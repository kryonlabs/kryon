    codec.fields[6].value.type_name = HostTextData("[]s32")
    codec.fields[6].value.length = cast(usize)data.layers.count
    if codec.fields[6].value.length > cast(usize)1024 { codec.fields[6].value.length = cast(usize)1024 }
    codec.fields[6].value.elements = *codec.layers_values[0]
    {
        index: usize = 0
        while index < codec.fields[6].value.length {
            codec.layers_values[index] = HostScalar("s32", cast(s64)data.layers[index])
            index += cast(usize)1
        }
    }
    codec.fields[7].name = HostTextData("layer_count")
    codec.fields[7].value = HostScalar("s32", cast(s64)data.layer_count)
    codec.fields[8].name = HostTextData("fill")
    codec.fields[8].value = WidgetEncodeColor(data.fill, *codec.fill)
    codec.fields[9].name = HostTextData("label")
    codec.fields[9].value = HostValue.{.kind = cast(s32)HostString, .type_name = HostTextData("string"), .data = HostTextData(data.label), .length = cast(usize)data.label.count}
    codec.fields[10].name = HostTextData("pixel_snap")
    codec.fields[10].value = HostScalar("bool", ifx data.pixel_snap then 1 else 0)
    codec.fields[11].name = HostTextData("nearest")
    codec.fields[11].value = HostScalar("bool", ifx data.nearest then 1 else 0)
    codec.fields[12].name = HostTextData("nearest_tiles")
    codec.fields[12].value.kind = cast(s32)HostSlice
    codec.fields[12].value.type_name = HostTextData("[]s32")
    codec.fields[12].value.length = cast(usize)data.nearest_tiles.count
    if codec.fields[12].value.length > cast(usize)1024 { codec.fields[12].value.length = cast(usize)1024 }
    codec.fields[12].value.elements = *codec.nearest_tiles_values[0]
    {
        index: usize = 0
        while index < codec.fields[12].value.length {
            codec.nearest_tiles_values[index] = HostScalar("s32", cast(s64)data.nearest_tiles[index])
            index += cast(usize)1
        }
    }
    return value
}

WidgetDecodeTileMapProps :: (value: HostValue, codec: *WidgetTileMapPropsCodec) -> TileMapProps {
    data: TileMapProps
    zero: HostValue
    data.key = cast(u64)HostFieldValue(*value, 0, "key", *zero).bits
    data.bounds = WidgetDecodeRectangle(HostFieldValue(*value, 1, "bounds", *zero).*, *codec.bounds)
    data.columns = cast(s32)HostFieldValue(*value, 2, "columns", *zero).integer
    data.rows = cast(s32)HostFieldValue(*value, 3, "rows", *zero).integer
    {
        field_at := HostFieldAt(value, 4, "tiles")
        if field_at >= 0 {
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    codec.tiles_decoded[index] = HostValueText(value.fields[field_at].value.elements[index])
                    index += cast(usize)1
                }
            }
            // Slice storage is attached by the rendering effect after decoding.
        }
    }
    {
        field_at := HostFieldAt(value, 5, "names")
        if field_at >= 0 {
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    codec.names_decoded[index] = HostValueText(value.fields[field_at].value.elements[index])
                    index += cast(usize)1
                }
            }
            // Slice storage is attached by the rendering effect after decoding.
        }
    }
    {
        field_at := HostFieldAt(value, 6, "layers")
        if field_at >= 0 {
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    codec.layers_decoded[index] = cast(s32)value.fields[field_at].value.elements[index].integer
                    index += cast(usize)1
                }
            }
            // Slice storage is attached by the rendering effect after decoding.
        }
    }
    data.layer_count = cast(s32)HostFieldValue(*value, 7, "layer_count", *zero).integer
    data.fill = WidgetDecodeColor(HostFieldValue(*value, 8, "fill", *zero).*, *codec.fill)
    data.label = HostValueText(HostFieldValue(*value, 9, "label", *zero).*)
    data.pixel_snap = HostFieldValue(*value, 10, "pixel_snap", *zero).integer != 0
    data.nearest = HostFieldValue(*value, 11, "nearest", *zero).integer != 0
    {
        field_at := HostFieldAt(value, 12, "nearest_tiles")
        if field_at >= 0 {
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    codec.nearest_tiles_decoded[index] = cast(s32)value.fields[field_at].value.elements[index].integer
                    index += cast(usize)1
                }
            }
            // Slice storage is attached by the rendering effect after decoding.
        }
    }
    return data
}

WidgetValidTileMapProps :: (value: HostValue) -> bool {
    if !HostRecordValid(*value, "TileMapProps") { return false }
    if !HostFieldScalarValid(*value, 0, "key", "u64", cast(s32)HostUnsigned) { return false }
    if !HostFieldRecordValid(*value, 1, "bounds", WidgetValidRectangle) { return false }
    if !HostFieldScalarValid(*value, 2, "columns", "s32", cast(s32)HostInteger) { return false }
    if !HostFieldScalarValid(*value, 3, "rows", "s32", cast(s32)HostInteger) { return false }
    {
        field_at := HostFieldAt(value, 4, "tiles")
        if field_at >= 0 {
            if value.fields[field_at].value.kind != cast(s32)HostSlice || TextFromCString(value.fields[field_at].value.type_name) != "[]string" ||
                value.fields[field_at].value.length > cast(usize)1024 || (value.fields[field_at].value.length > cast(usize)0 && value.fields[field_at].value.elements == null) { return false }
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    if !HostScalarValid(value.fields[field_at].value.elements[index], "string", cast(s32)HostString) { return false }
                    index += cast(usize)1
                }
            }
        }
    }
    {
        field_at := HostFieldAt(value, 5, "names")
        if field_at >= 0 {
            if value.fields[field_at].value.kind != cast(s32)HostSlice || TextFromCString(value.fields[field_at].value.type_name) != "[]string" ||
                value.fields[field_at].value.length > cast(usize)1024 || (value.fields[field_at].value.length > cast(usize)0 && value.fields[field_at].value.elements == null) { return false }
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    if !HostScalarValid(value.fields[field_at].value.elements[index], "string", cast(s32)HostString) { return false }
                    index += cast(usize)1
                }
            }
        }
    }
    {
        field_at := HostFieldAt(value, 6, "layers")
        if field_at >= 0 {
            if value.fields[field_at].value.kind != cast(s32)HostSlice || TextFromCString(value.fields[field_at].value.type_name) != "[]s32" ||
                value.fields[field_at].value.length > cast(usize)1024 || (value.fields[field_at].value.length > cast(usize)0 && value.fields[field_at].value.elements == null) { return false }
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    if !HostScalarValid(value.fields[field_at].value.elements[index], "s32", cast(s32)HostInteger) { return false }
                    index += cast(usize)1
                }
            }
        }
    }
    if !HostFieldScalarValid(*value, 7, "layer_count", "s32", cast(s32)HostInteger) { return false }
    if !HostFieldRecordValid(*value, 8, "fill", WidgetValidColor) { return false }
    if !HostFieldScalarValid(*value, 9, "label", "string", cast(s32)HostString) { return false }
    if !HostFieldScalarValid(*value, 10, "pixel_snap", "bool", cast(s32)HostInteger) { return false }
    if !HostFieldScalarValid(*value, 11, "nearest", "bool", cast(s32)HostInteger) { return false }
    {
        field_at := HostFieldAt(value, 12, "nearest_tiles")
        if field_at >= 0 {
            if value.fields[field_at].value.kind != cast(s32)HostSlice || TextFromCString(value.fields[field_at].value.type_name) != "[]s32" ||
                value.fields[field_at].value.length > cast(usize)1024 || (value.fields[field_at].value.length > cast(usize)0 && value.fields[field_at].value.elements == null) { return false }
            {
                index: usize = 0
                while index < value.fields[field_at].value.length {
                    if !HostScalarValid(value.fields[field_at].value.elements[index], "s32", cast(s32)HostInteger) { return false }
                    index += cast(usize)1
                }
            }
        }
    }
    return true
}

WidgetTileMapResultCodec :: struct {
    fields: [4]HostField
    board: WidgetRectangleCodec
}

WidgetEncodeTileMapResult :: (data: TileMapResult, codec: *WidgetTileMapResultCodec) -> HostValue {
    value := HostRecordValue("TileMapResult", codec.fields[:])
    codec.fields[0].name = HostTextData("board")
    codec.fields[0].value = WidgetEncodeRectangle(data.board, *codec.board)
    codec.fields[1].name = HostTextData("cell")
    codec.fields[1].value = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = cast(float64)data.cell}
    codec.fields[2].name = HostTextData("columns")
    codec.fields[2].value = HostScalar("s32", cast(s64)data.columns)
    codec.fields[3].name = HostTextData("rows")
    codec.fields[3].value = HostScalar("s32", cast(s64)data.rows)
    return value
}

WidgetDecodeTileMapResult :: (value: HostValue, codec: *WidgetTileMapResultCodec) -> TileMapResult {
    data: TileMapResult
    zero: HostValue
    data.board = WidgetDecodeRectangle(HostFieldValue(*value, 0, "board", *zero).*, *codec.board)
    data.cell = cast(float32)HostFieldValue(*value, 1, "cell", *zero).real
    data.columns = cast(s32)HostFieldValue(*value, 2, "columns", *zero).integer
    data.rows = cast(s32)HostFieldValue(*value, 3, "rows", *zero).integer
    return data
}

WidgetValidTileMapResult :: (value: HostValue) -> bool {
    if !HostRecordValid(*value, "TileMapResult") { return false }
    if !HostFieldRecordValid(*value, 0, "board", WidgetValidRectangle) { return false }
    if !HostFieldScalarValid(*value, 1, "cell", "float32", cast(s32)HostReal) { return false }
    if !HostFieldScalarValid(*value, 2, "columns", "s32", cast(s32)HostInteger) { return false }
    if !HostFieldScalarValid(*value, 3, "rows", "s32", cast(s32)HostInteger) { return false }
    return true
}
