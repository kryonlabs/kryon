#import "session"
#import "geometry"
#import "layout"
#import "layout_widget"
#import "layout_props"

FlowProps :: struct {
    bounds: Rectangle
    gap: s32
    padding: s32
    key: u64
}

FlowResult :: struct {
    node: s32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
}

// Flow places its children along a row. The caller uses FlowChildBounds before
// submitting each child, then closes the retained scope with End(session).
#program_export
Flow :: (session: Session, props: FlowProps) -> FlowResult {
    container: LayoutContainer = Row(session, ColumnProps.{.bounds = props.bounds,
        .gap = props.gap, .padding = props.padding, .key = props.key})
    return FlowResult.{.node = container.node, .opened = container.opened,
        .bounds = container.bounds, .content = container.content, .gap = container.gap,
        .padding = container.padding}
}

#program_export
FlowChildBounds :: (flow: FlowResult, declared: Rectangle,
    measured: Rectangle, child_index: s32,
    previous_width_sum: float32) -> Rectangle {
    container: LayoutContainer = .{.bounds = flow.bounds, .gap = flow.gap, .padding = flow.padding}
    return RowChildBounds(container, declared, measured,
        child_index, previous_width_sum)
}
