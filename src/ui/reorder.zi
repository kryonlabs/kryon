#module "reorder"
#import "control_props"
#import "reorder_props"
#import "style"

ReorderDragMotion :: struct {
    dragging: i32
    scroll_offset: i32
}

ReorderLifecycleDecision :: struct {
    cancel_active: bool
    ignore_list: bool
}

ReorderPressDecision :: struct {
    can_press: bool
}

ReorderReleaseDecision :: struct {
    capture_input: bool
    commit: bool
    cancel_active: bool
}

ReorderMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return (i32)(value * scale)
}

ReorderMetricFloat :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> float {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return value * scale
}

ReorderMetricsFor :: (scale: float, handle_width: i32, drag_threshold: i32,
    auto_scroll_margin: i32, auto_scroll_step: i32, handle: StyleFrame,
    placeholder: StyleFrame) -> ReorderMetrics #export {
    metrics: ReorderMetrics

    metrics.handle_width = handle_width
    if metrics.handle_width <= 0 {
        metrics.handle_width = ReorderMetric(handle.value.fields,
            (u32)StyleContentOffset, handle.value.offset_x, 36.0, scale)
    }

    metrics.drag_threshold = drag_threshold
    if metrics.drag_threshold <= 0 {
        metrics.drag_threshold = ReorderMetric(handle.value.fields,
            (u32)StyleContentOffset, handle.value.offset_y, 5.0, scale)
    }

    metrics.auto_scroll_margin = auto_scroll_margin
    if metrics.auto_scroll_margin <= 0 {
        metrics.auto_scroll_margin = ReorderMetric(placeholder.value.fields,
            (u32)StyleContentOffset, placeholder.value.offset_x, 34.0, scale)
    }

    metrics.auto_scroll_step = auto_scroll_step
    if metrics.auto_scroll_step <= 0 {
        metrics.auto_scroll_step = ReorderMetric(placeholder.value.fields,
            (u32)StyleContentOffset, placeholder.value.offset_y, 12.0, scale)
    }

    return metrics
}

ReorderHandleBounds :: (item_bounds: Rectangle, handle_width: i32,
    handle_height: i32) -> Rectangle #export {
    handle: Rectangle = item_bounds
    handle.width = (float)handle_width
    if handle_height > 0 {
        limit: float = (float)handle_height
        if handle.height > limit {
            handle.height = limit
        }
    }
    return handle
}

ReorderHandlePaintFor :: (bounds: Rectangle, scale: float,
    handle: StyleFrame) -> ReorderHandlePaint #export {
    paint: ReorderHandlePaint
    w: i32 = (i32)bounds.width
    h: i32 = (i32)bounds.height
    if w <= 0 || h <= 0 { return paint }

    dot: i32 = ReorderMetric(handle.value.fields, (u32)StyleIconSize,
        handle.value.icon_size, 3.0, scale)
    gap: i32 = ReorderMetric(handle.value.fields, (u32)StyleGap,
        handle.value.gap, 4.0, scale)
    col_gap: i32 = ReorderMetric(handle.value.fields, (u32)StylePaddingX,
        handle.value.padding_x, 8.0, scale)
    if dot <= 0 { return paint }
    if gap < 0 { gap = 0 }
    if col_gap < 0 { col_gap = 0 }

    total_w: i32 = dot * 2 + col_gap
    total_h: i32 = dot * 3 + gap * 2
    start_x: i32 = (i32)bounds.x + (w - total_w) / 2
    start_y: i32 = (i32)bounds.y + (h - total_h) / 2

    paint.dot0 = ReorderDotBounds(start_x, start_y, dot)
    paint.dot1 = ReorderDotBounds(start_x + dot + col_gap, start_y, dot)
    paint.dot2 = ReorderDotBounds(start_x, start_y + dot + gap, dot)
    paint.dot3 = ReorderDotBounds(start_x + dot + col_gap, start_y + dot + gap, dot)
    paint.dot4 = ReorderDotBounds(start_x, start_y + (dot + gap) * 2, dot)
    paint.dot5 = ReorderDotBounds(start_x + dot + col_gap, start_y + (dot + gap) * 2, dot)
    paint.dot_count = 6
    return paint
}

ReorderDotBounds :: (x: i32, y: i32, size: i32) -> Rectangle {
    bounds: Rectangle
    bounds.x = (float)x
    bounds.y = (float)y
    bounds.width = (float)size
    bounds.height = (float)size
    return bounds
}

ReorderPlaceholderPaintFor :: (bounds: Rectangle, scale: float,
    placeholder: StyleFrame) -> ReorderPlaceholderPaint #export {
    paint: ReorderPlaceholderPaint
    x: i32 = (i32)bounds.x
    y: i32 = (i32)bounds.y
    w: i32 = (i32)bounds.width
    h: i32 = (i32)bounds.height
    if w <= 0 || h <= 0 { return paint }

    line_h: i32 = ReorderMetric(placeholder.value.fields,
        (u32)StyleBorderWidth, placeholder.value.border_width, 2.0, scale)
    if line_h < 0 { line_h = 0 }

    threshold: i32 = ReorderMetric(placeholder.value.fields,
        (u32)StyleIconSize, placeholder.value.icon_size, 32.0, scale)
    if h >= threshold {
        inset: i32 = ReorderMetric(placeholder.value.fields,
            (u32)StylePaddingX, placeholder.value.padding_x, 3.0, scale)
        slot_w: i32 = w - inset * 2
        slot_h: i32 = h - inset * 2
        if slot_w <= 0 || slot_h <= 0 { return paint }
        paint.slot_bounds.x = (float)(x + inset)
        paint.slot_bounds.y = (float)(y + inset)
        paint.slot_bounds.width = (float)slot_w
        paint.slot_bounds.height = (float)slot_h
        paint.stroke_width = ReorderMetricFloat(placeholder.value.fields,
            (u32)StyleBorderWidth, placeholder.value.border_width, 2.0, scale)
        if paint.stroke_width < 0.0 { paint.stroke_width = 0.0 }
        paint.radius = 0.12
        if (placeholder.value.fields & (u32)StyleRadius) != (u32)0 &&
           placeholder.value.radius >= 0.0 {
            paint.radius = placeholder.value.radius
        }
        paint.segments = 10
        paint.fill_alpha = 0.10
        if (placeholder.value.fields & (u32)StyleOpacity) != (u32)0 &&
           placeholder.value.opacity >= 0.0 {
            paint.fill_alpha = placeholder.value.opacity
        }
        paint.use_slot = 1
        return paint
    }

    paint.line_bounds.x = (float)x
    paint.line_bounds.y = (float)(y + h / 2 - line_h / 2)
    paint.line_bounds.width = (float)w
    paint.line_bounds.height = (float)line_h
    return paint
}

ReorderDraggedCenterY :: (pointer_y: i32, press_offset_y: i32,
    item_height: float) -> i32 #export {
    return pointer_y - press_offset_y + (i32)(item_height / 2.0)
}

ReorderItemMatches :: (candidate_id: i32, item_id: i32) -> bool #export {
    return candidate_id == item_id
}

ReorderTargetIncludesItem :: (pointer_y: i32, item_bounds: Rectangle) -> bool #export {
    center_y: i32 = (i32)(item_bounds.y + item_bounds.height / 2.0)
    return pointer_y > center_y
}

ReorderTargetStep :: (target: i32, index: i32, active_index: i32,
    pointer_y: i32, item_bounds: Rectangle) -> i32 #export {
    if index == active_index { return target }
    if ReorderTargetIncludesItem(pointer_y, item_bounds) {
        return target + 1
    }
    return target
}

ReorderTargetIndexFor :: (target: i32, item_count: i32) -> i32 #export {
    if item_count <= 0 { return -1 }
    if target < 0 { return 0 }
    limit: i32 = item_count - 1
    if target > limit { return limit }
    return target
}

ReorderListResultDefault :: (pointer_y: i32) -> ReorderListResult #export {
    result: ReorderListResult
    result.from_index = -1
    result.to_index = -1
    result.active_index = -1
    result.target_index = -1
    result.pointer_y = pointer_y
    return result
}

ReorderListPressResultFor :: (index: i32, item_id: i32,
    pointer_y: i32) -> ReorderListResult #export {
    result: ReorderListResult = ReorderListResultDefault(pointer_y)
    result.active = 1
    result.from_index = index
    result.to_index = index
    result.active_index = index
    result.target_index = index
    result.active_id = item_id
    return result
}

ReorderListActiveResultFor :: (from_index: i32, active_index: i32,
    target_index: i32, active_id: i32, pointer_y: i32,
    press_y: i32) -> ReorderListResult #export {
    result: ReorderListResult = ReorderListResultDefault(pointer_y)
    result.active = 1
    result.from_index = from_index
    result.to_index = target_index
    result.active_index = active_index
    result.target_index = target_index
    result.active_id = active_id
    result.drag_delta_y = pointer_y - press_y
    return result
}

ReorderListCommitResultFor :: (active: ReorderListResult,
    item_count: i32) -> ReorderListResult #export {
    result: ReorderListResult = active
    result.dragging = 0
    result.from_index = active.active_index
    result.committed = 0
    if result.target_index >= 0 && result.target_index < item_count &&
       result.target_index != active.active_index {
        result.committed = 1
    }
    return result
}

ReorderForeignActiveListFor :: (has_active_list: bool,
    active_list_id: i32, list_id: i32,
    mouse_down: bool) -> ReorderLifecycleDecision #export {
    decision: ReorderLifecycleDecision
    if has_active_list && active_list_id != list_id {
        decision.ignore_list = true
        if !mouse_down {
            decision.cancel_active = true
        }
    }
    return decision
}

ReorderActiveItemLifecycleFor :: (active_index: i32, item_count: i32,
    has_items: bool, active_item_disabled: bool) -> ReorderLifecycleDecision #export {
    decision: ReorderLifecycleDecision
    if active_index < 0 || active_index >= item_count || !has_items ||
        active_item_disabled {
        decision.cancel_active = true
        decision.ignore_list = true
    }
    return decision
}

ReorderPressFor :: (list_id: i32, has_items: bool, item_count: i32,
    mouse_pressed: bool, captured: bool, pointer_owner_none: bool,
    inside_bounds: bool) -> ReorderPressDecision #export {
    decision: ReorderPressDecision
    decision.can_press = list_id != 0 && has_items && item_count > 0 &&
        mouse_pressed && !captured && pointer_owner_none && inside_bounds
    return decision
}

ReorderReleaseFor :: (mouse_released: bool,
    was_dragging: bool) -> ReorderReleaseDecision #export {
    decision: ReorderReleaseDecision
    decision.capture_input = mouse_released
    decision.commit = mouse_released && was_dragging
    decision.cancel_active = true
    return decision
}

ReorderDragMotionFor :: (pointer_y: i32, press_y: i32, was_dragging: i32,
    bounds: Rectangle, viewport_top: i32, viewport_bottom: i32,
    scroll_offset: i32, max_scroll: i32,
    metrics: ReorderMetrics) -> ReorderDragMotion #export {
    motion: ReorderDragMotion
    dy: i32 = pointer_y - press_y
    abs_dy: i32 = dy
    if abs_dy < 0 { abs_dy = -abs_dy }

    motion.dragging = was_dragging
    if motion.dragging == 0 && abs_dy >= metrics.drag_threshold {
        motion.dragging = 1
    }

    motion.scroll_offset = scroll_offset
    if motion.dragging == 0 || max_scroll <= 0 {
        return motion
    }

    view_top: i32 = viewport_top
    if view_top <= 0 { view_top = (i32)bounds.y }
    view_bottom: i32 = viewport_bottom
    if view_bottom <= 0 { view_bottom = (i32)(bounds.y + bounds.height) }

    if pointer_y < view_top + metrics.auto_scroll_margin {
        motion.scroll_offset -= metrics.auto_scroll_step
    } else if pointer_y > view_bottom - metrics.auto_scroll_margin {
        motion.scroll_offset += metrics.auto_scroll_step
    }
    if motion.scroll_offset < 0 { motion.scroll_offset = 0 }
    if motion.scroll_offset > max_scroll { motion.scroll_offset = max_scroll }
    return motion
}
