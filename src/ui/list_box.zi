#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"

using StyleField;

ListBoxLayout :: struct {
    row_height: s32
    content_height: s32
    max_scroll: s32
    scroll: s32
    first_row: s32
    y_offset: s32
    visible_rows: s32
}

ListBoxNavigation :: struct {
    selected: s32
    scroll: s32
    changed: bool
}

ListBoxRowDecision :: struct {
    select: bool
    consume_release: bool
    selected: s32
    changed: bool
}

ListBoxItemPaint :: struct {
    text_x: s32
    text_y: s32
}

ListBoxMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
ListBoxRowHeight :: (row_height: s32, scale: float32, item: StyleFrame) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if row_height <= 0 {
        fallback: float32 = 30.0
        if (item.value.fields & cast(u32)StyleIconSize) != cast(u32)0 &&
           item.value.icon_size > 0.0 {
            fallback = item.value.icon_size
        }
        return ListBoxMetric(item.value.fields, cast(u32)StyleContentOffset,
            item.value.offset_y, fallback, scale, false)
    }
    return row_height
}

#program_export
ListBoxContentHeight :: (item_count: s32, row_height: s32,
    content_height: s32, scale: float32, item: StyleFrame) -> s32 {
    if content_height > 0 {
        return content_height
    }
    if item_count <= 0 {
        return 0
    }
    row_height = ListBoxRowHeight(row_height, scale, item)
    height: s64 = cast(s64)item_count * cast(s64)row_height
    if height > 2147483647 {
        return 2147483647
    }
    return cast(s32)height
}

#program_export
ListBoxMaxScroll :: (bounds_height: float32, item_count: s32,
    row_height: s32, content_height: s32, scale: float32, item: StyleFrame) -> s32 {
    height: s32 = ListBoxContentHeight(item_count, row_height, content_height,
        scale, item)
    max_scroll: s32 = height - cast(s32)bounds_height
    if max_scroll < 0 {
        return 0
    }
    return max_scroll
}

#program_export
ListBoxClampScroll :: (scroll: s32, max_scroll: s32) -> s32 {
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

#program_export
ListBoxRevealScroll :: (selected: s32, scroll: s32, row_height: s32,
    viewport_height: float32, max_scroll: s32, scale: float32,
    item: StyleFrame) -> s32 {
    if selected < 0 {
        return ListBoxClampScroll(scroll, max_scroll)
    }
    row_height = ListBoxRowHeight(row_height, scale, item)
    top: s32 = selected * row_height
    bottom: s32 = top + row_height
    viewport: s32 = cast(s32)viewport_height
    if top < scroll {
        scroll = top
    } else if bottom > scroll + viewport {
        scroll = bottom - viewport
    }
    return ListBoxClampScroll(scroll, max_scroll)
}

// key: 1 home, 2 end, 3 up, 4 down.
#program_export
ListBoxKeyNone :: () -> s32 {
    return 0
}

#program_export
ListBoxKeyHome :: () -> s32 {
    return 1
}

#program_export
ListBoxKeyEnd :: () -> s32 {
    return 2
}

#program_export
ListBoxKeyUp :: () -> s32 {
    return 3
}

#program_export
ListBoxKeyDown :: () -> s32 {
    return 4
}

#program_export
ListBoxKeyFor :: (home: bool, end: bool, up: bool, down: bool) -> s32 {
    if home { return ListBoxKeyHome() }
    if end { return ListBoxKeyEnd() }
    if up { return ListBoxKeyUp() }
    if down { return ListBoxKeyDown() }
    return ListBoxKeyNone()
}

#program_export
ListBoxNavigate :: (selected: s32, item_count: s32, key: s32,
    scroll: s32, row_height: s32, viewport_height: float32,
    max_scroll: s32, scale: float32, item: StyleFrame) -> ListBoxNavigation {
    nav: ListBoxNavigation
    nav.selected = selected
    nav.scroll = ListBoxClampScroll(scroll, max_scroll)
    if item_count <= 0 || key == ListBoxKeyNone() {
        return nav
    }
    next: s32 = selected
    if key == ListBoxKeyHome() {
        next = 0
    } else if key == ListBoxKeyEnd() {
        next = item_count - 1
    } else if key == ListBoxKeyUp() {
        if selected < 0 {
            next = item_count - 1
        } else {
            next = selected - 1
        }
    } else if key == ListBoxKeyDown() {
        if selected < 0 {
            next = 0
        } else {
            next = selected + 1
        }
    } else {
        return nav
    }
    if next < 0 {
        next = 0
    }
    if next >= item_count {
        next = item_count - 1
    }
    nav.changed = next != selected
    nav.selected = next
    nav.scroll = ListBoxRevealScroll(next, nav.scroll, row_height,
        viewport_height, max_scroll, scale, item)
    return nav
}

#program_export
ListBoxRowDecisionFor :: (hot: bool, released: bool, has_selection: bool,
    current_selected: s32, row: s32) -> ListBoxRowDecision {
    decision: ListBoxRowDecision
    decision.selected = current_selected
    if !hot || !released || !has_selection {
        return decision
    }
    decision.consume_release = true
    decision.select = true
    decision.selected = row
    decision.changed = row != current_selected
    return decision
}

#program_export
ListBoxLayoutFor :: (bounds: Rectangle, item_count: s32, row_height: s32,
    content_height: s32, scroll: s32, scale: float32, item: StyleFrame) -> ListBoxLayout {
    layout: ListBoxLayout
    layout.row_height = ListBoxRowHeight(row_height, scale, item)
    layout.content_height = ListBoxContentHeight(item_count,
        layout.row_height, content_height, scale, item)
    layout.max_scroll = ListBoxMaxScroll(bounds.height, item_count,
        layout.row_height, content_height, scale, item)
    layout.scroll = ListBoxClampScroll(scroll, layout.max_scroll)
    if layout.row_height > 0 {
        layout.first_row = layout.scroll / layout.row_height
        layout.y_offset = layout.scroll % layout.row_height
        layout.visible_rows = cast(s32)bounds.height / layout.row_height
    }
    return layout
}

#program_export
ListBoxRowBounds :: (bounds: Rectangle, row_index: s32,
    layout: ListBoxLayout) -> Rectangle {
    row: Rectangle
    row.x = bounds.x
    row.y = bounds.y + cast(float32)(row_index * layout.row_height - layout.y_offset)
    row.width = bounds.width
    row.height = cast(float32)layout.row_height
    return row
}

#program_export
ListBoxItemPaintFor :: (row: Rectangle, label_inset: s32,
    text_line_height: s32) -> ListBoxItemPaint {
    paint: ListBoxItemPaint
    paint.text_x = cast(s32)row.x + label_inset
    paint.text_y = cast(s32)row.y + (cast(s32)row.height - text_line_height) / 2
    return paint
}

#program_export
ListBoxItemLabelInset :: (scale: float32, item: StyleFrame) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return ListBoxMetric(item.value.fields, cast(u32)StylePaddingX,
        item.value.padding_x, 8.0, scale, true)
}

#program_export
ListBoxScrollbarBoundsFor :: (bounds: Rectangle, scale: float32,
    list: StyleFrame) -> Rectangle {
    bar: Rectangle
    scrollbar_width: s32 = ListBoxMetric(list.value.fields,
        cast(u32)StyleContentOffset, list.value.offset_y, 8.0, scale, true)
    bar.x = bounds.x + bounds.width - cast(float32)scrollbar_width
    bar.y = bounds.y
    bar.width = cast(float32)scrollbar_width
    bar.height = bounds.height
    return bar
}
