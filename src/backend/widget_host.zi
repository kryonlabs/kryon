// The widget calls WidgetHostCall answers, for checking a bundle's
// capabilities before it runs.
WidgetHostSupports :: (module: string, function: string) -> bool {
    if (ModuleName(module, "tooltip") && function == "TooltipHostedHost") ||
    (ModuleName(module, "sheet") && function == "SheetBeginHostedHost") ||
    (ModuleName(module, "commandpalette") && function == "CommandPaletteHostedHost") ||
    (ModuleName(module, "hovercard") && function == "HoverCardHostedHost") ||
    (ModuleName(module, "confirmpopover") && function == "ConfirmPopoverHostedHost") ||
    (ModuleName(module, "guidedtour") && function == "GuidedTourHostedHost") ||
    (ModuleName(module, "sheet") && function == "SheetEndHostedHost") { return true }
    if (ModuleName(module, "taginput") && function == "TagInputHostedHost") ||
    (ModuleName(module, "onetimecode") && function == "OneTimeCodeHostedHost") ||
    (ModuleName(module, "inlineedit") && function == "InlineEditHostedHost") ||
    (ModuleName(module, "scrubfield") && function == "ScrubFieldHostedHost") ||
    (ModuleName(module, "moneyfield") && function == "MoneyFieldHostedHost") ||
    (ModuleName(module, "shortcutrecorder") && function == "ShortcutRecorderHostedHost") { return true }
    return (ModuleName(module, "cursor") && (function == "CursorSetHostedHost" ||
        function == "CursorHoverHostedHost")) ||
    (ModuleName(module, "media_audio") && function == "MediaAudioHost") ||
    (ModuleName(module, "frame_snapshot") && function == "CaptureFrameInputHost") ||
    (ModuleName(module, "pointer_input") && function == "PollPointer") ||
    (ModuleName(module, "carousel") && function == "CarouselWheelHostedHost") ||
    (ModuleName(module, "text") && function == "TextHostedHost") ||
    (ModuleName(module, "text") && function == "TextLinkAtHostedHost") ||
    (ModuleName(module, "text_measure") && function == "TextWidthHostedHost") ||
    (ModuleName(module, "text_measure") && function == "TextHeightHostedHost") ||
    (ModuleName(module, "image") && function == "ImageHostedHost") ||
    (ModuleName(module, "image_raster") &&
        (function == "ImageWidth" || function == "ImageHeight")) ||
    (ModuleName(module, "image_showing") && function == "ImageShowingHostedHost") ||
    (ModuleName(module, "tilemap") && function == "TileMapHostedHost") ||
    (ModuleName(module, "button") && function == "ButtonHostedHost") ||
    (ModuleName(module, "textarea") && function == "TextAreaHostedHost") ||
    (ModuleName(module, "scroll") && function == "ScrollHostedHost") ||
    (ModuleName(module, "tree") && function == "EndHostedHost") ||
    (ModuleName(module, "tree") && function == "TreePushScopeHostedHost") ||
    (ModuleName(module, "textfield") && function == "TextFieldHostedHost") ||
    (ModuleName(module, "tabs") && function == "TabBarHostedHost") ||
    (ModuleName(module, "segmented") && function == "SegmentedControlHostedHost") ||
    (ModuleName(module, "checkbox") && function == "CheckboxHostedHost") ||
    (ModuleName(module, "toggle") && function == "ToggleHostedHost") ||
    (ModuleName(module, "box") && function == "BoxHostedHost") ||
    (ModuleName(module, "fieldset") && function == "FieldsetHostedHost") ||
    (ModuleName(module, "shape") && (function == "LineHostedHost" ||
        function == "CircleHostedHost" || function == "RingHostedHost" ||
        function == "TriangleHostedHost")) ||
    (ModuleName(module, "toggle_measure") && function == "ToggleSizeHostedHost") ||
    (ModuleName(module, "slider") && (function == "SliderHostedHost" ||
        function == "DiscreteSliderHostedHost")) ||
    (ModuleName(module, "progress") && function == "ProgressHostedHost") ||
    (ModuleName(module, "overlay") && (function == "DismissibleOverlayHostedHost" ||
        function == "PopupHostedHost")) ||
    (ModuleName(module, "svgicon") && function == "SvgIconHostedHost") ||
    (ModuleName(module, "press") && function == "PressHostedHost") ||
    (ModuleName(module, "spinbox") && function == "SpinboxHostedHost") ||
    (ModuleName(module, "timepicker") && function == "TimePickerHostedHost") ||
    (ModuleName(module, "dropdown") && function == "DropdownHostedHost") ||
    (ModuleName(module, "titlebar") && function == "TitleBarHostedHost") ||
    (ModuleName(module, "modal_frame") && function == "ModalFrameHostedHost") ||
    (ModuleName(module, "modal") && function == "ActionModalHostedHost") ||
    (ModuleName(module, "contextmenu") && function == "ContextMenuHostedHost") ||
    (ModuleName(module, "widget_palette") && function == "WidgetPaletteHostedHost") ||
    (ModuleName(module, "widget_palette") && function == "WidgetPaletteRestoreHostedHost")
}

WidgetHostPackedPath :: (path: string) -> string { return path }

// A portable Text's props with its strong and link ranges attached.
WidgetHostTextProps :: (props: HostValue) -> TextProps {
    text: TextProps = WidgetDecodeTextProps(props, *widget_text_codec)
    text.strong = widget_text_codec.strong_decoded[:HostSliceLength(props, 15, "strong")]
    text.links = widget_text_codec.links_decoded[:HostSliceLength(props, 18, "links")]
    if text.typeface.count >= 7 && text.typeface[:7] == "assets/" {
        text.typeface = WidgetHostAssetPath(text.typeface)
    } else {
        // A guest can name a registered face, but cannot load arbitrary host
        // paths. Only its own allowed assets pass through the resolver.
        for byte: text.typeface {
            if byte == #char "/" || byte == #char "\\" || byte == #char ":" {
                text.typeface = ""
                break
            }
        }
    }
    return text
}

// Which of a portable Text's links is under a point, as TextLinkAt.
WidgetHostTextLinkAt :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    props := arguments[1]
    if !WidgetValidTextProps(props) ||
    !HostScalarValid(arguments[2], "float32", cast(s32)HostReal) ||
    !HostScalarValid(arguments[3], "float32", cast(s32)HostReal) {
        return 0
    }
    hit := TextLinkAt(session, WidgetHostTextProps(props),
        cast(float32)arguments[2].real, cast(float32)arguments[3].real)
    result.* = HostScalar("s32", cast(s64)hit)
    return 1
}

WidgetHostAudioReadNone :: (context: *void, path: string) -> string {
    unused context
    unused path
    return ""
}

WidgetHostBegin :: (session: Session, asset_allowed: WidgetAssetAllowed, resolve: WidgetAssetResolve = WidgetHostPackedPath,
    audio: *MediaAudioOwner = null, audio_read: MediaAudioRead = WidgetHostAudioReadNone, audio_context: *void = null, staging: bool = false) {
    widget_host_staging = staging
    widget_host_audio = ifx staging then null else audio
    widget_host_audio_read = audio_read
    widget_host_audio_context = audio_context
    widget_host_session = session
    widget_host_asset_allowed = asset_allowed
    widget_host_asset_resolve = resolve
    widget_host_depth = 0
    widget_host_palette_depth = 0
    widget_host_active = true
    if !staging && audio != null {
        MediaAudioOwnerBind(audio, session, WidgetHostAssetAllowed, audio_read, audio_context)
        MediaAudioOwnerTick(audio)
    }
}

// Closes any scroll the bundle left open, so the host's tree stays balanced,
// and draws in the host's own style again.
WidgetHostEnd :: () {
    while widget_host_depth > 0 {
        End(widget_host_session)
        widget_host_depth -= 1
    }
    while widget_host_palette_depth > 0 {
        unused WidgetPaletteRestore(widget_host_session)
        widget_host_palette_depth -= 1
    }
    widget_host_active = false
    widget_host_staging = false
    widget_host_audio = null
    widget_host_audio_context = null
}

WidgetHostAssetAllowed :: (path: string) -> bool {
    return widget_host_asset_allowed != null && widget_host_asset_allowed(path)
}

WidgetHostAssetPath :: (path: string) -> string {
    if !WidgetHostAssetAllowed(path) { return "" }
    if path == "" || widget_host_asset_resolve == null { return path }
    return widget_host_asset_resolve(path)
}

WidgetHostImage :: (image: *ImageProps) -> bool {
    if image.texture.id != cast(u32)0 { return false }
    packed := image.asset_path
    if !WidgetHostAssetAllowed(packed) { return false }
    // A preview passes the same policy as its picture; one its owner cannot
    // resolve yet is left out, and the picture draws as it would alone.
    preview := image.preview_path
    if preview != "" {
        if !WidgetHostAssetAllowed(preview) { return false }
        image.preview_path = WidgetHostAssetPath(preview)
    }
    if packed == "" { return true }
    image.asset_path = WidgetHostAssetPath(packed)
    if image.asset_path == "" {
        image.texture.width = -1
        image.texture.height = -1
    }
    return true
}

// A warped image's points, validated with its props, decoded into the
// host's own buffer.
WidgetHostMeshPoints :: (mesh: HostValue) -> []Vector2 {
    points_at := HostFieldAt(mesh, 2, "points")
    if points_at >= 0 { return WidgetHostImagePoints(mesh.fields[points_at].value) }
    return widget_image_mesh_points[:0]
}

WidgetHostImagePoints :: (points: HostValue) -> []Vector2 {
    count: usize = 0
    while count < points.length && count < cast(usize)IMAGE_MESH_POINT_LIMIT {
        widget_image_mesh_points[count] = WidgetDecodeVector2(points.elements[count],
            *widget_image_mesh_point_codec)
        count += cast(usize)1
    }
    return widget_image_mesh_points[:cast(s64)count]
}

// A bundle's own colours for the widgets it draws after this call, until
// its frame ends: nine packed colours and whether buttons are raised.
WidgetHostPalette :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    colors: [9]u32
    for index: cast(s32)0..8 {
        if !HostScalarValid(arguments[index + 1], "u32", cast(s32)HostUnsigned) { return 0 }
        colors[index] = cast(u32)arguments[index + 1].bits
    }
    if !HostScalarValid(arguments[10], "bool", cast(s32)HostInteger) { return 0 }
    palette := WidgetPalette.{.background = colors[0], .base = colors[1], .text = colors[2],
        .selected = colors[3], .selected_text = colors[4], .border = colors[5],
        .danger = colors[6], .warning = colors[7], .success = colors[8],
        .material = arguments[10].integer != 0}
    used := WidgetPaletteUse(session, palette)
    if used { widget_host_palette_depth += 1 }
    result.* = HostScalar("bool", ifx used then 1 else 0)
    return 1
}

// The active widget frame supplies the asset policy; the actual instance
// supplies ownership and a packed resource reader. No owner means unsupported.
WidgetHostAudioCall :: (audio: *MediaAudioOwner, read: MediaAudioRead, context: *void,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if !widget_host_active || count != 2 || !WidgetValidSession(arguments[0]) ||
    !WidgetValidMediaAudioCommand(arguments[1]) { return 0 }
    session := WidgetDecodeSession(arguments[0], *widget_session_codec)
    if session.slot != widget_host_session.slot || session.epoch != widget_host_session.epoch { return 0 }
    command := WidgetDecodeMediaAudioCommand(arguments[1], *widget_audio_command_codec)
    answer := MediaAudioResult.{.code = .Unsupported, .message = "Host has no owned asset audio scope"}
    if !widget_host_staging && audio != null {
        MediaAudioOwnerBind(audio, session, WidgetHostAssetAllowed, read, context)
        answer = MediaAudioOwnerCall(audio, session, command)
    }
    result.* = WidgetEncodeMediaAudioResult(answer, *widget_audio_result_codec)
    return 1
}

// A HostCall for the hosted widget functions. Returns 0 for a call it does
// not answer or refuses.
WidgetHostCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    unused context
    if !widget_host_active {
        return 0
    }
    owner := TextFromCString(module)
    name := TextFromCString(function)
    if ModuleName(owner, "image_raster") &&
        (name == "ImageWidth" || name == "ImageHeight") {
        if count != 1 ||
            !HostScalarValid(arguments[0], "string", cast(s32)HostString) {
            return 0
        }
        packed := HostValueText(arguments[0])
        if !WidgetHostAssetAllowed(packed) { return 0 }
        resolved := WidgetHostAssetPath(packed)
        dimension: s32 = 0
        if packed != "" {
            if resolved == "" {
                dimension = -1
            } else if name == "ImageWidth" {
                dimension = AssetWidth(resolved)
            } else {
                dimension = AssetHeight(resolved)
            }
        }
        result.* = HostScalar("s32", cast(s64)dimension)
        return 1
    }
    if name == "MediaAudioHost" && ModuleName(owner, "media_audio") {
        return WidgetHostAudioCall(widget_host_audio, widget_host_audio_read, widget_host_audio_context,
            arguments, count, result)
    }
    if name == "PollPointer" && ModuleName(owner, "pointer_input") && count == 0 {
        result.* = WidgetEncodePointerFrame(PointerSample(widget_host_session), *widget_pointer_codec)
        return 1
    }
    if count < 1 || !WidgetValidSession(arguments[0]) {
        return 0
    }
    session := WidgetDecodeSession(arguments[0], *widget_session_codec)
    if session.slot != widget_host_session.slot || session.epoch != widget_host_session.epoch {
        return 0
    }
    if name == "CaptureFrameInputHost" && ModuleName(owner, "frame_snapshot") && count == 1 {
        result.* = WidgetEncodeFrameInputSnapshot(CaptureFrameInput(session), *widget_frame_input_codec)
        return 1
    }
    if name == "CursorSetHostedHost" && ModuleName(owner, "cursor") && count == 8 {
        if !HostScalarValid(arguments[1], "string", cast(s32)HostString) ||
        !HostScalarValid(arguments[6], "bool", cast(s32)HostInteger) { return 0 }
        for index: 2..7 {
            if index == 6 { continue }
            if !HostScalarValid(arguments[index], "s32", cast(s32)HostInteger) ||
            arguments[index].integer < -2147483648 || arguments[index].integer > 2147483647 { return 0 }
        }
        if arguments[6].integer != 0 && arguments[6].integer != 1 { return 0 }
        props := CursorProps.{.asset_path = HostValueText(arguments[1]),
            .width = cast(s32)arguments[2].integer, .height = cast(s32)arguments[3].integer,
            .hotspot_x = cast(s32)arguments[4].integer, .hotspot_y = cast(s32)arguments[5].integer,
            .hidden = arguments[6].integer != 0, .shape = cast(s32)arguments[7].integer}
        accepted := CursorPropsValid(props)
        if accepted && props.asset_path != "" {
            accepted = CursorPackedPath(props.asset_path)
            if accepted {
                props.asset_path = WidgetHostAssetPath(props.asset_path)
                accepted = props.asset_path != "" && CursorPropsValid(props)
            }
        }
        if accepted { accepted = CursorSet(session, props) }
        result.* = HostScalar("bool", ifx accepted then 1 else 0)
        return 1
    }
