        Text((TextProps){.bounds={x, y + ScaleUIPx(216), 0, 0}, .text="ClosableTabBar", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        ClosableTabBar((ClosableTabBarProps){.bounds = {x,y + ScaleUIPx(252),ScaleUIPx(760),ScaleUIPx(36)}, .tabs = open_tabs, .count = tab_count, .selected_index = &tab_selected, .font = Text16, .closed_index = &closed_tab})
        if closed_tab >= 0 {
            if closed_tab < tab_count {
                tab_index: int = closed_tab
                for tab_index = closed_tab; tab_index < tab_count - 1; tab_index++ {
                    open_tabs[tab_index] = open_tabs[tab_index + 1]
                }
                tab_count -= 1
                if tab_selected > closed_tab {
                    tab_selected -= 1
                }
                if tab_selected >= tab_count {
                    tab_selected = tab_count - 1
                }
            }
            closed_tab = -1
        }
        if TabItemButton((TabItemButtonProps){.bounds = {right,y + ScaleUIPx(308),ScaleUIPx(130),ScaleUIPx(36)}, .id = 209, .label = "New tab", .font = Text16, .disabled = tab_count >= 8}) {
            open_tabs[tab_count] = (Tab){.label = tab_labels[tab_count], .closeable = 1}
            tab_selected = tab_count
            tab_count += 1
        }

        }

        if category == 4 {
            Text((TextProps){.bounds={x, y + ScaleUIPx(308), 0, 0}, .text=TextFormat("Open tabs: %d / Menu command: %d", tab_count, menu_command), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Text((TextProps){.bounds={x, y + ScaleUIPx(350), 0, 0}, .text="SubtabBar", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            subtab_result: int = SubtabBar((SubtabBarProps){.bounds = {x,y + ScaleUIPx(384),ScaleUIPx(350),ScaleUIPx(36)},.tabs = subtabs,.count = 3,.selected_index = subtab_selected,.font = Text16})
