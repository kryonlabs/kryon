App :: #import "kryon/app";
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/transition"
#import "kryon/frame_snapshot"
DemoTheme :: #import "kryon/Theme";

state: TransitionState;

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    input := CaptureFrameInput(session)
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Transition", .size = 28})
    if Button.Draw(session, Button.Props.{.disabled = example_disabled, .bounds = .{width = 180, height = 44}, .label = "Animate fade"}) != 0 { state = TransitionStart(0.6) }
    state = TransitionAdvance(state, (ifx (example_reduced_motion || DemoTheme.CurrentTheme().motion.reduced_motion) then 1.0 else cast(float32)input.delta_ms / 1000.0)).state
    // The fade lies over the content it covers.
    area := Layout.Stack(session, Layout.Props.{.bounds = .{height = 128}})
    if area.opened {
        Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = area.bounds, .text = "A transition over this content"})
        Box.Draw(session, Box.Props.{.bounds = area.bounds, .fill = TransitionFadeColor(state, .{16, 34, 45, 180})})
        unused End(session)
    }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "transition"}, Frame) }
