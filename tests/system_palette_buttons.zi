// A system palette colors buttons by tone and keeps their emphasis: accent
// takes the selection color, ghost and outline buttons stay transparent.
#import "system_theme"
#import "style_sheet"
#import "style"
#import "control_props"
#import "scroll"
#import "dropdown"
#import "image"
#import "modal"
using ButtonTone;
using ButtonEmphasis;
using ButtonState;
using StyleField;

failures: s32;
Check :: (ok: bool, name: string) { if !ok { failures += 1; print("FAIL: %\n", name) } }

// The widget's own face, marked so an unchanged field is visible.
Untouched :: 0x01020304
Base :: () -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground | cast(u32)StyleBorder | cast(u32)StyleFontSize
    face.background = cast(u32)Untouched; face.foreground = cast(u32)Untouched; face.border = cast(u32)Untouched
    face.font_size = 11.0
    return face
}
Face :: (kind: s32, tone: s32, emphasis: s32, state: s32) -> StyleData {
    facts := StyleControlRoleFacts(kind, 0, 0, StyleAny(), tone, emphasis, 0, state)
    return ResolveInstalledStyleRules(Base(), facts, state)
}

DropdownFace :: (role: s32, state: s32) -> StyleData {
    facts := StyleControlRoleFacts(StyleKindDropdown(), 0, 0, role, 0, 0, 0, state)
    return ResolveInstalledStyleRules(Base(), facts, state)
}

#program_export
main :: () -> s32 {
    palette := SystemPaletteFallback(false)
    palette.selected = CssPack(29, 185, 84, 255)
    Check(SystemPaletteInstall(palette), "palette installs")
    bg := palette.background; fg := palette.text
    button := StyleKindButton()

    plain := Face(button, ButtonToneNeutral, ButtonEmphasisFilled, 0)
    Check(plain.background == CssMix(bg, fg, 0.10) && plain.foreground == fg && plain.font_size == 15.0, "plain buttons take the palette's button color")
    hover := Face(button, ButtonToneNeutral, ButtonEmphasisFilled, cast(s32)ButtonStateHover)
    Check(hover.background == CssMix(bg, fg, 0.16), "plain buttons keep a hover color")

    accent := Face(button, ButtonToneAccent, ButtonEmphasisFilled, 0)
    Check(accent.background == palette.selected && accent.foreground == palette.selected_text && accent.font_size == 15.0, "accent buttons take the selection color")
    success := Face(button, ButtonToneSuccess, ButtonEmphasisFilled, 0)
    Check(success.background == palette.success, "success buttons take the palette's success color")
    danger := Face(button, ButtonToneDanger, ButtonEmphasisFilled, 0)
    Check(danger.background == palette.danger, "danger buttons take the palette's danger color")

    ghost := Face(button, ButtonToneNeutral, ButtonEmphasisGhost, 0)
    Check(ghost.background == cast(u32)Untouched && ghost.foreground == fg && ghost.font_size == 15.0, "ghost buttons stay transparent with the text color")
    chosen := Face(button, ButtonToneAccent, ButtonEmphasisGhost, cast(s32)ButtonStateSelected)
    Check(chosen.background == cast(u32)Untouched && chosen.foreground == palette.selected, "selected accent ghost buttons use the selection color")
    outline := Face(button, ButtonToneDanger, ButtonEmphasisOutline, 0)
    Check(outline.background == cast(u32)Untouched && outline.foreground == palette.danger && outline.border == palette.danger, "outline buttons keep their tone's border")
    link := Face(button, ButtonToneNeutral, ButtonEmphasisLink, 0)
    Check(link.background == cast(u32)Untouched && link.foreground == fg, "link buttons keep no background")

    field := Face(StyleKindTextField(), ButtonToneNeutral, ButtonEmphasisFilled, 0)
    Check(field.background == CssMix(bg, fg, 0.10) && field.font_size == 15.0, "text fields keep the palette's field color")
    Check(field.border == palette.border, "input borders use the subtle palette border")
    spin := Face(StyleKindSpinbox(), ButtonToneNeutral, ButtonEmphasisFilled, 0)
    value := Face(StyleKindSpinboxValue(), ButtonToneNeutral, ButtonEmphasisFilled, 0)
    Check(spin.background == palette.base && value.background == palette.base && spin.foreground == palette.text && value.foreground == palette.text, "spinbox and value share the palette's input colors")
    Check(spin.border == palette.border && spin.focus == palette.selected, "spinbox keeps palette border and keyboard focus colors")
    track := ScrollFace(StyleKindScroll(), 0, false, cast(s32)ButtonStateNormal, 10.0)
    thumb := ScrollFace(StyleKindScrollThumb(), 0, false, cast(s32)ButtonStateNormal, 10.0)
    thumb_hover := ScrollFace(StyleKindScrollThumb(), 0, false, cast(s32)ButtonStateHover, 10.0)
    thumb_pressed := ScrollFace(StyleKindScrollThumb(), 0, false, cast(s32)ButtonStatePressed, 10.0)
    Check(track.value.background == cast(u32)0 && thumb.value.radius == 3.0, "scrollbar has a transparent track and rounded thumb")
    Check(CssLuminance(thumb.value.background) < CssLuminance(bg), "light scrollbar thumb contrasts with its page")
    Check(thumb.value.background != thumb_hover.value.background && thumb_hover.value.background != thumb_pressed.value.background, "scrollbar shows hover and drag feedback")
    dark := SystemPaletteFallback(true)
    Check(SystemPaletteInstall(dark), "dark palette installs without a platform host")
    picture := Face(StyleKindImage(), ButtonToneNeutral, ButtonEmphasisFilled, 0)
    Check(picture.foreground == cast(u32)0xffffffff, "palette preserves bitmap and sprite colours")
    picture_facts := StyleDefaultFacts(StyleKindImage())
    picture_facts.role = ImageLabelRole()
    picture_label := ResolveInstalledStyleRules(Base(), picture_facts, 0)
    Check(picture_label.foreground == dark.text, "missing-picture labels remain readable")
    dark_value := Face(StyleKindSpinboxValue(), ButtonToneNeutral, ButtonEmphasisFilled, 0)
    Check(dark_value.background == dark.base && dark_value.foreground == dark.text, "numeric values remain readable with a dark palette")
    // A dropdown's field, panel and chosen row, which a time picker shares.
    trigger := DropdownFace(0, 0)
    panel := DropdownFace(DropdownPanelRole(), 0)
    chosen_row := DropdownFace(DropdownOptionRole(), cast(s32)ButtonStateSelected)
    Check(trigger.background == CssMix(dark.background, dark.text, 0.10) && trigger.foreground == dark.text &&
        trigger.border == dark.border && trigger.focus == dark.selected, "dark dropdown fields follow the palette")
    Check(panel.background == dark.base && panel.border == dark.border, "dark dropdown menus take the palette's base")
    Check(chosen_row.background == dark.selected && chosen_row.foreground == dark.selected_text, "a dropdown's chosen row takes the selection color")
    dark_thumb := ScrollFace(StyleKindScrollThumb(), 0, false, cast(s32)ButtonStateNormal, 10.0)
    dark_track := ScrollFace(StyleKindScroll(), 0, false, cast(s32)ButtonStateNormal, 10.0)
    Check(dark_track.value.background == cast(u32)0 && CssLuminance(dark_thumb.value.background) > CssLuminance(dark.background), "dark scrollbar follows its palette instead of a light track")
    for mode: cast(s32)0..1 {
        theme := SystemPaletteFallback(mode == 1)
        Check(SystemPaletteInstall(theme), "dialog palette installs")
        facts := StyleDefaultFacts(StyleKindModal())
        facts.role = ModalPanelRole()
        dialog := ResolveInstalledStyleRules(Base(), facts, 0)
        Check(dialog.background == theme.base && dialog.foreground == theme.text && dialog.border == theme.border,
            "dialog panel and text share the light or dark app palette")
        facts.role = ModalScrimRole()
        scrim := ResolveInstalledStyleRules(Base(), facts, 0)
        Check(scrim.background == cast(u32)Untouched, "dialog palette preserves its translucent scrim")
    }
    print("System palette buttons: % failures\n", failures)
    return ifx failures == 0 then 0 else 1
}
