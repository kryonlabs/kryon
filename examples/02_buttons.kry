            trailing_bounds[1] = (Rectangle){origin + 200, 802, 81, 39}
            pill_bounds[1] = (Rectangle){origin + 360, 801, 99, 41}
            icon_bounds[0] = (Rectangle){origin + 297, 748, 40, 40}
            icon_bounds[1] = (Rectangle){origin + 296, 802, 40, 40}
            square_bounds[0] = (Rectangle){origin + 479, 748, 40, 40}
            square_bounds[1] = (Rectangle){origin + 479, 802, 40, 40}
            split_bounds[0] = (Rectangle){origin + 538, 747, 98, 40}
            split_bounds[1] = (Rectangle){origin + 538, 801, 98, 40}
            menu_bounds[0] = (Rectangle){origin + 656, 747, 88, 40}
            menu_bounds[1] = (Rectangle){origin + 656, 801, 88, 40}
        }
        for int column = 0; column < 8; column++ {
            Text((TextProps){.bounds={origin + icon_label_x[column], 720, 88, 22},
                .text=icon_names[column], .font=Text16, .wrap=TextWrapNone})
        }
        for int row = 0; row < 2; row++ {
            tone := tones[row]
            emphasis := emphases[row]
            icon_style: ControlStyle = (ControlStyle){}
            if row == 1 {
                icon_style.normal = (Style){.fields=StyleIconSize, .icon_size=20}
            }
            if current_theme.mode == THEME_MODE_LIGHT { emphasis = ButtonEmphasisSoft }
            Button text_only: {
                bounds = text_bounds[row]
                label = text_labels[row]
                id = id_base + 3000 + row * 20
                tone = tone
                emphasis = emphasis
            }
            Button icon_leading: {
                bounds = leading_bounds[row]
                label = leading_labels[row]
                id = id_base + 3001 + row * 20
                tone = tone
                emphasis = emphasis
                icon_type = leading_icons[row]
            }
            Button icon_trailing: {
                bounds = trailing_bounds[row]
                label = trailing_labels[row]
                id = id_base + 3002 + row * 20
                tone = tone
                emphasis = emphasis
                icon_type = trailing_icons[row]
                icon_placement = IconPlacementTrailing
            }
            Button icon_only: {
                bounds = icon_bounds[row]
                label = leading_labels[row]
                id = id_base + 3003 + row * 20
                tone = tone
                emphasis = emphasis
                icon_type = leading_icons[row]
                icon_only = true
                circle = row == 0
                style = icon_style
            }
            Button pill: {
                bounds = pill_bounds[row]
                label = "Continue"
                id = id_base + 3004 + row * 20
                tone = tone
                emphasis = emphasis
                pill = true
            }
            Button square: {
                bounds = square_bounds[row]
                label = "Add"
                id = id_base + 3005 + row * 20
                tone = tone
                emphasis = emphasis
                icon_type = UI_ICON_TYPE_PLUS
                icon_only = true
                square = true
            }
            SplitButton split: {
                button = (ButtonProps){.bounds=split_bounds[row], .label="Add",
                    .id=id_base + 3006 + row * 20, .tone=tone, .emphasis=emphasis}
                menu_id = id_base + 4000 + row
                items = menu_items
                item_count = 2
                open = &split_open[state_base + row]
            }
            MenuButton dropdown: {
                button = (ButtonProps){.bounds=menu_bounds[row], .label="More",
                    .id=id_base + 3008 + row * 20, .tone=tone, .emphasis=emphasis}
                menu_id = id_base + 4010 + row
                items = menu_items
                item_count = 2
                open = &menu_open[state_base + row]
            }
        }
        Line(origin + 24, 864, origin + 744, 864, GetThemeBorder())
        Text((TextProps){.bounds={origin + 25, 872, 400, 28},
            .text="FULL WIDTH EXAMPLES", .font=Text24, .typeface="semibold", .letter_spacing=1, .wrap=TextWrapNone})
        Button full_run: {
            bounds = {origin + 24, 901, 720, 34}
            label = "Run"
            id = id_base + 5000
            icon_type = UI_ICON_TYPE_PLAY
            full_width = true
            pill = true
            tone = ButtonToneAccent
            style = (ControlStyle){.normal=full_run_style}
        }
        Button full_delete: {
            bounds = {origin + 24, 945, 720, 38}
            label = "Delete"
            id = id_base + 5001
            icon_type = UI_ICON_TYPE_TRASH
            full_width = true
            tone = ButtonToneNeutral
            emphasis = ButtonEmphasisSoft
            style = (ControlStyle){.normal=full_delete_style}
        }
        Text((TextProps){.bounds={origin + 27, 1003, 714, 20},
            .text=footer_label, .font=footer_font, .letter_spacing=footer_spacing, .align=footer_align,
            .color=chrome_theme.colors.icon, .wrap=TextWrapNone})
    }
}
