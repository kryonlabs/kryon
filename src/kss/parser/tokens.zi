// Part of the kss_parser module, loaded by src/kss/kss_parser.zi.
// The token table: lookups, caller overrides, and overlays.

// Token table. Later entries shadow earlier ones; overlays update in place so
// provenance always reflects the winning value. Variant color overrides are
// applied on add, matching the highest precedence layer.

KssFindToken :: (p: KssParser, name: KssName, kind: s32) -> s32 {
    index: s32 = p.token_count - 1
    while index >= 0 {
        if p.tokens[index].kind == kind && KssNameEqualsName(p.tokens[index].name, name) {
            return index
        }
        index = index - 1
    }
    return -1
}

KssApplyOverride :: (p: KssParser, index: s32) -> KssParser {
    override: s32 = 0
    while override < p.override_count {
        if p.tokens[index].kind == cast(s32)KssTokenColor &&
           cast(s32)p.overrides[override].name.count == p.tokens[index].name.length {
            same: bool = true
            byte_index: s32 = 0
            while byte_index < p.tokens[index].name.length {
                if KssLower(cast(u8)p.overrides[override].name[byte_index]) !=
                   KssLower(p.tokens[index].name.bytes[byte_index]) {
                    same = false
                }
                byte_index = byte_index + 1
            }
            if same {
                p.tokens[index].color = p.overrides[override].color
                p.tokens[index].origin = cast(s32)KssOriginVariant
                return p
            }
        }
        override = override + 1
    }
    return p
}

KssAddToken :: (p: KssParser, token: KssToken) -> KssParser {
    if p.token_count >= 128 {
        return KssFail(p, "style token capacity exceeded")
    }
    p.tokens[p.token_count] = token
    p.token_count = p.token_count + 1
    p = KssApplyOverride(p, p.token_count - 1)
    return p
}

// Update an existing token in place: theme overlays and matching environment
// overlays win over base and imported values but keep a single entry.

KssOverlayToken :: (p: KssParser, name: KssName, kind: s32, color: u32,
    number: float32, material: s32, origin: s32) -> KssParser {
    index: s32 = KssFindToken(p, name, kind)
    if index < 0 {
        return KssFailName(p, "unknown overlay token '", name)
    }
    if kind == cast(s32)KssTokenColor {
        p.tokens[index].color = color
    } else if kind == cast(s32)KssTokenMaterial {
        p.tokens[index].material = material
    } else {
        p.tokens[index].number = number
    }
    p.tokens[index].origin = origin
    p.tokens[index].file = p.cursor.file
    p.tokens[index].line = p.cursor.line
    p.tokens[index].column = p.cursor.column
    p = KssApplyOverride(p, index)
    return p
}

KssFindColorToken :: (p: KssParser, name: KssName) -> s32 {
    return KssFindToken(p, name, cast(s32)KssTokenColor)
}

KssColorTokenResult :: struct {
    found: bool
    color: u32
}

#program_export
KssColorTokenValue :: (parser: KssParser,
name: string) -> KssColorTokenResult {
    result: KssColorTokenResult
    result.found = false
    result.color = 0
    index: s32 = KssFindColorToken(parser, KssMakeName(name))
    if index >= 0 {
        result.found = true
        result.color = parser.tokens[index].color
    }
    return result
}

KssFindNumberToken :: (p: KssParser, name: KssName) -> s32 {
    index: s32 = KssFindToken(p, name, cast(s32)KssTokenDuration)
    if index >= 0 {
        return index
    }
    return KssFindToken(p, name, cast(s32)KssTokenLength)
}

KssFindMaterialToken :: (p: KssParser, name: KssName) -> s32 {
    return KssFindToken(p, name, cast(s32)KssTokenMaterial)
}

KssMaterialValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "lightfield") {
        return cast(s32)MaterialLightfield
    }
    if KssNameEquals(name, "flat") {
        return cast(s32)MaterialFlat
    }
    if KssNameEquals(name, "glass") {
        return cast(s32)MaterialGlass
    }
    return -999999
}
