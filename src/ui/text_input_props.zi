#module "text_input_props"
#import "geometry"

SyntaxMode :: enum {
    SyntaxNone = 0
    SyntaxZiran = 1
    SyntaxC = 2
    SyntaxMake = 3
}

TextInputProps :: struct {
    bounds: Rectangle
    text: const char*
    cursor_position: i32
    focused: bool
    cursor_visible: bool
    focus_id: i32
    class_name: i32
}

TextFieldProps :: struct {
    bounds: Rectangle
    text: char*
    text_size: size_t
    cursor_position: i32*
    focused: i32*
    max_codepoints: i32
    focus_id: i32
    commit_pressed: i32*
    secure: bool
    read_only: bool
    class_name: i32
}

TextAreaProps :: struct {
    bounds: Rectangle
    text: char*
    text_size: size_t
    cursor_position: i32*
    focused: i32*
    scroll_y: i32*
    max_codepoints: i32
    focus_id: i32
    placeholder: const char*
    syntax: SyntaxMode
    content_version: i32
    read_only: bool
    wrap: bool
    class_name: i32
}
