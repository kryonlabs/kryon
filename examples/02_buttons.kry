        footer_label: const char* = "KRYON / 2040 / BUILD WHAT'S NEXT"
        footer_align: TextAlign = TextAlignEnd
        footer_font: int = Text14
        footer_spacing: int = 6
        panel_x: int = 1
        panel_border := current_theme.colors.background
        panel_top: Color = {250, 252, 254, 255}
