#module "example_scene"
#import "kryon.h"
#import "kryon_example_font.h"

app "Kryon Scene Tree" {
    size 640 420
    fps 60
    font examples
    scene main
}

sprite_id :: int #global #export

scene main {
    camera := NodeCreate(scene, 0, NODE_CAMERA2D, "camera")
    NodeSetProps(scene, camera, KryCamera2DPropsAlloc(1.0, 1))

    sprite_id = NodeCreate(scene, 0, NODE_SPRITE2D, "player")
    NodeSetPosition(scene, sprite_id, 320.0, 210.0)
    NodeSetProps(scene, sprite_id, KrySprite2DPropsAlloc("tiles/tile.png", 96.0, 96.0))
}
