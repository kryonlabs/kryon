TextSchema :: #import "text_props";
Layout :: #import "std/text_layout";
#import "font_metrics"
#import "control_props"
#import "text_align"

using TextAlign;
using TextSchema.Wrap;

TextMeasurement :: struct { font: s32; typeface: string; style: TextGlyphStyle; }
TextLineMeasure :: #type (string, TextMeasurement) -> s32 #reads;
MeasureTextLine :: (value: string, request: TextMeasurement) -> s32 {
    return GlyphWidth(value, request.font, request.typeface, request.style)
}

MeasureNextTextLine :: (value: string, start: s32, max_width: float32,
    wrap: TextSchema.Wrap, font: s32, typeface: string, style: TextGlyphStyle) -> Layout.Line {
    request := TextMeasurement.{font, typeface, style}
    measure: TextLineMeasure = MeasureTextLine
    mode: Layout.Wrap = .TextWrapNone
    if wrap == cast(TextSchema.Wrap)TextWrapAuto { mode = .TextWrapAuto }
    else if wrap == cast(TextSchema.Wrap)TextWrapAnywhere { mode = .TextWrapAnywhere }
    return Layout.NextLine(value, start, max_width, mode,
        measure, request)
}

// A text laid out every frame measured each line again for every word in
// it, twice a frame: most of a phone frame of chat. While the host's glyph
// metrics hold (see GlyphMetricsRevision), the lines of recent texts are
// kept, found by a hash of the text and its layout inputs.
TEXT_LINE_SLOTS :: 128
TEXT_LINE_ROWS :: 32
TextLineCache :: struct {
    revision: u64
    hash: u64
    count: s64
    face: u64
    glyph_style: TextGlyphStyle
    font: s32
    width: float32
    wrap: s32
    used: u64
    rows: s32
    lines: [TEXT_LINE_ROWS]Layout.Line
}
text_line_cache: [TEXT_LINE_SLOTS]TextLineCache;
text_line_clock: u64;
text_line_last: s32;

TextLineHash :: (value: string) -> u64 {
    hash: u64 = cast(u64)14695981039346656037
    for byte: value { hash = (hash ^ cast(u64)byte) * cast(u64)1099511628211 }
    return hash
}

TextLineCacheMatches :: (entry: *TextLineCache, revision: u64, hash: u64, count: s64, face: u64,
    font: s32, width: float32, wrap: s32, glyph_style: TextGlyphStyle) -> bool {
    return entry.revision == revision && entry.hash == hash && entry.count == count && entry.face == face &&
        entry.font == font && entry.width == width && entry.wrap == wrap &&
        SameTextGlyphStyle(entry.glyph_style, glyph_style)
}

// Auto keeps oversized words intact and uses the core's word boundaries.
// Anywhere instead wraps between complete extended grapheme clusters.
#program_export
NextTextLine :: (value: string, start: s32, max_width: float32,
    wrap: TextSchema.Wrap, font: s32, typeface: string,
    glyph_style: TextGlyphStyle = TextGlyphStyle.{}) -> Layout.Line {
    revision := GlyphMetricsRevision()
    if revision == cast(u64)0 || start < 0 || start > cast(s32)value.count {
        return MeasureNextTextLine(value, start, max_width, wrap, font, typeface, glyph_style)
    }
    hash := TextLineHash(value)
    face := TextLineHash(typeface)
    slot := text_line_last
    if !TextLineCacheMatches(*text_line_cache[slot], revision, hash, value.count, face, font, max_width, cast(s32)wrap, glyph_style) {
        found: bool
        for index: cast(s32)0..TEXT_LINE_SLOTS - 1 {
            if TextLineCacheMatches(*text_line_cache[index], revision, hash, value.count, face, font, max_width, cast(s32)wrap, glyph_style) {
                slot = index
                found = true
                break
            }
        }
        if !found {
            slot = 0
            for index: cast(s32)1..TEXT_LINE_SLOTS - 1 {
                if text_line_cache[index].used < text_line_cache[slot].used { slot = index }
            }
            text_line_cache[slot] = .{.revision = revision, .hash = hash, .count = value.count, .face = face,
                .font = font, .width = max_width, .wrap = cast(s32)wrap, .glyph_style = glyph_style}
        }
        text_line_last = slot
    }
    entry := *text_line_cache[slot]
    text_line_clock += cast(u64)1
    entry.used = text_line_clock
    low: s32
    high := entry.rows
    while low < high {
        middle := (low + high) / 2
        if entry.lines[middle].start < start { low = middle + 1 }
        else { high = middle }
    }
    if low < entry.rows && entry.lines[low].start == start { return entry.lines[low] }
    line := MeasureNextTextLine(value, start, max_width, wrap, font, typeface, glyph_style)
    // Measuring can load a fallback font, which moves the revision.
    if entry.rows < TEXT_LINE_ROWS && GlyphMetricsRevision() == revision {
        row := entry.rows
        while row > low {
            entry.lines[row] = entry.lines[row - 1]
            row -= 1
        }
        entry.lines[low] = line
        entry.rows += 1
    }
    return line
}

#program_export
TextDefaultLineGap :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(4.0 * scale)
}

#program_export
TextLineXFor :: (x: s32, width: s32, line_width: s32, align: s32) -> s32 {
    spare: s32 = width - line_width
    if align == TextAlignCenter { return x + spare / 2 }
    if align == TextAlignEnd { return x + spare }
    return x
}
