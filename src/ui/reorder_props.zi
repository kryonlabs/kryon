#import "geometry"
host_api :: #system_library "host_api";

ReorderItem :: struct {
    id: s32
    bounds: Rectangle
    disabled: s32
}

ReorderList :: struct {
    id: s32
    bounds: Rectangle
    items: *ReorderItem
    item_count: s32
    handle_width: s32
    handle_height: s32
    drag_threshold: s32
    scroll_offset: *s32
    max_scroll: s32
    viewport_top: s32
    viewport_bottom: s32
    auto_scroll_margin: s32
    auto_scroll_step: s32
}

ReorderState :: struct {
    list_id: s32
    item_id: s32
    from_index: s32
    press_y: s32
    press_offset_y: s32
    scroll_start: s32
    dragging: s32
}

ReorderMetrics :: struct {
    handle_width: s32
    drag_threshold: s32
    auto_scroll_margin: s32
    auto_scroll_step: s32
}

ReorderHandlePaint :: struct {
    dot0: Rectangle
    dot1: Rectangle
    dot2: Rectangle
    dot3: Rectangle
    dot4: Rectangle
    dot5: Rectangle
    dot_count: s32
}

ReorderPlaceholderPaint :: struct {
    slot_bounds: Rectangle
    line_bounds: Rectangle
    stroke_width: float32
    radius: float32
    segments: s32
    fill_alpha: float32
    use_slot: s32
}

ReorderListResult :: struct {
    active: s32
    dragging: s32
    committed: s32
    from_index: s32
    to_index: s32
    active_index: s32
    target_index: s32
    active_id: s32
    pointer_y: s32
    drag_delta_y: s32
}

// The host applies the user's pointer motion and scrolling to the list.
#program_export
UpdateReorderList :: (list: ReorderList) -> ReorderListResult #foreign host_api;
