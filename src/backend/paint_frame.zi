// A completed frame owns every byte and mesh point its emitters borrow.
// One thread builds it; after publication another replays it unchanged.
#import "paint_queue"
#import "geometry"
#import "std/vec"
#import "std/byte_text_linux"
using Bitmaps :: #import "bitmap_store";

RecordedBitmap :: struct { id: u32; revision: u64; start: s64; count: s64 }

RecordedPaint :: struct {
    command: QueuedPaint
    value_start: s64
    value_count: s64
    asset_start: s64
    asset_count: s64
    mesh_start: s64
    mesh_count: s64
    bitmap_start: s64
    bitmap_count: s64
}

PaintFrame :: struct {
    commands: Vec(RecordedPaint)
    bytes: Vec(u8)
    points: Vec(Vector2)
    bitmap_pixels: Vec(u32)
    bitmaps: [BITMAP_IMAGE_LIMIT]RecordedBitmap
    bitmap_count: s32
    failed: bool
}

PaintFrameClear :: (frame: *PaintFrame) {
    VecClear(frame.commands)
    VecClear(frame.bytes)
    VecClear(frame.points)
    VecClear(frame.bitmap_pixels)
    frame.bitmap_count = 0
    frame.failed = false
}

PaintFrameClose :: (frame: *PaintFrame) {
    VecFree(frame.commands)
    VecFree(frame.bytes)
    VecFree(frame.points)
    VecFree(frame.bitmap_pixels)
    frame.bitmap_count = 0
    frame.failed = false
}

PaintFrameAppend :: (frame: *PaintFrame, command: QueuedPaint) -> bool {
    if frame.failed { return false }
    kept: RecordedPaint
    kept.command = command
    if Bitmaps.BitmapTagged(command.data.texture_id) {
        // Never leave a tagged handle pointing into mutable session storage
        // on the render thread, including an already released handle.
        kept.command.data.bitmap_revision = 1
        at := Bitmaps.BitmapSlot(command.data.texture_id)
        if at >= 0 {
            item := *Bitmaps.bitmap_images[at]
            found: s32 = -1
            for index: cast(s32)0..frame.bitmap_count - 1 {
                bitmap := frame.bitmaps[index]
                if bitmap.id == item.image.id && bitmap.revision == item.revision { found = index; break }
            }
            if found < 0 {
                count := item.pixels.count
                start := frame.bitmap_pixels.count
                limit := cast(s64)Bitmaps.BITMAP_IMAGE_BYTE_BUDGET / 8
                if frame.bitmap_count >= Bitmaps.BITMAP_IMAGE_LIMIT || count > limit - start ||
                    !VecResizeBounded(frame.bitmap_pixels, start + count, limit) { frame.failed = true; return false }
                for pixel: cast(s64)0..count - 1 { frame.bitmap_pixels[start + pixel] = item.pixels[pixel] }
                found = frame.bitmap_count; frame.bitmap_count += 1
                frame.bitmaps[found] = RecordedBitmap.{item.image.id,item.revision,start,count}
            }
            bitmap := frame.bitmaps[found]
            kept.command.data.texture = item.image
            kept.command.data.bitmap_revision = bitmap.revision
            kept.bitmap_start = bitmap.start; kept.bitmap_count = bitmap.count
        }
    }
    kept.value_start = frame.bytes.count
    kept.value_count = command.data.value.count
    if !BuilderAppend(frame.bytes, command.data.value) { frame.failed = true; return false }
    kept.asset_start = frame.bytes.count
    kept.asset_count = command.data.asset_path.count
    if !BuilderAppend(frame.bytes, command.data.asset_path) { frame.failed = true; return false }
    kept.mesh_start = frame.points.count
    kept.mesh_count = command.data.mesh_points.count
    for point: command.data.mesh_points {
        if !VecPush(frame.points, point) { frame.failed = true; return false }
    }
    // Do not retain pointers into the producer's frame or stack.
    kept.command.data.value = ""
    kept.command.data.asset_path = ""
    empty: []Vector2
    kept.command.data.mesh_points = empty
    empty_pixels: []u32
    kept.command.data.bitmap_pixels = empty_pixels
    if !VecPush(frame.commands, kept) { frame.failed = true; return false }
    return true
}

PaintFrameEmit :: (frame: *PaintFrame) -> bool {
    if frame.failed { return false }
    for index: cast(s64)0..frame.commands.count - 1 {
        kept := frame.commands[index]
        command := kept.command
        if kept.bitmap_count > 0 {
            command.data.bitmap_pixels = VecSlice(frame.bitmap_pixels,kept.bitmap_start,kept.bitmap_start+kept.bitmap_count)
        }
        if kept.value_count > 0 {
            command.data.value = TextFromBytes(BytesFromPointer(
                *frame.bytes[kept.value_start], cast(u64)kept.value_count))
        }
        if kept.asset_count > 0 {
            command.data.asset_path = TextFromBytes(BytesFromPointer(
                *frame.bytes[kept.asset_start], cast(u64)kept.asset_count))
        }
        if kept.mesh_count > 0 {
            descriptor := cast(*PaintFramePoints)(*command.data.mesh_points)
            descriptor.data = *frame.points[kept.mesh_start]
            descriptor.count = kept.mesh_count
        }
        EmitPaintDirect(command)
    }
    return true
}

PaintFramePoints :: struct { data: *Vector2; count: s64 }
