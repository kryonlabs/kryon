#module "text_state_host"
#import "ui_internal.h"
#import "ui/text_rows.h"
#import "ui/text_navigation.h"
#import "runtime/text_rows.h"
#import "runtime/text_input.h"
#import "string.h"

TextAreaHeightCacheEntry :: struct {
    text: const char*
    font: i32
    line_gap: i32
    wrap_width: i32
    len: i32
    content_version: i32
    height: i32
}

TextFieldScrollCacheEntry :: struct {
    id: i32
    owner: *i32
    scroll_x: i32
}

text_area_height_cache :: [16]TextAreaHeightCacheEntry #global
text_area_height_cache_next :: i32 #global
text_field_scroll_cache :: [128]TextFieldScrollCacheEntry #global
text_field_scroll_cache_next :: i32 #global

TextFieldScrollEntryMatches :: (entry: TextFieldScrollCacheEntry,
id: i32, owner: *i32) -> i32 {
    if id > 0 { return entry.id == id }
    return entry.id == 0 && entry.owner == owner
}

ui_text_field_scroll_for :: (id: i32,
owner: *i32) -> *i32 #export {
    empty_slot: i32 = -1
    index: i32 = 0
    while index < 128 {
        if TextFieldScrollEntryMatches(text_field_scroll_cache[index],
        id, owner) {
            return &text_field_scroll_cache[index].scroll_x
        }
        if text_field_scroll_cache[index].id == 0 &&
        text_field_scroll_cache[index].owner == nil &&
        empty_slot < 0 { empty_slot = index }
        index += 1
    }
    slot: i32 = empty_slot
    if slot < 0 {
        slot = text_field_scroll_cache_next
        text_field_scroll_cache_next =
        (text_field_scroll_cache_next + 1) % 128
    }
    text_field_scroll_cache[slot].id = id
    text_field_scroll_cache[slot].owner = id > 0 ? nil : owner
    text_field_scroll_cache[slot].scroll_x = 0
    return &text_field_scroll_cache[slot].scroll_x
}

TextAreaContentHeightUncached :: (text: const char*,
font: i32, line_gap: i32, wrap_width: i32) -> i32 {
    rows: TextRowCursor = ui_text_rows(text, font,
    line_gap, wrap_width, 1, 0)
    row: TextMeasuredRow = (TextMeasuredRow){0}
    while ui_text_row_next(&rows, &row) {
        continue
    }
    return rows.y
}

ui_text_area_content_height :: (text: const char*,
font: i32, line_gap: i32, wrap_width: i32,
content_version: i32, force_recompute: i32) -> i32 #export {
    if text == nil { text = "" }
    length: i32 = (int)strlen(text)
    if content_version == 0 {
        return TextAreaContentHeightUncached(text, font,
        line_gap, wrap_width)
    }
    if !force_recompute {
        index: i32 = 0
        while index < 16 {
            entry: *TextAreaHeightCacheEntry =
            &text_area_height_cache[index]
            if entry->text == text && entry->font == font &&
            entry->line_gap == line_gap &&
            entry->wrap_width == wrap_width && entry->len == length &&
            entry->content_version == content_version {
                return entry->height
            }
            index += 1
        }
    }
    entry: *TextAreaHeightCacheEntry =
    &text_area_height_cache[text_area_height_cache_next]
    entry->text = text
    entry->font = font
    entry->line_gap = line_gap
    entry->wrap_width = wrap_width
    entry->len = length
    entry->content_version = content_version
    entry->height = TextAreaContentHeightUncached(
    text, font, line_gap, wrap_width)
    text_area_height_cache_next =
    (text_area_height_cache_next + 1) % 16
    return entry->height
}

ui_text_area_cursor_from_point :: (text: const char*,
font: i32, line_gap: i32, wrap_width: i32,
x: i32, y: i32, mouse_x: i32, mouse_y: i32,
scroll_y: i32) -> i32 #export {
    rows: TextRowCursor = ui_text_rows(text, font,
    line_gap, wrap_width, 1, 0)
    row: TextMeasuredRow = (TextMeasuredRow){0}
    target_y: i32 = mouse_y - y + scroll_y
    while ui_text_row_next(&rows, &row) {
        if TextRowAtY(row.y, row.height, target_y, row.last) {
            return ui_text_cursor_from_line_x(
            rows.source.data, row.start, row.end,
            row.font, mouse_x - x)
        }
    }
    return (int)rows.source.length
}

ui_text_area_cursor_y :: (text: const char*, cursor: i32,
font: i32, line_gap: i32, wrap_width: i32,
cursor_height: *i32) -> i32 #export {
    rows: TextRowCursor = ui_text_rows(text, font,
    line_gap, wrap_width, 1, 0)
    row: TextMeasuredRow = (TextMeasuredRow){0}
    cursor = TextCursorForLength(cursor, (int)rows.source.length)
    while ui_text_row_next(&rows, &row) {
        if TextRowHasCursor(row.start, row.end,
        row.line_end, cursor) {
            if cursor_height != nil {
                *cursor_height = TextLineHeight(row.font)
            }
            return row.y
        }
    }
    if cursor_height != nil {
        *cursor_height = TextLineHeight(font)
    }
    return rows.y
}

ui_text_area_select_line :: (text: const char*, cursor: i32,
start: *i32, end: *i32) -> i32 #export {
    if text == nil || start == nil || end == nil { return 0 }
    length: i32 = (int)strlen(text)
    cursor = TextCursorForLength(cursor, length)
    if cursor > 0 &&
    (cursor == length || text[cursor] == '\n') {
        cursor -= 1
    }
    *start = ui_text_line_start(text, cursor)
    *end = ui_text_line_end(text, cursor)
    return *end >= *start
}
