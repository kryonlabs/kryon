#module "popup_host"
#import "ui_internal.h"
#import "ui_paint_layers_internal.h"
#import "ui_tree_layout_internal.h"
#import "ui/disabled.h"
#import "ui/input_capture.h"
#import "ui_popup_input_internal.h"
#import "ui_style_internal.h"
#import "runtime/popup_policy.h"

ComposedPopupScope :: struct {
    previous: *ComposedPopupScope
    layers: *PaintLayers
    paint: PaintLayerToken
    input: PopupInputToken
    layout: TreeLayoutScopeState
    disabled: DisabledScopeState
    input_clip: InputClipScopeState
    state: PopupLifecycle
    id: i32
    has_paint: i32
    has_input: i32
    has_clip: i32
    local_open: bool
    open: *bool
}

popup_scope :: *ComposedPopupScope #global

ApplyPopupState :: (state: PopupLifecycle, open: *bool,
context: *PopupInput, id: i32) {
    if state.eligible && !state.decision.tooltip && open != nil {
        *open = state.open
    }
    if state.close_input && context != nil {
        ui_popup_input_close(context, id)
    }
}

EnterPopupScope :: (popup: PopupProps, state: PopupLifecycle,
layers: *PaintLayers) -> i32 {
    context: *PopupInput = nil
    if state.decision.captures_input {
        context = ui_popup_input_bound()
        if layers != nil { context = ui_paint_layers_input(layers) }
    }
    input: PopupInputToken = (PopupInputToken){0}
    if context != nil {
        input = ui_popup_input_begin(context, popup.id,
        state.input_bounds)
    }
    state = PopupLifecycleKeyboard(state,
    IsKeyPressed(KEY_ESCAPE) != 0,
    ui_popup_input_keyboard_captures() != 0)
    ApplyPopupState(state, popup.open, context, popup.id)
    if !state.visible {
        if context != nil { ui_popup_input_end(input) }
        return 0
    }

    scope: *ComposedPopupScope =
    (ComposedPopupScope*)calloc(1, sizeof(ComposedPopupScope))
    if scope == nil { abort() }
    scope->previous = popup_scope
    scope->layers = layers
    scope->input = input
    scope->has_input = context != nil
    scope->state = state
    scope->id = popup.id
    scope->local_open = state.open
    scope->open = popup.open
    if state.decision.tooltip { scope->open = &scope->local_open }
    if layers != nil {
        scope->paint = ui_paint_layer_begin(layers, popup.id)
        scope->has_paint = 1
    } else {
        scope->layout = ui_tree_layout_suspend()
        scope->disabled = ui_disabled_suspend()
        scope->input_clip = ui_input_clip_suspend()
    }
    if state.backdrop_alpha > 0 {
        SetModalCapture(popup.bounds)
        if IsWindowReady() {
            DrawRectangle(0, 0, GetViewWidth(), GetViewHeight(),
            (Color){0, 0, 0, (unsigned char)state.backdrop_alpha})
        }
    }
    PushInputClip(popup.bounds)
    if IsWindowReady() {
        BeginClip((int)popup.bounds.x, (int)popup.bounds.y,
        (int)popup.bounds.width, (int)popup.bounds.height)
        props: ButtonProps = (ButtonProps){0}
        props.tone = ButtonToneNeutral
        props.emphasis = ButtonEmphasisSoft
        props.class_name = popup.class_name
        panel: Style = ui_unpack_style(
        ui_control_style_frame_role_kind(props,
        ButtonStateNormal, 0, 0.0, 0.0, 0.0,
        StyleKindPopup(), PopupPanelRole()).value)
        ui_draw_material(popup.bounds, (Rectangle){0},
        panel.background, panel.border, panel.border,
        panel.radius, panel.border_width, 0, 0, 0,
        panel.focus, 0, panel.opacity, ui_style_fill(panel),
        panel.material)
        scope->has_clip = 1
    }
    popup_scope = scope
    return 1
}

FinishPopupScope :: (scope: *ComposedPopupScope,
close_requested: bool) {
    scope->state = PopupLifecycleFinish(scope->state,
    *scope->open, close_requested)
    *scope->open = scope->state.open
    if !scope->state.visible && scope->layers != nil {
        ui_paint_layers_hide(scope->layers, scope->id)
    } else if scope->state.close_input && scope->has_input {
        ui_popup_input_close(scope->input.context, scope->id)
    }
}

PopupScope :: (popup: PopupProps) -> i32 #export {
    layers: *PaintLayers = ui_frame_paint_layers()
    mouse: Vector2 = ui_mouse_world()
    input: PopupFrameInput = (PopupFrameInput){0}
    input.id = popup.id
    input.bounds = popup.bounds
    input.trigger = popup.trigger
    input.has_open = popup.open != nil
    if popup.open != nil { input.open = *popup.open }
    input.disabled = popup.disabled != 0
    input.trigger_blocked = InputCapturesClick(mouse) != 0
    input.mouse = mouse
    input.right_released =
    IsMouseButtonReleased(MOUSE_BUTTON_RIGHT) != 0
    input.view_width = GetViewWidth()
    input.view_height = GetViewHeight()
    state: PopupLifecycle = PopupLifecycleBegin(popup.flags, input)
    if !state.decision.valid { abort() }
    if !state.eligible { return 0 }
    context: *PopupInput = ui_popup_input_bound()
    if layers != nil { context = ui_paint_layers_input(layers) }
    state = PopupLifecycleRelease(state,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    ReleaseConsumed() != 0,
    CheckCollisionPointRec(mouse, popup.bounds) != 0)
    if state.consume_release { ConsumeRelease() }
    ApplyPopupState(state, popup.open, context, popup.id)
    if !state.visible { return 0 }
    return EnterPopupScope(popup, state, layers)
}

popup_close_scope :: () #export {
    if popup_scope == nil { abort() }
    FinishPopupScope(popup_scope, true)
}

PopupEndScope :: () #export {
    scope: *ComposedPopupScope = popup_scope
    if scope == nil { abort() }
    FinishPopupScope(scope, false)
    if scope->has_clip { EndClip() }
    PopInputClip()
    if scope->has_paint {
        ui_paint_layer_end(scope->paint)
    } else {
        ui_input_clip_resume(scope->input_clip)
        ui_disabled_resume(scope->disabled)
        ui_tree_layout_resume(scope->layout)
    }
    if scope->has_input { ui_popup_input_end(scope->input) }
    popup_scope = scope->previous
    free(scope)
}
