#import "drawing_props"
#import "geometry"
#import "raster"

BevelLines :: struct {
    top: Rectangle
    left: Rectangle
    bottom: Rectangle
    right: Rectangle
}

#program_export
BevelLineBounds :: (x1: s32, y1: s32, x2: s32, y2: s32) -> Rectangle {
    line: Rectangle
    line.x = cast(float32)x1
    line.y = cast(float32)y1
    line.width = cast(float32)(x2 - x1)
    line.height = cast(float32)(y2 - y1)
    return line
}

#program_export
BevelLinesFor :: (x: s32, y: s32, width: s32, height: s32) -> BevelLines {
    lines: BevelLines
    right: s32 = x + width - 1
    bottom: s32 = y + height - 1
    lines.top = BevelLineBounds(x, y, right, y)
    lines.left = BevelLineBounds(x, y, x, bottom)
    lines.bottom = BevelLineBounds(x, bottom, right, bottom)
    lines.right = BevelLineBounds(right, y, right, bottom)
    return lines
}

#program_export
RenderBevel :: (x: s32, y: s32, width: s32, height: s32,
    light: Color, dark: Color) {
    lines: BevelLines = BevelLinesFor(x, y, width, height)
    StrokeLine(lines.top, light)
    StrokeLine(lines.left, light)
    StrokeLine(lines.bottom, dark)
    StrokeLine(lines.right, dark)
}
