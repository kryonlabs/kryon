using UI :: #import "kryon/Widgets";
preview_theme: s32;
preview_installed_theme: s32 = -1;

// The host supplies the selected theme; styling stays ordinary Ziran.
#program_export
SetPreviewTheme :: (theme: s32) { preview_theme = theme }

#program_export
PreviewBackground :: (highlighted: bool) -> Color {
    if preview_theme == 2 {
        if highlighted { return Color.{38, 53, 46, 255} }
        return Color.{24, 34, 31, 255}
    }
    if highlighted { return Color.{220, 226, 212, 255} }
    return Color.{247, 243, 235, 255}
}

#program_export
InstallPreviewStyle :: () {
    if preview_installed_theme == preview_theme { return }
    preview_installed_theme = preview_theme
    rules: StyleRules
    if preview_theme == 0 {
        InstallStyleRules(rules)
        return
    }
    foreground: u32 = 0x202c29ff
    focus: u32 = 0x315e48ff
    surface: u32 = 0xfcfaf5ff
    track: u32 = 0xdce2d4ff
    border: u32 = 0xd9d6caff
    on_accent: u32 = 0xfcfaf5ff
    if preview_theme == 2 {
        foreground = 0xf4efe3ff
        focus = 0xb5d4a9ff
        surface = 0x202e28ff
        track = 0x26352eff
        border = 0x415247ff
        on_accent = 0x17241bff
    }
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.style.fields = cast(u32)StyleField.StyleForeground | cast(u32)StyleField.StyleFocus
    rule.style.foreground = foreground
    rule.style.focus = focus
    rules.items[0] = rule
    rules.count = 1
    kinds: [7]s32 = .{StyleKindButton(), StyleKindCheckbox(), StyleKindSlider(), StyleKindSliderThumb(), StyleKindProgress(), StyleKindToggle(), StyleKindToggleThumb()}
    for index: 0..6 {
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = kinds[index]
        rule.style.fields = cast(u32)StyleField.StyleBackground | cast(u32)StyleField.StyleBorder | cast(u32)StyleField.StyleRadius | cast(u32)StyleField.StyleMaterial
        rule.style.background = ifx index == 0 || index == 3 || index == 6 then surface else track
        rule.style.border = border
        rule.style.radius = 8.0
        rule.style.material = MaterialKind.MaterialFlat
        rule.order = rules.count
        rules.items[rules.count] = rule
        rules.count += 1
    }
    rule.selector = StyleDefaultSelector()
    rule.selector.tone = cast(s32)ButtonTone.ButtonToneAccent
    rule.style.fields = cast(u32)StyleField.StyleBackground | cast(u32)StyleField.StyleForeground | cast(u32)StyleField.StyleBorder
    rule.style.background = focus
    rule.style.foreground = on_accent
    rule.style.border = focus
    rule.order = rules.count
    rules.items[rules.count] = rule
    rules.count += 1
    InstallStyleRules(rules)
}
