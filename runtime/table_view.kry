#module "table_view"
#import "drawing_props"
#import "style"
#import "control_props"

TableViewMetrics :: struct {
    default_row_height: i32
    min_header_height: i32
    default_min_column_width: i32
    header_text_pad_x: i32
    resize_tolerance: i32
    scrollbar_width: i32
}

TableViewLayout :: struct {
    row_height: i32
    header_height: i32
    body: Rectangle
    frozen_rows: i32
    scroll_body_height: i32
    max_scroll: i32
}

TableViewScrollLayout :: struct {
    first: i32
    y_offset: i32
    visible_rows: i32
}

TableViewSelection :: struct {
    row: i32
    column_slot: i32
}

TableViewSelectionClearDecision :: struct {
    row: i32
    column: i32
    changed: bool
}

TableViewSortDecision :: struct {
    selected_row: i32
    selected_column: i32
    sort_column: i32
    sort_direction: i32
    changed: bool
}

TableViewClipboardDecision :: struct {
    copy_selection: bool
    paste: bool
}

TableViewResizeClearDecision :: struct {
    clear: bool
}

TableViewPanelRole :: () -> i32 #export {
    return 2
}

TableViewHeaderRole :: () -> i32 #export {
    return 13
}

TableViewDividerRole :: () -> i32 #export {
    return 18
}

TableViewRowRole :: () -> i32 #export {
    return 21
}

TableViewCellRole :: () -> i32 #export {
    return 22
}

TableViewSelectionRole :: () -> i32 #export {
    return 23
}

TableViewMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

TableViewMetricsFor :: (scale: float, table: StyleFrame, header: StyleFrame,
    cell: StyleFrame, divider: StyleFrame) -> TableViewMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: TableViewMetrics
    metrics.default_row_height = TableViewMetric(table.value.fields,
        (u32)StyleContentOffset, table.value.offset_y, 28.0, scale, false)
    metrics.min_header_height = TableViewMetric(header.value.fields,
        (u32)StyleContentOffset, header.value.offset_y, 30.0, scale, false)
    metrics.default_min_column_width = TableViewMetric(cell.value.fields,
        (u32)StyleContentOffset, cell.value.offset_x, 32.0, scale, false)
    metrics.header_text_pad_x = TableViewMetric(header.value.fields,
        (u32)StylePaddingX, header.value.padding_x, 6.0, scale, true)
    metrics.resize_tolerance = TableViewMetric(divider.value.fields,
        (u32)StylePaddingX, divider.value.padding_x, 5.0, scale, true)
    metrics.scrollbar_width = TableViewMetric(divider.value.fields,
        (u32)StyleContentOffset, divider.value.offset_y, 8.0, scale, true)
    return metrics
}

TableViewRowHeight :: (requested_row_height: i32, scale: float,
    metrics: TableViewMetrics) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    if requested_row_height > 0 {
        height: i32 = (i32)((float)requested_row_height * scale)
        if height > 0 { return height }
    }
    return metrics.default_row_height
}

TableViewHeaderHeight :: (requested_header_height: i32, scale: float,
    metrics: TableViewMetrics) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    height: i32 = metrics.min_header_height
    if requested_header_height > 0 {
        height = (i32)((float)requested_header_height * scale)
    }
    if height < metrics.min_header_height { height = metrics.min_header_height }
    return height
}

TableViewBodyBounds :: (bounds: Rectangle, header_height: i32) -> Rectangle #export {
    body: Rectangle
    body.x = bounds.x
    body.y = bounds.y + (float)header_height
    body.width = bounds.width
    body.height = bounds.height - (float)header_height
    if body.height < 0.0 { body.height = 0.0 }
    return body
}

TableViewFrozenRows :: (requested: i32, row_count: i32, body_height: i32,
    row_height: i32) -> i32 #export {
    frozen: i32 = requested
    if frozen < 0 { frozen = 0 }
    if frozen > row_count { frozen = row_count }
    if row_height <= 0 { row_height = 1 }
    max_frozen: i32 = body_height / row_height
    if max_frozen < 0 { max_frozen = 0 }
    if frozen > max_frozen { frozen = max_frozen }
    return frozen
}

TableViewScrollBodyHeight :: (body_height: i32, frozen_rows: i32,
    row_height: i32) -> i32 #export {
    height: i32 = body_height - frozen_rows * row_height
    if height < 0 { return 0 }
    return height
}

TableViewMaxScroll :: (row_count: i32, frozen_rows: i32, row_height: i32,
    scroll_body_height: i32) -> i32 #export {
    rows: i32 = row_count - frozen_rows
    if rows < 0 { rows = 0 }
    max_scroll: i32 = rows * row_height - scroll_body_height
    if max_scroll < 0 { return 0 }
    return max_scroll
}

TableViewLayoutFor :: (bounds: Rectangle, row_count: i32,
    requested_row_height: i32, requested_header_height: i32,
    requested_frozen_rows: i32, scale: float,
    metrics: TableViewMetrics) -> TableViewLayout #export {
    layout: TableViewLayout
    layout.row_height = TableViewRowHeight(requested_row_height, scale, metrics)
    layout.header_height = TableViewHeaderHeight(requested_header_height, scale, metrics)
    layout.body = TableViewBodyBounds(bounds, layout.header_height)
    layout.frozen_rows = TableViewFrozenRows(requested_frozen_rows, row_count,
        (i32)layout.body.height, layout.row_height)
    layout.scroll_body_height = TableViewScrollBodyHeight((i32)layout.body.height,
        layout.frozen_rows, layout.row_height)
    layout.max_scroll = TableViewMaxScroll(row_count, layout.frozen_rows,
        layout.row_height, layout.scroll_body_height)
    return layout
}

TableViewScrollFor :: (scroll_y: i32, frozen_rows: i32, row_height: i32,
    scroll_body_height: i32) -> TableViewScrollLayout #export {
    layout: TableViewScrollLayout
    if scroll_y < 0 { scroll_y = 0 }
    if row_height <= 0 { row_height = 1 }
    layout.first = frozen_rows + scroll_y / row_height
    layout.y_offset = scroll_y % row_height
    if scroll_body_height <= 0 {
        layout.visible_rows = 0
    } else {
        layout.visible_rows = scroll_body_height / row_height + 1
    }
    return layout
}

TableViewDefaultColumnWidth :: (bounds_width: i32, visible_columns: i32) -> i32 #export {
    if visible_columns <= 0 { return 0 }
    return bounds_width / visible_columns
}

TableViewColumnWidth :: (requested_width: i32, default_width: i32) -> i32 #export {
    if requested_width > 0 { return requested_width }
    return default_width
}

TableViewHeaderBounds :: (bounds: Rectangle, column_x: i32,
    column_width: i32, header_height: i32) -> Rectangle #export {
    header: Rectangle
    header.x = (float)column_x
    header.y = bounds.y
    header.width = (float)column_width
    header.height = (float)header_height
    return header
}

TableViewRowBounds :: (bounds: Rectangle, layout: TableViewLayout,
    row_index: i32, draw_index: i32, scroll: TableViewScrollLayout,
    scrolling: bool) -> Rectangle #export {
    row: Rectangle
    row.x = bounds.x
    if scrolling {
        local: i32 = draw_index - layout.frozen_rows
        row.y = bounds.y + (float)(layout.header_height +
            layout.frozen_rows * layout.row_height +
            local * layout.row_height - scroll.y_offset)
    } else {
        row.y = bounds.y + (float)(layout.header_height +
            row_index * layout.row_height)
    }
    row.width = bounds.width
    row.height = (float)layout.row_height
    return row
}

TableViewCellBounds :: (row: Rectangle, column_x: i32, column_width: i32) -> Rectangle #export {
    cell: Rectangle
    cell.x = (float)column_x
    cell.y = row.y
    cell.width = (float)column_width
    cell.height = row.height
    return cell
}

TableViewViewport :: (bounds: Rectangle, layout: TableViewLayout,
    scrolling: bool) -> Rectangle #export {
    viewport: Rectangle
    viewport.x = bounds.x
    viewport.y = bounds.y + (float)layout.header_height
    viewport.width = bounds.width
    if scrolling {
        viewport.y += (float)(layout.frozen_rows * layout.row_height)
        viewport.height = (float)layout.scroll_body_height
    } else {
        viewport.height = (float)(layout.frozen_rows * layout.row_height)
    }
    if viewport.height < 0.0 { viewport.height = 0.0 }
    return viewport
}

TableViewScrollbarBoundsFor :: (bounds: Rectangle, layout: TableViewLayout,
    scrollbar_width: i32) -> Rectangle #export {
    scrollbar: Rectangle
    scrollbar.x = bounds.x + bounds.width - (float)scrollbar_width
    scrollbar.y = bounds.y + (float)(layout.header_height +
        layout.frozen_rows * layout.row_height)
    scrollbar.width = (float)scrollbar_width
    scrollbar.height = (float)layout.scroll_body_height
    if scrollbar.width < 0.0 { scrollbar.width = 0.0 }
    if scrollbar.height < 0.0 { scrollbar.height = 0.0 }
    return scrollbar
}

TableViewMinimumColumnWidth :: (requested_min_width: i32, scale: float,
    metrics: TableViewMetrics) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    if requested_min_width > 0 {
        width: i32 = (i32)((float)requested_min_width * scale)
        if width > 0 { return width }
    }
    return metrics.default_min_column_width
}

TableViewResizeColumnWidthFor :: (start_width: i32, start_x: i32,
    pointer_x: i32, minimum_width: i32) -> i32 #export {
    width: i32 = start_width + pointer_x - start_x
    if width < minimum_width {
        return minimum_width
    }
    return width
}

TableViewResizeClearFor :: (active: bool, owner_captured: bool,
    content_disabled: bool, released: bool, same_table: bool,
    table_disabled: bool, resizable: bool,
    has_column_widths: bool) -> TableViewResizeClearDecision #export {
    decision: TableViewResizeClearDecision
    if !active {
        return decision
    }
    if owner_captured {
        decision.clear = true
        return decision
    }
    if (content_disabled || released) &&
       (content_disabled || !same_table || table_disabled || !resizable ||
        !has_column_widths) {
        decision.clear = true
    }
    return decision
}

TableViewSelectedRowFor :: (selected_row: i32, row_count: i32) -> i32 #export {
    if row_count <= 0 { return -1 }
    if selected_row < 0 { return 0 }
    if selected_row >= row_count { return row_count - 1 }
    return selected_row
}

TableViewSelectionMoveRow :: (row: i32, row_count: i32,
    direction: i32) -> i32 #export {
    if row_count <= 0 { return -1 }
    row = TableViewSelectedRowFor(row, row_count)
    if direction < 0 && row > 0 { row -= 1 }
    if direction > 0 && row < row_count - 1 { row += 1 }
    return row
}

TableViewColumnSlotFor :: (slot: i32, visible_columns: i32) -> i32 #export {
    if visible_columns <= 0 { return -1 }
    if slot < 0 { return 0 }
    if slot >= visible_columns { return visible_columns - 1 }
    return slot
}

TableViewSelectionMoveColumn :: (slot: i32, visible_columns: i32,
    direction: i32) -> i32 #export {
    if visible_columns <= 0 { return -1 }
    slot = TableViewColumnSlotFor(slot, visible_columns)
    if direction < 0 && slot > 0 { slot -= 1 }
    if direction > 0 && slot < visible_columns - 1 { slot += 1 }
    return slot
}

TableViewSelectionTab :: (row: i32, column_slot: i32, row_count: i32,
    visible_columns: i32, backwards: bool) -> TableViewSelection #export {
    selection: TableViewSelection
    selection.row = TableViewSelectedRowFor(row, row_count)
    selection.column_slot = TableViewColumnSlotFor(column_slot, visible_columns)
    if selection.row < 0 || selection.column_slot < 0 {
        return selection
    }
    if backwards {
        if selection.column_slot > 0 {
            selection.column_slot -= 1
        } else {
            selection.column_slot = visible_columns - 1
            if selection.row > 0 { selection.row -= 1 }
        }
    } else {
        if selection.column_slot < visible_columns - 1 {
            selection.column_slot += 1
        } else {
            selection.column_slot = 0
            if selection.row < row_count - 1 { selection.row += 1 }
        }
    }
    return selection
}

TableViewSelectionClearFor :: (selected_row: i32,
    selected_column: i32) -> TableViewSelectionClearDecision #export {
    decision: TableViewSelectionClearDecision
    decision.row = selected_row
    decision.column = selected_column
    if selected_row >= 0 || selected_column >= 0 {
        decision.row = -1
        decision.column = -1
        decision.changed = true
    }
    return decision
}

TableViewSortDecisionFor :: (column: i32, previous_sort_column: i32,
    previous_sort_direction: i32) -> TableViewSortDecision #export {
    decision: TableViewSortDecision
    decision.selected_row = -1
    decision.selected_column = column
    decision.sort_column = column
    decision.sort_direction = previous_sort_direction
    if column < 0 {
        decision.selected_column = -1
        decision.sort_column = previous_sort_column
        return decision
    }
    if previous_sort_column != column || previous_sort_direction == 0 {
        decision.sort_direction = 1
    } else if previous_sort_direction > 0 {
        decision.sort_direction = -1
    } else {
        decision.sort_direction = 0
    }
    decision.changed = true
    return decision
}

TableViewClipboardDecisionFor :: (modifier_down: bool,
    copy_pressed: bool, cut_pressed: bool, paste_pressed: bool,
    has_paste_target: bool) -> TableViewClipboardDecision #export {
    decision: TableViewClipboardDecision
    if !modifier_down {
        return decision
    }
    decision.copy_selection = copy_pressed || cut_pressed
    decision.paste = paste_pressed && has_paste_target
    return decision
}

TableViewActivationShouldRun :: (clicked_column: i32, same_table: bool,
    last_row: i32, row: i32, last_column: i32, elapsed_seconds: float) -> bool #export {
    if clicked_column < 0 {
        return false
    }
    if !same_table {
        return false
    }
    if last_row != row || last_column != clicked_column {
        return false
    }
    return elapsed_seconds <= 0.45
}

TableViewSelectionScrollOffset :: (row: i32, frozen_rows: i32,
    row_height: i32, view_height: i32, scroll_offset: i32,
    max_scroll: i32) -> i32 #export {
    if scroll_offset < 0 { scroll_offset = 0 }
    if max_scroll < 0 { max_scroll = 0 }
    if row < frozen_rows || view_height <= 0 {
        if scroll_offset > max_scroll { return max_scroll }
        return scroll_offset
    }
    if row_height <= 0 { row_height = 1 }
    top: i32 = (row - frozen_rows) * row_height
    bottom: i32 = top + row_height
    if top < scroll_offset {
        scroll_offset = top
    } else if bottom > scroll_offset + view_height {
        scroll_offset = bottom - view_height
    }
    if scroll_offset < 0 { scroll_offset = 0 }
    if scroll_offset > max_scroll { scroll_offset = max_scroll }
    return scroll_offset
}
