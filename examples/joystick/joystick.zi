Joystick :: #import "kryon/joystick";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
#import "std/number_text"

steps: s32;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace3), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Joystick", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    result := Joystick.Draw(session, Joystick.Props.{.disabled = example_disabled, .bounds = .{width = 180, height = 180}, .label = "Move", .now = now})
    if result.step { steps += 1 }
    digits: [24]u8
    // The step count beside its caption.
    row := Layout.Row(session, Layout.Props.{})
    if row.opened {
        Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{width = 120, height = 28}, .text = "Steps", .size = 14, .vertical_align = .TextAlignCenter})
        Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{width = 60, height = 28}, .text = FormatInteger(cast(s64)steps, digits[:]), .size = 14, .align = .TextAlignEnd, .vertical_align = .TextAlignCenter})
        unused End(session)
    }
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
