#import "kryon.h"

app "UI Buttons Example" {
    size 800 600
    fps 60
    font examples
}

state {
    click_count: int = 0
    last_action: [128] char = "No button clicked yet."
}

ButtonsExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        Text((TextProps){.bounds={Scale(20), Scale(20), 0, 0}, .text="UI Buttons Example", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(20), Scale(54), 0, 0}, .text="Click the buttons below to test interactions", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        if Button((ButtonProps){
            .bounds = {Scale(20), Scale(100), Scale(200), Scale(40)},
            .label = "Primary Button",
            .style = ButtonStylePrimary,
            .id = 101,
        }) {
            click_count++
            snprintf(last_action,sizeof(last_action),"Primary Button clicked.")
        }
        if Button((ButtonProps){
            .bounds = {Scale(20), Scale(150), Scale(200), Scale(40)},
            .label = "Secondary Button",
            .style = ButtonStyleSecondary,
            .id = 102,
        }) {
            click_count++
            snprintf(last_action,sizeof(last_action),"Secondary Button clicked.")
        }
        if Button((ButtonProps){
            .bounds = {Scale(20), Scale(200), Scale(200), Scale(40)},
            .label = "Danger Button",
            .style = ButtonStyleDanger,
            .id = 103,
        }) {
            click_count++
            snprintf(last_action,sizeof(last_action),"Danger Button clicked.")
        }
        Text((TextProps){.bounds={Scale(20), Scale(260), 0, 0}, .text=TextFormat("Clicks:%d",click_count), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(20), Scale(290), 0, 0}, .text=last_action, .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(300), Scale(100), 0, 0}, .text="Button Styles", .font=18, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(300), Scale(130), 0, 0}, .text="Primary,secondary,and danger styles use the active theme.", .font=14, .color=GetThemeIcon(), .wrap=TextWrapNone})
    }
}
