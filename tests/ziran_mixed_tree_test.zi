#import "session"
#import "widget_test_session"

#import "geometry"
#import "progress_props"
#import "progress_widget"
#import "separator_props"
#import "separator_widget"
#import "tree"
#import "tree_draw"
#import "ziran_mixed_tree_host"

using FrameStatus;

#program_export
Frame :: () -> s32 {
    progress: ProgressProps = .{.bounds = Rectangle.{10.0, 20.0, 100.0, 20.0}, .min = 0,
        .max = 100, .value = 50}
    separator: SeparatorProps
    separator.bounds = Rectangle.{20.0, 50.0, 20.0, 40.0}
    separator.vertical = true
    BeginFrame(TestSession(), cast(u64)10, Rectangle.{0.0, 0.0, 200.0, 200.0})
    Progress(TestSession(), progress)
    Separator(TestSession(), separator)
    progress.bounds.y = 100.0
    Progress(TestSession(), progress)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk { return -1 }
    return TreeCount(TestSession())
}

#program_export
main :: () -> s32 {
    if Frame() != 4 || MixedEventCount() != 7 || MixedHostFailed() {
        return 1
    }
    return 0
}
