// Creates a render-target texture with its own framebuffer. Rows stay
// upright like the canvas targets this presenter replaces.
PageGpuTargetCreate :: (width: s32, height: s32, texture_out: *s32,
    framebuffer_out: *s32) -> bool {
    if page_gpu_gl == 0 || page_gpu_lost { return false }
    if width <= 0 || height <= 0 { return false }
    scope: s32 = WebScope()
    gl := page_gpu_gl
    texture := WebAsObject(WebCall0(gl, page_gpu_names.create_texture))
    framebuffer := WebAsObject(WebCall0(gl, page_gpu_names.create_framebuffer))
    ok := texture != 0 && framebuffer != 0
    if ok {
        unused WebCall1(gl, page_gpu_names.active_texture, WebNumber(33984.0))
        unused WebCall2(gl, page_gpu_names.bind_texture, WebNumber(3553.0), WebObject(texture))
        unused PageGpuTextureParams(gl, false)
        args: [9]WebValue
        args[0] = WebNumber(3553.0)
        args[1] = WebNumber(0.0)
        args[2] = WebNumber(6408.0)
        args[3] = WebNumber(cast(float64)width)
        args[4] = WebNumber(cast(float64)height)
        args[5] = WebNumber(0.0)
        args[6] = WebNumber(6408.0)
        args[7] = WebNumber(5121.0)
        args[8] = WebNull()
        unused WebCall(gl, page_gpu_names.tex_image_2d, *args[0], 9)
        args[0] = WebNumber(36160.0)
        args[1] = WebNumber(36064.0)
        args[2] = WebNumber(3553.0)
        args[3] = WebObject(texture)
        args[4] = WebNumber(0.0)
        unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0), WebObject(framebuffer))
        unused WebCall(gl, page_gpu_names.framebuffer_texture_2d, *args[0], 5)
        complete := WebAsNumber(WebCall1(gl, page_gpu_names.check_framebuffer, WebNumber(36160.0)))
        unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0),
            WebObject(page_gpu_bound_framebuffer))
        if complete != 36053.0 { ok = false }
    }
    if !ok {
        if texture != 0 { PageGpuTextureDiscard(gl, texture) }
        if framebuffer != 0 {
            unused WebCall1(gl, page_gpu_names.delete_framebuffer, WebObject(framebuffer))
            WebRelease(framebuffer)
        }
        texture = 0
        framebuffer = 0
    }
    if ok {
        texture = WebKeep(texture)
        framebuffer = WebKeep(framebuffer)
    }
    texture_out.* = texture
    framebuffer_out.* = framebuffer
    WebEnd(scope)
    return ok
}

// Reads a texture's pixels through the shared readback framebuffer.
PageGpuTextureRead :: (texture: s32, width: s32, height: s32,
    pixels: *u8, capacity: s32, premultiplied: bool) -> bool {
    if page_gpu_gl == 0 || page_gpu_lost || texture == 0 || pixels == null { return false }
    if width * height * 4 > capacity { return false }
    scope: s32 = WebScope()
    gl := page_gpu_gl
    PageGpuFlush()
    bound := page_gpu_bound_framebuffer
    args: [5]WebValue
    args[0] = WebNumber(36160.0)
    args[1] = WebNumber(36064.0)
    args[2] = WebNumber(3553.0)
    args[3] = WebObject(texture)
    args[4] = WebNumber(0.0)
    unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0),
        WebObject(page_gpu_read_framebuffer))
    unused WebCall(gl, page_gpu_names.framebuffer_texture_2d, *args[0], 5)
    saved_flip := page_gpu_flip
    saved_height := page_gpu_target_height
    page_gpu_flip = -1.0
    page_gpu_target_height = height
    complete := WebAsNumber(WebCall1(gl, page_gpu_names.check_framebuffer, WebNumber(36160.0)))
    ok := complete == 36053.0 && PageGpuReadPixels(0, 0, width, height, pixels, premultiplied)
    page_gpu_flip = saved_flip
    page_gpu_target_height = saved_height
    args[3] = WebNull()
    unused WebCall(gl, page_gpu_names.framebuffer_texture_2d, *args[0], 5)
    args[3] = WebObject(bound)
    unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0), args[3])
    WebEnd(scope)
    return ok
}

// A lost context keeps the GL object handles but they are dead; drawing
// stops until the browser restores the context and resources rebuild.
PageGpuLost :: (context: s32, event: s32, second: s32, third: s32) {
    unused context
    unused second
    unused third
    if event != 0 { unused WebCall0(event, WebName("preventDefault")) }
    PageGpuFlushSoft()
    page_gpu_lost = true
}

PageGpuFlushSoft :: () {
    page_gpu_vertex_count = 0
    page_gpu_index_count = 0
    page_gpu_run_count = 0
    page_gpu_batch_texture = 0
}

PageGpuRestored :: (context: s32, event: s32, second: s32, third: s32) {
    unused context
    unused event
    unused second
    unused third
    page_gpu_lost = false
    page_gpu_generation += 1
    PageGpuRebuild()
}

PageGpuTextureGeneration :: () -> u64 { return page_gpu_generation }

// Recreates the program and buffers after a context restore. Textures belong
// to their owners and re-upload through their next use.
PageGpuRebuild :: () {
    if page_gpu_gl == 0 { return }
    scope: s32 = WebScope()
    gl := page_gpu_gl
    if page_gpu_size_uniform != 0 { WebRelease(page_gpu_size_uniform) }
    page_gpu_size_uniform = 0
    if page_gpu_flip_uniform != 0 { WebRelease(page_gpu_flip_uniform) }
    page_gpu_flip_uniform = 0
    if page_gpu_sampler_uniform != 0 { WebRelease(page_gpu_sampler_uniform) }
    page_gpu_sampler_uniform = 0
    if page_gpu_program != 0 {
        unused WebCall1(gl, page_gpu_names.delete_program, WebObject(page_gpu_program))
        WebRelease(page_gpu_program)
        page_gpu_program = 0
    }
    if page_gpu_buffer != 0 {
        unused WebCall1(gl, page_gpu_names.delete_buffer, WebObject(page_gpu_buffer))
        WebRelease(page_gpu_buffer)
        page_gpu_buffer = 0
    }
    if page_gpu_elements != 0 {
        unused WebCall1(gl, page_gpu_names.delete_buffer, WebObject(page_gpu_elements))
        WebRelease(page_gpu_elements)
        page_gpu_elements = 0
    }
    ok := PageGpuMakeResources()
    if ok { PageGpuTargetBind(0, page_gpu_surface_width, page_gpu_surface_height) }
    WebEnd(scope)
}

PageGpuMakeResources :: () -> bool {
    gl := page_gpu_gl
    vertex := PageGpuShader(gl, 35633, PageGpuVertexSource)
    fragment := PageGpuShader(gl, 35632, PageGpuFragmentSource)
    ok := vertex != 0 && fragment != 0
    if ok {
        page_gpu_program = WebAsObject(WebCall0(gl, page_gpu_names.create_program))
        ok = page_gpu_program != 0
    }
    if ok {
        unused WebCall2(gl, page_gpu_names.attach_shader, WebObject(page_gpu_program), WebObject(vertex))
        unused WebCall2(gl, page_gpu_names.attach_shader, WebObject(page_gpu_program), WebObject(fragment))
        unused WebCall1(gl, page_gpu_names.link_program, WebObject(page_gpu_program))
        ok = WebAsBool(WebCall2(gl, page_gpu_names.get_program_parameter,
            WebObject(page_gpu_program), WebNumber(35714.0)))
    }
    if vertex != 0 {
        unused WebCall1(gl, page_gpu_names.delete_shader, WebObject(vertex))
        WebRelease(vertex)
    }
    if fragment != 0 {
        unused WebCall1(gl, page_gpu_names.delete_shader, WebObject(fragment))
        WebRelease(fragment)
    }
    if !ok {
        if page_gpu_program != 0 {
            unused WebCall1(gl, page_gpu_names.delete_program, WebObject(page_gpu_program))
            WebRelease(page_gpu_program)
            page_gpu_program = 0
        }
        return false
    }
    page_gpu_program = WebKeep(page_gpu_program)
    page_gpu_buffer = WebAsObject(WebCall0(gl, page_gpu_names.create_buffer))
    page_gpu_elements = WebAsObject(WebCall0(gl, page_gpu_names.create_buffer))
    if page_gpu_buffer == 0 || page_gpu_elements == 0 { return false }
    page_gpu_buffer = WebKeep(page_gpu_buffer)
    page_gpu_elements = WebKeep(page_gpu_elements)
    unused WebCall1(gl, page_gpu_names.use_program, WebObject(page_gpu_program))
    page_gpu_size_uniform = WebAsObject(WebCall2(gl, WebName("getUniformLocation"),
        WebObject(page_gpu_program), WebText("uSize")))
    page_gpu_flip_uniform = WebAsObject(WebCall2(gl, WebName("getUniformLocation"),
        WebObject(page_gpu_program), WebText("uFlip")))
    page_gpu_sampler_uniform = WebAsObject(WebCall2(gl, WebName("getUniformLocation"),
        WebObject(page_gpu_program), WebText("uTex")))
    page_gpu_size_uniform = WebKeep(page_gpu_size_uniform)
    page_gpu_flip_uniform = WebKeep(page_gpu_flip_uniform)
    page_gpu_sampler_uniform = WebKeep(page_gpu_sampler_uniform)
    args: [2]WebValue
    args[0] = WebObject(page_gpu_sampler_uniform)
    args[1] = WebNumber(0.0)
    unused WebCall(gl, page_gpu_names.uniform1i, *args[0], 2)
    unused WebCall2(gl, page_gpu_names.bind_buffer, WebNumber(34962.0), WebObject(page_gpu_buffer))
    unused WebCall2(gl, page_gpu_names.bind_buffer, WebNumber(34963.0), WebObject(page_gpu_elements))
    PageGpuApplyAttributes()
    PageGpuBlendApply()
    return true
}

// Attaches the presenter to a canvas element. The context options keep the
// drawing buffer between composites so damage rects repaint in place.
PageGpuAttach :: (canvas: s32, width: s32, height: s32, dpi: float64,
    transparent: bool) -> bool {
    if page_gpu_attached { PageGpuClose() }
    scope: s32 = WebScope()
    page_gpu_attached = true
    page_gpu_surface_width = width
    page_gpu_surface_height = height
    page_gpu_dpi = dpi
    page_gpu_transparent = transparent
    page_gpu_matrix[0] = dpi
    page_gpu_matrix[3] = dpi
    page_gpu_flip = 1.0
    page_gpu_target_width = width
    page_gpu_target_height = height
    options := WebNewObject()
    WebSet(options, WebName("alpha"), WebBool(true))
    WebSet(options, WebName("premultipliedAlpha"), WebBool(true))
    WebSet(options, WebName("antialias"), WebBool(false))
    WebSet(options, WebName("preserveDrawingBuffer"), WebBool(true))
    WebSet(options, WebName("powerPreference"), WebText("high-performance"))
    gl := WebAsObject(WebCall2(canvas, WebName("getContext"),
        WebText("webgl2"), WebObject(options)))
    if gl == 0 {
        page_gpu_attached = false
        WebEnd(scope)
        return false
    }
    page_gpu_gl = WebKeep(gl)
    page_gpu_canvas = WebKeep(canvas)
    PageGpuInternNames()
    lost := WebFunction(PageGpuLost, 0)
    page_gpu_lost_handler = lost
    restored := WebFunction(PageGpuRestored, 0)
    page_gpu_restored_handler = restored
    unused WebCall2(canvas, WebName("addEventListener"), WebText("webglcontextlost"),
        WebObject(lost))
    unused WebCall2(canvas, WebName("addEventListener"), WebText("webglcontextrestored"),
        WebObject(restored))
    page_gpu_read_framebuffer = WebAsObject(WebCall0(gl, page_gpu_names.create_framebuffer))
    if page_gpu_read_framebuffer != 0 { page_gpu_read_framebuffer = WebKeep(page_gpu_read_framebuffer) }
    ok := PageGpuMakeResources()
    if ok {
        PageGpuTargetBind(0, width, height)
    } else {
        PageGpuClose()
    }
    WebEnd(scope)
    return ok
}

PageGpuClose :: () {
    PageGpuFlushSoft()
    if page_gpu_gl != 0 {
        scope: s32 = WebScope()
        gl := page_gpu_gl
        if page_gpu_lost_handler != 0 {
            unused WebCall2(page_gpu_canvas, WebName("removeEventListener"),
                WebText("webglcontextlost"), WebObject(page_gpu_lost_handler))
            WebRelease(page_gpu_lost_handler)
            page_gpu_lost_handler = 0
        }
        if page_gpu_restored_handler != 0 {
            unused WebCall2(page_gpu_canvas, WebName("removeEventListener"),
                WebText("webglcontextrestored"), WebObject(page_gpu_restored_handler))
            WebRelease(page_gpu_restored_handler)
            page_gpu_restored_handler = 0
        }
        if page_gpu_read_framebuffer != 0 {
            unused WebCall1(gl, page_gpu_names.delete_framebuffer, WebObject(page_gpu_read_framebuffer))
            WebRelease(page_gpu_read_framebuffer)
            page_gpu_read_framebuffer = 0
        }
        if page_gpu_program != 0 {
            unused WebCall1(gl, page_gpu_names.delete_program, WebObject(page_gpu_program))
            WebRelease(page_gpu_program)
            page_gpu_program = 0
        }
        if page_gpu_buffer != 0 {
            unused WebCall1(gl, page_gpu_names.delete_buffer, WebObject(page_gpu_buffer))
            WebRelease(page_gpu_buffer)
            page_gpu_buffer = 0
        }
        if page_gpu_elements != 0 {
            unused WebCall1(gl, page_gpu_names.delete_buffer, WebObject(page_gpu_elements))
            WebRelease(page_gpu_elements)
            page_gpu_elements = 0
        }
        if page_gpu_size_uniform != 0 { WebRelease(page_gpu_size_uniform) }
        page_gpu_size_uniform = 0
        if page_gpu_flip_uniform != 0 { WebRelease(page_gpu_flip_uniform) }
        page_gpu_flip_uniform = 0
        if page_gpu_sampler_uniform != 0 { WebRelease(page_gpu_sampler_uniform) }
        page_gpu_sampler_uniform = 0

        WebRelease(page_gpu_gl)
        WebRelease(page_gpu_canvas)
        WebEnd(scope)
    }
    page_gpu_gl = 0
    page_gpu_canvas = 0
    page_gpu_bound_framebuffer = 0
    page_gpu_attached = false
    page_gpu_lost = false
    page_gpu_scissor_count = 0
    page_gpu_blend = 0
    page_gpu_flip = 1.0
    page_gpu_target_width = 0
    page_gpu_target_height = 0
}

// Presents nothing: the browser composites the preserved drawing buffer on
// its own. Flushing only guarantees the queued batch reached the GL.
PageGpuPresent :: () {
    PageGpuFlush()
}

// A deferred root-frame clear must not alter the current render target,
// camera or clip. glClear changes only the selected framebuffer's pixels.
PageGpuClearRoot :: (r: s32, g: s32, b: s32, a: s32) {
    PageGpuFlush()
    if page_gpu_gl == 0 || page_gpu_lost { return }
    scope := WebScope()
    gl := page_gpu_gl
    unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0), WebNull())
    unused WebCall1(gl, page_gpu_names.disable, WebNumber(3089.0))
    PageGpuClearAll(r, g, b, a)
    unused WebCall2(gl, page_gpu_names.bind_framebuffer, WebNumber(36160.0),
        WebObject(page_gpu_bound_framebuffer))
    PageGpuScissorApply()
    WebEnd(scope)
}
