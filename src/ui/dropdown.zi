#import "geometry"
#import "style"
#import "button"
#import "surface"
#import "control_props"

# Roles select semantic facts for host-side style resolution. They do not
# manufacture color, material, gradient, radius, or border recipes.
# 0: trigger, 2: floating panel, 26: option row, 27: scrollbar.
#program_export
DropdownPanelRole :: () -> s32 {
    return 2
}

#program_export
DropdownOptionRole :: () -> s32 {
    return 26
}

#program_export
DropdownScrollbarRole :: () -> s32 {
    return 27
}

#program_export
Appearance :: (base: StyleData, accent: StyleData, role: s32,
    state: s32, selected: bool) -> StyleData {
    if role == DropdownOptionRole() && selected && state != ButtonStateDisabled {
        return accent
    }
    return base
}

ContentMetrics :: struct {
    padding: float32
    gap: float32
    icon: float32
    font: float32
}

DropdownTriggerMetrics :: struct {
    min_width: s32
    min_height: s32
    indicator_padding: s32
    indicator_size: s32
    text_indicator_gap: s32
}

DropdownTriggerContent :: struct {
    icon_bounds: Rectangle
    text_bounds: Rectangle
    clip_bounds: Rectangle
    indicator_center_x: s32
    indicator_center_y: s32
}

DropdownTriggerInput :: struct {
    enter: bool
    space: bool
    down: bool
}

DropdownMenuInput :: struct {
    navigating: bool
    up: bool
    down: bool
    home: bool
    end: bool
    commit: bool
    escape: bool
}

DropdownOpenDecision :: struct {
    open: bool
    changed: bool
    opened: bool
    closed: bool
}

# Both native hosts consume Button's resolved content metrics. Geometry does
# not silently select another size: the standard dropdown uses medium tokens.
#program_export
Content :: (paint: StyleData, scale: float32) -> ContentMetrics {
    if scale <= 0.0 { scale = 1.0 }
    return ContentMetrics.{.padding = paint.padding_x * scale,
        .gap = paint.gap * scale, .icon = paint.icon_size * scale,
        .font = paint.font_size * scale}
}

DropdownMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
DropdownTriggerMetricsFor :: (scale: float32, trigger: StyleFrame) -> DropdownTriggerMetrics {
    if scale <= 0.0 { scale = 1.0 }
    metrics: DropdownTriggerMetrics
    metrics.min_width = cast(s32)(32.0 * scale)
    metrics.min_height = cast(s32)(24.0 * scale)
    metrics.indicator_padding = DropdownMetric(trigger.value.fields,
        cast(u32)StyleContentOffset, trigger.value.offset_x, 24.0, scale, true)
    metrics.indicator_size = DropdownMetric(trigger.value.fields,
        cast(u32)StyleIconSize, trigger.value.icon_size, 10.0, scale, true)
    metrics.text_indicator_gap = DropdownMetric(trigger.value.fields,
        cast(u32)StyleGap, trigger.value.gap, 8.0, scale, true)
    return metrics
}

DropdownIndicator :: struct {
    x1: s32
    y1: s32
    x2: s32
    y2: s32
    x3: s32
    y3: s32
    x4: s32
    y4: s32
}

#program_export
DropdownIndicatorFor :: (center_x: s32, center_y: s32, size: s32,
    open: bool) -> DropdownIndicator {
    if size < 0 { size = 0 }
    half: s32 = size / 2
    left: s32 = center_x - half
    right: s32 = center_x + half
    upper: s32 = center_y - half / 2
    lower: s32 = center_y + half / 2

    if open {
        return DropdownIndicator.{.x1 = left, .y1 = lower,
            .x2 = center_x, .y2 = upper, .x3 = center_x, .y3 = upper,
            .x4 = right, .y4 = lower}
    }
    return DropdownIndicator.{.x1 = left, .y1 = upper,
        .x2 = center_x, .y2 = lower, .x3 = center_x, .y3 = lower,
        .x4 = right, .y4 = upper}
}

#program_export
DropdownTriggerContentFor :: (bounds: Rectangle, content: ContentMetrics,
    metrics: DropdownTriggerMetrics, has_icon: bool) -> DropdownTriggerContent {
    layout: DropdownTriggerContent
    text_x: float32 = bounds.x + content.padding
    text_right: float32

    layout.indicator_center_x = cast(s32)(bounds.x + bounds.width) -
        metrics.indicator_padding
    layout.indicator_center_y = cast(s32)bounds.y + cast(s32)bounds.height / 2
    if has_icon {
        layout.icon_bounds.x = text_x
        layout.icon_bounds.y = bounds.y + (bounds.height - content.icon) / 2.0
        layout.icon_bounds.width = content.icon
        layout.icon_bounds.height = content.icon
        text_x += content.icon + content.gap
    }
    text_right = cast(float32)(layout.indicator_center_x -
        metrics.indicator_size - metrics.text_indicator_gap)
    layout.clip_bounds.x = text_x
    layout.clip_bounds.y = bounds.y
    layout.clip_bounds.width = text_right - text_x
    layout.clip_bounds.height = bounds.height
    if layout.clip_bounds.width < 0.0 {
        layout.clip_bounds.width = 0.0
    }
    layout.text_bounds = layout.clip_bounds
    return layout
}

# Portable input and popup policy. Hosts supply input samples and option
# availability; no host reimplements navigation, dismissal, or geometry.
#program_export
ClampIndex :: (value: s32, count: s32) -> s32 {
    if count <= 0 {
        return -1
    }
    if value < 0 {
        return 0
    }
    if value >= count {
        return count - 1
    }
    return value
}

#program_export
DropdownOptionCountFor :: (count: s32) -> s32 {
    if count < 0 { return 0 }
    return count
}

#program_export
DropdownCurrentIndexFor :: (selected: s32, count: s32) -> s32 {
    index: s32 = ClampIndex(selected, count)
    if index < 0 { return 0 }
    return index
}

#program_export
Trigger :: (open: bool, disabled: bool, count: s32, focused: bool,
    keyboard: bool, activated: bool, enter: bool, space: bool, down: bool) -> bool {
    if disabled || count <= 0 {
        return false
    }
    if activated {
        return !open
    }
    if !open && focused && keyboard && (enter || space || down) {
        return true
    }
    return open
}

#program_export
DropdownTriggerInputFor :: (enter_pressed: bool, keypad_enter_pressed: bool,
    space_pressed: bool, down_pressed: bool) -> DropdownTriggerInput {
    input: DropdownTriggerInput
    input.enter = enter_pressed || keypad_enter_pressed
    input.space = space_pressed
    input.down = down_pressed
    return input
}

#program_export
DropdownMenuInputFor :: (keyboard_available: bool, opening: bool,
    up_pressed: bool, down_pressed: bool, home_pressed: bool,
    end_pressed: bool, enter_pressed: bool, keypad_enter_pressed: bool,
    escape_pressed: bool) -> DropdownMenuInput {
    input: DropdownMenuInput
    if !keyboard_available {
        return input
    }
    input.escape = escape_pressed
    if !opening {
        input.up = up_pressed
        input.down = down_pressed
        input.home = home_pressed
        input.end = end_pressed
        input.navigating = input.up || input.down || input.home || input.end
        input.commit = enter_pressed || keypad_enter_pressed
    }
    return input
}

#program_export
Dismiss :: (open: bool, opening: bool, count: s32, height: float32,
    escape: bool, lost_focus: bool, outside: bool) -> bool {
    return open && (count <= 0 || height <= 0.0 || escape || lost_focus || (!opening && outside))
}

#program_export
DropdownOpenDecisionFor :: (open: bool, disabled: bool, count: s32,
    focused: bool, keyboard: bool, activated: bool,
    trigger: DropdownTriggerInput, height: float32, escape: bool,
    lost_focus: bool, outside: bool) -> DropdownOpenDecision {
    decision: DropdownOpenDecision
    next: bool = Trigger(open, disabled, count, focused, keyboard, activated,
        trigger.enter, trigger.space, trigger.down)
    opening: bool = next != open && next
    if Dismiss(next, opening, count, height, escape, lost_focus, outside) {
        next = false
    }
    decision.open = next
    decision.changed = next != open
    decision.opened = decision.changed && next
    decision.closed = decision.changed && !next
    return decision
}

#program_export
DropdownOpenAfterCommit :: (open: bool, committed: bool) -> DropdownOpenDecision {
    decision: DropdownOpenDecision
    decision.open = open
    if committed {
        decision.open = false
    }
    decision.changed = decision.open != open
    decision.opened = decision.changed && decision.open
    decision.closed = decision.changed && !decision.open
    return decision
}

Navigation :: struct {
    index: s32
    previous: s32
    count: s32
    direction: s32
    phase: s32
    searching: bool
    result: s32
}

#program_export
StartNavigation :: (current: s32, count: s32, up: bool, down: bool,
    home: bool, end: bool) -> Navigation {
    current = ClampIndex(current, count)
    nav: Navigation = Navigation.{.index = current, .previous = current,
        .count = count, .direction = 1, .searching = count > 0, .result = -1}
    if up {
        nav.index = ClampIndex(current - 1, count)
        nav.direction = -1
    } else if down {
        nav.index = ClampIndex(current + 1, count)
    } else if home {
        nav.index = 0
    } else if end {
        nav.index = count - 1
        nav.direction = -1
    }
    return nav
}

# The host only looks up the availability of nav.index. This bounded scan
# includes boundary fallback and handles all-disabled lists without activation.
#program_export
ScanNavigation :: (nav: Navigation, enabled: bool) -> Navigation {
    if !nav.searching {
        return nav
    }
    if enabled {
        nav.result = nav.index
        nav.searching = false
        return nav
    }
    if nav.phase == 1 {
        nav.phase = 2
        nav.direction = -nav.direction
    }
    nav.index += nav.direction
    if nav.index < 0 || nav.index >= nav.count {
        if nav.phase == 0 {
            nav.index = nav.previous
            nav.phase = 1
        } else {
            nav.searching = false
            nav.result = -1
        }
    }
    return nav
}

#program_export
CanCommit :: (enabled: bool, opening: bool, keyboard: bool, enter: bool,
    pointer: bool, scrollbar: bool, dragging: bool, returned: bool) -> bool {
    return enabled && !opening && ((keyboard && enter) ||
        (pointer && !scrollbar && (!dragging || returned)))
}

#program_export
ContentHeight :: (count: s32, row: float32, padding: float32) -> s32 {
    height: float64 = cast(float64)count * cast(float64)row + cast(float64)padding
    if height <= 0.0 {
        return 0
    }
    if height >= 2147483647.0 {
        return 2147483647
    }
    return cast(s32)height
}

MenuLayout :: struct {
    content_bounds: Rectangle
    scrollbar_bounds: Rectangle
    option_width: s32
    content_height: s32
    max_scroll: s32
}

OptionPaint :: struct {
    option_y: s32
    visible_bounds: Rectangle
    highlight_bounds: Rectangle
}

DropdownOptionContent :: struct {
    icon_bounds: Rectangle
    text_bounds: Rectangle
    clip_bounds: Rectangle
    check_bounds: Rectangle
    separator_bounds: Rectangle
}

DropdownMenuMetrics :: struct {
    padding_top: s32
    padding_bottom: s32
    scrollbar_width: s32
    scrollbar_gap: s32
    scrollbar_track_inset: s32
    highlight_inset_x: s32
    highlight_inset_y: s32
    separator_inset: s32
    drag_threshold: s32
}

#program_export
DropdownMenuMetricsFor :: (scale: float32, panel: StyleFrame,
    option: StyleFrame, scrollbar: StyleFrame) -> DropdownMenuMetrics {
    metrics: DropdownMenuMetrics
    metrics.padding_top = DropdownMetric(panel.value.fields,
        cast(u32)StylePaddingY, panel.value.padding_y, 4.0, scale, true)
    metrics.padding_bottom = metrics.padding_top
    metrics.scrollbar_width = DropdownMetric(scrollbar.value.fields,
        cast(u32)StyleIconSize, scrollbar.value.icon_size, 8.0, scale, true)
    metrics.scrollbar_gap = DropdownMetric(scrollbar.value.fields,
        cast(u32)StyleGap, scrollbar.value.gap, 2.0, scale, true)
    metrics.scrollbar_track_inset = DropdownMetric(scrollbar.value.fields,
        cast(u32)StylePaddingY, scrollbar.value.padding_y, 2.0, scale, true)
    metrics.highlight_inset_x = DropdownMetric(option.value.fields,
        cast(u32)StylePaddingX, option.value.padding_x, 4.0, scale, true)
    metrics.highlight_inset_y = DropdownMetric(option.value.fields,
        cast(u32)StylePaddingY, option.value.padding_y, 2.0, scale, true)
    metrics.separator_inset = DropdownMetric(option.value.fields,
        cast(u32)StyleContentOffset, option.value.offset_x, 16.0, scale, true)
    metrics.drag_threshold = DropdownMetric(scrollbar.value.fields,
        cast(u32)StyleContentOffset, scrollbar.value.offset_x, 8.0, scale, false)
    return metrics
}

#program_export
MenuLayoutFor :: (bounds: Rectangle, count: s32, row_height: s32,
    padding_top: s32, padding_bottom: s32, scrollbar_width: s32,
    scrollbar_gap: s32) -> MenuLayout {
    layout: MenuLayout
    layout.content_height = ContentHeight(count, cast(float32)row_height,
        cast(float32)(padding_top + padding_bottom))
    layout.max_scroll = layout.content_height - cast(s32)bounds.height
    if layout.max_scroll < 0 { layout.max_scroll = 0 }
    layout.option_width = cast(s32)bounds.width
    if layout.max_scroll > 0 {
        layout.option_width -= scrollbar_width + scrollbar_gap
        if layout.option_width < 0 { layout.option_width = 0 }
    }
    layout.content_bounds.x = bounds.x
    layout.content_bounds.y = bounds.y + cast(float32)padding_top
    layout.content_bounds.width = cast(float32)layout.option_width
    layout.content_bounds.height = bounds.height - cast(float32)(padding_top + padding_bottom)
    if layout.content_bounds.height < 0.0 { layout.content_bounds.height = 0.0 }
    layout.scrollbar_bounds.x = bounds.x + bounds.width - cast(float32)scrollbar_width
    layout.scrollbar_bounds.y = bounds.y
    layout.scrollbar_bounds.width = cast(float32)scrollbar_width
    layout.scrollbar_bounds.height = bounds.height
    if layout.scrollbar_bounds.width < 0.0 { layout.scrollbar_bounds.width = 0.0 }
    if layout.scrollbar_bounds.height < 0.0 { layout.scrollbar_bounds.height = 0.0 }
    return layout
}

#program_export
ScrollbarTrackBounds :: (scrollbar: Rectangle, inset: s32) -> Rectangle {
    track: Rectangle = scrollbar
    track.y += cast(float32)inset
    track.height -= cast(float32)(inset * 2)
    if track.height < 0.0 { track.height = 0.0 }
    return track
}

#program_export
OptionPaintFor :: (menu: Rectangle, option_width: s32, index: s32,
    row_height: s32, scroll_offset: s32, padding_top: s32,
    padding_bottom: s32, highlight_inset_x: s32,
    highlight_inset_y: s32) -> OptionPaint {
    paint: OptionPaint
    option_bottom: s32
    visible_bottom: s32
    content_top: s32 = cast(s32)menu.y + padding_top
    content_bottom: s32 = cast(s32)(menu.y + menu.height) - padding_bottom

    paint.option_y = cast(s32)(cast(s64)(cast(s32)menu.y) + cast(s64)padding_top +
        cast(s64)index * cast(s64)row_height - cast(s64)scroll_offset)
    option_bottom = paint.option_y + row_height
    paint.visible_bounds.x = menu.x
    paint.visible_bounds.y = cast(float32)paint.option_y
    if cast(s32)paint.visible_bounds.y < content_top {
        paint.visible_bounds.y = cast(float32)content_top
    }
    visible_bottom = option_bottom
    if visible_bottom > content_bottom { visible_bottom = content_bottom }
    paint.visible_bounds.width = cast(float32)option_width
    paint.visible_bounds.height = cast(float32)visible_bottom - paint.visible_bounds.y
    if paint.visible_bounds.height < 0.0 { paint.visible_bounds.height = 0.0 }
    paint.highlight_bounds.x = menu.x + cast(float32)highlight_inset_x
    paint.highlight_bounds.y = cast(float32)(paint.option_y + highlight_inset_y)
    paint.highlight_bounds.width = cast(float32)(option_width - highlight_inset_x * 2)
    paint.highlight_bounds.height = cast(float32)(row_height - highlight_inset_y * 2)
    if paint.highlight_bounds.width < 0.0 { paint.highlight_bounds.width = 0.0 }
    if paint.highlight_bounds.height < 0.0 { paint.highlight_bounds.height = 0.0 }
    return paint
}

#program_export
DropdownOptionContentFor :: (row: Rectangle, visible: Rectangle,
    content: ContentMetrics, metrics: DropdownMenuMetrics,
    has_icon: bool) -> DropdownOptionContent {
    layout: DropdownOptionContent
    text_x: float32 = row.x + content.padding
    text_right: float32 = row.x + row.width - content.padding -
        content.icon - content.gap

    layout.separator_bounds.x = row.x + cast(float32)metrics.separator_inset
    layout.separator_bounds.y = row.y
    layout.separator_bounds.width = row.width -
        cast(float32)(metrics.separator_inset * 2)
    if layout.separator_bounds.width < 0.0 {
        layout.separator_bounds.width = 0.0
    }

    if has_icon {
        layout.icon_bounds.x = text_x
        layout.icon_bounds.y = row.y + (row.height - content.icon) / 2.0
        layout.icon_bounds.width = content.icon
        layout.icon_bounds.height = content.icon
        text_x += content.icon + content.gap
    }

    layout.clip_bounds.x = text_x
    layout.clip_bounds.y = visible.y
    layout.clip_bounds.width = text_right - text_x
    layout.clip_bounds.height = visible.height
    if layout.clip_bounds.width < 0.0 {
        layout.clip_bounds.width = 0.0
    }
    if layout.clip_bounds.height < 0.0 {
        layout.clip_bounds.height = 0.0
    }

    layout.text_bounds = layout.clip_bounds
    layout.text_bounds.y = row.y
    layout.text_bounds.height = row.height

    layout.check_bounds.x = row.x + row.width - content.padding - content.icon
    layout.check_bounds.y = row.y + (row.height - content.icon) / 2.0
    layout.check_bounds.width = content.icon
    layout.check_bounds.height = content.icon
    return layout
}

#program_export
PopupBounds :: (button: Rectangle, view: Rectangle, count: s32,
    scale: float32, panel: StyleFrame) -> Rectangle {
    if scale <= 0.0 {
        scale = 1.0
    }
    gap: float32 = cast(float32)DropdownMetric(panel.value.fields, cast(u32)StyleGap,
        panel.value.gap, 4.0, scale, true)
    padding: float32 = cast(float32)DropdownMetric(panel.value.fields,
        cast(u32)StylePaddingY, panel.value.padding_y, 8.0, scale, true)
    margin: float32 = cast(float32)DropdownMetric(panel.value.fields,
        cast(u32)StyleContentOffset, panel.value.offset_y, 16.0, scale, true)
    bottom: float32 = view.y + view.height
    below_y: float32 = button.y + button.height + gap
    if below_y < view.y {
        below_y = view.y
    }
    below: float32 = bottom - below_y - margin
    above: float32 = button.y - view.y - margin
    if below < 0.0 {
        below = 0.0
    }
    if above < 0.0 {
        above = 0.0
    }
    available: float32 = below
    if above > available {
        available = above
    }
    height: float32 = cast(float32)ContentHeight(count, button.height,
        padding * 2.0)
    if height > available && button.height > 0.0 {
        rows: s32 = cast(s32)((available - padding * 2.0) /
            button.height)
        if rows < 1 {
            rows = 1
        }
        height = cast(float32)ContentHeight(rows, button.height,
            padding * 2.0)
    }
    y: float32 = below_y
    if height > below && above > below {
        y = button.y - gap - height
    }
    if height > view.height {
        height = view.height
    }
    if height < 0.0 {
        height = 0.0
    }
    if y > bottom - height {
        y = bottom - height
    }
    if y < view.y {
        y = view.y
    }
    width: float32 = button.width
    if width > view.width {
        width = view.width
    }
    if width < 0.0 {
        width = 0.0
    }
    x: float32 = button.x
    if x > view.x + view.width - width {
        x = view.x + view.width - width
    }
    if x < view.x {
        x = view.x
    }
    return Rectangle.{.x = x, .y = y, .width = width, .height = height}
}

#program_export
ScrollOffset :: (offset: float64, maximum: s32) -> s32 {
    if maximum < 0 {
        maximum = 0
    }
    if offset <= 0.0 {
        return 0
    }
    if offset >= cast(float64)maximum {
        return maximum
    }
    return cast(s32)offset
}

#program_export
RevealRow :: (offset: s32, index: s32, row: float32, viewport: float32, maximum: s32) -> s32 {
    if index < 0 {
        return ScrollOffset(cast(float64)offset, maximum)
    }
    top: float64 = cast(float64)index * cast(float64)row
    next: float64 = cast(float64)offset
    if top < next {
        next = top
    }
    if top + cast(float64)row > next + cast(float64)viewport {
        next = top + cast(float64)row - cast(float64)viewport
    }
    return ScrollOffset(next, maximum)
}

#program_export
WheelOffset :: (offset: s32, wheel: float32, row: float32, maximum: s32) -> s32 {
    return ScrollOffset(cast(float64)offset - cast(float64)wheel * cast(float64)row, maximum)
}

VisibleRows :: struct {
    first: s32
    end: s32
}

#program_export
Rows :: (count: s32, offset: s32, viewport: float32, row: float32) -> VisibleRows {
    result: VisibleRows
    if count <= 0 || row <= 0.0 || viewport <= 0.0 {
        return result
    }
    result.first = cast(s32)(cast(float32)offset / row)
    if result.first < 0 {
        result.first = 0
    }
    if result.first > count {
        result.first = count
    }
    bottom: float64 = (cast(float64)offset + cast(float64)viewport) / cast(float64)row
    if bottom >= cast(float64)count {
        result.end = count
    } else {
        result.end = cast(s32)bottom
        if cast(float64)result.end < bottom {
            result.end += 1
        }
    }
    return result
}

PopupGesture :: struct {
    pressed: bool
    dragging: bool
    origin_y: float32
    origin_offset: s32
    offset: s32
}

#program_export
PopupDragGesture :: (gesture: PopupGesture, offset: s32, down: bool, inside: bool,
    scrollbar: bool, y: float32, maximum: s32, threshold: float32) -> PopupGesture {
    gesture.offset = ScrollOffset(cast(float64)offset, maximum)
    if down && !scrollbar {
        if !gesture.pressed && inside {
            gesture.pressed = true
            gesture.origin_y = y
            gesture.origin_offset = gesture.offset
            gesture.dragging = false
        } else if gesture.pressed && !gesture.dragging {
            delta: float32 = y - gesture.origin_y
            if maximum > 0 && (delta > threshold || delta < -threshold) {
                gesture.dragging = true
            }
        }
        if gesture.dragging && maximum > 0 {
            gesture.offset = ScrollOffset(cast(float64)gesture.offset - cast(float64)(y - gesture.origin_y), maximum)
            gesture.origin_y = y
        }
    } else {
        gesture.pressed = false
    }
    return gesture
}

#program_export
DropdownJustOpenedNext :: (just_opened: bool, pointer_pressed: bool) -> bool {
    return just_opened && pointer_pressed
}

#program_export
DropdownScrollbarPressedNext :: (pressed: bool, pointer_down: bool,
    pointer_pressed: bool, max_scroll: s32, pointer_over_scrollbar: bool) -> bool {
    if !pointer_down {
        return false
    }
    return pressed || (max_scroll > 0 && pointer_pressed && pointer_over_scrollbar)
}
