#module "paragraph"
#import "text_align"

ParagraphMetrics :: struct {
    font: i32
    line_gap: i32
    icon_size: i32
    width: i32
    height: i32
    next_y: i32
}

ParagraphLayoutPolicy :: struct {
    space_width: i32
    icon_spacing: i32
    line_gap: i32
}

ParagraphToken :: struct {
    start: i32
    end: i32
    next: i32
    valid: bool
    line_break: bool
    icon: bool
}

ParagraphLine :: struct {
    start: i32
    end: i32
    width: float
    has_content: bool
}

ParagraphLineDecision :: struct {
    line: ParagraphLine
    next: ParagraphLine
    emit: bool
}

# Hosts copy these borrowed byte ranges and measure their text. Whitespace,
# explicit line breaks and inline icon recognition are shared language policy.
# Non-breaking spaces and other UTF-8 sequences remain inside their word.
ParagraphIsSpace :: (value: u8) -> bool {
    return value == (u8)32 || value == (u8)9 ||
    value == (u8)11 || value == (u8)12
}

ParagraphTokenNext :: (text: string, offset: i32, icons: bool) -> ParagraphToken #export {
    token: ParagraphToken
    if offset < 0 {
        offset = 0
    }
    while offset < text.length && ParagraphIsSpace(text[offset]) {
        offset += 1
    }
    token.start = offset
    token.end = offset
    token.next = offset
    if offset >= text.length {
        return token
    }
    token.valid = true
    value: u8 = text[offset]
    if value == (u8)10 || value == (u8)13 {
        token.line_break = true
        offset += 1
        if value == (u8)13 && offset < text.length && text[offset] == (u8)10 {
            offset += 1
        }
    } else if icons && value == (u8)37 && offset + 1 < text.length &&
    text[offset + 1] == (u8)105 {
        token.icon = true
        offset += 2
    } else {
        while offset < text.length {
            value = text[offset]
            if ParagraphIsSpace(value) || value == (u8)10 || value == (u8)13 {
                break
            }
            if icons && value == (u8)37 && offset + 1 < text.length &&
            text[offset + 1] == (u8)105 {
                break
            }
            offset += 1
        }
    }
    token.end = offset
    token.next = offset
    return token
}

ParagraphTextSeparator :: (line: ParagraphLine) -> string #export {
    if line.has_content {
        return " "
    }
    return ""
}

# The host supplies both the standalone element width and the measured joined
# candidate (including shaping/letter spacing). No renderer chooses wrap points.
# An oversized first element stays on its line; it never emits a phantom blank.
ParagraphLineAdvance :: (line: ParagraphLine, index: i32,
line_break: bool, end: bool, element_width: float, candidate_width: float,
max_width: float) -> ParagraphLineDecision #export {
    decision: ParagraphLineDecision
    decision.next = line
    if line_break || end {
        decision.emit = true
        decision.line = line
        decision.next = (ParagraphLine){.start = index + 1, .end = index + 1}
        return decision
    }
    if element_width < 0.0 {
        element_width = 0.0
    }
    if candidate_width < 0.0 {
        candidate_width = 0.0
    }
    if line.has_content && max_width > 0.0 && candidate_width > max_width {
        decision.emit = true
        decision.line = line
        decision.next = (ParagraphLine){.start = index}
    }
    decision.next.width = candidate_width
    if !decision.next.has_content {
        decision.next.width = element_width
    }
    decision.next.end = index + 1
    decision.next.has_content = true
    return decision
}

ParagraphElementSpacing :: (has_content: bool, icon: bool,
policy: ParagraphLayoutPolicy) -> i32 #export {
    if !has_content {
        return 0
    }
    if icon {
        return policy.icon_spacing
    }
    return policy.space_width
}

ParagraphResolveMetrics :: (requested_font: i32, default_font: i32,
requested_line_gap: i32, default_line_gap: i32, requested_icon_size: i32,
requested_width: i32, fallback_width: i32, measured_height: i32,
current_y: i32) -> ParagraphMetrics #export {
    metrics: ParagraphMetrics
    metrics.font = requested_font
    if metrics.font <= 0 { metrics.font = default_font }
    metrics.line_gap = requested_line_gap
    if metrics.line_gap <= 0 { metrics.line_gap = default_line_gap }
    metrics.icon_size = requested_icon_size
    if metrics.icon_size <= 0 { metrics.icon_size = metrics.font }
    metrics.width = requested_width
    if metrics.width <= 0 { metrics.width = fallback_width }
    if metrics.width < 0 { metrics.width = 0 }
    metrics.height = measured_height
    if metrics.height <= 0 { metrics.height = metrics.font + metrics.line_gap }
    metrics.next_y = current_y + metrics.height
    return metrics
}

ParagraphCanLayout :: (width: i32) -> bool #export {
    return width > 0
}

ParagraphDefaultLineGap :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(4.0 * scale)
}

ParagraphLayoutPolicyFor :: (space_text_width: i32, letter_spacing: i32, requested_line_gap: i32, default_line_gap: i32, scale: float) -> ParagraphLayoutPolicy #export {
    policy: ParagraphLayoutPolicy
    policy.space_width = space_text_width + 2 * letter_spacing
    if policy.space_width < 0 { policy.space_width = 0 }
    policy.icon_spacing = (i32)(4.0 * scale + 0.5)
    policy.line_gap = requested_line_gap
    if policy.line_gap <= 0 { policy.line_gap = default_line_gap }
    return policy
}

ParagraphLayoutTotalHeight :: (line_count: i32, drawn_line_height: i32,
line_gap: i32) -> i32 #export {
    if line_count <= 0 { return 0 }
    height: i32 = line_count * drawn_line_height
    if line_count > 1 { height += (line_count - 1) * line_gap }
    if height < 0 { return 0 }
    return height
}

ParagraphLineXFor :: (x: i32, width: i32, line_width: i32, align: i32) -> i32 #export {
    spare: i32 = width - line_width
    if align == TextAlignCenter { return x + spare / 2 }
    if align == TextAlignEnd { return x + spare }
    return x
}

ParagraphNextLineY :: (current_y: i32, drawn_line_height: i32,
line_gap: i32, has_next_line: bool) -> i32 #export {
    next: i32 = current_y + drawn_line_height
    if has_next_line { next += line_gap }
    return next
}

ParagraphLineStride :: (drawn_line_height: i32, line_gap: i32) -> i32 #export {
    stride: i32 = drawn_line_height + line_gap
    if stride < 1 { return 1 }
    return stride
}

ParagraphLineIndexFor :: (mouse_y: float, bounds_y: float,
line_stride: i32, line_count: i32) -> i32 #export {
    if line_count <= 0 {
        return -1
    }
    if line_stride < 1 {
        line_stride = 1
    }
    index: i32 = (i32)(mouse_y - bounds_y) / line_stride
    if index < 0 {
        return 0
    }
    if index >= line_count {
        return line_count - 1
    }
    return index
}

ParagraphSelectionLocalOffsetFor :: (mouse_y: float, bounds_y: float,
block_height: i32, line_length: i32, measured_offset: i32) -> i32 #export {
    if line_length < 0 {
        line_length = 0
    }
    if mouse_y < bounds_y {
        return 0
    }
    if mouse_y > bounds_y + (float)block_height {
        return line_length
    }
    if measured_offset < 0 {
        return 0
    }
    if measured_offset > line_length {
        return line_length
    }
    return measured_offset
}
