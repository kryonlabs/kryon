// A wrapping row: children keep their widths, wrap onto new lines and the
// flow sizes to its lines. Draw children with no x or y; it places them.
Layout :: #import "layout";
#import "session"
#import "geometry"

Props :: struct {
    bounds: Rectangle
    gap: s32
    padding: s32
    key: u64
}

FlowResult :: struct {
    node: s32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
}

Draw :: (session: Session, props: Props) -> FlowResult {
    container: Layout.LayoutContainer = Layout.Flow(session, Layout.Props.{.bounds = props.bounds,
        .gap = props.gap, .padding = props.padding, .key = props.key})
    return FlowResult.{.node = container.node, .opened = container.opened,
        .bounds = container.bounds, .content = container.content, .gap = container.gap,
        .padding = container.padding}
}
