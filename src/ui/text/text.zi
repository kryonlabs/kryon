TextLayout :: #import "std/text_layout";
using Text :: #import "text_props";
// Portable compositions can submit the same public widget contract to a
// retained UI host. The host binds this effect to the ordinary implementation;
// widget behavior, styles and input ownership have one implementation.
#if #defined(KRYON_HOSTED_UI) {
    #import "session"
    host_api :: #system_library "host_api";
    TextHostedHost :: (session: Session, props: Text.Props) #foreign host_api;
    TextLinkAtHostedHost :: (session: Session, props: Text.Props, x: float32, y: float32) -> s32 #foreign host_api;
    #scope_package
    DrawSession :: (session: Session, props: Text.Props) {
        TextHostedHost(session, props)
    }
    #scope_package
    Draw :: (frame: $T, props: Text.Props) {
        DrawSession(Session.{.slot = frame.slot, .epoch = frame.epoch}, props)
    }
    #scope_export
    #program_export
    TextLinkAt :: (session: Session, props: Text.Props, x: float32, y: float32) -> s32 {
        return TextLinkAtHostedHost(session, props, x, y)
    }
} else {
    Theme :: #import "text_theme";
    #import "session"
    #import "control_props"
    #import "drawing_props"
    #import "font_metrics"
    #import "geometry"
    #import "math"
    #import "shape_paint"
    #import "paint_queue"
    #import "text_layout"
    #import "semantic"
    #import "color_props"
    #import "text_behavior"
    #import "text_align"
    using FaceModule :: #import "text_style";
    #import "tree"
    #import "text_selection_host"
    #import "widget_kind"
    Layout :: #import "layout_width";
    Grapheme :: #import "std/grapheme";

    using WidgetKind;
    #program_export
    TextSpan :: (source: string, start: s32, length: s32) -> string {
        return source[start:start + length]
    }

    #program_export
    DefaultTextFace :: () -> TextFace {
        face: TextFace
        face.foreground_set = true
        face.foreground = Theme.CurrentText()
        face.font_size = 16.0
        face.fallback_font = 16
        return face
    }

    #program_export
    TextFaceFor :: (props: Text.Props, defaults: TextFace) -> TextFace {
        face: TextFace = defaults
        request: TextStyleRequest = .{.kind = props.style_kind, .id = props.id,
            .class_name = props.class_name,
            .disabled = props.disabled}
        face.align = cast(s32)props.align
        return TextStyleFor(request, face)
    }

    TextRangeValid :: (text: string, range: Range, previous_end: s32) -> bool {
        if range.start < previous_end || range.start < 0 || range.end <= range.start ||
        range.end > text.count {
            return false
        }
        if (text[range.start] & cast(u8)192) == cast(u8)128 {
            return false
        }
        return range.end == text.count || (text[range.end] & cast(u8)192) != cast(u8)128
    }

    TextLineCaret :: (props: Text.Props, prepared: PreparedText, line: TextLayout.Line, at: s32) -> s32 {
        return GlyphCaret(props.text[line.start:line.end], at - line.start,
            prepared.font, prepared.typeface, prepared.glyph_style)
    }

    TextLineSpans :: (props: Text.Props, prepared: PreparedText, line: TextLayout.Line,
        first: s32, last: s32) -> GlyphSpans {
        return GlyphSpansFor(props.text[line.start:line.end], first - line.start, last - line.start,
            prepared.font, prepared.typeface, prepared.glyph_style)
    }

    PaintTextEmphasis :: (session: Session, node: s32, props: Text.Props,
        prepared: PreparedText, line: TextLayout.Line, x: s32, y: s32, clip: Rectangle) {
        previous_end: s32 = 0
        for range: props.strong {
            if !TextRangeValid(props.text, range, previous_end) {
                continue
            }
            previous_end = range.end
            start := range.start
            end := range.end
            if start < line.start {
                start = line.start
            }
            if end > line.end {
                end = line.end
            }
            if start >= end {
                continue
            }
            at := start
            while at < end {
                run := TextLinkRunAt(props, at, end)
                color := ifx run.link then TextLinkColor(prepared.color) else prepared.color
                origin := TextOrigin(props, prepared)
                if caret_preserves_layout {
                    spans := TextLineSpans(props, prepared, line, at, run.end)
                    for index: cast(s32)0..spans.count - 1 {
                        span := GlyphSpanAt(spans, index)
                        run_clip := TextRunClip(clip, x + span.left, x + span.right)
                        PaintClippedEmphasis(session, node, props.text[line.start:line.end], x, y,
                            prepared.font, color, run_clip, prepared.typeface, props.rotation, origin, prepared.glyph_style)
                    }
                    GlyphSpansDone(spans)
                } else {
                    from := x + TextLineCaret(props, prepared, line, at)
                    PaintClippedEmphasis(session, node, props.text[at:run.end], from, y,
                        prepared.font, color, clip, prepared.typeface, props.rotation, origin, prepared.glyph_style)
                }
                at = run.end
            }
        }
    }

    // The theme's link color, as see-through as the text around it; a theme
    // without one uses the light accent.
    TextLinkColor :: (text: Color) -> Color {
        link := StyleTokenColorOr("link", ColorFromPacked(Theme.CurrentAccent()))
        link.a = cast(u8)((cast(s32)link.a * cast(s32)text.a) / 255)
        return link
    }

    // A run of characters that are all inside one link or all outside links.
    TextLinkRun :: struct {
        end: s32
        link: bool
    }

    // The run that starts at `at` and ends at most at `limit`.
    TextLinkRunAt :: (props: Text.Props, at: s32, limit: s32) -> TextLinkRun {
        run := TextLinkRun.{.end = limit, .link = false}
        previous_end: s32 = 0
        for range: props.links {
            if !TextRangeValid(props.text, range, previous_end) {
                continue
            }
            previous_end = range.end
            if range.end <= at {
                continue
            }
            if range.start <= at {
                run.link = true
                if range.end < limit {
                    run.end = range.end
                }
                return run
            }
            if range.start < limit {
                run.end = range.start
            }
            return run
        }
        return run
    }

    // Paints a line's characters, from line_start for value's length: link
    // characters in the link color and underlined, the others in the text's
    // color.
    PaintTextLineRuns :: (session: Session, node: s32, props: Text.Props,
        prepared: PreparedText, line: TextLayout.Line, x: s32, y: s32, clip: Rectangle) {
        origin := TextOrigin(props, prepared)
        value := props.text[line.start:line.end]
        at := line.start
        while at < line.end {
            run := TextLinkRunAt(props, at, line.end)
            color := ifx run.link then TextLinkColor(prepared.color) else prepared.color
            if !run.link && at == line.start && run.end == line.end {
                PaintClippedLabel(session, node, value, x, y, prepared.font,
                    color, clip, prepared.typeface, props.rotation, origin, prepared.glyph_style)
                break
            }
            if !caret_preserves_layout {
                from := x + TextLineCaret(props, prepared, line, at)
                PaintClippedLabel(session, node, props.text[at:run.end], from, y, prepared.font,
                    color, clip, prepared.typeface, props.rotation, origin, prepared.glyph_style)
            }
            if caret_preserves_layout || run.link {
                spans := TextLineSpans(props, prepared, line, at, run.end)
                for index: cast(s32)0..spans.count - 1 {
                    span := GlyphSpanAt(spans, index)
                    run_clip := TextRunClip(clip, x + span.left, x + span.right)
                    if caret_preserves_layout {
                        PaintClippedLabel(session, node, value, x, y, prepared.font,
                            color, run_clip, prepared.typeface, props.rotation, origin, prepared.glyph_style)
                    }
                    if run.link {
                        underline := RectangleIntersection(Rectangle.{run_clip.x,
                            cast(float32)(y + prepared.glyph_height - 1), run_clip.width, 1.0}, clip)
                        if underline.width > 0.0 && underline.height > 0.0 {
                            PaintTextRule(session, node, props, prepared, underline, color)
                        }
                    }
                }
                GlyphSpansDone(spans)
            }
            at = run.end
        }
    }

    TextRunClip :: (clip: Rectangle, from: s32, to: s32) -> Rectangle {
        left := ifx from < to then from else to
        right := ifx from < to then to else from
        return RectangleIntersection(clip, Rectangle.{cast(float32)left, clip.y,
            cast(float32)(right - left), clip.height})
    }

    #program_export
    PrepareText :: (props: Text.Props, face: TextFace) -> PreparedText {
        lines: []TextLayout.Line
        return PrepareTextWithLines(props, face, lines)
    }

    TextAppearanceFor :: (props: Text.Props, face: TextFace) -> TextAppearance {
        return ResolveTextStyle(props.size, 0,
            ResolveFont(0, cast(s32)(face.font_size + 0.5), face.fallback_font),
            face.foreground, cast(u32)0, Theme.CurrentText(),
            false, face.foreground_set,
            // A stylesheet's opacity already supplies the disabled face;
            // the fallback must not fade it a second time.
            props.disabled && !face.opacity_set, false)
    }

    TextPaintColor :: (face: TextFace, color: u32) -> Color {
        return ColorFromPacked(Opacity(color,
            ifx face.opacity_set then face.opacity else 1.0))
    }

    // The draw owns these borrowed plans only until its paint is queued.
    // Overflow keeps the ordinary line-at-a-time layout path.
    PrepareTextWithLines :: (props: Text.Props, face: TextFace,
        lines: []TextLayout.Line) -> PreparedText {
        prepared: PreparedText
        prepared.bounds = props.bounds
        prepared.align = ifx props.align != .TextAlignStart then cast(s32)props.align else face.align
        prepared.typeface = ifx props.typeface != "" then props.typeface else face.typeface
        appearance := TextAppearanceFor(props, face)
        prepared.font = appearance.font
        prepared.color = TextPaintColor(face, appearance.color)
        prepared.glyph_style = face.glyphs
        prepared.glyph_height = GlyphLineHeight(prepared.font, prepared.typeface, prepared.glyph_style)
        if prepared.glyph_height < 1 { prepared.glyph_height = prepared.font }
        prepared.line_height = prepared.glyph_height
        prepared.line_gap = ifx props.line_gap > 0 then props.line_gap else TextDefaultLineGap(1.0)
        line_height := TextLineHeightValue(face.line_height_set, face.line_height,
            face.line_height_unit, cast(float32)prepared.font,
            cast(float32)prepared.glyph_height)
        if line_height >= 0.0 {
            prepared.line_height = cast(s32)(cast(float64)line_height + 0.5)
            prepared.line_gap = 0
            prepared.glyph_offset = (prepared.line_height - prepared.glyph_height) / 2
        }
        prepared.wrap = cast(Wrap)TextWrapPolicy(props.bounds.width,
            cast(s32)props.wrap)

        start: s32 = 0
        maximum: s32 = 0
        while start <= (cast(s32)props.text.count) {
            line: TextLayout.Line = NextTextLine(props.text, start,
                props.bounds.width, prepared.wrap, prepared.font,
                prepared.typeface, prepared.glyph_style)
            if prepared.line_count < lines.count { lines[prepared.line_count] = line }
            prepared.line_count += 1
            if line.width > maximum { maximum = line.width }
            start = line.next
        }
        prepared.bounds.width = TextExtent(props.bounds.width, cast(float32)maximum)
        height: s32 = TextLayout.TotalHeight(prepared.line_count,
            prepared.line_height, prepared.line_gap)
        prepared.bounds.height = TextExtent(props.bounds.height, cast(float32)height)
        return prepared
    }

    // The longest start of value, ending on a whole character, that is at
    // most max_width wide.
    TextEllipsisStart :: (value: string, max_width: s32, font: s32,
        typeface: string, glyph_style: TextGlyphStyle) -> string {
        end: s32 = cast(s32)value.count
        while end > 0 {
            end = Grapheme.Previous(value, end)
            if GlyphWidth(value[0:end], font, typeface, glyph_style) <= max_width {
                return value[0:end]
            }
        }
        return ""
    }

    // How many wrapped lines start at or below the bottom of a fixed-height
    // box; PaintTextLines leaves those out.
    #program_export
    TextHiddenLines :: (props: Text.Props, prepared: PreparedText) -> s32 {
        if props.bounds.height <= 0.0 { return 0 }
        total_height: s32 = TextLayout.TotalHeight(prepared.line_count,
            prepared.line_height, prepared.line_gap)
        y: s32 = cast(s32)prepared.bounds.y +
        cast(s32)TextAlignmentOffset(prepared.bounds.height,
            cast(float32)total_height, cast(s32)props.vertical_align)
        bottom: float32 = prepared.bounds.y + prepared.bounds.height
        hidden: s32 = 0
        line: s32 = 0
        while line < prepared.line_count {
            if cast(float32)y >= bottom {
                hidden += 1
            }
            y += prepared.line_height + prepared.line_gap
            line += 1
        }
        return hidden
    }

    #program_export
    PaintTextLines :: (session: Session, node: s32, props: Text.Props,
        prepared: PreparedText) {
        lines: []TextLayout.Line
        PaintTextLinesWithPlans(session, node, props, prepared, lines, GlyphMetricsRevision())
    }

    PaintTextLinesWithPlans :: (session: Session, node: s32, props: Text.Props,
        prepared: PreparedText, lines: []TextLayout.Line, revision: u64) {
        total_height: s32 = TextLayout.TotalHeight(prepared.line_count,
            prepared.line_height, prepared.line_gap)
        y: s32 = cast(s32)prepared.bounds.y +
        cast(s32)TextAlignmentOffset(prepared.bounds.height,
            cast(float32)total_height, cast(s32)props.vertical_align)
        // Text being typed is laid out whole and painted up to the end of
        // its typed characters, so no word moves while it is typed.
        typed_end: s32 = cast(s32)props.text.count
        if props.typing {
            typed_end = TextLayout.CharactersEnd(props.text, props.typed)
        }
        start: s32 = 0
        line_index: s32 = 0
        while start <= (cast(s32)props.text.count) {
            line: TextLayout.Line
            if line_index < lines.count && GlyphMetricsRevision() == revision {
                line = lines[line_index]
            } else {
                line = NextTextLine(props.text, start,
                    prepared.bounds.width, prepared.wrap, prepared.font,
                    prepared.typeface, prepared.glyph_style)
            }
            line_index += 1
            if line.start >= typed_end && typed_end < cast(s32)props.text.count {
                break
            }
            value: string = TextSpan(props.text, line.start,
                line.end - line.start)
            // A line too wide for its bounds keeps the start that fits and
            // ends in "...".
            ellipsis: bool = props.wrap == Wrap.TextWrapEllipsis &&
            prepared.bounds.width > 0.0 &&
            cast(float32)line.width > prepared.bounds.width
            dots_width: s32 = 0
            if ellipsis {
                dots_width = GlyphWidth("...", prepared.font, prepared.typeface, prepared.glyph_style)
                value = TextEllipsisStart(value,
                    cast(s32)prepared.bounds.width - dots_width,
                    prepared.font, prepared.typeface, prepared.glyph_style)
                line.width = GlyphWidth(value, prepared.font, prepared.typeface, prepared.glyph_style) +
                dots_width
                line.end = line.start + cast(s32)value.count
            }
            x: s32 = TextLineXFor(cast(s32)prepared.bounds.x,
                cast(s32)prepared.bounds.width, line.width, prepared.align)
            // A line typed partway keeps its place and shows its typed start;
            // an ellipsis appears once its line is typed to the end.
            if line.end > typed_end {
                value = TextSpan(props.text, line.start, typed_end - line.start)
                line.end = typed_end
                line.width = GlyphWidth(value, prepared.font, prepared.typeface, prepared.glyph_style)
                ellipsis = false
            }
            // A line that starts inside the box is drawn whole: a box a little
            // shorter than the line must not cut off the bottoms of its glyphs.
            // Lines that start below the box are still clipped away.
            clip: Rectangle = prepared.bounds
            glyph_y := y + prepared.glyph_offset
            if cast(float32)y < clip.y + clip.height {
                if cast(float32)glyph_y < clip.y {
                    clip.height += clip.y - cast(float32)glyph_y
                    clip.y = cast(float32)glyph_y
                }
                line_bottom: float32 = cast(float32)(glyph_y + prepared.glyph_height)
                if line_bottom > clip.y + clip.height {
                    clip.height = line_bottom - clip.y
                }
            }
            if value != "" {
                PaintTextLineRuns(session, node, props, prepared, line, x, glyph_y, clip)
                if ellipsis {
                    PaintClippedLabel(session, node, "...",
                        x + line.width - dots_width, glyph_y, prepared.font,
                        prepared.color, clip, prepared.typeface, props.rotation,
                        TextOrigin(props, prepared), prepared.glyph_style)
                }
                PaintTextEmphasis(session, node, props, prepared, line, x, glyph_y, clip)
                if props.strikethrough {
                    strike: Rectangle = TextStrikethroughBounds(cast(float32)x,
                        cast(float32)glyph_y, cast(float32)line.width,
                        cast(float32)prepared.glyph_height, 1.0)
                    strike = RectangleIntersection(strike, prepared.bounds)
                    if strike.width > 0.0 && strike.height > 0.0 {
                        PaintTextRule(session,node,props,prepared,strike,prepared.color)
                    }
                }
            }
            y += prepared.line_height + prepared.line_gap
            start = line.next
        }
    }

    PaintTextRule :: (session: Session, node: s32, props: Text.Props, prepared: PreparedText,
        bounds: Rectangle, color: Color) {
        if props.rotation == 0.0 { PaintRoundedFill(session,node,bounds,0.0,1,color); return }
        origin := TextOrigin(props,prepared)
        camera: Camera = .{.offset=origin,.target=origin,.rotation=props.rotation,.zoom=1.0}
        a := WorldToScreen(Vector2.{bounds.x,bounds.y},camera)
        b := WorldToScreen(Vector2.{bounds.x+bounds.width,bounds.y},camera)
        c := WorldToScreen(Vector2.{bounds.x+bounds.width,bounds.y+bounds.height},camera)
        d := WorldToScreen(Vector2.{bounds.x,bounds.y+bounds.height},camera)
        area := RotatedRectangleBounds(bounds,origin,props.rotation)
        PaintTriangleShape(session,node,area,a,b,c,color)
        PaintTriangleShape(session,node,area,a,c,d,color)
    }

    TextOrigin :: (props: Text.Props, prepared: PreparedText) -> Vector2 {
        return .{prepared.bounds.x + props.origin.x, prepared.bounds.y + props.origin.y}
    }

    // The face Text paints props with.
    TextFaceOf :: (props: Text.Props) -> TextFace {
        defaults: TextFace = DefaultTextFace()
        if props.fallback_font > 0 {
            defaults.fallback_font = props.fallback_font
            defaults.font_size = cast(float32)props.fallback_font
        }
        return TextFaceFor(props, defaults)
    }

    #scope_package
    DrawSession :: (session: Session, props: Text.Props) {
        if !Finite32(props.rotation) || !Finite32(props.origin.x) || !Finite32(props.origin.y) { return }
        face: TextFace = TextFaceOf(props)
        if TreeIsBuilding(session) && props.bounds.x == 0.0 && props.bounds.y == 0.0 &&
            (props.bounds.width <= 0.0 || props.bounds.height <= 0.0) &&
            TreeSubmittedNodeAt(session, TreeCurrentParent(session)).places_children {
            // Placed by its container: an unset width fills a column, stack or
            // grid track (a row keeps the text's own width), an unset height
            // takes the wrapped lines.
            if props.bounds.width <= 0.0 {
                props.bounds.width = Layout.LayoutChildWidth(session)
                if props.bounds.width <= 0.0 {
                    sized := PrepareText(props, face)
                    props.bounds.width = cast(float32)GlyphWidth(props.text, sized.font, sized.typeface,
                        sized.glyph_style)
                }
            }
            if props.bounds.height <= 0.0 {
                sized := PrepareText(props, face)
                props.bounds.height = cast(float32)TextLayout.TotalHeight(sized.line_count,
                    sized.line_height, sized.line_gap)
            }
        } else if props.bounds.width == 0.0 && props.bounds.height == 0.0 {
            props.bounds = TreeRootBounds(session)
        }
        lines: [8]TextLayout.Line
        revision := GlyphMetricsRevision()
        prepared: PreparedText = PrepareTextWithLines(props, face, lines[:])
        node: s32 = -1
        if TreeIsBuilding(session) {
            node = TreeSubmitCurrent(session, props.key, WidgetKindText,
                RotatedRectangleBounds(prepared.bounds, TextOrigin(props, prepared), props.rotation))
            if node < 0 { return }
            TreeSetLabel(session, node, props.text)
            TreeSetStyleClass(session, node, props.class_name)
            TreeSetStyleId(session, node, props.id)
            if text_style_motion != null {
                request := TextStyleRequest.{.kind = props.style_kind, .id = props.id,
                    .class_name = props.class_name, .disabled = props.disabled}
                face = text_style_motion(session, TreeSubmittedIdentity(session, node), request, face)
                prepared.color = TextPaintColor(face, TextAppearanceFor(props, face).color)
            }
            TreeSetSemantic(session, node, props.semantic_kind, props.heading_level)
            hidden: s32 = TextHiddenLines(props, prepared)
            if hidden > 0 {
                TreeSetHiddenLines(session, node, hidden)
            }
        }
        if props.selectable && node >= 0 && TextSelectionPresent(session, node, props, prepared) {
            return
        }
        count: s32 = prepared.line_count
        if count > lines.count { count = cast(s32)lines.count }
        PaintTextLinesWithPlans(session, node, props, prepared, lines[:count], revision)
    }

    #scope_package
    Draw :: (frame: $T, props: Text.Props) {
        DrawSession(Session.{.slot = frame.slot, .epoch = frame.epoch}, props)
    }

    // The index in props.links of the link whose characters Text paints
    // under (x, y), on any of its lines, or -1.
    #scope_export
    #program_export
    TextLinkAt :: (session: Session, props: Text.Props, x: float32, y: float32) -> s32 {
        unused session
        if props.links.count == 0 {
            return -1
        }
        prepared := PrepareText(props, TextFaceOf(props))
        origin := TextOrigin(props, prepared)
        point := ScreenToWorld(Vector2.{x,y}, Camera.{.offset=origin,.target=origin,.rotation=props.rotation,.zoom=1.0})
        x = point.x; y = point.y
        top := TextFirstLineY(props, prepared)
        start: s32 = 0
        while start <= cast(s32)props.text.count {
            line := NextTextLine(props.text, start, prepared.bounds.width,
                prepared.wrap, prepared.font, prepared.typeface, prepared.glyph_style)
            bottom := top + prepared.line_height + prepared.line_gap
            if y >= cast(float32)top && y < cast(float32)bottom {
                left := TextLineXFor(cast(s32)prepared.bounds.x, cast(s32)prepared.bounds.width,
                    line.width, prepared.align)
                previous_end: s32 = 0
                for range, index: props.links {
                    if !TextRangeValid(props.text, range, previous_end) {
                        continue
                    }
                    previous_end = range.end
                    first := ifx range.start > line.start then range.start else line.start
                    last := ifx range.end < line.end then range.end else line.end
                    if first >= last {
                        continue
                    }
                    spans := TextLineSpans(props, prepared, line, first, last)
                    hit := false
                    for visual: cast(s32)0..spans.count - 1 {
                        span := GlyphSpanAt(spans, visual)
                        if x >= cast(float32)(left + span.left) && x < cast(float32)(left + span.right) { hit = true; break }
                    }
                    GlyphSpansDone(spans)
                    if hit { return cast(s32)index }
                }
                return -1
            }
            if line.next <= start {
                break
            }
            start = line.next
            top = bottom
        }
        return -1
    }

    TextFirstLineY :: (props: Text.Props, prepared: PreparedText) -> s32 {
        height := TextLayout.TotalHeight(prepared.line_count, prepared.line_height, prepared.line_gap)
        return cast(s32)prepared.bounds.y + cast(s32)TextAlignmentOffset(
            prepared.bounds.height, cast(float32)height, cast(s32)props.vertical_align)
    }

    TextByteAtPoint :: (props: Text.Props, prepared: PreparedText, x: float32, y: float32) -> s32 {
        origin := TextOrigin(props,prepared)
        point := ScreenToWorld(Vector2.{x,y},Camera.{.offset=origin,.target=origin,.rotation=props.rotation,.zoom=1.0})
        x = point.x; y = point.y
        top := TextFirstLineY(props, prepared)
        start: s32 = 0
        while start <= props.text.count {
            line := NextTextLine(props.text, start, prepared.bounds.width,
                prepared.wrap, prepared.font, prepared.typeface, prepared.glyph_style)
            if y < cast(float32)(top + prepared.line_height + prepared.line_gap) || line.next > props.text.count {
                left := TextLineXFor(cast(s32)prepared.bounds.x, cast(s32)prepared.bounds.width,
                    line.width, prepared.align)
                at := line.start
                nearest := at
                distance := x - cast(float32)(left + TextLineCaret(props, prepared, line, at))
                if distance < 0.0 { distance = -distance }
                while at < line.end {
                    at = Grapheme.Next(props.text, at)
                    next_distance := x - cast(float32)(left + TextLineCaret(props, prepared, line, at))
                    if next_distance < 0.0 { next_distance = -next_distance }
                    if next_distance <= distance {
                        nearest = at
                        distance = next_distance
                    }
                }
                return nearest
            }
            start = line.next
            top += prepared.line_height + prepared.line_gap
        }
        return cast(s32)props.text.count
    }

    TextCaretBounds :: (props: Text.Props, prepared: PreparedText, at: s32) -> Rectangle {
        top := TextFirstLineY(props, prepared)
        start: s32 = 0
        while start <= props.text.count {
            line := NextTextLine(props.text, start, prepared.bounds.width,
                prepared.wrap, prepared.font, prepared.typeface, prepared.glyph_style)
            if at <= line.end || line.next > props.text.count {
                left := TextLineXFor(cast(s32)prepared.bounds.x, cast(s32)prepared.bounds.width,
                    line.width, prepared.align)
                width := TextLineCaret(props, prepared, line, at)
                return Rectangle.{cast(float32)(left + width), cast(float32)top,
                    1.0, cast(float32)prepared.line_height}
            }
            start = line.next
            top += prepared.line_height + prepared.line_gap
        }
        return .{}
    }

    PaintTextSelection :: (session: Session, node: s32, props: Text.Props, prepared: PreparedText,
        anchor: s32, cursor: s32, color: Color) {
        first := ifx anchor < cursor then anchor else cursor
        last := ifx anchor < cursor then cursor else anchor
        top := TextFirstLineY(props, prepared)
        start: s32 = 0
        while start <= props.text.count {
            line := NextTextLine(props.text, start, prepared.bounds.width,
                prepared.wrap, prepared.font, prepared.typeface, prepared.glyph_style)
            from := ifx first > line.start then first else line.start
            to := ifx last < line.end then last else line.end
            if from < to {
                left := TextLineXFor(cast(s32)prepared.bounds.x, cast(s32)prepared.bounds.width,
                    line.width, prepared.align)
                row := RectangleIntersection(prepared.bounds, Rectangle.{prepared.bounds.x,
                    cast(float32)top, prepared.bounds.width, cast(float32)prepared.line_height})
                spans := TextLineSpans(props, prepared, line, from, to)
                for index: cast(s32)0..spans.count - 1 {
                    span := GlyphSpanAt(spans, index)
                    PaintTextRule(session, node, props, prepared, TextRunClip(row, left + span.left, left + span.right), color)
                }
                GlyphSpansDone(spans)
            }
            start = line.next
            top += prepared.line_height + prepared.line_gap
        }
    }

}
