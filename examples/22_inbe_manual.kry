#import "kryon.h"

# Declarative port of inbe's manual screen: a scrollable breathing
# guide. Long-form text in a scroll container — the screen class that
# habits/learn screens share.

state {
    scroll_off: int = 0
}

app "Inner Breeze — Manual" {
    size 480 640
    fps 60
}

App :: () #ui {
    Screen root: {
        ClearBackground(GetThemeBackground())
        Background(GetThemeSurface())
        Text("Manual", ScaleUIPx(70), ScaleUIPx(28), Text24, GetThemeText())
        manual_area: UIScrollArea = {{ScaleUIPx(24), ScaleUIPx(80), ScaleUIPx(432), ScaleUIPx(520)}, ScaleUIPx(1250), ScaleUIPx(24), ScaleUIPx(432), &scroll_off, 0, 0}
        manual_view: UIScrollView = BeginUIScrollContainer(manual_area)
        Text("Welcome to Inner Breeze", manual_view.content_x, manual_view.content_y + ScaleUIPx(10), Text16, GetThemeText())
        Text("Inner Breeze guides breathing practices with gentle visual and audio cues.", manual_view.content_x, manual_view.content_y + ScaleUIPx(40), Text16, GetThemeIcon())
        Text("Box breathing", manual_view.content_x, manual_view.content_y + ScaleUIPx(100), Text16, GetThemeText())
        Text("Inhale, hold, exhale, hold — four equal phases traced around a square.", manual_view.content_x, manual_view.content_y + ScaleUIPx(130), Text16, GetThemeIcon())
        Text("Start with four seconds per phase and lengthen gradually.", manual_view.content_x, manual_view.content_y + ScaleUIPx(180), Text16, GetThemeIcon())
        Text("Wim Hof method", manual_view.content_x, manual_view.content_y + ScaleUIPx(240), Text16, GetThemeText())
        Text("Thirty deep breaths, a retention hold, and a recovery breath.", manual_view.content_x, manual_view.content_y + ScaleUIPx(270), Text16, GetThemeIcon())
        Text("Always practice seated and never in or near water.", manual_view.content_x, manual_view.content_y + ScaleUIPx(320), Text16, GetThemeIcon())
        Text("Meditation", manual_view.content_x, manual_view.content_y + ScaleUIPx(380), Text16, GetThemeText())
        Text("Follow the expanding ring; the pause between breaths is the practice.", manual_view.content_x, manual_view.content_y + ScaleUIPx(410), Text16, GetThemeIcon())
        DrawCircleV((Vector2){ScaleUIPx(240), manual_view.content_y + ScaleUIPx(560)}, ScaleUIPx(60), (Color){0x2d, 0x4d, 0x7b, 0xff})
        DrawRing((Vector2){ScaleUIPx(240), manual_view.content_y + ScaleUIPx(560)}, ScaleUIPx(66), ScaleUIPx(76), 0.0f, 360.0f, 0, (Color){0x70, 0x90, 0xc0, 0xff})
        Text("Habits", manual_view.content_x, manual_view.content_y + ScaleUIPx(680), Text16, GetThemeText())
        Text("Small daily marks build streaks; missing one day is fine, two is a pattern.", manual_view.content_x, manual_view.content_y + ScaleUIPx(710), Text16, GetThemeIcon())
        Text("Scroll for more", manual_view.content_x, manual_view.content_y + ScaleUIPx(1100), Text16, GetThemeIcon())
        EndUIScrollContainer(manual_area, manual_view)
    }
}
