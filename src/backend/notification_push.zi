    PLock :: (mutex: *void) -> s32 #foreign pc "pthread_mutex_lock";
    PUnlock :: (mutex: *void) -> s32 #foreign pc "pthread_mutex_unlock";
    p_mutex: [8]u64;
    p_up :: "org/unifiedpush/android/connector/UnifiedPush"

    PClear :: (env: *JniEnv) -> bool {
