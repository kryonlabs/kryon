#import "kryon.h"

app "Text Area and Slider" {
    size 800 600
    fps 60
    theme THEME_OCEAN light
}

state {
    material_ready: int = 0
    hue: int = 215
    note: [4096] char = ""
    note_cursor: int = 0
    note_focused: int = 0
    note_scroll: int = 0
}

TextAreaSliderExample :: (viewport: Rectangle) #ui {
    if !material_ready {
        SetThemeStyle(THEME_STYLE_MATERIAL)
        material_ready = 1
    }
    bg: Color = ColorFromHSV((float)hue, 0.12f, 0.96f)
    accent: Color = ColorFromHSV((float)hue, 0.68f, 0.92f)
    panel: Rectangle = {48.0f, viewport.height - 82.0f, viewport.width - 96.0f, 54.0f}
    ta_bounds: Rectangle = {48.0f, 120.0f, viewport.width - 96.0f, viewport.height - 230.0f}
    ta_style: TextInputStyle = {
        {248,250,252,255},
        {190,200,215,255},
        accent,
        {28,36,48,255},
        accent,
        0.05f,
        16,
        14
    }
    Screen root: {
        bounds = viewport
        Background(bg)
        Text("Text area and slider", 48, 36, Text32, (Color){24,32,44,255})
        Text("A small, responsive note editor.", 48, 78, Text16, (Color){82,96,116,255})
        TextArea((TextAreaProps){ta_bounds, note, sizeof(note), &note_cursor, &note_focused, &note_scroll, 4000, Text16, 6, 200, "Type something here...", SyntaxNone, ta_style, 0, 0, 0, 0, 1})
        Rect((int)panel.x, (int)panel.y, (int)panel.width, (int)panel.height, (Color){248,250,252,255}, (Color){190,200,215,255})
        Slider(100, (int)panel.x + 18, (int)panel.y + 13, (int)panel.width - 36, "Background hue", 0, 360, &hue, "", 0)
    }
}
