    }
    PPrefs :: (env: *JniEnv, context: *void) -> *void {
        return NObject(env, context, "getSharedPreferences", "(Ljava/lang/String;I)Landroid/content/SharedPreferences;", NRef(NString(env, "org.kryonlabs.push")), NNumber(0))
    }
    PGet :: (env: *JniEnv, prefs: *void, key: string) -> *void {
        return NObject(env, prefs, "getString", "(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;", NRef(NString(env, key)), NRef(NString(env, "")))
    }
    PInt :: (env: *JniEnv, prefs: *void, key: string) -> s32 {
        return NInt(env, prefs, "getInt", "(Ljava/lang/String;I)I", NRef(NString(env, key)), NNumber(0))
    }
    PEdit :: (env: *JniEnv, prefs: *void) -> *void { return NObject(env, prefs, "edit", "()Landroid/content/SharedPreferences$Editor;") }
    PPut :: (env: *JniEnv, editor: *void, key: string, value: *void) {
        unused NObject(env, editor, "putString", "(Ljava/lang/String;Ljava/lang/String;)Landroid/content/SharedPreferences$Editor;", NRef(NString(env, key)), NRef(value))
    }
    PPutInt :: (env: *JniEnv, editor: *void, key: string, value: s32) {
        unused NObject(env, editor, "putInt", "(Ljava/lang/String;I)Landroid/content/SharedPreferences$Editor;", NRef(NString(env, key)), NNumber(value))
