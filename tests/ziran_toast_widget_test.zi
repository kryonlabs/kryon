#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "geometry"
#import "paint_queue"
#import "toast"
#import "toast_props"
#import "toast_widget"
#import "tree"
#import "widget_kind"
#import "ziran_toast_widget_host"

using WidgetKind;

phase: s32;
state_class_name: s32;
state_until_seconds: float64;
state_message: [64]u8;
state_message_count: s64;

#program_export
Frame :: () -> s32 {
    if ToastPrefixBefore("aéz", 3) != 1 { return -20 }
    utf8: ToastDisplay = ToastDisplayFor("aéabcdefghijkl", 48,
        14, "")
    if !utf8.ellipsis || utf8.prefix != "aé" ||
        utf8.width != 48 { return -21 }
    previous_message: [64]u8
    previous_count: s64 = state_message_count
    if previous_count > 64 { return -22 }
    previous_byte: s64 = 0
    while previous_byte < previous_count {
        previous_message[previous_byte] = state_message[previous_byte]
        previous_byte += 1
    }
    previous_state: ToastState
    previous_state.class_name = state_class_name
    previous_state.until_seconds = state_until_seconds
    previous_state.message = TextView(previous_message[:previous_count])
    props: ToastProps
    props.key = cast(u64)17
    props.viewport = Rectangle.{10.0, 20.0, 200.0, 100.0}
    props.state = previous_state
    if phase == 0 {
        props.message = "Hello"
        props.seconds = 2.0
        props.now_seconds = 1.0
    } else if phase == 1 {
        props.now_seconds = 2.0
    } else if phase == 2 {
        props.message = "1234567890123456789012345"
        props.seconds = 1.0
        props.now_seconds = 2.5
    } else if phase == 3 {
        props.now_seconds = 4.0
    } else if phase == 4 {
        props.message = "X"
        props.now_seconds = 5.0
    } else {
        props.clear = true
        props.now_seconds = 6.0
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 140.0})
    result: ToastResult = Toast(TestSession(), props)
    if !TreeFinish(TestSession()) { return -10 }
    if phase == 0 || phase == 1 {
        if !result.visible || result.state.until_seconds != 3.0 ||
            result.display != "Hello" || result.ellipsis ||
            result.bounds.x != 76.0 || result.bounds.y != 68.0 ||
            TreeCount(TestSession()) != 2 || result.node != 1 ||
            TreeNodeAt(TestSession(), 1).kind != WidgetKindCustom { return -1 }
    } else if phase == 2 {
        if !result.visible || result.state.until_seconds != 3.5 ||
            !result.ellipsis || result.display.count != 14 ||
            result.bounds.width != 164.0 || TreeCount(TestSession()) != 2 {
            return -2
        }
    } else if phase == 3 || phase == 5 {
        if result.visible || result.state.message.count != 0 ||
            TreeCount(TestSession()) != 1 { return -3 }
    } else {
        if !result.visible || result.state.until_seconds != 8.0 ||
            result.display != "X" || TreeCount(TestSession()) != 2 { return -4 }
    }
    PaintFlush(TestSession())
    if result.state.message.count > 64 { return -23 }
    incoming_message: [64]u8
    incoming_message_count: s64 = result.state.message.count
    incoming_message_byte: s64 = 0
    while incoming_message_byte < incoming_message_count {
        incoming_message[incoming_message_byte] = result.state.message[incoming_message_byte]
        incoming_message_byte += 1
    }
    incoming_message_byte = 0
    while incoming_message_byte < incoming_message_count {
        state_message[incoming_message_byte] = incoming_message[incoming_message_byte]
        incoming_message_byte += 1
    }
    state_message_count = incoming_message_count
    state_class_name = result.state.class_name
    state_until_seconds = result.state.until_seconds
    old: s32 = phase
    phase += 1
    return old
}

#program_export
main :: () -> s32 {
    index: s32 = 0
    while index < 6 {
        if Frame() != index || ToastHostFailed() { return 1 }
        index += 1
    }
    if ToastFills() != 4 || ToastOutlines() != 4 ||
        ToastLabels() != 5 { return 2 }
    return 0
}
