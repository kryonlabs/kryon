#module "text_widget"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "paragraph"
#import "semantic"
#import "style"
#import "style_sheet"
#import "surface"
#import "text"
#import "text_align"
#import "text_props"
#import "tree"
#import "widget_kind"

# A raw byte-range view. The host only returns bytes; line breaking, layout,
# style, and paint order are decided by this module.
TextSlice :: (source: string, start: i32, length: i32) -> string #extern

TextSpan :: (source: string, start: i32, length: i32) -> string #export {
    return TextSlice(source, start, length)
}

TextFace :: struct {
    value: StyleData
    fallback_font: i32
}

DefaultTextFace :: () -> TextFace #export {
    face: TextFace
    face.value.fields = (u32)StyleForeground | (u32)StyleFontSize
    face.value.foreground = (u32)0x171717ff
    face.value.font_size = 16.0
    face.fallback_font = 16
    return face
}

TextFaceFor :: (rules: StyleRules, props: TextProps,
    defaults: TextFace) -> TextFace #export {
    face: TextFace = defaults
    state: i32 = (i32)ButtonStateNormal
    if props.disabled { state = (i32)ButtonStateDisabled }
    kind: i32 = props.style_kind
    if kind <= 0 { kind = StyleKindText() }
    face.value = ResolveStyleRules(rules, defaults.value,
        StyleTextFacts(0, props.class_name, kind, state), state)
    return face
}

TextLinePlan :: struct {
    start: i32
    end: i32
    next: i32
    width: i32
}

# A word that exceeds the available width stays intact on its own line.
# ParagraphTokenNext keeps UTF-8 bytes together by splitting only at ASCII
# whitespace and line breaks.
NextTextLine :: (value: string, start: i32, max_width: float,
    wrap: TextWrap, font: i32, typeface: string) -> TextLinePlan #export {
    line: TextLinePlan
    line.start = start
    line.end = start
    line.next = value.length + 1
    if start >= value.length { return line }
    offset: i32 = start
    while offset < value.length {
        token: ParagraphToken = ParagraphTokenNext(value, offset, false)
        if !token.valid { break }
        if token.line_break {
            line.next = token.next
            return line
        }
        candidate: string = TextSlice(value, line.start,
            token.end - line.start)
        width: i32 = GlyphWidth(candidate, font, typeface)
        if wrap == (TextWrap)TextWrapAuto && max_width > 0.0 &&
            line.end > line.start && (float)width > max_width {
            line.next = token.start
            return line
        }
        line.end = token.end
        line.width = width
        offset = token.next
    }
    return line
}

PreparedText :: struct {
    bounds: Rectangle
    font: i32
    color: Color
    typeface: string
    line_height: i32
    line_gap: i32
    line_count: i32
    wrap: TextWrap
}

PrepareText :: (props: TextProps, face: TextFace) -> PreparedText #export {
    prepared: PreparedText
    prepared.bounds = props.bounds
    prepared.typeface = face.value.typeface
    appearance: TextAppearance = ResolveTextStyle(props.font, 0,
        ResolveFont(0, StyleFontValue(face.value.fields,
            face.value.font_size), face.fallback_font),
        face.value.foreground, (u32)0, (u32)0x171717ff,
        false, (face.value.fields & (u32)StyleForeground) != (u32)0,
        props.disabled, false, 0)
    prepared.font = appearance.font
    prepared.color = ColorFromPacked(Opacity(appearance.color,
        StyleOpacityValue(face.value.fields, face.value.opacity)))
    prepared.line_height = GlyphLineHeight(prepared.font,
        prepared.typeface)
    if prepared.line_height < 1 { prepared.line_height = prepared.font }
    prepared.line_gap = ParagraphDefaultLineGap(1.0)
    prepared.wrap = (TextWrap)TextWrapPolicy(props.bounds.width,
        (i32)props.wrap)

    start: i32 = 0
    maximum: i32 = 0
    while start <= props.text.length {
        line: TextLinePlan = NextTextLine(props.text, start,
            props.bounds.width, prepared.wrap, prepared.font,
            prepared.typeface)
        prepared.line_count += 1
        if line.width > maximum { maximum = line.width }
        start = line.next
    }
    prepared.bounds.width = TextExtent(props.bounds.width, (float)maximum)
    height: i32 = ParagraphLayoutTotalHeight(prepared.line_count,
        prepared.line_height, prepared.line_gap)
    prepared.bounds.height = TextExtent(props.bounds.height, (float)height)
    return prepared
}

PaintTextLines :: (node: i32, props: TextProps,
    prepared: PreparedText) #export {
    total_height: i32 = ParagraphLayoutTotalHeight(prepared.line_count,
        prepared.line_height, prepared.line_gap)
    y: i32 = (i32)prepared.bounds.y +
        (i32)TextAlignmentOffset(prepared.bounds.height,
            (float)total_height, (i32)props.vertical_align)
    start: i32 = 0
    while start <= props.text.length {
        line: TextLinePlan = NextTextLine(props.text, start,
            prepared.bounds.width, prepared.wrap, prepared.font,
            prepared.typeface)
        value: string = TextSlice(props.text, line.start,
            line.end - line.start)
        x: i32 = ParagraphLineXFor((i32)prepared.bounds.x,
            (i32)prepared.bounds.width, line.width, (i32)props.align)
        if value != "" {
            PaintClippedLabel(node, value, x, y, prepared.font,
                prepared.color, prepared.bounds)
            if props.strikethrough {
                strike: Rectangle = TextStrikethroughBounds((float)x,
                    (float)y, (float)line.width,
                    (float)prepared.line_height, 1.0)
                strike = RectangleIntersection(strike, prepared.bounds)
                if strike.width > 0.0 && strike.height > 0.0 {
                    PaintRoundedFill(node, strike, 0.0, 1, prepared.color)
                }
            }
        }
        y += prepared.line_height + prepared.line_gap
        start = line.next
    }
}

Text :: (props: TextProps) #export {
    defaults: TextFace = DefaultTextFace()
    if props.fallback_font > 0 {
        defaults.fallback_font = props.fallback_font
        defaults.value.font_size = (float)props.fallback_font
    }
    face: TextFace = TextFaceFor(ActiveStyleRules(), props, defaults)
    prepared: PreparedText = PrepareText(props, face)
    node: i32 = -1
    if TreeIsBuilding() {
        node = TreeSubmitCurrent(props.key, WidgetKindText, prepared.bounds)
        if node < 0 { return }
        TreeSetLabel(node, props.text)
        TreeSetSemantic(node, props.semantic_kind, props.heading_level)
    }
    PaintTextLines(node, props, prepared)
}
