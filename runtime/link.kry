#module "link"
#import "control_props"
#import "style"

LinkVisualState :: enum {
    LinkStateNormal = 0
    LinkStateHover = 1
    LinkStateDisabled = 2
}

LinkAppearance :: struct {
    color: u32
    underline: bool
}

LinkInteraction :: struct {
    active: bool
    hovered: bool
    disabled_marker: bool
    state: ButtonState
}

LinkBoundsFor :: (bounds: Rectangle, text_width: i32,
    text_height: i32, font: i32) -> Rectangle #export {
    result: Rectangle = bounds
    if result.width <= 0.0 {
        result.width = (float)text_width
    }
    if result.height <= 0.0 {
        result.height = (float)text_height
    }
    if result.height <= 0.0 {
        result.height = (float)font
    }
    return result
}

LinkUnderlineYFor :: (bounds: Rectangle, scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(bounds.y + bounds.height) - (i32)(2.0 * scale)
}

LinkInteractionFor :: (disabled: bool, captured: bool, mouse_inside: bool,
    hover_effects: bool) -> LinkInteraction #export {
    interaction: LinkInteraction
    interaction.active = !disabled && !captured && mouse_inside
    interaction.hovered = interaction.active && hover_effects
    interaction.disabled_marker = disabled && !captured && mouse_inside
    interaction.state = (ButtonState)ButtonStateNormal
    if interaction.hovered {
        interaction.state = (ButtonState)ButtonStateHover
    }
    if disabled {
        interaction.state = (ButtonState)ButtonStateDisabled
    }
    return interaction
}

LinkActivated :: (disabled: bool, clicked: bool, focus_activate: bool) -> bool #export {
    return !disabled && (clicked || focus_activate)
}

ResolveLinkAppearance :: (frame: StyleFrame, hovered: bool,
    disabled: bool) -> LinkAppearance #export {
    state: i32 = LinkStateNormal
    if hovered {
        state = LinkStateHover
    }
    if disabled {
        state = LinkStateDisabled
    }
    appearance: LinkAppearance
    appearance.color = frame.value.foreground
    appearance.underline = state == LinkStateHover
    return appearance
}
