// {{name}}: a Kryon application. Frame runs every frame and declares the
// whole interface from the state in src/tasks.zi; Kryon keeps the widgets
// between frames and reports what the user did. Layout containers place
// their children and theme tokens size them, so no code here computes a
// position.
//
//   kryon run                     the desktop window (ziran run does the same)
//   kryon run shot --png build/shot.png --width 390 --height 844 --theme dark
//   kryon run tui                 the same interface in a terminal
//   kryon run web                 a Canvas2D browser page (needs Emscripten)
Button :: #import "kryon/button";
Card :: #import "kryon/card";
Checkbox :: #import "kryon/checkbox";
Dropdown :: #import "kryon/dropdown";
Layout :: #import "kryon/layout";
Text :: #import "kryon/text";
Theme :: #import "kryon/theme";
TitleBar :: #import "kryon/title_bar";
Toggle :: #import "kryon/toggle";
#import "kryon/control_props"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"
using Model :: #import "tasks";

started: bool;
dark: bool;
no_menu: []Dropdown.Option;

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    // Start in the mode the host chose: the system's, or kryon run --theme.
    if !started { dark = Theme.CurrentTheme().dark; StartTasks(); started = true }
    screen := Layout.Draw(session, Layout.Props.{.bounds = viewport})
    if !screen.opened { return 0 }
    AppBar(session)
    body := Layout.Draw(session, Layout.Props.{
        .gap = Layout.Gap(.ThemeMetricSpace3), .gap_override = true,
        .padding = Layout.Gap(.ThemeMetricSpace4), .padding_override = true})
    if body.opened {
        Line(session, Summary(), .ThemeMetricHeading3)
        for index: 0..TaskCount() - 1 { TaskCard(session, index) }
        add := Button.Props.{.label = "Add task", .size = .ControlSizeLarge,
            .tone = .ButtonToneAccent, .emphasis = .ButtonEmphasisFilled}
        add.bounds = .{width = body.content.width, height = Button.ButtonMeasure(add).height}
        if Button.Draw(session, add) == 1 { unused AddTask("A new task", "Rename it in src/tasks.zi") }
        unused End(session)
    }
    unused End(session)
    return 0
}

// The app bar: the title, and a dark mode switch at its right.
AppBar :: (session: Session) {
    height := Theme.CurrentThemeMetric(.ThemeMetricControlHeightLarge) +
        Theme.CurrentThemeMetric(.ThemeMetricSpace3)
    slot := Layout.Stack(session, Layout.Props.{.bounds = .{.height = height}})
    if !slot.opened { return }
    bar := TitleBar.Draw(session, TitleBar.Props.{.bounds = slot.bounds,
        .title = "{{name}}", .strong_title = true, .trailing_width = 120}, no_menu)
    switch := Toggle.Draw(session, Toggle.Props.{.bounds = bar.trailing_bounds,
        .label = "Dark", .value = dark})
    if switch.changed {
        dark = switch.value
        unused Theme.SetThemeMode(dark)
    }
    unused End(session)
}

// One task as a card: a checkbox with its title, and a detail line.
TaskCard :: (session: Session, index: s32) {
    task := TaskAt(index)
    lines: [2]Rectangle = .[.{height = Theme.CurrentThemeMetric(.ThemeMetricControlHeightMedium)},
        .{height = LineHeight(.ThemeMetricTextSM)}]
    gap := Layout.Gap(.ThemeMetricSpace1)
    padding := Layout.Gap(.ThemeMetricSpace4)
    measured := Layout.LayoutContentBounds(Rectangle.{}, .FlexColumn, lines[:], gap, padding)
    slot := Layout.Stack(session, Layout.Props.{.bounds = .{.height = measured.height}})
    if !slot.opened { return }
    card := Card.Draw(session, Card.Props.{.bounds = slot.bounds, .variant = .CardOutlined})
    column := Layout.Draw(session, Layout.Props.{.bounds = card.content, .gap = gap, .gap_override = true})
    if column.opened {
        check := Checkbox.Draw(session, Checkbox.Props.{.bounds = lines[0],
            .label = task.title, .checked = task.done})
        if check.changed { SetTaskDone(index, check.checked) }
        Text.Draw(session, Text.Props.{.bounds = lines[1], .text = task.detail,
            .size = cast(s32)Theme.CurrentThemeMetric(.ThemeMetricTextSM)})
        unused End(session)
    }
    unused End(session)
}

// One line of text in the open column, sized by a type-scale token.
Line :: (session: Session, text: string, role: Theme.ThemeMetricRole) {
    Text.Draw(session, Text.Props.{.bounds = .{height = LineHeight(role)}, .text = text,
        .size = cast(s32)Theme.CurrentThemeMetric(role)})
}

LineHeight :: (role: Theme.ThemeMetricRole) -> float32 {
    return Theme.CurrentThemeMetric(role) * 1.4
}
