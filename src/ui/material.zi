#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"
#import "surface"

using StyleField;

// A resolved surface and its retained interaction sample. Lengths in StyleData
// are logical; bounds and segment coordinates are physical.
MaterialPaint :: struct {
    bounds: Rectangle
    surface: Rectangle
    value: StyleData
    light: u32
    ambient: u32
    hover: float32
    press: float32
    focus: float32
    disabled: bool
    fill: FillStates
    fill_valid: bool
    scale: float32
}

SurfaceDrawing :: struct {
    layer: SurfaceLayer
    bounds: Rectangle
    area: Rectangle
    scale: float32
    surface: Rectangle
    segment: Rectangle
    visible: bool
}
