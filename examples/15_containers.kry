#import "kryon.h"

app "Kryon Containers" {
    size 800 600
    fps 60
    font examples
}

state {
    tab: int = 0
    split: int = 260
    open: bool = true
    tabs: [3] const Tab = {{"Files"},{"Search"},{"Output"}}
}

ContainersExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        TabBar((TabBarProps){.bounds={40,50,680,0},.tabs=tabs,.count=3,.selected_index=tab,.focus_selected=1,.id=1501})
        PanedView((PanedViewProps){.bounds = {40,100,680,280}, .id = 501, .vertical = 1, .split = &split, .min_first = 120, .min_second = 160})
        Collapsible((CollapsibleProps){.bounds = {60,410,320,120}, .label = "Details", .open = &open})
        if open {
            Text((TextProps){.bounds={80, 455, 0, 0}, .text="Collapsible content", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        }
    }
}
