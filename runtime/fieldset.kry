#module "fieldset"
#import "control_props"
#import "drawing_props"
#import "style"

FieldsetPaint :: struct {
    frame: Rectangle
    title_background: Rectangle
    title_text: Rectangle
    face: StyleFrame
    border_color: u32
    background_color: u32
    text_color: u32
    border_width: float
    show_title: bool
}

FieldsetPaintFor :: (bounds: Rectangle, title_width: float,
    has_title: bool, scale: float, frame: StyleFrame) -> FieldsetPaint #export {
    paint: FieldsetPaint
    if scale <= 0.0 {
        scale = 1.0
    }

    pad: float = frame.value.padding_x
    if (frame.value.fields & (u32)StylePaddingX) == (u32)0 || pad < 0.0 {
        pad = 8.0
    }
    pad *= scale
    title_height: float = frame.value.font_size
    if (frame.value.fields & (u32)StyleFontSize) == (u32)0 || title_height <= 0.0 {
        title_height = 18.0
    }
    title_height *= scale
    title_offset_y: float = frame.value.padding_y
    if (frame.value.fields & (u32)StylePaddingY) == (u32)0 || title_offset_y < 0.0 {
        title_offset_y = 8.0
    }
    title_offset_y *= scale
    text_offset_y: float = frame.value.gap
    if (frame.value.fields & (u32)StyleGap) == (u32)0 || text_offset_y < 0.0 {
        text_offset_y = 9.0
    }
    text_offset_y *= scale

    paint.frame = bounds
    paint.face = frame
    paint.border_color = frame.value.border
    paint.background_color = frame.value.background
    paint.text_color = frame.value.foreground
    paint.border_width = frame.value.border_width * scale
    if paint.border_width < 0.0 {
        paint.border_width = 0.0
    }
    paint.show_title = has_title

    paint.title_background.x = bounds.x + pad
    paint.title_background.y = bounds.y - title_offset_y
    paint.title_background.width = title_width + pad * 2.0
    paint.title_background.height = title_height

    paint.title_text.x = bounds.x + pad * 2.0
    paint.title_text.y = bounds.y - text_offset_y
    paint.title_text.width = title_width
    paint.title_text.height = title_height

    if !has_title {
        paint.title_background.width = 0.0
        paint.title_background.height = 0.0
        paint.title_text.width = 0.0
        paint.title_text.height = 0.0
    }

    return paint
}
