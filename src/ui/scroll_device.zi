#import "control_props"
#import "geometry"
#import "scroll"
#import "scroll_props"
#import "session"
#import "style"
#import "style_sheet"
#import "tree_input"
#import "drawing_props"

using ButtonState;

// One pointer can own a scroll drag, of a scrollbar thumb or of content, and
// one scroll can coast after a flicked content drag. The host samples the
// pointer and clock once per frame with BeginScrollFrame; each Scroll then
// observes the device and commits its frame.
ScrollDevice :: struct {
    session: Session
    mouse: Vector2
    pressed: bool
    down: bool
    released: bool
    wheel: float32
    // The sideways wheel, positive to the right, as touchpads and tilting
    // wheels send it; see ScrollDeviceSideways.
    wheel_x: float32
    wheel_consumed: bool
    owner: u64
    grab: float32
    content_drag: bool
    drag_origin_y: float32
    drag_origin_offset: s32
    drag_moving: bool
    // Where the pointer went down, for a drag that goes across a scroll.
    press_origin: Vector2
    sampled: bool
    now_seconds: float64
    // The owner's content velocity while dragging.
    sample_seconds: float64
    velocity: float32
    // The scroll that is coasting, if any, and its motion.
    fling_owner: u64
    fling_seconds: float64
    fling_velocity: float32
    // The scroll gliding to a wheel target, if any.
    glide_owner: u64
    glide_seconds: float64
    glide_target: s32
}

scroll_device: ScrollDevice;

// Retained views must continue composing while a drag, glide or fling owns
// this session. Motion can continue without another OS input event.
#program_export
ScrollDeviceMoving :: (session: Session) -> bool {
    return ScrollDeviceSampled(session) && (scroll_device.owner != cast(u64)0 ||
        scroll_device.fling_owner != cast(u64)0 || scroll_device.glide_owner != cast(u64)0)
}

ScrollDeviceRelease :: () {
    scroll_device.owner = cast(u64)0
    scroll_device.grab = 0.0
    scroll_device.content_drag = false
    scroll_device.drag_moving = false
    scroll_device.sample_seconds = 0.0
    scroll_device.velocity = 0.0
}

// Whether the host sampled the device for this session's frames.
ScrollDeviceSampled :: (session: Session) -> bool {
    return scroll_device.sampled && SessionValid(session) &&
        scroll_device.session.slot == session.slot &&
        scroll_device.session.epoch == session.epoch
}

#program_export
BeginScrollFrame :: (session: Session, mouse: Vector2, pressed: bool, down: bool,
    released: bool, wheel: float32, now_seconds: float64) {
    scroll_device.sampled = true
    scroll_device.now_seconds = now_seconds
    // A new touch or wheel stops a coasting scroll.
    if pressed || wheel != 0.0 { scroll_device.fling_owner = cast(u64)0 }
    if pressed {
        scroll_device.glide_owner = cast(u64)0
        scroll_device.press_origin = mouse
    }
    scroll_device.session = session
    scroll_device.mouse = mouse
    scroll_device.pressed = pressed
    scroll_device.down = down
    scroll_device.released = released
    scroll_device.wheel = wheel
    scroll_device.wheel_x = 0.0
    scroll_device.wheel_consumed = false
    if !down && !released {
        ScrollDeviceRelease()
    }
}

// The host's sideways wheel for this frame, positive to the right, after
// BeginScrollFrame. The wheel BeginScrollFrame took is then the vertical
// one only: sideways movement scrolls a sideways scroll and nothing else.
#program_export
ScrollDeviceSideways :: (session: Session, wheel_x: float32) {
    if !ScrollDeviceSampled(session) { return }
    scroll_device.wheel_x = wheel_x
    if wheel_x != 0.0 { scroll_device.fling_owner = cast(u64)0 }
}

// The pointer has moved across a scroll's axis by more than along it, far
// enough to tell.
ScrollDeviceAcross :: (horizontal: bool, scale: float32) -> bool {
    dx: float32 = ScrollWheelSize(scroll_device.mouse.x - scroll_device.press_origin.x)
    dy: float32 = ScrollWheelSize(scroll_device.mouse.y - scroll_device.press_origin.y)
    along: float32 = dy
    across: float32 = dx
    if horizontal {
        along = dx
        across = dy
    }
    if scale <= 0.0 { scale = 1.0 }
    return across >= 8.0 * scale && across >= along * 1.25
}

ScrollWheelSize :: (wheel: float32) -> float32 {
    if wheel < 0.0 { return 0.0 - wheel }
    return wheel
}

// The wheel a scroll moves by, positive toward its start. A sideways scroll
// moves with the vertical wheel too, unless the wheel moved more sideways.
ScrollDeviceWheelFor :: (horizontal: bool) -> float32 {
    if horizontal && ScrollWheelSize(scroll_device.wheel_x) > ScrollWheelSize(scroll_device.wheel) {
        return 0.0 - scroll_device.wheel_x
    }
    return scroll_device.wheel
}

#program_export
ScrollObservationFor :: (key: u64, bounds: Rectangle, horizontal: bool = false,
    scale: float32 = 1.0) -> ScrollInput {
    input: ScrollInput
    input.enabled = true
    input.device = true
    if !TreeScrollAllowed(scroll_device.session, key) {
        if scroll_device.owner == key { ScrollDeviceRelease() }
        if scroll_device.fling_owner == key { scroll_device.fling_owner = cast(u64)0 }
        if scroll_device.glide_owner == key { scroll_device.glide_owner = cast(u64)0 }
        input.disabled = true
        return input
    }
    input.mouse = scroll_device.mouse
    input.pressed = scroll_device.pressed
    input.down = scroll_device.down
    input.released = scroll_device.released
    input.owns_drag = key != cast(u64)0 && scroll_device.owner == key
    input.owner_captured = scroll_device.owner != cast(u64)0 && !input.owns_drag
    input.grab = scroll_device.grab
    input.now_seconds = scroll_device.now_seconds
    if input.owns_drag {
        input.content_drag = scroll_device.content_drag
        input.drag_origin_y = scroll_device.drag_origin_y
        input.drag_origin_offset = scroll_device.drag_origin_offset
        input.drag_moving = scroll_device.drag_moving
        input.sample_seconds = scroll_device.sample_seconds
        input.velocity = scroll_device.velocity
    } else if key != cast(u64)0 && scroll_device.fling_owner == key {
        input.flinging = true
        input.sample_seconds = scroll_device.fling_seconds
        input.velocity = scroll_device.fling_velocity
    } else if key != cast(u64)0 && scroll_device.glide_owner == key {
        input.gliding = true
        input.sample_seconds = scroll_device.glide_seconds
        input.glide_target = scroll_device.glide_target
    }
    inside: bool = ScrollPointInside(input.mouse, bounds)
    target: u64 = TreeScrollAt(scroll_device.session,
        input.mouse.x, input.mouse.y)
    targeted: bool = target == cast(u64)0 || target == key
    input.pointer_allowed = ((inside && targeted) || input.owns_drag) &&
        !input.owner_captured && !TreePointerCapturesDrag(scroll_device.session)
    // A content drag that has not moved the content lets go once the pointer
    // goes across this scroll's axis: the gesture belongs to what moves that
    // way, such as a row swiped sideways in a list. The press stays with it.
    if input.owns_drag && scroll_device.content_drag && !scroll_device.drag_moving &&
    ScrollDeviceAcross(horizontal, scale) {
        input.pointer_allowed = false
    }
    wheel_target: u64 = TreeScrollAt(scroll_device.session,
        input.mouse.x, input.mouse.y, true)
    wheel_targeted: bool = wheel_target == cast(u64)0 || wheel_target == key
    if inside && wheel_targeted && !scroll_device.wheel_consumed && !input.owner_captured {
        input.wheel = ScrollDeviceWheelFor(horizontal)
    }
    return input
}

// The wheel for a widget that scrolls its own content, such as a text area,
// while it has content out of view: the host's wheel when the pointer is
// over the widget, no scroll inside it is under the pointer, no drag owns
// the pointer and nothing took the wheel yet. The widget takes it, so a
// scroll submitted after it does not move too.
#program_export
ScrollWheelTake :: (session: Session, key: u64, bounds: Rectangle,
    scrolls: bool) -> float32 {
    if !scrolls || !ScrollDeviceSampled(session) || scroll_device.wheel == 0.0 ||
        scroll_device.wheel_consumed || scroll_device.owner != cast(u64)0 {
        return 0.0
    }
    if !TreeScrollAllowed(session, key) || !ScrollPointInside(scroll_device.mouse, bounds) {
        return 0.0
    }
    target: u64 = TreeScrollAt(session, scroll_device.mouse.x, scroll_device.mouse.y, true)
    if target != cast(u64)0 && target != key {
        return 0.0
    }
    scroll_device.wheel_consumed = true
    return scroll_device.wheel
}

// A widget that scrolls its own content, such as a text area on a touch
// screen, lets a drag of that content move it as Scroll does: the same slop
// before it moves, then the flick and coasting, with one drag per pointer.
// It gives its key, its bounds, how far its content scrolls and the offset
// it has, and keeps the returned frame's offset. The wheel stays the
// widget's own; see ScrollWheelTake. A frame that starts moving the content
// cancels the press it began with, so the widget no longer gets it. Content
// that scrolls sideways, as a row of tabs does, sets horizontal.
#program_export
ScrollDeviceContentDrag :: (session: Session, key: u64, bounds: Rectangle,
    max_scroll: s32, offset: s32, scale: float32, horizontal: bool = false) -> ScrollFrame {
    frame: ScrollFrame
    frame.offset = offset
    if key == cast(u64)0 || !ScrollDeviceSampled(session) { return frame }
    if max_scroll < 0 { max_scroll = 0 }
    input: ScrollFrameInput = ScrollFrameInputFor(ScrollObservationFor(key, bounds, horizontal, scale))
    input.bounds = bounds
    input.horizontal = horizontal
    input.content_height = cast(s32)bounds.height + max_scroll
    input.content_width = cast(s32)bounds.width + max_scroll
    input.has_offset = true
    input.offset = offset
    input.wheel = 0.0
    input.gliding = false
    track: StyleFrame = ScrollFace(StyleKindScroll(), 0, false,
        cast(s32)ButtonStateNormal, 10.0)
    thumb: StyleFrame = ScrollFace(StyleKindScrollThumb(), 0, false,
        cast(s32)ButtonStateNormal, 10.0)
    metrics: ScrollMetrics = ScrollMetricsFor(scale, track, thumb)
    // The content has no scrollbar of its own to press.
    metrics.scrollbar_width = 0
    frame = ScrollFrameFor(input, metrics)
    CommitScroll(key, frame)
    return frame
}

// Scroll commits its own frame when its input came from ScrollObservationFor.
#program_export
CommitScroll :: (key: u64, frame: ScrollFrame) {
    if frame.consume_wheel { scroll_device.wheel_consumed = true }
    if key == cast(u64)0 { return }
    if frame.flinging {
        scroll_device.fling_owner = key
        scroll_device.fling_seconds = frame.sample_seconds
        scroll_device.fling_velocity = frame.velocity
    } else if scroll_device.fling_owner == key {
        scroll_device.fling_owner = cast(u64)0
    }
    if frame.gliding {
        scroll_device.glide_owner = key
        scroll_device.glide_seconds = frame.sample_seconds
        scroll_device.glide_target = frame.glide_target
    } else if scroll_device.glide_owner == key {
        scroll_device.glide_owner = cast(u64)0
    }
    if frame.start_drag && scroll_device.owner == cast(u64)0 {
        scroll_device.owner = key
    }
    if scroll_device.owner != key { return }
    // A drag that starts moving on its release frame must not also tap.
    if frame.cancel_press {
        TreePointerCancel(scroll_device.session)
    }
    if frame.clear_drag {
        ScrollDeviceRelease()
        return
    }
    scroll_device.grab = frame.grab
    scroll_device.content_drag = frame.content_drag
    scroll_device.drag_origin_y = frame.drag_origin_y
    scroll_device.drag_origin_offset = frame.drag_origin_offset
    scroll_device.drag_moving = frame.drag_moving
    scroll_device.sample_seconds = frame.sample_seconds
    scroll_device.velocity = frame.velocity
}
