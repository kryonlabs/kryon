#import "kryon.h"

app "Kryon Geometry" {
    size 800 600
    fps 60
    font examples
}

GeometryExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        SetViewSize(GetScreenWidth(),GetScreenHeight())
        shell: Rectangle = {40,42,GetViewWidth()-80,GetViewHeight()-84}
        pad: float = 16.0f
        gap: float = 12.0f
        header: Rectangle = {shell.x+pad,shell.y+pad,shell.width-pad*2.0f,54}
        footer: Rectangle = {shell.x+pad,shell.y+shell.height-pad-46,shell.width-pad*2.0f,46}
        rail: Rectangle = {shell.x+pad,header.y+header.height+gap,150,footer.y-(header.y+header.height+gap)-gap}
        body: Rectangle = {rail.x+rail.width+gap,rail.y,shell.x+shell.width-pad-(rail.x+rail.width+gap),rail.height}
        grid_gap: float = 10.0f
        grid_pad: float = 16.0f
        cell_w: float = (body.width-grid_pad*2.0f-grid_gap*2.0f)/3.0f
        cell_h: float = (body.height-grid_pad*2.0f-grid_gap)/2.0f
        card0: Rectangle = {body.x+grid_pad,body.y+grid_pad,cell_w*2.0f+grid_gap,cell_h}
        card1: Rectangle = {body.x+grid_pad+(cell_w+grid_gap)*2.0f,body.y+grid_pad,cell_w,cell_h}
        card2: Rectangle = {body.x+grid_pad,body.y+grid_pad+cell_h+grid_gap,cell_w,cell_h}
        card3: Rectangle = {body.x+grid_pad+cell_w+grid_gap,body.y+grid_pad+cell_h+grid_gap,cell_w*2.0f+grid_gap,cell_h}
        badge: Rectangle = {card1.x+14,card1.y+42,92,28}
        action: Rectangle = {footer.x+16,footer.y+7,150,32}
        Text((TextProps){.bounds={40, 14, 0, 0}, .text="Geometry helpers", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(shell,GetThemeSurface(),GetThemeIcon())
        Box(header,GetThemeButton(),BLANK)
        Box(rail,DarkenColor(GetThemeSurface(),8),BLANK)
        Separator((SeparatorProps){.bounds = {rail.x+rail.width+6,rail.y,1,rail.height}, .vertical = true})
        Text((TextProps){.bounds={header.x+16, header.y+16, 0, 0}, .text="Packed header", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={rail.x+16, rail.y+16, 0, 0}, .text="Left rail", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(card0,DarkenColor(GetThemeSurface(),12),GetThemeButton())
        Box(card1,DarkenColor(GetThemeSurface(),16),GetThemeButton())
        Box(card2,DarkenColor(GetThemeSurface(),18),GetThemeButton())
        Box(card3,DarkenColor(GetThemeSurface(),22),GetThemeButton())
        Text((TextProps){.bounds={card0.x+14, card0.y+18, 0, 0}, .text="Wide card", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card1.x+14, card1.y+18, 0, 0}, .text="Badge card", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(badge,GetThemeButtonHover(),BLANK)
        Text((TextProps){.bounds={badge.x+18, badge.y+7, 0, 0}, .text="badge", .font=Text12, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card2.x+14, card2.y+18, 0, 0}, .text="cell 1,0", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card3.x+14, card3.y+18, 0, 0}, .text="wide footer cell", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Separator((SeparatorProps){.bounds = {footer.x,footer.y-7,footer.width,1}})
        Box(action,GetThemeButton(),BLANK)
        Text((TextProps){.bounds={action.x+14, action.y+9, 0, 0}, .text="placed action", .font=Text12, .color=GetThemeText(), .wrap=TextWrapNone})
    }
}
