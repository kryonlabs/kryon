#module "modal_widget"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "font_metrics"
#import "geometry"
#import "modal"
#import "modal_frame_widget"
#import "modal_props"
#import "paint_queue"
#import "semantic"
#import "style"
#import "style_sheet"
#import "surface"
#import "text_props"
#import "text_widget"
#import "tree"
#import "widget_kind"

ActionModalKey :: (props: ActionModalProps) -> u64 #export {
    if props.key != (u64)0 { return props.key }
    if props.id > 0 { return (u64)(u32)props.id }
    return TreeNextKey()
}

ActionModalWidth :: (action: ActionModalAction,
    font: i32, typeface: string, content_width: i32,
    metrics: ModalMetrics) -> i32 #export {
    width: i32 = ModalActionWidth(GlyphWidth(action.label,
        font, typeface), metrics)
    if width > content_width { width = content_width }
    if width < 1 { width = 1 }
    return width
}

ActionModalRows :: (actions: []ActionModalAction,
    content_width: i32, font: i32, typeface: string,
    metrics: ModalMetrics) -> i32 #export {
    if actions.length == 0 { return 0 }
    rows: i32 = 1
    row_width: i32 = 0
    index: i32 = 0
    while index < actions.length {
        width: i32 = ActionModalWidth(actions[index], font,
            typeface, content_width, metrics)
        rows = ModalActionRowsStep(row_width, rows, width,
            content_width, metrics.button_gap)
        row_width = ModalActionRowWidthStep(row_width, width,
            content_width, metrics.button_gap)
        index += 1
    }
    return rows
}

ActionModalDrawRow :: (props: ActionModalProps, modal_key: u64,
    actions: []ActionModalAction, first: i32, end: i32,
    row_width: i32, content_x: i32, content_width: i32,
    y: i32, font: i32, typeface: string,
    metrics: ModalMetrics) -> i32 #export {
    x: i32 = content_x + (content_width - row_width) / 2
    result: i32 = 0
    index: i32 = first
    while index < end {
        item: ActionModalAction = actions[index]
        width: i32 = ActionModalWidth(item, font,
            typeface, content_width, metrics)
        button: ButtonProps
        button.key = item.key
        if button.key == (u64)0 {
            button.key = modal_key *
                (u64)131071 + (u64)(u32)(index + 1)
        }
        button.id = props.id + index + 1
        button.class_name = props.class_name
        button.bounds = (Rectangle){(float)x, (float)y,
            (float)width, (float)metrics.button_height}
        button.label = item.label
        button.tone = item.tone
        button.emphasis = item.emphasis
        button.disabled = item.disabled
        button.style_kind = StyleKindModal()
        button.style_role = ModalActionRole()
        if Button(button) != 0 { result = index + 1 }
        x += width + metrics.button_gap
        index += 1
    }
    return result
}

# A checked message/action dialog. The caller receives a one-based action
# index, or -1 for backdrop/close dismissal. Prompt editing is a separate
# composition because it requires retained text-input state.
ActionModal :: (props: ActionModalProps,
    actions: []ActionModalAction) -> ActionModalResult #export {
    result: ActionModalResult
    result.node = -1
    viewport: Rectangle = TreeRootBounds()
    if viewport.width <= 0.0 || viewport.height <= 0.0 {
        return result
    }
    frame_props: ModalFrameProps
    frame_props.key = ActionModalKey(props)
    frame_props.id = props.id
    frame_props.class_name = props.class_name
    frame_props.title = props.title
    frame_props.scale = props.scale
    frame_props.has_right_action = props.show_close
    frame_props.right_label = props.close_label
    panel: StyleFrame = ModalFrameFaceFor(frame_props,
        ModalPanelRole())
    title: StyleFrame = ModalFrameFaceFor(frame_props,
        ModalTitleRole())
    message: StyleFrame = ModalFrameFaceFor(frame_props,
        ModalMessageRole())
    action: StyleFrame = ModalFrameFaceFor(frame_props,
        ModalActionRole())
    close: StyleFrame = ModalFrameFaceFor(frame_props,
        ModalCloseRole())
    scale: float = props.scale
    if scale <= 0.0 { scale = 1.0 }
    metrics: ModalMetrics = ModalMetricsFor(scale,
        panel, title, message, action, close)
    max_width: i32 = props.max_width
    if max_width > 0 { max_width = (i32)((float)max_width * scale) }
    width: i32 = ModalClampWidth((i32)viewport.width,
        max_width, metrics)
    content_width: i32 = ModalContentWidth(width, metrics)
    message_props: TextProps
    message_props.text = props.message
    message_props.bounds.width = (float)content_width
    message_props.wrap = (TextWrap)TextWrapAuto
    face: TextFace = DefaultTextFace()
    face.value = message.value
    face.fallback_font = 14
    prepared: PreparedText = PrepareText(message_props, face)
    message_height: i32 = (i32)prepared.bounds.height
    if props.message == "" { message_height = 0 }
    font: i32 = ResolveFont(0,
        StyleFontValue(action.value.fields,
            action.value.font_size), 14)
    rows: i32 = ActionModalRows(actions, content_width,
        font, action.value.typeface, metrics)
    top_gap: i32 = metrics.frame_content_y - metrics.title_height
    if top_gap < 0 { top_gap = 0 }
    layout: ModalLayout = ModalLayoutFor((i32)viewport.width,
        (i32)viewport.height, max_width,
        message_height + top_gap, rows, false, metrics)
    layout.panel.x += viewport.x
    layout.panel.y += viewport.y
    layout.message_x += (i32)viewport.x
    layout.message_y += (i32)viewport.y
    layout.button_y += (i32)viewport.y
    frame_props.bounds = layout.panel
    frame_props.width = (i32)layout.panel.width
    frame_props.height = (i32)layout.panel.height
    frame: ModalFrameResult = ModalFrame(frame_props)
    result.node = frame.node
    if frame.dismissed || frame.right_clicked {
        result.action = -1
        return result
    }
    if frame.panel_node < 0 || !TreePushScope(frame.panel_node) {
        return result
    }
    if props.message != "" {
        message_props.key = frame_props.key * (u64)65599 + (u64)3
        message_props.bounds.x = (float)layout.message_x
        message_props.bounds.y = (float)(layout.message_y + top_gap)
        message_props.bounds.height = (float)message_height
        available: i32 = layout.button_y -
            metrics.message_gap - (i32)message_props.bounds.y
        if rows == 0 {
            available = (i32)(layout.panel.y +
                layout.panel.height) - metrics.padding_bottom -
                (i32)message_props.bounds.y
        }
        if available < 0 { available = 0 }
        if message_props.bounds.height > (float)available {
            message_props.bounds.height = (float)available
        }
        prepared.bounds = message_props.bounds
        message_node: i32 = TreeSubmitCurrent(message_props.key,
            WidgetKindText, prepared.bounds)
        if message_node >= 0 {
            TreeSetLabel(message_node, props.message)
            TreeSetSemantic(message_node,
                (SemanticKind)SemanticParagraph, 0)
            PaintTextLines(message_node, message_props, prepared)
        }
    }
    row_start: i32 = 0
    row_width: i32 = 0
    row_y: i32 = layout.button_y
    index: i32 = 0
    while index <= actions.length {
        at_end: bool = index == actions.length
        next_width: i32 = 0
        if !at_end {
            width = ActionModalWidth(actions[index], font,
                action.value.typeface, content_width, metrics)
            next_width = ModalActionRowWidthStep(row_width,
                width, content_width, metrics.button_gap)
        }
        if at_end || (row_width > 0 &&
            next_width == width &&
            row_width + metrics.button_gap + width > content_width) {
            if index > row_start {
                chosen: i32 = ActionModalDrawRow(props,
                    frame_props.key, actions,
                    row_start, index, row_width, layout.message_x,
                    content_width, row_y, font,
                    action.value.typeface, metrics)
                if chosen > 0 { result.action = chosen }
                row_y = ModalActionNextY(row_y,
                    metrics.button_height, metrics.button_gap)
            }
            row_start = index
            row_width = 0
        }
        if !at_end {
            width = ActionModalWidth(actions[index], font,
                action.value.typeface, content_width, metrics)
            row_width = ModalActionRowWidthStep(row_width,
                width, content_width, metrics.button_gap)
        }
        index += 1
    }
    End()
    return result
}
