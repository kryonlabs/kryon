ThemeMotionPurposeRole :: enum {
    ThemeMotionHighlight :: 0
    ThemeMotionHover :: 1
    ThemeMotionState :: 2
    ThemeMotionEnter :: 3
    ThemeMotionExit :: 4
    ThemeMotionTheme :: 5
}
using ThemeMotionPurposeRole;

#program_export
LightPalette :: () -> Palette {
    palette: Palette
    palette.background = cast(u32)0xffffffff; palette.surface = cast(u32)0xffffffff
    palette.surface_raised = cast(u32)0xffffffff; palette.surface_muted = cast(u32)0xf8f8f8ff
    palette.surface_sunken = cast(u32)0xf3f3f3ff; palette.foreground = cast(u32)0x0b0b0bff
    palette.text_secondary = cast(u32)0x585858ff; palette.text_muted = cast(u32)0x767676ff
    palette.text_disabled = cast(u32)0x76767692; palette.icon = palette.foreground
    palette.icon_muted = palette.text_muted; palette.border = cast(u32)0xe3e3e3ff
    palette.subtle_border = cast(u32)0xf0f0f0ff; palette.strong_border = cast(u32)0x949494ff
    palette.focus = cast(u32)0x1f7dcfe6; palette.hover_layer = cast(u32)0x0b0b0b0d
    palette.active_layer = cast(u32)0x0b0b0b13; palette.scrim = cast(u32)0x0a0a0c52
    palette.selection = cast(u32)0x00864b21; palette.selection_text = cast(u32)0x006c36ff
    palette.accent = cast(u32)0x00864bff; palette.accent_strong = cast(u32)0x006c36ff
    palette.accent_subtle = cast(u32)0x00864b21; palette.on_accent = cast(u32)0xffffffff
    palette.control_on = cast(u32)0x00864bff; palette.control_glyph = cast(u32)0xffffffff
    palette.control_track = cast(u32)0xdcdcdcff; palette.control_track_hover = cast(u32)0xd1d1d1ff
    palette.control_thumb = cast(u32)0xffffffff; palette.control_thumb_on = cast(u32)0xffffffff
    palette.success = cast(u32)0x00774dff; palette.on_success = cast(u32)0xffffffff
    palette.warning = cast(u32)0x9f6202ff; palette.on_warning = cast(u32)0xffffffff
    palette.danger = cast(u32)0xc9302dff; palette.on_danger = cast(u32)0xffffffff
    palette.info = cast(u32)0x136d9eff; palette.on_info = cast(u32)0xffffffff
    palette.link = palette.accent; palette.shadow = cast(u32)0x00000009
    return palette
}

#program_export
DarkPalette :: () -> Palette {
    palette: Palette = LightPalette()
    palette.background = cast(u32)0x121212ff; palette.surface = cast(u32)0x181818ff
    palette.surface_raised = cast(u32)0x1f1f1fff; palette.surface_muted = cast(u32)0x1f1f1fff
    palette.surface_sunken = cast(u32)0x0e0e0eff; palette.foreground = cast(u32)0xf2f2f2ff
    palette.text_secondary = cast(u32)0xb4b4b4ff; palette.text_muted = cast(u32)0x8c8c8cff
    palette.text_disabled = cast(u32)0x8c8c8c92; palette.border = cast(u32)0x2b2b2bff
    palette.subtle_border = cast(u32)0x222222ff; palette.strong_border = cast(u32)0x676767ff
    palette.focus = cast(u32)0x55adffe6; palette.hover_layer = cast(u32)0xf2f2f20d
    palette.active_layer = cast(u32)0xf2f2f213; palette.scrim = cast(u32)0x0000008c
    palette.selection = cast(u32)0x53dca633; palette.selection_text = cast(u32)0x93efd0ff
    palette.accent = cast(u32)0x53dca6ff; palette.accent_strong = cast(u32)0x93efd0ff
    palette.accent_subtle = cast(u32)0x53dca633; palette.on_accent = cast(u32)0x102016ff
    palette.control_on = cast(u32)0x1fae78ff; palette.control_glyph = cast(u32)0xffffffff
    palette.control_track = cast(u32)0x353535ff; palette.control_track_hover = cast(u32)0x404040ff
    palette.control_thumb = cast(u32)0xf7f7f7ff; palette.control_thumb_on = cast(u32)0x1d1d1dff
    palette.success = cast(u32)0x55d69fff; palette.on_success = cast(u32)0x102016ff
    palette.warning = cast(u32)0xf2bd68ff; palette.on_warning = cast(u32)0x241d0aff
    palette.danger = cast(u32)0xf2716cff; palette.on_danger = cast(u32)0x2a0d0bff
    palette.info = cast(u32)0x7cc4f0ff; palette.on_info = cast(u32)0x0b1a25ff
    palette.icon = palette.foreground; palette.icon_muted = palette.text_muted
    palette.link = palette.accent
    palette.shadow = cast(u32)0x0000002e
    return palette
}

#program_export
DefaultFonts :: () -> FontTokens {
    fonts: FontTokens
    fonts.body = "Inter"
    fonts.control = "Inter Medium"
    fonts.heading = "Geist Medium"
    fonts.code = "Geist Mono"
    fonts.icon = "Lucide"
    return fonts
}

#program_export
DefaultMetrics :: () -> Metrics {
    metrics: Metrics
    metrics.radius_mark = 6.0; metrics.radius_item = 8.0; metrics.radius_small = 6.0
    metrics.radius_medium = 10.0; metrics.radius_large = 14.0; metrics.radius_surface = 18.0
    metrics.radius_pill = 999.0; metrics.border_width = 1.0; metrics.focus_width = 2.0
    metrics.focus_gap = 3.0; metrics.space_1 = 4.0; metrics.space_2 = 8.0; metrics.space_3 = 12.0
    metrics.space_4 = 16.0; metrics.space_5 = 20.0; metrics.space_6 = 24.0
    metrics.control_height_small = 30.0; metrics.control_height_medium = 36.0
    metrics.control_height_large = 44.0; metrics.control_padding_small = 8.0
    metrics.control_padding_medium = 10.0; metrics.control_padding_large = 12.0
    metrics.control_gap = 8.0; metrics.text_xs = 11.0; metrics.text_sm = 12.0
    metrics.text_body = 13.0; metrics.text_lg = 15.0; metrics.heading_1 = 36.0
    metrics.heading_2 = 28.0; metrics.heading_3 = 22.0; metrics.heading_4 = 17.0
    metrics.icon_size_small = 12.0; metrics.icon_size_medium = 14.0
    metrics.icon_size_large = 16.0; metrics.disabled_opacity = 0.55
    return metrics
}

#program_export
DefaultShadows :: (dark: bool) -> ShadowTokens {
    shadows: ShadowTokens
    if dark {
        shadows.rest = ShadowLayer.{1.0, 2.0, 0.0, 0.18}
        shadows.raised[0] = ShadowLayer.{8.0, 22.0, 0.0, 0.22}
        shadows.floating[0] = ShadowLayer.{14.0, 36.0, -4.0, 0.40}
        shadows.floating[1] = ShadowLayer.{1.0, 3.0, 0.0, 0.24}
    } else {
        shadows.rest = ShadowLayer.{1.0, 2.0, 0.0, 0.035}
        shadows.raised[0] = ShadowLayer.{6.0, 18.0, 0.0, 0.065}
        shadows.raised[1] = ShadowLayer.{1.0, 3.0, 0.0, 0.035}
        shadows.floating[0] = ShadowLayer.{12.0, 32.0, -4.0, 0.12}
        shadows.floating[1] = ShadowLayer.{1.0, 3.0, 0.0, 0.06}
    }
    return shadows
}

#program_export
DefaultMotion :: (reduced_motion: bool) -> MotionTokens {
    motion: MotionTokens
    motion.highlight_ms = 100.0; motion.hover_ms = 140.0; motion.state_ms = 180.0
    motion.enter_ms = 260.0; motion.exit_ms = 160.0; motion.theme_ms = 320.0
    motion.multiplier = 1.0; motion.saved_multiplier = 1.0
    motion.reduced_motion = reduced_motion
    if reduced_motion { motion.multiplier = 0.0 }
    motion.oklab_theme_transition = true
    return motion
}

#program_export
DefaultTheme :: (dark: bool, reduced_motion: bool = false) -> ThemeTokens {
    theme: ThemeTokens
    theme.dark = dark
    theme.colors = ifx dark then DarkPalette() else LightPalette()
    theme.metrics = DefaultMetrics(); theme.shadows = DefaultShadows(dark)
    theme.motion = DefaultMotion(reduced_motion)
    theme.fonts = DefaultFonts()
    if dark {
        theme.series.items = .{cast(u32)0x20ab7aff, cast(u32)0x8e7fe6ff,
            cast(u32)0xd17f00ff, cast(u32)0xdd6197ff, cast(u32)0x4892edff, cast(u32)0xe8672eff}
    } else {
        theme.series.items = .{cast(u32)0x1baf7aff, cast(u32)0x6250d6ff,
            cast(u32)0xeda100ff, cast(u32)0xe87ba4ff, cast(u32)0x2a78d6ff, cast(u32)0xeb6834ff}
    }
    return theme
}

active_theme: ThemeTokens;
active_theme_ready: bool;

#program_export
InstallTheme :: (theme: ThemeTokens) -> bool {
    active_theme = theme; active_theme_ready = true; return true
}

#program_export
InstallDefaultTheme :: (dark: bool, reduced_motion: bool = false) -> bool {
    return InstallTheme(DefaultTheme(dark, reduced_motion))
}

#program_export
CurrentTheme :: () -> ThemeTokens {
    if !active_theme_ready { return DefaultTheme(false) }
    return active_theme
}

#program_export
SetThemeMode :: (dark: bool) -> bool {
    theme: ThemeTokens = CurrentTheme()
    if theme.dark == dark { return true }
    replacement := DefaultTheme(dark, theme.motion.reduced_motion)
    replacement.metrics = theme.metrics
    replacement.fonts = theme.fonts
    replacement.motion = theme.motion
    return InstallTheme(replacement)
}

#program_export
SetReducedMotion :: (reduced_motion: bool) -> bool {
    theme: ThemeTokens = CurrentTheme()
    theme.motion.reduced_motion = reduced_motion
    if reduced_motion {
        if theme.motion.multiplier > 0.0 { theme.motion.saved_multiplier = theme.motion.multiplier }
        theme.motion.multiplier = 0.0
    } else {
        if theme.motion.multiplier > 0.0 { theme.motion.saved_multiplier = theme.motion.multiplier }
        theme.motion.multiplier = theme.motion.saved_multiplier
    }
    return InstallTheme(theme)
}

#program_export
WithAccent :: (theme: ThemeTokens, accent: u32, on_accent: u32,
    accent_strong: u32, accent_subtle: u32) -> ThemeTokens {
    result: ThemeTokens = theme
    result.colors.accent = accent; result.colors.on_accent = on_accent
    result.colors.accent_strong = accent_strong; result.colors.accent_subtle = accent_subtle
    result.colors.selection = accent_subtle; result.colors.selection_text = accent_strong
    result.colors.link = accent
    result.colors.control_on = accent
    result.colors.control_glyph = OnColor(accent)
    result.colors.control_thumb_on = OnColor(accent)
    return result
}

#program_export
FontSizeForRole :: (theme: ThemeTokens, role: s32) -> float32 {
    if role == 1 { return theme.metrics.text_body }
    if role == 2 { return theme.metrics.text_body }
    if role == 3 { return theme.metrics.heading_3 }
    return theme.metrics.text_sm
}

#program_export
FontForRole :: (theme: ThemeTokens, role: s32) -> string {
    if role == 1 { return theme.fonts.control }
    if role == 2 { return theme.fonts.body }
    if role == 3 { return theme.fonts.heading }
    if role == 4 { return theme.fonts.code }
    return theme.fonts.body
}

#program_export
DefaultPalette :: (dark: bool) -> Palette {
    return ifx dark then DarkPalette() else LightPalette()
}

#program_export
ThemeColorValue :: (theme: ThemeTokens, role: ThemeColorRole) -> u32 {
    colors := theme.colors
    if role == .ThemeColorSurface { return colors.surface }
    if role == .ThemeColorSurfaceRaised { return colors.surface_raised }
    if role == .ThemeColorSurfaceMuted { return colors.surface_muted }
    if role == .ThemeColorSurfaceSunken { return colors.surface_sunken }
    if role == .ThemeColorForeground { return colors.foreground }
    if role == .ThemeColorTextSecondary { return colors.text_secondary }
    if role == .ThemeColorTextMuted { return colors.text_muted }
    if role == .ThemeColorTextDisabled { return colors.text_disabled }
    if role == .ThemeColorIcon { return colors.icon }
    if role == .ThemeColorIconMuted { return colors.icon_muted }
    if role == .ThemeColorBorder { return colors.border }
    if role == .ThemeColorSubtleBorder { return colors.subtle_border }
    if role == .ThemeColorStrongBorder { return colors.strong_border }
    if role == .ThemeColorFocus { return colors.focus }
    if role == .ThemeColorHoverLayer { return colors.hover_layer }
    if role == .ThemeColorActiveLayer { return colors.active_layer }
    if role == .ThemeColorScrim { return colors.scrim }
    if role == .ThemeColorSelection { return colors.selection }
    if role == .ThemeColorSelectionText { return colors.selection_text }
    if role == .ThemeColorAccent { return colors.accent }
    if role == .ThemeColorAccentStrong { return colors.accent_strong }
    if role == .ThemeColorAccentSubtle { return colors.accent_subtle }
    if role == .ThemeColorOnAccent { return colors.on_accent }
    if role == .ThemeColorControlOn { return colors.control_on }
    if role == .ThemeColorControlGlyph { return colors.control_glyph }
    if role == .ThemeColorControlTrack { return colors.control_track }
    if role == .ThemeColorControlTrackHover { return colors.control_track_hover }
    if role == .ThemeColorControlThumb { return colors.control_thumb }
    if role == .ThemeColorControlThumbOn { return colors.control_thumb_on }
    if role == .ThemeColorSuccess { return colors.success }
    if role == .ThemeColorOnSuccess { return colors.on_success }
    if role == .ThemeColorWarning { return colors.warning }
    if role == .ThemeColorOnWarning { return colors.on_warning }
    if role == .ThemeColorDanger { return colors.danger }
    if role == .ThemeColorOnDanger { return colors.on_danger }
    if role == .ThemeColorInfo { return colors.info }
    if role == .ThemeColorOnInfo { return colors.on_info }
    if role == .ThemeColorLink { return colors.link }
    if role == .ThemeColorShadow { return colors.shadow }
    return colors.background
}

#program_export
ThemeSeriesValue :: (theme: ThemeTokens, index: s32) -> u32 {
    if index < 0 || index >= cast(s32)theme.series.items.count { return theme.colors.accent }
    return theme.series.items[index]
}

#program_export
ThemeMetricValue :: (theme: ThemeTokens, role: ThemeMetricRole) -> float32 {
    metrics := theme.metrics
    if role == .ThemeMetricRadiusItem { return metrics.radius_item }
    if role == .ThemeMetricRadiusSmall { return metrics.radius_small }
    if role == .ThemeMetricRadiusControl { return metrics.radius_medium }
    if role == .ThemeMetricRadiusPanel { return metrics.radius_large }
    if role == .ThemeMetricRadiusSurface { return metrics.radius_surface }
    if role == .ThemeMetricRadiusPill { return metrics.radius_pill }
    if role == .ThemeMetricBorderWidth { return metrics.border_width }
    if role == .ThemeMetricFocusWidth { return metrics.focus_width }
    if role == .ThemeMetricFocusGap { return metrics.focus_gap }
    if role == .ThemeMetricSpace1 { return metrics.space_1 }
    if role == .ThemeMetricSpace2 { return metrics.space_2 }
    if role == .ThemeMetricSpace3 { return metrics.space_3 }
    if role == .ThemeMetricSpace4 { return metrics.space_4 }
    if role == .ThemeMetricSpace5 { return metrics.space_5 }
    if role == .ThemeMetricSpace6 { return metrics.space_6 }
    if role == .ThemeMetricControlHeightSmall { return metrics.control_height_small }
    if role == .ThemeMetricControlHeightMedium { return metrics.control_height_medium }
    if role == .ThemeMetricControlHeightLarge { return metrics.control_height_large }
    if role == .ThemeMetricControlPaddingSmall { return metrics.control_padding_small }
    if role == .ThemeMetricControlPaddingMedium { return metrics.control_padding_medium }
    if role == .ThemeMetricControlPaddingLarge { return metrics.control_padding_large }
    if role == .ThemeMetricControlGap { return metrics.control_gap }
    if role == .ThemeMetricTextXS { return metrics.text_xs }
    if role == .ThemeMetricTextSM { return metrics.text_sm }
    if role == .ThemeMetricTextBody { return metrics.text_body }
    if role == .ThemeMetricTextLG { return metrics.text_lg }
    if role == .ThemeMetricHeading1 { return metrics.heading_1 }
    if role == .ThemeMetricHeading2 { return metrics.heading_2 }
    if role == .ThemeMetricHeading3 { return metrics.heading_3 }
    if role == .ThemeMetricHeading4 { return metrics.heading_4 }
    if role == .ThemeMetricIconSmall { return metrics.icon_size_small }
    if role == .ThemeMetricIconMedium { return metrics.icon_size_medium }
    if role == .ThemeMetricIconLarge { return metrics.icon_size_large }
    if role == .ThemeMetricDisabledOpacity { return metrics.disabled_opacity }
    return metrics.radius_mark
}

#program_export
CurrentThemeColor :: (role: ThemeColorRole) -> u32 {
    return ThemeColorValue(CurrentTheme(), role)
}

#program_export
CurrentThemeSeries :: (index: s32) -> u32 {
    return ThemeSeriesValue(CurrentTheme(), index)
}

#program_export
CurrentThemeMetric :: (role: ThemeMetricRole) -> float32 {
    return ThemeMetricValue(CurrentTheme(), role)
}

