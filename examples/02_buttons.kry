        ButtonStateNormal, ButtonStateHover, ButtonStatePressed,
        ButtonStateFocus, ButtonStateDisabled, ButtonStateLoading
    }
    tone_names: [8] const char* = {
        "Primary", "Secondary", "Outline", "Ghost", "Danger", "Success", "Warning", "Link"
