// Dashboard starter: a service monitor composed from layout containers and
// the stylesheet in styles.zi. Containers place and size every child, so
// the frame computes no rectangles and no keys.
Alert :: #import "kryon/alert";
Badge :: #import "kryon/badge";
Button :: #import "kryon/button";
Checkbox :: #import "kryon/checkbox";
EmptyState :: #import "kryon/empty_state";
Layout :: #import "kryon/layout";
Loading :: #import "kryon/loading_indicator";
Modal :: #import "kryon/modal";
Progress :: #import "kryon/progress";
Scroll :: #import "kryon/scroll";
Separator :: #import "kryon/separator";
Text :: #import "kryon/text";
TextField :: #import "kryon/text_field";
Toggle :: #import "kryon/toggle";
Theme :: #import "kryon/theme";
#import "kryon/control_props"
#import "kryon/frame_snapshot"
#import "kryon/geometry"
#import "kryon/grid_props"
#import "kryon/semantic"
#import "kryon/session"
#import "kryon/style_sheet"
#import "kryon/tree"
#import "model"
#import "styles"

using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ContentAlignment;
using SemanticKind;

SEARCH_FOCUS :: 200
WORKSPACE_FOCUS :: 902

// Application state across frames.
initialized: bool;
dark_theme: bool;
compact_density: bool;
auto_refresh: bool = true;
active_section: NavSection;
active_filter: StatusFilter;
view_state: ViewState;
selected_service: s32 = 0;
results_scroll: s32 = 0;
// The rows' height when they last drew, for the scroll range.
results_height: s32 = 0;
settings_open: bool;
alert_state: Alert.AlertState;
search_bytes: [128]u8;
search_state: TextField.State;
workspace_bytes: [64]u8;
workspace_length: s32;
draft_bytes: [64]u8;
draft_state: TextField.State;
draft_dark: bool;
draft_compact: bool;
draft_auto_refresh: bool;
focus_workspace_pending: bool;

// Frame-local text.
kpi_latency_buf: [24]u8;
kpi_uptime_buf: [24]u8;
kpi_healthy_buf: [24]u8;
count_label_buf: [48]u8;
row_latency_buf: [8][24]u8;
detail_uptime_buf: [24]u8;
detail_latency_buf: [24]u8;
detail_rps_buf: [32]u8;
filtered_indices: [SERVICE_COUNT]s32;

fixture_configured: bool;
fixture_name: string = "";

NAV_LABELS :: string.["Overview", "Services", "Incidents", "Audit"];
FILTER_LABELS :: string.["All", "Healthy", "Attention"];
STATE_LABELS :: string.["Ready", "Loading", "Error"];

DashboardSetFixture :: (name: string) {
    fixture_name = name
    fixture_configured = true
    initialized = false
}

ResetSearch :: () {
    search_state.length = 0
    search_state.cursor = 0
    search_state.anchor = 0
    search_state.scroll_x = 0
}

// Preview fixtures start the dashboard in one theme or state.
ApplyFixturePreset :: (name: string) {
    dark_theme = Theme.CurrentTheme().dark
    if name == "dark" || name == "dark-wide" || name == "dark-narrow" || name == "settings-dark" { dark_theme = true }
    if name == "light" || name == "light-wide" || name == "light-narrow" { dark_theme = false }
    if name == "loading" { view_state = .ViewLoading }
    if name == "error" { view_state = .ViewError }
    if name == "empty" {
        view_state = .ViewEmpty
        search_state.length = CopyIntoBuffer(search_bytes[:], "nonexistent-region")
        search_state.cursor = search_state.length
        search_state.anchor = search_state.length
    }
    if name == "settings" || name == "settings-dark" { OpenSettingsModal() }
}

OpenSettingsModal :: () {
    draft_dark = dark_theme
    draft_compact = compact_density
    draft_auto_refresh = auto_refresh
    draft_state.bytes = draft_bytes[:]
    draft_state.length = CopyIntoBuffer(draft_bytes[:], TextView(workspace_bytes[0:workspace_length]))
    draft_state.cursor = draft_state.length
    draft_state.anchor = draft_state.length
    draft_state.scroll_x = 0
    draft_state.focused = true
    focus_workspace_pending = true
    settings_open = true
}

CommitSettingsModal :: () {
    dark_theme = draft_dark
    compact_density = draft_compact
    auto_refresh = draft_auto_refresh
    if draft_state.length > 0 {
        workspace_length = CopyIntoBuffer(workspace_bytes[:], TextView(draft_bytes[0:draft_state.length]))
    }
    settings_open = false
}

EnsureInitialized :: () {
    if initialized { return }
    search_state.bytes = search_bytes[:]
    draft_state.bytes = draft_bytes[:]
    workspace_length = CopyIntoBuffer(workspace_bytes[:], "Production Cluster")
    if fixture_configured { ApplyFixturePreset(fixture_name) }
    else { dark_theme = Theme.CurrentTheme().dark }
    initialized = true
}

HealthBadgeTone :: (health: ServiceHealth) -> Badge.BadgeTone {
    if health == .HealthHealthy { return .BadgeToneSuccess }
    if health == .HealthDegraded { return .BadgeToneWarning }
    return .BadgeToneDanger
}

Class :: (name: string) -> s32 { return ClassId(name) }

// Container scopes: draw children when one opened, then End.
Box :: (session: Session, class_name: string) -> bool {
    return Layout.Draw(session, Layout.Props.{.class_name = Class(class_name)}).opened
}

// A slot of fixed height for a composite widget that lays out its own
// children from its bounds (Alert, EmptyState, the loading spinner).
Slot :: (session: Session, height: float32) -> Layout.LayoutContainer {
    return Layout.Stack(session, Layout.Props.{.bounds = .{height = height}})
}

Cells :: (session: Session, class_name: string) -> bool {
    grid := Layout.Grid(session, GridProps.{.class_name = Class(class_name)})
    return grid.container.opened
}

Line :: (session: Session, text: string, class_name: string) {
    Text.Draw(session, Text.Props.{.text = text, .class_name = Class(class_name), .wrap = .TextWrapEllipsis})
}

Heading :: (session: Session, text: string, class_name: string, level: s32) {
    Text.Draw(session, Text.Props.{.text = text, .class_name = Class(class_name),
        .semantic_kind = .SemanticHeading, .heading_level = level, .wrap = .TextWrapEllipsis})
}

Chip :: (session: Session, label: string, selected: bool) -> bool {
    return Button.Draw(session, Button.Props.{.class_name = Class("chip"), .label = label,
        .size = .ControlSizeSmall, .selected = selected, .fit_content = true,
        .emphasis = ifx selected then .ButtonEmphasisSoft else .ButtonEmphasisOutline,
        .tone = ifx selected then .ButtonToneAccent else .ButtonToneNeutral}) != 0
}

ChooseSection :: (index: s32) {
    active_section = cast(NavSection)index
    view_state = .ViewReady
    results_scroll = 0
}

Nav :: (session: Session, wide: bool) {
    for i: cast(s32)0..3 {
        selected := cast(s32)active_section == i
        if Button.Draw(session, Button.Props.{.class_name = Class(ifx wide then "nav-item" else "chip"),
            .label = NAV_LABELS[i], .selected = selected, .content_alignment = .ContentAlignmentStart,
            .emphasis = ifx selected then .ButtonEmphasisSoft else .ButtonEmphasisGhost,
            .tone = ifx selected then .ButtonToneAccent else .ButtonToneNeutral, .full_width = true}) != 0 {
            ChooseSection(i)
        }
    }
}

Sidebar :: (session: Session) {
    if !Box(session, "sidebar") { return }
    Heading(session, "Pulseboard", "brand", 1)
    Line(session, TextView(workspace_bytes[0:workspace_length]), "muted")
    Nav(session, true)
    SettingsButtons(session, "Light mode", "Dark mode")
    unused End(session)
}

SettingsButtons :: (session: Session, light: string, dark: string) {
    if Button.Draw(session, Button.Props.{.class_name = Class("chip"), .label = ifx dark_theme then light else dark,
        .emphasis = .ButtonEmphasisOutline, .fit_content = true}) != 0 {
        dark_theme = !dark_theme
    }
    if Button.Draw(session, Button.Props.{.class_name = Class("chip"), .label = "Settings",
        .emphasis = .ButtonEmphasisSoft, .fit_content = true}) != 0 {
        OpenSettingsModal()
    }
}

Header :: (session: Session, wide: bool) {
    if !Layout.Row(session, Layout.Props.{.class_name = Class("header")}).opened { return }
    Heading(session, SectionLabel(active_section), "title", 1)
    if Layout.Row(session, Layout.Props.{.class_name = Class("header-actions")}).opened {
        if wide {
            states: [3]ViewState = .[.ViewReady, .ViewLoading, .ViewError]
            for s: 0..2 {
                if Chip(session, STATE_LABELS[s], view_state == states[s]) {
                    view_state = states[s]
                    alert_state.dismissed = false
                }
            }
        } else {
            SettingsButtons(session, "Light", "Dark")
        }
        unused End(session)
    }
    unused End(session)
}

NavStrip :: (session: Session) {
    if !Cells(session, "nav-strip") { return }
    Nav(session, false)
    unused End(session)
}

KpiCard :: (session: Session, title: string, value: string, badge: string, tone: Badge.BadgeTone,
    progress: s32, most: s32) {
    if !Box(session, "kpi") { return }
    if Layout.Row(session, Layout.Props.{.class_name = Class("kpi-top")}).opened {
        Line(session, title, "muted")
        if Layout.Row(session, Layout.Props.{.class_name = Class("badge-slot")}).opened {
            Badge.Draw(session, Badge.Props.{.text = badge, .tone = tone, .size = .ControlSizeSmall})
            unused End(session)
        }
        unused End(session)
    }
    Heading(session, value, "kpi-value", 3)
    Progress.Draw(session, Progress.Props.{.bounds = .{height = 6.0}, .min = 0, .max = most, .value = progress})
    unused End(session)
}

Kpis :: (session: Session, wide: bool) {
    metrics := ComputeMetrics()
    healthy: Vec(u8)
    BuilderPrint(*healthy, "%/%", metrics.healthy, metrics.total)
    healthy_text := TextView(kpi_healthy_buf[0:CopyIntoBuffer(kpi_healthy_buf[:], BuilderFinish(healthy))])
    latency := FormatLatency(metrics.avg_latency_ms, kpi_latency_buf[:])
    if !Cells(session, "kpis") { return }
    if wide {
        KpiCard(session, "Healthy services", healthy_text, ifx metrics.offline > 0 then "1 offline" else "Nominal",
            ifx metrics.offline > 0 then .BadgeToneWarning else .BadgeToneSuccess, metrics.healthy, metrics.total)
        KpiCard(session, "Mean p95 latency", latency, "EU / US", .BadgeToneInfo, 200 - metrics.avg_latency_ms, 200)
        KpiCard(session, "Availability SLA", FormatPercentTenths(metrics.avg_uptime_tenths, kpi_uptime_buf[:]),
            "30d", .BadgeToneAccent, metrics.avg_uptime_tenths, 1000)
    } else {
        KpiCard(session, "Healthy", healthy_text, "SLA", .BadgeToneSuccess, metrics.healthy, metrics.total)
        KpiCard(session, "Latency", latency, "p95", .BadgeToneInfo, 200 - metrics.avg_latency_ms, 200)
    }
    unused End(session)
}

Toolbar :: (session: Session) {
    unused TextField.Bind(session, *search_state, TextField.Props.{.focus_id = SEARCH_FOCUS,
        .class_name = Class("search-field"), .label = "Search services",
        .placeholder = "Search services, regions, owners...", .clear_label = "Clear search"})
    if !Layout.Row(session, Layout.Props.{.class_name = Class("filters")}).opened { return }
    for f: cast(s32)0..2 {
        if Chip(session, FILTER_LABELS[f], cast(s32)active_filter == f) {
            active_filter = cast(StatusFilter)f
            view_state = .ViewReady
            results_scroll = 0
        }
    }
    unused End(session)
}

LoadingState :: (session: Session, now: float64) {
    if !Box(session, "state-card") { return }
    spinner := Slot(session, 32.0)
    if spinner.opened {
        Loading.Draw(session, Loading.Props.{.bounds = spinner.content, .now = now, .scale = 1.0})
        unused End(session)
    }
    Line(session, "Refreshing service telemetry...", "state-text")
    if Box(session, "centered-action") {
        if Button.Draw(session, Button.Props.{.label = "Cancel refresh", .emphasis = .ButtonEmphasisOutline}) != 0 {
            view_state = .ViewReady
        }
        unused End(session)
    }
    unused End(session)
}

ErrorState :: (session: Session) {
    alert := Slot(session, 74.0)
    if alert.opened {
        unused Alert.Draw(session, Alert.Props.{.bounds = alert.content, .title = "Telemetry sync failed",
            .description = "Collector endpoint eu-west-1 returned HTTP 503 Service Unavailable.",
            .tone = .AlertToneDanger, .dismissible = false}, *alert_state)
        unused End(session)
    }
    if !Layout.Row(session, Layout.Props.{.class_name = Class("actions")}).opened { return }
    if Button.Draw(session, Button.Props.{.class_name = Class("primary-btn"), .label = "Retry sync",
        .tone = .ButtonToneAccent, .emphasis = .ButtonEmphasisFilled}) != 0 {
        view_state = .ViewReady
    }
    if Button.Draw(session, Button.Props.{.label = "Open settings", .emphasis = .ButtonEmphasisOutline}) != 0 {
        OpenSettingsModal()
    }
    unused End(session)
}

ResultRows :: (session: Session, count: s32) {
    Line(session, FormatCountOf(count, SERVICE_COUNT, count_label_buf[:]), "muted")
    area := Layout.Draw(session, Layout.Props.{.class_name = Class("scroll-area")})
    if !area.opened { return }
    scroll := Scroll.Draw(session, Scroll.Props.{.bounds = area.content, .content_height = results_height,
        .scroll_offset = results_scroll})
    results_scroll = scroll.scroll_offset
    if scroll.opened {
        rows := Layout.Draw(session, Layout.Props.{.class_name = Class("rows"),
            .bounds = .{x = scroll.content.x, y = scroll.content.y, width = scroll.viewport.width}})
        if rows.opened {
            for i: cast(s32)0..count - 1 {
                index := filtered_indices[i]
                item := SERVICES[index]
                latency := FormatLatency(item.latency_ms, row_latency_buf[index][:])
                detail: Vec(u8)
                if active_section == .NavAudit { BuilderPrint(*detail, "%  -  %", item.audit_note, latency) }
                else { BuilderPrint(*detail, "%  |  %  |  %  |  %", HealthLabel(item.health), item.region, item.owner, latency) }
                selected := index == selected_service
                if Button.Draw(session, Button.Props.{.key = Layout.KeyHash(item.name), .class_name = Class("result-row"),
                    .label = item.name, .detail = BuilderFinish(detail), .selected = selected,
                    .emphasis = ifx selected then .ButtonEmphasisSoft else .ButtonEmphasisOutline,
                    .tone = ifx selected then .ButtonToneAccent else .ButtonToneNeutral,
                    .content_alignment = .ContentAlignmentStart, .full_width = true}) != 0 {
                    selected_service = index
                }
            }
            unused End(session)
            results_height = cast(s32)TreeSubmittedBounds(session, rows.node).height
        }
        unused End(session)
    }
    unused End(session)
}

Inspector :: (session: Session, bounds: Rectangle, item: ServiceItem) {
    if !Layout.Draw(session, Layout.Props.{.class_name = Class("inspector"), .bounds = bounds}).opened { return }
    if Layout.Row(session, Layout.Props.{.class_name = Class("inspector-top")}).opened {
        Heading(session, item.name, "inspector-title", 2)
        if Layout.Row(session, Layout.Props.{.class_name = Class("badge-slot")}).opened {
            Badge.Draw(session, Badge.Props.{.text = HealthLabel(item.health), .tone = HealthBadgeTone(item.health),
                .dot = true})
            unused End(session)
        }
        unused End(session)
    }
    meta: Vec(u8)
    BuilderPrint(*meta, "%  |  Owner: %", item.region, item.owner)
    Line(session, BuilderFinish(meta), "muted")
    Separator.Draw(session, Separator.Props.{.bounds = .{height = 8.0}})
    Text.Draw(session, Text.Props.{.text = item.summary, .class_name = Class("summary"), .wrap = .TextWrapAuto,
        .semantic_kind = .SemanticParagraph})
    rps: Vec(u8)
    BuilderPrint(*rps, "% req/s", item.rps)
    stats: [3]string = .[FormatLatency(item.latency_ms, detail_latency_buf[:]),
        FormatPercentTenths(item.uptime_tenths, detail_uptime_buf[:]),
        TextView(detail_rps_buf[0:CopyIntoBuffer(detail_rps_buf[:], BuilderFinish(rps))])]
    names: [3]string = .["Latency", "Uptime", "Throughput"]
    if Cells(session, "stats") {
        for i: 0..2 {
            if Box(session, "stat") {
                Line(session, names[i], "stat-name")
                Line(session, stats[i], "stat-value")
                unused End(session)
            }
        }
        unused End(session)
    }
    Line(session, "Latest change", "stat-name")
    Line(session, item.audit_note, "muted")
    unused End(session)
}

Results :: (session: Session, count: s32) {
    visible := false
    for i: cast(s32)0..count - 1 {
        if filtered_indices[i] == selected_service { visible = true; break }
    }
    if !visible { selected_service = filtered_indices[0] }
    area := Layout.Draw(session, Layout.Props.{.class_name = Class("body")})
    if !area.opened { return }
    items: [2]Layout.FlexItem = .[.{.kind = StyleKindColumn(), .class_name = Class("list")},
        .{.kind = StyleKindColumn(), .class_name = Class("inspector")}]
    slots: [2]Layout.FlexPlacement
    if Layout.Row(session, Layout.Props.{.class_name = Class("split"), .bounds = area.content}, items[:], slots[:]).opened {
        if Layout.Draw(session, Layout.Props.{.class_name = Class("list"), .bounds = slots[0].bounds}).opened {
            ResultRows(session, count)
            unused End(session)
        }
        Inspector(session, slots[1].bounds, SERVICES[selected_service])
        unused End(session)
    }
    unused End(session)
}

Body :: (session: Session, now: float64) {
    count := FilterIndices(active_section, active_filter, TextView(search_bytes[0:search_state.length]),
        filtered_indices[:])
    if view_state == .ViewLoading { LoadingState(session, now); return }
    if view_state == .ViewError { ErrorState(session); return }
    if view_state == .ViewEmpty || count == 0 {
        slot := Slot(session, 220.0)
        if slot.opened {
            result := EmptyState.Draw(session, EmptyState.Props.{.title = "No matching services",
                .description = "Adjust your search query or reset filters to view all cluster services.",
                .action = "Reset filters", .bounds = slot.content})
            if result.action {
                ResetSearch()
                active_filter = .FilterAll
                active_section = .NavOverview
                view_state = .ViewReady
            }
            unused End(session)
        }
        return
    }
    Results(session, count)
}

SettingsModal :: (session: Session) {
    modal := Modal.Draw(session, Modal.Props.{.title = "Dashboard settings", .title_at_start = true,
        .width = 460, .height = 330, .has_right_action = true, .right_label = "Close", .dismiss_on_outside = true})
    if modal.dismissed || modal.right_clicked { settings_open = false; return }
    if !modal.opened { return }
    defer { unused End(session) }
    if !Layout.Draw(session, Layout.Props.{.class_name = Class("settings"), .bounds = modal.layout.content}).opened { return }
    defer { unused End(session) }
    Line(session, "Workspace name", "muted")
    focus_now := focus_workspace_pending
    focus_workspace_pending = false
    edited := TextField.Bind(session, *draft_state, TextField.Props.{.focus_id = WORKSPACE_FOCUS,
        .class_name = Class("search-field"), .label = "Workspace name", .placeholder = "Enter workspace title",
        .input = .{.focus = focus_now}})
    if Layout.Row(session, Layout.Props.{.class_name = Class("setting")}).opened {
        Line(session, "Color theme", "setting-name")
        if Layout.Row(session, Layout.Props.{.class_name = Class("toggle-slot")}).opened {
            toggle := Toggle.Draw(session, Toggle.Props.{.label = "Dark theme", .off_label = "Light",
                .on_label = "Dark", .value = draft_dark})
            if toggle.changed { draft_dark = toggle.value }
            unused End(session)
        }
        unused End(session)
    }
    compact := Checkbox.Draw(session, Checkbox.Props.{.label = "Compact density", .checked = draft_compact})
    if compact.changed { draft_compact = compact.checked }
    refresh := Checkbox.Draw(session, Checkbox.Props.{.label = "Auto-refresh telemetry", .checked = draft_auto_refresh})
    if refresh.changed { draft_auto_refresh = refresh.checked }
    if Cells(session, "modal-actions") {
        if Button.Draw(session, Button.Props.{.label = "Cancel", .emphasis = .ButtonEmphasisOutline}) != 0 {
            settings_open = false
        }
        if Button.Draw(session, Button.Props.{.class_name = Class("primary-btn"), .label = "Apply",
            .tone = .ButtonToneAccent, .emphasis = .ButtonEmphasisFilled}) != 0 || edited.committed {
            CommitSettingsModal()
        }
        unused End(session)
    }
}

DashboardFrame :: (session: Session, viewport: Rectangle) -> s32 {
    EnsureInitialized()
    snapshot := CaptureFrameInput(session)
    unused EnsureDashboardTheme(dark_theme, compact_density, false, viewport.width)
    wide := viewport.width >= 760.0
    if Layout.Row(session, Layout.Props.{.class_name = Class("shell"), .bounds = viewport}).opened {
        if wide { Sidebar(session) }
        if Box(session, "main") {
            Header(session, wide)
            if !wide { NavStrip(session) }
            Kpis(session, wide)
            Toolbar(session)
            Body(session, cast(float64)snapshot.elapsed_ms / 1000.0)
            unused End(session)
        }
        unused End(session)
    }
    if settings_open { SettingsModal(session) }
    return 0
}
