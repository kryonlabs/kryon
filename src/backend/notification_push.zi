    PUnified :: (env: *JniEnv, context: *void, method: string, signature: string, b: JniValue = .{}, c: JniValue = .{}, d: JniValue = .{}, void_result: bool = false) -> *void {
        return PStatic(env, context, p_up, method, signature, NRef(context), b, c, d, void_result)
    }
