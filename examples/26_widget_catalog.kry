        if category == 3 {
            Text((TextProps){.bounds={x, y + ScaleUIPx(650), 0, 0}, .text="CascadingTreeView (expand folders)", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            CascadingTreeView((CascadingTreeViewProps){.bounds = {x,y + ScaleUIPx(688),ScaleUIPx(350),ScaleUIPx(210)},.id = 964,.items = cascade_items,.item_count = 4,.selected_id = &cascade_selected,.activated_id = &cascade_activated,.expanded = {cascade_ids,&cascade_count,4},.scroll_offset = &cascade_scroll,.row_height = ScaleUIPx(30)})
        }
        if category == 9 {
            Text((TextProps){.bounds={x, y, 0, 0}, .text="PAGES AND SETTINGS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds = {x,y + ScaleUIPx(42),ScaleUIPx(350),ScaleUIPx(36)},.label = "Preview TitleBar and BottomNav",.id = 965}) { page_preview = 1 }
