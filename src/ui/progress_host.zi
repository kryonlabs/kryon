#module "progress_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/progress.h"
#import "ui/paint_command.h"

RenderProgress :: (progress: ProgressProps) #export {
    label: const char* = progress.label
    text_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, progress.class_name,
    StyleKindProgress(), ProgressLabelRole())
    text_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(text_frame).value)
    font: i32 = ResolveFont(0, StyleFontValue(text_style.fields,
    text_style.font_size), GetSmallFontSize())
    label_width: i32 = 0
    label_height: i32 = 0
    if label != nil {
        label_width = TextWidth(label, font)
        label_height = TextLineHeight(font)
    }
    track: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, progress.class_name,
    StyleKindProgress(), ProgressTrackRole())
    active: StyleFrame = WidgetFrameForClassRole(
    ButtonToneAccent, ButtonStateNormal, 0, 1, progress.class_name,
    StyleKindProgress(), ProgressFillRole())

    paint: ProgressPaint = ProgressPaintFor(progress.bounds,
    progress.min, progress.max, progress.value,
    (float)label_width, (float)label_height,
    (float)Scale(1000) / 1000.0, track, active, text_frame)
    fill: Rectangle = paint.layout.fill_bounds
    plan: ProgressDrawPlan = ProgressDrawPlanFor(progress.bounds, paint,
        label != nil, text_style.opacity)
    if !IsWindowReady() { return }
    DrawRectangleRounded(progress.bounds, plan.radius, 12,
    GetColor(paint.track_color))
    if plan.draw_fill {
        DrawRectangleRounded(fill, plan.radius, 12,
        GetColor(paint.fill_color))
    }
    if plan.draw_border {
        DrawRectangleRoundedLinesEx(progress.bounds, plan.radius, 12,
        paint.border_width, GetColor(paint.border_color))
    }

    if plan.draw_label {
        text_x: i32 = (int)paint.layout.label_x
        text_y: i32 = (int)paint.layout.label_y
        RenderText(label, text_x, text_y, font, GetColor(plan.label_color))
    }
}
