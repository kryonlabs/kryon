#module "navigation_bar"
#import "button"
#import "control_props"
#import "drawing_props"
#import "style"

NavigationBarSpec :: struct {
    view_width: i32
    view_height: i32
    count: i32
    height: i32
    side_margin: i32
    bottom_margin: i32
    icon_size: i32
    scale: float
    bar: StyleFrame
}

NavigationBarPaint :: struct {
    bounds: Rectangle
    bar_bounds: Rectangle
    start_x: i32
    tab_width: i32
    group_width: i32
    count: i32
    icon_size: i32
    height: i32
    y: i32
    bar: StyleFrame
}

NavigationBarItemSpec :: struct {
    bar: NavigationBarPaint
    index: i32
    active: bool
    disabled: bool
    hovered: bool
    label_height: i32
    base: StyleFrame
    face: StyleFrame
}

NavigationBarItemPaint :: struct {
    bounds: Rectangle
    state_bounds: Rectangle
    icon_bounds: Rectangle
    label_bounds: Rectangle
    face: StyleFrame
    draw_face: bool
    icon_color: u32
    text_color: u32
    icon_alpha: i32
}

NavigationBarConfigMetrics :: struct {
    frame_width: i32
    frame_base_height: i32
    frame_bottom_extra: i32
    row_height: i32
    row_control_y: i32
    dropdown_height: i32
    remove_width: i32
    add_height: i32
    add_max_width: i32
    button_height: i32
    button_gap: i32
    button_max_width: i32
    button_bottom_gap: i32
    route_top_gap: i32
    route_bottom_gap: i32
    route_min_height: i32
    scrollbar_width: i32
}

NavigationBarConfigLayout :: struct {
    route_bounds: Rectangle
    route_content_height: i32
    wheel_step: i32
    scrollbar_x: i32
    add_bounds: Rectangle
    reset_bounds: Rectangle
    cancel_bounds: Rectangle
    save_bounds: Rectangle
    clip_y: i32
    clip_height: i32
}

NavigationBarConfigRowLayout :: struct {
    label_bounds: Rectangle
    dropdown_bounds: Rectangle
    remove_bounds: Rectangle
}

NavigationBarDefaultHeight :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(86.0 * scale)
}

NavigationBarConfigMetricsFor :: (scale: float) -> NavigationBarConfigMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: NavigationBarConfigMetrics
    metrics.frame_width = (i32)(340.0 * scale)
    metrics.frame_base_height = (i32)(128.0 * scale)
    metrics.frame_bottom_extra = (i32)(58.0 * scale)
    metrics.row_height = (i32)(58.0 * scale)
    metrics.row_control_y = (i32)(22.0 * scale)
    metrics.dropdown_height = (i32)(36.0 * scale)
    metrics.remove_width = (i32)(36.0 * scale)
    metrics.add_height = (i32)(34.0 * scale)
    metrics.add_max_width = (i32)(180.0 * scale)
    metrics.button_height = (i32)(36.0 * scale)
    metrics.button_gap = (i32)(8.0 * scale)
    metrics.button_max_width = (i32)(92.0 * scale)
    metrics.button_bottom_gap = (i32)(16.0 * scale)
    metrics.route_top_gap = (i32)(12.0 * scale)
    metrics.route_bottom_gap = (i32)(8.0 * scale)
    metrics.route_min_height = (i32)(48.0 * scale)
    metrics.scrollbar_width = (i32)(8.0 * scale)
    return metrics
}

NavigationBarConfigFrameHeight :: (route_count: i32,
    metrics: NavigationBarConfigMetrics) -> i32 #export {
    if route_count < 0 { route_count = 0 }
    return metrics.frame_base_height + metrics.row_height * route_count +
        metrics.add_height + metrics.frame_bottom_extra
}

NavigationBarConfigLayoutFor :: (frame: Rectangle, content: Rectangle,
    route_count: i32, metrics: NavigationBarConfigMetrics) -> NavigationBarConfigLayout #export {
    layout: NavigationBarConfigLayout
    if route_count < 0 { route_count = 0 }
    button_w: i32 = ((i32)content.width - metrics.button_gap * 2) / 3
    if button_w > metrics.button_max_width { button_w = metrics.button_max_width }
    if button_w < 1 { button_w = 1 }
    total_button_w: i32 = button_w * 3 + metrics.button_gap * 2
    button_y: i32 = (i32)frame.y + (i32)frame.height - metrics.button_height -
        metrics.button_bottom_gap
    button_x: i32 = (i32)frame.x + ((i32)frame.width - total_button_w) / 2
    add_y: i32 = button_y - metrics.button_gap - metrics.add_height

    route_h: i32 = add_y - (i32)content.y - metrics.route_top_gap
    if route_h < metrics.row_height { route_h = metrics.row_height }
    if (i32)content.y + route_h > add_y - metrics.route_bottom_gap {
        route_h = add_y - (i32)content.y - metrics.route_bottom_gap
    }
    if route_h < metrics.route_min_height { route_h = metrics.route_min_height }

    add_w: i32 = (i32)content.width
    if add_w > metrics.add_max_width { add_w = metrics.add_max_width }
    if add_w < 1 { add_w = 1 }

    layout.route_bounds.x = content.x
    layout.route_bounds.y = content.y
    layout.route_bounds.width = content.width
    layout.route_bounds.height = (float)route_h
    layout.route_content_height = metrics.row_height * route_count
    layout.wheel_step = metrics.row_height
    layout.scrollbar_x = (i32)content.x + (i32)content.width - metrics.scrollbar_width

    layout.add_bounds.x = content.x + (content.width - (float)add_w) / 2.0
    layout.add_bounds.y = (float)add_y
    layout.add_bounds.width = (float)add_w
    layout.add_bounds.height = (float)metrics.add_height

    layout.reset_bounds.x = (float)button_x
    layout.reset_bounds.y = (float)button_y
    layout.reset_bounds.width = (float)button_w
    layout.reset_bounds.height = (float)metrics.button_height
    layout.cancel_bounds = layout.reset_bounds
    layout.cancel_bounds.x += (float)(button_w + metrics.button_gap)
    layout.save_bounds = layout.cancel_bounds
    layout.save_bounds.x += (float)(button_w + metrics.button_gap)

    layout.clip_y = (i32)content.y
    layout.clip_height = add_y - metrics.route_bottom_gap
    return layout
}

NavigationBarConfigRowLayoutFor :: (content: Rectangle, row_y: i32,
    label_height: i32, metrics: NavigationBarConfigMetrics) -> NavigationBarConfigRowLayout #export {
    row: NavigationBarConfigRowLayout
    control_y: i32 = row_y + metrics.row_control_y
    row.label_bounds.x = content.x
    row.label_bounds.y = (float)row_y
    row.label_bounds.width = content.width
    row.label_bounds.height = (float)label_height
    row.dropdown_bounds.x = content.x
    row.dropdown_bounds.y = (float)control_y
    row.dropdown_bounds.width = content.width - (float)(metrics.remove_width + metrics.button_gap)
    if row.dropdown_bounds.width < 1.0 { row.dropdown_bounds.width = 1.0 }
    row.dropdown_bounds.height = (float)metrics.dropdown_height
    row.remove_bounds.x = content.x + content.width - (float)metrics.remove_width
    row.remove_bounds.y = (float)control_y
    row.remove_bounds.width = (float)metrics.remove_width
    row.remove_bounds.height = (float)metrics.remove_width
    return row
}

NavigationBarPaintFor :: (spec: NavigationBarSpec) -> NavigationBarPaint #export {
    paint: NavigationBarPaint
    scale: float = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    count: i32 = spec.count
    if count < 0 { count = 0 }
    if count > 8 { count = 8 }
    height: i32 = spec.height
    if height <= 0 { height = NavigationBarDefaultHeight(scale) }
    bottom_margin: i32 = spec.bottom_margin
    if bottom_margin < 0 { bottom_margin = 0 }
    side_margin: i32 = spec.side_margin
    if side_margin < 0 { side_margin = 0 }
    icon_size: i32 = spec.icon_size
    if icon_size <= 0 { icon_size = (i32)(32.0 * scale) }

    y: i32 = spec.view_height - bottom_margin - height
    available_w: i32 = spec.view_width - side_margin * 2
    if available_w < (i32)(96.0 * scale) { available_w = (i32)(96.0 * scale) }
    tab_w: i32 = available_w
    if count > 0 { tab_w = available_w / count }
    min_tab: i32 = (i32)(56.0 * scale)
    if tab_w < min_tab { tab_w = min_tab }
    group_w: i32 = tab_w * count
    if group_w > available_w { group_w = available_w }
    if count > 0 { tab_w = group_w / count }

    paint.bounds.x = 0.0
    paint.bounds.y = (float)y
    paint.bounds.width = (float)spec.view_width
    paint.bounds.height = (float)height
    inset: i32 = (i32)(1.0 * scale)
    paint.bar_bounds.x = (float)(side_margin + inset)
    paint.bar_bounds.y = (float)(y + inset)
    paint.bar_bounds.width = (float)(available_w - inset * 2)
    paint.bar_bounds.height = (float)(height - inset * 2)
    paint.start_x = side_margin + (available_w - group_w) / 2
    paint.tab_width = tab_w
    paint.group_width = group_w
    paint.count = count
    paint.icon_size = icon_size
    paint.height = height
    paint.y = y

    paint.bar = spec.bar
    return paint
}

NavigationBarItemPaintFor :: (spec: NavigationBarItemSpec) -> NavigationBarItemPaint #export {
    paint: NavigationBarItemPaint
    scale: float = 1.0
    if spec.bar.height > 0 { scale = (float)spec.bar.height / 86.0 }
    index: i32 = spec.index
    if index < 0 { index = 0 }
    x: i32 = spec.bar.start_x + index * spec.bar.tab_width
    w: i32 = spec.bar.tab_width
    if index == spec.bar.count - 1 { w = spec.bar.start_x + spec.bar.group_width - x }
    if w < 0 { w = 0 }
    state_w: i32 = (i32)(58.0 * scale)
    state_h: i32 = (i32)(58.0 * scale)
    if state_w < spec.bar.icon_size + (i32)(16.0 * scale) {
        state_w = spec.bar.icon_size + (i32)(16.0 * scale)
    }
    if state_h < spec.bar.icon_size + (i32)(16.0 * scale) {
        state_h = spec.bar.icon_size + (i32)(16.0 * scale)
    }
    label_gap: i32 = (i32)(4.0 * scale)
    stack_h: i32 = state_h + label_gap + spec.label_height
    state_y: i32 = spec.bar.y + (spec.bar.height - stack_h) / 2
    if state_y < spec.bar.y + (i32)(2.0 * scale) {
        state_y = spec.bar.y + (i32)(2.0 * scale)
    }
    label_y: i32 = state_y + state_h + label_gap
    if label_y + spec.label_height > spec.bar.y + spec.bar.height - (i32)(2.0 * scale) {
        label_y = spec.bar.y + spec.bar.height - spec.label_height - (i32)(2.0 * scale)
        state_y = label_y - label_gap - state_h
        if state_y < spec.bar.y + (i32)(2.0 * scale) {
            state_y = spec.bar.y + (i32)(2.0 * scale)
        }
    }
    icon_y: i32 = state_y + (state_h - spec.bar.icon_size) / 2

    paint.bounds.x = (float)x
    paint.bounds.y = (float)spec.bar.y
    paint.bounds.width = (float)w
    paint.bounds.height = (float)spec.bar.height
    paint.state_bounds.x = (float)(x + (w - state_w) / 2)
    paint.state_bounds.y = (float)state_y
    paint.state_bounds.width = (float)state_w
    paint.state_bounds.height = (float)state_h
    paint.icon_bounds.x = (float)(x + (w - spec.bar.icon_size) / 2)
    paint.icon_bounds.y = (float)icon_y
    paint.icon_bounds.width = (float)spec.bar.icon_size
    paint.icon_bounds.height = (float)spec.bar.icon_size
    paint.label_bounds.x = (float)(x + (i32)(3.0 * scale))
    paint.label_bounds.y = (float)label_y
    paint.label_bounds.width = (float)(w - (i32)(6.0 * scale))
    paint.label_bounds.height = (float)spec.label_height

    paint.face = spec.face
    paint.draw_face = spec.active || spec.hovered
    paint.icon_color = spec.base.value.foreground
    paint.text_color = spec.base.value.foreground
    if spec.active {
        paint.icon_color = paint.face.value.foreground
        paint.text_color = paint.face.value.foreground
    }
    if !spec.active {
        paint.face.value.opacity = 0.45
    }
    paint.icon_alpha = spec.disabled ? 150 : 255
    return paint
}
