// SDL presentation for hosts that already rasterize their frame into pixels.
// This chooses the transport of those pixels; it does not draw UI or own
// the window, texture, event loop, or raster workers.
#import "std/c_string"

sdl :: #system_library "SDL2";
GetHint :: (name: *u8) -> *u8 #foreign sdl "SDL_GetHint";
GetEnv :: (name: *u8) -> *u8 #foreign sdl "SDL_getenv";
SetHintPriority :: (name: *u8, value: *u8, priority: s32) -> s32 #foreign sdl "SDL_SetHintWithPriority";
CreateRenderer :: (window: *void, index: s32, flags: u32) -> *void #foreign sdl "SDL_CreateRenderer";
DestroyRenderer :: (renderer: *void) #foreign sdl "SDL_DestroyRenderer";

PixmapGpuSelected :: () -> bool {
    gpu_name: [32]u8
    if !CopyCString("KRYON_PIXMAP_GPU", gpu_name[:]) { return false }
    choice := GetEnv(*gpu_name[0])
    return choice != null && choice[0] == cast(u8)49
}

// Call on the window's owner thread, before creating its pixel texture.
// Normal/override SDL hints and environment preferences take precedence.
#program_export
CreatePixmapRenderer :: (window: *void) -> *void {
    if window == null { return null }
    surface_hint: [32]u8; disabled: [2]u8; driver_hint: [32]u8
    if !CopyCString("SDL_FRAMEBUFFER_ACCELERATION", surface_hint[:]) ||
        !CopyCString("0", disabled[:]) ||
        !CopyCString("SDL_RENDER_DRIVER", driver_hint[:]) { return null }
    // This hint controls software window surfaces, not renderer textures.
    // Preserve the cheap software path even with an explicit software driver.
    unused SetHintPriority(*surface_hint[0], *disabled[0], 0)
    preferred := GetHint(*driver_hint[0])
    if preferred != null && preferred[0] != cast(u8)0 {
        // Explicit driver preferences, including software, remain authoritative.
        return CreateRenderer(window, -1, cast(u32)0)
    }
    if PixmapGpuSelected() { return CreateRenderer(window, -1, cast(u32)2) }
    // CPU-raster applications pay twice for software OpenGL: create a GL
    // context to discover llvmpipe, then destroy it and create the real
    // renderer. Software transport is the fast common path; an explicit
    // owner choice above retains the GPU upload path.
    renderer := CreateRenderer(window, -1, cast(u32)1) // SDL_RENDERER_SOFTWARE
    if renderer != null { return renderer }
    return CreateRenderer(window, -1, cast(u32)2)
}
