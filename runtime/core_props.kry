#module "core_props"
#import "kryon_compat.generated.h"
#import "ui_input_props.generated.h"

# Shared view extents, updated by the app frame loop.
ui_view_width :: i32 = 320 #global #export
ui_view_height :: i32 = 560 #global #export

# C-only host types: the platform text-input callback and the frame record,
# whose anonymous capture arrays and inline arrays have no portable mirror.
TextInputPlatformCallback :: void (*)(int active) #type
FrameState :: struct FrameState { int view_width; int view_height; Camera2D camera; int input_clip_count; Rectangle input_clips[16]; int input_capture_count; struct { Rectangle bounds; int allow_inside; } input_captures[16]; int cursor_priority; int cursor_had_intent; int pointer_down; int pointer_dragging; int pointer_dragged_this_click; int pointer_start_x; int pointer_start_y; int pointer_owner; int release_consumed; int focus_active_id; int focus_ids[256]; int focus_count; int focus_tab_dir; int focus_frame_open; int focus_text_input_active; int text_input_requested; int text_input_show_requested; int mouse_world_override_enabled; Vector2 mouse_world_override; unsigned long frame_serial; int auto_focus_id; float ui_scale; } #type

# Implemented by the C-only interface, focus, and cursor hosts; declared here
# for the public ABI. KryonSetFocus/KryonGetFocus carry their real symbol
# names so MinGW's SetFocus macro can never collide.
InitInterface :: (width: i32, height: i32, dpi: float) #extern #export
SetDefaultFontAutoLoad :: (enabled: i32) #extern #export
ApplyCurrentTheme :: () #extern #export
IsDesktopMode :: () -> i32 #extern #export
GetDefaultCamera :: () -> Camera2D #extern #export
BeginInterfaceFrame :: (width: i32, height: i32, dpi: float) #extern #export
EndInterfaceFrame :: () #extern #export
ResolveFocusID :: (id: i32) -> i32 #extern #export
SetFrameCamera :: (camera: Camera2D) #extern #export
SaveFrameState :: () -> FrameState #extern #export
RestoreFrameState :: (state: FrameState) #extern #export
SetMouseWorldOverride :: (enabled: i32, position: Vector2) #extern #export
SetKeyboardInputEnabled :: (enabled: i32) -> i32 #extern #export
IsKeyboardInputEnabled :: () -> i32 #extern #export
ClearInputCaptures :: () #extern #export
PushInputCapture :: (bounds: Rectangle, allow_inside: i32) #extern #export
PopInputCapture :: () #extern #export
BeginModalLayer :: () #extern #export
PushInputClip :: (bounds: Rectangle) #extern #export
PopInputClip :: () #extern #export
SetModalCapture :: (bounds: Rectangle) #extern #export
SetTextInputPlatformCallback :: (callback: TextInputPlatformCallback) #extern #export
SetCursorClickable :: (cursor_clickable: *i32) #extern #export
SetCursorDisabled :: (cursor_disabled: *i32) #extern #export
MarkCursor :: (cursor: i32) #extern #export
MarkClickable :: () #extern #export
MarkDisabled :: () #extern #export
GetMouseCursorIntent :: () -> i32 #extern #export
SetInterfaceIcons :: (gear_icon: Texture2D, x_icon: Texture2D) #extern #export
HandleClick :: (bounds: Rectangle, disabled: i32, hover: *i32) -> i32 #extern #export
ReadActivation :: (bounds: Rectangle, id: i32, enabled: bool) -> Activation #extern #export
HandleCircleClick :: (center: Vector2, radius: float, disabled: i32, hover: *i32) -> i32 #extern #export
InputCapturesClick :: (point: Vector2) -> i32 #extern #export
ReleaseConsumed :: () -> i32 #extern #export
ConsumeRelease :: () #extern #export
HoverEffectsEnabled :: () -> i32 #extern #export
SetTransitionCuesEnabled :: (enabled: i32) #extern #export
TransitionCuesEnabled :: () -> i32 #extern #export
FocusFrameOpen :: () -> i32 #extern #export
RegisterFocus :: (id: i32, bounds: Rectangle) -> i32 #extern #export
IsFocusActive :: (id: i32) -> i32 #extern #export
IsFocusActivatePressed :: (id: i32) -> i32 #extern #export
KryonSetFocus :: (id: i32) #extern #export
KryonGetFocus :: () -> i32 #extern #export
ClearFocus :: () #extern #export
SetFocusTextInputActive :: (active: i32) #extern #export
TextInputActive :: () -> i32 #extern #export
