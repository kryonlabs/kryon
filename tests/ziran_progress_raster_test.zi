#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "geometry"
#import "progress"
#import "progress_raster"
#import "ziran_progress_raster_host"

#program_export
Answer :: () -> s32 {
    bounds: Rectangle = Rectangle.{10.0, 20.0, 100.0, 20.0}
    paint: ProgressPaint
    paint.layout.fill_bounds = Rectangle.{10.0, 20.0, 25.0, 20.0}
    paint.layout.label_x = 40.9
    paint.layout.label_y = 25.9
    paint.track_color = cast(u32)0x11223344
    paint.fill_color = cast(u32)0x55667788
    paint.border_color = cast(u32)0x99aabbcc
    paint.label_color = cast(u32)0x10203080
    paint.filled_label_color = cast(u32)0x405060c0
    paint.radius = 5.0
    paint.border_width = 2.0
    PaintProgress(TestSession(), bounds, paint, "50%", 14, 0.5)
    paint.layout.fill_bounds.width = 0.0
    paint.border_width = 0.0
    PaintProgress(TestSession(), bounds, paint, "", 14, 1.0)
    return 42
}

#program_export
main :: () -> s32 {
    if Answer() != 42 || RasterCallCount() != 5 || RasterHostFailed() {
        return 1
    }
    return 0
}
