#if #defined(KRYON_ZX_APP) {
    #import "android_bundle_run"
    #program_export
    AndroidRunMain :: () -> s32 { return AndroidBundleRunMain() }
} else {
// Kryon owns Android's NativeActivity application thread. The NDK glue only
// bridges lifecycle/input events to a looper; this host owns the window,
// pixels, input, IME, density, damage presentation and frame pacing.
#import "android_device"
#import "android_clipboard"
#import "android_jni"
#import "android_native"
#import "android_process"
#import "android_surface"
#import "android_touch"
#import "frame_entry"
#import "std/byte_text_linux"
#import "drawing_props"
#import "frame_snapshot"
#import "geometry"
#import "paint_queue"
#import "pixmap"
#import "pixmap_frame"
#import "scroll_device"
#import "secondary_pointer"
#import "session"
#import "test_driver"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "input_protocol"
#import "std/number_text"
#import "std/text_buffer"
Clock :: #import "std/timer_linux";

using FrameStatus;

android_log :: #system_library "log";
AndroidLogWrite :: (priority: s32, tag: *u8, text: *u8) -> s32 #foreign android_log "__android_log_write";

AndroidError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = 0
    tag: [8]u8 = .[cast(u8)107, cast(u8)114, cast(u8)121, cast(u8)111, cast(u8)110, 0, 0, 0]
    unused AndroidLogWrite(6, *tag[0], *output[0])
    return 1
}

AndroidCanvas :: () -> u32 {
    canvas := StyleTokenColorOr("canvas", Color.{248, 250, 252, 255})
    return (cast(u32)canvas.a << 24) | (cast(u32)canvas.r << 16) |
        (cast(u32)canvas.g << 8) | cast(u32)canvas.b
}

AndroidFrameFailure :: (session: Session, step: string) {
    failure := FrameFailureAt(session)
    message: [240]u8
    length: s64 = 0
    digits: [24]u8
    parts: [7]string = .["kryon: ", step, ": ", failure.message, " (key ",
        FormatInteger(cast(s64)failure.key, digits[:]), ")"]
    for part: parts {
        for byte: part {
            if length < 239 { message[length] = byte; length += 1 }
        }
    }
    unused AndroidError(TextView(message[0:length]))
}

AndroidPresentPixmap :: (damage: Rectangle, width: s32, height: s32,
    zoom: float32) -> bool {
    if width <= 0 || height <= 0 { return false }
    if zoom < 0.1 || zoom > 8.0 { zoom = 1.0 }
    left := cast(s32)(damage.x * zoom)
    top := cast(s32)(damage.y * zoom)
    right := cast(s32)((damage.x + damage.width) * zoom) + 1
    bottom := cast(s32)((damage.y + damage.height) * zoom) + 1
    if left < 0 { left = 0 }
    if top < 0 { top = 0 }
    if right > width { right = width }
    if bottom > height { bottom = height }
    if left >= right || top >= bottom { return true }
    if !AndroidNativeLock(left, top, right, bottom) { return false }
    copied := AndroidNativePresentDamage(left, top, right, bottom)
    return AndroidNativeUnlock() && copied
}

DrawAndroidFrame :: (session: Session, viewport: AndroidViewport,
    bounds: Rectangle, zoom: float32, reuse: bool) -> bool {
    width := viewport.x + viewport.width
    height := viewport.y + viewport.height
    if !AndroidNativeSurfaceSize(*width, *height) ||
    !AndroidNativeEnsurePixels(width, height) { return false }

    pixels := AndroidNativePixels()
    if !PixmapScale(zoom, zoom) ||
    !PixmapResumeInto(width, height, pixels, true) { return false }
    if !reuse {
        AndroidNativeFill(cast(u32)0xff000000)
        ClearAndroidFrame(viewport, AndroidCanvas())
    }

    ok: bool = true
    finished: PixmapFrameResult
    input_open := AndroidTouchFrameInputBegin(session, zoom)
    if input_open {
        pointer: PointerFrame = TestDriverPointer(session, PollPointer())
        TreePointerUpdate(session, pointer)
        TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
        BeginScrollFrame(session, Vector2.{pointer.x, pointer.y},
            pointer.pressed, pointer.down, pointer.released, 0.0,
            cast(float64)Clock.MonotonicMilliseconds() / 1000.0)
        key := AndroidTouchTakeKey()
        if key == 0 {
            for candidate: cast(s32)0..349 {
                if TestDriverKeyPressed(candidate) { key = candidate; break }
            }
        }
        if AndroidTextInputKeyPressed(259) { key = 259 }
        if AndroidTextInputKeyPressed(257) { key = 257 }
        if key != 0 { KeyboardSend(session, key) }
        codepoint := AndroidTextInputCharacter()
        while codepoint != 0 {
            TypedCodepointSend(session, codepoint)
            codepoint = AndroidTextInputCharacter()
        }

        if BeginFrame(session, cast(u64)1, bounds) != cast(FrameStatus)FrameOk {
            AndroidFrameFailure(session, "the frame could not begin")
            ok = false
        } else if Frame(session, bounds) != 0 {
            unused AndroidError("kryon: the application's frame failed")
            TreeCancel(session)
            ok = false
        } else {
            finished = EndPixmapFrame(session, reuse, AndroidCanvas())
            if finished.status != cast(FrameStatus)FrameOk {
                AndroidFrameFailure(session, "the frame could not finish")
                ok = false
            }
        }
        FrameInputEnd(session)
    } else {
        ok = false
    }
    AndroidTouchFrameEnd()
    PixmapEndInto()
    if ok && !finished.paint_unchanged { ok = AndroidPresentPixmap(finished.damage, width, height, zoom) }
    if ok { TestDriverFrame(session) }
    return ok
}

AndroidViewportSignature :: (viewport: AndroidViewport, zoom: float32) -> u64 {
    value := cast(u64)viewport.x | cast(u64)viewport.y << 12 |
        cast(u64)viewport.width << 24 | cast(u64)viewport.height << 36 |
        cast(u64)viewport.ready << 48
    return value ^ cast(u64)(zoom * 256.0)
}

#program_export
android_main :: (app: *NativeAndroidApp) {
    if app == null { return }
    AndroidNativeStart(app)
    defer { AndroidNativeClose() }
    defer { AndroidNativeFinish() }
    AndroidJniKeepHostThread()
    defer { AndroidJniReleaseHostThread() }
    AndroidProcessPrepare()

    session: Session = SessionOpen()
    if !SessionValid(session) {
        unused AndroidError("kryon: could not open a UI session")
        return
    }
    defer { CloseSession(session) }
    AndroidTextInputOpen(session)
    defer { AndroidTextInputClose(session) }

    ok: bool = true
    first_frame: bool = true
    reuse: bool = false
    signature: u64
    quiet_frames: s32 = 0
    next_frame_ms := Clock.MonotonicMilliseconds()
    while ok && !AndroidNativeDestroyRequested() {
        now := Clock.MonotonicMilliseconds()
        timeout := ifx next_frame_ms > now then cast(s32)(next_frame_ms - now) else 0
        if timeout > 1000 { timeout = 1000 }
        unused AndroidNativePoll(timeout)
        if AndroidNativeDestroyRequested() { break }

        width: s32
        height: s32
        if AndroidNativePaused() || !AndroidNativeWindowReady() ||
        !AndroidNativeSurfaceSize(*width, *height) {
            AndroidTextInputFrame(session, false)
            reuse = false
            quiet_frames = 0
            next_frame_ms = Clock.MonotonicMilliseconds() + 1000
            continue
        }

        if AndroidNativeTakeResized() || AndroidTakeGraphicsInvalidate() != 0 {
            PaintSnapshotInvalidate(session)
            reuse = false
        }
        if AndroidNativeTakeRedraw() { reuse = false }

        viewport: AndroidViewport
        SyncAndroidViewport(*viewport)
        if viewport.ready == 0 || viewport.width <= 0 || viewport.height <= 0 {
            viewport.x = 0
            viewport.y = 0
            viewport.width = width
            viewport.height = height
        }
        zoom := AndroidLayoutZoom()
        AndroidTouchSetZoom(zoom)
        bounds := Rectangle.{cast(float32)viewport.x / zoom,
            cast(float32)viewport.y / zoom, cast(float32)viewport.width / zoom,
            cast(float32)viewport.height / zoom}
        current_signature := AndroidViewportSignature(viewport, zoom)
        if current_signature != signature {
            signature = current_signature
            reuse = false
        }

        AndroidTextInputBeginFrame(session)
        ok = DrawAndroidFrame(session, viewport, bounds, zoom, reuse)
        AndroidTextInputFrame(session, TreeTextInputActive(session))
        if !ok { break }
        if first_frame {
            first_frame = false
            AndroidNotifyFirstFrame()
        }

        if reuse { quiet_frames += 1 } else { quiet_frames = 0 }
        reuse = true
        next_frame_ms = Clock.MonotonicMilliseconds() +
            ifx quiet_frames >= 2 then cast(s64)100 else cast(s64)16
    }
    if !ok { unused AndroidError("kryon: android frame rendering failed") }
}

#program_export
AndroidRunMain :: () -> s32 {
    app := AndroidNativeApp()
    if app == null { return AndroidError("kryon: the android activity did not start") }
    android_main(app)
    return 0
}

}
