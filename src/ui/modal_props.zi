#module "modal_props"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "image_props"
#import "modal"

ModalAction :: struct {
    label: const char*
    tone: ButtonTone
    emphasis: ButtonEmphasis
    disabled: bool
}

ModalProps :: struct {
    title: const char*
    class_name: i32
    message: const char*
    actions: const ModalAction*
    action_count: i32
    close_icon: Texture2D
    max_width: i32
    text: char*
    text_size: i32
    cursor_position: i32*
    focused: bool*
    focus_id: i32
}

# Caller supplied bounds support movable/resizable panels without making a
# platform host decide the layout. Zero bounds center the requested size.
ModalFrameProps :: struct {
    key: u64
    id: i32
    class_name: i32
    title: string
    bounds: Rectangle
    width: i32
    height: i32
    scale: float
    left_image: ImageProps
    right_image: ImageProps
    left_label: string
    right_label: string
    has_left_action: bool
    has_right_action: bool
    dismiss_disabled: bool
}

ModalFrameResult :: struct {
    node: i32
    panel_node: i32
    layout: ModalFrameLayout
    dismissed: bool
    left_clicked: bool
    right_clicked: bool
}

# Action modal: title, message, and buttons; returns the activated action id
# (0 = dismissed). Implemented by the modal host.
RenderActionModal :: (modal: ModalProps) -> i32 #extern #export
