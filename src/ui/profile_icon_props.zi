# Implemented by the C-only profile-header host; declared here for the public
# ABI. IconType comes from the script-generated ui_icon_types.h.
GetProfileImageIconCount :: () -> i32 #extern #export
GetProfileImageIconType :: (index: i32) -> IconType #extern #export
GetProfileImageIconName :: (index: i32) -> const char* #extern #export
GetProfileImageIconTypeForSyncID :: (sync_id: i32) -> IconType #extern #export
GetSyncIDForProfileImageIconType :: (icon_type: IconType) -> i32 #extern #export

# Profile picture picker modal: grid of profile icons with selection.
ProfileImagePickerProps :: struct { const char *title; const Texture2D *icons; IconType *selected_icon_type; Texture2D close_icon; int max_width; int *scroll_offset; } #type
ProfileImagePickerResult :: struct { int closed; int changed; int selected_index; IconType selected_icon_type; } #type
RenderProfileImagePickerModal :: (modal: ProfileImagePickerProps) -> ProfileImagePickerResult #extern #export
