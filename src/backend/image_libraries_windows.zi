// Optional codecs use the executable's Windows DLL search path.
#scope_file
kernel :: #system_library "kernel32";
Load :: (path: *u8) -> *void #foreign kernel "LoadLibraryA";
Find :: (library: *void, name: *u8) -> *void #foreign kernel "GetProcAddress";
#scope_export
OpenLibrary :: (path: *u8) -> *void { return Load(path) }
Lookup :: (library: *void, name: *u8) -> *void { return Find(library, name) }
PIXBUF_LIBRARY :: "libgdk_pixbuf-2.0-0.dll"
OBJECT_LIBRARY :: "libgobject-2.0-0.dll"
WEBP_LIBRARY :: "libwebpdemux-2.dll"
WEBP_CORE_LIBRARY :: "libwebp-7.dll"
AVIF_LIBRARY :: "kryonavif.dll"
AVIF_LOCAL_LIBRARY :: "lib/kryonavif.dll"
AVIF_PARENT_LIBRARY :: "../lib/kryonavif.dll"
