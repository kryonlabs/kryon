// Google Play Billing for the Google Play edition of an Android app
// (org.kryonlabs.play.PlayBilling, templates/droid/droid/app/src/gplay).
// Requests and the JSON answer are described in PlayBilling.java. Every other
// platform or edition answers "".
#import "std/json_scan"
#if #defined(ANDROID_BUILD) {
    #import "android_jni"
    #import "std/c_string"
    #import "std/byte_text_linux"
}

// One answer, typed: products with Play's price in the buyer's currency and
// the first purchase Play still lists for the app's server to confirm.
PlayBillingProduct :: struct {
    id: [64]u8
    price: [64]u8
    micros: s64
}
PlayBillingPurchase :: struct {
    product: [64]u8
    token: [1024]u8
}
PlayBillingState :: struct {
    ready: bool
    package_name: [256]u8
    error: [128]u8
    products: [8]PlayBillingProduct
    product_count: s32
    purchase: PlayBillingPurchase
    has_purchase: bool
}

PlayBillingRead :: (answer: string, state: *PlayBillingState) -> bool {
    state.* = .{}
    if answer.count == 0 || answer[0] != #char "{" { return false }
    state.ready = MatchLiteral(answer, FieldAt(answer, 0, "ready"), "true")
    unused ReadStringText(answer, FieldAt(answer, 0, "package"), state.package_name[:])
    unused ReadStringText(answer, FieldAt(answer, 0, "error"), state.error[:])
    products := FieldAt(answer, 0, "products")
    for index: cast(s32)0..7 {
        item := ElementAt(answer, products, index)
        if item < 0 { break }
        end := ValueEnd(answer, item, 0)
        if end <= item { break }
        text := answer[item:end]
        product := *state.products[state.product_count]
        if ReadStringText(text, FieldAt(text, 0, "id"), product.id[:]) <= 0 ||
        ReadStringText(text, FieldAt(text, 0, "price"), product.price[:]) <= 0 { continue }
        product.micros = cast(s64)ReadNumber(text, FieldAt(text, 0, "micros")).value
        state.product_count += 1
    }
    first := ElementAt(answer, FieldAt(answer, 0, "purchases"), 0)
    end := ValueEnd(answer, first, 0)
    if first >= 0 && end > first {
        text := answer[first:end]
        state.has_purchase = ReadStringText(text, FieldAt(text, 0, "product"), state.purchase.product[:]) > 0 &&
        ReadStringText(text, FieldAt(text, 0, "token"), state.purchase.token[:]) > 0
    }
    return true
}

// Load one-time products ("dew_100,dew_500"), open the purchase sheet for one,
// or forget a purchase the app's server has credited and consumed.
PlayBillingProducts :: (ids: string, output: []u8) -> string { return PlayBillingAsk("products:", ids, output) }
PlayBillingBuy :: (id: string, output: []u8) -> string { return PlayBillingAsk("buy:", id, output) }
PlayBillingDone :: (token: string, output: []u8) -> string { return PlayBillingAsk("done:", token, output) }

PlayBillingAsk :: (verb: string, value: string, output: []u8) -> string {
    request: [1100]u8
    if verb.count + value.count >= request.count { return "" }
    for byte, at: verb { request[at] = byte }
    for byte, at: value { request[verb.count + at] = byte }
    return PlayBillingCall(TextView(request[:verb.count + value.count]), output)
}

PlayBillingCall :: (request: string, output: []u8) -> string {
    #if #defined(ANDROID_BUILD) {
        text: [1200]u8
        if !CopyCString(request, text[:]) { return "" }
        session: AndroidJniSession
        if AndroidJniAttachCurrent(*session) == 0 { return "" }
        defer { AndroidJniDetachCurrent(*session) }
        env := session.env
        // The activity's class loader finds the Play-only class, so apps need
        // no bridge code: an edition without it simply answers "".
        billing := PlayBillingClass(env, session.activity)
        if billing == null { return "" }
        defer { env.functions.DeleteLocalRef(env, billing) }
        name_1: [8]u8
        name_2: [80]u8
        method := env.functions.GetStaticMethodID(env, billing, PlayBillingName("call", name_1[:]),
            PlayBillingName("(Landroid/app/Activity;Ljava/lang/String;)Ljava/lang/String;", name_2[:]))
        if method == null { PlayBillingClear(env); return "" }
        arguments: [2]JniValue
        arguments[0].reference = session.activity
        arguments[1].reference = AndroidJniString(env, *text[0])
        if arguments[1].reference == null { return "" }
        defer { env.functions.DeleteLocalRef(env, arguments[1].reference) }
        value := env.functions.CallStaticObjectMethodA(env, billing, method, *arguments[0])
        if PlayBillingClear(env) || value == null { return "" }
        defer { env.functions.DeleteLocalRef(env, value) }
        bytes := env.functions.GetStringUTFChars(env, value, null)
        if bytes == null { return "" }
        defer { env.functions.ReleaseStringUTFChars(env, value, bytes) }
        answer := TextFromCString(bytes)
        if !CopyCString(answer, output) { return "" }
        return TextView(output[:answer.count])
    }
    unused request
    unused output
    return ""
}

#if #defined(ANDROID_BUILD) {
    // A NUL-terminated copy for JNI names and signatures.
    PlayBillingName :: (text: string, output: []u8) -> *u8 {
        if !CopyCString(text, output) { return null }
        return *output[0]
    }

    PlayBillingClear :: (env: *JniEnv) -> bool {
        if env.functions.ExceptionCheck(env) == 0 { return false }
        env.functions.ExceptionClear(env)
        return true
    }

    // org.kryonlabs.play.PlayBilling through the activity's class loader, or null.
    PlayBillingClass :: (env: *JniEnv, activity: *void) -> *void {
        activity_class := env.functions.GetObjectClass(env, activity)
        if activity_class == null { return null }
        defer { env.functions.DeleteLocalRef(env, activity_class) }
        name_3: [24]u8
        name_4: [40]u8
        get_loader := env.functions.GetMethodID(env, activity_class, PlayBillingName("getClassLoader", name_3[:]), PlayBillingName("()Ljava/lang/ClassLoader;", name_4[:]))
        if get_loader == null { PlayBillingClear(env); return null }
        loader := env.functions.CallObjectMethodA(env, activity, get_loader, null)
        if PlayBillingClear(env) || loader == null { return null }
        defer { env.functions.DeleteLocalRef(env, loader) }
        loader_class := env.functions.GetObjectClass(env, loader)
        if loader_class == null { return null }
        defer { env.functions.DeleteLocalRef(env, loader_class) }
        name_5: [16]u8
        name_6: [48]u8
        load := env.functions.GetMethodID(env, loader_class, PlayBillingName("loadClass", name_5[:]), PlayBillingName("(Ljava/lang/String;)Ljava/lang/Class;", name_6[:]))
        if load == null { PlayBillingClear(env); return null }
        arguments: [1]JniValue
        name_7: [40]u8
        arguments[0].reference = AndroidJniString(env, PlayBillingName("org.kryonlabs.play.PlayBilling", name_7[:]))
        if arguments[0].reference == null { return null }
        defer { env.functions.DeleteLocalRef(env, arguments[0].reference) }
        billing := env.functions.CallObjectMethodA(env, loader, load, *arguments[0])
        if PlayBillingClear(env) { return null }
        return billing
    }
}
