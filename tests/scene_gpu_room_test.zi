// Explicit integration fixture. The runner supplies Jungle's host module path;
// geometry and materials are imported unchanged from the actual application.
#import, file "../src/backend/scene_gpu.zi";
#import "treehouse_draw"
#import "treehouse_scene"
#import "jungle_title_data"
#import "std/image"
#import "std/vec"
#import "std/math"
#import "std/file"
#import "std/c_string"
#import "std/byte_text_linux"
#import "kryon/scene_render"
#import "kryon/scene"
AndroidRoom :: #import "treehouse_android";
#import, file "scene_gpu_padding.zi";
libc :: #system_library "c";
TickTime :: struct {seconds: s64;nanoseconds: s64}
TickGet :: (id: s32,value: *TickTime)->s32 #foreign libc "clock_gettime";
Tick :: ()->float64 {t: TickTime;unused TickGet(1,*t);return cast(float64)t.seconds*1000.0+cast(float64)t.nanoseconds/1000000.0}
Load :: (path: string)->Image {
 data: Vec(u8);defer VecFree(data)
 if !ReadFileInto(path,*data)||data.count<8 {print("room asset unavailable %\n",path);return .{}}
 width:=cast(s32)data[0]+cast(s32)data[1]*256
 height:=cast(s32)data[4]+cast(s32)data[5]*256
 image:=NewImage(width,height)
 if data.count!=8+image.pixels.count {VecFree(image.pixels);return .{}}
 for at:0..image.pixels.count-1 {image.pixels[at]=data[at+8]}
 return image
}
PrintProfile :: (kind: string,width: s32,height: s32,frame: s64,result: SceneGpuFrame) {
 p:=result.profile
 print("room profile % % % % % % % % %\n",kind,width,height,frame,p.shader_setup_ms,p.texture_upload_ms,
  p.gpu_completion_ms,p.pixel_transfer_ms,p.image_copy_ms)
}
Hash :: (image: *Image)->u64 {
 h: u64=1469598103934665603
 for at:0..image.pixels.count-1 {h=(h^cast(u64)image.pixels[at])*cast(u64)1099511628211}
 return h
}
ResolutionSample :: (image: *Image,prefix: string,w: s32,h: s32,frame: s64,render: float64,resize: float64,legacy: float64,result: SceneGpuFrame)->bool {
 print("resolution % % % % % % % % % %\n",w,h,frame,render,resize,legacy,
  result.profile.shader_setup_ms,result.profile.texture_upload_ms,result.profile.gpu_completion_ms,result.profile.pixel_transfer_ms)
 if frame<9 {return true}
 name: Vec(u8);BuilderPrint(*name,"%-%-%.rgba",prefix,w,frame);path: Text=BuilderFinish(name)
 return WriteEntireFile(TextView(path),TextFromBytes(image.pixels[:]))
}
ProfileResolution :: (gpu: *SceneGpuContext,cache: *TreehouseRenderCache,room: s32,prefix: string)->bool {
 width: s32=2527; height: s32=1423
 // The production view keeps the same screen crop at each pan position.
 for pan:-1..1 {
  x:=cast(float64)pan; y:=-x
  native:=AndroidRoom.TreehouseAndroidViewFor(1600,720,1.0,x,y,true,0.0)
  pixels:=cast(float64)native.cache_width*cast(float64)native.cache_height*0.9025
  scaled:=AndroidRoom.TreehouseAndroidViewFor(1600,720,1.0,x,y,true,pixels)
  if scaled.cache_width!=native.cache_width||scaled.cache_height!=native.cache_height||
   scaled.render_width!=cast(s32)(cast(float64)native.render_width*0.95+0.5)||
   scaled.render_height!=cast(s32)(cast(float64)native.render_height*0.95+0.5)||
   scaled.crop.x!=native.crop.x||scaled.crop.y!=native.crop.y||
   scaled.crop.width!=native.crop.width||scaled.crop.height!=native.crop.height {return false}
 }
 for variant:0..2 {
  // Begin each size without cached scene geometry, textures or programs.
  if variant>0 {
   SceneGpuRelease(gpu)
   if !SceneGpuProbe(gpu).available {return false}
   SceneGpuSetProfiling(gpu,true)
  }
  scale: float64=ifx variant==0 then 1.0 else ifx variant==1 then 0.95 else 0.90
  w:=cast(s32)(cast(float64)width*scale+0.5)
  h:=cast(s32)(cast(float64)height*scale+0.5)
  camera:=AndroidRoom.TreehousePanoramaCamera(room,.{},w,h,
   .{0.0,0.0,1600.0*cast(float32)w/2527.0,720.0*cast(float32)h/1423.0})
  image:=NewImage(w,h);defer VecFree(image.pixels)
  enlarged: Image;defer VecFree(enlarged.pixels)
  for frame:0..11 {
   hour: float64=ifx frame==10 then 18.0 else ifx frame==11 then 22.0 else 12.0
   TreehouseSetDaylight(cache,hour,0.0)
   start:=Tick()
   result:=SceneGpuRender(gpu,*cache.scene,camera,*image)
   rendered:=Tick()
   if !result.ok {print("resolution render failed %\n",result.diagnostic);return false}
   if variant==0 {
    if !ResolutionSample(*image,prefix,w,h,frame,rendered-start,0.0,0.0,result) {return false}
   } else {
    if !SceneResizeOpaqueInto(*image,width,height,*enlarged) {return false}
    resized:=Tick()
    reference:=ResizeLanczos(*image,width,height);defer VecFree(reference.pixels)
    legacy:=Tick()-resized
    if enlarged.width!=width||enlarged.height!=height||!ImageValid(*reference) {return false}
    for at:0..reference.pixels.count-1 {
     if reference.pixels[at]!=enlarged.pixels[at] {print("resolution resize pixel mismatch at %\n",at);return false}
    }
    if !ResolutionSample(*enlarged,prefix,w,h,frame,rendered-start,resized-rendered,legacy,result) {return false}
   }
  }
 }
 return true
}
#program_export
main :: (argc: s32,argv: **u8)->s32 {
 if argc<1||argc>3 {return 1}
 balcony: s32=-1
 for room:cast(s32)0..TITLE_SCENE_COUNT-1 {
  if TITLE_SCENE_NAME[room]=="treehouse-balcony" {balcony=room;break}
 }
 if balcony<0||!TreehouseRoom(balcony) {return 2}
 if argc==1 {
  for at:cast(s32)0..TreehouseAssetCount()-1 {
   path:=TreehouseAsset(at)
   if path.count>0 {print("%\n",path)}
  }
  return 0
 }
 cache: TreehouseRenderCache
 prepared:=Tick()
 if !TreehousePrepare(*cache,balcony,Load,false) {return 2}
 print("room scene preparation with decoded assets % ms\n",Tick()-prepared)
 // The production app passes the same materials through a different native
 // call context. This variant tests representation independence explicitly.
 mode:=ifx argc==3 then TextFromCString(argv[2]) else ""
 if mode=="padding" {
  for at:0..cache.scene.meshes.count-1 {MaterialFillPadding(*cache.scene.meshes[at].material,cast(u8)(at%251))}
  print("room padding variant enabled\n")
 }
 print("room meshes % vertices % triangles % texels %\n",cache.scene.meshes.count,cache.scene.positions.count,cache.scene.positions.count/3,cache.scene.texels.count)
 gpu: SceneGpuContext;caps:=SceneGpuProbe(*gpu)
 if !caps.available {print("GPU unavailable %\n",caps.diagnostic);return 3}
 SceneGpuSetProfiling(*gpu,true)
 print("GPU renderer %\n",TextView(caps.renderer[:]))
 print("GPU version %\n",TextView(caps.version[:]))
 print("GPU vendor % highp bits % range % max_samples % actual_samples %\n",TextView(caps.vendor[:]),caps.highp_bits,caps.highp_range,caps.max_samples,caps.samples)
 if mode=="resolution" {
  ok:=ProfileResolution(*gpu,*cache,balcony,TextFromCString(argv[1]))
  SceneGpuRelease(*gpu);TreehouseRenderClose(*cache)
  return ifx ok then 0 else 13
 }
 for size:0..2 {
  width: s32=ifx size==0 then 2527 else ifx size==1 then 960 else 420
  height: s32=ifx size==0 then 1423 else ifx size==1 then 600 else 900
  image:=NewImage(width,height);reference:=NewImage(width,height)
  TreehouseSetDaylight(*cache,12.0,0.0)
  if !TreehouseRenderInto(*cache,.{},12.0,*reference) {return 4}
  camera:=TreehouseRenderCamera(*cache,.{},12.0,width,height)
  result:=SceneGpuRender(*gpu,*cache.scene,camera,*image)
  if !result.ok {print("room GPU failure % log %\n",result.diagnostic,TextView(gpu.log[:]));return 5}
  prefix:=TextFromCString(argv[1])
  b: Vec(u8);BuilderPrint(*b,"%-%-cpu.rgba",prefix,width);cpu: Text=BuilderFinish(b)
  c: Vec(u8);BuilderPrint(*c,"%-%-gpu.rgba",prefix,width);out: Text=BuilderFinish(c)
  if !WriteEntireFile(TextView(cpu),TextFromBytes(reference.pixels[:]))||!WriteEntireFile(TextView(out),TextFromBytes(image.pixels[:])) {return 6}
  print("room cold % % % % %\n",width,height,result.submit_ms,result.readback_ms,result.conversion_ms)
  PrintProfile("cold",width,height,-1,result)
  // Hold the scenery and light direction steady while panning the camera.
  TreehouseSetDaylight(*cache,18.0,0.0)
  if !SceneGpuRender(*gpu,*cache.scene,camera,*image).ok {return 7}
  before:=SceneGpuMemoryUsage(*gpu)
  previous: u64
  for frame:0..124 {
   travel: TreehouseCamera=.{Sin(cast(float64)frame*0.047)*0.3,Cos(cast(float64)frame*0.039)*0.04}
   camera=TreehouseRenderCamera(*cache,travel,18.0,width,height)
   start:=Tick()
   result=SceneGpuRender(*gpu,*cache.scene,camera,*image)
   wall:=Tick()-start
   if !result.ok {print("motion failure %\n",result.diagnostic);return 7}
   hash:=Hash(*image)
   if frame>0&&hash==previous {return 8}
   previous=hash
   print("room frame % % % % % % % % % % % % %\n",width,height,frame,result.submit_ms,result.readback_ms,result.conversion_ms,wall,hash,
    result.prepare_ms,result.shadow_ms,result.draw_ms,result.draw_calls,result.shadow_passes)
   PrintProfile("warm",width,height,frame,result)
  }
  after:=SceneGpuMemoryUsage(*gpu)
  print("room resources % % % % % % % % % % shadow_renders %\n",width,after.cpu_bytes,after.gpu_bytes,after.buffers,after.textures,after.programs,after.framebuffers,after.renderbuffers,after.geometry_uploads,after.texture_uploads,after.shadow_renders)
  if before.geometry_uploads!=after.geometry_uploads||before.texture_uploads!=after.texture_uploads||before.gpu_bytes!=after.gpu_bytes||before.cpu_bytes!=after.cpu_bytes||before.shadow_renders!=after.shadow_renders {return 9}
  // Additional CPU references exercise different camera poses, daylight,
  // shader uniforms and moving shadow edges, beyond the approved noon view.
  for state:1..3 {
   travel: TreehouseCamera=.{ifx state==1 then 0.28 else -0.24,ifx state==2 then 0.06 else -0.04}
   hour: float64=ifx state==1 then 7.0 else ifx state==2 then 18.0 else 22.0
   TreehouseSetDaylight(*cache,hour,0.0)
   if !TreehouseRenderInto(*cache,travel,hour,*reference) {return 10}
   camera=TreehouseRenderCamera(*cache,travel,hour,width,height)
   if !SceneGpuRender(*gpu,*cache.scene,camera,*image).ok {return 11}
   a: Vec(u8);BuilderPrint(*a,"%-%-state%-cpu.rgba",prefix,width,state);cpu_state: Text=BuilderFinish(a)
   z: Vec(u8);BuilderPrint(*z,"%-%-state%-gpu.rgba",prefix,width,state);gpu_state: Text=BuilderFinish(z)
   if !WriteEntireFile(TextView(cpu_state),TextFromBytes(reference.pixels[:]))||!WriteEntireFile(TextView(gpu_state),TextFromBytes(image.pixels[:])) {return 12}
  }
  VecFree(image.pixels);VecFree(reference.pixels)
 }
 SceneGpuRelease(*gpu);TreehouseRenderClose(*cache);RenderSceneRelease()
 return 0
}
