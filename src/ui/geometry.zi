#import "math"

Vector2 :: struct {
    x: float32
    y: float32
}

Rectangle :: struct {
    x: float32
    y: float32
    width: float32
    height: float32
}

Camera :: struct {
    offset: Vector2
    target: Vector2
    rotation: float32
    zoom: float32
}

#program_export
WorldToScreen :: (point: Vector2, camera: Camera) -> Vector2 {
    sine: float32 = SineDegrees(camera.rotation)
    cosine: float32 = CosineDegrees(camera.rotation)
    x: float32 = (point.x - camera.target.x) * camera.zoom
    y: float32 = (point.y - camera.target.y) * camera.zoom
    return Vector2.{camera.offset.x + x * cosine - y * sine,
                    camera.offset.y + x * sine + y * cosine}
}

#program_export
ScreenToWorld :: (point: Vector2, camera: Camera) -> Vector2 {
    if camera.zoom == 0.0 { return camera.target }
    sine: float32 = SineDegrees(camera.rotation)
    cosine: float32 = CosineDegrees(camera.rotation)
    x: float32 = (point.x - camera.offset.x) / camera.zoom
    y: float32 = (point.y - camera.offset.y) / camera.zoom
    return Vector2.{camera.target.x + x * cosine + y * sine,
                    camera.target.y - x * sine + y * cosine}
}

#program_export
RectangleIntersection :: (a: Rectangle, b: Rectangle) -> Rectangle {
    result: Rectangle
    right: float32 = a.x + a.width
    bottom: float32 = a.y + a.height
    other_right: float32 = b.x + b.width
    other_bottom: float32 = b.y + b.height
    result.x = a.x
    if b.x > a.x { result.x = b.x }
    result.y = a.y
    if b.y > a.y { result.y = b.y }
    if other_right < right { right = other_right }
    if other_bottom < bottom { bottom = other_bottom }
    result.width = right - result.x
    result.height = bottom - result.y
    if result.width < 0.0 { result.width = 0.0 }
    if result.height < 0.0 { result.height = 0.0 }
    return result
}
