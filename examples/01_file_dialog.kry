#import "kryon.h"
#import "file_dialog.h"
#import "stdio.h"

app "Kryon File Dialog Example" {
    size 800 600
    fps 60
    font examples
}

state {
    dlg: FileDialog = {0}
    status: [256] char = "Choose an action."
    last_path: [512] char = ""
    dlg_ready: int = 0
}

FileDialogExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        if dlg_ready == 0 {
            InitFileDialog(&dlg)
            dlg_ready = 1
        }
        Text((TextProps){.bounds={Scale(32), Scale(28), 0, 0}, .text="Kryon File Dialog", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(32), Scale(66), 0, 0}, .text="Dialog backend and result state", .font=Text16, .color=GetThemeIcon(), .wrap=TextWrapNone})
        if Button((ButtonProps){.bounds = {Scale(32), Scale(116), Scale(180), Scale(42)}, .label = "Open File", .style = ButtonStylePrimary, .font = Text16, .id = 101}) {
            BeginLoadFileDialog(&dlg,"Open File")
            snprintf(status,sizeof(status),"Open file requested.")
        }
        if Button((ButtonProps){.bounds = {Scale(226), Scale(116), Scale(180), Scale(42)}, .label = "Save File", .style = ButtonStyleSecondary, .font = Text16, .id = 102}) {
            BeginSaveFileDialog(&dlg,"Save File","untitled.kry")
            snprintf(status,sizeof(status),"Save file requested.")
        }
        if Button((ButtonProps){.bounds = {Scale(420), Scale(116), Scale(180), Scale(42)}, .label = "Select Folder", .style = ButtonStyleSecondary, .font = Text16, .id = 103}) {
            BeginSelectFileDialogFolder(&dlg,"Select Folder")
            snprintf(status,sizeof(status),"Folder selection requested.")
        }
        dialog_result: int = UpdateFileDialog(&dlg)
        if dialog_result == 1 {
            snprintf(last_path,sizeof(last_path),"%s",GetFileDialogPath(&dlg))
            snprintf(status,sizeof(status),"Selected: %s",last_path)
        }
        if dialog_result < 0 {
            snprintf(status,sizeof(status),"Dialog cancelled.")
        }
        Text((TextProps){.bounds={Scale(32), Scale(210), 0, 0}, .text="Status", .font=18, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(32), Scale(242), 0, 0}, .text=status, .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(32), Scale(274), 0, 0}, .text=last_path, .font=Text16, .color=GetThemeIcon(), .wrap=TextWrapNone})
    }
}
