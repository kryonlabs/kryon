#import "app"
#import "dpi"
#import "geometry"
#import "raylib_runtime"
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "zoom"

using DPIPlatform;

using FrameStatus;

libc :: #system_library "libc";
RaylibWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";

RaylibError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = cast(u8)10
    RaylibWrite(2, *output[0], cast(u64)(length + 1))
    return 1
}

DrawRaylibFrame :: (session: Session, viewport: Rectangle, wheel: float32,
    capture: bool) -> bool {
    BeginRaylibFrame()
    pointer: PointerFrame = PollPointer()
    TreePointerUpdate(session, pointer)
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    if BeginFrame(session, cast(u64)1, viewport) !=
        cast(FrameStatus)FrameOk {
        EndRaylibFrame()
        return false
    }
    if Frame(session, viewport) != 0 {
        TreeCancel(session)
        EndRaylibFrame()
        return false
    }
    if EndFrame(session) != cast(FrameStatus)FrameOk {
        EndRaylibFrame()
        return false
    }
    if capture && !CaptureConfigured() {
        EndRaylibFrame()
        return false
    }
    return EndRaylibFrame()
}

#program_export
main :: () -> s32 {
    if !OpenRaylib() {
        CloseRaylib()
        return RaylibError("kryon: could not open the raylib window")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseRaylib()
        return RaylibError("kryon: could not open a UI session")
    }
    ok: bool = true
    // Ctrl and the wheel, or Ctrl with plus, minus, and zero, scale the whole
    // application. The session's ZoomProps decide whether that is on; the
    // default is automatic, which zooms a desktop window.
    desktop: DPIPlatform = cast(DPIPlatform)DPIPlatformDesktop
    initial_zoom: float32 = RaylibEnvironmentZoom()
    if initial_zoom > 0.0 { unused ZoomSet(session, initial_zoom) }
    RaylibSetZoom(ZoomFactor(session))
    if CaptureRequested() {
        ok = DrawRaylibFrame(session, RaylibViewport(), 0.0, true)
    } else {
        while ok && PollRaylib() {
            modifiers: s32 = RaylibModifiers()
            KeyboardModifiersSend(session, modifiers)
            wheel: float32 = RaylibWheelMove()
            if ZoomWheel(session, desktop, wheel, modifiers) { wheel = 0.0 }
            key: s32 = RaylibPressedKey()
            if key != 0 && !ZoomKey(session, desktop, key, modifiers) {
                KeyboardSend(session, key)
            }
            RaylibSetZoom(ZoomFactor(session))
            codepoint: s32 = RaylibTypedCodepoint()
            while codepoint != 0 {
                TypedCodepointSend(session, codepoint)
                codepoint = RaylibTypedCodepoint()
            }
            ok = DrawRaylibFrame(session, RaylibViewport(), wheel, false)
        }
    }
    CloseSession(session)
    CloseRaylib()
    if ok { return 0 }
    return RaylibError("kryon: raylib frame rendering failed")
}
