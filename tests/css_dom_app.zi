using UI :: #import "kryon/Widgets";
CSS :: #import "css/Css";
Dom :: #import "kryon/Dom";
#import "kryon/theme"
#import "std/web"

using ButtonState;

host_api :: #system_library "host_api";
RequestWindowClose :: () #foreign host_api;

started: bool;
updated: bool;
sheet: CSS.CssSheet;

css_source :: #string CSS
:root {
  --save-motion: 123ms;
}

Button.primary {
  background: #111111;
  color: #ffffff;
  min-height: 32px;
  width: 180px;
  display: block;
  margin-bottom: 8px;
}

Button#save {
  background: #102030;
  color: #f0e0d0;
  min-height: 64px;
  line-height: 1.4;
  font-family: "Kryon Css Test";
  font-size: 17px;
  transition: opacity 123ms linear;
  -kryon-font-role: body;
  -kryon-elevation: floating;
  -kryon-motion-duration: var(--save-motion);
  -kryon-motion-multiplier: 1.25;
  -kryon-motion-easing: standard;
  -kryon-motion-reduced: no-preference;
}

Button#other {
  background: #302010;
}

Button#state {
  background: #203040;
}

Button#state:selected {
  background: #405060;
}

Button#focus:focus {
  background: #506070;
}

Button#disabled:disabled {
  background: #607080;
}

@media (prefers-reduced-motion: reduce) {
  Button#save {
    -kryon-motion-duration: 0ms;
  }
}
CSS;

ButtonFor :: (key: u64, id: s32, label: string,
    selected: bool, disabled: bool) -> ButtonProps {
    props: ButtonProps
    props.key = key
    props.id = id
    props.class_name = CSS.StyleClass("primary")
    props.label = label
    props.bounds = Rectangle.{12.0, 12.0, 180.0, 32.0}
    props.selected = selected
    props.disabled = disabled
    return props
}

Start :: () -> bool {
    if !InstallDefaultTheme(false) { return false }
    CSS.CssSheetReset(*sheet)
    if !CSS.CssSheetParse(*sheet, css_source, "css-dom.css",
        CSS.CssNoImports) { return false }
    if !CSS.CssSheetInstall(*sheet, CSS.CssDefaultEnvironment(),
        null) { return false }

    exported: [16384]u8
    result: CSS.CSSExport = CSS.ExportCSS(css_source,
        "css-dom.css", CSS.CssDefaultEnvironment(), exported[:])
    if !result.ok ||
        !Dom.UseDocumentLayout(TextView(exported[:result.count])) { return false }

    save: ButtonProps = ButtonFor(cast(u64)101,
        CSS.StyleId("save"), "Save", false, false)
    face := ButtonInstalledFaceFor(save, cast(s32)ButtonStateNormal)
    scope: s32 = WebScope()
    WebSet(WebGlobal, WebName("__cssDomMinHeight"),
        WebNumber(cast(float64)face.min_height))
    WebSet(WebGlobal, WebName("__cssDomLineHeight"),
        WebNumber(cast(float64)face.line_height))
    WebSet(WebGlobal, WebName("__cssDomTypeface"), WebText(face.typeface))
    WebSet(WebGlobal, WebName("__cssDomElevation"),
        WebNumber(cast(float64)face.elevation))
    WebSet(WebGlobal, WebName("__cssDomMotionDuration"),
        WebNumber(cast(float64)face.motion_duration))
    WebSet(WebGlobal, WebName("__cssDomMotionMultiplier"),
        WebNumber(cast(float64)face.motion_multiplier))
    WebEnd(scope)
    return true
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    scope: s32 = WebScope()
    defer WebEnd(scope)
    if !started {
        if !Start() { return 1 }
        started = true
    }
    if !updated && WebAsBool(WebGet(WebGlobal,
            WebName("__cssDomUpdate"))) { updated = true }

    page: PageProps
    page.key = cast(u64)1; page.bounds = viewport; page.title = "CSS DOM"
    opened: PageResult = Page(session, page)

    save: ButtonProps = ButtonFor(cast(u64)101,
        CSS.StyleId("save"), ifx updated then "Save updated" else "Save",
        false, false)
    other: ButtonProps = ButtonFor(cast(u64)102,
        CSS.StyleId("other"), "Other", true, false)
    state: ButtonProps = ButtonFor(cast(u64)103,
        CSS.StyleId("state"), "State", true, false)
    focus: ButtonProps = ButtonFor(cast(u64)104,
        CSS.StyleId("focus"), "Focus", false, false)
    disabled: ButtonProps = ButtonFor(cast(u64)105,
        CSS.StyleId("disabled"), "Disabled", false, true)
    plain: ButtonProps = ButtonFor(cast(u64)106, 0, "Plain",
        false, false)
    if updated {
        Button(session, other)
        Button(session, save)
    } else {
        Button(session, save)
        Button(session, other)
    }
    Button(session, state)
    Button(session, focus)
    Button(session, disabled)
    Button(session, plain)

    if opened.opened { End(session) }
    if WebAsBool(WebGet(WebGlobal, WebName("__cssDomDone"))) {
        RequestWindowClose()
    }
    return 0
}
