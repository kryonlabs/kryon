#import "kryon.h"
#style <material> as material

app "Kryon Keyboard Platform" {
    size 800 600
    fps 60
    font examples
}

state {
    copied: int = 0
    message: [128] char = "Press Ctrl/Cmd+C to copy text."
}

KeyboardPlatformExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        AppBackground()
        Text((TextProps){.bounds={40, 40, 0, 0}, .text="Keyboard and clipboard", .wrap=TextWrapNone})
        Text((TextProps){.bounds={40, 90, 0, 0}, .text=message, .wrap=TextWrapNone})
        if AcceleratorPressed((Accelerator){KEY_C,1,0,0,1}) {
            SetClipboardTextValue("Copied from Kryon")
            snprintf(message,sizeof(message),"Copied to clipboard")
            copied = 1
        }
        if copied {
            Text((TextProps){.bounds={40, 130, 0, 0}, .text="Clipboard updated.", .wrap=TextWrapNone})
        }
    }
}
