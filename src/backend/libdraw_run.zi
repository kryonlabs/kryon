#import "secondary_pointer"
#import "app"
#import "cairo_raster"
#import "geometry"
#import "libdraw_runtime"
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"

using FrameStatus;

libc :: #system_library "libc";
LibdrawWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";

LibdrawError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = cast(u8)10
    LibdrawWrite(2, *output[0], cast(u64)(length + 1))
    return 1
}

DrawLibdrawFrame :: (session: Session, viewport: Rectangle) -> bool {
    BeginLibdrawFrame()
    TreePointerUpdate(session, PollPointer())
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    pointer := PollPointer()
    PointerWheelSend(session, pointer.x, pointer.y, LibdrawWheelMove())
    if BeginFrame(session, cast(u64)1, viewport) !=
    cast(FrameStatus)FrameOk { return false }
    if Frame(session, viewport) != 0 {
        TreeCancel(session)
        return false
    }
    if EndFrame(session) != cast(FrameStatus)FrameOk { return false }
    if !EndLibdrawFrame() { return false }
    if CaptureRequested() { return CaptureConfigured() }
    return true
}

#program_export
main :: () -> s32 {
    if !OpenLibdraw() {
        CloseLibdraw()
        return LibdrawError("kryon: could not open the libdraw window")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseLibdraw()
        return LibdrawError("kryon: could not open a UI session")
    }
    ok: bool = true
    if CaptureRequested() {
        ok = DrawLibdrawFrame(session, LibdrawViewport())
    } else {
        while ok && PollLibdraw() {
            KeyboardModifiersSend(session, LibdrawKeyboardModifiers())
            key: s32 = LibdrawPressedKey()
            if key != 0 {
                KeyboardSend(session, key)
            }
            codepoint := LibdrawTypedCodepoint()
            if codepoint != 0 { TypedCodepointSend(session, codepoint) }
            ok = DrawLibdrawFrame(session, LibdrawViewport())
            if ok { PauseLibdraw() }
        }
    }
    CloseSession(session)
    CloseLibdraw()
    if ok { return 0 }
    return LibdrawError("kryon: libdraw frame rendering failed")
}
