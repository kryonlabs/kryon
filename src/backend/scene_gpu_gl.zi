DrawArrays :: (kind: u32, first: s32, count: s32)  {RawDrawArrays(kind,first,count)}
ReadPixels :: (x: s32, y: s32, width: s32, height: s32, format: u32, kind: u32, data: *void)  {RawReadPixels(x,y,width,height,format,kind,data)}
