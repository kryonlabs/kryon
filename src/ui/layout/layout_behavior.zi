#import "geometry"
#import "layout_props"

LayoutMetrics :: struct {
    content: Rectangle
    gap: s32
    padding: s32
    padding_y: s32
}

// Stable widget identity from UTF-8 bytes. This matches the native Key
// helper, including its historical offset basis and zero sentinel.
#program_export
KeyHash :: (text: string) -> u64 {
    hash: u64 = cast(u64)1469598103934665603
    index: s32 = 0
    while index < (cast(s32)text.count) {
        hash = (hash ^ cast(u64)text[index]) * cast(u64)1099511628211
        index += 1
    }
    if hash == cast(u64)0 { return cast(u64)1 }
    return hash
}

CenteredColumnLayout :: struct {
    x: s32
    width: s32
}

FlexDirection :: enum {
    FlexRow :: 0
    FlexColumn
}

JustifyContent :: enum {
    JustifyStart :: 0
    JustifyCenter
    JustifyEnd
    JustifySpaceBetween
    JustifySpaceAround
    JustifySpaceEvenly
}

AlignItems :: enum {
    AlignStart :: 0
    AlignCenter
    AlignEnd
    AlignStretch
    // CSS baseline: items with a measured baseline share it, other items
    // of the line keep their own cross placement.
    AlignBaseline
}
using FlexDirection;
using JustifyContent;
using AlignItems;

// CSS align-content: how wrapped lines (or the single line of a row or
// column) distribute the cross space left over after their natural sizes.
AlignContent :: enum {
    AlignContentStretch :: 0
    AlignContentStart
    AlignContentCenter
    AlignContentEnd
    AlignContentSpaceBetween
    AlignContentSpaceAround
    AlignContentSpaceEvenly
}
using AlignContent;


FlexProps :: struct {
    bounds: Rectangle
    direction: FlexDirection
    justify_content: JustifyContent
    align_items: AlignItems
    // Cross-axis distribution of the lines; unset is AlignContentStretch.
    align_content: AlignContent
    gap: s32
    padding: s32
    cross_gap: s32
    wrap: bool
    // `wrap-reverse`: the lines stack bottom to top.
    wrap_reverse: bool
    reverse: bool
}

FlexItem :: struct {
    width: float32
    height: float32
    basis: float32
    has_basis: bool
    grow: float32
    shrink: float32
    align_self: AlignItems
    has_align_self: bool
    kind: s32
    id: s32
    class_name: s32
    grow_override: bool
    shrink_override: bool
    // Placement order inside the container; a nonzero order wins over the
    // style's. Earlier siblings precede on ties.
    order: s32
    // The item's first-baseline ascent from its top; at most zero places
    // its bottom edge on the line's baseline.
    baseline: float32
    // Main-axis clamps in logical pixels; at most zero is CSS `none`.
    min_width: float32
    max_width: float32
    min_height: float32
    max_height: float32
    // The basis is a percentage of the container's inner main size.
    basis_percent: bool
}

FlexItemResolver :: #type (item: FlexItem) -> FlexItem;

FlexPlacement :: struct {
    bounds: Rectangle
    grow: float32
    shrink: float32
    align: AlignItems
    // The clamped main sizes: bounds.width never leaves them.
    min_main: float32
    max_main: float32
    baseline: float32
    order: s32
    // The caller's item index; placement permutes and restores it.
    slot: s32
}

FlexCursor :: struct {
    content: Rectangle
    item: Rectangle
    direction: FlexDirection
    align_items: AlignItems
    position: float32
    gap: float32
    remaining: s32
}

Clamp :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    out: s32 = value
    if out < min_value { out = min_value }
    if out > max_value { out = max_value }
    return out
}

#program_export
CenteredColumnFor :: (view_width: s32, max_width: s32, side_padding: s32) -> CenteredColumnLayout {
    layout: CenteredColumnLayout
    if view_width < 0 { view_width = 0 }
    if max_width < 0 { max_width = 0 }
    if side_padding < 0 { side_padding = 0 }
    available: s32 = view_width - side_padding * 2
    if available < 0 { available = 0 }
    layout.width = max_width
    if layout.width > available { layout.width = available }
    layout.x = (view_width - layout.width) / 2
    return layout
}

#program_export
PageSidePaddingFor :: (view_width: s32) -> s32 {
    padding: s32 = view_width / 50
    return Clamp(padding, 12, 24)
}

#program_export
DesktopWidthThresholdFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(500.0 * scale + 0.5)
}

#program_export
IsDesktopWidth :: (view_width: s32, scale: float32) -> bool {
    return view_width >= DesktopWidthThresholdFor(scale)
}

#program_export
LayoutMetricsFor :: (bounds: Rectangle, gap: s32, padding: s32, padding_y: s32 = -1) -> LayoutMetrics {
    metrics: LayoutMetrics
    if gap < 0 { gap = 0 }
    if padding < 0 { padding = 0 }
    if padding_y < 0 { padding_y = padding }
    metrics.gap = gap
    metrics.padding = padding
    metrics.padding_y = padding_y
    metrics.content.x = bounds.x + cast(float32)padding
    metrics.content.y = bounds.y + cast(float32)padding_y
    metrics.content.width = bounds.width - cast(float32)padding * 2.0
    metrics.content.height = bounds.height - cast(float32)padding_y * 2.0
    if metrics.content.width < 0.0 { metrics.content.width = 0.0 }
    if metrics.content.height < 0.0 { metrics.content.height = 0.0 }
    return metrics
}

#program_export
LayoutScopeBounds :: (bounds: Rectangle, fallback_width: s32, fallback_height: s32) -> Rectangle {
    out: Rectangle = bounds
    if out.width <= 0.0 { out.width = cast(float32)fallback_width }
    if out.height <= 0.0 { out.height = cast(float32)fallback_height }
    if out.width < 0.0 { out.width = 0.0 }
    if out.height < 0.0 { out.height = 0.0 }
    return out
}

#program_export
LayoutCursorForChild :: (metrics: LayoutMetrics, horizontal: bool,
    child_index: s32, previous_extent_sum: float32) -> float32 {
    if child_index < 0 { child_index = 0 }
    base: float32 = metrics.content.y
    if horizontal { base = metrics.content.x }
    return base + previous_extent_sum + cast(float32)child_index * cast(float32)metrics.gap
}

#program_export
LayoutChildBounds :: (declared: Rectangle, current: Rectangle,
    metrics: LayoutMetrics, horizontal: bool, cursor: float32) -> Rectangle {
    out: Rectangle = current
    if horizontal {
        out.x = cursor
        out.y = metrics.content.y
        if out.height <= 0.0 { out.height = metrics.content.height }
    } else {
        out.x = metrics.content.x
        out.y = cursor
        if out.width <= 0.0 { out.width = metrics.content.width }
    }
    if declared.x != 0.0 || declared.y != 0.0 { return current }
    return out
}

#program_export
StackChildBounds :: (declared: Rectangle, current: Rectangle,
    metrics: LayoutMetrics) -> Rectangle {
    out: Rectangle = current
    if declared.x != 0.0 || declared.y != 0.0 { return current }
    out.x = metrics.content.x
    out.y = metrics.content.y
    if out.width <= 0.0 { out.width = metrics.content.width }
    if out.height <= 0.0 { out.height = metrics.content.height }
    return out
}

#program_export
BeginFlexCursor :: (props: FlexProps, count: s32, total_item_extent: float32) -> FlexCursor {
    cursor: FlexCursor
    metrics := LayoutMetricsFor(props.bounds, props.gap, props.padding)
    horizontal := props.direction != cast(FlexDirection)FlexColumn
    available := ifx horizontal then metrics.content.width else metrics.content.height
    cursor.content = metrics.content
    cursor.direction = props.direction
    cursor.align_items = props.align_items
    cursor.gap = cast(float32)metrics.gap
    cursor.position = ifx horizontal then metrics.content.x else metrics.content.y
    if count <= 0 { return cursor }
    cursor.remaining = count
    if total_item_extent < 0.0 { total_item_extent = 0.0 }
    remaining := available - total_item_extent - cursor.gap * cast(float32)(count - 1)
    if remaining < 0.0 { remaining = 0.0 }
    offset: float32 = 0.0
    if props.justify_content == cast(JustifyContent)JustifyCenter {
        offset = remaining / 2.0
    } else if props.justify_content == cast(JustifyContent)JustifyEnd {
        offset = remaining
    } else if props.justify_content == cast(JustifyContent)JustifySpaceBetween && count > 1 {
        cursor.gap += remaining / cast(float32)(count - 1)
    } else if props.justify_content == cast(JustifyContent)JustifySpaceAround {
        offset = remaining / cast(float32)count / 2.0
        cursor.gap += remaining / cast(float32)count
    } else if props.justify_content == cast(JustifyContent)JustifySpaceEvenly {
        offset = remaining / (cast(float32)count + 1.0)
        cursor.gap += offset
    }
    cursor.position += offset
    return cursor
}

#program_export
FlexStep :: (cursor: FlexCursor, width: float32, height: float32) -> FlexCursor {
    cursor.item = Rectangle.{0.0, 0.0, 0.0, 0.0}
    if cursor.remaining <= 0 { return cursor }
    if width < 0.0 { width = 0.0 }
    if height < 0.0 { height = 0.0 }
    horizontal := cursor.direction != cast(FlexDirection)FlexColumn
    cross_size := ifx horizontal then cursor.content.height else cursor.content.width
    extent := ifx horizontal then height else width
    if cursor.align_items == cast(AlignItems)AlignStretch && extent <= 0.0 {
        extent = cross_size
    }
    cross_remaining := cross_size - extent
    if cross_remaining < 0.0 { cross_remaining = 0.0 }
    cross_offset: float32 = 0.0
    if cursor.align_items == cast(AlignItems)AlignCenter {
        cross_offset = cross_remaining / 2.0
    } else if cursor.align_items == cast(AlignItems)AlignEnd {
        cross_offset = cross_remaining
    }
    if horizontal {
        cursor.item = Rectangle.{cursor.position,
            cursor.content.y + cross_offset, width, extent}
        cursor.position += width + cursor.gap
    } else {
        cursor.item = Rectangle.{cursor.content.x + cross_offset,
            cursor.position, extent, height}
        cursor.position += height + cursor.gap
    }
    cursor.remaining -= 1
    return cursor
}

FlexNonnegative :: (value: float32) -> float32 {
    return ifx value > 0.0 then value else 0.0
}

// A percentage basis refers to the inner main size; against an indefinite
// one (zero: a column without a height) the item is content-sized.
FlexBasis :: (item: FlexItem, horizontal: bool, main: float32) -> float32 {
    if item.has_basis && !item.basis_percent { return FlexNonnegative(item.basis) }
    if item.has_basis && main > 0.0 {
        return FlexNonnegative(cast(float32)(cast(float64)item.basis * cast(float64)main / 100.0))
    }
    return FlexNonnegative(ifx horizontal then item.width else item.height)
}

// During distribution, each box's width holds its main extent even in a
// column. Growth shares the free space in rounds, freezing an item at its
// maximum so the rest absorb what it leaves; shrinkage freezes an item at
// its minimum and redistributes over the items that can still shrink.
FlexDistribute :: (boxes: []FlexPlacement, free: float32,
    total: float32, grow: float32, shrink: float32, weight: float32) -> float32 {
    if free > 0.0 && grow > 0.0 {
        rounds: s32 = 0
        while rounds < 4 {
            rounds += 1
            unit := free / (ifx grow > 1.0 then grow else 1.0)
            if unit <= 0.0 { break }
            frozen: bool = false
            for i: cast(s32)0..cast(s32)boxes.count - 1 {
                if boxes[i].grow <= 0.0 { continue }
                next := boxes[i].bounds.width + boxes[i].grow * unit
                if boxes[i].max_main > 0.0 && next > boxes[i].max_main {
                    free -= boxes[i].max_main - boxes[i].bounds.width
                    boxes[i].bounds.width = boxes[i].max_main
                    grow -= boxes[i].grow
                    boxes[i].grow = 0.0
                    frozen = true
                }
            }
            if !frozen {
                for i: cast(s32)0..cast(s32)boxes.count - 1 {
                    if boxes[i].grow > 0.0 { boxes[i].bounds.width += boxes[i].grow * unit }
                }
                return total + unit * grow
            }
            if free <= 0.0 || grow <= 0.0 { break }
        }
        return total
    }
    if free >= 0.0 || weight <= 0.0 { return total }

    initial_free := free
    while free < 0.0 && weight > 0.0 {
        deficit := ifx shrink < 1.0 && initial_free * shrink > free then initial_free * shrink else free
        unit := deficit / weight
        frozen := false
        for i: cast(s32)0..cast(s32)boxes.count - 1 {
            basis := boxes[i].bounds.width
            factor := boxes[i].shrink
            scaled := 1.0 + factor * unit
            if basis > 0.0 && factor > 0.0 && (scaled <= 0.0 || basis * scaled < boxes[i].min_main) {
                floor := boxes[i].min_main
                drop := basis - floor
                weight -= basis * factor
                shrink -= factor
                free += drop
                total -= drop
                boxes[i].bounds.width = floor
                boxes[i].shrink = 0.0
                frozen = true
            }
        }
        if !frozen {
            for i: cast(s32)0..cast(s32)boxes.count - 1 {
                boxes[i].bounds.width *= FlexNonnegative(1.0 + boxes[i].shrink * unit)
            }
            total += deficit
            break
        }
    }
    return total
}

KeepFlexItem :: (item: FlexItem) -> FlexItem { return item }

// One wrapped line: the sorted item range it covers and its cross geometry.
FlexLineSpan :: struct {
    top: float32
    cross: float32
    baseline: float32
    start: s32
    end: s32
}

// Wrapped lines beyond this fold into the last one; a measured batch of a
// page never comes close.
FlexLineLimit :: 64

// The natural cross extent of a line and its baseline: the tallest item
// sets the cross, a baseline item's ascent sets the baseline, and a
// baseline item must fit below the shared baseline.
FlexLineMeasure :: (boxes: []FlexPlacement, line: *FlexLineSpan) {
    line.cross = 0.0
    line.baseline = 0.0
    for i: line.start..line.end - 1 {
        extent := boxes[i].bounds.height
        if extent > line.cross { line.cross = extent }
        ascent := boxes[i].baseline
        if ascent <= 0.0 { ascent = extent }
        if boxes[i].align == cast(AlignItems)AlignBaseline && ascent > line.baseline {
            line.baseline = ascent
        }
    }
    for i: line.start..line.end - 1 {
        if boxes[i].align != cast(AlignItems)AlignBaseline { continue }
        ascent := boxes[i].baseline
        if ascent <= 0.0 { ascent = boxes[i].bounds.height }
        fit := line.baseline + boxes[i].bounds.height - ascent
        if fit > line.cross { line.cross = fit }
    }
}

// Place a measured batch using caller-owned storage. The result is the
// natural cross extent including padding, or -1 when there is insufficient
// storage. Items are placed in `order` first and document order on ties,
// wrapped into lines when `wrap` asks, distributed per line on the main
// axis, and stacked on the cross axis by `align_content`.
#program_export
PlaceFlexItems :: (props: FlexProps, items: []FlexItem, boxes: []FlexPlacement,
    resolve: FlexItemResolver = KeepFlexItem) -> float32 {
    if boxes.count < items.count { return -1.0 }
    metrics := LayoutMetricsFor(props.bounds, props.gap, props.padding)
    horizontal := props.direction != cast(FlexDirection)FlexColumn
    available := ifx horizontal then metrics.content.width else metrics.content.height
    available_cross := ifx horizontal then metrics.content.height else metrics.content.width
    main_gap := cast(float32)metrics.gap
    cross_gap := FlexNonnegative(cast(float32)props.cross_gap)
    count := cast(s32)items.count
    if count == 0 { return cast(float32)metrics.padding * 2.0 }
    natural_main: float32 = 0.0
    definite_main := ifx horizontal || props.bounds.height > 0.0 then available else 0.0
    for i: cast(s32)0..count - 1 {
        item := items[i]
        if resolve != null { item = resolve(item) }
        basis := FlexBasis(item, horizontal, definite_main)
        min_main := FlexNonnegative(ifx horizontal then item.min_width else item.min_height)
        max_main: float32 = 0.0
        limit := ifx horizontal then item.max_width else item.max_height
        if limit > 0.0 { max_main = limit }
        if max_main > 0.0 && basis > max_main { basis = max_main }
        if basis < min_main { basis = min_main }
        extent := FlexNonnegative(ifx horizontal then item.height else item.width)
        boxes[i] = .{.bounds = .{0.0, 0.0, basis, extent},
            .grow = FlexNonnegative(item.grow), .shrink = FlexNonnegative(item.shrink),
            .align = ifx item.has_align_self then item.align_self else props.align_items,
            .min_main = min_main, .max_main = max_main,
            .baseline = FlexNonnegative(item.baseline), .order = item.order, .slot = i}
        natural_main += basis
    }
    // Placement order: `order` first, earlier siblings on ties.
    for i: cast(s32)1..count - 1 {
        box := boxes[i]
        j := i - 1
        while j >= 0 && (boxes[j].order > box.order ||
            (boxes[j].order == box.order && boxes[j].slot > box.slot)) {
            boxes[j + 1] = boxes[j]
            j -= 1
        }
        boxes[j + 1] = box
    }
    if !horizontal && props.bounds.height <= 0.0 {
        available = natural_main + main_gap * cast(float32)(count - 1)
        metrics.content.height = available
    }
    lines: [FlexLineLimit]FlexLineSpan
    line_count: s32 = 0
    start: s32 = 0
    while start < count {
        end := start
        total: float32 = 0.0
        while end < count {
            basis := boxes[end].bounds.width
            if props.wrap && end > start && total + basis + main_gap * cast(float32)(end - start) > available { break }
            total += basis
            end += 1
        }
        if line_count >= FlexLineLimit {
            lines[FlexLineLimit - 1].end = end
            FlexLineMeasure(boxes, *lines[FlexLineLimit - 1])
        } else {
            lines[line_count] = .{.start = start, .end = end}
            FlexLineMeasure(boxes, *lines[line_count])
            line_count += 1
        }
        start = end
    }
    natural_cross: float32 = 0.0
    for line: 0..line_count - 1 {
        if line > 0 { natural_cross += cross_gap }
        natural_cross += lines[line].cross
    }
    extra := available_cross - natural_cross
    if extra < 0.0 { extra = 0.0 }
    content := props.align_content
    if content == cast(AlignContent)AlignContentStretch && extra > 0.0 {
        share := extra / cast(float32)line_count
        for line: 0..line_count - 1 { lines[line].cross += share }
    }
    top: float32 = 0.0
    between: float32 = cross_gap
    if content == cast(AlignContent)AlignContentCenter {
        top = extra / 2.0
    } else if content == cast(AlignContent)AlignContentEnd {
        top = extra
    } else if content == cast(AlignContent)AlignContentSpaceBetween && line_count > 1 {
        between = cross_gap + extra / cast(float32)(line_count - 1)
    } else if content == cast(AlignContent)AlignContentSpaceAround {
        around := extra / cast(float32)line_count
        top = around / 2.0
        between = cross_gap + around
    } else if content == cast(AlignContent)AlignContentSpaceEvenly {
        around := extra / (cast(float32)line_count + 1.0)
        top = around
        between = cross_gap + around
    }
    for line: 0..line_count - 1 {
        lines[line].top = top
        top += lines[line].cross + between
    }
    if props.wrap_reverse && line_count > 1 {
        block := lines[line_count - 1].top + lines[line_count - 1].cross
        base := lines[0].top
        for line: 0..line_count - 1 {
            lines[line].top = base + block - lines[line].top - lines[line].cross
        }
    }
    for line: 0..line_count - 1 {
        span := lines[line]
        line_bounds := metrics.content
        if horizontal { line_bounds.y += span.top; line_bounds.height = span.cross }
        else { line_bounds.x += span.top; line_bounds.width = span.cross }
        total: float32 = 0.0
        grow: float32 = 0.0
        shrink: float32 = 0.0
        weight: float32 = 0.0
        for i: span.start..span.end - 1 {
            total += boxes[i].bounds.width
            grow += boxes[i].grow
            shrink += boxes[i].shrink
            weight += boxes[i].shrink * boxes[i].bounds.width
        }
        free := available - main_gap * cast(float32)(span.end - span.start - 1) - total
        adjusted := FlexDistribute(boxes[span.start:span.end], free, total, grow, shrink, weight)
        cursor := BeginFlexCursor(FlexProps.{.bounds = line_bounds, .direction = props.direction,
            .justify_content = props.justify_content, .gap = metrics.gap}, span.end - span.start, adjusted)
        for i: span.start..span.end - 1 {
            cursor.align_items = boxes[i].align
            main := boxes[i].bounds.width
            extent := boxes[i].bounds.height
            width := ifx horizontal then main else extent
            height := ifx horizontal then extent else main
            cursor = FlexStep(cursor, width, height)
            box := cursor.item
            if props.reverse {
                if horizontal { box.x = line_bounds.x + line_bounds.width - (box.x - line_bounds.x) - box.width }
                else { box.y = line_bounds.y + line_bounds.height - (box.y - line_bounds.y) - box.height }
            }
            if horizontal && boxes[i].align == cast(AlignItems)AlignBaseline {
                ascent := boxes[i].baseline
                if ascent <= 0.0 { ascent = extent }
                box.y = line_bounds.y + span.baseline - ascent
            }
            boxes[i].bounds = box
        }
    }
    // Undo the order permutation: the caller reads its own item indices.
    for i: cast(s32)0..count - 1 {
        target := i
        while boxes[target].slot != i { target += 1 }
        if target != i {
            swap := boxes[i]
            boxes[i] = boxes[target]
            boxes[target] = swap
        }
    }
    return natural_cross + cast(float32)metrics.padding * 2.0
}

CenteredBands :: struct {
    leading: Rectangle
    center: Rectangle
    trailing: Rectangle
}

#program_export
LayoutCenteredBands :: (bounds: Rectangle, width: float32) -> CenteredBands {
    if width < 0.0 { width = 0.0 }
    if width > bounds.width { width = bounds.width }
    if width < 0.0 { width = 0.0 }
    side := (bounds.width - width) / 2.0
    if side < 0.0 { side = 0.0 }
    return .{.{bounds.x, bounds.y, side, bounds.height},
        .{bounds.x + side, bounds.y, width, bounds.height},
        .{bounds.x + side + width, bounds.y, side, bounds.height}}
}
