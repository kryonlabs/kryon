#module "kss_parser"
#import "style"
#import "style_sheet"
#import "control_props"

# Host-provided borrowed substring view; backends slice their native strings.

StringSlice :: (source: string, start: i32, length: i32) -> string #extern

# KSS is the text style format; this module is the one shared implementation.
# Backends lower it to C, Go, and JavaScript, so the grammar, environment
# axes, theme overlays, imports, and provenance rules exist exactly once.
# Hosts own I/O: they feed source text in and resolve import requests.

KssTokenKind :: enum {
    KssTokenColor = 0
    KssTokenLength = 1
    KssTokenDuration = 2
    KssTokenMaterial = 3
}

KssOriginKind :: enum {
    KssOriginPack = 0
    KssOriginImport = 1
    KssOriginTheme = 2
    KssOriginEnvironment = 3
    KssOriginVariant = 4
}

KssStatus :: enum {
    KssStatusContinue = 0
    KssStatusRule = 1
    KssStatusNeedImport = 2
    KssStatusDone = 3
    KssStatusError = 4
}

KssContrast :: enum {
    KssContrastNormal = 0
    KssContrastHigh = 1
}

KssDensity :: enum {
    KssDensityComfortable = 0
    KssDensityCompact = 1
    KssDensityTouch = 2
}

KssPointer :: enum {
    KssPointerMouse = 0
    KssPointerTouch = 1
    KssPointerMixed = 2
}

KssPlatform :: enum {
    KssPlatformDesktop = 0
    KssPlatformAndroid = 1
    KssPlatformWeb = 2
    KssPlatformPlan9 = 3
    KssPlatformTerminal = 4
}

KssTheme :: enum {
    KssThemeNone = 0
    KssThemeLight = 1
    KssThemeDark = 2
}


KssEnvironment :: struct {
    theme: i32
    contrast: i32
    density: i32
    pointer: i32
    platform: i32
}

KssDefaultEnvironment :: () -> KssEnvironment #export {
    env: KssEnvironment
    env.theme = (i32)KssThemeNone
    env.contrast = (i32)KssContrastNormal
    env.density = (i32)KssDensityComfortable
    env.pointer = (i32)KssPointerMouse
    env.platform = (i32)KssPlatformDesktop
    return env
}

KssCursor :: struct {
    source: string
    pos: i32
    line: i32
    column: i32
    file: i32
}

KssName :: struct {
    bytes: [64]u8
    length: i32
}

KssSourceFile :: struct {
    name: [96]u8
    length: i32
}

KssToken :: struct {
    name: KssName
    kind: i32
    color: u32
    number: f32
    material: i32
    origin: i32
    file: i32
    line: i32
    column: i32
}

KssColorOverride :: struct {
    name: string
    color: u32
}

KssOrigin :: struct {
    file: i32
    line: i32
    column: i32
}

# Source spans let hosts map typed rules back to their original text (the web
# CSS layer builds selectors and declarations from these byte ranges).

KssRuleSpan :: struct {
    file: i32
    selector_start: i32
    selector_length: i32
    body_start: i32
    body_length: i32
    group: i32
}

# Declarative hosts (the web CSS mapping) consume raw declaration text and
# foreign blocks instead of the closed property vocabulary. Structure lexing
# stays here; only value interpretation lives in the host. Entries are spans
# into the owning rule's source unit.

KssDeclaration :: struct {
    rule: i32
    name_start: i32
    name_length: i32
    value_start: i32
    value_length: i32
}

KssForeignBlock :: struct {
    name: KssName
    query_start: i32
    query_length: i32
    body_start: i32
    body_length: i32
    file: i32
}

KssImportFrame :: struct {
    name: KssName
    outer_source: string
    outer_pos: i32
    outer_line: i32
    outer_column: i32
    outer_file: i32
}

KssParser :: struct {
    cursor: KssCursor
    files: [8]KssSourceFile
    file_count: i32
    imports: [8]KssImportFrame
    import_depth: i32
    tokens: [128]KssToken
    token_count: i32
    overrides: [16]KssColorOverride
    override_count: i32
    layer: i32
    layer_names: [12]KssName
    layer_count: i32
    layer_declared: bool
    pack: KssName
    env: KssEnvironment
    themes: [16]KssName
    theme_count: i32
    version_seen: bool
    status: i32
    rule: StyleRule
    origin: KssOrigin
    rule_span: KssRuleSpan
    pending_import: KssName
    in_env: bool
    resume_group: i32
    declarative: bool
    declarations: [1024]KssDeclaration
    declaration_count: i32
    foreign: [16]KssForeignBlock
    foreign_count: i32
    diagnostic: [256]u8
    diagnostic_length: i32
    rule_total: i32
}

KssBegin :: (source: string, path: string, env: KssEnvironment) -> KssParser #export {
    p: KssParser
    p.cursor.source = source
    p.cursor.pos = 0
    p.cursor.line = 1
    p.cursor.column = 1
    p.cursor.file = 0
    p.files[0] = KssCopyFileName(path)
    p.file_count = 1
    p.import_depth = 0
    p.token_count = 0
    p.override_count = 0
    p.layer = 0
    p.layer_count = 4
    p.layer_names[0] = KssMakeName("reset")
    p.layer_names[1] = KssMakeName("components")
    p.layer_names[2] = KssMakeName("app")
    p.layer_names[3] = KssMakeName("overrides")
    p.layer_declared = false
    p.env = env
    p.theme_count = 0
    p.version_seen = false
    p.status = KssStatusContinue
    p.rule_total = 0
    p.declarative = false
    p.declaration_count = 0
    p.foreign_count = 0
    p.resume_group = -1
    p.diagnostic_length = 0
    return p
}

# Declarative hosts consume raw declarations and foreign blocks instead of the
# closed property vocabulary; grammar and structure stay identical.

KssBeginDeclarative :: (source: string, path: string, env: KssEnvironment) -> KssParser #export {
    p: KssParser = KssBegin(source, path, env)
    p.declarative = true
    return p
}

KssAddColorOverride :: (p: KssParser, name: string, color: u32) -> KssParser #export {
    if p.override_count < 16 {
        p.overrides[p.override_count].name = name
        p.overrides[p.override_count].color = color
        p.override_count = p.override_count + 1
    }
    return p
}

# Byte helpers over the borrowed source view. Every advance keeps the
# line/column provenance current so diagnostics and rule origins stay exact.

KssAtEnd :: (c: KssCursor) -> bool {
    return c.pos >= c.source.length
}

KssPeek :: (c: KssCursor, ahead: i32) -> u8 {
    index: i32 = c.pos + ahead
    if index < 0 || index >= c.source.length {
        return 0
    }
    return c.source[index]
}

KssAdvance :: (c: KssCursor, count: i32) -> KssCursor {
    step: i32 = 0
    while step < count {
        if c.pos < c.source.length {
            if c.source[c.pos] == 10 {
                c.line = c.line + 1
                c.column = 1
            } else {
                c.column = c.column + 1
            }
            c.pos = c.pos + 1
        }
        step = step + 1
    }
    return c
}

KssIsSpace :: (byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 13 || byte == 10 || byte == 11 || byte == 12
}

KssIsDigit :: (byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

KssIsHexDigit :: (byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102) ||
        (byte >= 65 && byte <= 70)
}

KssIsAlpha :: (byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

KssIdentStart :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || byte == 95 || byte == 45
}

KssIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45 ||
        byte == 46
}

KssSelectorIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45
}

KssLower :: (byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 {
        return byte + 32
    }
    return byte
}

KssNameEquals :: (name: KssName, text: string) -> bool {
    if name.length != text.length {
        return false
    }
    index: i32 = 0
    while index < name.length {
        if KssLower(name.bytes[index]) != KssLower(text[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssNameEqualsName :: (a: KssName, b: KssName) -> bool {
    if a.length != b.length {
        return false
    }
    index: i32 = 0
    while index < a.length {
        if KssLower(a.bytes[index]) != KssLower(b.bytes[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssMakeName :: (text: string) -> KssName {
    name: KssName
    index: i32 = 0
    while index < text.length && index < 64 {
        name.bytes[index] = text[index]
        index = index + 1
    }
    name.length = index
    return name
}

KssCopyFileName :: (text: string) -> KssSourceFile {
    file: KssSourceFile
    index: i32 = 0
    while index < text.length && index < 96 {
        file.name[index] = text[index]
        index = index + 1
    }
    file.length = index
    return file
}

KssNameAppend :: (destination: KssName, byte: u8) -> KssName {
    if destination.length < 64 {
        destination.bytes[destination.length] = byte
        destination.length = destination.length + 1
    }
    return destination
}

# Skip whitespace and // plus /* */ comments, keeping provenance current.

KssSkipSpace :: (c: KssCursor) -> KssCursor {
    while !KssAtEnd(c) {
        byte: u8 = c.source[c.pos]
        if KssIsSpace(byte) {
            c = KssAdvance(c, 1)
            continue
        }
        if byte == 47 && KssPeek(c, 1) == 47 {
            while !KssAtEnd(c) && c.source[c.pos] != 10 {
                c = KssAdvance(c, 1)
            }
            continue
        }
        if byte == 47 && KssPeek(c, 1) == 42 {
            c = KssAdvance(c, 2)
            while !KssAtEnd(c) {
                if c.source[c.pos] == 42 && KssPeek(c, 1) == 47 {
                    c = KssAdvance(c, 2)
                    break
                }
                c = KssAdvance(c, 1)
            }
            continue
        }
        break
    }
    return c
}

KssNameResult :: struct {
    parser: KssCursor
    name: KssName
    ok: bool
}

KssExpectResult :: struct {
    parser: KssCursor
    ok: bool
}

KssNumberResult :: struct {
    parser: KssCursor
    value: f32
    ok: bool
}

KssColorResult :: struct {
    parser: KssCursor
    value: u32
    ok: bool
}

KssReadName :: (c: KssCursor) -> KssNameResult {
    result: KssNameResult
    c = KssSkipSpace(c)
    if KssAtEnd(c) || !KssIdentStart(c.source[c.pos]) {
        result.parser = c
        result.ok = false
        return result
    }
    while !KssAtEnd(c) && KssIdentChar(c.source[c.pos]) {
        result.name = KssNameAppend(result.name, c.source[c.pos])
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = result.name.length > 0
    return result
}

KssReadSelectorName :: (c: KssCursor) -> KssNameResult {
    result: KssNameResult
    c = KssSkipSpace(c)
    if !KssAtEnd(c) && c.source[c.pos] == 42 {
        result.name = KssNameAppend(result.name, 42)
        c = KssAdvance(c, 1)
        result.parser = c
        result.ok = true
        return result
    }
    if KssAtEnd(c) || !KssIdentStart(c.source[c.pos]) {
        result.parser = c
        result.ok = false
        return result
    }
    while !KssAtEnd(c) && KssSelectorIdentChar(c.source[c.pos]) {
        result.name = KssNameAppend(result.name, c.source[c.pos])
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = result.name.length > 0
    return result
}

KssExpect :: (c: KssCursor, byte: u8) -> KssExpectResult {
    result: KssExpectResult
    c = KssSkipSpace(c)
    if KssAtEnd(c) || c.source[c.pos] != byte {
        result.parser = c
        result.ok = false
        return result
    }
    c = KssAdvance(c, 1)
    result.parser = c
    result.ok = true
    return result
}

# Diagnostics carry the message plus the exact file, line, and column.

KssDiagnosticAppend :: (p: KssParser, text: string) -> KssParser {
    index: i32 = 0
    while index < text.length && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = text[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendName :: (p: KssParser, name: KssName) -> KssParser {
    index: i32 = 0
    while index < name.length && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = name.bytes[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendInt :: (p: KssParser, value: i32) -> KssParser {
    remaining: i32 = value
    digits: i32 = 1
    if remaining < 0 {
        p = KssDiagnosticAppend(p, "-")
        remaining = -remaining
    }
    probe: i32 = 10
    while probe <= remaining && digits < 10 {
        probe = probe * 10
        digits = digits + 1
    }
    while digits > 0 {
        power: i32 = 1
        step: i32 = 1
        while step < digits {
            power = power * 10
            step = step + 1
        }
        digit: i32 = 0
        while remaining >= power {
            remaining = remaining - power
            digit = digit + 1
        }
        if p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = (u8)(48 + digit)
            p.diagnostic_length = p.diagnostic_length + 1
        }
        digits = digits - 1
    }
    return p
}

KssDiagnosticAt :: (p: KssParser) -> KssParser {
    p = KssDiagnosticAppend(p, " at ")
    if p.cursor.file >= 0 && p.cursor.file < p.file_count && p.files[p.cursor.file].length > 0 {
        index: i32 = 0
        while index < p.files[p.cursor.file].length && p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = p.files[p.cursor.file].name[index]
            p.diagnostic_length = p.diagnostic_length + 1
            index = index + 1
        }
        p = KssDiagnosticAppend(p, ":")
    }
    p = KssDiagnosticAppendInt(p, p.cursor.line)
    p = KssDiagnosticAppend(p, ":")
    p = KssDiagnosticAppendInt(p, p.cursor.column)
    return p
}

KssFail :: (p: KssParser, message: string) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAt(p)
    p.status = (i32)KssStatusError
    return p
}

KssFailName :: (p: KssParser, message: string, name: KssName) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAppendName(p, name)
    p = KssDiagnosticAt(p)
    p.status = (i32)KssStatusError
    return p
}

KssReadHexColor :: (c: KssCursor) -> KssColorResult {
    result: KssColorResult
    value: u32 = 0
    digits: i32 = 0
    c = KssSkipSpace(c)
    if KssAtEnd(c) || c.source[c.pos] != 35 {
        result.parser = c
        return result
    }
    c = KssAdvance(c, 1)
    while !KssAtEnd(c) && KssIsHexDigit(c.source[c.pos]) {
        byte: u8 = c.source[c.pos]
        digit: u32 = 0
        if byte >= 48 && byte <= 57 {
            digit = (u32)(byte - 48)
        } else if byte >= 97 && byte <= 102 {
            digit = (u32)(byte - 87)
        } else {
            digit = (u32)(byte - 55)
        }
        value = (value << (u32)4) | digit
        digits = digits + 1
        c = KssAdvance(c, 1)
    }
    if digits == 6 {
        value = (value << (u32)8) | (u32)255
    } else if digits != 8 {
        result.parser = c
        return result
    }
    result.parser = c
    result.value = value
    result.ok = true
    return result
}

KssReadNumber :: (c: KssCursor) -> KssNumberResult {
    result: KssNumberResult
    negative: bool = false
    whole: u32 = 0
    fraction: u32 = 0
    fraction_digits: i32 = 0
    exponent: i32 = 0
    exponent_negative: bool = false
    seen_digits: bool = false
    power: f64 = 1.0
    value64: f64 = 0.0
    c = KssSkipSpace(c)
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    if c.source[c.pos] == 45 {
        negative = true
        c = KssAdvance(c, 1)
    } else if c.source[c.pos] == 43 {
        c = KssAdvance(c, 1)
    }
    while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
        whole = whole * 10 + (u32)(c.source[c.pos] - 48)
        seen_digits = true
        c = KssAdvance(c, 1)
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 && !seen_digits {
        result.parser = c
        return result
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            if fraction_digits < 9 {
                fraction = fraction * 10 + (u32)(c.source[c.pos] - 48)
                fraction_digits = fraction_digits + 1
            }
            seen_digits = true
            c = KssAdvance(c, 1)
        }
    }
    if !seen_digits {
        result.parser = c
        return result
    }
    if !KssAtEnd(c) && (c.source[c.pos] == 101 || c.source[c.pos] == 69) {
        c = KssAdvance(c, 1)
        if !KssAtEnd(c) && c.source[c.pos] == 45 {
            exponent_negative = true
            c = KssAdvance(c, 1)
        } else if !KssAtEnd(c) && c.source[c.pos] == 43 {
            c = KssAdvance(c, 1)
        }
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            exponent = exponent * 10 + (i32)(c.source[c.pos] - 48)
            c = KssAdvance(c, 1)
        }
    }
    step: i32 = 0
    while step < fraction_digits {
        power = power * 10.0
        step = step + 1
    }
    value64 = (f64)whole + (f64)fraction / power
    step = 0
    while step < exponent {
        if exponent_negative {
            value64 = value64 / 10.0
        } else {
            value64 = value64 * 10.0
        }
        step = step + 1
    }
    if negative {
        value64 = -value64
    }
    result.parser = c
    result.value = (f32)value64
    result.ok = true
    return result
}

# Durations convert to milliseconds with exact decimal shifting so '0.14s'
# yields exactly 140 instead of a float rounding artifact.

KssReadDuration :: (c: KssCursor) -> KssNumberResult {
    result: KssNumberResult
    negative: bool = false
    whole: u32 = 0
    fraction: u32 = 0
    fraction_digits: i32 = 0
    seen_digits: bool = false
    seconds: bool = false
    c = KssSkipSpace(c)
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    if c.source[c.pos] == 45 {
        negative = true
        c = KssAdvance(c, 1)
    } else if c.source[c.pos] == 43 {
        c = KssAdvance(c, 1)
    }
    while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
        whole = whole * 10 + (u32)(c.source[c.pos] - 48)
        seen_digits = true
        c = KssAdvance(c, 1)
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            if fraction_digits < 9 {
                fraction = fraction * 10 + (u32)(c.source[c.pos] - 48)
                fraction_digits = fraction_digits + 1
            }
            seen_digits = true
            c = KssAdvance(c, 1)
        }
    }
    if !seen_digits {
        result.parser = c
        return result
    }
    unit: KssNameResult = KssReadName(c)
    if unit.ok && KssNameEquals(unit.name, "ms") {
        seconds = false
    } else if unit.ok && KssNameEquals(unit.name, "s") {
        seconds = true
    } else if unit.ok {
        result.parser = unit.parser
        return result
    } else {
        result.parser = c
        return result
    }

    value: f64 = 0.0
    scaled: u32 = whole
    shift: i32 = fraction_digits
    while shift > 0 {
        scaled = scaled * 10
        shift = shift - 1
    }
    scaled = scaled + fraction
    if seconds {
        value = (f64)scaled
        step: i32 = 0
        while step < 3 - fraction_digits {
            value = value * 10.0
            step = step + 1
        }
        step = 0
        while step < fraction_digits - 3 {
            value = value / 10.0
            step = step + 1
        }
    } else {
        value = (f64)scaled
        step: i32 = 0
        while step < fraction_digits {
            value = value / 10.0
            step = step + 1
        }
    }
    if negative {
        value = -value
    }
    result.parser = unit.parser
    result.value = (f32)value
    result.ok = true
    return result
}

# Token table. Later entries shadow earlier ones; overlays update in place so
# provenance always reflects the winning value. Variant color overrides are
# applied on add, matching the highest precedence layer.

KssFindToken :: (p: KssParser, name: KssName, kind: i32) -> i32 {
    index: i32 = p.token_count - 1
    while index >= 0 {
        if p.tokens[index].kind == kind && KssNameEqualsName(p.tokens[index].name, name) {
            return index
        }
        index = index - 1
    }
    return -1
}

KssApplyOverride :: (p: KssParser, index: i32) -> KssParser {
    override: i32 = 0
    while override < p.override_count {
        if p.tokens[index].kind == (i32)KssTokenColor &&
           p.overrides[override].name.length == p.tokens[index].name.length {
            same: bool = true
            byte_index: i32 = 0
            while byte_index < p.tokens[index].name.length {
                if KssLower((u8)p.overrides[override].name[byte_index]) !=
                   KssLower(p.tokens[index].name.bytes[byte_index]) {
                    same = false
                }
                byte_index = byte_index + 1
            }
            if same {
                p.tokens[index].color = p.overrides[override].color
                p.tokens[index].origin = (i32)KssOriginVariant
                return p
            }
        }
        override = override + 1
    }
    return p
}

KssAddToken :: (p: KssParser, token: KssToken) -> KssParser {
    if p.token_count >= 128 {
        return KssFail(p, "style token capacity exceeded")
    }
    p.tokens[p.token_count] = token
    p.token_count = p.token_count + 1
    p = KssApplyOverride(p, p.token_count - 1)
    return p
}

# Update an existing token in place: theme overlays and matching environment
# overlays win over base and imported values but keep a single entry.

KssOverlayToken :: (p: KssParser, name: KssName, kind: i32, color: u32,
    number: f32, material: i32, origin: i32) -> KssParser {
    index: i32 = KssFindToken(p, name, kind)
    if index < 0 {
        return KssFailName(p, "unknown overlay token '", name)
    }
    if kind == (i32)KssTokenColor {
        p.tokens[index].color = color
    } else if kind == (i32)KssTokenMaterial {
        p.tokens[index].material = material
    } else {
        p.tokens[index].number = number
    }
    p.tokens[index].origin = origin
    p.tokens[index].file = p.cursor.file
    p.tokens[index].line = p.cursor.line
    p.tokens[index].column = p.cursor.column
    p = KssApplyOverride(p, index)
    return p
}

KssFindColorToken :: (p: KssParser, name: KssName) -> i32 {
    return KssFindToken(p, name, (i32)KssTokenColor)
}

KssFindNumberToken :: (p: KssParser, name: KssName) -> i32 {
    index: i32 = KssFindToken(p, name, (i32)KssTokenDuration)
    if index >= 0 {
        return index
    }
    return KssFindToken(p, name, (i32)KssTokenLength)
}

KssFindMaterialToken :: (p: KssParser, name: KssName) -> i32 {
    return KssFindToken(p, name, (i32)KssTokenMaterial)
}

KssMaterialValue :: (name: KssName) -> i32 {
    if KssNameEquals(name, "lightfield") {
        return (i32)MaterialLightfield
    }
    if KssNameEquals(name, "flat") {
        return (i32)MaterialFlat
    }
    if KssNameEquals(name, "glass") {
        return (i32)MaterialGlass
    }
    return -999999
}

# Stable class ids match StyleClassId in the C and Go pack registries.

KssClassId :: (name: KssName) -> i32 {
    hash: u32 = 2166136261
    if name.length == 0 {
        return 0
    }
    index: i32 = 0
    while index < name.length {
        hash = hash ^ (u32)name.bytes[index]
        hash = hash * (u32)16777619
        index = index + 1
    }
    hash = hash & (u32)2147483647
    if hash == 0 {
        return 1
    }
    return (i32)hash
}

