#import "geometry"
InspectReleaseDecision :: struct {
    end_edit: bool
    consume_release: bool
}
#program_export
InspectReleaseDecisionFor :: (released: bool, dragging: bool,
    resizing: bool) -> InspectReleaseDecision {
    decision: InspectReleaseDecision
    decision.end_edit = released && (dragging || resizing)
    decision.consume_release = decision.end_edit
    return decision
}
