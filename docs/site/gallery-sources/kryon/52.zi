using UI :: #import "kryon/Widgets";
#import "kryon/system_theme"
#import "std/number_text"
using Example :: #import "scenes";
#import "palette"
#import "preview_protocol"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = "DiscreteSlider", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 52
    scene_image = "catalog-image.png"
    input := Prepare(session, scene)
    field_input := input.field
    area_input := input.area
    discrete = DiscreteSlider(session, DiscreteSliderProps.{.bounds = .{24.0, 64.0, 432.0, 80.0}, .label = "Step size", .value = discrete, .min = 1, .max = 10, .disabled = disabled}).value
    digits: [16]u8
    Label(session, FormatInteger(cast(s64)discrete, digits[:]), 180.0)

    return 0
}
