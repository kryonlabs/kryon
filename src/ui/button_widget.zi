#module "button_widget"
#import "button"
#import "button_props"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "image"
#import "image_props"
#import "image_widget"
#import "paint_queue"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

ButtonDefaultFace :: (props: ButtonProps, state: i32) -> StyleData #export {
    face: StyleData
    face.fields = (u32)StyleBackground | (u32)StyleForeground |
        (u32)StyleBorder | (u32)StyleRadius |
        (u32)StyleBorderWidth | (u32)StyleOpacity |
        (u32)StylePaddingX | (u32)StylePaddingY |
        (u32)StyleFontSize | (u32)StyleIconSize | (u32)StyleGap
    face.background = (u32)0xe5e7ebff
    face.foreground = (u32)0x111827ff
    face.border = (u32)0x00000000
    if props.tone == (ButtonTone)ButtonToneAccent {
        face.background = (u32)0x2563ebff
        face.foreground = (u32)0xffffffff
    } else if props.tone == (ButtonTone)ButtonToneDanger {
        face.background = (u32)0xdc2626ff
        face.foreground = (u32)0xffffffff
    } else if props.tone == (ButtonTone)ButtonToneSuccess {
        face.background = (u32)0x15803dff
        face.foreground = (u32)0xffffffff
    } else if props.tone == (ButtonTone)ButtonToneWarning {
        face.background = (u32)0xf59e0bff
    }
    if props.emphasis == (ButtonEmphasis)ButtonEmphasisSoft {
        face.foreground = face.background
        face.background = Opacity(face.background, 0.16)
    } else if props.emphasis == (ButtonEmphasis)ButtonEmphasisOutline {
        face.foreground = face.background
        face.border = face.background
        face.background = (u32)0x00000000
        face.border_width = 1.0
    } else if props.emphasis == (ButtonEmphasis)ButtonEmphasisGhost ||
        props.emphasis == (ButtonEmphasis)ButtonEmphasisLink {
        face.foreground = face.background
        face.background = (u32)0x00000000
    }
    if state == ButtonStateHover {
        face.background = GradientColor(face.background,
            (u32)0xffffffff, 0.08)
    } else if state == ButtonStatePressed ||
        state == ButtonStateSelected {
        face.background = GradientColor(face.background,
            (u32)0x000000ff, 0.12)
    } else if state == ButtonStateDisabled || state == ButtonStateLoading {
        face.background = Opacity(face.background, 0.45)
        face.foreground = Opacity(face.foreground, 0.45)
        face.border = Opacity(face.border, 0.45)
    }
    face.radius = 6.0
    face.opacity = 1.0
    face.padding_x = 12.0
    face.padding_y = 6.0
    face.font_size = 14.0
    face.icon_size = 18.0
    face.gap = 8.0
    return face
}

ButtonFaceFor :: (rules: StyleRules, props: ButtonProps,
    state: i32) -> StyleData #export {
    facts: StyleFacts = ButtonRoleFactsFor(StyleKindButton(), props.id,
        props.class_name, StyleAny(), (i32)props.tone,
        (i32)props.emphasis, (i32)props.size, state)
    return ResolveStyleRules(rules, ButtonDefaultFace(props, state),
        facts, state)
}

ButtonMinimumHeight :: (size: ControlSize) -> float #export {
    if size == (ControlSize)ControlSizeSmall { return 28.0 }
    if size == (ControlSize)ControlSizeLarge { return 44.0 }
    return 36.0
}

PaintButtonForNode :: (node: i32, props: ButtonProps, bounds: Rectangle,
    face: StyleData, font: i32, label_width: i32,
    label_height: i32) #export {
    if props.invisible { return }
    opacity: float = StyleOpacityValue(face.fields, face.opacity)
    radius: float = face.radius
    if props.pill || props.circle { radius = bounds.height * 0.5 }
    background: Color = ColorFromPacked(Opacity(face.background, opacity))
    if background.a > (u8)0 {
        PaintRoundedFill(node, bounds, radius, 12, background)
    }
    if face.border_width > 0.0 {
        border: Color = ColorFromPacked(Opacity(face.border, opacity))
        if border.a > (u8)0 {
            PaintRoundedOutline(node, bounds, radius, 12,
                face.border_width, border)
        }
    }
    has_image: bool = props.image.asset_path != "" ||
        props.image.texture.id != (u32)0
    content: ButtonContent = ContentLayout(bounds.width, bounds.height,
        (float)label_width, face.icon_size, face.gap, has_image,
        props.icon_only,
        (i32)props.icon_placement == IconPlacementTrailing,
        face.offset_x, face.offset_y)
    if has_image && content.icon_size > 0.0 {
        image: ImageProps = props.image
        image.bounds = (Rectangle){bounds.x + content.icon_x,
            bounds.y + content.icon_y, content.icon_size,
            content.icon_size}
        texture: Texture2D = ImageTextureFor(image)
        tint: Color = ColorFromPacked(Opacity((u32)0xffffffff, opacity))
        plan: ImageDrawPlan = ImageDrawPlanFor(image, texture, tint)
        if plan.draw && tint.a > (u8)0 {
            PaintImage(node, image.asset_path, image.texture.id,
                plan.source, plan.destination, bounds, image.origin,
                image.rotation, radius, plan.tint)
        }
    }
    if !props.icon_only && props.label != "" {
        x: i32 = (i32)(bounds.x + content.text_x)
        y: i32 = (i32)(bounds.y +
            (bounds.height - (float)label_height) * 0.5 +
            face.offset_y)
        PaintClippedLabel(node, props.label, x, y, font,
            ColorFromPacked(Opacity(face.foreground, opacity)), bounds)
    }
}

# A retained press is routed after the previous tree commits. The next
# submission consumes its activation and paints from the latest input state.
SubmitButton :: (props: ButtonProps, parent_index: i32,
    parent_key: u64) -> i32 #export {
    key: u64 = props.key
    if key == (u64)0 && props.id > 0 { key = (u64)(u32)props.id }
    if key == (u64)0 { key = TreeNextKey() }
    previous: i32 = -1
    if TreeIsBuilding() && key != (u64)0 {
        previous = TreeFind(key, parent_key, WidgetKindButton)
    }
    flags: StateFlags = ResolveFlags((i32)props.state,
        props.disabled, props.loading, props.selected)
    clicked: bool = TreeTakeActivationAt(previous)
    if flags.disabled || flags.loading { clicked = false }
    state: i32 = ResolveState((i32)props.state,
        flags.disabled, flags.loading, TreePressedAt(previous),
        TreeHoveredAt(previous), false, flags.selected)
    face: StyleData = ButtonFaceFor(ActiveStyleRules(), props, state)
    font: i32 = ResolveFont(0,
        StyleFontValue(face.fields, face.font_size), 14)
    label_width: i32 = 0
    label_height: i32 = 0
    if props.label != "" && !props.icon_only {
        label_width = GlyphWidth(props.label, font, face.typeface)
        label_height = GlyphLineHeight(font, face.typeface)
    }
    available_width: float = 0.0
    if TreeIsBuilding() {
        root: Rectangle = TreeRootBounds()
        available_width = root.x + root.width - props.bounds.x
    }
    bounds: Rectangle = MeasureBounds(props, face,
        ButtonMinimumHeight(props.size), font, (float)label_width,
        available_width, 1.0, false)
    node: i32 = -1
    if TreeIsBuilding() {
        node = TreeSubmit(key, parent_index, WidgetKindButton, bounds)
        if node < 0 { return 0 }
        TreeSetInteractive(node, flags.disabled, flags.loading, props.id)
        TreeSetSelected(node, flags.selected)
        TreeSetLabel(node, props.label)
    }
    PaintButtonForNode(node, props, bounds, face, font,
        label_width, label_height)
    if clicked { return 1 }
    return 0
}

Button :: (props: ButtonProps) -> i32 #export {
    return SubmitButton(props, TreeCurrentParent(), TreeCurrentParentKey())
}
