#import "list_box_multi"

// Laws for rows of a multiple-selection list box. Each states the expected
// behavior independently of the implementation; `ziran check` proves it
// over every listed input. An implementation edit may not change this file.

// A row toggles only when released over while enabled, and toggling takes
// the release.
#law RowToggles forall hot: 0..1, disabled: 0..1, released: 0..1 => ListBoxMultiRowDecisionFor(hot != 0, disabled != 0, released != 0).activate == (hot != 0 && disabled == 0 && released != 0);
#law ToggleTakesRelease forall hot: 0..1, disabled: 0..1, released: 0..1 => ListBoxMultiRowDecisionFor(hot != 0, disabled != 0, released != 0).consume_release == ListBoxMultiRowDecisionFor(hot != 0, disabled != 0, released != 0).activate;
