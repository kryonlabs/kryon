#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style"
#import "toolbar_props"

ToolbarSpec :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
    action_count: s32
    action_icon_size: s32
    action_icon_padding: s32
    action_gap: s32
    side_padding: s32
    action_fields: u32
    bar_fields: u32
    dropdown_min_width: s32
    dropdown_max_width: s32
    dropdown_height: s32
    scale: float32
    bar: StyleFrame
    action: StyleFrame
}

ToolbarLayout :: struct {
    bounds: Rectangle
    dropdown_bounds: Rectangle
    controls_x: s32
    action_width: s32
    action_y: s32
    action_icon_size: s32
    action_icon_padding: s32
    action_gap: s32
    side_padding: s32
}

ToolbarDividerLine :: struct {
    x1: s32
    y1: s32
    x2: s32
    y2: s32
}

ToolbarMetric :: (fields: u32, field: u32, value: s32, fallback: float32,
    scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) != cast(u32)0 && value >= 0 { return value }
    return cast(s32)(fallback * scale)
}

ToolbarPropMetric :: (value: s32, fallback: float32, scale: float32) -> s32 {
    if value > 0 { return value }
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(fallback * scale)
}

ToolbarStyleMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
ToolbarBarRole :: () -> s32 {
    return 1
}

#program_export
ToolbarDividerRole :: () -> s32 {
    return 18
}

#program_export
ToolbarActionRole :: () -> s32 {
    return 17
}

#program_export
ToolbarBottomBarRole :: () -> s32 {
    return 28
}

#program_export
ToolbarBottomActionRole :: () -> s32 {
    return 29
}

#program_export
ToolbarActionIdFor :: (toolbar_id: s32, index: s32) -> s32 {
    if toolbar_id <= 0 || index < 0 {
        return 0
    }
    return toolbar_id * 100 + index + 1
}

#program_export
ToolbarDividerLineFor :: (x: s32, y: s32, width: s32, height: s32) -> ToolbarDividerLine {
    line: ToolbarDividerLine
    if width < 0 { width = 0 }
    line.x1 = x
    line.x2 = x + width
    line.y1 = y + height - 1
    line.y2 = line.y1
    return line
}

#program_export
ToolbarSidePadding :: (value: s32, fields: u32, scale: float32) -> s32 {
    if value < 0 { return 0 }
    return ToolbarMetric(fields, cast(u32)StylePaddingX, value, 12.0, scale)
}

ToolbarSpecMetric :: (value: s32, fields: u32, field: u32,
    frame: StyleFrame, frame_value: float32, fallback: float32,
    scale: float32) -> s32 {
    if (fields & field) != cast(u32)0 && value >= 0 {
        return value
    }
    return ToolbarStyleMetric(frame.value.fields, field, frame_value,
        fallback, scale, true)
}

#program_export
ToolbarLayoutFor :: (spec: ToolbarSpec) -> ToolbarLayout {
    layout: ToolbarLayout
    scale: float32 = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    width: s32 = spec.width
    if width < 0 { width = 0 }
    height: s32 = spec.height
    if height < 0 { height = 0 }
    action_count: s32 = spec.action_count
    if action_count < 0 { action_count = 0 }

    layout.bounds.x = cast(float32)spec.x
    layout.bounds.y = cast(float32)spec.y
    layout.bounds.width = cast(float32)width
    layout.bounds.height = cast(float32)height
    layout.side_padding = ToolbarSpecMetric(spec.side_padding,
        spec.bar_fields, cast(u32)StylePaddingX, spec.bar,
        spec.bar.value.padding_x, 12.0, scale)
    layout.action_icon_size = ToolbarSpecMetric(spec.action_icon_size,
        spec.action_fields, cast(u32)StyleIconSize, spec.action,
        spec.action.value.icon_size, 20.0, scale)
    layout.action_icon_padding = ToolbarSpecMetric(spec.action_icon_padding,
        spec.action_fields, cast(u32)StylePaddingX, spec.action,
        spec.action.value.padding_x, 8.0, scale)
    layout.action_gap = ToolbarSpecMetric(spec.action_gap,
        spec.action_fields, cast(u32)StyleGap, spec.action,
        spec.action.value.gap, 6.0, scale)
    layout.action_width = layout.action_icon_size + layout.action_icon_padding * 2
    layout.action_y = spec.y + (height - layout.action_width) / 2
    layout.controls_x = spec.x + width - layout.side_padding

    controls_after_actions: s32 = layout.controls_x
    if action_count > 0 {
        controls_after_actions -= action_count * (layout.action_width + layout.action_gap)
    }
    dropdown_width: s32 = controls_after_actions - spec.x
    if action_count > 0 {
        dropdown_width -= layout.side_padding - layout.action_gap
    }
    available_width: s32 = dropdown_width
    if spec.dropdown_min_width > 0 && dropdown_width < spec.dropdown_min_width {
        dropdown_width = spec.dropdown_min_width
    }
    if spec.dropdown_max_width > 0 && dropdown_width > spec.dropdown_max_width {
        dropdown_width = spec.dropdown_max_width
    }
    if available_width > 0 && dropdown_width > available_width {
        dropdown_width = available_width
    }
    if dropdown_width < 0 { dropdown_width = 0 }

    layout.dropdown_bounds.x = cast(float32)spec.x
    layout.dropdown_bounds.y = cast(float32)spec.y
    layout.dropdown_bounds.width = cast(float32)dropdown_width
    layout.dropdown_bounds.height = cast(float32)ToolbarPropMetric(spec.dropdown_height, 36.0, scale)
    return layout
}

#program_export
ToolbarActionBoundsFor :: (layout: ToolbarLayout, index: s32,
    action_count: s32) -> Rectangle {
    bounds: Rectangle
    if action_count <= 0 { return bounds }
    if index < 0 { index = 0 }
    if index >= action_count { index = action_count - 1 }
    from_right: s32 = action_count - 1 - index
    bounds.x = cast(float32)(layout.controls_x - layout.action_width -
        from_right * (layout.action_width + layout.action_gap))
    bounds.y = cast(float32)layout.action_y
    bounds.width = cast(float32)layout.action_width
    bounds.height = cast(float32)layout.action_width
    return bounds
}

#program_export
ToolbarActionStyleIconSize :: (icon_size: s32, scale: float32) -> float32 {
    if icon_size < 0 { icon_size = 0 }
    if scale <= 0.0 { scale = 1.0 }
    return cast(float32)icon_size / scale
}

BottomIconRowLayout :: struct {
    y: s32
    button_width: s32
    icon_size: s32
    icon_padding: s32
    gap: s32
    start_x: s32
    count: s32
}

#program_export
BottomIconRowLayoutFor :: (row: BottomIconRowProps, scale: float32) -> BottomIconRowLayout {
    bar: StyleFrame
    action: StyleFrame
    return BottomIconRowLayoutForStyle(row, scale, bar, action)
}

#program_export
BottomIconRowLayoutForStyle :: (row: BottomIconRowProps, scale: float32,
    bar: StyleFrame, action: StyleFrame) -> BottomIconRowLayout {
    layout: BottomIconRowLayout
    if scale <= 0.0 { scale = 1.0 }

    count: s32 = row.count
    if count < 0 { count = 0 }
    icon_size: s32 = ToolbarStyleMetric(action.value.fields,
        cast(u32)StyleIconSize, action.value.icon_size, 24.0, scale, true)
    icon_padding: s32 = ToolbarStyleMetric(action.value.fields,
        cast(u32)StylePaddingX, action.value.padding_x, 10.0, scale, true)
    gap: s32 = ToolbarStyleMetric(action.value.fields,
        cast(u32)StyleGap, action.value.gap, 12.0, scale, true)
    side_margin: s32 = ToolbarStyleMetric(bar.value.fields,
        cast(u32)StylePaddingX, bar.value.padding_x, 24.0, scale, true)
    bottom_margin: s32 = ToolbarStyleMetric(bar.value.fields,
        cast(u32)StylePaddingY, bar.value.padding_y, 6.0, scale, true)
    min_icon_size: s32 = ToolbarStyleMetric(action.value.fields,
        cast(u32)StyleContentOffset, action.value.offset_x, 16.0, scale, true)
    min_icon_padding: s32 = ToolbarStyleMetric(action.value.fields,
        cast(u32)StyleContentOffset, action.value.offset_y, 6.0, scale, true)
    min_gap: s32 = ToolbarStyleMetric(bar.value.fields,
        cast(u32)StyleGap, bar.value.gap, 8.0, scale, true)
    available_w: s32 = row.view_width - side_margin * 2
    min_available: s32 = ToolbarStyleMetric(bar.value.fields,
        cast(u32)StyleContentOffset, bar.value.offset_x, 120.0, scale, false)
    if available_w < min_available { available_w = min_available }

    max_btn_w: s32 = available_w
    if count > 1 {
        fit_btn_w: s32 = (available_w - gap * (count - 1)) / count
        if max_btn_w <= 0 || max_btn_w > fit_btn_w {
            max_btn_w = fit_btn_w
        }
    }

    button_w: s32 = icon_size + icon_padding * 2
    if button_w > max_btn_w {
        button_w = max_btn_w
        icon_padding = button_w / 4
        icon_size = button_w - icon_padding * 2
    }

    if icon_padding < min_icon_padding { icon_padding = min_icon_padding }
    if icon_size < min_icon_size { icon_size = min_icon_size }

    button_w = icon_size + icon_padding * 2
    gap = button_w / 4
    if gap < min_gap { gap = min_gap }

    row_w: s32 = button_w * count
    if count > 1 { row_w += gap * (count - 1) }
    layout.y = row.view_height - bottom_margin - button_w
    layout.button_width = button_w
    layout.icon_size = icon_size
    layout.icon_padding = icon_padding
    layout.gap = gap
    layout.start_x = row.center_x - row_w / 2
    layout.count = count
    return layout
}

#program_export
BottomIconRowButtonBoundsFor :: (layout: BottomIconRowLayout,
    index: s32) -> Rectangle {
    bounds: Rectangle
    if layout.count <= 0 { return bounds }
    if index < 0 { index = 0 }
    if index >= layout.count { index = layout.count - 1 }
    bounds.x = cast(float32)(layout.start_x +
        index * (layout.button_width + layout.gap))
    bounds.y = cast(float32)layout.y
    bounds.width = cast(float32)layout.button_width
    bounds.height = cast(float32)layout.button_width
    return bounds
}

IconSliderPopupLayout :: struct {
    button_bounds: Rectangle
    popup_bounds: Rectangle
    slider_x: s32
    slider_y: s32
    slider_height: s32
    icon_size: s32
}

IconSliderPopupCloseDecision :: struct {
    close: bool
}

IconSliderPopupOpenResult :: struct {
    open: bool
    changed: bool
}

#program_export
IconSliderPopupLayoutFor :: (x: s32, y: s32, icon_size: s32,
    icon_padding: s32, popup_width: s32, popup_height: s32,
    scale: float32) -> IconSliderPopupLayout {
    layout: IconSliderPopupLayout
    if scale <= 0.0 { scale = 1.0 }
    if icon_size < 0 { icon_size = 0 }
    if icon_padding < 0 { icon_padding = 0 }

    button_w: s32 = icon_size + icon_padding * 2
    popup_w: s32 = popup_width
    if popup_w <= 0 { popup_w = button_w }
    if popup_w < button_w { popup_w = button_w }
    popup_h: s32 = popup_height
    if popup_h <= 0 { popup_h = cast(s32)(200.0 * scale) }

    layout.button_bounds.x = cast(float32)x
    layout.button_bounds.y = cast(float32)y
    layout.button_bounds.width = cast(float32)button_w
    layout.button_bounds.height = cast(float32)button_w
    layout.popup_bounds.x = cast(float32)(x + button_w / 2 - popup_w / 2)
    layout.popup_bounds.y = cast(float32)(y + button_w + cast(s32)(4.0 * scale))
    layout.popup_bounds.width = cast(float32)popup_w
    layout.popup_bounds.height = cast(float32)popup_h
    layout.slider_x = cast(s32)layout.popup_bounds.x + popup_w / 2
    layout.slider_y = cast(s32)layout.popup_bounds.y + cast(s32)(14.0 * scale)
    layout.slider_height = popup_h - cast(s32)(24.0 * scale)
    if layout.slider_height < 0 { layout.slider_height = 0 }
    layout.icon_size = icon_size
    return layout
}

#program_export
IconSliderPopupCloseDecisionFor :: (icon_clicked: bool, released: bool,
    pointer_inside_popup: bool) -> IconSliderPopupCloseDecision {
    decision: IconSliderPopupCloseDecision
    decision.close = !icon_clicked && released && !pointer_inside_popup
    return decision
}

#program_export
IconSliderPopupOpenFor :: (open: bool, icon_clicked: bool,
    close_requested: bool, has_open: bool) -> IconSliderPopupOpenResult {
    result: IconSliderPopupOpenResult
    result.open = open
    result.changed = false
    if !has_open {
        return result
    }
    if icon_clicked {
        result.open = !open
    }
    if close_requested {
        result.open = false
    }
    result.changed = result.open != open
    return result
}
