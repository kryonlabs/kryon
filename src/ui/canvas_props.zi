#import "canvas"
#import "geometry"

Canvas :: struct {
    bounds: Rectangle
    class_name: s32
    scroll_x: s32
    scroll_y: s32
    zoom: float32
}

CanvasResult :: struct {
    active: bool
    dragging: bool
    selected_index: s32
    world: Vector2
}

#program_export
CanvasHitTest :: (point: Vector2, items: []Rectangle) -> s32 {
    index: s32 = (cast(s32)items.count)
    while index > 0 {
        index -= 1
        if CanvasContains(items[index], point) { return index }
    }
    return -1
}

#program_export
CanvasToScreen :: (canvas: Canvas, point: Vector2) -> Vector2 {
    return CanvasPointToScreen(canvas.bounds, point, canvas.scroll_x,
        canvas.scroll_y, canvas.zoom)
}

#program_export
CanvasRectToScreen :: (canvas: Canvas, rect: Rectangle) -> Rectangle {
    return CanvasRectToScreenBounds(canvas.bounds, rect, canvas.scroll_x,
        canvas.scroll_y, canvas.zoom)
}
