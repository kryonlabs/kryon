#import "pixmap_font"
Mono :: #import "pixmap_mono_font";
#import "pixmap_emoji"
#import "utf8"

// Text for the pixmap host: Kryon's font, Liberation Sans, from its outlines.
// It is laid out as the desktop, raylib, and canvas hosts lay text out: a
// `font`-pixel line box runs from the top of the ascent to the bottom of the
// descent, the baseline sits at the ascent, and glyphs advance by their
// unhinted widths. Rasterizing uses only integer arithmetic -- positions in
// 1/256 pixel, coverage from sub-scanlines with exact horizontal spans -- so
// every Ziran target draws the same pixels.

PixmapTextLine :: PixmapFontAscent + PixmapFontDescent;
// Sub-scanlines per pixel row.
PixmapTextSamples :: 5;
// The largest glyph a mask holds, in pixels.
PixmapMaskSide :: 160;

PixmapGlyphMask :: struct {
    left: s32
    top: s32
    width: s32
    height: s32
}

// Coverage of the last rasterized glyph, 0 to 255, row by row.
pixmap_mask: [25600]u8;
pixmap_edge_x0: [4096]s64;
pixmap_edge_y0: [4096]s64;
pixmap_edge_x1: [4096]s64;
pixmap_edge_y1: [4096]s64;
pixmap_edge_count: s32;
pixmap_contour_x: [2048]s64;
pixmap_contour_y: [2048]s64;
pixmap_contour_on: [2048]bool;
pixmap_crossing_x: [1024]s64;
pixmap_crossing_turn: [1024]s32;
pixmap_row: [160]s64;

// Rasterized glyphs, keyed by glyph, size and the sub-pixel part of their
// origin. Whole pixels only move a mask, so a cached mask holds the bytes
// rasterizing again would make. A full cache starts over.
PixmapCacheSlots :: 16384;
PixmapCacheProbes :: 32;
PixmapCacheBytes :: 1048576;
// Key plus one; zero marks a free slot.
pixmap_cache_keys: [16384]s64;
// Mask position relative to the origin's whole pixel.
pixmap_cache_masks: [16384]PixmapGlyphMask;
// Where the mask's coverage starts; -1 when the glyph draws nothing.
pixmap_cache_starts: [16384]s32;
pixmap_cache_bytes: [1048576]u8;
pixmap_cache_used: s32;
pixmap_cache_count: s32;

// Division rounding toward negative infinity, for a positive divisor.
PixmapFloorDiv :: (value: s64, divisor: s64) -> s64 {
    if value >= 0 { return value / divisor }
    return -((-value + divisor - 1) / divisor)
}

// Font units to 1/256 pixel at a font size.
PixmapUnits :: (units: s64, font: s32, line: s32 = PixmapTextLine) -> s64 {
    return PixmapFloorDiv(units * cast(s64)font * 256, cast(s64)line)
}

// Monospace glyph IDs occupy a separate cache namespace. Ordinary chat text
// keeps its proportional font, measurements and masks.
PixmapCellGlyph :: (glyph: s32) -> s32 {
    if glyph < 0 { return glyph }
    Mono.PixmapFontReady(); PixmapFontReady()
    code := pixmap_font_codes[glyph]
    low: s32; high: s32 = Mono.PixmapFontGlyphs - 1
    while low <= high {
        middle := (low + high) / 2; found := Mono.pixmap_font_codes[middle]
        if found == code { return PixmapFontGlyphs + middle }
        if found < code { low = middle + 1 } else { high = middle - 1 }
    }
    return glyph
}
PixmapCellWidth :: (font: s32) -> s32 {
    Mono.PixmapFontReady()
    line: s32 = Mono.PixmapFontAscent + Mono.PixmapFontDescent
    advance := Mono.pixmap_font_advances[0]
    width := (advance * font + line / 2) / line
    return ifx width > 0 then width else 1
}
PixmapCellBaseline :: (glyph: s32, font: s32) -> s64 {
    if glyph >= PixmapFontGlyphs {
        return PixmapUnits(cast(s64)Mono.PixmapFontAscent, font, Mono.PixmapFontAscent + Mono.PixmapFontDescent)
    }
    return PixmapTextBaseline(font)
}
PixmapOutlineValue :: (mono: bool, at: s32) -> s32 {
    if mono { return Mono.PixmapFontValue(at) }
    return PixmapFontValue(at)
}

// The font's glyph for a code point; -1 when it has none.
PixmapGlyphExact :: (code: s32) -> s32 {
    PixmapFontReady()
    low: s32 = 0
    high: s32 = PixmapFontGlyphs - 1
    while low <= high {
        middle: s32 = (low + high) / 2
        found: s32 = pixmap_font_codes[middle]
        if found == code { return middle }
        if found < code { low = middle + 1 } else { high = middle - 1 }
    }
    return -1
}

// The glyph for a code point, or the question mark's.
PixmapGlyphFor :: (point: u32) -> s32 {
    code: s32 = cast(s32)point
    if point > cast(u32)1114111 { code = 63 }
    glyph: s32 = PixmapGlyphExact(code)
    if glyph >= 0 { return glyph }
    glyph = PixmapGlyphExact(63)
    if glyph >= 0 { return glyph }
    return 0
}

PixmapGlyphAdvance :: (glyph: s32) -> s32 {
    PixmapFontReady()
    return pixmap_font_advances[glyph]
}

// The width of text at a font size, in whole pixels.
PixmapTextWidth :: (units: s64, font: s32) -> s32 {
    line: s64 = cast(s64)PixmapTextLine
    return cast(s32)((units * cast(s64)font * 2 + line) / (line * 2))
}

// The baseline's distance below the top of a font's line box, in 1/256 px.
PixmapTextBaseline :: (font: s32) -> s64 {
    return PixmapUnits(cast(s64)PixmapFontAscent, font)
}

PixmapAddEdge :: (x0: s64, y0: s64, x1: s64, y1: s64) {
    if y0 == y1 || pixmap_edge_count >= 4096 { return }
    pixmap_edge_x0[pixmap_edge_count] = x0
    pixmap_edge_y0[pixmap_edge_count] = y0
    pixmap_edge_x1[pixmap_edge_count] = x1
    pixmap_edge_y1[pixmap_edge_count] = y1
    pixmap_edge_count += 1
}

// A quadratic Bezier as `steps` lines.
PixmapAddCurve :: (x0: s64, y0: s64, cx: s64, cy: s64, x1: s64, y1: s64, steps: s64) {
    px: s64 = x0
    py: s64 = y0
    square: s64 = steps * steps
    step: s64 = 1
    while step <= steps {
        rest: s64 = steps - step
        nx: s64 = PixmapFloorDiv(x0 * rest * rest + cx * 2 * step * rest + x1 * step * step, square)
        ny: s64 = PixmapFloorDiv(y0 * rest * rest + cy * 2 * step * rest + y1 * step * step, square)
        PixmapAddEdge(px, py, nx, ny)
        px = nx
        py = ny
        step += 1
    }
}

// Adds one TrueType contour: on-curve points are corners, and an off-curve
// point is a quadratic's control, with an implied on-curve point between
// two controls in a row.
PixmapAddContour :: (count: s32, steps: s64) {
    if count < 2 { return }
    start: s32 = -1
    for index: 0..count - 1 {
        if start < 0 && pixmap_contour_on[index] { start = cast(s32)index }
    }
    sx: s64 = 0
    sy: s64 = 0
    if start >= 0 {
        sx = pixmap_contour_x[start]
        sy = pixmap_contour_y[start]
    } else {
        // All controls: the contour starts between the first two.
        start = 0
        sx = PixmapFloorDiv(pixmap_contour_x[0] + pixmap_contour_x[1], 2)
        sy = PixmapFloorDiv(pixmap_contour_y[0] + pixmap_contour_y[1], 2)
    }
    x: s64 = sx
    y: s64 = sy
    control: bool = false
    cx: s64 = 0
    cy: s64 = 0
    for step: 1..count {
        index: s32 = (start + cast(s32)step) % count
        px: s64 = pixmap_contour_x[index]
        py: s64 = pixmap_contour_y[index]
        if pixmap_contour_on[index] {
            if control { PixmapAddCurve(x, y, cx, cy, px, py, steps) }
            else { PixmapAddEdge(x, y, px, py) }
            x = px
            y = py
            control = false
        } else if control {
            mx: s64 = PixmapFloorDiv(cx + px, 2)
            my: s64 = PixmapFloorDiv(cy + py, 2)
            PixmapAddCurve(x, y, cx, cy, mx, my, steps)
            x = mx
            y = my
            cx = px
            cy = py
        } else {
            cx = px
            cy = py
            control = true
        }
    }
    if control { PixmapAddCurve(x, y, cx, cy, sx, sy, steps) }
    else { PixmapAddEdge(x, y, sx, sy) }
}

// Adds a span [from, to) of one sub-scanline, in 1/256 px relative to the
// mask's left edge, to the row's coverage.
PixmapAddSpan :: (from: s64, to: s64, width: s32) {
    limit: s64 = cast(s64)width * 256
    if from < 0 { from = 0 }
    if to > limit { to = limit }
    if to <= from { return }
    first: s64 = from / 256
    last: s64 = (to - 1) / 256
    if first == last {
        pixmap_row[first] += to - from
        return
    }
    pixmap_row[first] += (first + 1) * 256 - from
    column: s64 = first + 1
    while column < last {
        pixmap_row[column] += 256
        column += 1
    }
    pixmap_row[last] += to - last * 256
}

// Rasterizes a glyph whose origin is (origin_x, baseline) in 1/256 px into
// pixmap_mask; false when the glyph draws nothing.
PixmapRasterGlyph :: (glyph: s32, origin_x: s64, baseline: s64, font: s32,
    mask: *PixmapGlyphMask) -> bool {
    PixmapFontReady()
    pixmap_edge_count = 0
    mono := glyph >= PixmapFontGlyphs
    at: s32; line: s32 = PixmapTextLine; bias: s32 = PixmapFontBias
    if mono {
        Mono.PixmapFontReady(); at = Mono.pixmap_font_starts[glyph - PixmapFontGlyphs]
        line = Mono.PixmapFontAscent + Mono.PixmapFontDescent; bias = Mono.PixmapFontBias
    } else { at = pixmap_font_starts[glyph] }
    contours: s32 = PixmapOutlineValue(mono, at)
    points: s32 = at + 1 + contours
    steps: s64 = cast(s64)(font / 6)
    if steps < 2 { steps = 2 }
    if steps > 12 { steps = 12 }
    first: s32 = 0
    for contour: 0..contours - 1 {
        last: s32 = PixmapOutlineValue(mono, at + 1 + cast(s32)contour)
        count: s32 = last - first + 1
        if count > 0 && count <= 2048 {
            for index: 0..count - 1 {
                value: s32 = PixmapOutlineValue(mono, points + (first + cast(s32)index) * 2)
                y: s32 = PixmapOutlineValue(mono, points + (first + cast(s32)index) * 2 + 1)
                pixmap_contour_x[index] = origin_x +
                    PixmapUnits(cast(s64)(value / 2 - bias), font, line)
                pixmap_contour_y[index] = baseline -
                    PixmapUnits(cast(s64)(y - bias), font, line)
                pixmap_contour_on[index] = value % 2 == 1
            }
            PixmapAddContour(count, steps)
        }
        first = last + 1
    }
    if pixmap_edge_count == 0 { return false }
    left: s64 = pixmap_edge_x0[0]
    right: s64 = left
    top: s64 = pixmap_edge_y0[0]
    bottom: s64 = top
    for edge: 0..pixmap_edge_count - 1 {
        if pixmap_edge_x0[edge] < left { left = pixmap_edge_x0[edge] }
        if pixmap_edge_x1[edge] < left { left = pixmap_edge_x1[edge] }
        if pixmap_edge_x0[edge] > right { right = pixmap_edge_x0[edge] }
        if pixmap_edge_x1[edge] > right { right = pixmap_edge_x1[edge] }
        if pixmap_edge_y0[edge] < top { top = pixmap_edge_y0[edge] }
        if pixmap_edge_y1[edge] < top { top = pixmap_edge_y1[edge] }
        if pixmap_edge_y0[edge] > bottom { bottom = pixmap_edge_y0[edge] }
        if pixmap_edge_y1[edge] > bottom { bottom = pixmap_edge_y1[edge] }
    }
    mask.left = cast(s32)PixmapFloorDiv(left, 256)
    mask.top = cast(s32)PixmapFloorDiv(top, 256)
    mask.width = cast(s32)(PixmapFloorDiv(right + 255, 256)) - mask.left
    mask.height = cast(s32)(PixmapFloorDiv(bottom + 255, 256)) - mask.top
    if mask.width > PixmapMaskSide { mask.width = PixmapMaskSide }
    if mask.height > PixmapMaskSide { mask.height = PixmapMaskSide }
    if mask.width <= 0 || mask.height <= 0 { return false }
    origin: s64 = cast(s64)mask.left * 256
    for row: 0..mask.height - 1 {
        for column: 0..mask.width - 1 { pixmap_row[column] = 0 }
        for sample: 0..PixmapTextSamples - 1 {
            scan: s64 = (cast(s64)mask.top + cast(s64)row) * 256 +
                (cast(s64)sample * 2 + 1) * 128 / cast(s64)PixmapTextSamples
            crossings: s32 = 0
            for edge: 0..pixmap_edge_count - 1 {
                y0: s64 = pixmap_edge_y0[edge]
                y1: s64 = pixmap_edge_y1[edge]
                turn: s32 = 1
                low: s64 = y0
                high: s64 = y1
                if y1 < y0 {
                    turn = -1
                    low = y1
                    high = y0
                }
                if scan >= low && scan < high && crossings < 1024 {
                    x0: s64 = pixmap_edge_x0[edge]
                    x1: s64 = pixmap_edge_x1[edge]
                    x: s64 = x0 + PixmapFloorDiv((x1 - x0) * (scan - y0), y1 - y0)
                    // Insertion keeps the crossings in x order.
                    place: s32 = crossings
                    while place > 0 && pixmap_crossing_x[place - 1] > x {
                        pixmap_crossing_x[place] = pixmap_crossing_x[place - 1]
                        pixmap_crossing_turn[place] = pixmap_crossing_turn[place - 1]
                        place -= 1
                    }
                    pixmap_crossing_x[place] = x
                    pixmap_crossing_turn[place] = turn
                    crossings += 1
                }
            }
            // Non-zero winding: inside wherever the turns do not cancel.
            winding: s32 = 0
            span: s64 = 0
            for index: 0..crossings - 1 {
                before: s32 = winding
                winding += pixmap_crossing_turn[index]
                if before == 0 && winding != 0 { span = pixmap_crossing_x[index] }
                if before != 0 && winding == 0 {
                    PixmapAddSpan(span - origin, pixmap_crossing_x[index] - origin, mask.width)
                }
            }
        }
        full: s64 = cast(s64)PixmapTextSamples * 256
        for column: 0..mask.width - 1 {
            coverage: s64 = pixmap_row[column] * 255 / full
            if coverage > 255 { coverage = 255 }
            pixmap_mask[row * mask.width + cast(s32)column] = cast(u8)coverage
        }
    }
    return true
}

PixmapCacheClear :: () {
    for slot: 0..PixmapCacheSlots - 1 { pixmap_cache_keys[slot] = 0 }
    pixmap_cache_used = 0
    pixmap_cache_count = 0
}

// The coverage of a glyph whose origin is (origin_x, baseline) in 1/256 px,
// with its mask in pixels. Empty when the glyph draws nothing.
PixmapCachedGlyph :: (glyph: s32, origin_x: s64, baseline: s64, font: s32,
    mask: *PixmapGlyphMask) -> []u8 {
    whole_x: s64 = PixmapFloorDiv(origin_x, 256)
    whole_y: s64 = PixmapFloorDiv(baseline, 256)
    part_x: s64 = origin_x - whole_x * 256
    part_y: s64 = baseline - whole_y * 256
    nothing: []u8 = pixmap_mask[0:0]
    if font >= 65536 {
        if !PixmapRasterGlyph(glyph, origin_x, baseline, font, mask) { return nothing }
        return pixmap_mask[0:mask.width * mask.height]
    }
    key: s64 = ((cast(s64)glyph * 65536 + cast(s64)font) * 256 + part_x) * 256 + part_y + 1
    home: s32 = cast(s32)((cast(s64)glyph * 7919 + cast(s64)font * 131 + part_x * 31 + part_y) % cast(s64)PixmapCacheSlots)
    free: s32 = -1
    for probe: 0..PixmapCacheProbes - 1 {
        slot: s32 = (home + cast(s32)probe) % PixmapCacheSlots
        if pixmap_cache_keys[slot] == key {
            cached: PixmapGlyphMask = pixmap_cache_masks[slot]
            if pixmap_cache_starts[slot] < 0 { return nothing }
            mask.left = cached.left + cast(s32)whole_x
            mask.top = cached.top + cast(s32)whole_y
            mask.width = cached.width
            mask.height = cached.height
            start: s32 = pixmap_cache_starts[slot]
            return pixmap_cache_bytes[start:start + cached.width * cached.height]
        }
        if pixmap_cache_keys[slot] == 0 {
            free = slot
            break
        }
    }
    drawn: bool = PixmapRasterGlyph(glyph, origin_x, baseline, font, mask)
    size: s32 = 0
    if drawn { size = mask.width * mask.height }
    if free < 0 || pixmap_cache_count >= PixmapCacheSlots * 3 / 4 ||
        pixmap_cache_used + size > PixmapCacheBytes {
        PixmapCacheClear()
        free = home
    }
    pixmap_cache_keys[free] = key
    pixmap_cache_count += 1
    if !drawn {
        pixmap_cache_starts[free] = -1
        return nothing
    }
    stored: PixmapGlyphMask
    stored.left = mask.left - cast(s32)whole_x
    stored.top = mask.top - cast(s32)whole_y
    stored.width = mask.width
    stored.height = mask.height
    pixmap_cache_masks[free] = stored
    pixmap_cache_starts[free] = pixmap_cache_used
    for index: 0..size - 1 { pixmap_cache_bytes[pixmap_cache_used + index] = pixmap_mask[index] }
    pixmap_cache_used += size
    return pixmap_mask[0:size]
}

// Color emoji. A cell is decoded from pixmap_emoji on first use and shrunk
// to the text size with integer box filtering, so every target draws the
// same pixels. Shrunk emoji are cached by emoji and size like glyph masks.
PixmapEmojiSlots :: 4096;
PixmapEmojiProbes :: 32;
PixmapEmojiPixels :: 262144;
PixmapEmojiLargest :: 128;
pixmap_emoji_ready: bool;
pixmap_emoji_cell: [1024]u32;
pixmap_emoji_keys: [4096]s32;
pixmap_emoji_offsets: [4096]s32;
pixmap_emoji_pool: [262144]u32;
pixmap_emoji_used: s32;
pixmap_emoji_count: s32;

PixmapEmojiSymbol :: (at: s32) -> s32 {
    chunk: s32 = at / PixmapEmojiChunk
    text: string = pixmap_emoji_chunks[chunk]
    return PixmapFontSextet(text[at - chunk * PixmapEmojiChunk])
}

PixmapEmojiReady :: () {
    if pixmap_emoji_ready { return }
    PixmapEmojiChunksFill()
    for index: 0..PixmapEmojiCount - 1 {
        at: s32 = cast(s32)index * 3
        pixmap_emoji_codes[index] = PixmapEmojiSymbol(at) * 4096 +
            PixmapEmojiSymbol(at + 1) * 64 + PixmapEmojiSymbol(at + 2)
    }
    for index: 0..PixmapEmojiCount - 1 {
        at: s32 = PixmapEmojiCount * 3 + cast(s32)index * 4
        pixmap_emoji_starts[index] = PixmapEmojiSymbol(at) * 262144 +
            PixmapEmojiSymbol(at + 1) * 4096 + PixmapEmojiSymbol(at + 2) * 64 +
            PixmapEmojiSymbol(at + 3)
    }
    pixmap_emoji_ready = true
}

// The color emoji for a code point; -1 when there is none.
PixmapEmojiFor :: (code: s32) -> s32 {
    if code < 8252 { return -1 }
    PixmapEmojiReady()
    low: s32 = 0
    high: s32 = PixmapEmojiCount - 1
    while low <= high {
        middle: s32 = (low + high) / 2
        found: s32 = pixmap_emoji_codes[middle]
        if found == code { return middle }
        if found < code { low = middle + 1 } else { high = middle - 1 }
    }
    return -1
}

// Code points shown as emoji without a variation selector: everything past
// the Basic Multilingual Plane, and there the Emoji_Presentation symbols.
PixmapEmojiDefault :: (code: s32) -> bool {
    if code >= 65536 { return true }
    if code == 8986 || code == 8987 || (code >= 9193 && code <= 9196) ||
        code == 9200 || code == 9203 || code == 9725 || code == 9726 ||
        code == 9748 || code == 9749 || (code >= 9800 && code <= 9811) ||
        code == 9855 || code == 9875 || code == 9889 || code == 9898 ||
        code == 9899 || code == 9917 || code == 9918 || code == 9924 ||
        code == 9925 || code == 9934 || code == 9940 || code == 9962 ||
        code == 9970 || code == 9971 || code == 9973 || code == 9978 ||
        code == 9981 || code == 9989 || code == 9994 || code == 9995 ||
        code == 10024 || code == 10060 || code == 10062 ||
        (code >= 10067 && code <= 10069) || code == 10071 ||
        (code >= 10133 && code <= 10135) || code == 10160 || code == 10175 ||
        code == 11035 || code == 11036 || code == 11088 || code == 11093 { return true }
    return false
}

// Skin tone modifiers, the keycap mark and tags only change the emoji
// before them and take no room.
PixmapEmojiModifier :: (code: s32) -> bool {
    return (code >= 127995 && code <= 127999) || code == 8419 ||
        (code >= 917504 && code <= 917631)
}

PixmapEmojiDecode :: (emoji: s32) {
    palette: [64]u32
    at: s32 = PixmapEmojiHeader + pixmap_emoji_starts[emoji]
    colors: s32 = PixmapEmojiSymbol(at)
    at += 1
    for color: 1..colors {
        rgb: s32 = PixmapEmojiSymbol(at) * 262144 + PixmapEmojiSymbol(at + 1) * 4096 +
            PixmapEmojiSymbol(at + 2) * 64 + PixmapEmojiSymbol(at + 3)
        alpha: s32 = PixmapEmojiSymbol(at + 4) * 4 + PixmapEmojiSymbol(at + 5)
        palette[color] = (cast(u32)alpha << cast(u32)24) | cast(u32)rgb
        at += 6
    }
    pixel: s32 = 0
    while pixel < 1024 {
        value: s32 = PixmapEmojiSymbol(at)
        run: s32 = 1
        at += 1
        if value == 63 {
            run = PixmapEmojiSymbol(at) + 3
            value = PixmapEmojiSymbol(at + 1)
            at += 2
        }
        while run > 0 && pixel < 1024 {
            pixmap_emoji_cell[pixel] = palette[value]
            pixel += 1
            run -= 1
        }
    }
}

// Shrinks the decoded cell to size x size into the pool at `offset`,
// averaging premultiplied color; larger sizes take the nearest cell pixel.
PixmapEmojiScale :: (size: s32, offset: s32) {
    cell: s32 = PixmapEmojiCell
    if size > cell {
        for y: 0..size - 1 {
            for x: 0..size - 1 {
                pixmap_emoji_pool[offset + cast(s32)y * size + cast(s32)x] =
                    pixmap_emoji_cell[(cast(s32)y * cell / size) * cell + cast(s32)x * cell / size]
            }
        }
        return
    }
    red: [1024]s32
    green: [1024]s32
    blue: [1024]s32
    alpha: [1024]s32
    count: [1024]s32
    for y: 0..cell - 1 {
        row: s32 = cast(s32)y * size / cell
        for x: 0..cell - 1 {
            target: s32 = row * size + cast(s32)x * size / cell
            pixel: u32 = pixmap_emoji_cell[cast(s32)y * cell + cast(s32)x]
            a: s32 = cast(s32)(pixel >> cast(u32)24)
            red[target] += cast(s32)((pixel >> cast(u32)16) & cast(u32)255) * a
            green[target] += cast(s32)((pixel >> cast(u32)8) & cast(u32)255) * a
            blue[target] += cast(s32)(pixel & cast(u32)255) * a
            alpha[target] += a
            count[target] += 1
        }
    }
    for target: 0..size * size - 1 {
        result: u32 = 0
        if alpha[target] > 0 {
            a: s32 = (alpha[target] + count[target] / 2) / count[target]
            r: s32 = (red[target] + alpha[target] / 2) / alpha[target]
            g: s32 = (green[target] + alpha[target] / 2) / alpha[target]
            b: s32 = (blue[target] + alpha[target] / 2) / alpha[target]
            result = (cast(u32)a << cast(u32)24) | (cast(u32)r << cast(u32)16) |
                (cast(u32)g << cast(u32)8) | cast(u32)b
        }
        pixmap_emoji_pool[offset + cast(s32)target] = result
    }
}

// Where the emoji's size x size pixels start in the pool; -1 when the size
// is not drawn.
PixmapEmojiPixelsFor :: (emoji: s32, size: s32) -> s32 {
    if size <= 0 || size > PixmapEmojiLargest { return -1 }
    key: s32 = emoji * 256 + size + 1
    home: s32 = (emoji * 7919 + size * 31) % PixmapEmojiSlots
    free: s32 = -1
    for probe: 0..PixmapEmojiProbes - 1 {
        slot: s32 = (home + cast(s32)probe) % PixmapEmojiSlots
        if pixmap_emoji_keys[slot] == key { return pixmap_emoji_offsets[slot] }
        if pixmap_emoji_keys[slot] == 0 {
            free = slot
            break
        }
    }
    area: s32 = size * size
    if free < 0 || pixmap_emoji_count >= PixmapEmojiSlots * 3 / 4 ||
        pixmap_emoji_used + area > PixmapEmojiPixels {
        for slot: 0..PixmapEmojiSlots - 1 { pixmap_emoji_keys[slot] = 0 }
        pixmap_emoji_used = 0
        pixmap_emoji_count = 0
        free = home
    }
    PixmapEmojiDecode(emoji)
    offset: s32 = pixmap_emoji_used
    PixmapEmojiScale(size, offset)
    pixmap_emoji_keys[free] = key
    pixmap_emoji_offsets[free] = offset
    pixmap_emoji_used += area
    pixmap_emoji_count += 1
    return offset
}

// One unit of laid-out text: a glyph, a color emoji or nothing, and its
// advance in font units.
PixmapTextUnit :: struct {
    after: s32
    glyph: s32
    emoji: s32
    advance: s64
}

PixmapNextUnit :: (value: string, at: s32) -> PixmapTextUnit {
    unit: PixmapTextUnit
    unit.after = at
    unit.glyph = -1
    unit.emoji = -1
    point: Decoded = Decode(value, at)
    if point.after <= at { return unit }
    unit.after = point.after
    code: s32 = cast(s32)point.value
    if point.value > cast(u32)1114111 { code = 63 }
    if PixmapEmojiModifier(code) { return unit }
    exact: s32 = PixmapGlyphExact(code)
    emoji: s32 = PixmapEmojiFor(code)
    if emoji >= 0 {
        next: s32 = 0
        if point.after < cast(s32)value.count {
            following: Decoded = Decode(value, point.after)
            if following.after > point.after { next = cast(s32)following.value }
        }
        shown: bool = next == 65039 || exact < 0 || PixmapEmojiDefault(code)
        if next == 65038 && exact >= 0 { shown = false }
        if shown {
            unit.emoji = emoji
            unit.advance = cast(s64)PixmapTextLine
            return unit
        }
    }
    unit.glyph = exact
    if unit.glyph < 0 { unit.glyph = PixmapGlyphFor(cast(u32)63) }
    unit.advance = cast(s64)PixmapGlyphAdvance(unit.glyph)
    return unit
}
