// The size a Toggle needs for its labels and track, so a caller can place
// it at the end of a row. It stays apart from toggle_widget, as
// text_measure stays apart from the Text widget.
using Toggle :: #import "toggle_props";
#if #defined(KRYON_HOSTED_UI) {
    #import "session"
    #import "geometry"
    host_api :: #system_library "host_api";
    ToggleSizeHostedHost :: (session: Session, props: Toggle.Props) -> Vector2 #foreign host_api;
    // A portable app asks its host, which sizes the toggle as it draws it.
    #program_export
    ToggleSize :: (session: Session, props: Toggle.Props) -> Vector2 {
        return ToggleSizeHostedHost(session, props)
    }
} else {
    #import "session"
    #import "geometry"
    #import "toggle"
    #program_export
    ToggleSize :: (session: Session, props: Toggle.Props) -> Vector2 {
        unused session
        return ToggleMinimumSize(props)
    }
}
