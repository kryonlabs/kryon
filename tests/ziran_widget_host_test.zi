    TextStyleFor(TextStyleRequest.{}, StyleData.{}).foreground != cast(u32)0x10203fff { return 84 }
    if Call("widget_palette", "WidgetPaletteRestoreHostedHost", restore[:], *result) != 1 ||
    StyleTokenColor("canvas").r != cast(u8)0x26 || StyleTokenColor("text").r != cast(u8)0xe0 ||
    TextStyleFor(TextStyleRequest.{}, StyleData.{}).foreground != cast(u32)0xe0e4e3ff { return 85 }
    if Call("widget_palette", "WidgetPaletteRestoreHostedHost", restore[:], *result) != 1 ||
    ActiveStyleRules().count != host_rules { return 79 }
    // The frame's end unwinds every palette the bundle left open.
    if Call("widget_palette", "WidgetPaletteHostedHost", colors[:], *result) != 1 ||
    Call("widget_palette", "WidgetPaletteHostedHost", inner[:], *result) != 1 { return 80 }
    WidgetHostEnd()
    if EndFrame(session) != cast(FrameStatus)FrameOk || ActiveStyleRules().count != host_rules ||
    TextStyleFor(TextStyleRequest.{}, StyleData.{}).foreground == cast(u32)0xe0e4e3ff { return 81 }
    restored_canvas := StyleTokenColorOr("canvas", Color.{1, 2, 3, 4})
    restored_accent := StyleTokenColorOr("accent", Color.{5, 6, 7, 8})
    if CaptureStyleTokenColors().count != host_tokens.count || restored_canvas.r != original_canvas.r ||
    restored_canvas.a != original_canvas.a || restored_accent.g != original_accent.g || restored_accent.a != original_accent.a { return 83 }
    // Twenty nested palettes: each shows, the restores past the sixteen
    // remembered levels give the deepest remembered one, every one inside
    // it comes back in turn, and the last restore gives the host its style.
    BeginFrame(session, cast(u64)8, Rectangle.{0.0, 0.0, 300.0, 200.0})
    WidgetHostBegin(session, AllowPhoto)
    deep := colors
    for level: cast(s32)0..19 {
        deep[1] = HostScalar("u32", cast(s64)((cast(u64)(0x10 + level) << cast(u64)24) | cast(u64)0xff))
        if Call("widget_palette", "WidgetPaletteHostedHost", deep[:], *result) != 1 || result.integer != 1 ||
        StyleTokenColor("canvas").r != cast(u8)(0x10 + level) { return 101 }
    }
    for restored: cast(s32)1..19 {
        shown := ifx restored <= 3 then 16 else 19 - restored
        if Call("widget_palette", "WidgetPaletteRestoreHostedHost", restore[:], *result) != 1 ||
        StyleTokenColor("canvas").r != cast(u8)(0x10 + shown) ||
        ActiveStyleRules().count == host_rules { return 102 }
    }
    if Call("widget_palette", "WidgetPaletteRestoreHostedHost", restore[:], *result) != 1 ||
    ActiveStyleRules().count != host_rules { return 103 }
    deep_canvas := StyleTokenColorOr("canvas", Color.{1, 2, 3, 4})
    if deep_canvas.r != original_canvas.r || deep_canvas.a != original_canvas.a { return 104 }
    // Twenty left open: the frame's end still gives the host its style.
    for level: cast(s32)0..19 {
        deep[1] = HostScalar("u32", cast(s64)((cast(u64)(0x10 + level) << cast(u64)24) | cast(u64)0xff))
        if Call("widget_palette", "WidgetPaletteHostedHost", deep[:], *result) != 1 { return 105 }
    }
    WidgetHostEnd()
    deep_canvas = StyleTokenColorOr("canvas", Color.{1, 2, 3, 4})
    if EndFrame(session) != cast(FrameStatus)FrameOk || ActiveStyleRules().count != host_rules ||
    deep_canvas.r != original_canvas.r || deep_canvas.a != original_canvas.a { return 106 }
    // Sampling overrides survive the bounded host codec with exact paint parity.
    paths: [2]string = .["assets/photo.png", "assets/photo.png"]
    mixed_layers: [6]s32 = .[0, 1, 0, 1, -1, 0]
    nearest: [1]s32 = .[0]
    filtered := map
    filtered.bounds.width = 91.0
    filtered.bounds.height = 43.0
    filtered.pixel_snap = true
    filtered.tiles = paths[:]
    filtered.layers = mixed_layers[:]
    filtered.nearest_tiles = nearest[:]
    BeginFrame(session, cast(u64)8, Rectangle.{0.0, 0.0, 300.0, 200.0})
    WidgetHostBegin(session, AllowPhoto)
    arguments[1] = WidgetEncodeTileMapProps(filtered, *tile_map_codec)
    if Call("tilemap", "TileMapHostedHost", arguments[:2], *result) != 1 { return 84 }
    filtered_grid := WidgetDecodeTileMapResult(result, *tile_map_result_codec)
    filtered_count := TileMapPaintTake(session)
    if filtered_grid.cell != 21.0 || filtered_count != 6 || tile_map_paint[1].smooth || !tile_map_paint[2].smooth { return 85 }
    WidgetHostEnd()
    if EndFrame(session) != cast(FrameStatus)FrameOk { return 86 }
    BeginFrame(session, cast(u64)8, Rectangle.{0.0, 0.0, 300.0, 200.0})
    unused TileMap.Draw(session, filtered)
    if !TileMapPaintSame(session, filtered_count) { return 87 }
    if EndFrame(session) != cast(FrameStatus)FrameOk { return 88 }
    return 0
}

// Reject guest addresses before dispatch; a null-state hosted tab remains usable.
HostedImageDimensions :: () -> s32 {
    if !WidgetHostSupports("image_raster", "ImageWidth") ||
        !WidgetHostSupports("p95ee34f8b47b4393_image_raster", "ImageHeight") ||
        WidgetHostSupports("other", "ImageWidth") ||
        WidgetHostSupports("image_raster", "RasterImage") { return 1 }
    session := SessionOpen()
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 200.0})
    argument: [1]HostValue
    paths: [4]string = .{"assets/photo.png", "assets/photo-small.png",
        "assets/slow.png", "assets/gone.png"}
    expected: [4]s64 = .{40, 10, -1, 0}
    answer: HostValue
    WidgetHostBegin(session, AllowPhoto)
    for index: cast(s32)0..3 {
        path := paths[index]
        argument[0] = HostValue.{.kind = cast(s32)HostString,
            .type_name = HostTextData("string"), .data = HostTextData(path),
            .length = cast(usize)path.count}
        if Call("image_raster", "ImageWidth", argument[:], *answer) != 1 ||
            !HostScalarValid(answer, "s32", cast(s32)HostInteger) ||
            answer.integer != expected[index] { return 2 }
        if Call("p95ee34f8b47b4393_image_raster", "ImageHeight", argument[:], *answer) != 1 ||
            answer.integer != expected[index] { return 3 }
    }
    argument[0] = HostScalar("s32", 0)
    if Call("image_raster", "ImageWidth", argument[:], *answer) != 0 ||
        Call("image_raster", "ImageWidth", argument[:0], *answer) != 0 { return 4 }
    path := "private/key.png"
    argument[0] = HostValue.{.kind = cast(s32)HostString,
        .type_name = HostTextData("string"), .data = HostTextData(path),
        .length = cast(usize)path.count}
    if Call("image_raster", "ImageWidth", argument[:], *answer) != 0 { return 5 }
    WidgetHostEnd()
    if Call("image_raster", "ImageWidth", argument[:], *answer) != 0 { return 6 }
    path = "assets/photo.png"
    argument[0].data = HostTextData(path)
    argument[0].length = cast(usize)path.count
    WidgetHostBegin(session, AllowPhoto, ResolvePhoto)
    resolved_owner = 1
    if Call("image_raster", "ImageWidth", argument[:], *answer) != 1 ||
        TextFromCString(*image_size_path[0]) != "apps/owner-a/assets/photo.png" { return 7 }
    resolved_owner = 0
    if Call("image_raster", "ImageHeight", argument[:], *answer) != 1 ||
        answer.integer != -1 { return 8 }
    WidgetHostEnd()
    EndFrame(session)
    SessionClose(session)
    return 0
}

HostedPointerBoundary :: () -> s32 {
    session := SessionOpen()
    BeginFrame(session, cast(u64)99, Rectangle.{0.0, 0.0, 300.0, 200.0})
    WidgetHostBegin(session, AllowPhoto)
    arguments: [3]HostValue
    arguments[0] = WidgetEncodeSession(session, *session_codec)
    tabs: [2]TabBar.Tab
    tabs[0] = TabBar.Tab.{.key = 10, .label = "First"}
    tabs[1] = TabBar.Tab.{.key = 11, .label = "Second"}
    for index: 0..1 { tab_values[index] = WidgetEncodeTab(tabs[index], *tab_codecs[index]) }
    arguments[2] = HostValue.{.kind = cast(s32)HostSlice, .type_name = HostTextData("[]Tab"),
        .length = cast(usize)2, .elements = *tab_values[0]}
    props := TabBar.Props.{.key = 80, .bounds = .{0.0, 0.0, 280.0, 44.0}, .selected_index = 1}
    arguments[1] = WidgetEncodeTabBarProps(props, *tab_bar_codec)
    result: HostValue
    before := TreeSubmittedCount(session)
    addresses: [3]s64 = .[1, 4096, -1]
    for address: addresses {
        for field: 0..cast(s32)tab_bar_codec.fields.count - 1 {
            if TextFromCString(tab_bar_codec.fields[field].name) == "motion" {
                tab_bar_codec.fields[field].value = HostScalar("*TransitionMotionState", address)
            }
        }
        if WidgetValidTabBarProps(arguments[1]) { return 1 }
        if Call("tabs", "TabBarHostedHost", arguments[:], *result) != 0 { return 2 }
        if TreeSubmittedCount(session) != before { return 3 }
    }
    arguments[1] = WidgetEncodeTabBarProps(props, *tab_bar_codec)
    if !WidgetValidTabBarProps(arguments[1]) { return 4 }
    if Call("tabs", "TabBarHostedHost", arguments[:], *result) != 1 { return 5 }
    decoded: WidgetTabBarResultCodec
    answer := WidgetDecodeTabBarResult(result, *decoded)
    if answer.selected_index != 1 || answer.animating || TreeSubmittedCount(session) <= before { return 6 }
    WidgetHostEnd()
    if CommitFrame(session) != cast(FrameStatus)FrameOk { return 7 }
    TreeDispose(session)
    unused SessionClose(session)
    return 0
}
