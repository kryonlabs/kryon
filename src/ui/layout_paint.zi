#import "control_props"
#import "elevation_paint"
#import "drawing_props"
#import "geometry"
#import "layout_paint_slot"
#import "paint_primitives"
#import "session"
#import "std/math"
#import "style"
#import "style_sheet"
#import "surface"

using StyleField;
using StyleBoxField;

// A container's CSS box, like a styled div: shadow (an elevation role),
// background (a color or two-stop gradient), border and radius at the
// container's bounds. Per-side borders
// paint square edges; with a radius the box keeps its uniform border.
LayoutPaintBox :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData, mark: s64,
    node: s32) {
    paint_primitives.owner(node)
    defer { paint_primitives.owner(-1) }
    from := paint_primitives.mark(session)
    opacity := StyleOpacityValue(face.fields, face.opacity)
    radius := ifx StyleHasField(face, cast(u32)StyleRadius) && face.radius > 0.0 then face.radius else 0.0
    if StyleHasField(face, cast(u32)StyleElevation) && face.elevation != .ElevationRoleNone {
        PaintElevationForRole(session, -1, bounds, radius, opacity, cast(s32)face.elevation)
    }
    if StyleHasField(face, cast(u32)StyleBackground) {
        top := ColorFromPacked(Opacity(face.background, opacity))
        if StyleHasField(face, cast(u32)StyleBackgroundEnd) && (box.fields & cast(u32)StyleBoxRadial) != 0 {
            LayoutPaintRadial(session, bounds, face, box, opacity)
        } else if StyleHasField(face, cast(u32)StyleBackgroundEnd) && (box.fields & cast(u32)StyleBoxGradient) != 0 {
            LayoutPaintGradient(session, bounds, face, box, opacity)
        } else if StyleHasField(face, cast(u32)StyleBackgroundEnd) {
            paint_primitives.gradient(session, -1, bounds, top,
                ColorFromPacked(Opacity(face.background_end, opacity)))
        } else if top.a != cast(u8)0 {
            paint_primitives.fill(session, -1, bounds, radius, 8, top)
        }
    }
    uniform := ifx StyleHasField(face, cast(u32)StyleBorderWidth) && face.border_width > 0.0 then face.border_width else 0.0
    border := ColorFromPacked(Opacity(face.border, opacity))
    if (box.fields & cast(u32)StyleBoxBorderSides) != 0 && radius == 0.0 {
        LayoutPaintSides(session, bounds, face, box, opacity, uniform)
    } else if uniform > 0.0 && border.a != cast(u8)0 {
        paint_primitives.outline(session, -1, bounds, radius, 8, uniform, border)
    }
    if mark >= 0 { paint_primitives.move_below(session, mark, from) }
}

LayoutGradientStops :: struct {
    count: s32
    positions: [6]float64
    colors: [6]Color
}

LayoutMix :: (a: u8, b: u8, t: float64) -> u8 {
    return cast(u8)(cast(float64)a + (cast(float64)b - cast(float64)a) * t + 0.5)
}

// The gradient's color at `t` along its line, clamped to the end stops.
LayoutGradientAt :: (stops: *LayoutGradientStops, t: float64) -> Color {
    if t <= stops.positions[0] { return stops.colors[0] }
    last := stops.count - 1
    for index: 1..last {
        if t <= stops.positions[index] {
            start := stops.positions[index - 1]
            span := stops.positions[index] - start
            f := ifx span > 0.0 then (t - start) / span else 1.0
            a := stops.colors[index - 1]
            b := stops.colors[index]
            return Color.{LayoutMix(a.r, b.r, f), LayoutMix(a.g, b.g, f), LayoutMix(a.b, b.b, f), LayoutMix(a.a, b.a, f)}
        }
    }
    return stops.colors[last]
}

LayoutAbs :: (value: float64) -> float64 { return ifx value < 0.0 then -value else value }

LayoutRound :: (value: float64) -> float64 {
    if value >= 0.0 { return cast(float64)cast(s64)(value + 0.5) }
    return -cast(float64)cast(s64)(0.5 - value)
}

// A linear gradient at any angle with up to six stops, from vertical
// gradients: a vertical one is one strip split at its stops; any other is
// up to 64 narrow strips, each split where a stop line crosses it, so the
// colors are exact along each strip's center line.
LayoutPaintGradient :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData, opacity: float32) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    stops: LayoutGradientStops
    stops.count = ifx box.gradient_count >= 2 && box.gradient_count <= 6 then box.gradient_count else 2
    last := stops.count - 1
    for index: 0..last {
        stops.positions[index] = cast(float64)box.gradient_stops[index]
        packed := face.background_end
        if index == 0 { packed = face.background }
        else if index < last { packed = box.gradient_colors[index - 1] }
        stops.colors[index] = ColorFromPacked(Opacity(packed, opacity))
    }
    w := cast(float64)bounds.width
    h := cast(float64)bounds.height
    // The gradient line's direction; a corner runs perpendicular to the
    // diagonal that misses it, as in CSS. Its scale cancels below.
    dx := cast(float64)box.gradient_dx
    dy := cast(float64)box.gradient_dy
    corner := box.gradient_corner
    if corner >= 1 && corner <= 4 {
        dx = ifx corner <= 2 then h else -h
        dy = ifx corner == 2 || corner == 3 then w else -w
    }
    length := LayoutAbs(w * dx) + LayoutAbs(h * dy)
    if length <= 0.0 { return }
    cx := cast(float64)bounds.x + w / 2.0
    cy := cast(float64)bounds.y + h / 2.0
    strips: s32 = 1
    if LayoutAbs(dx) * w > 0.0001 * length {
        strips = cast(s32)(w / 4.0 + 0.999)
        if strips > 64 { strips = 64 }
        if strips < 1 { strips = 1 }
    }
    top := cast(float64)bounds.y
    bottom := top + h
    for strip: 0..strips - 1 {
        left := LayoutRound(cast(float64)bounds.x + w * cast(float64)strip / cast(float64)strips)
        right := LayoutRound(cast(float64)bounds.x + w * cast(float64)(strip + 1) / cast(float64)strips)
        if strip == strips - 1 { right = cast(float64)bounds.x + w }
        if right <= left { continue }
        center := (left + right) / 2.0
        along := (center - cx) * dx
        // t(y) = (along + (y - cy) * dy) / length + 0.5 down the strip.
        if LayoutAbs(dy) * h < 0.000001 * length {
            color := LayoutGradientAt(*stops, along / length + 0.5)
            paint_primitives.fill(session, -1, Rectangle.{cast(float32)left, bounds.y, cast(float32)(right - left), bounds.height},
                0.0, 4, color)
            continue
        }
        cuts: [8]float64
        cut_count: s32 = 0
        cuts[0] = top
        cut_count = 1
        for index: 0..last {
            // The y where the strip crosses stop `index`, in top-down order.
            stop := ifx dy > 0.0 then index else last - index
            y := cy + ((stops.positions[stop] - 0.5) * length - along) / dy
            if y > cuts[cut_count - 1] && y < bottom {
                cuts[cut_count] = y
                cut_count += 1
            }
        }
        cuts[cut_count] = bottom
        for segment: 0..cut_count - 1 {
            y0 := cuts[segment]
            y1 := cuts[segment + 1]
            if y1 - y0 <= 0.0 { continue }
            upper := LayoutGradientAt(*stops, (along + (y0 - cy) * dy) / length + 0.5)
            lower := LayoutGradientAt(*stops, (along + (y1 - cy) * dy) / length + 0.5)
            paint_primitives.gradient(session, -1, Rectangle.{cast(float32)left, cast(float32)y0,
                cast(float32)(right - left), cast(float32)(y1 - y0)}, upper, lower)
        }
    }
}

// A radial gradient paints the box as horizontal bands, each exact along
// its center line: bands are about 2px tall (up to 256), split at the stop
// radii's crossings, with each ring between stops cut at most an eighth of
// a stop span wide. Beyond the ending shape the last stop's color extends.
LayoutPaintRadial :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData, opacity: float32) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    stops: LayoutGradientStops
    stops.count = ifx box.gradient_count >= 2 && box.gradient_count <= 6 then box.gradient_count else 2
    last := stops.count - 1
    for index: 0..last {
        stops.positions[index] = cast(float64)box.gradient_stops[index]
        packed := face.background_end
        if index == 0 { packed = face.background }
        else if index < last { packed = box.gradient_colors[index - 1] }
        stops.colors[index] = ColorFromPacked(Opacity(packed, opacity))
    }
    w := cast(float64)bounds.width
    h := cast(float64)bounds.height
    cx := cast(float64)bounds.x + cast(float64)box.radial_cx * w
    cy := cast(float64)bounds.y + cast(float64)box.radial_cy * h
    // The radii: explicit ones win, otherwise the extent keyword measures
    // the side and corner distances, as CSS sizes its ending shape. An
    // ellipse's corner sizes run the closest or farthest side distances out
    // to the corner, sqrt(2) about the box's center; a circle takes the
    // corner's straight distance or the nearer or farther side distance.
    rx := 0.0
    ry := 0.0
    if box.radial_rx < 0.0 { rx = -cast(float64)box.radial_rx * w }
    else if box.radial_rx > 0.0 { rx = cast(float64)box.radial_rx }
    if box.radial_ry < 0.0 { ry = -cast(float64)box.radial_ry * h }
    else if box.radial_ry > 0.0 { ry = cast(float64)box.radial_ry }
    left := cx - cast(float64)bounds.x
    right := cast(float64)bounds.x + w - cx
    top := cy - cast(float64)bounds.y
    bottom := cast(float64)bounds.y + h - cy
    if rx <= 0.0 || ry <= 0.0 {
        near_x := ifx left < right then left else right
        near_y := ifx top < bottom then top else bottom
        far_x := ifx left > right then left else right
        far_y := ifx top > bottom then top else bottom
        corner := 1.4142135623730951
        if box.radial_shape == 1 {
            radius := 0.0
            if box.radial_size == 1 { radius = Sqrt(near_x * near_x + near_y * near_y) }
            else if box.radial_size == 2 { radius = ifx near_x < near_y then near_x else near_y }
            else if box.radial_size == 3 { radius = ifx far_x > far_y then far_x else far_y }
            else { radius = Sqrt(far_x * far_x + far_y * far_y) }
            if rx <= 0.0 { rx = radius }
            if ry <= 0.0 { ry = radius }
        } else {
            if box.radial_size == 1 { rx = near_x * corner; ry = near_y * corner }
            else if box.radial_size == 2 { rx = near_x; ry = near_y }
            else if box.radial_size == 3 { rx = far_x; ry = far_y }
            else { rx = far_x * corner; ry = far_y * corner }
        }
    }
    if rx < 0.01 { rx = 0.01 }
    if ry < 0.01 { ry = 0.01 }
    // The ring boundaries between 0 and 1: each stop span cut into steps of
    // at most an eighth, ending at 1.
    ring: [48]float64
    ring_count: s32 = 0
    for index: 0..last - 1 {
        from := stops.positions[index]
        span := stops.positions[index + 1] - from
        if span <= 0.0 { continue }
        steps := cast(s32)(span * 8.0 + 0.999)
        if steps > 8 { steps = 8 }
        for step: 0..steps - 1 {
            if ring_count >= 47 { break }
            ring[ring_count] = from + span * cast(float64)step / cast(float64)steps
            ring_count += 1
        }
    }
    ring[ring_count] = 1.0
    ring_count += 1
    bands := cast(s32)(h / 2.0 + 0.999)
    if bands < 1 { bands = 1 }
    if bands > 256 { bands = 256 }
    for band: 0..bands - 1 {
        band_top := LayoutRound(cast(float64)bounds.y + h * cast(float64)band / cast(float64)bands)
        band_bottom := LayoutRound(cast(float64)bounds.y + h * cast(float64)(band + 1) / cast(float64)bands)
        if band == bands - 1 { band_bottom = cast(float64)bounds.y + h }
        if band_bottom <= band_top { continue }
        v := ((band_top + band_bottom) / 2.0 - cy) / ry
        distance := LayoutAbs(v)
        band_rect := Rectangle.{bounds.x, cast(float32)band_top, bounds.width, cast(float32)(band_bottom - band_top)}
        if distance >= 1.0 {
            paint_primitives.fill(session, -1, band_rect, 0.0, 4, stops.colors[last])
            continue
        }
        // Inward on the left: beyond the ending shape one color, then each
        // ring between two boundaries, then the core holding the center.
        edge := cast(float64)bounds.x
        inner := 1.0
        for index: 0..ring_count - 1 {
            at := ring[ring_count - 1 - index]
            if at < distance { break }
            half := rx * Sqrt(at * at - v * v)
            crossing := cx - half
            if crossing > edge + 0.01 {
                color := LayoutGradientAt(*stops, (at + inner) / 2.0)
                paint_primitives.fill(session, -1, Rectangle.{cast(float32)edge, cast(float32)band_top,
                    cast(float32)(crossing - edge), cast(float32)(band_bottom - band_top)}, 0.0, 4, color)
            }
            edge = crossing
            inner = at
        }
        core_half := rx * Sqrt(inner * inner - v * v)
        if core_half > 0.01 {
            color := LayoutGradientAt(*stops, (distance + inner) / 2.0)
            paint_primitives.fill(session, -1, Rectangle.{cast(float32)(cx - core_half), cast(float32)band_top,
                cast(float32)(core_half * 2.0), cast(float32)(band_bottom - band_top)}, 0.0, 4, color)
        }
        // Out again on the right.
        edge = cx + core_half
        for index: 0..ring_count - 1 {
            at := ring[index]
            if at <= inner { continue }
            half := rx * Sqrt(at * at - v * v)
            crossing := cx + half
            if crossing > edge + 0.01 {
                color := LayoutGradientAt(*stops, (at + ring[index - 1]) / 2.0)
                paint_primitives.fill(session, -1, Rectangle.{cast(float32)edge, cast(float32)band_top,
                    cast(float32)(crossing - edge), cast(float32)(band_bottom - band_top)}, 0.0, 4, color)
            }
            edge = crossing
        }
        if cast(float64)bounds.x + w > edge + 0.01 {
            paint_primitives.fill(session, -1, Rectangle.{cast(float32)edge, cast(float32)band_top,
                cast(float32)(cast(float64)bounds.x + w - edge), cast(float32)(band_bottom - band_top)},
                0.0, 4, stops.colors[last])
        }
    }
}

// Each side is a band inside the border box: top and bottom span its width,
// left and right the height between them.
LayoutPaintSides :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData,
    opacity: float32, uniform: float32) {
    widths: [4]float32
    colors: [4]Color
    for side: cast(u32)0..3 {
        widths[side] = uniform
        if (box.fields & (cast(u32)StyleBoxBorderTop << side)) != 0 { widths[side] = box.border_widths[side] }
        packed := face.border
        if (box.fields & (cast(u32)StyleBoxBorderTopColor << side)) != 0 { packed = box.border_colors[side] }
        colors[side] = ColorFromPacked(Opacity(packed, opacity))
    }
    middle := bounds.height - widths[0] - widths[2]
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y, bounds.width, widths[0]}, colors[0])
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y + bounds.height - widths[2], bounds.width, widths[2]}, colors[2])
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y + widths[0], widths[3], middle}, colors[3])
    LayoutPaintBand(session, Rectangle.{bounds.x + bounds.width - widths[1], bounds.y + widths[0], widths[1], middle}, colors[1])
}

LayoutPaintBand :: (session: Session, band: Rectangle, color: Color) {
    if band.width > 0.0 && band.height > 0.0 && color.a != cast(u8)0 {
        paint_primitives.fill(session, -1, band, 0.0, 8, color)
    }
}

LayoutPaintInstall :: () {
    if paint_primitives.mark == null { return }
    layout_box_paint = LayoutPaintBox
}
