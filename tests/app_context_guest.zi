#import "app_context"
#import "app_protocol"
#import "app_theme"
#import "drawing_props"
#import "vec"

#program_export
main :: () -> s32 {
    if AppMode() == APP_IDENTIFY {
        #if #defined(APP_BAD_API) {
            AppIdentity("diary", 2)
        } else {
            AppIdentity("diary")
        }
        AppDescribe("Diary", "")
        #if #defined(APP_IDENTIFY_WRITE) {
            unused DocumentWrite("entry.json", "wrong")
        }
        return APP_PROTOCOL
    }
    if AppMode() == APP_SAVE {
        // Built during the run, so the bundle reclaims it when the run returns.
        reply: Vec(u8)
        BuilderPrint(*reply, "{\"saved\":%,\"day\":%}", true, 18)
        AppReply(BuilderFinish(reply))
        return 0
    }
    if AppSupports("missing.service") { return 1 }
    if AppService("missing.service", "") != "{\"status\":\"unavailable\"}" { return 2 }
    if !DocumentWrite("entry.json", "a saved entry") { return 3 }
    // The host's theme colours; a token the host lacks keeps the app's own.
    accent := AppThemeColor("accent", Color.{1, 2, 3, 255})
    if accent.r != 46 || accent.g != 125 || accent.b != 104 || accent.a != 255 { return 4 }
    own := AppThemeColor("no-such-token", Color.{1, 2, 3, 255})
    if own.r != 1 || own.g != 2 || own.b != 3 { return 5 }
    return 0
}
