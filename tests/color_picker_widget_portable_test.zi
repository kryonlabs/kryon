#import "color_picker_widget_behavior"
#import "color_picker_widget_host"

#program_export
main :: () -> s32 {
    phase: s32 = 0
    while phase < 5 {
        // The preview is transparent until the alpha slider moves. Only
        // visible swatches reach the raster host.
        swatches: s32 = 0
        if phase >= 3 { swatches = phase - 2 }
        if Frame() != phase ||
        !HostCountsAre(swatches, (phase + 1) * 9) { return 1 }
        phase += 1
    }
    return 0
}
