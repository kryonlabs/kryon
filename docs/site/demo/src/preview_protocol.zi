#import "kryon/geometry"
// Raw observations shared by the portable app and the Canvas host.
#scope_export
PreviewInput :: struct {
    origin_x: float32
    origin_y: float32
    now: float32
    reduced_motion: bool
    width: float32
    height: float32
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
    secondary_down: bool
    secondary_pressed: bool
    secondary_released: bool
    key: s32
    modifiers: s32
    wheel: float32
    theme: s32
    disabled: bool
    space_held: bool
    focused: bool
}

host_api :: #system_library "host_api";
ReadPreviewInput :: () -> PreviewInput #foreign host_api;
ReadPreviewCodepoint :: () -> s32 #foreign host_api;

#program_export
PreviewInputRead :: () -> PreviewInput { return ReadPreviewInput() }

#program_export
PreviewCodepointRead :: () -> s32 { return ReadPreviewCodepoint() }

ReportPreviewNodeHost :: (key: u64, kind: s32, label: string, bounds: Rectangle, selected: bool, interactive: bool, disabled: bool) #foreign host_api;
ReportPreviewCursorHost :: (cursor: s32) #foreign host_api;

#program_export
ReportPreviewNode :: (key: u64, kind: s32, label: string, bounds: Rectangle, selected: bool, interactive: bool, disabled: bool) { ReportPreviewNodeHost(key, kind, label, bounds, selected, interactive, disabled) }

#program_export
ReportPreviewCursor :: (cursor: s32) { ReportPreviewCursorHost(cursor) }
