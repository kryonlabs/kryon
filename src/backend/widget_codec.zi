    codec.fields[6] = HostField.{.name = HostTextData("skip_node"), .value = HostScalar("s32", cast(s64)data.skip_node)}
    codec.fields[7].name = HostTextData("geometry")
    codec.fields[7].value = WidgetEncodeGuidedTourGeometry(data.geometry, *codec.geometry)
    codec.fields[8] = HostField.{.name = HostTextData("action"), .value = HostScalar("GuidedTour.GuidedTourAction", cast(s64)data.action)}
    codec.fields[9] = HostField.{.name = HostTextData("step"), .value = HostScalar("s32", cast(s64)data.step)}
    codec.fields[10] = HostField.{.name = HostTextData("visible"), .value = HostScalar("bool", ifx data.visible then 1 else 0)}
    codec.fields[11] = HostField.{.name = HostTextData("progress"), .value = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = cast(float64)data.progress}}
    codec.fields[12] = HostField.{.name = HostTextData("focus_wrapped"), .value = HostScalar("bool", ifx data.focus_wrapped then 1 else 0)}
    return value
