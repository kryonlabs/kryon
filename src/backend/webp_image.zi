// Static WebP selection for native hosts. The package owns RIFF parsing,
// native ABI and first-frame composition. Decode directly into host storage.
// A raylib page links no native codec: it uses the package's authored still
// image engine, VP8L and keyframe VP8 with alpha.
#if #defined(PLATFORM_WEB) {
    Authored :: #import "webp/authored";
} else {
    Webp :: #import "webp/facade";
}
Riff :: #import "webp/riff";
Codecs :: #import "image_codec/api";
Engine :: #import "webp/engine";
#import "std/byte_text_linux"
#import "ziran_image_decode"

WebPImageDecode :: (data: string, width: *s32, height: *s32) -> *u8 {
    width.* = 0; height.* = 0
    options := Engine.WebpDefaultOptions()
    // This host historically bounded WebP by total pixels, with no separate
    // 32768-axis restriction on an animation's composed canvas.
    options.limits.max_width = 67108864
    options.limits.max_height = 67108864
    options.limits.max_frames = 2147483647
    options.limits.max_metadata_bytes = options.limits.max_input_bytes
    input := ImageEncodedBytes(data)
    probe := Riff.WebpProbe(input, options.limits)
    if !probe.is_ok { return null }
    count := cast(s64)probe.metadata.width * probe.metadata.height * 4
    pixels := ImagePixelsAllocate(cast(usize)count)
    if pixels == null { return null }
    output := Codecs.OutputBuffer.{BytesFromPointer(pixels, cast(u64)count), cast(s64)probe.metadata.width * 4}
    result: Engine.WebpOutputResult
    #if #defined(PLATFORM_WEB) {
        result = Authored.WebpAuthoredDecodeInto(input, output, options)
    } else {
        result = Webp.WebpDecodeInto(input, output, options)
    }
    if !result.is_ok || result.metadata.width != probe.metadata.width || result.metadata.height != probe.metadata.height {
        ImagePixelsFree(pixels); return null
    }
    width.* = result.metadata.width; height.* = result.metadata.height
    return pixels
}
