// Icon IDs are stable across releases because applications persist them.
// The atlas positions follow icons/*.json; callers render the returned props
// through Image, including when the icon is decorative.
#program_export
ImageForIcon :: (icon_type: s32, bounds: Rectangle,
    alt_text: string) -> ImageProps {
    image: ImageProps
    image.bounds = bounds
    image.alt_text = alt_text
    index: s32 = -1
    columns: s32 = 1
    if icon_type >= 1 && icon_type <= 15 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 1
        columns = 8
    } else if icon_type >= 16 && icon_type <= 20 {
        image.asset_path = "icons/language.png"
        index = icon_type - 16
        columns = 5
    } else if icon_type >= 21 && icon_type <= 30 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 6
        columns = 8
    } else if icon_type >= 31 && icon_type <= 35 {
        image.asset_path = "icons/ui.png"
        if icon_type == 31 { index = 58 }
        if icon_type == 32 { index = 57 }
        if icon_type == 33 { index = 59 }
        if icon_type == 34 { index = 60 }
        if icon_type == 35 { index = 25 }
        columns = 8
    } else if icon_type >= 36 && icon_type <= 38 {
        image.asset_path = "icons/payments.png"
        index = icon_type - 36
        columns = 3
    } else if icon_type >= 39 && icon_type <= 40 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 13
        columns = 8
    } else if icon_type >= 41 && icon_type <= 65 {
        image.asset_path = "icons/pfp.png"
        index = icon_type - 41
        columns = 5
    } else if icon_type >= 66 && icon_type <= 88 {
        image.asset_path = "icons/platforms.png"
        index = icon_type - 66
        columns = 6
    } else if icon_type >= 89 && icon_type <= 91 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 61
        columns = 8
    } else if icon_type >= 92 && icon_type <= 93 {
        image.asset_path = "icons/logos.png"
        index = icon_type - 92
        columns = 2
    } else if icon_type >= 94 && icon_type <= 108 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 63
        columns = 8
    } else if icon_type >= 109 && icon_type <= 112 {
        image.asset_path = "icons/tiles.png"
        index = icon_type - 109
        columns = 4
    } else if icon_type >= 113 && icon_type <= 116 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 67
        columns = 8
    } else if icon_type == 117 {
        image.asset_path = "icons/ui.png"
        index = 56
        columns = 8
    } else if icon_type >= 118 && icon_type <= 123 {
        image.asset_path = "icons/ui.png"
        index = icon_type - 68
        columns = 8
    } else if icon_type >= 124 && icon_type <= 126 {
        image.asset_path = "icons/pfp.png"
        index = icon_type - 99
        columns = 5
    }
    if index >= 0 {
        image.source = Rectangle.{cast(float32)((index % columns) * 64),
            cast(float32)((index / columns) * 64), 64.0, 64.0}
    }
    return image
}

IconLayout :: struct {
    bounds: Rectangle
    size: s32
    drawable: bool
}

IconScaledPx :: (px: s32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(cast(float32)px * scale + 0.5)
}

IconClampPx :: (px: s32, min_px: s32, max_px: s32, scale: float32) -> s32 {
    value: s32 = IconScaledPx(px, scale)
    min_value: s32 = IconScaledPx(min_px, scale)
    max_value: s32 = IconScaledPx(max_px, scale)
    if value < min_value { value = min_value }
    if value > max_value { value = max_value }
    return value
}

#program_export
IconButtonSizeFor :: (kind: s32, scale: float32) -> s32 {
    if kind == 0 { return IconClampPx(12, 10, 18, scale) }
    if kind == 2 { return IconClampPx(16, 14, 24, scale) }
    if kind == 3 { return IconClampPx(20, 18, 28, scale) }
    return IconClampPx(14, 12, 20, scale)
}

#program_export
IconButtonPaddingFor :: (kind: s32, scale: float32) -> s32 {
    if kind == 0 { return IconScaledPx(4, scale) }
    if kind == 2 { return IconScaledPx(6, scale) }
    if kind == 3 { return IconScaledPx(7, scale) }
    return IconScaledPx(5, scale)
}

#program_export
IconLayoutFor :: (x: s32, y: s32, size: s32) -> IconLayout {
    layout: IconLayout
    layout.size = size
    if layout.size < 0 { layout.size = 0 }
    layout.bounds.x = cast(float32)x
    layout.bounds.y = cast(float32)y
    layout.bounds.width = cast(float32)layout.size
    layout.bounds.height = cast(float32)layout.size
    layout.drawable = layout.size > 0
    return layout
}
