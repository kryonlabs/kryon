// Keyboard focus contracts, run as one table of cases: a focused editable
// text field asks the host for the platform keyboard, and a press keeps or
// moves the focus only when it lands.
#import "session"
#import "widget_test_session"
Button :: #import "kryon/button";
TextField :: #import "kryon/text_field";
#import "geometry"
#import "text_input_platform"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "ziran_widget_noop_host"
#import "ziran_button_widget_host"
#import "ziran_composition_widget_host"
#import "system_clipboard_host"

using FrameStatus;

focused: bool;
request_focus: bool;
clicks: s32;

// A text field above a button, as Lumi's composer sits beside its command
// list. Returns 1 when the field is focused, 0 when not, -1 on a bad frame.
Frame :: () -> s32 {
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 200.0})
    field: TextField.Props = .{.key = cast(u64)77, .bounds = Rectangle.{20.0, 20.0, 220.0, 36.0},
        .value = "/", .label = "Message", .cursor = 1, .anchor = 1, .focused = focused,
        .focus_id = 77}
    field.input.focus = request_focus
    result: TextField.Result = TextField.Draw(TestSession(), field)
    button: Button.Props
    button.key = cast(u64)88
    button.id = 88
    button.label = "/todo"
    button.bounds = Rectangle.{20.0, 100.0, 80.0, 30.0}
    clicks += Button.Draw(TestSession(), button)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk { return -1 }
    focused = result.focused
    request_focus = false
    if result.focused { return 1 }
    return 0
}

Press :: (x: float32, y: float32) {
    unused TreePointerUpdate(TestSession(), PointerFrame.{x, y, true, true, false})
}

Release :: (x: float32, y: float32) {
    unused TreePointerUpdate(TestSession(), PointerFrame.{x, y, false, false, true})
}

PressFocus :: () -> s32 {
    // The field asks for the focus once it exists, as Lumi's composer does.
    if Frame() != 0 { return 1 }
    request_focus = true
    if Frame() != 1 || !TreeHasFocus(TestSession()) { return 1 }
    // A press on the button that a scroll then takes over keeps the field
    // focused throughout, so the keyboard stays open.
    Press(40.0, 115.0)
    if Frame() != 1 { return 2 }
    TreePointerCancel(TestSession())
    Release(40.0, 115.0)
    if Frame() != 1 || clicks != 0 { return 3 }
    // A click on the button still takes the focus when it lands.
    Press(40.0, 115.0)
    if Frame() != 1 { return 4 }
    Release(40.0, 115.0)
    if Frame() != 0 || clicks != 1 { return 5 }
    // Without a focused field, a press focuses at once, and a press on a
    // text field always does.
    Press(100.0, 38.0)
    if Frame() != 1 { return 6 }
    Release(100.0, 38.0)
    if Frame() != 1 { return 7 }
    return 0
}

DrawField :: (session: Session, focused: bool, read_only: bool,
    disabled: bool) -> bool {
    props: TextField.Props = .{.key = cast(u64)41, .bounds = Rectangle.{20.0, 20.0, 220.0, 36.0},
        .value = "Diary", .label = "Entry", .cursor = 5, .anchor = 5, .focused = focused,
        .focus_id = 41, .read_only = read_only, .disabled = disabled}
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 100.0})
    unused TextField.Draw(session, props)
    return EndFrame(session) == cast(FrameStatus)FrameOk
}

TextInputFocus :: () -> s32 {
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    if TextInputFocused(session) { return 2 }
    if !DrawField(session, true, false, false) { return 3 }
    if !TextInputFocused(session) { return 4 }
    // The focus seen last frame still holds until the next frame ends.
    if !DrawField(session, false, false, false) { return 5 }
    if !TextInputFocused(session) { return 6 }
    if !DrawField(session, false, false, false) { return 7 }
    if TextInputFocused(session) { return 8 }
    if !DrawField(session, true, true, false) { return 9 }
    if TextInputFocused(session) { return 10 }
    if !DrawField(session, true, false, true) { return 11 }
    if TextInputFocused(session) { return 12 }
    // A closed Session never reports a keyboard for a reopened one.
    if !DrawField(session, true, false, false) { return 13 }
    unused SessionClose(session)
    reopened := SessionOpen()
    if TextInputFocused(reopened) { return 14 }
    return 0
}

// Each case returns 0 or its own failure code; a failure reports the case
// number in the hundreds.
#program_export
main :: () -> s32 {
    for index: cast(s32)0..1 {
        failure: s32
        if index == 0 { failure = PressFocus() } else { failure = TextInputFocus() }
        if failure != 0 { return (index + 1) * 100 + failure }
    }
    return 0
}
