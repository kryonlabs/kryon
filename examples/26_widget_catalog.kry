#import "kryon.h"

app "Kryon Widget Catalog" {
    size 1200 800
    fps 60
    font examples
}

state {
    demo_texture: Texture2D = {0}
    image_path: const char * = "icons/tiles.png"
    menu_items: [2] MenuItem = {{MenuCommand,"Open",NULL,1,0,0,NULL,0},{MenuCommand,"Save",NULL,2,0,0,NULL,0}}
    menus: [1] Menu = {{{0},"File",menu_items,2}}
    action_count: int = 0
    category: int = 0
    category_names: [10] const char * = {"Display & media","Actions & input","Layout & containers","Collections & editors","Navigation","Feedback & dialogs","Canvas","Numbers & plots","Colors","Pages & settings"}
    category_heights: [10] int = {760,760,400,1020,680,660,400,1060,540,740}
    numbers: [3] float = {0.25f,0.5f,0.75f}
    integers: [3] int = {2,5,8}
    doubles: [2] double = {0.25,0.75}
    plot: [8] float = {0.2f,0.5f,0.3f,0.8f,0.6f,0.9f,0.4f,0.7f}
    rgba: [4] float = {0.3f,0.6f,0.8f,1.0f}
    range_min: float = 2.0f
    range_max: float = 8.0f
    int_min: int = 2
    int_max: int = 8
    angle: float = 0.0f
    selected: int = 0
    flags: int = 1
    multi_selected: [3] int = {0}
    multi_count: int = 0
    multi_anchor: int = -1
    accepted_size: int = 0
    open_tabs: [8] Tab = {{.label = "One", .closeable = 1},{.label = "Two", .closeable = 1}}
    tab_labels: [8] const char * = {"One","Two","Three","Four","Five","Six","Seven","Eight"}
    tab_count: int = 2
    tab_selected: int = 0
    subtab_selected: int = 0
    pane_selected: int = 0
    pane_dragged: int = -1
    subtabs: [3] Subtab = {{.label = "Overview"},{.label = "Details"},{.label = "History"}}
    cascade_items: [4] UICascadingTreeItem = {{"Project",0,10,1,1},{"Sources",1,11,1,1},{"main.kry",2,12,0,1},{"README",1,13,0,1}}
    cascade_ids: [4] int = {10}
    cascade_count: int = 1
    cascade_selected: int = 10
    cascade_activated: int = -1
    cascade_scroll: int = 0
    page_preview: int = 0
    page_route: int = 0
    nav_items: [3] BottomNavItem = {{.route = 0,.label = "Home"},{.route = 1,.label = "Explore"},{.route = 2,.label = "Settings"}}
    theme_source: int = 0
    theme_mode: int = 2
    theme_style: int = 1
    theme_state: UIThemeSettingsState = {0}
    theme_result: UIThemeSettingsResult = {0}
    theme_initialized: int = 0
    menu_command: int = 0
    picker_choice: int = -1
    dialog_result: int = 0
    canvas_dragging: int = 0
    canvas_last: Vector2 = {0}
    closed_tab: int = -1
    scroll_off: int = 0
    open_menu: int = -1
    context_open: int = 0
    context_x: int = 0
    context_y: int = 0
    theme_id: int = 0
    dark_mode: int = 0
    picked: int = 0
    slider_value: int = 42
    toggle_value: int = 0
    checkbox_value: int = 1
    text_cursor: int = 5
    text_focused: int = 0
    area_cursor: int = 12
    area_focused: int = 0
    area_scroll: int = 0
    list_scroll: int = 0
    tree_selected: int = 1
    table_selected_row: int = 0
    table_selected_column: int = 0
    table_activated_row: int = -1
    table_activated_column: int = -1
    table_right_row: int = -1
    table_right_column: int = -1
    canvas_scroll_x: int = 0
    canvas_scroll_y: int = 0
    canvas_zoom: float = 1.0f
    split: int = 90
    open: bool = true
    dialog: int = 0
    color_value: Color = {88,201,235,255}
    text_value: [64] char = "Hello"
    area_value: [128] char = "Editable text area"
    choices: [3] const char * = {"Alpha","Beta","Gamma"}
    display_lines: [2] const char * = {"Text lines: first","Text lines: second"}
    columns: [2] const char * = {"Name","Value"}
    cells_a: [2] const char * = {"Alpha","1"}
    cells_b: [2] const char * = {"Beta","2"}
    rows: [2] TableRow = {{.cells = cells_a, .cell_count = 2},{.cells = cells_b, .cell_count = 2}}
    widths: [2] int = {150,90}
    tree_items: [2] UITreeItem = {{"Root",0,1,1,1},{"Child",1,2,0,1}}
    tabs: [2] const Tab = {{.label = "One"},{.label = "Two"}}
}

WidgetCatalogExample :: (viewport: Rectangle) #ui {
    # Keep both columns and every sidebar category reachable in smaller windows.
    density: float = GetWindowScaleDPI().x
    if density > viewport.width / 1120.0f { density = viewport.width / 1120.0f }
    if density > viewport.height / 640.0f { density = viewport.height / 640.0f }
    SetUIScale(density)
    SetExitKey(KEY_NULL)
    if demo_texture.id == 0 {
        if !FileExists(image_path) {
            image_path = "../icons/tiles.png"
        }
        demo_image: Image = LoadImage(image_path)
        ImageCrop(&demo_image, (Rectangle){0,0,64,64})
        demo_texture = LoadTextureFromImage(demo_image)
        UnloadImage(demo_image)
    }
    if theme_initialized == 0 {
        dark_mode = GetEffectiveThemeDarkMode()
        theme_mode = GetThemeMode()
        theme_style = GetThemeStyle()
        theme_source = GetThemeSource()
        theme_initialized = 1
    }
    if page_preview {
        Screen preview: {
            bounds = viewport
            ClearBackground(GetThemeBackground())
            TitleBar("TitleBar / BottomNav preview", ScaleUIPx(54))
            if Button((ButtonProps){.bounds = {ScaleUIPx(20),ScaleUIPx(72),ScaleUIPx(180),ScaleUIPx(36)}, .label = "Back to catalog", .id = 950}) {
                page_preview = 0
            }
            Text((TextProps){.bounds={ScaleUIPx(230), ScaleUIPx(80), 0, 0}, .text=TextFormat("Selected route: %d", page_route), .font=Text20, .color=GetThemeText(), .wrap=TextWrapNone})
            nav_index: int = 0
            for nav_index = 0; nav_index < 3; nav_index++ {
                nav_items[nav_index].active = page_route == nav_index
            }
            nav_result: BottomNavResult = BottomNav((BottomNavProps){.view_width = (int)viewport.width,.view_height = (int)viewport.height,.count = 3,.items = nav_items,.height = ScaleUIPx(64)})
            if nav_result.clicked_index >= 0 {
                page_route = nav_result.clicked_route
            }
        }
        return
    }
    Screen root: {
        bounds = viewport
        ClearBackground(GetThemeBackground())
        Text((TextProps){.bounds={ScaleUIPx(20), ScaleUIPx(22), 0, 0}, .text="Widget catalog", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={ScaleUIPx(246), ScaleUIPx(28), 0, 0}, .text="Standard Kryon controls. Select a category and try them.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Line(ScaleUIPx(220), ScaleUIPx(76), ScaleUIPx(220), (int)viewport.height - ScaleUIPx(24), GetThemeButton())
        i: int = 0
        for i = 0; i < 10; i++ {
            if Button((ButtonProps){.bounds = {ScaleUIPx(16),ScaleUIPx(86 + i * 46),ScaleUIPx(190),ScaleUIPx(38)}, .label = category_names[i], .font = Text14, .id = 900 + i, .style = category == i ? ButtonStylePrimary : ButtonStyleSecondary}) {
                category = i
                scroll_off = 0
                open_menu = -1
                context_open = 0
            }
        }
        Text((TextProps){.bounds={ScaleUIPx(20), (int)viewport.height - ScaleUIPx(52), 0, 0}, .text="Wheel to scroll", .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={ScaleUIPx(20), (int)viewport.height - ScaleUIPx(30), 0, 0}, .text=TextFormat("Clicks: %d", action_count), .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})

        area: UIScrollArea = {{ScaleUIPx(236), ScaleUIPx(82), (int)viewport.width - ScaleUIPx(252), (int)viewport.height - ScaleUIPx(100)}, ScaleUIPx(category_heights[category]), ScaleUIPx(252), (int)viewport.width - ScaleUIPx(292), &scroll_off, ScaleUIPx(42), 0}
        view: UIScrollView = BeginUIScrollContainer(area)
        x: int = view.content_x
        right: int = x + ScaleUIPx(410)
        y: int = view.content_y

        if category == 0 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="DISPLAY AND MEDIA", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + ScaleUIPx(38), 0, 0}, .text="Text", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds=(Rectangle){x, y + ScaleUIPx(70), ScaleUIPx(300), ScaleUIPx(52)}, .text="Text is bounded, wrapped, and clipped by default.", .font=Text16, .color=GetThemeText(), .align=TextAlignCenter, .vertical_align=TextAlignCenter})
        lines_y: int = y + ScaleUIPx(132)
        TextLines(display_lines, 2, x, &lines_y, Text14, ScaleUIPx(18), GetThemeIcon())
        paragraph_y: int = y + ScaleUIPx(176)
        Paragraph((ParagraphSpec){.text = "A short paragraph with an icon.", .icon_type = 1, .icon_size = ScaleUIPx(16), .width = ScaleUIPx(300), .font = Text16, .line_gap = ScaleUIPx(4), .color = GetThemeText()}, x, &paragraph_y)
        Rect(right, y + ScaleUIPx(38), ScaleUIPx(120), ScaleUIPx(54), GetThemeSurface(), GetThemeButton())
        Line(right, y + ScaleUIPx(110), right + ScaleUIPx(120), y + ScaleUIPx(110), GetThemeLink())
        Bevel(right, y + ScaleUIPx(132), ScaleUIPx(120), ScaleUIPx(34), GetThemeSurface(), GetThemeButton())
        Icon(100, right + ScaleUIPx(150), y + ScaleUIPx(46), ScaleUIPx(28), 1, GetThemeIcon())
        LabelFrame((LabelFrameProps){.bounds = {right + ScaleUIPx(200), y + ScaleUIPx(36), ScaleUIPx(150), ScaleUIPx(58)}, .title = "Label frame"})
        ImageBox((ImageBoxProps){.bounds = {right + ScaleUIPx(200), y + ScaleUIPx(112), ScaleUIPx(58), ScaleUIPx(58)}, .texture = demo_texture, .tint = WHITE})
        Picture((PictureProps){.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right + ScaleUIPx(278), y + ScaleUIPx(112), ScaleUIPx(72), ScaleUIPx(58)}, .tint = WHITE, .fit = PICTURE_FIT_CONTAIN})

        Text((TextProps){.bounds={x, y + ScaleUIPx(260), 0, 0}, .text="Custom color", .font=Text16, .color=GetThemeLink(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + ScaleUIPx(300), 0, 0}, .text="Disabled text", .font=Text16, .wrap=TextWrapNone, .disabled=1})
        Text((TextProps){.bounds=(Rectangle){x,y + ScaleUIPx(340),ScaleUIPx(320),ScaleUIPx(60)}, .text="Bounded text wraps and clips inside its standard bounds.", .font=Text16, .color=GetThemeText()})
        LabelText("LabelText", "Value", (Rectangle){x,y + ScaleUIPx(418),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        BulletText("BulletText", (Rectangle){x,y + ScaleUIPx(460),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        selectable_token: int = PushTextSelectable(1)
        Text((TextProps){.bounds={x, y + ScaleUIPx(510), 0, 0}, .text="Select and copy this text.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        PopTextSelectable(selectable_token)
        ValueBool("ValueBool", true, (Rectangle){right,y + ScaleUIPx(260),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        ValueInt("ValueInt", 42, (Rectangle){right,y + ScaleUIPx(300),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        ValueUInt("ValueUInt", 42, (Rectangle){right,y + ScaleUIPx(340),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        ValueFloat("ValueFloat", 0.5f, "%.2f", (Rectangle){right,y + ScaleUIPx(380),ScaleUIPx(300),ScaleUIPx(28)}, Text16, GetThemeText())
        ImageWithBg((ImageWithBgProps){.picture = {.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right,y + ScaleUIPx(500),ScaleUIPx(80),ScaleUIPx(80)}, .tint = WHITE, .fit = PICTURE_FIT_CONTAIN}, .background = GetThemeSurface()})
        if ImageButton((ImageButtonProps){.picture = {.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right + ScaleUIPx(110),y + ScaleUIPx(500),ScaleUIPx(80),ScaleUIPx(80)}, .tint = WHITE, .fit = PICTURE_FIT_CONTAIN}, .background = GetThemeSurface(), .id = 210}) {
            action_count += 1
            ShowToast("ImageButton clicked")
        }
        Text((TextProps){.bounds={right, y + ScaleUIPx(606), 0, 0}, .text="ImageWithBg / ImageButton", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        SeparatorText((SeparatorTextProps){.bounds = {x,y + ScaleUIPx(570),ScaleUIPx(350),ScaleUIPx(30)}, .label = "SeparatorText"})
        Bullet((Rectangle){right,y + ScaleUIPx(460),ScaleUIPx(24),ScaleUIPx(24)})
        }

        if category == 1 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="ACTIONS AND INPUT", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        if Button((ButtonProps){.bounds = {x, y + ScaleUIPx(38), ScaleUIPx(140), ScaleUIPx(34)}, .label = "Button", .font = Text16, .id = 101}) {
            action_count += 1
        }
        if IconButton((IconButtonProps){.bounds = {x + ScaleUIPx(154), y + ScaleUIPx(38), ScaleUIPx(34), ScaleUIPx(34)}, .icon_type = 1, .focus_id = 102}) {
            action_count += 1
        }
        Href((HrefProps){.bounds = {x + ScaleUIPx(204), y + ScaleUIPx(40), ScaleUIPx(100), ScaleUIPx(30)}, .text = "Kryon Labs", .href = "https://kryonlabs.com", .font = Text16, .focus_id = 103, .color = GetThemeLink(), .hover_color = GetThemeLink()})
        TextField((TextFieldProps){.bounds = {right, y + ScaleUIPx(38), ScaleUIPx(260), ScaleUIPx(34)}, .text = text_value, .text_size = sizeof(text_value), .cursor_position = &text_cursor, .focused = &text_focused, .max_codepoints = 63, .font = Text16, .focus_id = 104})
        TextArea((TextAreaProps){.bounds = {right, y + ScaleUIPx(86), ScaleUIPx(300), ScaleUIPx(76)}, .text = area_value, .text_size = sizeof(area_value), .cursor_position = &area_cursor, .focused = &area_focused, .scroll_y = &area_scroll, .max_codepoints = 127, .font = Text16, .line_gap = ScaleUIPx(4), .focus_id = 105, .placeholder = "Notes", .syntax = SyntaxNone})

        y += ScaleUIPx(190)
        Dropdown(106, x, y, ScaleUIPx(180), ScaleUIPx(32), choices, 3, &picked)
        Slider(107, x, y + ScaleUIPx(46), ScaleUIPx(250), "Slider", 0, 100, &slider_value, "%", nil)
        Toggle(108, x, y + ScaleUIPx(92), ScaleUIPx(130), ScaleUIPx(30), &toggle_value, "Off", "On")
        Checkbox(109, x, y + ScaleUIPx(140), "Checkbox", &checkbox_value)
        if Radio((RadioButtonProps){{right, y, ScaleUIPx(130), ScaleUIPx(28)}, "Radio", 129, picked == 1, 0}) {
            picked = 1
        }
        Spinbox((SpinboxProps){.bounds = {right, y + ScaleUIPx(44), ScaleUIPx(140), ScaleUIPx(32)}, .id = 110, .min = 0, .max = 100, .step = 1, .value = &slider_value, .value_text = nil, .wrap = 0})
        Combobox((ComboboxProps){{right, y + ScaleUIPx(92), ScaleUIPx(180), ScaleUIPx(32)}, 111, choices, 3, &picked, 0})
        Progress((ProgressBarProps){{right, y + ScaleUIPx(140), ScaleUIPx(220), ScaleUIPx(24)}, 0, 100, slider_value, "Progress"})
        ColorPicker((Rectangle){right + ScaleUIPx(240), y, ScaleUIPx(120), ScaleUIPx(120)}, &color_value)

        if SmallButton((ButtonProps){.bounds = {x,y + ScaleUIPx(204),ScaleUIPx(120),ScaleUIPx(28)}, .label = "SmallButton", .id = 200}) {
            action_count += 1
        }
        if ArrowButton((ArrowButtonProps){.bounds = {x + ScaleUIPx(140),y + ScaleUIPx(204),ScaleUIPx(32),ScaleUIPx(28)}, .id = 201, .direction = ARROW_RIGHT}) {
            action_count += 1
        }
        Selectable((SelectableProps){.bounds = {x,y + ScaleUIPx(250),ScaleUIPx(300),ScaleUIPx(32)}, .id = 202, .label = "Selectable", .selected = &selected})
        CheckboxFlags((CheckboxFlagsProps){.bounds = {right,y + ScaleUIPx(204),ScaleUIPx(300),ScaleUIPx(32)}, .id = 203, .label = "CheckboxFlags", .flags = &flags, .flags_value = 1})
        Text((TextProps){.bounds={right, y + ScaleUIPx(258), 0, 0}, .text="InvisibleButton (click this area)", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        if InvisibleButton((InvisibleButtonProps){.bounds = {right,y + ScaleUIPx(250),ScaleUIPx(300),ScaleUIPx(32)}, .id = 204}) {
            action_count += 1
            ShowToast("InvisibleButton clicked")
        }
        BeginDisabled(1)
        if Button((ButtonProps){.bounds = {x,y + ScaleUIPx(310),ScaleUIPx(180),ScaleUIPx(34)}, .label = "Disabled button", .id = 205}) {
            action_count += 1
        }
        EndDisabled()
        Popup disabled_help: {
            bounds = {x + ScaleUIPx(188),y + ScaleUIPx(304),ScaleUIPx(256),ScaleUIPx(48)}
            id = 206
            trigger = {x,y + ScaleUIPx(310),ScaleUIPx(180),ScaleUIPx(34)}
            flags = PopupTooltip
            Text((TextProps){.bounds={x + ScaleUIPx(196),y + ScaleUIPx(316),ScaleUIPx(240),ScaleUIPx(22)},.text="A standard tooltip",.font=Text14,.color=GetThemeText(),.wrap=TextWrapNone})
        }
        }

        if category == 2 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="LAYOUT AND CONTAINERS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        Column demo_column: {
            bounds = {x, y + ScaleUIPx(38), ScaleUIPx(190), ScaleUIPx(92)}
            gap = ScaleUIPx(6)
            padding = ScaleUIPx(8)
            Text((TextProps){.bounds={0, 0, 0, 0}, .text="Column", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Row demo_row: {
                bounds = {0, 0, ScaleUIPx(170), ScaleUIPx(34)}
                gap = ScaleUIPx(6)
                if Button((ButtonProps){.bounds = {0,0,ScaleUIPx(72),ScaleUIPx(30)}, .label = "Row A", .id = 112}) {
                    action_count += 1
                }
                if Button((ButtonProps){.bounds = {0,0,ScaleUIPx(72),ScaleUIPx(30)}, .label = "Row B", .id = 113}) {
                    action_count += 1
                }
            }
        }
        Stack demo_stack: {
            bounds = {x + ScaleUIPx(214), y + ScaleUIPx(38), ScaleUIPx(160), ScaleUIPx(92)}
            key = Key("catalog-stack")
            Rect(x + ScaleUIPx(214), y + ScaleUIPx(38), ScaleUIPx(160), ScaleUIPx(92), GetThemeSurface(), GetThemeButton())
            Text((TextProps){.bounds={x + ScaleUIPx(258), y + ScaleUIPx(70), 0, 0}, .text="Stack", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        }
        GridLayout((GridLayoutProps){.bounds = {x, y + ScaleUIPx(148), ScaleUIPx(374), ScaleUIPx(48)}, .columns = 2, .gap = ScaleUIPx(6)})
        if Button((ButtonProps){.bounds = {0,0,ScaleUIPx(150),ScaleUIPx(32)}, .label = "Grid A", .id = 124}) {
            action_count += 1
        }
        if Button((ButtonProps){.bounds = {0,0,ScaleUIPx(150),ScaleUIPx(32)}, .label = "Grid B", .id = 125}) {
            action_count += 1
        }
        End()
        Notebook((NotebookProps){.bounds = {right, y + ScaleUIPx(38), ScaleUIPx(180), ScaleUIPx(54)}, .tabs = choices, .tab_count = 3, .selected_index = &picked})
        PanedView((PanedViewProps){{right + ScaleUIPx(198), y + ScaleUIPx(38), ScaleUIPx(180), ScaleUIPx(54)}, 114, 1, &split, 60, 80})
        Text((TextProps){.bounds={right + ScaleUIPx(198), y + ScaleUIPx(8), 0, 0}, .text="Drag the divider", .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        Collapsible((CollapsibleProps){.bounds = {right, y + ScaleUIPx(108), ScaleUIPx(260), ScaleUIPx(54)}, .label = "Collapsible", .open = &open})
        if open {
            Text((TextProps){.bounds={right, y + ScaleUIPx(174), 0, 0}, .text="This content collapses with its header.", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        }

        }

        if category == 3 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="COLLECTIONS AND EDITORS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        ListBox((ListBoxProps){.bounds = {x, y + ScaleUIPx(38), ScaleUIPx(180), ScaleUIPx(90)}, .id = 115, .items = choices, .item_count = 3, .selected_index = &picked, .scroll_offset = &list_scroll, .row_height = ScaleUIPx(26)})
        TreeView((TreeViewProps){.bounds = {x + ScaleUIPx(198), y + ScaleUIPx(38), ScaleUIPx(180), ScaleUIPx(90)}, .id = 116, .items = tree_items, .item_count = 2, .selected_id = &tree_selected, .scroll_offset = &list_scroll, .row_height = ScaleUIPx(26)})
        SourceView((SourceViewProps){.bounds = {right, y + ScaleUIPx(38), ScaleUIPx(360), ScaleUIPx(90)}, .text = "Text(\"Hello\")", .scroll_x = &canvas_scroll_x, .scroll_y = &canvas_scroll_y, .font_size = Text14, .line_height = ScaleUIPx(18), .show_line_numbers = 1})
        TableView((TableViewProps){.bounds = {x, y + ScaleUIPx(148), ScaleUIPx(378), ScaleUIPx(100)}, .id = 117, .columns = columns, .column_count = 2, .rows = rows, .row_count = 2, .column_widths = widths, .selected_row = &table_selected_row, .selected_column = &table_selected_column, .activated_row = &table_activated_row, .activated_column = &table_activated_column, .right_clicked_row = &table_right_row, .right_clicked_column = &table_right_column})

        Text((TextProps){.bounds={x, y + ScaleUIPx(290), 0, 0}, .text="MultiSelectList (Ctrl / Shift to select)", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        MultiSelectList((MultiSelectListProps){.bounds = {x,y + ScaleUIPx(330),ScaleUIPx(350),ScaleUIPx(110)}, .id = 206, .items = choices, .item_count = 3, .selected = multi_selected, .selected_count = &multi_count, .anchor = &multi_anchor, .row_height = ScaleUIPx(30)})
        Text((TextProps){.bounds={x, y + ScaleUIPx(480), 0, 0}, .text="Drag text from the left into the right box", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(x,y + ScaleUIPx(522),ScaleUIPx(300),ScaleUIPx(48),GetThemeSurface(),GetThemeButton())
        Text((TextProps){.bounds={x + ScaleUIPx(12), y + ScaleUIPx(538), 0, 0}, .text="DragDropSource", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        DragDropSource((DragDropSourceProps){.bounds = {x,y + ScaleUIPx(522),ScaleUIPx(300),ScaleUIPx(48)}, .id = 207, .type = "TEXT", .data = text_value, .data_size = sizeof(text_value)})
        Rect(right,y + ScaleUIPx(522),ScaleUIPx(300),ScaleUIPx(48),GetThemeSurface(),GetThemeButton())
        Text((TextProps){.bounds={right + ScaleUIPx(12), y + ScaleUIPx(538), 0, 0}, .text="DragDropTarget", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        DragDropTarget((DragDropTargetProps){.bounds = {right,y + ScaleUIPx(522),ScaleUIPx(300),ScaleUIPx(48)}, .id = 208, .type = "TEXT", .output = area_value, .output_size = sizeof(area_value), .accepted_size = &accepted_size})
        Text((TextProps){.bounds={right, y + ScaleUIPx(590), 0, 0}, .text=area_value, .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        }

        if category == 4 {
