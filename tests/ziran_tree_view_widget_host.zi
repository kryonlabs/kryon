#import "drawing_props"
#import "geometry"

fills: s32;
labels: s32;
failed: bool;

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    unused value
    unused font
    unused typeface
    return 0
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused radius
    unused segments
    unused color
    if bounds.x < 10.0 || bounds.y < 10.0 ||
        bounds.x + bounds.width > 130.0 ||
        bounds.y + bounds.height > 58.0 { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused radius
    unused segments
    unused width
    unused color
    if bounds.x != 10.0 || bounds.y != 10.0 ||
        bounds.width != 120.0 || bounds.height != 48.0 { failed = true }
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused value
    unused x
    unused y
    unused color
    if font != 14 || clip.x < 10.0 || clip.y < 10.0 ||
        clip.x + clip.width > 130.0 ||
        clip.y + clip.height > 58.0 { failed = true }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
TreeViewHostFailed :: () -> bool { return failed }

#program_export
TreeViewLabelCount :: () -> s32 { return labels }

#program_export
TreeViewFillCount :: () -> s32 { return fills }
