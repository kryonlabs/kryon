Components :: #import "component_slot";
Bitmaps :: #import "bitmap_state";
using Keys :: #import "widget_key";

// A value handle is portable across native code and Ziran bundles.
// Slot zero is invalid; an epoch rejects handles after their slot closes.
Session :: struct {
    slot: s32
    epoch: u64
}

// How many sessions can be open at once; every per-slot table sizes itself
// with this.
SessionSlotCount :: 9;

session_active: u32;
session_epochs: [SessionSlotCount]u64;

#program_export
SessionValid :: (session: Session) -> bool {
    return SessionIndex(session) != 0
}

#program_export
SessionIndex :: (session: Session) -> s32 {
    if session.slot > 0 && session.slot < SessionSlotCount &&
        (session_active & (cast(u32)1 << cast(u32)session.slot)) != cast(u32)0 &&
        session_epochs[session.slot] == session.epoch {
        return session.slot
    }
    return 0
}

#program_export
SessionOpen :: () -> Session {
    result: Session
    slot: s32 = 1
    while slot < SessionSlotCount {
        mask := cast(u32)1 << cast(u32)slot
        if (session_active & mask) == cast(u32)0 &&
            session_epochs[slot] != cast(u64)18446744073709551615 {
            session_epochs[slot] += cast(u64)1
            session_active = session_active | mask
            result.slot = slot
            result.epoch = session_epochs[slot]
            return result
        }
        slot += 1
    }
    return result
}

#program_export
SessionClose :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    if !Components.ComponentDisposeOwner(session.slot, session.epoch) { return false }
    Bitmaps.BitmapDisposeOwner(session.slot, session.epoch)
    session_active = session_active & ~(cast(u32)1 << cast(u32)session.slot)
    return true
}

// Slot flags include the invalid slot zero, matching per-session storage.
SessionFlagGet :: (flags: u32, slot: s32) -> bool {
    if slot < 0 || slot >= SessionSlotCount { return false }
    return (flags & (cast(u32)1 << cast(u32)slot)) != cast(u32)0
}

SessionFlagSet :: (flags: u32, slot: s32, value: bool) -> u32 {
    if slot < 0 || slot >= SessionSlotCount { return flags }
    mask := cast(u32)1 << cast(u32)slot
    if value { return flags | mask }
    return flags & ~mask
}
