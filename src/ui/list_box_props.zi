#import "geometry"
#import "list_box_multi"

# Items are borrowed for one frame. Nonzero keys preserve row identity when
# items move; zero keys use their current index.
ListBoxItem :: struct {
    key: u64
    label: string
}

# The caller stores returned selection and scroll values between frames.
ListBoxProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    selected_index: s32
    scroll_offset: s32
    scroll_delta: s32
    row_height: s32
    scale: float32
    focused: bool
    navigation: s32
    disabled: bool
}

ListBoxResult :: struct {
    node: s32
    selected_index: s32
    scroll_offset: s32
    changed: bool
}

# Selection is a caller-owned mutable bool slice passed to ListBoxMulti.
# It must contain one element per item. Anchor and scroll remain values.
ListBoxMultiProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    anchor: s32
    scroll_offset: s32
    scroll_delta: s32
    row_height: s32
    scale: float32
    focused: bool
    navigation: ListBoxMultiInput
    control: bool
    shift: bool
    disabled: bool
}

ListBoxMultiResult :: struct {
    node: s32
    clicked_index: s32
    anchor: s32
    scroll_offset: s32
    selected_count: s32
    changed: bool
    valid: bool
}
