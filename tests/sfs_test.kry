#module "sfs_test"
#import "kryon.h"
#import "kry_inject.h"
#import "kry_sfs.h"
#import "ui/kryon_test.h"
#import "ui_inspect_props.generated.h"
#import "ui_widget_internal.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

SfsRequire :: (condition: i32, message: const char*) {
    if condition { return }
    fprintf(stderr, "SFS failed: %s\n", message)
    exit(1)
}

SfsContains :: (label: const char*, path: const char*,
expected: const char*) {
    buf: [256]char
    n: i32 = KrySfsRead(path, &buf[0], sizeof(buf))
    if n <= 0 || strstr(&buf[0], expected) == nil {
        fprintf(stderr, "SFS failed: %s: %s\n", label, path)
        exit(1)
    }
}

SfsRootChecks :: () {
    entries: [16]KrySfsEntry
    buf: [8]char
    count: i32 = KrySfsList("/", &entries[0], 16)
    SfsRequire(count == 4, "root entry count")
    has_info: i32 = 0
    has_input: i32 = 0
    has_widgets: i32 = 0
    has_theme: i32 = 0
    i: i32 = 0
    while i < count {
        has_info |= strcmp(&entries[i].name[0], "info") == 0 &&
        !entries[i].is_dir
        has_input |= strcmp(&entries[i].name[0], "input") == 0 &&
        entries[i].is_dir
        has_widgets |= strcmp(&entries[i].name[0], "widgets") == 0 &&
        entries[i].is_dir
        has_theme |= strcmp(&entries[i].name[0], "theme") == 0 &&
        entries[i].is_dir
        i += 1
    }
    SfsRequire(has_info && has_input && has_widgets && has_theme,
    "root entry names")
    SfsContains("info", "/info", "kryon")
    SfsRequire(KrySfsIsDir("/input"), "input directory")
    SfsRequire(!KrySfsIsDir("/info"), "info file")
    SfsRequire(KrySfsRead("/nope", &buf[0], sizeof(buf)) == KRY_SFS_ENOENT,
    "unknown path")
}

SfsThemeChecks :: () {
    entries: [16]KrySfsEntry
    buf: [8]char
    SfsRequire(KrySfsList("/theme", &entries[0], 16) == 8,
    "theme entry count")
    SfsContains("text token", "/theme/text", " ")
    SfsContains("button token", "/theme/button", " ")
    SfsRequire(KrySfsRead("/theme/nope", &buf[0], sizeof(buf)) ==
    KRY_SFS_ENOENT, "unknown theme token")
}

SfsMouseChecks :: () {
    SfsRequire(KrySfsWrite("/input/mouse/x", "150") == 1,
    "mouse x write")
    SfsRequire(KrySfsWrite("/input/mouse/y", "200") == 1,
    "mouse y write")
    SfsContains("mouse x", "/input/mouse/x", "150")

    KrySfsWrite("/input/mouse/button/0", "down")
    InjectPump()
    SfsRequire(IsMouseButtonDown(MOUSE_BUTTON_LEFT), "mouse down")
    SfsRequire(IsMouseButtonPressed(MOUSE_BUTTON_LEFT), "mouse press edge")
    SfsContains("button down", "/input/mouse/button/0", "down")
    InjectPump()
    SfsRequire(!IsMouseButtonPressed(MOUSE_BUTTON_LEFT),
    "mouse press edge expires")
    SfsRequire(IsMouseButtonDown(MOUSE_BUTTON_LEFT), "mouse remains down")

    KrySfsWrite("/input/mouse/button/0", "up")
    InjectPump()
    SfsRequire(IsMouseButtonReleased(MOUSE_BUTTON_LEFT),
    "mouse release edge")
    SfsRequire(!IsMouseButtonDown(MOUSE_BUTTON_LEFT), "mouse up")
    SfsContains("button up", "/input/mouse/button/0", "up")

    InjectMousePosition(150, 200)
    InjectPump()
    point: Vector2 = GetMousePosition()
    SfsRequire((int)point.x == 150 && (int)point.y == 200,
    "mouse position")
    InjectPump()
    SfsRequire(InjectMouseActive() == 0, "mouse hold expires")

    SfsRequire(KrySfsWrite("/input/mouse/button/9", "down") ==
    KRY_SFS_ENOENT, "unknown mouse button")
    SfsRequire(KrySfsWrite("/input/mouse/x", "not-a-number") ==
    KRY_SFS_EINVAL, "invalid mouse position")
}

SfsKeyAndTextChecks :: () {
    KrySfsWrite("/input/keys/KEY_A", "down")
    InjectPump()
    SfsRequire(IsKeyPressed(KEY_A), "key press edge")
    SfsRequire(IsKeyDown(KEY_A), "key down")
    SfsContains("key down", "/input/keys/KEY_A", "down")
    InjectPump()
    SfsRequire(!IsKeyPressed(KEY_A), "key press edge expires")
    SfsRequire(IsKeyDown(KEY_A), "key remains down")
    KrySfsWrite("/input/keys/KEY_A", "up")
    InjectPump()
    SfsRequire(IsKeyReleased(KEY_A), "key release edge")
    SfsRequire(KrySfsWrite("/input/keys/KEY_NOPE", "down") ==
    KRY_SFS_ENOENT, "unknown key")

    KrySfsWrite("/input/text", "hi")
    InjectPump()
    SfsRequire(GetCharPressed() == 'h', "first typed character")
    SfsRequire(GetCharPressed() == 'i', "second typed character")
    SfsRequire(GetCharPressed() == 0, "text queue exhausted")

    KrySfsWrite("/input/wheel", "2.5")
    InjectPump()
    wheel: float = GetMouseWheelMove()
    SfsRequire(wheel > 2.0 && wheel < 3.0, "wheel delta")
    InjectPump()
    SfsRequire(GetMouseWheelMove() == 0.0, "wheel delta expires")
}

SfsWidgetFrame :: (id: const char*, bounds: Rectangle) {
    entries: [16]KrySfsEntry
    KrySfsList("/", &entries[0], 16)
    BeginInterfaceFrame(800, 600, 1.0)
    BeginInspectFrame(nil)
    widget: Widget = BeginWidget("Button", id, bounds, 0)
    EndWidget(&widget)
    EndInspectFrame()
    EndInterfaceFrame()
}

SfsWidgetChecks :: () {
    entries: [16]KrySfsEntry
    path: [128]char
    SfsWidgetFrame("sfs-test:login", (Rectangle){100, 50, 80, 24})
    count: i32 = KrySfsList("/widgets", &entries[0], 16)
    SfsRequire(count >= 1, "widget entry count")
    snprintf(&path[0], sizeof(path), "/widgets/%d/name", count - 1)
    SfsContains("widget name", &path[0], "sfs-test:login")
    snprintf(&path[0], sizeof(path), "/widgets/%d/bounds", count - 1)
    SfsContains("widget bounds", &path[0], "100 50 80 24")

    snprintf(&path[0], sizeof(path), "/widgets/%d/tap", count - 1)
    SfsRequire(KrySfsWrite(&path[0], "1") == 1, "widget tap")
    InjectPump()
    SfsRequire(IsMouseButtonPressed(MOUSE_BUTTON_LEFT),
    "widget tap press")
    InjectPump()
    SfsRequire(HandleClick((Rectangle){100, 50, 80, 24}, 0, nil),
    "widget tap release")
    point: Vector2 = GetMousePosition()
    SfsRequire((int)point.x == 140 && (int)point.y == 62,
    "widget tap center")
}

SfsKryTHelperChecks :: () {
    InjectReset()
    KrySfsIsDir("/")
    SfsWidgetFrame("sfs-test:save", (Rectangle){0, 0, 40, 20})
    SfsRequire(KryTTap("sfs-test:save"), "KryT tap")
    InjectPump()
    SfsRequire(IsMouseButtonPressed(MOUSE_BUTTON_LEFT),
    "KryT press")
    InjectPump()
    SfsRequire(HandleClick((Rectangle){0, 0, 40, 20}, 0, nil),
    "KryT click")
    SfsRequire(KryTKey("ENTER"), "KryT key")
    InjectPump()
    SfsRequire(IsKeyPressed(KEY_ENTER), "KryT key press")
    SfsRequire(KryTType("abc"), "KryT type")
    InjectPump()
    SfsRequire(GetCharPressed() == 'a', "KryT typed character")
}

main :: () -> i32 #export {
    InjectReset()
    SfsRootChecks()
    SfsThemeChecks()
    SfsMouseChecks()
    SfsKeyAndTextChecks()
    InjectReset()
    SfsWidgetChecks()
    InjectReset()
    SfsKryTHelperChecks()
    puts("sfs Kry checks passed")
    return 0
}
