libm :: #system_library "m";
CanvasSqrt :: (value: float32) -> float32 #foreign libm "sqrtf";

CanvasRoundness :: (bounds: Rectangle, radius: float32) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 || radius <= 0.0 { return 0.0 }
    roundness: float32 = radius * 2.0 / edge
    if roundness > 1.0 { return 1.0 }
    return roundness
}

CanvasDrawImageStrip :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, origin: Vector2, rotation: float32,
    tint: Color, x: s32, y: s32, width: s32, height: s32) {
    if width <= 0 || height <= 0 { return }
    // Clips are in the same camera space as the image, like the native host.
    saved := BeginRasterClip(Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)width, cast(float32)height})
    DrawTexturePro(texture, source, destination, origin, rotation, tint)
    EndRasterClip(saved)
}

// Scissor strips preserve DrawTexturePro's rotation and source mapping while
// following the same rounded clip boundary used by the Cairo host.
CanvasDrawImageClipped :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {
    x: s32 = cast(s32)clip.x
    y: s32 = cast(s32)clip.y
    width: s32 = cast(s32)clip.width
    height: s32 = cast(s32)clip.height
    if width <= 0 || height <= 0 { return }
    if radius <= 0.0 {
        // A contained image cannot touch this clip's boundary. Keep any
        // enclosing clip/camera, but avoid rebuilding an identical scissor
        // and reading its modelview for every tile in a board.
        if rotation == 0.0 && destination.width > 0.0 && destination.height > 0.0 &&
        destination.x >= cast(float32)x && destination.y >= cast(float32)y &&
        destination.x + destination.width <= cast(float32)(x + width) &&
        destination.y + destination.height <= cast(float32)(y + height) {
            DrawTexturePro(texture, source, destination, origin, rotation, tint)
            return
        }
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x, y, width, height)
        return
    }
    if radius > cast(float32)width * 0.5 {
        radius = cast(float32)width * 0.5
    }
    if radius > cast(float32)height * 0.5 {
        radius = cast(float32)height * 0.5
    }
    rounded_rows: s32 = cast(s32)(radius + 0.5)
    if rounded_rows < 1 { rounded_rows = 1 }
    if rounded_rows * 2 > height { rounded_rows = height / 2 }
    row: s32 = 0
    while row < rounded_rows {
        dy: float32 = radius - (cast(float32)row + 0.5)
        inset: s32 = 0
        if dy > 0.0 {
            inset = cast(s32)(radius - CanvasSqrt(radius * radius -
                dy * dy) + 0.5)
        }
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + row,
            width - inset * 2, 1)
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + height - 1 - row,
            width - inset * 2, 1)
        row += 1
    }
    CanvasDrawImageStrip(texture, source, destination, origin,
        rotation, tint, x, y + rounded_rows,
        width, height - rounded_rows * 2)
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    previous := TextTypefaceUse(typeface)
    defer { unused TextTypefaceUse(previous) }
    face: s32 = 0
    if canvas_font_loaded { face = CanvasFontFace(canvas_font) }
    return cast(s32)(PageTextWidth(face, value, font) + 0.5)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return font
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    if segments < 4 { segments = 4 }
    DrawRectangleRounded(bounds, CanvasRoundness(bounds, radius),
        segments, color)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 || width <= 0.0 { return }
    if segments < 4 { segments = 4 }
    DrawRectangleRoundedLinesEx(bounds, CanvasRoundness(bounds, radius),
        segments, width, color)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    DrawLineEx(Vector2.{line.x, line.y},
        Vector2.{line.x + line.width, line.y + line.height}, 1.0, color)
}

// One call's triangles are one shape: the page fills them as one path.
#program_export
RasterTriangles :: (points: []Vector2, color: Color) {
    if color.a == cast(u8)0 { return }
    PageFillTriangles(points, cast(s32)color.r, cast(s32)color.g,
        cast(s32)color.b, cast(s32)color.a)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    face: s32 = 0
    if canvas_font_loaded { face = CanvasFontFace(canvas_font) }
    PageTextDraw(face, value, x, y, font, color.r, color.g, color.b, color.a)
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    saved := BeginRasterClip(clip)
    RasterText(value, x, y, font, color)
    EndRasterClip(saved)
}

// Copies belong to the one page.
CANVAS_LANCZOS_SESSION :: 0x63616e

CanvasLanczosRelease :: (argument: *void) {
    entry := cast(*Lanczos.LanczosEntry)argument
    if entry.texture != 0 { PageTextureFree(cast(s32)entry.texture) }
    entry.texture = 0
}

// A smooth picture drawn upright at one scale on both axes shows its
// Lanczos copy (see lanczos_cache) over the whole device pixels it covers.
// Firefox has no imageSmoothingQuality, so the browser's own filter is
// only what draws until the copy is made. The source is read back from its
// canvas once per new size, only when a copy can start, and the copy then
// lives only in its own canvas. False draws the picture with the browser's
// filter.
CanvasLanczosImage :: (index: s32, source: Rectangle, destination: Rectangle,
    clip: Rectangle, radius: float32, tint: Color) -> bool {
    asset := *canvas_assets[index]
    texture := asset.texture
    slot := PageTextureFind(cast(s32)texture.id)
    if slot < 0 || page_textures[slot].target || page_ctx == 0 { return false }
    matrix := WebAsObject(WebCall0(page_ctx, page_names.get_transform))
    if matrix == 0 { return false }
    a := WebGetNumber(matrix, page_names.a)
    d := WebGetNumber(matrix, page_names.d)
    e := WebGetNumber(matrix, page_names.e)
    f := WebGetNumber(matrix, page_names.f)
    if WebGetNumber(matrix, page_names.b) != 0.0 || WebGetNumber(matrix, page_names.c) != 0.0 ||
        !(a > 0.0) || !(d > 0.0) { return false }
    snapped := Lanczos.LanczosSnap(Rectangle.{cast(float32)(cast(float64)destination.x * a + e),
        cast(float32)(cast(float64)destination.y * d + f), cast(float32)(cast(float64)destination.width * a),
        cast(float32)(cast(float64)destination.height * d)})
    if !Lanczos.LanczosEligible(source, texture.width, texture.height, snapped) { return false }
    width := cast(s32)snapped.width
    height := cast(s32)snapped.height
    // The path names the picture; the bytes it was decoded from and any
    // later upload to its canvas name its revision.
    revision := asset.content ^ (page_textures[slot].revision * cast(u64)0x9e3779b97f4a7c15)
    key: Lanczos.LanczosKey = .{asset.hash, revision, CANVAS_LANCZOS_SESSION, source, width, height}
    entry := Lanczos.LanczosLookup(key, null, 0, 0, 0, Lanczos.LANCZOS_STRAIGHT, Lanczos.LANCZOS_STRAIGHT)
    exact := entry != null && entry.key.width == width && entry.key.height == height
    if !exact && Lanczos.LanczosCanStart(key) {
        bytes := cast(u32)texture.width * cast(u32)texture.height * 4
        pixels := CanvasAllocate(bytes)
        if pixels != null {
            if PageTextureRead(cast(s32)texture.id, pixels, bytes) == 1 {
                unused Lanczos.LanczosLookup(key, pixels, texture.width, texture.height,
                    cast(s64)texture.width * 4, Lanczos.LANCZOS_STRAIGHT, Lanczos.LANCZOS_STRAIGHT)
            }
            CanvasRelease(cast(*void)pixels)
        }
    }
    if entry == null { return false }
    if entry.texture == 0 {
        if entry.pixels == null { return false }
        id := PageTextureFromRgba(entry.pixels, entry.key.width, entry.key.height)
        if id == 0 { return false }
        entry.texture = cast(u32)id
        entry.release = CanvasLanczosRelease
        Lanczos.LanczosUploaded(entry)
    }
    // Its own copy lands pixel for pixel; one of another size is stretched
    // smoothly until its own replaces it.
    PageTextureFilter(cast(s32)entry.texture, ifx exact then 0 else 1)
    shown := Rectangle.{cast(float32)((cast(float64)snapped.x - e) / a), cast(float32)((cast(float64)snapped.y - f) / d),
        cast(float32)(cast(float64)snapped.width / a), cast(float32)(cast(float64)snapped.height / d)}
    CanvasDrawImageClipped(Texture2D.{entry.texture, entry.key.width, entry.key.height, 1, 7},
        Rectangle.{0.0, 0.0, cast(float32)entry.key.width, cast(float32)entry.key.height}, shown, clip,
        Vector2.{}, 0.0, radius, tint)
    return true
}

// The browser decodes images itself and draws each when it is ready.
#program_export
ImagesPending :: () -> s32 {
    return 0
}

// This host shows no picture cursors; a request for one decodes nothing.
#program_export
CursorPictureHost :: (asset_path: string, width: s32, height: s32,
    pixels: []u32, premultiplied: bool) -> bool {
    unused asset_path
    unused width
    unused height
    unused pixels
    unused premultiplied
    return false
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    index: s32 = CanvasAssetIndex(asset_path)
    if index < 0 { return 0 }
    return canvas_assets[index].texture.width
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    index: s32 = CanvasAssetIndex(asset_path)
    if index < 0 { return 0 }
    return canvas_assets[index].texture.height
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    if source.width <= 0.0 || source.height <= 0.0 ||
    destination.width <= 0.0 || destination.height <= 0.0 ||
    clip.width <= 0.0 || clip.height <= 0.0 {
        return
    }
    texture: Texture2D
    asset: s32 = -1
    if Bitmaps.BitmapTagged(texture_id) {
        texture = CanvasBitmapTexture(texture_id)
        if texture.id == cast(u32)0 { return }
    } else if texture_id != cast(u32)0 {
        texture = CurrentPaintTexture()
        if texture.id != texture_id {
            // Keep direct calls to the low-level raster effect usable.
            texture.id = texture_id
            texture.width = cast(s32)(source.x + source.width)
            texture.height = cast(s32)(source.y + source.height)
        }
    } else if asset_path.count > 0 {
        index: s32 = CanvasAssetIndex(asset_path)
        if index < 0 {
            canvas_image_error = true
            return
        }
        texture = canvas_assets[index].texture
        if CurrentPaintSmooth() && !canvas_assets[index].smooth {
            SetTextureFilter(texture, 1)
            canvas_assets[index].smooth = true
        }
        asset = index
    } else {
        canvas_image_error = true
        return
    }
    if Bitmaps.BitmapTagged(texture_id) { SetTextureFilter(texture, ifx CurrentPaintSmooth() then 1 else 0) }
    polygon := CurrentPaintPolygon()
    scope := WebScope()
    context := page_ctx
    if polygon.count >= 3 {
        PageMeshFlush()
        unused WebCall0(context, WebName("save"))
        unused WebCall0(context, WebName("beginPath"))
        unused WebCall2(context, WebName("moveTo"),
            WebNumber(destination.x + polygon[0].x * destination.width),
            WebNumber(destination.y + polygon[0].y * destination.height))
        for at: cast(s64)1..polygon.count - 1 {
            unused WebCall2(context, WebName("lineTo"),
                WebNumber(destination.x + polygon[at].x * destination.width),
                WebNumber(destination.y + polygon[at].y * destination.height))
        }
        unused WebCall0(context, WebName("closePath"))
        unused WebCall0(context, WebName("clip"))
    }
    if asset < 0 || !CurrentPaintSmooth() || rotation != 0.0 ||
        !CanvasLanczosImage(asset, source, destination, clip, radius, tint) {
        CanvasDrawImageClipped(texture, source, destination, clip, origin,
            rotation, radius, tint)
    }
    if polygon.count >= 3 { unused WebCall0(context, WebName("restore")) }
    WebEnd(scope)
}

// A warped image (see ImageMesh): the canvas draws each triangle of each
// grid cell through its own transform, clipped to the image's clip.
#program_export
RasterImageMesh :: (asset_path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) {
    if columns < 2 || rows < 2 || clip.width <= 0.0 || clip.height <= 0.0 { return }
    count: s64 = cast(s64)columns * cast(s64)rows
    if count > cast(s64)ImageSchema.IMAGE_MESH_POINT_LIMIT || points.count < count { return }
    texture: Texture2D
    if Bitmaps.BitmapTagged(texture_id) {
        texture = CanvasBitmapTexture(texture_id)
        if texture.id == cast(u32)0 { return }
    } else if texture_id != cast(u32)0 {
        texture = CurrentPaintTexture()
        if texture.id != texture_id {
            // Keep direct calls to the low-level raster effect usable.
            texture.id = texture_id
        }
    } else if asset_path.count > 0 {
        index: s32 = CanvasAssetIndex(asset_path)
        if index < 0 {
            canvas_image_error = true
            return
        }
        texture = canvas_assets[index].texture
        if CurrentPaintSmooth() && !canvas_assets[index].smooth {
            SetTextureFilter(texture, 1)
            canvas_assets[index].smooth = true
        }
    } else {
        canvas_image_error = true
        return
    }
    if Bitmaps.BitmapTagged(texture_id) { SetTextureFilter(texture, ifx CurrentPaintSmooth() then 1 else 0) }
    id: s32 = cast(s32)texture.id
    filter: s32 = PageTextureFilterFor(id)
    if PageMeshDraw(id, source, points[:count], columns, rows, clip, tint, filter) {
        return
    }
    saved := BeginRasterClip(clip)
    for row: cast(s32)0..rows - 2 {
        for column: cast(s32)0..columns - 2 {
            top_left: s32 = row * columns + column
            bottom_left: s32 = top_left + columns
            left_share: float32 = cast(float32)column / cast(float32)(columns - 1)
            right_share: float32 = cast(float32)(column + 1) / cast(float32)(columns - 1)
            top_share: float32 = cast(float32)row / cast(float32)(rows - 1)
            bottom_share: float32 = cast(float32)(row + 1) / cast(float32)(rows - 1)
            a := PageMeshSource(source, left_share, top_share)
            b := PageMeshSource(source, right_share, top_share)
            c := PageMeshSource(source, left_share, bottom_share)
            d := PageMeshSource(source, right_share, bottom_share)
            CanvasMeshTriangle(id, points[top_left], a, points[top_left + 1], b,
                points[bottom_left], c, tint, filter)
            CanvasMeshTriangle(id, points[top_left + 1], b, points[bottom_left + 1], d,
                points[bottom_left], c, tint, filter)
        }
    }
    EndRasterClip(saved)
}

CanvasMeshTriangle :: (id: s32, a: Vector2, a_source: Vector2, b: Vector2,
    b_source: Vector2, c: Vector2, c_source: Vector2, tint: Color, filter: s32) {
    PageDrawTextureTriangle(id, cast(float64)a.x, cast(float64)a.y,
        cast(float64)b.x, cast(float64)b.y, cast(float64)c.x, cast(float64)c.y,
        cast(float64)a_source.x, cast(float64)a_source.y,
        cast(float64)b_source.x, cast(float64)b_source.y,
        cast(float64)c_source.x, cast(float64)c_source.y,
        cast(s32)tint.r, cast(s32)tint.g, cast(s32)tint.b, cast(s32)tint.a, filter)
}

#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle, origin: Vector2, rotation: float32,
    outer_clip: Rectangle, outer_clipped: bool, emphasis: bool, italic: bool) {
    scope := WebScope(); ctx := PageContext()
    unused WebCall0(ctx,WebName("save"))
    if outer_clipped {
        unused WebCall0(ctx,WebName("beginPath"))
        unused WebCall4(ctx,WebName("rect"),WebNumber(outer_clip.x),WebNumber(outer_clip.y),WebNumber(outer_clip.width),WebNumber(outer_clip.height))
        unused WebCall0(ctx,WebName("clip"))
    }
    unused WebCall2(ctx,WebName("translate"),WebNumber(origin.x),WebNumber(origin.y))
    unused WebCall1(ctx,WebName("rotate"),WebNumber(cast(float64)rotation*0.017453292519943295))
    unused WebCall2(ctx,WebName("translate"),WebNumber(-origin.x),WebNumber(-origin.y))
    unused WebCall0(ctx,WebName("beginPath"))
    unused WebCall4(ctx,WebName("rect"),WebNumber(clip.x),WebNumber(clip.y),WebNumber(clip.width),WebNumber(clip.height))
    unused WebCall0(ctx,WebName("clip"))
    unused italic
    stroke := ifx emphasis then (ifx font / 24 > 0 then font / 24 else 1) else 0
    RasterText(value,x+stroke,y,font,color)
    unused WebCall0(ctx,WebName("restore")); WebEnd(scope)
}
