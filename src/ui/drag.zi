#import "geometry"

DragStep :: struct {
    value: float32
    changed: bool
}

DragDiscreteStep :: struct {
    value: s32
    changed: bool
}

DragKeyboardInput :: struct {
    direction: s32
    home: bool
    end: bool
    alt: bool
    shift: bool
}

DragPointerDecision :: struct {
    clear_active: bool
    start_active: bool
    update_delta: bool
    finish_active: bool
}

DragTextPaint :: struct {
    text_x: float32
    text_y: float32
}

#program_export
DragTextInsetFor :: (scale: float32) -> float32 {
    return scale * 6.0
}

#program_export
DragLabelGapFor :: (scale: float32) -> float32 {
    return scale * 2.0
}

#program_export
DragComponentTokenFor :: (control_id: s32, component: s32) -> s32 {
    if control_id <= 0 || component < 0 {
        return 0
    }
    return control_id * 16 + component + 1
}

#program_export
DragCellTextPaintFor :: (bounds: Rectangle, inset: float32,
    text_line_height: float32) -> DragTextPaint {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y + (bounds.height - text_line_height) / 2.0
    return paint
}

#program_export
DragLabelTextPaintFor :: (bounds: Rectangle, inset: float32, font_size: s32,
    gap: float32) -> DragTextPaint {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y - cast(float32)font_size - gap
    return paint
}

#program_export
DragCellBoundsFor :: (bounds: Rectangle, count: s32, index: s32) -> Rectangle {
    cell: Rectangle
    if count <= 0 { return cell }
    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }
    cell.x = bounds.x + bounds.width * cast(float32)index / cast(float32)count
    cell.y = bounds.y
    cell.width = bounds.width / cast(float32)count
    cell.height = bounds.height
    return cell
}

#program_export
DragPointerDecisionFor :: (any_active: bool, active: bool, hot: bool, disabled: bool,
    owner_captured: bool, pressed: bool, down: bool,
    released: bool) -> DragPointerDecision {
    decision: DragPointerDecision
    decision.clear_active = (any_active && owner_captured) ||
        (active && disabled)
    decision.start_active = hot && pressed
    effective_active: bool = (active && !decision.clear_active) ||
        decision.start_active
    decision.update_delta = effective_active && !disabled && down
    decision.finish_active = effective_active && released
    return decision
}

#program_export
DragEffectiveSpeed :: (speed: float32) -> float32 {
    if speed == 0.0 { return 1.0 }
    return speed
}

#program_export
DragClamp :: (value: float32, minimum: float32, maximum: float32) -> float32 {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

#program_export
DragDiscreteClamp :: (value: s32, minimum: s32, maximum: s32) -> s32 {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

#program_export
DragDiscreteRoundedDelta :: (scaled: float32, force_minimum_step: bool) -> s32 {
    step: s32 = cast(s32)(scaled + (ifx scaled < 0.0 then -0.5 else 0.5))
    if force_minimum_step && step == 0 {
        if scaled < 0.0 { return -1 }
        return 1
    }
    return step
}

#program_export
DragKeyboardShouldRun :: (focus_active: bool, keyboard_enabled: bool,
    popup_captures: bool) -> bool {
    return focus_active && keyboard_enabled && !popup_captures
}

#program_export
DragKeyboardDirectionFor :: (right: bool, left: bool) -> s32 {
    if right { return 1 }
    if left { return -1 }
    return 0
}

#program_export
DragKeyboardInputFor :: (direction: s32, home: bool, end: bool,
    alt: bool, shift: bool) -> DragKeyboardInput {
    input: DragKeyboardInput
    input.direction = direction
    input.home = home
    input.end = end
    input.alt = alt
    input.shift = shift
    return input
}

#program_export
DragKeyboardValue :: (value: float32, speed: float32, minimum: float32,
    maximum: float32, input: DragKeyboardInput) -> DragStep {
    result: DragStep
    result.value = value
    result.changed = false
    next: float32 = value
    if input.home && minimum < maximum {
        next = minimum
    } else if input.end && minimum < maximum {
        next = maximum
    } else if input.direction != 0 {
        step: float32 = DragEffectiveSpeed(speed)
        if input.alt { step = step * 0.1 }
        if input.shift { step = step * 10.0 }
        next = DragClamp(next + cast(float32)input.direction * step, minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

#program_export
DragDiscreteKeyboardValue :: (value: s32, speed: float32, minimum: s32,
    maximum: s32, input: DragKeyboardInput) -> DragDiscreteStep {
    result: DragDiscreteStep
    result.value = value
    result.changed = false
    next: s32 = value
    if input.home && minimum < maximum {
        next = minimum
    } else if input.end && minimum < maximum {
        next = maximum
    } else if input.direction != 0 {
        scaled: float32 = DragEffectiveSpeed(speed)
        if input.alt { scaled = scaled * 0.1 }
        if input.shift { scaled = scaled * 10.0 }
        next = DragDiscreteClamp(next + input.direction * DragDiscreteRoundedDelta(scaled, true),
            minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

#program_export
DragDeltaValue :: (value: float32, delta: float32, speed: float32,
    minimum: float32, maximum: float32) -> DragStep {
    result: DragStep
    result.value = DragClamp(value + delta * DragEffectiveSpeed(speed),
        minimum, maximum)
    result.changed = result.value != value
    return result
}

#program_export
DragDiscreteDeltaValue :: (value: s32, delta: float32, speed: float32,
    minimum: s32, maximum: s32) -> DragDiscreteStep {
    result: DragDiscreteStep
    scaled: float32 = delta * DragEffectiveSpeed(speed)
    result.value = DragDiscreteClamp(value + DragDiscreteRoundedDelta(scaled, false),
        minimum, maximum)
    result.changed = result.value != value
    return result
}
