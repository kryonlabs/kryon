using PropsModule :: #import "layout_props";
using BehaviorModule :: #import "layout_behavior";
Theme :: #import "theme";
#import "geometry"
#import "session"

LayoutContainer :: struct {
    node: s32
    opened: bool
    kind: s32
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
    padding_y: s32
}

// Resolve a theme spacing role into the same logical units as Props.gap.
#program_export
Gap :: (token: Theme.ThemeMetricRole) -> s32 {
    return LayoutPixelMetric(Theme.CurrentThemeMetric(token))
}

LayoutPixelMetric :: (value: float32) -> s32 {
    if !(value > 0.0) { return 0 }
    if value >= 2147483520.0 { return 2147483647 }
    return cast(s32)(value + 0.5)
}
#if #defined(KRYON_HOSTED_UI) {
layout_host :: #system_library "host_api";
GroupHostedHost :: (session: Session, props: PropsModule.Props) -> LayoutContainer #foreign layout_host;

#program_export
Group :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    return GroupHostedHost(session, props)
}
}

#if !#defined(KRYON_HOSTED_UI) {
#import "control_props"
#import "grid"
#import "grid_props"
#import "layout_paint"
#import "layout_paint_slot"
#import "paint_primitives"
using WidthModule :: #import "layout_width";
#import "math"
#import "style"
#import "style_sheet"
#import "tree"
#import "widget_kind"

using WidgetKind;
using StyleField;
using StyleFlexField;
using StyleBoxField;

// The space a column child may fill, or -1 outside a column.
#program_export
ColumnWidth :: (session: Session) -> float32 {
    parent_index := TreeCurrentParent(session)
    if TreeSubmittedNodeAt(session, parent_index).kind != WidgetKindColumn { return -1.0 }
    parent := TreeLayoutAt(session, parent_index)
    return LayoutMetricsFor(parent.bounds, parent.gap, parent.padding, parent.padding_y).content.width
}

GridResult :: struct {
    container: LayoutContainer
    cursor: GridCursor
}

TreePlaceLinear :: (session: Session, parent_index: s32, bounds: Rectangle,
    horizontal: bool) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    metrics: LayoutMetrics = LayoutMetricsFor(parent.bounds,
        parent.gap, parent.padding, parent.padding_y)
    progress: LayoutProgress = TreeLayoutProgressAt(session, parent_index)
    cursor: float32 = LayoutCursorForChild(metrics, horizontal,
        progress.count, progress.extent)
    placed: Rectangle = LayoutChildBounds(bounds, bounds, metrics,
        horizontal, cursor)
    progress.count += 1
    if horizontal {
        progress.extent += placed.width
        if placed.height > progress.cross { progress.cross = placed.height }
    } else {
        progress.extent += placed.height
    }
    TreeSetLayoutProgress(session, parent_index, progress)
    return placed
}

// Left to right with the parent's gap, starting a new line below the
// tallest slot when the next child would pass the content edge. A child
// without a width takes a whole line.
#program_export
TreePlaceFlow :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    content := LayoutMetricsFor(parent.bounds, parent.gap, parent.padding, parent.padding_y).content
    progress: LayoutProgress = TreeLayoutProgressAt(session, parent_index)
    width := ifx bounds.width > 0.0 then bounds.width else content.width
    x := ifx progress.extent > 0.0 then progress.extent + cast(float32)parent.gap else 0.0
    if progress.extent > 0.0 && x + width > content.width {
        progress.line += progress.cross + cast(float32)parent.row_gap
        progress.cross = 0.0
        x = 0.0
    }
    placed: Rectangle = .{content.x + x, content.y + progress.line, width, bounds.height}
    progress.extent = x + width
    if bounds.height > progress.cross { progress.cross = bounds.height }
    progress.count += 1
    TreeSetLayoutProgress(session, parent_index, progress)
    return placed
}

#program_export
TreePlaceColumn :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    return TreePlaceLinear(session, parent_index, bounds, false)
}

#program_export
TreePlaceRow :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    return TreePlaceLinear(session, parent_index, bounds, true)
}

#program_export
TreePlaceStack :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    metrics: LayoutMetrics = LayoutMetricsFor(parent.bounds,
        parent.gap, parent.padding, parent.padding_y)
    return StackChildBounds(bounds, bounds, metrics)
}

LayoutGridCursor :: (parent: LayoutInfo) -> GridCursor {
    return BeginGridCursor(GridProps.{.bounds = parent.bounds, .gap = parent.gap,
        .padding = parent.padding, .padding_y = parent.padding_y, .padding_y_override = true,
        .row_gap = parent.row_gap, .row_gap_override = true, .columns = parent.columns,
        .min_item_width = parent.min_item_width, .max_columns = parent.max_columns})
}

#program_export
TreePlaceGrid :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    grid := LayoutGridCursor(TreeLayoutAt(session, parent_index))
    progress: LayoutProgress = TreeLayoutProgressAt(session, parent_index)
    if progress.grid_initialized {
        grid.y = progress.grid_y
        grid.col = progress.grid_col
        grid.row_height = progress.grid_row_height
        grid.used_height = progress.grid_used_height
    }
    grid = GridStep(grid, cast(s32)bounds.height, ifx progress.span != 0 then progress.span else 1)
    progress.span = 0
    progress.grid_initialized = true
    progress.grid_y = grid.y
    progress.grid_col = grid.col
    progress.grid_row_height = grid.row_height
    progress.grid_used_height = grid.used_height
    TreeSetLayoutProgress(session, parent_index, progress)
    return grid.item
}

LayoutFace :: (props: PropsModule.Props, kind: s32, flex: *StyleFlexData,
    box: *StyleBoxData) -> StyleData {
    style_kind: s32 = 0
    if kind == WidgetKindRow { style_kind = StyleKindRow() }
    if kind == WidgetKindColumn { style_kind = StyleKindColumn() }
    if kind == WidgetKindGrid { style_kind = StyleKindGrid() }
    defaults: StyleData
    if style_kind == 0 { return defaults }
    facts := StyleDefaultFacts(style_kind)
    facts.id = props.id
    facts.class_name = props.class_name
    return ResolveInstalledLayoutStyle(facts, flex, box)
}

LayoutSpacingFor :: (axis: s32, axis_override: bool, uniform: s32,
    uniform_override: bool, styled: float32) -> s32 {
    value := LayoutPixelMetric(styled)
    if uniform != 0 || uniform_override { value = uniform }
    if axis != 0 || axis_override { value = axis }
    if value < 0 { return 0 }
    return value
}

LayoutExtentFor :: (declared: float32, inherited: float32, styled: float32,
    has_style: bool) -> float32 {
    if !(declared <= 0.0) { return declared }
    if has_style && styled > 0.0 && Finite32(styled) { return styled }
    return inherited
}

// CSS box fields that change a container's width (min, max, inline margins)
// or move it in its slot (also max-height and block margins).
LayoutBoxWidthFields :: 323
LayoutBoxSlotFields :: 487

// A fixed margin in logical pixels; unset and `auto` sides are zero here.
LayoutMargin :: (box: StyleBoxData, field: StyleBoxField, value: float32) -> float32 {
    if (box.fields & cast(u32)field) == 0 || !(value > 0.0) { return 0.0 }
    return value
}

LayoutAutoMargin :: (box: StyleBoxData, field: StyleBoxField, value: float32) -> bool {
    return (box.fields & cast(u32)field) != 0 && value < 0.0
}

// The border-box width: an auto width gives up its fixed inline margins,
// then min-width and max-width clamp it.
LayoutBoxWidth :: (width: float32, auto_width: bool, box: StyleBoxData) -> float32 {
    if auto_width {
        width -= LayoutMargin(box, .StyleBoxMarginLeft, box.margin_left) +
            LayoutMargin(box, .StyleBoxMarginRight, box.margin_right)
        if width < 0.0 { width = 0.0 }
    }
    if (box.fields & cast(u32)StyleBoxMaxWidth) != 0 && box.max_width >= 0.0 &&
        width > box.max_width { width = box.max_width }
    if (box.fields & cast(u32)StyleBoxMinWidth) != 0 && width < box.min_width { width = box.min_width }
    return width
}

LayoutAutoWidth :: (declared: float32, face: StyleData) -> bool {
    return declared <= 0.0 && !(StyleHasField(face, cast(u32)StyleWidth) && face.width > 0.0)
}

// The box CSS percentages of a child refer to: the parent's content box,
// or its track in a grid. A zero height is indefinite.
LayoutPercentBasis :: (session: Session, parent: Rectangle) -> Rectangle {
    track := AutoGridChildWidth(session, Rectangle.{})
    if track > 0.0 { return Rectangle.{parent.x, parent.y, track, 0.0} }
    return parent
}

// A percentage of `extent`; not definite when the extent is unknown, and
// the declaration then computes to its initial value.
LayoutPercentOf :: (percentage: float32, extent: float32) -> (value: float32, definite: bool) {
    if !(extent > 0.0) { return 0.0, false }
    return cast(float32)(cast(float64)percentage * cast(float64)extent / 100.0), true
}

// CSS percentages of width, height, min-height, min-width, max-width and
// max-height in logical pixels of `basis`.
LayoutResolvePercent :: (face: *StyleData, box: *StyleBoxData, basis: Rectangle) {
    sizes := face.percent & face.fields
    if (sizes & cast(u32)StyleWidth) != 0 {
        value, definite := LayoutPercentOf(face.width, basis.width)
        face.width = value
        if !definite { face.fields &= ~cast(u32)StyleWidth }
    }
    if (sizes & cast(u32)StyleHeight) != 0 {
        value, definite := LayoutPercentOf(face.height, basis.height)
        face.height = value
        if !definite { face.fields &= ~cast(u32)StyleHeight }
    }
    if (sizes & cast(u32)StyleMinHeight) != 0 {
        value, definite := LayoutPercentOf(face.min_height, basis.height)
        face.min_height = value
        if !definite { face.fields &= ~cast(u32)StyleMinHeight }
    }
    face.percent = 0
    limits := box.percent & box.fields
    if (limits & cast(u32)StyleBoxMinWidth) != 0 {
        value, definite := LayoutPercentOf(box.min_width, basis.width)
        box.min_width = value
        if !definite { box.fields &= ~cast(u32)StyleBoxMinWidth }
    }
    if (limits & cast(u32)StyleBoxMaxWidth) != 0 {
        value, definite := LayoutPercentOf(box.max_width, basis.width)
        box.max_width = value
        if !definite { box.fields &= ~cast(u32)StyleBoxMaxWidth }
    }
    if (limits & cast(u32)StyleBoxMaxHeight) != 0 {
        value, definite := LayoutPercentOf(box.max_height, basis.height)
        box.max_height = value
        if !definite { box.fields &= ~cast(u32)StyleBoxMaxHeight }
    }
    box.percent = 0
}

// What the placing parent row or column has left on its main axis after
// the children it already placed; zero or less when nothing is left.
LayoutRemaining :: (session: Session, horizontal: bool) -> float32 {
    index := TreeCurrentParent(session)
    info := TreeLayoutAt(session, index)
    progress := TreeLayoutProgressAt(session, index)
    content := LayoutMetricsFor(info.bounds, info.gap, info.padding, info.padding_y).content
    used := progress.extent + cast(float32)(info.gap * progress.count)
    return ifx horizontal then content.width - used else content.height - used
}

// CSS `flex-grow` above zero on the container itself, as a child.
LayoutGrows :: (props: PropsModule.Props, kind: s32) -> bool {
    style_kind := ifx kind == WidgetKindRow then StyleKindRow() else StyleKindColumn()
    facts := StyleDefaultFacts(style_kind)
    facts.id = props.id
    facts.class_name = props.class_name
    item := ResolveInstalledFlexItem(facts)
    return (item.fields & cast(u32)StyleFlexGrow) != 0 && item.grow > 0.0
}

LayoutAutoHeight :: (declared: float32, face: StyleData) -> bool {
    return declared <= 0.0 && !(StyleHasField(face, cast(u32)StyleHeight) && face.height > 0.0)
}

// What a content-sized container settles at its close.
LayoutContentSizeFor :: (face: StyleData, box: StyleBoxData) -> TreeContentSize {
    size: TreeContentSize = .{.max = -1.0, .paint_mark = -1}
    if StyleHasField(face, cast(u32)StyleMinHeight) { size.min = face.min_height }
    if (box.fields & cast(u32)StyleBoxMaxHeight) != 0 { size.max = box.max_height }
    size.margin_top = LayoutMargin(box, .StyleBoxMarginTop, box.margin_top)
    size.margin_bottom = LayoutMargin(box, .StyleBoxMarginBottom, box.margin_bottom)
    return size
}

// The height its children used: the stacked column, the tallest row slot,
// the flow lines or the grid rows, plus block padding, within min and max.
LayoutContentHeight :: (session: Session, index: s32, kind: s32) -> float32 {
    info := TreeLayoutAt(session, index)
    progress := TreeLayoutProgressAt(session, index)
    used: float32 = progress.line + progress.cross
    if kind == WidgetKindColumn {
        used = progress.extent
        if progress.count > 1 { used += cast(float32)(info.gap * (progress.count - 1)) }
    } else if kind == WidgetKindGrid {
        used = cast(float32)progress.grid_used_height
        if progress.grid_col > 0 { used += cast(float32)progress.grid_row_height }
        else if used > 0.0 { used -= cast(float32)info.row_gap }
    }
    size := TreeContentSizeAt(session, index)
    height := used + cast(float32)(info.padding_y * 2)
    if size.max >= 0.0 && height > size.max { height = size.max }
    if height < size.min { height = size.min }
    return height
}

// A content-sized child grew from its zero slot height: the parent's
// cursor moves on by that much before the next sibling is placed.
LayoutGrowParent :: (session: Session, parent_index: s32, bounds: Rectangle, size: TreeContentSize) {
    parent := TreeSubmittedNodeAt(session, parent_index)
    if !parent.places_children { return }
    progress := TreeLayoutProgressAt(session, parent_index)
    if parent.kind == WidgetKindColumn {
        progress.extent += bounds.height
    } else if parent.kind == WidgetKindGrid {
        info := TreeLayoutAt(session, parent_index)
        bottom := cast(s32)(bounds.y + bounds.height + size.margin_bottom + 0.999)
        if progress.grid_col == 0 {
            next := bottom + info.row_gap
            if next > progress.grid_y {
                progress.grid_used_height += next - progress.grid_y
                progress.grid_y = next
            }
        } else if bottom - progress.grid_y > progress.grid_row_height {
            progress.grid_row_height = bottom - progress.grid_y
        }
    } else {
        outer := bounds.height + size.margin_top + size.margin_bottom
        if outer > progress.cross { progress.cross = outer }
    }
    TreeSetLayoutProgress(session, parent_index, progress)
}

// A container with a CSS background, border or shadow paints its box, like
// a styled div, beneath its children.
LayoutPaintsBox :: (face: StyleData, box: StyleBoxData) -> bool {
    if layout_box_paint == null { return false }
    fill := StyleHasField(face, cast(u32)StyleBackground) && (face.background & cast(u32)255) != 0
    line := StyleHasField(face, cast(u32)StyleBorderWidth) && face.border_width > 0.0 &&
        (face.border & cast(u32)255) != 0
    shadow := StyleHasField(face, cast(u32)StyleElevation) && face.elevation != .ElevationRoleNone
    return fill || line || shadow || (box.fields & cast(u32)StyleBoxBorderSides) != 0
}

// The faces of open Boxes that paint at End, innermost last: containers
// close in reverse order, so each close finds its face on top.
LayoutBoxFace :: struct {
    node: s32
    face: StyleData
}
LayoutBoxFaceLimit :: 8
layout_box_faces: [8]LayoutBoxFace;
layout_box_face_count: s32;

// The face a content-sized container paints at End: a Box's own, else its CSS.
LayoutClosingFace :: (index: s32, node: TreeEntry, box: *StyleBoxData) -> StyleData {
    while layout_box_face_count > 0 {
        top := layout_box_faces[layout_box_face_count - 1]
        if top.node < index { break }
        layout_box_face_count -= 1
        if top.node == index { return top.face }
    }
    return LayoutFace(PropsModule.Props.{.id = node.style_id, .class_name = node.style_class},
        node.kind, null, box)
}


#program_export
LayoutCloseContent :: (session: Session, index: s32) {
    node := TreeSubmittedNodeAt(session, index)
    bounds := node.bounds
    bounds.height = LayoutContentHeight(session, index, node.kind)
    TreeSetSubmittedBounds(session, index, bounds)
    size := TreeContentSizeAt(session, index)
    if size.paint_mark >= 0 {
        box: StyleBoxData
        face := LayoutClosingFace(index, node, *box)
        layout_box_paint(session, bounds, face, box, size.paint_mark, index)
    }
    if node.auto_placed { LayoutGrowParent(session, node.parent, bounds, size) }
}

LayoutBoxHeight :: (height: float32, face: StyleData, box: StyleBoxData) -> float32 {
    if (box.fields & cast(u32)StyleBoxMaxHeight) != 0 && box.max_height >= 0.0 &&
        height > box.max_height { height = box.max_height }
    if StyleHasField(face, cast(u32)StyleMinHeight) && height < face.min_height { height = face.min_height }
    return height
}

LayoutParentBounds :: (session: Session, inset_sections: bool = false) -> Rectangle {
    parent_index := TreeCurrentParent(session)
    parent_kind := TreeSubmittedNodeAt(session, parent_index).kind
    parent := TreeCurrentParentBounds(session)
    if parent_kind == WidgetKindRow || parent_kind == WidgetKindColumn || parent_kind == WidgetKindStack ||
        (inset_sections && (parent_kind == WidgetKindPage || parent_kind == WidgetKindSection)) {
        outer := TreeLayoutAt(session, parent_index)
        parent = LayoutMetricsFor(outer.bounds, outer.gap, outer.padding, outer.padding_y).content
    }
    return parent
}

// With `own`, the container takes that face's padding, gap and paint and no
// CSS of its own (see Box).
#program_export
ContainerFor :: (session: Session, props: PropsModule.Props,
    kind: s32, own: *StyleData = null) -> LayoutContainer {
    result: LayoutContainer = .{.node = -1, .kind = kind, .bounds = props.bounds}
    parent := LayoutParentBounds(session)
    box: StyleBoxData
    face := ifx own != null then <<own else LayoutFace(props, kind, null, *box)
    if face.percent != 0 || box.percent != 0 { LayoutResolvePercent(*face, *box, LayoutPercentBasis(session, parent)) }
    auto_width := LayoutAutoWidth(props.bounds.width, face)
    result.bounds.width = LayoutExtentFor(props.bounds.width, parent.width,
        face.width, StyleHasField(face, cast(u32)StyleWidth))
    // In a placing row an auto width takes what the earlier siblings left,
    // and an auto height stretches to a row of definite height. In a column
    // of definite height, CSS flex-grow takes the height that is left.
    holder := TreeSubmittedNodeAt(session, TreeCurrentParent(session))
    placed := holder.places_children && props.bounds.x == 0.0 && props.bounds.y == 0.0
    in_row := placed && holder.kind == WidgetKindRow
    if in_row && auto_width {
        rest := LayoutRemaining(session, true)
        result.bounds.width = ifx rest > 0.0 then rest else 0.0
    }
    auto_height := LayoutAutoHeight(props.bounds.height, face)
    content_sized := (kind == WidgetKindRow || kind == WidgetKindColumn) && auto_height &&
        !(in_row && parent.height > 0.0)
    result.bounds.height = LayoutExtentFor(props.bounds.height, parent.height,
        face.height, StyleHasField(face, cast(u32)StyleHeight))
    if content_sized && placed && holder.kind == WidgetKindColumn && parent.height > 0.0 &&
        LayoutGrows(props, kind) {
        rest := LayoutRemaining(session, false)
        if rest > 0.0 {
            result.bounds.height = rest
            content_sized = false
        }
    }
    if (box.fields & cast(u32)LayoutBoxWidthFields) != 0 {
        result.bounds.width = LayoutBoxWidth(AutoGridChildWidth(session, result.bounds), auto_width, box)
    }
    result.bounds.height = LayoutBoxHeight(result.bounds.height, face, box)
    if content_sized { result.bounds.height = 0.0 }
    gap := props.gap
    if kind == WidgetKindRow {
        gap = LayoutSpacingFor(props.column_gap, props.column_gap_override,
            props.gap, props.gap_override, face.column_gap)
    } else if kind == WidgetKindColumn {
        gap = LayoutSpacingFor(props.row_gap, props.row_gap_override,
            props.gap, props.gap_override, face.row_gap)
    }
    padding := LayoutSpacingFor(props.padding_x, props.padding_x_override,
        props.padding, props.padding_override, face.padding_x)
    padding_y := LayoutSpacingFor(props.padding_y, props.padding_y_override,
        props.padding, props.padding_override, face.padding_y)
    metrics := LayoutMetricsFor(result.bounds, gap, padding, padding_y)
    result.content = metrics.content
    result.gap = metrics.gap
    result.padding = metrics.padding
    result.padding_y = metrics.padding_y
    available := parent.width
    if in_row { available = LayoutRemaining(session, true) }
    return OpenContainer(session, props, result, box, available, content_sized, face, own != null)
}

// The slot a parent places: the border box plus its margins. An `auto`
// inline margin asks for the parent's whole inner width.
LayoutMarginSlot :: (bounds: Rectangle, box: StyleBoxData, available: float32) -> Rectangle {
    slot := bounds
    slot.width += LayoutMargin(box, .StyleBoxMarginLeft, box.margin_left) +
        LayoutMargin(box, .StyleBoxMarginRight, box.margin_right)
    slot.height += LayoutMargin(box, .StyleBoxMarginTop, box.margin_top) +
        LayoutMargin(box, .StyleBoxMarginBottom, box.margin_bottom)
    if (LayoutAutoMargin(box, .StyleBoxMarginLeft, box.margin_left) ||
        LayoutAutoMargin(box, .StyleBoxMarginRight, box.margin_right)) && available > slot.width {
        slot.width = available
    }
    return slot
}

// The border box inside its placed slot: fixed margins inset it, auto
// margins share the free inline space, and the computed size is kept.
LayoutBoxInSlot :: (placed: Rectangle, bounds: Rectangle, box: StyleBoxData) -> Rectangle {
    left := LayoutMargin(box, .StyleBoxMarginLeft, box.margin_left)
    right := LayoutMargin(box, .StyleBoxMarginRight, box.margin_right)
    top := LayoutMargin(box, .StyleBoxMarginTop, box.margin_top)
    bottom := LayoutMargin(box, .StyleBoxMarginBottom, box.margin_bottom)
    inner: Rectangle = .{placed.x + left, placed.y + top, bounds.width, bounds.height}
    if !(inner.width > 0.0) { inner.width = placed.width - left - right }
    if !(inner.height > 0.0) { inner.height = placed.height - top - bottom }
    if inner.width < 0.0 { inner.width = 0.0 }
    if inner.height < 0.0 { inner.height = 0.0 }
    free := placed.width - left - right - inner.width
    if free > 0.0 {
        auto_left := LayoutAutoMargin(box, .StyleBoxMarginLeft, box.margin_left)
        auto_right := LayoutAutoMargin(box, .StyleBoxMarginRight, box.margin_right)
        if auto_left && auto_right { inner.x += free / 2.0 }
        else if auto_left { inner.x += free }
    }
    return inner
}

OpenContainer :: (session: Session, props: PropsModule.Props,
    result: LayoutContainer, box: StyleBoxData, available: float32,
    content_sized: bool = false, face: StyleData = StyleData.{}, own_face: bool = false) -> LayoutContainer {
    if !TreeIsBuilding(session) { return result }
    if layout_box_paint == null { LayoutPaintInstall() }
    key: u64 = props.key
    if key == cast(u64)0 { key = TreeNextKey(session) }
    parent := TreeSubmittedNodeAt(session, TreeCurrentParent(session))
    boxed := (box.fields & cast(u32)LayoutBoxSlotFields) != 0 && parent.places_children &&
        result.bounds.x == 0.0 && result.bounds.y == 0.0
    slot := ifx boxed then LayoutMarginSlot(result.bounds, box, available) else result.bounds
    result.node = TreeSubmitCurrent(session, key, result.kind, slot)
    if result.node < 0 { return result }
    placed := TreeSubmittedBounds(session, result.node)
    if boxed {
        inner := LayoutBoxInSlot(placed, result.bounds, box)
        TreeSetSubmittedBounds(session, result.node, inner)
        placed = inner
    }
    result.bounds = placed
    result.content = LayoutMetricsFor(result.bounds, result.gap, result.padding, result.padding_y).content
    TreeSetLayout(session, result.node, result.gap, result.padding, 0, 0, 0,
        result.padding_y, -1, LayoutContentChildWidth)
    size := LayoutContentSizeFor(face, box)
    if LayoutPaintsBox(face, box) {
        if !content_sized {
            layout_box_paint(session, result.bounds, face, box, -1, result.node)
        } else if !own_face || layout_box_face_count < LayoutBoxFaceLimit {
            size.paint_mark = paint_primitives.mark(session)
            if own_face {
                // Node indices grow within a frame: an entry at or past this
                // node is left from an earlier frame.
                while layout_box_face_count > 0 &&
                    layout_box_faces[layout_box_face_count - 1].node >= result.node {
                    layout_box_face_count -= 1
                }
                layout_box_faces[layout_box_face_count] = .{.node = result.node, .face = face}
                layout_box_face_count += 1
            }
        }
    }
    if content_sized { TreeSetClose(session, result.node, LayoutCloseContent, size) }
    if box.clip_children {
        // A content-sized box clips its sides now and its bottom at max-height.
        clip := result.bounds
        if content_sized { clip.height = ifx size.max >= 0.0 then size.max else 16777216.0 }
        TreeSetChildClip(session, result.node, clip)
    }
    if props.id != 0 { TreeSetStyleId(session, result.node, props.id) }
    if props.class_name != 0 { TreeSetStyleClass(session, result.node, props.class_name) }
    result.opened = TreePushScope(session, result.node)
    return result
}

EmptyFlexItems :: () -> []FlexItem {
    items: []FlexItem
    return items
}

EmptyFlexBoxes :: () -> []FlexPlacement {
    boxes: []FlexPlacement
    return boxes
}

#scope_package
Draw :: (session: Session, props: PropsModule.Props, items: []FlexItem = EmptyFlexItems(),
    boxes: []FlexPlacement = EmptyFlexBoxes()) -> LayoutContainer {
    if items.count > 0 { return MeasuredFlex(session, props, WidgetKindColumn, items, boxes) }
    result: LayoutContainer = ContainerFor(session, props, WidgetKindColumn)
    TreeSetPlacement(session, result.node, TreePlaceColumn)
    return result
}

#scope_export
#program_export
#scope_package
Row :: (session: Session, props: PropsModule.Props, items: []FlexItem = EmptyFlexItems(),
    boxes: []FlexPlacement = EmptyFlexBoxes()) -> LayoutContainer {
    if items.count > 0 { return MeasuredFlex(session, props, WidgetKindRow, items, boxes) }
    result: LayoutContainer = ContainerFor(session, props, WidgetKindRow)
    TreeSetPlacement(session, result.node, TreePlaceRow)
    return result
}

#scope_export
ResolveLayoutFlexItem :: (item: FlexItem) -> FlexItem {
    facts := StyleDefaultFacts(item.kind)
    facts.id = item.id
    facts.class_name = item.class_name
    flex := ResolveInstalledFlexItem(facts)
    if !item.has_basis && (flex.fields & cast(u32)StyleFlexBasis) != 0 && flex.basis >= 0.0 {
        item.basis = flex.basis
        item.has_basis = true
        item.basis_percent = (flex.percent & cast(u32)StyleFlexBasis) != 0
    }
    if item.grow == 0.0 && !item.grow_override && (flex.fields & cast(u32)StyleFlexGrow) != 0 {
        item.grow = flex.grow
    }
    if item.shrink == 0.0 && !item.shrink_override {
        item.shrink = ifx (flex.fields & cast(u32)StyleFlexShrink) != 0 then flex.shrink else 1.0
    }
    if !item.has_align_self && (flex.fields & cast(u32)StyleFlexSelf) != 0 && flex.align_self >= 0 {
        item.align_self = cast(AlignItems)flex.align_self
        item.has_align_self = true
    }
    if item.order == 0 && (flex.fields & cast(u32)StyleFlexOrder) != 0 {
        item.order = flex.order
    }
    box: StyleBoxData
    ResolveIndexedStyle(StyleData.{}, facts, StyleStateAny(), false, null, cast(u32)0,
        *box, cast(u32)StyleBoxMinWidth | cast(u32)StyleBoxMaxWidth | cast(u32)StyleBoxMaxHeight)
    if item.min_width <= 0.0 && (box.fields & cast(u32)StyleBoxMinWidth) != 0 {
        item.min_width = box.min_width
    }
    if item.max_width <= 0.0 && (box.fields & cast(u32)StyleBoxMaxWidth) != 0 && box.max_width > 0.0 {
        item.max_width = box.max_width
    }
    if item.max_height <= 0.0 && (box.fields & cast(u32)StyleBoxMaxHeight) != 0 && box.max_height > 0.0 {
        item.max_height = box.max_height
    }
    if item.min_height <= 0.0 {
        face := ResolveIndexedStyle(StyleData.{}, facts, StyleStateAny(), true, null, cast(u32)0)
        if StyleHasField(face, cast(u32)StyleMinHeight) { item.min_height = face.min_height }
    }
    return item
}

MeasuredFlex :: (session: Session, props: PropsModule.Props, kind: s32,
    items: []FlexItem, boxes: []FlexPlacement) -> LayoutContainer {
    result: LayoutContainer = .{.node = -1, .kind = kind, .bounds = props.bounds}
    if boxes.count < items.count { return result }
    style: StyleFlexData
    box: StyleBoxData
    face := LayoutFace(props, kind, *style, *box)
    parent := LayoutParentBounds(session, true)
    if face.percent != 0 || box.percent != 0 { LayoutResolvePercent(*face, *box, LayoutPercentBasis(session, parent)) }
    direction := ifx kind == WidgetKindColumn then 1 else 0
    if (style.fields & cast(u32)StyleFlexDirection) != 0 { direction = style.direction }
    horizontal := (direction & 1) == 0
    align: AlignItems = .AlignStretch
    if (style.fields & cast(u32)StyleFlexAlign) != 0 { align = cast(AlignItems)style.align_items }

    auto_width := LayoutAutoWidth(props.bounds.width, face)
    result.bounds.width = LayoutExtentFor(props.bounds.width, parent.width,
        face.width, StyleHasField(face, cast(u32)StyleWidth))
    result.bounds.width = LayoutBoxWidth(AutoGridChildWidth(session, result.bounds), auto_width, box)
    height_limit := ifx !horizontal && style.wrap then parent.height else 0.0
    result.bounds.height = LayoutExtentFor(props.bounds.height, height_limit,
        face.height, StyleHasField(face, cast(u32)StyleHeight))
    if result.bounds.height > 0.0 { result.bounds.height = LayoutBoxHeight(result.bounds.height, face, box) }
    row_gap := LayoutSpacingFor(props.row_gap, props.row_gap_override, props.gap, props.gap_override, face.row_gap)
    column_gap := LayoutSpacingFor(props.column_gap, props.column_gap_override,
        props.gap, props.gap_override, face.column_gap)
    result.gap = ifx horizontal then column_gap else row_gap
    result.padding = LayoutSpacingFor(props.padding_x, props.padding_x_override,
        props.padding, props.padding_override, face.padding_x)
    result.padding_y = LayoutSpacingFor(props.padding_y, props.padding_y_override,
        props.padding, props.padding_override, face.padding_y)
    metrics := LayoutMetricsFor(result.bounds, result.gap, result.padding, result.padding_y)
    content := metrics.content
    cross := PlaceFlexItems(FlexProps.{.bounds = content, .direction = cast(FlexDirection)(direction & 1),
        .reverse = direction >= 2, .justify_content = cast(JustifyContent)style.justify_content,
        .align_items = align, .align_content = cast(AlignContent)style.align_content,
        .wrap = style.wrap, .wrap_reverse = style.wrap_reverse, .gap = result.gap,
        .cross_gap = ifx horizontal then row_gap else column_gap}, items, boxes, ResolveLayoutFlexItem)
    if result.bounds.height <= 0.0 {
        height := cross
        if !horizontal {
            height = 0.0
            for i: cast(s32)0..cast(s32)items.count - 1 {
                bottom := boxes[i].bounds.y + boxes[i].bounds.height - content.y
                if bottom > height { height = bottom }
            }
        }
        result.bounds.height = LayoutBoxHeight(height + cast(float32)result.padding_y * 2.0, face, box)
    }
    result.content = LayoutMetricsFor(result.bounds, result.gap, result.padding, result.padding_y).content
    before := result.bounds
    result = OpenContainer(session, props, result, box, parent.width, false, face)
    for i: cast(s32)0..cast(s32)items.count - 1 {
        boxes[i].bounds.x += result.bounds.x - before.x
        boxes[i].bounds.y += result.bounds.y - before.y
    }
    return result
}

// A padded column, or a row with `kind` WidgetKindRow, whose box paints
// `face` (fill, border, radius and elevation) and takes its padding and gap
// instead of CSS of its own: a composite widget such as Card resolves its
// face and lays out its content here. Without a height it sizes to its
// children and paints its box at End, beneath them.
#program_export
Box :: (session: Session, props: PropsModule.Props, face: StyleData,
    kind: s32 = WidgetKindColumn) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, kind, *face)
    if kind == WidgetKindRow { TreeSetPlacement(session, result.node, TreePlaceRow) }
    else { TreeSetPlacement(session, result.node, TreePlaceColumn) }
    return result
}

// A row that wraps: children keep their widths and move to a new line when
// the next one would pass the content edge; it sizes to its lines.
#program_export
Flow :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, WidgetKindRow)
    TreeSetPlacement(session, result.node, TreePlaceFlow)
    return result
}

// The next child this grid places takes `span` tracks; -1 is the whole row,
// as CSS `grid-column: 1 / -1`.
#program_export
GridSpan :: (session: Session, grid: LayoutContainer, span: s32) {
    progress := TreeLayoutProgressAt(session, grid.node)
    progress.span = span
    TreeSetLayoutProgress(session, grid.node, progress)
}

#program_export
#scope_package
Stack :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, WidgetKindStack)
    TreeSetPlacement(session, result.node, TreePlaceStack)
    return result
}

#scope_export
#program_export
Group :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    return ContainerFor(session, props, WidgetKindGroup)
}

#program_export
Screen :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    root: Rectangle = TreeRootBounds(session)
    if props.bounds.width <= 0.0 { props.bounds.width = root.width }
    if props.bounds.height <= 0.0 { props.bounds.height = root.height }
    return ContainerFor(session, props, WidgetKindGroup)
}

EmptyGridItems :: () -> []GridItem {
    items: []GridItem
    return items
}

EmptyGridBounds :: () -> []Rectangle {
    bounds: []Rectangle
    return bounds
}

AutoGridChildWidth :: (session: Session, bounds: Rectangle) -> float32 {
    if bounds.x != 0.0 || bounds.y != 0.0 { return bounds.width }
    parent_index := TreeCurrentParent(session)
    node := TreeSubmittedNodeAt(session, parent_index)
    if node.kind != WidgetKindGrid || !node.places_children { return bounds.width }
    track := GridStep(LayoutGridCursor(TreeLayoutAt(session, parent_index)), 0, 1)
    return track.item.width
}

// A container owns its width policy, just as it owns child placement.
LayoutContentChildWidth :: (session: Session, index: s32) -> float32 {
    node := TreeSubmittedNodeAt(session, index)
    if node.kind == WidgetKindRow { return 0.0 }
    info := TreeLayoutAt(session, index)
    return LayoutMetricsFor(info.bounds, info.gap, info.padding, info.padding_y).content.width
}

LayoutGridChildWidth :: (session: Session, index: s32) -> float32 {
    track := GridStep(LayoutGridCursor(TreeLayoutAt(session, index)), 0, 1)
    return track.item.width
}

#program_export
Grid :: (session: Session, props: GridProps, items: []GridItem = EmptyGridItems(),
    item_bounds: []Rectangle = EmptyGridBounds()) -> GridResult {
    scope: PropsModule.Props = .{.key = props.key, .id = props.id, .class_name = props.class_name}
    box: StyleBoxData
    face := LayoutFace(scope, WidgetKindGrid, null, *box)
    parent := LayoutParentBounds(session, true)
    if face.percent != 0 || box.percent != 0 { LayoutResolvePercent(*face, *box, LayoutPercentBasis(session, parent)) }
    auto_width := LayoutAutoWidth(props.bounds.width, face)
    props.bounds.width = LayoutExtentFor(props.bounds.width, parent.width,
        face.width, StyleHasField(face, cast(u32)StyleWidth))
    props.bounds.width = LayoutBoxWidth(AutoGridChildWidth(session, props.bounds), auto_width, box)
    props.row_gap = LayoutSpacingFor(props.row_gap, props.row_gap_override,
        props.gap, props.gap_override, face.row_gap)
    props.row_gap_override = true
    props.gap = LayoutSpacingFor(0, false, props.gap, props.gap_override, face.column_gap)
    props.padding_y = LayoutSpacingFor(props.padding_y, props.padding_y_override,
        props.padding, props.padding_override, face.padding_y)
    props.padding_y_override = true
    props.padding = LayoutSpacingFor(0, false, props.padding, props.padding_override, face.padding_x)
    if props.columns <= 0 && props.min_item_width <= 0 {
        if face.grid_tracks >= 0 { props.columns = face.grid_tracks }
        else {
            props.min_item_width = -face.grid_tracks
            // Collapse empty auto-fit tracks when declared items fit in one row.
            occupied: s64 = 0
            for item: items {
                if item.column_span < 0 { occupied = 0; break }
                occupied += ifx item.column_span > 0 then item.column_span else 1
            }
            if occupied > 0 && occupied <= 2147483647 &&
                (props.max_columns <= 0 || occupied < cast(s64)props.max_columns) {
                props.max_columns = cast(s32)occupied
            }
        }
    }
    content_height: float32 = 0.0
    content_sized := items.count == 0 && LayoutAutoHeight(props.bounds.height, face)
    measured := BeginGridCursor(props)
    if items.count > 0 {
        content_height = cast(float32)(PlaceGridItems(measured, items, item_bounds) + 2 * props.padding_y)
    }
    props.bounds.height = LayoutExtentFor(props.bounds.height, content_height,
        face.height, StyleHasField(face, cast(u32)StyleHeight))
    if !content_sized { props.bounds.height = LayoutBoxHeight(props.bounds.height, face, box) }

    metrics := MeasureGrid(props)
    container: LayoutContainer = .{.node = -1, .kind = WidgetKindGrid, .bounds = props.bounds,
        .content = metrics.content, .gap = props.gap, .padding = props.padding,
        .padding_y = props.padding_y}
    container = OpenContainer(session, scope, container, box, parent.width, content_sized, face)
    TreeSetLayout(session, container.node, props.gap, props.padding, metrics.columns,
        0, 0, props.padding_y, props.row_gap, LayoutGridChildWidth)
    if items.count == 0 { TreeSetPlacement(session, container.node, TreePlaceGrid) }
    props.bounds = container.bounds
    cursor := BeginGridCursor(props)
    for index: 0..cast(s32)items.count - 1 {
        if index >= cast(s32)item_bounds.count { break }
        item_bounds[index].x += cast(float32)(cursor.x - measured.x)
        item_bounds[index].y += cast(float32)(cursor.y - measured.y)
    }
    return .{.container = container, .cursor = cursor}
}

}

#program_export
CenteredBandsFor :: (bounds: Rectangle, width: float32) -> BehaviorModule.CenteredBands {
    return BehaviorModule.LayoutCenteredBands(bounds, width)
}
