#import "kss_parser"
#import "style_sheet"

# The parser and its rule table are owned values. An application may pause at
# NeedImport, provide the requested source, then keep parsing the same table.
StyleRulesParse :: struct {
    parser: KssParser
    rules: StyleRules
    overflow: bool
}

#program_export
BeginStyleRules :: (source: string, path: string,
    environment: KssEnvironment) -> StyleRulesParse {
    result: StyleRulesParse
    result.parser = KssBegin(source, path, environment)
    return result
}

#program_export
StepStyleRules :: (result: StyleRulesParse) -> StyleRulesParse {
    if result.overflow { return result }
    result.parser = KssStep(result.parser)
    if result.parser.status == cast(s32)KssStatusRule {
        if result.rules.count < 0 || result.rules.count >= 320 {
            result.overflow = true
        } else {
            result.rules.items[result.rules.count] = result.parser.rule
            result.rules.count += 1
        }
    }
    return result
}

#program_export
ParseStyleRules :: (result: StyleRulesParse) -> StyleRulesParse {
    while !result.overflow &&
        result.parser.status != cast(s32)KssStatusNeedImport &&
        result.parser.status != cast(s32)KssStatusDone &&
        result.parser.status != cast(s32)KssStatusError {
        result = StepStyleRules(result)
    }
    return result
}

#program_export
ProvideStyleRulesImport :: (result: StyleRulesParse,
    source: string, name: string) -> StyleRulesParse {
    if !result.overflow &&
        result.parser.status == cast(s32)KssStatusNeedImport {
        result.parser = KssProvideImport(result.parser, source, name)
    }
    return result
}

#program_export
FailStyleRulesImport :: (result: StyleRulesParse) -> StyleRulesParse {
    if !result.overflow &&
        result.parser.status == cast(s32)KssStatusNeedImport {
        result.parser = KssFailImport(result.parser)
    }
    return result
}
