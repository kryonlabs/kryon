#module "guide_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/guide.h"
#import "runtime/style.h"

GuideDrawScrim :: (scrim: GuideScrim, color: Color) {
    DrawRectangleRec(scrim.top, color)
    DrawRectangleRec(scrim.bottom, color)
    DrawRectangleRec(scrim.left, color)
    DrawRectangleRec(scrim.right, color)
}

GuideDrawArrow :: (tip: Rectangle, anchor: Rectangle, color: Color,
metrics: GuideMetrics) {
    arrow: GuideArrow = GuideArrowFor(tip, anchor, metrics)
    if arrow.stroke_width > 0.0 {
        DrawLineEx(arrow.line_start, arrow.line_end, arrow.stroke_width,
        color)
    }
    if metrics.gap > 0 {
        DrawTriangle(arrow.tip0, arrow.tip1, arrow.tip2, color)
    }
}

GuideFrame :: (role: i32, state: ButtonState) -> StyleFrame {
    props: ButtonProps = (ButtonProps){
        .tone = ButtonToneNeutral,
        .emphasis = ButtonEmphasisSoft,
        .icon_only = true}
    return ui_control_style_frame_role_kind(props, state, 0, 0.0,
    0.0, 0.0, StyleKindGuide(), role)
}

GuideStyle :: (role: i32, state: ButtonState) -> Style {
    return ui_unpack_style(GuideFrame(role, state).value)
}

GuideIconAction :: (bounds: Rectangle, icon: Texture2D, size: i32,
padding: i32, normal: Style, hover: Style) -> IconActionSpec {
    props: IconActionSpec = (IconActionSpec){0}
    props.bounds = bounds
    props.icon = icon
    props.icon_size = size
    props.icon_padding = padding
    props.background = normal.background
    props.hover_background = hover.background
    props.icon_color = normal.foreground
    props.border = normal.border
    props.radius = normal.radius
    return props
}

RenderGuideOverlay :: (guide: GuideOverlayProps) -> GuideResult #export {
    result: GuideResult = (GuideResult){0}
    if guide.steps == nil || guide.count <= 0 || guide.step == nil {
        return result
    }

    metrics: GuideMetrics = GuideMetricsFor((float)GetScale(),
    GuideFrame(2, ButtonStateNormal),
    GuideFrame(24, ButtonStateNormal),
    GuideFrame(6, ButtonStateNormal),
    GuideFrame(17, ButtonStateNormal),
    GuideFrame(15, ButtonStateNormal))
    view_width: i32 = guide.view_width
    if view_width <= 0 { view_width = ui_view_width }
    view_height: i32 = guide.view_height
    if view_height <= 0 { view_height = ui_view_height }
    step: i32 = GuideStepFor(*guide.step, guide.count)
    *guide.step = step
    result.step = step

    keyboard_input: GuideInput = GuideInputFor(
    IsKeyPressed(KEY_LEFT) != 0, IsKeyPressed(KEY_RIGHT) != 0,
    IsKeyPressed(KEY_ENTER) != 0, IsKeyPressed(KEY_BACK) != 0,
    IsKeyPressed(KEY_ESCAPE) != 0)
    previous_requested: i32 = keyboard_input.previous_requested
    next_requested: i32 = keyboard_input.next_requested
    policy: GuidePolicy = GuidePolicyFor(step, guide.count,
    previous_requested != 0, next_requested != 0,
    keyboard_input.close_requested != 0)
    if policy.closed || policy.finished || policy.changed {
        *guide.step = policy.step
        result.step = policy.step
        result.changed = policy.changed
        result.closed = policy.closed
        result.finished = policy.finished
        return result
    }

    panel_style: Style = GuideStyle(2, ButtonStateNormal)
    label_style: Style = GuideStyle(6, ButtonStateNormal)
    scrim_style: Style = GuideStyle(19, ButtonStateNormal)
    anchor_style: Style = GuideStyle(24, ButtonStateNormal)
    close_style: Style = GuideStyle(15, ButtonStateNormal)
    close_hover_style: Style = GuideStyle(15, ButtonStateHover)
    action_style: Style = GuideStyle(17, ButtonStateNormal)
    action_hover_style: Style = GuideStyle(17, ButtonStateHover)
    tip_width: i32 = GuideTipWidth(view_width, guide.max_width, metrics)
    max_tip_height: i32 = GuideMaxTipHeight(view_height,
    guide.reserved_top, guide.reserved_bottom, metrics)
    paragraph: ParagraphSpec = (ParagraphSpec){0}
    paragraph.text = guide.steps[step].text
    paragraph.width = tip_width - metrics.pad * 2
    paragraph.font = GuideParagraphFontFor(guide.paragraph_font,
    StyleFontValue(label_style.fields, label_style.font_size), Text16)
    label_font: i32 = paragraph.font
    paragraph.line_gap = GuideLineGapFor(guide.line_gap, metrics)
    label_color: Color = GetColor(Opacity(
    ColorToInt(label_style.foreground), label_style.opacity))
    paragraph_height: i32 = ui_paragraph_height(paragraph)
    while GuideShouldShrinkParagraphFont(paragraph_height,
    GuideParagraphHeightLimit(max_tip_height, metrics),
    paragraph.font, Text12) {
        paragraph.font = GuideShrinkParagraphFontStep(paragraph_height,
        GuideParagraphHeightLimit(max_tip_height, metrics),
        paragraph.font, Text12)
        paragraph_height = ui_paragraph_height(paragraph)
    }

    tip_height: i32 = GuideTipHeight(paragraph_height,
    max_tip_height, metrics)
    tip: Rectangle = GuideTipBounds(guide.steps[step].anchor,
    tip_width, tip_height, view_width, view_height,
    guide.reserved_top, guide.reserved_bottom, metrics)
    layout: GuideLayout = GuideLayoutFor(tip, paragraph.width,
    paragraph_height, step, guide.count, metrics)
    SetModalCapture(tip)
    GuideDrawScrim(GuideScrimFor(view_width, view_height,
    guide.steps[step].anchor, metrics),
    GetColor(Opacity(ColorToInt(scrim_style.background),
    scrim_style.opacity)))
    DrawRectangleLinesEx(guide.steps[step].anchor,
    (float)metrics.anchor_stroke, anchor_style.border)
    GuideDrawArrow(tip, guide.steps[step].anchor,
    anchor_style.foreground, metrics)
    ui_draw_material(tip, (Rectangle){0}, panel_style.background,
    panel_style.border, panel_style.border, panel_style.radius,
    panel_style.border_width, 0.0, 0.0, 0, panel_style.focus, 0.0,
    panel_style.opacity, ui_style_fill(panel_style),
    panel_style.material)

    icon: IconActionSpec = GuideIconAction(layout.close_button,
    guide.close_icon, metrics.close_icon_size,
    metrics.close_icon_padding, close_style, close_hover_style)
    if RenderIconAction(icon) {
        result.closed = 1
        return result
    }

    y: i32 = (int)layout.text.y
    if layout.text_clip_height > 0 {
        if layout.text_clipped {
            BeginClip((int)layout.text.x,
            y - metrics.text_guard / 2,
            paragraph.width,
            layout.text_clip_height + metrics.text_guard)
        }
        Paragraph(paragraph, (int)layout.text.x, &y)
        if layout.text_clipped { EndClip() }
    }

    page_text: [32]char
    snprintf(&page_text[0], 32, "%d/%d", step + 1, guide.count)
    RenderText(&page_text[0], (int)tip.x + metrics.pad,
    layout.controls_y + (metrics.button_size - label_font) / 2,
    label_font, label_color)
    if step > 0 {
        icon = GuideIconAction(layout.back_button, guide.back_icon,
        metrics.nav_icon_size, metrics.nav_icon_padding,
        action_style, action_hover_style)
        if RenderIconAction(icon) { previous_requested = 1 }
    }
    next_icon: Texture2D = guide.next_icon
    if layout.finish { next_icon = guide.done_icon }
    icon = GuideIconAction(layout.next_button, next_icon,
    metrics.nav_icon_size, metrics.nav_icon_padding,
    action_style, action_hover_style)
    if RenderIconAction(icon) { next_requested = 1 }

    policy = GuidePolicyFor(step, guide.count,
    previous_requested != 0, next_requested != 0, false)
    *guide.step = policy.step
    result.step = policy.step
    result.changed = policy.changed
    result.closed = policy.closed
    result.finished = policy.finished
    return result
}
