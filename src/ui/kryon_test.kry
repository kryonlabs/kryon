#module "kryon_test"
#import "ui_inspect_props.generated.h"
#import "kry_inject.h"
#import "kry_sfs.h"
#import "stdio.h"
#import "string.h"

kryt_last_text :: [1024]char #global
kryt_last_key :: [64]char #global
kryt_last_shot :: [256]char #global

kryt_copy :: (dst: *char, dst_size: size_t,
source: const char*) {
    if dst == nil || dst_size == 0 { return }
    value: const char* = source
    if value == nil { value = "" }
    snprintf(dst, dst_size, "%s", value)
}

KryTFind :: (selector: const char*,
node: *InspectNode) -> i32 #export {
    return InspectFindNode(selector, node)
}

KryTTap :: (selector: const char*) -> i32 #export {
    node: InspectNode = {0}
    if !KryTFind(selector, &node) { return 0 }
    InjectTap(node.bounds.x + node.bounds.width / 2.0,
    node.bounds.y + node.bounds.height / 2.0)
    return 1
}

KryTType :: (value: const char*) -> i32 #export {
    kryt_copy(&kryt_last_text[0], sizeof(kryt_last_text), value)
    if value == nil || value[0] == '\0' { return 0 }
    InjectText(value)
    return 1
}

KryTKey :: (key: const char*) -> i32 #export {
    name: [96]char
    path: [160]char
    kryt_copy(&kryt_last_key[0], sizeof(kryt_last_key), key)
    if key == nil || key[0] == '\0' { return 0 }
    if strncmp(key, "KEY_", 4) == 0 {
        snprintf(&name[0], sizeof(name), "%s", key)
    } else {
        snprintf(&name[0], sizeof(name), "KEY_%s", key)
    }
    snprintf(&path[0], sizeof(path), "/input/keys/%s", &name[0])
    return KrySfsWrite(&path[0], "tap") == 1
}

KryTSee :: (value: const char*) -> i32 #export {
    node: InspectNode = {0}
    selector: [96]char
    if value == nil || value[0] == '\0' { return 0 }
    snprintf(&selector[0], sizeof(selector), "text=%s", value)
    return KryTFind(&selector[0], &node)
}

KryTShot :: (name: const char*) -> i32 #export {
    kryt_copy(&kryt_last_shot[0], sizeof(kryt_last_shot), name)
    return name != nil && name[0] != '\0'
}

KryTLastText :: () -> const char* #export {
    return &kryt_last_text[0]
}

KryTLastKey :: () -> const char* #export {
    return &kryt_last_key[0]
}

KryTLastShot :: () -> const char* #export {
    return &kryt_last_shot[0]
}
