#module "scaling_host"
#import "ui_dpi_props.generated.h"

scale_value :: float = 1.0 #global

SetScale :: (scale: float) #export {
    if scale > 0.0 { scale_value = scale }
}

GetScale :: () -> float #export {
    return scale_value
}

Scale :: (px: i32) -> i32 #export {
    return (int)((float)px * scale_value + 0.5)
}

ClampPx :: (px: i32, min_px: i32, max_px: i32) -> i32 #export {
    value: i32 = Scale(px)
    minimum: i32 = Scale(min_px)
    maximum: i32 = Scale(max_px)
    if value < minimum { value = minimum }
    if value > maximum { value = maximum }
    return value
}
