App :: #import "kryon/app";
Layout :: #import "kryon/layout";
Skeleton :: #import "kryon/skeleton";
Text :: #import "kryon/text";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"

// A card's shape while its content loads: an avatar, two lines and a block.
seconds: float64;

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    if !example_reduced_motion { seconds += 1.0 / 60.0 }
    column := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5), .padding_override = true,
        .gap = 10, .gap_override = true})
    if !column.opened { return }
    Text.Draw(session, Text.Props.{.bounds = .{height = 40}, .text = "Skeleton", .size = 28})
    Skeleton.Draw(session, Skeleton.Props.{.shape = .SkeletonCircle, .now = seconds})
    Skeleton.Draw(session, Skeleton.Props.{.shape = .SkeletonLine, .now = seconds})
    Skeleton.Draw(session, Skeleton.Props.{.shape = .SkeletonLine, .now = seconds, .bounds = .{width = column.content.width * 0.6}})
    Skeleton.Draw(session, Skeleton.Props.{.shape = .SkeletonBlock, .now = seconds})
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "skeleton"}, Frame) }
