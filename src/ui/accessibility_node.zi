#import "geometry"

AccessibilityNode :: struct {
    bounds: Rectangle
    role: string
    label: string
    focused: bool
    disabled: bool
    checked: bool
    focus_id: s32
    value: string
    read_only: bool
    secure: bool
    multiline: bool
    generation: u64
    actions: u32
    selection_anchor: s32
    selection_cursor: s32
    key: u64
    parent: u32
    selected: bool
    multi_select: bool
    item_index: s32
    offscreen: bool
}
