#import "geometry"
#import "layout_props"

LayoutMetrics :: struct {
    content: Rectangle
    gap: s32
    padding: s32
    padding_y: s32
}

// Stable widget identity from UTF-8 bytes. This matches the native Key
// helper, including its historical offset basis and zero sentinel.
#program_export
KeyHash :: (text: string) -> u64 {
    hash: u64 = cast(u64)1469598103934665603
    index: s32 = 0
    while index < (cast(s32)text.count) {
        hash = (hash ^ cast(u64)text[index]) * cast(u64)1099511628211
        index += 1
    }
    if hash == cast(u64)0 { return cast(u64)1 }
    return hash
}

CenteredColumnLayout :: struct {
    x: s32
    width: s32
}

FlexDirection :: enum {
    FlexRow :: 0
    FlexColumn
}

JustifyContent :: enum {
    JustifyStart :: 0
    JustifyCenter
    JustifyEnd
    JustifySpaceBetween
    JustifySpaceAround
    JustifySpaceEvenly
}

AlignItems :: enum {
    AlignStart :: 0
    AlignCenter
    AlignEnd
    AlignStretch
}
using FlexDirection;
using JustifyContent;
using AlignItems;


FlexProps :: struct {
    bounds: Rectangle
    direction: FlexDirection
    justify_content: JustifyContent
    align_items: AlignItems
    gap: s32
    padding: s32
    cross_gap: s32
    wrap: bool
    reverse: bool
}

FlexItem :: struct {
    width: float32
    height: float32
    basis: float32
    has_basis: bool
    grow: float32
    shrink: float32
    align_self: AlignItems
    has_align_self: bool
    kind: s32
    id: s32
    class_name: s32
    grow_override: bool
    shrink_override: bool
}

FlexItemResolver :: #type (item: FlexItem) -> FlexItem;

FlexPlacement :: struct {
    bounds: Rectangle
    grow: float32
    shrink: float32
    align: AlignItems
}

FlexCursor :: struct {
    content: Rectangle
    item: Rectangle
    direction: FlexDirection
    align_items: AlignItems
    position: float32
    gap: float32
    remaining: s32
}

Clamp :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    out: s32 = value
    if out < min_value { out = min_value }
    if out > max_value { out = max_value }
    return out
}

#program_export
CenteredColumnFor :: (view_width: s32, max_width: s32, side_padding: s32) -> CenteredColumnLayout {
    layout: CenteredColumnLayout
    if view_width < 0 { view_width = 0 }
    if max_width < 0 { max_width = 0 }
    if side_padding < 0 { side_padding = 0 }
    available: s32 = view_width - side_padding * 2
    if available < 0 { available = 0 }
    layout.width = max_width
    if layout.width > available { layout.width = available }
    layout.x = (view_width - layout.width) / 2
    return layout
}

#program_export
PageSidePaddingFor :: (view_width: s32) -> s32 {
    padding: s32 = view_width / 50
    return Clamp(padding, 12, 24)
}

#program_export
DesktopWidthThresholdFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(500.0 * scale + 0.5)
}

#program_export
IsDesktopWidth :: (view_width: s32, scale: float32) -> bool {
    return view_width >= DesktopWidthThresholdFor(scale)
}

#program_export
LayoutMetricsFor :: (bounds: Rectangle, gap: s32, padding: s32, padding_y: s32 = -1) -> LayoutMetrics {
    metrics: LayoutMetrics
    if gap < 0 { gap = 0 }
    if padding < 0 { padding = 0 }
    if padding_y < 0 { padding_y = padding }
    metrics.gap = gap
    metrics.padding = padding
    metrics.padding_y = padding_y
    metrics.content.x = bounds.x + cast(float32)padding
    metrics.content.y = bounds.y + cast(float32)padding_y
    metrics.content.width = bounds.width - cast(float32)padding * 2.0
    metrics.content.height = bounds.height - cast(float32)padding_y * 2.0
    if metrics.content.width < 0.0 { metrics.content.width = 0.0 }
    if metrics.content.height < 0.0 { metrics.content.height = 0.0 }
    return metrics
}

// Fit unset container axes to the measured children in submission order.
// Each child contributes a gap only when another child precedes it.
#program_export
LayoutContentBounds :: (bounds: Rectangle, direction: FlexDirection,
    children: []Rectangle, gap: s32 = 0, padding: s32 = 0, padding_y: s32 = -1) -> Rectangle {
    metrics := LayoutMetricsFor(bounds, gap, padding, padding_y)
    horizontal := direction != cast(FlexDirection)FlexColumn
    main: float32 = 0.0
    cross: float32 = 0.0
    for child: children {
        extent := ifx horizontal then child.width else child.height
        breadth := ifx horizontal then child.height else child.width
        if extent > 0.0 { main += extent }
        if breadth > cross { cross = breadth }
    }
    if children.count > 1 {
        main += cast(float32)(children.count - 1) * cast(float32)metrics.gap
    }
    if bounds.width <= 0.0 {
        bounds.width = cast(float32)metrics.padding * 2.0 + (ifx horizontal then main else cross)
    }
    if bounds.height <= 0.0 {
        bounds.height = cast(float32)metrics.padding_y * 2.0 + (ifx horizontal then cross else main)
    }
    return bounds
}

#program_export
LayoutScopeBounds :: (bounds: Rectangle, fallback_width: s32, fallback_height: s32) -> Rectangle {
    out: Rectangle = bounds
    if out.width <= 0.0 { out.width = cast(float32)fallback_width }
    if out.height <= 0.0 { out.height = cast(float32)fallback_height }
    if out.width < 0.0 { out.width = 0.0 }
    if out.height < 0.0 { out.height = 0.0 }
    return out
}

#program_export
LayoutCursorForChild :: (metrics: LayoutMetrics, horizontal: bool,
    child_index: s32, previous_extent_sum: float32) -> float32 {
    if child_index < 0 { child_index = 0 }
    base: float32 = metrics.content.y
    if horizontal { base = metrics.content.x }
    return base + previous_extent_sum + cast(float32)child_index * cast(float32)metrics.gap
}

#program_export
LayoutChildBounds :: (declared: Rectangle, current: Rectangle,
    metrics: LayoutMetrics, horizontal: bool, cursor: float32) -> Rectangle {
    out: Rectangle = current
    if horizontal {
        out.x = cursor
        out.y = metrics.content.y
        if out.height <= 0.0 { out.height = metrics.content.height }
    } else {
        out.x = metrics.content.x
        out.y = cursor
        if out.width <= 0.0 { out.width = metrics.content.width }
    }
    if declared.x != 0.0 || declared.y != 0.0 { return current }
    return out
}

#program_export
StackChildBounds :: (declared: Rectangle, current: Rectangle,
    metrics: LayoutMetrics) -> Rectangle {
    out: Rectangle = current
    if declared.x != 0.0 || declared.y != 0.0 { return current }
    out.x = metrics.content.x
    out.y = metrics.content.y
    if out.width <= 0.0 { out.width = metrics.content.width }
    if out.height <= 0.0 { out.height = metrics.content.height }
    return out
}

#program_export
BeginFlexCursor :: (props: FlexProps, count: s32, total_item_extent: float32) -> FlexCursor {
    cursor: FlexCursor
    metrics := LayoutMetricsFor(props.bounds, props.gap, props.padding)
    horizontal := props.direction != cast(FlexDirection)FlexColumn
    available := ifx horizontal then metrics.content.width else metrics.content.height
    cursor.content = metrics.content
    cursor.direction = props.direction
    cursor.align_items = props.align_items
    cursor.gap = cast(float32)metrics.gap
    cursor.position = ifx horizontal then metrics.content.x else metrics.content.y
    if count <= 0 { return cursor }
    cursor.remaining = count
    if total_item_extent < 0.0 { total_item_extent = 0.0 }
    remaining := available - total_item_extent - cursor.gap * cast(float32)(count - 1)
    if remaining < 0.0 { remaining = 0.0 }
    offset: float32 = 0.0
    if props.justify_content == cast(JustifyContent)JustifyCenter {
        offset = remaining / 2.0
    } else if props.justify_content == cast(JustifyContent)JustifyEnd {
        offset = remaining
    } else if props.justify_content == cast(JustifyContent)JustifySpaceBetween && count > 1 {
        cursor.gap += remaining / cast(float32)(count - 1)
    } else if props.justify_content == cast(JustifyContent)JustifySpaceAround {
        offset = remaining / cast(float32)count / 2.0
        cursor.gap += remaining / cast(float32)count
    } else if props.justify_content == cast(JustifyContent)JustifySpaceEvenly {
        offset = remaining / (cast(float32)count + 1.0)
        cursor.gap += offset
    }
    cursor.position += offset
    return cursor
}

#program_export
FlexStep :: (cursor: FlexCursor, width: float32, height: float32) -> FlexCursor {
    cursor.item = Rectangle.{0.0, 0.0, 0.0, 0.0}
    if cursor.remaining <= 0 { return cursor }
    if width < 0.0 { width = 0.0 }
    if height < 0.0 { height = 0.0 }
    horizontal := cursor.direction != cast(FlexDirection)FlexColumn
    cross_size := ifx horizontal then cursor.content.height else cursor.content.width
    extent := ifx horizontal then height else width
    if cursor.align_items == cast(AlignItems)AlignStretch && extent <= 0.0 {
        extent = cross_size
    }
    cross_remaining := cross_size - extent
    if cross_remaining < 0.0 { cross_remaining = 0.0 }
    cross_offset: float32 = 0.0
    if cursor.align_items == cast(AlignItems)AlignCenter {
        cross_offset = cross_remaining / 2.0
    } else if cursor.align_items == cast(AlignItems)AlignEnd {
        cross_offset = cross_remaining
    }
    if horizontal {
        cursor.item = Rectangle.{cursor.position,
            cursor.content.y + cross_offset, width, extent}
        cursor.position += width + cursor.gap
    } else {
        cursor.item = Rectangle.{cursor.content.x + cross_offset,
            cursor.position, extent, height}
        cursor.position += height + cursor.gap
    }
    cursor.remaining -= 1
    return cursor
}

FlexNonnegative :: (value: float32) -> float32 {
    return ifx value > 0.0 then value else 0.0
}

FlexBasis :: (item: FlexItem, horizontal: bool) -> float32 {
    if item.has_basis { return FlexNonnegative(item.basis) }
    return FlexNonnegative(ifx horizontal then item.width else item.height)
}

// During distribution, each box's width holds its main extent even in a column.
// Freeze items at zero, then redistribute the space to items that can shrink.
FlexDistribute :: (boxes: []FlexPlacement, free: float32,
    total: float32, grow: float32, shrink: float32, weight: float32) -> float32 {
    if free > 0.0 && grow > 0.0 {
        unit := free / (ifx grow > 1.0 then grow else 1.0)
        for i: cast(s32)0..cast(s32)boxes.count - 1 {
            boxes[i].bounds.width += boxes[i].grow * unit
        }
        return total + unit * grow
    }
    if free >= 0.0 || weight <= 0.0 { return total }

    initial_free := free
    while free < 0.0 && weight > 0.0 {
        deficit := ifx shrink < 1.0 && initial_free * shrink > free then initial_free * shrink else free
        unit := deficit / weight
        frozen := false
        for i: cast(s32)0..cast(s32)boxes.count - 1 {
            basis := boxes[i].bounds.width
            factor := boxes[i].shrink
            if basis > 0.0 && factor > 0.0 && 1.0 + factor * unit <= 0.0 {
                weight -= basis * factor
                shrink -= factor
                free += basis
                total -= basis
                boxes[i].bounds.width = 0.0
                frozen = true
            }
        }
        if !frozen {
            for i: cast(s32)0..cast(s32)boxes.count - 1 {
                boxes[i].bounds.width *= FlexNonnegative(1.0 + boxes[i].shrink * unit)
            }
            total += deficit
            break
        }
    }
    return total
}

KeepFlexItem :: (item: FlexItem) -> FlexItem { return item }

// Place a measured batch using caller-owned storage. The result is the natural
// cross extent including padding, or -1 when there is insufficient storage.
#program_export
PlaceFlexItems :: (props: FlexProps, items: []FlexItem, boxes: []FlexPlacement,
    resolve: FlexItemResolver = KeepFlexItem) -> float32 {
    if boxes.count < items.count { return -1.0 }
    metrics := LayoutMetricsFor(props.bounds, props.gap, props.padding)
    horizontal := props.direction != cast(FlexDirection)FlexColumn
    available := ifx horizontal then metrics.content.width else metrics.content.height
    available_cross := ifx horizontal then metrics.content.height else metrics.content.width
    main_gap := cast(float32)metrics.gap
    cross_gap := FlexNonnegative(cast(float32)props.cross_gap)
    cross_used: float32 = 0.0
    start: s32 = 0
    count := cast(s32)items.count
    natural_main: float32 = 0.0
    for i: cast(s32)0..count - 1 {
        item := items[i]
        if resolve != null { item = resolve(item) }
        basis := FlexBasis(item, horizontal)
        extent := FlexNonnegative(ifx horizontal then item.height else item.width)
        boxes[i] = .{.bounds = .{0.0, 0.0, basis, extent},
            .grow = FlexNonnegative(item.grow), .shrink = FlexNonnegative(item.shrink),
            .align = ifx item.has_align_self then item.align_self else props.align_items}
        natural_main += basis
    }
    if !horizontal && props.bounds.height <= 0.0 && count > 0 {
        available = natural_main + main_gap * cast(float32)(count - 1)
        metrics.content.height = available
    }
    while start < count {
        end := start
        total: float32 = 0.0
        cross: float32 = 0.0
        grow: float32 = 0.0
        shrink: float32 = 0.0
        weight: float32 = 0.0
        while end < count {
            item := boxes[end]
            basis := item.bounds.width
            if props.wrap && end > start && total + basis + main_gap * cast(float32)(end - start) > available { break }
            total += basis
            grow += item.grow
            shrink += item.shrink
            weight += item.shrink * basis
            extent := item.bounds.height
            if extent > cross { cross = extent }
            end += 1
        }
        if start > 0 { cross_used += cross_gap }
        line_cross := cross
        if !props.wrap && available_cross > 0.0 { line_cross = available_cross }
        line := metrics.content
        if horizontal { line.y += cross_used; line.height = line_cross }
        else { line.x += cross_used; line.width = line_cross }
        free := available - main_gap * cast(float32)(end - start - 1) - total
        adjusted := FlexDistribute(boxes[start:end], free, total, grow, shrink, weight)
        cursor := BeginFlexCursor(FlexProps.{.bounds = line, .direction = props.direction,
            .justify_content = props.justify_content, .gap = metrics.gap}, end - start, adjusted)
        for i: start..end - 1 {
            cursor.align_items = boxes[i].align
            main := boxes[i].bounds.width
            extent := boxes[i].bounds.height
            width := ifx horizontal then main else extent
            height := ifx horizontal then extent else main
            cursor = FlexStep(cursor, width, height)
            box := cursor.item
            if props.reverse {
                if horizontal { box.x = line.x + line.width - (box.x - line.x) - box.width }
                else { box.y = line.y + line.height - (box.y - line.y) - box.height }
            }
            boxes[i].bounds = box
        }
        cross_used += cross
        start = end
    }
    return cross_used + cast(float32)metrics.padding * 2.0
}

CenteredBands :: struct {
    leading: Rectangle
    center: Rectangle
    trailing: Rectangle
}

#program_export
LayoutCenteredBands :: (bounds: Rectangle, width: float32) -> CenteredBands {
    if width < 0.0 { width = 0.0 }
    if width > bounds.width { width = bounds.width }
    if width < 0.0 { width = 0.0 }
    side := (bounds.width - width) / 2.0
    if side < 0.0 { side = 0.0 }
    return .{.{bounds.x, bounds.y, side, bounds.height},
        .{bounds.x + side, bounds.y, width, bounds.height},
        .{bounds.x + side + width, bounds.y, side, bounds.height}}
}
