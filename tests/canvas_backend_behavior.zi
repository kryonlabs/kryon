#import "canvas_window"
#import "canvas_draw"
#import "canvas_input"
#import "canvas_texture"
#import "canvas_types"
#import "canvas_os"
#import "canvas_text"
#import "canvas_state"
#import "raylib_clip"
#import "canvas_raster"
#import "geometry"
#import "drawing_props"
#import "c_string"
#import "page_texture"
#import "page_mesh"
#import "page_core"
#import "tree_draw"
#import "session"
#import "paint_queue"
#import "web"

scheduled_frames: s32;

CountScheduledFrame :: (context: s32, first: s32, second: s32, third: s32) {
    unused context
    unused first
    unused second
    unused third
    scheduled_frames += 1
}

TestExternalFramePacing :: () -> bool {
    scope := WebScope()
    callback := WebFunction(CountScheduledFrame, 0)
    unused WebCall1(WebGlobal, WebName("requestAnimationFrame"), WebObject(callback))
    SetExternalFramePacing(true)
    BeginDrawing()
    EndDrawing()
    // An externally scheduled frame must return before the next RAF.
    synchronous := scheduled_frames == 0
    SetExternalFramePacing(false)
    BeginDrawing()
    EndDrawing()
    // Ordinary canvas loops still yield to the browser after presenting.
    yielded := scheduled_frames > 0
    WebEnd(scope)
    return synchronous && yielded
}

browser :: #system_library "env";
CanvasTestFinish :: (mesh_draws: s32) -> s32 #foreign browser "canvas_test_finish";
CanvasTestInput :: (phase: s32) -> s32 #foreign browser "canvas_test_input";
CanvasTestFail :: (code: s32) #foreign browser "canvas_test_fail";
CanvasTestFront :: (r: s32, g: s32, b: s32) -> s32 #foreign browser "canvas_test_front";

MeshLossFrame :: (session: Session) -> bool {
    BeginDrawing()
    BeginFrame(session, cast(u64)991, Rectangle.{0.0, 0.0, 160.0, 120.0})
    PaintLine(session, -1, Rectangle.{4.0, 4.0, 10.0, 0.0}, Color.{255, 0, 0, 255})
    result := EndFrameRetained(session, true)
    EndDrawing()
    return result.paint_unchanged
}
CanvasTestText :: (face: s32, size: s32, zoom: float32, width: s32,
    dark: bool) -> s32 #foreign browser "canvas_test_text";

// Compare UI text with browser text drawn directly at the output resolution.
// An atlas resized from its seed size cannot pass this pixel comparison.
TestTextResolution :: (loaded: bool) {
    sizes: [4]s32 = .[13, 17, 21, 32]
    zooms: [3]float32 = .[1.0, 1.25, 2.0]
    face: s32 = 0
    if loaded { face = CanvasFontFace(canvas_font) }
    for size: sizes {
        width := MeasureGlyphWidth("AV café ›…", size, "")
        for zoom: zooms {
            for theme: 0..2 {
                dark := theme == 1
                background := Color.{255, 255, 255, 255}
                ink := Color.{20, 30, 40, 255}
                if dark {
                    background = Color.{24, 34, 56, 255}
                    ink = Color.{247, 249, 255, 190}
                }
                BeginDrawing()
                ClearBackground(background)
                BeginMode2D(Camera.{offset = Vector2.{3.0, 4.0}, zoom = zoom})
                RasterTextClipped("AV café ›…", 4, 5, size, ink,
                    Rectangle.{4.0, 5.0, 52.0, cast(float32)size})
                EndMode2D()
                EndDrawing()
                if CanvasTestText(face, size, zoom, width, dark) == 0 {
                    CanvasTestFail(30)
                    return
                }
            }
        }
    }
}

#program_export
main :: () -> s32 {
    title: [32]u8
    CopyCString("Canvas Zi runtime", title[:])
    InitWindow(160, 120, *title[0])
    if !IsWindowReady() || GetScreenWidth() != 160 { return 1 }
    if !TestExternalFramePacing() { return 31 }
    SetRandomSeed(cast(u32)42)
    first := GetRandomValue(-100, 100)
    SetRandomSeed(cast(u32)42)
    if first != GetRandomValue(-100, 100) { return 2 }
    CanvasTestInput(0)
    if !IsKeyPressed(65) || !IsKeyDown(65) || GetCharPressed() != 128512 { return 3 }
    if !IsMouseButtonPressed(0) || GetMouseX() != 17 { return 4 }
    CanvasTestInput(1)
    if !IsKeyReleased(65) || IsKeyDown(65) { return 5 }
    BeginDrawing()
    ClearBackground(Color.{255, 255, 255, 255})
    BeginMode2D(Camera.{offset = Vector2.{20.0, 10.0}, zoom = 2.0})
    DrawRectangle(0, 0, 20, 20, Color.{255, 0, 0, 255})
    clip := BeginRasterClip(Rectangle.{0.0, 0.0, 10.0, 10.0})
    DrawRectangle(0, 0, 20, 20, Color.{0, 255, 0, 255})
    inner := BeginRasterClip(Rectangle.{2.0, 2.0, 2.0, 2.0})
    DrawRectangle(0, 0, 20, 20, Color.{0, 0, 255, 255})
    EndRasterClip(inner)
    DrawRectangle(6, 0, 20, 20, Color.{255, 255, 0, 255})
    EndRasterClip(clip)
    EndMode2D()
    image := GenImageColor(8, 8, Color.{255, 0, 255, 255})
    path: [32]u8
    CopyCString("/test-image.png", path[:])
    if !ExportImage(image, *path[0]) { return 9 }
    direct := LoadTexture(*path[0])
    if !IsTextureValid(direct) || direct.width != 8 || direct.height != 8 {
        CanvasTestFail(34)
    }
    copied := LoadImageFromTexture(direct)
    if copied.data == null { CanvasTestFail(35) }
    if copied.data != null {
        copied_pixels := cast(*u8)copied.data
        if copied_pixels[0] != cast(u8)255 || copied_pixels[1] != cast(u8)0 ||
        copied_pixels[2] != cast(u8)255 || copied_pixels[3] != cast(u8)255 {
            CanvasTestFail(36)
        }
    }
    UnloadImage(copied)
    UnloadTexture(direct)
    decoded := LoadImage(*path[0])
    if decoded.width != 8 || decoded.height != 8 || decoded.data == null { return 10 }
    decoded_pixels := cast(*u8)decoded.data
    if decoded_pixels[0] != cast(u8)255 || decoded_pixels[1] != cast(u8)0 || decoded_pixels[2] != cast(u8)255 { return 11 }
    UnloadImage(decoded)
    texture := LoadTextureFromImage(image)
    UnloadImage(image)
    if !IsTextureValid(texture) { return 6 }
    DrawTexture(texture, 80, 10, Color.{255, 255, 255, 255})
    // Updated pixels invalidate cached tints, including after texture release.
    DrawTexture(texture, 90, 10, Color.{128, 255, 255, 255})
    image = GenImageColor(8, 8, Color.{0, 255, 255, 255})
    UpdateTexture(texture, image.data)
    UnloadImage(image)
    DrawTexture(texture, 100, 10, Color.{128, 255, 255, 255})
    target := LoadRenderTexture(10, 10)
    BeginTextureMode(target)
    ClearBackground(Color.{0, 0, 0, 255})
    DrawRectangle(0, 0, 10, 5, Color.{255, 128, 0, 255})
    EndTextureMode()
    DrawTexturePro(target.texture, Rectangle.{0.0, 0.0, 10.0, -10.0}, Rectangle.{80.0, 30.0, 10.0, 10.0}, Vector2.{}, 0.0, Color.{255, 255, 255, 255})
    UnloadRenderTexture(target)
    UnloadTexture(texture)
    // A warped image: a mirrored grid, drawn triangle by triangle through
    // the canvas's transforms, keeps each texel in its mirrored place.
    mesh_pixels: [16]u8
    mesh_pixels[0] = cast(u8)255; mesh_pixels[3] = cast(u8)255
    mesh_pixels[5] = cast(u8)255; mesh_pixels[7] = cast(u8)255
    mesh_pixels[10] = cast(u8)255; mesh_pixels[11] = cast(u8)255
    for at: 12..15 { mesh_pixels[at] = cast(u8)255 }
    mesh_texture := LoadTextureFromImage(CanvasImageFromRgba(*mesh_pixels[0], 2, 2))
    if !IsTextureValid(mesh_texture) { return 17 }
    mesh: [4]Vector2
    mesh[0] = .{112.0, 30.0}; mesh[1] = .{96.0, 30.0}
    mesh[2] = .{112.0, 46.0}; mesh[3] = .{96.0, 46.0}
    if PageMeshDraw(cast(s32)mesh_texture.id, .{-1.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255}, 0) { CanvasTestFail(45) }
    before_mesh_draws := page_mesh_draws
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    // Adjacent uses of the same image retain their own tint and opacity
    // while sharing one GPU draw, including when its source changes next.
    if page_mesh_gl != 0 {
        for index: cast(s32)0..3 { mesh[index].x += 30.0 }
        RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
            .{0.0, 0.0, 160.0, 120.0}, .{128, 255, 255, 128})
        for index: cast(s32)0..3 { mesh[index].x -= 30.0 }
    }
    PaintRoundedFill(Session.{}, -1, .{0.0, 0.0, 160.0, 120.0}, 0.0, 4,
        Color.{0, 0, 0, 0})
    if page_mesh_gl != 0 && !page_mesh_pending { CanvasTestFail(44) }
    // The accelerated sampler must interpolate transparent texels before
    // applying tint. Keep the software painter's existing opaque baseline.
    if page_mesh_gl != 0 {
        mesh_pixels[7] = cast(u8)128
        mesh_pixels[11] = cast(u8)64
        mesh_pixels[15] = cast(u8)0
        UpdateTexture(mesh_texture, cast(*void)(*mesh_pixels[0]))
        if page_mesh_draws != before_mesh_draws + 1 { CanvasTestFail(46) }
        if WebGetNumber(page_mesh_canvas, page_names.width) * WebGetNumber(page_mesh_canvas, page_names.height) >
        9600.0 * PageSurfaceScale() * PageSurfaceScale() { CanvasTestFail(47) }
    }
    SetTextureFilter(mesh_texture, 1)
    for index: cast(s32)0..3 {
        mesh[index].x -= 16.0
        mesh[index].y += 22.0
    }
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{192, 192, 192, 255})
    // A cached mesh sees updated pixels, and its opacity composites once.
    for index: cast(s32)0..3 {
        mesh_pixels[index * 4] = cast(u8)0
        mesh_pixels[index * 4 + 1] = cast(u8)255
        mesh_pixels[index * 4 + 2] = cast(u8)255
        mesh_pixels[index * 4 + 3] = cast(u8)255
        mesh[index].x += 18.0
    }
    UpdateTexture(mesh_texture, cast(*void)(*mesh_pixels[0]))
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 128})
    // Cached textures can alternate within one crop without changing their
    // painter order, including a translucent image above another texture.
    accent_pixels: [16]u8
    for index: cast(s32)0..3 {
        accent_pixels[index * 4] = cast(u8)255
        accent_pixels[index * 4 + 2] = cast(u8)255
        accent_pixels[index * 4 + 3] = cast(u8)255
    }
    accent := LoadTextureFromImage(CanvasImageFromRgba(*accent_pixels[0], 2, 2))
    mixed: [4]Vector2 = .{.{20.0, 52.0}, .{36.0, 52.0}, .{20.0, 68.0}, .{36.0, 68.0}}
    RasterImageMesh("", accent.id, .{0.0, 0.0, 2.0, 2.0}, mixed[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    DrawRectangle(18, 50, 20, 20, Color.{255, 255, 255, 255})
    for index: cast(s32)0..3 { mixed[index].x -= 8.0 }
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mixed[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    for index: cast(s32)0..3 { mixed[index].x += 8.0 }
    RasterImageMesh("", accent.id, .{0.0, 0.0, 2.0, 2.0}, mixed[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    for index: cast(s32)0..3 { mixed[index].x += 8.0 }
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, mixed[:], 2, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 128})
    // More texture runs than fit in one batch still preserve the last image.
    for index: cast(s32)0..3 { mixed[index].x += 120.0; mixed[index].y += 24.0 }
    for index: cast(s32)0..69 {
        id := ifx index % 2 == 0 then mesh_texture.id else accent.id
        RasterImageMesh("", id, .{0.0, 0.0, 2.0, 2.0}, mixed[:], 2, 2,
            .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    }
    if page_mesh_gl != 0 {
        // Three large grids cross the index-buffer capacity. Shared vertices
        // and the next batch's indices must still refer to the right colours.
        large: [64 * 32]Vector2
        for row: cast(s32)0..31 {
            for column: cast(s32)0..63 {
                large[row * 64 + column] = Vector2.{148.0 + cast(float32)column * 8.0 / 63.0,
                    90.0 + cast(float32)row * 8.0 / 31.0}
            }
        }
        for index: cast(s32)0..2 {
            color := Color.{255, 255, 255, 255}
            if index == 1 { color.b = cast(u8)0 }
            if index == 2 { color = Color.{255, 128, 0, 255} }
            RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, large[:], 64, 32,
                .{0.0, 0.0, 160.0, 120.0}, color)
        }
    }
    UnloadTexture(accent)
    // A collapsed grid column must not erase its visible neighbour.
    folded: [6]Vector2 = .{.{120.0, 76.0}, .{120.0, 76.0}, .{140.0, 76.0},
        .{120.0, 88.0}, .{120.0, 88.0}, .{140.0, 88.0}}
    RasterImageMesh("", mesh_texture.id, .{0.0, 0.0, 2.0, 2.0}, folded[:], 3, 2,
        .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
    UnloadTexture(mesh_texture)
    // A shape's triangles are filled as one path: no seam along the edges
    // they share lets the background through.
    fan: [12]Vector2
    fan[0] = .{64.0, 52.0}
    fan[1] = .{76.0, 52.0}
    fan[2] = .{70.0, 58.0}
    fan[3] = .{76.0, 52.0}
    fan[4] = .{76.0, 64.0}
    fan[5] = .{70.0, 58.0}
    fan[6] = .{76.0, 64.0}
    fan[7] = .{64.0, 64.0}
    fan[8] = .{70.0, 58.0}
    fan[9] = .{64.0, 64.0}
    fan[10] = .{64.0, 52.0}
    fan[11] = .{70.0, 58.0}
    RasterTriangles(fan[:], Color.{0, 160, 0, 255})
    CopyCString("/test-font.ttf", path[:])
    font := LoadFontEx(*path[0], 20, null, 0)
    if !IsFontValid(font) { return 13 }
    measured := MeasureTextEx(font, *title[0], 20.0, 0.0)
    if measured.x <= 50.0 || measured.y <= 0.0 { return 14 }
    DrawTextEx(font, *title[0], Vector2.{4.0, 70.0}, 20.0, 0.0, Color.{0, 0, 0, 255})
    // A glyph stays inside its line box: a 20px "g" ends by y = 50.
    CopyCString("g", path[:])
    DrawTextEx(font, *path[0], Vector2.{120.0, 30.0}, 20.0, 0.0, Color.{0, 0, 0, 255})
    // Glyphs outside the first atlas are added on first use, not drawn as ?.
    if GetGlyphInfo(font, 8250).value != 8250 || GetGlyphInfo(font, 8230).value != 8230 ||
    GetGlyphInfo(font, 8250).advance_x <= 0 { CanvasTestFail(16) }
    CopyCString("›…", path[:])
    DrawTextEx(font, *path[0], Vector2.{130.0, 0.0}, 20.0, 0.0, Color.{0, 0, 0, 255})
    UnloadFont(font)
    // A text clip follows the camera like the text: at zoom 2 the 40-unit
    // clip covers 80 screen pixels.
    BeginMode2D(Camera.{offset = Vector2.{0.0, 94.0}, zoom = 2.0})
    RasterTextClipped("MMMMMMMMMMMM", 0, 0, 10, Color.{0, 0, 0, 255},
        Rectangle.{0.0, 0.0, 40.0, 12.0})
    EndMode2D()
    // RasterText used the default font; release it before the leak check.
    UnloadFont(GetFontDefault())
    if PageTextureCount() != 0 { CanvasTestFail(21) }
    SetTargetFPS(120)
    // The page shows a frame once it ends, so its pixels are read after.
    EndDrawing()
    result := CanvasTestFinish(page_mesh_draws)
    if page_mesh_gl != 0 {
        retained := SessionOpen()
        unused MeshLossFrame(retained)
        if !MeshLossFrame(retained) { CanvasTestFail(40) }
        scope := WebScope()
        extension := WebAsObject(WebCall1(page_mesh_gl, WebName("getExtension"),
            WebText("WEBGL_lose_context")))
        if extension == 0 { CanvasTestFail(41) }
        else {
            unused WebCall0(extension, WebName("loseContext"))
            for attempt: cast(s32)0..49 {
                if page_mesh_gl == 0 { break }
                WebSleep(10)
            }
            if page_mesh_gl != 0 || MeshLossFrame(retained) { CanvasTestFail(42) }
        }
        WebEnd(scope)
        SessionClose(retained)
        restored := LoadTextureFromImage(CanvasImageFromRgba(*mesh_pixels[0], 2, 2))
        mesh[0] = .{0.0, 0.0}; mesh[1] = .{10.0, 0.0}
        mesh[2] = .{0.0, 10.0}; mesh[3] = .{10.0, 10.0}
        BeginDrawing()
        ClearBackground(Color.{0, 0, 0, 255})
        RasterImageMesh("", restored.id, .{0.0, 0.0, 2.0, 2.0}, mesh[:], 2, 2,
            .{0.0, 0.0, 160.0, 120.0}, .{255, 255, 255, 255})
        EndDrawing()
        if page_mesh_gl == 0 || page_mesh_draws == 0 || CanvasTestFront(0, 255, 255) == 0 {
            CanvasTestFail(43)
        }
        UnloadTexture(restored)
        BeginDrawing()
        ClearBackground(Color.{255, 255, 255, 255})
        EndDrawing()
    }
    if IsKeyPressed(65) || IsKeyReleased(65) { CanvasTestFail(12) }
    // A frame in progress stays off the page until it ends.
    BeginDrawing()
    ClearBackground(Color.{255, 0, 255, 255})
    if CanvasTestFront(255, 255, 255) == 0 { CanvasTestFail(28) }
    EndDrawing()
    if CanvasTestFront(255, 0, 255) == 0 { CanvasTestFail(29) }
    TestTextResolution(false)
    if !LoadTypefaceFile("test", "/test-font.ttf", null, 0) ||
    !SelectTypeface("test") {
        CanvasTestFail(31)
    }
    TestTextResolution(true)
    // Density can change while the CSS width and height stay identical.
    CanvasTestInput(3)
    TestTextResolution(true)
    ReleaseTypefaces()
    // Input arriving after a frame starts is still available on the next
    // frame, even when rendering suspended for a browser resource decode.
    BeginDrawing()
    CanvasTestInput(4)
    EndDrawing()
    if !IsMouseButtonPressed(0) || !IsMouseButtonReleased(0) ||
    !IsKeyPressed(67) || !IsKeyReleased(67) || GetMouseWheelMove() != 1.0 {
        CanvasTestFail(32)
    }
    BeginDrawing()
    EndDrawing()
    if IsMouseButtonPressed(0) || IsMouseButtonReleased(0) ||
    IsKeyPressed(67) || IsKeyReleased(67) || GetMouseWheelMove() != 0.0 {
        CanvasTestFail(33)
    }
    BeginMode2D(Camera.{offset = Vector2.{30.0, 30.0}, zoom = 2.0})
    BeginScissorMode(0, 0, 1, 1)
    CloseWindow()
    InitWindow(160, 120, *title[0])
    BeginDrawing()
    ClearBackground(Color.{0, 0, 0, 255})
    EndDrawing()
    // Failures after an await are recorded; main's exit code is lost.
    if CanvasTestInput(2) != 0 { CanvasTestFail(15) }
    if !IsKeyPressed(66) || GetCharPressed() != 66 { CanvasTestFail(7) }
    CloseWindow()
    if IsWindowReady() { CanvasTestFail(8) }
    return result
}
