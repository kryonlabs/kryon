using FrameStatus;
using PaintKind;
using SemanticKind;

Viewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0, 480.0, 360.0}
}

TooltipBehavior :: () -> s32 {
    state := Tooltip.TooltipStateFor(1)
    props: Tooltip.Props
    props.key = 1
    props.id = 1001
    props.class_name = 2001
    props.anchor = Rectangle.{20.0, 30.0, 60.0, 24.0}
    props.viewport = Viewport()
    props.text = "Disabled control"
    props.shortcut = "Ctrl+D"
    props.placement = .OverlayPlaceBottom
    props.gap = 8.0
    props.max_width = 180.0
    props.delay_ms = 550.0
    props.passive_delay_ms = 1000.0
    props.warm_ms = 400.0
    props.now_ms = 1000
    props.pointer.over_anchor = true
    props.pointer.x = 40.0
    props.pointer.y = 40.0
    props.style = Tooltip.TooltipDefaultStyle()

    result := Tooltip.TooltipApply(*state, props)
    if result.visible { return 11 }
    if result.remaining_delay_ms < 548.0 { return 12 }
    if result.remaining_delay_ms > 552.0 { return 13 }
    props.now_ms = 1549
    result = Tooltip.TooltipApply(*state, props)
    if result.visible || result.remaining_delay_ms < 0.5 ||
        result.remaining_delay_ms > 1.0 { return 2 }
    props.now_ms = 1550
    result = Tooltip.TooltipApply(*state, props)
    if !result.visible { return 30 }
    if !result.changed { return 31 }
    if state.last_shown_ms != 1550 { return 32 }

    props.pointer.touch = true
    result = Tooltip.TooltipApply(*state, props)
    if result.visible { return 4 }
    props.pointer.touch = false

    truncated := props
    truncated.key = 2
    truncated.only_when_truncated = true
    truncated.measured_text_width = 80
    truncated.anchor.width = 60.0
    truncated.delay_ms = 0.0
    truncated.pointer.over_anchor = true
    truncated_state := Tooltip.TooltipStateFor(2)
    result = Tooltip.TooltipApply(*truncated_state, truncated)
    if !result.truncated || !result.visible { return 5 }
    truncated.measured_text_width = 40
    truncated_state = Tooltip.TooltipStateFor(2)
    result = Tooltip.TooltipApply(*truncated_state, truncated)
    if result.truncated || result.visible { return 6 }

    disabled := props
    disabled.disabled = true
    disabled_state := Tooltip.TooltipStateFor(1)
    disabled_state.visible = true
    result = Tooltip.TooltipApply(*disabled_state, disabled)
    if result.visible || !result.changed || disabled_state.visible { return 7 }
    return 0
}

SheetBehavior :: () -> s32 {
    state := Sheet.SheetStateFor()
    props: Sheet.Props
    props.key = 10
    props.id = 1010
    props.class_name = 2010
    props.title = "Filters"
    props.description = "Narrow the current table"
    props.close_label = "Close"
    props.open = true
    props.side = .OverlaySideRight
    props.size = 180.0
    props.minimum_size = 100.0
    props.maximum_size = 220.0
    props.viewport = Viewport()
    props.safe_area = Sheet.SheetSafeArea.{10.0, 12.0, 14.0, 16.0}
    props.scrim_close = true
    props.drag_enabled = true
    props.drag_close_distance = 40.0
    props.now_ms = 1000
    props.surface_style = Sheet.SheetSurfaceDefaultStyle()
    props.scrim_style = Sheet.SheetScrimDefaultStyle()

    result := Sheet.SheetApply(*state, props)
    if !result.visible { return 11 }
    if result.progress != 0.0 { return 12 }
    if result.geometry.panel.width != 180.0 { return 13 }
    if result.geometry.panel.x <= Viewport().width { return 14 }
    props.now_ms = 1420
    props.input.keys.escape = true
    props.input.focus_count = 4
    result = Sheet.SheetApply(*state, props)
    if !result.close_requested || !result.closed_by_escape ||
        result.progress < 0.99 || result.geometry.panel.x < 285.0 ||
        result.geometry.panel.x > 287.0 { return 2 }
    props.open = false
    props.input.keys.escape = false
    props.now_ms = 1841
    result = Sheet.SheetApply(*state, props)
    if !result.visible || result.progress != 0.0 { return 3 }
    props.now_ms = 2261
    result = Sheet.SheetApply(*state, props)
    if !result.focus_returned { return 30 }
    if state.visible { return 31 }

    drag_state := Sheet.SheetStateFor()
    drag := props
    drag.open = true
    drag.now_ms = 2000
    drag.input = Sheet.SheetInput.{}
    result = Sheet.SheetApply(*drag_state, drag)
    if result.progress != 0.0 || result.geometry.panel.x <=
        drag.viewport.width { return 46 }
    drag.now_ms = 2420
    result = Sheet.SheetApply(*drag_state, drag)
    if result.progress != 1.0 { return 48 }
    if result.geometry.panel.x < 285.0 { return 47 }
    if result.geometry.panel.x > 287.0 { return 44 }
    drag.now_ms = 2430
    drag.input.pointer.down = true
    drag.input.pointer.pressed = true
    drag.input.pointer.x = drag_state_drag_x(drag)
    drag.input.pointer.y = drag_state_drag_y(drag)
    if !OverlayPointIn(drag.input.pointer, result.geometry.handle) { return 45 }
    result = Sheet.SheetApply(*drag_state, drag)
    if !drag_state.dragging { return 42 }
    drag.input.pointer.pressed = false
    drag.input.pointer.x += 50.0
    drag.input.pointer.y += 50.0
    result = Sheet.SheetApply(*drag_state, drag)
    if drag_state.drag_offset < 40.0 { return 43 }
    drag.input.pointer.down = false
    result = Sheet.SheetApply(*drag_state, drag)
    if !result.closed_by_drag { return 40 }
    if drag_state.drag_offset < 40.0 { return 41 }

    focus_state := Sheet.SheetStateFor()
    focus_state.focus_index = 3
    if !Sheet.SheetAdvanceFocus(*focus_state, 4, false) ||
        focus_state.focus_index != 0 { return 5 }
    if !Sheet.SheetAdvanceFocus(*focus_state, 4, true) ||
        focus_state.focus_index != 3 { return 6 }
    return 0
}

drag_state_drag_x :: (props: Sheet.Props) -> float32 {
    return props.viewport.x + props.safe_area.left +
        props.viewport.width - props.safe_area.left -
        props.safe_area.right - props.size + 12.0
}

drag_state_drag_y :: (props: Sheet.Props) -> float32 {
    return props.safe_area.top + 26.0
}

CommandPaletteBehavior :: () -> s32 {
    commands: [3]CommandPalette.CommandPaletteCommand
    commands[0].title = "File settings"
    commands[0].group = "File"
    commands[0].action = 11
    commands[1].title = "Settings file"
    commands[1].group = "File"
    commands[1].action = 12
    commands[2].title = "Palette"
    commands[2].group = "Palette"
    commands[2].action = 13

    state := CommandPalette.CommandPaletteStateFor(1)
    props: CommandPalette.Props
    props.key = 20
    props.id = 1020
    props.class_name = 2020
    props.owner = 1
    props.open = true
    props.placeholder = "Type a command"
    props.viewport = Viewport()
    props.width = 360.0
    props.maximum_height = 180.0
    props.now_ms = 1000
    props.commands = commands[:]
    props.surface_style = CommandPalette.CommandPaletteSurfaceDefaultStyle()
    props.item_style = CommandPalette.CommandPaletteItemDefaultStyle()
    props.scrim_style = props.surface_style
    props.scrim_style.background = CurrentTheme().colors.scrim
    props.scrim_style.opacity = 0.7

    result := CommandPalette.CommandPaletteApply(*state, props)
    if !result.changed { return 10 }
    if result.match_count != 3 { return 11 }
    if !state.group_starts[0] || state.group_starts[1] ||
        !state.group_starts[2] { return 12 }

    props.input.text.text = "file"
    result = CommandPalette.CommandPaletteApply(*state, props)
    if result.match_count != 2 || state.order[0] != 0 ||
        state.order[1] != 1 || state.scores[0] <= state.scores[1] { return 2 }
    props.input.text.text = ""
    props.input.down = true
    result = CommandPalette.CommandPaletteApply(*state, props)
    if result.highlighted != 1 { return 3 }
    props.input.down = false
    props.input.text.commit = false
    props.input.enter = true
    result = CommandPalette.CommandPaletteApply(*state, props)
    if state.highlighted != 1 { return 50 }
    if state.match_count != 2 { return 51 }
    if state.order[1] != 1 { return 52 }
    if result.chosen_index != 1 { return 200 + result.chosen_index }
    if result.chosen_action != 12 { return 41 }
    if !result.exact_action { return 42 }
    if !result.close_requested { return 43 }

    props.owner = 2
    props.input = CommandPalette.CommandPaletteInput.{}
    props.input.text.text = "file"
    result = CommandPalette.CommandPaletteApply(*state, props)
    if !result.ownership_changed || state.owner != 2 ||
        state.query_length != 4 { return 5 }

    props.owner = 3
    props.input = CommandPalette.CommandPaletteInput.{}
    result = CommandPalette.CommandPaletteApply(*state, props)
    if !result.ownership_changed || result.match_count != 3 { return 6 }
    props.input.activate_index = -1
    chunks: [3]string = .["fi", "l", "e"]
    for chunk: chunks {
        props.input.text.text = chunk
        result = CommandPalette.CommandPaletteApply(*state, props)
    }
    if CommandPalette.CommandPaletteQuery(state.query[:state.query_length]) != "file" { return 60 }
    props.input.text = .{.left = true}
    unused CommandPalette.CommandPaletteApply(*state, props)
    props.input.text = .{.backspace = true}
    unused CommandPalette.CommandPaletteApply(*state, props)
    if CommandPalette.CommandPaletteQuery(state.query[:state.query_length]) != "fie" { return 61 }
    props.input.text = .{.text = "l"}
    unused CommandPalette.CommandPaletteApply(*state, props)
    props.input.text = .{.delete_forward = true}
    unused CommandPalette.CommandPaletteApply(*state, props)
    if CommandPalette.CommandPaletteQuery(state.query[:state.query_length]) != "fil" { return 62 }
    props.input.text = .{.text = "e"}
    unused CommandPalette.CommandPaletteApply(*state, props)
    props.input.text = .{}
    props.input.escape = true
    result = CommandPalette.CommandPaletteApply(*state, props)
    if !result.close_requested { return 63 }
    props.open = false
    props.input.escape = false
    props.now_ms += 1000
    result = CommandPalette.CommandPaletteApply(*state, props)
    if result.visible { return 64 }
    props.open = true
    unused CommandPalette.CommandPaletteApply(*state, props)
    if CommandPalette.CommandPaletteQuery(state.query[:state.query_length]) != "file" { return 65 }
    props.input.text = .{.select_all = true}
    unused CommandPalette.CommandPaletteApply(*state, props)
    props.input.text = .{.text = "é🌿"}
    unused CommandPalette.CommandPaletteApply(*state, props)
    props.input.text = .{.backspace = true}
    unused CommandPalette.CommandPaletteApply(*state, props)
    if CommandPalette.CommandPaletteQuery(state.query[:state.query_length]) != "é" { return 66 }
    return 0
}

HoverCardBehavior :: () -> s32 {
    state := HoverCard.HoverCardStateFor()
    props: HoverCard.Props
    props.key = 30
    props.id = 1030
    props.class_name = 2030
    props.anchor = Rectangle.{40.0, 40.0, 100.0, 30.0}
    props.viewport = Viewport()
    props.title = "Kryon"
    props.body = "Portable retained UI"
    props.action_label = "Open"
    props.action = 77
    props.placement = .OverlayPlaceTop
    props.width = 260.0
    props.delay_ms = 450.0
    props.grace_ms = 200.0
    props.movement_tolerance = 8.0
    props.gap = 10.0
    props.now_ms = 100
    props.pointer.over_anchor = true
    props.pointer.x = 3.0
    props.pointer.y = 3.0
    props.style = HoverCard.HoverCardDefaultStyle()
    props.action_style = HoverCard.HoverCardActionDefaultStyle()

    result := HoverCard.HoverCardApply(*state, props)
    if result.open || result.remaining_delay_ms < 449.0 { return 1 }
    props.now_ms = 550
    result = HoverCard.HoverCardApply(*state, props)
    if !result.open || !result.changed { return 2 }

    props.pointer.over_anchor = false
    props.pointer.over_content = false
    props.now_ms = 650
    result = HoverCard.HoverCardApply(*state, props)
    if result.closed || result.remaining_grace_ms < 99.0 { return 3 }
    props.now_ms = 851
    result = HoverCard.HoverCardApply(*state, props)
    if !result.closed || state.open { return 4 }

    action_state := HoverCard.HoverCardStateFor()
    props.now_ms = 100
    props.pointer.over_anchor = true
    unused HoverCard.HoverCardApply(*action_state, props)
    props.now_ms = 550
    unused HoverCard.HoverCardApply(*action_state, props)
    props.activate_action = true
    result = HoverCard.HoverCardApply(*action_state, props)
    if result.action != 77 { return 50 }
    if !result.action_selected { return 51 }
    if !result.closed { return 52 }
    return 0
}

ConfirmPopoverBehavior :: () -> s32 {
    state := ConfirmPopover.ConfirmPopoverStateFor()
    props: ConfirmPopover.Props
    props.key = 40
    props.id = 1040
    props.class_name = 2040
    props.title = "Delete workspace?"
    props.description = "This removes local files"
    props.confirm_label = "Delete"
    props.cancel_label = "Cancel"
    props.anchor = Rectangle.{100.0, 100.0, 120.0, 34.0}
    props.viewport = Viewport()
    props.placement = .OverlayPlaceBottom
    props.width = 290.0
    props.gap = 8.0
    props.danger = true
    props.open = true
    props.now_ms = 1000
    props.style = ConfirmPopover.ConfirmPopoverDefaultStyle()
    props.confirm_style = ConfirmPopover.ConfirmPopoverConfirmDefaultStyle(true)
    props.cancel_style = ConfirmPopover.ConfirmPopoverDefaultStyle()

    result := ConfirmPopover.ConfirmPopoverApply(*state, props)
    if !result.visible || !result.focus_on_confirm ||
        result.confirm_node >= 0 { return 1 }
    props.now_ms = 1280
    props.keys.enter = true
    result = ConfirmPopover.ConfirmPopoverApply(*state, props)
    if !result.confirmed || result.cancelled || !result.closed {
        return 2
    }

    escape_state := ConfirmPopover.ConfirmPopoverStateFor()
    escape := props
    escape.keys = OverlayKeyInput.{}
    escape.keys.escape = true
    result = ConfirmPopover.ConfirmPopoverApply(*escape_state, escape)
    if !result.cancelled || result.confirmed { return 3 }

    outside_state := ConfirmPopover.ConfirmPopoverStateFor()
    outside := props
    outside.keys = OverlayKeyInput.{}
    outside.pointer.released = true
    outside.pointer.x = 20.0
    outside.pointer.y = 20.0
    result = ConfirmPopover.ConfirmPopoverApply(*outside_state, outside)
    if !result.closed || result.confirmed || result.cancelled {
        return 4
    }

    close_state := ConfirmPopover.ConfirmPopoverStateFor()
    closing := props
    closing.keys = OverlayKeyInput.{}
    unused ConfirmPopover.ConfirmPopoverApply(*close_state, closing)
    closing.open = false
    closing.now_ms = 1281
    unused ConfirmPopover.ConfirmPopoverApply(*close_state, closing)
    closing.now_ms = 1561
    result = ConfirmPopover.ConfirmPopoverApply(*close_state, closing)
    if !result.focus_returned || result.visible { return 5 }
    return 0
}

GuidedTourBehavior :: () -> s32 {
    steps: [2]GuidedTour.GuidedTourStep
    steps[0].target_key = 90
    steps[0].target = Rectangle.{160.0, 80.0, 100.0, 40.0}
    steps[0].title = "Select data"
    steps[0].body = "Choose a project"
    steps[0].placement = .OverlayPlaceBottomStart
    steps[1].target_key = 91
    steps[1].target = Rectangle.{180.0, 140.0, 100.0, 40.0}
    steps[1].title = "Run"
    steps[1].body = "Start the portable app"
    steps[1].placement = .OverlayPlaceTopStart

    state := GuidedTour.GuidedTourStateFor(0)
    props: GuidedTour.Props
    props.key = 50
    props.id = 1050
    props.class_name = 2050
    props.steps = steps[:]
    props.step = 0
    props.width = 280.0
    props.padding = 12.0
    props.block_target = true
    props.next_label = "Next"
    props.back_label = "Back"
    props.done_label = "Done"
    props.skip_label = "Skip tour"
    props.count_format = "%d / %d"
    props.viewport = Viewport()
    props.now_ms = 1000
    props.card_style = GuidedTour.GuidedTourCardDefaultStyle()
    props.scrim_style = GuidedTour.GuidedTourScrimDefaultStyle()
    props.button_style = GuidedTour.GuidedTourButtonDefaultStyle()

    result := GuidedTour.GuidedTourApply(*state, props)
    if !result.visible || result.geometry.band_count != 4 ||
        result.geometry.hole.x != 148.0 || result.geometry.hole.y != 68.0 ||
        result.geometry.hole.width != 124.0 ||
        result.geometry.hole.height != 64.0 { return 1 }
    props.now_ms = 1280
    props.input.enter = true
    result = GuidedTour.GuidedTourApply(*state, props)
    if result.action != .GuidedTourActionNext || state.step != 1 { return 2 }
    props.input.enter = false
    props.input.left = true
    result = GuidedTour.GuidedTourApply(*state, props)
    if result.action != .GuidedTourActionBack || state.step != 0 { return 3 }
    props.input.left = false
    props.input.right = true
    result = GuidedTour.GuidedTourApply(*state, props)
    if result.action != .GuidedTourActionNext || state.step != 1 { return 4 }
    props.input.right = false
    props.input.enter = true
    result = GuidedTour.GuidedTourApply(*state, props)
    if result.action != .GuidedTourActionDone || state.step != -1 ||
        result.visible { return 5 }

    skip_state := GuidedTour.GuidedTourStateFor(0)
    skip := props
    skip.input = GuidedTour.GuidedTourInput.{}
    skip.input.escape = true
    result = GuidedTour.GuidedTourApply(*skip_state, skip)
    if result.action != .GuidedTourActionSkip || skip_state.step != -1 {
        return 6
    }

    focus_state := GuidedTour.GuidedTourStateFor(0)
    focus_state.focus_index = 2
    if !GuidedTour.GuidedTourAdvanceFocus(*focus_state, false) ||
        focus_state.focus_index != 0 { return 7 }
    if !GuidedTour.GuidedTourAdvanceFocus(*focus_state, true) ||
        focus_state.focus_index != 2 { return 8 }
    return 0
}

render_overlay_failure: s32;

PendingFillRadius :: (session: Session, radius: float32) -> bool {
    index: s32 = 0
    while index < PendingPaintCount(session) {
        paint := PendingPaintAt(session, index)
        if paint.kind == PaintKindRoundedFill && paint.radius == radius {
            return true
        }
        index += 1
    }
    return false
}

RenderOverlayFrame :: (session: Session, frame: u64,
    dark: bool) -> bool {
    TreeStart(session, frame, Viewport())
    tooltip_state := Tooltip.TooltipStateFor(1)
    tooltip: Tooltip.Props
    tooltip.key = 1
    tooltip.id = 1001
    tooltip.class_name = 2001
    tooltip.anchor = Rectangle.{20.0, 20.0, 80.0, 24.0}
    tooltip.viewport = Viewport()
    tooltip.text = "Overlay"
    tooltip.shortcut = "Ctrl+O"
    tooltip.placement = .OverlayPlaceBottom
    tooltip.delay_ms = 550.0
    tooltip.passive_delay_ms = 1000.0
    tooltip.warm_ms = 400.0
    tooltip.style = Tooltip.TooltipDefaultStyle()
    tooltip.style.radius = 11.0
    tooltip.style.font_size = 17.0
    tooltip.style.motion_duration = 333.0
    tooltip.style.motion_multiplier = 1.25
    tooltip.pointer.over_anchor = true
    tooltip.pointer.x = 30.0
    tooltip.pointer.y = 30.0
    tooltip.now_ms = 1000
    unused Tooltip.TooltipApply(*tooltip_state, tooltip)
    tooltip.now_ms = 1550
    tooltip_result := Tooltip.Draw(session, tooltip, *tooltip_state)
    if !tooltip_result.visible { render_overlay_failure = 15; return false }
    if !tooltip_result.fit.visible { render_overlay_failure = 16; return false }
    if tooltip_result.node < 0 { render_overlay_failure = 17; return false }
    if !PendingFillRadius(session, 11.0) {
        render_overlay_failure = 14; return false
    }

    sheet_state := Sheet.SheetStateFor()
    sheet: Sheet.Props
    sheet.key = 10
    sheet.id = 1010
    sheet.class_name = 2010
    sheet.title = "Sheet"
    sheet.close_label = "Close"
    sheet.open = true
    sheet.side = ifx dark then .OverlaySideTop else .OverlaySideBottom
    sheet.size = 220.0
    sheet.viewport = Viewport()
    sheet.safe_area = Sheet.SheetSafeArea.{10.0, 12.0, 14.0, 16.0}
    sheet.now_ms = 1420
    sheet.surface_style = Sheet.SheetSurfaceDefaultStyle()
    sheet.surface_style.radius = 13.0
    sheet.surface_style.font_size = 18.0
    sheet.surface_style.motion_duration = 351.0
    sheet.scrim_style = Sheet.SheetScrimDefaultStyle()
    sheet_result := Sheet.Draw(session, sheet, *sheet_state)
    if sheet_result.node < 0 ||
        !PendingFillRadius(session, 13.0) { render_overlay_failure = 2; return false }

    commands: [2]CommandPalette.CommandPaletteCommand
    commands[0].title = "File"
    commands[0].group = "File"
    commands[0].action = 11
    commands[1].title = "Format"
    commands[1].group = "Edit"
    commands[1].action = 12
    palette_state := CommandPalette.CommandPaletteStateFor(1)
    unused CommandPalette.CommandPaletteSetQuery(*palette_state, "f")
    palette: CommandPalette.Props
    palette.key = 20
    palette.id = 1020
    palette.class_name = 2020
    palette.owner = 1
    palette.open = true
    palette.placeholder = "Command"
    palette.viewport = Viewport()
    palette.width = 360.0
    palette.maximum_height = 180.0
    palette.now_ms = 1280
    palette.commands = commands[:]
    palette.surface_style = CommandPalette.CommandPaletteSurfaceDefaultStyle()
    palette.surface_style.radius = 15.0
    palette.surface_style.font_size = 19.0
    palette.surface_style.motion_duration = 367.0
    palette.item_style = CommandPalette.CommandPaletteItemDefaultStyle()
    palette.scrim_style = palette.surface_style
    palette_result := CommandPalette.Draw(session, palette, *palette_state)
    if palette_result.node < 0 || palette_result.match_count != 2 {
        render_overlay_failure = 3; return false
    }

    hover_state := HoverCard.HoverCardStateFor()
    hover_state.open = true
    hover_state.transition_start_ms = 0
    hover: HoverCard.Props
    hover.key = 30
    hover.id = 1030
    hover.class_name = 2030
    hover.anchor = Rectangle.{40.0, 40.0, 100.0, 30.0}
    hover.viewport = Viewport()
    hover.title = "Hover"
    hover.body = "Interactive"
    hover.action_label = "Open"
    hover.action = 77
    hover.width = 260.0
    hover.delay_ms = 450.0
    hover.grace_ms = 200.0
    hover.now_ms = 280
    hover.style = HoverCard.HoverCardDefaultStyle()
    hover.style.radius = 17.0
    hover.style.font_size = 20.0
    hover.style.motion_duration = 381.0
    hover.action_style = HoverCard.HoverCardActionDefaultStyle()
    hover_result := HoverCard.Draw(session, hover, *hover_state)
    if hover_result.node < 0 {
        render_overlay_failure = 4
        return false
    }

    confirm_state := ConfirmPopover.ConfirmPopoverStateFor()
    confirm: ConfirmPopover.Props
    confirm.key = 40
    confirm.id = 1040
    confirm.class_name = 2040
    confirm.title = "Delete?"
    confirm.confirm_label = "Delete"
    confirm.cancel_label = "Cancel"
    confirm.anchor = Rectangle.{100.0, 100.0, 120.0, 34.0}
    confirm.viewport = Viewport()
    confirm.width = 290.0
    confirm.danger = true
    confirm.open = true
    confirm.now_ms = 1280
    confirm.style = ConfirmPopover.ConfirmPopoverDefaultStyle()
    confirm.confirm_style = ConfirmPopover.ConfirmPopoverConfirmDefaultStyle(true)
    confirm.cancel_style = ConfirmPopover.ConfirmPopoverDefaultStyle()
    confirm_result := ConfirmPopover.Draw(session, confirm, *confirm_state)
    if confirm_result.node < 0 { render_overlay_failure = 5; return false }

    tour_steps: [2]GuidedTour.GuidedTourStep
    tour_steps[0].target = Rectangle.{160.0, 80.0, 100.0, 40.0}
    tour_steps[0].title = "Tour"
    tour_steps[0].placement = .OverlayPlaceBottomStart
    tour_steps[1].target = Rectangle.{180.0, 140.0, 100.0, 40.0}
    tour_steps[1].title = "Finish"
    tour_steps[1].placement = .OverlayPlaceTopStart
    tour_state := GuidedTour.GuidedTourStateFor(0)
    tour: GuidedTour.Props
    tour.key = 50
    tour.id = 1050
    tour.class_name = 2050
    tour.steps = tour_steps[:]
    tour.width = 280.0
    tour.padding = 12.0
    tour.next_label = "Next"
    tour.back_label = "Back"
    tour.done_label = "Done"
    tour.skip_label = "Skip"
    tour.viewport = Viewport()
    tour.now_ms = 1280
    tour.card_style = GuidedTour.GuidedTourCardDefaultStyle()
    tour.card_style.radius = 19.0
    tour.card_style.font_size = 21.0
    tour.card_style.motion_duration = 397.0
    tour.scrim_style = GuidedTour.GuidedTourScrimDefaultStyle()
    tour.button_style = GuidedTour.GuidedTourButtonDefaultStyle()
    tour_result := GuidedTour.Draw(session, tour, *tour_state)
    if tour_result.card_node < 0 ||
        !PendingFillRadius(session, 19.0) { render_overlay_failure = 6; return false }

    pending := PendingPaintCount(session)
    if pending > 99 { render_overlay_failure = 7; return false }
    PaintFlush(session)
    if EndFrame(session) != cast(FrameStatus)FrameOk {
        render_overlay_failure = 8
        return false
    }
    if TreeNodeAt(session, tooltip_result.node).style_id != 1001 ||
        TreeNodeAt(session, tooltip_result.node).style_class != 2001 {
        render_overlay_failure = 9; return false
    }
    if TreeNodeAt(session, sheet_result.title_node).semantic_label != "Sheet" ||
        TreeNodeAt(session, palette_result.query_node).semantic_kind !=
            cast(SemanticKind)SemanticTextField ||
        TreeNodeAt(session, hover_result.action_node).semantic_label != "Open" ||
        TreeNodeAt(session, confirm_result.confirm_node).semantic_label != "Delete" ||
        TreeNodeAt(session, tour_result.next_node).semantic_label != "Next" {
        render_overlay_failure = 10; return false
    }
    return true
}

RenderAndTreeBehavior :: () -> s32 {
    if !CuiOverlaysRasterBegin() { return 1 }
    session := SessionOpen()
    CuiOverlaysRasterReset()
    if !RenderOverlayFrame(session, 1, false) || CuiOverlaysRasterFailed() {
        if render_overlay_failure != 0 { return 200 + render_overlay_failure }
        if CuiOverlaysRasterFailed() { return 20 }
        if CuiOverlaysRasterCalls() < 10 {
            return 100 + CuiOverlaysRasterCalls()
        }
        return 22
    }
    light_hash := CuiOverlaysRasterHash()
    if light_hash == cast(u64)14695981039346656037 { return 3 }

    if !InstallDefaultTheme(true) { return 4 }
    if !RenderOverlayFrame(session, 2, true) ||
        CuiOverlaysRasterFailed() { return 5 }
    dark_hash := CuiOverlaysRasterHash()
    if dark_hash == light_hash { return 6 }

    TreeDispose(session)
    unused SessionClose(session)
    CuiOverlaysRasterClose()
    return 0
}

#program_export
main :: () -> s32 {
    if !InstallDefaultTheme(false, false) { return 100 }
    check := TooltipBehavior()
    if check != 0 { return check }
    check = SheetBehavior()
    if check != 0 { return 1000 + check }
    check = CommandPaletteBehavior()
    if check != 0 { return 2000 + check }
    check = HoverCardBehavior()
    if check != 0 { return 3000 + check }
    check = ConfirmPopoverBehavior()
    if check != 0 { return 4000 + check }
    check = GuidedTourBehavior()
    if check != 0 { return 5000 + check }
    check = RenderAndTreeBehavior()
    if check != 0 { return 6000 + check }
    return 0
}
