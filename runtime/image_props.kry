#module "image_props"
#import "kryon_compat.generated.h"

ImageFit :: enum {
    ImageFitStretch = 0
    ImageFitContain = 1
    ImageFitCover = 2
}

ImageProps :: struct {
    asset_path: const char*
    alt_text: const char*
    bounds: Rectangle
    source: Rectangle
    origin: Vector2
    rotation: float
    tint: Color
    fit: ImageFit
    class_name: i32
}
