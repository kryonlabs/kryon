#import "drawing_props"
#import "geometry"

ProfileHeaderLayout :: struct {
    height: s32
    top_pad: s32
    avatar_radius: s32
    avatar_size: s32
    padding_x: s32
    avatar_center_x: s32
    avatar_center_y: s32
    name_x: s32
    name_y: s32
    count_y: s32
    max_name_width: s32
    profile_bounds: Rectangle
    avatar_tile_bounds: Rectangle
    icon_bounds: Rectangle
    username_bounds: Rectangle
    friends_bounds: Rectangle
    header_bounds: Rectangle
}

ProfilePickerLayout :: struct {
    width: s32
    gap: s32
    content_width: s32
    columns: s32
    cell: s32
    rows: s32
    grid_width: s32
    content_height: s32
    height: s32
    max_height: s32
    icon_inset: s32
}

ProfilePickerCell :: struct {
    row: s32
    column: s32
    bounds: Rectangle
    icon_bounds: Rectangle
}

ProfilePointerAction :: struct {
    active: bool
    activated: bool
    mark_clickable: bool
    consume_release: bool
    activate: bool
}

ProfilePickerCellDecision :: struct {
    mark_clickable: bool
    consume_release: bool
    select: bool
    changed: bool
    selected_index: s32
    selected_icon_type: s32
    close: bool
}

ProfileScale :: (scale: float32) -> float32 {
    if scale <= 0.0 { return 1.0 }
    return scale
}

ProfilePx :: (value: float32, scale: float32) -> s32 {
    return cast(s32)(value * ProfileScale(scale))
}

#program_export
ProfileHeaderUsernameHitWidth :: (text_width: s32, scale: float32) -> s32 {
    if text_width < 0 { text_width = 0 }
    return text_width + ProfilePx(8.0, scale)
}

#program_export
ProfileHeaderUsernameHitHeight :: (text_height: s32, scale: float32) -> s32 {
    if text_height < 0 { text_height = 0 }
    return text_height + ProfilePx(8.0, scale)
}

#program_export
ProfileHeaderSubtitleY :: (name_y: s32, scale: float32) -> s32 {
    return name_y + ProfilePx(22.0, scale)
}

#program_export
ProfileHeaderFriendsTextX :: (header_x: s32, scale: float32) -> s32 {
    return header_x + ProfilePx(12.0, scale)
}

#program_export
ProfileHeaderFriendsTextY :: (count_y: s32, scale: float32) -> s32 {
    return count_y + ProfilePx(8.0, scale)
}

#program_export
ProfileHeaderMutedAlpha :: (alpha: u8) -> u8 {
    return cast(u8)(cast(float32)alpha * 0.72)
}

#program_export
ProfilePickerSelectedStrokeWidth :: (scale: float32) -> s32 {
    return ProfilePx(2.0, scale)
}

#program_export
ProfileHeaderLayoutFor :: (x: s32, y: s32, width: s32,
    requested_height: s32, requested_padding_x: s32, username_width: s32,
    username_height: s32, scale: float32) -> ProfileHeaderLayout {
    layout: ProfileHeaderLayout
    layout.height = requested_height
    if layout.height <= 0 { layout.height = ProfilePx(138.0, scale) }
    layout.top_pad = ProfilePx(24.0, scale)
    layout.avatar_radius = ProfilePx(28.0, scale)
    layout.avatar_size = layout.avatar_radius * 2
    layout.padding_x = requested_padding_x
    if layout.padding_x <= 0 { layout.padding_x = ProfilePx(16.0, scale) }
    layout.avatar_center_x = x + layout.padding_x + layout.avatar_radius
    layout.avatar_center_y = y + layout.top_pad + layout.avatar_radius
    layout.name_x = layout.avatar_center_x + layout.avatar_radius +
        ProfilePx(14.0, scale)
    layout.name_y = layout.avatar_center_y - ProfilePx(14.0, scale)
    layout.count_y = layout.avatar_center_y + layout.avatar_radius +
        ProfilePx(8.0, scale)
    layout.max_name_width = width - (layout.name_x - x) -
        ProfilePx(12.0, scale)
    if layout.max_name_width < ProfilePx(48.0, scale) {
        layout.max_name_width = ProfilePx(48.0, scale)
    }
    if username_width > layout.max_name_width {
        username_width = layout.max_name_width
    }
    layout.profile_bounds = Rectangle.{
        cast(float32)(layout.avatar_center_x - layout.avatar_radius -
            ProfilePx(4.0, scale)),
        cast(float32)(layout.avatar_center_y - layout.avatar_radius -
            ProfilePx(4.0, scale)),
        cast(float32)(layout.avatar_size + ProfilePx(8.0, scale)),
        cast(float32)(layout.avatar_size + ProfilePx(8.0, scale))}
    layout.avatar_tile_bounds = Rectangle.{
        cast(float32)(layout.avatar_center_x - layout.avatar_radius -
            ProfilePx(3.0, scale)),
        cast(float32)(layout.avatar_center_y - layout.avatar_radius -
            ProfilePx(3.0, scale)),
        cast(float32)(layout.avatar_size + ProfilePx(6.0, scale)),
        cast(float32)(layout.avatar_size + ProfilePx(6.0, scale))}
    layout.icon_bounds = Rectangle.{
        cast(float32)(layout.avatar_center_x - layout.avatar_radius +
            ProfilePx(3.0, scale)),
        cast(float32)(layout.avatar_center_y - layout.avatar_radius +
            ProfilePx(3.0, scale)),
        cast(float32)(layout.avatar_size - ProfilePx(6.0, scale)),
        cast(float32)(layout.avatar_size - ProfilePx(6.0, scale))}
    layout.username_bounds = Rectangle.{
        cast(float32)layout.name_x,
        cast(float32)(layout.name_y - ProfilePx(4.0, scale)),
        cast(float32)username_width,
        cast(float32)username_height}
    layout.friends_bounds = Rectangle.{
        cast(float32)x, cast(float32)layout.count_y, cast(float32)width,
        cast(float32)ProfilePx(36.0, scale)}
    layout.header_bounds = Rectangle.{
        cast(float32)x, cast(float32)y, cast(float32)width, cast(float32)layout.height}
    return layout
}

#program_export
ProfilePickerLayoutFor :: (view_width: s32, view_height: s32,
    requested_max_width: s32, icon_count: s32, scale: float32) -> ProfilePickerLayout {
    layout: ProfilePickerLayout
    layout.width = requested_max_width
    if layout.width > 0 { layout.width = ProfilePx(cast(float32)layout.width, scale) }
    if layout.width <= 0 { layout.width = ProfilePx(520.0, scale) }
    if layout.width > view_width - ProfilePx(24.0, scale) {
        layout.width = view_width - ProfilePx(24.0, scale)
    }
    if layout.width < ProfilePx(240.0, scale) {
        layout.width = ProfilePx(240.0, scale)
    }
    layout.gap = ProfilePx(8.0, scale)
    layout.content_width = layout.width - ProfilePx(36.0, scale)
    layout.columns = (layout.content_width + layout.gap) /
        (ProfilePx(64.0, scale) + layout.gap)
    if layout.columns < 3 { layout.columns = 3 }
    if layout.columns > icon_count { layout.columns = icon_count }
    if layout.columns < 1 { layout.columns = 1 }
    layout.cell = (layout.content_width - (layout.columns - 1) *
        layout.gap) / layout.columns
    if layout.cell > ProfilePx(64.0, scale) { layout.cell = ProfilePx(64.0, scale) }
    if layout.cell < ProfilePx(52.0, scale) { layout.cell = ProfilePx(52.0, scale) }
    layout.grid_width = layout.columns * layout.cell +
        (layout.columns - 1) * layout.gap
    if layout.columns > 0 {
        layout.rows = (icon_count + layout.columns - 1) / layout.columns
    }
    if layout.rows > 0 {
        layout.content_height = layout.rows * layout.cell +
            (layout.rows - 1) * layout.gap
    }
    layout.height = ProfilePx(74.0, scale) + layout.content_height +
        ProfilePx(18.0, scale)
    layout.max_height = view_height - ProfilePx(24.0, scale)
    if layout.height > layout.max_height { layout.height = layout.max_height }
    layout.icon_inset = ProfilePx(6.0, scale)
    return layout
}

#program_export
ProfilePickerCellFor :: (index: s32, content_x: s32, content_y: s32,
    content_width: s32, picker: ProfilePickerLayout) -> ProfilePickerCell {
    cell: ProfilePickerCell
    if picker.columns <= 0 { return cell }
    cell.row = index / picker.columns
    cell.column = index % picker.columns
    x: s32 = content_x + (content_width - picker.grid_width) / 2 +
        cell.column * (picker.cell + picker.gap)
    y: s32 = content_y + cell.row * (picker.cell + picker.gap)
    cell.bounds = Rectangle.{
        cast(float32)x, cast(float32)y, cast(float32)picker.cell, cast(float32)picker.cell}
    cell.icon_bounds = Rectangle.{
        cast(float32)(x + picker.icon_inset),
        cast(float32)(y + picker.icon_inset),
        cast(float32)(picker.cell - picker.icon_inset * 2),
        cast(float32)(picker.cell - picker.icon_inset * 2)}
    return cell
}

#program_export
ProfilePointerActionFor :: (active: bool, activated: bool) -> ProfilePointerAction {
    action: ProfilePointerAction
    action.active = active
    action.activated = activated
    action.mark_clickable = active
    action.activate = active && activated
    action.consume_release = action.activate
    return action
}

#program_export
ProfilePointerActionFromInput :: (inside: bool, input_captured: bool,
    hover_enabled: bool, released: bool) -> ProfilePointerAction {
    active: bool = inside && !input_captured && hover_enabled
    return ProfilePointerActionFor(active, active && released)
}

#program_export
ProfilePickerCellDecisionFor :: (active: bool, activated: bool,
    index: s32, icon_type: s32, selected_icon_type: s32) -> ProfilePickerCellDecision {
    decision: ProfilePickerCellDecision
    decision.selected_index = -1
    decision.selected_icon_type = selected_icon_type
    decision.mark_clickable = active
    if active && activated {
        decision.consume_release = true
        decision.select = true
        decision.changed = icon_type != selected_icon_type
        decision.selected_index = index
        decision.selected_icon_type = icon_type
        decision.close = true
    }
    return decision
}
