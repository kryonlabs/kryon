#module "flow"
#import "geometry"
#import "layout"
#import "tree"
#import "widget_kind"

FlowProps :: struct {
    bounds: Rectangle
    gap: i32
    padding: i32
    key: u64
}

FlowResult :: struct {
    node: i32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: i32
    padding: i32
}

# Flow places its children along a row. The caller uses FlowChildBounds before
# submitting each child, then closes the retained scope with End().
Flow :: (props: FlowProps) -> FlowResult #export {
    result: FlowResult
    result.node = -1
    result.bounds = props.bounds
    parent: Rectangle = TreeCurrentParentBounds()
    if result.bounds.width <= 0.0 { result.bounds.width = parent.width }
    if result.bounds.height <= 0.0 { result.bounds.height = parent.height }
    metrics: LayoutMetrics = LayoutMetricsFor(result.bounds,
        props.gap, props.padding)
    result.content = metrics.content
    result.gap = metrics.gap
    result.padding = metrics.padding
    if !TreeIsBuilding() { return result }
    key: u64 = props.key
    if key == (u64)0 { key = TreeNextKey() }
    result.node = TreeSubmitCurrent(key, WidgetKindRow, result.bounds)
    if result.node < 0 { return result }
    result.opened = TreePushScope(result.node)
    return result
}

FlowChildBounds :: (flow: FlowResult, declared: Rectangle,
    measured: Rectangle, child_index: i32,
    previous_width_sum: float) -> Rectangle #export {
    metrics: LayoutMetrics = LayoutMetricsFor(flow.bounds,
        flow.gap, flow.padding)
    cursor: float = LayoutCursorForChild(metrics, true,
        child_index, previous_width_sum)
    return LayoutChildBounds(declared, measured, metrics, true, cursor)
}
