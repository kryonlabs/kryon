#import "geometry"
#import "drawing_props"
#import "semantic"
#import "text_align"

// Common font sizes used by the Ziran Text widget. A host supplies glyph
// measurements and rasterization through font_metrics and raster_text.
Text8 :: 8
Text12 :: 12
Text14 :: 14
Text16 :: 16
Text18 :: 18
Text20 :: 20
Text24 :: 24
Text32 :: 32
Text48 :: 48
TextBaseSize :: 16

TextWrap :: enum {
    TextWrapAuto :: 0
    TextWrapNone :: 1
    // One line, like TextWrapNone; text wider than its bounds ends in "...".
    TextWrapEllipsis :: 2
}

// UTF-8 byte ranges in the visible text, with an exclusive end. Invalid or
// overlapping ranges are ignored. Emphasis keeps the ordinary text layout.
TextRange :: struct {
    start: s32
    end: s32
}

TextProps :: struct {
    key: u64
    bounds: Rectangle
    text: string
    font: s32
    fallback_font: s32
    style_kind: s32
    semantic_kind: SemanticKind
    heading_level: s32
    class_name: s32
    wrap: TextWrap
    align: TextAlign
    vertical_align: TextAlign
    disabled: bool
    selectable: bool
    strikethrough: bool
    strong: []TextRange
    // While typing, only the first typed characters are painted, as if they
    // were being typed. A character is a grapheme cluster. The layout, the
    // size and the accessible label always keep the whole text.
    typing: bool
    typed: s32
    // Web links in the visible text, as for strong. Each is painted in the
    // theme's link color and underlined, inside the ordinary text; TextLinkAt
    // finds the one under a pointer so the caller can open it.
    links: []TextRange
}

PreparedText :: struct {
    bounds: Rectangle
    font: s32
    color: Color
    typeface: string
    line_height: s32
    line_gap: s32
    line_count: s32
    wrap: TextWrap
}
