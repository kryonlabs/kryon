#module "radio_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/radio.h"
#import "ui/widget_input.h"
#import "ui/widget_store.h"

RadioFrame :: (tone: ButtonTone, state: ButtonState,
disabled: i32, selected: i32, class_name: i32,
role: i32) -> StyleFrame {
    props: ButtonProps
    props.class_name = class_name
    props.tone = tone
    props.emphasis = ButtonEmphasisOutline
    if tone == ButtonToneAccent { props.emphasis = ButtonEmphasisFilled }
    props.size = ControlSizeMedium
    props.disabled = disabled
    props.selected = selected
    return ui_control_style_frame_role_kind(props, state, 0,
    0.0, 0.0, 0.0, StyleKindRadio(), role)
}

RadioAnimationKey :: (radio: RadioProps) -> u32 {
    key: u32 = 2166136261u
    key = (key ^ (unsigned int)radio.id) * 16777619u
    key = (key ^ (unsigned int)(int)radio.bounds.x) * 16777619u
    key = (key ^ (unsigned int)(int)radio.bounds.y) * 16777619u
    key = (key ^ (unsigned int)(int)radio.bounds.width) * 16777619u
    key = (key ^ (unsigned int)(int)radio.bounds.height) * 16777619u
    text: const char* = radio.label
    if text == nil { text = "" }
    index: i32 = 0
    while text[index] != 0 {
        key = (key ^ (unsigned char)text[index]) * 16777619u
        index += 1
    }
    return key
}

RenderRadio :: (radio: RadioProps) -> i32 #export {
    toolkit: *ToolkitStore = toolkit_store_current()
    initial_state: ButtonState = ButtonStateNormal
    if radio.disabled { initial_state = ButtonStateDisabled }
    label_frame: StyleFrame = RadioFrame(ButtonToneNeutral,
    initial_state, radio.disabled, radio.checked, radio.class_name,
    RadioLabelRole())
    label_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(label_frame).value)
    font: i32 = ResolveFont(0, StyleFontValue(label_style.fields,
    label_style.font_size), GetFontSize())
    runtime_scale: float = (float)Scale(1000) / 1000.0
    target: float = 0.0
    if radio.checked { target = 1.0 }
    spec: RadioSpec
    spec.bounds = radio.bounds
    spec.checked = radio.checked
    spec.disabled = radio.disabled
    spec.selected_amount = target
    spec.scale = runtime_scale
    spec.frame = RadioFrame(ButtonToneNeutral, initial_state,
    radio.disabled, radio.checked, radio.class_name, RadioRingRole())
    spec.selected = RadioFrame(ButtonToneAccent, initial_state,
    radio.disabled, radio.checked, radio.class_name, RadioMarkRole())
    paint: RadioPaint = RadioPaintFor(spec)
    paint.label_color = ColorToInt(label_style.foreground)

    focused: i32 = 0
    activated: i32 = ui_focusable_pressed(paint.hit_bounds,
    radio.id, radio.disabled, &focused)
    hot: i32 = ui_hot(paint.hit_bounds) && !radio.disabled &&
    !ContentDisabled()
    down: i32 = hot && IsMouseButtonDown(MOUSE_BUTTON_LEFT)
    if hot != 0 { MarkClickable() }
    if radio.disabled { MarkDisabled() }
    if !IsWindowReady() {
        return RadioActivationFor(radio.id, activated != 0,
        radio.disabled != 0)
    }

    state_bounds: Rectangle
    state_bounds.x = paint.center.x - paint.touch / 2.0
    state_bounds.y = paint.center.y - paint.touch / 2.0
    state_bounds.width = paint.touch
    state_bounds.height = paint.touch
    key: u32 = RadioAnimationKey(radio)
    anim: *RadioAnimState = &toolkit->radio_anim[key % RADIO_ANIM_MAX]
    if anim->key != key || g_ui_frame_serial - anim->frame_seen > 12 {
        memset(anim, 0, sizeof(RadioAnimState))
        anim->key = key
        anim->selected = target
    }
    anim->frame_seen = g_ui_frame_serial
    dt: float = GetFrameTime()
    if dt <= 0.0 || dt > 0.1 { dt = 1.0 / 60.0 }
    step: float = dt * 18.0
    press_step: float = dt * 20.0
    if step > 1.0 { step = 1.0 }
    if press_step > 1.0 { press_step = 1.0 }
    anim->selected += (target - anim->selected) * step
    press_target: float = 0.0
    if down != 0 { press_target = 1.0 }
    anim->press += (press_target - anim->press) * press_step
    press: float = anim->press

    state: ButtonState = ui_selection_button_state(hot, down,
    focused, radio.disabled)
    spec.selected_amount = anim->selected
    spec.frame = RadioFrame(ButtonToneNeutral, state, radio.disabled,
    radio.checked, radio.class_name, RadioRingRole())
    spec.selected = RadioFrame(ButtonToneAccent, state, radio.disabled,
    radio.checked, radio.class_name, RadioMarkRole())
    paint = RadioPaintFor(spec)
    label_frame = RadioFrame(ButtonToneNeutral, state, radio.disabled,
    radio.checked, radio.class_name, RadioLabelRole())
    label_style = ui_unpack_style(
    ui_style_apply_effects_frame(label_frame).value)
    font = ResolveFont(0, StyleFontValue(label_style.fields,
    label_style.font_size), font)
    paint.label_color = ColorToInt(label_style.foreground)

    ring: Color = GetColor(paint.ring_color)
    fill: Color = GetColor(paint.fill_color)
    text_color: Color = Fade(GetColor(paint.label_color),
    label_style.opacity)
    if radio.disabled { press = 0.0 }
    layer_alpha: i32 = RadioStateLayerAlpha(
    hot != 0 && HoverEffectsEnabled(), down != 0, press)
    if layer_alpha > 0 {
        layer: Color = ring
        layer.a = (unsigned char)layer_alpha
        DrawCircleV(paint.center, paint.touch / 2.0, layer)
    }
    ui_default_ripple(state_bounds, ring, (int)key, down)
    if paint.fill_radius > 0.2 {
        DrawCircleV(paint.center, paint.fill_radius, fill)
    }
    if paint.stroke_width > 0.0 {
        DrawRing(paint.center, paint.outer_radius - paint.stroke_width,
        paint.outer_radius, 0.0, 360.0, 48, ring)
    }
    text: const char* = radio.label
    if text == nil { text = "" }
    RenderText(text, (int)paint.label_x,
    ui_row_text_y(radio.bounds, font), font, text_color)
    if focused != 0 && IsWindowReady() { RenderFocus(paint.hit_bounds) }
    return RadioActivationFor(radio.id, activated != 0,
    radio.disabled != 0)
}
