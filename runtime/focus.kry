#module "focus"
#import "control_props"
#import "drawing_props"
#import "style"

FocusPaint :: struct {
    bounds: Rectangle
    stroke_width: i32
}

FocusDebugOverlayPaint :: struct {
    outline: Rectangle
    label_position: Vector2
    stroke_width: i32
    label_visible: bool
}

FocusBoxRole :: () -> i32 #export {
    return 9
}

FocusLabelRole :: () -> i32 #export {
    return 6
}

FocusMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return (i32)(value * scale)
}

FocusStrokeWidthFor :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(2.0 * scale)
}

FocusActivationFor :: (active: bool, keyboard_enabled: bool,
    content_disabled: bool, captured: bool, enter_pressed: bool,
    space_pressed: bool, text_input_active: bool) -> bool #export {
    return active && keyboard_enabled && !content_disabled && !captured &&
        (enter_pressed || (!text_input_active && space_pressed))
}

FocusDefaultOutlineBounds :: (bounds: Rectangle, scale: float) -> Rectangle #export {
    if scale <= 0.0 { scale = 1.0 }
    pad: i32 = (i32)(2.0 * scale)
    out: Rectangle
    out.x = bounds.x - (float)pad
    out.y = bounds.y - (float)pad
    out.width = bounds.width + (float)(pad * 2)
    out.height = bounds.height + (float)(pad * 2)
    return out
}

FocusPaintFor :: (bounds: Rectangle, scale: float, frame: StyleFrame) -> FocusPaint #export {
    if scale <= 0.0 { scale = 1.0 }
    pad: i32 = FocusMetric(frame.value.fields, (u32)StylePaddingX,
        frame.value.padding_x, 3.0, scale)
    stroke: i32 = FocusMetric(frame.value.fields, (u32)StyleBorderWidth,
        frame.value.border_width, 2.0, scale)
    paint: FocusPaint
    paint.bounds.x = bounds.x - (float)pad
    paint.bounds.y = bounds.y - (float)pad
    paint.bounds.width = bounds.width + (float)(pad * 2)
    paint.bounds.height = bounds.height + (float)(pad * 2)
    paint.stroke_width = stroke
    return paint
}

FocusDebugOverlayPaintFor :: (bounds: Rectangle, font_height: i32, has_label: bool) -> FocusDebugOverlayPaint #export {
    if font_height < 0 { font_height = 0 }
    paint: FocusDebugOverlayPaint
    paint.outline = bounds
    paint.label_position.x = bounds.x
    paint.label_position.y = bounds.y - (float)font_height
    paint.stroke_width = 1
    paint.label_visible = has_label
    return paint
}
