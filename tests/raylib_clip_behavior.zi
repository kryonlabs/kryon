#import "raylib_runtime"
#import "raylib_clip"
#import "geometry"
#import "drawing_props"
#import "c_string"

test_raylib :: #system_library "raylib";
TestHostInitWindow :: (width: s32, height: s32,
    title: *u8) #foreign test_raylib "InitWindow";
TestHostIsWindowReady :: () -> bool #foreign test_raylib "IsWindowReady";
TestHostBeginDrawing :: () #foreign test_raylib "BeginDrawing";
TestHostEndDrawing :: () #foreign test_raylib "EndDrawing";
TestHostCloseWindow :: () #foreign test_raylib "CloseWindow";
TestHostClearBackground :: (color: Color) #foreign test_raylib "ClearBackground";
TestHostBeginScissor :: (x: s32, y: s32, width: s32,
    height: s32) #foreign test_raylib "BeginScissorMode";
TestHostEndScissor :: () #foreign test_raylib "EndScissorMode";
TestClipEnabled :: (capability: u32) -> u8 #foreign test_raylib "glIsEnabled";
TestClipRead :: (parameter: u32, values: *s32) #foreign test_raylib "glGetIntegerv";

ClipTestImage :: struct {
    data: *void
    width: s32
    height: s32
    mipmaps: s32
    format: s32
}

TestCameraBegin :: (camera: Camera) #foreign test_raylib "BeginMode2D";
TestCameraEnd :: () #foreign test_raylib "EndMode2D";
TestCapture :: () -> ClipTestImage #foreign test_raylib "LoadImageFromScreen";
TestImageColor :: (image: ClipTestImage, x: s32,
    y: s32) -> Color #foreign test_raylib "GetImageColor";
TestImageFree :: (image: ClipTestImage) #foreign test_raylib "UnloadImage";

RedAt :: (image: ClipTestImage, x: s32, y: s32) -> bool {
    color := TestImageColor(image, x, y)
    return color.r > 200 && color.g < 50 && color.b < 50
}

BlackAt :: (image: ClipTestImage, x: s32, y: s32) -> bool {
    color := TestImageColor(image, x, y)
    return color.r == 0 && color.g == 0 && color.b == 0
}

BlueAt :: (image: ClipTestImage, x: s32, y: s32) -> bool {
    color := TestImageColor(image, x, y)
    return color.b > 200 && color.r < 50 && color.g < 50
}

#program_export
main :: () -> s32 {
    title: [32]u8
    CopyCString("Kryon clip test", title[:])
    TestHostInitWindow(320, 240, *title[0])
    if !TestHostIsWindowReady() {
        return 1
    }
    TestHostBeginDrawing()
    TestHostClearBackground(Color.{0, 0, 0, 255})
    TestCameraBegin(Camera.{.{80.0, 40.0}, .{0.0, 0.0}, 0.0, 2.0})
    RasterImage("red.png", 0, Rectangle.{0.0, 0.0, 16.0, 16.0},
        Rectangle.{10.0, 10.0, 40.0, 40.0},
        Rectangle.{15.0, 15.0, 20.0, 20.0},
        Vector2.{0.0, 0.0}, 0.0, 0.0, Color.{255, 255, 255, 255})
    RasterTextClipped("Clip", 10, 60, 16, Color.{255, 255, 255, 255},
        Rectangle.{10.0, 60.0, 80.0, 24.0})
    if TestClipEnabled(cast(u32)0x0C11) != 0 {
        TestHostCloseWindow()
        return 2
    }
    TestCameraEnd()

    // A caller's screen clip must survive both raster effects and limit them.
    TestHostBeginScissor(210, 50, 12, 16)
    before: [4]s32
    TestClipRead(cast(u32)0x0C10, *before[0])
    TestCameraBegin(Camera.{.{200.0, 40.0}, .{0.0, 0.0}, 0.0, 1.0})
    RasterImage("red.png", 0, Rectangle.{0.0, 0.0, 16.0, 16.0},
        Rectangle.{0.0, 0.0, 60.0, 60.0},
        Rectangle.{0.0, 0.0, 60.0, 60.0},
        Vector2.{0.0, 0.0}, 0.0, 0.0, Color.{255, 255, 255, 255})
    after: [4]s32
    TestClipRead(cast(u32)0x0C10, *after[0])
    if TestClipEnabled(cast(u32)0x0C11) == 0 {
        TestHostCloseWindow()
        return 3
    }
    index: s32 = 0
    while index < 4 {
        if before[index] != after[index] {
            TestHostCloseWindow()
            return 4
        }
        index += 1
    }
    TestCameraEnd()
    TestHostEndScissor()
    // A rounded image draws inside its rounded corners and not past them.
    RasterImage("red.png", 0, Rectangle.{0.0, 0.0, 16.0, 16.0},
        Rectangle.{270.0, 10.0, 40.0, 40.0},
        Rectangle.{270.0, 10.0, 40.0, 40.0},
        Vector2.{0.0, 0.0}, 0.0, 20.0, Color.{255, 255, 255, 255})
    RasterImage("split.png", 0, Rectangle.{0.0, 0.0, -16.0, 16.0},
        Rectangle.{10.0, 120.0, 80.0, 40.0},
        Rectangle.{10.0, 120.0, 80.0, 40.0},
        Vector2.{0.0, 0.0}, 0.0, 0.0, Color.{255, 255, 255, 255})
    RasterImage("split.png", 0, Rectangle.{0.0, 0.0, -16.0, 16.0},
        Rectangle.{110.0, 120.0, 80.0, 40.0},
        Rectangle.{120.0, 120.0, 60.0, 40.0},
        Vector2.{0.0, 0.0}, 0.0, 8.0, Color.{255, 255, 255, 255})
    // Text wider than its clip is still cut at the clip edge.
    RasterTextClipped("WWWWWWWWWW", 10, 215, 16, Color.{255, 255, 255, 255},
        Rectangle.{10.0, 215.0, 24.0, 20.0})
    TestHostEndDrawing()
    capture := TestCapture()
    result: s32 = 0
    if !BlueAt(capture, 25, 140) || !RedAt(capture, 75, 140) ||
    !BlueAt(capture, 125, 140) || !RedAt(capture, 175, 140) ||
    !BlackAt(capture, 115, 140) || !BlackAt(capture, 185, 140) {
        print("Mirrored image pixels: % % % % % %", TestImageColor(capture, 25, 140),
            TestImageColor(capture, 75, 140), TestImageColor(capture, 125, 140),
            TestImageColor(capture, 175, 140), TestImageColor(capture, 115, 140),
            TestImageColor(capture, 185, 140))
        result = 10
    }
    if !RedAt(capture, 130, 90) || !BlackAt(capture, 105, 65) ||
    !BlackAt(capture, 155, 90) {
        result = 5
    }
    if !RedAt(capture, 215, 55) || !BlackAt(capture, 205, 55) ||
    !BlackAt(capture, 225, 55) {
        result = 6
    }
    text_pixels: s32 = 0
    y: s32 = 160
    while y < 208 {
        x: s32 = 100
        while x < 260 {
            color := TestImageColor(capture, x, y)
            if color.r > 200 && color.g > 200 && color.b > 200 {
                text_pixels += 1
            }
            x += 1
        }
        y += 1
    }
    if text_pixels < 20 {
        result = 7
    }
    inside_pixels: s32 = 0
    outside_pixels: s32 = 0
    y = 215
    while y < 235 {
        x: s32 = 10
        while x < 140 {
            color := TestImageColor(capture, x, y)
            if color.r > 200 && color.g > 200 && color.b > 200 {
                if x < 34 { inside_pixels += 1 } else { outside_pixels += 1 }
            }
            x += 1
        }
        y += 1
    }
    if inside_pixels < 10 || outside_pixels != 0 {
        result = 8
    }
    if !RedAt(capture, 290, 30) || !RedAt(capture, 272, 30) ||
    !RedAt(capture, 290, 48) || !BlackAt(capture, 272, 12) ||
    !BlackAt(capture, 308, 48) {
        result = 9
    }
    TestImageFree(capture)
    TestHostCloseWindow()
    return result
}
