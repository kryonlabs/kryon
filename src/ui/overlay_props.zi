#module "overlay_props"
#import "drawing_props"
#import "geometry"

DismissibleOverlayProps :: struct {
    key: u64
    bounds: Rectangle
    view_width: i32
    view_height: i32
    scrim: Color
    dismiss_disabled: bool
}

DismissibleOverlayResult :: struct {
    node: i32
    panel_node: i32
    closed: bool
    outside_released: bool
    release_consumed: bool
}
