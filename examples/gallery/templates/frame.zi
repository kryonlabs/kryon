// @declarations
App :: #import "kryon/app";
Box :: #import "kryon/box";
Layout :: #import "kryon/layout";
Text :: #import "kryon/text";
#import "kryon/tree"
#import "palette"
#import "preview_protocol"

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    SetGalleryViewport(viewport, true, example_input.now, example_input.reduced_motion)
    Box.Draw(session, Box.Props.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    // A page column places the header; scene content keeps its own anchors.
    page := Layout.Draw(session, Layout.Props.{.key = 9100, .bounds = viewport,
        .padding = 24, .padding_override = true})
    if page.opened {
        Text.Draw(session, Text.Props.{.key = 9001, .bounds = .{height = 36.0}, .text = "// @title", .size = 23})
        unused End(session)
    }
    disabled := example_input.disabled
    // @example
    return
}

main :: () -> s32 { return App.Run(App.Window.{.title = "frame"}, Frame) }
