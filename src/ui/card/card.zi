#import "tree"
using PropsModule :: #import "card_props";
Layout :: #import "layout";
using BehaviorModule :: #import "card_behavior";
#import "control_props"
#import "drawing_props"
#import "session"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree_input"
#import "widget_kind"
Theme :: #import "theme";

using StyleField;
using WidgetKind;

// A card is a padded column with the card's face: draw its content while it
// is opened, then End(session). Without a height it grows to its content; a
// clickable card is one press target with hover and pressed faces.
#scope_package
Draw :: (session: Session, props: PropsModule.Props, location := #caller_location) -> CardResult {
    site := TreeCallSite(session, location)
    defer { TreeCallSiteEnd(session, site) }
    result: CardResult
    previous: s32 = -1
    if props.clickable && TreeIsBuilding(session) {
        previous = TreePrevious(session, TreeCurrentParent(session), props.key, WidgetKindColumn)
    }
    state := ResolveState(cast(s32)props.state, props.disabled, false,
        TreePressedAt(session, previous), TreeHoveredAt(session, previous), false, props.selected)
    emphasis := CardEmphasis(props.variant)
    facts := StyleControlRoleFacts(StyleKindCard(), props.id, props.class_name,
        StyleAny(), cast(s32)ButtonTone.ButtonToneNeutral, cast(s32)emphasis,
        cast(s32)ControlSize.ControlSizeMedium, state)
    face := ResolveInstalledStyleRules(CardDefaultFace(emphasis, state), facts, state)
    if !StyleHasField(face, cast(u32)StylePaddingX) { face.padding_x = 16.0 }
    if !StyleHasField(face, cast(u32)StylePaddingY) { face.padding_y = 16.0 }
    // The column reads row_gap: a CSS `gap` on a card means its row gap.
    if !StyleHasField(face, cast(u32)StyleRowGap) {
        face.row_gap = Theme.CurrentThemeMetric(.ThemeMetricSpace2)
        if StyleHasField(face, cast(u32)StyleGap) { face.row_gap = face.gap }
    }
    face.fields |= cast(u32)StylePaddingX | cast(u32)StylePaddingY | cast(u32)StyleRowGap
    opacity := StyleOpacityValue(face.fields, face.opacity)
    if props.disabled && opacity == 1.0 { opacity = 0.45 }
    face.background = Opacity(face.background, opacity)
    face.border = Opacity(face.border, opacity)
    face.opacity = 1.0
    box := Layout.Box(session, Layout.Props.{.key = props.key, .bounds = props.bounds}, face)
    result.opened = box.opened
    result.content = box.content
    if props.clickable && box.node >= 0 {
        TreeSetInteractive(session, box.node, props.disabled, false, props.id)
        TreeSetLabel(session, box.node, props.label)
        result.activated = !props.disabled && TreeTakeActivationAt(session, previous)
    }
    return result
}
