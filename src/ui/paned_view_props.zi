#module "paned_view_props"
#import "geometry"

DropZone :: enum {
    DropNone = 0
    DropCenter = 1
    DropLeft = 2
    DropRight = 3
    DropTop = 4
    DropBottom = 5
}

PanedViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    class_name: i32
    vertical: bool
    split: i32
    has_split: bool
    min_first: i32
    min_second: i32
    scale: float
    disabled: bool
}

PanedViewResult :: struct {
    node: i32
    split: i32
    changed: bool
    first: Rectangle
    second: Rectangle
    handle: Rectangle
}
