#import "kryon.h"

app "Generated Table View Parity" {
    size 420 220
    fps 60
}

state {
    selected_row: int = -1
    selected_column: int = -1
    activated_row: int = -1
    activated_column: int = -1
    sort_column: int = -1
    sort_direction: int = 0
    scroll: int = 0
}

table_frame :: () #ui {
    Screen root: {
        columns: [3] const char * = {"Section","Label","Units"}
        cells_a: [3] const char * = {"Banks","Checking","10"}
        cells_b: [3] const char * = {"Cash","Wallet","5"}
        text_colors: [3] Color = {{230,230,230,255},{220,190,80,255},{120,220,140,255}}
        background_colors: [3] Color = {{0,0,0,0},{60,45,20,255},{20,55,30,255}}
        rows: [2] TableRow = {{.cells = cells_a, .cell_count = 3, .text_colors = text_colors, .background_colors = background_colors},{.cells = cells_b, .cell_count = 3}}
        widths: [3] int = {90,140,70}
        enabled: [3] int = {1,1,1}
        order: [3] int = {0,1,2}
        TableView((TableViewProps){.bounds = {20,20,300,120}, .id = 901, .columns = columns, .column_count = 3, .rows = rows, .row_count = 2, .column_widths = widths, .selected_row = &selected_row, .selected_column = &selected_column, .activated_row = &activated_row, .activated_column = &activated_column, .sort_column = &sort_column, .scroll_offset = &scroll, .row_height = 24, .column_enabled = enabled, .column_order = order, .sort_direction = &sort_direction, .disabled = 0, .resizable = 1, .min_column_width = 32, .freeze_rows = 0})
    }
}
