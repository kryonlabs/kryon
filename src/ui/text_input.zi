#program_export
TextFocusClaimDecisionFor :: (has_target: bool, has_previous_owner: bool,
    same_owner: bool) -> TextFocusClaimDecision {
    decision: TextFocusClaimDecision
    decision.claim = has_target
    if !has_target {
        return decision
    }
    decision.displace_previous = has_previous_owner && !same_owner
    decision.cancel_previous = !same_owner
    decision.close_context = !same_owner
    decision.clear_peer_selection = !same_owner
    return decision
}

#program_export
TextFocusOwnerDecisionFor :: (has_target: bool, owns_focus: bool,
    has_frame_owner: bool, target_flag: bool,
    has_focus_owner: bool) -> TextFocusOwnerDecision {
    decision: TextFocusOwnerDecision
    if !has_target {
        return decision
    }
    if owns_focus {
        decision.focused = true
        decision.mark_frame_owner = true
        return decision
    }
    if has_frame_owner {
        decision.clear_target = true
        return decision
    }
    if target_flag && !has_focus_owner {
        decision.focused = true
        decision.adopt_owner = true
        decision.mark_frame_owner = true
        return decision
    }
    decision.clear_target = true
    return decision
}

#program_export
TextFocusOwnerIsStale :: (has_owner: bool, owner_frame: s64,
    current_frame: s64) -> bool {
    return has_owner && owner_frame != current_frame - 1 &&
        owner_frame != current_frame
}

#program_export
TextPlatformInputActiveFor :: (requested: bool, has_owner: bool,
    owner_rendered_this_frame: bool) -> bool {
    return requested || (has_owner && owner_rendered_this_frame)
}

#program_export
TextPlatformInputSyncDecisionFor :: (show_requested: bool,
    has_callback: bool, platform_active: bool,
    text_input_active: bool) -> TextPlatformInputSyncDecision {
    decision: TextPlatformInputSyncDecision
    decision.clear_show_request = true
    if show_requested && has_callback {
        decision.active = true
        decision.call_callback = true
        decision.callback_active = true
        return decision
    }
    decision.active = text_input_active
    if platform_active != text_input_active {
        decision.call_callback = has_callback
        decision.callback_active = text_input_active
    }
    return decision
}

#program_export
TextFocusReleaseDecisionFor :: (has_target: bool, owns_focus: bool,
    owns_frame_focus: bool, active_focus_matches: bool,
    owns_field_drag: bool, owns_area_drag: bool) -> TextFocusReleaseDecision {
    decision: TextFocusReleaseDecision
    decision.release = has_target
    if !has_target {
        return decision
    }
    decision.cancel_self = owns_focus
    decision.clear_owner = owns_focus
    decision.clear_frame_owner = owns_frame_focus
    decision.clear_active_focus = active_focus_matches
    decision.close_context = true
    decision.clear_field_drag = owns_field_drag
    decision.clear_area_drag = owns_area_drag
    return decision
}

#program_export
TextCompositionInputDecisionFor :: (focused: bool, read_only: bool) -> TextCompositionInputDecision {
    decision: TextCompositionInputDecision
    decision.accept_events = focused && !read_only
    decision.cancel = !decision.accept_events
    decision.drain_events = focused && read_only
    return decision
}

#program_export
TextCompositionCancelDecisionFor :: (has_owner: bool, scoped: bool,
    same_owner: bool) -> TextCompositionSessionDecision {
    decision: TextCompositionSessionDecision
    decision.cancel = has_owner && (!scoped || same_owner)
    return decision
}

#program_export
TextCompositionGetDecisionFor :: (has_owner: bool, same_owner: bool,
    has_text: bool) -> TextCompositionSessionDecision {
    decision: TextCompositionSessionDecision
    decision.visible = has_owner && same_owner && has_text
    return decision
}

#program_export
TextCompositionPhaseDecisionFor :: (phase: s32) -> TextCompositionPhaseDecision {
    decision: TextCompositionPhaseDecision
    decision.store_preedit = phase == 1 || phase == 2
    decision.commit = phase == 3
    decision.cancel = phase == 4
    return decision
}

#program_export
TextCompositionApplyDecisionFor :: (phase: s32,
    text_changed: bool) -> TextCompositionApplyDecision {
    event: TextCompositionPhaseDecision = TextCompositionPhaseDecisionFor(phase)
    decision: TextCompositionApplyDecision
    if event.store_preedit || event.cancel {
        decision.presentation_changed = true
        return decision
    }
    if event.commit {
        decision.text_changed = text_changed
        decision.presentation_changed = true
        decision.selection_changed = true
    }
    return decision
}

#program_export
TextCompositionSelectionLength :: (preedit_len: s32, cursor: s32,
    selection_length: s32) -> s32 {
    if preedit_len < 0 { preedit_len = 0 }
    if cursor < 0 { cursor = 0 }
    if cursor > preedit_len { cursor = preedit_len }
    if selection_length < 0 { selection_length = 0 }
    max_length: s32 = preedit_len - cursor
    if selection_length > max_length { return max_length }
    return selection_length
}

#program_export
TextCompositionViewRangeFor :: (selection_start: s32, selection_end: s32,
    preedit_len: s32, preedit_cursor: s32,
    preedit_selection_end: s32) -> TextCompositionViewRange {
    view_range: TextCompositionViewRange
    if selection_start < 0 { selection_start = 0 }
    if selection_end < 0 { selection_end = 0 }
    if selection_start <= selection_end {
        view_range.replace_start = selection_start
        view_range.replace_end = selection_end
    } else {
        view_range.replace_start = selection_end
        view_range.replace_end = selection_start
    }
    if preedit_len < 0 { preedit_len = 0 }
    if preedit_cursor < 0 { preedit_cursor = 0 }
    if preedit_cursor > preedit_len { preedit_cursor = preedit_len }
    if preedit_selection_end < preedit_cursor {
        preedit_selection_end = preedit_cursor
    }
    if preedit_selection_end > preedit_len {
        preedit_selection_end = preedit_len
    }
    view_range.cursor = view_range.replace_start + preedit_cursor
    view_range.selection_start = view_range.cursor
    view_range.selection_end = view_range.replace_start + preedit_selection_end
    view_range.composition_start = view_range.replace_start
    view_range.composition_end = view_range.replace_start + preedit_len
    return view_range
}

#program_export
TextCompositionPaintSpanForText :: (composition_start: s32,
    composition_end: s32, text_len: s32) -> TextCompositionPaintSpan {
    span: TextCompositionPaintSpan
    if text_len < 0 { text_len = 0 }
    if composition_start < 0 { composition_start = 0 }
    if composition_end < 0 { composition_end = 0 }
    if composition_start > text_len { composition_start = text_len }
    if composition_end > text_len { composition_end = text_len }
    if composition_end <= composition_start { return span }
    span.visible = true
    span.start = composition_start
    span.end = composition_end
    return span
}

#program_export
TextCompositionPaintSpanForLine :: (composition_start: s32,
    composition_end: s32, line_start: s32,
    line_end: s32) -> TextCompositionPaintSpan {
    span: TextCompositionPaintSpan
    if composition_end <= composition_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = composition_start
    if span.start < line_start { span.start = line_start }
    span.end = composition_end
    if span.end > line_end { span.end = line_end }
    if span.end <= span.start { return span }
    span.visible = true
    return span
}

#program_export
TextCompositionUnderlineEndX :: (start_x: s32, end_x: s32,
    stroke_width: s32) -> s32 {
    if stroke_width < 1 { stroke_width = 1 }
    if end_x <= start_x { return start_x + stroke_width }
    return end_x
}

#program_export
TextCompositionUnderlineY :: (text_y: s32, line_height: s32,
    stroke_width: s32) -> s32 {
    if stroke_width < 1 { stroke_width = 1 }
    return text_y + line_height - stroke_width
}

#program_export
TextSelectionPaintSpanForLine :: (selection_start: s32,
    selection_end: s32, line_start: s32,
    line_end: s32) -> TextSelectionPaintSpan {
    span: TextSelectionPaintSpan
    if selection_end <= selection_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = selection_start
    if span.start < line_start { span.start = line_start }
    span.end = selection_end
    if span.end > line_end { span.end = line_end }
    span.continues_past_line = selection_start <= line_start &&
        selection_end > line_end
    if span.end < span.start { return span }
    if span.end == span.start && !span.continues_past_line {
        return span
    }
    span.visible = true
    return span
}

#program_export
TextSelectionPaintSpanForText :: (selection_start: s32,
    selection_end: s32, text_len: s32) -> TextSelectionPaintSpan {
    span: TextSelectionPaintSpan
    if text_len < 0 { text_len = 0 }
    if selection_start < 0 { selection_start = 0 }
    if selection_end < 0 { selection_end = 0 }
    if selection_start > text_len { selection_start = text_len }
    if selection_end > text_len { selection_end = text_len }
    if selection_end <= selection_start { return span }
    span.visible = true
    span.start = selection_start
    span.end = selection_end
    span.continues_past_line = false
    return span
}

TextSelectionRange :: struct {
    start: s32
    end: s32
    has_selection: bool
}

TextSelectionState :: struct {
    anchor: s32
    cursor: s32
    has_selection: bool
}

#program_export
TextSelectionOwnerMatches :: (has_owner: bool, same_owner: bool,
    selection_id: s32, requested_id: s32) -> bool {
    if has_owner && same_owner {
        return true
    }
    return requested_id > 0 && selection_id == requested_id
}

#program_export
TextContextMenuStateFor :: (has_selection: bool,
    copy_all_when_empty: bool, has_text: bool, read_only: bool,
    clipboard_has_text: bool) -> TextContextMenuState {
    state: TextContextMenuState
    can_copy_content: bool = has_selection ||
        (copy_all_when_empty && has_text)
    state.cut_enabled = can_copy_content && !read_only
    state.copy_enabled = can_copy_content
    state.paste_enabled = clipboard_has_text && !read_only
    state.select_all_enabled = has_text
    return state
}

#program_export
TextContextCommandCut :: () -> s32 {
    return 1
}

#program_export
TextContextCommandCopy :: () -> s32 {
    return 2
}

#program_export
TextContextCommandPaste :: () -> s32 {
    return 3
}

#program_export
TextContextCommandSelectAll :: () -> s32 {
    return 4
}

#program_export
TextEditCommandDecisionFor :: (command: s32, has_selection: bool,
    copy_all_when_empty: bool, clear_all_when_empty: bool, has_text: bool,
    allow_copy: bool, allow_delete: bool,
    allow_paste: bool) -> TextContextCommandDecision {
    decision: TextContextCommandDecision
    if command == TextContextCommandCut() {
        if has_selection {
            decision.copy_selection = allow_copy
            decision.delete_selection = allow_copy && allow_delete
        } else if copy_all_when_empty && has_text {
            decision.copy_all = allow_copy
            decision.clear_all = allow_copy && allow_delete && clear_all_when_empty
        }
        decision.collapse_selection = decision.copy_selection || decision.copy_all ||
            decision.delete_selection || decision.clear_all
        return decision
    }
    if command == TextContextCommandCopy() {
        if has_selection {
            decision.copy_selection = allow_copy
        } else if allow_copy && copy_all_when_empty && has_text {
            decision.copy_all = true
        }
        return decision
    }
    if command == TextContextCommandPaste() {
        if allow_paste {
            decision.delete_selection = allow_delete && has_selection
            decision.paste = true
            decision.collapse_selection = true
        }
        return decision
    }
    if command == TextContextCommandSelectAll() {
        decision.select_all = true
        return decision
    }
    return decision
}

#program_export
TextContextCommandDecisionFor :: (command: s32, has_selection: bool,
    copy_all_when_empty: bool, has_text: bool,
    read_only: bool) -> TextContextCommandDecision {
    return TextEditCommandDecisionFor(command, has_selection,
        copy_all_when_empty, copy_all_when_empty, has_text,
        true, !read_only, !read_only)
}

TextShortcutInput :: struct {
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
}

#program_export
TextShortcutInputFor :: (modifier: bool, select_all: bool, copy: bool,
    cut: bool, paste: bool) -> TextShortcutInput {
    input: TextShortcutInput
    input.select_all = modifier && select_all
    input.copy = modifier && copy
    input.cut = modifier && cut
    input.paste = modifier && paste
    return input
}

#program_export
TextShortcutShouldClaimSelectionFocus :: (has_selection: bool, focused: bool,
    keyboard_enabled: bool, modifier: bool, copy_pressed: bool,
    cut_pressed: bool, paste_pressed: bool) -> bool {
    return has_selection && !focused && keyboard_enabled && modifier &&
        (copy_pressed || cut_pressed || paste_pressed)
}

#program_export
TextDeleteShortcutShouldRun :: (read_only: bool, backspace_pressed: bool,
    delete_pressed: bool, queued_backspace_count: s32) -> bool {
    return !read_only && (backspace_pressed || delete_pressed ||
        queued_backspace_count > 0)
}

#program_export
TextSelectionReplacementShouldRun :: (read_only: bool, handled: bool,
    has_selection: bool, modifier: bool) -> bool {
    return !read_only && !handled && has_selection && !modifier
}

#program_export
TextNativeEditShouldRun :: (read_only: bool, handled: bool) -> bool {
    return !read_only && !handled
}

#program_export
TextCommitAfterHandledShouldRun :: (read_only: bool, handled: bool,
    enter_requested: bool) -> bool {
    return !read_only && handled && enter_requested
}

#program_export
TextNavigationShouldRun :: (handled: bool) -> bool {
    return !handled
}

#program_export
TextAreaEnterNewlineShouldRun :: (read_only: bool,
    enter_requested: bool) -> bool {
    return !read_only && enter_requested
}

#program_export
TextAreaChangedShouldCollapseSelection :: (changed: bool,
    handled: bool) -> bool {
    return changed && !handled
}

#program_export
TextFieldChangedShouldCollapseSelection :: (changed: bool, left_pressed: bool,
    right_pressed: bool, home_pressed: bool, end_pressed: bool) -> bool {
    return changed || left_pressed || right_pressed || home_pressed || end_pressed
}

#program_export
TextKeyboardShouldRun :: (focused: bool, keyboard_enabled: bool) -> bool {
    return focused && keyboard_enabled
}

#program_export
TextEscapeShouldBlur :: (focused: bool, keyboard_enabled: bool,
    escape_pressed: bool) -> bool {
    return focused && keyboard_enabled && escape_pressed
}

#program_export
TextOutsideClickShouldBlur :: (focused: bool, context_active: bool,
    scroll_gesture_pending: bool) -> bool {
    return focused && !context_active && !scroll_gesture_pending
}

#program_export
TextSelectionRangeShouldResolve :: (focused: bool, context_active: bool,
    has_selection: bool) -> bool {
    return (focused || context_active) && has_selection
}

#program_export
TextCompositionDisplayShouldRun :: (secure: bool) -> bool {
    return !secure
}

#program_export
TextEditCommitShouldRun :: (enter_pressed: bool,
    queued_enter_count: s32) -> bool {
    return enter_pressed || queued_enter_count > 0
}

#program_export
TextAreaScrollbarShouldShow :: (has_scroll_storage: bool,
    max_scroll: s32) -> bool {
    return has_scroll_storage && max_scroll > 0
}

#program_export
TextAreaWheelShouldScroll :: (mouse_inside: bool, captured: bool,
    modifier: bool) -> bool {
    return mouse_inside && !captured && !modifier
}

#program_export
TextAreaRevealCursorShouldRun :: (focused: bool, changed: bool,
    navigation_pressed: bool) -> bool {
    return focused && (changed || navigation_pressed)
}

#program_export
TextAreaRevealScroll :: (scroll: s32, cursor_y: s32, cursor_height: s32,
    viewport_height: s32) -> s32 {
    if cursor_y < scroll {
        return cursor_y
    }
    if cursor_y + cursor_height > scroll + viewport_height {
        return cursor_y + cursor_height - viewport_height
    }
    return scroll
}

#program_export
TextAreaScrollFor :: (scroll: s32, max_scroll: s32) -> s32 {
    if max_scroll < 0 {
        max_scroll = 0
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

#program_export
TextFieldRevealCursorShouldRun :: (focused: bool) -> bool {
    return focused
}

#program_export
TextFieldContextShouldRegister :: (secure: bool) -> bool {
    return !secure
}

#program_export
TextNavNone :: () -> s32 {
    return 0
}

#program_export
TextNavLeft :: () -> s32 {
    return 1
}

#program_export
TextNavRight :: () -> s32 {
    return 2
}

#program_export
TextNavHome :: () -> s32 {
    return 3
}

#program_export
TextNavEnd :: () -> s32 {
    return 4
}

#program_export
TextNavUp :: () -> s32 {
    return 5
}

#program_export
TextNavDown :: () -> s32 {
    return 6
}

#program_export
TextNavPageUp :: () -> s32 {
    return 7
}

#program_export
TextNavPageDown :: () -> s32 {
    return 8
}

#program_export
TextNavigationKeyFor :: (multiline: bool, left: bool, right: bool,
    home: bool, end: bool, up: bool, down: bool,
    page_up: bool, page_down: bool) -> s32 {
    if left { return TextNavLeft() }
    if right { return TextNavRight() }
    if home { return TextNavHome() }
    if end { return TextNavEnd() }
    if multiline && up { return TextNavUp() }
    if multiline && down { return TextNavDown() }
    if multiline && page_up { return TextNavPageUp() }
    if multiline && page_down { return TextNavPageDown() }
    return TextNavNone()
}

TextBackspaceRepeat :: struct {
    count: s32
    next_repeat_at: float64
}

#program_export
TextBackspaceRepeatFor :: (pressed: bool, down: bool, now: float64,
    next_repeat_at: float64) -> TextBackspaceRepeat {
    result: TextBackspaceRepeat
    if pressed {
        result.count = 1
        result.next_repeat_at = now + 0.34
        return result
    }
    if !down {
        result.next_repeat_at = 0.0
        return result
    }
    if next_repeat_at <= 0.0 {
        result.next_repeat_at = now + 0.34
        return result
    }
    count: s32 = 0
    cursor: float64 = next_repeat_at
    while now >= cursor && count < 8 {
        count += 1
        cursor += 0.045
    }
    result.count = count
    result.next_repeat_at = cursor
    return result
}

#program_export
TextDeleteNone :: () -> s32 {
    return 0
}

#program_export
TextDeleteBackspace :: () -> s32 {
    return 1
}

#program_export
TextDeleteForward :: () -> s32 {
    return 2
}

TextInputMetric :: (fields: u32, field: u32, value: s32,
    fallback: s32) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0 {
        return fallback
    }
    return value
}

TextInputScaledMetric :: (value: float32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: s32 = cast(s32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}

TextInputRoundScaledMetric :: (value: float32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: s32 = cast(s32)((cast(float32)(cast(s32)(value + 0.5))) * scale + 0.5)
    if metric < 0 { return 0 }
    return metric
}

TextInputRequestedFieldsFor :: (fields: u32, padding_x: s32,
    padding_y: s32, line_gap: s32) -> u32 {
    requested: u32 = fields
    if padding_x > 0 {
        requested = requested | cast(u32)StylePaddingX
    }
    if padding_y > 0 {
        requested = requested | cast(u32)StylePaddingY
    }
    if line_gap >= 0 {
        requested = requested | cast(u32)StyleGap
    }
    return requested
}

TextInputResolvedMetric :: (requested_fields: u32, field: u32,
    requested_value: s32, resolved_fields: u32, resolved_value: float32,
    scale: float32, unset_value: s32) -> s32 {
    if (requested_fields & field) != cast(u32)0 {
        if requested_value < 0 { return 0 }
        return requested_value
    }
    if (resolved_fields & field) != cast(u32)0 && resolved_value >= 0.0 {
        return TextInputRoundScaledMetric(resolved_value, scale)
    }
    return unset_value
}

#program_export
TextInputResolvedStyleFor :: (fields: u32, padding_x: s32, padding_y: s32,
    line_gap: s32, radius: float32, resolved_fields: u32,
    resolved_padding_x: float32, resolved_padding_y: float32,
    resolved_gap: float32, resolved_radius: float32,
    scale: float32) -> TextInputResolvedStyle {
    style: TextInputResolvedStyle
    requested_fields: u32 = TextInputRequestedFieldsFor(fields, padding_x,
        padding_y, line_gap)
    style.fields = requested_fields | resolved_fields
    style.padding_x = TextInputResolvedMetric(requested_fields,
        cast(u32)StylePaddingX, padding_x, resolved_fields, resolved_padding_x,
        scale, padding_x)
    style.padding_y = TextInputResolvedMetric(requested_fields,
        cast(u32)StylePaddingY, padding_y, resolved_fields, resolved_padding_y,
        scale, padding_y)
    style.line_gap = TextInputResolvedMetric(requested_fields,
        cast(u32)StyleGap, line_gap, resolved_fields, resolved_gap, scale, -1)
    style.radius = radius
    if (fields & cast(u32)StyleRadius) == cast(u32)0 || radius < 0.0 {
        style.radius = resolved_radius
    }
    return style
}

#program_export
TextInputDefaultPaddingX :: (scale: float32) -> s32 {
    return TextInputScaledMetric(10.0, scale)
}

#program_export
TextInputDefaultPaddingY :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextAreaMinWrapWidth :: (scale: float32) -> s32 {
    return TextInputScaledMetric(24.0, scale)
}

#program_export
TextAreaScrollbarWidthFor :: (scale: float32) -> s32 {
    return TextInputScaledMetric(12.0, scale)
}

#program_export
TextAreaMaxScrollFor :: (content_height: s32, bounds_height: float32,
    padding_y: s32) -> s32 {
    viewport_height: s32 = cast(s32)bounds_height - padding_y * 2
    max_scroll: s32 = content_height - viewport_height
    if max_scroll < 0 {
        return 0
    }
    return max_scroll
}

#program_export
TextAreaWheelScrollFor :: (scroll: s32, wheel: float32,
    line_height: s32) -> s32 {
    return scroll - cast(s32)(wheel * cast(float32)line_height * 3.0)
}

#program_export
TextAreaDragScrollFor :: (scroll: s32, mouse_y: s32, bounds_y: float32,
    bounds_height: float32, padding_y: s32, line_height: s32) -> s32 {
    next: s32 = scroll
    if mouse_y < cast(s32)bounds_y + padding_y {
        next -= line_height
    }
    if mouse_y > cast(s32)(bounds_y + bounds_height) - padding_y {
        next += line_height
    }
    if next < 0 {
        return 0
    }
    return next
}

#program_export
TextAreaGutterMetricsFor :: (scale: float32) -> TextAreaGutterMetrics {
    metrics: TextAreaGutterMetrics
    metrics.top_inset = TextInputScaledMetric(10.0, scale)
    metrics.active_y_inset = TextInputScaledMetric(2.0, scale)
    metrics.label_x_inset = TextInputScaledMetric(6.0, scale)
    metrics.label_font = TextInputScaledMetric(10.0, scale)
    metrics.extra_rows = 3
    return metrics
}

#program_export
TextAreaGutterRowsFor :: (bounds_height: float32, line_height: s32,
    metrics: TextAreaGutterMetrics) -> s32 {
    if line_height <= 0 { return 0 }
    rows: s32 = (cast(s32)bounds_height / line_height) + metrics.extra_rows
    if rows < 0 { return 0 }
    return rows
}

#program_export
TextAreaGutterFirstY :: (gutter_y: float32, scroll_y: s32, line_height: s32,
    metrics: TextAreaGutterMetrics) -> s32 {
    if line_height <= 0 { return cast(s32)gutter_y + metrics.top_inset }
    return cast(s32)gutter_y + metrics.top_inset - (scroll_y % line_height)
}

#program_export
TextAreaGutterInactiveAlpha :: (alpha: u8) -> u8 {
    return cast(u8)(cast(float32)alpha * 0.62)
}

#program_export
TextFieldRevealMargin :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextInputDoubleClickSlopFor :: (scale: float32) -> s32 {
    return TextInputScaledMetric(6.0, scale)
}

#program_export
TextInputDoubleClickMaxSeconds :: () -> float32 {
    return 0.45
}

#program_export
TextInputDoubleClickDecisionFor :: (same_owner: bool, same_id: bool,
    elapsed_seconds: float32, dx: s32, dy: s32,
    slop: s32) -> TextInputDoubleClickDecision {
    decision: TextInputDoubleClickDecision
    if slop < 0 { slop = 0 }
    if dx < 0 { dx = -dx }
    if dy < 0 { dy = -dy }
    decision.double_click = same_owner && same_id &&
        elapsed_seconds <= TextInputDoubleClickMaxSeconds() &&
        dx <= slop && dy <= slop
    return decision
}

#program_export
TextFieldPanDragThresholdFor :: (scale: float32) -> s32 {
    return TextInputScaledMetric(5.0, scale)
}

#program_export
TextFieldPanDecisionFor :: (already_panning: bool, dx: s32, dy: s32,
    threshold: s32) -> TextFieldPanDecision {
    decision: TextFieldPanDecision
    if threshold < 0 { threshold = 0 }
    abs_dx: s32 = dx
    abs_dy: s32 = dy
    if abs_dx < 0 { abs_dx = -abs_dx }
    if abs_dy < 0 { abs_dy = -abs_dy }
    decision.pan = already_panning ||
        (abs_dx > threshold && abs_dx >= abs_dy)
    return decision
}

#program_export
TextFieldMinCursorHeight :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextFieldCursorVerticalPadding :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextFieldClipGuard :: (scale: float32) -> s32 {
    clip_guard: s32 = TextInputScaledMetric(1.0, scale)
    if clip_guard < 1 { return 1 }
    return clip_guard
}

#program_export
TextInputStrokeWidth :: (scale: float32) -> s32 {
    width: s32 = TextInputScaledMetric(2.0, scale)
    if width < 1 { return 1 }
    return width
}

#program_export
TextInputMetricsFor :: (fields: u32, font: s32, padding_x: s32, padding_y: s32,
    line_gap: s32, default_font: s32, default_padding_x: s32,
    default_padding_y: s32, default_line_gap: s32) -> TextInputMetrics {
    metrics: TextInputMetrics
    metrics.font = font
    if metrics.font <= 0 {
        metrics.font = default_font
    }
    metrics.padding_x = TextInputMetric(fields, cast(u32)StylePaddingX,
        padding_x, default_padding_x)
    metrics.padding_y = TextInputMetric(fields, cast(u32)StylePaddingY,
        padding_y, default_padding_y)
    metrics.line_gap = TextInputMetric(fields, cast(u32)StyleGap,
        line_gap, default_line_gap)
    metrics.line_height = metrics.font + metrics.line_gap
    if metrics.line_height <= 0 {
        metrics.line_height = 1
    }
    return metrics
}

#program_export
TextInputContentWidth :: (bounds_width: float32, padding_x: s32) -> s32 {
    width: s32 = cast(s32)bounds_width - padding_x * 2
    if width < 0 {
        return 0
    }
    return width
}

#program_export
TextAreaPageRows :: (bounds_height: float32, font: s32, line_gap: s32,
    padding_y: s32) -> s32 {
    line_height: s32 = font + line_gap
    visible_height: s32 = cast(s32)bounds_height - padding_y * 2
    if line_height <= 0 || visible_height < line_height {
        return 1
    }
    rows: s32 = visible_height / line_height
    if rows < 1 {
        return 1
    }
    if rows < 2 {
        return 2
    }
    return rows
}

#program_export
TextAreaWrapWidthFor :: (bounds_width: float32, padding_x: s32,
    wrap: bool, min_wrap_width: s32) -> s32 {
    if !wrap { return 0 }
    width: s32 = cast(s32)bounds_width - padding_x * 2
    if width < min_wrap_width { return 0 }
    return width
}

#program_export
TextAreaPaintFor :: (bounds: Rectangle, font: s32, line_gap: s32,
    padding_x: s32, padding_y: s32, wrap: bool, content_height: s32,
    scroll_y: s32, text_line_height: s32, min_wrap_width: s32) -> TextAreaPaint {
    paint: TextAreaPaint
    line_height: s32 = font + line_gap
    paint.viewport_height = cast(s32)bounds.height - padding_y * 2
    if paint.viewport_height < 0 { paint.viewport_height = 0 }
    paint.max_scroll = TextAreaMaxScrollFor(content_height, bounds.height,
                                            padding_y)
    paint.scroll_y = TextAreaScrollFor(scroll_y, paint.max_scroll)
    paint.wrap_width = TextAreaWrapWidthFor(bounds.width, padding_x, wrap,
                                            min_wrap_width)
    paint.clip_bounds.x = bounds.x + cast(float32)padding_x
    paint.clip_bounds.y = bounds.y + cast(float32)padding_y
    paint.clip_bounds.width = bounds.width - cast(float32)(padding_x * 2)
    paint.clip_bounds.height = bounds.height - cast(float32)(padding_y * 2)
    if paint.clip_bounds.width < 0.0 { paint.clip_bounds.width = 0.0 }
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.placeholder_x = cast(s32)bounds.x + padding_x
    paint.placeholder_y = cast(s32)bounds.y + padding_y +
        (line_height - text_line_height) / 2
    return paint
}

#program_export
TextInputBufferLimit :: (text_size: s32, max_codepoints: s32) -> s32 {
    limit: s32 = text_size - 1
    if max_codepoints > 0 && max_codepoints < limit {
        limit = max_codepoints
    }
    if limit < 0 {
        return 0
    }
    return limit
}

#program_export
TextFieldScrollFor :: (bounds_x: float32, bounds_width: float32, padding_x: s32,
    text_width: s32, scroll: s32) -> TextFieldScroll {
    result: TextFieldScroll
    result.clip_width = TextInputContentWidth(bounds_width, padding_x)
    result.max_scroll = text_width - result.clip_width
    if result.max_scroll < 0 {
        result.max_scroll = 0
    }
    if scroll < 0 {
        result.scroll = 0
    } else if scroll > result.max_scroll {
        result.scroll = result.max_scroll
    } else {
        result.scroll = scroll
    }
    result.text_origin_x = cast(s32)bounds_x + padding_x - result.scroll
    return result
}

#program_export
TextFieldRevealScroll :: (scroll: s32, max_scroll: s32, clip_width: s32,
    cursor_text_x: s32, margin: s32) -> s32 {
    if margin < 0 {
        margin = 0
    }
    if cursor_text_x < scroll + margin {
        scroll = cursor_text_x - margin
    }
    if cursor_text_x > scroll + clip_width - margin {
        scroll = cursor_text_x - clip_width + margin
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

#program_export
TextFieldCursorHeightFor :: (font: s32, bounds_height: float32,
    text_line_height: s32, min_height: s32, vertical_padding: s32) -> s32 {
    height: s32 = text_line_height
    max_height: s32 = cast(s32)bounds_height - vertical_padding
    if height < font { height = font }
    if max_height < min_height { max_height = cast(s32)bounds_height }
    if height > max_height { height = max_height }
    if height < min_height { height = min_height }
    return height
}

#program_export
TextFieldPaintFor :: (bounds: Rectangle, padding_x: s32, scroll_x: s32,
    font: s32, text_line_height: s32, min_cursor_height: s32,
    cursor_vertical_padding: s32, clip_guard: s32) -> TextFieldPaint {
    paint: TextFieldPaint
    clip_width: s32 = TextInputContentWidth(bounds.width, padding_x)

    paint.clip_bounds.x = bounds.x + cast(float32)padding_x
    paint.clip_bounds.y = bounds.y - cast(float32)clip_guard
    paint.clip_bounds.width = cast(float32)clip_width
    paint.clip_bounds.height = bounds.height + cast(float32)(clip_guard * 2)
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.text_x = cast(s32)bounds.x + padding_x - scroll_x
    paint.cursor_height = TextFieldCursorHeightFor(
        font, bounds.height, text_line_height, min_cursor_height,
        cursor_vertical_padding)
    paint.cursor_y = cast(s32)bounds.y +
        (cast(s32)bounds.height - paint.cursor_height) / 2
    return paint
}

#program_export
TextSelectionRangeFor :: (anchor: s32, cursor: s32) -> TextSelectionRange {
    out: TextSelectionRange
    if anchor < cursor {
        out.start = anchor
        out.end = cursor
    } else {
        out.start = cursor
        out.end = anchor
    }
    out.has_selection = out.start != out.end
    return out
}

#program_export
TextSelectionRangeForLength :: (anchor: s32, cursor: s32,
    length: s32) -> TextSelectionRange {
    out: TextSelectionRange = TextSelectionRangeFor(anchor, cursor)
    if length < 0 { length = 0 }
    if out.start < 0 { out.start = 0 }
    if out.end < 0 { out.end = 0 }
    if out.start > length { out.start = length }
    if out.end > length { out.end = length }
    out.has_selection = out.start != out.end
    return out
}

#program_export
TextCursorForLength :: (cursor: s32, length: s32) -> s32 {
    if length < 0 { length = 0 }
    if cursor < 0 { return 0 }
    if cursor > length { return length }
    return cursor
}

#program_export
TextSelectionAfterMove :: (anchor: s32, cursor: s32, target: s32,
    extend: bool) -> TextSelectionState {
    out: TextSelectionState
    if extend {
        if anchor == cursor {
            out.anchor = cursor
        } else {
            out.anchor = anchor
        }
        out.cursor = target
    } else {
        out.anchor = target
        out.cursor = target
    }
    out.has_selection = out.anchor != out.cursor
    return out
}

#program_export
TextSelectionCollapsed :: (cursor: s32) -> TextSelectionState {
    out: TextSelectionState
    out.anchor = cursor
    out.cursor = cursor
    out.has_selection = false
    return out
}

#program_export
TextSelectionAll :: (length: s32) -> TextSelectionState {
    out: TextSelectionState
    if length < 0 {
        length = 0
    }
    out.anchor = 0
    out.cursor = length
    out.has_selection = length > 0
    return out
}

#program_export
TextBufferLineStartCursor :: (cursor: s32) -> s32 {
    if cursor < 0 { return 0 }
    return cursor
}

#program_export
TextBufferInsertDecisionFor :: (text_size: s32, used: s32, at: s32,
    insert_len: s32) -> TextBufferInsertDecision {
    decision: TextBufferInsertDecision
    if text_size <= 0 || used < 0 || at < 0 || at > used || insert_len <= 0 {
        return decision
    }
    if used + insert_len >= text_size {
        return decision
    }
    decision.can_insert = true
    decision.tail_count = used - at + 1
    return decision
}

#program_export
TextBufferDeleteDecisionFor :: (used: s32, at: s32,
    delete_len: s32) -> TextBufferDeleteDecision {
    decision: TextBufferDeleteDecision
    if used < 0 || at < 0 || delete_len <= 0 || at + delete_len > used {
        return decision
    }
    decision.can_delete = true
    decision.tail_count = used - at - delete_len + 1
    return decision
}

#program_export
TextBufferDeleteRangeDecisionFor :: (used: s32, start: s32,
    end: s32) -> TextBufferDeleteRangeDecision {
    decision: TextBufferDeleteRangeDecision
    if used < 0 {
        return decision
    }
    if start < 0 { start = 0 }
    if end < 0 { end = 0 }
    if start > used { start = used }
    if end > used { end = used }
    if end <= start {
        return decision
    }
    decision.can_delete = true
    decision.start = start
    decision.end = end
    decision.cursor = start
    decision.tail_count = used - end + 1
    return decision
}

#program_export
TextBufferCursorAfterInsert :: (cursor: s32, at: s32, insert_len: s32) -> s32 {
    if cursor >= at {
        return cursor + insert_len
    }
    return cursor
}

#program_export
TextBufferCursorAfterDelete :: (cursor: s32, at: s32,
    delete_len: s32) -> s32 {
    if cursor >= at + delete_len {
        return cursor - delete_len
    }
    if cursor > at {
        return at
    }
    return cursor
}

# The buffer has a trailing zero byte and length excludes it. Insert bytes
# must come from storage separate from the destination buffer.
#program_export
TextBufferInsertBytes :: (buffer: []u8, length: s32, at: s32,
    bytes: []u8) -> TextBufferEditResult {
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(at, length)
    decision: TextBufferInsertDecision = TextBufferInsertDecisionFor(
        (cast(s32)buffer.count), length, at, (cast(s32)bytes.count))
    if !decision.can_insert || length >= (cast(s32)buffer.count) ||
        buffer[length] != cast(u8)0 { return result }
    index: s32 = 0
    while index < (cast(s32)bytes.count) {
        if bytes[index] == cast(u8)0 { return result }
        index += 1
    }
    index = length
    while index >= at {
        buffer[index + (cast(s32)bytes.count)] = buffer[index]
        index -= 1
    }
    index = 0
    while index < (cast(s32)bytes.count) {
        buffer[at + index] = bytes[index]
        index += 1
    }
    result.length = length + (cast(s32)bytes.count)
    result.cursor = at + (cast(s32)bytes.count)
    result.changed = true
    return result
}

#program_export
TextBufferDeleteBytes :: (buffer: []u8, length: s32,
    at: s32, count: s32) -> TextBufferEditResult {
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(at, length)
    decision: TextBufferDeleteDecision = TextBufferDeleteDecisionFor(
        length, at, count)
    if !decision.can_delete || length >= (cast(s32)buffer.count) ||
        buffer[length] != cast(u8)0 { return result }
    index: s32 = at
    while index <= length - count {
        buffer[index] = buffer[index + count]
        index += 1
    }
    result.length = length - count
    result.cursor = at
    result.changed = true
    return result
}

#program_export
TextBufferDeleteRange :: (buffer: []u8, length: s32,
    start: s32, end: s32) -> TextBufferEditResult {
    decision: TextBufferDeleteRangeDecision =
        TextBufferDeleteRangeDecisionFor(length, start, end)
    if decision.can_delete {
        return TextBufferDeleteBytes(buffer, length,
            decision.start, decision.end - decision.start)
    }
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(start, length)
    return result
}

#program_export
TextUtf8Continuation :: (value: u8) -> bool {
    return (value & cast(u8)0xc0) == cast(u8)0x80
}

#program_export
TextPreviousCodepoint :: (buffer: []u8, length: s32,
    cursor: s32) -> s32 {
    if length < 0 { return 0 }
    if length > (cast(s32)buffer.count) { length = (cast(s32)buffer.count) }
    cursor = TextCursorForLength(cursor, length)
    if cursor == 0 { return 0 }
    cursor -= 1
    while cursor > 0 && TextUtf8Continuation(buffer[cursor]) {
        cursor -= 1
    }
    return cursor
}

#program_export
TextNextCodepoint :: (buffer: []u8, length: s32,
    cursor: s32) -> s32 {
    if length < 0 { return 0 }
    if length > (cast(s32)buffer.count) { length = (cast(s32)buffer.count) }
    cursor = TextCursorForLength(cursor, length)
    if cursor >= length { return length }
    cursor += 1
    while cursor < length && TextUtf8Continuation(buffer[cursor]) {
        cursor += 1
    }
    return cursor
}

#program_export
TextBufferBracketCursorFor :: (cursor: s32, length: s32) -> s32 {
    if length <= 0 { return -1 }
    if cursor < 0 { return 0 }
    if cursor >= length { return length - 1 }
    return cursor
}

#program_export
TextBufferBracketCandidatePos :: (cursor: s32,
    current_is_bracket: bool) -> s32 {
    if cursor > 0 && !current_is_bracket {
        return cursor - 1
    }
    return cursor
}

#program_export
TextBufferBracketDecisionFor :: (pos: s32,
    bracket_code: s32) -> TextBufferBracketDecision {
    decision: TextBufferBracketDecision
    decision.pos = pos
    if bracket_code == 40 {
        decision.valid = true
        decision.open = 40
        decision.close = 41
        decision.direction = 1
        return decision
    }
    if bracket_code == 91 {
        decision.valid = true
        decision.open = 91
        decision.close = 93
        decision.direction = 1
        return decision
    }
    if bracket_code == 123 {
        decision.valid = true
        decision.open = 123
        decision.close = 125
        decision.direction = 1
        return decision
    }
    if bracket_code == 41 {
        decision.valid = true
        decision.open = 40
        decision.close = 41
        decision.direction = -1
        return decision
    }
    if bracket_code == 93 {
        decision.valid = true
        decision.open = 91
        decision.close = 93
        decision.direction = -1
        return decision
    }
    if bracket_code == 125 {
        decision.valid = true
        decision.open = 123
        decision.close = 125
        decision.direction = -1
        return decision
    }
    return decision
}

#program_export
TextNavigationDecisionFor :: (key: s32, multiline: bool, shift: bool,
    modifier: bool, secure: bool, has_selection: bool) -> TextNavigationDecision {
    decision: TextNavigationDecision
    decision.extend_selection = shift

    if key == TextNavLeft() {
        decision.consumed = true
        if !shift && has_selection {
            decision.collapse_selection_start = true
        } else if modifier && secure {
            decision.document_edge = -1
        } else if modifier {
            decision.word_direction = -1
        } else {
            decision.char_direction = -1
        }
        return decision
    }

    if key == TextNavRight() {
        decision.consumed = true
        if !shift && has_selection {
            decision.collapse_selection_end = true
        } else if modifier && secure {
            decision.document_edge = 1
        } else if modifier {
            decision.word_direction = 1
        } else {
            decision.char_direction = 1
        }
        return decision
    }

    if key == TextNavHome() {
        decision.consumed = true
        if multiline && !modifier {
            decision.line_edge = -1
        } else {
            decision.document_edge = -1
        }
        return decision
    }

    if key == TextNavEnd() {
        decision.consumed = true
        if multiline && !modifier {
            decision.line_edge = 1
        } else {
            decision.document_edge = 1
        }
        return decision
    }

    if key == TextNavUp() && multiline {
        decision.consumed = true
        decision.vertical_direction = -1
        return decision
    }

    if key == TextNavDown() && multiline {
        decision.consumed = true
        decision.vertical_direction = 1
        return decision
    }

    if key == TextNavPageUp() && multiline {
        decision.consumed = true
        decision.page_direction = -1
        return decision
    }

    if key == TextNavPageDown() && multiline {
        decision.consumed = true
        decision.page_direction = 1
        return decision
    }

    return decision
}

#program_export
TextDeleteDecisionFor :: (action: s32, modifier: bool, secure: bool,
    has_selection: bool) -> TextDeleteDecision {
    decision: TextDeleteDecision

    if action == TextDeleteBackspace() {
        decision.consumed = true
        if has_selection {
            return decision
        }
        if modifier && secure {
            decision.document_edge = -1
        } else if modifier {
            decision.word_direction = -1
        } else {
            decision.char_direction = -1
        }
        return decision
    }

    if action == TextDeleteForward() {
        decision.consumed = true
        if has_selection {
            return decision
        }
        if modifier && secure {
            decision.document_edge = 1
        } else if modifier {
            decision.word_direction = 1
        } else {
            decision.char_direction = 1
        }
        return decision
    }

    return decision
}

#program_export
TextInsertDecisionFor :: (codepoint: s32, encoded_len: s32,
    text_len: s32, text_size: s32, current_codepoints: s32,
    inserted_codepoints: s32, max_codepoints: s32,
    allow_newlines: bool) -> TextInsertDecision {
    decision: TextInsertDecision

    if codepoint == 13 {
        decision.skip = true
        return decision
    }

    if codepoint == 10 && !allow_newlines {
        decision.skip = true
        return decision
    }

    if codepoint < 32 && codepoint != 10 {
        decision.skip = true
        return decision
    }

    if encoded_len <= 0 {
        decision.skip = true
        return decision
    }

    if text_size <= 0 || text_len + encoded_len + 1 > text_size {
        decision.stop = true
        return decision
    }

    if max_codepoints > 0 &&
       current_codepoints + inserted_codepoints >= max_codepoints {
        decision.stop = true
        return decision
    }

    decision.accept = true
    return decision
}

TextWordBlank :: (codepoint: s32) -> bool {
    return codepoint == 32 || codepoint == 9 || codepoint == 0x3000
}

TextWordSeparator :: (codepoint: s32) -> bool {
    return codepoint == 44 || codepoint == 0x3001 ||
        codepoint == 46 || codepoint == 0x3002 ||
        codepoint == 59 || codepoint == 0xff1b ||
        codepoint == 40 || codepoint == 0xff08 ||
        codepoint == 41 || codepoint == 0xff09 ||
        codepoint == 123 || codepoint == 0xff5b ||
        codepoint == 125 || codepoint == 0xff5d ||
        codepoint == 91 || codepoint == 0x300c ||
        codepoint == 93 || codepoint == 0x300d ||
        codepoint == 124 || codepoint == 0xff5c ||
        codepoint == 33 || codepoint == 0xff01 ||
        codepoint == 92 || codepoint == 0xffe5 ||
        codepoint == 47 || codepoint == 0x30fb || codepoint == 0xff0f ||
        codepoint == 10 || codepoint == 13
}

#program_export
TextWordBoundaryFor :: (previous: s32, current: s32) -> bool {
    previous_blank := TextWordBlank(previous)
    previous_separator := TextWordSeparator(previous)
    current_blank := TextWordBlank(current)
    current_separator := TextWordSeparator(current)
    return ((previous_blank || previous_separator) &&
        !(current_separator || current_blank)) ||
        (current_separator && !previous_separator)
}
