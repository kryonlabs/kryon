
AppShellLayoutSpec :: struct {
    view_width: s32
    view_height: s32
    safe_left: s32
    safe_top: s32
    safe_right: s32
    safe_bottom: s32
    padding: s32
    nav_height: s32
    sidebar_breakpoint: s32
    sidebar_width: s32
    min_content_width: s32
    max_content_width: s32
}

AppShellLayout :: struct {
    compact: bool
    sidebar_width: s32
    content_x: s32
    content_y: s32
    content_width: s32
    content_height: s32
    nav_x: s32
    nav_y: s32
    nav_width: s32
    nav_height: s32
}

#program_export
MeasureAppShell :: (spec: AppShellLayoutSpec) -> AppShellLayout {
    layout: AppShellLayout
    padding: s32 = ifx spec.padding >= 0 then spec.padding else 0
    nav_height: s32 = ifx spec.nav_height > 0 then spec.nav_height else 0
    breakpoint: s32 = ifx spec.sidebar_breakpoint > 0 then spec.sidebar_breakpoint else 480
    sidebar_width: s32 = ifx spec.sidebar_width > 0 then spec.sidebar_width else 0

    layout.compact = spec.view_width <= breakpoint
    layout.sidebar_width = ifx layout.compact then 0 else sidebar_width

    layout.nav_x = spec.safe_left
    layout.nav_y = spec.view_height - spec.safe_bottom - nav_height
    layout.nav_width = spec.view_width - spec.safe_left - spec.safe_right
    layout.nav_height = nav_height
    if layout.nav_y < spec.safe_top {
        layout.nav_y = spec.safe_top
    }
    if layout.nav_width < 0 {
        layout.nav_width = 0
    }

    layout.content_x = spec.safe_left + layout.sidebar_width + padding
    layout.content_y = spec.safe_top + padding
    available_width: s32 = spec.view_width - spec.safe_left - spec.safe_right -
                       layout.sidebar_width - padding * 2
    layout.content_width = available_width
    if spec.max_content_width > 0 &&
       layout.content_width > spec.max_content_width {
        layout.content_width = spec.max_content_width
    }
    if spec.min_content_width > 0 &&
       layout.content_width < spec.min_content_width {
        layout.content_width = spec.min_content_width
    }
    layout.content_height = layout.nav_y - layout.content_y - padding
    if layout.content_height < 0 {
        layout.content_height = 0
    }
    return layout
}
