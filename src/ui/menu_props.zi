#import "geometry"
#import "menu"

MenuItemKind :: enum {
    MenuCommand :: 0
    MenuCheck :: 1
    MenuRadio :: 2
    MenuSeparator :: 3
    MenuSubmenu :: 4
}

MenuItem :: struct {
    kind: MenuItemKind
    label: string
    accelerator: string
    id: s32
    disabled: bool
    checked: bool
    submenu: []MenuItem
}

MenuGroup :: struct {
    label: string
    items: []MenuItem
}

// The application retains navigation between frames, never the item slices.
MenuState :: struct {
    initialized: bool
    open_index: s32
    top_index: s32
    focused: bool
    depth: s32
    selected: [4]s32
    scroll: [4]s32
    reveal: bool
    pointer_valid: bool
    pointer_x: float32
    pointer_y: float32
}

MenuResult :: struct {
    activated_id: s32
    open_index: s32
    focused: bool
}

MenuProps :: struct {
    key: u64
    id: s32
    class_name: s32
    bounds: Rectangle
    scale: float32
    focus_requested: bool
    input: MenuKeyboardInput
}

#program_export
MenuStateInit :: (state: *MenuState) {
    if state == null { return }
    state.* = MenuState.{}
    state.initialized = true
    state.open_index = -1
    for depth: 0..3 { state.selected[depth] = -1 }
}
