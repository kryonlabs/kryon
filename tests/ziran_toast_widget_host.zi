#import "drawing_props"
#import "geometry"

fills: s32;
outlines: s32;
labels: s32;
failed: bool;

WithinToast :: (bounds: Rectangle) -> bool {
    return bounds.x >= 10.0 && bounds.y >= 20.0 &&
        bounds.x + bounds.width <= 210.0 &&
        bounds.y + bounds.height <= 120.0
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return (cast(s32)value.count) * 8
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 14
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused radius
    unused segments
    unused color
    if !WithinToast(bounds) { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused radius
    unused segments
    unused width
    unused color
    if !WithinToast(bounds) { failed = true }
    outlines += 1
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused color
    if font != 14 || x < 10 || y < 20 || !WithinToast(clip) {
        failed = true
    }
    if labels == 0 || labels == 1 {
        if value != "Hello" { failed = true }
    } else if labels == 2 {
        if value != "12345678901234" { failed = true }
    } else if labels == 3 {
        if value != "..." { failed = true }
    } else {
        if labels != 4 || value != "X" { failed = true }
    }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
ToastHostFailed :: () -> bool { return failed }

#program_export
ToastFills :: () -> s32 { return fills }

#program_export
ToastOutlines :: () -> s32 { return outlines }

#program_export
ToastLabels :: () -> s32 { return labels }
