#module "scroll_props"
#import "kryon_compat.generated.h"

ScrollProps :: struct {
    bounds: Rectangle
    content_height: i32
    offset: *i32
}

# Implemented by the C-only scroll host; declared here for the public ABI.
GetScrollbarReservedWidth :: (max_scroll: i32) -> i32 #extern #export
GetScrollbarContentWidth :: (content_width: i32, max_scroll: i32) -> i32 #extern #export
GetScrollbarSafeContentWidth :: (content_x: i32, content_width: i32,
                                 scrollbar_x: i32, max_scroll: i32) -> i32 #extern #export
