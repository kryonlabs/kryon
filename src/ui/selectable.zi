#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"

using StyleField;

SelectableSpec :: struct {
    bounds: Rectangle
    selected: bool
    hovered: bool
    pressed: bool
    disabled: bool
    face: StyleFrame
    label_inset: float32
}

SelectablePaint :: struct {
    bounds: Rectangle
    fill_color: u32
    text_color: u32
    label_x: float32
    draw_fill: bool
}

SelectableToggleResult :: struct {
    selected: bool
    changed: bool
}

#program_export
SelectableLabelInset :: (scale: float32, face: StyleFrame) -> float32 {
    if scale <= 0.0 { scale = 1.0 }
    inset: float32 = face.value.padding_x
    if (face.value.fields & cast(u32)StylePaddingX) == cast(u32)0 ||
       inset < 0.0 {
        inset = 8.0
    }
    return inset * scale
}

#program_export
SelectablePaintFor :: (spec: SelectableSpec) -> SelectablePaint {
    paint: SelectablePaint
    paint.bounds = spec.bounds
    paint.label_x = spec.bounds.x + spec.label_inset
    paint.text_color = spec.face.value.foreground
    paint.draw_fill = !spec.disabled && (spec.selected || spec.hovered || spec.pressed)
    paint.fill_color = spec.face.value.background
    return paint
}

#program_export
SelectableToggleFor :: (selected: bool, activated: bool) -> SelectableToggleResult {
    result: SelectableToggleResult
    result.selected = selected
    result.changed = false
    if activated {
        result.selected = !selected
        result.changed = true
    }
    return result
}
