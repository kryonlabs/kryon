#module "layout_host"
#import "ui_layout_props.generated.h"
#import "ui_core.h"
#import "ui_internal.h"
#import "runtime/layout.h"

ui_centered_min_hit_rect :: (x: i32, y: i32, w: i32,
h: i32, min_w: i32, min_h: i32) -> Rectangle #export {
    hit_w: i32 = w < min_w ? min_w : w
    hit_h: i32 = h < min_h ? min_h : h
    return (Rectangle){(float)(x + w / 2 - hit_w / 2),
        (float)(y + h / 2 - hit_h / 2),
        (float)hit_w, (float)hit_h}
}

GetDefaultCamera :: () -> Camera2D #export {
    camera: Camera2D = (Camera2D){0}
    camera.zoom = 1.0
    return camera
}

ui_float_isfinite :: (value: float) -> i32 {
    return value == value && value > -3.4e38 && value < 3.4e38
}

ui_sane_float :: (value: float, fallback: float) -> float {
    if ui_float_isfinite(value) { return value }
    return fallback
}

ui_sane_camera :: (camera: Camera2D) -> Camera2D #export {
    camera.offset.x = ui_sane_float(camera.offset.x, 0.0)
    camera.offset.y = ui_sane_float(camera.offset.y, 0.0)
    camera.target.x = ui_sane_float(camera.target.x, 0.0)
    camera.target.y = ui_sane_float(camera.target.y, 0.0)
    camera.rotation = ui_sane_float(camera.rotation, 0.0)
    if !ui_float_isfinite(camera.zoom) ||
    (camera.zoom > -0.0001 && camera.zoom < 0.0001) {
        camera.zoom = 1.0
    }
    return camera
}

ui_camera_ensure_sane :: () #export {
    g_ui_camera = ui_sane_camera(g_ui_camera)
}

SetViewSize :: (width: i32, height: i32) #export {
    ui_view_width = width
    ui_view_height = height
}

GetViewWidth :: () -> i32 #export {
    return ui_view_width
}

GetViewHeight :: () -> i32 #export {
    return ui_view_height
}

IsDesktopMode :: () -> i32 #export {
    return IsDesktopWidth(ui_view_width,
    (float)Scale(1000) / 1000.0)
}

GetCenteredColumn :: (max_w: i32, side_pad: i32,
x: *i32, w: *i32) #export {
    layout: CenteredColumnLayout = CenteredColumnFor(ui_view_width,
    max_w, side_pad)
    if x != nil { *x = layout.x }
    if w != nil { *w = layout.width }
}

GetPageSidePadding :: () -> i32 #export {
    return PageSidePaddingFor(ui_view_width)
}
