#module "icon_controls_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_style_pack_props.generated.h"
#import "runtime/dropdown.h"
#import "runtime/toolbar.h"

IconPopupStyle :: () -> Style {
    props: ButtonProps
    props.tone = ButtonToneNeutral
    props.emphasis = ButtonEmphasisFilled
    return ui_style_apply_effects(ui_resolve_button_style_kind(props,
    ButtonStateNormal, StyleKindDropdown()))
}

DrawIconPopupSurface :: (bounds: Rectangle) {
    paint: Style = IconPopupStyle()
    ui_draw_material(bounds, (Rectangle){0}, paint.background, paint.border,
    paint.border, paint.radius, paint.border_width, 1, 0, 0,
    paint.focus, 0, paint.opacity, ui_style_fill(paint), paint.material)
}

IconControlSpec :: (bounds: Rectangle, icon: Texture2D,
icon_size: i32, scale: float) -> ButtonSpec {
    spec: ButtonSpec
    spec.props.bounds = bounds
    spec.props.icon = icon
    spec.props.icon_only = true
    spec.props.tone = ButtonToneNeutral
    spec.props.emphasis = ButtonEmphasisSoft
    spec.style.normal.fields = StyleIconSize
    spec.style.normal.icon_size = ToolbarActionStyleIconSize(icon_size, scale)
    spec.style_resolved = 1
    return spec
}

RenderIconSliderPopup :: (popup: IconSliderPopupProps) -> i32 #export {
    if popup.open == nil || popup.value == nil { return 0 }

    scale: float = (float)Scale(1000) / 1000.0
    layout: IconSliderPopupLayout = IconSliderPopupLayoutFor(popup.x,
    popup.y, popup.icon_size, popup.icon_padding, popup.popup_width,
    popup.popup_height, scale)
    was_open: i32 = *popup.open
    icon_clicked: i32 = ui_button_render(IconControlSpec(
    layout.button_bounds, popup.icon, layout.icon_size, scale))
    if icon_clicked {
        opening: IconSliderPopupOpenResult = IconSliderPopupOpenFor(
        was_open != 0, true, false, true)
        *popup.open = opening.open
        if !opening.open { return 0 }
    }
    if !*popup.open { return 0 }

    mouse: Vector2 = ui_mouse_world()
    close_decision: IconSliderPopupCloseDecision =
    IconSliderPopupCloseDecisionFor(icon_clicked != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    CheckCollisionPointRec(mouse, layout.popup_bounds) != 0)
    if close_decision.close {
        closing: IconSliderPopupOpenResult = IconSliderPopupOpenFor(
        *popup.open != 0, false, true, true)
        *popup.open = closing.open
        return 0
    }

    DrawIconPopupSurface(layout.popup_bounds)
    return ui_render_vertical_slider_active(popup.id, layout.slider_x,
    layout.slider_y, layout.slider_height, popup.min, popup.max,
    popup.value)
}

RenderBottomIconRow :: (row: BottomIconRowProps) -> IconRowResult #export {
    result: IconRowResult
    result.clicked_index = -1
    if row.items == nil || row.count <= 0 { return result }

    bar_button: ButtonProps
    bar_button.tone = ButtonToneNeutral
    bar_button.emphasis = ButtonEmphasisSoft
    bar_button.size = ControlSizeMedium
    bar_frame: StyleFrame = ui_control_style_frame_role_kind(bar_button,
    ButtonStateNormal, 0, 0.0, 0.0, 0.0, StyleKindToolbar(),
    ToolbarBottomBarRole())

    action_button: ButtonProps = bar_button
    action_button.icon_only = true
    action_frame: StyleFrame = ui_control_style_frame_role_kind(action_button,
    ButtonStateNormal, 0, 0.0, 0.0, 0.0, StyleKindToolbar(),
    ToolbarBottomActionRole())

    scale: float = (float)Scale(1000) / 1000.0
    layout: BottomIconRowLayout = BottomIconRowLayoutForStyle(row, scale,
    bar_frame, action_frame)
    result.y = layout.y
    result.button_width = layout.button_width

    index: i32 = 0
    while index < row.count {
        if !row.items[index].disabled {
            bounds: Rectangle = BottomIconRowButtonBoundsFor(layout, index)
            spec: ButtonSpec = IconControlSpec(bounds, row.items[index].icon,
            layout.icon_size, scale)
            if ui_button_render(spec) { result.clicked_index = index }
        }
        index += 1
    }
    return result
}
