#module "page_props"
#import "kryon_compat.generated.h"
#import "kryon_key.h"

SemanticKind :: enum {
    SemanticNone = 0
    SemanticPage = 1
    SemanticSection = 2
    SemanticHeading = 3
    SemanticParagraph = 4
    SemanticLink = 5
    SemanticImage = 6
    SemanticButton = 7
}

PageProps :: struct {
    bounds: Rectangle
    title: const char*
    description: const char*
    canonical_url: const char*
    class_name: i32
    key: KeyID
}

SectionProps :: struct {
    bounds: Rectangle
    label: const char*
    class_name: i32
    key: KeyID
}

HeadingProps :: struct {
    bounds: Rectangle
    text: const char*
    level: i32
    class_name: i32
    key: KeyID
}

ParagraphTextProps :: struct {
    bounds: Rectangle
    text: const char*
    class_name: i32
    key: KeyID
}
