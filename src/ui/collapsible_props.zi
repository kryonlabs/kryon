#import "geometry"

CollapsibleProps :: struct {
    key: u64
    bounds: Rectangle
    class_name: s32
    label: string
    close_label: string
    open: bool
    has_open: bool
    tree: bool
    depth: s32
    leaf: bool
    selected: bool
    disabled: bool
    id: s32
    hidden: bool
    closable: bool
    scale: float32
    focused: bool
    focus_captured: bool
    key_already_handled: bool
    navigation: s32
    activate: bool
}

CollapsibleHeader :: struct {
    id: s32
    depth: s32
}

CollapsibleResult :: struct {
    node: s32
    open: bool
    hidden: bool
    changed: bool
    closed: bool
    focus_requested: bool
    focus_target: s32
    key_handled: bool
    header: Rectangle
    body: Rectangle
    close_bounds: Rectangle
    content: Rectangle
}
