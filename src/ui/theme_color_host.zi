#module "theme_color_host"
#import "theme.h"
#import "theme_meta.h"
#import "runtime/theme.h"
#import "stdio.h"
#import "string.h"

ThemeStateCurrentId :: () -> i32 #extern
ThemeStateContentAlpha :: () -> float #extern
SystemThemeColor :: (key: const char*, color: *Color) -> bool #extern

NormalizeThemeMode :: (mode: ThemeMode) -> ThemeMode #export {
    if mode < THEME_MODE_SYSTEM || mode > THEME_MODE_DARK {
        return THEME_MODE_SYSTEM
    }
    return mode
}

NormalizeThemeSource :: (source: ThemeSource) -> ThemeSource #export {
    if source == THEME_SOURCE_SYSTEM { return source }
    return THEME_SOURCE_APP
}

ThemeModeFor :: (theme: Theme) -> ThemeMode #export {
    if theme.mode == THEME_MODE_DARK { return THEME_MODE_DARK }
    return THEME_MODE_LIGHT
}

ThemeFamilySelection :: (family: ThemeFamily,
dark: bool) -> Theme #export {
    selected: Theme = family.light
    if dark { selected = family.dark }
    if dark { selected.mode = THEME_MODE_DARK }
    else { selected.mode = THEME_MODE_LIGHT }
    return selected
}

GetDefaultPlatformThemeSource :: () -> ThemeSource #export {
    return THEME_SOURCE_SYSTEM
}

GetDefaultPlatformThemeMode :: () -> ThemeMode #export {
    if GetDefaultPlatformThemeSource() == THEME_SOURCE_SYSTEM {
        return THEME_MODE_SYSTEM
    }
    return THEME_MODE_LIGHT
}

GetEffectiveThemeDarkMode :: () -> bool #export {
    mode: ThemeMode = GetThemeMode()
    if mode == THEME_MODE_LIGHT { return false }
    if mode == THEME_MODE_DARK { return true }
    return SystemThemePrefersDark()
}

GetThemeColor :: (scope_name: const char*, key: const char*) -> Color #export {
    catalog_color: Color = {0}
    if GetThemeCatalogScopeColor(scope_name, key, &catalog_color) {
        return catalog_color
    }

    shown_scope: const char* = "(null)"
    shown_key: const char* = "(null)"
    if scope_name != nil { shown_scope = scope_name }
    if key != nil { shown_key = key }
    fprintf(stderr, "warning: missing theme color: %s.%s, using fallback\n",
    shown_scope, shown_key)

    if key != nil {
        if strstr(key, "background") != nil ||
        strstr(key, "paper") != nil {
            return (Color){0xE2, 0xEE, 0xFC, 0xFF}
        }
        if strstr(key, "surface") != nil || strstr(key, "modal") != nil ||
        strstr(key, "panel") != nil {
            return (Color){0xD4, 0xE4, 0xF5, 0xFF}
        }
        if strstr(key, "text") != nil || strstr(key, "foreground") != nil ||
        strstr(key, "ink") != nil {
            return (Color){0x24, 0x48, 0x7C, 0xFF}
        }
        if strstr(key, "circle") != nil || strstr(key, "selection") != nil {
            return (Color){0x7E, 0xB7, 0xE6, 0xFF}
        }
        if strstr(key, "button_hover") != nil ||
        strstr(key, "face_hover") != nil {
            return (Color){0x68, 0x9E, 0xD7, 0xFF}
        }
        if strstr(key, "button") != nil || strstr(key, "face") != nil {
            return (Color){0xA6, 0xCF, 0xF2, 0xFF}
        }
        if strstr(key, "icon") != nil {
            return (Color){0xE2, 0xEE, 0xFC, 0xFF}
        }
        if strstr(key, "link") != nil {
            return (Color){0x4A, 0x90, 0xE2, 0xFF}
        }
    }
    return (Color){0xE2, 0xEE, 0xFC, 0xFF}
}

ThemeColorForKey :: (colors: ThemeColors,
key: const char*) -> Color #export {
    if key == nil { return BLANK }
    if strcmp(key, "background") == 0 { return colors.background }
    if strcmp(key, "surface") == 0 { return colors.surface }
    if strcmp(key, "text") == 0 { return colors.text }
    if strcmp(key, "circle") == 0 { return colors.accent }
    if strcmp(key, "button") == 0 { return colors.accent }
    if strcmp(key, "button_hover") == 0 { return colors.accent_hover }
    if strcmp(key, "icon") == 0 { return colors.icon }
    if strcmp(key, "link") == 0 { return colors.link }
    if strcmp(key, "border") == 0 { return colors.border }
    if strcmp(key, "text_muted") == 0 { return colors.text_muted }
    if strcmp(key, "selection") == 0 { return colors.selection }
    if strcmp(key, "on_accent") == 0 { return colors.on_accent }
    return BLANK
}

GetCurrentThemeColor :: (key: const char*) -> Color #export {
    color: Color = BLANK
    resolved: const Theme* = GetThemeRef()
    if resolved != nil {
        color = ThemeColorForKey(resolved->colors, key)
    } else {
        dark: bool = GetEffectiveThemeDarkMode()
        found: bool = false
        if GetThemeSource() == THEME_SOURCE_SYSTEM {
            SetSystemThemeDarkMode(dark)
            found = SystemThemeColor(key, &color)
        }
        if !found {
            GetThemeCatalogColor(NormalizeTheme(ThemeStateCurrentId()),
            dark, key, &color)
        }
    }
    color.a = (unsigned char)((float)color.a *
    ThemeStateContentAlpha() + 0.5)
    return color
}

ThemeDefaultFor :: (dark: bool) -> Theme {
    theme: Theme = {0}
    palette: Palette = DefaultPalette(dark)
    if dark {
        theme.name = "Default dark"
        theme.mode = THEME_MODE_DARK
    } else {
        theme.name = "Default light"
        theme.mode = THEME_MODE_LIGHT
    }
    theme.metrics = GetDefaultThemeMetrics()
    theme.colors.background = GetColor(palette.background)
    theme.colors.surface = GetColor(palette.surface)
    theme.colors.surface_raised = GetColor(palette.surface_raised)
    theme.colors.surface_sunken = GetColor(palette.surface_sunken)
    theme.colors.overlay = GetColor(palette.overlay)
    theme.colors.text = GetColor(palette.text)
    theme.colors.text_muted = GetColor(palette.text_muted)
    theme.colors.text_disabled = GetColor(palette.text_disabled)
    theme.colors.icon = GetColor(palette.icon)
    theme.colors.icon_muted = GetColor(palette.icon_muted)
    theme.colors.border = GetColor(palette.border)
    theme.colors.border_strong = GetColor(palette.border_strong)
    theme.colors.divider = GetColor(palette.divider)
    theme.colors.focus = GetColor(palette.focus)
    theme.colors.selection = GetColor(palette.selection)
    theme.colors.accent = GetColor(palette.accent)
    theme.colors.on_accent = GetColor(palette.on_accent)
    theme.colors.accent_hover = GetColor(palette.accent_hover)
    theme.colors.accent_pressed = GetColor(palette.accent_pressed)
    theme.colors.success = GetColor(palette.success)
    theme.colors.on_success = GetColor(palette.on_success)
    theme.colors.warning = GetColor(palette.warning)
    theme.colors.on_warning = GetColor(palette.on_warning)
    theme.colors.danger = GetColor(palette.danger)
    theme.colors.on_danger = GetColor(palette.on_danger)
    theme.colors.info = GetColor(palette.info)
    theme.colors.on_info = GetColor(palette.on_info)
    theme.colors.link = GetColor(palette.link)
    theme.colors.link_hover = GetColor(palette.link_hover)
    theme.colors.shadow = GetColor(palette.shadow)
    return theme
}

ThemeDefaultLight :: () -> Theme #export {
    return ThemeDefaultFor(false)
}

ThemeDefaultDark :: () -> Theme #export {
    return ThemeDefaultFor(true)
}

DefaultThemeFamily :: () -> ThemeFamily #export {
    family: ThemeFamily = {0}
    family.name = "Default"
    family.light = ThemeDefaultLight()
    family.dark = ThemeDefaultDark()
    return family
}

ThemeColorLuminance :: (color: Color) -> i32 {
    return ((i32)color.r * 299 + (i32)color.g * 587 +
    (i32)color.b * 114) / 1000
}

ThemeMixChannel :: (from: u8, to: u8, amount: float) -> u8 {
    if amount < 0.0 { amount = 0.0 }
    if amount > 1.0 { amount = 1.0 }
    value: float = (float)from + ((float)to - (float)from) * amount
    if value < 0.0 { value = 0.0 }
    if value > 255.0 { value = 255.0 }
    return (u8)(value + 0.5)
}

MixThemeColor :: (from: Color, to: Color, amount: float) -> Color #export {
    return (Color){
        ThemeMixChannel(from.r, to.r, amount),
        ThemeMixChannel(from.g, to.g, amount),
        ThemeMixChannel(from.b, to.b, amount),
        ThemeMixChannel(from.a, to.a, amount)
    }
}

GetThemeColorLuminance :: (color: Color) -> i32 #export {
    return ThemeColorLuminance(color)
}

IsThemeColorDark :: (color: Color) -> bool #export {
    return ThemeColorLuminance(color) < 128
}

GetThemeReadableText :: (background: Color) -> Color #export {
    if IsThemeColorDark(background) { return RAYWHITE }
    return BLACK
}

ThemeReadableSemanticColor :: (key: const char*,
surface_key: const char*) -> Color {
    color: Color = GetCurrentThemeColor(key)
    surface: Color = GetCurrentThemeColor(surface_key)
    delta: i32 = ThemeColorLuminance(color) - ThemeColorLuminance(surface)
    if delta < 0 { delta = -delta }
    if delta < 72 {
        result: Color = GetCurrentThemeColor("text")
        if color.a != 0 { result.a = color.a }
        else { result.a = 255 }
        return result
    }
    return color
}

GetThemeText :: () -> Color #export {
    return GetCurrentThemeColor("text")
}

GetThemeBackground :: () -> Color #export {
    return GetCurrentThemeColor("background")
}

GetThemeSurface :: () -> Color #export {
    return GetCurrentThemeColor("surface")
}

GetThemeCircle :: () -> Color #export {
    return GetCurrentThemeColor("circle")
}

GetThemeButton :: () -> Color #export {
    return GetCurrentThemeColor("button")
}

GetThemeButtonHover :: () -> Color #export {
    return GetCurrentThemeColor("button_hover")
}

GetThemeIcon :: () -> Color #export {
    if GetThemeRef() != nil { return GetCurrentThemeColor("icon") }
    return ThemeReadableSemanticColor("icon", "surface")
}

GetThemeLink :: () -> Color #export {
    return GetCurrentThemeColor("link")
}

GetThemeSurfaceAlt :: () -> Color #export {
    amount: float = 0.42
    if IsThemeColorDark(GetThemeBackground()) { amount = 0.20 }
    return MixThemeColor(GetThemeSurface(), GetThemeBackground(), amount)
}

GetThemeBorder :: () -> Color #export {
    if GetThemeRef() != nil { return GetCurrentThemeColor("border") }
    amount: float = 0.80
    if IsThemeColorDark(GetThemeBackground()) { amount = 0.70 }
    return MixThemeColor(GetThemeText(), GetThemeSurface(), amount)
}

GetThemeMutedText :: () -> Color #export {
    if GetThemeRef() != nil { return GetCurrentThemeColor("text_muted") }
    amount: float = 0.48
    if IsThemeColorDark(GetThemeBackground()) { amount = 0.36 }
    return MixThemeColor(GetThemeText(), GetThemeSurface(), amount)
}

GetThemeSelection :: () -> Color #export {
    if GetThemeRef() != nil { return GetCurrentThemeColor("selection") }
    amount: float = 0.16
    if IsThemeColorDark(GetThemeBackground()) { amount = 0.26 }
    return MixThemeColor(GetThemeSurface(), GetThemeButton(), amount)
}

GetThemeButtonText :: () -> Color #export {
    if GetThemeRef() != nil { return GetCurrentThemeColor("on_accent") }
    return GetThemeReadableText(GetThemeButton())
}
