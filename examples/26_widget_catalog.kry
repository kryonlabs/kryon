        }

        }

        if category == 5 {
            if Button((ButtonProps){.bounds = {x,y + ScaleUIPx(430),ScaleUIPx(180),ScaleUIPx(36)},.label = "PickerDialog",.id = 960}) { dialog = 5 }
            if Button((ButtonProps){.bounds = {x + ScaleUIPx(200),y + ScaleUIPx(430),ScaleUIPx(180),ScaleUIPx(36)},.label = "ModalFrame",.id = 961}) { dialog = 6 }
            if Button((ButtonProps){.bounds = {right,y + ScaleUIPx(430),ScaleUIPx(180),ScaleUIPx(36)},.label = "TextPopover",.id = 962}) { dialog = 7; text_focused = 0 }
            Text((TextProps){.bounds={x, y + ScaleUIPx(486), 0, 0}, .text=TextFormat("Picker: %d / Dialog result: %d", picker_choice, dialog_result), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        }
        if category == 6 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="CANVAS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        canvas_bounds: Rectangle = {x,y + ScaleUIPx(38),ScaleUIPx(360),ScaleUIPx(120)}
        mouse: Vector2 = GetMousePosition()
        if CheckCollisionPointRec(mouse, canvas_bounds) && !UIInputCapturesClick(mouse) {
            wheel: float = GetMouseWheelMove()
            if wheel != 0 {
                canvas_zoom = Clamp(canvas_zoom + wheel * 0.1f, 0.25f, 4.0f)
            }
            if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
                canvas_dragging = 1
                canvas_last = mouse
            }
        }
        if canvas_dragging {
            canvas_scroll_x -= (int)((mouse.x - canvas_last.x) / canvas_zoom)
            canvas_scroll_y -= (int)((mouse.y - canvas_last.y) / canvas_zoom)
            canvas_last = mouse
            if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) { canvas_dragging = 0 }
        }
        canvas_result: CanvasResult = BeginCanvas((Canvas){{x, y + ScaleUIPx(38), ScaleUIPx(360), ScaleUIPx(120)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
        CanvasGrid((Rectangle){x, y + ScaleUIPx(38), ScaleUIPx(360), ScaleUIPx(120)}, 12, GetThemeIcon())
        DrawCircle(x + ScaleUIPx(180), y + ScaleUIPx(98), ScaleUIPx(16), GetThemeLink())
        unused canvas_result
        EndCanvas((Canvas){{x, y + ScaleUIPx(38), ScaleUIPx(360), ScaleUIPx(120)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
        Text((TextProps){.bounds={right, y + ScaleUIPx(56), 0, 0}, .text="Wheel to zoom; drag the canvas to pan.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})

        }

        if category == 6 {
            Text((TextProps){.bounds={x, y + ScaleUIPx(190), 0, 0}, .text=TextFormat("Pan: %d, %d / Zoom: %.2f", canvas_scroll_x,canvas_scroll_y,canvas_zoom), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds = {right,y + ScaleUIPx(100),ScaleUIPx(140),ScaleUIPx(34)},.label = "Reset canvas",.id = 963}) {
                canvas_scroll_x = 0
                canvas_scroll_y = 0
                canvas_zoom = 1.0f
            }
        }
        if category == 7 {
