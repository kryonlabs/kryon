#module "transition_fade"
#import "transition_props"

TransitionClampProgress :: (value: float) -> float #export {
    if value < 0.0 { return 0.0 }
    if value > 1.0 { return 1.0 }
    return value
}

TransitionSmoothProgress :: (value: float) -> float #export {
    value = TransitionClampProgress(value)
    return value * value * (3.0 - 2.0 * value)
}

TransitionDuration :: (duration_seconds: float) -> float #export {
    if duration_seconds <= 0.0 { return 0.001 }
    return duration_seconds
}

TransitionDelta :: (delta_seconds: float) -> float #export {
    if delta_seconds < 0.0 { return 0.0 }
    return delta_seconds
}

TransitionReverseElapsed :: (duration_seconds: float,
    elapsed_seconds: float) -> float #export {
    elapsed: float = duration_seconds - elapsed_seconds
    if elapsed < 0.0 { return 0.0 }
    return elapsed
}

TransitionAlpha :: (active: bool, phase: i32, elapsed_seconds: float,
    duration_seconds: float) -> float #export {
    if !active || duration_seconds <= 0.0 { return 0.0 }
    progress: float = TransitionSmoothProgress(elapsed_seconds / duration_seconds)
    if phase == TransitionOut { return progress }
    if phase == TransitionIn { return 1.0 - progress }
    return 0.0
}

TransitionFadeAlphaByte :: (active: bool, phase: i32, elapsed_seconds: float,
    duration_seconds: float) -> i32 #export {
    alpha: i32 = (i32)(TransitionAlpha(active, phase, elapsed_seconds,
        duration_seconds) * 255.0)
    if alpha < 0 { return 0 }
    if alpha > 255 { return 255 }
    return alpha
}

TransitionApplyAlpha :: (color_alpha: i32, fade_alpha: i32) -> i32 #export {
    if fade_alpha < 0 { fade_alpha = 0 }
    if fade_alpha > 255 { fade_alpha = 255 }
    if color_alpha < 0 { color_alpha = 0 }
    if color_alpha > 255 { color_alpha = 255 }
    return (color_alpha * fade_alpha) / 255
}
