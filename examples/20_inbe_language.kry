#import "kryon.h"

# Inner Breeze language screen, in LOGICAL UI units (the engine applies
# the physical UI scale, 1.125 on the reference machine). Values derive
# from the native screen source: title centered, y=ScaleUIPx(28), label
# y=ScaleUIPx(252), dropdown at ScaleUIPx(39/266/348/43), Next at
# ScaleUIPx(197/337).

state {
    language_index: int = 0
}

app "Inner Breeze — Language" {
    size 480 640
    fps 60
    frame main
}

frame main {
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(GetScreenWidth(), GetScreenHeight(), GetUIScale())
    Background(GetThemeBackground())
    Text("Language", ScaleUIPx(142), ScaleUIPx(28), UI_TEXT_24, GetThemeText())
    Text("Choose your language", ScaleUIPx(41), ScaleUIPx(252), UI_TEXT_16, GetThemeText())
    Dropdown(260, ScaleUIPx(39), ScaleUIPx(266), ScaleUIPx(348), ScaleUIPx(43), "English;Portugues;Espanol;Deutsch;Francais", &language_index)
    Text("Next", ScaleUIPx(197), ScaleUIPx(337), UI_TEXT_16, GetThemeText())
    EndUIFocus()
    EndDrawing()
}
