// Retained, windowless GPU Scene renderer. All entry points belong to one
// owning thread. Scene/program/sampler storage is borrowed only during Render.
#import "scene"
#import "scene_render"
#import "shader"
#import, file "../ui/shader_glsl.zi";
#import "std/image"
#import "std/vec"
#import "std/format"
#import "std/math"
#import "drawing_props"
#if OS != .WEB || #defined(KRYON_WEBGL2) {
    G :: #import "scene_gpu_gl";
    #if OS == .ANDROID {
        Android :: #import "android_jni";
    }
    #if OS == .WEB {
        Surface :: #import "scene_gpu_web_context";
        Page :: #import "page_texture";
        Core :: #import "page_core";
        Presenter :: #import "page_gpu";
    }
}
M :: #import "scene_gpu_math";
#import "scene_gpu_sources"
#import "scene_gpu_dfg"
#if OS == .ANDROID && #defined(__arm__) {
 AndroidText :: #import "std/byte_text_linux";
}

SceneGpuCapabilities :: struct {
 available: bool
 async_available: bool; async_diagnostic: string
 // Whether shadow filtering can use a hardware bilinear depth comparison.
 pcf_available: bool
 diagnostic: string
 samples: s32
 max_texture_size: s32
 texture_units: s32
 max_samples: s32; highp_bits: s32; highp_range: s32
 // Texture units the vertex shaders can read; GPU skinning needs unit 15.
 // Some drivers report none although their vertex stage samples textures:
 // a linked probe program that reads a texture in the vertex shader decides.
 vertex_texture_units: s32; vertex_texture_fetch: bool
 // GL_MAX_VERTEX_UNIFORM_VECTORS: the palette size a uniform array allows.
 vertex_uniform_vectors: s32
 vendor: [256]u8
 renderer: [256]u8
 version: [256]u8
}
SceneGpuFrame :: struct {
 ok: bool; accelerated: bool; diagnostic: string
 // Owner wall time: submission includes synchronization before readback;
 // readback includes the final GPU wait; conversion includes GPU conversion
 // submission and the final CPU copy (or async CPU flip/unpremultiplication).
 submit_ms: float64; readback_ms: float64; conversion_ms: float64
 prepare_ms: float64; shadow_ms: float64; draw_ms: float64
 draw_calls: s32; shadow_passes: s64
 // GPU execution of the previous frame between two timestamp queries, or
 // -1 while the backend reports none.
 gpu_ms: float64
 profile: SceneGpuProfile
}
SceneGpuProfile :: struct {
 shader_setup_ms: float64; texture_upload_ms: float64
 gpu_completion_ms: float64; pixel_transfer_ms: float64; image_copy_ms: float64
 geometry_compare_ms: float64; geometry_upload_ms: float64; geometry_snapshot_ms: float64
 direct_resolve: bool
}
SceneGpuResources :: struct {
 gpu_bytes: s64; cpu_bytes: s64
 buffers: s32; textures: s32; programs: s32; framebuffers: s32; renderbuffers: s32
 geometry_uploads: s64; texture_uploads: s64; frames: s64; shadow_renders: s64
 // Vertices sent to the GPU so far. A node that only moves sends its own.
 geometry_vertices: s64
 fences: s32; pending_frames: s32; submitted_frames: s64; cancelled_frames: s64
 // Poses sent to a skin palette texture.
 skin_uploads: s64
}
// ok means a valid nonblocking operation; queued/completed distinguish progress.
// IDs must be positive and increase until Release. A busy submit accepts nothing.
SceneGpuAsyncResult :: struct {
 ok: bool; queued: bool; busy: bool; completed: bool; diagnostic: string
 request_id: u64; camera: SceneCamera; width: s32; height: s32
 frame: SceneGpuFrame; latency_ms: float64
}
GpuTransfer :: struct {
 buffer: u32; bytes: s64; fence: *void
 framebuffer: u32; texture: u32
 request_id: u64; camera: SceneCamera; width: s32; height: s32
 opaque: bool; straight: bool; frame: SceneGpuFrame; submitted_at: float64; fence_at: float64
}
GpuVertex :: struct { p: [3]float32; n: [3]float32; c: [3]float32; uv: [2]float32; face: [3]float32 }
// skin is the scene.skins entry that poses these vertices on the GPU, -1 for none.
GpuDraw :: struct { first: s32; count: s32; mesh: s32; node: s32; receive: bool; cast_shadow: bool; shown: bool; origin: Vector3; skin: s32 }
// An indexed draw's first/count address the element stream. The other draws
// still address the interleaved vertices with per-face normals.
GpuIndexedGeometry :: struct {
 attributes: u32; elements: u32; bound: bool
 vertex_count: s64
 indices: Vec(u32); scratch: Vec(float32)
 // One skin record per indexed vertex, in the stream's own order.
 skin: Vec(SkinAttribute); skin_attributes: u32
}
GpuLocations :: struct {
 vp: s32; view: s32; base: s32; glow: s32; material: s32; flags: s32; settings: s32; transparent: s32
 albedo_size: s32; albedo_sampling: s32; albedo: s32; dfg: s32; sky: s32; ground: s32; up: s32; light_count: s32; uniforms: s32
 shadow: [4]s32; shadow_settings: [4]s32; light_color: [4]s32; light_direction: [4]s32; shadow_matrix: [4]s32
 cookie: s32; cookie_matrix: s32; cookie_transform: s32; cookie_size: s32; cookie_light: s32
 sampler: [8]s32; sampler_size: [8]s32; sampler_repeat: [8]s32
 graded: s32; grade_tint: s32; grade_lamp: [4]s32; grade_lamp_color: [4]s32; grade_beam_centre: s32; grade_beam_u: s32
 grade_beam_v: s32; grade_beam_normal: s32; grade_beam_direction: s32; grade_beam_color: s32; grade_beam_shadow: s32
 model: s32; skin_mode: s32; bones: s32; bone_stride: s32; bones_texture: s32; bones_in_texture: s32
}
GPU_RECENT_PROGRAMS :: 8
GpuProgram :: struct { features: s32; key: *ShaderProgram; saved: ShaderProgram; id: u32; last_frame: u64; frame_uniforms_set: bool; locations: GpuLocations }
GpuTexture :: struct { key: *u8; cache_key: u64; width: s32; height: s32; id: u32; used: bool; bytes: Vec(u8) }
GpuShadow :: struct { texture: u32; framebuffer: u32; size: s32; source: SceneLight }
// One scene skin palette on the GPU: bones*rows packed vec4 rows in a uniform
// array, or a texture six RGBA float texels wide with one row per joint where
// the joint count exceeds the array. Primitives of one glTF skin carry
// identical joints: alias names the first palette with the same pose, so each
// program receives the pose once per frame.
GpuSkin :: struct {
 texture: u32; bones: s32; version: u64; active: bool; dual: bool; uploaded: bool
 rows: s32; alias: s32; uniform: Vec(float32)
}
GpuBindingCheck :: struct {program: *ShaderProgram; uniforms: *ShaderValue; uniform_count: s64; samplers: *ShaderSampler; sampler_count: s64}
// One rung of the window ladder: the internal size as a percent of the window
// and its coverage samples, with the GPU time of the rung relative to the full
// one. The rungs run from the best the GPU may hold to the smallest.
ScaleStep :: struct {percent: s32; samples: s32; cost: float64}
SCALE_STEPS :: 6
SceneGpuContext :: struct {
 capabilities: SceneGpuCapabilities
 display: *void; context: *void; attempted: bool
 // A window host may lend the renderer its context and window surface;
 // the renderer then presents into the window's default framebuffer.
 window_surface: *void; adopted: bool
 timer_start: u32; timer_end: u32; timer_pending: bool; last_gpu_ms: float64
 // 0 no timestamp entry points, 1 a frame is pending, 2 a frame was measured.
 timer_state: s32
 timer_wait: s32
 finish_at: float64
 // Window frames render into a target of scale_percent of the window with
 // scale_samples coverage when the GPU cannot hold the refresh period at the
 // full one; the present scales the resolve. A positive scale_fixed holds that
 // percent and scale_fixed_samples, 0 adapts both.
 scale_fixed: s32; scale_fixed_samples: s32; scale_percent: s32; scale_samples: s32; scale_level: s32
 scale_warm: s32; scale_probe: s32; scale_count: s32; scale_fail: [SCALE_STEPS]s32
 scale_idle: s32; scale_late: s32; scale_hold: s32; scale_sum: float64; scale_cpu_sum: float64; last_frame_at: float64; scale_start: float64
 // GPU time is measured while the owner asks for it or a scale step probes.
 measure_gpu: bool; gpu_time: bool
 #if OS == .WEB {
  canvas: s32; canvas_texture: s32
 }
 width: s32; height: s32
 framebuffer: u32; color: u32; depth: u32; resolve: u32; resolved: u32
 samples: s32
 straight_framebuffer: u32; straight_texture: u32; straight_program: u32
 buffer: u32; shadow_program: u32; dfg: u32
 #if OS == .ANDROID {
  program_cache: G.ProgramCache
  scene_vertex_shader: u32
 }
 vertices: Vec(GpuVertex); draws: Vec(GpuDraw)
 indexed: GpuIndexedGeometry
 skins: Vec(GpuSkin); skin_bound: bool
 // The palette the vertex shaders read: a texture, or this many vec4 rows of
 // a uniform array where the vertex stage cannot fetch textures (0 = texture).
 skin_uniform_vectors: s32
 // The vertex source every material program shares, composed once per probe.
 vertex_source: string
 // The uniform palette already sent to a program; the same pose on the same
 // program is not sent again.
 skin_uniform_program: u32; skin_uniform_index: s32; skin_uniform_version: u64
 // Each node's starting vertex in its stream and the transform used to bake it.
 node_first: Vec(s32); node_count: Vec(s32); node_world: Vec(M.GpuMatrix); node_shown: Vec(bool)
 // Each node's posing palette (scene.skins index), -1 for none.
 node_skin: Vec(s32)
 snapshot: Vec(u8); readback: Vec(u8); order: Vec(s32); keys: Vec(float64)
 programs: Vec(GpuProgram); program_frame: u64; textures: Vec(GpuTexture); shadows: [4]GpuShadow
 bindings: Vec(GpuBindingCheck)
 resources: SceneGpuResources
 transfers: [2]GpuTransfer; last_request: u64
 direct_readback: bool
 profile_enabled: bool; texture_upload_ms: float64
 // Per-frame owner time of the geometry phases, filled while profiling.
 profile_compare_ms: float64; profile_upload_ms: float64; profile_snapshot_ms: float64
 shadow_geometry: s64; shadow_skin: s64
 geometry_valid: bool
 // The snapshot was taken of a scene whose geometry was frozen.
 snapshot_frozen: bool
 snapshot_counts: [7]s64
 log: [2048]u8
}

// Profiling a synchronous read waits explicitly to separate completion from
// transfer. Async completion still uses zero-timeout polls.
SceneGpuSetProfiling :: (gpu: *SceneGpuContext, enabled: bool) {
 gpu.profile_enabled=enabled
}

// Whether GPU skinning (SceneSkinUseGpu) poses meshes on this backend: it is
// available and its vertex shaders read the palette, from texture unit 15 as
// GLES 3 promises or from a uniform array where the vertex stage cannot fetch.
SceneGpuSkinningAvailable :: (gpu: *SceneGpuContext)->bool {
 c:=SceneGpuProbe(gpu)
 return c.available&&(c.vertex_texture_fetch||gpu.skin_uniform_vectors>=64)
}
// The joints one palette holds: a texture column per joint, or the uniform
// rows that fit beside the shader's own uniforms.
SceneGpuPoseCapacity :: (gpu: *SceneGpuContext,dual: bool)->s32 {
 c:=SceneGpuProbe(gpu)
 if !c.available {return 0}
 capacity: s32 = 0
 if gpu.skin_uniform_vectors>=64 {capacity=gpu.skin_uniform_vectors/BoneRows(false,dual)}
 if c.vertex_texture_fetch&&c.max_texture_size>capacity {capacity=cast(s32)c.max_texture_size}
 return capacity
}
// Rows of one joint in its palette: six in a texture, two (dual quaternions)
// or three (linear blend skinning) packed in a uniform array.
BoneRows :: (texture: bool,dual: bool)->s32 {
 if texture {return 6}
 return ifx dual then 2 else 3
}
// The uniform array is the palette whenever the joints fit it, the same on
// every backend; only a larger skin takes the texture of a backend whose
// vertex stage reads textures.
PaletteUsesTexture :: (gpu: *SceneGpuContext,p: *SceneSkinPalette)->bool {
 if gpu.skin_uniform_vectors>=64&&p.joint_count*BoneRows(false,p.dual_quaternion)<=gpu.skin_uniform_vectors {return false}
 return gpu.capabilities.vertex_texture_fetch
}
// The vertex shader every material program links: the shared attributes and
// skin main around the palette this GPU's vertex stage can read.
SceneVertexSource :: (gpu: *SceneGpuContext)->string {
 if gpu.vertex_source.count>0 {return gpu.vertex_source}
 code: Vec(u8)
 unused BuilderAppend(code,GpuVertexVersion)
 unused BuilderAppend(code,GpuVertexBody)
 if gpu.capabilities.vertex_texture_fetch {
  if gpu.skin_uniform_vectors>=64 {
   BuilderPrint(*code,"#define KRYON_BONE_VECTORS %\n",gpu.skin_uniform_vectors)
   unused BuilderAppend(code,GpuBonesBoth)
  } else {unused BuilderAppend(code,GpuBonesTexture)}
 } else {
  BuilderPrint(*code,"#define KRYON_BONE_VECTORS %\n",gpu.skin_uniform_vectors)
  unused BuilderAppend(code,GpuBonesUniform)
 }
 unused BuilderAppend(code,GpuVertexSkin)
 gpu.vertex_source=BuilderFinish(code)
 return gpu.vertex_source
}

#if OS != .WEB || #defined(KRYON_WEBGL2) {
// Binds the renderer's context. An adopted window context binds with its
// surface so the frame can end in the window; a private context is surfaceless.
BindContext :: (gpu: *SceneGpuContext)->bool {
 #if OS == .WEB {
  return gpu.context!=null && G.MakeSceneCurrent(null,gpu.context)
 } else {
  if gpu.context==null { return false }
  if gpu.adopted && gpu.window_surface!=null {
   if G.EGetCurrentContext()==gpu.context && G.EGetCurrentSurface(0x3059)==gpu.window_surface { return true }
   return G.EMakeCurrent(gpu.display,gpu.window_surface,gpu.window_surface,gpu.context)!=0
  }
  if G.EGetCurrentContext()==gpu.context && G.EGetCurrentSurface(0x3059)==null { return true }
  return G.MakeSceneCurrent(gpu.display,gpu.context)
 }
}

// The window host lends the renderer its current EGL context and surface.
// Everything the renderer creates lives in that context; the host swaps.
SceneGpuAdoptWindow :: (gpu: *SceneGpuContext,display: *void,context: *void,surface: *void) {
 if gpu.adopted && gpu.display==display && gpu.context==context { gpu.window_surface=surface; return }
 if gpu.attempted { SceneGpuRelease(gpu) }
 gpu.display=display; gpu.context=context; gpu.window_surface=surface; gpu.adopted=true
}

// The window host is about to destroy the context it lent. Nothing of the
// renderer survives it, so the next render probes the next window afresh.
SceneGpuWindowLost :: (gpu: *SceneGpuContext) {
 if gpu.attempted { SceneGpuRelease(gpu) }
 gpu.adopted=false; gpu.window_surface=null; gpu.context=null; gpu.display=null
}

// The GL phases that left an error flag set since the process started.
SceneGpuErrorTrace :: () -> string { return TextView(note_buffer[0:cast(s64)trace_used]) }

// Calling again after Release retries detection, including after context loss.
SceneGpuProbe :: (gpu: *SceneGpuContext)->SceneGpuCapabilities {
 if gpu.attempted { return gpu.capabilities }
 gpu.attempted=true
 saved:=G.SaveContext()
 defer G.RestoreContext(saved,gpu.display)
 #if OS == .WEB {
  gpu.capabilities.diagnostic="WebGL 2 context unavailable"
  context,canvas:=Surface.CreateContext()
  gpu.context=context;gpu.canvas=canvas
 } else {
  gpu.capabilities.diagnostic="EGL surfaceless ES3 context unavailable"
  if !gpu.adopted {
   gpu.display=G.ESceneDisplay()
   if gpu.display==null { return gpu.capabilities }
   major: s32;minor: s32
   if G.EInitialize(gpu.display,*major,*minor)==0 { gpu.display=null;return gpu.capabilities }
   unused G.EBindAPI(0x30a0)
   attrs: [9]s32=.[0x3033,1,0x3040,0x40,0x3024,8,0x3025,8,0x3038]
   config: *void;count: s32
   if G.EChooseConfig(gpu.display,*attrs[0],*config,1,*count)==0||count==0 { return gpu.capabilities }
   context_attrs: [3]s32=.[0x3098,3,0x3038]
   gpu.context=G.ECreateContext(gpu.display,config,null,*context_attrs[0])
  }
 }
 if gpu.context==null||!BindContext(gpu) { return gpu.capabilities }
 CopyLabel(gpu.capabilities.renderer[: ],G.GetString(0x1f01))
 CopyLabel(gpu.capabilities.version[: ],G.GetString(0x1f02))
 CopyLabel(gpu.capabilities.vendor[: ],G.GetString(0x1f00))
 #if OS == .ANDROID && #defined(__arm__) {
  gpu.direct_readback=AndroidText.TextFromCString(*gpu.capabilities.renderer[0])=="PowerVR Rogue GE8320"
 }
 G.GetInteger(0x0d33,*gpu.capabilities.max_texture_size)
 G.GetInteger(0x8872,*gpu.capabilities.texture_units)
 // MAX_VERTEX_TEXTURE_IMAGE_UNITS.
 G.GetInteger(0x8b4c,*gpu.capabilities.vertex_texture_units)
 TraceError("caps_vtunits",G.GetError())
 G.GetInteger(0x8dfb,*gpu.capabilities.vertex_uniform_vectors)
 TraceError("caps_vuniforms",G.GetError())
 maximum: s32;G.GetInteger(0x8d57,*maximum)
 range: [2]s32;precision: s32;G.GetPrecision(0x8b30,0x8df2,*range[0],*precision)
 gpu.capabilities.max_samples=maximum;gpu.capabilities.highp_bits=precision;gpu.capabilities.highp_range=range[1]
 gpu.capabilities.diagnostic="fragment highp, 15 texture units and full 4x MSAA required"
 if maximum<4||precision<23||range[1]<127||gpu.capabilities.texture_units<15 { return gpu.capabilities }
 #if OS == .ANDROID {
  directory: [4096]u8
  gpu.program_cache=G.InitProgramCache(Android.AndroidPrivateDataPath(directory[:]))
 }
 if !Resize(gpu,4,4,4) { return gpu.capabilities }
 gpu.capabilities.pcf_available=ProbePCF(gpu)
 TraceError("pcf",G.GetError())
 gpu.capabilities.vertex_texture_fetch=gpu.capabilities.vertex_texture_units>=16||ProbeVTF(gpu)
 TraceError("vtf",G.GetError())
 // The palette is a uniform array whenever the joints fit it, whether or not
 // the vertex stage reads textures. Leave room for the shader's own matrices
 // and refuse a program the driver will not take.
 gpu.skin_uniform_vectors=0
 if gpu.capabilities.vertex_uniform_vectors>=128 {
  vectors:=gpu.capabilities.vertex_uniform_vectors-24;if vectors>384 {vectors=384}
  gpu.skin_uniform_vectors=(vectors/64)*64
 }
 gpu.vertex_source=""
 gpu.shadow_program=LoadSceneProgram(gpu,SceneVertexSource(gpu),GpuShadowFragment,true)
 if gpu.shadow_program==0&&gpu.skin_uniform_vectors>0 {
  TraceError("uniform_palette",G.GetError())
  gpu.skin_uniform_vectors=0;gpu.vertex_source=""
  gpu.shadow_program=LoadSceneProgram(gpu,SceneVertexSource(gpu),GpuShadowFragment,true)
 }
 TraceError("shadow",G.GetError())
 if gpu.shadow_program==0 { gpu.capabilities.diagnostic=ifx gpu.log[0]==0 then "shadow GLSL program rejected" else TextView(gpu.log[0:cast(s64)gpu.log.count]);return gpu.capabilities }
 G.GenBuffers(1,*gpu.buffer)
 // The shader and framebuffer probes do not exercise the vertex buffer ABI.
 // Allocate and update a small buffer with the same calls as indexed meshes.
 gpu.capabilities.diagnostic="GLES geometry buffer upload unavailable"
 if gpu.buffer==0 {return gpu.capabilities}
 vertex: u32=1
 G.BindBuffer(0x8892,gpu.buffer)
 G.BufferData(0x8892,4,null,0x88e8)
 G.BufferSubData(0x8892,0,4,cast(*void)*vertex)
 if G.GetError()!=0 {return gpu.capabilities}
 if !CreateDFG(gpu) { gpu.capabilities.diagnostic="DFG texture unavailable";return gpu.capabilities }
 gpu.capabilities.available=true;gpu.capabilities.diagnostic=""
 #if OS == .WEB {
  gpu.capabilities.async_diagnostic="WebGL does not support mapping pixel pack buffers"
 } else {
  gpu.capabilities.async_available=ProbeAsync(gpu)
  if !gpu.capabilities.async_available {gpu.capabilities.async_diagnostic="pixel pack buffers, fences and read mapping unavailable"}
 }
 TraceError("probe",G.GetError())
 return gpu.capabilities
}

SceneGpuResize :: (gpu: *SceneGpuContext,width: s32,height: s32)->bool {
 if !SceneGpuProbe(gpu).available { return false }
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if !BindContext(gpu) { return false }
 return Resize(gpu,width,height,4)
}

// Strict GPU call never reports a CPU frame as accelerated. It leaves the
// output untouched until a complete readback succeeds.
SceneGpuRender :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,image: *Image)->SceneGpuFrame {
 if !SceneGpuProbe(gpu).available { return .{diagnostic=gpu.capabilities.diagnostic} }
 if scene.failed||scene.open.count!=0||image.width<=0||image.height<=0 { return .{diagnostic="invalid Scene or Image"} }
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if !BindContext(gpu) { return .{diagnostic="GPU context lost"} }
 if !Resize(gpu,image.width,image.height,4) { return .{diagnostic=gpu.capabilities.diagnostic} }
 bytes:=cast(s64)gpu.width*gpu.height*4
 if !VecResizeBounded(gpu.readback,bytes,bytes) {return .{diagnostic="readback allocation failed"}}
 frame:=RenderTarget(gpu,scene,camera)
 if !frame.ok {return frame}
 converting:=Now()
 opaque_direct:=gpu.direct_readback&&scene.background.a>0
 if opaque_direct {G.BindFramebuffer(0x8d40,gpu.resolve)}
 else if !StraightReadbackTarget(gpu,*gpu.straight_framebuffer,*gpu.straight_texture) {return .{diagnostic="straight RGBA readback target unavailable"}}
 submitted:=Now()
 G.PixelStore(0x0d05,1);G.BindBuffer(0x88eb,0)
 transfer:=submitted
 if gpu.profile_enabled {
  finish:=Now()
  G.Finish()
  transfer=Now()
  frame.profile.gpu_completion_ms=transfer-finish
 }
 G.ReadPixels(0,0,gpu.width,gpu.height,0x1908,0x1401,cast(*void)*gpu.readback[0])
 read:=Now()
 if G.GetError()!=0 {return .{diagnostic="GLES render/readback failed"}}
 // Commit only after successful GL completion, preserving the previous Image
 // on GPU failure. Opaque resolves need only a copy in reverse row order.
 copy:=ifx gpu.profile_enabled then Now() else read
 copied:=ifx opaque_direct then ConvertReadback(gpu,image,true) else CopyReadback(gpu,image,bytes)
 if !copied {return .{diagnostic="Image allocation failure"}}
 published:=Now()
 gpu.resources.frames+=1
 frame.submit_ms+=submitted-converting
 frame.readback_ms=read-submitted;frame.conversion_ms=submitted-converting+published-read
 if gpu.profile_enabled {
  frame.profile.direct_resolve=opaque_direct
  frame.profile.pixel_transfer_ms=read-transfer
  frame.profile.image_copy_ms=published-copy
 }
 return frame
}

// Draw and resolve only; both public paths use precisely the same quality math.
}
#scope_file
#if OS != .WEB || #defined(KRYON_WEBGL2) {
RenderTarget :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera)->SceneGpuFrame {
 start:=Now()
 gpu.texture_upload_ms=0.0
 gpu.profile_compare_ms=0.0;gpu.profile_upload_ms=0.0;gpu.profile_snapshot_ms=0.0
 if SkinsChanged(gpu,scene) {gpu.geometry_valid=false}
 if !PrepareGeometry(gpu,scene) { return .{diagnostic="invalid geometry or allocation failure"} }
 gpu.program_frame+=1
 for at: 0..gpu.textures.count-1 { gpu.textures[at].used=false }
 defer Sweep(gpu)
 VecClear(gpu.bindings)
 shadow_features:=ShadowFeatures(scene)
 setup:=ifx gpu.profile_enabled then Now() else 0.0
 for at: 0..scene.meshes.count-1 {
  m:=scene.meshes[at].material
  if m.shader!=null {
   diagnostic:=ValidateBindings(gpu,m)
   if !diagnostic.ok { return .{diagnostic=diagnostic.message} }
  }
  if ProgramFor(gpu,m.shader,MaterialFeatures(m,camera.perspective)|shadow_features)==null { return .{diagnostic="material GLSL program rejected"} }
 }
 shader_setup_ms:=ifx gpu.profile_enabled then Now()-setup else 0.0
 BindVertices(gpu)
 if !PrepareSkins(gpu,scene) { return .{diagnostic="skin palette texture unavailable"} }
 prepared:=Now();shadows_before:=gpu.resources.shadow_renders
 if !RenderShadows(gpu,scene) { return .{diagnostic="shadow framebuffer unavailable"} }
 shadowed:=Now()
 G.BindFramebuffer(0x8d40,gpu.framebuffer);G.Viewport(0,0,gpu.width,gpu.height)
 b:=scene.background
 if b.a>0 { G.ClearColor(cast(float32)b.r/255.0,cast(float32)b.g/255.0,cast(float32)b.b/255.0,1.0) }
 else { G.ClearColor(0.0,0.0,0.0,0.0) }
 G.DepthMask(1);G.ClearDepth(1.0);G.Clear(0x4100)
 G.Enable(0x0b71);G.DepthFunc(0x0203);G.Disable(0x0be2);G.Disable(0x0bd0)
 G.FrontFace(0x0901);G.CullFace(0x0405)
 view:=M.LookAt(camera.position,camera.target,camera.up)
 projection:=M.Projection(camera);vp:=M.Multiply(projection,view)
 grade:=PrepareGrade(scene.grade)
 VecClear(gpu.order);VecClear(gpu.keys)
 draw_calls: s32
 for at: 0..gpu.draws.count-1 {
  d:=gpu.draws[at];if !d.shown { continue }
  draw_calls+=1
  m:=scene.meshes[d.mesh].material
  if m.transparent {
   origin:=M.Point(view,d.origin);clip:=M.Point(projection,origin);w:=M.ProjectW(projection,origin)
   if !VecPush(gpu.order,cast(s32)at)||!VecPush(gpu.keys,ifx w!=0.0 then clip.z/w else clip.z) { return .{diagnostic="sort allocation failure"} }
  } else if !Draw(gpu,scene,d,view,vp,*grade,camera.perspective,shadow_features) { return .{diagnostic="material texture unavailable"} }
 }
 for i: 1..gpu.order.count-1 {
  key:=gpu.keys[i];draw:=gpu.order[i];j:=i-1
  while j>=0&&gpu.keys[j]<key {gpu.keys[j+1]=gpu.keys[j];gpu.order[j+1]=gpu.order[j];j-=1}
  gpu.keys[j+1]=key;gpu.order[j+1]=draw
 }
 G.Enable(0x0be2);G.BlendFuncSeparate(0x0302,0x0303,1,0x0303)
 // CPU transparent meshes also write depth.
 for at: 0..gpu.order.count-1 { if !Draw(gpu,scene,gpu.draws[gpu.order[at]],view,vp,*grade,camera.perspective,shadow_features) {return .{diagnostic="material texture unavailable"}} }
 G.BindFramebuffer(0x8ca8,gpu.framebuffer);G.BindFramebuffer(0x8ca9,gpu.resolve)
 G.BlitFramebuffer(0,0,gpu.width,gpu.height,0,0,gpu.width,gpu.height,0x4000,0x2600)
 submitted:=Now()
 if G.GetError()!=0 {return .{diagnostic="GLES render/resolve failed"}}
 return .{ok=true,accelerated=true,submit_ms=submitted-start,
  prepare_ms=prepared-start,shadow_ms=shadowed-prepared,draw_ms=submitted-shadowed,
  draw_calls=draw_calls,shadow_passes=gpu.resources.shadow_renders-shadows_before,
  profile=.{shader_setup_ms=shader_setup_ms,texture_upload_ms=gpu.texture_upload_ms,geometry_compare_ms=gpu.profile_compare_ms,geometry_upload_ms=gpu.profile_upload_ms,geometry_snapshot_ms=gpu.profile_snapshot_ms}}
}
// Use integer arithmetic on the quantized resolved texel, matching the CPU
// formula exactly even at alpha 1, 127, 128 and 254. This pass also flips rows.
GpuStraightFragment :: #string GLSL
#version 300 es
precision highp float;
precision highp int;
uniform highp sampler2D source;
out vec4 outputColor;
void main(){
 ivec2 size=textureSize(source,0);
 ivec2 pixel=ivec2(int(gl_FragCoord.x),size.y-1-int(gl_FragCoord.y));
 uvec4 bytes=uvec4(floor(texelFetch(source,pixel,0)*255.0+0.5));
 if(bytes.a==0u)bytes.rgb=uvec3(0u);
 else if(bytes.a!=255u)bytes.rgb=min(uvec3(255u),(bytes.rgb*255u+bytes.a/2u)/bytes.a);
 outputColor=vec4(bytes)/255.0;
}
GLSL
DropReadbackTarget :: (framebuffer: *u32,texture: *u32) {
 G.DeleteFramebuffers(1,framebuffer);G.DeleteTextures(1,texture)
 framebuffer[0]=0;texture[0]=0
}
BindReadbackTarget :: (gpu: *SceneGpuContext,framebuffer: *u32,texture: *u32)->bool {
 if framebuffer[0]==0 {
  G.GenFramebuffers(1,framebuffer)
  G.BindFramebuffer(0x8d40,framebuffer[0])
  texture[0]=G.Texture(gpu.width,gpu.height,0x8058,0x1908,0x1401,null)
  G.FramebufferTexture(0x8d40,0x8ce0,0x0de1,texture[0],0)
  status:=G.CheckFramebuffer(0x8d40);err:=G.GetError()
  if status!=0x8cd5||err!=0 {
   DropReadbackTarget(framebuffer,texture)
   return false
  }
 } else {G.BindFramebuffer(0x8d40,framebuffer[0])}
 return true
}
StraightReadbackTarget :: (gpu: *SceneGpuContext,framebuffer: *u32,texture: *u32)->bool {
 if gpu.straight_program==0 {
  gpu.straight_program=LoadSceneProgram(gpu,GpuProbeVertex,GpuStraightFragment)
  if gpu.straight_program==0 {return false}
 }
 if !BindReadbackTarget(gpu,framebuffer,texture) {return false}
 G.Viewport(0,0,gpu.width,gpu.height)
 G.Disable(0x0b71);G.Disable(0x0be2);G.Disable(0x0b44);G.Disable(0x0bd0)
 G.UseProgram(gpu.straight_program)
 G.ActiveTexture(0x84c0);G.BindTexture(0x0de1,gpu.resolved)
 G.Uniform1i(G.Location(gpu.straight_program,"source"),0)
 G.DrawArrays(4,0,3)
 return G.GetError()==0
}
CopyReadback :: (gpu: *SceneGpuContext,image: *Image,bytes: s64)->bool {
 if !VecResize(image.pixels,bytes) {return false}
 unused G.CopyMemory(cast(*void)*image.pixels[0],cast(*void)*gpu.readback[0],cast(usize)bytes)
 return true
}
ConvertReadback :: (gpu: *SceneGpuContext,image: *Image,opaque: bool)->bool {
 if !VecResize(image.pixels,cast(s64)gpu.width*gpu.height*4) {return false}
 for y: 0..gpu.height-1 {
  source_row:=cast(s64)(gpu.height-1-y)*gpu.width*4;dest_row:=cast(s64)y*gpu.width*4
  unused G.CopyMemory(cast(*void)*image.pixels[dest_row],cast(*void)*gpu.readback[source_row],cast(usize)gpu.width*4)
  // An opaque clear stays opaque under source-over blending, so the row copy
  // is already the required straight RGBA output.
  if opaque {continue}
  source_pixels:=*gpu.readback[source_row];dest_pixels:=*image.pixels[dest_row]
  x: s32
  while x<gpu.width {
  source:=cast(s64)x*4
  // Most resolved pixels are opaque even with a transparent scene clear.
  // Check eight alpha bytes together before entering per-pixel conversion.
  // Byte accesses preserve channel order and alignment on every CPU.
  if x+8<=gpu.width && (source_pixels[source+3]&source_pixels[source+7]&
      source_pixels[source+11]&source_pixels[source+15]&source_pixels[source+19]&
      source_pixels[source+23]&source_pixels[source+27]&source_pixels[source+31])==cast(u8)255 {
      x+=8; continue
  }
  // Convert a mixed block once, without repeatedly inspecting overlapping
  // alpha groups on transparent surfaces. The final block may be shorter.
  end:=ifx x+8<gpu.width then x+8 else gpu.width
  for pixel: x..end-1 {
   at:=cast(s64)pixel*4
   a:=cast(s32)source_pixels[at+3]
   if a==255 {continue}
   for c: 0..2 {
    v:=ifx a>0 then (cast(s32)source_pixels[at+c]*255+a/2)/a else 0
    dest_pixels[at+c]=cast(u8)(ifx v>255 then 255 else v)
   }
   dest_pixels[at+3]=cast(u8)a
  }
  x=end
 }}
 return true
}

}
#scope_export
#if OS != .WEB || #defined(KRYON_WEBGL2) {
#if OS != .WEB {
// Submit snapshots camera metadata and enqueues all Scene reads before return.
// Public Scene, shader and texture storage can then be mutated on this thread.
SceneGpuSubmit :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32,request_id: u64)->SceneGpuAsyncResult {
 caps:=SceneGpuProbe(gpu)
 if !caps.available {return .{diagnostic=caps.diagnostic}}
 if !caps.async_available {return .{diagnostic=caps.async_diagnostic}}
 if scene.failed||scene.open.count!=0||width<=0||height<=0||request_id==0||request_id<=gpu.last_request {return .{diagnostic="invalid Scene, size or non-increasing request ID"}}
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if !BindContext(gpu) {SceneGpuRelease(gpu);return .{diagnostic="GPU context lost; pending requests cancelled"}}
 defer G.BindBuffer(0x88eb,0)
 if !Resize(gpu,width,height,4) {return .{diagnostic=gpu.capabilities.diagnostic}}
 index: s32=-1
 for at:0..1 {if gpu.transfers[at].fence==null {index=cast(s32)at;break}}
 if index<0 {return .{ok=true,busy=true}}
 slot:=*gpu.transfers[index];bytes:=cast(s64)width*height*4
 start:=Now()
 slot.opaque=scene.background.a>0
 slot.straight=false
 // Prepare a spare before drawing so allocation cannot stall this resolve.
 // If the allocation fails, the existing PBO path still works.
 direct_opaque:=gpu.direct_readback&&slot.opaque&&BindReadbackTarget(gpu,*slot.framebuffer,*slot.texture)
 if direct_opaque {slot.bytes=bytes}
 frame:=RenderTarget(gpu,scene,camera)
 if !frame.ok {return .{diagnostic=frame.diagnostic}}
 if direct_opaque {
  // The slot owns this resolve until its fence signals. Give later renders
  // the slot's spare so they cannot overwrite the pending frame.
  spare_framebuffer:=slot.framebuffer;spare_texture:=slot.texture
  slot.framebuffer=gpu.resolve;slot.texture=gpu.resolved
  gpu.resolve=spare_framebuffer;gpu.resolved=spare_texture
 } else if gpu.direct_readback&&!slot.opaque {
  // Keep the straight-alpha path for transparent output on PowerVR, where
  // mapped pixel pack memory is slow to copy.
  slot.straight=StraightReadbackTarget(gpu,*slot.framebuffer,*slot.texture)
  if !slot.straight {DropReadbackTarget(*slot.framebuffer,*slot.texture)}
 } else if slot.framebuffer!=0 {
  DropReadbackTarget(*slot.framebuffer,*slot.texture)
 }
 if slot.framebuffer!=0&&slot.buffer!=0 {G.DeleteBuffers(1,*slot.buffer);slot.buffer=0}
 if slot.framebuffer==0 {
  if slot.buffer==0 {G.GenBuffers(1,*slot.buffer);slot.bytes=0}
  G.BindBuffer(0x88eb,slot.buffer)
  if slot.bytes!=bytes {G.BufferData(0x88eb,bytes,null,0x88e1)}
  if slot.buffer==0||G.GetError()!=0 {return .{diagnostic="pixel pack allocation failed"}}
  G.BindFramebuffer(0x8d40,gpu.resolve);G.PixelStore(0x0d05,1)
  G.ReadPixels(0,0,width,height,0x1908,0x1401,null)
 }
 slot.bytes=bytes
 if gpu.profile_enabled {
  frame.profile.direct_resolve=direct_opaque
  slot.fence_at=Now()
 } else {slot.fence_at=0.0}
 slot.fence=G.FenceSync(0x9117,0)
 G.Flush()
 if slot.fence==null||G.GetError()!=0 {
  if slot.fence!=null {G.DeleteSync(slot.fence);slot.fence=null}
  gpu.capabilities.async_available=false;gpu.capabilities.async_diagnostic="asynchronous pixel transfer failed"
  return .{diagnostic=gpu.capabilities.async_diagnostic}
 }
 slot.request_id=request_id;slot.camera=camera;slot.width=width;slot.height=height
 slot.frame=frame;slot.submitted_at=start
 slot.frame.submit_ms=Now()-start
 gpu.last_request=request_id;gpu.resources.submitted_frames+=1
 return .{ok=true,queued=true,request_id=request_id,camera=camera,width=width,height=height,frame=slot.frame}
}

// Check the oldest queued fence without waiting, then transfer a ready frame.
// Empty/unready/error leaves Image dimensions and pixels untouched.
SceneGpuPoll :: (gpu: *SceneGpuContext,image: *Image)->SceneGpuAsyncResult {
 index: s32=-1
 for at:0..1 {
  if gpu.transfers[at].fence!=null&&(index<0||gpu.transfers[at].request_id<gpu.transfers[index].request_id) {index=cast(s32)at}
 }
 if index<0 {return .{ok=true}}
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if !BindContext(gpu) {SceneGpuRelease(gpu);return .{diagnostic="GPU context lost; pending requests cancelled"}}
 defer G.BindBuffer(0x88eb,0)
 slot:=*gpu.transfers[index]
 status:=G.ClientWaitSync(slot.fence,0,0)
 if status==0x911b {return .{ok=true}}
 if status!=0x911a&&status!=0x911c {return .{diagnostic="asynchronous fence wait failed"}}
 completion:=ifx slot.fence_at>0.0 then Now()-slot.fence_at else 0.0
 if image.width!=slot.width||image.height!=slot.height {return .{diagnostic="completed frame size differs from output Image"}}
 if !VecResizeBounded(gpu.readback,slot.bytes,slot.bytes) {return .{diagnostic="readback allocation failed"}}
 start:=Now()
 if slot.framebuffer!=0 {
  G.BindFramebuffer(0x8d40,slot.framebuffer);G.PixelStore(0x0d05,1);G.BindBuffer(0x88eb,0)
  G.ReadPixels(0,0,slot.width,slot.height,0x1908,0x1401,cast(*void)*gpu.readback[0])
  if G.GetError()!=0 {return .{diagnostic="completed framebuffer readback failed"}}
 } else {
  G.BindBuffer(0x88eb,slot.buffer)
  mapped:=G.MapBufferRange(0x88eb,0,slot.bytes,1)
  if mapped==null {return .{diagnostic="completed pixel pack mapping failed"}}
  // Validate unmap before publishing from the retained CPU staging buffer.
  unused G.CopyMemory(cast(*void)*gpu.readback[0],mapped,cast(usize)slot.bytes)
  if G.UnmapBuffer(0x88eb)==0||G.GetError()!=0 {return .{diagnostic="completed pixel pack mapping invalid"}}
 }
 read:=Now()
 copied:=ifx slot.straight then CopyReadback(gpu,image,slot.bytes) else ConvertReadback(gpu,image,slot.opaque)
 if !copied {return .{diagnostic="Image allocation failure"}}
 published:=Now()
 result: SceneGpuAsyncResult=.{ok=true,completed=true,request_id=slot.request_id,camera=slot.camera,
  width=slot.width,height=slot.height,frame=slot.frame,latency_ms=published-slot.submitted_at}
 result.frame.readback_ms=read-start;result.frame.conversion_ms=published-read
 if slot.fence_at>0.0 {
  result.frame.profile.gpu_completion_ms=completion
  result.frame.profile.pixel_transfer_ms=result.frame.readback_ms
  result.frame.profile.image_copy_ms=result.frame.conversion_ms
 }
 G.DeleteSync(slot.fence);slot.fence=null;slot.request_id=0
 gpu.resources.frames+=1
 return result
}

// Cancellation is a lifecycle operation and may drain GPU work. Slots remain
// bounded; discarded IDs are never returned by subsequent Poll calls.
SceneGpuCancel :: (gpu: *SceneGpuContext) {
 if gpu.context==null {return}
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if BindContext(gpu) {DropTransfers(gpu)}
 else {SceneGpuRelease(gpu)}
}

// Explicit full-quality fallback; no reduced resolution, texture, light or AA.
 } else {
SceneGpuSubmit :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32,request_id: u64)->SceneGpuAsyncResult {
 unused scene;unused camera;unused width;unused height;unused request_id
 return .{diagnostic=SceneGpuProbe(gpu).async_diagnostic}
}
SceneGpuPoll :: (gpu: *SceneGpuContext,image: *Image)->SceneGpuAsyncResult {
 unused image
 return .{diagnostic=SceneGpuProbe(gpu).async_diagnostic}
}
SceneGpuCancel :: (gpu: *SceneGpuContext) {unused gpu}
}

#if OS == .WEB {
// Resolve the scene in its private WebGL context, then import its canvas
// into the page presenter as a real GPU texture. Context-local GL names cannot
// be registered as page textures. No Image allocation or pixel readback occurs.
SceneGpuRenderCanvas :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32)->(result: SceneGpuFrame,image: Texture2D) {
 caps:=SceneGpuProbe(gpu)
 if !caps.available {return .{diagnostic=caps.diagnostic},.{}}
 if scene.failed||scene.open.count!=0||width<=0||height<=0 {return .{diagnostic="invalid Scene or canvas extent"},.{}}
 saved:=G.SaveContext();defer G.RestoreContext(saved,null)
 if !G.MakeSceneCurrent(null,gpu.context) {return .{diagnostic="WebGL context lost"},.{}}
 Core.PageFlushPaint()
 Presenter.PageGpuFlush()
 if !Resize(gpu,width,height,4)||!Surface.ResizeCanvas(gpu.canvas,width,height) {return .{diagnostic="WebGL canvas extent unavailable"},.{}}
 frame:=RenderTarget(gpu,scene,camera)
 if !frame.ok {return frame,.{}}
 G.BindFramebuffer(0x8ca8,gpu.resolve);G.BindFramebuffer(0x8ca9,0)
 G.BlitFramebuffer(0,0,width,height,0,0,width,height,0x4000,0x2600)
 if G.GetError()!=0 {return .{diagnostic="WebGL canvas presentation failed"},.{}}
 // Give the new pixels a new texture identity for retained paint damage.
 uploaded:=Presenter.PageGpuTextureFromBitmap(gpu.canvas)
 if uploaded==0 {return .{diagnostic="WebGL scene texture import failed"},.{}}
 texture:=Page.PageTextureRegister(uploaded,0,false,width,height)
 if texture==0 {
  Presenter.PageGpuTextureFree(uploaded)
  return .{diagnostic="WebGL scene texture table is full"},.{}
 }
 Page.PageTextureFree(gpu.canvas_texture)
 gpu.canvas_texture=texture
 gpu.resources.frames+=1
 return frame,.{cast(u32)texture,width,height,1,7}
}
}

SceneGpuRenderOrCPU :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,image: *Image)->SceneGpuFrame {
 result:=SceneGpuRender(gpu,scene,camera,image)
 if result.ok { return result }
 result.ok=RenderScene(scene,camera,image);result.accelerated=false
 return result
}

scale_steps: [SCALE_STEPS]ScaleStep = .[.{100,4,1.0},.{75,4,0.6},.{100,1,0.5},.{75,1,0.3},.{50,1,0.17},.{35,1,0.1}];
// The internal resolution of window frames follows the GPU. A rung whose
// frame cannot hold the refresh period renders the next one smaller; one with
// room for the rung above, which failed at most twice, climbs back. Each rung
// is measured over a few frames: timestamp queries where the driver has them,
// otherwise a finish that drains the pipeline, and never between rungs unless
// frames keep missing the refresh. The first frames upload shaders and
// textures, so the first measurement waits for the scene to run.
WindowScale :: (gpu: *SceneGpuContext)->s32 {
 now:=Now()
 if gpu.scale_fixed>0 {gpu.scale_percent=gpu.scale_fixed;gpu.scale_samples=gpu.scale_fixed_samples;gpu.gpu_time=gpu.measure_gpu;gpu.last_frame_at=now;return gpu.scale_fixed}
 if gpu.scale_level<0||gpu.scale_level>=SCALE_STEPS {gpu.scale_level=0}
 if gpu.scale_percent==0 {gpu.scale_warm=3;gpu.scale_probe=0;gpu.scale_hold=0;gpu.scale_start=now}
 if gpu.last_frame_at>0.0 {if now-gpu.last_frame_at>25.0 {gpu.scale_late+=1}}
 gpu.last_frame_at=now
 if gpu.scale_hold>0 {gpu.scale_hold-=1}
 else if now-gpu.scale_start<2.0 {gpu.scale_late=0}
 else {
  gpu.scale_idle+=1
  if gpu.scale_idle>=60 {
   if gpu.scale_late>=3&&gpu.scale_probe<=0 {gpu.scale_warm=1;gpu.scale_probe=10}
   gpu.scale_idle=0;gpu.scale_late=0
  }
 }
 gpu.scale_percent=scale_steps[gpu.scale_level].percent
 gpu.scale_samples=scale_steps[gpu.scale_level].samples
 gpu.gpu_time=gpu.measure_gpu||gpu.scale_probe>0
 return gpu.scale_percent
}
// gpu_ms is the frame's wall time through the finish, cpu_ms the part of it
// the CPU spent submitting: only a frame that waits for the GPU beyond its
// submission says the GPU is behind.
WindowScaleMeasured :: (gpu: *SceneGpuContext,gpu_ms: float64,cpu_ms: float64) {
 if gpu.scale_fixed>0||gpu.scale_probe<=0||gpu_ms<=0.0 {return}
 if gpu.scale_warm>0 {gpu.scale_warm-=1;return}
 gpu.scale_sum+=gpu_ms;gpu.scale_cpu_sum+=cpu_ms;gpu.scale_count+=1;gpu.scale_probe-=1
 if gpu.scale_probe>0 {return}
 average:=gpu.scale_sum/cast(float64)gpu.scale_count
 submitted:=gpu.scale_cpu_sum/cast(float64)gpu.scale_count
 gpu.scale_sum=0.0;gpu.scale_cpu_sum=0.0;gpu.scale_count=0
 if average>14.5&&average>submitted+4.0&&gpu.scale_level<SCALE_STEPS-1 {
  gpu.scale_fail[gpu.scale_level]+=1
  // A frame that misses the period by far skips a rung.
  down: s32 = ifx average>40.0&&gpu.scale_level+2<SCALE_STEPS then 2 else 1
  gpu.scale_level+=down;gpu.scale_warm=3;gpu.scale_probe=10
  return
 }
 gpu.scale_hold=240
 if gpu.scale_level>0&&gpu.scale_fail[gpu.scale_level-1]<2 {
  above:=scale_steps[gpu.scale_level-1].cost/scale_steps[gpu.scale_level].cost
  if average*above<13.5 {gpu.scale_level-=1;gpu.scale_warm=3;gpu.scale_probe=10}
 }
}
// The internal resolution of window frames as a percent of the window and its
// coverage samples: a positive percent holds both, 0 lets the renderer hold
// the refresh period.
SceneGpuWindowScale :: (gpu: *SceneGpuContext,percent: s32,samples: s32) {
 gpu.scale_fixed=ifx percent<0 then 0 else percent
 gpu.scale_fixed_samples=ifx samples<1||samples>4 then 4 else samples
 gpu.scale_percent=0
}
// Renders into the adopted window's context and presents the resolve into the
// window's default framebuffer. No pixel leaves the GPU; the window host swaps
// the surface once the frame callback returns.
SceneGpuRenderWindow :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32)->SceneGpuFrame {
 if !gpu.adopted||gpu.window_surface==null { return .{diagnostic="scene renderer has no window"} }
 if !SceneGpuProbe(gpu).available { return .{diagnostic=gpu.capabilities.diagnostic} }
 if scene.failed||scene.open.count!=0||width<=0||height<=0 { return .{diagnostic="invalid Scene or window"} }
 saved:=G.SaveContext();defer G.RestoreContext(saved,gpu.display)
 if !BindContext(gpu) { return .{diagnostic="window context lost"} }
 TraceError("window",G.GetError())
 percent:=WindowScale(gpu)
 inner_width:=width*percent/100;inner_height:=height*percent/100
 if !Resize(gpu,inner_width,inner_height,gpu.scale_samples) { return .{diagnostic=gpu.capabilities.diagnostic} }
 // The GPU time of a frame: between two GL timestamp queries where the
 // driver has them, otherwise the wall time through a finish at the end of
 // the frame, which drains the pipeline. Only while it is measured.
 #if OS != .WEB {
 if gpu.gpu_time {
 if TimerQueries() {
  gpu.timer_state=1
  if gpu.timer_pending {
   ready: u64
   query_object(gpu.timer_end,0x8867,*ready)
   gpu.timer_wait+=1
   // A driver that never reports a timestamp ready gets one blocking read.
   if ready==0&&gpu.timer_wait>3 {ready=1;gpu.timer_state=3}
   if ready!=0 {
    start_ns: u64;end_ns: u64
    query_object(gpu.timer_start,0x8866,*start_ns);query_object(gpu.timer_end,0x8866,*end_ns)
    if gpu.timer_state!=3 {gpu.timer_state=2}
    gpu.last_gpu_ms=cast(float64)(end_ns-start_ns)/1000000.0;gpu.timer_pending=false;gpu.timer_wait=0
   }
  }
  if gpu.timer_start==0 {G.GenQueries(1,*gpu.timer_start);G.GenQueries(1,*gpu.timer_end)}
  if gpu.timer_start!=0 {query_counter(gpu.timer_start,0x8e28)}
 } else {gpu.finish_at=Now()}
 }
 }
 frame:=RenderTarget(gpu,scene,camera)
 if !frame.ok {return frame}
 // The resolve is the frame; the present scales it into the window without a
 // scissor. A multisampled source copies only at its own size, so the present
 // reads the resolve.
 G.BindFramebuffer(0x8ca9,0);G.BindFramebuffer(0x8ca8,gpu.resolve)
 G.Disable(0x0c11)
 G.BlitFramebuffer(0,0,gpu.width,gpu.height,0,0,width,height,0x4000,0x2600)
 G.BindFramebuffer(0x8ca8,0)
 code:=G.GetError()
 if code!=0 {return .{diagnostic=Note("GLES window present failed",width,height,0,0,code)}}
 #if OS != .WEB {
 if gpu.timer_end!=0&&gpu.timer_start!=0 {query_counter(gpu.timer_end,0x8e28);gpu.timer_pending=true;frame.gpu_ms=gpu.last_gpu_ms}
 else if gpu.finish_at>0.0 {G.Finish();frame.gpu_ms=Now()-gpu.finish_at;gpu.finish_at=0.0}
 }
 WindowScaleMeasured(gpu,frame.gpu_ms,frame.profile.shader_setup_ms+frame.prepare_ms+frame.shadow_ms+frame.draw_ms)
 return frame
}

SceneGpuRelease :: (gpu: *SceneGpuContext) {
 saved:=G.SaveContext()
 if gpu.context!=null&&BindContext(gpu) {
  DropTargets(gpu)
  #if OS != .WEB {
  if gpu.timer_start!=0 {G.DeleteQueries(1,*gpu.timer_start);G.DeleteQueries(1,*gpu.timer_end);gpu.timer_start=0;gpu.timer_end=0;gpu.timer_pending=false}
  }
  if gpu.buffer!=0 {G.DeleteBuffers(1,*gpu.buffer)}
  if gpu.indexed.attributes!=0 {G.DeleteBuffers(1,*gpu.indexed.attributes)}
  if gpu.indexed.elements!=0 {G.DeleteBuffers(1,*gpu.indexed.elements)}
  if gpu.skin_bound {G.DisableAttribute(5);G.DisableAttribute(6);gpu.skin_bound=false}
  if gpu.indexed.skin_attributes!=0 {G.DeleteBuffers(1,*gpu.indexed.skin_attributes)}
  for at:0..gpu.skins.count-1 {if gpu.skins[at].texture!=0 {G.DeleteTextures(1,*gpu.skins[at].texture)}}
  if gpu.shadow_program!=0 {G.DeleteProgram(gpu.shadow_program)}
  if gpu.straight_program!=0 {G.DeleteProgram(gpu.straight_program)}
  #if OS == .ANDROID {
   if gpu.scene_vertex_shader!=0 {G.DeleteShader(gpu.scene_vertex_shader)}
  }
  if gpu.dfg!=0 {G.DeleteTextures(1,*gpu.dfg)}
  for at: 0..gpu.programs.count-1 {if gpu.programs[at].id!=0 {G.DeleteProgram(gpu.programs[at].id)}}
  for at: 0..gpu.textures.count-1 {if gpu.textures[at].id!=0 {G.DeleteTextures(1,*gpu.textures[at].id)}}
  for at: 0..3 {DropShadow(*gpu.shadows[at])}
  G.RestoreContext(saved,gpu.display)
 }
 else {G.RestoreContext(saved,gpu.display)}
 #if OS == .WEB {
  Page.PageTextureFree(gpu.canvas_texture);gpu.canvas_texture=0
  Surface.DestroyContext(gpu.context,gpu.canvas);gpu.canvas=0
 } else {
  // An adopted context belongs to the window host, which destroys it.
  if gpu.context!=null&&!gpu.adopted {unused G.EDestroyContext(gpu.display,gpu.context)}
 }
 // EGLDisplay is process-shared, including with foreign hosts. eglTerminate
 // invalidates their contexts too; release only the context/objects we own.
 VecFree(gpu.vertices);VecFree(gpu.draws);VecFree(gpu.snapshot);VecFree(gpu.readback)
 VecFree(gpu.indexed.indices);VecFree(gpu.indexed.scratch);VecFree(gpu.indexed.skin)
 gpu.indexed.attributes=0;gpu.indexed.elements=0;gpu.indexed.bound=false;gpu.indexed.vertex_count=0
 gpu.indexed.skin_attributes=0;gpu.skin_bound=false
 for at:0..gpu.skins.count-1 {VecFree(gpu.skins[at].uniform)}
 VecFree(gpu.skins);VecFree(gpu.node_skin)
 VecFree(gpu.node_first);VecFree(gpu.node_count);VecFree(gpu.node_world);VecFree(gpu.node_shown)
 VecFree(gpu.order);VecFree(gpu.keys);VecFree(gpu.programs);VecFree(gpu.textures)
 VecFree(gpu.bindings)
 gpu.capabilities=SceneGpuCapabilities.{};gpu.resources=SceneGpuResources.{}
 #if OS == .ANDROID {
  gpu.program_cache=G.ProgramCache.{}
  gpu.scene_vertex_shader=0
 }
 gpu.shadow_skin=0
 for at:0..1 {gpu.transfers[at]=GpuTransfer.{}}
 gpu.last_request=0;gpu.program_frame=0
 gpu.direct_readback=false;gpu.texture_upload_ms=0.0
 gpu.context=null;gpu.display=null;gpu.attempted=false
 gpu.adopted=false;gpu.window_surface=null
 gpu.buffer=0;gpu.shadow_program=0;gpu.straight_program=0;gpu.dfg=0;gpu.shadow_geometry=0
 gpu.skin_uniform_vectors=0;gpu.vertex_source="";gpu.skin_uniform_program=0;gpu.skin_uniform_index=-1;gpu.skin_uniform_version=0
 gpu.width=0;gpu.height=0
 gpu.framebuffer=0;gpu.resolve=0;gpu.color=0;gpu.depth=0;gpu.resolved=0
 gpu.straight_framebuffer=0;gpu.straight_texture=0
 for at:0..3 {gpu.shadows[at]=GpuShadow.{}}
 for at:0..gpu.snapshot_counts.count-1 {gpu.snapshot_counts[at]=0}
 gpu.geometry_valid=false
 for at:0..gpu.log.count-1 {gpu.log[at]=0}
}

SceneGpuMemoryUsage :: (gpu: *SceneGpuContext)->SceneGpuResources {
 r:=gpu.resources
 r.cpu_bytes=(gpu.vertices.capacity*cast(s64)size_of(GpuVertex)+gpu.draws.capacity*cast(s64)size_of(GpuDraw)+
  gpu.snapshot.capacity+gpu.readback.capacity+gpu.order.capacity*4+gpu.keys.capacity*8+
  gpu.programs.capacity*cast(s64)size_of(GpuProgram)+gpu.textures.capacity*cast(s64)size_of(GpuTexture)+
  gpu.bindings.capacity*cast(s64)size_of(GpuBindingCheck))
 if gpu.framebuffer!=0 {r.framebuffers+=1;r.renderbuffers+=2;r.gpu_bytes+=cast(s64)gpu.width*gpu.height*32}
 if gpu.resolve!=0 {r.framebuffers+=1;r.textures+=1;r.gpu_bytes+=cast(s64)gpu.width*gpu.height*4}
 if gpu.straight_framebuffer!=0 {r.framebuffers+=1;r.textures+=1;r.gpu_bytes+=cast(s64)gpu.width*gpu.height*4}
 if gpu.dfg!=0 {r.textures+=1;r.gpu_bytes+=2048}
 if gpu.buffer!=0 {r.buffers+=1;r.gpu_bytes+=gpu.vertices.count*cast(s64)size_of(GpuVertex)}
 r.cpu_bytes+=4*(gpu.indexed.indices.capacity+gpu.indexed.scratch.capacity)+gpu.node_skin.capacity*4+gpu.skins.capacity*cast(s64)size_of(GpuSkin)
 r.cpu_bytes+=gpu.indexed.skin.capacity*cast(s64)size_of(SkinAttribute)
 if gpu.indexed.attributes!=0 {r.buffers+=1;r.gpu_bytes+=gpu.indexed.vertex_count*44}
 if gpu.indexed.skin_attributes!=0 {r.buffers+=1;r.gpu_bytes+=gpu.indexed.skin.count*cast(s64)size_of(SkinAttribute)}
 for at:0..gpu.skins.count-1 {if gpu.skins[at].texture!=0 {r.textures+=1;r.gpu_bytes+=cast(s64)gpu.skins[at].bones*96};r.cpu_bytes+=gpu.skins[at].uniform.capacity*4}
 if gpu.indexed.elements!=0 {r.buffers+=1;r.gpu_bytes+=gpu.indexed.indices.count*4}
 for at:0..1 {
  slot:=gpu.transfers[at]
  if slot.buffer!=0 {r.buffers+=1;r.gpu_bytes+=slot.bytes}
  if slot.framebuffer!=0 {r.framebuffers+=1;r.textures+=1;r.gpu_bytes+=slot.bytes}
  if slot.fence!=null {r.fences+=1;r.pending_frames+=1}
 }
 if gpu.shadow_program!=0 {r.programs+=1}
 if gpu.straight_program!=0 {r.programs+=1}
 for at: 0..gpu.programs.count-1 {if gpu.programs[at].id!=0 {r.programs+=1}}
 for at: 0..gpu.textures.count-1 {
  t:=*gpu.textures[at];r.cpu_bytes+=t.bytes.capacity
  if t.id!=0 {r.textures+=1;r.gpu_bytes+=cast(s64)t.width*t.height*4}
 }
 for at: 0..3 {s:=gpu.shadows[at];if s.texture!=0 {r.textures+=1;r.framebuffers+=1;r.gpu_bytes+=cast(s64)s.size*s.size*4}}
 return r
}

} else {
// No surfaceless EGL context on the web: probing reports the GPU unavailable,
// rendering asks RenderScene, and nothing GPU-side is ever held.
SceneGpuProbe :: (gpu: *SceneGpuContext)->SceneGpuCapabilities {
 gpu.attempted=true
 gpu.capabilities.diagnostic="no GPU scene renderer on the web"
 gpu.capabilities.async_diagnostic=gpu.capabilities.diagnostic
 return gpu.capabilities
}
SceneGpuResize :: (gpu: *SceneGpuContext,width: s32,height: s32)->bool { unused gpu; unused width; unused height; return false }
SceneGpuRender :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,image: *Image)->SceneGpuFrame {
 unused scene; unused camera; unused image
 return SceneGpuFrame.{.diagnostic=SceneGpuProbe(gpu).diagnostic}
}
SceneGpuSubmit :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32,request_id: u64)->SceneGpuAsyncResult {
 unused scene; unused camera; unused width; unused height; unused request_id
 return SceneGpuAsyncResult.{.diagnostic=SceneGpuProbe(gpu).diagnostic}
}
SceneGpuPoll :: (gpu: *SceneGpuContext,image: *Image)->SceneGpuAsyncResult {
 unused image
 return SceneGpuAsyncResult.{.diagnostic=SceneGpuProbe(gpu).diagnostic}
}
SceneGpuCancel :: (gpu: *SceneGpuContext) { unused gpu }
SceneGpuRenderOrCPU :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,image: *Image)->SceneGpuFrame {
 unused gpu
 result: SceneGpuFrame
 result.ok=RenderScene(scene,camera,image)
 return result
}
SceneGpuRelease :: (gpu: *SceneGpuContext) { gpu.attempted=false }
SceneGpuAdoptWindow :: (gpu: *SceneGpuContext,display: *void,context: *void,surface: *void) { unused gpu; unused display; unused context; unused surface }
SceneGpuWindowLost :: (gpu: *SceneGpuContext) { unused gpu }
SceneGpuRenderWindow :: (gpu: *SceneGpuContext,scene: *Scene,camera: SceneCamera,width: s32,height: s32)->SceneGpuFrame {
 unused gpu; unused scene; unused camera; unused width; unused height
 return SceneGpuFrame.{.diagnostic="no GPU scene renderer on the web"}
}
SceneGpuMemoryUsage :: (gpu: *SceneGpuContext)->SceneGpuResources { return gpu.resources }
}
#scope_file
#if OS != .WEB || #defined(KRYON_WEBGL2) {
Timer :: #import "std/timer_linux";
Now :: () -> float64 { return cast(float64)Timer.MonotonicNanoseconds() / 1000000.0 }
#if OS != .WEB {
// GL_TIMESTAMP queries measure the GPU execution of a frame. The ES 3.1
// entry points resolve through EGL once per process; without them the
// window path reports no GPU time.
QueryCounterProc :: #type (id: u32, target: u32) #c_call;
QueryObjectProc :: #type (id: u32, pname: u32, params: *u64) #c_call;
query_counter: QueryCounterProc;
query_object: QueryObjectProc;
query_counter_slot: *void;
query_object_slot: *void;
queries_resolved: bool;
TimerQueries :: () -> bool {
 if !queries_resolved {
  queries_resolved=true
  counter:=G.TimerProcAddress("glQueryCounter");object:=G.TimerProcAddress("glGetQueryObjectui64v")
  if counter!=null {unused G.CopyMemory(cast(*void)*query_counter,counter,size_of(*void));query_counter_slot=counter}
  if object!=null {unused G.CopyMemory(cast(*void)*query_object,object,size_of(*void));query_object_slot=object}
 }
 return query_counter_slot!=null&&query_object_slot!=null
}
ProbeAsync :: (gpu: *SceneGpuContext)->bool {
 buffer: u32;G.GenBuffers(1,*buffer);defer G.DeleteBuffers(1,*buffer)
 G.BindBuffer(0x88eb,buffer);defer G.BindBuffer(0x88eb,0)
 G.BufferData(0x88eb,64,null,0x88e1)
 G.BindFramebuffer(0x8d40,gpu.resolve);G.ReadPixels(0,0,4,4,0x1908,0x1401,null)
 fence:=G.FenceSync(0x9117,0)
 if fence==null {unused G.GetError();return false}
 defer G.DeleteSync(fence)
 G.Flush()
 status:=G.ClientWaitSync(fence,1,1000000000)
 if status!=0x911a&&status!=0x911c {unused G.GetError();return false}
 mapped:=G.MapBufferRange(0x88eb,0,64,1)
 if mapped==null {unused G.GetError();return false}
 return G.UnmapBuffer(0x88eb)!=0&&G.GetError()==0
}
DropTransfers :: (gpu: *SceneGpuContext) {
 pending:=false
 for at:0..1 {if gpu.transfers[at].fence!=null {pending=true}}
 if pending {G.Finish()}
 G.BindBuffer(0x88eb,0)
 for at:0..1 {
  slot:=*gpu.transfers[at]
  if slot.fence!=null {G.DeleteSync(slot.fence);gpu.resources.cancelled_frames+=1}
  if slot.buffer!=0 {G.DeleteBuffers(1,*slot.buffer)}
  if slot.framebuffer!=0 {DropReadbackTarget(*slot.framebuffer,*slot.texture)}
  slot[0]=GpuTransfer.{}
 }
}
} else {
DropTransfers :: (gpu: *SceneGpuContext) {unused gpu}
}
CopyLabel :: (dest: []u8,source: *u8) { if source==null {return};for i: 0..dest.count-2 {if source[i]==0 {return};dest[i]=source[i]} }
// ES permits implementation-dependent shadow filtering. Use the hardware
// comparison only when its bilinear result agrees with the reference.
ProbePCF :: (gpu: *SceneGpuContext)->bool {
 program:=LoadSceneProgram(gpu,GpuProbeVertex,GpuProbeFragment)
 if program==0 {return false}
 defer G.DeleteProgram(program)
 depths: [4]float32=.[0.25,0.75,0.75,0.25]
 G.ActiveTexture(0x84c0)
 texture:=G.Texture(2,2,0x8cac,0x1902,0x1406,cast(*void)*depths[0],true)
 defer G.DeleteTextures(1,*texture)
 G.TexParameter(0x0de1,0x884c,0x884e);G.TexParameter(0x0de1,0x884d,0x0203)
 G.BindFramebuffer(0x8d40,gpu.framebuffer);G.Viewport(0,0,4,4)
 G.Disable(0x0b71);G.Disable(0x0be2);G.Disable(0x0b44)
 G.UseProgram(program);G.Uniform1i(G.Location(program,"depthMap"),0)
 G.DrawArrays(4,0,3)
 G.BindFramebuffer(0x8ca8,gpu.framebuffer);G.BindFramebuffer(0x8ca9,gpu.resolve)
 G.BlitFramebuffer(0,0,4,4,0,0,4,4,0x4000,0x2600)
 G.BindFramebuffer(0x8d40,gpu.resolve)
 G.BindBuffer(0x88eb,0)
 pixels: [64]u8;G.ReadPixels(0,0,4,4,0x1908,0x1401,cast(*void)*pixels[0])
 if G.GetError()!=0 {return false}
 expected: [4]s32=.[128,64,191,0]
 for y:0..3 {for x:0..3 {
  target:=ifx y==1 then 0 else ifx y==2 then 255 else expected[x]
  delta:=cast(s32)pixels[(y*4+x)*4]-target
  if delta < -1||delta>1 {return false}
 }}
 return true
}
// Draws one point whose color is a texel read by the vertex shader, then
// reads that point back: vertex texture fetch works only if the color arrives.
ProbeVTF :: (gpu: *SceneGpuContext)->bool {
 program:=LoadSceneProgram(gpu,GpuVTFVertex,GpuVTFVertexFragment)
 if program==0 {TraceError("vtf_program",1);return false}
 defer G.DeleteProgram(program)
 texel: [4]u8=.[200,100,50,255]
 G.ActiveTexture(0x84c0)
 texture:=G.Texture(1,1,0x8058,0x1908,0x1401,cast(*void)*texel[0],false)
 defer G.DeleteTextures(1,*texture)
 G.BindTexture(0x0de1,texture)
 G.BindFramebuffer(0x8d40,gpu.resolve);G.Viewport(0,0,4,4)
 G.Disable(0x0b71);G.Disable(0x0be2);G.Disable(0x0b44)
 G.UseProgram(program)
 at:=G.Location(program,"texel");if at>=0 {G.Uniform1i(at,0)}
 G.DrawArrays(0x0000,0,1)
 G.BindBuffer(0x88eb,0)
 pixels: [64]u8;G.ReadPixels(0,0,4,4,0x1908,0x1401,cast(*void)*pixels[0])
 if G.GetError()!=0 {TraceError("vtf_error",G.GetError());return false}
 for pixel: 0..15 {
  same:=true
  for at: 0..3 {delta:=cast(s32)pixels[pixel*4+at]-cast(s32)texel[at];if delta < -1||delta>1 {same=false}}
  if same {return true}
 }
 for pixel: 0..15 {
  if pixels[pixel*4+3]!=0 {TraceError("vtf_pixel",cast(u32)pixels[pixel*4]+(cast(u32)pixels[pixel*4+1]<<8)+(cast(u32)pixels[pixel*4+2]<<16))}
 }
 return false
}
Name :: (pattern: string,index: s64)->Text {
 b: Vec(u8)
 for at: 0..pattern.count-1 {
  if pattern[at]==37 {BuilderPrint(*b,"%",index)}
  else {unused VecPush(b,pattern[at])}
 }
 return BuilderFinish(b)
}
ValidateBindings :: (gpu: *SceneGpuContext,m: SceneMaterial)->ShaderDiagnostic {
 u:=ifx m.shader_uniforms.count>0 then *m.shader_uniforms[0] else null
 s:=ifx m.shader_samplers.count>0 then *m.shader_samplers[0] else null
 for at:0..gpu.bindings.count-1 {
  b:=gpu.bindings[at]
  if b.program==m.shader&&b.uniforms==u&&b.uniform_count==m.shader_uniforms.count&&b.samplers==s&&b.sampler_count==m.shader_samplers.count {return .{true,-1,""}}
 }
 diagnostic:=ShaderGLSLBindings(m.shader,m.shader_uniforms,m.shader_samplers)
 if diagnostic.ok {
  b: GpuBindingCheck=.{m.shader,u,m.shader_uniforms.count,s,m.shader_samplers.count}
  if !VecPush(gpu.bindings,b) {return .{false,-1,"binding cache allocation failure"}}
 }
 return diagnostic
}
CreateDFG :: (gpu: *SceneGpuContext)->bool {
 values: [512]float32;at: s32;digits: s32;bits: u16
 for character: 0..DFG_HEX.count-1 {
  code:=cast(s32)DFG_HEX[character];digit: s32=-1
  if code>=48&&code<=57 {digit=code-48}
  if code>=97&&code<=102 {digit=code-97+10}
  if digit<0 {continue}
  bits=cast(u16)((cast(s32)bits<<4)|digit);digits+=1
  if digits==4&&at<512 {
   exponent:=cast(s32)((bits>>10)&31);fraction:=cast(float64)(bits&1023)
   value:=ifx exponent==0 then fraction/1024.0*Pow(2.0,-14.0) else (1.0+fraction/1024.0)*Pow(2.0,cast(float64)(exponent-15))
   if (bits&32768)!=0 {value=-value}
   values[at]=cast(float32)value;at+=1;digits=0;bits=0
  }
 }
 gpu.dfg=G.Texture(16,16,0x8230,0x8227,0x1406,cast(*void)*values[0])
 return at==512&&G.GetError()==0
}
note_buffer: [192]u8;
trace_used: s32;
// Records which GL phase left an error flag set, so a later failure names it.
TraceError :: (label: string,code: u32) {
 if code==0 {return}
 piece: Vec(u8)
 BuilderPrint(*piece,"%=% ",label,code)
 text:=BuilderFinish(piece)
 for at: 0..text.count-1 {
  if trace_used<note_buffer.count {note_buffer[trace_used]=text[at];trace_used+=1}
 }
}
Note :: (label: string,width: s32,height: s32,stale: u32,status: u32,code: u32)->string {
 b: Vec(u8)
 BuilderPrint(*b,"% %x% status=% error=% stale=% %",label,width,height,status,code,stale,TextView(note_buffer[0:cast(s64)trace_used]))
 text:=BuilderFinish(b)
 count:=text.count
 if count>note_buffer.count {count=note_buffer.count}
 for at: 0..count-1 {note_buffer[at]=text[at]}
 return TextView(note_buffer[0:count])
}
DropTargets :: (gpu: *SceneGpuContext) {
 DropTransfers(gpu)
 G.DeleteFramebuffers(1,*gpu.framebuffer);G.DeleteFramebuffers(1,*gpu.resolve)
 G.DeleteRenderbuffers(1,*gpu.color);G.DeleteRenderbuffers(1,*gpu.depth);G.DeleteTextures(1,*gpu.resolved)
 DropReadbackTarget(*gpu.straight_framebuffer,*gpu.straight_texture)
 gpu.framebuffer=0;gpu.resolve=0;gpu.color=0;gpu.depth=0;gpu.resolved=0;gpu.width=0;gpu.height=0;gpu.samples=0
}
// The storage of the renderbuffer bound on the context with the coverage asked
// for: multisampled, or plain when one sample is wanted.
RenderbufferCoverage :: (samples: s32,format: u32,width: s32,height: s32) {
 if samples>1 {G.RenderbufferMS(0x8d41,samples,format,width,height)} else {G.RenderbufferStorage(0x8d41,format,width,height)}
}
// Whether the renderbuffer bound on the context carries the coverage asked for.
RenderbufferHasCoverage :: (samples: s32)->bool {
 if samples<=1 {return true}
 given: s32;G.GetRenderbuffer(0x8d41,0x8cab,*given)
 return given==samples
}
Resize :: (gpu: *SceneGpuContext,width: s32,height: s32,samples: s32)->bool {
 stale:=G.GetError()
 TraceError("resize",stale)
 if width<=0||height<=0||width>gpu.capabilities.max_texture_size||height>gpu.capabilities.max_texture_size {gpu.capabilities.diagnostic="target exceeds full-quality framebuffer limits";return false}
 if samples<1||samples>gpu.capabilities.max_samples {samples=gpu.capabilities.max_samples}
 if width==gpu.width&&height==gpu.height&&samples==gpu.samples {return true}
 DropTargets(gpu)
 G.GenFramebuffers(1,*gpu.framebuffer);G.BindFramebuffer(0x8d40,gpu.framebuffer)
 G.GenRenderbuffers(1,*gpu.color);G.BindRenderbuffer(0x8d41,gpu.color)
 RenderbufferCoverage(samples,0x8058,width,height)
 if !RenderbufferHasCoverage(samples) {gpu.capabilities.diagnostic=Note("color coverage unavailable",width,height,cast(u32)samples,0,G.GetError());DropTargets(gpu);return false}
 G.FramebufferRenderbuffer(0x8d40,0x8ce0,0x8d41,gpu.color)
 G.GenRenderbuffers(1,*gpu.depth);G.BindRenderbuffer(0x8d41,gpu.depth)
 RenderbufferCoverage(samples,0x81a6,width,height)
 if !RenderbufferHasCoverage(samples) {gpu.capabilities.diagnostic=Note("depth coverage unavailable",width,height,cast(u32)samples,0,G.GetError());DropTargets(gpu);return false}
 G.FramebufferRenderbuffer(0x8d40,0x8d00,0x8d41,gpu.depth)
 if G.CheckFramebuffer(0x8d40)!=0x8cd5 {gpu.capabilities.diagnostic=Note("framebuffer incomplete",width,height,stale,G.CheckFramebuffer(0x8d40),G.GetError());DropTargets(gpu);return false}
 G.GenFramebuffers(1,*gpu.resolve);G.BindFramebuffer(0x8d40,gpu.resolve)
 gpu.resolved=G.Texture(width,height,0x8058,0x1908,0x1401,null)
 G.FramebufferTexture(0x8d40,0x8ce0,0x0de1,gpu.resolved,0)
 if G.CheckFramebuffer(0x8d40)!=0x8cd5||G.GetError()!=0 {gpu.capabilities.diagnostic=Note("resolve framebuffer incomplete",width,height,stale,G.CheckFramebuffer(0x8d40),G.GetError());DropTargets(gpu);return false}
 if cast(s64)width*height*4<gpu.readback.count {VecFree(gpu.readback)}
 gpu.width=width;gpu.height=height;gpu.samples=samples;gpu.capabilities.samples=samples
 return true
}

GpuScenePart :: struct { data: *void; bytes: s64; offset: s64 }
GPU_NODES_CHANGED :: 1
GPU_VERTEX_ATTRIBUTES :: 28 // positions, normals, colors
GPU_ALL_GEOMETRY :: 127

GeometryParts :: (scene: *Scene)->[7]GpuScenePart {
 parts: [7]GpuScenePart
 parts[0]=.{ifx scene.nodes.count>0 then cast(*void)*scene.nodes[0] else null,scene.nodes.count*cast(s64)size_of(SceneNode),0}
 parts[1]=.{ifx scene.meshes.count>0 then cast(*void)*scene.meshes[0] else null,scene.meshes.count*cast(s64)size_of(SceneMesh),0}
 parts[2]=.{ifx scene.positions.count>0 then cast(*void)*scene.positions[0] else null,scene.positions.count*cast(s64)size_of(Vector3),0}
 parts[3]=.{ifx scene.normals.count>0 then cast(*void)*scene.normals[0] else null,scene.normals.count*cast(s64)size_of(Vector3),0}
 parts[4]=.{ifx scene.colors.count>0 then cast(*void)*scene.colors[0] else null,scene.colors.count*cast(s64)size_of(Vector3),0}
 parts[5]=.{ifx scene.uvs.count>0 then cast(*void)*scene.uvs[0] else null,scene.uvs.count*cast(s64)size_of(ShapePoint),0}
 parts[6]=.{ifx scene.indices.count>0 then cast(*void)*scene.indices[0] else null,scene.indices.count*4,0}
 for at: 1..6 { parts[at].offset=parts[at-1].offset+parts[at-1].bytes }
 return parts
}
GeometrySnapshot :: (gpu: *SceneGpuContext,parts: [7]GpuScenePart,frozen: bool,mask: s32)->bool {
 started:=ifx gpu.profile_enabled then Now() else 0.0
 defer {if gpu.profile_enabled {gpu.profile_snapshot_ms+=Now()-started}}
 if mask==GPU_ALL_GEOMETRY && !VecResize(gpu.snapshot,parts[6].offset+parts[6].bytes) {return false}
 for at: 0..6 {
  if (mask & (1<<cast(s32)at))==0 {continue}
  part:=parts[at]
  if part.bytes>0 {unused G.CopyMemory(cast(*void)*gpu.snapshot[part.offset],part.data,cast(usize)part.bytes)}
  gpu.snapshot_counts[at]=part.bytes
 }
 gpu.snapshot_frozen=frozen
 return true
}
GeometryChange :: (gpu: *SceneGpuContext,parts: [7]GpuScenePart,frozen: bool)->s32 {
 started:=ifx gpu.profile_enabled then Now() else 0.0
 defer {if gpu.profile_enabled {gpu.profile_compare_ms+=Now()-started}}
 for at:0..6 {if parts[at].bytes!=gpu.snapshot_counts[at] {return GPU_ALL_GEOMETRY}}
 last:=ifx gpu.snapshot_frozen&&frozen then 0 else 6
 mask: s32
 for at:0..last {
  part:=parts[at]
  if part.bytes>0 && G.CompareMemory(cast(*void)*gpu.snapshot[part.offset],part.data,cast(usize)part.bytes)!=0 {
   mask|=1<<cast(s32)at
  }
 }
 return mask
}
V3 :: (v: Vector3)->[3]float32 {return float32.[cast(float32)v.x,cast(float32)v.y,cast(float32)v.z]}
ColorEqual :: (a: Color,b: Color)->bool {return a.r==b.r&&a.g==b.g&&a.b==b.b&&a.a==b.a}
MaterialEqual :: (a: SceneMaterial,b: SceneMaterial)->bool {
 // Native record padding is unspecified and must never determine batching.
 // Borrowed bindings require identity, not merely equal current values: their
 // contents can change independently without rebuilding the geometry.
 if a.kind!=b.kind||!ColorEqual(a.color,b.color)||a.roughness!=b.roughness||a.metalness!=b.metalness||
  !ColorEqual(a.glow,b.glow)||a.glow_strength!=b.glow_strength||a.opacity!=b.opacity||
  a.transparent!=b.transparent||a.double_sided!=b.double_sided||a.flat!=b.flat||a.vertex_colors!=b.vertex_colors||
  a.texture!=b.texture||a.texture_projection!=b.texture_projection||a.texture_filter!=b.texture_filter||
  a.texture_wrap!=b.texture_wrap||a.texture_scale.x!=b.texture_scale.x||a.texture_scale.y!=b.texture_scale.y||
  a.texture_offset.x!=b.texture_offset.x||a.texture_offset.y!=b.texture_offset.y||
  a.alpha_test!=b.alpha_test||a.exact_color!=b.exact_color||a.shader!=b.shader||
  a.shader_uniforms.count!=b.shader_uniforms.count||a.shader_samplers.count!=b.shader_samplers.count {return false}
 if a.shader_uniforms.count>0&&*a.shader_uniforms[0]!=*b.shader_uniforms[0] {return false}
 if a.shader_samplers.count>0&&*a.shader_samplers[0]!=*b.shader_samplers[0] {return false}
 return true
}
// One node's triangles in world space, written into gpu.vertices from FIRST
// on (appended where FIRST is past the end). Returns how many vertices, or -1.
BakeNode :: (gpu: *SceneGpuContext,scene: *Scene,node: SceneNode,matrix: M.GpuMatrix,first: s32)->s32 {
 if node.mesh<0||node.mesh>=scene.meshes.count {return -1}
 mesh:=scene.meshes[node.mesh];normal:=M.NormalMatrix(matrix)
 count:=ifx mesh.index_count>0 then mesh.index_count else mesh.vertex_count
 if count<0||mesh.first_vertex<0||mesh.vertex_count<0||mesh.first_vertex+mesh.vertex_count>scene.positions.count {return -1}
 if scene.normals.count!=scene.positions.count||scene.colors.count!=scene.positions.count||scene.uvs.count!=scene.positions.count {return -1}
 if mesh.index_count>0&&(mesh.first_index<0||mesh.first_index+count>scene.indices.count) {return -1}
 mirrored:=M.Determinant3(matrix)<0.0
 write:=cast(s64)first
 corner: s32
 while corner+2<count {
  p: [3]Vector3;n: [3]Vector3;c: [3]Vector3;uv: [3]ShapePoint
  for lane: 0..2 {
   index:=mesh.first_vertex+corner+cast(s32)lane
   if mesh.index_count>0 {index=mesh.first_vertex+scene.indices[mesh.first_index+corner+lane]}
   if index<mesh.first_vertex||index>=mesh.first_vertex+mesh.vertex_count {return -1}
   p[lane]=M.Point(matrix,scene.positions[index]);n[lane]=M.Normalize(M.Direction(normal,scene.normals[index]))
   c[lane]=scene.colors[index]
   uv[lane]=SceneTextureCoordinate(mesh.material,scene.positions[index],scene.normals[index],scene.uvs[index])
  }
  face:=M.Normalize(M.Cross(M.Sub(p[1],p[0]),M.Sub(p[2],p[0])))
  for lane: 0..2 {
   at0:=ifx mirrored&&lane>0 then 3-lane else lane
   vertex: GpuVertex=.{V3(p[at0]),V3(n[at0]),V3(c[at0]),float32.[cast(float32)uv[at0].x,cast(float32)uv[at0].y],V3(face)}
   if write<gpu.vertices.count {gpu.vertices[write]=vertex}
   else if !VecPush(gpu.vertices,vertex) {return -1}
   write+=1
  }
  corner+=3
 }
 return cast(s32)(write-cast(s64)first)
}
MatrixSame :: (a: M.GpuMatrix,b: M.GpuMatrix)->bool {
 for at: 0..15 {if a.m[at]!=b.m[at] {return false}}
 return true
}
MeshIndexed :: (mesh: SceneMesh)->bool {return mesh.index_count>0&&!mesh.material.flat}

IndexNode :: (gpu: *SceneGpuContext,scene: *Scene,mesh: SceneMesh,matrix: M.GpuMatrix)->s32 {
 count:=mesh.index_count/3*3
 base:=gpu.indexed.vertex_count
 if mesh.first_vertex<0||mesh.vertex_count<0||cast(s64)mesh.first_vertex+mesh.vertex_count>scene.positions.count||
  mesh.first_index<0||cast(s64)mesh.first_index+mesh.index_count>scene.indices.count||
  base+mesh.vertex_count>2147483647||gpu.indexed.indices.count+count>2147483647 {return -1}
 mirrored:=M.Determinant3(matrix)<0.0
 for corner: 0..count-1 {
  lane:=corner%3
  source:=mesh.first_index+corner
  if mirrored&&lane!=0 {source+=3-2*lane}
  index:=scene.indices[source]
  if index<0||index>=mesh.vertex_count||!VecPush(gpu.indexed.indices,cast(u32)(base+index)) {return -1}
 }
 gpu.indexed.vertex_count+=mesh.vertex_count
 return count
}

WriteIndexedAttribute :: (gpu: *SceneGpuContext,scene: *Scene,mesh: SceneMesh,matrix: M.GpuMatrix,channel: s64,first: s64) {
 width: s32=ifx channel==3 then 2 else 3
 normal:=ifx channel==1 then M.NormalMatrix(matrix) else M.GpuMatrix.{}
 // Borrow the arrays once; mesh vertex ranges were validated before upload.
 // A 32-bit loop avoids widened multiplies for every vertex on ARM phones.
 positions:=scene.positions[:];normals:=scene.normals[:]
 colors:=scene.colors[:];uvs:=scene.uvs[:];destination:=gpu.indexed.scratch[:]
 target:=first*width
 for vertex: cast(s32)0..mesh.vertex_count-1 {
  source:=mesh.first_vertex+vertex
  if channel==3 {
   uv:=SceneTextureCoordinate(mesh.material,positions[source],normals[source],uvs[source])
   destination[target]=cast(float32)uv.x
   destination[target+1]=cast(float32)uv.y
  } else {
   value:=ifx channel==0 then M.Point(matrix,positions[source]) else ifx channel==1 then M.Normalize(M.Direction(normal,normals[source])) else colors[source]
   destination[target]=cast(float32)value.x
   destination[target+1]=cast(float32)value.y
   destination[target+2]=cast(float32)value.z
  }
  target+=width
 }
}

// Four contiguous streams let an animated pose replace positions or normals
// without sending the untouched colors, UVs or element buffer again.
UploadIndexed :: (gpu: *SceneGpuContext,scene: *Scene,mask: s32,full: bool)->bool {
 started:=ifx gpu.profile_enabled then Now() else 0.0
 defer {if gpu.profile_enabled {gpu.profile_upload_ms+=Now()-started}}
 count:=gpu.indexed.vertex_count
 if count==0 {return true}
 if !VecResize(gpu.indexed.scratch,count*3) {return false}
 if gpu.indexed.attributes==0 {G.GenBuffers(1,*gpu.indexed.attributes)}
 if gpu.indexed.elements==0 {G.GenBuffers(1,*gpu.indexed.elements)}
 G.BindBuffer(0x8892,gpu.indexed.attributes)
 if full {
  G.BufferData(0x8892,count*44,null,0x88e8)
  G.BindBuffer(0x8893,gpu.indexed.elements)
  indices:=ifx gpu.indexed.indices.count>0 then cast(*void)*gpu.indexed.indices[0] else null
  G.BufferData(0x8893,gpu.indexed.indices.count*4,indices,0x88e4)
 }
 for channel: 0..3 {
  if (mask & (1<<cast(s32)channel))==0 {continue}
  width:=ifx channel==3 then 2 else 3
  for at: 0..scene.nodes.count-1 {
   node:=scene.nodes[at]
   if node.mesh<0 {continue}
   mesh:=scene.meshes[node.mesh]
   if !MeshIndexed(mesh) {continue}
   WriteIndexedAttribute(gpu,scene,mesh,NodeMatrix(gpu,scene,at),channel,cast(s64)gpu.node_first[at])
  }
  G.BufferSubData(0x8892,channel*count*12,count*width*4,cast(*void)*gpu.indexed.scratch[0])
 }
 return G.GetError()==0
}

// Compare only this mesh's source range before regenerating its GPU stream.
// GPU skins and hidden wardrobe meshes retain their bind vertices while a
// contact solver changes a small CPU-posed part of the same Scene.
IndexedSourceChanged :: (gpu: *SceneGpuContext,part: GpuScenePart,mesh: SceneMesh,channel: s64)->bool {
 stride:=ifx channel==3 then cast(s64)size_of(ShapePoint) else cast(s64)size_of(Vector3)
 offset:=cast(s64)mesh.first_vertex*stride
 bytes:=cast(s64)mesh.vertex_count*stride
 if bytes==0 {return false}
 current:=cast(*u8)part.data
 return G.CompareMemory(cast(*void)*gpu.snapshot[part.offset+offset],cast(*void)*current[offset],cast(usize)bytes)!=0
}

UpdateIndexed :: (gpu: *SceneGpuContext,scene: *Scene,parts: [7]GpuScenePart,change: s32)->bool {
 if (change&GPU_NODES_CHANGED)!=0&&!OnlyMoved(gpu,scene) {return false}
 started:=ifx gpu.profile_enabled then Now() else 0.0
 defer {if gpu.profile_enabled {gpu.profile_upload_ms+=Now()-started}}
 count:=gpu.indexed.vertex_count
 if !VecResize(gpu.indexed.scratch,count*3) {return false}
 G.BindBuffer(0x8892,gpu.indexed.attributes)
 sent: s64
 for at: 0..scene.nodes.count-1 {
  node:=scene.nodes[at]
  matrix:=M.Compose(node.position,node.rotation,node.scale)
  if node.parent>=0 {matrix=M.Multiply(gpu.node_world[node.parent],matrix)}
  previous:=gpu.node_world[at]
  moved:=!MatrixSame(matrix,previous)
  gpu.node_world[at]=matrix
  if moved {
   for d: 0..gpu.draws.count-1 {if gpu.draws[d].node==cast(s32)at {gpu.draws[d].origin=M.Point(matrix,.{})}}
  }
  if node.mesh<0 {continue}
  mesh:=scene.meshes[node.mesh]
  if !MeshIndexed(mesh) {
   if moved {return false}
   for channel: 0..2 {
    if (change&(1<<cast(s32)(channel+2)))!=0&&IndexedSourceChanged(gpu,parts[channel+2],mesh,channel) {return false}
   }
   continue
  }
  if moved&&(M.Determinant3(matrix)<0.0)!=(M.Determinant3(previous)<0.0) {return false}
  changed: [4]bool
  for channel: 0..3 {
   if (change&(1<<cast(s32)(channel+2)))!=0 {
    changed[channel]=IndexedSourceChanged(gpu,parts[channel+2],mesh,channel)
   }
  }
  if mesh.material.texture_projection==.SceneTextureBox&&(changed[0]||changed[1]) {changed[3]=true}
  if moved&&!NodeSkinned(gpu,scene,at) {changed[0]=true;changed[1]=true}
  wrote:=false
  for channel: 0..3 {
   if !changed[channel] {continue}
   width:=ifx channel==3 then 2 else 3
   WriteIndexedAttribute(gpu,scene,mesh,NodeMatrix(gpu,scene,at),channel,0)
   offset:=channel*count*12+cast(s64)gpu.node_first[at]*width*4
   G.BufferSubData(0x8892,offset,cast(s64)mesh.vertex_count*width*4,cast(*void)*gpu.indexed.scratch[0])
   wrote=true
  }
  if wrote {sent+=mesh.vertex_count}
 }
 if G.GetError()!=0||!GeometrySnapshot(gpu,parts,scene.geometry_frozen,change) {return false}
 gpu.resources.geometry_uploads+=1
 gpu.resources.geometry_vertices+=sent
 return true
}
// The changed node records only moved nodes: every node keeps its parent, its
// mesh, whether it is shown and how it takes part in shadows, so the batches
// made from them still hold.
// The palette that poses the vertices of MESH on the GPU, or -1.
SkinPaletteForMesh :: (scene: *Scene,mesh: s32)->s32 {
 for at: 0..scene.skins.count-1 {
  if scene.skins[at].mesh==mesh&&scene.skins[at].joint_count>0 {return cast(s32)at}
 }
 return -1
}
// The mesh of a node is posed on the GPU: its vertices in the buffers keep the
// bind pose and the vertex shader places them through the matrix of the node.
NodeSkinned :: (gpu: *SceneGpuContext,scene: *Scene,at: s64)->bool {
 if at>=gpu.node_skin.count {return false}
 skin:=gpu.node_skin[at]
 return skin>=0&&skin<scene.skins.count&&scene.skins[skin].active
}
NodeMatrix :: (gpu: *SceneGpuContext,scene: *Scene,at: s64)->M.GpuMatrix {
 if NodeSkinned(gpu,scene,at) {return M.Identity()}
 return gpu.node_world[at]
}
// Every indexed vertex gets its skin record in the order of the vertex stream,
// so the element buffer addresses it like the vertices. A mesh without a
// palette gets blank records.
PackSkin :: (gpu: *SceneGpuContext,scene: *Scene,mesh: SceneMesh,skin: s32)->bool {
 if scene.skins.count==0 {return true}
 empty: SkinAttribute
 if mesh.vertex_count<0 {return false}
 if skin<0 {
  for vertex: 0..mesh.vertex_count-1 {if !VecPush(gpu.indexed.skin,empty) {return false}}
  return true
 }
 palette:=*scene.skins[skin]
 if palette.attributes.count<mesh.vertex_count {return false}
 for vertex: 0..mesh.vertex_count-1 {if !VecPush(gpu.indexed.skin,palette.attributes[vertex]) {return false}}
 return true
}
// A palette that starts or stops posing on the GPU changes what the vertex
// buffers must hold, the bind pose or posed vertices: that frame rebuilds them.
SkinsChanged :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 for at: 0..scene.skins.count-1 {
  live:=scene.skins[at].mesh>=0&&scene.skins[at].active
  if at>=gpu.skins.count||gpu.skins[at].active!=live {return true}
 }
 return false
}
DropSkin :: (s: *GpuSkin) {
 if s.texture!=0 {G.DeleteTextures(1,*s.texture)}
 VecFree(s.uniform)
 s.texture=0;s.bones=0;s.version=0;s.active=false;s.dual=false;s.uploaded=false;s.rows=0;s.alias=0
}
// Keeps every palette on the GPU: the rows each joint uses packed into a
// uniform array, or a texture six texels wide with one row per joint, sent on
// texture unit 15. Every new pose is sent once; the palettes of one glTF skin
// share one send.
PrepareSkins :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 for at: gpu.skins.count..scene.skins.count-1 {
  empty: GpuSkin
  if !VecPush(gpu.skins,empty) {return false}
 }
 for at: 0..gpu.skins.count-1 {
  s:=*gpu.skins[at]
  if at>=scene.skins.count||scene.skins[at].mesh<0||scene.skins[at].joint_count<=0 {DropSkin(s);continue}
  p:=*scene.skins[at]
  texture:=PaletteUsesTexture(gpu,p)
  rows:=BoneRows(texture,p.dual_quaternion)
  fits:=ifx texture then p.joint_count<=gpu.capabilities.max_texture_size else gpu.skin_uniform_vectors>=64
  s.active=p.active
  if !fits {DropSkin(s);continue}
  if s.uploaded&&s.version==p.version {continue}
  // The primitives of one glTF skin pose the same joints: the first palette
  // of that skin holds them and the others name it. Palettes without a source
  // share only when their floats are identical.
  s.alias=cast(s32)at
  for prior: 0..at-1 {
   q:=*gpu.skins[prior]
   if !q.uploaded||!q.active||q.bones!=p.joint_count||q.rows!=rows||q.dual!=p.dual_quaternion||(q.texture!=0)!=texture||q.version<p.version {continue}
   shared:=p.source>=0||scene.skins[prior].source>=0
   if shared {shared=p.source==scene.skins[prior].source} else if p.values.count>0&&scene.skins[prior].values.count==p.values.count {
    shared=G.CompareMemory(cast(*void)*scene.skins[prior].values[0],cast(*void)*p.values[0],cast(usize)(p.values.count*4))==0
   }
   if shared {s.alias=cast(s32)prior;break}
  }
  // A palette that follows another of its source has no rows to send: without
  // that palette it waits in the bind pose.
  if s.alias==at&&p.follows {DropSkin(s);continue}
  s.bones=p.joint_count;s.rows=rows;s.dual=p.dual_quaternion;s.version=p.version;s.uploaded=true
  if s.alias!=at {continue}
  if (s.texture!=0)!=texture||(s.texture==0&&s.uniform.count!=cast(s64)p.joint_count*rows*4) {
   // Another storage or joint count: only the storage goes. The palette
   // stays live, so its followers find it and the vertex buffers keep.
   if texture {
    G.ActiveTexture(0x84cf)
    // Six texels wide, one row per joint: the palette's joint-major floats
    // upload as they are and the vertex shader reads texel (row, joint).
    if s.texture!=0 {G.DeleteTextures(1,*s.texture);s.texture=0}
    s.texture=G.Texture(6,p.joint_count,0x8814,0x1908,0x1406,null)
   } else if !VecResize(s.uniform,cast(s64)p.joint_count*rows*4) {DropSkin(s);return false}
  }
  if s.texture!=0 {
   G.ActiveTexture(0x84cf);G.BindTexture(0x0de1,s.texture)
   G.TexSubImage(0x0de1,0,0,0,6,s.bones,0x1908,0x1406,cast(*void)*p.values[0])
  } else {
   // Dual quaternions keep rows 0-1 of a joint, linear blend skinning 0-2.
   for joint: 0..s.bones-1 {
    source:=cast(s64)joint*24;target:=cast(s64)joint*cast(s64)s.rows*4
    for value: 0..s.rows*4-1 {s.uniform[target+value]=p.values[source+value]}
   }
  }
  s.version=p.version;s.uploaded=true;gpu.resources.skin_uploads+=1
 }
 return G.GetError()==0
}
OnlyMoved :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 if gpu.node_first.count!=scene.nodes.count||gpu.node_world.count!=scene.nodes.count||gpu.node_shown.count!=scene.nodes.count {return false}
 kept:=cast(*SceneNode)cast(*void)*gpu.snapshot[0]
 for at: 0..scene.nodes.count-1 {
  node:=scene.nodes[at];before:=kept[at]
  if node.parent>=at||node.parent!=before.parent||node.mesh!=before.mesh||node.cast_shadow!=before.cast_shadow||
   node.receive_shadow!=before.receive_shadow||node.visible!=before.visible {return false}
 }
 return true
}
// Re-makes and sends only the vertices of nodes that moved.
UpdateMoved :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 size:=cast(s64)size_of(GpuVertex)
 sent: s64
 for at: 0..scene.nodes.count-1 {
  node:=scene.nodes[at];matrix:=M.Compose(node.position,node.rotation,node.scale)
  if node.parent>=0 {matrix=M.Multiply(gpu.node_world[node.parent],matrix)}
  previous:=gpu.node_world[at]
  if MatrixSame(matrix,previous) {continue}
  gpu.node_world[at]=matrix
  if node.mesh<0 {continue}
  first:=gpu.node_first[at]
  mesh:=scene.meshes[node.mesh]
  if MeshIndexed(mesh) {
   // Crossing zero scale can flip winding and requires new elements.
   if (M.Determinant3(matrix)<0.0)!=(M.Determinant3(previous)<0.0) {return false}
   if mesh.vertex_count>0&&!NodeSkinned(gpu,scene,at) {
    G.BindBuffer(0x8892,gpu.indexed.attributes)
    for channel: 0..1 {
     WriteIndexedAttribute(gpu,scene,mesh,matrix,channel,0)
     offset:=(channel*gpu.indexed.vertex_count+cast(s64)first)*12
     G.BufferSubData(0x8892,offset,cast(s64)mesh.vertex_count*12,cast(*void)*gpu.indexed.scratch[0])
    }
    sent+=mesh.vertex_count
   }
  } else {
   if BakeNode(gpu,scene,node,matrix,first)!=gpu.node_count[at] {return false}
   if gpu.node_count[at]>0 {
    G.BindBuffer(0x8892,gpu.buffer)
    G.BufferSubData(0x8892,cast(s64)first*size,cast(s64)gpu.node_count[at]*size,cast(*void)*gpu.vertices[first])
    sent+=gpu.node_count[at]
   }
  }
  // A blended mesh is sorted by where its node stands.
  for d: 0..gpu.draws.count-1 {if gpu.draws[d].node==cast(s32)at {gpu.draws[d].origin=M.Point(matrix,.{})}}
 }
 if G.GetError()!=0 {return false}
 if scene.nodes.count>0 {unused G.CopyMemory(cast(*void)*gpu.snapshot[0],cast(*void)*scene.nodes[0],cast(usize)(scene.nodes.count*cast(s64)size_of(SceneNode)))}
 gpu.resources.geometry_uploads+=1
 gpu.resources.geometry_vertices+=sent
 return true
}
PrepareGeometry :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 parts:=GeometryParts(scene)
 if gpu.geometry_valid {
  change:=GeometryChange(gpu,parts,scene.geometry_frozen)
  if change==0 {return true}
  // Most frames that change anything only move a node: a door swings, a leaf
  // sways. Those replace the moved nodes' triangles and nothing else.
  if change==GPU_NODES_CHANGED&&OnlyMoved(gpu,scene)&&UpdateMoved(gpu,scene) {return true}
  if gpu.indexed.vertex_count>0&&(change&(GPU_VERTEX_ATTRIBUTES|GPU_NODES_CHANGED))==change&&UpdateIndexed(gpu,scene,parts,change) {return true}
 }
 gpu.geometry_valid=false
 if scene.normals.count!=scene.positions.count||scene.colors.count!=scene.positions.count||scene.uvs.count!=scene.positions.count {return false}
 VecClear(gpu.vertices);VecClear(gpu.draws)
 VecClear(gpu.indexed.indices);gpu.indexed.vertex_count=0;VecClear(gpu.indexed.skin)
 VecClear(gpu.node_first);VecClear(gpu.node_count);VecClear(gpu.node_world);VecClear(gpu.node_shown);VecClear(gpu.node_skin)
 for at: 0..scene.nodes.count-1 {
  node:=scene.nodes[at];matrix:=M.Compose(node.position,node.rotation,node.scale);visible:=node.visible
  if node.parent>=0 {
   if node.parent>=at {return false}
   matrix=M.Multiply(gpu.node_world[node.parent],matrix);visible=visible&&gpu.node_shown[node.parent]
  }
  first:=cast(s32)gpu.vertices.count
  if !VecPush(gpu.node_world,matrix)||!VecPush(gpu.node_shown,visible)||!VecPush(gpu.node_first,first)||!VecPush(gpu.node_count,0) {return false}
  skin: s32 = -1
  if node.mesh>=0 {
   if node.mesh>=scene.meshes.count {return false}
   skin=SkinPaletteForMesh(scene,node.mesh)
  }
  if !VecPush(gpu.node_skin,skin) {return false}
  if node.mesh<0 {continue}
  mesh:=scene.meshes[node.mesh]
  indexed:=MeshIndexed(mesh)
  count: s32
  if indexed {
   gpu.node_first[at]=cast(s32)gpu.indexed.vertex_count
   first=cast(s32)gpu.indexed.indices.count
   count=IndexNode(gpu,scene,mesh,matrix)
   if !PackSkin(gpu,scene,mesh,skin) {return false}
  } else {count=BakeNode(gpu,scene,node,matrix,first)}
  if count<0 {return false}
  gpu.node_count[at]=count
  draw: GpuDraw=.{first,count,node.mesh,cast(s32)at,node.receive_shadow,node.cast_shadow,visible,M.Point(matrix,.{}),skin}
  merged:=false
  if gpu.draws.count>0&&!mesh.material.transparent {
   last:=*gpu.draws[gpu.draws.count-1];other_mesh:=scene.meshes[last.mesh];other:=other_mesh.material
   // Only draws posed alike batch into one.
   if MeshIndexed(other_mesh)==indexed&&!other.transparent&&last.receive==draw.receive&&last.cast_shadow==draw.cast_shadow&&last.shown==draw.shown&&
    last.skin==draw.skin&&MaterialEqual(other,mesh.material) {
    last.count+=draw.count;merged=true
   }
  }
  if !merged&&!VecPush(gpu.draws,draw) {return false}
 }
 G.BindBuffer(0x8892,gpu.buffer)
 G.BufferData(0x8892,gpu.vertices.count*cast(s64)size_of(GpuVertex),(ifx gpu.vertices.count>0 then cast(*void)*gpu.vertices[0] else null),0x88e8)
 if gpu.indexed.vertex_count==0&&gpu.indexed.attributes!=0 {
  G.DeleteBuffers(1,*gpu.indexed.attributes);gpu.indexed.attributes=0
  G.DeleteBuffers(1,*gpu.indexed.elements);gpu.indexed.elements=0
 }
 if gpu.skin_bound {DisableSkin(gpu)}
 if gpu.indexed.skin.count>0 {
  if gpu.indexed.skin_attributes==0 {G.GenBuffers(1,*gpu.indexed.skin_attributes)}
  G.BindBuffer(0x8892,gpu.indexed.skin_attributes)
  G.BufferData(0x8892,gpu.indexed.skin.count*cast(s64)size_of(SkinAttribute),cast(*void)*gpu.indexed.skin[0],0x88e4)
 } else if gpu.indexed.skin_attributes!=0 {
  G.DeleteBuffers(1,*gpu.indexed.skin_attributes);gpu.indexed.skin_attributes=0
 }
 if G.GetError()!=0||!UploadIndexed(gpu,scene,15,true)||!GeometrySnapshot(gpu,parts,scene.geometry_frozen,GPU_ALL_GEOMETRY) {return false}
 gpu.resources.geometry_uploads+=1
 gpu.resources.geometry_vertices+=gpu.vertices.count+gpu.indexed.vertex_count
 gpu.geometry_valid=true
 return true
}
BindVertices :: (gpu: *SceneGpuContext) {
 gpu.indexed.bound=false
 if gpu.skin_bound {DisableSkin(gpu)}
 G.BindBuffer(0x8892,gpu.buffer)
 offsets: [5]s64=.[0,12,24,36,44]
 for at: 0..4 {
  G.EnableAttribute(cast(u32)at)
  G.AttributePointer(cast(u32)at,ifx at==3 then 2 else 3,0x1406,0,cast(s32)size_of(GpuVertex),cast(*void)offsets[at])
 }
}
DisableSkin :: (gpu: *SceneGpuContext) {
 G.DisableAttribute(5);G.DisableAttribute(6)
 gpu.skin_bound=false
}
// 0 when the vertices of a draw are posed already, or are world space; 1 or 2
// is the mode of its palette, which the vertex shader reads.
DrawSkinMode :: (gpu: *SceneGpuContext,scene: *Scene,draw: GpuDraw)->s32 {
 if draw.skin<0||draw.skin>=scene.skins.count||draw.skin>=gpu.skins.count {return 0}
 if !scene.skins[draw.skin].active||!gpu.skins[draw.skin].uploaded {return 0}
 return ifx gpu.skins[draw.skin].dual then 2 else 1
}
// The skin uniforms of the shared vertex shader PROGRAM for one draw: the
// palette texture on unit 15, or the packed rows sent once per program and
// pose. The palette the draw's skin names holds the data.
BindSkinAt :: (gpu: *SceneGpuContext,scene: *Scene,draw: GpuDraw,program: u32,mode: s32,model: s32,bones: s32,bones_texture: s32,bones_in_texture: s32,stride: s32) {
 skin_mode:=DrawSkinMode(gpu,scene,draw)
 G.Uniform1i(mode,skin_mode)
 if skin_mode==0 {return}
 MatrixAt(model,gpu.node_world[draw.node])
 root:=gpu.skins[draw.skin].alias
 s:=*gpu.skins[root]
 if s.texture!=0 {G.Uniform1i(bones_texture,15);BindTexture(15,s.texture);G.Uniform1i(bones_in_texture,1);return}
 G.Uniform1i(bones_in_texture,0)
 if gpu.skin_uniform_program!=program||gpu.skin_uniform_index!=root||gpu.skin_uniform_version!=s.version {
  G.Uniform1i(stride,s.rows)
  G.Uniform4fv(bones,s.bones*s.rows,*s.uniform[0])
  gpu.skin_uniform_program=program;gpu.skin_uniform_index=root;gpu.skin_uniform_version=s.version
 }
}
DrawGeometry :: (gpu: *SceneGpuContext,scene: *Scene,mesh: SceneMesh,draw: GpuDraw) {
 if draw.count==0 {return}
 if !MeshIndexed(mesh) {
  if gpu.indexed.bound||gpu.skin_bound {BindVertices(gpu)}
  G.DrawArrays(4,draw.first,draw.count)
  return
 }
 if !gpu.indexed.bound {
  gpu.indexed.bound=true
  G.BindBuffer(0x8892,gpu.indexed.attributes)
  G.BindBuffer(0x8893,gpu.indexed.elements)
  for at: 0..4 {
   width: s32=ifx at==3 then 2 else 3
   // Smooth shaders ignore the face normal. Give the attribute a valid
   // range for platforms that validate all enabled vertex arrays.
   channel:=ifx at==4 then 1 else at
   G.AttributePointer(cast(u32)at,width,0x1406,0,0,cast(*void)(channel*gpu.indexed.vertex_count*12))
  }
 }
 // A posed draw reads its joints and weights from the skin stream next to
 // the vertices; every other draw leaves those arrays off.
 skinned:=DrawSkinMode(gpu,scene,draw)!=0
 if skinned&&!gpu.skin_bound {
  gpu.skin_bound=true
  weights_offset: s64 = 8
  G.BindBuffer(0x8892,gpu.indexed.skin_attributes)
  G.EnableAttribute(5);G.AttributePointer(5,4,0x1403,0,24,null)
  G.EnableAttribute(6);G.AttributePointer(6,4,0x1406,0,24,cast(*void)weights_offset)
 } else if !skinned&&gpu.skin_bound {DisableSkin(gpu)}
 G.DrawElements(4,draw.count,0x1405,cast(s64)draw.first*4)
}
// A finite set of exact branches, never quantized material values. Binding
// contents remain uniforms and the source-program snapshot still invalidates
// every variant independently. Sweep releases variants unused by this frame.
MaterialFeatures :: (m: SceneMaterial,perspective: bool)->s32 {
 kind:=cast(s32)m.kind
 if kind>1 {return 4}
 features: s32=ifx kind==1 then 2 else 0
 if m.vertex_colors {features=features | 8}
 // Unlit shaders receive the original world normal. The view-space lighting
 // flags only specialize lit programs, and flat shading takes precedence.
 if kind==1 {return features}
 if m.metalness==0.0 {features=features | 1}
 if m.flat {features=features | 16}
 else if m.double_sided {features=features | 32}
 if perspective {features=features | 64}
 return features
}
ShadowFeatures :: (scene: *Scene)->s32 {
 features: s32
 for at: 0..3 {
  if at<scene.lights.count&&scene.lights[at].shadow&&scene.lights[at].shadow_size>0 {
   features=features|cast(s32)(1<<(7+at))
  }
 }
 return features
}
LoadSceneProgram :: (gpu: *SceneGpuContext,vertex: string,fragment: string,scene_vertex: bool=false)->u32 {
 #if OS == .ANDROID {
  shared_vertex:=ifx scene_vertex then *gpu.scene_vertex_shader else null
  return G.CachedProgram(*gpu.program_cache,vertex,fragment,gpu.log[:],shared_vertex)
 } else {
  unused scene_vertex
  return G.Program(vertex,fragment,gpu.log[:])
 }
}
SameShaderCode :: (saved: *ShaderProgram,key: *ShaderProgram)->bool {
 if saved.count!=key.count||saved.uniform_count!=key.uniform_count||saved.sampler_count!=key.sampler_count||
  saved.input_mask!=key.input_mask||saved.ready!=key.ready {return false}
 bytes:=cast(usize)saved.count*size_of(ShaderInstruction)
 return G.CompareMemory(cast(*void)*saved.code[0],cast(*void)*key.code[0],bytes)==0
}
ProgramFor :: (gpu: *SceneGpuContext,key: *ShaderProgram,features: s32)->*GpuProgram {
 slot: s64=-1
 for at: 0..gpu.programs.count-1 {
  p:=*gpu.programs[at]
  if p.id==0 {slot=at;continue}
  if p.features!=features||p.saved.ready!=(key!=null) {continue}
  if p.last_frame==gpu.program_frame&&p.key==key {return p}
  // Separately prepared rooms can own equivalent shader instructions.
  if key==null||SameShaderCode(*p.saved,key) {
   if p.last_frame!=gpu.program_frame {p.frame_uniforms_set=false}
   p.key=key;p.last_frame=gpu.program_frame
   return p
  }
 }
 code: Vec(u8);unused BuilderAppend(code,"#version 300 es\n")
 unused BuilderAppend(code,ifx gpu.capabilities.pcf_available then "#define KRYON_MANUAL_PCF 0\n" else "#define KRYON_MANUAL_PCF 1\n")
 if (features&128)!=0 {unused BuilderAppend(code,"#define KRYON_SHADOW_0\n")}
 if (features&256)!=0 {unused BuilderAppend(code,"#define KRYON_SHADOW_1\n")}
 if (features&512)!=0 {unused BuilderAppend(code,"#define KRYON_SHADOW_2\n")}
 if (features&1024)!=0 {unused BuilderAppend(code,"#define KRYON_SHADOW_3\n")}
 unused BuilderAppend(code,GpuFragmentPrefix)
 BuilderPrint(*code,"#define KRYON_KIND %.0\n",(features>>1)&3)
 BuilderPrint(*code,"#define KRYON_METALNESS %\n",ifx (features&1)!=0 then "0.0" else "material.y")
 BuilderPrint(*code,"#define KRYON_VERTEX %.0\n",(features>>3)&1)
 BuilderPrint(*code,"#define KRYON_FLAT %.0\n",(features>>4)&1)
 BuilderPrint(*code,"#define KRYON_DOUBLE %.0\n",(features>>5)&1)
 BuilderPrint(*code,"#define KRYON_PERSPECTIVE %.0\n",(features>>6)&1)
 if key!=null {
  translated:=ShaderGLSLTranslate(key)
  if !translated.diagnostic.ok {return null}
  unused BuilderAppend(code,TextView(translated.source))
 } else {unused BuilderAppend(code,"vec4 kryonMaterial(vec4 c,vec4 p,vec4 n,vec4 uv){return c;}\n")}
 unused BuilderAppend(code,GpuFragmentMain)
 source: Text=BuilderFinish(code)
 id:=LoadSceneProgram(gpu,SceneVertexSource(gpu),TextView(source),true)
 if id==0 {return null}
 // A new program number may reuse a deleted one's: the palette goes again.
 gpu.skin_uniform_program=0
 value: GpuProgram;value.key=key;value.features=features;value.id=id;value.last_frame=gpu.program_frame;value.locations=CacheLocations(gpu,id)
 if key!=null {value.saved=key[0]}
 if slot>=0 {gpu.programs[slot]=value;return *gpu.programs[slot]}
 if !VecPush(gpu.programs,value) {G.DeleteProgram(id);return null}
 return *gpu.programs[gpu.programs.count-1]
}
TextureFor :: (gpu: *SceneGpuContext,unit: s32,pixels: *u8,width: s32,height: s32,cache_key: u64=0)->u32 {
 if width<=0||height<=0||width>gpu.capabilities.max_texture_size||height>gpu.capabilities.max_texture_size {return 0}
 // Upload and refresh bind on the active unit, just like the cached draw.
 G.ActiveTexture(cast(u32)(0x84c0+unit))
 bytes:=cast(s64)width*height*4;slot: s64=-1
 for at: 0..gpu.textures.count-1 {
  t:=*gpu.textures[at]
  if t.id==0 {slot=at;continue}
  if t.key==pixels&&t.width==width&&t.height==height {
   if t.used {return t.id}
   t.used=true
   if cache_key!=0&&t.cache_key==cache_key {return t.id}
   if t.bytes.count==bytes&&G.CompareMemory((ifx t.bytes.count>0 then cast(*void)*t.bytes[0] else null),cast(*void)pixels,cast(usize)bytes)==0 {return t.id}
   upload:=ifx gpu.profile_enabled then Now() else 0.0
   G.BindTexture(0x0de1,t.id);G.TexImage(0x0de1,0,0x8058,width,height,0,0x1908,0x1401,cast(*void)pixels)
   if gpu.profile_enabled {gpu.texture_upload_ms+=Now()-upload}
   if cache_key==0 {
    if !VecResize(t.bytes,bytes) {return 0}
    unused G.CopyMemory((ifx t.bytes.count>0 then cast(*void)*t.bytes[0] else null),cast(*void)pixels,cast(usize)bytes)
   } else {VecFree(t.bytes)}
   t.cache_key=cache_key;gpu.resources.texture_uploads+=1;return t.id
  }
 }
 if slot<0 {empty: GpuTexture;if !VecPush(gpu.textures,empty) {return 0};slot=gpu.textures.count-1}
 value:=*gpu.textures[slot];value.key=pixels;value.cache_key=cache_key;value.width=width;value.height=height;value.used=true
 if cache_key==0 {
  if !VecResize(value.bytes,bytes) {return 0}
  unused G.CopyMemory(cast(*void)*value.bytes[0],cast(*void)pixels,cast(usize)bytes)
 } else {VecFree(value.bytes)}
 upload:=ifx gpu.profile_enabled then Now() else 0.0
 value.id=G.Texture(width,height,0x8058,0x1908,0x1401,cast(*void)pixels)
 if gpu.profile_enabled {gpu.texture_upload_ms+=Now()-upload}
 id:=value.id
 gpu.resources.texture_uploads+=1
 return id
}
Sweep :: (gpu: *SceneGpuContext) {
 // Keep a small number of recently used programs across room changes.
 // Programs needed by the current frame do not count against this budget.
 recent: [GPU_RECENT_PROGRAMS]*GpuProgram
 count: s32
 for at: 0..gpu.programs.count-1 {
  p:=*gpu.programs[at]
  if p.id==0 {continue}
  // The pointer accelerates lookup only while the caller's frame borrows it.
  p.key=null
  if p.last_frame==gpu.program_frame {continue}
  if count<GPU_RECENT_PROGRAMS {recent[count]=p;count+=1;continue}
  oldest: s64
  for i:1..GPU_RECENT_PROGRAMS-1 {if recent[i].last_frame<recent[oldest].last_frame {oldest=i}}
  discard:=p
  if p.last_frame>recent[oldest].last_frame {discard=recent[oldest];recent[oldest]=p}
  if gpu.skin_uniform_program==discard.id {gpu.skin_uniform_program=0}
  G.DeleteProgram(discard.id);discard.id=0
 }
 for at: 0..gpu.textures.count-1 {t:=*gpu.textures[at];if t.id!=0&&!t.used {G.DeleteTextures(1,*t.id);t.id=0;VecFree(t.bytes)}}
}
MatrixUniform :: (id: u32,name: string,matrix: M.GpuMatrix) {
 MatrixAt(G.Location(id,name),matrix)
}
MatrixAt :: (location: s32,matrix: M.GpuMatrix) {
 data: [16]float32
 for row: 0..3 {for col: 0..3 {data[col*4+row]=cast(float32)matrix.m[row*4+col]}}
 G.UniformMatrix(location,1,0,*data[0])
}
VectorUniform :: (id: u32,name: string,v: Vector3) {G.Uniform3f(G.Location(id,name),cast(float32)v.x,cast(float32)v.y,cast(float32)v.z)}
VectorAt :: (location: s32,v: Vector3) {G.Uniform3f(location,cast(float32)v.x,cast(float32)v.y,cast(float32)v.z)}
Linear :: (v: u8)->float64 {c:=cast(float64)v/255.0;return ifx c<0.04045 then c/12.92 else Pow((c+0.055)/1.055,2.4)}
LinearColor :: (v: Color)->Vector3 {return .{Linear(v.r),Linear(v.g),Linear(v.b)}}
BindTexture :: (unit: s32,id: u32) {G.ActiveTexture(cast(u32)(0x84c0+unit));G.BindTexture(0x0de1,id)}
CacheLocations :: (gpu: *SceneGpuContext,id: u32)->GpuLocations {
 l: GpuLocations
 l.vp=G.Location(id,"vp");l.view=G.Location(id,"view");l.base=G.Location(id,"base");l.glow=G.Location(id,"glow")
 l.material=G.Location(id,"material");l.flags=G.Location(id,"flags");l.settings=G.Location(id,"settings")
 l.transparent=G.Location(id,"transparent");l.albedo_size=G.Location(id,"albedoSize")
 l.albedo_sampling=G.Location(id,"albedoSampling");l.albedo=G.Location(id,"albedo")
 l.dfg=G.Location(id,"dfg");l.sky=G.Location(id,"sky");l.ground=G.Location(id,"ground");l.up=G.Location(id,"up")
 l.light_count=G.Location(id,"lightCount");l.uniforms=G.Location(id,"kryonUniforms[0]")
 l.cookie=G.Location(id,"cookie");l.cookie_matrix=G.Location(id,"cookieMatrix");l.cookie_transform=G.Location(id,"cookieTransform")
 l.cookie_size=G.Location(id,"cookieSize");l.cookie_light=G.Location(id,"cookieLight")
 l.model=G.Location(id,"kryonModel");l.skin_mode=G.Location(id,"kryonSkinMode")
 // The palette names the program lacks are -1, which the GL ignores.
 l.bones=G.Location(id,"kryonBones[0]");l.bone_stride=G.Location(id,"kryonBoneStride")
 l.bones_texture=G.Location(id,"kryonBonesTexture");l.bones_in_texture=G.Location(id,"kryonBonesInTexture")
 l.graded=G.Location(id,"graded");l.grade_tint=G.Location(id,"gradeTint");l.grade_beam_centre=G.Location(id,"gradeBeamCentre")
 l.grade_beam_u=G.Location(id,"gradeBeamU");l.grade_beam_v=G.Location(id,"gradeBeamV");l.grade_beam_normal=G.Location(id,"gradeBeamNormal")
 l.grade_beam_direction=G.Location(id,"gradeBeamDirection");l.grade_beam_color=G.Location(id,"gradeBeamColor")
 l.grade_beam_shadow=G.Location(id,"gradeBeamShadow")
 for at:0..3 {
  lamp: Text=Name("gradeLamp[%]",at);l.grade_lamp[at]=G.Location(id,TextView(lamp))
  lamp_color: Text=Name("gradeLampColor[%]",at);l.grade_lamp_color[at]=G.Location(id,TextView(lamp_color))
 }
 for at:0..3 {
  shadow: Text=Name("shadow%",at);l.shadow[at]=G.Location(id,TextView(shadow))
  settings: Text=Name("shadowSettings[%]",at);l.shadow_settings[at]=G.Location(id,TextView(settings))
  color: Text=Name("lightColor[%]",at);l.light_color[at]=G.Location(id,TextView(color))
  direction: Text=Name("lightDirection[%]",at);l.light_direction[at]=G.Location(id,TextView(direction))
  matrix: Text=Name("shadowMatrix[%]",at);l.shadow_matrix[at]=G.Location(id,TextView(matrix))
 }
 for at:0..7 {
  sampler: Text=Name("kryonSampler%",at);l.sampler[at]=G.Location(id,TextView(sampler))
  size: Text=Name("kryonSamplerSize[%]",at);l.sampler_size[at]=G.Location(id,TextView(size))
  repetition: Text=Name("kryonSamplerRepeat[%]",at);l.sampler_repeat[at]=G.Location(id,TextView(repetition))
 }
 return l
}
// The scene grade is shared by every material using this program.
GradeUniforms :: (l: *GpuLocations,g: *RenderGrade) {
 if !g.on {return}
 G.Uniform4f(l.grade_tint,cast(float32)g.tint.x,cast(float32)g.tint.y,cast(float32)g.tint.z,cast(float32)g.saturation)
 for at:0..3 {
  p:=g.lamp_position[at];G.Uniform4f(l.grade_lamp[at],cast(float32)p.x,cast(float32)p.y,cast(float32)p.z,cast(float32)g.lamp_reach[at])
  VectorAt(l.grade_lamp_color[at],g.lamp_color[at])
 }
 VectorAt(l.grade_beam_centre,g.beam_centre);VectorAt(l.grade_beam_u,g.beam_u);VectorAt(l.grade_beam_v,g.beam_v)
 G.Uniform4f(l.grade_beam_normal,cast(float32)g.beam_normal.x,cast(float32)g.beam_normal.y,cast(float32)g.beam_normal.z,cast(float32)g.beam_reach)
 VectorAt(l.grade_beam_direction,g.beam_direction)
 c:=g.beam_color;G.Uniform4f(l.grade_beam_color,cast(float32)c.x,cast(float32)c.y,cast(float32)c.z,ifx g.beam then cast(float32)g.beam_sharp else 0.0)
 G.Uniform1i(l.grade_beam_shadow,g.beam_shadow)
}
FrameUniforms :: (gpu: *SceneGpuContext,scene: *Scene,locations: *GpuLocations,view: M.GpuMatrix,vp: M.GpuMatrix,grade: *RenderGrade)->bool {
 MatrixAt(locations.vp,vp);MatrixAt(locations.view,view)
 GradeUniforms(locations,grade)
 G.Uniform1i(locations.albedo,0)
 BindTexture(1,gpu.dfg);G.Uniform1i(locations.dfg,1)
 VectorAt(locations.sky,M.Times(LinearColor(scene.sky),scene.hemisphere));VectorAt(locations.ground,M.Times(LinearColor(scene.ground),scene.hemisphere))
 VectorAt(locations.up,M.Normalize(M.Direction(view,.{0,1,0})))
 count:=ifx scene.lights.count<4 then cast(s32)scene.lights.count else 4
 G.Uniform1i(locations.light_count,count)
 for at: 0..3 {
  G.Uniform1i(locations.shadow[at],cast(s32)at+2)
  BindTexture(cast(s32)at+2,gpu.shadows[at].texture)
  G.Uniform4f(locations.shadow_settings[at],0.0,0.0,0.0,0.0)
  if at>=count {continue}
  l:=scene.lights[at]
  VectorAt(locations.light_color[at],M.Times(LinearColor(l.color),l.intensity))
  VectorAt(locations.light_direction[at],M.Normalize(M.Direction(view,M.Sub(l.position,l.target))))
  if l.shadow&&l.shadow_size>0 {
   bias:=M.Identity()
   bias.m[0]=0.5;bias.m[3]=0.5;bias.m[5]=0.5;bias.m[7]=0.5;bias.m[10]=0.5;bias.m[11]=0.5
   MatrixAt(locations.shadow_matrix[at],M.Multiply(bias,ShadowVP(l)))
   G.Uniform4f(locations.shadow_settings[at],1.0,cast(float32)l.shadow_bias,cast(float32)l.shadow_normal_bias,cast(float32)(l.shadow_radius/cast(float64)l.shadow_size))
  }
 }
 return BindCookie(gpu,scene,locations,count)
}
Draw :: (gpu: *SceneGpuContext,scene: *Scene,d: GpuDraw,view: M.GpuMatrix,vp: M.GpuMatrix,grade: *RenderGrade,perspective: bool,shadow_features: s32)->bool {
 m:=scene.meshes[d.mesh].material
 program:=ProgramFor(gpu,m.shader,MaterialFeatures(m,perspective)|shadow_features)
 if program==null {return false}
 locations:=*program.locations
 G.UseProgram(program.id)
 if !program.frame_uniforms_set {
  if !FrameUniforms(gpu,scene,locations,view,vp,grade) {return false}
  program.frame_uniforms_set=true
 }
 base:=LinearColor(m.color);G.Uniform4f(locations.base,cast(float32)base.x,cast(float32)base.y,cast(float32)base.z,cast(float32)m.opacity)
 VectorAt(locations.glow,M.Times(LinearColor(m.glow),m.glow_strength))
 G.Uniform4f(locations.material,cast(float32)m.roughness,cast(float32)m.metalness,cast(float32)m.alpha_test,cast(float32)cast(s32)m.kind)
 G.Uniform4f(locations.flags,ifx m.vertex_colors then 1.0 else 0.0,ifx m.flat then 1.0 else 0.0,ifx m.double_sided then 1.0 else 0.0,ifx d.receive then 1.0 else 0.0)
 G.Uniform4f(locations.settings,ifx scene.tone_mapping then 1.0 else 0.0,ifx m.exact_color then 1.0 else 0.0,cast(float32)scene.exposure,ifx perspective then 1.0 else 0.0)
 G.Uniform1i(locations.transparent,ifx m.transparent then 1 else 0)
 G.Uniform1f(locations.graded,ifx grade.on&&!m.ungraded then 1.0 else 0.0)
 if m.double_sided {G.Disable(0x0b44)} else {G.Enable(0x0b44)}
 if m.texture>=0&&m.texture<scene.textures.count {
  t:=scene.textures[m.texture];bytes:=cast(s64)t.width*t.height*4
  if t.first_texel<0||t.first_texel+bytes>scene.texels.count {return false}
  texture:=TextureFor(gpu,0,*scene.texels[t.first_texel],t.width,t.height,t.cache_key);if texture==0 {return false}
  G.BindTexture(0x0de1,texture);G.Uniform2f(locations.albedo_size,cast(float32)t.width,cast(float32)t.height)
  G.Uniform2f(locations.albedo_sampling,cast(float32)cast(s32)m.texture_filter,cast(float32)cast(s32)m.texture_wrap)
 } else {
  G.Uniform2f(locations.albedo_size,0.0,0.0);G.Uniform2f(locations.albedo_sampling,0.0,0.0)
 }
 if m.shader!=null {
  uniforms: [64]float32
  for slot: 0..m.shader.uniform_count-1 {
   u:=m.shader_uniforms[slot];uniforms[slot*4]=cast(float32)u.x;uniforms[slot*4+1]=cast(float32)u.y;uniforms[slot*4+2]=cast(float32)u.z;uniforms[slot*4+3]=cast(float32)u.w
  }
  if m.shader.uniform_count>0 {G.Uniform4fv(locations.uniforms,m.shader.uniform_count,*uniforms[0])}
  for slot: 0..m.shader.sampler_count-1 {
   unit:=cast(s32)slot+6
   s:=m.shader_samplers[slot];texture:=TextureFor(gpu,unit,*s.pixels[0],s.width,s.height);if texture==0 {return false}
   G.BindTexture(0x0de1,texture)
   G.Uniform1i(locations.sampler[slot],unit)
   G.Uniform2f(locations.sampler_size[slot],cast(float32)s.width,cast(float32)s.height)
   G.Uniform1f(locations.sampler_repeat[slot],ifx s.repeat then 1.0 else 0.0)
  }
 }
 BindSkinAt(gpu,scene,d,program.id,locations.skin_mode,locations.model,locations.bones,locations.bones_texture,locations.bones_in_texture,locations.bone_stride)
 DrawGeometry(gpu,scene,scene.meshes[d.mesh],d)
 return true
}
// The first light whose cookie can project binds it to unit 14, after the
// albedo, DFG, four shadow and eight shader-sampler units.
BindCookie :: (gpu: *SceneGpuContext,scene: *Scene,locations: *GpuLocations,count: s32)->bool {
 G.Uniform1i(locations.cookie,14);G.Uniform1i(locations.cookie_light,-1)
 for at: 0..count-1 {
  l:=scene.lights[at]
  if !l.cookie {continue}
  if l.cookie_texture<0||l.cookie_texture>=scene.textures.count||l.shadow_half_width<=0.0||l.shadow_half_height<=0.0||l.shadow_far==l.shadow_near {continue}
  t:=scene.textures[l.cookie_texture];bytes:=cast(s64)t.width*t.height*4
  if t.width<=0||t.height<=0||t.first_texel<0||t.first_texel+bytes>scene.texels.count {continue}
  texture:=TextureFor(gpu,14,*scene.texels[t.first_texel],t.width,t.height,t.cache_key);if texture==0 {return false}
  G.BindTexture(0x0de1,texture)
  bias:=M.Identity()
  bias.m[0]=0.5;bias.m[3]=0.5;bias.m[5]=0.5;bias.m[7]=0.5;bias.m[10]=0.5;bias.m[11]=0.5
  MatrixAt(locations.cookie_matrix,M.Multiply(bias,ShadowVP(l)))
  G.Uniform4f(locations.cookie_transform,cast(float32)l.cookie_scale.x,cast(float32)l.cookie_scale.y,cast(float32)l.cookie_offset.x,cast(float32)l.cookie_offset.y)
  G.Uniform2f(locations.cookie_size,cast(float32)t.width,cast(float32)t.height)
  G.Uniform1i(locations.cookie_light,cast(s32)at)
  return true
 }
 return true
}
ShadowVP :: (l: SceneLight)->M.GpuMatrix {return M.Multiply(M.Orthographic(-l.shadow_half_width,l.shadow_half_width,l.shadow_half_height,-l.shadow_half_height,l.shadow_near,l.shadow_far),M.LookAt(l.position,l.target,.{0,1,0}))}
ShadowSpaceEqual :: (a: SceneLight,b: SceneLight)->bool {
 // Radiometry and receiver bias/filter parameters do not change caster depth.
 return a.position.x==b.position.x&&a.position.y==b.position.y&&a.position.z==b.position.z&&
  a.target.x==b.target.x&&a.target.y==b.target.y&&a.target.z==b.target.z&&
  a.shadow_half_width==b.shadow_half_width&&a.shadow_half_height==b.shadow_half_height&&
  a.shadow_near==b.shadow_near&&a.shadow_far==b.shadow_far
}
DropShadow :: (s: *GpuShadow) {G.DeleteTextures(1,*s.texture);G.DeleteFramebuffers(1,*s.framebuffer);s[0]=GpuShadow.{}}
RenderShadows :: (gpu: *SceneGpuContext,scene: *Scene)->bool {
 G.Disable(0x0b44);G.Disable(0x0be2);G.Enable(0x0b71);G.DepthMask(1);G.DepthFunc(0x0203);G.UseProgram(gpu.shadow_program)
 alpha_settings:=G.Location(gpu.shadow_program,"alphaSettings")
 albedo_size:=G.Location(gpu.shadow_program,"albedoSize")
 albedo_sampling:=G.Location(gpu.shadow_program,"albedoSampling")
 G.Uniform1i(G.Location(gpu.shadow_program,"albedo"),0)
 skin_mode:=G.Location(gpu.shadow_program,"kryonSkinMode")
 skin_model:=G.Location(gpu.shadow_program,"kryonModel")
 skin_bones:=G.Location(gpu.shadow_program,"kryonBones[0]")
 skin_bones_texture:=G.Location(gpu.shadow_program,"kryonBonesTexture")
 skin_bones_in_texture:=G.Location(gpu.shadow_program,"kryonBonesInTexture")
 skin_stride:=G.Location(gpu.shadow_program,"kryonBoneStride")
 for at: 0..3 {
  s:=*gpu.shadows[at]
  if at>=scene.lights.count||!scene.lights[at].shadow||scene.lights[at].shadow_size<=0 {if s.texture!=0 {DropShadow(s)};continue}
  l:=scene.lights[at]
  if l.shadow_size>gpu.capabilities.max_texture_size {return false}
  // A new pose moves the casters as surely as new vertices do.
  redraw:=gpu.resources.geometry_uploads!=gpu.shadow_geometry||gpu.resources.skin_uploads!=gpu.shadow_skin||s.texture==0
  if !ShadowSpaceEqual(s.source,l) {redraw=true}
  if s.size!=l.shadow_size {
   DropShadow(s);s.size=l.shadow_size
   s.texture=G.Texture(s.size,s.size,0x8cac,0x1902,0x1406,null)
   if gpu.capabilities.pcf_available {
    G.TexParameter(0x0de1,0x884c,0x884e)
    G.TexParameter(0x0de1,0x884d,0x0203)
    G.TexParameter(0x0de1,0x2801,0x2601);G.TexParameter(0x0de1,0x2800,0x2601)
   }
   G.GenFramebuffers(1,*s.framebuffer);G.BindFramebuffer(0x8d40,s.framebuffer)
   G.FramebufferTexture(0x8d40,0x8d00,0x0de1,s.texture,0)
   if G.CheckFramebuffer(0x8d40)!=0x8cd5 {return false}
   redraw=true
  }
  if redraw {
   G.BindFramebuffer(0x8d40,s.framebuffer);G.Viewport(0,0,s.size,s.size);G.ClearDepth(1.0);G.Clear(0x0100)
   MatrixUniform(gpu.shadow_program,"vp",ShadowVP(l))
   // The CPU reference casts back faces for one-sided materials, and both
   // faces for double-sided materials. Cutout textures retain their silhouette.
   G.FrontFace(0x0901);G.CullFace(0x0404)
   double_sided:=true
   for draw: 0..gpu.draws.count-1 {
    d:=gpu.draws[draw];if !d.cast_shadow {continue}
    m:=scene.meshes[d.mesh].material
    both:=m.double_sided
    if both!=double_sided {if both {G.Disable(0x0b44)} else {G.Enable(0x0b44)};double_sided=both}
    G.Uniform2f(alpha_settings,cast(float32)m.opacity,cast(float32)m.alpha_test)
    G.Uniform2f(albedo_size,0.0,0.0);G.Uniform2f(albedo_sampling,0.0,0.0)
    if m.texture>=0&&m.texture<scene.textures.count {
     t:=scene.textures[m.texture];bytes:=cast(s64)t.width*t.height*4
     if t.first_texel<0||t.first_texel+bytes>scene.texels.count {return false}
     texture:=TextureFor(gpu,0,*scene.texels[t.first_texel],t.width,t.height,t.cache_key);if texture==0 {return false}
     G.BindTexture(0x0de1,texture);G.Uniform2f(albedo_size,cast(float32)t.width,cast(float32)t.height)
     G.Uniform2f(albedo_sampling,cast(float32)cast(s32)m.texture_filter,cast(float32)cast(s32)m.texture_wrap)
    }
    BindSkinAt(gpu,scene,d,gpu.shadow_program,skin_mode,skin_model,skin_bones,skin_bones_texture,skin_bones_in_texture,skin_stride)
    DrawGeometry(gpu,scene,scene.meshes[d.mesh],d)
   }
   G.Disable(0x0b44)
   s.source=l
   gpu.resources.shadow_renders+=1
  }
 }
 gpu.shadow_geometry=gpu.resources.geometry_uploads
 gpu.shadow_skin=gpu.resources.skin_uploads
 return G.GetError()==0
}
}
