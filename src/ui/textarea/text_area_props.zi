Text :: #import "text";
#import "geometry"
#import "text_input"
Utf8 :: #import "std/utf8"
using Vectors :: #import "std/vec"

Input :: struct {
    text: string
    paste_text: string
    composition_event: CompositionEvent
    left: bool
    right: bool
    up: bool
    down: bool
    home: bool
    end: bool
    document_home: bool
    document_end: bool
    page_up: bool
    page_down: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    enter: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
    wheel: float32
    // The host's monotonic clock in seconds. A second press on the same text
    // soon after the first selects the word under it; zero turns that off.
    now_seconds: float64
}

ColorSpan :: struct {
    start: s32
    end: s32
    color: u32
}

// A box under a logical line of the value, such as a picture in a note, or
// in place of the line's last row when `cover` is set, for a line whose
// bytes are all hidden. A line's boxes follow it one under another, in
// order; only its first may cover the row. Rows, wrapping and caret stops
// stay those of the text; only vertical positions, hit testing and painting
// make room for boxes. A point inside one is the end of its line.
Block :: struct {
    // The byte offset where the line starts.
    start: s32
    height: s32
    cover: bool
    // An asset drawn fitted inside the box, or "".
    image: string
    // Shown in a soft frame while the image is empty or unavailable.
    label: string
}

// A logical line drawn at its own size, such as a heading. Its rows wrap,
// take caret stops and take height at that size.
Line :: struct {
    // The byte offset where the line starts.
    start: s32
    // The line's font size as a multiple of the area's.
    scale: float32
}

Props :: struct {
    key: u64
    bounds: Rectangle
    value: string
    label: string
    placeholder: string
    cursor: s32
    anchor: s32
    scroll_y: s32
    focused: bool
    composition: CompositionState
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    max_bytes: s32
    max_codepoints: s32
    id: s32
    focus_id: s32
    colors: []ColorSpan
    composition_start: s32
    composition_end: s32
    read_only: bool
    wrap: bool
    class_name: s32
    scale: float32
    disabled: bool
    input: Input
    // A reader may keep its viewport independent of caret/selection changes.
    manual_scroll: bool
    // Bytes kept in the value but not shown: no width, paint or caret stop,
    // such as Markdown markers away from the line being edited. Sorted and
    // disjoint on character boundaries; any other list is ignored.
    hidden: []Text.Range
    // Bytes drawn with emphasis, as Text's strong ranges.
    strong: []Text.Range
    // Bytes drawn slanted where the backend can, with unchanged advances;
    // sorted and disjoint like `strong`.
    italic: []Text.Range
    // Boxes under or in place of lines, and lines drawn at their own size.
    // Each list is sorted by start, every start at a line start, with at
    // most one size per line; any other list is ignored as a whole. Without
    // them the layout is exactly the one of a plain area.
    blocks: []Block
    lines: []Line
}

Edit :: struct {
    start: s32
    end: s32
    replacement: string
    changed: bool
}

Result :: struct {
    node: s32
    cursor: s32
    anchor: s32
    scroll_y: s32
    focused: bool
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    committed: bool
    escaped: bool
    composition: CompositionState
    composition_changed: bool
    clipboard_write: bool
    clipboard_text: string
    // Paste ran in an editable area while the clipboard held no text; the
    // application may take an image or files from it instead.
    paste_without_text: bool
    edit: Edit
}
