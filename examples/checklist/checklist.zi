App :: #import "kryon/app";
OnboardingChecklist :: #import "kryon/onboarding_checklist";
Layout :: #import "kryon/layout";
#import "kryon/tree"
Text :: #import "kryon/text";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/onboarding_checklist_task"

done: [3]bool;
Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Onboarding checklist", .size = 28})
    tasks := OnboardingChecklistTask.[.{.id = 1, .title = "Create a project", .done = done[0]}, .{.id = 2, .title = "Add a component", .done = done[1]}, .{.id = 3, .title = "Run the app", .done = done[2]}]
    result := OnboardingChecklist.Draw(session, OnboardingChecklist.Props.{.disabled = example_disabled, .bounds = .{height = 224}, .title = "Get started", .tasks = tasks[:]})
    if result.toggled_index >= 0 && result.toggled_index < 3 { done[result.toggled_index] = !done[result.toggled_index] }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "checklist"}, Frame) }
