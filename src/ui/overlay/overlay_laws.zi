#import "overlay_behavior"

// Laws for dismissible overlays. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A release outside an overlay that allows dismissing, and that no one else
// took, closes it. Every release owned by the backdrop is consumed, including
// a release that a modal intentionally refuses to dismiss.
#law OutsideReleaseCloses custom DismissibleOverlayPolicyFor(true, false, false, false).closed && DismissibleOverlayPolicyFor(true, false, false, false).outside_released && DismissibleOverlayPolicyFor(true, false, false, false).release_consumed;
// Every release the overlay receives is reported as a tap, inside or
// outside its panel and whether or not it closes the overlay.
#law ReleasesAreTaps forall released: 0..1, consumed: 0..1, locked: 0..1, inside: 0..1 => DismissibleOverlayPolicyFor(B(released), B(consumed), B(locked), B(inside)).tapped == (B(released) && !B(consumed));
#law OwnedReleaseConsumed forall consumed: 0..1, locked: 0..1, inside: 0..1 => DismissibleOverlayPolicyFor(true, B(consumed), B(locked), B(inside)).release_consumed;
#law OtherwiseStays forall released: 0..1, consumed: 0..1, locked: 0..1, inside: 0..1 => (B(released) && !B(consumed) && !B(locked) && !B(inside)) || (!DismissibleOverlayPolicyFor(B(released), B(consumed), B(locked), B(inside)).closed && DismissibleOverlayPolicyFor(B(released), B(consumed), B(locked), B(inside)).release_consumed == (B(released) || B(consumed)));
