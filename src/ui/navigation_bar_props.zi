#import "image_props"

NavigationBarItem :: struct {
    key: u64
    route: s32
    label: string
    image: ImageProps
    active: bool
    disabled: bool
}

NavigationBarProps :: struct {
    key: u64
    id: s32
    view_width: s32
    view_height: s32
    class_name: s32
    height: s32
    scale: float32
}

NavigationBarResult :: struct {
    node: s32
    clicked_index: s32
    clicked_route: s32
    y: s32
    height: s32
}
