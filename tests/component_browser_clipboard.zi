// Browser rollback fixture: keep the same typed clipboard capability in each
// counter revision, but only the rejected candidate executes this edit.
TextField :: #import "kryon/text_field";
#import "session"
#import "geometry"

BrowserClipboardProbe :: (session: Session, copy: bool) {
    if !copy { return }
    unused TextField.Draw(session, TextField.Props.{
        .key = 700, .bounds = Rectangle.{16.0, 110.0, 240.0, 40.0},
        .value = "staged-clipboard-probe", .cursor = 22, .anchor = 0,
        .focused = true, .input = TextField.Input.{.copy = true}
    })
}
