#import "session"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "selectable"
#import "selectable_props"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

using WidgetKind;
using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ButtonState;
using StyleField;

#program_export
SelectableDefaultFace :: (state: s32) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleBorderWidth |
        cast(u32)StyleRadius | cast(u32)StyleOpacity |
        cast(u32)StyleFontSize | cast(u32)StylePaddingX
    face.background = cast(u32)0x00000000
    face.foreground = cast(u32)0x171717ff
    face.border = cast(u32)0x00000000
    face.opacity = 1.0
    face.radius = 4.0
    face.font_size = 14.0
    face.padding_x = 8.0
    if state == ButtonStateHover {
        face.background = cast(u32)0xe5e7ebff
    } else if state == ButtonStatePressed {
        face.background = cast(u32)0xd1d5dbff
    } else if state == ButtonStateSelected {
        face.background = cast(u32)0xdbeafeff
        face.foreground = cast(u32)0x1d4ed8ff
    } else if state == ButtonStateDisabled {
        face.foreground = Opacity(face.foreground, 0.45)
    }
    return face
}

#program_export
SelectableFaceFor :: (props: SelectableProps,
    state: s32) -> StyleFrame {
    facts: StyleFacts = StyleControlRoleFacts(StyleKindSelectable(),
        props.id, props.class_name, StyleAny(),
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisFilled,
        cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(),
        SelectableDefaultFace(state), facts, state)
    return frame
}

#program_export
Selectable :: (session: Session, props: SelectableProps) -> SelectableToggleResult {
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    previous: s32 = -1
    if TreeIsBuilding(session) {
        previous = TreePrevious(session, TreeCurrentParent(session), key, WidgetKindSelectable)
    }
    activated: bool = TreeTakeActivationAt(session, previous)
    result: SelectableToggleResult = SelectableToggleFor(
        props.selected, activated && !props.disabled)
    state: s32 = ResolveState(cast(s32)ButtonStateAuto,
        props.disabled, false, TreePressedAt(session, previous),
        TreeHoveredAt(session, previous), false, result.selected)
    face: StyleFrame = SelectableFaceFor(props, state)
    bounds: Rectangle = props.bounds
    if bounds.width <= 0.0 { bounds.width = 120.0 }
    if bounds.height <= 0.0 { bounds.height = 36.0 }
    spec: SelectableSpec
    spec.bounds = bounds
    spec.selected = result.selected
    spec.hovered = TreeHoveredAt(session, previous)
    spec.pressed = TreePressedAt(session, previous)
    spec.disabled = props.disabled
    spec.face = face
    spec.label_inset = SelectableLabelInset(1.0, face)
    paint: SelectablePaint = SelectablePaintFor(spec)
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, key, WidgetKindSelectable, bounds)
        if node < 0 { return result }
        TreeSetInteractive(session, node, props.disabled, false, props.id)
        TreeSetSelected(session, node, result.selected)
        TreeSetLabel(session, node, props.label)
    }
    opacity: float32 = StyleOpacityValue(face.value.fields,
        face.value.opacity)
    if paint.draw_fill {
        PaintRoundedFill(session, node, paint.bounds, face.value.radius, 12,
            ColorFromPacked(Opacity(paint.fill_color, opacity)))
    }
    if face.value.border_width > 0.0 {
        PaintRoundedOutline(session, node, paint.bounds, face.value.radius, 12,
            face.value.border_width,
            ColorFromPacked(Opacity(face.value.border, opacity)))
    }
    if props.label != "" {
        font: s32 = ResolveFont(0,
            StyleFontValue(face.value.fields, face.value.font_size), 14)
        line_height: s32 = GlyphLineHeight(font, face.value.typeface)
        y: s32 = cast(s32)(paint.bounds.y +
            (paint.bounds.height - cast(float32)line_height) * 0.5)
        PaintClippedLabel(session, node, props.label, cast(s32)paint.label_x,
            y, font,
            ColorFromPacked(Opacity(paint.text_color, opacity)),
            paint.bounds)
    }
    return result
}
