    return -999999
}

# Selector: Kind[attr=value].class:state chains filling a StyleRule selector.

KssRuleResult :: struct {
    parser: KssParser
    rule: StyleRule
}

KssApplyAttr :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    result: KssRuleResult
    attribute: KssNameResult = KssReadName(p)
    if !attribute.ok {
        result.parser = KssFail(attribute.parser, "expected selector attribute")
        return result
    }
    equals: KssExpectResult = KssExpect(attribute.parser, 61)
    if !equals.ok {
        result.parser = KssFail(equals.parser, "expected '=' in selector attribute")
        return result
    }
    value: KssNameResult = KssReadName(equals.parser)
    if !value.ok {
        result.parser = KssFail(value.parser, "expected selector attribute value")
        return result
    }
    close: KssExpectResult = KssExpect(value.parser, 93)
    if !close.ok {
        result.parser = KssFail(close.parser, "expected ']'")
        return result
    }
    if KssNameEquals(attribute.name, "tone") {
        mapped: i32 = KssToneValue(value.name)
        if mapped == -999999 {
            result.parser = KssFailName(close.parser, "unknown tone '", value.name)
            return result
        }
        rule.selector.tone = mapped
    } else if KssNameEquals(attribute.name, "emphasis") {
        mapped: i32 = KssEmphasisValue(value.name)
        if mapped == -999999 {
            result.parser = KssFailName(close.parser, "unknown emphasis '", value.name)
            return result
        }
        rule.selector.emphasis = mapped
    } else if KssNameEquals(attribute.name, "size") {
        mapped: i32 = KssSizeValue(value.name)
        if mapped == -999999 {
            result.parser = KssFailName(close.parser, "unknown size '", value.name)
            return result
        }
        rule.selector.size = mapped
    } else if KssNameEquals(attribute.name, "state") {
        mapped: i32 = KssStateValue(value.name)
        if mapped == -999999 {
            result.parser = KssFailName(close.parser, "unknown state '", value.name)
            return result
        }
        rule.selector.state = mapped
    } else if KssNameEquals(attribute.name, "role") {
        mapped: i32 = KssRoleValue(value.name)
        if mapped == -999999 {
            result.parser = KssFailName(close.parser, "unknown role '", value.name)
            return result
        }
        rule.selector.role = mapped
    } else if KssNameEquals(attribute.name, "class") {
        rule.selector.class_name = KssClassId(value.name)
    } else {
        result.parser = KssFailName(close.parser, "unknown selector attribute '",
            attribute.name)
        return result
    }
    result.parser = close.parser
    result.rule = rule
    return result
}

KssParseSelector :: (p: KssParser) -> KssRuleResult {
    result: KssRuleResult
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.state = StyleStateAny()
    kind: KssNameResult = KssReadSelectorName(p)
    if !kind.ok {
        result.parser = KssFail(kind.parser, "expected style selector")
        return result
    }
    mapped: i32 = KssKindValue(kind.name)
    if mapped == -999999 {
        result.parser = KssFailName(kind.parser, "unknown style selector '",
            kind.name)
        return result
    }
    rule.selector.kind = mapped
    p = kind.parser
    running: bool = true
    while running {
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            result.parser = KssFail(p, "unterminated style rule")
            return result
        }
        if p.source[p.pos] == 91 {
            p = KssAdvance(p, 1)
            attribute: KssRuleResult = KssApplyAttr(p, rule)
            if attribute.parser.status == (i32)KssStatusError {
                return attribute
            }
            p = attribute.parser
            rule = attribute.rule
            continue
        }
        if p.source[p.pos] == 46 {
            p = KssAdvance(p, 1)
            class_name: KssNameResult = KssReadSelectorName(p)
            if !class_name.ok {
                result.parser = KssFail(class_name.parser,
                    "expected class name after '.'")
                return result
            }
            rule.selector.class_name = KssClassId(class_name.name)
            p = class_name.parser
            continue
        }
        if p.source[p.pos] == 58 {
            p = KssAdvance(p, 1)
            state: KssNameResult = KssReadName(p)
            if !state.ok {
                result.parser = KssFail(state.parser, "expected state after ':'")
                return result
            }
            state_mapped: i32 = KssStateValue(state.name)
            if state_mapped == -999999 {
                result.parser = KssFailName(state.parser, "unknown state '",
                    state.name)
                return result
            }
            rule.state = state_mapped
            p = state.parser
            continue
        }
        running = false
    }
    result.parser = p
    result.rule = rule
    return result
}

# Property declarations. Token references resolve immediately against the
# final token table, so overlays applied earlier win as intended.

KssReadColorValue :: (p: KssParser) -> KssColorResult {
    hex: KssColorResult = KssReadHexColor(p)
    if hex.ok {
        return hex
    }
    reference: KssNameResult = KssReadName(hex.parser)
    if reference.ok {
        index: i32 = KssFindColorToken(reference.parser, reference.name)
        if index >= 0 {
            hex.value = reference.parser.tokens[index].color
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
    }
    hex.ok = false
    hex.parser = hex.parser
    return hex
}

KssReadNumberValue :: (p: KssParser) -> KssNumberResult {
    literal: KssNumberResult = KssReadNumber(p)
    if literal.ok {
        return literal
    }
    reference: KssNameResult = KssReadName(literal.parser)
    if reference.ok {
        index: i32 = KssFindNumberToken(reference.parser, reference.name)
        if index >= 0 {
            literal.value = reference.parser.tokens[index].number
            literal.ok = true
            literal.parser = reference.parser
            return literal
        }
    }
    literal.ok = false
    return literal
}

KssIntResult :: struct {
    parser: KssParser
    value: i32
    ok: bool
}

KssReadMaterialValue :: (p: KssParser) -> KssIntResult {
    result: KssIntResult
    reference: KssNameResult = KssReadName(p)
    if !reference.ok {
        result.parser = KssFail(reference.parser, "expected material")
        return result
    }
    mapped: i32 = KssMaterialValue(reference.name)
    if mapped == -999999 {
        index: i32 = KssFindMaterialToken(reference.parser, reference.name)
        if index >= 0 {
            mapped = reference.parser.tokens[index].material
        }
    }
    if mapped == -999999 {
        result.parser = KssFailName(reference.parser, "unknown material '",
            reference.name)
        return result
    }
    result.parser = reference.parser
    result.value = mapped
    result.ok = true
    return result
}

# One declaration into the rule's StyleData. Field flags come from
# control_props; every property stores presence explicitly.

KssParseProperty :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    result: KssRuleResult
    name: KssNameResult = KssReadName(p)
    if !name.ok {
        result.parser = KssFail(name.parser, "expected property name")
        return result
    }
    colon: KssExpectResult = KssExpect(name.parser, 58)
    if !colon.ok {
        result.parser = KssFail(colon.parser, "expected ':' after property")
        return result
    }
    p = colon.parser

    if KssNameEquals(name.name, "background") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBackground
        rule.style.background = value.value
        p = value.parser
    } else if KssNameEquals(name.name, "foreground") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleForeground
        rule.style.foreground = value.value
        p = value.parser
    } else if KssNameEquals(name.name, "border") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBorder
        rule.style.border = value.value
        p = value.parser
    } else if KssNameEquals(name.name, "focus") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleFocus
        rule.style.focus = value.value
        p = value.parser
    } else if KssNameEquals(name.name, "background-end") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBackgroundEnd
        rule.style.background_end = value.value
        p = value.parser
    } else {
        return KssParseNumberProperty(p, rule, name.name)
    }

    semicolon: KssExpectResult = KssExpect(p, 59)
    if !semicolon.ok {
        result.parser = KssFail(semicolon.parser, "expected ';'")
        return result
    }
    result.parser = semicolon.parser
    result.rule = rule
    return result
}

KssParseNumberProperty :: (p: KssParser, rule: StyleRule, name: KssName) -> KssRuleResult {
    result: KssRuleResult
    if KssNameEquals(name, "radius") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleRadius
        rule.style.radius = value.value
        p = value.parser
    } else if KssNameEquals(name, "border-width") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBorderWidth
        rule.style.border_width = value.value
        p = value.parser
    } else if KssNameEquals(name, "opacity") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleOpacity
        rule.style.opacity = value.value
        p = value.parser
    } else if KssNameEquals(name, "padding-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StylePaddingX
        rule.style.padding_x = value.value
        p = value.parser
    } else if KssNameEquals(name, "padding-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StylePaddingY
        rule.style.padding_y = value.value
        p = value.parser
    } else if KssNameEquals(name, "gap") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleGap
        rule.style.gap = value.value
        p = value.parser
    } else if KssNameEquals(name, "font-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleFontSize
        rule.style.font_size = value.value
        p = value.parser
    } else if KssNameEquals(name, "letter-spacing") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleLetterSpacing
        rule.style.letter_spacing = value.value
        p = value.parser
    } else if KssNameEquals(name, "icon-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleIconSize
        rule.style.icon_size = value.value
        p = value.parser
    } else if KssNameEquals(name, "offset-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleContentOffset
        rule.style.offset_x = value.value
        p = value.parser
    } else if KssNameEquals(name, "offset-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            result.parser = KssFail(value.parser, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleContentOffset
        rule.style.offset_y = value.value
        p = value.parser
    } else if KssNameEquals(name, "material") {
        value: KssIntResult = KssReadMaterialValue(p)
        if !value.ok {
            result.parser = value.parser
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleMaterial
        rule.style.material = (MaterialKind)value.value
        p = value.parser
    } else if KssNameEquals(name, "typeface") {
        start: i32 = -1
        length: i32 = 0
        scan: KssParser = KssSkipSpace(p)
        if !KssAtEnd(scan) && KssIdentStart(scan.source[scan.pos]) {
            start = scan.pos
            while !KssAtEnd(scan) && KssIdentChar(scan.source[scan.pos]) {
                length = length + 1
                scan = KssAdvance(scan, 1)
            }
        }
        if start < 0 {
            result.parser = KssFail(scan, "expected typeface name")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleTypeface
        rule.style.typeface = StringSlice(scan.source, start, length)
        p = scan
    } else {
        result.parser = KssFailName(p, "unknown property '", name)
        return result
    }

    semicolon: KssExpectResult = KssExpect(p, 59)
    if !semicolon.ok {
        result.parser = KssFail(semicolon.parser, "expected ';'")
        return result
    }
    result.parser = semicolon.parser
    result.rule = rule
    return result
}

# Rules: selector, declaration block, layer and order bookkeeping.

KssParseRule :: (p: KssParser) -> KssParser {
    origin: KssOrigin
    origin.file = p.file
    origin.line = p.line
    origin.column = p.column
    selector: KssRuleResult = KssParseSelector(p)
    if selector.parser.status == (i32)KssStatusError {
        return selector.parser
    }
    p = selector.parser
    open: KssExpectResult = KssExpect(p, 123)
    if !open.ok {
        return KssFail(open.parser, "expected '{'")
    }
    p = open.parser
    rule: StyleRule = selector.rule
    rule.layer = p.layer
    rule.order = p.rule_total
    running: bool = true
    while running {
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            return KssFail(p, "unterminated style rule")
        }
        if p.source[p.pos] == 125 {
            p = KssAdvance(p, 1)
            running = false
            continue
        }
        property: KssRuleResult = KssParseProperty(p, rule)
        if property.parser.status == (i32)KssStatusError {
            return property.parser
        }
        p = property.parser
        rule = property.rule
    }
    p.rule = rule
    p.origin = origin
    p.rule_total = p.rule_total + 1
    p.status = (i32)KssStatusRule
    return p
}

# Environment axes are closed and typed. Blocks match the active environment
# only; values are validated regardless of the match.

KssEnvAxisValid :: (axis: KssName) -> bool {
    return KssNameEquals(axis, "theme") || KssNameEquals(axis, "contrast") ||
        KssNameEquals(axis, "density") || KssNameEquals(axis, "pointer") ||
        KssNameEquals(axis, "platform")
}

KssEnvValueValid :: (axis: KssName, value: KssName) -> bool {
    if KssNameEquals(axis, "theme") {
        return KssNameEquals(value, "light") || KssNameEquals(value, "dark")
    }
    if KssNameEquals(axis, "contrast") {
        return KssNameEquals(value, "normal") || KssNameEquals(value, "high")
    }
    if KssNameEquals(axis, "density") {
        return KssNameEquals(value, "compact") ||
            KssNameEquals(value, "comfortable") || KssNameEquals(value, "touch")
    }
    if KssNameEquals(axis, "pointer") {
        return KssNameEquals(value, "mouse") || KssNameEquals(value, "touch") ||
            KssNameEquals(value, "mixed")
    }
    return KssNameEquals(value, "desktop") || KssNameEquals(value, "android") ||
        KssNameEquals(value, "web") || KssNameEquals(value, "plan9") ||
        KssNameEquals(value, "terminal")
}

KssEnvMatches :: (p: KssParser, axis: KssName, value: KssName) -> bool {
    if KssNameEquals(axis, "theme") {
        if KssNameEquals(value, "light") {
            return p.env.theme == (i32)KssThemeLight
        }
        return p.env.theme == (i32)KssThemeDark
    }
    if KssNameEquals(axis, "contrast") {
        if KssNameEquals(value, "high") {
            return p.env.contrast == (i32)KssContrastHigh
        }
        return p.env.contrast == (i32)KssContrastNormal
    }
    if KssNameEquals(axis, "density") {
        if KssNameEquals(value, "compact") {
            return p.env.density == (i32)KssDensityCompact
        }
        if KssNameEquals(value, "touch") {
            return p.env.density == (i32)KssDensityTouch
        }
        return p.env.density == (i32)KssDensityComfortable
    }
    if KssNameEquals(axis, "pointer") {
        if KssNameEquals(value, "touch") {
            return p.env.pointer == (i32)KssPointerTouch
        }
        if KssNameEquals(value, "mixed") {
            return p.env.pointer == (i32)KssPointerMixed
        }
        return p.env.pointer == (i32)KssPointerMouse
    }
    if KssNameEquals(value, "android") {
        return p.env.platform == (i32)KssPlatformAndroid
    }
    if KssNameEquals(value, "web") {
        return p.env.platform == (i32)KssPlatformWeb
    }
    if KssNameEquals(value, "plan9") {
        return p.env.platform == (i32)KssPlatformPlan9
    }
    if KssNameEquals(value, "terminal") {
        return p.env.platform == (i32)KssPlatformTerminal
    }
    return p.env.platform == (i32)KssPlatformDesktop
}

KssThemeActive :: (p: KssParser, name: KssName) -> bool {
    if KssNameEquals(name, "light") {
        return p.env.theme == (i32)KssThemeLight
    }
    if KssNameEquals(name, "dark") {
        return p.env.theme == (i32)KssThemeDark
    }
    return false
}

# Skip the remainder of a block whose '{' is already consumed. Used for
# non-matching environment overlays.

KssSkipBlockRemainder :: (p: KssParser) -> KssParser {
    depth: i32 = 1
    while !KssAtEnd(p) && depth > 0 {
        if p.source[p.pos] == 123 {
            depth = depth + 1
        } else if p.source[p.pos] == 125 {
            depth = depth - 1
        }
        p = KssAdvance(p, 1)
    }
    if depth != 0 {
        return KssFail(p, "unterminated block")
    }
    return p
}

# One 'name: value;' overlay entry. The existing token fixes the value type;
# unknown names and value/type mismatches are errors.

KssOverlayOutcome :: struct {
    parser: KssParser
    matched: bool
}

KssTryOverlayEntry :: (p: KssParser, origin_kind: i32) -> KssOverlayOutcome {
    outcome: KssOverlayOutcome
    name: KssNameResult = KssReadName(p)
    if !name.ok {
        outcome.parser = name.parser
        return outcome
    }
    colon: KssExpectResult = KssExpect(name.parser, 58)
    if !colon.ok {
        outcome.parser = colon.parser
        return outcome
    }
    token_index: i32 = -1
    scan: i32 = name.parser.token_count - 1
    while scan >= 0 {
        if KssNameEqualsName(name.parser.tokens[scan].name, name.name) {
            token_index = scan
        }
        scan = scan - 1
    }
    if token_index < 0 {
        outcome.parser = colon.parser
        return outcome
    }
    kind: i32 = name.parser.tokens[token_index].kind
    if kind == (i32)KssTokenColor {
        value: KssColorResult = KssReadHexColor(colon.parser)
        if !value.ok {
            outcome.parser = colon.parser
            return outcome
        }
        semicolon: KssExpectResult = KssExpect(value.parser, 59)
        if !semicolon.ok {
            outcome.parser = colon.parser
            return outcome
        }
        p = KssOverlayToken(semicolon.parser, name.name, kind, value.value,
            0.0, 0, origin_kind)
        if p.status == (i32)KssStatusError {
            outcome.parser = p
            return outcome
        }
        outcome.parser = p
        outcome.matched = true
        return outcome
    }
    if kind == (i32)KssTokenMaterial {
        value: KssIntResult = KssReadMaterialValue(colon.parser)
        if !value.ok {
            outcome.parser = colon.parser
            return outcome
        }
        semicolon: KssExpectResult = KssExpect(value.parser, 59)
        if !semicolon.ok {
            outcome.parser = colon.parser
            return outcome
        }
        p = KssOverlayToken(semicolon.parser, name.name, kind, 0, 0.0,
            value.value, origin_kind)
        if p.status == (i32)KssStatusError {
            outcome.parser = p
            return outcome
        }
        outcome.parser = p
        outcome.matched = true
        return outcome
    }
    value: KssNumberResult = KssReadDuration(colon.parser)
    if !value.ok {
        value = KssReadNumber(colon.parser)
    }
    if !value.ok {
        outcome.parser = colon.parser
        return outcome
    }
    semicolon: KssExpectResult = KssExpect(value.parser, 59)
    if !semicolon.ok {
        outcome.parser = colon.parser
        return outcome
    }
    p = KssOverlayToken(semicolon.parser, name.name, kind, 0, value.value,
        0, origin_kind)
    if p.status == (i32)KssStatusError {
        outcome.parser = p
        return outcome
    }
    outcome.parser = p
    outcome.matched = true
    return outcome
}

# '@theme name { entry... }': always validated, applied only when active.

KssParseThemeBlock :: (p: KssParser, name: KssName) -> KssParser {
    if p.theme_count >= 16 {
        return KssFail(p, "style theme capacity exceeded")
    }
    p.themes[p.theme_count] = name
    p.theme_count = p.theme_count + 1
    open: KssExpectResult = KssExpect(p, 123)
    if !open.ok {
        return KssFail(open.parser, "expected '{' after @theme name")
    }
    p = open.parser
    active: bool = KssThemeActive(p, name)
    running: bool = true
    while running {
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            return KssFail(p, "unterminated theme block")
        }
        if p.source[p.pos] == 125 {
            p = KssAdvance(p, 1)
            running = false
            continue
        }
        if !active {
            return KssSkipBlockRemainder(p)
        }
        entry: KssOverlayOutcome = KssTryOverlayEntry(p, (i32)KssOriginTheme)
        if entry.parser.status == (i32)KssStatusError {
            return entry.parser
        }
        if !entry.matched {
            return KssFail(entry.parser, "expected theme overlay entry")
        }
        p = entry.parser
    }
    return p
}

# '@env axis(value) { rules and token overlays }'. Matching blocks yield each
# rule to the host and resume inside the block on the next step; non-matching
# blocks are validated by shape and skipped.

KssParseEnvBlock :: (p: KssParser, axis: KssName, value: KssName) -> KssParser {
    if !KssEnvValueValid(axis, value) {
        return KssFailName(p, "unknown environment value '", value)
    }
    open: KssExpectResult = KssExpect(p, 123)
    if !open.ok {
        return KssFail(open.parser, "expected '{' after @env query")
    }
    p = open.parser
    if !KssEnvMatches(p, axis, value) {
        return KssSkipBlockRemainder(p)
    }
    p.in_env = true
    return KssContinueEnvBlock(p)
}

KssContinueEnvBlock :: (p: KssParser) -> KssParser {
    running: bool = true
    while running {
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            return KssFail(p, "unterminated environment block")
        }
        if p.source[p.pos] == 125 {
            p = KssAdvance(p, 1)
            p.in_env = false
            running = false
            continue
        }
        saved: KssParser = p
        entry: KssOverlayOutcome = KssTryOverlayEntry(p,
            (i32)KssOriginEnvironment)
        if entry.parser.status == (i32)KssStatusError {
            return entry.parser
        }
        if entry.matched {
            p = entry.parser
            continue
        }
        p = KssParseRule(saved)
        if p.status == (i32)KssStatusError {
            return p
        }
        return p
    }
    return p
}

# 'tokens { group { name: value; ... } ... }'

KssParseTokenGroup :: (p: KssParser, origin_kind: i32) -> KssParser {
    group: KssNameResult = KssReadName(p)
    if !group.ok {
        return KssFail(group.parser, "expected token group")
    }
    kind: i32 = -1
    if KssNameEquals(group.name, "color") {
        kind = (i32)KssTokenColor
    } else if KssNameEquals(group.name, "length") ||
        KssNameEquals(group.name, "number") {
        kind = (i32)KssTokenLength
    } else if KssNameEquals(group.name, "duration") {
        kind = (i32)KssTokenDuration
    } else if KssNameEquals(group.name, "material") {
        kind = (i32)KssTokenMaterial
    } else {
        return KssFailName(group.parser, "unknown token group '", group.name)
    }
    open: KssExpectResult = KssExpect(group.parser, 123)
    if !open.ok {
        return KssFail(open.parser, "expected '{' after token group")
    }
    p = open.parser
    running: bool = true
    while running {
        token: KssToken
        token.kind = kind
        token.origin = origin_kind
        token.file = p.file
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            return KssFail(p, "unterminated token group")
        }
        if p.source[p.pos] == 125 {
            p = KssAdvance(p, 1)
            running = false
            continue
        }
        token.line = p.line
        token.column = p.column
        name: KssNameResult = KssReadName(p)
        if !name.ok {
            return KssFail(name.parser, "expected token name")
        }
        token.name = name.name
        colon: KssExpectResult = KssExpect(name.parser, 58)
        if !colon.ok {
            return KssFail(colon.parser, "expected ':' after token name")
        }
        if kind == (i32)KssTokenColor {
            value: KssColorResult = KssReadHexColor(colon.parser)
            if !value.ok {
                return KssFail(value.parser, "expected token color")
            }
            token.color = value.value
            p = value.parser
        } else if kind == (i32)KssTokenMaterial {
            value: KssIntResult = KssReadMaterialValue(colon.parser)
            if !value.ok {
                return value.parser
            }
            token.material = value.value
            p = value.parser
        } else if kind == (i32)KssTokenDuration {
            value: KssNumberResult = KssReadDuration(colon.parser)
            if !value.ok {
                return KssFail(value.parser, "expected token duration")
            }
            token.number = value.value
            p = value.parser
        } else {
            value: KssNumberResult = KssReadNumber(colon.parser)
            if !value.ok {
                return KssFail(value.parser, "expected token number")
            }
            token.number = value.value
            p = value.parser
        }
        semicolon: KssExpectResult = KssExpect(p, 59)
        if !semicolon.ok {
            return KssFail(semicolon.parser, "expected ';'")
        }
        p = KssAddToken(semicolon.parser, token)
        if p.status == (i32)KssStatusError {
            return p
        }
    }
    return p
}

KssParseTokensBlock :: (p: KssParser, origin_kind: i32) -> KssParser {
    open: KssExpectResult = KssExpect(p, 123)
    if !open.ok {
        return KssFail(open.parser, "expected '{' after tokens")
    }
    p = open.parser
    running: bool = true
    while running {
        p = KssSkipSpace(p)
        if KssAtEnd(p) {
            return KssFail(p, "unterminated tokens block")
        }
        if p.source[p.pos] == 125 {
            p = KssAdvance(p, 1)
            running = false
            continue
        }
        p = KssParseTokenGroup(p, origin_kind)
        if p.status == (i32)KssStatusError {
            return p
        }
    }
    return p
}

# Directives: @pack, @version, @layer, @import, @theme, @env.

KssParseLayerName :: (p: KssParser, name: KssName) -> KssParser {
    index: i32 = 0
    while index < p.layer_count {
        if KssNameEqualsName(p.layer_names[index], name) {
            p.layer = index
            return p
        }
        index = index + 1
    }
    if !p.layer_declared {
        if KssNameEquals(name, "reset") || KssNameEquals(name, "base") ||
            KssNameEquals(name, "defaults") {
            p.layer = 0
            return p
        }
        if KssNameEquals(name, "components") || KssNameEquals(name, "widgets") {
            p.layer = 1
            return p
        }
        if KssNameEquals(name, "app") {
            p.layer = 2
            return p
        }
        if KssNameEquals(name, "overrides") {
            p.layer = 3
            return p
        }
    }
    return KssFailName(p, "unknown layer '", name)
}

KssParseLayerDeclaration :: (p: KssParser) -> KssParser {
    if p.layer_declared {
        return KssFail(p, "layer order declared twice")
    }
    p.layer_count = 0
    p.layer = 0
    running: bool = true
    while running {
        name: KssNameResult = KssReadName(p)
        if !name.ok {
            return KssFail(name.parser, "expected layer name")
        }
        if p.layer_count >= 12 {
            return KssFail(p, "layer capacity exceeded")
        }
        p.layer_names[p.layer_count] = name.name
        p.layer_count = p.layer_count + 1
        p = name.parser
        p = KssSkipSpace(p)
        if !KssAtEnd(p) && p.source[p.pos] == 44 {
            p = KssAdvance(p, 1)
            continue
        }
        running = false
    }
    p.layer_declared = true
    return p
}

KssReadImportTarget :: (p: KssParser) -> KssNameResult {
    result: KssNameResult
    p = KssSkipSpace(p)
    if KssAtEnd(p) {
        result.parser = p
        return result
    }
    if p.source[p.pos] == 60 {
        p = KssAdvance(p, 1)
        while !KssAtEnd(p) && p.source[p.pos] != 62 {
            result.name = KssNameAppend(result.name, p.source[p.pos])
            p = KssAdvance(p, 1)
        }
        if KssAtEnd(p) {
            result.parser = p
            return result
        }
        p = KssAdvance(p, 1)
        result.parser = p
        result.ok = result.name.length > 0
        return result
    }
    if p.source[p.pos] == 34 {
        p = KssAdvance(p, 1)
        while !KssAtEnd(p) && p.source[p.pos] != 34 {
            result.name = KssNameAppend(result.name, p.source[p.pos])
            p = KssAdvance(p, 1)
        }
        if KssAtEnd(p) {
            result.parser = p
            return result
        }
        p = KssAdvance(p, 1)
        result.parser = p
        result.ok = result.name.length > 0
        return result
    }
    result.parser = p
    return result
}

KssParseLayerList :: (p: KssParser) -> KssParser {
    p = KssSkipSpace(p)
    if KssAtEnd(p) {
        return KssFail(p, "expected layer name")
    }
    first: KssNameResult = KssReadName(p)
    if !first.ok {
        return KssFail(first.parser, "expected layer name")
    }
    p = first.parser
    p = KssSkipSpace(p)
    if !KssAtEnd(p) && p.source[p.pos] == 44 {
        p = KssAdvance(p, 1)
        p = KssParseLayerDeclaration(p)
        if p.status == (i32)KssStatusError {
            return p
        }
    } else {
        p = KssParseLayerName(p, first.name)
        if p.status == (i32)KssStatusError {
            return p
        }
    }
    semicolon: KssExpectResult = KssExpect(p, 59)
    if !semicolon.ok {
        return KssFail(semicolon.parser, "expected ';'")
    }
    return semicolon.parser
}

KssParseDirective :: (p: KssParser) -> KssParser {
    p = KssAdvance(p, 1)
    keyword: KssNameResult = KssReadName(p)
    if !keyword.ok {
        return KssFail(keyword.parser, "expected directive name")
    }

    if KssNameEquals(keyword.name, "pack") {
        value: KssNameResult = KssReadName(keyword.parser)
        if !value.ok {
            return KssFail(value.parser, "expected pack id")
        }
        p = value.parser
        if p.import_depth > 0 {
            p = KssSkipSpace(p)
            if !KssAtEnd(p) && p.source[p.pos] == 59 {
                p = KssAdvance(p, 1)
            }
            return p
        }
        p.pack = value.name
        semicolon: KssExpectResult = KssExpect(p, 59)
        if !semicolon.ok {
            return KssFail(semicolon.parser, "expected ';'")
        }
        return semicolon.parser
    }
    if KssNameEquals(keyword.name, "version") {
        value: KssNumberResult = KssReadNumber(keyword.parser)
        if !value.ok {
            return KssFail(value.parser, "expected version number")
        }
        if (i32)value.value != 1 {
            return KssFail(value.parser, "unsupported style sheet version")
        }
        if p.version_seen {
            return KssFail(value.parser, "version declared twice")
        }
        p.version_seen = true
        semicolon: KssExpectResult = KssExpect(value.parser, 59)
        if !semicolon.ok {
            return KssFail(semicolon.parser, "expected ';'")
        }
        return semicolon.parser
    }
    if KssNameEquals(keyword.name, "layer") {
        return KssParseLayerList(keyword.parser)
    }
    if KssNameEquals(keyword.name, "import") {
        target: KssNameResult = KssReadImportTarget(keyword.parser)
        if !target.ok {
            return KssFail(target.parser, "expected import target")
        }
        p = target.parser
        semicolon: KssExpectResult = KssExpect(p, 59)
        if !semicolon.ok {
            return KssFail(semicolon.parser, "expected ';'")
        }
        p = semicolon.parser
        p.pending_import = target.name
        p.status = (i32)KssStatusNeedImport
        return p
    }
    if KssNameEquals(keyword.name, "theme") {
        value: KssNameResult = KssReadName(keyword.parser)
        if !value.ok {
            return KssFail(value.parser, "expected theme name")
        }
        return KssParseThemeBlock(value.parser, value.name)
    }
    if KssNameEquals(keyword.name, "env") {
        axis: KssNameResult = KssReadName(keyword.parser)
        if !axis.ok {
            return KssFail(axis.parser, "expected environment axis")
        }
        if !KssEnvAxisValid(axis.name) {
            return KssFailName(axis.parser, "unknown environment axis '",
                axis.name)
        }
        open: KssExpectResult = KssExpect(axis.parser, 40)
        if !open.ok {
            return KssFail(open.parser, "expected '(' after @env axis")
        }
        value: KssNameResult = KssReadName(open.parser)
        if !value.ok {
            return KssFail(value.parser, "expected environment value")
        }
        close: KssExpectResult = KssExpect(value.parser, 41)
        if !close.ok {
            return KssFail(close.parser, "expected ')'")
        }
        return KssParseEnvBlock(close.parser, axis.name, value.name)
    }
    return KssFailName(keyword.parser, "unknown directive '@", keyword.name)
}

# Import resolution. The host supplies sources; the parser tracks ordering,
# cycles, and per-file provenance.

KssImportNameOnStack :: (p: KssParser, name: KssName) -> bool {
    index: i32 = 0
    while index < p.import_depth {
        if KssNameEqualsName(p.imports[index].name, name) {
            return true
        }
        index = index + 1
    }
    return false
}

KssProvideImport :: (p: KssParser, source: string, name: string) -> KssParser #export {
    import_name: KssName = KssMakeName(name)
    if KssImportNameOnStack(p, import_name) {
        return KssFailName(p, "@import cycle: ", import_name)
    }
    if p.import_depth >= 8 || p.file_count >= 8 {
        return KssFail(p, "style import depth exceeded")
    }
    p.imports[p.import_depth].name = import_name
    p.imports[p.import_depth].outer_source = p.source
    p.imports[p.import_depth].outer_pos = p.pos
    p.imports[p.import_depth].outer_line = p.line
    p.imports[p.import_depth].outer_column = p.column
    p.imports[p.import_depth].outer_file = p.file
    p.import_depth = p.import_depth + 1
    p.files[p.file_count] = KssCopyFileName(name)
    p.file = p.file_count
    p.file_count = p.file_count + 1
    p.source = source
    p.pos = 0
    p.line = 1
    p.column = 1
    p.status = (i32)KssStatusContinue
    return p
}

KssFailImport :: (p: KssParser) -> KssParser #export {
    return KssFailName(p, "missing import: ", p.pending_import)
}

KssPopImport :: (p: KssParser) -> KssParser {
    if p.import_depth <= 0 {
        return p
    }
    p.import_depth = p.import_depth - 1
    p.source = p.imports[p.import_depth].outer_source
    p.pos = p.imports[p.import_depth].outer_pos
    p.line = p.imports[p.import_depth].outer_line
    p.column = p.imports[p.import_depth].outer_column
    p.file = p.imports[p.import_depth].outer_file
    return p
}

# One parse step. Statuses: Rule (collect p.rule), NeedImport (feed via
# KssProvideImport/KssFailImport), Done, Error (read p.diagnostic).

KssStep :: (p: KssParser) -> KssParser #export {
    if p.status == (i32)KssStatusError || p.status == (i32)KssStatusDone {
        return p
    }
    if p.in_env {
        p.status = (i32)KssStatusContinue
        p = KssContinueEnvBlock(p)
        if p.status == (i32)KssStatusRule ||
           p.status == (i32)KssStatusError {
            return p
        }
    }
    p = KssSkipSpace(p)
    if KssAtEnd(p) {
        if p.import_depth > 0 {
            p = KssPopImport(p)
            p.status = (i32)KssStatusContinue
            return p
        }
        p.status = (i32)KssStatusDone
        return p
    }
    if p.source[p.pos] == 64 {
        p = KssParseDirective(p)
        if p.status == (i32)KssStatusNeedImport ||
           p.status == (i32)KssStatusError ||
           p.status == (i32)KssStatusRule {
            return p
        }
        p.status = (i32)KssStatusContinue
        return p
    }
    probe: KssNameResult = KssReadName(p)
    if probe.ok && KssNameEquals(probe.name, "tokens") {
        return KssParseTokensBlock(probe.parser, (i32)KssOriginPack)
    }
    return KssParseRule(p)
}

