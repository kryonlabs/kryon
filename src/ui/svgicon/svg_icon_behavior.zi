// Paints an icon Shape (see svg_shape) as queued rectangles, so every host
// draws it the same way at any size, tinted with the caller's color. A host
// that draws textures can take each icon's raster as one texture instead
// (SvgIconUseTextures): a screen of icons is then one image each, not
// hundreds of rectangles, and looks the same.
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "session"
#import "svg_shape"
#import "vec"

// Icons kept rasterized at once. One screen can show many, a grid of
// symbols to choose from over sixty, so the cache holds several screens'
// worth and lets the least recently painted icon go first: an icon is
// rasterized once, not again on every frame.
SVG_ICON_CACHE :: 256;
// Pixels across the largest cached raster: 48 units at density 2.
SVG_ICON_MAX :: 96;
SVG_ICON_LEVELS :: 32;

// One rectangle of an icon's raster, in raster pixels, and its coverage out
// of SVG_ICON_LEVELS.
SvgIconCell :: struct {
    x: u8
    y: u8
    width: u8
    height: u8
    level: u8
}

// A rasterized icon is kept as its rectangles, so painting it again only
// queues them.
SvgIconEntry :: struct {
    hash: u64
    size: s32
    used: bool
    // When it was last painted; 0 for a slot never filled.
    stamp: u64
    cells: Vec(SvgIconCell)
    // The host's texture of the raster, made on first paint while the host
    // takes textures; id 0 when there is none.
    texture: Texture2D
}

// Makes a texture of a raster: size by size pixels, each a white byte and
// its alpha byte (raylib's gray-alpha format). Returns id 0 on failure.
SvgIconTextureMake :: #type (pixels: []u8, size: s32) -> Texture2D;
SvgIconTextureFree :: #type (texture: Texture2D) -> ();
svg_icon_texture_make: SvgIconTextureMake;
svg_icon_texture_free: SvgIconTextureFree;
svg_icon_textures: bool = false;
svg_icon_pixels: [SVG_ICON_MAX * SVG_ICON_MAX * 2]u8;
// Textures of icons that left the cache. A frame may still have queued one,
// so each is freed only after SVG_ICON_RETIRED more have left.
SVG_ICON_RETIRED :: 64;
svg_icon_retired: [SVG_ICON_RETIRED]Texture2D;
svg_icon_retired_next: s32 = 0;

svg_icon_cache: [SVG_ICON_CACHE]SvgIconEntry;
svg_icon_clock: u64 = 0;
svg_icon_rasters: s64 = 0;
svg_icon_coverage: [SVG_ICON_MAX * SVG_ICON_MAX]u8;
svg_icon_levels: [SVG_ICON_MAX * SVG_ICON_MAX]u8;

// How many icons have been rasterized; painting a cached icon adds none.
#program_export
SvgIconRasterCount :: () -> s64 {
    return svg_icon_rasters
}

SvgIconRetire :: (texture: Texture2D) {
    if texture.id == cast(u32)0 { return }
    oldest: Texture2D = svg_icon_retired[svg_icon_retired_next]
    if oldest.id != cast(u32)0 && svg_icon_textures { svg_icon_texture_free(oldest) }
    svg_icon_retired[svg_icon_retired_next] = texture
    svg_icon_retired_next = (svg_icon_retired_next + 1) % SVG_ICON_RETIRED
}

// Drops every icon texture. With release they are freed; without, as after
// a lost graphics context whose names mean nothing any more, only forgotten.
#program_export
SvgIconForgetTextures :: (release: bool) {
    slot: s32 = 0
    while slot < SVG_ICON_CACHE {
        texture: Texture2D = svg_icon_cache[slot].texture
        if release && svg_icon_textures && texture.id != cast(u32)0 { svg_icon_texture_free(texture) }
        svg_icon_cache[slot].texture = Texture2D.{}
        slot += 1
    }
    index: s32 = 0
    while index < SVG_ICON_RETIRED {
        texture: Texture2D = svg_icon_retired[index]
        if release && svg_icon_textures && texture.id != cast(u32)0 { svg_icon_texture_free(texture) }
        svg_icon_retired[index] = Texture2D.{}
        index += 1
    }
}

// Has icons drawn from textures the host makes and frees, on the thread
// that draws; icons already cached get theirs when next painted.
#program_export
SvgIconUseTextures :: (make: SvgIconTextureMake, release: SvgIconTextureFree) {
    SvgIconForgetTextures(true)
    svg_icon_texture_make = make
    svg_icon_texture_free = release
    svg_icon_textures = true
}

// How many cached icons have a texture.
#program_export
SvgIconTextureCount :: () -> s32 {
    count: s32 = 0
    slot: s32 = 0
    while slot < SVG_ICON_CACHE {
        if svg_icon_cache[slot].texture.id != cast(u32)0 { count += 1 }
        slot += 1
    }
    return count
}

// The slot's texture, made from its cells at the levels they paint with,
// so it looks as the rectangles would.
SvgIconTexture :: (slot: s32) -> Texture2D {
    if svg_icon_cache[slot].texture.id != cast(u32)0 { return svg_icon_cache[slot].texture }
    size: s32 = svg_icon_cache[slot].size
    index: s32 = 0
    while index < size * size {
        svg_icon_pixels[index * 2] = cast(u8)255
        svg_icon_pixels[index * 2 + 1] = cast(u8)0
        index += 1
    }
    part_index: s64 = 0
    while part_index < svg_icon_cache[slot].cells.count {
        part: SvgIconCell = svg_icon_cache[slot].cells[part_index]
        alpha: u8 = cast(u8)((255 * cast(s32)part.level) / SVG_ICON_LEVELS)
        row: s32 = cast(s32)part.y
        while row < cast(s32)part.y + cast(s32)part.height {
            column: s32 = cast(s32)part.x
            while column < cast(s32)part.x + cast(s32)part.width {
                svg_icon_pixels[(row * size + column) * 2 + 1] = alpha
                column += 1
            }
            row += 1
        }
        part_index += 1
    }
    svg_icon_cache[slot].texture = svg_icon_texture_make(svg_icon_pixels[0:size * size * 2], size)
    return svg_icon_cache[slot].texture
}

// FNV-1a over the shape's bytes, so the cache is keyed by its drawing.
SvgIconHash :: (shape: string) -> u64 {
    hash: u64 = cast(u64)14695981039346656037
    index: s32 = 0
    while index < cast(s32)shape.count {
        hash = (hash ^ cast(u64)shape[index]) * cast(u64)1099511628211
        index += 1
    }
    return hash
}

// Splits the raster's coverage into the slot's rectangles. Each unpainted
// pixel grows right, then down, across equal levels, so solid areas are a
// few rectangles and edges keep their anti-aliasing.
SvgIconCells :: (slot: s32, size: s32) -> bool {
    index: s32 = 0
    while index < size * size {
        svg_icon_levels[index] = cast(u8)((cast(s32)svg_icon_coverage[index] *
            SVG_ICON_LEVELS + 127) / 255)
        index += 1
    }
    VecClear(svg_icon_cache[slot].cells)
    row: s32 = 0
    while row < size {
        column: s32 = 0
        while column < size {
            level: s32 = svg_icon_levels[row * size + column]
            if level == 0 {
                column += 1
                continue
            }
            width: s32 = 1
            while column + width < size &&
                cast(s32)svg_icon_levels[row * size + column + width] == level {
                width += 1
            }
            height: s32 = 1
            growing: bool = true
            while growing && row + height < size {
                across: s32 = 0
                while across < width {
                    if cast(s32)svg_icon_levels[(row + height) * size + column + across] != level {
                        growing = false
                        break
                    }
                    across += 1
                }
                if growing { height += 1 }
            }
            part: SvgIconCell = SvgIconCell.{cast(u8)column, cast(u8)row,
                cast(u8)width, cast(u8)height, cast(u8)level}
            if !VecPush(svg_icon_cache[slot].cells, part) { return false }
            paint_row: s32 = 0
            while paint_row < height {
                across: s32 = 0
                while across < width {
                    svg_icon_levels[(row + paint_row) * size + column + across] = cast(u8)0
                    across += 1
                }
                paint_row += 1
            }
            column += width
        }
        row += 1
    }
    return true
}

// The cached rectangles for shape at size, rasterizing it on first use into
// the least recently painted slot. Returns -1 when the shape cannot be drawn.
SvgIconSlot :: (shape: string, size: s32) -> s32 {
    hash: u64 = SvgIconHash(shape)
    svg_icon_clock += cast(u64)1
    oldest: s32 = 0
    slot: s32 = 0
    while slot < SVG_ICON_CACHE {
        if svg_icon_cache[slot].used && svg_icon_cache[slot].hash == hash &&
            svg_icon_cache[slot].size == size {
            svg_icon_cache[slot].stamp = svg_icon_clock
            return slot
        }
        if svg_icon_cache[slot].stamp < svg_icon_cache[oldest].stamp { oldest = slot }
        slot += 1
    }
    slot = oldest
    SvgIconRetire(svg_icon_cache[slot].texture)
    svg_icon_cache[slot].texture = Texture2D.{}
    svg_icon_cache[slot].used = false
    svg_icon_cache[slot].stamp = cast(u64)0
    if !ShapeRaster(shape, size, svg_icon_coverage[:]) || !SvgIconCells(slot, size) {
        return -1
    }
    svg_icon_rasters += 1
    svg_icon_cache[slot].hash = hash
    svg_icon_cache[slot].size = size
    svg_icon_cache[slot].used = true
    svg_icon_cache[slot].stamp = svg_icon_clock
    return slot
}

// Paints shape inside bounds in color. The icon is drawn square and centered,
// rasterized at the host's screen pixels so a scaled frame keeps it sharp.
#program_export
// The nearest screen pixel boundary, in layout units.
SvgIconSnap :: (value: float32, scale: float32) -> float32 {
    pixels: float32 = value * scale
    whole: float32 = cast(float32)cast(s32)pixels
    if pixels < 0.0 && whole != pixels { whole -= 1.0 }
    if pixels - whole >= 0.5 { whole += 1.0 }
    return whole / scale
}

PaintSvgIcon :: (session: Session, node: s32, shape: string, bounds: Rectangle,
    color: Color) {
    if shape.count == 0 || bounds.width <= 0.0 || bounds.height <= 0.0 || color.a == cast(u8)0 {
        return
    }
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    scale: float32 = PaintPixelScale()
    size: s32 = cast(s32)(edge * scale + 0.5)
    if size < 1 { size = 1 }
    // Each raster cell is one screen pixel, and the icon's corner sits on a
    // screen pixel, so the painted cells meet on whole pixels: no seams where
    // the host anti-aliases a cell edge between two pixels.
    cell: float32 = 1.0 / scale
    if size > SVG_ICON_MAX {
        size = SVG_ICON_MAX
        cell = edge / cast(float32)size
    }
    slot: s32 = SvgIconSlot(shape, size)
    if slot < 0 { return }
    extent: float32 = cast(float32)size * cell
    left: float32 = SvgIconSnap(bounds.x + (bounds.width - extent) * 0.5, scale)
    top: float32 = SvgIconSnap(bounds.y + (bounds.height - extent) * 0.5, scale)
    if svg_icon_textures {
        texture: Texture2D = SvgIconTexture(slot)
        if texture.id != cast(u32)0 {
            // One raster pixel per screen pixel, sampled without blending.
            area: Rectangle = Rectangle.{left, top, extent, extent}
            PaintImage(session, node, "", texture.id,
                Rectangle.{0.0, 0.0, cast(float32)size, cast(float32)size}, area, area,
                Vector2.{0.0, 0.0}, 0.0, 0.0, color, texture)
            return
        }
    }
    index: s64 = 0
    while index < svg_icon_cache[slot].cells.count {
        part: SvgIconCell = svg_icon_cache[slot].cells[index]
        fill: Color = color
        fill.a = cast(u8)((cast(s32)color.a * cast(s32)part.level) / SVG_ICON_LEVELS)
        PaintRoundedFill(session, node,
            Rectangle.{left + cast(float32)part.x * cell, top + cast(float32)part.y * cell,
                cast(float32)part.width * cell, cast(float32)part.height * cell},
            0.0, 1, fill)
        index += 1
    }
}

// Appends value with up to two decimals, as the shape language reads it.
StrokeAppendNumber :: (output: []u8, length: *s32, value: float32) {
    hundredths: s32 = cast(s32)(value * 100.0 + 0.5)
    if hundredths < 0 { hundredths = 0 }
    digits: [12]u8
    count: s32 = 0
    whole: s32 = hundredths / 100
    if whole == 0 {
        digits[0] = #char "0"
        count = 1
    }
    while whole > 0 {
        digits[count] = cast(u8)(#char "0" + whole % 10)
        count += 1
        whole /= 10
    }
    while count > 0 && length.* < cast(s32)output.count {
        count -= 1
        output[length.*] = digits[count]
        length.* += 1
    }
    if length.* + 3 <= cast(s32)output.count {
        output[length.*] = #char "."
        output[length.* + 1] = cast(u8)(#char "0" + (hundredths / 10) % 10)
        output[length.* + 2] = cast(u8)(#char "0" + hundredths % 10)
        length.* += 3
    }
}

StrokeAppendByte :: (output: []u8, length: *s32, byte: u8) {
    if length.* < cast(s32)output.count {
        output[length.*] = byte
        length.* += 1
    }
}

// Paints the line through points as a smooth stroke of the given width with
// round caps and joins. It is rasterized like an icon, so it is
// anti-aliased alike on every host and at every scale; up to eight points.
#program_export
PaintStroke :: (session: Session, node: s32, points: []Vector2,
    width: float32, color: Color) {
    if points.count < 2 || points.count > 8 || width <= 0.0 ||
        color.a == cast(u8)0 {
        return
    }
    left: float32 = points[0].x
    right: float32 = points[0].x
    top: float32 = points[0].y
    bottom: float32 = points[0].y
    for point: points {
        if point.x < left { left = point.x }
        if point.x > right { right = point.x }
        if point.y < top { top = point.y }
        if point.y > bottom { bottom = point.y }
    }
    // A square around the line and its round ends, centred on it.
    edge: float32 = right - left
    if bottom - top > edge { edge = bottom - top }
    edge += width + 1.0
    bounds: Rectangle = Rectangle.{(left + right - edge) * 0.5,
        (top + bottom - edge) * 0.5, edge, edge}
    unit: float32 = SHAPE_VIEW / edge
    shape: [256]u8
    length: s32 = 0
    StrokeAppendByte(shape[:], *length, #char "S")
    StrokeAppendNumber(shape[:], *length, width * unit)
    StrokeAppendByte(shape[:], *length, #char "r")
    StrokeAppendByte(shape[:], *length, #char "r")
    StrokeAppendByte(shape[:], *length, #char ":")
    index: s32 = 0
    for point: points {
        StrokeAppendByte(shape[:], *length, ifx index == 0 then #char "M" else #char "L")
        StrokeAppendNumber(shape[:], *length, (point.x - bounds.x) * unit)
        StrokeAppendByte(shape[:], *length, #char " ")
        StrokeAppendNumber(shape[:], *length, (point.y - bounds.y) * unit)
        index += 1
    }
    PaintSvgIcon(session, node, TextView(shape[0:length]), bounds, color)
}
