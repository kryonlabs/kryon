#import "control_props"
#import "drawing_props"
#import "geometry"
#import "raster"
#import "style"

SeparatorLine :: struct {
    line: Rectangle
    color: u32
}

SeparatorLabelPaint :: struct {
    text: Rectangle
    line: Rectangle
    text_color: u32
    line_color: u32
    show_text: bool
    show_line: bool
}

BulletPaint :: struct {
    bounds: Rectangle
    center: Vector2
    radius: float32
    color: u32
}

#program_export
SeparatorLineRole :: () -> s32 {
    return 7
}

#program_export
SeparatorLabelRole :: () -> s32 {
    return 6
}

#program_export
SeparatorBulletRole :: () -> s32 {
    return 8
}

#program_export
SeparatorLineFor :: (bounds: Rectangle, vertical: bool, frame: StyleFrame) -> SeparatorLine {
    paint: SeparatorLine
    paint.color = frame.value.background
    if vertical {
        paint.line.x = bounds.x + bounds.width * 0.5
        paint.line.y = bounds.y
        paint.line.width = 0.0
        paint.line.height = bounds.height
    } else {
        paint.line.x = bounds.x
        paint.line.y = bounds.y + bounds.height * 0.5
        paint.line.width = bounds.width
        paint.line.height = 0.0
    }
    return paint
}

#program_export
RenderSeparatorLine :: (bounds: Rectangle, vertical: bool,
    frame: StyleFrame) {
    paint: SeparatorLine = SeparatorLineFor(bounds, vertical, frame)
    StrokeLine(paint.line, ColorFromPacked(paint.color))
}

#program_export
SeparatorLabelPaintFor :: (bounds: Rectangle, label_width: float32,
    has_label: bool, font: s32, scale: float32, frame: StyleFrame) -> SeparatorLabelPaint {
    paint: SeparatorLabelPaint
    if scale <= 0.0 { scale = 1.0 }
    if font <= 0 { font = 14 }

    gap: float32 = frame.value.gap
    if (frame.value.fields & cast(u32)StyleGap) == cast(u32)0 || gap < 0.0 {
        gap = 12.0
    }
    gap *= scale
    line_x: float32 = bounds.x
    end_x: float32 = bounds.x + bounds.width

    paint.text.x = bounds.x
    paint.text.y = bounds.y + (bounds.height - cast(float32)font) * 0.5
    paint.text.width = label_width
    paint.text.height = bounds.height
    paint.text_color = frame.value.foreground
    paint.line_color = frame.value.background
    paint.show_text = has_label

    if has_label {
        line_x = bounds.x + label_width + gap
    }

    paint.line.x = line_x
    paint.line.y = bounds.y + bounds.height * 0.5
    paint.line.width = end_x - line_x
    paint.line.height = 0.0
    paint.show_line = line_x < end_x
    if paint.line.width < 0.0 {
        paint.line.width = 0.0
        paint.show_line = false
    }
    return paint
}

#program_export
BulletPaintFor :: (bounds: Rectangle, frame: StyleFrame) -> BulletPaint {
    paint: BulletPaint
    size: float32 = frame.value.icon_size
    if size <= 0.0 {
        size = bounds.width
        if bounds.height < size {
            size = bounds.height
        }
        size = size * 0.5
    }
    paint.bounds.x = bounds.x + (bounds.width - size) * 0.5
    paint.bounds.y = bounds.y + (bounds.height - size) * 0.5
    paint.bounds.width = size
    paint.bounds.height = size
    paint.center.x = bounds.x + bounds.width * 0.5
    paint.center.y = bounds.y + bounds.height * 0.5
    paint.radius = size * 0.5
    paint.color = frame.value.foreground
    return paint
}
