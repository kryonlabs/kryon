#import "kryon.h"
#style <kryon.material> as material

app "Kryon Menus" {
    size 800 600
    fps 60
    font examples
}

state {
    open_menu: int = -1
    status: [64] char = "No menu command"
}

MenusExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        AppBackground()
        file_items: [4] MenuItem = {{MenuCommand,"New","Ctrl+N",1,0,0,NULL,0},{MenuCommand,"Open","Ctrl+O",2,0,0,NULL,0},{MenuSeparator,NULL,NULL,0,0,0,NULL,0},{MenuCommand,"Quit","Esc",3,0,0,NULL,0}}
        view_items: [3] MenuItem = {{MenuCheck,"Show Grid","G",4,0,1,NULL,0},{MenuRadio,"Compact",NULL,5,0,0,NULL,0},{MenuRadio,"Comfortable",NULL,6,0,1,NULL,0}}
        menus: [2] MenuGroup = {{{0},"File",file_items,4},{{0},"View",view_items,3}}
        result: MenuResult = Menu((MenuProps){.id = 100, .mode = MenuModeBar, .bounds = {0,0,GetScreenWidth(),34}, .menus = menus, .menu_count = 2, .open_index = &open_menu})
        if result.activated_id != 0 {
            snprintf(status,sizeof(status),"Command %d",result.activated_id)
        }
        Text((TextProps){.bounds={40, 80, 0, 0}, .text=status, .font=20, .wrap=TextWrapNone})
    }
}
