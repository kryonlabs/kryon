#module "style_pack_props"
#import "kryon_compat.generated.h"
#import "runtime/style_sheet.h"
#import "runtime/style.h"
#import "ui_style_picker_props.generated.h"
#import "ui_style_token_props.generated.h"

STYLE_PACK_MAX :: 32

# C-only record: the pack points at a parsed StyleSheet owned by the loader.
StylePack :: struct { const char *id; const char *label; const char *description; const StyleSheet *sheet; } #type

# Implemented by the C-only style hosts; declared here for the public ABI.
RegisterStylePackVariant :: (id: const char*, source: const char*, label: const char*, colors: const StyleColorToken*, color_count: i32) -> bool #extern #export
RegisterStylePack :: (pack: StylePack) -> bool #extern #export
RegisterStylePackSource :: (source: const char*, label: const char*, description: const char*) -> bool #extern #export
RegisterBuiltInStylePacks :: () -> bool #extern #export
ReapplyBuiltInStyleTheme :: (theme: const char*) -> bool #extern #export
EnsureBuiltInStylePacks :: () -> bool #extern #export
ClearStylePacks :: () #extern #export
GetStylePackCount :: () -> i32 #extern #export
GetStylePackAt :: (index: i32) -> const StylePack* #extern #export
FindStylePack :: (id: const char*) -> const StylePack* #extern #export
SetActiveStylePack :: (id: const char*) -> bool #extern #export
SetStyleTheme :: (theme: const char*) -> bool #extern #export
GetActiveStylePack :: () -> const StylePack* #extern #export
GetActiveStylePackId :: () -> const char* #extern #export
GetStylePackOptions :: (options: *StylePackOption, capacity: i32) -> i32 #extern #export
StylePackVersion :: () -> u64 #extern #export
StyleClassId :: (class_name: const char*) -> i32 #extern #export
ResolveStyle :: (sheet: const StyleSheet*, base: StyleData, facts: StyleFacts, active_state: i32) -> StyleData #extern #export
ResolveActiveStyle :: (base: StyleData, facts: StyleFacts, active_state: i32) -> StyleData #extern #export
StylePicker :: (props: StylePickerProps) -> bool #extern #export
