#import "drawing_props"
#import "geometry"

fills: s32;
outlines: s32;
lines: s32;
labels: s32;
failed: bool;

BoxIsExpected :: (bounds: Rectangle) -> bool {
    return bounds.x == 11.0 && bounds.y == 25.0 &&
        bounds.width == 20.0 && bounds.height == 20.0
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if value != "Agree" || font != 14 || typeface.count != 0 {
        failed = true
    }
    return 35
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if !BoxIsExpected(bounds) || radius != cast(float32)0.18 ||
        segments != 8 || color.r != cast(u8)0x12 ||
        color.g != cast(u8)0x34 || color.b != cast(u8)0x56 {
        failed = true
    }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    expected_red: u8 = cast(u8)0x12
    if outlines == 0 { expected_red = cast(u8)0x73 }
    if !BoxIsExpected(bounds) || radius != cast(float32)0.18 ||
        segments != 8 || width != 1.0 || color.r != expected_red {
        failed = true
    }
    outlines += 1
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    if line.x < 16.0 || line.x > 20.0 ||
        line.y < 30.0 || line.y > 41.0 ||
        line.width <= 0.0 || color.r != cast(u8)255 ||
        color.g != cast(u8)255 || color.b != cast(u8)255 {
        failed = true
    }
    lines += 1
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if value != "Agree" || x != 42 || y != 29 || font != 14 ||
        clip.x != 10.0 || clip.y != 20.0 ||
        clip.width != 120.0 || clip.height != 30.0 ||
        color.r != cast(u8)0x17 || color.g != cast(u8)0x17 ||
        color.b != cast(u8)0x17 { failed = true }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
CheckboxHostFailed :: () -> bool { return failed }

#program_export
CheckboxFills :: () -> s32 { return fills }

#program_export
CheckboxOutlines :: () -> s32 { return outlines }

#program_export
CheckboxLines :: () -> s32 { return lines }

#program_export
CheckboxLabels :: () -> s32 { return labels }
