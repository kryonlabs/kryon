#import "touch_hold"

// Laws for a held press on a game's touch area. Each states the expected
// behavior independently of the implementation; `ziran check` proves it over
// every listed input. An implementation edit may not change this file.

H :: (direction: s32, last: s32, now: s32, next: s32) -> TouchHold {
    return TouchHoldStep(direction, last, cast(float64)now, cast(float64)next, 0.5)
}

// Without a repeat, holding never steps.
#law NoRepeatNoStep forall direction: -1..3, last: -1..3, now: 0..4, next: 0..4 => TouchHoldStep(direction, last, cast(float64)now, cast(float64)next, 0.0).direction == -1 && !TouchHoldStep(direction, last, cast(float64)now, cast(float64)next, 0.0).toward;

// Moving out in a new direction steps that way at once and waits two
// repeats for the next step, like the first repeat of a held key.
#law NewDirectionStepsAtOnce forall direction: 0..3, last: -1..3, now: 0..4, next: 0..8 => direction == last || (H(direction, last, now, next).direction == direction && H(direction, last, now, next).last == direction && H(direction, last, now, next).next == cast(float64)now + 1.0 && !H(direction, last, now, next).toward);

// Staying in the same direction steps again only when the step is due,
// then waits one repeat.
#law SameDirectionRepeats forall direction: 0..3, now: 0..4, next: 0..8 => H(direction, direction, now, next).direction == (ifx now >= next then direction else -1) && H(direction, direction, now, next).next == (ifx now >= next then cast(float64)now + 0.5 else cast(float64)next);

// A press held in place steps towards itself whenever a step is due.
#law HeldInPlaceStepsToward forall now: 0..4, next: 0..8 => H(-1, -1, now, next).toward == (now >= next) && H(-1, -1, now, next).direction == -1 && H(-1, -1, now, next).next == (ifx now >= next then cast(float64)now + 0.5 else cast(float64)next);

// Coming back within reach after a step stops walking until it moves out
// again.
#law BackWithinReachStops forall last: 0..3, now: 0..4, next: 0..8 => H(-1, last, now, next).direction == -1 && !H(-1, last, now, next).toward && H(-1, last, now, next).last == last;
