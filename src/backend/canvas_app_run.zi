// Runs one portable app compiled into the browser page on the canvas host,
// for an app whose interpreted ZX is too slow on a phone. It is the same
// AppContext app a ZX player runs: the build binds CanvasAppMain to the
// app's Main (--bind canvas_app_run:CanvasAppMain=MODULE:Main), and this
// runner answers the app's context calls itself. Its private documents live
// where a ZX player keeps them, /kryon-apps/<app id> on IndexedDB, so
// saves carry over between the two.
#import "secondary_pointer"
#import "frame_snapshot"
using Host :: #import "Canvas";
#import "geometry"
#import "session"
#import "tree"
#import "tree_draw"
#import "canvas_frame"
#import "dom_tree"
#import "dom_host"
#import "dom_paint"
#import "tree_input"
#import "scroll_device"
#import "key_input"
#import "canvas_events"
TextField :: #import "textfield";
#import "theme"
#import "app_protocol"
#import "app_files"
#import "bundle_storage_web"
#import "bundle_time"
#import "page_core"
#import "test_driver"
#import "std/vec"
#import "page_route"
#import "mini_embed"
#import "std/web"
#import "std/text_buffer"
#import "canvas_app_hooks"

using FrameStatus;

host_api :: #system_library "host_api";
// The app's Main, bound when the page is built.
CanvasAppMain :: () -> s64 #foreign host_api;

canvas_app_mode: s32;
canvas_app_session: Session;
canvas_app_bounds: Rectangle;
canvas_app_key: s32;
canvas_app_modifiers: s32;
canvas_app_typed: [1024]u8;
canvas_app_typed_length: s64;
canvas_app_id: [64]u8;
canvas_app_id_length: s64;
canvas_app_files: AppFiles;
canvas_app_read: string;
canvas_app_unsaved: bool;

// A page embedded with ?mini runs the app in mini mode.
canvas_app_mini: bool;
canvas_app_semantic_dom: bool;
canvas_app_dark: bool;
canvas_app_reduced_motion: bool;
canvas_app_theme_changed: bool;
canvas_app_theme_media: [2]s32;
canvas_app_theme_functions: [2]s32;
#program_export
AppModeHost :: () -> s32 { return canvas_app_mode }

#program_export
AppIdentityHost :: (id: string, minimum_api: s32) {
    unused minimum_api
    if id.count >= canvas_app_id.count { return }
    for index: cast(s64)0..id.count - 1 { canvas_app_id[index] = id[index] }
    canvas_app_id_length = id.count
}

#program_export
AppDescribeHost :: (name: string, icon_shape: string) {
    unused name
    unused icon_shape
}

#program_export
AppSessionHost :: () -> Session { return canvas_app_session }
#program_export
AppBoundsHost :: () -> Rectangle { return canvas_app_bounds }
#program_export
AppDarkHost :: () -> bool { return canvas_app_dark }
#program_export
AppScaleHost :: () -> float32 { return cast(float32)PageDpi() }
#program_export
AppFontHost :: () -> s32 { return cast(s32)CurrentTheme().metrics.text_body }
#program_export
AppKeyHost :: () -> s32 { return canvas_app_key }
#program_export
AppModifiersHost :: () -> s32 { return canvas_app_modifiers }

CanvasAppFieldInput :: () -> TextField.Input {
    input := TextFieldInputFor(canvas_app_key, canvas_app_modifiers,
        TextView(canvas_app_typed[:canvas_app_typed_length]))
    composition := CanvasCompositionFrame()
    input.composition_event = composition
    return input
}

CanvasAppThemeMatches :: (query: string) -> bool {
    media := WebAsObject(WebCall1(WebGlobal, WebName("matchMedia"), WebText(query)))
    return media != 0 && WebAsBool(WebGet(media, WebName("matches")))
}

CanvasAppThemeChanged :: (context: s32, first: s32, second: s32, third: s32) {
    unused first
    unused second
    unused third
    scope := WebScope()
    if context == 0 {
        canvas_app_dark = CanvasAppThemeMatches("(prefers-color-scheme: dark)")
    } else {
        canvas_app_reduced_motion = CanvasAppThemeMatches("(prefers-reduced-motion: reduce)")
    }
    canvas_app_theme_changed = true
    WebEnd(scope)
}

CanvasAppThemeWatch :: (query: string, context: s32) -> bool {
    scope := WebScope()
    media := WebAsObject(WebCall1(WebGlobal, WebName("matchMedia"), WebText(query)))
    matches := media != 0 && WebAsBool(WebGet(media, WebName("matches")))
    if media != 0 && canvas_app_theme_functions[context] == 0 {
        function := WebFunction(CanvasAppThemeChanged, context)
        canvas_app_theme_functions[context] = function
        canvas_app_theme_media[context] = WebKeep(media)
        unused WebCall2(media, WebName("addEventListener"), WebText("change"),
            WebObject(function))
    }
    WebEnd(scope)
    return matches
}

CanvasAppThemeApply :: () {
    unused InstallDefaultTheme(canvas_app_dark, canvas_app_reduced_motion)
}

CanvasAppThemeClose :: () {
    scope := WebScope()
    for index: cast(s32)0..1 {
        if canvas_app_theme_media[index] != 0 { WebRelease(canvas_app_theme_media[index]) }
        if canvas_app_theme_functions[index] != 0 { WebRelease(canvas_app_theme_functions[index]) }
        canvas_app_theme_media[index] = 0
        canvas_app_theme_functions[index] = 0
    }
    WebEnd(scope)
}

#program_export
AppFieldInputHost :: () -> TextField.Input {
    return CanvasAppFieldInput()
}
#program_export
AppKeyboardHost :: (visible: bool) { unused visible }
#program_export
AppNowHost :: () -> float64 { return cast(float64)BundleUnixMilliseconds() / 1000.0 }
#program_export
AppLocalOffsetHost :: () -> s32 { return BundleLocalOffset() }
// Optional services belong to the installed host extension.
#program_export
AppSupportsHost :: (capability: string) -> bool {
    return (canvas_app_mini && capability == MINI_MODE_CAPABILITY) || CanvasAppExtensionSupports(capability)
}
#program_export
AppServiceHost :: (name: string, request: string) -> string {
    return CanvasAppExtensionService(name, request)
}
// The app carries its own words; a page has no locale files of its own.
#program_export
AppLocaleHost :: (key: string) -> string { unused key; return "" }
#program_export
AppAssetPathHost :: (name: string) -> string { return name }

#program_export
DocumentStorageReadyHost :: () -> bool { return AppFilesReady(*canvas_app_files) }
#program_export
DocumentFlushHost :: () -> bool { return AppFilesFlush(*canvas_app_files) }
#program_export
DocumentStatusHost :: () -> s32 { return canvas_app_files.status }
#program_export
DocumentReadHost :: (name: string) -> string {
    AppFileFree(canvas_app_read)
    canvas_app_read = AppFileRead(*canvas_app_files, name)
    return canvas_app_read
}
#program_export
DocumentWriteHost :: (name: string, value: string) -> bool {
    saved := AppFileWrite(*canvas_app_files, name, value)
    if saved { canvas_app_unsaved = true }
    return saved
}

libc :: #system_library "libc";
CanvasAppWrite :: (fd: s32, input: *u8, count: usize) -> isize #foreign libc "write";

CanvasAppError :: (message: string) -> s32 {
    output: [256]u8
    length: s64 = ifx message.count > 254 then 254 else message.count
    for index: cast(s64)0..length - 1 { output[index] = message[index] }
    output[length] = cast(u8)10
    unused CanvasAppWrite(2, *output[0], cast(usize)(length + 1))
    return 1
}

// The app's documents, once IndexedDB has filled the mounted folder.
CanvasAppOpenFiles :: () -> bool {
    root: Vec(u8)
    BuilderPrint(*root, "/kryon-apps/%", TextView(canvas_app_id[:canvas_app_id_length]))
    return AppFilesOpen(*canvas_app_files, BuilderFinish(root))
}

CanvasAppFrame :: (session: Session, viewport: Rectangle) -> bool {
    if !CanvasFrameInputBegin(session) { return false }
    defer { FrameInputEnd(session) }
    BeginCanvasFrame()
    // A test driver may stand in for the person (KRYON_TEST_DRIVER).
    pointer: PointerFrame = TestDriverPointer(session, PollPointer())
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    if canvas_app_semantic_dom { DomHostFrame(session) }
    wheel := TestDriverWheel(CanvasWheelMove())
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    // Scrolls take their wheel, drags and flings from the sampled device;
    // without it no list in a compiled page could scroll.
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel, AppNowHost())
    if BeginFrame(session, cast(u64)1, viewport) != cast(FrameStatus)FrameOk {
        EndCanvasFrame()
        return false
    }
    canvas_app_mode = APP_FRAME
    canvas_app_session = session
    canvas_app_bounds = viewport
    replacement := CanvasAppExtensionFrame(session, viewport, canvas_app_key,
        canvas_app_modifiers, CanvasAppFieldInput())
    if replacement < 0 { EndCanvasFrame(); return false }
    if replacement == 0 { unused CanvasAppMain() }
    commit_status: FrameStatus
    if canvas_app_semantic_dom { commit_status = DomPaintFrame(session) }
    else { commit_status = EndCanvasUiFrame(session) }
    if commit_status != cast(FrameStatus)FrameOk {
        EndCanvasFrame()
        return false
    }
    CanvasCursor(session)
    if canvas_app_semantic_dom {
        if !DomReconcile(session, viewport) {
            EndCanvasFrame()
            return false
        }
    }
    drawn := EndCanvasFrame()
    TestDriverFrame(session)
    return drawn
}

#program_export
CanvasAppMainLoop :: (semantic_dom: bool) -> s32 {
    canvas_app_semantic_dom = semantic_dom
    if !OpenCanvas() {
        CloseCanvas()
        return CanvasAppError("kryon: could not open the browser canvas")
    }
    page_native_dom = semantic_dom
    canvas_app_mode = APP_IDENTIFY
    canvas_app_dark = CanvasAppThemeWatch("(prefers-color-scheme: dark)", 0)
    canvas_app_reduced_motion = CanvasAppThemeWatch("(prefers-reduced-motion: reduce)", 1)
    CanvasAppThemeApply()
    route_query: [512]u8
    PageRouteReadQuery(route_query[:])
    canvas_app_mini = MiniModeQuery(TextUntilNul(route_query[:]))
    if CanvasAppMain() != APP_PROTOCOL || canvas_app_id_length == 0 {
        CloseCanvas()
        return CanvasAppError("kryon: the compiled app did not identify itself")
    }
    unused BundleStorageOpen()
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseCanvas()
        return CanvasAppError("kryon: could not open a UI session")
    }
    files_open := false
    extension_open := false
    last_saved: float64 = 0.0
    ok: bool = true
    while ok && PollCanvas() {
        if canvas_app_theme_changed {
            canvas_app_theme_changed = false
            CanvasAppThemeApply()
        }
        // Saves are read only once IndexedDB has filled their folder.
        if !files_open {
            // IndexedDB answers between frames, so the wait yields.
            if !BundleStorageReady() && !BundleStorageFailed() {
                WebSleep(16)
                continue
            }
            if !CanvasAppOpenFiles() {
                ok = false
                break
            }
            files_open = true
            if !CanvasAppExtensionStart(canvas_app_mini) { ok = false; break }
            extension_open = true
        }
        CanvasAppExtensionPump()
        canvas_app_key, canvas_app_modifiers = CanvasInputTake(session)
        KeyboardModifiersSend(session, canvas_app_modifiers)
        if canvas_app_key != 0 { unused KeyboardSend(session, canvas_app_key) }
        canvas_app_typed_length = TypedTextTake(session, canvas_app_typed[:]).count
        ok = CanvasAppFrame(session, CanvasViewport())
        // Written documents reach IndexedDB in one batch about each second.
        if canvas_app_unsaved && PageNow() - last_saved >= 1000.0 {
            if BundleStorageSync(false) { canvas_app_unsaved = false }
            last_saved = PageNow()
        }
    }
    if extension_open && !CanvasAppExtensionStop() { ok = false }
    unused BundleStorageSync(false)
    AppFilesClose(*canvas_app_files)
    CloseSession(session)
    if semantic_dom { DomPaintClose(); DomClose() }
    CanvasAppThemeClose()
    CloseCanvas()
    if ok { return 0 }
    return CanvasAppError("kryon: the compiled app's frame failed")
}

#program_export
main :: () -> s32 { return CanvasAppMainLoop(false) }
