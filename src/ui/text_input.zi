#module "text_input"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style_sheet"

TextInputMetrics :: struct {
    font: i32
    padding_x: i32
    padding_y: i32
    line_gap: i32
    line_height: i32
}

TextInputResolvedStyle :: struct {
    fields: u32
    padding_x: i32
    padding_y: i32
    line_gap: i32
    radius: float
}

TextInputFactsFor :: (style_kind: i32, class_name: i32) -> StyleFacts #export {
    return StyleControlFacts(style_kind, 0, class_name, ButtonToneNeutral,
        ButtonEmphasisSoft, ControlSizeMedium, ButtonStateNormal)
}

