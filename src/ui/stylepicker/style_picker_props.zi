#import "dropdown_props"

StylePackOption :: struct {
    id: string
    label: string
    description: string
    active: bool
}

StylePickerProps :: struct {
    dropdown: DropdownProps
}

StylePickerResult :: struct {
    dropdown: DropdownResult
    selected_id: string
    changed: bool
}

StylePickerState :: struct {
    option_count: s32
    selected_index: s32
    has_options: bool
}

#program_export
StylePickerOptionCountFor :: (count: s32, limit: s32) -> s32 {
    if count < 0 { return 0 }
    if limit > 0 && count > limit { return limit }
    return count
}

#program_export
StylePickerSelectedIndexFor :: (selected: s32, count: s32) -> s32 {
    count = StylePickerOptionCountFor(count, 0)
    if count <= 0 { return -1 }
    if selected < 0 { return 0 }
    if selected >= count { return count - 1 }
    return selected
}

#program_export
StylePickerStateFor :: (count: s32, selected: s32, limit: s32) -> StylePickerState {
    state: StylePickerState
    state.option_count = StylePickerOptionCountFor(count, limit)
    state.selected_index = StylePickerSelectedIndexFor(selected,
        state.option_count)
    state.has_options = state.option_count > 0
    return state
}
