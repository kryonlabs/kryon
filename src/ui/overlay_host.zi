#module "overlay_host"
#import "ui_internal.h"
#import "runtime/overlay.h"

DismissibleOverlay :: (overlay: DismissibleOverlayProps) -> DismissibleOverlayResult #export {
    result: DismissibleOverlayResult
    mouse: Vector2 = ui_mouse_world()
    view_width: i32 = OverlayViewExtent(overlay.view_width, ui_view_width)
    view_height: i32 = OverlayViewExtent(overlay.view_height, ui_view_height)

    if overlay.scrim.a != 0 {
        DrawRectangle(0, 0, view_width, view_height, overlay.scrim)
    }
    SetModalCapture(overlay.bounds)
    policy: DismissibleOverlayPolicy = DismissibleOverlayPolicyFor(
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT), ReleaseConsumed(),
    overlay.dismiss_disabled != 0,
    CheckCollisionPointRec(mouse, overlay.bounds))
    if policy.closed && policy.release_consumed { ConsumeRelease() }
    result.closed = policy.closed
    result.outside_released = policy.outside_released
    result.release_consumed = policy.release_consumed
    return result
}
