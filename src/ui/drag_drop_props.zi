#import "geometry"

DragDropRole :: enum {
    DragDropRoleSource :: 0
    DragDropRoleTarget :: 1
}

DragDropProps :: struct {
    bounds: Rectangle
    id: s32
    class_name: s32
    role: DragDropRole
    type: string
    data: *u8
    data_size: s32
    output: *u8
    output_size: s32
    accepted_size: *s32
    disabled: bool
}
