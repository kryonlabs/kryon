Text :: #import "text";
#import "geometry"
#import "text_input"
Utf8 :: #import "std/utf8"
using Vectors :: #import "std/vec"

// The bytes a field edits when the application wires none: Bind points
// state.bytes at state.storage on first use. A field needing another
// capacity or shared bytes wires state.bytes itself (usually frame.first).
DefaultCapacity :: 256;

// The caller owns bytes; length excludes unused capacity, with no trailing
// zero required. Bind keeps preedit bytes separately from the value. A
// zeroed State is ready to edit: its bytes view storage.
State :: struct {
    bytes: []u8
    length: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    preedit: [4096]u8
    preedit_length: s32
    preedit_cursor: s32
    preedit_selection: s32
    preedit_active: bool
    storage: [DefaultCapacity]u8
}

Input :: struct {
    text: string
    paste_text: string
    composition_event: CompositionEvent
    left: bool
    right: bool
    home: bool
    end: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
}

Props :: struct {
    key: u64
    bounds: Rectangle
    value: string
    display_value: string
    label: string
    placeholder: string
    // An accessible clear action at the right, shown only for nonempty text.
    clear_label: string
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    composition: CompositionState
    id: s32
    focus_id: s32
    class_name: s32
    scale: float32
    max_bytes: s32
    max_codepoints: s32
    secure: bool
    // Accepts only the digits 0-9; touch keyboards open a number pad.
    numeric: bool
    read_only: bool
    disabled: bool
    input: Input
    // Leave unmodified Tab for KeyboardTake while this editable field owns
    // retained focus. Shift+Tab continues ordinary reverse traversal.
    capture_tab: bool
}

Edit :: struct {
    start: s32
    end: s32
    replacement: string
    changed: bool
}

Result :: struct {
    node: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    committed: bool
    escaped: bool
    composition: CompositionState
    composition_changed: bool
    clipboard_write: bool
    clipboard_text: string
    // Paste ran in an editable field while the clipboard held no text; the
    // application may take an image or files from it instead.
    paste_without_text: bool
    edit: Edit
}

BindingResult :: struct {
    node: s32
    focused: bool
    changed: bool
    committed: bool
    escaped: bool
    paste_without_text: bool
}

// Caller storage stays local even when Draw runs in a retained UI host.
StateBindingProps :: (state: *State, props: Props, preedit: []u8) -> Props {
    props = StatePropsFor(state, props)
    event := props.input.composition_event
    updating := event.phase == .CompositionStart || event.phase == .CompositionUpdate
    if (updating && event.text.count > state.preedit.count) ||
        ((updating || event.phase == .CompositionCommit) && !Utf8.Valid(event.text)) {
        props.input.composition_event = .{.phase = .CompositionCancel}
    }
    props.composition = .{}
    if state.preedit_active && state.preedit_length >= 0 &&
        state.preedit_length <= preedit.count {
        props.composition = .{.active = true, .text = TextView(preedit[:state.preedit_length]),
            .cursor = state.preedit_cursor, .selection_length = state.preedit_selection}
    }
    return props
}

// Stage the borrowed preedit before applying an edit that may change its
// backing bytes. Publish composition only after the value edit is accepted.
StateApplyBindingResult :: (state: *State, result: Result) -> bool {
    preedit: [4096]u8
    if result.composition.active {
        if result.composition.text.count > preedit.count || !Utf8.Valid(result.composition.text) { return false }
        for byte, index: result.composition.text { preedit[index] = byte }
    }
    if !StateApplyResult(state, result) { return false }
    state.preedit_active = result.composition.active
    state.preedit_cursor = result.composition.cursor
    state.preedit_selection = result.composition.selection_length
    state.preedit_length = 0
    if result.composition.active {
        state.preedit_length = cast(s32)result.composition.text.count
        for index: 0..state.preedit_length - 1 { state.preedit[index] = preedit[index] }
    }
    return true
}

StateValid :: (state: *State) -> bool {
    return state.bytes.count <= 2147483647 && state.length >= 0 &&
        state.length <= state.bytes.count &&
        Utf8.Valid(TextView(state.bytes[:state.length]))
}

// Fill the existing widget's value and interaction props from caller state.
// The value borrows bytes until the next mutation. Other props, including
// composition and application limits, keep their supplied values.
#program_export
StateProps :: (state: State,
    props: Props) -> Props {
    return StatePropsFor(*state, props)
}

StatePropsFor :: (state: *State, props: Props) -> Props {
    if !StateValid(state) {
        props.value = ""
        props.disabled = true
        return props
    }
    props.value = TextView(state.bytes[:state.length])
    props.cursor = CompositionBoundaryFor(props.value, state.cursor)
    props.anchor = CompositionBoundaryFor(props.value, state.anchor)
    props.scroll_x = state.scroll_x
    props.focused = state.focused
    if props.max_bytes <= 0 || props.max_bytes > state.bytes.count {
        props.max_bytes = cast(s32)state.bytes.count
    }
    if state.bytes.count == 0 { props.read_only = true }
    return props
}

// True means accepted (including an unchanged edit). Invalid state, ranges,
// UTF-8 or capacity and allocation failures leave every byte and field alone.
// Both range ends must be UTF-8 scalar boundaries. Replacement may alias any
// part of bytes: stage the whole join before publishing it. Accepted edits
// collapse selection after the replacement; result application below supplies
// the widget's final selection, focus and scroll instead.
#program_export
StateApplyEdit :: (state: *State,
    edit: Edit) -> bool {
    if state == null { return false }
    if !StateValid(state) { return false }
    if !edit.changed { return true }
    if edit.start < 0 || edit.end < edit.start || edit.end > state.length {
        return false
    }
    {
        value := TextView(state.bytes[:state.length])
        if CompositionBoundaryFor(value, edit.start) != edit.start ||
            CompositionBoundaryFor(value, edit.end) != edit.end {
            return false
        }
    }
    remaining := cast(s64)state.length - (edit.end - edit.start)
    if edit.replacement.count > state.bytes.count - remaining ||
        !Utf8.Valid(edit.replacement) { return false }
    joined: Vec(u8)
    defer { VecFree(joined) }
    for index: 0..edit.start - 1 {
        if !VecPush(joined, state.bytes[index]) { return false }
    }
    for byte: edit.replacement {
        if !VecPush(joined, byte) { return false }
    }
    for index: edit.end..state.length - 1 {
        if !VecPush(joined, state.bytes[index]) { return false }
    }
    for index: cast(s64)0..joined.count - 1 { state.bytes[index] = joined[index] }
    state.length = cast(s32)joined.count
    state.cursor = edit.start + cast(s32)edit.replacement.count
    state.anchor = state.cursor
    return true
}

// Apply bytes and interaction state together; a rejected edit keeps both.
// Cursor/anchor are clamped to scalar boundaries in the resulting value and
// negative scroll becomes zero. Enter, Escape, clipboard and composition are
// still decisions for the application using the original Result.
#program_export
StateApplyResult :: (state: *State,
    result: Result) -> bool {
    if !StateApplyEdit(state, result.edit) { return false }
    value := TextView(state.bytes[:state.length])
    state.cursor = CompositionBoundaryFor(value, result.cursor)
    state.anchor = CompositionBoundaryFor(value, result.anchor)
    state.scroll_x = result.scroll_x
    if state.scroll_x < 0 { state.scroll_x = 0 }
    state.focused = result.focused
    return true
}

// The field's text, viewing the state's bytes. The view lasts until those
// bytes change; copy it into app storage to keep it. Unwired state (no
// bytes) reads as empty.
#program_export
Value :: (state: State) -> string {
    if state.length <= 0 || state.length > state.bytes.count { return "" }
    return TextView(state.bytes[:state.length])
}

// Empties the field: its text, selection, scroll and any composition. The
// field keeps its wired bytes and its focus, so typing can continue.
#program_export
Clear :: (state: *State) {
    if state == null { return }
    state.length = 0
    state.cursor = 0
    state.anchor = 0
    state.scroll_x = 0
    state.preedit_length = 0
    state.preedit_cursor = 0
    state.preedit_selection = 0
    state.preedit_active = false
}
