#module "spinbox"
#import "drawing_props"
#import "geometry"

SpinboxLayout :: struct {
    left: Rectangle
    text: Rectangle
    right: Rectangle
    button_width: i32
}

SpinboxStepResult :: struct {
    value: i32
    changed: bool
}

SpinboxEffectiveStep :: (step: i32) -> i32 #export {
    if step <= 0 {
        return 1
    }
    return step
}

SpinboxClampValue :: (value: i32, min_value: i32, max_value: i32) -> i32 #export {
    if value < min_value {
        return min_value
    }
    if value > max_value {
        return max_value
    }
    return value
}

SpinboxScaledMetric :: (value: float, scale: float) -> i32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: i32 = (i32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}

SpinboxDefaultButtonWidth :: (scale: float) -> i32 #export {
    return SpinboxScaledMetric(28.0, scale)
}

SpinboxDecrementIdFor :: (control_id: i32) -> i32 #export {
    if control_id <= 0 {
        return 0
    }
    return control_id * 10 + 1
}

SpinboxIncrementIdFor :: (control_id: i32) -> i32 #export {
    if control_id <= 0 {
        return 0
    }
    return control_id * 10 + 2
}

SpinboxLayoutFor :: (bounds: Rectangle, requested_button_width: i32) -> SpinboxLayout #export {
    layout: SpinboxLayout
    layout.button_width = requested_button_width
    if layout.button_width < 0 {
        layout.button_width = 0
    }
    max_button: i32 = (i32)(bounds.width / 2.0)
    if layout.button_width > max_button {
        layout.button_width = max_button
    }
    layout.left = bounds
    layout.left.width = (float)layout.button_width
    layout.right = bounds
    layout.right.x = bounds.x + bounds.width - (float)layout.button_width
    layout.right.width = (float)layout.button_width
    layout.text = bounds
    layout.text.x = bounds.x + (float)layout.button_width
    layout.text.width = bounds.width - (float)(layout.button_width * 2)
    if layout.text.width < 0.0 {
        layout.text.width = 0.0
    }
    return layout
}

SpinboxStepValue :: (value: i32, min_value: i32, max_value: i32,
    step: i32, direction: i32, wrap: bool) -> SpinboxStepResult #export {
    result: SpinboxStepResult
    result.value = value
    step = SpinboxEffectiveStep(step)
    if direction < 0 {
        if value > min_value {
            result.value = value - step
        } else if wrap && value <= min_value {
            result.value = max_value
        }
    } else if direction > 0 {
        if value < max_value {
            result.value = value + step
        } else if wrap && value >= max_value {
            result.value = min_value
        }
    }
    result.value = SpinboxClampValue(result.value, min_value, max_value)
    result.changed = result.value != value
    return result
}

SpinboxStepButtonsValue :: (value: i32, min_value: i32, max_value: i32,
    step: i32, decrement: bool, increment: bool, wrap: bool) -> SpinboxStepResult #export {
    result: SpinboxStepResult
    result.value = value
    if decrement {
        result = SpinboxStepValue(result.value, min_value, max_value, step,
            -1, wrap)
    }
    if increment {
        next: SpinboxStepResult = SpinboxStepValue(result.value, min_value,
            max_value, step, 1, wrap)
        result.changed = result.changed || next.changed
        result.value = next.value
    }
    return result
}
