#module "dpi_props"

DPIState :: struct {
    physical_width: int
    physical_height: int
    view_width: int
    view_height: int
    layout_width: int
    layout_height: int
    ui_scale: float
    ui_scale_clamped: float
    render_scale: float
    camera_zoom: float
    base_width: int
    base_height: int
    needs_update: int
}

# Implemented by the C-only scaling host; declared here for the public ABI.
SetScale :: (scale: float) #extern #export
GetScale :: () -> float #extern #export
Scale :: (px: i32) -> i32 #extern #export
ClampPx :: (px: i32, min_px: i32, max_px: i32) -> i32 #extern #export
UpdateDPIOffscreen :: (view_width: i32, view_height: i32, forced_scale: float) #extern #export
