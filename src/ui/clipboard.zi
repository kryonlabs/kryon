#module "clipboard"

CLIPBOARD_BUFFER_SIZE :: 4096

ClipboardBuffer :: struct {
    text: [4096]char
    pending: i32
}

ClipboardSource :: enum {
    CLIPBOARD_SOURCE_CLIPBOARD
    CLIPBOARD_SOURCE_PRIMARY
    CLIPBOARD_SOURCE_PRIMARY_OR_CLIPBOARD
}

# Host-provided write callbacks. The host writes text to the OSC52 response
# or paste stream for the terminal identified by userdata. These replace the
# former raw function-pointer typedefs so generated Go can type the callbacks.
ClipboardOSC52Write :: (userdata: *void, text: const char*) -> i32 #extern #export
ClipboardPasteWrite :: (userdata: *void, text: const char*, size: i32) -> i32 #extern #export

SetClipboardTextValue :: (text: const char*) -> i32 #extern #export
GetClipboardTextValue :: () -> const char* #extern #export
SetPrimarySelectionTextValue :: (text: const char*) -> i32 #extern #export
GetPrimarySelectionTextValue :: () -> const char* #extern #export
ClipboardSourceHasText :: (source: ClipboardSource) -> i32 #extern #export
GetClipboardSourceText :: (clipboard: const ClipboardBuffer*, source: ClipboardSource) -> const char* #extern #export
SetPrimarySelectionFromText :: (text: const char*) -> i32 #extern #export
CopySelectionTextToClipboard :: (clipboard: *ClipboardBuffer, text: const char*) -> i32 #extern #export
ClipboardTargetIncludes :: (target: const char*, wanted: char) -> i32 #extern #export
ClipboardTargetUsesPrimary :: (target: const char*) -> i32 #extern #export
GetClipboardTargetText :: (clipboard: const ClipboardBuffer*, target: const char*) -> const char* #extern #export
RequestClipboardTargetWrite :: (clipboard: *ClipboardBuffer, target: const char*, text: const char*) -> i32 #extern #export
HandleClipboardOSC52 :: (clipboard: *ClipboardBuffer, payload: const char*, userdata: *void) -> i32 #extern #export
WriteClipboardPaste :: (text: const char*, bracketed: i32, userdata: *void) -> i32 #extern #export
WriteClipboardTextPaste :: (clipboard: *ClipboardBuffer, text: const char*, bracketed: i32, userdata: *void) -> i32 #extern #export
WriteClipboardSourcePaste :: (clipboard: *ClipboardBuffer, source: ClipboardSource, bracketed: i32, userdata: *void) -> i32 #extern #export
InitClipboardBuffer :: (buffer: *ClipboardBuffer, text: const char*) #extern #export
SetClipboardBufferText :: (buffer: *ClipboardBuffer, text: const char*) -> i32 #extern #export
RequestClipboardBufferWrite :: (buffer: *ClipboardBuffer, text: const char*) -> i32 #extern #export
GetClipboardBufferText :: (buffer: const ClipboardBuffer*) -> const char* #extern #export
ClipboardBufferHasPendingWrite :: (buffer: const ClipboardBuffer*) -> i32 #extern #export
SyncClipboardBufferFromHost :: (buffer: *ClipboardBuffer) -> i32 #extern #export
FlushClipboardBufferToHost :: (buffer: *ClipboardBuffer) -> i32 #extern #export
