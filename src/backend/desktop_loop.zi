// The desktop frame loop every desktop host runs: input, the app's frame,
// retained painting and accessibility. desktop_run is the default host; a
// project host can call RunDesktop with its own window size.
#import "secondary_pointer"
#import "frame_snapshot"
#import "test_driver"
A :: #import "accessibility_linux";
#import "app"
#import "cairo_raster"
#import "desktop_runtime"
#import "geometry"
#import "program_title"
#import "session"
#import "scroll_device"
#import "tree"
#import "tree_draw"
#import "tree_input"
Clock :: #import "frame_clock";
Timer :: #import "std/timer_linux";
#import "std/file_linux"
#import "std/c_string"

using FrameStatus;

accessibility_attempted: bool;
accessibility_enabled: bool;
frame_activity: Clock.FrameActivity;
last_pointer: Vector2; last_width: float32; last_height: float32;

libc :: #system_library "libc";
DesktopWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";
DesktopChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";

DesktopError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = cast(u8)10
    DesktopWrite(2, *output[0], cast(u64)(length + 1))
    return 1
}

DrawFrame :: (session: Session, keyboard_activity: bool = false) -> bool {
    origin: Vector2 = DesktopOrigin()
    A.AccessibilityOrigin(cast(s32)origin.x, cast(s32)origin.y)
    A.AccessibilityPoll()
    BeginDesktopFrame()
    viewport: Rectangle = DesktopViewport()
    pointer: PointerFrame = TestDriverPointer(session, PollPointer())
    secondary := PollSecondaryPointer()
    wheel := TestDriverWheel(DesktopWheelMove())
    active := keyboard_activity || pointer.down || pointer.pressed || pointer.released ||
        secondary.down || secondary.pressed || secondary.released || wheel != 0.0 ||
        pointer.x != last_pointer.x || pointer.y != last_pointer.y ||
        viewport.width != last_width || viewport.height != last_height
    last_pointer = .{pointer.x, pointer.y}
    last_width = viewport.width; last_height = viewport.height
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, secondary)
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(session, .{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel,
        cast(float64)Timer.MonotonicMilliseconds() / 1000.0)
    if !DesktopFrameInputBegin(session) { return false }
    published_session := session
    defer { FrameInputEnd(published_session) }
    if BeginFrame(session, cast(u64)1, viewport) !=
        cast(FrameStatus)FrameOk { return false }
    if Frame(session, viewport) != 0 {
        TreeCancel(session)
        return false
    }
    finished := EndFrameRetained(session, DesktopFrameReusable(), Clock.Observe(*frame_activity, active))
    if finished.status != cast(FrameStatus)FrameOk { return false }
    unused DesktopCursor(session)
    DesktopFrameUnchanged(finished.paint_unchanged)
    if !accessibility_attempted && !CaptureRequested() {
        accessibility_attempted = true
        title: string = ProgramTitle()
        for index: 0..TreeCount(session) - 1 {
            node: TreeEntry = TreeNodeAt(session, index)
            if cast(s32)node.semantic_kind == 1 && node.semantic_label.count > 0 { title = node.semantic_label; break }
        }
        accessibility_enabled = A.AccessibilityOpen(session, title)
    } else if accessibility_enabled && !A.AccessibilitySync() {
        A.AccessibilityClose()
        accessibility_enabled = false
        unused DesktopError("kryon: Linux accessibility synchronization failed")
    }
    return EndDesktopFrame()
}

// Runs the app's frames in a desktop window of `width` by `height` pixels
// until it closes, and returns the program's exit status.
RunDesktop :: (width: s32 = 960, height: s32 = 600) -> s32 {
    if !OpenDesktopSized(width, height) {
        CloseDesktop()
        return DesktopError("kryon: could not open the desktop window")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseDesktop()
        return DesktopError("kryon: could not open a UI session")
    }
    ok: bool = true
    if CaptureRequested() {
        ok = PollDesktop() && DrawFrame(session)
        if ok { ok = CaptureConfigured() }
    } else {
        while ok && PollDesktop() {
            KeyboardModifiersSend(session, DesktopModifiers())
            key: s32 = DesktopPressedKey()
            if key == 0 {
                for candidate: cast(s32)0..349 {
                    if TestDriverKeyPressed(candidate) { key = candidate; break }
                }
            }
            if key != 0 { KeyboardSend(session, key) }
            codepoint: s32 = DesktopTypedCodepoint()
            if codepoint == 0 { codepoint = TestDriverCodepoint() }
            keyboard_activity := key != 0 || codepoint != 0
            while codepoint != 0 {
                TypedCodepointSend(session, codepoint)
                codepoint = DesktopTypedCodepoint()
                if codepoint == 0 { codepoint = TestDriverCodepoint() }
            }
            ok = DrawFrame(session, keyboard_activity)
            TestDriverFrame(session)
            if ok { PauseDesktop() }
        }
    }
    A.AccessibilityClose()
    CloseSession(session)
    CloseDesktop()
    if ok { return 0 }
    return DesktopError("kryon: desktop frame rendering failed")
}

// Starts the program where MARKER, such as "assets/art/title.png", exists:
// the working directory, or else the program's directory or one of its three
// parents, so a program opened from its build folder still finds its files.
DesktopStartBeside :: (marker: string) -> bool {
    if PathExists(marker) { return true }
    bytes: [4096]u8
    program := ProgramPath(bytes[:])
    start := ProgramNameStart(program)
    if start <= 1 { return false }
    directory: [4096]u8
    if !CopyCString(program[0:start - 1], directory[:]) || DesktopChangeDirectory(*directory[0]) != 0 {
        return false
    }
    up: [3]u8 = .[46, 46, 0]
    for level: 0..3 {
        if PathExists(marker) { return true }
        if level < 3 && DesktopChangeDirectory(*up[0]) != 0 { return false }
    }
    return false
}
