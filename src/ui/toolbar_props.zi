#module "toolbar_props"
#import "drawing_props"
#import "dropdown_props"
#import "image_props"

IconRowItem :: struct {
    icon: Texture2D
    disabled: bool
}

BottomIconRowProps :: struct {
    center_x: i32
    view_width: i32
    view_height: i32
    count: i32
    items: const IconRowItem*
}

IconRowResult :: struct {
    clicked_index: i32
    y: i32
    button_width: i32
}

ToolbarAction :: struct {
    key: u64
    label: string
    image: ImageProps
    disabled: bool
}

ToolbarProps :: struct {
    key: u64
    id: i32
    class_name: i32
    x: i32
    y: i32
    width: i32
    height: i32
    scale: float
    draw_menu: bool
    dropdown: DropdownProps
    dropdown_min_width: i32
    dropdown_max_width: i32
    dropdown_height: i32
}

ToolbarResult :: struct {
    node: i32
    dropdown: DropdownResult
    selected_menu_item: i32
    clicked_action: i32
}
