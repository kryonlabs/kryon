#module "kss_parser"
#import "style"
#import "style_sheet"
#import "control_props"

# Host-provided borrowed substring view; backends slice their native strings.

StringSlice :: (source: string, start: i32, length: i32) -> string #extern

# KSS is the text style format; this module is the one shared implementation.
# Backends lower it to C, Go, and JavaScript, so the grammar, environment
# axes, theme overlays, imports, and provenance rules exist exactly once.
# Hosts own I/O: they feed source text in and resolve import requests.

KssTokenKind :: enum {
    KssTokenColor = 0
    KssTokenLength = 1
    KssTokenDuration = 2
    KssTokenMaterial = 3
}

KssOriginKind :: enum {
    KssOriginPack = 0
    KssOriginImport = 1
    KssOriginTheme = 2
    KssOriginEnvironment = 3
    KssOriginVariant = 4
}

KssStatus :: enum {
    KssStatusContinue = 0
    KssStatusRule = 1
    KssStatusNeedImport = 2
    KssStatusDone = 3
    KssStatusError = 4
}

KssContrast :: enum {
    KssContrastNormal = 0
    KssContrastHigh = 1
}

KssDensity :: enum {
    KssDensityComfortable = 0
    KssDensityCompact = 1
    KssDensityTouch = 2
}

KssPointer :: enum {
    KssPointerMouse = 0
    KssPointerTouch = 1
    KssPointerMixed = 2
}

KssPlatform :: enum {
    KssPlatformDesktop = 0
    KssPlatformAndroid = 1
    KssPlatformWeb = 2
    KssPlatformPlan9 = 3
    KssPlatformTerminal = 4
}

KssTheme :: enum {
    KssThemeNone = 0
    KssThemeLight = 1
    KssThemeDark = 2
}


KssEnvironment :: struct {
    theme: i32
    contrast: i32
    density: i32
    pointer: i32
    platform: i32
}

KssDefaultEnvironment :: () -> KssEnvironment #export {
    env: KssEnvironment
    env.theme = (i32)KssThemeNone
    env.contrast = (i32)KssContrastNormal
    env.density = (i32)KssDensityComfortable
    env.pointer = (i32)KssPointerMouse
    env.platform = (i32)KssPlatformDesktop
    return env
}

KssName :: struct {
    bytes: [64]u8
    length: i32
}

KssSourceFile :: struct {
    name: [96]u8
    length: i32
}

KssToken :: struct {
    name: KssName
    kind: i32
    color: u32
    number: f32
    material: i32
    origin: i32
    file: i32
    line: i32
    column: i32
}

KssColorOverride :: struct {
    name: string
    color: u32
}

KssOrigin :: struct {
    file: i32
    line: i32
    column: i32
}

KssImportFrame :: struct {
    name: KssName
    outer_source: string
    outer_pos: i32
    outer_line: i32
    outer_column: i32
    outer_file: i32
}

KssParser :: struct {
    source: string
    pos: i32
    line: i32
    column: i32
    file: i32
    files: [8]KssSourceFile
    file_count: i32
    imports: [8]KssImportFrame
    import_depth: i32
    tokens: [128]KssToken
    token_count: i32
    overrides: [16]KssColorOverride
    override_count: i32
    layer: i32
    layer_names: [12]KssName
    layer_count: i32
    layer_declared: bool
    pack: KssName
    env: KssEnvironment
    themes: [16]KssName
    theme_count: i32
    version_seen: bool
    status: i32
    rule: StyleRule
    origin: KssOrigin
    pending_import: KssName
    in_env: bool
    diagnostic: [256]u8
    diagnostic_length: i32
    rule_total: i32
}

KssBegin :: (source: string, path: string, env: KssEnvironment) -> KssParser #export {
    p: KssParser
    p.source = source
    p.pos = 0
    p.line = 1
    p.column = 1
    p.file = 0
    p.files[0] = KssCopyFileName(path)
    p.file_count = 1
    p.import_depth = 0
    p.token_count = 0
    p.override_count = 0
    p.layer = 0
    p.layer_count = 4
    p.layer_names[0] = KssMakeName("reset")
    p.layer_names[1] = KssMakeName("components")
    p.layer_names[2] = KssMakeName("app")
    p.layer_names[3] = KssMakeName("overrides")
    p.layer_declared = false
    p.env = env
    p.theme_count = 0
    p.version_seen = false
    p.status = KssStatusContinue
    p.rule_total = 0
    p.diagnostic_length = 0
    return p
}

KssAddColorOverride :: (p: KssParser, name: string, color: u32) -> KssParser #export {
    if p.override_count < 16 {
        p.overrides[p.override_count].name = name
        p.overrides[p.override_count].color = color
        p.override_count = p.override_count + 1
    }
    return p
}

# Byte helpers over the borrowed source view. Every advance keeps the
# line/column provenance current so diagnostics and rule origins stay exact.

KssAtEnd :: (p: KssParser) -> bool {
    return p.pos >= p.source.length
}

KssPeek :: (p: KssParser, ahead: i32) -> u8 {
    index: i32 = p.pos + ahead
    if index < 0 || index >= p.source.length {
        return 0
    }
    return p.source[index]
}

KssAdvance :: (p: KssParser, count: i32) -> KssParser {
    step: i32 = 0
    while step < count {
        if p.pos < p.source.length {
            if p.source[p.pos] == 10 {
                p.line = p.line + 1
                p.column = 1
            } else {
                p.column = p.column + 1
            }
            p.pos = p.pos + 1
        }
        step = step + 1
    }
    return p
}

KssIsSpace :: (byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 13 || byte == 10 || byte == 11 || byte == 12
}

KssIsDigit :: (byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

KssIsHexDigit :: (byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102) ||
        (byte >= 65 && byte <= 70)
}

KssIsAlpha :: (byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

KssIdentStart :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || byte == 95 || byte == 45
}

KssIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45 ||
        byte == 46
}

KssSelectorIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45
}

KssLower :: (byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 {
        return byte + 32
    }
    return byte
}

KssNameEquals :: (name: KssName, text: string) -> bool {
    if name.length != text.length {
        return false
    }
    index: i32 = 0
    while index < name.length {
        if KssLower(name.bytes[index]) != KssLower(text[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssNameEqualsName :: (a: KssName, b: KssName) -> bool {
    if a.length != b.length {
        return false
    }
    index: i32 = 0
    while index < a.length {
        if KssLower(a.bytes[index]) != KssLower(b.bytes[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssMakeName :: (text: string) -> KssName {
    name: KssName
    index: i32 = 0
    while index < text.length && index < 64 {
        name.bytes[index] = text[index]
        index = index + 1
    }
    name.length = index
    return name
}

KssCopyFileName :: (text: string) -> KssSourceFile {
    file: KssSourceFile
    index: i32 = 0
    while index < text.length && index < 96 {
        file.name[index] = text[index]
        index = index + 1
    }
    file.length = index
    return file
}

KssNameAppend :: (destination: KssName, byte: u8) -> KssName {
    if destination.length < 64 {
        destination.bytes[destination.length] = byte
        destination.length = destination.length + 1
    }
    return destination
}

# Skip whitespace and // plus /* */ comments, keeping provenance current.

KssSkipSpace :: (p: KssParser) -> KssParser {
    while !KssAtEnd(p) {
        byte: u8 = p.source[p.pos]
        if KssIsSpace(byte) {
            p = KssAdvance(p, 1)
            continue
        }
        if byte == 47 && KssPeek(p, 1) == 47 {
            while !KssAtEnd(p) && p.source[p.pos] != 10 {
                p = KssAdvance(p, 1)
            }
            continue
        }
        if byte == 47 && KssPeek(p, 1) == 42 {
            p = KssAdvance(p, 2)
            while !KssAtEnd(p) {
                if p.source[p.pos] == 42 && KssPeek(p, 1) == 47 {
                    p = KssAdvance(p, 2)
                    break
                }
                p = KssAdvance(p, 1)
            }
            continue
        }
        break
    }
    return p
}

KssNameResult :: struct {
    parser: KssParser
    name: KssName
    ok: bool
}

KssExpectResult :: struct {
    parser: KssParser
    ok: bool
}

KssNumberResult :: struct {
    parser: KssParser
    value: f32
    ok: bool
}

KssColorResult :: struct {
    parser: KssParser
    value: u32
    ok: bool
}

KssReadName :: (p: KssParser) -> KssNameResult {
    result: KssNameResult
    p = KssSkipSpace(p)
    if KssAtEnd(p) || !KssIdentStart(p.source[p.pos]) {
        result.parser = p
        result.ok = false
        return result
    }
    while !KssAtEnd(p) && KssIdentChar(p.source[p.pos]) {
        result.name = KssNameAppend(result.name, p.source[p.pos])
        p = KssAdvance(p, 1)
    }
    result.parser = p
    result.ok = result.name.length > 0
    return result
}

KssReadSelectorName :: (p: KssParser) -> KssNameResult {
    result: KssNameResult
    p = KssSkipSpace(p)
    if !KssAtEnd(p) && p.source[p.pos] == 42 {
        result.name = KssNameAppend(result.name, 42)
        p = KssAdvance(p, 1)
        result.parser = p
        result.ok = true
        return result
    }
    if KssAtEnd(p) || !KssIdentStart(p.source[p.pos]) {
        result.parser = p
        result.ok = false
        return result
    }
    while !KssAtEnd(p) && KssSelectorIdentChar(p.source[p.pos]) {
        result.name = KssNameAppend(result.name, p.source[p.pos])
        p = KssAdvance(p, 1)
    }
    result.parser = p
    result.ok = result.name.length > 0
    return result
}

KssExpect :: (p: KssParser, byte: u8) -> KssExpectResult {
    result: KssExpectResult
    p = KssSkipSpace(p)
    if KssAtEnd(p) || p.source[p.pos] != byte {
        result.parser = p
        result.ok = false
        return result
    }
    p = KssAdvance(p, 1)
    result.parser = p
    result.ok = true
    return result
}

# Diagnostics carry the message plus the exact file, line, and column.

KssDiagnosticAppend :: (p: KssParser, text: string) -> KssParser {
    index: i32 = 0
    while index < text.length && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = text[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendName :: (p: KssParser, name: KssName) -> KssParser {
    index: i32 = 0
    while index < name.length && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = name.bytes[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendInt :: (p: KssParser, value: i32) -> KssParser {
    divisor: i32 = 1
    remaining: i32 = value
    if remaining < 0 {
        p = KssDiagnosticAppend(p, "-")
        remaining = -remaining
    }
    while remaining / (divisor * 10) > 0 && divisor < 1000000000 {
        divisor = divisor * 10
    }
    while divisor > 0 {
        digit: i32 = (remaining / divisor) % 10
        if p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = (u8)(48 + digit)
            p.diagnostic_length = p.diagnostic_length + 1
        }
        divisor = divisor / 10
    }
    return p
}

KssDiagnosticAt :: (p: KssParser) -> KssParser {
    p = KssDiagnosticAppend(p, " at ")
    if p.file >= 0 && p.file < p.file_count && p.files[p.file].length > 0 {
        index: i32 = 0
        while index < p.files[p.file].length && p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = p.files[p.file].name[index]
            p.diagnostic_length = p.diagnostic_length + 1
            index = index + 1
        }
        p = KssDiagnosticAppend(p, ":")
    }
    p = KssDiagnosticAppendInt(p, p.line)
    p = KssDiagnosticAppend(p, ":")
    p = KssDiagnosticAppendInt(p, p.column)
    return p
}

KssFail :: (p: KssParser, message: string) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAt(p)
    p.status = (i32)KssStatusError
    return p
}

KssFailName :: (p: KssParser, message: string, name: KssName) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAppendName(p, name)
    p = KssDiagnosticAt(p)
    p.status = (i32)KssStatusError
    return p
}

KssReadHexColor :: (p: KssParser) -> KssColorResult {
    result: KssColorResult
    value: u32 = 0
    digits: i32 = 0
    p = KssSkipSpace(p)
    if KssAtEnd(p) || p.source[p.pos] != 35 {
        result.parser = p
        return result
    }
    p = KssAdvance(p, 1)
    while !KssAtEnd(p) && KssIsHexDigit(p.source[p.pos]) {
        byte: u8 = p.source[p.pos]
        digit: u32 = 0
        if byte >= 48 && byte <= 57 {
            digit = (u32)(byte - 48)
        } else if byte >= 97 && byte <= 102 {
            digit = (u32)(byte - 87)
        } else {
            digit = (u32)(byte - 55)
        }
        value = (value << (u32)4) | digit
        digits = digits + 1
        p = KssAdvance(p, 1)
    }
    if digits == 6 {
        value = (value << (u32)8) | (u32)255
    } else if digits != 8 {
        result.parser = p
        return result
    }
    result.parser = p
    result.value = value
    result.ok = true
    return result
}

KssReadNumber :: (p: KssParser) -> KssNumberResult {
    result: KssNumberResult
    negative: bool = false
    whole: u32 = 0
    fraction: u32 = 0
    fraction_digits: i32 = 0
    exponent: i32 = 0
    exponent_negative: bool = false
    seen_digits: bool = false
    power: f64 = 1.0
    value64: f64 = 0.0
    p = KssSkipSpace(p)
    if KssAtEnd(p) {
        result.parser = p
        return result
    }
    if p.source[p.pos] == 45 {
        negative = true
        p = KssAdvance(p, 1)
    } else if p.source[p.pos] == 43 {
        p = KssAdvance(p, 1)
    }
    while !KssAtEnd(p) && KssIsDigit(p.source[p.pos]) {
        whole = whole * 10 + (u32)(p.source[p.pos] - 48)
        seen_digits = true
        p = KssAdvance(p, 1)
    }
    if !KssAtEnd(p) && p.source[p.pos] == 46 && !seen_digits {
        result.parser = p
        return result
    }
    if !KssAtEnd(p) && p.source[p.pos] == 46 {
        p = KssAdvance(p, 1)
        while !KssAtEnd(p) && KssIsDigit(p.source[p.pos]) {
            if fraction_digits < 9 {
                fraction = fraction * 10 + (u32)(p.source[p.pos] - 48)
                fraction_digits = fraction_digits + 1
            }
            seen_digits = true
            p = KssAdvance(p, 1)
        }
    }
    if !seen_digits {
        result.parser = p
        return result
    }
    if !KssAtEnd(p) && (p.source[p.pos] == 101 || p.source[p.pos] == 69) {
        p = KssAdvance(p, 1)
        if !KssAtEnd(p) && p.source[p.pos] == 45 {
            exponent_negative = true
            p = KssAdvance(p, 1)
        } else if !KssAtEnd(p) && p.source[p.pos] == 43 {
            p = KssAdvance(p, 1)
        }
        while !KssAtEnd(p) && KssIsDigit(p.source[p.pos]) {
            exponent = exponent * 10 + (i32)(p.source[p.pos] - 48)
            p = KssAdvance(p, 1)
        }
    }
    step: i32 = 0
    while step < fraction_digits {
        power = power * 10.0
        step = step + 1
    }
    value64 = (f64)whole + (f64)fraction / power
    step = 0
    while step < exponent {
        if exponent_negative {
            value64 = value64 / 10.0
        } else {
            value64 = value64 * 10.0
        }
        step = step + 1
    }
    if negative {
        value64 = -value64
    }
    result.parser = p
    result.value = (f32)value64
    result.ok = true
    return result
}

KssReadDuration :: (p: KssParser) -> KssNumberResult {
    result: KssNumberResult = KssReadNumber(p)
    if !result.ok {
        return result
    }
    unit: KssNameResult = KssReadName(result.parser)
    if unit.ok && KssNameEquals(unit.name, "s") {
        result.value = result.value * 1000.0
    } else if unit.ok && !KssNameEquals(unit.name, "ms") {
        result.ok = false
    }
    result.parser = unit.parser
    return result
}

# Token table. Later entries shadow earlier ones; overlays update in place so
# provenance always reflects the winning value. Variant color overrides are
# applied on add, matching the highest precedence layer.

KssFindToken :: (p: KssParser, name: KssName, kind: i32) -> i32 {
    index: i32 = p.token_count - 1
    while index >= 0 {
        if p.tokens[index].kind == kind && KssNameEqualsName(p.tokens[index].name, name) {
            return index
        }
        index = index - 1
    }
    return -1
}

KssApplyOverride :: (p: KssParser, index: i32) -> KssParser {
    override: i32 = 0
    while override < p.override_count {
        if p.tokens[index].kind == (i32)KssTokenColor &&
           p.overrides[override].name.length == p.tokens[index].name.length {
            same: bool = true
            byte_index: i32 = 0
            while byte_index < p.tokens[index].name.length {
                if KssLower((u8)p.overrides[override].name[byte_index]) !=
                   KssLower(p.tokens[index].name.bytes[byte_index]) {
                    same = false
                }
                byte_index = byte_index + 1
            }
            if same {
                p.tokens[index].color = p.overrides[override].color
                p.tokens[index].origin = (i32)KssOriginVariant
                return p
            }
        }
        override = override + 1
    }
    return p
}

KssAddToken :: (p: KssParser, token: KssToken) -> KssParser {
    if p.token_count >= 128 {
        return KssFail(p, "style token capacity exceeded")
    }
    p.tokens[p.token_count] = token
    p.token_count = p.token_count + 1
    p = KssApplyOverride(p, p.token_count - 1)
    return p
}

# Update an existing token in place: theme overlays and matching environment
# overlays win over base and imported values but keep a single entry.

KssOverlayToken :: (p: KssParser, name: KssName, kind: i32, color: u32,
    number: f32, material: i32, origin: i32) -> KssParser {
    index: i32 = KssFindToken(p, name, kind)
    if index < 0 {
        return KssFailName(p, "unknown overlay token '", name)
    }
    if kind == (i32)KssTokenColor {
        p.tokens[index].color = color
    } else if kind == (i32)KssTokenMaterial {
        p.tokens[index].material = material
    } else {
        p.tokens[index].number = number
    }
    p.tokens[index].origin = origin
    p.tokens[index].file = p.file
    p.tokens[index].line = p.line
    p.tokens[index].column = p.column
    p = KssApplyOverride(p, index)
    return p
}

KssFindColorToken :: (p: KssParser, name: KssName) -> i32 {
    return KssFindToken(p, name, (i32)KssTokenColor)
}

KssFindNumberToken :: (p: KssParser, name: KssName) -> i32 {
    index: i32 = KssFindToken(p, name, (i32)KssTokenDuration)
    if index >= 0 {
        return index
    }
    return KssFindToken(p, name, (i32)KssTokenLength)
}

KssFindMaterialToken :: (p: KssParser, name: KssName) -> i32 {
    return KssFindToken(p, name, (i32)KssTokenMaterial)
}

KssMaterialValue :: (name: KssName) -> i32 {
    if KssNameEquals(name, "lightfield") {
        return (i32)MaterialLightfield
    }
    if KssNameEquals(name, "flat") {
        return (i32)MaterialFlat
    }
    if KssNameEquals(name, "glass") {
        return (i32)MaterialGlass
    }
    return -999999
}

# Stable class ids match StyleClassId in the C and Go pack registries.

KssClassId :: (name: KssName) -> i32 {
    hash: u32 = 2166136261
    if name.length == 0 {
        return 0
    }
    index: i32 = 0
    while index < name.length {
        hash = hash ^ (u32)name.bytes[index]
        hash = hash * (u32)16777619
        index = index + 1
    }
    hash = hash & (u32)2147483647
    if hash == 0 {
        return 1
    }
    return (i32)hash
}

KssKindValue :: (name: KssName) -> i32 {
    if KssNameEquals(name, "*") || KssNameEquals(name, "Any") {
        return StyleKindAny()
    }
    if KssNameEquals(name, "App") {
        return StyleKindApp()
    }
    if KssNameEquals(name, "Button") {
        return StyleKindButton()
    }
    if KssNameEquals(name, "Text") {
        return StyleKindText()
    }
    if KssNameEquals(name, "TextField") {
        return StyleKindTextField()
    }
    if KssNameEquals(name, "TextArea") {
        return StyleKindTextArea()
    }
    if KssNameEquals(name, "Surface") {
        return StyleKindSurface()
    }
    if KssNameEquals(name, "Dropdown") {
        return StyleKindDropdown()
    }
    if KssNameEquals(name, "Card") {
        return StyleKindCard()
    }
    if KssNameEquals(name, "Slider") {
        return StyleKindSlider()
    }
    if KssNameEquals(name, "SliderThumb") {
        return StyleKindSliderThumb()
    }
    if KssNameEquals(name, "Toggle") {
        return StyleKindToggle()
    }
    if KssNameEquals(name, "ToggleThumb") {
        return StyleKindToggleThumb()
    }
    if KssNameEquals(name, "Scroll") {
        return StyleKindScroll()
    }
    if KssNameEquals(name, "ScrollThumb") {
        return StyleKindScrollThumb()
    }
    if KssNameEquals(name, "Checkbox") {
        return StyleKindCheckbox()
    }
    if KssNameEquals(name, "Radio") {
        return StyleKindRadio()
    }
    if KssNameEquals(name, "Progress") {
        return StyleKindProgress()
    }
    if KssNameEquals(name, "Separator") {
        return StyleKindSeparator()
    }
    if KssNameEquals(name, "NavigationBar") {
        return StyleKindNavigationBar()
    }
    if KssNameEquals(name, "NavigationBarItem") {
        return StyleKindNavigationBarItem()
    }
    if KssNameEquals(name, "Selectable") {
        return StyleKindSelectable()
    }
    if KssNameEquals(name, "Fieldset") {
        return StyleKindFieldset()
    }
    if KssNameEquals(name, "Plot") {
        return StyleKindPlot()
    }
    if KssNameEquals(name, "PlotMark") {
        return StyleKindPlotMark()
    }
    if KssNameEquals(name, "Link") {
        return StyleKindLink()
    }
    if KssNameEquals(name, "TabBar") {
        return StyleKindTabBar()
    }
    if KssNameEquals(name, "Tab") {
        return StyleKindTab()
    }
    if KssNameEquals(name, "TabClose") {
        return StyleKindTabClose()
    }
    if KssNameEquals(name, "SegmentedControl") {
        return StyleKindSegmentedControl()
    }
    if KssNameEquals(name, "Segment") {
        return StyleKindSegment()
    }
    if KssNameEquals(name, "Menu") {
        return StyleKindMenu()
    }
    if KssNameEquals(name, "MenuItem") {
        return StyleKindMenuItem()
    }
    if KssNameEquals(name, "MenuSeparator") {
        return StyleKindMenuSeparator()
