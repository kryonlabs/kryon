// Compare the portable Surface renderer to its full-raster path after every
// callback, including pixels outside the changed area and across strip seams.
Surface :: #import "kryon/host/surface";
Pixels :: #import "pixmap";
Button :: #import "kryon/button";
Text :: #import "kryon/text";
Theme :: #import "kryon/theme";
#import "kryon/frame_snapshot"
#import "kryon/input_protocol"
#import "kryon/session"
#import "kryon/tree_draw"
#import "kryon/paint_queue"
#import "kryon/drawing_props"

PIXELS :: 400 * 480
INITIAL_STRIP_PIXELS :: 400 * Surface.SURFACE_STRIP_ROWS
scratch: [480 * Surface.SURFACE_STRIP_ROWS]u32;
full: [PIXELS]u32;
rgba: [PIXELS * 4]u8;
presented: [PIXELS * 4]u8;
row_buffer: [480 * Surface.SURFACE_STRIP_ROWS * 4 + 2]u8;
packed_rgba: [480 * Surface.SURFACE_STRIP_ROWS * 4]u8;
image: [16]u32;

stage: s32;
callbacks: s32;
retained: s32;
observed_time: s64;
custom_paints: s32;
rows_sent: s32;
next_row: s32;
reject_after: s32 = -1;

PresentRows :: (width: s32, height: s32, first: s32, bytes: string) -> bool {
    if width <= 0 || width * height != PIXELS || bytes.count <= 0 || bytes.count % (width * 4) != 0 { return false }
    rows := cast(s32)bytes.count / (width * 4)
    if rows > Surface.SURFACE_STRIP_ROWS || first < 0 || first + rows > height ||
        (rows_sent > 0 && first != next_row) || (reject_after >= 0 && rows_sent >= reject_after) { return false }
    offset := first * width * 4
    for index: 0..bytes.count - 1 { presented[offset + index] = cast(u8)bytes[index] }
    next_row = first + rows
    rows_sent += rows
    return true
}

PresentPixels :: (width: s32, height: s32, first: s32, words: []u32) -> bool {
    if words.count <= 0 || words.count * 4 > packed_rgba.count { return false }
    for at: 0..words.count - 1 {
        pixel := words[at]
        packed_rgba[at*4] = cast(u8)(pixel >> 16)
        packed_rgba[at*4+1] = cast(u8)(pixel >> 8)
        packed_rgba[at*4+2] = cast(u8)pixel
        packed_rgba[at*4+3] = 255
    }
    return PresentRows(width, height, first, TextView(packed_rgba[:words.count*4]))
}

EmitCustom :: (command: PaintCommand) {
    custom_paints += 1
    EmitRoundedFill(command)
}

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    callbacks += 1
    observed_time = CaptureFrameInput(session).elapsed_ms
    if (stage == 10 || stage == 14) && RetainFrame(session) { retained += 1; return }
    unused Button.Draw(session, .{.key = 4, .bounds = .{12.0, 10.0, 120.0, 36.0}, .label = "Hover"})
    color := ifx stage >= 4 then Color.{28, 140, 150, 190} else Color.{24, 48, 90, 180}
    PaintRoundedFill(session, -1, .{10.2, 62.8, 365.5, 26.0}, 4.0, 8, color)
    PaintRoundedFill(session, -1, .{142.0, 49.0, 40.0, 56.0}, 3.0, 8, .{140, 46, 64, 130})
    label := ifx stage >= 5 then "Edited: café Ω" else "Original"
    Text.Draw(session, .{.key = 5, .bounds = .{18.0, 66.0, 130.0, 22.0}, .text = label})
    x: float32 = ifx stage >= 13 then 60.0 else ifx stage >= 6 then 45.0 else 30.0
    PaintRoundedFill(session, -1, .{x, 126.0, 20.0, 8.0}, 1.0, 6, .{81, 80, 58, 255})
    Text.Draw(session, .{.key = 6, .bounds = .{25.0, 164.0, 100.0, 28.0}, .text = "Rotated", .rotation = 22.0})
    PaintVerticalGradient(session, -1, .{16.0, 217.7, 68.0, 45.0}, .{10, 230, 20, 120}, .{20, 40, 230, 160})
    PaintLine(session, -1, .{100.3, 270.7, -90.0, -50.0}, .{200, 160, 10, 170})
    white: Color = .{255, 255, 255, 255}
    PaintImage(session, -1, "sample.png", 0, .{0.0, 0.0, 4.0, 4.0}, .{106.2, 215.8, 48.0, 49.0},
        .{90.2, 204.8, 100.0, 85.0}, .{0.0, 0.0}, 0.0, 2.0, white)
    PaintImage(session, -1, "sample.png", 0, .{0.0, 0.0, 4.0, 4.0}, .{192.2, 215.8, 48.0, 49.0},
        .{160.2, 204.8, 118.0, 95.0}, .{12.0, 4.0}, 27.0, 3.0, white)
    if stage >= 15 {
        SubmitPaint(session, .{.has_emitter = true, .emit = EmitCustom,
            .data = .{.node = -1, .bounds = .{30.0, 178.5, 80.0, 64.0}, .color = .{105, 80, 20, 180}}})
    }
}

Compare :: (count: s32, bytes: []u8) -> bool {
    for at: 0..count - 1 {
        pixel := full[at]
        base := at * 4
        if bytes[base] != cast(u8)(pixel >> 16) || bytes[base+1] != cast(u8)(pixel >> 8) ||
            bytes[base+2] != cast(u8)pixel || bytes[base+3] != 255 {
            print("RGBA differs at stage %, pixel %\n", stage, at)
            return false
        }
    }
    return true
}

#if #defined(KRYON_PIXMAP_EXTERNAL_BUFFER) {
    PaintWithoutStorage :: () {
        Pixels.PixmapBegin(cast(u32)0x123456)
        Pixels.PixmapDamageBegin(.{-4.0, -4.0, 12.0, 12.0}, 0)
        Pixels.PixmapClipTo(.{-4.0, -4.0, 12.0, 12.0})
        Pixels.PixmapFillRounded(-4, -4, 8, 8, 0, .{255, 255, 255, 255})
        Pixels.PixmapDamageEnd()
        Pixels.PixmapPresent()
    }

    BorrowedStorageTest :: () -> bool {
        clear: u32 = 0x123456
        guard: u32 = 0xabcdef
        backing: [6]u32
        backing[0] = guard; backing[5] = guard
        if Pixels.pixmap_surface.count != 0 { return false }
        PaintWithoutStorage()
        if Pixels.pixmap_surface.count != 0 || Pixels.pixmap_width != 0 || Pixels.pixmap_height != 0 { return false }

        pixels := backing[1:5]
        if !Pixels.PixmapBeginInto(clear, 2, 2, pixels) { return false }
        if Pixels.PixmapBeginInto(0, 0, 2, pixels) || Pixels.PixmapBeginInto(0, 3, 2, pixels) ||
            Pixels.PixmapResumeRowsInto(2, 2, 2, 1, pixels) { return false }
        Pixels.PixmapBegin(0)
        Pixels.PixmapBlend(1, 0, .{255, 255, 255, 255}, 255)
        if backing[1] != clear || backing[2] != cast(u32)0xffffff || backing[3] != clear || backing[4] != clear { return false }

        Pixels.PixmapEndInto()
        PaintWithoutStorage()
        return Pixels.pixmap_surface.count == 0 && Pixels.pixmap_width == 0 && Pixels.pixmap_height == 0 &&
            backing[0] == guard && backing[5] == guard && backing[1] == clear && backing[2] == cast(u32)0xffffff &&
            backing[3] == clear && backing[4] == clear
    }
}

#program_export
main :: () -> s32 {
    #if #defined(KRYON_PIXMAP_EXTERNAL_BUFFER) {
        if !BorrowedStorageTest() { return 14 }
    }
    fast := SessionOpen()
    baseline := SessionOpen()
    streamed := SessionOpen()
    packed := SessionOpen()
    if !SessionValid(fast) || !SessionValid(baseline) || !SessionValid(streamed) || !SessionValid(packed) { return 1 }
    defer { unused CloseSession(fast); unused CloseSession(baseline); unused CloseSession(streamed); unused CloseSession(packed) }
    for at: 0..15 { image[at] = cast(u32)0x904040c0 + cast(u32)(at * 8192) }
    image[0] = cast(u32)0xff209040
    if !Pixels.PixmapSetImage(0, "sample.png", 4, 4, image[:]) { return 10 }
    defer Pixels.PixmapClearImage(0)
    paint: Surface.SurfacePaint
    row_paint: Surface.SurfacePaint
    packed_paint: Surface.SurfacePaint
    no_presenter: Surface.SurfaceComposition
    no_rgba: []u8
    input: FrameInputSnapshot = .{.available = true, .focused = true}
    row_buffer[0] = 19
    row_buffer[row_buffer.count - 1] = 37
    strip := row_buffer[1:row_buffer.count - 1]
    if Surface.SurfaceFrameRetained(streamed, Draw, 0, 480, input, scratch[:], strip, *row_paint, PresentRows) ||
        Surface.SurfaceFrameRetained(streamed, Draw, 16384, 16384, input, scratch[:], strip, *row_paint, PresentRows) ||
        Surface.SurfaceFrameRetained(streamed, Draw, 400, 480, input, scratch[:], strip[:INITIAL_STRIP_PIXELS * 4 - 1], *row_paint, PresentRows) ||
        Surface.SurfaceFrameRetained(streamed, Draw, 400, 480, input, scratch[:INITIAL_STRIP_PIXELS - 1], strip, *row_paint, PresentRows) ||
        callbacks != 0 || rows_sent != 0 { return 15 }
    for turn: cast(s32)0..16 {
        stage = turn
        // A stationary idle frame, move onto the button, move again inside
        // it, change one row, edit text, animate a shape and then resize to
        // the same pixel count with a different stride.
        width: s32 = ifx turn >= 7 then 480 else 400
        height: s32 = ifx turn >= 7 then 400 else 480
        input.elapsed_ms = cast(s64)turn * 250
        input.sequence += 1
        if turn == 2 { input.pointer.x = 20.0; input.pointer.y = 20.0 }
        if turn == 3 { input.pointer.x = 40.0 }
        if turn == 8 { unused Theme.InstallDefaultTheme(true) }
        if turn == 9 { PaintResourcesChanged() }
        if turn == 11 && !Pixels.RasterSetTransform(1.25, -2.5, -16.5) { return 11 }
        if turn == 14 && !Pixels.RasterSetTransform(1.5, -4.5, -12.5) { return 11 }
        if !Surface.SurfaceFrameInto(fast, Draw, width, height, input, scratch[:], rgba[:], *paint) ||
            !Surface.SurfaceFrame(baseline, Draw, width, height, input, full[:]) { return 2 }
        if observed_time != input.elapsed_ms || callbacks != turn * 4 + 2 { return 3 }
        area := cast(s32)(paint.damage.width * paint.damage.height)
        print("Surface stage %: % / % pixels processed in % strips\n", turn, area, PIXELS, paint.strips)
        if turn == 0 || turn == 7 || turn == 9 || turn == 11 || turn >= 14 {
            if area != PIXELS { return 4 }
        } else if turn == 1 || turn == 3 || turn == 10 || turn == 12 {
            if area != 0 { return 5 }
        } else if area <= 0 || (turn != 8 && area >= PIXELS) { return 6 }
        if turn < 15 {
            if paint.strips != (cast(s32)paint.damage.height + Surface.SURFACE_STRIP_ROWS - 1) / Surface.SURFACE_STRIP_ROWS { return 9 }
        } else if paint.strips != 0 || custom_paints != (turn - 14) * 2 { return 12 }
        if FramePaintUnchanged(fast) != (area == 0) { return 13 }
        if !Compare(width * height, rgba[:]) { return 7 }
        rows_sent = 0
        if turn == 11 && !Pixels.RasterSetTransform(1.25, -2.5, -16.5) { return 11 }
        if turn == 14 && !Pixels.RasterSetTransform(1.5, -4.5, -12.5) { return 11 }
        // Force an expose while the app retains its prior paint plan.
        refreshed := turn == 10
        rendered := Surface.SurfaceFrameRetained(streamed, Draw, width, height, input, scratch[:], strip,
            *row_paint, PresentRows, refreshed)
        if observed_time != input.elapsed_ms || callbacks != turn * 4 + 3 || rendered != (turn < 15) { return 16 }
        if turn >= 15 {
            if rows_sent != 0 || custom_paints != (turn - 14) * 2 { return 17 }
        } else {
            expected_rows := ifx refreshed then height else cast(s32)paint.damage.height
            if rows_sent != expected_rows || !Compare(width * height, presented[:]) { return 18 }
        }
        rows_sent = 0
        if turn == 11 && !Pixels.RasterSetTransform(1.25, -2.5, -16.5) { return 11 }
        if turn == 14 && !Pixels.RasterSetTransform(1.5, -4.5, -12.5) { return 11 }
        packed_rendered := Surface.SurfaceFrameRetained(packed, Draw, width, height, input, scratch[:], no_rgba,
            *packed_paint, no_presenter.present_rows, refreshed, .{PresentPixels})
        if observed_time != input.elapsed_ms || callbacks != (turn + 1) * 4 || packed_rendered != (turn < 15) { return 22 }
        expected_rows := ifx turn >= 15 then 0 else ifx refreshed then height else cast(s32)paint.damage.height
        if rows_sent != expected_rows || (turn < 15 && !Compare(width * height, presented[:])) { return 23 }
    }
    if retained != 6 { return 8 }
    stage = 7
    rows_sent = 0
    reject_after = Surface.SURFACE_STRIP_ROWS
    if Surface.SurfaceFrameRetained(streamed, Draw, 480, 400, input, scratch[:], strip, *row_paint, PresentRows) ||
        rows_sent != Surface.SURFACE_STRIP_ROWS { return 19 }
    rows_sent = 0
    reject_after = -1
    if !Surface.SurfaceFrameRetained(streamed, Draw, 480, 400, input, scratch[:], strip, *row_paint, PresentRows) ||
        rows_sent != 400 || !Surface.SurfaceFrame(baseline, Draw, 480, 400, input, full[:]) ||
        !Compare(PIXELS, presented[:]) || row_buffer[0] != 19 || row_buffer[row_buffer.count - 1] != 37 { return 20 }
    rows_sent = 0
    reject_after = Surface.SURFACE_STRIP_ROWS
    if Surface.SurfaceFrameRetained(packed, Draw, 480, 400, input, scratch[:], no_rgba, *packed_paint,
        no_presenter.present_rows, false, .{PresentPixels}) || rows_sent != Surface.SURFACE_STRIP_ROWS { return 24 }
    rows_sent = 0
    reject_after = -1
    if !Surface.SurfaceFrameRetained(packed, Draw, 480, 400, input, scratch[:], no_rgba, *packed_paint,
        no_presenter.present_rows, false, .{PresentPixels}) || rows_sent != 400 || !Compare(PIXELS, presented[:]) { return 25 }
    #if #defined(KRYON_PIXMAP_EXTERNAL_BUFFER) {
        if Pixels.pixmap_surface.count != 0 { return 21 }
    }
    print("Strip raster RGBA matches the complete raster on all seventeen callbacks\n")
    print("Streamed full-width rows match the complete raster, including expose, resize and rejected-strip retry\n")
    print("Borrowed packed RGB strips match RGBA without a conversion buffer\n")
    return 0
}
