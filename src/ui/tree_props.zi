Line :: (x1: i32, y1: i32, x2: i32, y2: i32, color: Color) #extern #export
Triangle :: (x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: Color) #extern #export
Bevel :: (x: i32, y: i32, w: i32, h: i32, light: Color, dark: Color) #extern #export
Icon :: (id: i32, x: i32, y: i32, size: i32, icon: IconType, tint: Color) #extern #export
