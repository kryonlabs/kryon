Breadcrumb :: #import "kryon/breadcrumb";
Text :: #import "kryon/text";
#import "kryon/geometry"
#import "kryon/session"

active: s32 = 2;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .key = 1, .bounds = .{viewport.x + 20.0, viewport.y + 16.0, viewport.width - 40.0, 40.0}, .text = "Breadcrumb", .size = 28})
    bounds := Rectangle.{viewport.x + 20.0, viewport.y + 76.0, viewport.width - 40.0, 180.0}
    items := Breadcrumb.BreadcrumbItem.[.{.key = 11, .label = "Home"}, .{.key = 12, .label = "Projects"}, .{.key = 13, .label = "Kryon"}]
    result := Breadcrumb.Draw(session, Breadcrumb.Props.{.disabled = example_disabled, .key = 10, .bounds = .{bounds.x, bounds.y, bounds.width, 44.0}, .active_index = active}, items[:])
    if result.changed { active = result.activated_index }
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
