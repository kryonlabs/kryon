            Section((SectionProps){.bounds = {0,0,ScaleUIPx(336),ScaleUIPx(180)},.label = "Section",.gap = ScaleUIPx(12),.key = 967})
            Heading((HeadingProps){.bounds = {x + ScaleUIPx(12),y + ScaleUIPx(122),ScaleUIPx(312),ScaleUIPx(40)},.text = "Page / Section",.level = 2,.font = Text20,.color = GetThemeText(),.key = 968})
            ParagraphText((ParagraphTextProps){.bounds = {x + ScaleUIPx(12),y + ScaleUIPx(174),ScaleUIPx(312),ScaleUIPx(72)},.text = "Semantic page content using standard headings and paragraphs.",.font = Text16,.color = GetThemeText(),.key = 969})
            End()
            End()
            ThemeSettings((ThemeSettingsProps){.id_base = 980,.x = right,.y = y + ScaleUIPx(110),.w = ScaleUIPx(340),.theme_source = &theme_source,.theme_mode = &theme_mode,.theme_id = &theme_id,.theme_style = &theme_style,.allow_system_source = 1,.allow_system_mode = 1,.theme_label = "Source",.source_app_label = "App",.source_system_label = "System",.mode_label = "Mode",.mode_system_label = "System",.mode_light_label = "Light",.mode_dark_label = "Dark",.palette_label = "Palette",.style_label = "Style",.style_system_label = "System",.style_retro_label = "Retro",.style_material_label = "Material",.style_fluent_label = "Fluent",.style_adwaita_label = "Adwaita",.style_liquid_glass_label = "Liquid Glass",.system_theme_label = "System theme"}, &theme_state, &theme_result)
            if theme_result.changed {
                SetThemeSource((ThemeSource)theme_source)
                SetThemeMode((ThemeMode)theme_mode)
                SetThemeStyle((ThemeStyle)theme_style)
                dark_mode = GetEffectiveThemeDarkMode()
                SetCurrentTheme(theme_id, dark_mode)
            }
        }
        EndUIScrollContainer(area, view)

        if dialog == 1 && MessageDialog((MessageDialogProps){"Message","A simple message dialog.","OK"}) > 0 {
            dialog = 0
        }
        if dialog == 2 {
            result: int = ConfirmDialog((ConfirmDialogProps){"Confirm","Continue?","Cancel","OK"})
            if result != 0 { dialog_result = result; dialog = 0 }
        }
        if dialog == 3 {
            result: int = PromptDialog((PromptDialogProps){"Prompt",text_value,sizeof(text_value),&text_cursor,&text_focused,"Cancel","Save"})
            if result != 0 { dialog_result = result; dialog = 0 }
        }
        if dialog == 5 {
            picker_result: int = PickerDialog((PickerDialogProps){.title = "Choose an item",.labels = choices,.option_count = 3,.cancel_label = "Cancel",.max_width = 360})
            if picker_result != 0 {
                if picker_result > 0 { picker_choice = picker_result - 1 }
                dialog = 0
            }
        }
        if dialog == 6 {
            frame: UIPanelFrame = ModalFrame(420,220,"ModalFrame",(Texture2D){0},(Texture2D){0})
            Text((TextProps){.bounds={frame.content_x, frame.content_y, 0, 0}, .text="Custom modal content", .font=Text20, .color=GetThemeText(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds = {frame.content_x,frame.content_y + ScaleUIPx(56),ScaleUIPx(160),ScaleUIPx(36)},.label = "Close",.id = 970}) || IsKeyPressed(KEY_ESCAPE) {
                dialog = 0
            }
        }
        if dialog == 7 && TextPopover((TextPopoverProps){.anchor = {ScaleUIPx(662),ScaleUIPx(520),ScaleUIPx(180),ScaleUIPx(36)},.title = "Edit",.text = text_value,.text_size = sizeof(text_value),.cursor_position = &text_cursor,.focused = &text_focused,.id = 971,.width = 360,.max_codepoints = 63}) != 0 {
            dialog = 0
        }
        if dialog == 4 {
            actions: [2] ModalAction = {{"Cancel",ButtonStyleSecondary,0},{"Continue",ButtonStylePrimary,0}}
            if ActionModal((ModalProps){"Action modal","Choose a simple action.",actions,2,{0},ScaleUIPx(420)}) != 0 {
                dialog = 0
            }
        }
    }
