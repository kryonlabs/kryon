#import "session"
#import "text_props"
#import "image_props"
#import "button_props"
#import "text_input_props"
#import "scroll_props"
#import "geometry"
count: s32;
#program_export "TextHostedHost"
Text :: (session: Session, props: TextProps) {
    if session.slot == 4 && session.epoch == cast(u64)12 && props.text == "Portable composition" { count += 1 }
}
#program_export "ImageHostedHost"
Image :: (session: Session, image: ImageProps) {
    if session.slot == 4 && image.asset_path == "assets/photo.png" { count += 1 }
}
#program_export "ButtonHostedHost"
Button :: (session: Session, props: ButtonProps) -> s32 {
    if session.slot == 4 && props.label == "Save" && count == 2 { return props.id }
    return 0
}
#program_export "TextAreaHostedHost"
TextArea :: (session: Session, props: TextAreaProps) -> TextAreaResult {
    if session.slot != 4 || props.value != "Saved text" { return TextAreaResult.{} }
    return TextAreaResult.{.cursor = props.cursor + 1,
        .edit = TextAreaEdit.{.changed = true, .replacement = "🌿"}}
}
#program_export "ScrollHostedHost"
Scroll :: (session: Session, props: ScrollProps) -> ScrollResult {
    if session.slot != 4 { return ScrollResult.{} }
    return ScrollResult.{.opened = true, .scroll_offset = props.scroll_offset + 5,
        .content = Rectangle.{.width = 200.0}}
}
#program_export "EndHostedHost"
End :: (session: Session) -> bool { return session.slot == 4 && count == 2 }

#import "checkbox_props"
#import "toggle_props"
#program_export "CheckboxHostedHost"
Checkbox :: (session: Session, props: CheckboxProps) -> CheckboxValueResult {
    return CheckboxValueResult.{.changed = session.slot == 4 && props.id == 52, .checked = !props.checked}
}
#program_export "ToggleHostedHost"
Toggle :: (session: Session, props: ToggleProps) -> ToggleValueResult {
    return ToggleValueResult.{.changed = session.slot == 4 && props.id == 53, .value = !props.value}
}

#import "box_props"
#import "tab_bar_props"
#program_export "BoxHostedHost"
Box :: (session: Session, props: BoxProps) -> s32 {
    return ifx session.slot == 4 && props.radius == 12.0 then 71 else 0
}

#program_export "TextFieldHostedHost"
TextField :: (session: Session, props: TextFieldProps) -> TextFieldResult {
    if session.slot != 4 || props.value != "List title" {
        return TextFieldResult.{}
    }
    return TextFieldResult.{.cursor = props.cursor + 1,
        .edit = TextFieldEdit.{.changed = true, .replacement = "✓"}}
}

#program_export "TabBarHostedHost"
TabBar :: (session: Session, props: TabBarProps, tabs: []Tab) -> TabBarResult {
    if session.slot != 4 || tabs.count != 2 || tabs[1].label != "Two" {
        return TabBarResult.{}
    }
    return TabBarResult.{.selected_index = props.selected_index + 1}
}
