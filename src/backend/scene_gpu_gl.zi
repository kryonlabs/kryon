// An entry point beyond ES 3.0. The system GLES library exports the core ES
// 3.0 set only, so the ES 3.1 timer queries resolve through EGL.
TimerProcAddress :: (name: string) -> *void {
    text: [40]u8
    if !CopyCString(name, text[:]) { return null }
    return RawGetProcAddress(*text[0])
}
}
PixelStore :: (name: u32, value: s32)  {RawPixelStore(name,value)}
Finish :: ()  {RawFinish()}
