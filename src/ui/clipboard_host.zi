#module "clipboard_host"
#import "ui_internal.h"

// Match the host clipboard read limit and keep a stable value for callers.
ui_clipboard_cached_text :: [1048576]char #global
ui_primary_selection_text :: [1048576]char #global

SetClipboardTextValue :: (text: const char*) -> i32 #export {
    if text == nil { text = "" }
    snprintf(&ui_clipboard_cached_text[0],
    sizeof(ui_clipboard_cached_text), "%s", text)
    SetClipboardText(&ui_clipboard_cached_text[0])
    return 1
}

GetClipboardTextValue :: () -> const char* #export {
    text: const char* = GetClipboardText()
    if text != nil && text[0] != '\0' {
        snprintf(&ui_clipboard_cached_text[0],
        sizeof(ui_clipboard_cached_text), "%s", text)
    }
    return &ui_clipboard_cached_text[0]
}

SetPrimarySelectionTextValue :: (text: const char*) -> i32 #export {
    if text == nil { text = "" }
    snprintf(&ui_primary_selection_text[0],
    sizeof(ui_primary_selection_text), "%s", text)
    return 1
}

GetPrimarySelectionTextValue :: () -> const char* #export {
    return &ui_primary_selection_text[0]
}

ClipboardSourceHasText :: (source: ClipboardSource) -> i32 #export {
    text: const char* = nil
    if source == CLIPBOARD_SOURCE_PRIMARY {
        text = GetPrimarySelectionTextValue()
    } else if source == CLIPBOARD_SOURCE_PRIMARY_OR_CLIPBOARD {
        text = GetPrimarySelectionTextValue()
        if text != nil && text[0] != '\0' { return 1 }
        text = GetClipboardTextValue()
    } else {
        text = GetClipboardTextValue()
    }
    return text != nil && text[0] != '\0'
}

GetClipboardSourceText :: (clipboard: const ClipboardBuffer*,
source: ClipboardSource) -> const char* #export {
    if source == CLIPBOARD_SOURCE_PRIMARY {
        return GetPrimarySelectionTextValue()
    }
    if source == CLIPBOARD_SOURCE_PRIMARY_OR_CLIPBOARD {
        text: const char* = GetPrimarySelectionTextValue()
        if text != nil && text[0] != '\0' { return text }
    }
    return GetClipboardTextValue()
}

SetPrimarySelectionFromText :: (text: const char*) -> i32 #export {
    if text == nil || text[0] == '\0' { text = "" }
    return SetPrimarySelectionTextValue(text)
}

CopySelectionTextToClipboard :: (clipboard: *ClipboardBuffer,
text: const char*) -> i32 #export {
    if text == nil || text[0] == '\0' {
        SetPrimarySelectionTextValue("")
        return 0
    }
    changed: i32 = SetClipboardTextValue(text)
    changed |= SetClipboardBufferText(clipboard, text)
    changed |= SetPrimarySelectionTextValue(text)
    return changed
}

ClipboardBufferCopyText :: (dst: *char, dst_size: i32,
text: const char*) -> i32 {
    if dst == nil || dst_size <= 0 { return 0 }
    if text == nil { text = "" }
    changed: i32 = strcmp(dst, text) != 0
    snprintf(dst, (size_t)dst_size, "%s", text)
    return changed
}

InitClipboardBuffer :: (buffer: *ClipboardBuffer,
text: const char*) #export {
    if buffer == nil { return }
    buffer->text[0] = '\0'
    buffer->pending = 0
    ClipboardBufferCopyText(&buffer->text[0],
    CLIPBOARD_BUFFER_SIZE, text)
}

SetClipboardBufferText :: (buffer: *ClipboardBuffer,
text: const char*) -> i32 #export {
    if buffer == nil { return 0 }
    changed: i32 = ClipboardBufferCopyText(&buffer->text[0],
    CLIPBOARD_BUFFER_SIZE, text)
    buffer->pending = 0
    return changed
}

RequestClipboardBufferWrite :: (buffer: *ClipboardBuffer,
text: const char*) -> i32 #export {
    if buffer == nil { return 0 }
    was_pending: i32 = buffer->pending
    changed: i32 = ClipboardBufferCopyText(&buffer->text[0],
    CLIPBOARD_BUFFER_SIZE, text)
    buffer->pending = 1
    return changed || !was_pending
}

GetClipboardBufferText :: (buffer: const ClipboardBuffer*) -> const char* #export {
    if buffer == nil { return "" }
    return &buffer->text[0]
}

ClipboardBufferHasPendingWrite :: (buffer: const ClipboardBuffer*) -> i32 #export {
    return buffer != nil && buffer->pending
}

SyncClipboardBufferFromHost :: (buffer: *ClipboardBuffer) -> i32 #export {
    if buffer == nil || buffer->pending { return 0 }
    text: const char* = GetClipboardTextValue()
    return ClipboardBufferCopyText(&buffer->text[0],
    CLIPBOARD_BUFFER_SIZE, text)
}

FlushClipboardBufferToHost :: (buffer: *ClipboardBuffer) -> i32 #export {
    if buffer == nil || !buffer->pending { return 0 }
    SetClipboardTextValue(&buffer->text[0])
    buffer->pending = 0
    return 1
}
