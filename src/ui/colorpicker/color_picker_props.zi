#import "geometry"

ColorPickerProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    label: string
    values: [4]float32
    channels: s32
    scale: float32
    disabled: bool
    picker: bool
}

ColorPickerResult :: struct {
    node: s32
    values: [4]float32
    changed: bool
}
