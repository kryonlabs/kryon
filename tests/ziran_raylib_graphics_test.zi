#import "raylib_runtime"
#import "ziran_raylib_graphics_host"
#import "ziran_raylib_retained_host"
#import "byte_text_linux"
#import "drawing_props"
#import "geometry"

DrawAsset :: (path: string) {
    source := Rectangle.{0.0, 0.0, 200.0, 100.0}
    RasterImage(path, 0, source, source, source,
        Vector2.{}, 0.0, 0.0, Color.{255, 255, 255, 255})
}

#program_export
main :: () -> s32 {
    if !LoadTypefaceData("ui", ".ttf", "font fixture", null, 0) ||
    !SelectTypeface("ui") {
        return 1
    }
    if ImageWidth("banner.png") != 200 ||
    ImageHeight("banner.png") != 100 || texture_loads != 1 {
        return 2
    }
    DrawAsset("banner.png")
    if presented != 1001 {
        return 3
    }
    // A cover-fit image is wider than its tile: only the visible part is
    // drawn, from the matching source, and no scissor flushes the batch.
    RasterImage("banner.png", 0, Rectangle.{0.0, 0.0, 200.0, 100.0},
        Rectangle.{-50.0, 0.0, 200.0, 100.0}, Rectangle.{0.0, 0.0, 100.0, 100.0},
        Vector2.{}, 0.0, 0.0, Color.{255, 255, 255, 255})
    if graphics_failed || last_destination.x != 0.0 ||
    last_destination.width != 100.0 || last_source.x != 50.0 ||
    last_source.width != 100.0 || last_source.height != 100.0 {
        return 15
    }
    if !BeginRetainedFrame(100, 100) || !EndRetainedFrame() {
        return 4
    }
    old_frame := RetainedPreviousFrameTexture().id

    // Old names now refer to a new context's fonts or unrelated textures.
    // Reset must neither flush its old batch nor delete those new objects.
    context_epoch = 2
    lost_context = true
    ResetRaylibGraphics(true)
    if texture_unloads != 0 || unloads != 0 || font_unloads != 1 ||
    RetainedPreviousFrameTexture().id != 0 || graphics_failed {
        return 5
    }
    lost_context = false
    DrawAsset("banner.png")
    if texture_loads != 2 || presented != 2002 ||
    !BeginRetainedFrame(100, 100) || !EndRetainedFrame() ||
    RetainedPreviousFrameTexture().id == old_frame {
        return 6
    }

    // A preserved context releases live resources, then reloads on demand.
    ResetRaylibGraphics()
    if texture_unloads != 1 || unloads != 1 || graphics_failed ||
    RetainedPreviousFrameTexture().id != 0 {
        return 7
    }
    DrawAsset("banner.png")
    if texture_loads != 3 || presented != 2003 {
        return 8
    }

    // Cache eviction must submit earlier draws before deleting their texture.
    before_flushes := flushes
    paths: [RaylibAssetCapacity][2]u8
    for index: 0..RaylibAssetCapacity - 1 {
        paths[index][0] = cast(u8)(65 + index / 26)
        paths[index][1] = cast(u8)(97 + index % 26)
        if ImageWidth(TextFromBytes(paths[index][:])) != 200 {
            return 9
        }
    }
    if texture_unloads != 2 || flushes != before_flushes + 1 ||
    graphics_failed {
        return 10
    }
    ResetRaylibGraphics()
    if texture_unloads != 2 + RaylibAssetCapacity || graphics_failed {
        return 11
    }
    if !LoadTypefaceData("updated", ".ttf", "new font fixture", null, 0) ||
    !SelectTypeface("updated") || !BeginRetainedFrame(100, 100) ||
    !EndRetainedFrame() || ImageWidth("updated.png") != 200 { return 12 }
    frame := RetainedPreviousFrameTexture().id
    font_releases := font_unloads
    target_releases := unloads
    loads := texture_loads
    InvalidateRaylibAssets()
    if texture_unloads != 3 + RaylibAssetCapacity || font_unloads != font_releases ||
    unloads != target_releases || RetainedPreviousFrameTexture().id != frame ||
    !SelectTypeface("updated") || graphics_failed { return 13 }
    if ImageWidth("updated.png") != 200 || texture_loads != loads + 1 {
        return 14
    }
    return 0
}
