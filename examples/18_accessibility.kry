#import "kryon.h"

app "Kryon Accessibility" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    enabled: int = 1
}

screen AccessibilityExample(viewport: Rectangle) {
    WidgetBackground(GetThemeBackground())
    WidgetText("Accessibility overlay", 40, 40, UI_TEXT_24, GetThemeText())
    UICheckboxNode(1801,40,90,"Show focus/debug overlay",&enabled)
    if WidgetButton(40, 140, 200, 40, "Focusable Button", UI_BUTTON_STYLE_PRIMARY) {
        enabled = !enabled
    }
    if enabled {
        UIFocusNode((Rectangle){36,136,208,48})
    }
}
