// A raster host selects a font only for the current measurement or label.
// Names and font asset paths share the same bounded resource identity.
TextTypefaceSelector :: #type (name: string) -> string;
text_typeface_selector: TextTypefaceSelector;
text_typeface_installed: bool;

#program_export
SetTextTypefaceSelector :: (select: TextTypefaceSelector) {
    text_typeface_selector = select
    text_typeface_installed = true
}

#program_export
TextTypefaceUse :: (name: string) -> string {
    if !text_typeface_installed || name == "" { return "" }
    return text_typeface_selector(name)
}

// Paths may exceed a registered face name's capacity. Hash the whole path,
// including its package namespace, so separately installed assets stay apart.
#program_export
TextTypefaceKey :: (path: string, output: []u8) -> string {
    if output.count < 22 { return "" }
    hash: u64 = cast(u64)14695981039346656037
    for byte: path {
        hash = (hash ^ cast(u64)byte) * cast(u64)1099511628211
    }
    prefix := "font-"
    digits := "0123456789abcdef"
    for index: cast(s32)0..4 { output[index] = prefix[index] }
    for index: cast(s32)0..15 {
        digit := cast(s32)((hash >> cast(u64)(60 - index * 4)) & cast(u64)15)
        output[index + 5] = digits[digit]
    }
    output[21] = 0
    return TextView(output[:21])
}

// Stable scope tickets avoid borrowing a registered name across font loading,
// which may replace that name's backing storage.
#program_export
TextTypefaceSlot :: (index: s32) -> string {
    slots: [16]string = .["@font0", "@font1", "@font2", "@font3", "@font4", "@font5", "@font6", "@font7",
    "@font8", "@font9", "@font10", "@font11", "@font12", "@font13", "@font14", "@font15"]
    if index < 0 || index >= 16 { return "@builtin" }
    return slots[index]
}

#program_export
TextTypefaceSlotIndex :: (name: string) -> s32 {
    for index: cast(s32)0..15 {
        if name == TextTypefaceSlot(index) { return index }
    }
    return -1
}
