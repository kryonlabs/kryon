#module "drag"
#import "geometry"

DragStep :: struct {
    value: float
    changed: bool
}

DragDiscreteStep :: struct {
    value: i32
    changed: bool
}

DragKeyboardInput :: struct {
    direction: i32
    home: bool
    end: bool
    alt: bool
    shift: bool
}

DragPointerDecision :: struct {
    clear_active: bool
    start_active: bool
    update_delta: bool
    finish_active: bool
}

DragTextPaint :: struct {
    text_x: float
    text_y: float
}

DragTextInsetFor :: (scale: float) -> float #export {
    return scale * 6.0
}

DragLabelGapFor :: (scale: float) -> float #export {
    return scale * 2.0
}

DragComponentTokenFor :: (control_id: i32, component: i32) -> i32 #export {
    if control_id <= 0 || component < 0 {
        return 0
    }
    return control_id * 16 + component + 1
}

DragCellTextPaintFor :: (bounds: Rectangle, inset: float,
    text_line_height: float) -> DragTextPaint #export {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y + (bounds.height - text_line_height) / 2.0
    return paint
}

DragLabelTextPaintFor :: (bounds: Rectangle, inset: float, font_size: i32,
    gap: float) -> DragTextPaint #export {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y - (float)font_size - gap
    return paint
}

DragCellBoundsFor :: (bounds: Rectangle, count: i32, index: i32) -> Rectangle #export {
    cell: Rectangle
    if count <= 0 { return cell }
    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }
    cell.x = bounds.x + bounds.width * (float)index / (float)count
    cell.y = bounds.y
    cell.width = bounds.width / (float)count
    cell.height = bounds.height
    return cell
}

DragPointerDecisionFor :: (any_active: bool, active: bool, hot: bool, disabled: bool,
    owner_captured: bool, pressed: bool, down: bool,
    released: bool) -> DragPointerDecision #export {
    decision: DragPointerDecision
    decision.clear_active = (any_active && owner_captured) ||
        (active && disabled)
    decision.start_active = hot && pressed
    effective_active: bool = (active && !decision.clear_active) ||
        decision.start_active
    decision.update_delta = effective_active && !disabled && down
    decision.finish_active = effective_active && released
    return decision
}

DragEffectiveSpeed :: (speed: float) -> float #export {
    if speed == 0.0 { return 1.0 }
    return speed
}

DragClamp :: (value: float, minimum: float, maximum: float) -> float #export {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

DragDiscreteClamp :: (value: i32, minimum: i32, maximum: i32) -> i32 #export {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

DragDiscreteRoundedDelta :: (scaled: float, force_minimum_step: bool) -> i32 #export {
    step: i32 = (i32)(scaled + (scaled < 0.0 ? -0.5 : 0.5))
    if force_minimum_step && step == 0 {
        if scaled < 0.0 { return -1 }
        return 1
    }
    return step
}

DragKeyboardShouldRun :: (focus_active: bool, keyboard_enabled: bool,
    popup_captures: bool) -> bool #export {
    return focus_active && keyboard_enabled && !popup_captures
}

DragKeyboardDirectionFor :: (right: bool, left: bool) -> i32 #export {
    if right { return 1 }
    if left { return -1 }
    return 0
}

DragKeyboardInputFor :: (direction: i32, home: bool, end: bool,
    alt: bool, shift: bool) -> DragKeyboardInput #export {
    input: DragKeyboardInput
    input.direction = direction
    input.home = home
    input.end = end
    input.alt = alt
    input.shift = shift
    return input
}

DragKeyboardValue :: (value: float, speed: float, minimum: float,
    maximum: float, input: DragKeyboardInput) -> DragStep #export {
    result: DragStep
    result.value = value
    result.changed = false
    next: float = value
    if input.home && minimum < maximum {
        next = minimum
    } else if input.end && minimum < maximum {
        next = maximum
    } else if input.direction != 0 {
        step: float = DragEffectiveSpeed(speed)
        if input.alt { step = step * 0.1 }
        if input.shift { step = step * 10.0 }
        next = DragClamp(next + (float)input.direction * step, minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

DragDiscreteKeyboardValue :: (value: i32, speed: float, minimum: i32,
    maximum: i32, input: DragKeyboardInput) -> DragDiscreteStep #export {
    result: DragDiscreteStep
    result.value = value
    result.changed = false
    next: i32 = value
    if input.home && minimum < maximum {
        next = minimum
    } else if input.end && minimum < maximum {
        next = maximum
    } else if input.direction != 0 {
        scaled: float = DragEffectiveSpeed(speed)
        if input.alt { scaled = scaled * 0.1 }
        if input.shift { scaled = scaled * 10.0 }
        next = DragDiscreteClamp(next + input.direction * DragDiscreteRoundedDelta(scaled, true),
            minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

DragDeltaValue :: (value: float, delta: float, speed: float,
    minimum: float, maximum: float) -> DragStep #export {
    result: DragStep
    result.value = DragClamp(value + delta * DragEffectiveSpeed(speed),
        minimum, maximum)
    result.changed = result.value != value
    return result
}

DragDiscreteDeltaValue :: (value: i32, delta: float, speed: float,
    minimum: i32, maximum: i32) -> DragDiscreteStep #export {
    result: DragDiscreteStep
    scaled: float = delta * DragEffectiveSpeed(speed)
    result.value = DragDiscreteClamp(value + DragDiscreteRoundedDelta(scaled, false),
        minimum, maximum)
    result.changed = result.value != value
    return result
}
