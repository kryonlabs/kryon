#if #defined(KRYON_HOSTED_UI) {
    #program_export
    CanvasSetExitKey :: (key: s32) { unused key }
} else {
    // Browser applications can compose their own lifecycle with this host.
    using Runtime :: #import "canvas_host";
    using Raster :: #import "canvas_raster";
    // EndCanvasUiFrame repaints only the damaged pixels of the retained canvas.
    using Retained :: #import "canvas_frame";
    Events :: #import "canvas_events";
    // Live held modifiers; consumed key events use CanvasPressedKeyModifiers.
    CanvasModifiers :: () -> s32 { return Events.CanvasHeldModifiers() }
}
