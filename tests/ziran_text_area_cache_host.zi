measure_calls: s32;
measure_bias: s32;

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    measure_calls += 1
    width := cast(s32)value.count * font / 2 + measure_bias
    if typeface == "wide" { width *= 2 }
    // Shaping need not make prefix widths monotonic. Caching must preserve
    // the first overflow, rather than replacing wrapping with a width sum.
    if value == "AZ" { return 1 }
    return width
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 { unused typeface; return font }

#program_export
MeasureCalls :: () -> s32 { return measure_calls }

#program_export
SetMeasureBias :: (bias: s32) { measure_bias = bias }
