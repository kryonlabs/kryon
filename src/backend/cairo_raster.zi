layout: *void;
font_description: *void;
font_family: [256]u8;
text_error: bool;
// Pango owns each cached string and glyph run. A short bounded working set
// avoids reshaping labels as measurement and painting alternate between them.
ShapedSpanEntry :: struct { first: s32; last: s32; spans: GlyphSpans }
SHAPED_SPAN_LIMIT :: 8;
ShapedEntry :: struct {
    layout: *void
    font: s32
    family: s32
    weight: s32
    slant: FontStyle
    spacing: s32
    length: s64
    spans: [SHAPED_SPAN_LIMIT]ShapedSpanEntry
    span_count: s32
    span_next: s32
}
SHAPED_LAYOUT_LIMIT :: 8;
SHAPED_LABEL_BYTES :: 256;
shaped_entries: [SHAPED_LAYOUT_LIMIT]ShapedEntry;
shaped_next: s32;
shaped_current: s32;

RasterFontFamily :: struct { name: *u8; id: s32; }
RasterFontResolve :: #type (typeface: string) -> RasterFontFamily #reads;
raster_font_resolve: RasterFontResolve;

ShapedFamily :: (typeface: string) -> RasterFontFamily {
    if typeface != "" && raster_font_resolve != null {
        selected := raster_font_resolve(typeface)
        if selected.name != null { return selected }
    }
    if raster_family.name != null { return raster_family }
    return .{.name = *font_family[0]}
}


ShapedLayout :: (value: string, font: s32, typeface: string) -> bool {
    if !CairoTextOpen() || font <= 0 || value.count > 2147483647 { return false }
    family := ShapedFamily(typeface)
    style := text_glyph_style
    weight := ifx style.weight > 0 then style.weight else 400
    spacing := cast(s32)(style.letter_spacing * 1024.0)
    for index: cast(s32)0..SHAPED_LAYOUT_LIMIT - 1 {
        entry := *shaped_entries[index]
        if entry.layout == null || entry.font != font || entry.length != value.count ||
        entry.family != family.id || entry.weight != weight || entry.slant != style.style ||
        entry.spacing != spacing { continue }
        stored := LayoutTextPointer(entry.layout)
        same := true
        for byte: cast(s64)0..value.count - 1 {
            if stored[byte] != value[byte] { same = false; break }
        }
        if same { layout = entry.layout; shaped_current = index; return true }
    }
    if !Utf8.Valid(value) { return false }
    slot := shaped_next
    // Long editor runs share one slot, so eight large documents cannot
    // accumulate merely because the host measured them in succession.
    if value.count > SHAPED_LABEL_BYTES { slot = 0 }
    else { shaped_next = (shaped_next % (SHAPED_LAYOUT_LIMIT - 1)) + 1 }
    if shaped_entries[slot].layout == null {
        shaped_entries[slot].layout = LayoutNew(paint)
        if shaped_entries[slot].layout == null { return false }
        LayoutSingleParagraph(shaped_entries[slot].layout, 1)
    }
    layout = shaped_entries[slot].layout
    if value.count + 1 > layout_capacity {
        bytes: *u8 = LayoutReallocate(layout_bytes, cast(usize)(value.count + 1))
        if bytes == null { return false }
        layout_bytes = bytes; layout_capacity = value.count + 1
    }
    FontFamily(font_description, family.name)
    FontWeight(font_description, weight)
    FontSlant(font_description, cast(s32)style.style)
    // Text paint effects carry the host font, so measurement uses it too.
    SetFontSize(paint, cast(float64)font)
    extents: FontExtents
    FontExtentsOf(paint, *extents)
    total: float64 = extents.ascent + extents.descent
    size: float64 = cast(float64)font
    if total > 0.0 { size = cast(float64)font * cast(float64)font / total }
    FontSize(font_description, size * 1024.0)
    LayoutFont(layout, font_description)
    if spacing != shaped_entries[slot].spacing {
        attributes: *void
        if spacing != 0 {
            attributes = AttributesNew()
            AttributesInsert(attributes, LetterSpacingAttribute(spacing))
        }
        LayoutAttributes(layout, attributes)
        if attributes != null { AttributesUnref(attributes) }
    }
    for byte: 0..cast(s32)value.count - 1 { layout_bytes[byte] = value[byte] }
    layout_bytes[value.count] = 0
    LayoutText(layout, layout_bytes, cast(s32)value.count)
    shaped_entries[slot].font = font
    shaped_entries[slot].family = family.id
    shaped_entries[slot].weight = weight
    shaped_entries[slot].slant = style.style
    shaped_entries[slot].spacing = spacing
    shaped_entries[slot].length = value.count
    shaped_entries[slot].span_count = 0
    shaped_entries[slot].span_next = 0
    shaped_current = slot
    return true
}

ShapedCaret :: (value: string, byte: s32, font: s32, typeface: string) -> s32 {
    if !ShapedLayout(value, font, typeface) { return 0 }
    strong: LayoutRectangle; weak: LayoutRectangle
    LayoutCursor(layout, byte, *strong, *weak)
    return strong.x / 1024
}

ShapedSpanAt :: (positions: *s32, index: s32) -> GlyphSpan {
    return GlyphSpan.{positions[index * 2] / 1024, positions[index * 2 + 1] / 1024}
}

ShapedSpans :: (value: string, first: s32, last: s32, font: s32, typeface: string) -> GlyphSpans {
    spans: GlyphSpans
    if !ShapedLayout(value, font, typeface) { return spans }
    entry := *shaped_entries[shaped_current]
    for index: cast(s32)0..entry.span_count - 1 {
        cached := entry.spans[index]
        if cached.first == first && cached.last == last { return cached.spans }
    }
    line := LayoutLine(layout, 0)
    if line != null { LayoutLineRanges(line, first, last, *spans.positions, *spans.count) }
    if spans.positions != null && spans.count <= GLYPH_INLINE_SPANS {
        for index: cast(s32)0..spans.count - 1 { spans.stored[index] = ShapedSpanAt(spans.positions, index) }
        LayoutRangeFree(spans.positions)
        spans.positions = null
        index := entry.span_next
        entry.spans[index] = ShapedSpanEntry.{first, last, spans}
        entry.span_next = (index + 1) % SHAPED_SPAN_LIMIT
        if entry.span_count < SHAPED_SPAN_LIMIT { entry.span_count += 1 }
    }
    return spans
}

ShapedSpansDone :: (positions: *s32) { LayoutRangeFree(positions) }

