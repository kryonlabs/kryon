#module "node_registry_props"

NodeTypeFlag :: enum {
    NodeTypeFlagInsertable = 1
    NodeTypeFlagSelectable = 2
    NodeTypeFlagMovable = 4
    NodeTypeFlagResizable = 8
}

NodeType :: struct {
    name: const char*
    label: const char*
    group: const char*
    base: const char*
    detail: const char*
    flags: NodeTypeFlag
}
