// The canonical Android host's DrawAndroidFrame publishes the polled raylib
// frame input to the application callback and revokes it before presenting.
Probe :: #import "app";
#import "android_run"
#import "android_surface"
#import "frame_snapshot"
#import "geometry"
#import "input_protocol"
#import "raylib_runtime"
#import "session"
#import "std/c_string"
#import "tree_draw"

// Real SDL events enter raylib's platform poller; no replacement input provider.
sdl :: #system_library "SDL2";
raylib_input :: #system_library "raylib";
Event :: struct {
    kind: u32
    timestamp: u32
    window: u32
    state: u8
    repeat: u8
    pad1: u8
    pad2: u8
    scancode: s32
    keycode: s32
    modifiers: u16
    pad3: u16
    unused_value: u32
    tail: [24]u8
}
PushEvent :: (event: *Event) -> s32 #foreign sdl "SDL_PushEvent";
PollEvents :: () #foreign raylib_input "PollInputEvents";
RealEndDrawing :: () #foreign raylib_input "__real_EndDrawing";

KeyEvent :: (down: bool) -> bool {
    event: Event
    event.kind = ifx down then cast(u32)0x300 else cast(u32)0x301
    event.state = ifx down then cast(u8)1 else cast(u8)0
    event.scancode = 4
    event.keycode = 97
    return PushEvent(*event) == 1
}

FocusEvent :: (focused: bool) -> bool {
    event: Event
    event.kind = cast(u32)0x200
    event.state = ifx focused then cast(u8)12 else cast(u8)13
    return PushEvent(*event) == 1
}

watched: Session;
presents: s32;
presented_open: bool;

// Presentation may yield to the platform; the frame's input must be closed.
#program_export
__wrap_EndDrawing :: () {
    presents += 1
    if CaptureFrameInput(watched).available { presented_open = true }
    RealEndDrawing()
}

// Android's system log; the host has none.
#program_export
__wrap___android_log_write :: (priority: s32, tag: *u8, text: *u8) -> s32 {
    unused priority
    unused tag
    unused text
    return 1
}

Draw :: (session: Session) -> bool {
    PollEvents()
    if !PollRaylib() { return false }
    viewport := AndroidViewport.{.width = 320, .height = 200, .ready = 1}
    return DrawAndroidFrame(session, viewport, Rectangle.{0.0, 0.0, 320.0, 200.0})
}

#program_export
main :: () -> s32 {
    if !OpenRaylib(320, 200, "Android frame input local test") { return Failure(1) }
    defer { CloseRaylib() }
    RaylibExitKey(0)
    session := SessionOpen()
    Probe.foreign = SessionOpen()
    watched = session
    if !FocusEvent(true) || !KeyEvent(true) { return Failure(2) }
    if !Draw(session) || Probe.frames != 1 { return Failure(3) }
    first := Probe.seen
    if !first.available || !first.focused || first.keys[65] != cast(u8)3 ||
    first.delta_ms < 0 { return Failure(4) }
    if CaptureFrameInput(session).available || presents == 0 || presented_open { return Failure(5) }
    // Held without a new press, and published again on the next frame.
    if !Draw(session) || !Probe.seen.available ||
    Probe.seen.keys[65] != cast(u8)FrameKeyHeld || Probe.seen.sequence <= first.sequence { return Failure(6) }
    // An application failure still closes the publication before presenting.
    Probe.fail = true
    if !KeyEvent(false) || Draw(session) { return Failure(7) }
    if !Probe.seen.available || Probe.seen.keys[65] != cast(u8)FrameKeyReleased { return Failure(8) }
    if CaptureFrameInput(session).available || presented_open { return Failure(9) }
    Probe.fail = false
    // Losing focus releases held input in the published frame.
    if !KeyEvent(true) || !Draw(session) || Probe.seen.keys[65] != cast(u8)3 { return Failure(10) }
    if !FocusEvent(false) || !Draw(session) { return Failure(11) }
    lost := Probe.seen
    if !lost.available || lost.focused || lost.keys[65] != cast(u8)FrameKeyReleased ||
    lost.pointer.down || lost.modifiers != 0 { return Failure(12) }
    if Probe.foreign_seen || CaptureFrameInput(session).available || presented_open { return Failure(13) }
    unused CloseSession(Probe.foreign)
    unused CloseSession(session)
    return 0
}

libc :: #system_library "c";
PrintFailure :: (format: *u8, code: s32) -> s32 #foreign libc "printf";
Failure :: (code: s32) -> s32 {
    format: [40]u8
    unused CopyCString("android frame input failure %d\n", format[:])
    unused PrintFailure(*format[0], code)
    return code
}
