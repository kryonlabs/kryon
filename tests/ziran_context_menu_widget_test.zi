#import "session"
#import "widget_test_session"

ContextMenu :: #import "kryon/context_menu";
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "tree"
#import "tree_input"
#import "widget_kind"
#import "ziran_context_menu_widget_host"

using WidgetKind;

phase: s32;
open_state: bool;

Click :: (x: float32, y: float32) {
    // A quick click reaches the host as one sample with both edges.
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, true, true, true})
}

// A menu at (20, 20) with Cut, a disabled Copy, a divider, and Paste. The
// panel is 168 wide and 95 tall: rows at y 24, 50, and 85.
#program_export
Frame :: () -> s32 {
    items: [4]ContextMenu.ContextMenuItem
    items[0].id = 1
    items[0].label = "Cut"
    items[1].id = 2
    items[1].label = "Copy"
    items[1].disabled = true
    items[2].separator = true
    items[3].id = 3
    items[3].label = "Paste"
    props: ContextMenu.Props = .{.key = cast(u64)30, .open = open_state, .x = 20.0, .y = 20.0,
        .escape = phase == 9}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 240.0, 160.0})
    result: ContextMenu.ContextMenuResult = ContextMenu.Draw(TestSession(), props, items[0:4])
    if !TreeFinish(TestSession()) { return -1 }
    if phase == 0 {
        // Closed: nothing is submitted.
        if result.open || TreeCount(TestSession()) != 1 { return -2 }
        open_state = true
    } else if phase == 1 {
        // Open: the overlay, its panel, and the three commands.
        if !result.open || result.activated_id != 0 { return -3 }
        if TreeCount(TestSession()) != 7 { return -4 }
        if TreeNodeAt(TestSession(), TreeHitAt(TestSession(), 40.0, 37.0)).kind !=
        WidgetKindSelectable { return -5 }
        Click(40.0, 37.0)
    } else if phase == 2 {
        // Cut was chosen; the menu closes.
        if result.activated_id != 1 || result.open || !result.closed { return -6 }
        open_state = true
    } else if phase == 3 {
        if !result.open { return -7 }
        // The disabled Copy does nothing.
        Click(40.0, 63.0)
    } else if phase == 4 {
        if result.activated_id != 0 || !result.open { return -8 }
        // Paste, below the divider.
        Click(40.0, 98.0)
    } else if phase == 5 {
        if result.activated_id != 3 || result.open { return -9 }
        open_state = true
    } else if phase == 6 {
        if !result.open { return -10 }
        // A click outside the panel dismisses it without choosing anything.
        Click(220.0, 140.0)
    } else if phase == 7 {
        if result.open || !result.closed || result.activated_id != 0 { return -11 }
        open_state = true
    } else if phase == 8 {
        if !result.open { return -12 }
    } else if phase == 9 {
        // Escape closes.
        if result.open || !result.closed { return -13 }
    }
    PaintFlush(TestSession())
    old: s32 = phase
    phase += 1
    return old
}

inline_phase: s32;
inline_open: bool;

// A row of three inline cells above a Copy command, at (20, 20): the cells
// are 32 wide at x 23, 57 and 91, y 25 to 57; Copy is the row at y 58.
#program_export
InlineFrame :: () -> s32 {
    items: [4]ContextMenu.ContextMenuItem
    items[0].id = 11
    items[0].label = "A"
    items[0].inline = true
    items[1].id = 12
    items[1].label = "B"
    items[1].inline = true
    items[2].id = 14
    items[2].label = "C"
    items[2].inline = true
    items[3].id = 13
    items[3].label = "Copy"
    props: ContextMenu.Props = .{.key = cast(u64)31, .open = inline_open, .x = 20.0, .y = 20.0}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 240.0, 160.0})
    result: ContextMenu.ContextMenuResult = ContextMenu.Draw(TestSession(), props, items[0:4])
    if !TreeFinish(TestSession()) { return -1 }
    if inline_phase == 0 {
        bounds: Rectangle = ContextMenu.ContextMenuBounds(items[0:4], 20.0, 20.0,
            Rectangle.{0.0, 0.0, 240.0, 160.0})
        if bounds.width != 168.0 || bounds.height != 68.0 { return -2 }
        inline_open = true
    } else if inline_phase == 1 {
        if !result.open || TreeCount(TestSession()) != 8 { return -3 }
        // The middle cell of the row.
        Click(73.0, 40.0)
    } else if inline_phase == 2 {
        if result.activated_id != 12 || result.open { return -4 }
        inline_open = true
    } else if inline_phase == 3 {
        if !result.open { return -5 }
        // The command below the row.
        Click(60.0, 70.0)
    } else if inline_phase == 4 {
        if result.activated_id != 13 || result.open { return -6 }
    }
    PaintFlush(TestSession())
    old: s32 = inline_phase
    inline_phase += 1
    return old
}

submenu_phase: s32;
submenu_open: bool;

Hover :: (x: float32, y: float32) {
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, false, false, false})
}

Selectable :: (x: float32, y: float32) -> bool {
    return TreeNodeAt(TestSession(), TreeHitAt(TestSession(), x, y)).kind == WidgetKindSelectable
}

// Open, Reopen in with Codex and Claude in its submenu, and Close, at
// (20, 20) in a 480 wide view: rows at y 24, 50 and 76. The submenu opens
// at x 186 with Codex level with Reopen in, at y 50, and Claude at y 76.
#program_export
SubmenuFrame :: () -> s32 {
    items: [5]ContextMenu.ContextMenuItem
    items[0].id = 1
    items[0].label = "Open"
    items[1].id = 2
    items[1].label = "Reopen in"
    items[2].id = 3
    items[2].label = "Codex"
    items[2].parent = 2
    items[3].id = 4
    items[3].label = "Claude"
    items[3].parent = 2
    items[4].id = 5
    items[4].label = "Close"
    props: ContextMenu.Props = .{.key = cast(u64)32, .open = submenu_open, .x = 20.0, .y = 20.0,
        .escape = submenu_phase == 9}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 480.0, 200.0})
    result: ContextMenu.ContextMenuResult = ContextMenu.Draw(TestSession(), props, items[0:5])
    if !TreeFinish(TestSession()) { return -1 }
    if submenu_phase == 0 {
        bounds: Rectangle = ContextMenu.ContextMenuBounds(items[0:5], 20.0, 20.0,
            Rectangle.{0.0, 0.0, 480.0, 200.0})
        // Only the menu's own three rows count.
        if bounds.height != 86.0 { return -2 }
        submenu_open = true
    } else if submenu_phase == 1 {
        // Open with its submenu closed; the pointer rests on Reopen in.
        if !result.open || Selectable(200.0, 63.0) { return -3 }
        Hover(40.0, 63.0)
    } else if submenu_phase == 2 {
        // The submenu opened beside it without a click.
        if !result.open || !Selectable(200.0, 63.0) { return -4 }
        Hover(200.0, 89.0)
    } else if submenu_phase == 3 {
        // Moving into the submenu keeps it open; Claude is chosen.
        if !Selectable(200.0, 89.0) { return -5 }
        Click(200.0, 89.0)
    } else if submenu_phase == 4 {
        if result.activated_id != 4 || result.open || !result.closed { return -6 }
        submenu_open = true
    } else if submenu_phase == 5 {
        // Reopened with no submenu; a tap on Reopen in opens it.
        if !result.open || Selectable(200.0, 63.0) { return -7 }
        Click(40.0, 63.0)
    } else if submenu_phase == 6 {
        if result.activated_id != 0 || !result.open || !Selectable(200.0, 63.0) { return -8 }
        // A tap on the submenu's padding keeps the menu open.
        Click(200.0, 47.0)
    } else if submenu_phase == 7 {
        if !result.open || !Selectable(200.0, 63.0) { return -9 }
        // Resting on Close, which has no submenu, closes the submenu.
        Hover(40.0, 89.0)
    } else if submenu_phase == 8 {
        if !result.open || Selectable(200.0, 63.0) { return -10 }
    } else if submenu_phase == 9 {
        if result.open || !result.closed { return -11 }
    }
    PaintFlush(TestSession())
    old: s32 = submenu_phase
    submenu_phase += 1
    return old
}

check_phase: s32;
check_open: bool;
check_checked: bool;

// Zoom In with an accelerator, then the check rows Show Menubar and Show
// Borders, at (20, 20) in a 320 wide view. Glyphs are half the font wide
// here, so labels start 34 in (the 12 inset, the 14 box and its 8 gap) and
// the panel is 34 + 49 + 32 + 84 + 12 = 211 wide: rows at y 24, 50 and 76.
CheckItems :: (items: []ContextMenu.ContextMenuItem) {
    items[0].id = 21
    items[0].label = "Zoom In"
    items[0].accelerator = "Shift+Ctrl+T"
    items[1].id = 22
    items[1].label = "Show Menubar"
    items[1].checkable = true
    items[1].checked = check_checked
    items[2].id = 23
    items[2].label = "Show Borders"
    items[2].checkable = true
}

#program_export
CheckFrame :: () -> s32 {
    items: [3]ContextMenu.ContextMenuItem
    CheckItems(items[0:3])
    props: ContextMenu.Props = .{.key = cast(u64)33, .open = check_open, .x = 20.0, .y = 20.0}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 320.0, 200.0})
    result: ContextMenu.ContextMenuResult = ContextMenu.Draw(TestSession(), props, items[0:3])
    if !TreeFinish(TestSession()) { return -1 }
    if check_phase == 0 {
        bounds: Rectangle = ContextMenu.ContextMenuBounds(items[0:3], 20.0, 20.0,
            Rectangle.{0.0, 0.0, 320.0, 200.0})
        if bounds.width != 211.0 || bounds.height != 86.0 { return -2 }
        // Without the accelerator the rows fit the minimum width, and
        // without check rows labels keep the plain inset.
        plain: [3]ContextMenu.ContextMenuItem
        CheckItems(plain[0:3])
        plain[0].accelerator = ""
        if ContextMenu.ContextMenuBounds(plain[0:3], 20.0, 20.0, Rectangle.{0.0, 0.0, 320.0, 200.0}).width != 168.0 { return -3 }
        // Positional initializers keep their meaning.
        positional: ContextMenu.ContextMenuItem = .{4, "Old", true, false}
        if positional.id != 4 || !positional.disabled || positional.accelerator != "" ||
        positional.checkable || positional.checked { return -4 }
        check_open = true
        Hover(300.0, 190.0)
    } else if check_phase == 1 {
        if !result.open { return -5 }
        // The check rows report their state; the plain row reports none.
        if !TreeNodeAt(TestSession(), TreeHitAt(TestSession(), 60.0, 63.0)).selected { return -6 }
        if TreeNodeAt(TestSession(), TreeHitAt(TestSession(), 60.0, 89.0)).selected { return -7 }
        if TreeNodeAt(TestSession(), TreeHitAt(TestSession(), 60.0, 37.0)).selected { return -8 }
        ContextMenuWatchLabel("Show Borders")
    } else if check_phase == 2 {
        // Labels line up after the box column.
        if ContextMenuWatchedX() != 54 { return -9 }
        ContextMenuWatchLabel("Shift+Ctrl+T")
    } else if check_phase == 3 {
        // The accelerator ends 12 in from the panel's right edge.
        if ContextMenuWatchedX() != 20 + 211 - 12 - 84 { return -10 }
        // Choosing a check row reports it; the caller flips the state.
        Click(60.0, 89.0)
    } else if check_phase == 4 {
        if result.activated_id != 23 || result.open || !result.closed { return -11 }
        check_open = true
        Hover(300.0, 190.0)
    }
    PaintFlush(TestSession())
    old: s32 = check_phase
    check_phase += 1
    return old
}

// Paints the check menu once with Show Menubar checked or not, and returns
// the fills and outlines it drew.
CheckPaint :: (checked: bool, outlines: *s32) -> s32 {
    check_checked = checked
    check_open = true
    check_phase = 100
    fills: s32 = ContextMenuFillCount()
    before: s32 = ContextMenuOutlineCount()
    CheckFrame()
    outlines.* = ContextMenuOutlineCount() - before
    return ContextMenuFillCount() - fills
}

#program_export
main :: () -> s32 {
    expected: s32 = 0
    while expected < 10 {
        if Frame() != expected { return expected + 1 }
        expected += 1
    }
    // Labels were drawn: three commands per frame the menu was open.
    if ContextMenuLabelCount() < 9 { return 100 }
    expected = 0
    while expected < 5 {
        if InlineFrame() != expected { return 200 + expected }
        expected += 1
    }
    // A wider row widens the panel past its minimum.
    wide: [6]ContextMenu.ContextMenuItem
    index: s32 = 0
    while index < 6 {
        wide[index].id = index + 1
        wide[index].label = "XXXX"
        wide[index].inline = true
        index += 1
    }
    bounds: Rectangle = ContextMenu.ContextMenuBounds(wide[0:6], 0.0, 0.0,
        Rectangle.{0.0, 0.0, 640.0, 480.0})
    if bounds.width != 318.0 || bounds.height != 42.0 { return 300 }
    // A phone-scale menu keeps its rows, text insets and panel together,
    // including the clamped origin at the edge of the view.
    scaled := ContextMenu.ContextMenuBounds(wide[0:6], 600.0, 400.0,
        Rectangle.{0.0, 0.0, 640.0, 480.0}, 2.0)
    if scaled.width != 636.0 || scaled.height != 84.0 { return 301 }
    if scaled.x != 4.0 || scaled.y != 396.0 { return 302 }
    expected = 0
    while expected < 10 {
        if SubmenuFrame() != expected { return 400 + expected }
        expected += 1
    }
    check_checked = true
    expected = 0
    while expected < 5 {
        if CheckFrame() != expected { return 500 + expected }
        expected += 1
    }
    // Both check rows draw an empty box beside the panel's outline; only
    // the checked one adds its mark.
    checked_outlines: s32
    unchecked_outlines: s32
    checked_fills: s32 = CheckPaint(true, *checked_outlines)
    unchecked_fills: s32 = CheckPaint(false, *unchecked_outlines)
    if checked_outlines != 3 || unchecked_outlines != 3 { return 600 }
    if checked_fills <= unchecked_fills { return 601 }
    return 0
}
