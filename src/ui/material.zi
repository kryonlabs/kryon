#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"
#import "surface"

# A resolved surface and its retained interaction sample. Lengths in StyleData
# are logical; bounds and segment coordinates are physical.
MaterialPaint :: struct {
    bounds: Rectangle
    surface: Rectangle
    value: StyleData
    light: u32
    ambient: u32
    hover: float32
    press: float32
    focus: float32
    disabled: bool
    fill: FillStates
    fill_valid: bool
    scale: float32
}

SurfaceDrawing :: struct {
    layer: SurfaceLayer
    bounds: Rectangle
    area: Rectangle
    scale: float32
    surface: Rectangle
    segment: Rectangle
    visible: bool
}

#program_export
PrepareMaterial :: (paint: MaterialPaint) -> MaterialPaint {
    if paint.scale <= 0.0 { paint.scale = 1.0 }
    if paint.surface.width <= 0.0 || paint.surface.height <= 0.0 {
        paint.surface = paint.bounds
    }
    return paint
}

#program_export
MaterialContentBounds :: (paint: MaterialPaint) -> Rectangle {
    result: Rectangle = paint.bounds
    result.y += MaterialOffset(paint.value.material, paint.hover, paint.press,
        paint.disabled) * paint.scale
    return result
}

#program_export
PaintMaterialLayer :: (paint: MaterialPaint, index: s32) -> SurfaceDrawing {
    result: SurfaceDrawing
    value: StyleData = paint.value
    layer: SurfaceLayer = MaterialLayer(value.material, index,
        paint.surface.width / paint.scale, paint.surface.height / paint.scale,
        value.radius, value.border_width, value.background, value.border,
        paint.light, value.focus, paint.hover, paint.press, paint.focus,
        paint.disabled, value.opacity, paint.ambient)
    if layer.is_face {
        if paint.fill_valid {
            layer = ApplyFillStates(layer, paint.fill, value.opacity)
        } else {
            layer = FillGradient(layer, (value.fields & cast(u32)StyleBackgroundEnd) != cast(u32)0,
                value.background, value.background_end, value.opacity)
        }
    }
    result.layer = layer
    result.bounds.x = paint.surface.x + layer.x * paint.scale
    result.bounds.y = paint.surface.y + layer.y * paint.scale
    result.bounds.width = layer.width * paint.scale
    result.bounds.height = layer.height * paint.scale
    blur: float32 = layer.blur * paint.scale
    result.area.x = result.bounds.x - blur
    result.area.y = result.bounds.y - blur
    result.area.width = result.bounds.width + 2.0 * blur
    result.area.height = result.bounds.height + 2.0 * blur
    result.visible = result.bounds.width > 0.0 && result.bounds.height > 0.0 &&
        ((layer.color & cast(u32)255) != cast(u32)0 ||
         (layer.gradient && (layer.end_color & cast(u32)255) != cast(u32)0))
    result.scale = paint.scale
    result.surface = paint.surface
    result.segment = paint.bounds
    return result
}
