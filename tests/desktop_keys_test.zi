#import "desktop_keys"
#import "input_delivery"
#import "input_protocol"
#import "session"
#import "tree_input"
#import "key_input"

#program_export
main :: () -> s32 {
    // The editing keys match the canvas and raylib hosts.
    if DesktopKey(27) != 256 || DesktopKey(13) != 257 ||
    DesktopKey(9) != 258 || DesktopKey(8) != 259 ||
    DesktopKey(127) != 261 { return 1 }
    if DesktopKey(0x4000004F) != 262 || DesktopKey(0x40000050) != 263 ||
    DesktopKey(0x40000051) != 264 || DesktopKey(0x40000052) != 265 ||
    DesktopKey(0x4000004A) != 268 || DesktopKey(0x4000004D) != 269 { return 2 }
    if DesktopKey(0x4000004B) != 266 || DesktopKey(0x4000004E) != 267 ||
    DesktopKey(0x40000058) != 257 || DesktopKey(0x40000049) != 260 { return 3 }
    // Letters are uppercase; digits and punctuation keep their ASCII code.
    if DesktopKey(97) != 65 || DesktopKey(122) != 90 ||
    DesktopKey(48) != 48 || DesktopKey(61) != 61 ||
    DesktopKey(32) != 32 { return 4 }
    if DesktopKey(0x4000003A) != 290 || DesktopKey(0x40000045) != 301 ||
    DesktopKey(0x400000E0) != 341 || DesktopKey(0x400000E5) != 344 { return 5 }
    // A key with no shared code is not reported.
    if DesktopKey(0x40000066) != 0 || DesktopKey(233) != 0 ||
    DesktopKey(0) != 0 { return 6 }
    if DesktopKey(0x40000062) != 320 { return 7 }
    for key: 0..8 { if DesktopKey(0x40000059 + cast(s32)key) != 321 + key { return 8 } }
    if DesktopKeyWithModifiers(0x40000063,0)!=261 || DesktopKeyWithModifiers(0x40000063,0x1000)!=330 ||
        DesktopKeyWithModifiers(0x40000062,0)!=260 || DesktopKeyWithModifiers(0x40000062,0x1000)!=320 ||
        DesktopKey(0x40000057)!=334 || DesktopKey(0x40000056)!=333 { return 15 }
    result := OrderedDelivery()
    if result != 0 { return result }
    return 0
}

// The shared ordered queue every host delivers through.
OrderedDelivery :: () -> s32 {
    session := SessionOpen()
    if !SessionValid(session) { return 20 }
    defer { TreeInputReset(session); unused SessionClose(session) }
    queue: InputDelivery
    // Text, printable keys and Enter after them arrive as one field commit.
    InputDeliveryKey(*queue, 65, KeyModifierShift, false)
    InputDeliveryText(*queue, 65)
    InputDeliveryKey(*queue, 340, KeyModifierShift, false)
    InputDeliveryKey(*queue, KeyEnter, 0, false)
    InputDeliveryKey(*queue, KeyLeft, KeyModifierShift, false)
    if queue.count != 4 { return 21 }
    key, modifiers := InputDeliveryTake(*queue, session, 7)
    if key != KeyEnter || modifiers != 0 || TypedCodepointTake(session) != 65 { return 22 }
    key, modifiers = InputDeliveryTake(*queue, session, 7)
    if key != KeyLeft || modifiers != KeyModifierShift { return 23 }
    key, modifiers = InputDeliveryTake(*queue, session, 7)
    if key != 0 || modifiers != 7 { return 24 }
    // Unread text holds back the next edit; an edit never crosses a text run.
    InputDeliveryText(*queue, 120)
    InputDeliveryKey(*queue, KeyBackspace, 0, false)
    InputDeliveryText(*queue, 121)
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || TypedCodepointPeek(session) != 120 { return 25 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || queue.count != 2 { return 26 }
    if TypedCodepointTake(session) != 120 { return 27 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != KeyBackspace || TypedCodepointPeek(session) != 0 { return 28 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || TypedCodepointTake(session) != 121 { return 29 }
    // A host-reported shortcut (Super or Command) edits without a modifier bit.
    InputDeliveryText(*queue, 97)
    InputDeliveryKey(*queue, 67, 0, true)
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || TypedCodepointTake(session) != 97 { return 30 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 67 || modifiers != 0 { return 31 }
    // Focus loss cancels pending keys and keeps typed text in order.
    InputDeliveryKey(*queue, 68, KeyModifierControl, true)
    InputDeliveryText(*queue, 49)
    InputDeliveryKey(*queue, KeyTab, 0, false)
    InputDeliveryText(*queue, 50)
    InputDeliveryBlur(*queue)
    if queue.count != 2 { return 32 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    bytes: [4]u8
    if key != 0 || TypedTextTake(session, bytes[:]) != "12" { return 33 }
    // Text the application leaves unread holds edits back for one take only.
    InputDeliveryText(*queue, 122)
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    InputDeliveryKey(*queue, KeyEscape, 0, false)
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || queue.count != 1 { return 39 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != KeyEscape || TypedCodepointPeek(session) != 122 { return 40 }
    // A full session the application never reads drops new text, not keys.
    for index: 0..31 { InputDeliveryText(*queue, 97) }
    InputDeliveryKey(*queue, KeyTab, 0, false)
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 || queue.count != 1 || TypedCodepointCapacity(session) != 0 { return 41 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != 0 { return 42 }
    key, modifiers = InputDeliveryTake(*queue, session, 0)
    if key != KeyTab || queue.count != 0 { return 43 }
    TreeInputReset(session)
    // Keys wait at their limit; text may fill the rest, then input drops.
    for index: 0..31 { InputDeliveryKey(*queue, 65, 0, false) }
    if InputDeliveryAccepts(*queue, 1, 0) || !InputDeliveryAccepts(*queue, 0, 224) ||
        InputDeliveryAccepts(*queue, 0, 225) { return 34 }
    for index: 0..250 { InputDeliveryText(*queue, 66) }
    if queue.count != 256 { return 35 }
    InputDeliveryReset(*queue)
    if queue.count != 0 { return 36 }
    key, modifiers = InputDeliveryTake(*queue, session, 3)
    if key != 0 || modifiers != 3 { return 37 }
    // An invalid session takes nothing.
    InputDeliveryKey(*queue, KeyEscape, 0, false)
    invalid: Session
    key, modifiers = InputDeliveryTake(*queue, invalid, 3)
    if key != 0 || modifiers != 0 || queue.count != 1 { return 38 }
    return 0
}
