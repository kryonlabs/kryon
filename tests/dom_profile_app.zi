App :: #import "kryon/app";
Button :: #import "kryon/button";
Dom :: #import "kryon/dom";
Page :: #import "kryon/page";
Text :: #import "kryon/text";
Tree :: #import "kryon/tree";
using Geometry :: #import "kryon/geometry";
using Semantic :: #import "kryon/semantic";
using SessionModule :: #import "kryon/session";

css :: #string CSS
#kryon-dom-root { --face: rgb(16, 32, 48); }
@media (prefers-color-scheme: dark) {
    #kryon-dom-root { --face: rgb(64, 80, 96); }
}
[data-kryon-widget="Page"][data-kryon-class="7"] {
    display: grid; grid-auto-rows: max-content; gap: 8px; padding: 12px;
}
[data-kryon-widget="Button"][data-kryon-class="9"] {
    width: 180px; min-height: 64px; font-size: 17px; line-height: 1.4;
}
[data-kryon-id="31"] { background: var(--face); color: white; transition: opacity 123ms linear; }
@media (prefers-reduced-motion: reduce) {
    [data-kryon-id="31"] { transition-duration: 0ms; }
}
[data-kryon-selected="true"] { outline: 2px solid rebeccapurple; }
CSS;

started: bool;
count: s32;
failed: s32;

Save :: (session: Session) {
    if Button.Draw(session, .{key = 10, id = 31, class_name = 9,
        label = ifx count > 0 then "Save again" else "Save", selected = count > 0}) != 0 {
        count += 1
    }
}

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    if !started {
        if !Dom.SetStyleSheet(css) { print("dom profile: the style sheet failed\n"); failed = 1; return }
        started = true
    }
    page := Page.Draw(session, .{key = 1, bounds = viewport, class_name = 7,
        title = "DOM widget profile"})
    if !page.opened { return }
    Text.Draw(session, .{key = 2, text = "Browser widgets",
        semantic_kind = SemanticKind.SemanticHeading, heading_level = 2})
    reordered := count > 0
    if !reordered { Save(session) }
    unused Button.Draw(session, .{key = 11, label = "Unavailable", disabled = true})
    if reordered { Save(session) }
    if count < 2 { Text.Draw(session, .{key = 3, text = "Initial content"}) }
    label := ifx count < 2 then "Ready" else ifx count == 2 then "Saved twice" else "Saved three times"
    Text.Draw(session, .{key = 4, text = label,
        semantic_kind = SemanticKind.SemanticParagraph})
    closing := viewport.width >= 700.0
    viewport_label := ifx closing then "Closed" else ifx viewport.width >= 500.0 then "Wide" else "Narrow"
    Text.Draw(session, .{key = 5, text = viewport_label})
    if !Tree.End(session) { print("dom profile: the tree did not finish\n"); failed = 2; return }
    if closing { Dom.RequestClose() }
}

main :: () -> s32 {
    code := App.Run(App.Window.{.title = "DOM widget profile"}, Frame)
    if failed != 0 { return failed }
    return code
}
