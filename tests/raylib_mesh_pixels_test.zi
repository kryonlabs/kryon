#import "raylib_image_decode"
#import "raylib_runtime"
#import "geometry"
#import "drawing_props"
#import "c_string"
#import "paint_texture"

test_raylib :: #system_library "raylib";
TestInitWindow :: (width: s32, height: s32, title: *u8) #foreign test_raylib "InitWindow";
TestIsWindowReady :: () -> bool #foreign test_raylib "IsWindowReady";
TestBeginDrawing :: () #foreign test_raylib "BeginDrawing";
TestEndDrawing :: () #foreign test_raylib "EndDrawing";
TestClearBackground :: (color: Color) #foreign test_raylib "ClearBackground";
TestTexture :: (image: RaylibGlyphImage) -> Texture2D #foreign test_raylib "LoadTextureFromImage";
TestTextureFree :: (texture: Texture2D) #foreign test_raylib "UnloadTexture";
TestCapture :: () -> RaylibGlyphImage #foreign test_raylib "LoadImageFromScreen";
TestImageFree :: (image: RaylibGlyphImage) #foreign test_raylib "UnloadImage";

texels: [16]u8;
// Draws a plain triangle after the mesh, as widgets drawn after a warped
// image do.
triangle_after: bool;
// Draws solid triangles in both windings after the mesh, as shape widgets do.
solid_after: bool;
points: [6]Vector2;
texture: Texture2D;
polygon_mode: bool;
polygon_count: s32;
polygon_points: [6]Vector2;
probe_x: [4]s32;
probe_y: [4]s32;
probe_color: [4]u32;

Probe :: (index: s32, x: s32, y: s32, color: u32) {
    probe_x[index] = x
    probe_y[index] = y
    probe_color[index] = color
}

// Draws the 2 × 2 texture over the grid on black and checks four pixels:
// each is the expected texel color, or black.
Check :: (columns: s32, rows: s32, clip: Rectangle) -> bool {
    TestBeginDrawing()
    TestClearBackground(Color.{0, 0, 0, 255})
    if polygon_mode {
        emitting_image_polygon = polygon_points[:polygon_count]
        RasterImage("",texture.id,.{0.0,0.0,2.0,2.0},.{32.0,32.0,128.0,128.0},
            clip,.{0.0,0.0},0.0,0.0,.{255,255,255,255})
        emitting_image_polygon = polygon_points[:0]
    } else { RasterImageMesh("", texture.id, .{0.0, 0.0, 2.0, 2.0}, points[:], columns, rows,
        clip, .{255, 255, 255, 255}) }
    if triangle_after {
        // A rounded fill, which Kryon draws as plain triangles.
        RasterRoundedRectangle(.{192.0, 192.0, 56.0, 56.0}, 12.0, 8,
            .{255, 255, 0, 255})
    }
    if solid_after {
        solid: [6]Vector2
        solid[0] = .{192.0, 192.0}
        solid[1] = .{248.0, 192.0}
        solid[2] = .{248.0, 248.0}
        solid[3] = .{192.0, 192.0}
        solid[4] = .{192.0, 248.0}
        solid[5] = .{248.0, 248.0}
        RasterTriangles(solid[:], .{0, 255, 255, 255})
    }
    TestEndDrawing()
    image := TestCapture()
    defer TestImageFree(image)
    if image.data == null || image.format != 7 { return false }
    bytes := cast(*u8)image.data
    for index: 0..3 {
        at := (probe_y[index] * image.width + probe_x[index]) * 4
        color: u32 = (cast(u32)bytes[at] << cast(u32)16) |
            (cast(u32)bytes[at + 1] << cast(u32)8) | cast(u32)bytes[at + 2]
        if color != probe_color[index] {
            print("pixel % % is % expected %\n", probe_x[index], probe_y[index], color, probe_color[index])
            return false
        }
    }
    return true
}

// An antialiased edge over the same opaque colour changes no pixels.
// Rendering into a texture and presenting it must match direct painting;
// multiplying source alpha twice makes the overlap dark instead.
CheckRetainedAlpha :: () -> bool {
    if !BeginRetainedFrame(256, 256) { return false }
    TestClearBackground(Color.{63, 143, 122, 255})
    RasterRoundedRectangle(.{32.0, 32.0, 128.0, 128.0}, 0.0, 0,
        Color.{63, 143, 122, 128})
    if !EndRetainedFrame() { return false }
    image := TestCapture()
    defer TestImageFree(image)
    if image.data == null || image.format != 7 { return false }
    bytes := cast(*u8)image.data
    at := (64 * image.width + 64) * 4
    if bytes[at] != cast(u8)63 || bytes[at + 1] != cast(u8)143 ||
    bytes[at + 2] != cast(u8)122 {
        print("retained alpha overlap: % % % expected 63 143 122\n",
            bytes[at], bytes[at + 1], bytes[at + 2])
        return false
    }
    return true
}

#program_export
main :: () -> s32 {
    title: [64]u8
    CopyCString("Kryon mesh pixels test", title[:])
    TestInitWindow(256, 256, *title[0])
    if !TestIsWindowReady() { return 1 }
    defer CloseRaylib()
    // Red, green / blue, white.
    texels[0] = cast(u8)255; texels[3] = cast(u8)255
    texels[5] = cast(u8)255; texels[7] = cast(u8)255
    texels[10] = cast(u8)255; texels[11] = cast(u8)255
    for at: 12..15 { texels[at] = cast(u8)255 }
    image: RaylibGlyphImage
    image.data = cast(*void)*texels[0]
    image.width = 2
    image.height = 2
    image.mipmaps = 1
    image.format = 7
    texture = TestTexture(image)
    if texture.id == cast(u32)0 { return 2 }
    defer TestTextureFree(texture)
    full: Rectangle = .{0.0, 0.0, 256.0, 256.0}
    red: u32 = cast(u32)0xff0000
    green: u32 = cast(u32)0x00ff00
    blue: u32 = cast(u32)0x0000ff
    white: u32 = cast(u32)0xffffff
    black: u32 = cast(u32)0
    points[0] = .{32.0, 32.0}; points[1] = .{160.0, 32.0}
    points[2] = .{32.0, 160.0}; points[3] = .{160.0, 160.0}
    Probe(0, 40, 40, red); Probe(1, 150, 40, green)
    Probe(2, 40, 150, blue); Probe(3, 150, 150, white)
    if !Check(2, 2, full) { return 3 }
    // A mirrored grid is wound the other way and must not be culled.
    points[0] = .{160.0, 32.0}; points[1] = .{32.0, 32.0}
    points[2] = .{160.0, 160.0}; points[3] = .{32.0, 160.0}
    Probe(0, 40, 40, green); Probe(1, 150, 40, red)
    Probe(2, 40, 150, white); Probe(3, 150, 150, blue)
    if !Check(2, 2, full) { return 4 }
    // A strip bent into an L: down the left, then along the bottom.
    points[0] = .{32.0, 32.0}; points[1] = .{96.0, 32.0}
    points[2] = .{32.0, 160.0}; points[3] = .{96.0, 96.0}
    points[4] = .{160.0, 160.0}; points[5] = .{160.0, 96.0}
    Probe(0, 40, 40, red); Probe(1, 150, 40, black)
    Probe(2, 150, 156, blue); Probe(3, 200, 200, black)
    if !Check(2, 3, full) { return 5 }
    // Points beyond the clip are cut by it.
    points[0] = .{32.0, 32.0}; points[1] = .{160.0, 32.0}
    points[2] = .{32.0, 160.0}; points[3] = .{160.0, 160.0}
    Probe(0, 40, 40, red); Probe(1, 150, 40, black)
    Probe(2, 40, 150, blue); Probe(3, 150, 150, black)
    if !Check(2, 2, .{0.0, 0.0, 96.0, 256.0}) { return 6 }
    // An untextured shape drawn next keeps its own color: the mesh's
    // texture must not stay bound to the triangles that follow.
    triangle_after = true
    Probe(0, 40, 40, red); Probe(1, 150, 40, green)
    Probe(2, 40, 150, blue); Probe(3, 200, 200, cast(u32)0xffff00)
    if !Check(2, 2, full) { return 7 }
    // Solid triangles fill in either winding, in their own colour.
    triangle_after = false
    solid_after = true
    Probe(0, 40, 40, red)
    Probe(1, 240, 200, cast(u32)0x00ffff)
    Probe(2, 200, 240, cast(u32)0x00ffff)
    Probe(3, 180, 180, black)
    if !Check(2, 2, full) { return 8 }
    if !CheckRetainedAlpha() { return 9 }
    solid_after = false; polygon_mode = true; polygon_count = 4
    polygon_points[0] = .{0.5,0.0}; polygon_points[1] = .{1.0,0.5}
    polygon_points[2] = .{0.5,1.0}; polygon_points[3] = .{0.0,0.5}
    Probe(0,80,55,red); Probe(1,130,80,green); Probe(2,56,112,blue); Probe(3,40,40,black)
    if !Check(0,0,full) { return 10 }
    // Concave cuts work even when the polygon center is outside.
    polygon_count = 6
    polygon_points[0] = .{0.0,0.0}; polygon_points[1] = .{1.0,0.0}; polygon_points[2] = .{1.0,0.3}
    polygon_points[3] = .{0.3,0.3}; polygon_points[4] = .{0.3,1.0}; polygon_points[5] = .{0.0,1.0}
    Probe(0,40,40,red); Probe(1,150,40,green); Probe(2,40,150,blue); Probe(3,150,150,black)
    if !Check(0,0,full) { return 11 }
    return 0
}
