#import "card_behavior"
#import "card_props"
#import "control_props"
#import "geometry"
Theme :: #import "theme";

#program_export
main :: () -> s32 {
    unused Theme.InstallDefaultTheme(false)
    emphasis := CardEmphasis(.CardOutlined)
    face := CardDefaultFace(emphasis, cast(s32)ButtonState.ButtonStateNormal)
    if face.border_width != 1.0 { return 1 }
    return 0
}
