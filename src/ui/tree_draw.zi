#module "tree_draw"
#import "geometry"
#import "paint_queue"
#import "tree"

# Committing and painting are one frame boundary. Raster effects are emitted
# only after the submitted tree is accepted.
BeginTree :: (screen_key: u64, bounds: Rectangle) #export {
    PaintClear()
    TreeStart(screen_key, bounds)
}

CommitTree :: () -> bool #export {
    if PaintOverflow() {
        TreeCancel()
        PaintClear()
        return false
    }
    if !TreeFinish() {
        PaintClear()
        return false
    }
    return true
}

EndTree :: () -> bool #export {
    if !CommitTree() { return false }
    PaintFlush()
    return true
}
