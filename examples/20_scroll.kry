#import "kryon.h"
#style <material> as material

app "Kryon Scroll" {
    size 480 360
    fps 60
}

state {
    scroll_off: int = 0
}

ScrollExample :: () #ui {
    Screen root: {
        AppBackground()
        Background(GetThemeSurface())
        Text((TextProps){.bounds={Scale(40), Scale(28), 0, 0}, .text="Scroll", .wrap=TextWrapNone})
        Scroll content: {
            bounds = {Scale(40), Scale(76), Scale(360), Scale(220)}
            content_height = Scale(520)
            scroll_offset = &scroll_off
            Text((TextProps){.bounds={content.x, content.y + Scale(12), 0, 0}, .text="First row", .wrap=TextWrapNone})
            Text((TextProps){.bounds={content.x, content.y + Scale(82), 0, 0}, .text="Second row", .wrap=TextWrapNone})
            Text((TextProps){.bounds={content.x, content.y + Scale(152), 0, 0}, .text="Third row", .wrap=TextWrapNone})
            Text((TextProps){.bounds={content.x, content.y + Scale(222), 0, 0}, .text="Fourth row", .wrap=TextWrapNone})
            Text((TextProps){.bounds={content.x, content.y + Scale(292), 0, 0}, .text="Fifth row", .wrap=TextWrapNone})
            Text((TextProps){.bounds={content.x, content.y + Scale(362), 0, 0}, .text="Sixth row", .wrap=TextWrapNone})
        }
    }
}
