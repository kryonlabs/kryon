// Loads images as the browser driver asks for them. The DOM host must report
// an image's size only when the img showing it has decoded, keep showing it
// decoded after other images load, and report an undecodable image as
// unavailable rather than wait on it.
using UI :: #import "kryon/Widgets";
#import "std/web"
Raster :: #import "kryon/image_raster";
host_api :: #system_library "host_api";
RequestWindowClose :: () #foreign host_api;

frames: s32;
others: [6]string = .["assets/other0.png", "assets/other1.png", "assets/other2.png",
    "assets/other3.png", "assets/other4.png", "assets/other5.png"];

Flag :: (name: string) -> bool {
    return WebAsBool(WebGet(WebGlobal, WebName(name)))
}

Report :: (name: string, value: float64) {
    WebSet(WebGlobal, WebName(name), WebNumber(value))
}

PageImage :: (session: Session, key: u64, x: float32) {
    Image(session, ImageProps.{.key = key, .bounds = .{x, 0.0, 300.0, 200.0}, .asset_path = "assets/page.png"})
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    scope: s32 = WebScope()
    defer WebEnd(scope)
    page: PageProps
    page.key = 2; page.bounds = viewport; page.title = "DOM Image Decode"
    opened: PageResult = Page(session, page)
    // The driver reads these as the frame's imgs are published.
    if Flag("__kryonOthers") {
        loaded: s32 = 0
        for at: 0..others.count - 1 {
            if Raster.AssetWidth(others[at]) == 40 { loaded += 1 }
            Image(session, ImageProps.{.key = cast(u64)(30 + at), .bounds = .{cast(float32)(at * 50), 220.0, 40.0, 30.0},
                .asset_path = others[at]})
        }
        Report("__kryonOthersLoaded", cast(float64)loaded)
        // Shown again, twice: one img and one copy drawn from its canvas.
        if Flag("__kryonAgain") { PageImage(session, 20, 0.0); PageImage(session, 21, 320.0) }
    } else if Flag("__kryonLoad") {
        Report("__kryonWidth", cast(float64)Raster.AssetWidth("assets/page.png"))
        Report("__kryonHeight", cast(float64)Raster.AssetHeight("assets/page.png"))
        Report("__kryonBrokenWidth", cast(float64)Raster.AssetWidth("assets/broken.png"))
        PageImage(session, 20, 0.0)
    }
    if Flag("__kryonReject") {
        Report("__kryonRejectedWidth", cast(float64)Raster.AssetWidth("assets/rejected.png"))
    }
    frames += 1
    Report("__kryonFrames", cast(float64)frames)
    if opened.opened { End(session) }
    if Flag("__kryonTestDone") { RequestWindowClose() }
    return 0
}
