#module "radio"
#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"

RadioSpec :: struct {
    bounds: Rectangle
    checked: bool
    disabled: bool
    selected_amount: float
    scale: float
    frame: StyleFrame
    selected: StyleFrame
}

RadioPaint :: struct {
    hit_bounds: Rectangle
    mark_bounds: Rectangle
    label_bounds: Rectangle
    center: Vector2
    label_x: float
    diameter: float
    touch: float
    outer_radius: float
    stroke_width: float
    fill_radius: float
    ring_color: u32
    fill_color: u32
    label_color: u32
}

RadioHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

RadioMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !RadioHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

RadioRingRole :: () -> i32 #export {
    return 11
}

RadioMarkRole :: () -> i32 #export {
    return 10
}

RadioLabelRole :: () -> i32 #export {
    return 6
}

RadioSizeForStyle :: (ring: StyleFrame, scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return RadioMetric(ring.value.fields, (u32)StyleIconSize,
        ring.value.icon_size, 20.0, scale, true)
}

RadioTouchSizeForStyle :: (ring: StyleFrame, scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return RadioMetric(ring.value.fields, (u32)StylePaddingX,
        ring.value.padding_x, 40.0, scale, true)
}

RadioMarkText :: (checked: bool) -> const char* #export {
    if checked { return "◉" }
    return "○"
}

RadioStateLayerAlpha :: (hovered: bool, down: bool, press_amount: float) -> i32 #export {
    if down { return 31 }
    if !hovered { return 0 }
    if press_amount < 0.0 { press_amount = 0.0 }
    if press_amount > 1.0 { press_amount = 1.0 }
    return (i32)(20.0 + 11.0 * press_amount)
}

RadioActivationFor :: (id: i32, activated: bool, disabled: bool) -> i32 #export {
    if activated && !disabled {
        return id
    }
    return 0
}

RadioPaintFor :: (spec: RadioSpec) -> RadioPaint #export {
    paint: RadioPaint
    scale: float = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    diameter: float = (float)RadioSizeForStyle(spec.frame, scale)
    gap: float = (float)RadioMetric(spec.frame.value.fields,
        (u32)StyleGap, spec.frame.value.gap, 8.0, scale, true)
    slot_width: float = (float)RadioTouchSizeForStyle(spec.frame, scale)
    if slot_width < diameter {
        slot_width = diameter
    }

    paint.hit_bounds = spec.bounds
    if paint.hit_bounds.width < slot_width {
        paint.hit_bounds.width = slot_width
    }
    paint.diameter = diameter
    paint.touch = slot_width
    paint.center.x = spec.bounds.x + slot_width * 0.5
    paint.center.y = spec.bounds.y + spec.bounds.height * 0.5

    paint.mark_bounds.x = spec.bounds.x + (slot_width - diameter) * 0.5
    paint.mark_bounds.y = spec.bounds.y + (spec.bounds.height - diameter) * 0.5
    paint.mark_bounds.width = diameter
    paint.mark_bounds.height = diameter

    paint.label_x = spec.bounds.x + slot_width + gap
    paint.label_bounds.x = paint.label_x
    paint.label_bounds.y = spec.bounds.y
    paint.label_bounds.width = spec.bounds.width - (paint.label_x - spec.bounds.x)
    paint.label_bounds.height = spec.bounds.height
    if paint.label_bounds.width < 0.0 {
        paint.label_bounds.width = 0.0
    }

    selected: float = spec.selected_amount
    if selected < 0.0 { selected = 0.0 }
    if selected > 1.0 { selected = 1.0 }
    if spec.checked {
        selected = 1.0
    }
    paint.outer_radius = diameter * 0.5
    paint.stroke_width = spec.frame.value.border_width * scale
    if paint.stroke_width < 0.0 { paint.stroke_width = 0.0 }
    paint.fill_radius = (paint.outer_radius - paint.stroke_width * 1.5) * selected
    if spec.checked {
        paint.fill_radius = paint.outer_radius - paint.stroke_width
    }
    if paint.fill_radius < 0.0 {
        paint.fill_radius = 0.0
    }

    paint.ring_color = spec.frame.value.border
    paint.fill_color = spec.selected.value.background
    paint.label_color = spec.frame.value.foreground
    if spec.checked {
        paint.ring_color = spec.selected.value.background
    }
    if !spec.checked && selected > 0.0 {
        paint.ring_color = spec.selected.value.background
    }
    return paint
}
