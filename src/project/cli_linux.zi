#import "options"

// Linux command-line host for Kryon projects. Configuration and command
// selection are Ziran; libc supplies only file, stdout, and process effects.
libc :: #system_library "libc";
RawOpen :: (path: *u8, flags: s32) -> s32 #foreign libc "open";
RawRead :: (fd: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
RawWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";
RawClose :: (fd: s32) -> s32 #foreign libc "close";
RawIsTty :: (fd: s32) -> s32 #foreign libc "isatty";
RawExec :: (name: *u8, arguments: *PointerSlot) -> s32 #foreign libc "execvp";
RawSetenv :: (name: *u8, value: *u8, overwrite: s32) -> s32 #foreign libc "setenv";
RawGetenv :: (name: *u8) -> *u8 #foreign libc "getenv";
RawUnsetenv :: (name: *u8) -> s32 #foreign libc "unsetenv";
RawFork :: () -> s32 #foreign libc "fork";
RawExit :: (status: s32) -> void #foreign libc "_exit";
RawWait :: (pid: s32, status: *s32, options: s32) -> s32 #foreign libc "waitpid";
RawErrno :: () -> *s32 #foreign libc "__errno_location";
RawLock :: (fd: s32, operation: s32) -> s32 #foreign libc "flock";
RawOpenDirectory :: (path: *u8) -> *void #foreign libc "opendir";
RawDirectoryFd :: (directory: *void) -> s32 #foreign libc "dirfd";
RawCloseDirectory :: (directory: *void) -> s32 #foreign libc "closedir";
RawTempDirectory :: (path: *u8) -> *u8 #foreign libc "mkdtemp";
RawRemoveDirectory :: (path: *u8) -> s32 #foreign libc "rmdir";
RawUnlink :: (path: *u8) -> s32 #foreign libc "unlink";
RawRename :: (source: *u8, destination: *u8) -> s32 #foreign libc "rename";
CopyDescriptor :: (source: *TextDescriptor, destination: *string,
    count: u64) -> void #foreign libc "bcopy";

TextDescriptor :: struct {
    data: *u8
    length: u64
}

PointerSlot :: struct {
    value: *u8
}

ArgumentBytes :: struct {
    data: [4096]u8
}

FileContents :: struct {
    text: string
    ok: bool
}

TextFromBuffer :: (bytes: []u8, length: s32) -> string {
    if length < 0 || length > cast(s32)bytes.count { return "" }
    descriptor: TextDescriptor
    descriptor.data = *bytes[0]
    descriptor.length = cast(u64)length
    result: string = ""
    CopyDescriptor(*descriptor, *result, size_of(TextDescriptor))
    return result
}

Environment :: (name: string, output: []u8) -> string {
    name_bytes: [128]u8
    if !CString(name, name_bytes[:]) { return "" }
    value: *u8 = RawGetenv(*name_bytes[0])
    if value == null { return "" }
    length: s32 = 0
    while value[length] != cast(u8)0 {
        if length >= cast(s32)output.count { return "" }
        output[length] = value[length]
        length += 1
    }
    return TextFromBuffer(output, length)
}

CString :: (value: string, output: []u8) -> bool {
    if value.count >= output.count { return false }
    at: s32 = 0
    while at < cast(s32)value.count {
        output[at] = value[at]
        at += 1
    }
    output[at] = cast(u8)0
    return true
}

Join :: (first: string, second: string, output: []u8) -> string {
    count: s32 = cast(s32)first.count + cast(s32)second.count
    if count >= cast(s32)output.count { return "" }
    at: s32 = 0
    while at < cast(s32)first.count {
        output[at] = first[at]
        at += 1
    }
    index: s32 = 0
    while index < cast(s32)second.count {
        output[at] = second[index]
        at += 1
        index += 1
    }
    return TextFromBuffer(output, count)
}

PrintFd :: (fd: s32, value: string) -> bool {
    bytes: [4096]u8
    at: s32 = 0
    while at < cast(s32)value.count {
        count: s32 = cast(s32)value.count - at
        if count > 4096 { count = 4096 }
        index: s32 = 0
        while index < count {
            bytes[index] = value[at + index]
            index += 1
        }
        written: s64 = RawWrite(fd, *bytes[0], cast(u64)count)
        if written <= 0 { return false }
        at += cast(s32)written
    }
    return true
}

Error :: (message: string) -> s32 {
    PrintFd(2, "kryon: ")
    PrintFd(2, message)
    PrintFd(2, "\n")
    return 2
}

ReadFile :: (path: string, output: []u8) -> FileContents {
    result: FileContents
    name: [4096]u8
    if !CString(path, name[:]) { return result }
    fd: s32 = RawOpen(*name[0], 0)
    if fd < 0 { return result }
    length: s32 = 0
    while length < cast(s32)output.count {
        count: s64 = RawRead(fd, *output[length],
            cast(u64)(cast(s32)output.count - length))
        if count < 0 {
            RawClose(fd)
            return result
        }
        if count == 0 {
            result.ok = true
            break
        }
        length += cast(s32)count
    }
    if length == cast(s32)output.count {
        extra: u8 = cast(u8)0
        result.ok = RawRead(fd, *extra, 1) == 0
    }
    RawClose(fd)
    if result.ok { result.text = TextFromBuffer(output, length) }
    return result
}

SetEnvironment :: (name: string, value: string) -> bool {
    name_bytes: [128]u8
    value_bytes: [4096]u8
    if !CString(name, name_bytes[:]) || !CString(value, value_bytes[:]) { return false }
    return RawSetenv(*name_bytes[0], *value_bytes[0], 1) == 0
}

Exists :: (path: string) -> bool {
    name: [4096]u8
    if !CString(path, name[:]) { return false }
    fd: s32 = RawOpen(*name[0], 0)
    if fd < 0 { return false }
    RawClose(fd)
    return true
}

Execute :: (arguments: []string) -> s32 {
    storage: [24]ArgumentBytes
    pointers: [25]PointerSlot
    if arguments.count > storage.count { return Error("too many project command arguments") }
    if arguments.count == 0 { return 127 }
    at: s32 = 0
    while at < cast(s32)arguments.count {
        if !CString(arguments[at], storage[at].data[:]) { return 127 }
        pointers[at].value = *storage[at].data[0]
        at += 1
    }
    pointers[at].value = null
    RawExec(*storage[0].data[0], *pointers[0])
    return 127
}

RunChild :: (arguments: []string) -> s32 {
    pid := RawFork()
    if pid < 0 { return 127 }
    if pid == 0 { RawExit(Execute(arguments)); return 127 }
    status: s32
    while RawWait(pid, *status, 0) < 0 {
        if RawErrno().* != 4 { return 127 } // EINTR
    }
    if (status & 127) != 0 { return 128 + (status & 127) }
    return (status >> 8) & 255
}

// Argument index of a NUL-separated command line, as a view of it.
ArgumentAt :: (command_line: string, wanted: s32) -> string {
    current: s32 = 0
    start: s32 = 0
    at: s32 = 0
    while at < cast(s32)command_line.count {
        if command_line[at] == cast(u8)0 {
            if current == wanted { return command_line[start:at] }
            current += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

ArgumentCount :: (command_line: string) -> s32 {
    count: s32 = 0
    at: s32 = 0
    while at < cast(s32)command_line.count {
        if command_line[at] == cast(u8)0 { count += 1 }
        at += 1
    }
    return count
}

BackendDescription :: (profile: ProjectProfile) -> string {
    backend := profile.backend
    if backend == "desktop" { return "SDL2/Cairo window" }
    if backend == "canvas" { return "Canvas2D browser page" }
    if backend == "dom" { return "HTML DOM browser page" }
    if backend == "terminal" { return "terminal" }
    if backend == "pixmap" { return "headless image, PPM on standard output" }
    if backend == "android" { return "Android package (NativeActivity)" }
    return backend
}

// The android profile builds through its own Gradle project under droid/;
// the shared make route cannot link a NativeActivity payload. Everything the
// build script needs travels as environment variables, never as shell text.
AndroidCommand :: (config: ProjectConfig, profile: ProjectProfile, kryon_root: string,
    ziran_root: string, verb: string) -> s32 {
    project_root_bytes: [4096]u8
    project_root: string = Environment("ZIRAN_PROJECT_ROOT",
        project_root_bytes[:])
    if project_root == "" { project_root = "." }
    if !SetEnvironment("KRYON_DIR", kryon_root) ||
    !SetEnvironment("ZIRAN_DIR", ziran_root) ||
    !SetEnvironment("KRYON_PROJECT_ROOT", project_root) ||
    !SetEnvironment("KRYON_PROJECT_NAME", config.name) ||
    !SetEnvironment("KRYON_PROJECT_ENTRY", config.entry) ||
    !SetEnvironment("KRYON_PROJECT_PROFILE", profile.name) ||
    !SetEnvironment("KRYON_PROJECT_CODEGEN", profile.codegen) ||
    !SetEnvironment("KRYON_PROJECT_ASSETS", profile.assets) ||
    !SetEnvironment("KRYON_ANDROID_PACKAGE", config.android.package) ||
    !SetEnvironment("KRYON_ANDROID_MIN_SDK", config.android.min_sdk) ||
    !SetEnvironment("KRYON_ANDROID_ABIS", config.android.abis) ||
    !SetEnvironment("KRYON_ANDROID_ACTIVITY", config.android.activity) {
        return Error("cannot pass android options")
    }
    script_bytes: [4096]u8
    script: string = Join(kryon_root, "/scripts/android-build.sh",
        script_bytes[:])
    if script == "" || !Exists(script) {
        return Error("kryon android build script not found")
    }
    args: [3]string
    args[0] = "sh"
    args[1] = script
    args[2] = verb
    return Execute(args[:])
}

ChooseProfile :: (config: ProjectConfig) -> s32 {
    PrintFd(1, "Choose a profile:\n")
    index: s32 = 0
    while index < config.profile_count {
        digit: [1]u8
        digit[0] = cast(u8)(49 + index)
        PrintFd(1, "  ")
        PrintFd(1, TextFromBuffer(digit[:], 1))
        PrintFd(1, ") ")
        PrintFd(1, config.profiles[index].name)
        PrintFd(1, " (")
        PrintFd(1, BackendDescription(config.profiles[index]))
        PrintFd(1, ")\n")
        index += 1
    }
    PrintFd(1, "Selection: ")
    chosen: u8 = cast(u8)0
    extra: bool = false
    while true {
        byte: u8 = cast(u8)0
        if RawRead(0, *byte, 1) != 1 { break }
        if byte == cast(u8)10 || byte == cast(u8)13 { break }
        if chosen == cast(u8)0 {
            chosen = byte
        } else {
            extra = true
        }
    }
    if RawIsTty(0) == 0 { PrintFd(1, "\n") }
    if extra { return -1 }
    index = cast(s32)chosen - 49
    if index < 0 || index >= config.profile_count { return -1 }
    return index
}

ListProfiles :: (config: ProjectConfig) -> s32 {
    index: s32 = 0
    while index < config.profile_count {
        profile: ProjectProfile = config.profiles[index]
        if profile.name == config.default_profile { PrintFd(1, "* ") }
        else { PrintFd(1, "  ") }
        PrintFd(1, profile.name)
        PrintFd(1, "  ")
        PrintFd(1, BackendDescription(profile))
        PrintFd(1, "\n")
        index += 1
    }
    return 0
}

Usage :: () -> s32 {
    PrintFd(1, "usage: kryon new DIR [--template NAME|SOURCE[:NAME]] [--name NAME] [--overrides FILE]\n")
    PrintFd(1, "       kryon init [--template NAME|SOURCE[:NAME]] [--overrides FILE]\n")
    PrintFd(1, "       kryon run|build|check [PROFILE | --profile NAME]\n")
    PrintFd(1, "       kryon run FILE.zx\n")
    PrintFd(1, "       kryon install [--prefix DIR]\n")
    PrintFd(1, "       kryon profiles\n")
    unused PreviewUsage()
    PrintFd(1, "Kryon templates: app (window), tui (terminal), pages (navigation), web (browser page)\n")
    PrintFd(1, "An android profile builds an installable APK; it needs [tool.kryon.android] package.\n")
    return 0
}

PreviewUsage :: () -> s32 {
    PrintFd(1, "usage: kryon preview FIXTURE --theme light|dark --width PX[,PX...] --height PX --output FILE.png|PREFIX [--profile NAME]\n")
    PrintFd(1, "       Builds previews/FIXTURE.zi once and writes PNG and JSON. Multiple widths append -PX to the prefix.\n")
    return 0
}

PreviewOptions :: struct {
    fixture: string
    theme: string
    width: string
    height: string
    output: string
    profile: string
    error: string
}

PreviewDimension :: (value: string) -> s32 {
    if value.count == 0 || value.count > 4 { return 0 }
    result: s32 = 0
    for i: 0..value.count - 1 {
        byte := value[i]
        if byte < #char "0" || byte > #char "9" { return 0 }
        result = result * 10 + cast(s32)(byte - #char "0")
    }
    if result > 4096 { return 0 }
    return result
}

NextPreviewWidth :: (widths: string, position: *s32) -> string {
    start := position.*
    while position.* < widths.count && widths[position.*] != #char "," { position.* += 1 }
    finish := position.*
    position.* += 1
    return widths[start:finish]
}

PreviewWidthError :: (widths: string) -> string {
    seen: [4097]bool
    position: s32 = 0
    while position <= widths.count {
        width := PreviewDimension(NextPreviewWidth(widths, *position))
        if width == 0 { return "preview --width must list integers from 1 through 4096 separated by commas" }
        if seen[width] { return "preview --width lists the same width more than once" }
        seen[width] = true
    }
    return ""
}

ParsePreview :: (command_line: string) -> PreviewOptions {
    options: PreviewOptions
    options.fixture = ArgumentAt(command_line, 2)
    if !ProjectNameValid(options.fixture) || options.fixture.count > 100 {
        options.error = "preview requires a fixture name (letters, digits, _ or -); see kryon preview --help"
        return options
    }
    count := ArgumentCount(command_line)
    index: s32 = 3
    while index < count {
        flag := ArgumentAt(command_line, index)
        value := ArgumentAt(command_line, index + 1)
        if value == "" || ProjectStarts(value, "--") {
            options.error = "preview options need values; see kryon preview --help"
            return options
        }
        if flag == "--theme" && options.theme == "" { options.theme = value }
        else if flag == "--width" && options.width == "" { options.width = value }
        else if flag == "--height" && options.height == "" { options.height = value }
        else if flag == "--output" && options.output == "" { options.output = value }
        else if flag == "--profile" && options.profile == "" { options.profile = value }
        else {
            options.error = "unknown or repeated preview option; see kryon preview --help"
            return options
        }
        index += 2
    }
    if options.theme != "light" && options.theme != "dark" {
        options.error = "preview --theme must be light or dark"
    } else if PreviewDimension(options.height) == 0 {
        options.error = "preview --height must be an integer from 1 through 4096"
    } else if options.output == "" {
        options.error = "preview needs --output FILE.png or PREFIX"
    } else if options.profile != "" && !ProjectNameValid(options.profile) {
        options.error = "invalid preview profile name; use kryon profiles to list profiles"
    } else {
        options.error = PreviewWidthError(options.width)
    }
    return options
}

PreviewPngSizeMatches :: (path: *u8, width: s32, height: s32) -> bool {
    header: [24]u8
    fd := RawOpen(path, 0)
    if fd < 0 { return false }
    defer { RawClose(fd) }
    if RawRead(fd, *header[0], 24) != 24 { return false }
    signature: [8]u8 = .[137, 80, 78, 71, 13, 10, 26, 10]
    for i: 0..7 { if header[i] != signature[i] { return false } }
    if TextFromBuffer(header[12:16], 4) != "IHDR" { return false }
    actual_width: u32 = 0
    actual_height: u32 = 0
    for i: 0..3 {
        actual_width = (actual_width << 8) | cast(u32)header[16 + i]
        actual_height = (actual_height << 8) | cast(u32)header[20 + i]
    }
    return actual_width == cast(u32)width && actual_height == cast(u32)height
}

PreviewLockDirectory :: (path: *u8) -> *void {
    directory := RawOpenDirectory(path)
    if directory != null && RawLock(RawDirectoryFd(directory), 2) != 0 { // LOCK_EX
        RawCloseDirectory(directory)
        return null
    }
    return directory
}

PreviewCapture :: (prefix: string, width: string, height: string, args: []string) -> s32 {
    png_bytes: [4096]u8
    tree_bytes: [4096]u8
    parent_bytes: [4096]u8
    stage_name_bytes: [4096]u8
    png := Join(prefix, ".png", png_bytes[:])
    tree := Join(prefix, ".json", tree_bytes[:])
    parent_end := prefix.count
    while parent_end > 0 && prefix[parent_end - 1] != #char "/" { parent_end -= 1 }
    parent := ifx parent_end > 0 then prefix[0:parent_end] else "./"
    stage := Join(parent, ".kryon-preview.XXXXXX", stage_name_bytes[:])
    if png == "" || tree == "" || stage == "" || stage.count > 4080 {
        return Error("preview output path is too long")
    }
    // Join leaves the final zero byte in each zero-initialized buffer.
    destinations: [2]*u8 = .[*png_bytes[0], *tree_bytes[0]]
    for destination: destinations {
        directory := RawOpenDirectory(destination)
        if directory != null {
            RawCloseDirectory(directory)
            return Error("preview output names an existing directory")
        }
    }
    if RawTempDirectory(*stage_name_bytes[0]) == null {
        return Error("cannot stage preview output; check that its parent exists and is writable")
    }
    defer { RawRemoveDirectory(*stage_name_bytes[0]) }
    staged_png_bytes: [4096]u8
    staged_tree_bytes: [4096]u8
    staged_png := Join(stage, "/frame.png", staged_png_bytes[:])
    staged_tree := Join(stage, "/tree.json", staged_tree_bytes[:])
    defer {
        RawUnlink(*staged_png_bytes[0])
        RawUnlink(*staged_tree_bytes[0])
    }

    if !SetEnvironment("KRYON_TEST_DRIVER", stage) ||
    !SetEnvironment("KRYON_CAPTURE_PATH", staged_png) ||
    !SetEnvironment("KRYON_PREVIEW_TREE", staged_tree) ||
    !SetEnvironment("KRYON_PREVIEW_WIDTH", width) {
        return Error("cannot configure the preview renderer")
    }
    // Build under the preview lock on the first capture only.
    if args[5] == "build" {
        if RunChild(args) != 0 {
            return Error("preview build or render failed; see diagnostics above, add previews to [package] module_roots and export Frame from the fixture")
        }
        args[5] = "run-built"
    }
    if RunChild(args) != 0 {
        return Error("preview build or render failed; see diagnostics above, add previews to [package] module_roots and export Frame from the fixture")
    }
    if !Exists(staged_tree) || !PreviewPngSizeMatches(*staged_png_bytes[0],
        PreviewDimension(width), PreviewDimension(height)) {
        return Error("preview did not produce a widget tree and PNG of the requested size; export Frame from the fixture")
    }
    if !CString(parent, parent_bytes[:]) { return Error("preview output directory is too long") }
    publish_lock := PreviewLockDirectory(*parent_bytes[0])
    if publish_lock == null { return Error("cannot lock the preview output directory") }
    defer { RawCloseDirectory(publish_lock) }
    if RawRename(*staged_png_bytes[0], *png_bytes[0]) != 0 ||
    RawRename(*staged_tree_bytes[0], *tree_bytes[0]) != 0 {
        return Error("cannot publish preview outputs; check destination permissions")
    }
    PrintFd(1, png)
    PrintFd(1, "\n")
    PrintFd(1, tree)
    PrintFd(1, "\n")
    return 0
}

PreviewRun :: (options: PreviewOptions, profile: ProjectProfile, args: []string) -> s32 {
    prefix := options.output
    if prefix.count >= 4 && prefix[prefix.count - 4:prefix.count] == ".png" {
        prefix = prefix[0:prefix.count - 4]
    }
    if prefix == "" || prefix[prefix.count - 1] == #char "/" {
        return Error("preview --output must name a file or prefix")
    }

    build_root_bytes: [4096]u8
    build_path_bytes: [4096]u8
    build_option_bytes: [4096]u8
    build_root := Join("build/preview/", profile.name, build_root_bytes[:])
    build_path := Join(build_root, "/", build_path_bytes[:])
    if build_root == "" || build_path == "" { return Error("preview build directory is too long") }
    build_root = Join(build_path, options.fixture, build_root_bytes[:])
    if build_root == "" { return Error("preview build directory is too long") }
    args[5] = "build"
    args[22] = Join("PROJECT_BUILD_DIR=", build_root, build_option_bytes[:])
    args[23] = "PROJECT_PROGRAM=" // Bind Frame even if the fixture declares a main.
    if args[22] == "" { return Error("preview build directory is too long") }
    mkdir: [4]string = .["mkdir", "-p", "--", build_root]
    if RunChild(mkdir[:]) != 0 { return Error("cannot create the preview build directory") }
    unused CString("build/preview", build_path_bytes[:])
    lock := PreviewLockDirectory(*build_path_bytes[0])
    if lock == null { return Error("cannot lock the preview build directory") }
    defer { RawCloseDirectory(lock) }

    display_env: [11]string = .["DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "GDK_DISPLAY",
        "DBUS_SESSION_BUS_ADDRESS", "SESSION_MANAGER", "DESKTOP_SESSION", "ICEAUTHORITY",
        "XDG_SESSION_ID", "XDG_SESSION_TYPE", "XDG_RUNTIME_DIR"]
    for name: display_env {
        key: [64]u8
        if !CString(name, key[:]) || RawUnsetenv(*key[0]) != 0 {
            return Error("cannot isolate preview from the desktop session")
        }
    }
    if !SetEnvironment("HARMONY_DESKTOP_RECOVERY", "0") ||
    !SetEnvironment("YUE_DESKTOP_RECOVERY", "0") ||
    !SetEnvironment("SDL_VIDEODRIVER", "dummy") ||
    !SetEnvironment("SDL_RENDER_DRIVER", "software") ||
    !SetEnvironment("KRYON_PREVIEW_THEME", options.theme) ||
    !SetEnvironment("KRYON_PREVIEW_HEIGHT", options.height) {
        return Error("cannot configure the preview renderer")
    }
    position: s32 = 0
    width := NextPreviewWidth(options.width, *position)
    if position > options.width.count { return PreviewCapture(prefix, width, options.height, args) }
    stem_bytes: [4096]u8
    stem := Join(prefix, "-", stem_bytes[:])
    if stem == "" { return Error("preview output path is too long") }
    while width != "" {
        sized_bytes: [4096]u8
        sized_prefix := Join(stem, width, sized_bytes[:])
        if sized_prefix == "" { return Error("preview output path is too long") }
        status := PreviewCapture(sized_prefix, width, options.height, args)
        if status != 0 { return status }
        if position > options.width.count { break }
        width = NextPreviewWidth(options.width, *position)
    }
    return 0
}

KryonTemplates :: "https://github.com/kryonlabs/kryon.git";

// A bare template name is one of Kryon's; anything else names its own
// package, as ziran new does.
TemplateSpec :: (value: string, base: string, output: []u8) -> string {
    at: s32 = 0
    plain: bool = value.count > 0 && value[0] != cast(u8)46
    while at < cast(s32)value.count {
        if value[at] == cast(u8)47 || value[at] == cast(u8)58 { plain = false }
        at += 1
    }
    if !plain { return value }
    joined_bytes: [4096]u8
    joined: string = Join(base, ":", joined_bytes[:])
    if joined == "" { return "" }
    return Join(joined, value, output)
}

// Outside `ziran tool kryon`, kryon is a front door: project commands go
// through ziran, which runs the Kryon the project's ziran.lock pins, and
// new and init start projects from Kryon's templates.
FrontDoor :: (command_line: string, verb: string) -> s32 {
    guard_bytes: [8]u8
    if Environment("KRYON_FRONT_DOOR", guard_bytes[:]) == "1" {
        return Error("ziran tool kryon started kryon without project settings")
    }
    if !SetEnvironment("KRYON_FRONT_DOOR", "1") { return Error("cannot set the environment") }
    count: s32 = ArgumentCount(command_line)
    if count > 14 { return Error("too many arguments") }
    args: [16]string
    used: s32 = 0
    args[used] = "ziran"
    used += 1
    base_bytes: [4096]u8
    base: string = Environment("KRYON_TEMPLATES", base_bytes[:])
    if base == "" { base = KryonTemplates }
    spec_bytes: [4096]u8
    if verb == "new" || verb == "init" {
        args[used] = verb
        used += 1
        templated: bool = false
        index: s32 = 2
        while index < count {
            part: string = ArgumentAt(command_line, index)
            args[used] = part
            used += 1
            if part == "--template" && index + 1 < count {
                templated = true
                args[used] = TemplateSpec(ArgumentAt(command_line, index + 1),
                    base, spec_bytes[:])
                if args[used] == "" { return Error("template name is too long") }
                used += 1
                index += 1
            }
            index += 1
        }
        if !templated {
            args[used] = "--template"
            used += 1
            args[used] = TemplateSpec("app", base, spec_bytes[:])
            used += 1
        }
    } else {
        if verb == "install" {
            args[used] = "install"
            used += 1
        } else {
            args[used] = "tool"
            args[used + 1] = "kryon"
            args[used + 2] = verb
            used += 3
        }
        index: s32 = 2
        while index < count {
            args[used] = ArgumentAt(command_line, index)
            used += 1
            index += 1
        }
    }
    Execute(args[0:used])
    return Error("cannot run ziran; install it with make install-user in the Ziran repository")
}

#program_export
main :: () -> s32 {
    command_bytes: [8192]u8
    command_line: FileContents = ReadFile("/proc/self/cmdline", command_bytes[:])
    if !command_line.ok { return Error("cannot read command arguments") }
    verb: string = ArgumentAt(command_line.text, 1)
    if verb == "artifact" { return RendererArtifact(command_line.text) }
    if verb == "help" || verb == "--help" || verb == "-h" || verb == "" {
        return Usage()
    }
    preview: PreviewOptions
    if verb == "preview" {
        if ArgumentCount(command_line.text) == 3 &&
        (ArgumentAt(command_line.text, 2) == "--help" || ArgumentAt(command_line.text, 2) == "-h") {
            return PreviewUsage()
        }
        preview = ParsePreview(command_line.text)
        if preview.error != "" { return Error(preview.error) }
    }
    bundle_path := ArgumentAt(command_line.text, 2)
    if verb == "run" && bundle_path.count >= 3 &&
    bundle_path[bundle_path.count - 3:bundle_path.count] == ".zx" {
        if ArgumentCount(command_line.text) != 3 { return Error("usage: kryon run FILE.zx") }
        args: [3]string = .{"ziran", "run", bundle_path}
        return Execute(args[:])
    }
    if verb != "run" && verb != "build" && verb != "check" && verb != "install" &&
    verb != "profiles" && verb != "new" && verb != "init" && verb != "preview" {
        return Error("unknown command; see kryon --help")
    }
    options_path_bytes: [4096]u8
    options_path: string = Environment("ZIRAN_TOOL_OPTIONS", options_path_bytes[:])
    if options_path == "" { return FrontDoor(command_line.text, verb) }
    if verb == "new" || verb == "init" {
        return Error("kryon new and init start projects; run them outside ziran tool")
    }
    profile_name: string = ""
    option: string = ArgumentAt(command_line.text, 2)
    if verb == "preview" {
        profile_name = preview.profile
    } else if option == "--profile" {
        profile_name = ArgumentAt(command_line.text, 3)
        if profile_name == "" || ArgumentAt(command_line.text, 4) != "" {
            return Error("expected exactly one profile name")
        }
    } else if ProjectStarts(option, "--profile=") {
        profile_name = option[10:cast(s32)option.count]
        if profile_name == "" || ArgumentAt(command_line.text, 3) != "" {
            return Error("expected exactly one profile name")
        }
    } else if option != "" && option[0] != cast(u8)45 && verb != "profiles" {
        // kryon run desktop
        profile_name = option
        if ArgumentAt(command_line.text, 3) != "" {
            return Error("expected exactly one profile name")
        }
    } else if option != "" {
        return Error("unknown option")
    }

    name_env_bytes: [128]u8
    entry_env_bytes: [4096]u8
    options_bytes: [32768]u8
    file: FileContents = ReadFile(options_path, options_bytes[:])
    if !file.ok { return Error("cannot read the options ziran resolved") }
    config: ProjectConfig = ParseProject(file.text,
        Environment("ZIRAN_PROJECT_NAME", name_env_bytes[:]),
        Environment("ZIRAN_PROJECT_ENTRY", entry_env_bytes[:]))
    if !config.ok { return Error(config.error) }
    if verb == "profiles" { return ListProfiles(config) }
    installed_kryon_bytes: [4096]u8
    installed_ziran_bytes: [4096]u8
    package_id_bytes: [128]u8
    installed_kryon: string = Environment("ZIRAN_PACKAGE_ROOT", installed_kryon_bytes[:])
    installed_ziran: string = Environment("ZIRAN_TOOLCHAIN_ROOT", installed_ziran_bytes[:])
    package_id: string = Environment("ZIRAN_PACKAGE_ID", package_id_bytes[:])
    if installed_kryon == "" || installed_ziran == "" || package_id == "" {
        return Error("run this command through ziran tool kryon")
    }
    if profile_name == "" && verb == "install" {
        profile_name = config.install.profile
    }
    if profile_name == "" {
        if verb == "run" && config.profile_count > 1 && RawIsTty(0) != 0 {
            chosen_profile: s32 = ChooseProfile(config)
            if chosen_profile < 0 { return Error("invalid profile selection") }
            profile_name = config.profiles[chosen_profile].name
        } else {
            profile_name = config.default_profile
        }
    }
    if verb == "install" {
        prefix_bytes: [4096]u8
        bin_bytes: [128]u8
        if Environment("ZIRAN_INSTALL_PREFIX", prefix_bytes[:]) == "" {
            return Error("run this command through ziran install")
        }
        if !ProjectNameValid(Environment("ZIRAN_INSTALL_BIN", bin_bytes[:])) {
            return Error("invalid install bin name")
        }
        // The install rule reads these as shell variables, never as make
        // syntax, so desktop text cannot change the recipe.
        autostart: string = "false"
        if config.install.autostart { autostart = "true" }
        if !SetEnvironment("KRYON_INSTALL_NAME", config.install.name) ||
        !SetEnvironment("KRYON_INSTALL_COMMENT", config.install.comment) ||
        !SetEnvironment("KRYON_INSTALL_ICON", config.install.icon) ||
        !SetEnvironment("KRYON_INSTALL_ICON_NAME", config.install.icon_name) ||
        !SetEnvironment("KRYON_INSTALL_CATEGORIES", config.install.categories) ||
        !SetEnvironment("KRYON_INSTALL_DIRECTORY",
            config.install.working_directory) ||
        !SetEnvironment("KRYON_INSTALL_AUTOSTART", autostart) ||
        !SetEnvironment("KRYON_INSTALL_AUTOSTART_ENV",
            config.install.autostart_env) {
            return Error("cannot pass install options")
        }
    }
    profile: ProjectProfile = ProjectProfileNamed(config, profile_name)
    if profile.name == "" { return Error("unknown profile; use kryon profiles") }
    fixture_path: [128]u8
    if verb == "preview" {
        if profile.backend != "desktop" || profile.codegen != "c99" {
            return Error("preview requires a desktop C99 profile; select one with --profile NAME")
        }
        name: [128]u8
        config.entry = Join(Join("previews/", preview.fixture, name[:]), ".zi", fixture_path[:])
        if !Exists(config.entry) {
            PrintFd(2, "kryon: fixture not found: ")
            PrintFd(2, config.entry)
            PrintFd(2, "\n")
            return 2
        }
        // A preview uses the standard frame host even if the app owns its window.
        profile.host = ""
    }
    if profile.backend == "android" {
        if verb == "install" {
            return Error("android profiles ship as packages; use kryon build --profile android")
        }
        if profile.codegen != "c99" && profile.codegen != "zx" {
            return Error("android supports c99 and zx code generation")
        }
        return AndroidCommand(config, profile, installed_kryon, installed_ziran, verb)
    }
    if (profile.backend != "terminal" && profile.backend != "desktop" &&
        profile.backend != "canvas" && profile.backend != "dom" &&
        profile.backend != "pixmap") ||
    (profile.codegen != "c99" &&
        !(profile.codegen == "zx" &&
        (profile.backend == "desktop" || profile.backend == "pixmap" ||
        profile.backend == "canvas"))) {
        return Error("this backend/codegen pair is not available yet")
    }
    // Hosts name the program's window, page and menu entry after this.
    program_title: string = config.install.name
    if program_title == "" { program_title = config.name }
    if !SetEnvironment("KRYON_PROGRAM_TITLE", program_title) {
        return Error("cannot pass the program title")
    }
    makefile_bytes: [4096]u8
    makefile: string = Join(installed_kryon,
        "/mk/ziran-project.mk", makefile_bytes[:])
    if makefile == "" || !Exists(makefile) { return Error("Kryon build rules not found") }
    ziran_tool_bytes: [4096]u8
    ziran_tool: string = Join(installed_ziran,
        "/Makefile", ziran_tool_bytes[:])
    if ziran_tool == "" || !Exists(ziran_tool) {
        return Error("Ziran checkout not found")
    }
    if !Exists(config.entry) { return Error("project entry not found") }
    if profile.host != "" && !Exists(profile.host) {
        return Error("profile host not found")
    }

    name_bytes: [4096]u8
    entry_bytes: [4096]u8
    backend_bytes: [4096]u8
    codegen_bytes: [4096]u8
    selected_bytes: [4096]u8
    kryon_bytes: [4096]u8
    ziran_bytes: [4096]u8
    links_bytes: [4096]u8
    links_env_bytes: [4096]u8
    library_bytes: [4096]u8
    static_archive_bytes: [4096]u8
    native_artifacts_bytes: [4096]u8
    native_platform_bytes: [4096]u8
    host_bytes: [4096]u8
    assets_bytes: [4096]u8
    platform_bytes: [4096]u8
    preload_bytes: [4096]u8
    args: [24]string
    args[0] = "make"
    args[1] = "--silent"
    args[2] = "--no-print-directory"
    args[3] = "-f"
    args[4] = makefile
    args[5] = verb
    args[6] = Join("PROJECT_NAME=", config.name, name_bytes[:])
    args[7] = Join("PROJECT_ENTRY=", config.entry, entry_bytes[:])
    args[8] = Join("PROJECT_BACKEND=", profile.backend, backend_bytes[:])
    args[9] = Join("PROJECT_CODEGEN=", profile.codegen, codegen_bytes[:])
    args[10] = Join("PROJECT_PROFILE=", profile.name, selected_bytes[:])
    args[11] = Join("KRYON_DIR=", installed_kryon, kryon_bytes[:])
    args[12] = Join("ZIRAN_DIR=", installed_ziran, ziran_bytes[:])
    args[13] = Join("PROJECT_LIBRARY=", profile.library, library_bytes[:])
    args[14] = Join("PROJECT_STATIC_ARCHIVE=", profile.static_archive,
        static_archive_bytes[:])
    args[15] = Join("PROJECT_HOST=", profile.host, host_bytes[:])
    args[16] = Join("PROJECT_ASSETS=", profile.assets, assets_bytes[:])
    args[17] = Join("PROJECT_NATIVE_ARTIFACTS=", profile.native_artifacts, native_artifacts_bytes[:])
    args[18] = Join("PROJECT_NATIVE_PLATFORM=", profile.native_platform, native_platform_bytes[:])
    args[19] = Join("PROJECT_PLATFORM=", profile.platform, platform_bytes[:])
    args[20] = Join("PROJECT_PRELOAD=", profile.preload, preload_bytes[:])
    args[21] = Join("PROJECT_LINKS=",
        Environment("ZIRAN_PROJECT_LINKS", links_env_bytes[:]), links_bytes[:])
    at: s32 = 6
    while at < 22 {
        if args[at] == "" { return Error("project path or value is too long") }
        at += 1
    }
    if verb == "preview" { return PreviewRun(preview, profile, args[:]) }
    return Execute(args[0:22])
}

// The package driver owns staging, hashing and publication. This command only
// runs Kryon's foreign-library build recipe; Ziran modules remain imports.
RendererArtifact :: (command_line: string) -> s32 {
    if ArgumentCount(command_line) != 7 ||
    ArgumentAt(command_line, 3) != "--platform" ||
    ArgumentAt(command_line, 5) != "--output" {
        return Error("usage: artifact NAME --platform OS-ARCH-ABI --output STAGE")
    }
    root_bytes: [4096]u8
    script_bytes: [4096]u8
    root := Environment("ZIRAN_PACKAGE_ROOT", root_bytes[:])
    if root == "" { return Error("artifact requires the package driver") }
    args: [8]string = .["python3", Join(root, "/scripts/renderer_artifact.py", script_bytes[:]),
        ArgumentAt(command_line, 2), "--platform", ArgumentAt(command_line, 4),
        "--output", ArgumentAt(command_line, 6), root]
    return Execute(args[:])
}
