#module "transition_host"
#import "ui_internal.h"
#import "ui_transition.h"
#import "runtime/transition_fade.h"

ResetTransition :: (transition: *TransitionState) #export {
    if transition == nil { return }
    transition->active = 0
    transition->phase = TransitionNone
    transition->elapsed_seconds = 0.0
    transition->duration_seconds = 0.0
}

BeginTransition :: (transition: *TransitionState,
duration_seconds: float) #export {
    if transition == nil { return }
    transition->active = 1
    transition->phase = TransitionOut
    transition->elapsed_seconds = 0.0
    transition->duration_seconds = TransitionDuration(duration_seconds)
}

ReverseTransitionToOut :: (transition: *TransitionState) #export {
    if transition == nil || !transition->active { return }
    if transition->phase == TransitionIn {
        transition->phase = TransitionOut
        transition->elapsed_seconds = TransitionReverseElapsed(
        transition->duration_seconds, transition->elapsed_seconds)
    }
}

GetTransitionAlpha :: (transition: const TransitionState*) -> float #export {
    if transition == nil { return 0.0 }
    return TransitionAlpha(transition->active != 0, transition->phase,
    transition->elapsed_seconds, transition->duration_seconds)
}

StepTransition :: (transition: *TransitionState,
delta_seconds: float) -> TransitionPhase #export {
    if transition == nil || !transition->active { return TransitionNone }
    transition->elapsed_seconds += TransitionDelta(delta_seconds)
    if transition->elapsed_seconds < transition->duration_seconds {
        return TransitionNone
    }
    if transition->phase == TransitionOut {
        transition->phase = TransitionIn
        transition->elapsed_seconds = 0.0
        return TransitionOut
    }
    ResetTransition(transition)
    return TransitionIn
}

RenderTransitionFade :: (transition: const TransitionState*,
width: i32, height: i32, color: Color) #export {
    if transition == nil || !transition->active { return }
    alpha: i32 = TransitionFadeAlphaByte(transition->active != 0,
    transition->phase, transition->elapsed_seconds,
    transition->duration_seconds)
    if alpha <= 0 { return }
    color.a = (unsigned char)TransitionApplyAlpha((int)color.a, alpha)
    if color.a == 0 { return }
    DrawRectangle(0, 0, width, height, color)
}
