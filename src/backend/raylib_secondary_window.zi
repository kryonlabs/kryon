// Secondary windows for a raylib application on SDL, such as a floating
// timer or a reminder over other windows. Each one is an SDL window owned by
// this process: Kryon draws its tree into a raylib render texture, and the
// pixels are copied to the window's surface, so the main window's OpenGL
// context stays current. Only handles created here are accepted; a window
// found on the display is never touched. Up to three are open at a time.
//
// flags are NativeWindowFlags from window_flags: borderless, always on top,
// skip the taskbar, place from the top right, or center. Resizable gives a
// 160x196 minimum, and a left click then reports on release instead of
// dragging the window. Sticky is not applied here.
//
// Each window keeps its own pointer. SecondaryWindowInput gives it to the
// window's session before BeginSecondaryFrame, so buttons, sliders and menus
// drawn there answer that window's pointer, never the main window's.
#import "c_string"
#import "drawing_props"
#import "geometry"
#import "input_protocol"
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"

SecondaryWindow :: struct {
    handle: *void
}

#program_export
OpenSecondaryWindow :: (title: string, x: s32, y: s32, width: s32,
    height: s32, flags: s32, background: Color,
    scale: float32) -> SecondaryWindow {
    window: SecondaryWindow
    title_bytes: [128]u8
    if !CopyCString(title, title_bytes[:]) {
        return window
    }
    window.handle = SecondaryWindowOpenHost(*title_bytes[0], x, y, width,
        height, flags, background.r, background.g, background.b,
        background.a, scale)
    return window
}

#program_export
CloseSecondaryWindow :: (window: SecondaryWindow) {
    if window.handle != null {
        SecondaryWindowCloseHost(window.handle)
    }
}

#program_export
BeginSecondaryWindow :: (window: SecondaryWindow) -> bool {
    if window.handle == null {
        return false
    }
    return SecondaryWindowBeginHost(window.handle)
}

#program_export
EndSecondaryWindow :: (window: SecondaryWindow) -> bool {
    if window.handle == null {
        return false
    }
    return SecondaryWindowEndHost(window.handle)
}

#program_export
PumpSecondaryWindows :: () {
    SecondaryWindowPumpHost()
}

#program_export
IsSecondaryWindowClicked :: (window: SecondaryWindow) -> bool {
    return window.handle != null && SecondaryWindowClickedHost(window.handle)
}

#program_export
IsSecondaryWindowRightClicked :: (window: SecondaryWindow) -> bool {
    return window.handle != null && SecondaryWindowRightClickedHost(window.handle)
}

#program_export
IsSecondaryWindowDragged :: (window: SecondaryWindow) -> bool {
    return window.handle != null && SecondaryWindowDraggedHost(window.handle)
}

TakeSecondaryWindowClose :: (window: SecondaryWindow) -> bool {
    return window.handle != null && SecondaryWindowTakeCloseHost(window.handle)
}

GetSecondaryWindowSize :: (window: SecondaryWindow, width: *s32, height: *s32) {
    SecondaryWindowSizeHost(window.handle, width, height)
}

#program_export
SetSecondaryWindowKeyboardGrab :: (window: SecondaryWindow,
    enabled: bool) -> bool {
    return window.handle != null &&
    SecondaryWindowKeyboardGrabHost(window.handle, enabled)
}

#program_export
GetSecondaryWindowPosition :: (window: SecondaryWindow, x: *s32, y: *s32) {
    SecondaryWindowPositionHost(window.handle, x, y)
}

#program_export
GetSecondaryWindowClickPosition :: (window: SecondaryWindow,
    x: *s32, y: *s32) {
    SecondaryWindowClickPositionHost(window.handle, x, y)
}

// Gives the session this window's pointer for its next frame, in window
// pixels: position, left button and wheel. Outside the window the pointer
// is at -1, -1, so nothing in the window stays hovered.
#program_export
SecondaryWindowInput :: (window: SecondaryWindow, session: Session) -> bool {
    if window.handle == null {
        return false
    }
    pointer: PointerFrame
    wheel: float32
    if !SecondaryWindowPointerHost(window.handle, *pointer, *wheel) {
        return false
    }
    unused TreePointerUpdate(session, pointer)
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    return true
}

#program_export
BeginSecondaryFrame :: (session: Session, width: s32, height: s32) -> bool {
    bounds := Rectangle.{0.0, 0.0, cast(float32)width, cast(float32)height}
    return cast(s32)BeginFrame(session, cast(u64)1, bounds) == 0
}

#program_export
EndSecondaryFrame :: (session: Session) {
    unused EndFrame(session)
}

#program_export
CloseSecondarySession :: (session: Session) {
    if SessionValid(session) {
        unused CloseSession(session)
    }
}

SECONDARY_SDL :: #defined(NATIVE_WINDOW_HAVE_SDL) && !#defined(PLATFORM_WEB) && !#defined(ANDROID_BUILD)

SecondaryColor :: struct {
    r: u8
    g: u8
    b: u8
    a: u8
}

SecondaryTexture :: struct {
    id: u32
    width: s32
    height: s32
    mipmaps: s32
    format: s32
}

SecondaryTarget :: struct {
    id: u32
    texture: SecondaryTexture
    depth: SecondaryTexture
}

SecondaryImage :: struct {
    data: *void
    width: s32
    height: s32
    mipmaps: s32
    format: s32
}

SecondaryWindowState :: struct {
    window: *void
    window_id: u32
    target: SecondaryTarget
    background: SecondaryColor
    width: s32
    height: s32
    x: s32
    y: s32
    click_x: s32
    click_y: s32
    drag_anchor_x: s32
    drag_anchor_y: s32
    drag_motion_x: s32
    drag_motion_y: s32
    drag_total_x: s32
    drag_total_y: s32
    drag_active: bool
    drag_pending: bool
    release_seen: bool
    dragged: bool
    clicked: bool
    right_clicked: bool
    close_requested: bool
    resizable: bool
    pointer_x: s32
    pointer_y: s32
    pointer_inside: bool
    pointer_down: bool
    pointer_pressed: bool
    pointer_released: bool
    wheel: float32
}

SecondaryWindowSlot :: struct {
    state: *SecondaryWindowState
}

SecondaryArea :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
}

SecondaryEventHeader :: struct {
    event_type: u32
    timestamp: u32
    window_id: u32
}

SecondaryButtonEvent :: struct {
    event_type: u32
    timestamp: u32
    window_id: u32
    device: u32
    button: u8
    state: u8
    clicks: u8
    padding: u8
    x: s32
    y: s32
}

SecondaryMotionEvent :: struct {
    event_type: u32
    timestamp: u32
    window_id: u32
    device: u32
    state: u32
    x: s32
    y: s32
    relative_x: s32
    relative_y: s32
}

SecondaryWheelEvent :: struct {
    event_type: u32
    timestamp: u32
    window_id: u32
    device: u32
    x: s32
    y: s32
    direction: u32
}

secondary_windows: [3]SecondaryWindowSlot;
secondary_window_count: s32;
secondary_watching_events: bool;
secondary_active_window: *SecondaryWindowState;
secondary_render_window: *void;
secondary_render_context: *void;

#if SECONDARY_SDL {
    secondary_c :: #system_library "c";
    secondary_sdl :: #system_library "SDL2";
    secondary_raylib :: #system_library "raylib";
    SecondaryEventWatch :: #type (*void, *void) -> s32 #c_call;
    secondary_previous_filter: SecondaryEventWatch;
    secondary_previous_filter_argument: *void;
    SecondaryAllocate :: (count: usize, size: usize) -> *void #foreign secondary_c "calloc";
    SecondaryFree :: (value: *void) #foreign secondary_c "free";
    SecondaryWindowReady :: () -> bool #foreign secondary_raylib "IsWindowReady";
    SecondaryLoadTarget :: (width: s32, height: s32) -> SecondaryTarget #foreign secondary_raylib "LoadRenderTexture";
    SecondaryUnloadTarget :: (target: SecondaryTarget) #foreign secondary_raylib "UnloadRenderTexture";
    SecondaryBeginTarget :: (target: SecondaryTarget) #foreign secondary_raylib "BeginTextureMode";
    SecondaryEndTarget :: () #foreign secondary_raylib "EndTextureMode";
    SecondaryClear :: (background: SecondaryColor) #foreign secondary_raylib "ClearBackground";
    SecondaryReadTexture :: (texture: SecondaryTexture) -> SecondaryImage #foreign secondary_raylib "LoadImageFromTexture";
    SecondaryImageFormat :: (image: *SecondaryImage, format: s32) #foreign secondary_raylib "ImageFormat";
    SecondaryFlipImage :: (image: *SecondaryImage) #foreign secondary_raylib "ImageFlipVertical";
    SecondaryUnloadImage :: (image: SecondaryImage) #foreign secondary_raylib "UnloadImage";
    SecondarySDLInitialized :: (flags: u32) -> u32 #foreign secondary_sdl "SDL_WasInit";
    SecondarySetHint :: (name: *u8, value: *u8) -> s32 #foreign secondary_sdl "SDL_SetHint";
    SecondaryCurrentWindow :: () -> *void #foreign secondary_sdl "SDL_GL_GetCurrentWindow";
    SecondaryCurrentContext :: () -> *void #foreign secondary_sdl "SDL_GL_GetCurrentContext";
    SecondaryMakeCurrent :: (window: *void, context: *void) -> s32 #foreign secondary_sdl "SDL_GL_MakeCurrent";
    SecondaryDisplayBounds :: (display: s32, area: *SecondaryArea) -> s32 #foreign secondary_sdl "SDL_GetDisplayUsableBounds";
    SecondaryCreateWindow :: (title: *u8, x: s32, y: s32, width: s32,
        height: s32, flags: u32) -> *void #foreign secondary_sdl "SDL_CreateWindow";
    SecondaryDestroyWindow :: (window: *void) #foreign secondary_sdl "SDL_DestroyWindow";
    SecondaryShowWindow :: (window: *void) #foreign secondary_sdl "SDL_ShowWindow";
    SecondaryWindowId :: (window: *void) -> u32 #foreign secondary_sdl "SDL_GetWindowID";
    SecondaryGetPosition :: (window: *void, x: *s32, y: *s32) #foreign secondary_sdl "SDL_GetWindowPosition";
    SecondaryGetSize :: (window: *void, width: *s32, height: *s32) #foreign secondary_sdl "SDL_GetWindowSize";
    SecondaryMinimumSize :: (window: *void, width: s32, height: s32) #foreign secondary_sdl "SDL_SetWindowMinimumSize";
    SecondarySetPosition :: (window: *void, x: s32, y: s32) #foreign secondary_sdl "SDL_SetWindowPosition";
    SecondaryGetFilter :: (filter: *SecondaryEventWatch, argument: **void) -> s32 #foreign secondary_sdl "SDL_GetEventFilter";
    SecondarySetFilter :: (filter: SecondaryEventWatch, argument: *void) #foreign secondary_sdl "SDL_SetEventFilter";
    SecondaryFilterQueued :: (filter: SecondaryEventWatch, argument: *void) #foreign secondary_sdl "SDL_FilterEvents";
    SecondaryWindowSurface :: (window: *void) -> *void #foreign secondary_sdl "SDL_GetWindowSurface";
    SecondaryImageSurface :: (pixels: *void, width: s32, height: s32,
        depth: s32, pitch: s32, format: u32) -> *void #foreign secondary_sdl "SDL_CreateRGBSurfaceWithFormatFrom";
    SecondaryFreeSurface :: (surface: *void) #foreign secondary_sdl "SDL_FreeSurface";
    SecondaryBlitSurface :: (source: *void, source_area: *void,
        destination: *void, destination_area: *void) -> s32 #foreign secondary_sdl "SDL_UpperBlitScaled";
    SecondaryUpdateSurface :: (window: *void) -> s32 #foreign secondary_sdl "SDL_UpdateWindowSurface";
    SecondaryGetKeyboardGrab :: (window: *void) -> s32 #foreign secondary_sdl "SDL_GetWindowKeyboardGrab";
    SecondarySetKeyboardGrab :: (window: *void, enabled: s32) #foreign secondary_sdl "SDL_SetWindowKeyboardGrab";

    RestoreSecondaryRenderContext :: () {
        if secondary_render_window != null && secondary_render_context != null &&
        (SecondaryCurrentWindow() != secondary_render_window ||
            SecondaryCurrentContext() != secondary_render_context) {
            unused SecondaryMakeCurrent(secondary_render_window, secondary_render_context)
        }
    }

    SecondaryObserveEvent :: (argument: *void, event_data: *void) -> s32 {
        unused argument
        if event_data == null {
            return 1
        }
        event := cast(*SecondaryEventHeader)event_data
        if event.event_type != 0x200 &&
        (event.event_type < 0x300 || event.event_type > 0x303) &&
        (event.event_type < 0x400 || event.event_type > 0x403) {
            return 1
        }
        window := SecondaryWindowForId(event.window_id)
        if window == null {
            return 1
        }
        // SDL_WINDOWEVENT_CLOSE belongs only to the registered window.
        if event.event_type == 0x200 {
            bytes := cast(*u8)event_data
            if bytes[12] == cast(u8)14 {
                window.close_requested = true
            }
            // SDL_WINDOWEVENT_ENTER and LEAVE.
            if bytes[12] == cast(u8)10 {
                window.pointer_inside = true
            }
            if bytes[12] == cast(u8)11 {
                window.pointer_inside = false
            }
            return 0
        }
        if event.event_type == 0x403 {
            wheel := cast(*SecondaryWheelEvent)event_data
            steps := cast(float32)wheel.y
            // SDL_MOUSEWHEEL_FLIPPED reports natural scrolling inverted.
            if wheel.direction == cast(u32)1 {
                steps = -steps
            }
            window.wheel += steps
            return 0
        }
        if event.event_type == 0x400 {
            motion := cast(*SecondaryMotionEvent)event_data
            window.pointer_x = motion.x
            window.pointer_y = motion.y
            window.pointer_inside = true
        }
        if event.event_type == 0x401 {
            button := cast(*SecondaryButtonEvent)event_data
            if button.button == cast(u8)1 {
                window.pointer_x = button.x
                window.pointer_y = button.y
                window.pointer_inside = true
                window.pointer_down = true
                window.pointer_pressed = true
                window.drag_active = !window.resizable
                window.release_seen = false
                window.dragged = false
                window.clicked = false
                window.drag_pending = false
                window.drag_total_x = 0
                window.drag_total_y = 0
                window.drag_anchor_x = button.x
                window.drag_anchor_y = button.y
            }
            return 0
        }
        if event.event_type == 0x400 && window.drag_active {
            motion := cast(*SecondaryMotionEvent)event_data
            if (motion.state & cast(u32)1) != 0 {
                window.drag_motion_x = motion.x
                window.drag_motion_y = motion.y
                window.drag_pending = true
                return 0
            }
            window.release_seen = true
            return 0
        }
        if event.event_type == 0x402 {
            button := cast(*SecondaryButtonEvent)event_data
            window.click_x = button.x
            window.click_y = button.y
            if button.button == cast(u8)3 {
                window.right_clicked = true
            }
            if button.button == cast(u8)1 {
                window.pointer_x = button.x
                window.pointer_y = button.y
                window.pointer_down = false
                window.pointer_released = true
                if window.resizable {
                    window.clicked = true
                } else {
                    window.release_seen = true
                }
            }
        }
        return 0
    }

    SecondaryFilterEvent :: (argument: *void, event_data: *void) -> s32 {
        if SecondaryObserveEvent(argument, event_data) == 0 {
            return 0
        }
        if secondary_previous_filter != null {
            return secondary_previous_filter(secondary_previous_filter_argument, event_data)
        }
        return 1
    }

    ForgetSecondaryWindow :: (window: *SecondaryWindowState) {
        index: s32 = 0
        while index < secondary_window_count {
            if secondary_windows[index].state == window {
                offset := index
                while offset < secondary_window_count - 1 {
                    secondary_windows[offset].state = secondary_windows[offset + 1].state
                    offset += 1
                }
                secondary_window_count -= 1
                secondary_windows[secondary_window_count].state = null
                break
            }
            index += 1
        }
        if secondary_window_count == 0 && secondary_watching_events {
            filter: SecondaryEventWatch = SecondaryFilterEvent
            installed: SecondaryEventWatch = SecondaryObserveEvent
            argument: *void
            unused SecondaryGetFilter(*installed, *argument)
            if installed == filter {
                SecondarySetFilter(secondary_previous_filter, secondary_previous_filter_argument)
            }
            secondary_watching_events = false
        }
    }
}

OwnedSecondaryWindow :: (handle: *void) -> *SecondaryWindowState {
    index: s32 = 0
    while index < secondary_window_count {
        window := secondary_windows[index].state
        if cast(*void)window == handle {
            return window
        }
        index += 1
    }
    return null
}

SecondaryWindowForId :: (id: u32) -> *SecondaryWindowState {
    if id == 0 {
        return null
    }
    index: s32 = 0
    while index < secondary_window_count {
        window := secondary_windows[index].state
        if window.window_id == id {
            return window
        }
        index += 1
    }
    return null
}

SecondaryRGBAFormat :: () -> u32 {
    // SDL_RGBA32 names byte order; SDL's packed enum names integer order.
    native_word: u32 = 1
    native_bytes := cast(*u8)(*native_word)
    if native_bytes[0] == cast(u8)1 {
        return 0x16762004
    }
    return 0x16462004
}

#program_export
SecondaryWindowOpenHost :: (title: *u8, x: s32, y: s32, width: s32,
    height: s32, flags: s32, red: u8, green: u8, blue: u8,
    alpha: u8, scale: float32) -> *void {
    unused scale
    #if SECONDARY_SDL {
        if !SecondaryWindowReady() || SecondarySDLInitialized(cast(u32)32) == 0 ||
        title == null || width <= 0 || height <= 0 || secondary_window_count >= 3 {
            return null
        }
        window_flags: u32 = 8
        if (flags & 1) != 0 {
            window_flags |= cast(u32)16
        }
        if (flags & 2) != 0 {
            window_flags |= cast(u32)32768
        }
        if (flags & 4) != 0 {
            window_flags |= cast(u32)65536
        }
        if (flags & 64) != 0 {
            window_flags |= cast(u32)32
        }
        if (flags & 24) != 0 {
            area: SecondaryArea
            if SecondaryDisplayBounds(0, *area) == 0 {
                if (flags & 16) != 0 {
                    x = area.x + (area.width - width) / 2
                    y = area.y + (area.height - height) / 2
                }
                if (flags & 16) == 0 {
                    x = area.x + area.width - width - x
                    y = area.y + y
                }
            }
        }
        window := cast(*SecondaryWindowState)SecondaryAllocate(cast(usize)1,
            size_of(SecondaryWindowState))
        if window == null {
            return null
        }
        if secondary_window_count == 0 {
            // SDL's accelerated window surface can create a second GL context
            // and invalidate the main renderer's framebuffer state.
            hint: [64]u8
            value: [2]u8 = .[48, 0]
            if CopyCString("SDL_FRAMEBUFFER_ACCELERATION", hint[:]) {
                unused SecondarySetHint(*hint[0], *value[0])
            }
            secondary_render_window = SecondaryCurrentWindow()
            secondary_render_context = SecondaryCurrentContext()
            if secondary_render_window == null || secondary_render_context == null {
                SecondaryFree(cast(*void)window)
                return null
            }
        }
        RestoreSecondaryRenderContext()
        window.target = SecondaryLoadTarget(width, height)
        if window.target.id == 0 {
            SecondaryFree(cast(*void)window)
            return null
        }
        window.window = SecondaryCreateWindow(title, x, y, width, height, window_flags)
        if window.window == null || SecondaryWindowSurface(window.window) == null {
            if window.window != null {
                SecondaryDestroyWindow(window.window)
            }
            RestoreSecondaryRenderContext()
            SecondaryUnloadTarget(window.target)
            SecondaryFree(cast(*void)window)
            return null
        }
        window.window_id = SecondaryWindowId(window.window)
        window.width = width
        window.height = height
        window.resizable = (flags & 64) != 0
        if window.resizable {
            SecondaryMinimumSize(window.window, 160, 196)
        }
        window.background = SecondaryColor.{red, green, blue, alpha}
        SecondaryGetPosition(window.window, *window.x, *window.y)
        secondary_windows[secondary_window_count].state = window
        secondary_window_count += 1
        if !secondary_watching_events {
            unused SecondaryGetFilter(*secondary_previous_filter, *secondary_previous_filter_argument)
            filter: SecondaryEventWatch = SecondaryFilterEvent
            SecondarySetFilter(filter, null)
            secondary_watching_events = true
        }
        filter_queued: SecondaryEventWatch = SecondaryObserveEvent
        SecondaryFilterQueued(filter_queued, null)
        SecondaryShowWindow(window.window)
        RestoreSecondaryRenderContext()
        return cast(*void)window
    }
    unused title
    unused x
    unused y
    unused width
    unused height
    unused flags
    unused red
    unused green
    unused blue
    unused alpha
    return null
}

#program_export
SecondaryWindowCloseHost :: (handle: *void) {
    #if SECONDARY_SDL {
        window := OwnedSecondaryWindow(handle)
        if window == null {
            return
        }
        if secondary_active_window == window {
            SecondaryEndTarget()
            secondary_active_window = null
        }
        // Destruction emits SDL window events too. Keep this ID registered
        // until they have been filtered, so they cannot hide the main window.
        SecondaryDestroyWindow(window.window)
        RestoreSecondaryRenderContext()
        SecondaryUnloadTarget(window.target)
        ForgetSecondaryWindow(window)
        SecondaryFree(cast(*void)window)
        if secondary_window_count == 0 {
            secondary_render_window = null
            secondary_render_context = null
        }
    }
    unused handle
}

#program_export
SecondaryWindowBeginHost :: (handle: *void) -> bool {
    #if SECONDARY_SDL {
        window := OwnedSecondaryWindow(handle)
        if window == null || secondary_active_window != null {
            return false
        }
        RestoreSecondaryRenderContext()
        width: s32
        height: s32
        SecondaryGetSize(window.window, *width, *height)
        if width > 0 && height > 0 &&
        (width != window.width || height != window.height) {
            target := SecondaryLoadTarget(width, height)
            if target.id == 0 {
                return false
            }
            SecondaryUnloadTarget(window.target)
            window.target = target
            window.width = width
            window.height = height
        }
        secondary_active_window = window
        SecondaryBeginTarget(window.target)
        SecondaryClear(window.background)
        return true
    }
    unused handle
    return false
}

#program_export
SecondaryWindowEndHost :: (handle: *void) -> bool {
    #if SECONDARY_SDL {
        window := OwnedSecondaryWindow(handle)
        if window == null || secondary_active_window != window {
            return false
        }
        RestoreSecondaryRenderContext()
        SecondaryEndTarget()
        secondary_active_window = null
        image := SecondaryReadTexture(window.target.texture)
        if image.data == null {
            return false
        }
        SecondaryImageFormat(*image, 7)
        SecondaryFlipImage(*image)
        source := SecondaryImageSurface(image.data, image.width,
            image.height, 32, image.width * 4, SecondaryRGBAFormat())
        surface := SecondaryWindowSurface(window.window)
        if source == null || surface == null {
            if source != null {
                SecondaryFreeSurface(source)
            }
            SecondaryUnloadImage(image)
            RestoreSecondaryRenderContext()
            return false
        }
        blit_status := SecondaryBlitSurface(source, null, surface, null)
        SecondaryFreeSurface(source)
        SecondaryUnloadImage(image)
        update_status: s32 = -1
        if blit_status == 0 {
            update_status = SecondaryUpdateSurface(window.window)
        }
        RestoreSecondaryRenderContext()
        return blit_status == 0 && update_status == 0
    }
    unused handle
    return false
}

#program_export
SecondaryWindowPumpHost :: () {
    #if SECONDARY_SDL {
        index: s32 = 0
        while index < secondary_window_count {
            window := secondary_windows[index].state
            index += 1
            if !window.drag_active {
                continue
            }
            if window.drag_pending {
                dx := window.drag_motion_x - window.drag_anchor_x
                dy := window.drag_motion_y - window.drag_anchor_y
                window.drag_pending = false
                SecondaryGetPosition(window.window, *window.x, *window.y)
                if dx != 0 || dy != 0 {
                    window.x += dx
                    window.y += dy
                    window.drag_total_x += dx
                    window.drag_total_y += dy
                    SecondarySetPosition(window.window, window.x, window.y)
                    if window.drag_total_x > 2 || window.drag_total_x < -2 ||
                    window.drag_total_y > 2 || window.drag_total_y < -2 {
                        window.dragged = true
                    }
                }
            }
            if window.release_seen {
                window.drag_active = false
                window.release_seen = false
                if !window.dragged {
                    window.clicked = true
                }
            }
        }
    }
}

#program_export
SecondaryWindowClickedHost :: (handle: *void) -> bool {
    window := OwnedSecondaryWindow(handle)
    if window == null || !window.clicked {
        return false
    }
    window.clicked = false
    return true
}

#program_export
SecondaryWindowTakeCloseHost :: (handle: *void) -> bool {
    window := OwnedSecondaryWindow(handle)
    if window == null || !window.close_requested {
        return false
    }
    window.close_requested = false
    return true
}

#program_export
SecondaryWindowSizeHost :: (handle: *void, width: *s32, height: *s32) {
    window := OwnedSecondaryWindow(handle)
    if width != null {
        width[0] = ifx window != null then window.width else 0
    }
    if height != null {
        height[0] = ifx window != null then window.height else 0
    }
}

#program_export
SecondaryWindowRightClickedHost :: (handle: *void) -> bool {
    window := OwnedSecondaryWindow(handle)
    if window == null || !window.right_clicked {
        return false
    }
    window.right_clicked = false
    return true
}

#program_export
SecondaryWindowDraggedHost :: (handle: *void) -> bool {
    window := OwnedSecondaryWindow(handle)
    if window == null || !window.dragged {
        return false
    }
    window.dragged = false
    window.clicked = false
    return true
}

#program_export
SecondaryWindowKeyboardGrabHost :: (handle: *void, enabled: bool) -> bool {
    #if SECONDARY_SDL {
        window := OwnedSecondaryWindow(handle)
        if window == null {
            return false
        }
        desired: s32 = ifx (enabled) then (1) else (0)
        if SecondaryGetKeyboardGrab(window.window) == desired {
            return true
        }
        SecondarySetKeyboardGrab(window.window, desired)
        return SecondaryGetKeyboardGrab(window.window) == desired
    }
    unused handle
    unused enabled
    return false
}

#program_export
SecondaryWindowPositionHost :: (handle: *void, x: *s32, y: *s32) {
    window := OwnedSecondaryWindow(handle)
    if x != null {
        x[0] = ifx (window != null) then (window.x) else (0)
    }
    if y != null {
        y[0] = ifx (window != null) then (window.y) else (0)
    }
}

// This window's pointer since the last call: a press or release is reported
// once, and the wheel steps collected since then are taken.
#program_export
SecondaryWindowPointerHost :: (handle: *void, frame: *PointerFrame,
    wheel: *float32) -> bool {
    window := OwnedSecondaryWindow(handle)
    if window == null || frame == null || wheel == null {
        return false
    }
    frame.x = -1.0
    frame.y = -1.0
    // A held button keeps reporting where it is, so a drag that leaves the
    // window still ends where it was released.
    if window.pointer_inside || window.pointer_down || window.pointer_released {
        frame.x = cast(float32)window.pointer_x
        frame.y = cast(float32)window.pointer_y
    }
    frame.down = window.pointer_down
    frame.pressed = window.pointer_pressed
    frame.released = window.pointer_released
    wheel[0] = window.wheel
    window.pointer_pressed = false
    window.pointer_released = false
    window.wheel = 0.0
    return true
}

#program_export
SecondaryWindowClickPositionHost :: (handle: *void, x: *s32, y: *s32) {
    window := OwnedSecondaryWindow(handle)
    if x != null {
        x[0] = ifx (window != null) then (window.click_x) else (-1)
    }
    if y != null {
        y[0] = ifx (window != null) then (window.click_y) else (-1)
    }
}
