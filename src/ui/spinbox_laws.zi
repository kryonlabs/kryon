#import "spinbox"

// Laws for a spinbox's value. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

// Within a range the value is clamped into it, and a value already inside
// is kept.
#law ClampStaysInRange forall value: -4..4, low: -2..2, high: -2..2 => low > high || (SpinboxClampValue(value, low, high) >= low && SpinboxClampValue(value, low, high) <= high);
#law InsideKept forall value: -2..2, low: -2..2, high: -2..2 => value < low || value > high || SpinboxClampValue(value, low, high) == value;
#law BelowTakesMinimum forall value: -4..-3, low: -2..2, high: -2..2 => low > high || SpinboxClampValue(value, low, high) == low;
#law AboveTakesMaximum forall value: 3..4, low: -2..2, high: -2..2 => low > high || SpinboxClampValue(value, low, high) == high;

// An inverted range, minimum above maximum, leaves the value alone.
#law InvertedRangeKeeps forall value: -4..4, low: -2..2, high: -2..2 => low <= high || SpinboxClampValue(value, low, high) == value;
