#import "kryon.h"

ANSWER :: #run 6 * 7
#assert ANSWER == 42, "spec #run assertion failed"
#assert 1 + 1 == 2, "spec arithmetic assertion failed"

state {
    count: int = 0
}

app "Spec Contract" {
    size 320 240
    fps 60
}

# Fixed-capacity array fields and borrowed string byte access are portable
# strict expressions: every backend must lower them identically.

ContractBytes :: struct {
    data: [4]u32
    filled: i32
}

ContractSumBytes :: (text: string) -> i32 #export {
    total: i32 = 0
    index: i32 = 0
    while index < text.length {
        total = total + (i32)text[index]
        index = index + 1
    }
    return total
}

ContractFillBytes :: (bytes: ContractBytes, seed: u32) -> ContractBytes #export {
    index: i32 = 0
    while index < 4 {
        bytes.data[index] = seed + (u32)index
        index = index + 1
    }
    bytes.filled = 4
    return bytes
}

ContractByteAt :: (bytes: ContractBytes, index: i32) -> u32 #export {
    return bytes.data[index]
}

ContractBytesReady :: (bytes: ContractBytes) -> bool #export {
    return bytes.filled == 4 && bytes.data[0] != bytes.data[3]
}

App :: () #ui {
    Screen root: {
        Background(GetThemeBackground())
        Background(GetThemeSurface())
        Text((TextProps){.bounds={Scale(8), Scale(8), 0, 0}, .text="Spec Contract", .wrap=TextWrapNone})
        if count < 42 {
            count = count + 1
        }
        Text((TextProps){.bounds={Scale(8), Scale(32), 0, 0}, .text="ready", .wrap=TextWrapNone})
    }
}
