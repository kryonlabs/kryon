            column_x[3] = 336
            column_x[4] = 421
            column_x[5] = 506
            column_x[6] = 591
            column_x[7] = 674
            state_y[0] = 160
            state_y[2] = 253
            label_y[4] = 371
            size_caption_y[1] = 562
            size_fonts[1] = 19
            size_fonts[2] = 19
            size_label_x[1] = -1
            size_label_x[2] = -1
            icon_label_x[0] = 33
            icon_label_x[1] = 111
            icon_label_x[2] = 206
            icon_label_x[3] = 293
            icon_label_x[5] = 480
            icon_label_x[7] = 670
        } else {
            state_heights[1] = 38
            # The large face starts higher; retain the label's existing
            # pixel baseline while aligning the upper edge.
            size_label_y[2] = 1
        }
        focused_bounds: [8] Rectangle = {
            {origin + 80, 305, 74, 38}, {origin + 166, 305, 72, 38},
            {origin + 252, 305, 72, 38}, {origin + 336, 305, 72, 38},
            {origin + 421, 305, 72, 38}, {origin + 506, 305, 72, 38},
            {origin + 590, 305, 74, 38}, {origin + 674, 305, 72, 38}
        }
        small_bounds: [8] Rectangle = {
            {origin + 94, 511, 56, 24}, {origin + 176, 511, 56, 24},
            {origin + 262, 511, 57, 25}, {origin + 345, 511, 56, 25},
            {origin + 430, 511, 56, 25}, {origin + 514, 511, 56, 25},
            {origin + 598, 511, 56, 25}, {origin + 681, 511, 56, 25}
        }
        medium_bounds: [8] Rectangle = {
            {origin + 87, 548, 70, 41}, {origin + 168, 549, 70, 38},
            {origin + 254, 550, 71, 38}, {origin + 338, 549, 70, 38},
            {origin + 423, 549, 70, 39}, {origin + 508, 549, 70, 39},
            {origin + 592, 549, 71, 39}, {origin + 676, 549, 70, 38}
        }
        large_bounds: [8] Rectangle = {
            {origin + 86, 600, 72, 51}, {origin + 166, 601, 74, 48},
            {origin + 252, 599, 74, 51}, {origin + 336, 601, 74, 49},
            {origin + 421, 601, 74, 49}, {origin + 506, 601, 74, 48},
            {origin + 590, 601, 74, 48}, {origin + 674, 601, 74, 49}
        }
        if current_theme.mode == THEME_MODE_DARK {
            large_bounds[0] = (Rectangle){origin + 81, 599, 75, 49}
            large_bounds[1] = (Rectangle){origin + 166, 599, 75, 49}
            large_bounds[2] = (Rectangle){origin + 250, 599, 75, 49}
            large_bounds[3] = (Rectangle){origin + 333, 599, 75, 49}
            large_bounds[4] = (Rectangle){origin + 418, 599, 74, 49}
            large_bounds[5] = (Rectangle){origin + 502, 599, 74, 49}
            large_bounds[6] = (Rectangle){origin + 585, 599, 74, 49}
            large_bounds[7] = (Rectangle){origin + 669, 599, 75, 49}
            medium_bounds[0] = (Rectangle){origin + 83, 548, 71, 38}
            medium_bounds[1] = (Rectangle){origin + 168, 548, 71, 39}
            medium_bounds[2] = (Rectangle){origin + 253, 548, 70, 38}
            medium_bounds[3] = (Rectangle){origin + 335, 548, 71, 39}
            medium_bounds[4] = (Rectangle){origin + 420, 548, 70, 39}
            medium_bounds[5] = (Rectangle){origin + 504, 548, 70, 38}
            medium_bounds[6] = (Rectangle){origin + 587, 548, 70, 38}
            medium_bounds[7] = (Rectangle){origin + 671, 548, 70, 39}
            small_bounds[0] = (Rectangle){origin + 91, 511, 56, 24}
            small_bounds[1] = (Rectangle){origin + 175, 511, 57, 25}
            small_bounds[2] = (Rectangle){origin + 260, 511, 57, 24}
            small_bounds[3] = (Rectangle){origin + 343, 511, 56, 25}
            small_bounds[4] = (Rectangle){origin + 428, 511, 56, 24}
            small_bounds[5] = (Rectangle){origin + 512, 511, 56, 24}
            small_bounds[6] = (Rectangle){origin + 594, 511, 56, 24}
            small_bounds[7] = (Rectangle){origin + 677, 511, 56, 25}
            focused_bounds[0] = (Rectangle){origin + 80, 305, 75, 38}
            focused_bounds[1] = (Rectangle){origin + 166, 305, 72, 38}
            focused_bounds[2] = (Rectangle){origin + 250, 305, 73, 38}
            focused_bounds[3] = (Rectangle){origin + 334, 305, 72, 38}
            focused_bounds[4] = (Rectangle){origin + 419, 305, 73, 38}
            focused_bounds[5] = (Rectangle){origin + 503, 305, 73, 38}
            focused_bounds[6] = (Rectangle){origin + 587, 305, 73, 39}
            focused_bounds[7] = (Rectangle){origin + 671, 305, 73, 38}
