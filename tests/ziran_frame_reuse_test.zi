#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "key_input"
#import "text_input_platform"
Motion :: #import "scroll_device";
#import "text_input_platform_host"
using FrameStatus;
using PaintKind;

draws: s32;
failed: bool;
late_calls: s32;
emitter_calls: s32;

EmitFirst :: (command: PaintCommand) {
    unused command
    emitter_calls += 1
}

EmitSecond :: (command: PaintCommand) {
    unused command
    emitter_calls += 10
}

EmitterFrame :: (session: Session, emitter: PaintEmitter) -> FrameEndResult {
    Start(session)
    command: QueuedPaint
    command.emit = emitter
    command.has_emitter = true
    SubmitPaint(session, command)
    return EndFrameRetained(session, true)
}

// A still warped image is unchanged however many points it has; one moved
// point is a change. Comparing a full block of points must stay cheap. The
// emitter stands in for the raster backend with a built-in's comparison.
mesh_draws: s32;

DrawMesh :: (command: PaintCommand) {
    unused command
    mesh_draws += 1
}

MeshFrame :: (session: Session, points: []Vector2) -> FrameEndResult {
    Start(session)
    command: QueuedPaint
    command.data.kind = PaintKindImage
    command.data.node = -1
    command.data.asset_path = "mesh.png"
    command.data.bounds = Rectangle.{0.0, 0.0, 100.0, 80.0}
    command.data.mesh_columns = 2
    command.data.mesh_rows = cast(s32)(points.count / 2)
    command.data.mesh_points = points
    command.emit = DrawMesh
    command.has_emitter = true
    command.builtin_emitter = true
    SubmitPaint(session, command)
    return EndFrameRetained(session, true)
}

Draw :: (command: PaintCommand) {
    draws += 1
    if command.value.count != 5000 || command.value[0] != 65 ||
        command.value[4095] != 0 || command.value[4999] != 90 ||
        command.asset_path.count != 4500 || command.asset_path[0] != 112 ||
        command.asset_path[4096] != 0 || command.asset_path[4499] != 103 {
        failed = true
    }
}
Late :: (session: Session) { unused session; late_calls += 1 }
Start :: (session: Session, key: u64 = 17, width: float32 = 100.0) {
    unused BeginFrame(session, key, Rectangle.{0.0, 0.0, width, 80.0})
}

Build :: (session: Session) -> FrameEndResult {
    unused TreeSubmit(session, cast(u64)99, 0, 2, Rectangle.{1.0, 2.0, 30.0, 40.0})
    label: [5000]u8; path: [4500]u8
    for index: 0..4999 { label[index] = 65 }
    for index: 0..4499 { path[index] = 112 }
    label[4095] = 0; label[4999] = 90
    path[4096] = 0; path[4499] = 103
    command: QueuedPaint
    command.data.node = 1
    command.data.value = TextView(label[:])
    command.data.asset_path = TextView(path[:])
    command.emit = Draw; command.has_emitter = true
    SubmitPaint(session, command)
    return EndFrameRetained(session, false)
}

#program_export
main :: () -> s32 {
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    Start(session)
    if RetainFrame(session) { return 2 }
    result := Build(session)
    if result.status != cast(FrameStatus)FrameOk || draws != 1 || failed || TreeCount(session) != 2 { return 3 }
    Start(session)
    if !RetainFrame(session) || TreeIsBuilding(session) { return 4 }
    result = EndFrameRetained(session, true)
    if result.status != cast(FrameStatus)FrameOk || !result.paint_unchanged ||
        result.paint_count != 1 || draws != 1 || TreeCount(session) != 2 || TreeNodeAt(session, 1).key != cast(u64)99 { return 5 }
    Start(session)
    if !RetainFrame(session) { return 6 }
    result = EndFrameRetained(session, false, false)
    if result.status != cast(FrameStatus)FrameOk || !result.paint_unchanged ||
        FramePaintUnchanged(session) || draws != 2 || failed { return 7 }
    Start(session)
    if !RetainFrame(session) || EndFrame(session) != cast(FrameStatus)FrameOk || draws != 3 || failed { return 8 }
    // The same frame input is inspected before keyboard routing consumes Tab.
    unused KeyboardSend(session, KeyTab)
    Start(session)
    if RetainFrame(session) { return 9 }
    TreeCancel(session)
    unused KeyboardSend(session, 0)
    PointerWheelSend(session, 10.0, 10.0, 1.0)
    Start(session)
    if RetainFrame(session) { return 10 }
    TreeCancel(session)
    PointerWheelSend(session, 10.0, 10.0, 0.0)
    unused TypedCodepointSend(session, 97)
    Start(session)
    if RetainFrame(session) { return 11 }
    input: [8]u8; unused TypedTextTake(session, input[:])
    TreeCancel(session)
    Start(session, cast(u64)18)
    if RetainFrame(session) { return 12 }
    TreeCancel(session)
    Start(session, cast(u64)17, 101.0)
    if RetainFrame(session) { return 13 }
    TreeCancel(session)
    TreePointerUpdate(session, PointerFrame.{5.0, 5.0, false, false, false})
    Start(session)
    if RetainFrame(session) { return 14 }
    TreeCancel(session)
    Start(session)
    if RetainFrame(session) { return 15 }
    result = Build(session)
    Start(session)
    if !RetainFrame(session) { return 23 }
    result = EndFrameRetained(session, true)
    if result.status != cast(FrameStatus)FrameOk || draws != 4 { return 16 }
    if EndFrameRetained(session, true).status != cast(FrameStatus)FrameNotBuilding { return 24 }
    // Scroll motion and editable focus continue without a fresh OS event.
    Motion.BeginScrollFrame(session, Vector2.{5.0, 5.0}, false, false, false, 0.0, 1.0)
    Motion.scroll_device.glide_owner = cast(u64)99
    Start(session)
    if RetainFrame(session) || !Motion.ScrollDeviceMoving(session) { return 25 }
    TreeCancel(session)
    Motion.scroll_device.glide_owner = cast(u64)0
    Start(session)
    TextInputNoteFocused(session)
    if RetainFrame(session) { return 26 }
    TreeCancel(session)
    TextInputFocusFrameBegin(session)
    TextInputFocusFrameBegin(session)
    Start(session)
    unused TreeSubmit(session, cast(u64)100, 0, 2, Rectangle.{1.0, 2.0, 30.0, 40.0})
    if RetainFrame(session) { return 17 }
    TreeCancel(session)
    Start(session)
    unused TreeDefer(session, Late)
    if RetainFrame(session) { return 18 }
    result = EndFrameRetained(session, false)
    if result.status != cast(FrameStatus)FrameOk || late_calls != 1 { return 19 }
    PaintSnapshotInvalidate(session)
    Start(session)
    if RetainFrame(session) { return 20 }
    TreeCancel(session)
    if !CloseSession(session) || RetainFrame(session) { return 21 }
    fresh := SessionOpen()
    Start(fresh)
    if RetainFrame(fresh) { return 22 }
    TreeCancel(fresh)
    unused CloseSession(fresh)
    // Custom callbacks can read mutable state or draw different pixels for
    // identical command data. Composition must emit them every time.
    custom := SessionOpen()
    first: PaintEmitter = EmitFirst
    second: PaintEmitter = EmitSecond
    result = EmitterFrame(custom, first)
    if result.paint_unchanged || emitter_calls != 1 { return 27 }
    result = EmitterFrame(custom, first)
    if result.paint_unchanged || emitter_calls != 2 { return 28 }
    result = EmitterFrame(custom, second)
    if result.paint_unchanged || emitter_calls != 12 { return 29 }
    result = EmitterFrame(custom, second)
    if result.paint_unchanged || emitter_calls != 22 { return 30 }
    unused CloseSession(custom)
    meshes := SessionOpen()
    mesh: [4000]Vector2
    for index: 0..3999 { mesh[index] = Vector2.{cast(float32)(index % 2), cast(float32)(index / 2)} }
    result = MeshFrame(meshes, mesh[:])
    if result.status != cast(FrameStatus)FrameOk || result.paint_unchanged || mesh_draws != 1 { return 31 }
    result = MeshFrame(meshes, mesh[:])
    if result.status != cast(FrameStatus)FrameOk || !result.paint_unchanged || mesh_draws != 1 { return 32 }
    mesh[3999].x += 1.0
    result = MeshFrame(meshes, mesh[:])
    if result.status != cast(FrameStatus)FrameOk || result.paint_unchanged || mesh_draws != 2 { return 33 }
    unused CloseSession(meshes)

    // Invalid slot indices never shift a word or alter valid slots.
    flags := SessionFlagSet(cast(u32)0, 0, true)
    flags = SessionFlagSet(flags, 8, true)
    if !SessionFlagGet(flags, 0) || !SessionFlagGet(flags, 8) { return 45 }
    invalid: [5]s32 = .{-1, 9, 31, 32, 2147483647}
    for index: 0..4 {
        slot := invalid[index]
        if SessionFlagGet(flags, slot) || SessionFlagSet(flags, slot, true) != flags ||
            SessionFlagSet(flags, slot, false) != flags { return 46 }
    }

    // Nested input suspension must restore each session's flags independently.
    a := SessionOpen()
    b := SessionOpen()
    seed := TreeInputSuspend(a)
    seed.escape_captured = true
    seed.focus_visible = true
    if !TreeInputResume(a, seed) { return 34 }
    outer := TreeInputSuspend(a)
    if !outer.escape_captured || !outer.focus_visible || TreeEscapeCaptured(b) { return 35 }
    inner_seed := TreeInputSuspend(a)
    inner_seed.focus_visible = true
    if !TreeInputResume(a, inner_seed) { return 36 }
    inner := TreeInputSuspend(a)
    if inner.escape_captured || !inner.focus_visible { return 37 }
    if !TreeInputResume(a, inner) || !TreeInputResume(a, outer) { return 38 }
    restored := TreeInputSuspend(a)
    if !restored.escape_captured || !restored.focus_visible || TreeEscapeCaptured(b) { return 39 }
    if !TreeInputResume(a, restored) || !CloseSession(a) { return 40 }
    fresh_input := SessionOpen()
    reset := TreeInputSuspend(fresh_input)
    if reset.escape_captured || reset.focus_visible || TreeInputResume(fresh_input, restored) { return 41 }
    unused CloseSession(fresh_input)

    // Invalidating one session leaves another retained frame usable; resource
    // replacement invalidates all sessions.
    a = SessionOpen()
    Start(a); unused Build(a)
    Start(b); unused Build(b)
    PaintSnapshotInvalidate(a)
    Start(a)
    if RetainFrame(a) { return 42 }
    TreeCancel(a)
    Start(b)
    if !RetainFrame(b) { return 43 }
    unused EndFrameRetained(b, true)
    PaintResourcesChanged()
    Start(b)
    if RetainFrame(b) { return 44 }
    TreeCancel(b)
    unused CloseSession(a)
    unused CloseSession(b)
    return 0
}
