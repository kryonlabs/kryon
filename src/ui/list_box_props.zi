#module "list_box_props"
#import "geometry"

ListBoxProps :: struct {
    bounds: Rectangle
    id: i32
    class_name: i32
    items: const char**
    item_count: i32
    selected_index: i32*
    selected: i32*
    selected_count: i32*
    anchor: i32*
    scroll_offset: i32*
    row_height: i32
    disabled: bool
    content_height: i32
    item_keys: i32*
}
