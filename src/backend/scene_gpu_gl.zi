RawDeleteProgram :: (id: u32) #foreign gl "glDeleteProgram";
RawUseProgram :: (id: u32) #foreign gl "glUseProgram";
RawUniformLocation :: (id: u32, name: *u8)->s32 #foreign gl "glGetUniformLocation";
RawUniform1i :: (location: s32, value: s32) #foreign gl "glUniform1i";
RawUniform1f :: (location: s32, value: float32) #foreign gl "glUniform1f";
RawUniform2f :: (location: s32, x: float32, y: float32) #foreign gl "glUniform2f";
RawUniform3f :: (location: s32, x: float32, y: float32, z: float32) #foreign gl "glUniform3f";
RawUniform4f :: (location: s32, x: float32, y: float32, z: float32, w: float32) #foreign gl "glUniform4f";
RawUniform4fv :: (location: s32, count: s32, data: *float32) #foreign gl "glUniform4fv";
RawUniformMatrix :: (location: s32, count: s32, transpose: u8, data: *float32) #foreign gl "glUniformMatrix4fv";
RawEnable :: (kind: u32) #foreign gl "glEnable";
RawDisable :: (kind: u32) #foreign gl "glDisable";
RawDepthMask :: (enabled: u8) #foreign gl "glDepthMask";
RawDepthFunc :: (kind: u32) #foreign gl "glDepthFunc";
RawBlendFuncSeparate :: (src: u32, dst: u32, src_alpha: u32, dst_alpha: u32) #foreign gl "glBlendFuncSeparate";
RawFrontFace :: (kind: u32) #foreign gl "glFrontFace";
RawCullFace :: (kind: u32) #foreign gl "glCullFace";
RawViewport :: (x: s32, y: s32, width: s32, height: s32) #foreign gl "glViewport";
RawClearColor :: (r: float32, g: float32, b: float32, a: float32) #foreign gl "glClearColor";
RawClearDepth :: (depth: float32) #foreign gl "glClearDepthf";
RawClear :: (mask: u32) #foreign gl "glClear";
RawDrawArrays :: (kind: u32, first: s32, count: s32) #foreign gl "glDrawArrays";
RawReadPixels :: (x: s32, y: s32, width: s32, height: s32, format: u32, kind: u32, data: *void) #foreign gl "glReadPixels";
RawPixelStore :: (name: u32, value: s32) #foreign gl "glPixelStorei";
RawFinish :: () #foreign gl "glFinish";
RawCompareMemory :: (a: *void, b: *void, bytes: usize)->s32 #foreign c "memcmp";
RawCopyMemory :: (a: *void, b: *void, bytes: usize)->*void #foreign c "memcpy";

EGetPlatformDisplay :: (platform: u32, native: *void, attributes: *s64) ->*void {return RawEGetPlatformDisplay(platform,native,attributes)}
EInitialize :: (display: *void, major: *s32, minor: *s32) ->u32 {return RawEInitialize(display,major,minor)}
EBindAPI :: (api: u32) ->u32 {return RawEBindAPI(api)}
EChooseConfig :: (display: *void, attrs: *s32, configs: **void, count: s32, found: *s32) ->u32 {return RawEChooseConfig(display,attrs,configs,count,found)}
ECreateContext :: (display: *void, config: *void, share: *void, attrs: *s32) ->*void {return RawECreateContext(display,config,share,attrs)}
EDestroyContext :: (display: *void, context: *void) ->u32 {return RawEDestroyContext(display,context)}
ETerminate :: (display: *void) ->u32 {return RawETerminate(display)}
EMakeCurrent :: (display: *void, draw: *void, read: *void, context: *void) ->u32 {return RawEMakeCurrent(display,draw,read,context)}
EGetCurrentDisplay :: () ->*void {return RawEGetCurrentDisplay()}
EGetCurrentContext :: () ->*void {return RawEGetCurrentContext()}
EGetCurrentSurface :: (which: s32) ->*void {return RawEGetCurrentSurface(which)}
EQueryAPI :: () ->u32 {return RawEQueryAPI()}
GLXCurrentDisplay :: ()->*void {return RawGLXCurrentDisplay()}
GLXCurrentContext :: ()->*void {return RawGLXCurrentContext()}
GLXCurrentDrawable :: ()->u64 {return RawGLXCurrentDrawable()}
GLXCurrentReadDrawable :: ()->u64 {return RawGLXCurrentReadDrawable()}
GLXMakeCurrent :: (display: *void,draw: u64,read: u64,context: *void)->s32 {return RawGLXMakeCurrent(display,draw,read,context)}
GetString :: (name: u32) ->*u8 {return RawGetString(name)}
GetInteger :: (name: u32, value: *s32)  {RawGetInteger(name,value)}
GetError :: () ->u32 {return RawGetError()}
GetPrecision :: (stage: u32, kind: u32, range: *s32, precision: *s32)  {RawGetPrecision(stage,kind,range,precision)}
GenFramebuffers :: (count: s32, ids: *u32)  {RawGenFramebuffers(count,ids)}
DeleteFramebuffers :: (count: s32, ids: *u32)  {RawDeleteFramebuffers(count,ids)}
BindFramebuffer :: (target: u32, id: u32)  {RawBindFramebuffer(target,id)}
CheckFramebuffer :: (target: u32) ->u32 {return RawCheckFramebuffer(target)}
FramebufferTexture :: (target: u32, attachment: u32, texture_target: u32, id: u32, level: s32)  {RawFramebufferTexture(target,attachment,texture_target,id,level)}
FramebufferRenderbuffer :: (target: u32, attachment: u32, renderbuffer_target: u32, id: u32)  {RawFramebufferRenderbuffer(target,attachment,renderbuffer_target,id)}
GenRenderbuffers :: (count: s32, ids: *u32)  {RawGenRenderbuffers(count,ids)}
DeleteRenderbuffers :: (count: s32, ids: *u32)  {RawDeleteRenderbuffers(count,ids)}
BindRenderbuffer :: (target: u32, id: u32)  {RawBindRenderbuffer(target,id)}
RenderbufferStorage :: (target: u32, format: u32, width: s32, height: s32)  {RawRenderbufferStorage(target,format,width,height)}
RenderbufferMS :: (target: u32, samples: s32, format: u32, width: s32, height: s32)  {RawRenderbufferMS(target,samples,format,width,height)}
GetRenderbuffer :: (target: u32, name: u32, value: *s32)  {RawGetRenderbuffer(target,name,value)}
BlitFramebuffer :: (sx: s32, sy: s32, ex: s32, ey: s32, dx: s32, dy: s32, fx: s32, fy: s32, mask: u32, filter: u32)  {RawBlitFramebuffer(sx,sy,ex,ey,dx,dy,fx,fy,mask,filter)}
GenTextures :: (count: s32, ids: *u32)  {RawGenTextures(count,ids)}
DeleteTextures :: (count: s32, ids: *u32)  {RawDeleteTextures(count,ids)}
BindTexture :: (target: u32, id: u32)  {RawBindTexture(target,id)}
ActiveTexture :: (unit: u32)  {RawActiveTexture(unit)}
