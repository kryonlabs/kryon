#module "app_shell_layout"

#import "ui_app_shell_props.generated.h"

KryAppShellMeasure :: (spec: KryAppShellLayoutSpec) -> KryAppShellLayout #export {
    layout: KryAppShellLayout = {0}
    padding: i32 = spec.padding >= 0 ? spec.padding : 0
    nav_height: i32 = spec.nav_height > 0 ? spec.nav_height : 0
    breakpoint: i32 = spec.sidebar_breakpoint > 0 ? spec.sidebar_breakpoint : 480
    sidebar_width: i32 = spec.sidebar_width > 0 ? spec.sidebar_width : 0

    layout.compact = spec.view_width <= breakpoint ? 1 : 0
    layout.sidebar_width = layout.compact ? 0 : sidebar_width

    layout.nav_x = spec.safe_left
    layout.nav_y = spec.view_height - spec.safe_bottom - nav_height
    layout.nav_width = spec.view_width - spec.safe_left - spec.safe_right
    layout.nav_height = nav_height
    if layout.nav_y < spec.safe_top {
        layout.nav_y = spec.safe_top
    }
    if layout.nav_width < 0 {
        layout.nav_width = 0
    }

    layout.content_x = spec.safe_left + layout.sidebar_width + padding
    layout.content_y = spec.safe_top + padding
    available_width: i32 = spec.view_width - spec.safe_left - spec.safe_right -
                       layout.sidebar_width - padding * 2
    layout.content_width = available_width
    if spec.max_content_width > 0 &&
       layout.content_width > spec.max_content_width {
        layout.content_width = spec.max_content_width
    }
    if spec.min_content_width > 0 &&
       layout.content_width < spec.min_content_width {
        layout.content_width = spec.min_content_width
    }
    layout.content_height = layout.nav_y - layout.content_y - padding
    if layout.content_height < 0 {
        layout.content_height = 0
    }
    return layout
}
