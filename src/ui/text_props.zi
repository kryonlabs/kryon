#import "geometry"
#import "semantic"
#import "text_align"

// Common font sizes used by the Ziran Text widget. A host supplies glyph
// measurements and rasterization through font_metrics and raster_text.
Text8 :: 8
Text12 :: 12
Text14 :: 14
Text16 :: 16
Text18 :: 18
Text20 :: 20
Text24 :: 24
Text32 :: 32
Text48 :: 48
TextBaseSize :: 16

TextWrap :: enum {
    TextWrapAuto :: 0
    TextWrapNone :: 1
}

TextProps :: struct {
    key: u64
    bounds: Rectangle
    text: string
    font: s32
    fallback_font: s32
    style_kind: s32
    semantic_kind: SemanticKind
    heading_level: s32
    class_name: s32
    wrap: TextWrap
    align: TextAlign
    vertical_align: TextAlign
    disabled: bool
    selectable: bool
    strikethrough: bool
}
