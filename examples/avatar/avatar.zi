App :: #import "kryon/app";
Avatar :: #import "kryon/avatar";
Layout :: #import "kryon/layout";
#import "kryon/tree"
Text :: #import "kryon/text";
#import "kryon/geometry"
#import "kryon/session"


Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Avatar", .size = 28})
    row := Layout.Row(session, Layout.Props.{.gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if row.opened {
        Avatar.Draw(session, Avatar.Props.{.disabled = example_disabled, .bounds = .{width = 72, height = 72}, .name = "Ada Lovelace", .size = 72.0})
        Avatar.Draw(session, Avatar.Props.{.disabled = example_disabled, .bounds = .{width = 72, height = 72}, .name = "Grace Hopper", .size = 72.0, .square = true})
        unused End(session)
    }
    names := string.["Ada Lovelace", "Grace Hopper", "Katherine Johnson", "Alan Turing"]
    Avatar.AvatarGroup(session, Avatar.AvatarGroupProps.{.bounds = .{height = 56}, .size = 48.0, .max_visible = 3}, names[:])
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "avatar"}, Frame) }
