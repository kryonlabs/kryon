Image :: #import "image";
#import "drawing_props"
#import "geometry"
#import "session"
#import "transition"
using Surface :: #import "frame_surface";

using Image.ImageFit;
host_api :: #system_library "host_api";
DisposeFrameTexture :: (texture: Texture2D) #foreign host_api;
CopyFrameTexture :: (texture: Texture2D) -> Texture2D #foreign host_api;
FramePreviousSnapshotHost :: () -> FrameSurface #foreign host_api;

// Capture the last presented frame before painting a new route. This value
// owns its pixels until FrameSurfaceRelease, independently of later frames.
#program_export
FramePreviousSnapshot :: () -> FrameSurface {
    return FramePreviousSnapshotHost()
}

#program_export
FrameSurfaceValid :: (surface: FrameSurface) -> bool {
    return surface.texture.id != cast(u32)0 &&
    surface.texture.width > 0 && surface.texture.height > 0
}

#program_export
FrameSurfaceCopy :: (surface: FrameSurface) -> FrameSurface {
    if !FrameSurfaceValid(surface) { return FrameSurface.{} }
    return FrameSurface.{CopyFrameTexture(surface.texture), surface.upright}
}

#program_export
FrameSurfaceRelease :: (surface: FrameSurface) -> FrameSurface {
    if !FrameSurfaceValid(surface) { return surface }
    DisposeFrameTexture(surface.texture)
    surface.texture = Texture2D.{}
    return surface
}

#program_export
FrameTransitionAlpha :: (elapsed_seconds: float32,
    duration_seconds: float32) -> float32 {
    duration := TransitionDuration(duration_seconds)
    progress := TransitionClampProgress(elapsed_seconds / duration)
    return 1.0 - TransitionSmoothProgress(progress)
}

#program_export
FrameTransitionImage :: (surface: FrameSurface, bounds: Rectangle,
    elapsed_seconds: float32, duration_seconds: float32) -> Image.Props {
    alpha := FrameTransitionAlpha(elapsed_seconds, duration_seconds)
    alpha_byte := cast(u32)(alpha * 255.0 + 0.5)
    image: Image.Props = .{.bounds = bounds, .fit = cast(Image.ImageFit)ImageFitStretch,
        .texture = surface.texture}
    // Row orientation belongs to the captured surface, never to app policy.
    image.source = Rectangle.{0.0, 0.0,
        cast(float32)surface.texture.width,
        ifx surface.upright then cast(float32)surface.texture.height else -cast(float32)surface.texture.height}
    image.alt_text = "Previous screen"
    image.tint = (cast(u32)0xffffff << cast(u32)8) | alpha_byte
    return image
}

#program_export
FrameTransition :: (session: Session, surface: FrameSurface,
    bounds: Rectangle, elapsed_seconds: float32,
    duration_seconds: float32) {
    if !FrameSurfaceValid(surface) { return }
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    if FrameTransitionAlpha(elapsed_seconds, duration_seconds) <= 0.0 { return }
    Image.Draw(session, FrameTransitionImage(surface, bounds,
        elapsed_seconds, duration_seconds))
}
