#module "color_picker_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/color_picker.h"
#import "runtime/input.h"
#import "runtime/slider.h"
#import "ui/paint_command.h"

ColorPickerSlider :: (slider: SliderContinuousProps) -> i32 {
    changed: i32 = ui_update_slider_continuous(slider, 0)
    ui_paint_slider_continuous(slider, 0)
    return changed
}

ColorPickerEdit :: (edit: ColorPickerProps, channels: i32) -> i32 {
    if edit.values == nil || edit.value_count < channels { return 0 }
    slider: SliderContinuousProps
    slider.bounds = edit.bounds
    slider.id = edit.id
    slider.label = edit.label
    slider.values = edit.values
    slider.value_count = channels
    slider.min = 0.0
    slider.max = 1.0
    slider.format = InputDefaultFormat(NumericFloat)
    slider.disabled = edit.disabled
    slider.class_name = edit.class_name
    return ColorPickerSlider(slider)
}

ColorPickerFloatColor :: (values: *float,
channels: i32) -> Color {
    components: [4]float
    components[3] = 1.0
    index: i32 = 0
    while index < channels {
        components[index] = values[index]
        index += 1
    }
    return ColorPickerColorFor(components[0], components[1],
    components[2], components[3], channels)
}

ColorPickerFloat :: (picker: ColorPickerProps,
channels: i32) -> i32 {
    if picker.values == nil || picker.value_count < channels { return 0 }
    scale: float = (float)Scale(1000) / 1000.0
    state: ButtonState = ButtonStateNormal
    if picker.disabled { state = ButtonStateDisabled }
    picker_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, state, picker.disabled, 0, picker.class_name,
    StyleKindColorPicker(), StyleAny())
    layout: ColorPickerLayout = ColorPickerLayoutFor(picker.bounds,
    channels, scale, picker_frame)
    labels: [4]const char*
    labels[0] = "R"
    labels[1] = "G"
    labels[2] = "B"
    labels[3] = "A"
    changed: i32 = 0
    index: i32 = 0
    while index < channels {
        channel: SliderContinuousProps
        channel.bounds = ColorPickerChannelBounds(picker.bounds,
        index, channels, scale, picker_frame)
        channel.id = ColorPickerChannelIdFor(picker.id, index)
        channel.label = labels[index]
        channel.values = &picker.values[index]
        channel.value_count = 1
        channel.min = 0.0
        channel.max = 1.0
        channel.format = InputDefaultFormat(NumericFloat)
        channel.disabled = picker.disabled
        channel.class_name = picker.class_name
        changed |= ColorPickerSlider(channel)
        index += 1
    }
    if IsWindowReady() {
        frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, state, picker.disabled, 0, picker.class_name,
        StyleKindColorPickerSwatch(), StyleAny())
        style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(frame).value)
        font: i32 = ResolveFont(0, StyleFontValue(style.fields,
        style.font_size), GetSmallFontSize())
        label_inset: float = ColorPickerSwatchLabelInset(scale, frame)
        paint: ColorPickerSwatchPaint = ColorPickerSwatchPaintFor(
        layout.swatch_bounds, label_inset, (float)TextLineHeight(font))
        DrawRectangleRec(paint.bounds,
        ColorPickerFloatColor(picker.values, channels))
        DrawWidgetFrame(paint.bounds, picker.bounds,
        frame, 0, 0, picker.disabled, 0)
        if picker.label != nil {
            RenderText(picker.label, (int)paint.label_x,
            (int)paint.label_y, font,
            Fade(style.foreground, style.opacity))
        }
    }
    return changed
}

RenderColorPicker :: (picker: ColorPickerProps) -> i32 #export {
    channels: i32 = 3
    if picker.value_count >= 4 { channels = 4 }
    if picker.picker { return ColorPickerFloat(picker, channels) }
    return ColorPickerEdit(picker, channels)
}
