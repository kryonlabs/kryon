// KSS fuzz: feed generated and damaged style sheets to the parser, the style
// rule table, and the formatter, and check what they promise.
//
//   kss_fuzz CURRENT SEED COUNT PACK...   run COUNT cases made from SEED
//   kss_fuzz CURRENT check FILE           run the checks on one file
//   kss_fuzz CURRENT corpus FILE...       run the checks on each file; one
//                                         named *.ok.kss must also parse
//   kss_fuzz CURRENT shrink FILE          cut FILE down to a small sheet that
//                                         still fails, and write it to CURRENT
//
// Each case is either a random sheet assembled from the KSS grammar or a
// shipped PACK with random damage: flipped bytes, inserted directives and
// blocks, deleted, repeated, or spliced ranges, and cut-off endings. Every
// case is checked for:
//   - no abort in the typed parser, the declarative parser, or the formatter
//     (Ziran stops a program on an out-of-range index or cast);
//   - parser state that stays inside its tables after every step;
//   - a parse that ends: at most one step per source byte, plus imports;
//   - an error that says what went wrong;
//   - formatting that keeps meaning: the formatted sheet parses to the same
//     status, rules, tokens, and declarations as the original;
//   - formatting that only moves whitespace: every other byte stays, in order;
//   - formatting that is stable: formatting the output again changes nothing.
//
// Before each case the input is written to CURRENT, so when a check fails or
// the program is killed, CURRENT holds the sheet that did it. Exit status 1
// means a check failed.
#import "byte_text_linux"
#import "c_string"
#import "file_linux"
#import "kss_formatter"
#import "kss_parser"
#import "style_parse"
#import "style"
#import "style_sheet"

using KssStatus;

libc :: #system_library "libc";
RawWrite :: (descriptor: s32, input: *u8, count: u64) -> s64 #foreign libc "write";
RawExit :: (status: s32) #foreign libc "_exit";
RawFork :: () -> s32 #foreign libc "fork";
RawWaitPid :: (pid: s32, status: *s32, options: s32) -> s32 #foreign libc "waitpid";
RawOpen :: (path: *u8, flags: s32, mode: ..any) -> s32 #foreign libc "open";
RawDup2 :: (source: s32, destination: s32) -> s32 #foreign libc "dup2";

// ------------------------------------------------------------------ output

WriteText :: (descriptor: s32, text: string) {
    chunk: [512]u8
    at: s32 = 0
    while at < cast(s32)text.count {
        count: s32 = cast(s32)text.count - at
        if count > 512 { count = 512 }
        index: s32 = 0
        while index < count {
            chunk[index] = text[at + index]
            index += 1
        }
        if RawWrite(descriptor, *chunk[0], cast(u64)count) <= 0 { return }
        at += count
    }
}

NumberText :: (value: s64, output: []u8) -> string {
    at: s32 = cast(s32)output.count
    magnitude: s64 = value
    if magnitude < 0 { magnitude = -magnitude }
    while true {
        at -= 1
        output[at] = cast(u8)(48 + magnitude % 10)
        magnitude = magnitude / 10
        if magnitude == 0 { break }
    }
    if value < 0 {
        at -= 1
        output[at] = 45
    }
    return TextView(output[at:cast(s32)output.count])
}

WriteNumber :: (descriptor: s32, value: s64) {
    digits: [24]u8
    WriteText(descriptor, NumberText(value, digits[:]))
}

case_seed: s64 = 0;
case_index: s32 = 0;
shrinking: bool = false;

// The typed parse status of the last case.
last_status: s32 = 0;

// How far the cases got, so a run shows what it covered.
parsed_count: s64 = 0;
compared_count: s64 = 0;

// Reports a failed check with the case that failed and stops with status 1.
// CURRENT still holds the input.
Fail :: (message: string) {
    WriteText(2, "kss fuzz: seed ")
    WriteNumber(2, case_seed)
    WriteText(2, " case ")
    WriteNumber(2, cast(s64)case_index)
    WriteText(2, ": ")
    WriteText(2, message)
    WriteText(2, "\n")
    if shrinking {
        // The status names the check, so shrinking keeps the same failure.
        hash: u32 = 2166136261
        index: s32 = 0
        while index < cast(s32)message.count {
            hash = (hash ^ cast(u32)message[index]) * 16777619
            index += 1
        }
        RawExit(cast(s32)(10 + hash % 200))
    }
    RawExit(1)
}

Check :: (condition: bool, message: string) {
    if !condition { Fail(message) }
}

// ------------------------------------------------------------------ random

random_state: u64 = 1;

SeedRandom :: (seed: s64) {
    random_state = cast(u64)seed
}

// splitmix64: every seed gives a different, well mixed sequence.
NextRandom :: () -> u64 {
    random_state = random_state + 11400714819323198485
    z: u64 = random_state
    z = (z ^ (z >> 30)) * 13787848793156543929
    z = (z ^ (z >> 27)) * 10723151780598845931
    return z ^ (z >> 31)
}

// A number from 0 up to but not including limit.
Below :: (limit: s32) -> s32 {
    if limit <= 1 { return 0 }
    return cast(s32)((NextRandom() >> 11) % cast(u64)limit)
}

Chance :: (percent: s32) -> bool {
    return Below(100) < percent
}

// ------------------------------------------------------------------ input

InputCapacity :: 131072;

// The case being checked. Damage works on it in place.
input_bytes: [InputCapacity]u8;
input_length: s32 = 0;

// A scratch copy for moving ranges around.
scratch_bytes: [InputCapacity]u8;

Input :: () -> string {
    return TextView(input_bytes[0:input_length])
}

Append :: (text: string) {
    index: s32 = 0
    while index < cast(s32)text.count && input_length < InputCapacity {
        input_bytes[input_length] = text[index]
        input_length += 1
        index += 1
    }
}

AppendByte :: (byte: u8) {
    if input_length < InputCapacity {
        input_bytes[input_length] = byte
        input_length += 1
    }
}

AppendNumber :: (value: s64) {
    digits: [24]u8
    Append(NumberText(value, digits[:]))
}

// Replaces input[start:end] with text.
Replace :: (start: s32, end: s32, text: string) {
    if start < 0 || end < start || end > input_length { return }
    tail: s32 = input_length - end
    index: s32 = 0
    while index < tail {
        scratch_bytes[index] = input_bytes[end + index]
        index += 1
    }
    input_length = start
    Append(text)
    index = 0
    while index < tail && input_length < InputCapacity {
        input_bytes[input_length] = scratch_bytes[index]
        input_length += 1
        index += 1
    }
}

// The shipped packs, read once.
PackCapacity :: 4;
PackBytes :: 65536;
pack_bytes: [PackCapacity][PackBytes]u8;
pack_lengths: [PackCapacity]s32;
pack_count: s32 = 0;

Pack :: (index: s32) -> string {
    return TextView(pack_bytes[index][0:pack_lengths[index]])
}

LoadPack :: (path: string) -> bool {
    if pack_count >= PackCapacity { return false }
    file: FileHandle = OpenRead(path)
    if !file.valid { return false }
    read: s64 = ReadAt(file, pack_bytes[pack_count][:], 0)
    CloseFile(file)
    if read <= 0 || read >= cast(s64)PackBytes { return false }
    pack_lengths[pack_count] = cast(s32)read
    pack_count += 1
    return true
}

LoadInput :: (path: string) -> bool {
    file: FileHandle = OpenRead(path)
    if !file.valid { return false }
    read: s64 = ReadAt(file, input_bytes[:], 0)
    CloseFile(file)
    if read < 0 || read >= cast(s64)InputCapacity { return false }
    input_length = cast(s32)read
    return true
}

SaveInput :: (path: string) {
    file: FileHandle = OpenReplace(path)
    Check(file.valid, "cannot write CURRENT")
    written: s64 = WriteAt(file, input_bytes[0:input_length], 0)
    CloseFile(file)
    Check(written == cast(s64)input_length, "cannot write CURRENT")
}

// ------------------------------------------------------------------ grammar

Kinds :: 24;
KindName :: (index: s32) -> string {
    if index == 0 { return "Button" }
    if index == 1 { return "Text" }
    if index == 2 { return "TextField" }
    if index == 3 { return "Surface" }
    if index == 4 { return "Card" }
    if index == 5 { return "Slider" }
    if index == 6 { return "Toggle" }
    if index == 7 { return "Progress" }
    if index == 8 { return "Popup" }
    if index == 9 { return "Menu" }
    if index == 10 { return "MenuItem" }
    if index == 11 { return "TabBar" }
    if index == 12 { return "Tab" }
    if index == 13 { return "ListBoxItem" }
    if index == 14 { return "TreeView" }
    if index == 15 { return "Checkbox" }
    if index == 16 { return "Any" }
    if index == 17 { return "App" }
    if index == 18 { return "Scroll" }
    if index == 19 { return "Plot" }
    if index == 20 { return "NavigationBarItem" }
    if index == 21 { return "Dropdown" }
    if index == 22 { return "Nowhere" }
    return "button"
}

Attributes :: 12;
AttributeText :: (index: s32) -> string {
    if index == 0 { return "[tone=Accent]" }
    if index == 1 { return "[tone=Danger]" }
    if index == 2 { return "[emphasis=Outline]" }
    if index == 3 { return "[size=Small]" }
    if index == 4 { return "[role=Track]" }
    if index == 5 { return "[role=Panel]" }
    if index == 6 { return "[state=hover]" }
    if index == 7 { return ".primary" }
    if index == 8 { return ":hover" }
    if index == 9 { return ":disabled" }
    if index == 10 { return "[role=Nothing]" }
    return ":focus"
}

Properties :: 20;
PropertyName :: (index: s32) -> string {
    if index == 0 { return "background" }
    if index == 1 { return "foreground" }
    if index == 2 { return "border" }
    if index == 3 { return "border-width" }
    if index == 4 { return "radius" }
    if index == 5 { return "padding-x" }
    if index == 6 { return "padding-y" }
    if index == 7 { return "gap" }
    if index == 8 { return "opacity" }
    if index == 9 { return "font-size" }
    if index == 10 { return "icon-size" }
    if index == 11 { return "material" }
    if index == 12 { return "typeface" }
    if index == 13 { return "letter-spacing" }
    if index == 14 { return "offset-x" }
    if index == 15 { return "offset-y" }
    if index == 16 { return "background-end" }
    if index == 17 { return "focus" }
    if index == 18 { return "transition" }
    return "unknown-property"
}

Values :: 26;
ValueText :: (index: s32) -> string {
    if index == 0 { return "#112233" }
    if index == 1 { return "#11223344" }
    if index == 2 { return "#abc" }
    if index == 3 { return "#zzzzzz" }
    if index == 4 { return "accent" }
    if index == 5 { return "text" }
    if index == 6 { return "space.2" }
    if index == 7 { return "0" }
    if index == 8 { return "12" }
    if index == 9 { return "-3.5" }
    if index == 10 { return "99999999999999999999" }
    if index == 11 { return "1e40" }
    if index == 12 { return "0.000001" }
    if index == 13 { return "Flat" }
    if index == 14 { return "default" }
    if index == 15 { return "transparent" }
    if index == 16 { return "\"body\"" }
    if index == 17 { return "\"unterminated" }
    if index == 18 { return "120ms" }
    if index == 19 { return "var(--x)" }
    if index == 20 { return "" }
    if index == 21 { return "1 2 3" }
    if index == 22 { return "missing-token" }
    if index == 23 { return "radius" }
    if index == 24 { return "." }
    return "-"
}

TokenGroups :: 5;
TokenGroupName :: (index: s32) -> string {
    if index == 0 { return "color" }
    if index == 1 { return "length" }
    if index == 2 { return "duration" }
    if index == 3 { return "material" }
    return "shadow"
}

TokenNames :: 10;
TokenName :: (index: s32) -> string {
    if index == 0 { return "accent" }
    if index == 1 { return "text" }
    if index == 2 { return "canvas" }
    if index == 3 { return "space.2" }
    if index == 4 { return "radius" }
    if index == 5 { return "default" }
    if index == 6 { return "fast" }
    if index == 7 { return "border" }
    if index == 8 { return "a-token-name-that-is-longer-than-the-sixty-four-bytes-a-kss-name-holds" }
    return "x"
}

EnvQueries :: 12;
EnvQuery :: (index: s32) -> string {
    if index == 0 { return "theme(dark)" }
    if index == 1 { return "theme(light)" }
    if index == 2 { return "contrast(high)" }
    if index == 3 { return "density(compact)" }
    if index == 4 { return "density(touch)" }
    if index == 5 { return "pointer(touch)" }
    if index == 6 { return "platform(android)" }
    if index == 7 { return "platform(web)" }
    if index == 8 { return "platform(beos)" }
    if index == 9 { return "mood(happy)" }
    if index == 10 { return "theme(dark" }
    return "density()"
}

// Pieces that damage inserts anywhere: whole constructs, their openers and
// closers, and single bytes that change how the text around them reads.
Fragments :: 40;
Fragment :: (index: s32) -> string {
    if index == 0 { return "{" }
    if index == 1 { return "}" }
    if index == 2 { return ";" }
    if index == 3 { return ":" }
    if index == 4 { return "\"" }
    if index == 5 { return "/*" }
    if index == 6 { return "*/" }
    if index == 7 { return "//" }
    if index == 8 { return "\n" }
    if index == 9 { return "@" }
    if index == 10 { return "#" }
    if index == 11 { return "[" }
    if index == 12 { return "]" }
    if index == 13 { return "(" }
    if index == 14 { return ")" }
    if index == 15 { return "@import <base>;" }
    if index == 16 { return "@import \"other\";" }
    if index == 17 { return "@layer app;" }
    if index == 18 { return "@layer reset, components, app, overrides, extra;" }
    if index == 19 { return "@pack again;" }
    if index == 20 { return "@version 1;" }
    if index == 21 { return "@version 99;" }
    if index == 22 { return "@theme dark { accent: #ff0000; }" }
    if index == 23 { return "@theme " }
    if index == 24 { return "@env density(compact) { Button { gap: 2; } }" }
    if index == 25 { return "@env " }
    if index == 26 { return "@variant dense \"Dense\" { Button { radius: 0; } }" }
    if index == 27 { return "@variant " }
    if index == 28 { return "@media (min-width: 10px) { a { b: c; } }" }
    if index == 29 { return "@keyframes spin { from { x: 0; } }" }
    if index == 30 { return "tokens { color { accent: #123456; } }" }
    if index == 31 { return "tokens {" }
    if index == 32 { return "Button { background: accent; }" }
    if index == 33 { return "Button[tone=Accent]:hover { }" }
    if index == 34 { return "Button " }
    if index == 35 { return "\\" }
    if index == 36 { return "\xc3\xa9" }
    if index == 37 { return "\x7f" }
    if index == 38 { return "\x00" }
    return "   \t  "
}

AppendSelector :: () {
    Append(KindName(Below(Kinds)))
    count: s32 = Below(3)
    while count > 0 {
        Append(AttributeText(Below(Attributes)))
        count -= 1
    }
}

AppendRule :: () {
    AppendSelector()
    if Chance(10) {
        Append(", ")
        AppendSelector()
    }
    Append(" {\n")
    count: s32 = Below(6)
    while count > 0 {
        Append("  ")
        Append(PropertyName(Below(Properties)))
        Append(": ")
        Append(ValueText(Below(Values)))
        if !Chance(3) { Append(";") }
        Append("\n")
        count -= 1
    }
    if !Chance(3) { Append("}\n") }
}

AppendTokens :: () {
    Append("tokens {\n")
    groups: s32 = 1 + Below(3)
    while groups > 0 {
        Append("  ")
        Append(TokenGroupName(Below(TokenGroups)))
        Append(" {\n")
        count: s32 = Below(6)
        while count > 0 {
            Append("    ")
            Append(TokenName(Below(TokenNames)))
            Append(": ")
            Append(ValueText(Below(Values)))
            Append(";\n")
            count -= 1
        }
        Append("  }\n")
        groups -= 1
    }
    Append("}\n")
}

AppendOverlay :: () {
    count: s32 = Below(4)
    while count > 0 {
        Append("  ")
        if Chance(60) {
            Append(TokenName(Below(TokenNames)))
            Append(": ")
            Append(ValueText(Below(Values)))
            Append(";\n")
        } else {
            AppendRule()
        }
        count -= 1
    }
}

AppendConstruct :: () {
    choice: s32 = Below(12)
    if choice < 5 {
        AppendRule()
    } else if choice == 5 {
        AppendTokens()
    } else if choice == 6 {
        Append("@theme ")
        if Chance(80) { Append("dark") } else { Append("sepia") }
        Append(" {\n")
        AppendOverlay()
        Append("}\n")
    } else if choice == 7 {
        Append("@env ")
        Append(EnvQuery(Below(EnvQueries)))
        Append(" {\n")
        AppendOverlay()
        Append("}\n")
    } else if choice == 8 {
        Append("@variant ")
        if Chance(50) { Append("dense") } else { Append("roomy") }
        Append(" \"Label\" {\n")
        AppendOverlay()
        Append("}\n")
    } else if choice == 9 {
        if Chance(50) {
            Append("@layer ")
            Append(KindName(Below(Kinds)))
            Append(";\n")
        } else {
            Append("@layer reset, app;\n")
        }
    } else if choice == 10 {
        if Chance(50) { Append("@import <base>;\n") } else { Append("@import <loop>;\n") }
    } else {
        Append("/* ")
        Append(Fragment(Below(Fragments)))
        Append(" */\n")
    }
}

// A random sheet assembled from the grammar. Most of it is valid; a few
// choices (unknown names, missing semicolons and braces, odd values) are not.
Generate :: () {
    input_length = 0
    if Chance(80) {
        Append("@pack fuzz;\n")
    }
    if Chance(30) {
        Append("@version 1;\n")
    }
    count: s32 = Below(24)
    while count > 0 {
        AppendConstruct()
        if Chance(20) { Append("\n") }
        count -= 1
    }
}

// ------------------------------------------------------------------ valid sheets

// A sheet made only of valid pieces, so the parser accepts it and the
// formatted text can be compared with it rule by rule.
ValidColor :: () -> string {
    choice: s32 = Below(7)
    if choice == 0 { return "#112233" }
    if choice == 1 { return "#11223344" }
    if choice == 2 { return "transparent" }
    if choice == 3 { return "accent" }
    if choice == 4 { return "ink" }
    if choice == 5 { return "#ffffff" }
    return "surface"
}

ValidLength :: () -> string {
    choice: s32 = Below(7)
    if choice == 0 { return "0" }
    if choice == 1 { return "12" }
    if choice == 2 { return "2.5" }
    if choice == 3 { return "space.2" }
    if choice == 4 { return "corner" }
    if choice == 5 { return "-4" }
    return "1000"
}

AppendPair :: (name: string, value: string) {
    Append(name)
    Append(value)
}

AppendValidProperty :: () {
    choice: s32 = Below(17)
    if choice == 0 { AppendPair("background: ", ValidColor()) }
    else if choice == 1 { AppendPair("foreground: ", ValidColor()) }
    else if choice == 2 { AppendPair("border: ", ValidColor()) }
    else if choice == 3 { AppendPair("focus: ", ValidColor()) }
    else if choice == 4 { AppendPair("background-end: ", ValidColor()) }
    else if choice == 5 { AppendPair("border-width: ", ValidLength()) }
    else if choice == 6 { AppendPair("radius: ", ValidLength()) }
    else if choice == 7 { AppendPair("padding-x: ", ValidLength()) }
    else if choice == 8 { AppendPair("padding-y: ", ValidLength()) }
    else if choice == 9 { AppendPair("gap: ", ValidLength()) }
    else if choice == 10 { AppendPair("font-size: ", ValidLength()) }
    else if choice == 11 { AppendPair("icon-size: ", ValidLength()) }
    else if choice == 12 { AppendPair("offset-x: ", ValidLength()) }
    else if choice == 13 { AppendPair("letter-spacing: ", ValidLength()) }
    else if choice == 14 {
        Append("opacity: ")
        if Chance(50) { Append("0.5") } else { Append("1") }
    } else if choice == 15 {
        Append("material: ")
        if Chance(50) { Append("Flat") } else { Append("default") }
    } else {
        Append("typeface: ")
        if Chance(50) { Append("body") } else { Append("mono") }
    }
    Append(";")
}

AppendValidRule :: (indent: string) {
    Append(indent)
    Append(KindName(Below(22)))
    attributes: s32 = Below(3)
    while attributes > 0 {
        Append(AttributeText(Below(10)))
        attributes -= 1
    }
    Append(" {")
    count: s32 = Below(5)
    while count > 0 {
        if Chance(50) {
            Append("\n  ")
            Append(indent)
        } else {
            Append(" ")
        }
        AppendValidProperty()
        count -= 1
    }
    if Chance(50) {
        Append("\n")
        Append(indent)
    } else {
        Append(" ")
    }
    Append("}\n")
}

AppendValidOverlay :: () {
    choice: s32 = Below(4)
    if choice == 0 { AppendPair("  accent: ", ValidColor()) }
    else if choice == 1 { Append("  ink: #000000") }
    else if choice == 2 { AppendPair("  space.2: ", ValidLength()) }
    else { Append("  corner: 3") }
    Append(";\n")
}

// Labels are quoted text, so structure bytes inside them are only text.
VariantLabel :: () -> string {
    choice: s32 = Below(6)
    if choice == 0 { return "\"Dense\"" }
    if choice == 1 { return "\"a; b\"" }
    if choice == 2 { return "\"{ open\"" }
    if choice == 3 { return "\"close }\"" }
    if choice == 4 { return "\"/* not a comment\"" }
    return "\"// nor this\""
}

AppendComment :: () {
    choice: s32 = Below(4)
    if choice == 0 { Append("/* a comment */\n") }
    else if choice == 1 { Append("// a line comment\n") }
    else if choice == 2 { Append("/* a comment\n   over lines */\n") }
    else { Append("/**/\n") }
}

GenerateValid :: () {
    input_length = 0
    Append("@pack fuzz;\n")
    if Chance(50) { Append("@version 1;\n") }
    Append("tokens {\n")
    Append("  color {\n    accent: #3b609b;\n    ink: #171717;\n    surface: #e6e3dc;\n  }\n")
    Append("  length {\n    space.2: 8;\n    corner: 4;\n  }\n")
    Append("  material {\n    default: Flat;\n  }\n")
    Append("}\n")
    count: s32 = Below(16)
    while count > 0 {
        choice: s32 = Below(12)
        if choice < 6 {
            AppendValidRule("")
        } else if choice == 6 {
            Append("@theme dark {\n")
            AppendValidOverlay()
            Append("}\n")
        } else if choice == 7 {
            Append("@env ")
            Append(EnvQuery(Below(8)))
            Append(" {\n")
            if Chance(50) { AppendValidOverlay() } else { AppendValidRule("  ") }
            Append("}\n")
        } else if choice == 8 {
            Append("@variant dense ")
            Append(VariantLabel())
            if Chance(50) {
                // One line, which the formatter reflows.
                Append(" { Button { gap: 1; } }\n")
            } else {
                Append(" {\n")
                AppendValidRule("  ")
                Append("}\n")
            }
        } else if choice == 9 {
            if Chance(50) { Append("@layer app;\n") } else { Append("@layer components;\n") }
        } else if choice == 10 {
            AppendComment()
        } else {
            Append("@import <base>;\n")
        }
        if Chance(15) { Append("\n") }
        count -= 1
    }
}

RandomPosition :: () -> s32 {
    return Below(input_length + 1)
}

// One random change to the input.
Damage :: () {
    kind: s32 = Below(9)
    if kind == 0 && input_length > 0 {
        input_bytes[Below(input_length)] = cast(u8)Below(256)
    } else if kind == 1 && input_length > 0 {
        // Nearby punctuation reads as structure; swap it in.
        at: s32 = Below(input_length)
        input_bytes[at] = Fragment(Below(15))[0]
    } else if kind == 2 {
        at: s32 = RandomPosition()
        Replace(at, at, Fragment(Below(Fragments)))
    } else if kind == 3 {
        start: s32 = RandomPosition()
        end: s32 = start + Below(64)
        if end > input_length { end = input_length }
        Replace(start, end, "")
    } else if kind == 4 && input_length > 0 {
        // Repeat a range, so tables fill up.
        start: s32 = Below(input_length)
        length: s32 = 1 + Below(512)
        if start + length > input_length { length = input_length - start }
        copies: s32 = 1 + Below(40)
        copy: [512]u8
        index: s32 = 0
        while index < length {
            copy[index] = input_bytes[start + index]
            index += 1
        }
        at: s32 = start + length
        while copies > 0 {
            Replace(at, at, TextView(copy[0:length]))
            copies -= 1
        }
    } else if kind == 5 {
        input_length = RandomPosition()
    } else if kind == 6 && pack_count > 0 {
        // Splice a range of a pack in.
        pack: string = Pack(Below(pack_count))
        start: s32 = Below(cast(s32)pack.count)
        end: s32 = start + Below(2048)
        if end > cast(s32)pack.count { end = cast(s32)pack.count }
        at: s32 = RandomPosition()
        Replace(at, at, pack[start:end])
    } else if kind == 7 {
        // A whole generated construct goes in front of the tail.
        at: s32 = RandomPosition()
        tail_length: s32 = input_length - at
        index: s32 = 0
        while index < tail_length {
            scratch_bytes[index] = input_bytes[at + index]
            index += 1
        }
        input_length = at
        AppendConstruct()
        index = 0
        while index < tail_length && input_length < InputCapacity {
            input_bytes[input_length] = scratch_bytes[index]
            input_length += 1
            index += 1
        }
    } else {
        at: s32 = RandomPosition()
        Replace(at, at, "\n")
    }
}

// ------------------------------------------------------------------ imports

// The text an import name resolves to. It depends only on the name, so the
// original and formatted sheets see the same imports.
ImportSource :: (name: KssName) -> string {
    hash: u32 = 2166136261
    index: s32 = 0
    while index < name.length && index < 64 {
        hash = (hash ^ cast(u32)name.bytes[index]) * 16777619
        index += 1
    }
    choice: u32 = hash % 6
    if choice == 0 { return "" }
    if choice == 1 { return "tokens { color { accent: #334455; } }\nButton { background: accent; }\n" }
    if choice == 2 { return "@import <loop>;\nText { foreground: #000000; }\n" }
    if choice == 3 { return "@import <deeper>;\n" }
    if choice == 4 { return "Card { radius: 4; gap: space.2; }\n@theme dark { accent: #000000; }\n" }
    return "Button { background: #00000"
}

// Import names live here for the rest of the parse that uses them.
import_names: [64]KssName;

ImportName :: (slot: s32, name: KssName) -> string {
    import_names[slot] = name
    length: s32 = name.length
    if length < 0 { length = 0 }
    if length > 64 { length = 64 }
    return TextView(import_names[slot].bytes[0:length])
}

ImportFails :: (name: KssName) -> bool {
    return name.length > 0 && name.bytes[0] == cast(u8)120
}

// ------------------------------------------------------------------ parsing

RuleCapacity :: 2048;

// What one parse produced, for comparing two parses.
Outcome :: struct {
    status: s32
    steps: s32
    rule_count: s32
    token_count: s32
    declaration_count: s32
    foreign_count: s32
    variant_count: s32
    variants: [8]KssVariantDecl
}

rules_first: [RuleCapacity]StyleRule;
rules_second: [RuleCapacity]StyleRule;
tokens_first: [128]KssToken;
tokens_second: [128]KssToken;

// Parser tables stay inside their bounds after every step.
CheckParser :: (p: KssParser) {
    Check(p.cursor.pos >= 0 && p.cursor.pos <= cast(s32)p.cursor.source.count,
        "cursor left its source")
    Check(p.file_count >= 1 && p.file_count <= 8, "file count out of range")
    Check(p.cursor.file >= 0 && p.cursor.file < p.file_count, "cursor file out of range")
    Check(p.import_depth >= 0 && p.import_depth <= 8, "import depth out of range")
    Check(p.token_count >= 0 && p.token_count <= 128, "token count out of range")
    Check(p.layer_count >= 0 && p.layer_count <= 12, "layer count out of range")
    Check(p.theme_count >= 0 && p.theme_count <= 16, "theme count out of range")
    Check(p.variant_count >= 0 && p.variant_count <= 8, "variant count out of range")
    Check(p.block_count >= 0 && p.block_count <= 32, "block count out of range")
    Check(p.declaration_count >= 0 && p.declaration_count <= 1024,
        "declaration count out of range")
    Check(p.foreign_count >= 0 && p.foreign_count <= 16, "foreign count out of range")
    Check(p.diagnostic_length >= 0 && p.diagnostic_length <= 256,
        "diagnostic length out of range")
    Check(p.status >= cast(s32)KssStatusContinue && p.status <= cast(s32)KssStatusError,
        "unknown parser status")
}

// Parses source to the end, answering imports by name. The step limit is
// generous: every step either consumes source or finishes an import.
Parse :: (source: string, declarative: bool, rules: []StyleRule, tokens: []KssToken) -> Outcome {
    outcome: Outcome
    environment: KssEnvironment = KssDefaultEnvironment()
    p: KssParser
    if declarative {
        p = KssBeginDeclarative(source, "fuzz.kss", environment)
    } else {
        p = KssBegin(source, "fuzz.kss", environment)
    }
    imports: s32 = 0
    limit: s32 = cast(s32)source.count * 2 + 4096
    while p.status != cast(s32)KssStatusDone && p.status != cast(s32)KssStatusError {
        Check(outcome.steps < limit, "the parser does not finish")
        if p.status == cast(s32)KssStatusNeedImport {
            imports += 1
            Check(imports <= 64, "the parser keeps asking for imports")
            if ImportFails(p.pending_import) {
                p = KssFailImport(p)
            } else {
                p = KssProvideImport(p, ImportSource(p.pending_import),
                    ImportName(imports - 1, p.pending_import))
            }
        } else {
            p = KssStep(p)
        }
        outcome.steps += 1
        CheckParser(p)
        if p.status == cast(s32)KssStatusRule {
            if outcome.rule_count < RuleCapacity {
                rules[outcome.rule_count] = p.rule
            }
            outcome.rule_count += 1
        }
    }
    if p.status == cast(s32)KssStatusError {
        Check(p.diagnostic_length > 0, "an error without a diagnostic")
        if verbose {
            WriteText(2, "error: ")
            WriteText(2, TextView(p.diagnostic[0:p.diagnostic_length]))
            WriteText(2, "\n")
        }
    }
    outcome.status = p.status
    outcome.token_count = p.token_count
    outcome.declaration_count = p.declaration_count
    outcome.foreign_count = p.foreign_count
    outcome.variant_count = p.variant_count
    index: s32 = 0
    while index < p.token_count {
        tokens[index] = p.tokens[index]
        index += 1
    }
    index = 0
    while index < p.variant_count && index < 8 {
        outcome.variants[index] = p.variants[index]
        index += 1
    }
    return outcome
}

// The rule table path: the same parser behind the table an app installs.
ParseTable :: (source: string) {
    table: StyleRulesParse = BeginStyleRules(source, "fuzz.kss", KssDefaultEnvironment())
    imports: s32 = 0
    while true {
        table = ParseStyleRules(table)
        if table.overflow || table.parser.status != cast(s32)KssStatusNeedImport { break }
        imports += 1
        Check(imports <= 64, "the rule table keeps asking for imports")
        if ImportFails(table.parser.pending_import) {
            table = FailStyleRulesImport(table)
        } else {
            table = ProvideStyleRulesImport(table,
                ImportSource(table.parser.pending_import),
                ImportName(imports - 1, table.parser.pending_import))
        }
    }
    Check(table.rules.count >= 0 && table.rules.count <= 320, "rule table count out of range")
}

SameFloat :: (a: float32, b: float32) -> bool {
    return a == b || (a != a && b != b)
}

SameSelector :: (a: StyleSelector, b: StyleSelector) -> bool {
    return a.kind == b.kind && a.name == b.name && a.class_name == b.class_name &&
        a.role == b.role && a.tone == b.tone && a.emphasis == b.emphasis &&
        a.size == b.size && a.state == b.state && a.validation == b.validation &&
        a.orientation == b.orientation && a.placement == b.placement
}

SameStyle :: (a: StyleData, b: StyleData) -> bool {
    return a.fields == b.fields && a.background == b.background &&
        a.foreground == b.foreground && a.border == b.border && a.focus == b.focus &&
        SameFloat(a.radius, b.radius) && SameFloat(a.border_width, b.border_width) &&
        SameFloat(a.opacity, b.opacity) && SameFloat(a.padding_x, b.padding_x) &&
        SameFloat(a.padding_y, b.padding_y) && SameFloat(a.gap, b.gap) &&
        SameFloat(a.font_size, b.font_size) && SameFloat(a.icon_size, b.icon_size) &&
        SameFloat(a.offset_x, b.offset_x) && SameFloat(a.offset_y, b.offset_y) &&
        a.background_end == b.background_end && a.material == b.material &&
        a.typeface == b.typeface && SameFloat(a.letter_spacing, b.letter_spacing)
}

SameRule :: (a: StyleRule, b: StyleRule) -> bool {
    return SameSelector(a.selector, b.selector) && a.state == b.state &&
        a.layer == b.layer && a.order == b.order && SameStyle(a.style, b.style)
}

SameToken :: (a: KssToken, b: KssToken) -> bool {
    if a.name.length != b.name.length || a.kind != b.kind || a.color != b.color ||
        !SameFloat(a.number, b.number) || a.material != b.material ||
        a.origin != b.origin {
        return false
    }
    index: s32 = 0
    while index < a.name.length && index < 64 {
        if a.name.bytes[index] != b.name.bytes[index] { return false }
        index += 1
    }
    return true
}

// ------------------------------------------------------------------ formatting

FormattedCapacity :: 262144;
formatted_first: [FormattedCapacity]u8;
formatted_second: [FormattedCapacity]u8;

// Joins the formatter's segments into text. Returns -1 when it does not fit.
Stitch :: (source: string, result: KssFormatResult, output: []u8) -> s32 {
    length: s32 = 0
    capacity: s32 = cast(s32)output.count
    Check(result.count >= 0 && result.count <= 1024, "segment count out of range")
    index: s32 = 0
    while index < result.count {
        segment: KssFormatSegment = result.segments[index]
        if segment.kind == 0 {
            Check(segment.start >= 0 && segment.length >= 0 &&
                segment.start + segment.length <= cast(s32)source.count,
                "a copy segment leaves the source")
            if length + segment.length > capacity { return -1 }
            at: s32 = 0
            while at < segment.length {
                output[length] = source[segment.start + at]
                length += 1
                at += 1
            }
        } else if segment.kind == 1 {
            if length + 1 > capacity { return -1 }
            output[length] = segment.atom
            length += 1
        } else {
            Check(segment.kind == 2, "unknown segment kind")
            Check(segment.length >= 0 && segment.length <= 4096, "indent out of range")
            if length + 1 + segment.length > capacity { return -1 }
            output[length] = 10
            length += 1
            at: s32 = 0
            while at < segment.length {
                output[length] = 32
                length += 1
                at += 1
            }
        }
        index += 1
    }
    return length
}

// Check mode explains a sheet: the formatted text and both parses.
verbose: bool = false;

WriteOutcome :: (outcome: Outcome) {
    WriteText(2, "status ")
    WriteNumber(2, cast(s64)outcome.status)
    WriteText(2, ", ")
    WriteNumber(2, cast(s64)outcome.rule_count)
    WriteText(2, " rules, ")
    WriteNumber(2, cast(s64)outcome.token_count)
    WriteText(2, " tokens, ")
    WriteNumber(2, cast(s64)outcome.declaration_count)
    WriteText(2, " declarations, ")
    WriteNumber(2, cast(s64)outcome.foreign_count)
    WriteText(2, " foreign blocks\n")
}

IsSpace :: (byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

// True when a and b hold the same bytes apart from whitespace.
SameText :: (a: string, b: string) -> bool {
    left: s32 = 0
    right: s32 = 0
    while true {
        while left < cast(s32)a.count && IsSpace(a[left]) { left += 1 }
        while right < cast(s32)b.count && IsSpace(b[right]) { right += 1 }
        if left >= cast(s32)a.count || right >= cast(s32)b.count {
            return left >= cast(s32)a.count && right >= cast(s32)b.count
        }
        if a[left] != b[right] { return false }
        left += 1
        right += 1
    }
    return false
}

SameName :: (a: KssName, b: KssName) -> bool {
    if a.length != b.length { return false }
    index: s32 = 0
    while index < a.length && index < 64 {
        if a.bytes[index] != b.bytes[index] { return false }
        index += 1
    }
    return true
}

SameOutcome :: (a: Outcome, b: Outcome) -> bool {
    if a.status != b.status || a.rule_count != b.rule_count ||
        a.token_count != b.token_count || a.declaration_count != b.declaration_count ||
        a.foreign_count != b.foreign_count || a.variant_count != b.variant_count {
        return false
    }
    // Variant labels are quoted text the formatter must leave alone.
    index: s32 = 0
    while index < a.variant_count && index < 8 {
        if !SameName(a.variants[index].name, b.variants[index].name) ||
            !SameName(a.variants[index].label, b.variants[index].label) {
            return false
        }
        index += 1
    }
    return true
}

// Formatting may refuse a sheet, but what it produces must parse like the
// original and must not change when formatted again.
CheckFormat :: (source: string, typed: Outcome) {
    first: KssFormatResult = KssFormat(source)
    if !first.ok {
        if verbose {
            WriteText(2, "the formatter declines: ")
            WriteText(2, TextView(first.diagnostic[0:first.diagnostic_length]))
            WriteText(2, "\n")
        }
        Check(first.diagnostic_length > 0 && first.diagnostic_length <= 128,
            "a format failure without a diagnostic")
        return
    }
    length: s32 = Stitch(source, first, formatted_first[:])
    if length < 0 { return }
    formatted: string = TextView(formatted_first[0:length])
    Check(SameText(source, formatted), "formatting changed more than whitespace")

    again: Outcome = Parse(formatted, false, rules_second[:], tokens_second[:])
    if verbose {
        WriteText(2, "formatted sheet:\n")
        WriteText(2, formatted)
        WriteText(2, "\noriginal: ")
        WriteOutcome(typed)
        WriteText(2, "formatted: ")
        WriteOutcome(again)
    }
    if typed.status == cast(s32)KssStatusDone || again.status == cast(s32)KssStatusDone {
        compared_count += 1
        Check(SameOutcome(typed, again), "formatting changed what the sheet means")
        index: s32 = 0
        while index < typed.rule_count && index < RuleCapacity {
            Check(SameRule(rules_first[index], rules_second[index]),
                "formatting changed a rule")
            index += 1
        }
        index = 0
        while index < typed.token_count {
            Check(SameToken(tokens_first[index], tokens_second[index]),
                "formatting changed a token")
            index += 1
        }
        declarative: Outcome = Parse(source, true, rules_second[:], tokens_second[:])
        formatted_declarative: Outcome = Parse(formatted, true, rules_second[:], tokens_second[:])
        Check(SameOutcome(declarative, formatted_declarative),
            "formatting changed the declarations")
    }

    second: KssFormatResult = KssFormat(formatted)
    Check(second.ok, "the formatter rejects its own output")
    second_length: s32 = Stitch(formatted, second, formatted_second[:])
    if second_length < 0 { return }
    if verbose {
        WriteText(2, "formatted again:\n")
        WriteText(2, TextView(formatted_second[0:second_length]))
        WriteText(2, "\n")
    }
    Check(second_length == length, "formatting twice changes the length")
    index: s32 = 0
    while index < length {
        Check(formatted_first[index] == formatted_second[index], "formatting twice changes the text")
        index += 1
    }
}

// ------------------------------------------------------------------ cases

current_path: [4096]u8;
current_path_length: s32 = 0;
saving: bool = true;

RunCase :: () {
    if saving { SaveInput(TextView(current_path[0:current_path_length])) }
    source: string = Input()
    typed: Outcome = Parse(source, false, rules_first[:], tokens_first[:])
    if verbose {
        WriteText(2, "parsed: ")
        WriteOutcome(typed)
    }
    if typed.status == cast(s32)KssStatusDone { parsed_count += 1 }
    last_status = typed.status
    Parse(source, true, rules_second[:], tokens_second[:])
    ParseTable(source)
    CheckFormat(source, typed)
}

MakeCase :: () {
    if Chance(40) {
        GenerateValid()
        // Now and then one change, which may or may not keep it valid.
        if Chance(20) { Damage() }
        return
    }
    if pack_count == 0 || Chance(50) {
        Generate()
        damage: s32 = Below(4)
        while damage > 0 {
            Damage()
            damage -= 1
        }
        return
    }
    pack: string = Pack(Below(pack_count))
    input_length = 0
    Append(pack)
    damage: s32 = 1 + Below(8)
    while damage > 0 {
        Damage()
        damage -= 1
    }
}

// ------------------------------------------------------------------ shrinking

backup_bytes: [InputCapacity]u8;

// Runs the checks on the input in a child process, whose output goes nowhere,
// and returns its wait status: 0 when every check passes.
CaseStatus :: () -> s32 {
    pid: s32 = RawFork()
    Check(pid >= 0, "cannot fork")
    if pid == 0 {
        nowhere: [16]u8
        descriptor: s32 = -1
        if CopyCString("/dev/null", nowhere[:]) {
            descriptor = RawOpen(*nowhere[0], 1)
        }
        if descriptor >= 0 {
            RawDup2(descriptor, 1)
            RawDup2(descriptor, 2)
        }
        saving = false
        verbose = false
        shrinking = true
        RunCase()
        RawExit(0)
    }
    status: s32 = 0
    RawWaitPid(pid, *status, 0)
    return status
}

// Removes ever smaller ranges while the sheet keeps failing the same way.
Shrink :: (failure: s32) {
    chunk: s32 = input_length / 2
    if chunk < 1 { chunk = 1 }
    while chunk >= 1 {
        progress: bool = false
        at: s32 = 0
        while at < input_length {
            end: s32 = at + chunk
            if end > input_length { end = input_length }
            kept: s32 = input_length
            index: s32 = 0
            while index < kept {
                backup_bytes[index] = input_bytes[index]
                index += 1
            }
            Replace(at, end, "")
            if CaseStatus() == failure {
                progress = true
            } else {
                index = 0
                while index < kept {
                    input_bytes[index] = backup_bytes[index]
                    index += 1
                }
                input_length = kept
                at += chunk
            }
        }
        if !progress { chunk = chunk / 2 }
    }
}

ParseNumber :: (text: string) -> s64 {
    value: s64 = 0
    index: s32 = 0
    if text.count == 0 { return -1 }
    while index < cast(s32)text.count {
        byte: u8 = text[index]
        if byte < 48 || byte > 57 || value > 100000000000 { return -1 }
        value = value * 10 + cast(s64)(byte - 48)
        index += 1
    }
    return value
}

Usage :: () {
    WriteText(2, "usage: kss_fuzz CURRENT SEED COUNT PACK...\n")
    WriteText(2, "       kss_fuzz CURRENT check FILE\n")
    WriteText(2, "       kss_fuzz CURRENT corpus FILE...\n")
    WriteText(2, "       kss_fuzz CURRENT shrink FILE\n")
}

#program_export
main :: (argc: s32, argv: **s8) -> s32 {
    if argc < 4 {
        Usage()
        return 2
    }
    current: string = TextFromCString(cast(*u8)argv[1])
    if current.count == 0 || current.count >= 4096 {
        Usage()
        return 2
    }
    index: s32 = 0
    while index < cast(s32)current.count {
        current_path[index] = current[index]
        index += 1
    }
    current_path_length = cast(s32)current.count

    mode: string = TextFromCString(cast(*u8)argv[2])
    if mode == "check" {
        if argc != 4 {
            Usage()
            return 2
        }
        Check(LoadInput(TextFromCString(cast(*u8)argv[3])), "cannot read FILE")
        verbose = true
        RunCase()
        WriteText(1, "kss fuzz: the sheet passes every check\n")
        return 0
    }
    if mode == "corpus" {
        argument: s32 = 3
        while argument < argc {
            path: string = TextFromCString(cast(*u8)argv[argument])
            case_index = argument - 3
            if !LoadInput(path) {
                WriteText(2, "kss fuzz: cannot read ")
                WriteText(2, path)
                WriteText(2, "\n")
                return 2
            }
            RunCase()
            if path.count > 7 && path[path.count - 7:path.count] == ".ok.kss" &&
                last_status != cast(s32)KssStatusDone {
                WriteText(2, path)
                WriteText(2, "\n")
                Fail("a sheet named .ok.kss does not parse")
            }
            argument += 1
        }
        WriteText(1, "kss fuzz: ")
        WriteNumber(1, cast(s64)(argc - 3))
        WriteText(1, " corpus sheets passed\n")
        return 0
    }
    if mode == "shrink" {
        if argc != 4 {
            Usage()
            return 2
        }
        Check(LoadInput(TextFromCString(cast(*u8)argv[3])), "cannot read FILE")
        failure: s32 = CaseStatus()
        if failure == 0 {
            WriteText(1, "kss fuzz: the sheet passes every check; nothing to shrink\n")
            return 0
        }
        Shrink(failure)
        SaveInput(TextView(current_path[0:current_path_length]))
        WriteNumber(1, cast(s64)input_length)
        WriteText(1, " bytes still fail:\n")
        WriteText(1, Input())
        WriteText(1, "\n")
        return 0
    }

    seed: s64 = ParseNumber(mode)
    count: s64 = ParseNumber(TextFromCString(cast(*u8)argv[3]))
    if seed < 0 || count < 0 {
        Usage()
        return 2
    }
    argument: s32 = 4
    while argument < argc {
        path: string = TextFromCString(cast(*u8)argv[argument])
        if !LoadPack(path) {
            WriteText(2, "kss fuzz: cannot read pack ")
            WriteText(2, path)
            WriteText(2, "\n")
            return 2
        }
        argument += 1
    }
    case_seed = seed
    SeedRandom(seed)
    while cast(s64)case_index < count {
        MakeCase()
        RunCase()
        case_index += 1
    }
    WriteText(1, "kss fuzz: ")
    WriteNumber(1, count)
    WriteText(1, " sheets from seed ")
    WriteNumber(1, seed)
    WriteText(1, " passed; ")
    WriteNumber(1, parsed_count)
    WriteText(1, " parsed without error, ")
    WriteNumber(1, compared_count)
    WriteText(1, " compared with their formatted text\n")
    return 0
}
