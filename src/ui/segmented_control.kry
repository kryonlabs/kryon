#module "segmented_control_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/segmented_control.h"
#import "runtime/style.h"
#import "runtime/style_sheet.h"

SegmentedControlFrame :: (control: SegmentedControlProps,
kind: i32) -> StyleFrame {
    button: ButtonProps
    button.tone = ButtonToneNeutral
    button.emphasis = ButtonEmphasisSoft
    button.size = ControlSizeMedium
    button.class_name = control.class_name
    return ui_control_style_frame_kind(button, ButtonStateNormal,
    0, 0.0, 0.0, 0.0, kind)
}

SegmentedControlFont :: (frame: StyleFrame) -> i32 {
    return ResolveFont(0, StyleFontValue(frame.value.fields,
    frame.value.font_size), GetSmallFontSize())
}

SegmentedControlMetrics :: (control: SegmentedControlProps) -> SegmentedMetrics {
    container: StyleFrame = SegmentedControlFrame(control,
    StyleKindSegmentedControl())
    item: StyleFrame = SegmentedControlFrame(control, StyleKindSegment())
    return SegmentedDefaultMetrics(control.height, control.min_item_width,
    control.max_item_width, (float)Scale(1000) / 1000.0,
    container, item)
}

SegmentedControlItemWidth :: (control: SegmentedControlProps,
option: const SegmentOption*, font: i32) -> i32 {
    label: const char* = ""
    if option != nil && option->label != nil { label = option->label }
    label_width: i32 = TextWidth(label, font)
    measure_control: SegmentedControlProps
    measure_control.class_name = control.class_name
    measure_control.min_item_width = control.min_item_width
    measure_control.max_item_width = control.max_item_width
    metrics: SegmentedMetrics = SegmentedControlMetrics(measure_control)
    return SegmentedItemWidth(label_width, metrics)
}

GetSegmentedControlHeight :: (control: SegmentedControlProps) -> i32 #export {
    frame: StyleFrame = SegmentedControlFrame(control, StyleKindSegment())
    font: i32 = SegmentedControlFont(frame)
    metrics: SegmentedMetrics = SegmentedControlMetrics(control)
    if control.options == nil || control.option_count <= 0 ||
    metrics.row_height <= 0 { return 0 }
    if control.bounds.width <= 0 || !control.wrap { return metrics.row_height }
    row_width: i32 = 0
    rows: i32 = 1
    index: i32 = 0
    while index < control.option_count {
        item_width: i32 = SegmentedControlItemWidth(control,
        &control.options[index], font)
        advance: SegmentedRowAdvance = SegmentedRowAdvanceFor(true,
        row_width, 0, item_width, (int)control.bounds.width, metrics)
        if advance.wrap_before { rows += 1 }
        row_width = advance.row_width
        index += 1
    }
    return SegmentedHeightForRows(rows, metrics.row_height, metrics.gap)
}

SegmentedControl :: (control: SegmentedControlProps) -> SegmentedControlResult #export {
    result: SegmentedControlResult
    frame: StyleFrame = SegmentedControlFrame(control, StyleKindSegment())
    font: i32 = SegmentedControlFont(frame)
    metrics: SegmentedMetrics = SegmentedControlMetrics(control)
    row_start: i32 = 0
    row_width: i32 = 0
    row_count: i32 = 0
    row_y: i32 = (int)control.bounds.y
    selected: i32 = -1
    if control.selected_index != nil { selected = *control.selected_index }
    result.selected_index = selected
    result.clicked_index = -1
    result.height = GetSegmentedControlHeight(control)
    if control.options == nil || control.option_count <= 0 ||
    control.bounds.width <= 0 || metrics.row_height <= 0 { return result }

    index: i32 = 0
    while index <= control.option_count {
        end_row: bool = index == control.option_count
        advance: SegmentedRowAdvance
        if !end_row {
            item_width: i32 = SegmentedControlItemWidth(control,
            &control.options[index], font)
            advance = SegmentedRowAdvanceFor(control.wrap != 0, row_width,
            row_count, item_width, (int)control.bounds.width, metrics)
            if !advance.wrap_before {
                row_width = advance.row_width
                row_count = advance.row_count
                index += 1
                continue
            }
        }

        if row_count > 0 {
            row: SegmentedRow = SegmentedRowFor(control.bounds.x,
            control.bounds.width, row_y, row_start, row_count, row_width,
            control.wrap != 0, metrics)
            button_width: i32 = row.button_width
            item_x: i32 = row.x
            row_item: i32 = 0
            while row_item < row_count {
                item_index: i32 = row_start + row_item
                option: const SegmentOption* = &control.options[item_index]
                focus_id: i32 = SegmentedFocusIdFor(control.id, item_index)
                selected_item: bool = item_index == selected
                button: ButtonSpec
                button.props.bounds = (Rectangle){(float)item_x,
                    (float)row_y, (float)button_width, (float)metrics.row_height}
                button.props.label = option->label
                button.style.normal.font_size = (float)font
                button.style.normal.fields |= StyleFontSize
                button.props.id = focus_id
                button.props.disabled = option->disabled
                button.props.tone = selected_item
                ? ButtonToneAccent : ButtonToneNeutral
                button.props.emphasis = ButtonEmphasisSoft
                button.props.selected = selected_item
                button.props.class_name = control.class_name
                button.style_kind = StyleKindSegment()
                button.style_resolved = 1
                if ui_button_render(button) {
                    selection: SegmentedSelectionResult =
                    SegmentedSelectionFor(selected, item_index,
                    control.selected_index != nil)
                    result.clicked_index = item_index
                    result.selected_index = selection.selected_index
                    result.changed |= selection.changed
                    if selection.changed && control.selected_index != nil {
                        *control.selected_index = selection.selected_index
                    }
                    selected = selection.selected_index
                }
                item_x += button_width + metrics.gap
                row_item += 1
            }
            row_y += metrics.row_height + metrics.gap
        }

        if end_row {
            row_width = 0
            row_count = 0
        } else {
            row_start = index
            row_width = advance.row_width
            row_count = advance.row_count
        }
        index += 1
    }
    return result
}
