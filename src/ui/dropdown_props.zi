#import "dropdown"
#import "geometry"
#import "image_props"

DropdownOption :: struct {
    key: u64
    label: string
    image: ImageProps
    disabled: bool
    separator_before: bool
}

DropdownProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    placeholder: string
    selected_index: s32
    highlight_index: s32
    scroll_offset: s32
    open: bool
    focused: bool
    scale: float32
    wheel: float32
    trigger_input: DropdownTriggerInput
    menu_input: DropdownMenuInput
    disabled: bool
}

DropdownResult :: struct {
    node: s32
    selected_index: s32
    highlight_index: s32
    scroll_offset: s32
    open: bool
    changed: bool
    opened: bool
    closed: bool
}
