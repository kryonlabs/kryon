GetProfileImageIconCount :: () -> i32 #export {
    return 28
}

GetProfileImageIconType :: (index: i32) -> IconType #export {
    if index < 0 || index >= GetProfileImageIconCount() {
        return ICON_NONE
    }
    return ProfileIconAt(index).icon
}

GetProfileImageIconName :: (index: i32) -> const char* #export {
    if index < 0 || index >= GetProfileImageIconCount() {
        return nil
    }
    return ProfileIconAt(index).name
}

GetProfileImageIconTypeForSyncID :: (sync_id: i32) -> IconType #export {
    if sync_id == SYNC_PROFILE_ICON_NONE { return ICON_NONE }
    index: i32 = 0
    while index < GetProfileImageIconCount() {
        entry: ProfileIconEntry = ProfileIconAt(index)
        if entry.sync_id == sync_id { return entry.icon }
        index += 1
    }
    return ICON_NONE
}

GetSyncIDForProfileImageIconType :: (icon: IconType) -> i32 #export {
    if icon == ICON_NONE { return SYNC_PROFILE_ICON_NONE }
    index: i32 = 0
    while index < GetProfileImageIconCount() {
        entry: ProfileIconEntry = ProfileIconAt(index)
        if entry.icon == icon { return entry.sync_id }
        index += 1
    }
    return SYNC_PROFILE_ICON_NONE
}

ProfileDrawTexture :: (icon: Texture2D, x: i32,
y: i32, size: i32) {
    if icon.id == 0 || size <= 0 { return }
    image: ImageProps = (ImageProps){0}
    image.bounds = (Rectangle){(float)x, (float)y,
        (float)size, (float)size}
    image.fit = ImageFitStretch
    ImageTextureTinted(icon, image, WHITE)
}

ProfileDrawTextureInCircle :: (icon: Texture2D,
center_x: i32, center_y: i32, radius: i32) {
    size: i32 = radius * 2
    ProfileDrawTexture(icon, center_x - size / 2,
    center_y - size / 2, size)
}

ProfileDrawAvatarTile :: (bounds: Rectangle, style: Style) {
    ui_draw_material(bounds, (Rectangle){0},
    style.background, style.border, style.border,
    style.radius, style.border_width, 0, 0, 0,
    style.focus, 0, style.opacity, ui_style_fill(style),
    style.material)
}

ProfileImagesDarkMode :: () -> i32 {
    if IsThemeColorDark(ui_surface_style().background) {
        return 1
    }
    return 0
}

ProfileDrawFallback :: (x: i32, y: i32,
size: i32, color: Color) {
    center_x: i32 = x + size / 2
    head_radius: i32 = size / 6
    DrawCircle(center_x, y + size / 3,
    (float)head_radius, color)
    DrawCircle(center_x, y + size * 2 / 3,
    (float)(size / 4), color)
    DrawRectangle(x + size / 4, y + size * 2 / 3,
    size / 2, size / 5, color)
}

ProfileText :: (value: const char*) -> const char* {
    if value == nil { return "" }
    return value
}

RenderSidebarAccountHeader :: (header: SidebarAccountHeaderProps) -> SidebarAccountHeaderResult #export {
    result: SidebarAccountHeaderResult =
    (SidebarAccountHeaderResult){0}
    name_font: i32 = GetFontSize()
    small_font: i32 = GetSmallFontSize()
    click_enabled: i32 = header.current_frame == 0 ||
    header.current_frame != header.block_click_frame
    username: const char* = ProfileText(header.username)
    subtitle: const char* = ProfileText(header.subtitle)
    friends_text: const char* = ProfileText(header.friends_text)
    scale: float = (float)GetScale()
    username_width: i32 = ProfileHeaderUsernameHitWidth(
    TextWidth(username, name_font), scale)
    username_height: i32 = ProfileHeaderUsernameHitHeight(
    TextHeight(username, name_font), scale)
    layout: ProfileHeaderLayout = ProfileHeaderLayoutFor(
    header.x, header.y, header.width, header.height,
    header.content_padding_x, username_width,
    username_height, scale)
    icon: Texture2D = header.pfp_icon
    if icon.id == 0 && header.icons != nil &&
    header.pfp_icon_type > ICON_NONE &&
    header.pfp_icon_type < ICON_COUNT {
        icon = header.icons[header.pfp_icon_type]
    }
    result.height = layout.height
    mouse: Vector2 = ui_mouse_world()
    released: i32 = click_enabled &&
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
    surface_style: Style = ui_surface_style()
    text_style: Style = ui_resolve_button_style_kind(
    (ButtonProps){0}, ButtonStateNormal, StyleKindText())
    hover_props: ButtonProps = (ButtonProps){0}
    hover_props.tone = ButtonToneNeutral
    hover_props.emphasis = ButtonEmphasisSoft
    hover_style: Style = ui_resolve_button_style_kind(
    hover_props, ButtonStateHover, StyleKindSelectable())
    muted_text: Color = text_style.foreground
    muted_text.a = ProfileHeaderMutedAlpha(muted_text.a)
    ui_draw_material(layout.header_bounds, (Rectangle){0},
    surface_style.background, surface_style.border,
    surface_style.border, surface_style.radius,
    surface_style.border_width, 0.0, 0.0, 0,
    surface_style.focus, 0.0, surface_style.opacity,
    ui_style_fill(surface_style), surface_style.material)

    profile_action: ProfilePointerAction =
    ProfilePointerActionFromInput(
    CheckCollisionPointRec(mouse, layout.profile_bounds) != 0,
    InputCapturesClick(mouse) != 0,
    HoverEffectsEnabled() != 0, released != 0)
    if profile_action.mark_clickable { MarkClickable() }
    if profile_action.activate {
        if profile_action.consume_release { ConsumeRelease() }
        result.pfp_clicked = 1
    }
    ProfileDrawAvatarTile(layout.avatar_tile_bounds, surface_style)
    if header.pfp_icon_type > ICON_NONE &&
    header.pfp_icon_type < ICON_COUNT {
        DrawProfileImageIcon(header.pfp_icon_type,
        layout.icon_bounds, ProfileImagesDarkMode())
    } else if icon.id != 0 {
        ProfileDrawTextureInCircle(icon, layout.avatar_center_x,
        layout.avatar_center_y, layout.avatar_radius)
    } else {
        ProfileDrawFallback(layout.avatar_center_x -
        layout.avatar_radius,
        layout.avatar_center_y - layout.avatar_radius,
        layout.avatar_size, text_style.foreground)
    }

    username_action: ProfilePointerAction =
    ProfilePointerActionFromInput(
    CheckCollisionPointRec(mouse, layout.username_bounds) != 0,
    InputCapturesClick(mouse) != 0,
    HoverEffectsEnabled() != 0, released != 0)
    if username_action.mark_clickable { MarkClickable() }
    if username_action.activate {
        if username_action.consume_release { ConsumeRelease() }
        result.username_clicked = 1
    }
    DrawFittedTextInRect(username, layout.username_bounds,
    name_font, Text8, text_style.foreground)
    if subtitle[0] != '\0' {
        RenderText(subtitle, layout.name_x,
        ProfileHeaderSubtitleY(layout.name_y, scale),
        small_font, muted_text)
    }

    friends_action: ProfilePointerAction =
    ProfilePointerActionFromInput(
    CheckCollisionPointRec(mouse, layout.friends_bounds) != 0,
    InputCapturesClick(mouse) != 0,
    HoverEffectsEnabled() != 0, released != 0)
    if friends_action.mark_clickable {
        ui_draw_material(layout.friends_bounds,
        layout.header_bounds, hover_style.background,
        hover_style.border, hover_style.border,
        hover_style.radius, hover_style.border_width,
        1.0, 0.0, 0, hover_style.focus, 0.0,
        hover_style.opacity, ui_style_fill(hover_style),
        hover_style.material)
        MarkClickable()
    }
    if friends_action.activate {
        if friends_action.consume_release { ConsumeRelease() }
        result.friends_clicked = 1
    }
    if friends_text[0] != '\0' {
        RenderText(friends_text,
        ProfileHeaderFriendsTextX(header.x, scale),
        ProfileHeaderFriendsTextY(layout.count_y, scale),
        small_font, text_style.foreground)
    }
    return result
}

profile_picker_default_scroll_offset :: i32 #global

RenderProfileImagePickerModal :: (modal: ProfileImagePickerProps) -> ProfileImagePickerResult #export {
    result: ProfileImagePickerResult =
    (ProfileImagePickerResult){0}
    count: i32 = GetProfileImageIconCount()
    scroll_offset: *i32 = modal.scroll_offset
    if scroll_offset == nil {
        scroll_offset = &profile_picker_default_scroll_offset
    }
    selected: IconType = ICON_NONE
    if modal.selected_icon_type != nil {
        selected = *modal.selected_icon_type
    }
    runtime_scale: float = (float)GetScale()
    layout: ProfilePickerLayout = ProfilePickerLayoutFor(
    ui_view_width, ui_view_height, modal.max_width,
    count, runtime_scale)
    title: const char* = modal.title
    if title == nil { title = "Profile image" }
    frame: PanelFrame = RenderModalFrame(layout.width,
    layout.height, title, (Texture2D){0}, modal.close_icon)
    if frame.right_clicked {
        result.closed = 1
        return result
    }
    area: ScrollArea = (ScrollArea){0}
    area.bounds = (Rectangle){(float)frame.content_x,
        (float)frame.content_y, (float)frame.content_w,
        (float)frame.content_h}
    area.content_height = layout.content_height
    area.content_x = frame.content_x
    area.content_width = frame.content_w
    area.scroll_offset = scroll_offset
    area.wheel_step = layout.cell + layout.gap
    view: ScrollView = BeginScrollContainer(area)
    mouse: Vector2 = ui_mouse_world()
    index: i32 = 0
    while index < count {
        cell: ProfilePickerCell = ProfilePickerCellFor(index,
        view.content_x, view.content_y, view.content_w, layout)
        icon_type: IconType = GetProfileImageIconType(index)
        icon: Texture2D = (Texture2D){0}
        pointer: ProfilePointerAction = ProfilePointerActionFromInput(
        CheckCollisionPointRec(mouse, cell.bounds) != 0,
        InputCapturesClick(mouse) != 0,
        HoverEffectsEnabled() != 0,
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0)
        hovered: i32 = pointer.active
        active: i32 = icon_type == selected
        decision: ProfilePickerCellDecision =
        ProfilePickerCellDecisionFor(pointer.active != 0,
        pointer.activated != 0, index,
        (int)icon_type, (int)selected)
        state: ButtonState = ButtonStateNormal
        if hovered != 0 { state = ButtonStateHover }
        if active != 0 { state = ButtonStateSelected }
        props: ButtonProps = (ButtonProps){0}
        props.tone = ButtonToneNeutral
        if active != 0 { props.tone = ButtonToneAccent }
        props.emphasis = ButtonEmphasisSoft
        props.selected = active
        cell_style: Style = ui_resolve_button_style_kind(
        props, state, StyleKindSelectable())
        text_style: Style = ui_resolve_button_style_kind(
        (ButtonProps){0}, ButtonStateNormal, StyleKindText())
        ProfileDrawAvatarTile(cell.bounds, cell_style)
        if active != 0 {
            DrawRectangleLinesEx(cell.bounds,
            ProfilePickerSelectedStrokeWidth(runtime_scale),
            cell_style.border)
        }
        if modal.icons != nil && icon_type > ICON_NONE &&
        icon_type < ICON_COUNT {
            icon = modal.icons[icon_type]
        }
        if icon_type > ICON_NONE && icon_type < ICON_COUNT {
            DrawProfileImageIcon(icon_type,
            cell.icon_bounds, ProfileImagesDarkMode())
        } else if icon.id != 0 {
            ProfileDrawTexture(icon, (int)cell.icon_bounds.x,
            (int)cell.icon_bounds.y,
            (int)cell.icon_bounds.width)
        } else {
            ProfileDrawFallback((int)cell.icon_bounds.x,
            (int)cell.icon_bounds.y,
            (int)cell.icon_bounds.width,
            text_style.foreground)
        }
        if decision.mark_clickable {
            MarkClickable()
            if decision.select {
                if decision.consume_release { ConsumeRelease() }
                if modal.selected_icon_type != nil {
                    *modal.selected_icon_type =
                    (IconType)decision.selected_icon_type
                }
                result.changed = decision.changed
                result.selected_index = decision.selected_index
                result.selected_icon_type =
                (IconType)decision.selected_icon_type
                result.closed = decision.close
            }
        }
        index += 1
    }
    EndScrollContainer(area, view)
    return result
}
