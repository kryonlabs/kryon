#module "ui_window_test"
#import "kryon.h"
#import "ui_window.h"
#import "ui/window_policy.h"
#import <limits.h>
#import <stdio.h>
#import <stdlib.h>

WindowTestRequire :: (condition: bool, message: const char*) {
    if condition {
        return
    }
    fprintf(stderr, "window policy failed: %s\n", message)
    exit(1)
}

WindowTestPosition :: (actual: WindowPoint, x: i32, y: i32,
                       message: const char*) {
    WindowTestRequire(actual.x == x && actual.y == y, message)
}

WindowTestPolicy :: () {
    WindowTestPosition(WindowInitialPosition(7, 13, 100, 50,
        NATIVE_WINDOW_TOP_RIGHT, 10, 20, 300, 200), 203, 33,
        "top-right margins")
    WindowTestPosition(WindowInitialPosition(7, 13, 100, 50,
        NATIVE_WINDOW_CENTER, 10, 20, 300, 200), 110, 95,
        "centered work area")
    WindowTestPosition(WindowInitialPosition(7, 13, 100, 50,
        NATIVE_WINDOW_TOP_RIGHT | NATIVE_WINDOW_CENTER,
        10, 20, 300, 200), 203, 33,
        "top-right wins when both placement flags are set")
    WindowTestPosition(WindowInitialPosition(7, 13, 100, 50,
        0, 10, 20, 300, 200), 7, 13,
        "absolute position remains unchanged")
    WindowTestPosition(WindowInitialPosition(0, 0, 1, 1,
        NATIVE_WINDOW_TOP_RIGHT, INT_MAX, INT_MAX, INT_MAX, INT_MAX),
        INT_MAX, INT_MAX, "extreme work area clamps to i32")

    WindowTestRequire(!WindowDragMoved(3, 0), "three-pixel drag is a click")
    WindowTestRequire(WindowDragMoved(3, 1), "diagonal drag crosses threshold")
    WindowTestRequire(WindowDragMoved(INT_MIN, INT_MAX),
        "extreme drag deltas cannot overflow threshold")
    WindowTestPosition(WindowDragPosition(0, 0, 500, 500,
        10, 20, 100, 80), 86, 76,
        "drag keeps a grabbable strip in the work area")
    WindowTestPosition(WindowDragPosition(0, 0, -500, -500,
        10, 20, 100, 80), 10, 20,
        "drag clamps at the top-left work area edge")
    WindowTestPosition(WindowDragPosition(0, 0, 500, 500,
        10, 20, 5, 5), 10, 20,
        "work areas smaller than the strip remain reachable")
}

WindowTestNullBackend :: () {
    x: i32 = 12345
    y: i32 = 12345

    if !IsWindowReady() {
        window: NativeWindow* = OpenNativeWindow("kryon-test", 0, 0,
            32, 32, 0, (Color){0, 0, 0, 255}, 1.0f)
        WindowTestRequire(window == nil,
            "opening a secondary window requires the main window")
    }

    BeginNativeWindow(nil)
    EndNativeWindow()
    CloseNativeWindow(nil)
    WindowTestRequire(!IsNativeWindowClicked(nil), "null click")
    WindowTestRequire(!IsNativeWindowRightClicked(nil), "null right click")
    WindowTestRequire(!IsNativeWindowDragged(nil), "null drag")

    GetNativeWindowPosition(nil, &x, &y)
    WindowTestRequire(x == 0 && y == 0, "null window position")
    GetNativeWindowClickPosition(nil, &x, &y)
    WindowTestRequire(x == -1 && y == -1, "null click position")
}

main :: () -> i32 #export {
    if getenv("DISPLAY") != nil || getenv("WAYLAND_DISPLAY") != nil {
        fprintf(stderr, "window test requires a scrubbed display environment\n")
        return 2
    }
    WindowTestPolicy()
    WindowTestNullBackend()
    puts("window policy Kry checks passed")
    return 0
}
