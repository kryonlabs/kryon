host_api :: #system_library "host_api";

Accelerator :: struct {
    key: s32
    ctrl: s32
    shift: s32
    alt: s32
    id: s32
}

AcceleratorPressed :: (accelerator: Accelerator) -> s32 #foreign host_api;

#program_export
DispatchAccelerators :: (accelerators: []Accelerator) -> s32 {
    index: s32 = 0
    while index < (cast(s32)accelerators.count) {
        pressed: s32 = AcceleratorPressed(accelerators[index])
        if pressed != 0 { return pressed }
        index += 1
    }
    return 0
}
