                    }
                    if row == 1 && column == 0 {
                        bounds = (Rectangle){origin + 81, 206, 72, 39}
                    }
                    if row == 1 && column == 2 {
                        bounds = (Rectangle){origin + 251, 205, 72, 38}
                    }
                } else {
                    if row == 1 && column == 3 {
