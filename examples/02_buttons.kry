#import "kryon.h"

app "UI Buttons Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    click_count: int = 0
    last_action: [128] char = "No button clicked yet."
}

screen ButtonsExample(viewport: Rectangle) {
    WidgetBackground(GetThemeBackground())
    WidgetText("UI Buttons Example", ScaleUIPx(20), ScaleUIPx(20), UI_TEXT_24, GetThemeText())
    WidgetText("Click the buttons below to test interactions", ScaleUIPx(20), ScaleUIPx(54), UI_TEXT_16, GetThemeText())
    button "Primary Button" x: ScaleUIPx(20) y: ScaleUIPx(100) w: ScaleUIPx(200) h: ScaleUIPx(40) style: UI_BUTTON_STYLE_PRIMARY {
        click_count++
        snprintf(last_action,sizeof(last_action),"Primary Button clicked.")
    }
    button "Secondary Button" x: ScaleUIPx(20) y: ScaleUIPx(150) w: ScaleUIPx(200) h: ScaleUIPx(40) style: UI_BUTTON_STYLE_SECONDARY {
        click_count++
        snprintf(last_action,sizeof(last_action),"Secondary Button clicked.")
    }
    button "Danger Button" x: ScaleUIPx(20) y: ScaleUIPx(200) w: ScaleUIPx(200) h: ScaleUIPx(40) style: UI_BUTTON_STYLE_DANGER {
        click_count++
        snprintf(last_action,sizeof(last_action),"Danger Button clicked.")
    }
    WidgetText(TextFormat("Clicks:%d",click_count), ScaleUIPx(20), ScaleUIPx(260), UI_TEXT_16, GetThemeText())
    WidgetText(last_action, ScaleUIPx(20), ScaleUIPx(290), UI_TEXT_16, GetThemeText())
    WidgetText("Button Styles", ScaleUIPx(300), ScaleUIPx(100), 18, GetThemeText())
    WidgetText("Primary,secondary,and danger styles use the active theme.", ScaleUIPx(300), ScaleUIPx(130), 14, GetThemeIcon())
}
