#import "geometry"
host_api :: #system_library "host_api";

MenuItemKind :: enum {
    MenuCommand :: 0
    MenuCheck :: 1
    MenuRadio :: 2
    MenuSeparator :: 3
    MenuSubmenu :: 4
}

MenuMode :: enum {
    MenuModeBar :: 0
    MenuModePopup :: 1
    MenuModeContext :: 2
}

MenuItem :: struct {
    kind: MenuItemKind
    label: string
    accelerator: string
    id: s32
    disabled: bool
    checked: bool
    submenu: *MenuItem
    submenu_count: s32
}

MenuGroup :: struct {
    bounds: Rectangle
    label: string
    items: *MenuItem
    item_count: s32
}

MenuResult :: struct {
    activated_id: s32
    open_index: s32
}

MenuProps :: struct {
    id: s32
    class_name: s32
    mode: MenuMode
    bounds: Rectangle
    trigger: Rectangle
    menus: *MenuGroup
    menu_count: s32
    items: *MenuItem
    item_count: s32
    open_index: *s32
    open: *s32
    x: *s32
    y: *s32
}

#program_export
Menu :: (menu: MenuProps) -> MenuResult #foreign host_api;
