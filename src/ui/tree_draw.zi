#import "geometry"
#import "paint_queue"
#import "session"
#import "tree"
#import "tree_input"

using FrameStatus;

// A frame commits its tree before any queued raster effects are emitted.
#program_export
BeginFrame :: (session: Session, screen_key: u64,
    bounds: Rectangle) -> FrameStatus {
    if !SessionValid(session) { return cast(FrameStatus)FrameInvalidSession }
    PaintClear(session)
    frame_paint_unchanged[SessionIndex(session)] = false
    TreeStart(session, screen_key, bounds)
    return TreeFrameStatus(session)
}

#program_export
CommitFrame :: (session: Session) -> FrameStatus {
    if !SessionValid(session) { return cast(FrameStatus)FrameInvalidSession }
    if PaintOverflow(session) {
        TreeCancel(session)
        PaintClear(session)
        return cast(FrameStatus)FramePaintOverflow
    }
    if !TreeFinish(session) {
        status: FrameStatus = TreeFrameStatus(session)
        PaintClear(session)
        return status
    }
    return cast(FrameStatus)FrameOk
}

FrameEndResult :: struct {
    status: FrameStatus
    paint_unchanged: bool
    paint_count: s32
}

#program_export
EndFrame :: (session: Session) -> FrameStatus {
    status: FrameStatus = CommitFrame(session)
    if status != cast(FrameStatus)FrameOk { return status }
    PaintFlush(session)
    return cast(FrameStatus)FrameOk
}

// Ends a frame for a host that can present its previous frame again.
// `reuse` says the host will do so when this frame's paint matches the last
// one; the matching paint is then not emitted again. A host that repaints
// anyway, because something it drew itself changed, passes false and gets
// the paint emitted. paint_unchanged reports the comparison either way.
#program_export
EndFrameRetained :: (session: Session, reuse: bool) -> FrameEndResult {
    result: FrameEndResult
    result.status = CommitFrame(session)
    if result.status != cast(FrameStatus)FrameOk {
        PaintSnapshotInvalidate(session)
        return result
    }
    result.paint_count = PendingPaintCount(session)
    unchanged: bool = PaintPlanUnchanged(session)
    stored: bool = PaintSnapshotStore(session)
    result.paint_unchanged = unchanged && stored
    slot: s32 = SessionIndex(session)
    frame_paint_unchanged[slot] = result.paint_unchanged && reuse
    if result.paint_unchanged && reuse {
        PaintClear(session)
    } else {
        PaintFlush(session)
    }
    result.status = cast(FrameStatus)FrameOk
    return result
}

#program_export
CloseSession :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    TreeDispose(session)
    PaintDispose(session)
    TreeInputReset(session)
    return SessionClose(session)
}
