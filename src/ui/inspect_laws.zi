#import "inspect"

// Laws for the inspector's move and resize handles. Each states the
// expected behavior independently of the implementation; `ziran check`
// proves it over every listed input. An implementation edit may not change
// this file.

// A release ends a move or resize in progress and takes the release;
// otherwise nothing ends.
#law ReleaseEndsEdit forall dragging: 0..1, resizing: 0..1 => InspectReleaseDecisionFor(true, dragging != 0, resizing != 0).end_edit == (dragging != 0 || resizing != 0);
#law NoReleaseNoEnd forall dragging: 0..1, resizing: 0..1 => !InspectReleaseDecisionFor(false, dragging != 0, resizing != 0).end_edit;
#law EndingTakesRelease forall released: 0..1, dragging: 0..1, resizing: 0..1 => InspectReleaseDecisionFor(released != 0, dragging != 0, resizing != 0).consume_release == InspectReleaseDecisionFor(released != 0, dragging != 0, resizing != 0).end_edit;
