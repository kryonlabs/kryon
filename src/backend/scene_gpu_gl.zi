RawEnableAttribute :: (index: u32) #foreign gl "glEnableVertexAttribArray";
RawAttributePointer :: (index: u32, count: s32, kind: u32, normalized: u8, stride: s32, offset: *void) #foreign gl "glVertexAttribPointer";
RawCreateShader :: (kind: u32)->u32 #foreign gl "glCreateShader";
RawShaderSource :: (id: u32, count: s32, texts: **u8, lengths: *s32) #foreign gl "glShaderSource";
RawCompileShader :: (id: u32) #foreign gl "glCompileShader";
RawGetShader :: (id: u32, name: u32, value: *s32) #foreign gl "glGetShaderiv";
RawShaderLog :: (id: u32, size: s32, length: *s32, data: *u8) #foreign gl "glGetShaderInfoLog";
RawDeleteShader :: (id: u32) #foreign gl "glDeleteShader";
RawCreateProgram :: ()->u32 #foreign gl "glCreateProgram";
RawAttachShader :: (id: u32, shader: u32) #foreign gl "glAttachShader";
RawLinkProgram :: (id: u32) #foreign gl "glLinkProgram";
RawGetProgram :: (id: u32, name: u32, value: *s32) #foreign gl "glGetProgramiv";
