#module "text_input_props"
#import "geometry"
#import "syntax"

TextFieldInput :: struct {
    text: string
    paste_text: string
    left: bool
    right: bool
    home: bool
    end: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
}

TextFieldProps :: struct {
    key: u64
    bounds: Rectangle
    value: string
    display_value: string
    label: string
    placeholder: string
    cursor: i32
    anchor: i32
    scroll_x: i32
    focused: bool
    focus_id: i32
    class_name: i32
    scale: float
    max_bytes: i32
    max_codepoints: i32
    secure: bool
    read_only: bool
    disabled: bool
    input: TextFieldInput
}

TextFieldEdit :: struct {
    start: i32
    end: i32
    replacement: string
    changed: bool
}

TextFieldResult :: struct {
    node: i32
    cursor: i32
    anchor: i32
    scroll_x: i32
    focused: bool
    committed: bool
    escaped: bool
    clipboard_write: bool
    clipboard_text: string
    edit: TextFieldEdit
}

TextAreaInput :: struct {
    text: string
    paste_text: string
    left: bool
    right: bool
    up: bool
    down: bool
    home: bool
    end: bool
    document_home: bool
    document_end: bool
    page_up: bool
    page_down: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    enter: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
    wheel: float
}

TextAreaProps :: struct {
    key: u64
    bounds: Rectangle
    value: string
    label: string
    placeholder: string
    cursor: i32
    anchor: i32
    scroll_y: i32
    focused: bool
    selecting: bool
    preferred_x: i32
    preferred_x_valid: bool
    max_bytes: i32
    max_codepoints: i32
    focus_id: i32
    syntax: SyntaxMode
    composition_start: i32
    composition_end: i32
    read_only: bool
    wrap: bool
    class_name: i32
    scale: float
    disabled: bool
    input: TextAreaInput
}

TextAreaEdit :: struct {
    start: i32
    end: i32
    replacement: string
    changed: bool
}

TextAreaResult :: struct {
    node: i32
    cursor: i32
    anchor: i32
    scroll_y: i32
    focused: bool
    selecting: bool
    preferred_x: i32
    preferred_x_valid: bool
    committed: bool
    escaped: bool
    clipboard_write: bool
    clipboard_text: string
    edit: TextAreaEdit
}
