#import "kryon.h"
#import "kry_inject.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

app "Kryon appearance comparison" {
    size 450 760
    fps 60
    before_window AppearanceBeforeWindow
    init AppearanceInit
    after_frame AppearanceAfterFrame
    should_continue AppearanceContinue
}

state {
    appearance_output: const char*
    appearance_page: i32 = 0
    appearance_selected_page: i32 = -1
    appearance_frame: i32 = 0
    appearance_first: Image = {0}
    appearance_field: [64]char = {0}
    appearance_cursor: i32 = 15
    appearance_field_focused: i32 = 0
    appearance_area: [128]char = {0}
    appearance_area_cursor: i32 = 81
    appearance_area_focus: i32 = 1
    appearance_area_scroll: i32 = 0
    appearance_dropdown: i32 = 1
}

AppearanceBeforeWindow :: () -> bool {
    private_display: const char* = getenv("KRYON_PRIVATE_DISPLAY")
    display: const char* = getenv("DISPLAY")
    if private_display == nil || display == nil ||
    strcmp(private_display, "1") != 0 ||
    strncmp(display, ":0", 2) == 0 {
        puts("Appearance capture requires a private X display")
        return false
    }
    appearance_output = getenv("KRYON_APPEARANCE_CAPTURE_PNG")
    if appearance_output == nil || appearance_output[0] == '\0' {
        puts("Appearance capture requires an output PNG path")
        return false
    }
    SetConfigFlags(FLAG_WINDOW_HIDDEN | FLAG_MSAA_4X_HINT)
    return true
}

AppearanceInit :: () {
    snprintf(&appearance_field[0], sizeof(appearance_field),
        "%s", "freelancermap.de")
    snprintf(&appearance_area[0], sizeof(appearance_area), "%s",
        "Hello, this is a proposal.\nIt wraps across multiple lines\nand keeps a normal caret.")
    SetThemeMode(THEME_MODE_DARK)
}

AppearanceContinue :: () -> bool {
    return appearance_page < 2
}

AppearanceSelectPage :: () {
    if appearance_selected_page == appearance_page { return }
    if !EnsureBuiltInStylePacks() {
        puts("Could not load built-in style packs")
        exit(1)
    }
    pack: const char* = appearance_page == 0 ? "lightfield" : "material"
    if !SetActiveStylePack(pack) {
        fprintf(stderr, "Style pack '%s' unavailable\n", pack)
        exit(1)
    }
    SetFancyEffectsEnabled(appearance_page == 0)
    InjectReset()
    InjectMousePosition(-1000, -1000)
    InjectPump()
    appearance_selected_page = appearance_page
}

AppearanceAfterFrame :: () {
    if appearance_frame < 2 {
        appearance_frame += 1
        return
    }
    shot: Image = LoadImageFromScreen()
    if shot.data == nil {
        puts("Could not capture appearance frame")
        exit(1)
    }
    if appearance_page == 0 {
        appearance_first = shot
        appearance_frame = 0
        appearance_page = 1
        return
    }
    combined: Image = GenImageColor(900, 760, GetThemeBackground())
    if combined.data == nil {
        puts("Could not create comparison image")
        UnloadImage(shot)
        UnloadImage(appearance_first)
        exit(1)
    }
    ImageDrawImage(&combined, appearance_first, 0, 0, WHITE)
    ImageDrawImage(&combined, shot, 450, 0, WHITE)
    success: bool = ExportImage(combined, appearance_output)
    UnloadImage(combined)
    UnloadImage(shot)
    UnloadImage(appearance_first)
    if !success {
        puts("Could not write appearance comparison PNG")
        exit(1)
    }
    puts(appearance_output)
    appearance_page = 2
}

AppearanceLabel :: (value: const char*, y: i32,
height: i32) {
    props: TextProps = {0}
    props.bounds = (Rectangle){72, (float)y, 330, (float)height}
    props.text = value
    props.wrap = TextWrapNone
    Text(props)
}

AppearanceContent :: () {
    fancy: bool = appearance_page == 0
    items: [3]const char* = {"Morning", "Long Session", "Focus"}
    AppearanceLabel(fancy ? "Glow / fancy" : "Simple / no glow", 28, 32)
    AppearanceLabel(fancy ? "glass, lightfield, blur layers" :
        "flat material, no glow layers", 60, 24)
    AppearanceLabel("Text", 112, 24)
    AppearanceLabel("Human tomorrow, quieter power.", 142, 28)
    AppearanceLabel("TextInput", 214, 24)
    field: TextFieldProps = {0}
    field.bounds = (Rectangle){72, 246, 300, 44}
    field.text = &appearance_field[0]
    field.text_size = sizeof(appearance_field)
    field.cursor_position = &appearance_cursor
    field.focused = &appearance_field_focused
    field.max_codepoints = 63
    field.focus_id = 8100 + appearance_page
    TextField(field)
    AppearanceLabel("TextArea", 330, 24)
    area: TextAreaProps = {0}
    area.bounds = (Rectangle){72, 362, 300, 112}
    area.text = &appearance_area[0]
    area.text_size = sizeof(appearance_area)
    area.cursor_position = &appearance_area_cursor
    area.focused = &appearance_area_focus
    area.scroll_y = &appearance_area_scroll
    area.max_codepoints = 127
    area.focus_id = 8150 + appearance_page
    area.placeholder = "Write proposal"
    area.wrap = 1
    TextArea(area)
    AppearanceLabel("Button", 510, 24)
    button: ButtonProps = {0}
    button.bounds = (Rectangle){72, 542, 220, 44}
    button.label = "Save changes"
    button.id = 8200 + appearance_page
    button.tone = ButtonToneAccent
    button.emphasis = ButtonEmphasisFilled
    Button(button)
    AppearanceLabel("Dropdown", 628, 24)
    dropdown: DropdownProps = {0}
    dropdown.id = 8300 + appearance_page
    dropdown.bounds = (Rectangle){72, 660, 260, 44}
    dropdown.options = &items[0]
    dropdown.option_count = 3
    dropdown.selected_index = &appearance_dropdown
    Dropdown(dropdown)
}

AppearanceScreen :: (viewport: Rectangle) #ui {
    AppearanceSelectPage()
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        AppearanceContent()
    }
}
