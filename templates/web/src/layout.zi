using UI :: #import "Widgets";
using SharedLayout :: #import "kryon/PageLayout";

Label :: (session: Session, key: s32, text: string, bounds: Rectangle, font: s32) {
    Text(session, TextProps.{.key = cast(u64)key, .bounds = bounds, .text = text, .font = font})
}

// first followed by second, in output.
Joined :: (first: string, second: string, output: []u8) -> string {
    length: s32 = 0
    index: s32 = 0
    while index < cast(s32)first.count && length < cast(s32)output.count {
        output[length] = first[index]
        length += 1
        index += 1
    }
    index = 0
    while index < cast(s32)second.count && length < cast(s32)output.count {
        output[length] = second[index]
        length += 1
        index += 1
    }
    return TextView(output[0:length])
}
