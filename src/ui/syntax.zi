#module "syntax"

SyntaxMode :: enum {
    SyntaxNone = 0
    SyntaxZiran = 1
    SyntaxC = 2
    SyntaxMake = 3
}

SyntaxTokenKind :: enum {
    SyntaxPlain = 0
    SyntaxWhitespace = 1
    SyntaxKeyword = 2
    SyntaxString = 3
    SyntaxNumber = 4
    SyntaxPath = 5
    SyntaxComment = 6
}

SyntaxToken :: struct {
    length: i32
    kind: SyntaxTokenKind
    block_comment: bool
}

SyntaxIdentStart :: (byte: u8) -> bool #export {
    return (byte >= (u8)65 && byte <= (u8)90) ||
        (byte >= (u8)97 && byte <= (u8)122) ||
        byte == (u8)95
}

SyntaxIdent :: (mode: SyntaxMode, byte: u8) -> bool #export {
    return SyntaxIdentStart(byte) ||
        (byte >= (u8)48 && byte <= (u8)57) ||
        (mode == (SyntaxMode)SyntaxMake && byte == (u8)45)
}

SyntaxWordInList :: (value: string, start: i32,
    length: i32, words: string) -> bool #export {
    if start < 0 || length <= 0 ||
        start + length > value.length { return false }
    offset: i32 = 0
    while offset < words.length {
        if words[offset] != (u8)124 {
            offset += 1
            continue
        }
        begin: i32 = offset + 1
        end: i32 = begin
        while end < words.length && words[end] != (u8)124 {
            end += 1
        }
        if end - begin == length {
            equal: bool = true
            index: i32 = 0
            while index < length {
                if value[start + index] != words[begin + index] {
                    equal = false
                    break
                }
                index += 1
            }
            if equal { return true }
        }
        offset = end
    }
    return false
}

SyntaxKeywordFor :: (mode: SyntaxMode,
    value: string, start: i32,
    length: i32) -> bool #export {
    if mode == (SyntaxMode)SyntaxZiran {
        return SyntaxWordInList(value, start, length,
            "|#module|#import|#export|#extern|#global|#private|#type|struct|enum|if|else|while|return|true|false|nil|bool|string|i8|i16|i32|i64|u8|u16|u32|u64|float|double|f32|f64|char|const|size_t|void|int|")
    }
    if mode == (SyntaxMode)SyntaxC {
        return SyntaxWordInList(value, start, length,
            "|auto|break|case|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|restrict|return|short|signed|sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|_Bool|_Complex|_Atomic|_Thread_local|")
    }
    if mode == (SyntaxMode)SyntaxMake {
        return SyntaxWordInList(value, start, length,
            "|define|else|endef|endif|export|ifdef|ifeq|ifndef|ifneq|include|override|private|undefine|unexport|vpath|")
    }
    return false
}

SyntaxDarkBackground :: (background: u32) -> bool #export {
    red: u32 = (background >> (u32)24) & (u32)255
    green: u32 = (background >> (u32)16) & (u32)255
    blue: u32 = (background >> (u32)8) & (u32)255
    return red * (u32)3 + green * (u32)6 + blue <
        (u32)1280
}

SyntaxColorFor :: (kind: SyntaxTokenKind,
    dark: bool, base: u32) -> u32 #export {
    if kind == (SyntaxTokenKind)SyntaxKeyword {
        if dark { return (u32)0x8ea0f0ff }
        return (u32)0x2448acff
    }
    if kind == (SyntaxTokenKind)SyntaxString {
        if dark { return (u32)0x6ec8b0ff }
        return (u32)0x227e52ff
    }
    if kind == (SyntaxTokenKind)SyntaxNumber {
        if dark { return (u32)0xd59152ff }
        return (u32)0x96487eff
    }
    if kind == (SyntaxTokenKind)SyntaxPath {
        if dark { return (u32)0xcdaa6eff }
        return (u32)0x8a6020ff
    }
    if kind == (SyntaxTokenKind)SyntaxComment {
        if dark { return (u32)0x8a92a0ff }
        return (u32)0x68707cff
    }
    return base
}

SyntaxTokenAt :: (value: string, start: i32,
    end: i32, mode: SyntaxMode, first_token: bool,
    block_comment: bool) -> SyntaxToken #export {
    token: SyntaxToken
    token.kind = (SyntaxTokenKind)SyntaxPlain
    token.block_comment = block_comment
    if start < 0 || end > value.length ||
        start >= end { return token }
    byte: u8 = value[start]
    index: i32 = start
    if block_comment {
        token.kind = (SyntaxTokenKind)SyntaxComment
        while index < end {
            if value[index] == (u8)42 && index + 1 < end &&
                value[index + 1] == (u8)47 {
                index += 2
                token.block_comment = false
                break
            }
            index += 1
        }
        token.length = index - start
        return token
    }
    if byte == (u8)32 || byte == (u8)9 {
        token.kind = (SyntaxTokenKind)SyntaxWhitespace
        while index < end &&
            (value[index] == (u8)32 ||
                value[index] == (u8)9) { index += 1 }
        token.length = index - start
        return token
    }
    if mode == (SyntaxMode)SyntaxC && byte == (u8)47 &&
        start + 1 < end && value[start + 1] == (u8)42 {
        token.kind = (SyntaxTokenKind)SyntaxComment
        token.block_comment = true
        index = start + 2
        while index < end {
            if value[index] == (u8)42 && index + 1 < end &&
                value[index + 1] == (u8)47 {
                index += 2
                token.block_comment = false
                break
            }
            index += 1
        }
        token.length = index - start
        return token
    }
    if mode == (SyntaxMode)SyntaxC && byte == (u8)47 &&
        start + 1 < end && value[start + 1] == (u8)47 {
        token.length = end - start
        token.kind = (SyntaxTokenKind)SyntaxComment
        return token
    }
    if (mode == (SyntaxMode)SyntaxZiran ||
        mode == (SyntaxMode)SyntaxMake) && byte == (u8)35 {
        if mode == (SyntaxMode)SyntaxZiran && first_token &&
            start + 1 < end &&
            SyntaxIdentStart(value[start + 1]) {
            index = start + 2
            while index < end &&
                SyntaxIdent(mode, value[index]) { index += 1 }
            if SyntaxKeywordFor(mode, value,
                start, index - start) {
                token.length = index - start
                token.kind = (SyntaxTokenKind)SyntaxKeyword
                return token
            }
        }
        token.length = end - start
        token.kind = (SyntaxTokenKind)SyntaxComment
        return token
    }
    if byte == (u8)34 ||
        (mode == (SyntaxMode)SyntaxC && byte == (u8)39) {
        index = start + 1
        while index < end {
            if value[index] == (u8)92 && index + 1 < end {
                index += 2
                continue
            }
            if value[index] == byte {
                index += 1
                break
            }
            index += 1
        }
        token.length = index - start
        token.kind = (SyntaxTokenKind)SyntaxString
        return token
    }
    if mode == (SyntaxMode)SyntaxMake && byte == (u8)36 {
        index = start + 1
        if index < end &&
            (value[index] == (u8)40 ||
                value[index] == (u8)123) {
            close: u8 = (u8)41
            if value[index] == (u8)123 { close = (u8)125 }
            index += 1
            while index < end && value[index] != close {
                index += 1
            }
            if index < end { index += 1 }
        } else {
            if index < end { index += 1 }
        }
        token.length = index - start
        token.kind = (SyntaxTokenKind)SyntaxPath
        return token
    }
    digit: bool = byte >= (u8)48 && byte <= (u8)57
    negative: bool = byte == (u8)45 &&
        start + 1 < end && value[start + 1] >= (u8)48 &&
        value[start + 1] <= (u8)57
    if digit || negative {
        index = start + 1
        while index < end {
            next: u8 = value[index]
            if (next >= (u8)48 && next <= (u8)57) ||
                next == (u8)46 || next == (u8)95 ||
                next == (u8)120 || next == (u8)88 ||
                (next >= (u8)65 && next <= (u8)70) ||
                (next >= (u8)97 && next <= (u8)102) {
                index += 1
                continue
            }
            break
        }
        token.length = index - start
        token.kind = (SyntaxTokenKind)SyntaxNumber
        return token
    }
    if SyntaxIdentStart(byte) {
        index = start + 1
        while index < end && SyntaxIdent(mode, value[index]) {
            index += 1
        }
        token.length = index - start
        if SyntaxKeywordFor(mode, value,
            start, token.length) {
            token.kind = (SyntaxTokenKind)SyntaxKeyword
        }
        return token
    }
    if byte >= (u8)128 {
        index = start + 1
        while index < end &&
            (value[index] & (u8)192) == (u8)128 {
            index += 1
        }
        token.length = index - start
        return token
    }
    token.length = 1
    return token
}
