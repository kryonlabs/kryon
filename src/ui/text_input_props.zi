#module "text_input_props"
#import "geometry"

SyntaxMode :: enum {
    SyntaxNone = 0
    SyntaxZiran = 1
    SyntaxC = 2
    SyntaxMake = 3
}

TextInputProps :: struct {
    bounds: Rectangle
    text: const char*
    cursor_position: i32
    focused: bool
    cursor_visible: bool
    focus_id: i32
    class_name: i32
}

TextFieldInput :: struct {
    text: string
    left: bool
    right: bool
    home: bool
    end: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
}

TextFieldProps :: struct {
    key: u64
    bounds: Rectangle
    value: string
    display_value: string
    label: string
    placeholder: string
    cursor: i32
    anchor: i32
    scroll_x: i32
    focused: bool
    focus_id: i32
    class_name: i32
    scale: float
    max_bytes: i32
    max_codepoints: i32
    secure: bool
    read_only: bool
    disabled: bool
    input: TextFieldInput
}

TextFieldEdit :: struct {
    start: i32
    end: i32
    replacement: string
    changed: bool
}

TextFieldResult :: struct {
    node: i32
    cursor: i32
    anchor: i32
    scroll_x: i32
    focused: bool
    committed: bool
    escaped: bool
    edit: TextFieldEdit
}

TextAreaProps :: struct {
    bounds: Rectangle
    text: char*
    text_size: size_t
    cursor_position: i32*
    focused: i32*
    scroll_y: i32*
    max_codepoints: i32
    focus_id: i32
    placeholder: const char*
    syntax: SyntaxMode
    content_version: i32
    read_only: bool
    wrap: bool
    class_name: i32
}
