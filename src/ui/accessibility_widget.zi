#module "accessibility_widget"
#import "ui_internal.h"
#import "ui/tree_layout.h"
#import "ui_popup_input_internal.h"
#import "runtime/accessibility_policy.h"
#import "runtime/checkbox.h"

ui_accessibility_queue :: (focus_id: i32, generation: u64,
request: AccessibilityRequest) -> i32 {
    if ui_accessibility_building || generation == 0 ||
    generation != ui_tree_declaration || focus_id <= 0 { return 0 }
    target: *TreeNode = nil
    index: i32 = 0
    while index < ui_committed_node_count {
        node: *TreeNode = &ui_committed_nodes[index]
        if node->id == focus_id &&
        AccessibilityActionsFor(node->kind, focus_id,
        false, false, false) != 0 {
            if target != nil { return 0 }
            target = node
        }
        index += 1
    }
    if target == nil { return 0 }
    read_only: i32 = 0
    if target->kind == WidgetKindTextField {
        read_only = target->data.text_field.read_only
    } else if target->kind == WidgetKindTextArea {
        read_only = target->data.text_area.read_only
    } else if target->kind == WidgetKindListBox {
        read_only = target->data.list.selected == nil &&
        target->data.list.selected_index == nil
    }
    actions: u32 = AccessibilityActionsFor(target->kind, focus_id,
    ui_accessibility_node_disabled(target),
    ui_popup_input_snapshot_keyboard_captures(
    ui_tree_input_snapshot(target)), read_only)
    if target->kind == WidgetKindListBox &&
    target->data.list.selected == nil {
        actions &= ~(unsigned)AccessibilityActionSelectAll
    }
    if !AccessibilityActionAllowed(actions, request.action) { return 0 }
    if request.action == AccessibilityActionSetValue {
        offset: i32 = 0
        while offset < request.length {
            size: i32 = 0
            codepoint: i32 = GetCodepointNext(request.value + offset,
            &size)
            if !AccessibilityValueCodepointAllowed(codepoint,
            target->kind == WidgetKindTextArea) { return 0 }
            request.codepoints += 1
            offset += size
        }
    }
    index = 0
    while index < ui_accessibility_pending_count {
        prior: *AccessibilityRequest = &ui_accessibility_pending[index]
        if prior->id == focus_id && prior->action == request.action &&
        ((request.action != AccessibilityActionSelectItem &&
        request.action != AccessibilityActionDeselectItem) ||
        prior->anchor == request.anchor) {
            ui_accessibility_request_clear(prior)
            memmove(prior, &ui_accessibility_pending[index + 1],
            (size_t)(ui_accessibility_pending_count - index - 1) *
            sizeof(AccessibilityRequest))
            ui_accessibility_pending_count -= 1
            break
        }
        index += 1
    }
    if ui_accessibility_pending_count == 32 { return 0 }
    request.id = focus_id
    request.kind = target->kind
    ui_accessibility_pending[ui_accessibility_pending_count] = request
    ui_accessibility_pending_count += 1
    InvalidateTree(INVALIDATE_PAINT)
    return 1
}

QueueAccessibilityAction :: (focus_id: i32, generation: u64,
action: AccessibilityAction) -> i32 #export {
    if action != AccessibilityActionFocus &&
    action != AccessibilityActionActivate &&
    action != AccessibilityActionSelectAll &&
    action != AccessibilityActionClearSelection { return 0 }
    request: AccessibilityRequest = (AccessibilityRequest){0}
    request.action = action
    return ui_accessibility_queue(focus_id, generation, request)
}

QueueAccessibilityValue :: (focus_id: i32, generation: u64,
value: const char*) -> i32 #export {
    if value == nil { return 0 }
    request: AccessibilityRequest = (AccessibilityRequest){0}
    request.action = AccessibilityActionSetValue
    limit: i32 = AccessibilityValueByteLimit()
    while request.length <= limit && value[request.length] != '\0' {
        request.length += 1
    }
    if request.length > limit || !ui_utf8_valid(value,
    request.length) { return 0 }
    request.value = (char*)malloc((size_t)request.length + 1)
    if request.value == nil { return 0 }
    memcpy(request.value, value, (size_t)request.length + 1)
    if ui_accessibility_queue(focus_id, generation, request) {
        return 1
    }
    ui_accessibility_request_clear(&request)
    return 0
}

QueueAccessibilitySelection :: (focus_id: i32, generation: u64,
anchor: i32, cursor: i32) -> i32 #export {
    request: AccessibilityRequest = (AccessibilityRequest){0}
    request.action = AccessibilityActionSetSelection
    request.anchor = anchor
    request.cursor = cursor
    return ui_accessibility_queue(focus_id, generation, request)
}

QueueAccessibilityItem :: (focus_id: i32, generation: u64,
index: i32, selected: i32) -> i32 #export {
    if index < 0 || index >= ui_committed_node_count { return 0 }
    row: i32 = 0
    while row < ui_committed_node_count {
        node: *TreeNode = &ui_committed_nodes[row]
        if node->accessibility_item == index + 1 && node->parent >= 0 {
            parent: *TreeNode = &ui_committed_nodes[node->parent]
            if parent->kind == WidgetKindListBox &&
            parent->id == focus_id &&
            !ui_accessibility_node_disabled(node) {
                label: const char* = node->owned_text
                if label == nil { label = "" }
                length: size_t = strlen(label)
                if length > (size_t)AccessibilityValueByteLimit() {
                    return 0
                }
                request: AccessibilityRequest =
                (AccessibilityRequest){0}
                if selected {
                    request.action = AccessibilityActionSelectItem
                } else {
                    request.action = AccessibilityActionDeselectItem
                }
                request.anchor = index
                request.item_key = node->key
                request.length = (int)length
                request.value = ui_tree_strdup(label)
                if request.value == nil { return 0 }
                if ui_accessibility_queue(focus_id, generation, request) {
                    return 1
                }
                ui_accessibility_request_clear(&request)
                return 0
            }
        }
        row += 1
    }
    return 0
}

ui_accessibility_apply_list :: (list: ListBoxProps,
item: *i32) -> i32 #export {
    changed: i32 = 0
    *item = -1
    actions: u32 = AccessibilityActionsFor(WidgetKindListBox,
    list.id, list.disabled || ContentDisabled(),
    ui_popup_input_keyboard_captures(),
    list.selected == nil && list.selected_index == nil)
    if list.selected == nil {
        actions &= ~(unsigned)AccessibilityActionSelectAll
    }
    request_index: i32 = 0
    while request_index < ui_accessibility_active_count {
        request: *AccessibilityRequest =
        &ui_accessibility_active[request_index]
        if request->id == list.id && list.id > 0 &&
        request->kind == WidgetKindListBox &&
        request->action != AccessibilityActionFocus {
            request->id = 0
            if AccessibilityActionAllowed(actions, request->action) {
                all: bool = request->action ==
                AccessibilityActionSelectAll || request->action ==
                AccessibilityActionClearSelection
                index: i32 = request->anchor
                eligible: bool = true
                if !all {
                    if list.items == nil { eligible = false }
                    if eligible && request->item_key != 0 {
                        index = -1
                        row: i32 = 0
                        while list.item_keys != nil &&
                        row < list.item_count {
                            if list.item_keys[row] > 0 &&
                            (uint64_t)list.item_keys[row] ==
                            request->item_key {
                                if index >= 0 {
                                    index = -1
                                    break
                                }
                                index = row
                            }
                            row += 1
                        }
                    }
                    if index < 0 || index >= list.item_count {
                        eligible = false
                    }
                    if eligible && request->item_key == 0 {
                        label: const char* = list.items[index]
                        if label == nil { label = "" }
                        if strcmp(request->value, label) != 0 {
                            eligible = false
                        }
                    }
                }
                if eligible {
                    if list.selected != nil {
                        row: i32 = 0
                        while row < list.item_count {
                            selected: i32 = AccessibilityItemSelectionFor(
                            list.selected[row] != 0, row, index,
                            request->action)
                            changed |= selected != list.selected[row]
                            list.selected[row] = selected
                            row += 1
                        }
                        if !all && list.anchor != nil {
                            *list.anchor = index
                        }
                    } else if list.selected_index != nil {
                        selected: i32 = AccessibilitySingleSelectionFor(
                        *list.selected_index, index, request->action)
                        changed |= selected != *list.selected_index
                        *list.selected_index = selected
                    }
                    if !all { *item = index }
                    KryonSetFocus(list.id)
                }
            }
        }
        request_index += 1
    }
    return changed
}

ui_accessibility_list_items :: (list: ListBoxProps,
row_height: i32, scroll: i32) #export {
    if !ui_tree_building || ui_tree_stack_depth == 0 ||
    list.items == nil ||
    ui_tree_nodes[ui_tree_stack[ui_tree_stack_depth - 1]].kind !=
    WidgetKindListBox { return }
    index: i32 = 0
    while index < list.item_count {
        bounds: Rectangle = (Rectangle){list.bounds.x,
            list.bounds.y + (float)index * row_height - scroll,
            list.bounds.width, row_height}
        id: NodeId = ui_tree_add(0, WidgetKindCustom, bounds, nil)
        if id >= 0 {
            node: *TreeNode = &ui_tree_nodes[id]
            node->flags |= TreeNodeFlagPaintedImmediate
            if list.disabled {
                node->flags |= TreeNodeFlagScopeDisabled
            }
            node->accessibility_item = index + 1
            node->key = 0
            if list.item_keys != nil && list.item_keys[index] > 0 {
                node->key = (KeyID)list.item_keys[index]
            }
            label: const char* = list.items[index]
            if label == nil { label = "" }
            node->owned_text = ui_tree_strdup(label)
            node->data.option.selected = false
            if list.selected != nil {
                node->data.option.selected = list.selected[index] != 0
            } else if list.selected_index != nil {
                node->data.option.selected =
                *list.selected_index == index
            }
            node->data.option.offscreen =
            bounds.y + bounds.height <= list.bounds.y ||
            bounds.y >= list.bounds.y + list.bounds.height
        }
        index += 1
    }
}

ui_accessibility_apply_text :: (node: *TreeNode,
field: *TextFieldProps) #export {
    state: *TextFieldState = (TextFieldState*)node->state
    actions: u32 = AccessibilityActionsFor(node->kind, node->id,
    ui_accessibility_node_disabled(node),
    ui_popup_input_snapshot_keyboard_captures(
    ui_tree_input_snapshot(node)), field->read_only)
    if state == nil || field->text == nil ||
    field->text_size == 0 { return }
    index: i32 = 0
    while index < ui_accessibility_active_count {
        request: *AccessibilityRequest = &ui_accessibility_active[index]
        if node->id > 0 && request->id == node->id &&
        (request->action == AccessibilityActionSetValue ||
        request->action == AccessibilityActionSetSelection) {
            request->id = 0
            if request->kind == node->kind &&
            AccessibilityActionAllowed(actions, request->action) {
                eligible: bool = true
                changed: i32 = 0
                anchor: i32 = state->anchor
                cursor: i32 = state->cursor
                if request->action == AccessibilityActionSetValue {
                    capacity: size_t = field->text_size
                    limit: size_t =
                    (size_t)AccessibilityValueByteLimit() + 1
                    if capacity > limit { capacity = limit }
                    if !AccessibilityValueFits(request->length,
                    request->codepoints, (int)capacity,
                    field->max_codepoints) { eligible = false }
                    if eligible {
                        changed = strcmp(field->text,
                        request->value) != 0
                        memset(field->text, 0, field->text_size)
                        memcpy(field->text, request->value,
                        (size_t)request->length)
                        ui_tree_text_collapse(state, request->length)
                    }
                } else {
                    state->anchor = ui_grapheme_floor_offset(
                    field->text, request->anchor)
                    state->cursor = ui_grapheme_floor_offset(
                    field->text, request->cursor)
                }
                if eligible {
                    KryonSetFocus(node->id)
                    state->dragging = 0
                    if field->cursor_position != nil {
                        *field->cursor_position = state->cursor
                    }
                    if ui_text_composition_cancel(state) {
                        ui_text_field_event(node,
                        EVENT_COMPOSITION_CHANGED, GetTime())
                    }
                    ClearTextComposition()
                    if changed {
                        ui_text_field_event(node,
                        EVENT_TEXT_CHANGED, GetTime())
                    }
                    if anchor != state->anchor ||
                    cursor != state->cursor {
                        ui_text_field_event(node,
                        EVENT_SELECTION_CHANGED, GetTime())
                    }
                    if node->kind == WidgetKindTextArea {
                        ui_text_area_reveal_cursor(
                        node->data.text_area, state->cursor)
                    }
                    ui_tree_invalid |= INVALIDATE_PAINT
                }
            }
        }
        index += 1
    }
}

GetAccessibilitySnapshot :: (nodes: *AccessibilityNode,
capacity: i32) -> i32 #export {
    count: i32 = 0
    parents: *u32 = nil
    if nodes != nil && capacity > 0 {
        parents = (unsigned*)calloc((size_t)ui_committed_node_count,
        sizeof(unsigned))
    }
    index: i32 = 0
    while index < ui_committed_node_count {
        node: *TreeNode = &ui_committed_nodes[index]
        role: const char* = ui_accessibility_role(node->kind)
        if node->accessibility_item > 0 { role = "option" }
        label: const char* = node->owned_text
        parent: u32 = 0
        if parents != nil && node->parent >= 0 &&
        node->parent < index { parent = parents[node->parent] }
        if parents != nil { parents[index] = parent }
        skip: bool = false
        if node->kind == WidgetKindText {
            ancestor_index: i32 = node->parent
            while ancestor_index >= 0 {
                ancestor: *TreeNode =
                &ui_committed_nodes[ancestor_index]
                if ancestor->kind == WidgetKindButton ||
                (ancestor->kind == WidgetKindCard &&
                ancestor->id > 0) { break }
                ancestor_index = ancestor->parent
            }
            if ancestor_index >= 0 { skip = true }
        }
        if node->kind == WidgetKindCard &&
        node->data.button.props.id > 0 { role = "button" }
        if role == nil { skip = true }
        if !skip {
            if ui_tree_button_like_kind(node->kind) {
                if label == nil || label[0] == '\0' {
                    label = ui_tree_first_text(ui_committed_nodes,
                    ui_committed_node_count, index)
                }
                if label == nil {
                    label = node->data.button.props.label
                }
            } else if label == nil &&
            node->kind == WidgetKindCheckbox {
                label = node->data.checkbox.label
            }
            if nodes != nil && count < capacity {
                output: *AccessibilityNode = &nodes[count]
                memset(output, 0, sizeof(AccessibilityNode))
                output->key = node->key
                output->parent = parent
                output->bounds = node->bounds
                output->role = role
                output->label = label
                if label == nil { output->label = "" }
                output->value = ""
                output->focus_id = node->id
                if strcmp(role, "main") == 0 ||
                strcmp(role, "group") == 0 ||
                strcmp(role, "text") == 0 ||
                strcmp(role, "img") == 0 ||
                strcmp(role, "progressbar") == 0 {
                    output->focus_id = 0
                }
                output->disabled = ui_accessibility_node_disabled(node)
                if node->accessibility_item > 0 {
                    output->item_index = node->accessibility_item - 1
                    output->selected = node->data.option.selected
                    output->offscreen = node->data.option.offscreen
                } else if node->kind == WidgetKindListBox {
                    output->multi_select =
                    node->data.list.selected != nil
                    output->read_only =
                    node->data.list.selected == nil &&
                    node->data.list.selected_index == nil
                } else if node->kind == WidgetKindTextField {
                    field: TextFieldProps = node->data.text_field
                    output->secure = field.secure
                    output->read_only = field.read_only
                    if !field.secure && field.text != nil {
                        output->value = field.text
                    }
                } else if node->kind == WidgetKindTextArea {
                    area: TextAreaProps = node->data.text_area
                    output->multiline = 1
                    output->read_only = area.read_only
                    if area.placeholder != nil {
                        output->label = area.placeholder
                    } else {
                        output->label = ""
                    }
                    if area.text != nil { output->value = area.text }
                } else if node->kind == WidgetKindCheckbox {
                    if node->data.checkbox.flags != nil {
                        value: u32 =
                        (unsigned)*node->data.checkbox.flags
                        mask: u32 =
                        (unsigned)node->data.checkbox.flags_value
                        output->checked =
                        CheckboxFlagApply(value, mask, false).checked
                    } else {
                        output->checked =
                        node->data.checkbox.value != nil &&
                        *node->data.checkbox.value != 0
                    }
                } else if node->kind == WidgetKindToggle {
                    output->checked = node->data.toggle.value != nil &&
                    *node->data.toggle.value != 0
                    active_label: const char* =
                    node->data.toggle.off_label
                    if output->checked {
                        active_label = node->data.toggle.on_label
                    }
                    if active_label == nil { active_label = "" }
                    output->label = active_label
                } else if node->kind == WidgetKindRadio {
                    output->checked = node->data.radio.checked
                } else if node->kind == WidgetKindImage {
                    output->label = node->data.image.alt_text
                    if output->label == nil { output->label = "" }
                }
                focused: i32 = output->focus_id > 0 &&
                IsFocusActive(output->focus_id)
                if node->id <= 0 && node->state != nil &&
                (node->kind == WidgetKindTextField ||
                node->kind == WidgetKindTextArea) {
                    state: *TextFieldState =
                    (TextFieldState*)node->state
                    focused = state->focused
                }
                keyboard_captured: i32 =
                ui_popup_input_snapshot_keyboard_captures(
                ui_tree_input_snapshot(node))
                output->focused = !output->disabled && focused &&
                !keyboard_captured
                output->generation = ui_tree_declaration
                output->actions = AccessibilityActionsFor(node->kind,
                output->focus_id, output->disabled,
                keyboard_captured, output->read_only)
                if node->kind == WidgetKindListBox &&
                !output->multi_select {
                    output->actions &=
                    ~(unsigned)AccessibilityActionSelectAll
                }
                if !output->secure && node->state != nil &&
                (node->kind == WidgetKindTextField ||
                node->kind == WidgetKindTextArea) {
                    state: *TextFieldState =
                    (TextFieldState*)node->state
                    output->selection_anchor =
                    ui_grapheme_floor_offset(output->value,
                    state->anchor)
                    output->selection_cursor =
                    ui_grapheme_floor_offset(output->value,
                    state->cursor)
                }
            }
            count += 1
            if parents != nil { parents[index] = (unsigned)count }
        }
        index += 1
    }
    free(parents)
    return count
}
