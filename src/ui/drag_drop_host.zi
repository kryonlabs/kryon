#module "drag_drop_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/drag_drop.h"
#import "ui/widget_input.h"
#import "ui/paint_command.h"
#import "ui/widget_store.h"

DragDropTypePresent :: (value: const char*) -> bool {
    return value != nil && value[0] != 0
}

RenderDragDrop :: (drag_drop: DragDropProps) -> i32 #export {
    toolkit: *ToolkitStore = toolkit_store_current()
    mouse: Vector2 = ui_mouse_world()
    disabled: i32 = drag_drop.disabled || ContentDisabled()

    if drag_drop.role == DragDropRoleSource {
        hot: i32 = ui_hot(drag_drop.bounds)
        decision: DragDropSourceDecision = DragDropSourceDecisionFor(
        toolkit->drag_drop.active, toolkit->drag_drop.source_id,
        drag_drop.id, drag_drop.disabled, ContentDisabled(),
        DragDropTypePresent(drag_drop.type), drag_drop.data_size,
        DRAG_DROP_DATA_MAX, drag_drop.data != nil,
        hot != 0, IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0,
        IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0,
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0)
        if decision.clear_source {
            memset(&toolkit->drag_drop, 0, sizeof(DragDropState))
        }
        if !decision.valid { return 0 }
        if hot != 0 { MarkClickable() }
        if decision.start_source {
            memset(&toolkit->drag_drop, 0, sizeof(DragDropState))
            toolkit->drag_drop.active = 1
            toolkit->drag_drop.source_id = drag_drop.id
            snprintf(&toolkit->drag_drop.type[0],
            sizeof(toolkit->drag_drop.type), "%s", drag_drop.type)
            toolkit->drag_drop.data_size = drag_drop.data_size
            if drag_drop.data_size > 0 {
                memcpy(&toolkit->drag_drop.data[0], drag_drop.data,
                (size_t)drag_drop.data_size)
            }
        }
        return decision.returns_active
    }

    pointer_inside: bool = CheckCollisionPointRec(mouse,
    drag_drop.bounds) && !InspectInputCapturesClick(mouse) &&
    !ui_input_captures_click_internal(mouse, 0)
    hot: i32 = DragDropTargetHot(drag_drop.disabled,
    ContentDisabled(), pointer_inside)
    type_matches: bool = drag_drop.type != nil &&
    strcmp(&toolkit->drag_drop.type[0], drag_drop.type) == 0
    matches: i32 = DragDropTargetMatches(toolkit->drag_drop.active,
    DragDropTypePresent(drag_drop.type), type_matches)
    if drag_drop.accepted_size != nil { *drag_drop.accepted_size = 0 }
    if matches != 0 && IsWindowReady() {
        state: ButtonState = ButtonStateNormal
        if hot != 0 { state = ButtonStateHover }
        if disabled != 0 { state = ButtonStateDisabled }
        frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, state, disabled, hot, drag_drop.class_name,
        StyleKindDragDropTarget(), StyleAny())
        DrawWidgetFrame(drag_drop.bounds, (Rectangle){0},
        frame, hot, 0, disabled, 0)
    }
    decision: DragDropTargetDecision = DragDropTargetDecisionFor(
    drag_drop.disabled, ContentDisabled(), toolkit->drag_drop.active,
    DragDropTypePresent(drag_drop.type), type_matches, hot != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    toolkit->drag_drop.data_size, drag_drop.output_size)
    if !decision.accepted { return 0 }
    if drag_drop.output != nil && drag_drop.output_size > 0 {
        memcpy(drag_drop.output, &toolkit->drag_drop.data[0],
        (size_t)decision.copy_size)
        if drag_drop.accepted_size != nil {
            *drag_drop.accepted_size = decision.copy_size
        }
    }
    if decision.clear_source {
        memset(&toolkit->drag_drop, 0, sizeof(DragDropState))
    }
    if decision.consume_release { ConsumeRelease() }
    return 1
}
