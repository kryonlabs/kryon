#import "kryon.h"

# Inner Breeze language screen, matched to the native C render
# (light theme, measured geometry from the captured reference frame).

state {
    language_index: int = 0
}

app "Inner Breeze — Language" {
    size 480 640
    fps 60
    frame main
}

frame main {
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(GetScreenWidth(), GetScreenHeight(), GetUIScale())
    Background(GetThemeBackground())
    Text("Language", ScaleUIPx(160), ScaleUIPx(50), UI_TEXT_24, GetThemeText())
    Text("Choose your language", ScaleUIPx(46), ScaleUIPx(284), UI_TEXT_16, GetThemeText())
    Dropdown(260, ScaleUIPx(44), ScaleUIPx(299), ScaleUIPx(391), ScaleUIPx(48), "English;Portugues;Espanol;Deutsch;Francais", &language_index)
    Text("Next", ScaleUIPx(221), ScaleUIPx(379), UI_TEXT_16, GetThemeText())
    EndUIFocus()
    EndDrawing()
}
