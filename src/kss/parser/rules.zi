// Part of the kss_parser module, loaded by src/kss/kss_parser.zi.
// Rules: selectors, declarations, foreign and group blocks, and properties.

// Selector: Kind[attr=value].class:state chains filling a StyleRule selector.

KssRuleResult :: struct {
    parser: KssParser
    rule: StyleRule
}

KssApplyAttr :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    attribute: KssNameResult = KssReadName(c)
    if !attribute.ok {
        p.cursor = attribute.parser
        result.parser = KssFail(p, "expected selector attribute")
        return result
    }
    equals: KssExpectResult = KssExpect(attribute.parser, 61)
    if !equals.ok {
        p.cursor = equals.parser
        result.parser = KssFail(p, "expected '=' in selector attribute")
        return result
    }
    value: KssNameResult = KssReadName(equals.parser)
    if !value.ok {
        p.cursor = value.parser
        result.parser = KssFail(p, "expected selector attribute value")
        return result
    }
    close: KssExpectResult = KssExpect(value.parser, 93)
    if !close.ok {
        p.cursor = close.parser
        result.parser = KssFail(p, "expected ']'")
        return result
    }
    if KssNameEquals(attribute.name, "tone") {
        mapped: s32 = KssToneValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown tone '", value.name)
            return result
        }
        rule.selector.tone = mapped
    } else if KssNameEquals(attribute.name, "emphasis") {
        mapped: s32 = KssEmphasisValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown emphasis '", value.name)
            return result
        }
        rule.selector.emphasis = mapped
    } else if KssNameEquals(attribute.name, "size") {
        mapped: s32 = KssSizeValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown size '", value.name)
            return result
        }
        rule.selector.size = mapped
    } else if KssNameEquals(attribute.name, "state") {
        mapped: s32 = KssStateValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown state '", value.name)
            return result
        }
        rule.selector.state = mapped
    } else if KssNameEquals(attribute.name, "role") {
        mapped: s32 = KssRoleValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown role '", value.name)
            return result
        }
        rule.selector.role = mapped
    } else if KssNameEquals(attribute.name, "class") {
        rule.selector.class_name = KssClassId(value.name)
    } else {
        p.cursor = close.parser
        result.parser = KssFailName(p, "unknown selector attribute '",
            attribute.name)
        return result
    }
    p.cursor = close.parser
    result.parser = p
    result.rule = rule
    return result
}

KssParseSelector :: (p: KssParser) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.state = StyleStateAny()
    kind: KssNameResult = KssReadSelectorName(c)
    if !kind.ok {
        p.cursor = kind.parser
        result.parser = KssFail(p, "expected style selector")
        return result
    }
    mapped: s32 = KssKindValue(kind.name)
    if mapped == -999999 {
        p.cursor = kind.parser
        result.parser = KssFailName(p, "unknown style selector '",
            kind.name)
        return result
    }
    rule.selector.kind = mapped
    c = kind.parser
    p.cursor = c
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            result.parser = KssFail(p, "unterminated style rule")
            return result
        }
        if p.cursor.source[p.cursor.pos] == 91 {
            c = KssAdvance(c, 1)
            p.cursor = c
            attribute: KssRuleResult = KssApplyAttr(p, rule)
            if attribute.parser.status == cast(s32)KssStatusError {
                return attribute
            }
            p = attribute.parser
            c = p.cursor
            rule = attribute.rule
            continue
        }
        if p.cursor.source[p.cursor.pos] == 46 {
            c = KssAdvance(c, 1)
            p.cursor = c
            class_name: KssNameResult = KssReadSelectorName(c)
            if !class_name.ok {
                p.cursor = class_name.parser
                result.parser = KssFail(p,
                    "expected class name after '.'")
                return result
            }
            rule.selector.class_name = KssClassId(class_name.name)
            c = class_name.parser
            p.cursor = c
            continue
        }
        if p.cursor.source[p.cursor.pos] == 58 {
            c = KssAdvance(c, 1)
            p.cursor = c
            state: KssNameResult = KssReadName(c)
            if !state.ok {
                p.cursor = state.parser
                result.parser = KssFail(p, "expected state after ':'")
                return result
            }
            state_mapped: s32 = KssStateValue(state.name)
            if state_mapped == -999999 {
                p.cursor = state.parser
                result.parser = KssFailName(p, "unknown state '",
                    state.name)
                return result
            }
            rule.state = state_mapped
            c = state.parser
            p.cursor = c
            continue
        }
        running = false
    }
    result.parser = p
    result.rule = rule
    return result
}

// Property declarations. Token references resolve immediately against the
// current token table, so overlays applied earlier win as intended. Declarative
// hosts capture source spans and resolve them with KssResolveCSSValue when the
// rule is yielded, before subsequent overlays change the table.

KssCaptureDeclaration :: (p: KssParser, rule: StyleRule, name: KssName,
    name_start: s32, name_end: s32) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    if p.declaration_count >= 1024 {
        result.parser = KssFail(p, "declaration capacity exceeded")
        return result
    }
    entry: KssDeclaration
    entry.rule = p.rule_total
    entry.name_start = name_start
    entry.name_length = name_end - name_start
    c = KssSkipSpace(c)
    p.cursor = c
    entry.value_start = p.cursor.pos
    quote: u8 = 0
    depth: s32 = 0
    running: bool = true
    while running {
        if KssAtEnd(c) {
            result.parser = KssFail(p, "expected ';'")
            return result
        }
        byte: u8 = c.source[c.pos]
        if quote != 0 {
            if byte == 92 && KssPeek(c, 1) != 0 && !KssIsLineBreak(KssPeek(c, 1)) {
                c = KssAdvance(c, 2)
                p.cursor = c
                continue
            }
            if byte == quote || KssIsLineBreak(byte) {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && (KssPeek(c, 1) == 42 || (depth == 0 && KssPeek(c, 1) == 47)) {
            c = KssSkipSpace(c)
            p.cursor = c
            continue
        } else if byte == 40 || byte == 91 {
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            if depth <= 0 {
                result.parser = KssFail(p, "unmatched declaration delimiter")
                return result
            }
            depth = depth - 1
        } else if depth == 0 && (byte == 59 || byte == 125) {
            running = false
            continue
        }
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    entry.value_length = p.cursor.pos - entry.value_start
    while entry.value_length > 0 {
        byte: u8 = p.cursor.source[entry.value_start + entry.value_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.value_length = entry.value_length - 1
    }
    if entry.value_length <= 0 {
        result.parser = KssFailName(p, "expected declaration value after '", name)
        return result
    }
    if p.cursor.source[p.cursor.pos] == 59 {
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    p.declarations[p.declaration_count] = entry
    p.declaration_count = p.declaration_count + 1
    result.parser = p
    result.rule = rule
    return result
}

// Unknown foreign blocks are structure-lexed here. Recognized conditional
// groups and keyframes use the shared rule/declaration stream instead.

KssCaptureForeign :: (p: KssParser, name: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if p.foreign_count >= 16 {
        return KssFail(p, "foreign block capacity exceeded")
    }
    c = KssSkipSpace(c)
    p.cursor = c
    query_start: s32 = p.cursor.pos
    while !KssAtEnd(c) && p.cursor.source[p.cursor.pos] != 123 {
        if p.cursor.source[p.cursor.pos] == 59 || p.cursor.source[p.cursor.pos] == 125 {
            return KssFailName(p, "unknown directive '@", name)
        }
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    if KssAtEnd(c) {
        return KssFail(p, "expected '{' after block name")
    }
    entry: KssForeignBlock
    entry.name = name
    entry.query_start = query_start
    entry.query_length = p.cursor.pos - query_start
    while entry.query_length > 0 {
        byte: u8 = p.cursor.source[entry.query_start + entry.query_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.query_length = entry.query_length - 1
    }
    entry.body_start = 0
    entry.body_length = 0
    entry.file = p.cursor.file
    c = KssAdvance(c, 1)
    p.cursor = c
    entry.body_start = p.cursor.pos
    p.foreign[p.foreign_count] = entry
    p.foreign_count = p.foreign_count + 1
    p = KssSkipBlockRemainder(p)
    if p.status == cast(s32)KssStatusError {
        return p
    }
    p.foreign[p.foreign_count - 1].body_length = p.cursor.pos - 1 - p.foreign[p.foreign_count - 1].body_start
    return p
}

// Conditional groups ('@media (query) { rules }' and friends) contain rules;
// declarative hosts get them lexed here with per-rule group tags. The query
// text stays opaque to the grammar.

KssIsGroupName :: (name: KssName) -> bool {
    return KssNameEquals(name, "media") || KssNameEquals(name, "supports") ||
        KssNameEquals(name, "container") || KssNameEquals(name, "keyframes")
}

KssParseGroupBlock :: (p: KssParser, name: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if p.foreign_count >= 16 {
        return KssFail(p, "foreign block capacity exceeded")
    }
    c = KssSkipSpace(c)
    p.cursor = c
    query_start: s32 = p.cursor.pos
    while !KssAtEnd(c) && p.cursor.source[p.cursor.pos] != 123 {
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    if KssAtEnd(c) {
        return KssFail(p, "expected '{' after group query")
    }
    entry: KssForeignBlock
    entry.name = name
    entry.query_start = query_start
    entry.query_length = p.cursor.pos - query_start
    while entry.query_length > 0 {
        byte: u8 = p.cursor.source[entry.query_start + entry.query_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.query_length = entry.query_length - 1
    }
    entry.body_start = 0
    entry.body_length = 0
    entry.file = p.cursor.file
    group: s32 = p.foreign_count
    p.foreign[p.foreign_count] = entry
    p.foreign_count = p.foreign_count + 1
    c = KssAdvance(c, 1)
    p.cursor = c
    p.foreign[group].body_start = p.cursor.pos
    p.resume_group = group
    return KssContinueGroupBlock(p)
}

KssContinueGroupBlock :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated group block")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            p.foreign[p.resume_group].body_length = p.cursor.pos - p.foreign[p.resume_group].body_start
            c = KssAdvance(c, 1)
            p.cursor = c
            p.resume_group = -1
            running = false
            continue
        }
        p = KssParseRule(p)
        if p.status == cast(s32)KssStatusError {
            return p
        }
        p.rule_span.group = p.resume_group
        return p
    }
    return p
}

KssReadColorValue :: (p: KssParser) -> KssColorResult {
    c: KssCursor = p.cursor
    hex: KssColorResult = KssReadHexColor(c)
    if hex.ok {
        return hex
    }
    reference: KssNameResult = KssReadName(hex.parser)
    if reference.ok {
        p.cursor = reference.parser
        index: s32 = KssFindColorToken(p, reference.name)
        if index >= 0 {
            hex.value = p.tokens[index].color
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        // Closed set of named colors from the value-set proposal. Tokens win
        // over builtins so packs keep full control of their palette.
        if KssNameEquals(reference.name, "transparent") {
            hex.value = 0x00000000
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        if KssNameEquals(reference.name, "black") {
            hex.value = 0x000000ff
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        if KssNameEquals(reference.name, "white") {
            hex.value = 0xffffffff
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
    }
    hex.ok = false
    hex.parser = hex.parser
    return hex
}

KssReadNumberValue :: (p: KssParser) -> KssNumberResult {
    c: KssCursor = p.cursor
    literal: KssNumberResult = KssReadNumber(c)
    if literal.ok {
        return literal
    }
    reference: KssNameResult = KssReadName(literal.parser)
    if reference.ok {
        p.cursor = reference.parser
        index: s32 = KssFindNumberToken(p, reference.name)
        if index >= 0 {
            literal.value = p.tokens[index].number
            literal.ok = true
            literal.parser = reference.parser
            return literal
        }
    }
    literal.ok = false
    return literal
}

KssIntResult :: struct {
    parser: KssParser
    value: s32
    ok: bool
}

KssReadMaterialValue :: (p: KssParser) -> KssIntResult {
    c: KssCursor = p.cursor
    result: KssIntResult
    reference: KssNameResult = KssReadName(c)
    if !reference.ok {
        p.cursor = reference.parser
        result.parser = KssFail(p, "expected material")
        return result
    }
    mapped: s32 = KssMaterialValue(reference.name)
    if mapped == -999999 {
        p.cursor = reference.parser
        index: s32 = KssFindMaterialToken(p, reference.name)
        if index >= 0 {
            mapped = p.tokens[index].material
        }
    }
    if mapped == -999999 {
        result.parser = KssFailName(p, "unknown material '",
            reference.name)
        return result
    }
    p.cursor = reference.parser
    result.parser = p
    result.value = mapped
    result.ok = true
    return result
}

// One declaration into the rule's StyleData. Field flags come from
// control_props; every property stores presence explicitly.

KssParseProperty :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    c = KssSkipSpace(c)
    p.cursor = c
    name_start: s32 = p.cursor.pos
    name: KssNameResult = KssReadName(c)
    if !name.ok {
        p.cursor = name.parser
        result.parser = KssFail(p, "expected property name")
        return result
    }
    colon: KssExpectResult = KssExpect(name.parser, 58)
    if !colon.ok {
        p.cursor = colon.parser
        result.parser = KssFail(p, "expected ':' after property")
        return result
    }
    c = colon.parser
    p.cursor = c

    if p.declarative {
        return KssCaptureDeclaration(p, rule, name.name, name_start,
            name_start + name.name.length)
    }

    if KssNameEquals(name.name, "background") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleBackground
        rule.style.background = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "foreground") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleForeground
        rule.style.foreground = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "border") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleBorder
        rule.style.border = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "focus") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleFocus
        rule.style.focus = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "background-end") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleBackgroundEnd
        rule.style.background_end = value.value
        c = value.parser
        p.cursor = c
    } else {
        return KssParseNumberProperty(p, rule, name.name)
    }

    semicolon: KssExpectResult = KssExpect(c, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        result.parser = KssFail(p, "expected ';'")
        return result
    }
    p.cursor = semicolon.parser
    result.parser = p
    result.rule = rule
    return result
}

KssParseNumberProperty :: (p: KssParser, rule: StyleRule, name: KssName) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    if KssNameEquals(name, "radius") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleRadius
        rule.style.radius = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "border-width") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleBorderWidth
        rule.style.border_width = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "opacity") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleOpacity
        rule.style.opacity = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "padding-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StylePaddingX
        rule.style.padding_x = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "padding-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StylePaddingY
        rule.style.padding_y = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "gap") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleGap
        rule.style.gap = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "font-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleFontSize
        rule.style.font_size = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "letter-spacing") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleLetterSpacing
        rule.style.letter_spacing = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "icon-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleIconSize
        rule.style.icon_size = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "offset-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleContentOffset
        rule.style.offset_x = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "offset-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleContentOffset
        rule.style.offset_y = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "material") {
        value: KssIntResult = KssReadMaterialValue(p)
        if !value.ok {
            result.parser = value.parser
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleMaterial
        rule.style.material = cast(MaterialKind)value.value
        p.cursor = value.parser.cursor
        c = value.parser.cursor
    } else if KssNameEquals(name, "typeface") {
        start: s32 = -1
        length: s32 = 0
        scan: KssCursor = KssSkipSpace(c)
        if !KssAtEnd(scan) && KssIdentStart(scan.source[scan.pos]) {
            start = scan.pos
            while !KssAtEnd(scan) && KssIdentChar(scan.source[scan.pos]) {
                length = length + 1
                scan = KssAdvance(scan, 1)
            }
        }
        if start < 0 {
            p.cursor = scan
            result.parser = KssFail(p, "expected typeface name")
            return result
        }
        rule.style.fields = rule.style.fields | cast(u32)StyleTypeface
        rule.style.typeface = scan.source[start:start + length]
        c = scan
    } else {
        result.parser = KssFailName(p, "unknown property '", name)
        return result
    }

    semicolon: KssExpectResult = KssExpect(c, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        result.parser = KssFail(p, "expected ';'")
        return result
    }
    p.cursor = semicolon.parser
    result.parser = p
    result.rule = rule
    return result
}

// Rules: selector, declaration block, layer and order bookkeeping. Strict
// mode parses the typed selector grammar; declarative mode records the
// selector as a raw span consumed by the shared declarative selector lexer.

KssParseRule :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    origin: KssOrigin
    origin.file = p.cursor.file
    origin.line = p.cursor.line
    origin.column = p.cursor.column
    span: KssRuleSpan
    span.file = p.cursor.file
    span.group = -1
    selector: KssRuleResult
    c = KssSkipSpace(c)
    p.cursor = c
    selector_start: s32 = p.cursor.pos
    if p.declarative {
        bracket: s32 = 0
        paren: s32 = 0
        quote: u8 = 0
        running: bool = true
        while running {
            if KssAtEnd(c) {
                return KssFail(p, "expected '{'")
            }
            byte: u8 = p.cursor.source[p.cursor.pos]
            if quote != 0 {
                if byte == 92 && !KssIsLineBreak(KssPeek(c, 1)) {
                    c = KssAdvance(c, 2)
                    p.cursor = c
                    continue
                }
                if byte == quote || KssIsLineBreak(byte) {
                    quote = 0
                }
            } else if byte == 47 && (KssPeek(c, 1) == 42 ||
                (bracket == 0 && paren == 0 && KssPeek(c, 1) == 47)) {
                comment: KssExpectResult = KssSelectorComment(c)
                if !comment.ok {
                    return KssFail(p, "unterminated selector comment")
                }
                c = comment.parser
                p.cursor = c
                continue
            } else if byte == 34 || byte == 39 {
                quote = byte
            } else if byte == 91 {
                bracket = bracket + 1
            } else if byte == 93 && bracket > 0 {
                bracket = bracket - 1
            } else if byte == 40 {
                paren = paren + 1
            } else if byte == 41 && paren > 0 {
                paren = paren - 1
            } else if byte == 123 && bracket == 0 && paren == 0 {
                running = false
                continue
            }
            c = KssAdvance(c, 1)
            p.cursor = c
        }
    } else {
        selector = KssParseSelector(p)
        if selector.parser.status == cast(s32)KssStatusError {
            return selector.parser
        }
        p = selector.parser
        c = p.cursor
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) || p.cursor.source[p.cursor.pos] != 123 {
            return KssFail(p, "expected '{'")
        }
    }
    span.selector_start = selector_start
    span.selector_length = p.cursor.pos - selector_start
    c = KssAdvance(c, 1)
    p.cursor = c
    span.body_start = p.cursor.pos
    rule: StyleRule = selector.rule
    rule.layer = p.layer
    rule.order = p.rule_total
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated style rule")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            span.body_length = p.cursor.pos - span.body_start
            c = KssAdvance(c, 1)
            p.cursor = c
            span.end = c.pos
            running = false
            continue
        }
        property: KssRuleResult = KssParseProperty(p, rule)
        if property.parser.status == cast(s32)KssStatusError {
            return property.parser
        }
        p = property.parser
        c = p.cursor
        rule = property.rule
    }
    p.rule = rule
    p.origin = origin
    p.rule_span = span
    p.rule_total = p.rule_total + 1
    p.status = cast(s32)KssStatusRule
    return p
}
