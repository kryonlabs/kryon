#module "toast"
#import "control_props"
#import "drawing_props"
#import "style"

ToastMetrics :: struct {
    pad_x: i32
    pad_y: i32
    margin: i32
    default_seconds: float
}

ToastLayout :: struct {
    bounds: Rectangle
    text_bounds: Rectangle
    content_width: i32
}

ToastTruncation :: struct {
    prefix_len: i32
    ellipsis: bool
}

ToastRequestDecision :: struct {
    show: bool
    clear: bool
    seconds: float
}

ToastRenderDecision :: struct {
    render: bool
    clear: bool
}

ToastLabelRole :: () -> i32 #export {
    return 6
}

ToastMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return (i32)(value * scale)
}

ToastMetricsFor :: (scale: float, frame: StyleFrame) -> ToastMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: ToastMetrics
    metrics.pad_x = ToastMetric(frame.value.fields, (u32)StylePaddingX,
        frame.value.padding_x, 14.0, scale)
    metrics.pad_y = ToastMetric(frame.value.fields, (u32)StylePaddingY,
        frame.value.padding_y, 10.0, scale)
    metrics.margin = ToastMetric(frame.value.fields, (u32)StyleGap,
        frame.value.gap, 18.0, scale)
    metrics.default_seconds = 3.0
    return metrics
}

ToastDuration :: (seconds: float, metrics: ToastMetrics) -> float #export {
    if seconds <= 0.0 { return metrics.default_seconds }
    return seconds
}

ToastRequestDecisionFor :: (has_message: bool, seconds: float,
    metrics: ToastMetrics) -> ToastRequestDecision #export {
    decision: ToastRequestDecision
    if !has_message {
        decision.clear = true
        return decision
    }
    decision.show = true
    decision.seconds = ToastDuration(seconds, metrics)
    return decision
}

ToastRenderDecisionFor :: (has_message: bool, now_seconds: float,
    until_seconds: float) -> ToastRenderDecision #export {
    decision: ToastRenderDecision
    if !has_message || now_seconds >= until_seconds {
        decision.clear = true
        return decision
    }
    decision.render = true
    return decision
}

ToastTruncationFor :: (text_len: i32, fits: bool) -> ToastTruncation #export {
    truncation: ToastTruncation
    if text_len < 0 { text_len = 0 }
    truncation.prefix_len = text_len
    if fits || text_len <= 3 {
        return truncation
    }
    truncation.prefix_len = text_len - 3
    truncation.ellipsis = true
    return truncation
}

ToastTruncationNext :: (truncation: ToastTruncation,
    fits: bool) -> ToastTruncation #export {
    if fits || !truncation.ellipsis {
        return truncation
    }
    if truncation.prefix_len > 0 {
        truncation.prefix_len = truncation.prefix_len - 1
    }
    return truncation
}

ToastMaxWidth :: (view_width: i32, metrics: ToastMetrics) -> i32 #export {
    width: i32 = view_width - metrics.margin * 2
    if width < 1 { width = 1 }
    return width
}

ToastContentWidth :: (view_width: i32, metrics: ToastMetrics) -> i32 #export {
    width: i32 = ToastMaxWidth(view_width, metrics) - metrics.pad_x * 2
    if width < 1 { width = 1 }
    return width
}

ToastLayoutFor :: (view_width: i32, view_height: i32, text_width: i32,
    line_height: i32, metrics: ToastMetrics) -> ToastLayout #export {
    layout: ToastLayout
    max_width: i32 = ToastMaxWidth(view_width, metrics)
    width: i32 = text_width + metrics.pad_x * 2
    height: i32 = line_height + metrics.pad_y * 2
    if width > max_width { width = max_width }
    if width < 1 { width = 1 }
    if height < 1 { height = 1 }
    layout.bounds.x = (float)((view_width - width) / 2)
    layout.bounds.y = (float)(view_height - height - metrics.margin)
    layout.bounds.width = (float)width
    layout.bounds.height = (float)height
    layout.text_bounds.x = layout.bounds.x + (float)((width - text_width) / 2)
    layout.text_bounds.y = layout.bounds.y + (float)metrics.pad_y
    layout.text_bounds.width = (float)(width - metrics.pad_x * 2)
    layout.text_bounds.height = (float)line_height
    if layout.text_bounds.width < 0.0 { layout.text_bounds.width = 0.0 }
    layout.content_width = ToastContentWidth(view_width, metrics)
    return layout
}
