#import "geometry"
#import "control_props"
#import "reorder_props"
#import "style"

using StyleField;

ReorderDragMotion :: struct {
    dragging: s32
    scroll_offset: s32
}

ReorderLifecycleDecision :: struct {
    cancel_active: bool
    ignore_list: bool
}

ReorderPressDecision :: struct {
    can_press: bool
}

ReorderReleaseDecision :: struct {
    capture_input: bool
    commit: bool
    cancel_active: bool
}

ReorderMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0.0 { value = fallback }
    return cast(s32)(value * scale)
}
#program_export
ReorderMetricsFor :: (scale: float32, handle_width: s32, drag_threshold: s32,
    auto_scroll_margin: s32, auto_scroll_step: s32, handle: StyleFrame,
    placeholder: StyleFrame) -> ReorderMetrics {
    metrics: ReorderMetrics

    metrics.handle_width = handle_width
    if metrics.handle_width <= 0 {
        metrics.handle_width = ReorderMetric(handle.value.fields,
            cast(u32)StyleContentOffset, handle.value.offset_x, 36.0, scale)
    }

    metrics.drag_threshold = drag_threshold
    if metrics.drag_threshold <= 0 {
        metrics.drag_threshold = ReorderMetric(handle.value.fields,
            cast(u32)StyleContentOffset, handle.value.offset_y, 5.0, scale)
    }

    metrics.auto_scroll_margin = auto_scroll_margin
    if metrics.auto_scroll_margin <= 0 {
        metrics.auto_scroll_margin = ReorderMetric(placeholder.value.fields,
            cast(u32)StyleContentOffset, placeholder.value.offset_x, 34.0, scale)
    }

    metrics.auto_scroll_step = auto_scroll_step
    if metrics.auto_scroll_step <= 0 {
        metrics.auto_scroll_step = ReorderMetric(placeholder.value.fields,
            cast(u32)StyleContentOffset, placeholder.value.offset_y, 12.0, scale)
    }

    return metrics
}

#program_export
ReorderHandleBounds :: (item_bounds: Rectangle, handle_width: s32,
    handle_height: s32) -> Rectangle {
    handle: Rectangle = item_bounds
    handle.width = cast(float32)handle_width
    if handle_height > 0 {
        limit: float32 = cast(float32)handle_height
        if handle.height > limit {
            handle.height = limit
        }
    }
    return handle
}

#program_export
ReorderHandlePaintFor :: (bounds: Rectangle, scale: float32,
    handle: StyleFrame) -> ReorderHandlePaint {
    paint: ReorderHandlePaint
    w: s32 = cast(s32)bounds.width
    h: s32 = cast(s32)bounds.height
    if w <= 0 || h <= 0 { return paint }

    dot: s32 = ReorderMetric(handle.value.fields, cast(u32)StyleIconSize,
        handle.value.icon_size, 3.0, scale)
    gap: s32 = ReorderMetric(handle.value.fields, cast(u32)StyleGap,
        handle.value.gap, 4.0, scale)
    col_gap: s32 = ReorderMetric(handle.value.fields, cast(u32)StylePaddingX,
        handle.value.padding_x, 8.0, scale)
    if dot <= 0 { return paint }
    if gap < 0 { gap = 0 }
    if col_gap < 0 { col_gap = 0 }

    total_w: s32 = dot * 2 + col_gap
    total_h: s32 = dot * 3 + gap * 2
    start_x: s32 = cast(s32)bounds.x + (w - total_w) / 2
    start_y: s32 = cast(s32)bounds.y + (h - total_h) / 2

    paint.dot0 = ReorderDotBounds(start_x, start_y, dot)
    paint.dot1 = ReorderDotBounds(start_x + dot + col_gap, start_y, dot)
    paint.dot2 = ReorderDotBounds(start_x, start_y + dot + gap, dot)
    paint.dot3 = ReorderDotBounds(start_x + dot + col_gap, start_y + dot + gap, dot)
    paint.dot4 = ReorderDotBounds(start_x, start_y + (dot + gap) * 2, dot)
    paint.dot5 = ReorderDotBounds(start_x + dot + col_gap, start_y + (dot + gap) * 2, dot)
    paint.dot_count = 6
    return paint
}

ReorderDotBounds :: (x: s32, y: s32, size: s32) -> Rectangle {
    return Rectangle.{.x = cast(float32)x, .y = cast(float32)y, .width = cast(float32)size,
        .height = cast(float32)size}
}
#program_export
ReorderTargetIndexFor :: (target: s32, item_count: s32) -> s32 {
    if item_count <= 0 { return -1 }
    if target < 0 { return 0 }
    limit: s32 = item_count - 1
    if target > limit { return limit }
    return target
}

#program_export
ReorderListResultDefault :: (pointer_y: s32) -> ReorderListResult {
    return ReorderListResult.{.from_index = -1, .to_index = -1, .active_index = -1,
        .target_index = -1, .pointer_y = pointer_y}
}
#program_export
ReorderListActiveResultFor :: (from_index: s32, active_index: s32,
    target_index: s32, active_id: s32, pointer_y: s32,
    press_y: s32) -> ReorderListResult {
    result: ReorderListResult = ReorderListResultDefault(pointer_y)
    result.active = 1
    result.from_index = from_index
    result.to_index = target_index
    result.active_index = active_index
    result.target_index = target_index
    result.active_id = active_id
    result.drag_delta_y = pointer_y - press_y
    return result
}

#program_export
ReorderListCommitResultFor :: (active: ReorderListResult,
    item_count: s32) -> ReorderListResult {
    result: ReorderListResult = active
    result.dragging = 0
    result.from_index = active.active_index
    result.committed = 0
    if result.target_index >= 0 && result.target_index < item_count &&
       result.target_index != active.active_index {
        result.committed = 1
    }
    return result
}

#program_export
ReorderForeignActiveListFor :: (has_active_list: bool,
    active_list_id: s32, list_id: s32,
    mouse_down: bool) -> ReorderLifecycleDecision {
    decision: ReorderLifecycleDecision
    if has_active_list && active_list_id != list_id {
        decision.ignore_list = true
        if !mouse_down {
            decision.cancel_active = true
        }
    }
    return decision
}

#program_export
ReorderActiveItemLifecycleFor :: (active_index: s32, item_count: s32,
    has_items: bool, active_item_disabled: bool) -> ReorderLifecycleDecision {
    decision: ReorderLifecycleDecision
    if active_index < 0 || active_index >= item_count || !has_items ||
        active_item_disabled {
        decision.cancel_active = true
        decision.ignore_list = true
    }
    return decision
}

#program_export
ReorderPressFor :: (list_id: s32, has_items: bool, item_count: s32,
    mouse_pressed: bool, captured: bool, pointer_owner_none: bool,
    inside_bounds: bool) -> ReorderPressDecision {
    decision: ReorderPressDecision
    decision.can_press = list_id != 0 && has_items && item_count > 0 &&
        mouse_pressed && !captured && pointer_owner_none && inside_bounds
    return decision
}

#program_export
ReorderReleaseFor :: (mouse_released: bool,
    was_dragging: bool) -> ReorderReleaseDecision {
    decision: ReorderReleaseDecision
    decision.capture_input = mouse_released
    decision.commit = mouse_released && was_dragging
    decision.cancel_active = true
    return decision
}

#program_export
ReorderDragMotionFor :: (pointer_y: s32, press_y: s32, was_dragging: s32,
    bounds: Rectangle, viewport_top: s32, viewport_bottom: s32,
    scroll_offset: s32, max_scroll: s32,
    metrics: ReorderMetrics) -> ReorderDragMotion {
    motion: ReorderDragMotion
    dy: s32 = pointer_y - press_y
    abs_dy: s32 = dy
    if abs_dy < 0 { abs_dy = -abs_dy }

    motion.dragging = was_dragging
    if motion.dragging == 0 && abs_dy >= metrics.drag_threshold {
        motion.dragging = 1
    }

    motion.scroll_offset = scroll_offset
    if motion.dragging == 0 || max_scroll <= 0 {
        return motion
    }

    view_top: s32 = viewport_top
    if view_top <= 0 { view_top = cast(s32)bounds.y }
    view_bottom: s32 = viewport_bottom
    if view_bottom <= 0 { view_bottom = cast(s32)(bounds.y + bounds.height) }

    if pointer_y < view_top + metrics.auto_scroll_margin {
        motion.scroll_offset -= metrics.auto_scroll_step
    } else if pointer_y > view_bottom - metrics.auto_scroll_margin {
        motion.scroll_offset += metrics.auto_scroll_step
    }
    if motion.scroll_offset < 0 { motion.scroll_offset = 0 }
    if motion.scroll_offset > max_scroll { motion.scroll_offset = max_scroll }
    return motion
}
