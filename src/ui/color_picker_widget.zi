#import "session"
#import "color_picker"
#import "color_picker_props"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "slider"
#import "slider_props"
#import "slider_widget"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "widget_kind"

#program_export
ColorPickerDefaultFace :: (swatch: bool,
    disabled: bool) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleBorderWidth |
        cast(u32)StyleRadius | cast(u32)StyleOpacity |
        cast(u32)StyleFontSize | cast(u32)StylePaddingX |
        cast(u32)StylePaddingY | cast(u32)StyleGap |
        cast(u32)StyleIconSize | cast(u32)StyleContentOffset
    face.background = cast(u32)0x00000000
    face.foreground = cast(u32)0x171717ff
    face.border = cast(u32)0x00000000
    face.opacity = 1.0
    face.radius = 4.0
    face.font_size = 14.0
    face.padding_x = 6.0
    face.padding_y = 2.0
    face.gap = 4.0
    face.icon_size = 36.0
    face.offset_x = 20.0
    face.offset_y = 28.0
    if swatch {
        face.border = cast(u32)0x737373ff
        face.border_width = 1.0
    }
    if disabled { face.opacity = 0.45 }
    return face
}

#program_export
ColorPickerFace :: (props: ColorPickerProps,
    swatch: bool) -> StyleFrame {
    kind: s32 = StyleKindColorPicker()
    if swatch { kind = StyleKindColorPickerSwatch() }
    state: s32 = ButtonStateNormal
    if props.disabled { state = ButtonStateDisabled }
    facts: StyleFacts = StyleControlRoleFacts(kind, props.id,
        props.class_name, StyleAny(),
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisFilled,
        cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(),
        ColorPickerDefaultFace(swatch, props.disabled), facts, state)
    return frame
}

#program_export
ColorPickerChannelLabel :: (index: s32) -> string {
    if index == 0 { return "R" }
    if index == 1 { return "G" }
    if index == 2 { return "B" }
    return "A"
}

#program_export
ColorPickerChannels :: (requested: s32) -> s32 {
    if requested >= 4 { return 4 }
    return 3
}

#program_export
ColorPickerSliderBounds :: (row: Rectangle, thumb_radius: float32,
    label_height: s32, picker: bool,
    scale: float32) -> Rectangle {
    if scale <= 0.0 { scale = 1.0 }
    if thumb_radius < 0.0 { thumb_radius = 0.0 }
    left: float32 = thumb_radius
    right: float32 = thumb_radius
    if picker {
        left += 12.0 * scale
    } else {
        row.y += cast(float32)label_height
        row.height -= cast(float32)label_height
        if row.height < 0.0 { row.height = 0.0 }
    }
    row.x += left
    row.width -= left + right
    if row.width < 0.0 { row.width = 0.0 }
    return row
}

// A zero key uses the containing tree's next key; child sliders use stable
// per-channel keys. The returned values belong to the caller's next frame.
#program_export
ColorPicker :: (session: Session, props: ColorPickerProps) -> ColorPickerResult {
    result: ColorPickerResult
    result.node = -1
    index: s32 = 0
    while index < 4 {
        result.values[index] = props.values[index]
        index += 1
    }
    bounds: Rectangle = props.bounds
    parent: Rectangle = TreeCurrentParentBounds(session)
    if bounds.width <= 0.0 { bounds.width = parent.width }
    if bounds.height <= 0.0 { bounds.height = parent.height }
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return result }
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    if key == cast(u64)0 { key = TreeNextKey(session) }
    if TreeIsBuilding(session) {
        result.node = TreeSubmitCurrent(session, key,
            WidgetKindColorPicker, bounds)
        if result.node < 0 { return result }
        bounds = TreeSubmittedNodeAt(session, result.node).bounds
        if !TreePushScope(session, result.node) { return result }
    }
    channels: s32 = ColorPickerChannels(props.channels)
    scale: float32 = props.scale
    if scale <= 0.0 { scale = 1.0 }
    frame: StyleFrame = ColorPickerFace(props, false)
    swatch_face: StyleFrame = ColorPickerFace(props, true)
    slider_state: s32 = ButtonStateNormal
    if props.disabled { slider_state = ButtonStateDisabled }
    thumb_face: StyleFrame = SliderFaceFor(ActiveStyleRules(),
        props.id, props.class_name, props.disabled,
        StyleKindSliderThumb(), StyleAny(),
        cast(ButtonTone)ButtonToneAccent, slider_state)
    thumb_radius: float32 = cast(float32)SliderThumbSizeForStyle(
        thumb_face, 1.0) * 0.5
    layout: ColorPickerLayout = ColorPickerLayoutFor(bounds,
        channels, scale, frame)
    rows: Rectangle = bounds
    if !props.picker {
        if props.label != "" {
            font: s32 = ResolveFont(0,
                StyleFontValue(frame.value.fields,
                    frame.value.font_size), 14)
            line_height: s32 = GlyphLineHeight(font,
                frame.value.typeface)
            title: Rectangle = bounds
            title.height = cast(float32)line_height
            title_node: s32 = -1
            if TreeIsBuilding(session) {
                title_node = TreeSubmitCurrent(session, cast(u64)10,
                    WidgetKindText, title)
                TreeSetLabel(session, title_node, props.label)
            }
            PaintClippedLabel(session, title_node, props.label,
                cast(s32)bounds.x, cast(s32)bounds.y, font,
                ColorFromPacked(Opacity(frame.value.foreground,
                    StyleOpacityValue(frame.value.fields,
                        frame.value.opacity))), title)
            rows.y += cast(float32)(line_height + 4)
            rows.height -= cast(float32)(line_height + 4)
            if rows.height < 0.0 { rows.height = 0.0 }
        }
    }
    index = 0
    while index < channels {
        slider: SliderProps
        slider.key = cast(u64)(index + 1)
        row: Rectangle
        if props.picker {
            row = ColorPickerChannelBounds(bounds,
                index, channels, scale, frame)
        } else {
            row = SliderCellBoundsFor(rows,
                channels, index)
        }
        font: s32 = ResolveFont(0,
            StyleFontValue(frame.value.fields,
                frame.value.font_size), 14)
        line_height: s32 = GlyphLineHeight(font,
            frame.value.typeface)
        slider.bounds = ColorPickerSliderBounds(row,
            thumb_radius, line_height, props.picker, scale)
        slider.id = ColorPickerChannelIdFor(props.id, index)
        slider.semantic_label = ColorPickerChannelLabel(index)
        slider.value = result.values[index]
        slider.min = 0.0
        slider.max = 1.0
        slider.disabled = props.disabled
        slider.class_name = props.class_name
        step: SliderStep = Slider(session, slider)
        result.values[index] = step.value
        if step.changed { result.changed = true }
        label_y: s32 = cast(s32)row.y
        if props.picker {
            label_y = cast(s32)(row.y +
                (row.height - cast(float32)line_height) * 0.5)
        }
        label_node: s32 = -1
        if TreeIsBuilding(session) {
            label_node = TreeSubmitCurrent(session, cast(u64)(index + 6),
                WidgetKindText, row)
            TreeSetLabel(session, label_node,
                ColorPickerChannelLabel(index))
        }
        PaintClippedLabel(session, label_node,
            ColorPickerChannelLabel(index),
            cast(s32)(row.x + 2.0 * scale), label_y,
            font, ColorFromPacked(Opacity(
                frame.value.foreground,
                StyleOpacityValue(frame.value.fields,
                    frame.value.opacity))), row)
        index += 1
    }
    if props.picker {
        swatch: Rectangle = layout.swatch_bounds
        node: s32 = -1
        if TreeIsBuilding(session) {
            node = TreeSubmitCurrent(session, cast(u64)5,
                WidgetKindCustom, swatch)
            TreeSetLabel(session, node, props.label)
        }
        paint: ColorPickerSwatchPaint = ColorPickerSwatchPaintFor(
            swatch, ColorPickerSwatchLabelInset(scale, swatch_face),
            14.0)
        color: Color = ColorPickerColorFor(result.values[0],
            result.values[1], result.values[2], result.values[3],
            channels)
        PaintRoundedFill(session, node, paint.bounds,
            swatch_face.value.radius, 12, color)
        if swatch_face.value.border_width > 0.0 {
            PaintRoundedOutline(session, node, paint.bounds,
                swatch_face.value.radius, 12,
                swatch_face.value.border_width,
                ColorFromPacked(Opacity(swatch_face.value.border,
                    StyleOpacityValue(swatch_face.value.fields,
                        swatch_face.value.opacity))))
        }
        if props.label != "" {
            font: s32 = ResolveFont(0,
                StyleFontValue(swatch_face.value.fields,
                    swatch_face.value.font_size), 14)
            line_height: s32 = GlyphLineHeight(font,
                swatch_face.value.typeface)
            paint = ColorPickerSwatchPaintFor(swatch,
                ColorPickerSwatchLabelInset(scale, swatch_face),
                cast(float32)line_height)
            PaintClippedLabel(session, node, props.label,
                cast(s32)paint.label_x, cast(s32)paint.label_y,
                font, ColorFromPacked(Opacity(
                    swatch_face.value.foreground,
                    StyleOpacityValue(swatch_face.value.fields,
                        swatch_face.value.opacity))), swatch)
        }
    }
    if TreeIsBuilding(session) { End(session) }
    return result
}
