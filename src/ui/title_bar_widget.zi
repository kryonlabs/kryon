#import "session"
#import "button_props"
#import "button_widget"
#import "control_props"
#import "drawing_props"
#import "dropdown_props"
#import "dropdown_widget"
#import "font_metrics"
#import "geometry"
#import "image_props"
#import "paint_queue"
#import "style"
#import "style_sheet"
#import "surface"
#import "title_bar"
#import "title_bar_props"
#import "tree"
#import "widget_kind"

#program_export
TitleBarDefaultFace :: (role: s32) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleBorderWidth |
        cast(u32)StyleRadius | cast(u32)StyleOpacity |
        cast(u32)StylePaddingX | cast(u32)StyleGap |
        cast(u32)StyleIconSize | cast(u32)StyleContentOffset |
        cast(u32)StyleFontSize
    face.background = cast(u32)0xf8fafcff
    face.foreground = cast(u32)0x111827ff
    face.border = cast(u32)0xcbd5e1ff
    face.opacity = 1.0
    face.padding_x = 12.0
    face.gap = 4.0
    face.icon_size = 32.0
    face.offset_x = 60.0
    face.font_size = 18.0
    if role == TitleBarTitleRole() {
        face.padding_x = 16.0
        face.icon_size = 48.0
    } else if role == TitleBarActionRole() {
        face.icon_size = 18.0
        face.padding_x = 10.0
    }
    return face
}

#program_export
TitleBarFaceFor :: (props: TitleBarProps,
    role: s32) -> StyleFrame {
    facts: StyleFacts = StyleControlRoleFacts(
        StyleKindTitleBar(), props.id, props.class_name, role,
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisSoft,
        cast(s32)ControlSizeMedium, cast(s32)ButtonStateNormal)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(),
        TitleBarDefaultFace(role), facts,
        cast(s32)ButtonStateNormal)
    return frame
}

#program_export
TitleBarKey :: (session: Session, props: TitleBarProps) -> u64 {
    if props.key != cast(u64)0 { return props.key }
    if props.id > 0 { return cast(u64)cast(u32)props.id }
    return TreeNextKey(session)
}

#program_export
TitleBarLayoutAt :: (bounds: Rectangle, has_leading: bool,
    has_dropdown: bool, dropdown_height: s32,
    dropdown_min_width: s32,
    metrics: TitleBarMetrics) -> TitleBarLayout {
    layout: TitleBarLayout = TitleBarLayoutFor(cast(s32)bounds.width,
        cast(s32)bounds.height, has_leading, has_dropdown,
        dropdown_height, dropdown_min_width, metrics)
    layout.bounds = bounds
    layout.leading_bounds.x += bounds.x
    layout.leading_bounds.y += bounds.y
    layout.title_bounds.x += bounds.x
    layout.title_bounds.y += bounds.y
    layout.dropdown_bounds.x += bounds.x
    layout.dropdown_bounds.y += bounds.y
    return layout
}

// A TitleBar is ordinary checked UI composition. A caller retains the
// dropdown result and passes it back through props.dropdown next frame.
#program_export
TitleBar :: (session: Session, props: TitleBarProps,
    options: []DropdownOption) -> TitleBarResult {
    result: TitleBarResult
    result.node = -1
    result.dropdown.node = -1
    result.dropdown.open = props.dropdown.open
    result.dropdown.selected_index = props.dropdown.selected_index
    result.dropdown.highlight_index = props.dropdown.highlight_index
    result.dropdown.scroll_offset = props.dropdown.scroll_offset
    bar: StyleFrame = TitleBarFaceFor(props, TitleBarBarRole())
    title: StyleFrame = TitleBarFaceFor(props, TitleBarTitleRole())
    action: StyleFrame = TitleBarFaceFor(props,
        TitleBarActionRole())
    scale: float32 = props.scale
    if scale <= 0.0 { scale = 1.0 }
    metrics: TitleBarMetrics = TitleBarMetricsFor(scale,
        bar, title, action)
    requested_height: s32 = props.height
    if requested_height <= 0 && props.bounds.height > 0.0 {
        requested_height = cast(s32)props.bounds.height
    }
    state: TitleBarState = TitleBarStateFor(requested_height,
        TitleBarDefaultHeightFor(scale, bar),
        props.has_leading_action,
        props.has_dropdown && (cast(s32)options.count) > 0)
    result.height = state.height
    bounds: Rectangle = props.bounds
    if bounds.width <= 0.0 {
        parent: Rectangle = TreeCurrentParentBounds(session)
        bounds.x = parent.x
        bounds.width = parent.width
    }
    bounds.height = cast(float32)state.height
    if bounds.width <= 0.0 || bounds.height <= 0.0 {
        return result
    }
    key: u64 = TitleBarKey(session, props)
    if TreeIsBuilding(session) {
        result.node = TreeSubmitCurrent(session, key, WidgetKindTitleBar,
            bounds)
        if result.node < 0 { return result }
        TreeSetLabel(session, result.node, props.title)
        bounds = TreeSubmittedNodeAt(session, result.node).bounds
    }
    layout: TitleBarLayout = TitleBarLayoutAt(bounds,
        state.has_leading, state.has_dropdown,
        props.dropdown_height, props.dropdown_min_width,
        metrics)
    opacity: float32 = StyleOpacityValue(bar.value.fields,
        bar.value.opacity)
    PaintRoundedFill(session, result.node, bounds, bar.value.radius, 12,
        ColorFromPacked(Opacity(bar.value.background, opacity)))
    if bar.value.border_width > 0.0 {
        PaintRoundedOutline(session, result.node, bounds, bar.value.radius,
            12, bar.value.border_width,
            ColorFromPacked(Opacity(bar.value.border, opacity)))
    }
    PaintLine(session, result.node, Rectangle.{bounds.x,
        bounds.y + bounds.height - 1.0, bounds.width, 0.0},
        ColorFromPacked(Opacity(bar.value.border, opacity)))
    if state.has_leading {
        button: ButtonProps
        button.key = key * cast(u64)65599 + cast(u64)1
        button.bounds = layout.leading_bounds
        button.id = props.id
        button.class_name = props.class_name
        button.style_kind = StyleKindTitleBar()
        button.style_role = TitleBarActionRole()
        button.tone = cast(ButtonTone)ButtonToneNeutral
        button.emphasis = cast(ButtonEmphasis)ButtonEmphasisSoft
        button.icon_only = true
        button.circle = true
        button.image = props.leading_image
        button.label = props.leading_label
        button.arrow = props.leading_image.asset_path == "" &&
            props.leading_image.texture.id == cast(u32)0
        button.direction = cast(ArrowDirection)ArrowLeft
        result.clicked_leading = SubmitButton(session, button,
            result.node) != 0
    }
    if state.has_dropdown {
        dropdown: DropdownProps = props.dropdown
        dropdown.bounds = layout.dropdown_bounds
        if dropdown.key == cast(u64)0 {
            dropdown.key = key * cast(u64)65599 + cast(u64)2
        }
        if dropdown.id <= 0 { dropdown.id = props.id }
        if dropdown.class_name <= 0 {
            dropdown.class_name = props.class_name
        }
        if dropdown.scale <= 0.0 { dropdown.scale = scale }
        result.dropdown = Dropdown(session, dropdown, options)
        return result
    }
    if props.title != "" {
        font: s32 = ResolveFont(0,
            StyleFontValue(title.value.fields,
                title.value.font_size), 18)
        width: s32 = GlyphWidth(props.title, font,
            title.value.typeface)
        while TitleBarShouldShrinkTitleFont(width,
            cast(s32)layout.title_bounds.width, font, 12) {
            font = TitleBarShrinkTitleFontStep(width,
                cast(s32)layout.title_bounds.width, font, 12)
            width = GlyphWidth(props.title, font,
                title.value.typeface)
        }
        line_height: s32 = GlyphLineHeight(font,
            title.value.typeface)
        paint: TitleBarTitlePaint = TitleBarTitlePaintFor(
            layout, width, line_height)
        PaintClippedLabel(session, result.node, props.title, paint.x,
            paint.y, font, ColorFromPacked(Opacity(
                title.value.foreground,
                StyleOpacityValue(title.value.fields,
                    title.value.opacity))), layout.title_bounds)
    }
    return result
}
