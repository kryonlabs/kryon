#module "checkbox_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/checkbox.h"
#import "ui/widget_input.h"

CheckboxFrame :: (tone: ButtonTone, state: ButtonState,
disabled: i32, selected: i32, class_name: i32,
role: i32) -> StyleFrame {
    props: ButtonProps
    props.class_name = class_name
    props.tone = tone
    props.emphasis = ButtonEmphasisOutline
    if tone == ButtonToneAccent { props.emphasis = ButtonEmphasisFilled }
    props.size = ControlSizeMedium
    props.disabled = disabled
    props.selected = selected
    return ui_control_style_frame_role_kind(props, state, 0,
    0.0, 0.0, 0.0, StyleKindCheckbox(), role)
}

RenderCheckbox :: (checkbox: CheckboxProps) -> i32 #export {
    disabled: i32 = checkbox.disabled || ContentDisabled() ||
    (checkbox.value == nil && checkbox.flags == nil)
    focused: i32 = 0
    pressed: i32 = ui_focusable_pressed(checkbox.bounds, checkbox.id,
    disabled, &focused)
    changed: i32 = 0
    checked: i32 = 0

    if checkbox.flags != nil {
        result: CheckboxFlagResult = CheckboxFlagApply(
        (uint32_t)*checkbox.flags, (uint32_t)checkbox.flags_value,
        pressed != 0)
        checked = result.checked
        changed = result.changed
        if result.changed { *checkbox.flags = (int)result.flags }
    } else if checkbox.value != nil {
        result: CheckboxValueResult = CheckboxValueApply(
        *checkbox.value != 0, pressed != 0, true)
        checked = result.checked
        changed = result.changed
        if result.changed { *checkbox.value = result.checked }
    }

    if IsWindowReady() {
        runtime_scale: float = (float)Scale(1000) / 1000.0
        mouse: Vector2 = ui_mouse_world()
        hovered: i32 = !disabled && ui_contains(checkbox.bounds, mouse) &&
        !InputCapturesClick(mouse) && HoverEffectsEnabled()
        down: i32 = hovered && IsMouseButtonDown(MOUSE_BUTTON_LEFT)
        state: ButtonState = ui_selection_button_state(hovered, down,
        focused, disabled)
        label_frame: StyleFrame = CheckboxFrame(ButtonToneNeutral,
        state, disabled, checked, checkbox.class_name, CheckboxLabelRole())
        spec: CheckboxSpec
        spec.bounds = checkbox.bounds
        spec.checked = checked != 0
        spec.enabled = disabled == 0
        spec.hovered = hovered != 0
        spec.pressed = down != 0
        spec.focused = focused != 0
        spec.scale = runtime_scale
        spec.box = CheckboxFrame(ButtonToneNeutral, state,
        disabled, checked, checkbox.class_name,
        CheckboxBoxRoleForTone(ButtonToneNeutral))
        spec.active = CheckboxFrame(ButtonToneAccent, state,
        disabled, checked, checkbox.class_name,
        CheckboxBoxRoleForTone(ButtonToneAccent))
        spec.label = label_frame
        paint: CheckboxPaint = CheckboxPaintFor(spec)
        label_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(label_frame).value)
        label_font: i32 = ResolveFont(0,
        StyleFontValue(label_style.fields, label_style.font_size),
        GetFontSize())
        paint.label_color = ColorToInt(label_style.foreground)

        if paint.show_state {
            DrawRectangleRounded(paint.state_bounds,
            paint.state_radius, 8, GetColor(paint.state_color))
        }
        if paint.show_focus {
            DrawRectangleRoundedLinesEx(paint.focus_bounds,
            paint.focus_radius, 8, paint.border_width,
            GetColor(paint.focus_color))
        }
        if paint.show_fill {
            DrawRectangleRounded(paint.box_bounds, paint.radius, 8,
            GetColor(paint.fill_color))
        }
        DrawRectangleRoundedLinesEx(paint.box_bounds, paint.radius, 8,
        paint.border_width, GetColor(paint.border_color))
        if paint.show_mark {
            DrawLineEx(paint.check_start, paint.check_middle,
            paint.mark_width, GetColor(paint.mark_color))
            DrawLineEx(paint.check_middle, paint.check_end,
            paint.mark_width, GetColor(paint.mark_color))
        }
        label_x: float = CheckboxLabelXFor(paint.slot_bounds,
        runtime_scale, label_frame)
        label_y: float = CheckboxLabelYFor(checkbox.bounds,
        (float)TextLineHeight(label_font))
        label: const char* = checkbox.label
        if label == nil { label = "" }
        RenderText(label, (int)label_x, (int)label_y,
        label_font, Fade(GetColor(paint.label_color),
        label_style.opacity))
    }
    return changed
}

DrawDisabledCheckboxToggle :: (x: i32, y: i32,
label: const char*, value: *i32, disabled: i32) -> i32 #export {
    editor_id: [96]char
    runtime_scale: float = (float)Scale(1000) / 1000.0
    disabled = disabled || value == nil
    checked: i32 = value != nil && *value != 0
    initial_state: ButtonState = ButtonStateNormal
    if disabled != 0 { initial_state = ButtonStateDisabled }
    label_frame: StyleFrame = CheckboxFrame(ButtonToneNeutral,
    initial_state, disabled, checked, 0, CheckboxLabelRole())
    label_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(label_frame).value)
    font: i32 = ResolveFont(0,
    StyleFontValue(label_style.fields, label_style.font_size),
    GetFontSize())
    label_width: i32 = TextWidth(label, font)
    box_frame: StyleFrame = CheckboxFrame(ButtonToneNeutral,
    initial_state, disabled, checked, 0,
    CheckboxBoxRoleForTone(ButtonToneNeutral))
    layout: CheckboxLayout = CheckboxLayoutForText(
    (float)x, (float)y, (float)label_width,
    (float)TextLineHeight(font), runtime_scale,
    box_frame, label_frame)
    bounds: Rectangle = layout.bounds
    mouse_world: Vector2 = ui_mouse_world()
    can_draw: i32 = IsWindowReady()

    widget: Widget = BeginWidget("Checkbox",
    ui_inspect_control_id(editor_id, sizeof(editor_id),
    "Checkbox", 0, label),
    bounds, WidgetFlagMovable | WidgetFlagResizable)
    bounds = widget.bounds
    x = (int)bounds.x
    y = (int)bounds.y
    interaction: InputPointerInteraction = InputPointerInteractionFor(
    CheckCollisionPointRec(mouse_world, bounds) != 0,
    InputCapturesClick(mouse_world) != 0, disabled != 0,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0, false, true)
    if interaction.disabled_marker { MarkDisabled() }
    if interaction.active { MarkClickable() }
    result: CheckboxValueResult = CheckboxValueApply(
    checked != 0, interaction.activated != 0, value != nil)
    pressed: i32 = result.changed
    checked = result.checked
    if result.changed && value != nil {
        *value = result.checked
    }
    if pressed != 0 && interaction.consume_release {
        ConsumeRelease()
    }
    if !can_draw {
        EndWidget(&widget)
        return pressed
    }

    hovered: i32 = interaction.hovered
    down: i32 = hovered && IsMouseButtonDown(MOUSE_BUTTON_LEFT)
    state: ButtonState = ui_selection_button_state(
    hovered, down, 0, disabled)
    label_frame = CheckboxFrame(ButtonToneNeutral,
    state, disabled, checked, 0, CheckboxLabelRole())
    label_style = ui_unpack_style(
    ui_style_apply_effects_frame(label_frame).value)
    font = ResolveFont(0,
    StyleFontValue(label_style.fields, label_style.font_size), font)
    box_frame = CheckboxFrame(ButtonToneNeutral, state,
    disabled, checked, 0,
    CheckboxBoxRoleForTone(ButtonToneNeutral))
    layout = CheckboxLayoutForText(
    (float)x, (float)y, (float)label_width,
    (float)TextLineHeight(font), runtime_scale,
    box_frame, label_frame)
    active_frame: StyleFrame = CheckboxFrame(ButtonToneAccent,
    state, disabled, checked, 0,
    CheckboxBoxRoleForTone(ButtonToneAccent))
    spec: CheckboxSpec = (CheckboxSpec){0}
    spec.bounds = bounds
    spec.checked = checked != 0
    spec.enabled = disabled == 0
    spec.hovered = hovered != 0
    spec.pressed = down != 0
    spec.focused = false
    spec.scale = runtime_scale
    spec.box = box_frame
    spec.active = active_frame
    spec.label = label_frame
    paint: CheckboxPaint = CheckboxPaintFor(spec)
    paint.label_color = Opacity(ColorToInt(label_style.foreground),
    label_style.opacity)
    if paint.show_state {
        DrawRectangleRounded(paint.state_bounds,
        paint.state_radius, 8, GetColor(paint.state_color))
    }
    if paint.show_focus {
        DrawRectangleRoundedLinesEx(paint.focus_bounds,
        paint.focus_radius, 8, paint.border_width,
        GetColor(paint.focus_color))
    }
    if paint.show_fill {
        DrawRectangleRounded(paint.box_bounds, paint.radius, 8,
        GetColor(paint.fill_color))
    }
    DrawRectangleRoundedLinesEx(paint.box_bounds, paint.radius, 8,
    paint.border_width, GetColor(paint.border_color))
    if paint.show_mark {
        DrawLineEx(paint.check_start, paint.check_middle,
        paint.mark_width, GetColor(paint.mark_color))
        DrawLineEx(paint.check_middle, paint.check_end,
        paint.mark_width, GetColor(paint.mark_color))
    }
    RenderText(label, (int)layout.label_x, (int)layout.label_y,
    font, GetColor(paint.label_color))
    EndWidget(&widget)
    return pressed
}

RenderCheckboxToggle :: (x: i32, y: i32,
label: const char*, value: *i32) -> i32 #export {
    return DrawDisabledCheckboxToggle(x, y, label, value, 0)
}
