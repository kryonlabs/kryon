#import "kryon.h"

app "Generated Buttons Layout Parity" {
    size 420 220
    fps 60
}

state {
    buttons_action: int = 0
}

disabled_return_scope :: () {
    blocked: bool = true
    Disabled {
        when = (blocked)
        return
    }
}

disabled_loop_scope :: () {
    i: int = 0
    while i < 2 {
        i += 1
        Disabled {
            if i == 1 {
                continue
            }
            break
        }
    }
}

buttons_frame :: () #ui {
    disabled_return_scope()
    disabled_loop_scope()
    Screen root: {
        Column layout_column: {
            bounds = {20,20,220,80}
            gap = 6
            padding = 6
            key = Key("layout-column")
            Text((TextProps){.bounds={0, 0, 0, 0}, .text="Actions", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Row layout_row: {
                bounds = {0,0,200,36}
                gap = 8
                padding = 0
                key = Key("layout-row")
                Disabled saving: {
                    when = 2 >= 1
                    Disabled {
                        when = false
                        if Button((ButtonProps){.bounds = {20,120,80,32}, .label = "Save", .style = ButtonStylePrimary, .font = Text16, .id = 501}) {
                            buttons_action += 1
                        }
                    }
                }
                if Button((ButtonProps){.bounds = {120,120,80,32}, .label = "Cancel", .style = ButtonStyleSecondary, .font = Text16, .id = 502}) {
                    buttons_action += 10
                }
            }
        }
    }
}
