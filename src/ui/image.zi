#import "drawing_props"
#import "geometry"
#import "image_props"

// Matches the ImageFit host contract without exporting a second public enum.
ImagePlaceholderLayout :: struct {
    bounds: Rectangle
    label_x: s32
    label_y: s32
}

#program_export
ImageLabelRole :: () -> s32 {
    return 6
}

#program_export
ImageFitRect :: (image: ImageProps, texture: Texture2D) -> Rectangle {
    return ImageFitBounds(image.bounds, image.source,
        texture.width, texture.height, cast(s32)image.fit)
}

// A mesh replaces the fitted rectangle once it has 2 columns and 2 rows.
#program_export
ImageMeshActive :: (mesh: ImageMesh) -> bool {
    return mesh.columns >= 2 && mesh.rows >= 2
}

// Whether a mesh has a point for every grid position and a grid small
// enough to draw (IMAGE_MESH_POINT_LIMIT points).
#program_export
ImageMeshComplete :: (mesh: ImageMesh) -> bool {
    if !ImageMeshActive(mesh) { return false }
    needed: s64 = cast(s64)mesh.columns * cast(s64)mesh.rows
    return needed <= cast(s64)IMAGE_MESH_POINT_LIMIT && mesh.points.count >= needed
}

#program_export
ImagePolygonValid :: (points: []Vector2) -> bool {
    if points.count < 3 || points.count > IMAGE_MESH_POINT_LIMIT { return false }
    for at: cast(s64)0..points.count - 1 {
        p := points[at]
        if !(p.x >= 0.0 && p.x <= 1.0 && p.y >= 0.0 && p.y <= 1.0) { return false }
    }
    return true
}

// Triangulate a small simple polygon, retaining source vertex indices so
// texture coordinates follow the original image instead of warping it.
ImagePolygonCross :: (a: Vector2, b: Vector2, c: Vector2) -> float32 {
    return (b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x)
}
ImagePolygonTriangulate :: (points: []Vector2, triangles: []s32) -> s32 {
    if !ImagePolygonValid(points) || points.count > 128 || triangles.count < (points.count-2)*3 { return 0 }
    indices: [128]s32
    count := cast(s32)points.count
    area: float32
    previous := points[points.count-1]
    for at: cast(s32)0..count-1 {
        indices[at] = at
        next := points[at]; area += previous.x*next.y-next.x*previous.y; previous = next
    }
    if area > -0.0000001 && area < 0.0000001 { return 0 }
    direction: float32 = ifx area > 0.0 then 1.0 else -1.0
    changed := true
    while changed && count > 3 {
        changed = false
        for at: cast(s32)0..count-1 {
            a := points[indices[(at+count-1)%count]]; b := points[indices[at]]; c := points[indices[(at+1)%count]]
            cross := ImagePolygonCross(a,b,c)
            if cross > -0.0000001 && cross < 0.0000001 &&
                (b.x-a.x)*(b.x-c.x)+(b.y-a.y)*(b.y-c.y) <= 0.0000001 {
                for move: cast(s32)at..count-2 { indices[move] = indices[move+1] }
                count -= 1; changed = true; break
            }
        }
    }
    written: s32
    while count > 3 {
        found := false
        for at: cast(s32)0..count-1 {
            ia := indices[(at+count-1)%count]; ib := indices[at]; ic := indices[(at+1)%count]
            a := points[ia]; b := points[ib]; c := points[ic]
            if ImagePolygonCross(a,b,c)*direction <= 0.0000001 { continue }
            blocked := false
            for check: cast(s32)0..count-1 {
                id := indices[check]
                if id == ia || id == ib || id == ic { continue }
                point := points[id]
                if ImagePolygonCross(a,b,point)*direction >= -0.0000001 &&
                   ImagePolygonCross(b,c,point)*direction >= -0.0000001 &&
                   ImagePolygonCross(c,a,point)*direction >= -0.0000001 { blocked = true; break }
            }
            if blocked { continue }
            triangles[written] = ia; triangles[written+1] = ib; triangles[written+2] = ic; written += 3
            for move: cast(s32)at..count-2 { indices[move] = indices[move+1] }
            count -= 1; found = true; break
        }
        if !found { return 0 }
    }
    triangles[written] = indices[0]; triangles[written+1] = indices[1]; triangles[written+2] = indices[2]
    return written+3
}

// Whether IMAGE may draw its preview while its picture loads.
#program_export
ImagePreviewUsable :: (image: ImageProps) -> bool {
    if image.preview_path == "" || image.texture.id != cast(u32)0 { return false }
    if image.source.width == 0.0 || image.source.height == 0.0 { return true }
    return image.full_size.x > 0.0 && image.full_size.y > 0.0
}

// SOURCE, in the full picture's FULL_SIZE pixels, in the pixels of a preview
// PREVIEW_WIDTH × PREVIEW_HEIGHT. An empty source stays the whole preview.
#program_export
ImagePreviewSource :: (source: Rectangle, full_size: Vector2,
    preview_width: s32, preview_height: s32) -> Rectangle {
    if source.width == 0.0 || source.height == 0.0 ||
        full_size.x <= 0.0 || full_size.y <= 0.0 { return Rectangle.{} }
    sx := cast(float32)preview_width / full_size.x
    sy := cast(float32)preview_height / full_size.y
    return Rectangle.{source.x * sx, source.y * sy, source.width * sx, source.height * sy}
}

// What shows from the picture's and preview's host textures (ImageTextureFor:
// a nonzero id is ready, a negative size is loading). A preview the image
// may not use is passed as an empty texture.
#program_export
ImageShowingFor :: (full: Texture2D, preview: Texture2D) -> ImageShowing {
    if full.id != cast(u32)0 { return ImageShowing.ImageShowingFull }
    if preview.id != cast(u32)0 { return ImageShowing.ImageShowingPreview }
    if full.width < 0 || full.height < 0 || preview.width < 0 || preview.height < 0 {
        return ImageShowing.ImageShowingNone
    }
    return ImageShowing.ImageShowingUnavailable
}

ImageDrawPlan :: struct {
    draw: bool
    source: Rectangle
    destination: Rectangle
    tint: Color
}

#program_export
ImageDrawPlanFor :: (image: ImageProps, texture: Texture2D,
    tint: Color) -> ImageDrawPlan {
    plan: ImageDrawPlan
    if texture.id == cast(u32)0 || texture.width <= 0 ||
        texture.height <= 0 || image.bounds.width <= 0.0 ||
        image.bounds.height <= 0.0 {
        return plan
    }
    plan.draw = true
    plan.source = image.source
    if plan.source.width == 0.0 || plan.source.height == 0.0 {
        plan.source = Rectangle.{0.0, 0.0,
            cast(float32)texture.width, cast(float32)texture.height}
    }
    plan.destination = ImageFitRect(image, texture)
    plan.tint = tint
    if plan.tint.a == cast(u8)0 {
        plan.tint = Color.{cast(u8)255, cast(u8)255, cast(u8)255, cast(u8)255}
    }
    return plan
}

#program_export
ImageFitBounds :: (bounds: Rectangle, source: Rectangle,
    texture_width: s32, texture_height: s32, fit: s32) -> Rectangle {
    dst: Rectangle = bounds
    src_w: float32 = source.width
    src_h: float32 = source.height

    if src_w < 0.0 { src_w = -src_w }
    if src_h < 0.0 { src_h = -src_h }
    if src_w == 0.0 { src_w = cast(float32)texture_width }
    if src_h == 0.0 { src_h = cast(float32)texture_height }

    if fit == 1 || fit == 2 {
        if src_w == 0.0 || src_h == 0.0 {
            return dst
        }
        sx: float32 = bounds.width / src_w
        sy: float32 = bounds.height / src_h
        scale: float32 = sx
        if fit == 2 {
            if sy > scale { scale = sy }
        } else {
            if sy < scale { scale = sy }
        }
        dst.width = src_w * scale
        dst.height = src_h * scale
        dst.x = bounds.x + (bounds.width - dst.width) * 0.5
        dst.y = bounds.y + (bounds.height - dst.height) * 0.5
    }
    return dst
}

#program_export
ImagePlaceholderLayoutFor :: (bounds: Rectangle, text_width: s32,
    font_height: s32) -> ImagePlaceholderLayout {
    return ImagePlaceholderLayout.{.bounds = bounds,
        .label_x = cast(s32)bounds.x + (cast(s32)bounds.width - text_width) / 2,
        .label_y = cast(s32)bounds.y + (cast(s32)bounds.height - font_height) / 2}
}

#program_export
ImagePlaceholderFontFor :: (default_font: s32, style_font: s32) -> s32 {
    if style_font > 0 { return style_font }
    return default_font
}

// Maps a clipped destination strip back to the corresponding texture source.
// The image host uses this when drawing rounded or otherwise clipped images.
#program_export
ImageStripSource :: (source_base: Rectangle, dst: Rectangle,
    strip: Rectangle) -> Rectangle {
    source: Rectangle
    if dst.width == 0.0 || dst.height == 0.0 {
        return source
    }
    source.x = source_base.x +
        (strip.x - dst.x) * source_base.width / dst.width
    source.y = source_base.y +
        (strip.y - dst.y) * source_base.height / dst.height
    source.width = strip.width * source_base.width / dst.width
    source.height = strip.height * source_base.height / dst.height
    return source
}
