#import "session"
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "semantic"
#import "tree"
#import "tree_draw"

using FrameStatus;
host_api :: #system_library "host_api";

// These records deliberately expose values useful for comparing frames, not
// the tree's internal links or queue storage. They also cross the portable
// host boundary without importing internal record types into the host ABI.
FrameNode :: struct {
    key: u64
    parent_key: u64
    kind: s32
    x: float32
    y: float32
    width: float32
    height: float32
    label: string
    semantic_kind: s32
    heading_level: s32
    identity_generation: u64
    interactive: bool
    disabled: bool
    loading: bool
    selected: bool
    focus_id: s32
}

FramePaint :: struct {
    kind: s32
    node: s32
    x: float32
    y: float32
    width: float32
    height: float32
    clip_x: float32
    clip_y: float32
    clip_width: float32
    clip_height: float32
    red: u8
    green: u8
    blue: u8
    alpha: u8
    radius: float32
    segments: s32
    line_width: float32
    value: string
    text_x: s32
    text_y: s32
    font: s32
    asset_path: string
    texture_id: u32
    source_x: float32
    source_y: float32
    source_width: float32
    source_height: float32
    origin_x: float32
    origin_y: float32
    rotation: float32
}

FrameNodeFrom :: (entry: TreeEntry) -> FrameNode {
    node: FrameNode
    node.key = entry.key
    node.parent_key = entry.parent_key
    node.kind = entry.kind
    node.x = entry.bounds.x
    node.y = entry.bounds.y
    node.width = entry.bounds.width
    node.height = entry.bounds.height
    node.label = entry.semantic_label
    node.semantic_kind = cast(s32)entry.semantic_kind
    node.heading_level = entry.heading_level
    node.identity_generation = entry.identity_generation
    node.interactive = entry.interactive
    node.disabled = entry.disabled
    node.loading = entry.loading
    node.selected = entry.selected
    node.focus_id = entry.focus_id
    return node
}

FramePaintFrom :: (command: PaintCommand) -> FramePaint {
    paint: FramePaint
    paint.kind = command.kind
    paint.node = command.node
    paint.x = command.bounds.x
    paint.y = command.bounds.y
    paint.width = command.bounds.width
    paint.height = command.bounds.height
    paint.clip_x = command.clip.x
    paint.clip_y = command.clip.y
    paint.clip_width = command.clip.width
    paint.clip_height = command.clip.height
    paint.red = command.color.r
    paint.green = command.color.g
    paint.blue = command.color.b
    paint.alpha = command.color.a
    paint.radius = command.radius
    paint.segments = command.segments
    paint.line_width = command.line_width
    paint.value = command.value
    paint.text_x = command.x
    paint.text_y = command.y
    paint.font = command.font
    paint.asset_path = command.asset_path
    paint.texture_id = command.texture_id
    paint.source_x = command.source.x
    paint.source_y = command.source.y
    paint.source_width = command.source.width
    paint.source_height = command.source.height
    paint.origin_x = command.origin.x
    paint.origin_y = command.origin.y
    paint.rotation = command.rotation
    return paint
}

// These effects belong to an opt-in inspection host. Ordinary EndFrame does
// not require them. A host may record the values without opening a display.
RecordFrameStart :: (node_count: s32, paint_count: s32) #foreign host_api;
RecordNode :: (index: s32, node: FrameNode) #foreign host_api;
RecordPaint :: (index: s32, command: FramePaint) #foreign host_api;
RecordFrameEnd :: () #foreign host_api;

// Capture only a complete, committed frame. All values are sent before paint
// is flushed, while the queue still contains the commands chosen by widgets.
#program_export
EndFrameCapture :: (session: Session) -> bool {
    if CommitFrame(session) != cast(FrameStatus)FrameOk { return false }
    node_count: s32 = TreeCount(session)
    paint_count: s32 = PendingPaintCount(session)
    RecordFrameStart(node_count, paint_count)
    index: s32 = 0
    while index < node_count {
        RecordNode(index, FrameNodeFrom(TreeNodeAt(session, index)))
        index += 1
    }
    index = 0
    while index < paint_count {
        RecordPaint(index, FramePaintFrom(PendingPaintAt(session, index)))
        index += 1
    }
    RecordFrameEnd()
    PaintFlush(session)
    return true
}
