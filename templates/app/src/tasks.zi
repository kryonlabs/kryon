// The app's state and its text, apart from any widget draw calls, so
// tests can use it. Every task owns its bytes: AddTask copies the strings
// it is given, so a view into a widget's draft buffer never dangles.
#import "std/number_text"
#import "std/text_tools"
Dropdown :: #import "kryon/dropdown";
TextField :: #import "kryon/text_field";

Task :: struct {
    title: [48]u8
    title_length: s32
    detail: [64]u8
    detail_length: s32
    done: bool
}

tasks: [12]Task;
task_count: s32;
summary_text: [48]u8;

// The new-task draft: the field owns and keeps its bytes until AddTask
// copies the text into the model.
draft: TextField.State;

// The app bar's menu options: none yet, but the slice must outlive each
// frame, so the empty list lives here with the rest of the state.
no_menu: []Dropdown.Option;

// The draft's storage, for the text field to bind and clear.
Draft :: () -> *TextField.State { return *draft }

// The draft's current text, for AddTask to copy into a task.
DraftText :: () -> string { return TextField.Value(draft) }

// Empties the draft after its text was copied into a task.
ClearDraft :: () { TextField.Clear(*draft) }

// The app bar's menu options.
MenuOptions :: () -> []Dropdown.Option { return no_menu }

// Copies text into fixed storage; returns the length that fit.
Stored :: (output: []u8, text: string) -> s32 {
    length := ifx text.count > output.count then output.count else text.count
    for index: 0..length - 1 { output[index] = text[index] }
    return cast(s32)length
}

// The first tasks, once.
StartTasks :: () {
    if task_count > 0 { return }
    unused AddTask("Sketch the home screen", "Cards, an app bar and one clear action")
    unused AddTask("Connect real data", "Keep state in src/tasks.zi; widgets only draw it")
    unused AddTask("Check it in dark mode", "The app bar's Dark switch changes the theme")
    tasks[0].done = true
}

TaskCount :: () -> s32 { return task_count }

TaskTitle :: (index: s32) -> string {
    return TextView(tasks[index].title[0:tasks[index].title_length])
}

TaskDetail :: (index: s32) -> string {
    return TextView(tasks[index].detail[0:tasks[index].detail_length])
}

TaskDone :: (index: s32) -> bool { return tasks[index].done }

SetTaskDone :: (index: s32, done: bool) { tasks[index].done = done }

// Adds a task while there is room, copying both strings; false when the
// title is empty or the list is full.
AddTask :: (title: string, detail: string) -> bool {
    title_text := TextTrim(title)
    if title_text.count == 0 || task_count >= cast(s32)tasks.count { return false }
    stored: Task
    stored.title_length = Stored(stored.title[:], title_text)
    stored.detail_length = Stored(stored.detail[:], detail)
    tasks[task_count] = stored
    task_count += 1
    return true
}

// "N of M done", in storage that lives as long as the app.
Summary :: () -> string {
    done: s64 = 0
    for index: 0..task_count - 1 { if tasks[index].done { done += 1 } }
    length: s32 = 0
    digits: [24]u8
    length = Append(summary_text[:], length, FormatInteger(done, digits[:]))
    length = Append(summary_text[:], length, " of ")
    length = Append(summary_text[:], length, FormatInteger(cast(s64)task_count, digits[:]))
    length = Append(summary_text[:], length, " done")
    return TextView(summary_text[0:length])
}

Append :: (output: []u8, length: s32, text: string) -> s32 {
    at := length
    for byte: text {
        if at >= output.count { return at }
        output[at] = byte
        at += 1
    }
    return at
}
