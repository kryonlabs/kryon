
# Byte ranges remain borrowed from the host. Grapheme boundaries and measured
# prefix widths come from its Unicode/font services.
TextLogicalLine :: struct {
    start: s32
    end: s32
    next: s32
    valid: bool
}

#program_export
TextLogicalLineFor :: (text: string, offset: s32) -> TextLogicalLine {
    line: TextLogicalLine
    if offset < 0 { offset = 0 }
    if offset > (cast(s32)text.count) { return line }
    line.valid = true
    line.start = offset
    while offset < (cast(s32)text.count) && text[offset] != cast(u8)10 { offset += 1 }
    line.end = offset
    line.next = offset + 1
    if offset < (cast(s32)text.count) && offset > line.start && text[offset - 1] == cast(u8)13 {
        line.end -= 1
    }
    return line
}

#program_export
TextRowFontFor :: (text: string, start: s32, end: s32, base_font: s32,
headings: bool) -> s32 {
    if !headings || base_font >= 24 { return base_font }
    hashes: s32 = 0
    while start + hashes < end && hashes < 3 && text[start + hashes] == cast(u8)35 {
        hashes += 1
    }
    if hashes > 0 && hashes <= 2 && start + hashes < end && text[start + hashes] == cast(u8)32 {
        return 24
    }
    return base_font
}

TextRowBreak :: struct {
    end: s32
    space: s32
    has_space: bool
    done: bool
}

#program_export
TextRowAdvance :: (state: TextRowBreak, start: s32, next: s32, line_end: s32,
space: bool, measured: float32, max_width: float32, words: bool) -> TextRowBreak {
    if state.done { return state }
    if next > line_end { next = line_end }
    if max_width > 0.0 && measured > max_width && state.end > start {
        if words && state.has_space && state.space > start { state.end = state.space }
        state.done = true
        return state
    }
    if space {
        state.space = state.end
        state.has_space = true
    }
    state.done = next <= state.end || next >= line_end ||
    (max_width > 0.0 && measured > max_width)
    state.end = next
    return state
}

#program_export
TextRowNextStart :: (text: string, offset: s32, end: s32, words: bool) -> s32 {
    if words {
        while offset < end && (text[offset] == cast(u8)32 || text[offset] == cast(u8)9) {
            offset += 1
        }
    }
    return offset
}

#program_export
TextRowHasCursor :: (start: s32, end: s32, line_end: s32, cursor: s32) -> bool {
    return cursor >= start && cursor <= end && (cursor < end || end == line_end)
}

#program_export
TextRowAtY :: (y: s32, height: s32, target: s32, last: bool) -> bool {
    return target < y + height || last
}
