    size_names: [3] const char* = {"Small", "Medium", "Large"}
    sizes: [3] ControlSize = {ControlSizeSmall, ControlSizeMedium, ControlSizeLarge}
    column_x: [8] int = {81, 166, 250, 334, 419, 503, 587, 671}
    size_caption_y: [3] int = {518, 561, 617}
    size_fonts: [3] int = {15, 18, 18}
    size_label_x: [3] int = {-1, 0, 0}
    size_label_y: [3] float = {0, 0, 0}
    state_y: [6] int = {161, 206, 254, 305, 359, 409}
    label_y: [6] int = {169, 215, 265, 316, 370, 419}
    state_heights: [6] int = {34, 36, 36, 38, 38, 40}
    icon_names: [8] const char* = {
