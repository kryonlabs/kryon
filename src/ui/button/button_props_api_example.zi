ButtonProps :: #import "button_props";
#import "control_props"
#import "geometry"

#program_export
main :: () -> s32 {
    props := ButtonProps.Props.{
        .key = 10,
        .id = 10,
        .bounds = Rectangle.{16.0, 16.0, 140.0, 38.0},
        .label = "Save changes",
        .tone = .ButtonToneAccent,
        .emphasis = .ButtonEmphasisFilled,
        .direction = ButtonProps.ArrowDirection.ArrowRight
    }
    if props.label != "Save changes" || props.bounds.width <= 0.0 { return 1 }
    return 0
}
