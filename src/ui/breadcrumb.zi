// Reusable label navigation. No path interpretation or application focus policy.
#import "breadcrumb_props"
#import "session"
#import "button_props"
#import "button"
#import "font_metrics"
#import "button_widget"
#import "control_props"
#import "dropdown"
#import "dropdown_props"
#import "dropdown_widget"
#import "geometry"
#import "overlay_props"
#import "overlay_widget"
#import "scroll_props"
#import "scroll_widget"
#import "semantic"
#import "style"
#import "tree"
#import "tree_input"
#import "widget_kind"
#import "surface"
#import "paint_queue"
#import "drawing_props"

using WidgetKind;
using SemanticKind;

#scope_file
Action :: (props: BreadcrumbProps, item: BreadcrumbItem, index: s32) -> ButtonProps {
    return ButtonProps.{.key = item.key, .label = item.label,
        .id = props.id, .class_name = props.class_name,
        .disabled = props.disabled || item.disabled,
        .selected = props.active_index == index, .fit_content = true,
        .emphasis = ButtonEmphasis.ButtonEmphasisGhost}
}
Width :: (props: BreadcrumbProps, item: BreadcrumbItem, index: s32) -> float32 {
    action := Action(props, item, index)
    state := cast(s32)ButtonState.ButtonStateNormal
    if action.selected { state = cast(s32)ButtonState.ButtonStateSelected }
    if action.disabled { state = cast(s32)ButtonState.ButtonStateDisabled }
    face := ButtonInstalledFaceFor(action, state)
    font := ResolveFont(0, StyleFontValue(face.fields, face.font_size), 14)
    return MeasureBounds(action, face, ButtonMinimumHeight(action.size), font,
        cast(float32)GlyphWidth(item.label, font, face.typeface),
        0.0, 1.0, false, 0.0).width
}
Visible :: (index: s32, first: s32, active: s32) -> bool {
    return index >= first || index == active
}
Activate :: (props: BreadcrumbProps, item: BreadcrumbItem, index: s32,
    result: *BreadcrumbResult) {
    if props.disabled || item.disabled { return }
    result.activated_index = index
    result.activated_key = item.key
    result.changed = index != props.active_index
}
#scope_export

#program_export
Breadcrumb :: (session: Session, props: BreadcrumbProps,
    items: []BreadcrumbItem) -> BreadcrumbResult {
    result := BreadcrumbResult.{.node = -1, .activated_index = -1}
    count := cast(s32)items.count
    bounds := props.bounds
    if count <= 0 || bounds.width <= 0.0 || bounds.height <= 0.0 { return result }
    scope := TreeCurrentPaintGeometry(session)
    view := TreeRootBounds(session)
    if scope.clipped { view = RectangleIntersection(view, scope.clip) }
    if view.width <= 0.0 || view.height <= 0.0 { return result }
    key := props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)props.id }
    if key == cast(u64)0 { key = TreeNextKey(session) }
    parent := TreeCurrentParent(session)
    previous := TreePrevious(session, parent, key, WidgetKindCustom)
    overlay_key := key * cast(u64)65599 + cast(u64)7
    previous_overlay := TreePrevious(session, parent, overlay_key, WidgetKindCustom)
    saved := TreePreviousWidgetState(session, previous)
    was_open := saved.open
    result.open = (was_open || props.open) && !props.close && !props.disabled
    active := props.active_index
    if active < 0 || active >= count { active = -1 }
    // Measured suffix plus the caller's active ancestor. No byte truncation.
    separator := ButtonMeasure(ButtonProps.{.label = "›",
        .emphasis = ButtonEmphasis.ButtonEmphasisGhost, .id = props.id,
        .class_name = props.class_name}).width
    overflow := ButtonProps.{.key = cast(u64)3,
        .label = props.overflow_label, .id = props.id,
        .class_name = props.class_name, .disabled = props.disabled,
        .fit_content = true, .emphasis = ButtonEmphasis.ButtonEmphasisGhost}
    if overflow.label == "" { overflow.label = "…" }
    overflow_width := ButtonMeasure(overflow).width
    total: float32 = 0.0
    for i: 0..count - 1 {
        total += Width(props, items[i], i)
        if i > 0 { total += separator }
    }
    first: s32 = 0
    hidden: s32 = 0
    if total > bounds.width {
        first = count - 1
        used := Width(props, items[first], first) + overflow_width + separator
        if active >= 0 && active < first {
            used += Width(props, items[active], active) + separator
        }
        while first > 0 {
            candidate := first - 1
            extra := Width(props, items[candidate], candidate) + separator
            if candidate == active { extra = 0.0 }
            if used + extra > bounds.width { break }
            used += extra
            first = candidate
        }
        hidden = first
        if active >= 0 && active < first { hidden -= 1 }
    }
    if hidden <= 0 { result.open = false }
    result.node = TreeSubmitCurrent(session, key, WidgetKindCustom, bounds)
    if result.node < 0 { return result }
    bounds = TreeSubmittedNodeAt(session, result.node).bounds
    if RectangleIntersection(bounds, view).width <= 0.0 ||
    RectangleIntersection(bounds, view).height <= 0.0 { return result }
    TreeSetChildClip(session, result.node, bounds)
    if !TreePushScope(session, result.node) { return result }
    marker_key := cast(u64)5
    previous_marker := TreePreviousCommitted(session, previous, marker_key, WidgetKindCustom)
    highlight: s32 = -1
    for i: 0..count - 1 {
        if !Visible(i, first, active) && !items[i].disabled &&
        TreePreviousCommitted(session, previous_marker, items[i].key, WidgetKindCustom) >= 0 {
            highlight = i
        }
    }
    x := props.bounds.x
    remaining := bounds.width
    if hidden > 0 {
        // Even a subpixel bar divides its positive area between overflow and tail.
        if overflow_width > remaining * 0.35 { overflow_width = remaining * 0.35 }
        overflow.bounds = Rectangle.{x, props.bounds.y, overflow_width, bounds.height}
        toggled := Button(session, overflow) != 0
        keyboard := !props.disabled && props.focused && props.focused_index == -1 &&
            (props.trigger_input.enter || props.trigger_input.space || props.trigger_input.down)
        if toggled { result.open = !result.open }
        if keyboard { result.open = true }
        x += overflow_width
        remaining -= overflow_width
    }
    items_node := TreeSubmitCurrent(session, cast(u64)2, WidgetKindCustom, props.bounds)
    TreePushScope(session, items_node)
    visible_count := count - first
    if active >= 0 && active < first { visible_count += 1 }
    visible_width: float32 = 0.0
    for i: 0..count - 1 {
        if Visible(i, first, active) { visible_width += Width(props, items[i], i) }
    }
    gap := separator
    if gap * cast(float32)(visible_count - 1) > remaining * 0.25 {
        gap = remaining * 0.25 / cast(float32)visible_count
    }
    ratio: float32 = 1.0
    available := remaining - gap * cast(float32)(visible_count - 1)
    if visible_width > available && visible_width > 0.0 { ratio = available / visible_width }
    for i: 0..count - 1 {
        if Visible(i, first, active) {
            action := Action(props, items[i], i)
            width := Width(props, items[i], i) * ratio
            action.bounds = Rectangle.{x, props.bounds.y, width, bounds.height}
            clicked := Button(session, action) != 0
            if props.focused && props.focused_index == i && !result.open &&
            (props.trigger_input.enter || props.trigger_input.space) { clicked = true }
            if clicked { Activate(props, items[i], i, *result) }
            x += width
            remaining -= width
            visible_count -= 1
            if visible_count > 0 && gap > 0.0 {
                sep := ButtonProps.{.bounds = Rectangle.{x, props.bounds.y, gap, bounds.height},
                    .label = "›", .disabled = true, .emphasis = ButtonEmphasis.ButtonEmphasisGhost}
                Button(session, sep)
                x += gap; remaining -= gap
            }
        }
    }
    End(session)
    End(session)
    if props.menu_input.escape { result.open = false }
    if result.open {
        opening := !was_open
        if props.menu_input.navigating || opening || highlight < 0 {
            direction: s32 = 1
            start := highlight
            if props.menu_input.home || highlight < 0 { start = -1 }
            if props.menu_input.up { direction = -1 }
            if props.menu_input.end { start = count; direction = -1 }
            if opening && highlight >= 0 { start = highlight - direction }
            candidate := start + direction
            while candidate >= 0 && candidate < count {
                if !Visible(candidate, first, active) && !items[candidate].disabled {
                    highlight = candidate; break
                }
                candidate += direction
            }
        }
        if !opening && props.menu_input.commit && highlight >= 0 {
            Activate(props, items[highlight], highlight, *result)
            result.open = false
        }
    }
    if result.open {
        dropdown := DropdownProps.{.id = props.id, .class_name = props.class_name}
        panel := DropdownFaceFor(dropdown, DropdownPanelRole(), 0, false)
        option_face := DropdownFaceFor(dropdown, DropdownOptionRole(), 0, false)
        scrollbar := DropdownFaceFor(dropdown, DropdownScrollbarRole(), 0, false)
        // Measure the longest hidden label; popup width is viewport constrained.
        anchor := bounds
        for i: 0..count - 1 {
            if !Visible(i, first, active) {
                width := Width(props, items[i], i)
                if width > anchor.width { anchor.width = width }
            }
        }
        menu := PopupBounds(anchor, view, hidden, 1.0, panel)
        row_height := cast(s32)bounds.height
        if row_height < 24 { row_height = 24 }
        metrics := DropdownMenuMetricsFor(1.0, panel, option_face, scrollbar)
        layout := MenuLayoutFor(menu, hidden, row_height, metrics.padding_top,
            metrics.padding_bottom, metrics.scrollbar_width, metrics.scrollbar_gap)
        offset := ScrollOffset(cast(float64)saved.offset, layout.max_scroll)
        ordinal: s32 = 0
        highlighted_row: s32 = -1
        for i: 0..count - 1 {
            if !Visible(i, first, active) {
                if i == highlight { highlighted_row = ordinal }
                ordinal += 1
            }
        }
        if props.menu_input.navigating || !was_open {
            offset = RevealRow(offset, highlighted_row, cast(float32)row_height,
                layout.content_bounds.height, layout.max_scroll)
        }
        popup := Popup(session, PopupProps.{overlay_key, menu, bounds})
        if popup.closed || menu.width <= 0.0 || menu.height <= 0.0 { result.open = false }
        else if TreePushScope(session, popup.panel_node) {
            PaintRoundedFill(session, popup.panel_node, menu, panel.value.radius, 12,
                ColorFromPacked(panel.value.background))
            scroll_key := key * cast(u64)65599 + cast(u64)11
            scrolled := Scroll(session, ScrollProps.{.key = scroll_key, .bounds = menu,
                .content_height = layout.content_height, .scroll_offset = offset})
            saved.offset = scrolled.scroll_offset
            if scrolled.opened {
                rows := Rows(hidden, scrolled.scroll_offset,
                    layout.content_bounds.height, cast(float32)row_height)
                previous_panel := TreePreviousCommitted(session, previous_overlay,
                    OverlayPanelKey(), WidgetKindCustom)
                previous_scroll := TreePreviousCommitted(session, previous_panel, scroll_key, WidgetKindScroll)
                ordinal = 0
                for i: 0..count - 1 {
                    if !Visible(i, first, active) {
                        old := TreePreviousCommitted(session, previous_scroll, items[i].key, WidgetKindSelectable)
                        if TreeTakeActivationAt(session, old) {
                            Activate(props, items[i], i, *result)
                            if !items[i].disabled { result.open = false }
                        }
                        if ordinal >= rows.first && ordinal < rows.end {
                            paint := OptionPaintFor(menu, layout.option_width, ordinal, row_height,
                                scrolled.scroll_offset, metrics.padding_top, metrics.padding_bottom,
                                metrics.highlight_inset_x, metrics.highlight_inset_y)
                            node := TreeSubmitCurrent(session, items[i].key, WidgetKindSelectable, paint.visible_bounds)
                            TreeSetInteractive(session, node, items[i].disabled, false, 0)
                            TreeSetSemantic(session, node, cast(SemanticKind)SemanticOption, 0)
                            TreeSetLabel(session, node, items[i].label)
                            TreeSetSelected(session, node, i == active)
                            hovered := TreeHoveredAt(session, old)
                            state := cast(s32)ButtonState.ButtonStateNormal
                            if hovered || i == highlight { state = cast(s32)ButtonState.ButtonStateHover }
                            if items[i].disabled { state = cast(s32)ButtonState.ButtonStateDisabled }
                            face := DropdownFaceFor(dropdown, DropdownOptionRole(), state, i == active)
                            DropdownPaintRow(session, node, dropdown,
                                DropdownOption.{.label = items[i].label, .disabled = items[i].disabled},
                                Rectangle.{menu.x, cast(float32)paint.option_y,
                                    cast(float32)layout.option_width, cast(float32)row_height},
                                paint.visible_bounds, i == active, hovered || i == highlight, metrics, face)
                        }
                        ordinal += 1
                    }
                }
                End(session)
            }
            End(session)
        }
    }
    if TreePushScope(session, result.node) {
        marker := TreeSubmitCurrent(session, marker_key, WidgetKindCustom, Rectangle.{})
        if highlight >= 0 && TreePushScope(session, marker) {
            TreeSubmitCurrent(session, items[highlight].key, WidgetKindCustom, Rectangle.{})
            End(session)
        }
        End(session)
    }
    saved.open = result.open
    TreeSetWidgetState(session, result.node, saved)
    result.opened = result.open && !was_open
    result.closed = !result.open && was_open
    return result
}
