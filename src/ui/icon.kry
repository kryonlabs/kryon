#module "icon_host"
#import "ui_icons.h"
#import "ui/icon_assets.h"
#import "ui_internal.h"
#import "runtime/surface.h"
#import "math.h"

g_ui_gear_icon :: Texture2D #global #export
g_ui_x_icon :: Texture2D #global #export

SetInterfaceIcons :: (gear_icon: Texture2D,
x_icon: Texture2D) #export {
    g_ui_gear_icon = gear_icon
    g_ui_x_icon = x_icon
}

IconShape :: (type: IconType) -> i32 {
    if type == ICON_PLUS { return 1 }
    if type == ICON_PLAY { return 2 }
    if type == ICON_TRASH { return 3 }
    if type == ICON_SAVE { return 4 }
    return 0
}

DrawIcon :: (type: IconType, bounds: Rectangle,
tint: Color) #export {
    shape: i32 = IconShape(type)
    if shape == 0 {
        ui_draw_icon_asset_backend(type, bounds, tint)
        return
    }
    y: i32 = (int)floorf(bounds.y)
    while y < (int)ceilf(bounds.y + bounds.height) {
        x: i32 = (int)floorf(bounds.x)
        while x < (int)ceilf(bounds.x + bounds.width) {
            coverage: float = IconCoverage(shape,
            x - bounds.x, y - bounds.y,
            bounds.width, bounds.height)
            if coverage > 0 {
                DrawRectangle(x, y, 1, 1,
                GetColor(Opacity(ColorToInt(tint), coverage)))
            }
            x += 1
        }
        y += 1
    }
}

DrawProfileImageIcon :: (type: IconType,
bounds: Rectangle, dark_mode: i32) #export {
    asset: const IconAsset* = GetIconAsset(type)
    if asset == nil || bounds.width <= 0 ||
    bounds.height <= 0 { return }
    DrawIcon(type, bounds, WHITE)
}
