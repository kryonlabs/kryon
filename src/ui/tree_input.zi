#import "geometry"
#import "session"
#import "tree"
#import "widget_kind"

using WidgetKind;

// Raw device observations are supplied by the platform. Kryon owns hit order,
// capture, eligibility, and activation across retained frames.
// The secondary (right) button, which opens context menus. It travels beside
// PointerFrame so existing hosts and code keep their layout.
SecondaryPointerFrame :: struct {
    down: bool
    pressed: bool
    released: bool
}

PointerFrame :: struct {
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
}

PointerState :: struct {
    hovered_generation: u64
    held_generation: u64
    activation_generation: u64
    pressed_generation: u64
    released_generation: u64
    held_x: float32
    held_y: float32
    grab_x: float32
    grab_y: float32
    released_x: float32
    released_y: float32
    captures_drag: bool
}

PointerDrag :: struct {
    active: bool
    started: bool
    ended: bool
    x: float32
    y: float32
    grab_x: float32
    grab_y: float32
}

active_pointer: [9]PointerState;
active_sample: [9]PointerFrame;
active_secondary: [9]SecondaryPointerFrame;
active_key: [9]s32;
active_modifiers: [9]s32;

// Keyboard modifier bits reported by KeyboardModifiers.
KeyModifierShift :: 1;
KeyModifierControl :: 2;
KeyModifierAlt :: 4;

// The key codes every host reports through KeyboardTake. Letters are their
// uppercase ASCII codes, and digits and punctuation their ASCII codes.
KeyEscape :: 256;
KeyEnter :: 257;
KeyTab :: 258;
KeyBackspace :: 259;
KeyInsert :: 260;
KeyDelete :: 261;
KeyRight :: 262;
KeyLeft :: 263;
KeyDown :: 264;
KeyUp :: 265;
KeyPageUp :: 266;
KeyPageDown :: 267;
KeyHome :: 268;
KeyEnd :: 269;

TypedInputQueue :: struct {
    values: [32]s32
    head: s32
    count: s32
}

active_codepoints: [9]TypedInputQueue;

PointerWheelState :: struct {
    x: float32
    y: float32
    delta: float32
}

active_wheel: [9]PointerWheelState;

// A composed view can paint while lending no device input to its children.
// Keep the containing frame's pending events and retained capture intact.
InputSnapshot :: struct {
    session: Session
    pointer: PointerState
    sample: PointerFrame
    secondary: SecondaryPointerFrame
    key: s32
    modifiers: s32
    codepoints: TypedInputQueue
    wheel: PointerWheelState
}

#program_export
TreeInputSuspend :: (session: Session) -> InputSnapshot {
    snapshot: InputSnapshot
    if !SessionValid(session) { return snapshot }
    slot := SessionIndex(session)
    snapshot.session = session
    snapshot.pointer = active_pointer[slot]
    snapshot.sample = active_sample[slot]
    snapshot.secondary = active_secondary[slot]
    snapshot.key = active_key[slot]
    snapshot.modifiers = active_modifiers[slot]
    snapshot.codepoints = active_codepoints[slot]
    snapshot.wheel = active_wheel[slot]
    active_pointer[slot] = PointerState.{}
    active_sample[slot] = PointerFrame.{-1.0, -1.0, false, false, false}
    active_secondary[slot] = SecondaryPointerFrame.{}
    active_key[slot] = 0
    active_modifiers[slot] = 0
    active_codepoints[slot] = TypedInputQueue.{}
    active_wheel[slot] = PointerWheelState.{}
    return snapshot
}

#program_export
TreeInputResume :: (session: Session, snapshot: InputSnapshot) -> bool {
    if !SessionValid(session) || session.slot != snapshot.session.slot ||
        session.epoch != snapshot.session.epoch { return false }
    slot := SessionIndex(session)
    active_pointer[slot] = snapshot.pointer
    active_sample[slot] = snapshot.sample
    active_secondary[slot] = snapshot.secondary
    active_key[slot] = snapshot.key
    active_modifiers[slot] = snapshot.modifiers
    active_codepoints[slot] = snapshot.codepoints
    active_wheel[slot] = snapshot.wheel
    return true
}

// Hosts submit one keyboard event before the next frame. The application
// consumes it while composing widget props for that frame.
#program_export
KeyboardSend :: (session: Session, key: s32) -> bool {
    if !SessionValid(session) { return false }
    active_key[SessionIndex(session)] = key
    return true
}

#program_export
KeyboardTake :: (session: Session) -> s32 {
    if !SessionValid(session) { return 0 }
    index: s32 = SessionIndex(session)
    key: s32 = active_key[index]
    active_key[index] = 0
    return key
}

// Hosts submit the modifier keys held for the next frame as KeyModifier
// bits. The state stays until the host sends a new one.
#program_export
KeyboardModifiersSend :: (session: Session, modifiers: s32) -> bool {
    if !SessionValid(session) { return false }
    active_modifiers[SessionIndex(session)] = modifiers
    return true
}

#program_export
KeyboardModifiers :: (session: Session) -> s32 {
    if !SessionValid(session) { return 0 }
    return active_modifiers[SessionIndex(session)]
}

// Hosts submit a typed Unicode codepoint independently of physical keys.
// The application consumes it once while composing the next frame.
#program_export
TypedCodepointSend :: (session: Session, codepoint: s32) -> bool {
    if !SessionValid(session) || codepoint <= 0 || codepoint > 1114111 ||
       (codepoint >= 55296 && codepoint <= 57343) { return false }
    index: s32 = SessionIndex(session)
    if active_codepoints[index].count >= 32 { return false }
    tail: s32 = (active_codepoints[index].head +
        active_codepoints[index].count) % 32
    active_codepoints[index].values[tail] = codepoint
    active_codepoints[index].count += 1
    return true
}

#program_export
TypedCodepointTake :: (session: Session) -> s32 {
    if !SessionValid(session) { return 0 }
    index: s32 = SessionIndex(session)
    if active_codepoints[index].count == 0 { return 0 }
    head: s32 = active_codepoints[index].head
    codepoint: s32 = active_codepoints[index].values[head]
    active_codepoints[index].head = (head + 1) % 32
    active_codepoints[index].count -= 1
    return codepoint
}

#program_export
TreeSecondaryPointerUpdate :: (session: Session, frame: SecondaryPointerFrame) {
    if !SessionValid(session) { return }
    active_secondary[SessionIndex(session)] = frame
}

// This frame's state of the secondary button.
#program_export
SecondaryPointerSample :: (session: Session) -> SecondaryPointerFrame {
    empty: SecondaryPointerFrame
    if !SessionValid(session) { return empty }
    return active_secondary[SessionIndex(session)]
}

#program_export
PointerSample :: (session: Session) -> PointerFrame {
    empty: PointerFrame
    if !SessionValid(session) { return empty }
    return active_sample[SessionIndex(session)]
}

#program_export
PointInBounds :: (x: float32, y: float32, bounds: Rectangle) -> bool {
    return bounds.width > 0.0 && bounds.height > 0.0 &&
        x >= bounds.x && y >= bounds.y &&
        x < bounds.x + bounds.width && y < bounds.y + bounds.height
}

// Hosts submit one wheel sample per frame. A viewport under the pointer
// consumes it once, so sibling lists cannot both move from one gesture.
#program_export
PointerWheelSend :: (session: Session, x: float32, y: float32,
    delta: float32) {
    if !SessionValid(session) { return }
    index: s32 = SessionIndex(session)
    active_wheel[index].x = x
    active_wheel[index].y = y
    active_wheel[index].delta = delta
}

#program_export
PointerWheelTake :: (session: Session, bounds: Rectangle) -> float32 {
    if !SessionValid(session) { return 0.0 }
    index: s32 = SessionIndex(session)
    if !PointInBounds(active_wheel[index].x,
        active_wheel[index].y, bounds) { return 0.0 }
    delta: float32 = active_wheel[index].delta
    active_wheel[index].delta = 0.0
    return delta
}

#program_export
PointInCircleBounds :: (x: float32, y: float32,
    bounds: Rectangle) -> bool {
    if !PointInBounds(x, y, bounds) { return false }
    radius: float32 = bounds.width * 0.5
    center_x: float32 = bounds.x + radius
    center_y: float32 = bounds.y + bounds.height * 0.5
    distance_x: float32 = x - center_x
    distance_y: float32 = y - center_y
    return distance_x * distance_x + distance_y * distance_y <= radius * radius
}

// Only the uppermost modal lends input to its descendants. A retained drag
// from the page loses ownership when a modal is opened over it.
#program_export
TreeTopModalLayer :: (session: Session) -> s32 {
    return TreeModalLayer(session)
}

#program_export
TreeInputAllowedAt :: (session: Session, index: s32) -> bool {
    top := TreeTopModalLayer(session)
    return top == 0 || TreeOverlayLayerAt(session, index, true) == top
}

#program_export
TreeScrollAllowed :: (session: Session, key: u64) -> bool {
    index: s32 = TreeCount(session) - 1
    while index > 0 {
        entry := TreeInputAt(session, index)
        if entry.kind == WidgetKindScroll && entry.key == key {
            return TreeInputAllowedAt(session, index)
        }
        index -= 1
    }
    // A new scroll can receive input only when there is no retained modal.
    return TreeInputAllowedAt(session, 0)
}

#program_export
TreeHitAt :: (session: Session, x: float32, y: float32) -> s32 {
    if TreeCount(session) == 0 ||
        !PointInBounds(x, y, TreeInputAt(session, 0).bounds) { return -1 }
    index: s32 = TreeCount(session) - 1
    hit: s32 = -1
    layer: s32 = -1
    top := TreeTopModalLayer(session)
    while index > 0 {
        entry: NodeInput = TreeInputAt(session, index)
        if entry.interactive &&
        (top == 0 || TreeOverlayLayerAt(session, index, true) == top) &&
        (TreeButtonLike(entry.kind) ||
            entry.kind == WidgetKindCheckbox ||
            entry.kind == WidgetKindToggle ||
            entry.kind == WidgetKindRadio ||
            entry.kind == WidgetKindSlider ||
            entry.kind == WidgetKindSelectable ||
            entry.kind == WidgetKindLink ||
            entry.kind == WidgetKindCollapsible ||
            entry.kind == WidgetKindDropdown ||
            entry.kind == WidgetKindTextField ||
            entry.kind == WidgetKindTextArea) &&
        PointInBounds(x, y, entry.bounds) &&
        (!entry.circle_hit || PointInCircleBounds(x, y, entry.bounds)) &&
        (!entry.clipped || PointInBounds(x, y, entry.clip)) {
            candidate_layer := TreeOverlayLayerAt(session, index, true)
            if candidate_layer > layer {
                layer = candidate_layer
                hit = -1
                if TreePointerActivatable(entry.kind, entry.focus_id,
                    entry.disabled, entry.loading) { hit = index }
            }
        }
        index -= 1
    }
    return hit
}

// The most recently submitted scroll viewport under the pointer wins. A
// child scroll clips to its parent, so an outer page cannot consume its wheel.
#program_export
TreeScrollAt :: (session: Session, x: float32, y: float32) -> u64 {
    top := TreeTopModalLayer(session)
    index: s32 = TreeCount(session) - 1
    while index > 0 {
        entry: NodeInput = TreeInputAt(session, index)
        if entry.kind == WidgetKindScroll &&
        (top == 0 || TreeOverlayLayerAt(session, index, true) == top) &&
        PointInBounds(x, y, entry.bounds) &&
        (!entry.clipped || PointInBounds(x, y, entry.clip)) {
            return entry.key
        }
        index -= 1
    }
    return cast(u64)0
}

#program_export
TreePointerUpdate :: (session: Session, frame: PointerFrame) -> s32 {
    if TreeIsBuilding(session) { return -1 }
    active_sample[SessionIndex(session)] = frame
    hit: s32 = TreeHitAt(session, frame.x, frame.y)
    active_pointer[SessionIndex(session)].hovered_generation = 0
    if hit >= 0 {
        active_pointer[SessionIndex(session)].hovered_generation =
            TreeInputAt(session, hit).identity_generation
    }
    if frame.pressed {
        active_pointer[SessionIndex(session)].captures_drag = false
        active_pointer[SessionIndex(session)].held_generation = 0
        active_pointer[SessionIndex(session)].pressed_generation = 0
        active_pointer[SessionIndex(session)].released_generation = 0
        // A press released within the same frame, a quick tap during a
        // slow frame, still presses the node so its release activates it.
        if (frame.down || frame.released) && hit >= 0 {
            active_pointer[SessionIndex(session)].held_generation =
                TreeInputAt(session, hit).identity_generation
            active_pointer[SessionIndex(session)].pressed_generation =
                active_pointer[SessionIndex(session)].held_generation
            active_pointer[SessionIndex(session)].grab_x = frame.x - TreeInputAt(session, hit).bounds.x
            active_pointer[SessionIndex(session)].grab_y = frame.y - TreeInputAt(session, hit).bounds.y
            active_pointer[SessionIndex(session)].captures_drag =
                TreeInputAt(session, hit).captures_drag
        }
    }
    if frame.down && active_pointer[SessionIndex(session)].held_generation != 0 {
        active_pointer[SessionIndex(session)].held_x = frame.x
        active_pointer[SessionIndex(session)].held_y = frame.y
    }
    if frame.released {
        if active_pointer[SessionIndex(session)].held_generation != 0 {
            active_pointer[SessionIndex(session)].released_generation =
                active_pointer[SessionIndex(session)].held_generation
            active_pointer[SessionIndex(session)].released_x = frame.x
            active_pointer[SessionIndex(session)].released_y = frame.y
            if hit >= 0 && active_pointer[SessionIndex(session)].held_generation ==
                TreeInputAt(session, hit).identity_generation {
                active_pointer[SessionIndex(session)].activation_generation =
                    active_pointer[SessionIndex(session)].held_generation
            }
        }
        active_pointer[SessionIndex(session)].held_generation = 0
    } else if !frame.down {
        active_pointer[SessionIndex(session)].held_generation = 0
        active_pointer[SessionIndex(session)].pressed_generation = 0
    }
    return hit
}

// A control that owns dragging keeps it when the pointer leaves its bounds.
// Scroll containers must not turn that same press into a content scroll.
#program_export
TreePointerCapturesDrag :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    return active_pointer[SessionIndex(session)].held_generation != 0 &&
        active_pointer[SessionIndex(session)].captures_drag
}

// A drag keeps its original node identity while held, including when the
// pointer leaves that node or the root. The release sample is consumed once.
#program_export
TreeTakeDragAt :: (session: Session, index: s32) -> PointerDrag {
    drag: PointerDrag
    if index < 0 || index >= TreeCount(session) { return drag }
    entry: NodeInput = TreeInputAt(session, index)
    generation: u64 = entry.identity_generation
    if !entry.interactive || !TreeInputAllowedAt(session, index) ||
        !TreePointerActivatable(entry.kind, entry.focus_id,
            entry.disabled, entry.loading) {
        if active_pointer[SessionIndex(session)].held_generation == generation {
            active_pointer[SessionIndex(session)].held_generation = 0
        }
        if active_pointer[SessionIndex(session)].pressed_generation == generation {
            active_pointer[SessionIndex(session)].pressed_generation = 0
        }
        if active_pointer[SessionIndex(session)].released_generation == generation {
            active_pointer[SessionIndex(session)].released_generation = 0
        }
        if active_pointer[SessionIndex(session)].activation_generation == generation {
            active_pointer[SessionIndex(session)].activation_generation = 0
        }
        return drag
    }
    drag.active = generation != 0 &&
        active_pointer[SessionIndex(session)].held_generation == generation
    drag.started = generation != 0 &&
        active_pointer[SessionIndex(session)].pressed_generation == generation
    drag.ended = generation != 0 &&
        active_pointer[SessionIndex(session)].released_generation == generation
    if drag.active || drag.ended {
        drag.grab_x = active_pointer[SessionIndex(session)].grab_x
        drag.grab_y = active_pointer[SessionIndex(session)].grab_y
    }
    if drag.active {
        drag.x = active_pointer[SessionIndex(session)].held_x
        drag.y = active_pointer[SessionIndex(session)].held_y
    }
    if drag.ended {
        drag.x = active_pointer[SessionIndex(session)].released_x
        drag.y = active_pointer[SessionIndex(session)].released_y
        active_pointer[SessionIndex(session)].released_generation = 0
        if active_pointer[SessionIndex(session)].activation_generation == generation {
            active_pointer[SessionIndex(session)].activation_generation = 0
        }
    }
    if drag.started { active_pointer[SessionIndex(session)].pressed_generation = 0 }
    return drag
}

// A gesture that another widget took over, such as a content drag that
// scrolls, must not press or activate the node it started on.
#program_export
TreePointerCancel :: (session: Session) {
    if !SessionValid(session) { return }
    active_pointer[SessionIndex(session)].held_generation = 0
    active_pointer[SessionIndex(session)].pressed_generation = 0
    active_pointer[SessionIndex(session)].released_generation = 0
    active_pointer[SessionIndex(session)].activation_generation = 0
}

#program_export
TreeHoveredAt :: (session: Session, index: s32) -> bool {
    if index < 0 || index >= TreeCount(session) { return false }
    return TreeInputAllowedAt(session, index) &&
    active_pointer[SessionIndex(session)].hovered_generation != 0 &&
    TreeInputAt(session, index).identity_generation ==
    active_pointer[SessionIndex(session)].hovered_generation
}

#program_export
TreePressedAt :: (session: Session, index: s32) -> bool {
    if !TreeHoveredAt(session, index) { return false }
    return active_pointer[SessionIndex(session)].held_generation ==
        TreeInputAt(session, index).identity_generation
}

#program_export
TreeTakeActivationAt :: (session: Session, index: s32) -> bool {
    if index < 0 || index >= TreeCount(session) { return false }
    entry: NodeInput = TreeInputAt(session, index)
    if !entry.interactive || !TreeInputAllowedAt(session, index) ||
        !TreePointerActivatable(entry.kind, entry.focus_id,
        entry.disabled, entry.loading) ||
        active_pointer[SessionIndex(session)].activation_generation == 0 ||
        active_pointer[SessionIndex(session)].activation_generation != entry.identity_generation {
        return false
    }
    active_pointer[SessionIndex(session)].activation_generation = 0
    return true
}

#program_export
TreeInputReset :: (session: Session) {
    if !SessionValid(session) { return }
    pointer: PointerState
    sample: PointerFrame
    secondary: SecondaryPointerFrame
    wheel: PointerWheelState
    active_pointer[session.slot] = pointer
    active_sample[session.slot] = sample
    active_secondary[session.slot] = secondary
    active_wheel[session.slot] = wheel
    active_key[session.slot] = 0
    active_modifiers[session.slot] = 0
    typed: TypedInputQueue
    active_codepoints[session.slot] = typed
}
