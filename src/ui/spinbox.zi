#import "drawing_props"
#import "geometry"

SpinboxLayout :: struct {
    left: Rectangle
    text: Rectangle
    right: Rectangle
    button_width: s32
}

SpinboxStepResult :: struct {
    value: s32
    changed: bool
}

#program_export
SpinboxEffectiveStep :: (step: s32) -> s32 {
    if step <= 0 {
        return 1
    }
    return step
}

#program_export
SpinboxClampValue :: (value: s32, min_value: s32, max_value: s32) -> s32 {
    if min_value > max_value { return value }
    if value < min_value {
        return min_value
    }
    if value > max_value {
        return max_value
    }
    return value
}

SpinboxScaledMetric :: (value: float32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: s32 = cast(s32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}

#program_export
SpinboxDefaultButtonWidth :: (scale: float32) -> s32 {
    return SpinboxScaledMetric(28.0, scale)
}

#program_export
SpinboxDecrementIdFor :: (control_id: s32) -> s32 {
    if control_id <= 0 {
        return 0
    }
    return control_id * 10 + 1
}

#program_export
SpinboxIncrementIdFor :: (control_id: s32) -> s32 {
    if control_id <= 0 {
        return 0
    }
    return control_id * 10 + 2
}

#program_export
SpinboxLayoutFor :: (bounds: Rectangle, requested_button_width: s32) -> SpinboxLayout {
    layout: SpinboxLayout
    layout.button_width = requested_button_width
    if layout.button_width < 0 {
        layout.button_width = 0
    }
    max_button: s32 = cast(s32)(bounds.width / 2.0)
    if layout.button_width > max_button {
        layout.button_width = max_button
    }
    layout.left = bounds
    layout.left.width = cast(float32)layout.button_width
    layout.right = bounds
    layout.right.x = bounds.x + bounds.width - cast(float32)layout.button_width
    layout.right.width = cast(float32)layout.button_width
    layout.text = bounds
    layout.text.x = bounds.x + cast(float32)layout.button_width
    layout.text.width = bounds.width - cast(float32)(layout.button_width * 2)
    if layout.text.width < 0.0 {
        layout.text.width = 0.0
    }
    return layout
}

#program_export
SpinboxStepValue :: (value: s32, min_value: s32, max_value: s32,
    step: s32, direction: s32, wrap: bool) -> SpinboxStepResult {
    result: SpinboxStepResult
    result.value = value
    if min_value > max_value { return result }
    step = SpinboxEffectiveStep(step)
    if direction < 0 {
        if value > min_value {
            next: s64 = cast(s64)value - cast(s64)step
            if next < cast(s64)min_value { next = cast(s64)min_value }
            result.value = cast(s32)next
        } else if wrap && value <= min_value {
            result.value = max_value
        }
    } else if direction > 0 {
        if value < max_value {
            next: s64 = cast(s64)value + cast(s64)step
            if next > cast(s64)max_value { next = cast(s64)max_value }
            result.value = cast(s32)next
        } else if wrap && value >= max_value {
            result.value = min_value
        }
    }
    result.value = SpinboxClampValue(result.value, min_value, max_value)
    result.changed = result.value != value
    return result
}

#program_export
SpinboxStepButtonsValue :: (value: s32, min_value: s32, max_value: s32,
    step: s32, decrement: bool, increment: bool, wrap: bool) -> SpinboxStepResult {
    result: SpinboxStepResult
    result.value = value
    if decrement {
        result = SpinboxStepValue(result.value, min_value, max_value, step,
            -1, wrap)
    }
    if increment {
        next: SpinboxStepResult = SpinboxStepValue(result.value, min_value,
            max_value, step, 1, wrap)
        result.value = next.value
    }
    result.changed = result.value != value
    return result
}
