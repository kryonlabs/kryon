#import "control_props"
#import "geometry"
#import "image_props"
#import "modal"

// Caller supplied bounds support movable/resizable panels without making a
// platform host decide the layout. Zero bounds center the requested size.
ModalFrameProps :: struct {
    key: u64
    id: s32
    class_name: s32
    title: string
    bounds: Rectangle
    width: s32
    height: s32
    scale: float32
    left_image: ImageProps
    right_image: ImageProps
    left_label: string
    right_label: string
    has_left_action: bool
    has_right_action: bool
    dismiss_disabled: bool
}

ModalFrameResult :: struct {
    node: s32
    panel_node: s32
    layout: ModalFrameLayout
    dismissed: bool
    left_clicked: bool
    right_clicked: bool
}

// A message and action dialog. Actions are borrowed values supplied to
// ActionModal; the caller keeps any selection and dismissal state.
ActionModalProps :: struct {
    key: u64
    id: s32
    class_name: s32
    title: string
    message: string
    max_width: s32
    scale: float32
    show_close: bool
    close_label: string
}

ActionModalAction :: struct {
    key: u64
    label: string
    tone: ButtonTone
    emphasis: ButtonEmphasis
    disabled: bool
}

ActionModalResult :: struct {
    node: s32
    // Zero means no decision; -1 means dismissed; positive values are the
    // one-based action index.
    action: s32
}
