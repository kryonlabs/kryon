#module "menu_button"

# The menu button owns only portable state policy. Rendering, popup storage,
# and input adapters remain backend concerns.
ToggleOpen :: (open: bool, clicked: bool) -> bool #export {
    if clicked { return !open }
    return open
}

CloseAfterActivation :: (open: bool, activated_id: i32) -> bool #export {
    if activated_id != 0 { return false }
    return open
}
