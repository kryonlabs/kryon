}

Radio[role=Ring] {
  background: card;
  foreground: text;
  border: border;
  focus: accent;
  border-width: border;
  icon-size: 20;
  padding-x: 20;
  gap: gap;
  opacity: 1;
  material: default;
}

Radio[role=Mark] {
  background: accent;
