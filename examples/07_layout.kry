#import "kryon.h"

app "Kryon Layout Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    max_width: int = 560
}

LayoutInfo :: (label: const char *, value: int, x: int, y: int) {
    info: const char * = TextFormat("%s:%d",label,value)
    Text(info, x, y, UI_TEXT_16, GetThemeText())
}

WidthButton :: (label: const char *, x: int, y: int, value: int) -> int {
    style: int = UI_BUTTON_STYLE_SECONDARY
    if max_width == value {
        style = UI_BUTTON_STYLE_PRIMARY
    }
    return Button((ButtonProps){.bounds = {x,y,ScaleUIPx(110),ScaleUIPx(34)}, .label = label, .style = style, .font = UI_TEXT_16, .id = 1000 + x + y})
}

LayoutNote :: (label: const char *, x: int, y: int, color: Color) {
    Text(label, x, y, UI_TEXT_16, color)
}

screen LayoutExample(viewport: Rectangle) {
    Background(GetThemeBackground())
    side_padding: int = GetUIPageSidePadding()
    page_x: int = side_padding
    page_w: int = GetUIViewWidth() - side_padding * 2
    column_x: int = 0
    column_w: int = 0
    y: int = ScaleUIPx(42)
    guide_h: int = ScaleUIPx(450)
    column_y: int = y + ScaleUIPx(30)
    btn_y: int = y + ScaleUIPx(170)
    right_edge: int = GetUIViewWidth() - side_padding
    btn0_x: int = column_x + ScaleUIPx(16)
    btn1_x: int = column_x + ScaleUIPx(138)
    btn2_x: int = column_x + ScaleUIPx(260)
    GetUICenteredColumn(max_width,side_padding,&column_x,&column_w)
    btn0_x = column_x + ScaleUIPx(16)
    btn1_x = column_x + ScaleUIPx(138)
    btn2_x = column_x + ScaleUIPx(260)
    Text("Responsive layout", page_x, ScaleUIPx(16), UI_TEXT_24, GetThemeText())
    Rect(page_x, y, page_w, guide_h, GetThemeSurface(), GetThemeIcon())
    Line(side_padding, y, side_padding, y+guide_h, GetThemeLink())
    Line(right_edge, y, right_edge, y+guide_h, GetThemeLink())
    Rect(column_x, column_y, column_w, ScaleUIPx(360), GetThemeBackground(), GetThemeButton())
    LayoutInfo("View width", GetUIViewWidth(), column_x+16, y+ScaleUIPx(54))
    LayoutInfo("Side padding", side_padding, column_x+16, y+ScaleUIPx(84))
    LayoutInfo("Column max", max_width, column_x+16, y+ScaleUIPx(114))
    if WidthButton("Narrow", btn0_x, btn_y, 360) {
        max_width = 360
    }
    if WidthButton("Medium", btn1_x, btn_y, 560) {
        max_width = 560
    }
    if WidthButton("Wide", btn2_x, btn_y, 720) {
        max_width = 720
    }
    LayoutNote("Resize the preview/window or choose a width.", column_x+16, y+ScaleUIPx(240), GetThemeText())
    LayoutNote("The column stays centered and clamped.", column_x+16, y+ScaleUIPx(272), GetThemeIcon())
}
