#module "color_picker"
#import "control_props"
#import "drawing_props"
#import "style"

ColorPickerLayout :: struct {
    row_height: float
    swatch_bounds: Rectangle
}

ColorPickerSwatchPaint :: struct {
    bounds: Rectangle
    label_x: float
    label_y: float
}

ColorPickerSwatchPaintFor :: (bounds: Rectangle, label_inset: float,
    text_line_height: float) -> ColorPickerSwatchPaint #export {
    paint: ColorPickerSwatchPaint
    paint.bounds = bounds
    paint.label_x = bounds.x + label_inset
    paint.label_y = bounds.y + (bounds.height - text_line_height) / 2.0
    return paint
}

ColorPickerMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> float {
    if (fields & field) == (u32)0 || value < 0.0 {
        value = fallback
    }
    if !allow_zero && value <= 0.0 {
        value = fallback
    }
    return value * scale
}

ColorPickerChannelBounds :: (bounds: Rectangle, index: i32,
    channels: i32, scale: float, metrics: StyleFrame) -> Rectangle #export {
    row: Rectangle
    layout: ColorPickerLayout = ColorPickerLayoutFor(bounds, channels, scale, metrics)
    inset: float = ColorPickerMetric(metrics.value.fields, (u32)StylePaddingY,
        metrics.value.padding_y, 2.0, scale, true)
    row.x = bounds.x
    row.y = bounds.y + layout.row_height * (float)index
    row.width = bounds.width
    row.height = layout.row_height - inset
    if row.height < 0.0 { row.height = 0.0 }
    return row
}

ColorPickerLayoutFor :: (bounds: Rectangle, channels: i32,
    scale: float, metrics: StyleFrame) -> ColorPickerLayout #export {
    layout: ColorPickerLayout
    if scale <= 0.0 { scale = 1.0 }
    if channels < 1 { channels = 1 }
    swatch_height: float = ColorPickerMetric(metrics.value.fields,
        (u32)StyleIconSize, metrics.value.icon_size, 36.0, scale, false)
    gap: float = ColorPickerMetric(metrics.value.fields, (u32)StyleGap,
        metrics.value.gap, 4.0, scale, true)
    minimum_row: float = ColorPickerMetric(metrics.value.fields,
        (u32)StyleContentOffset, metrics.value.offset_y, 28.0, scale, false)
    compact_threshold: float = ColorPickerMetric(metrics.value.fields,
        (u32)StyleContentOffset, metrics.value.offset_x, 20.0, scale, false)
    row_height: float = (bounds.height - swatch_height - gap) / (float)channels
    if row_height < compact_threshold { row_height = minimum_row }
    layout.row_height = row_height
    layout.swatch_bounds.x = bounds.x
    layout.swatch_bounds.y = bounds.y + row_height * (float)channels + gap
    layout.swatch_bounds.width = bounds.width
    layout.swatch_bounds.height = swatch_height
    return layout
}

ColorPickerClampChannel :: (value: float) -> float #export {
    if value < 0.0 { return 0.0 }
    if value > 1.0 { return 1.0 }
    return value
}

ColorPickerChannelByte :: (value: float) -> u8 #export {
    return (u8)(ColorPickerClampChannel(value) * 255.0 + 0.5)
}

ColorPickerColorFor :: (red: float, green: float, blue: float,
    alpha: float, channels: i32) -> Color #export {
    color: Color
    color.r = ColorPickerChannelByte(red)
    color.g = ColorPickerChannelByte(green)
    color.b = ColorPickerChannelByte(blue)
    if channels >= 4 {
        color.a = ColorPickerChannelByte(alpha)
    } else {
        color.a = (u8)255
    }
    return color
}
