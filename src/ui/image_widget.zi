#module "image_widget"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "image"
#import "image_props"
#import "image_raster"
#import "paint_queue"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "widget_kind"

ImageFaces :: struct {
    surface: StyleData
    label: StyleData
}

DefaultImageFaces :: () -> ImageFaces #export {
    faces: ImageFaces
    faces.surface.fields = (u32)StyleForeground |
        (u32)StyleOpacity
    faces.surface.foreground = (u32)0xffffffff
    faces.surface.opacity = 1.0
    faces.label.fields = (u32)StyleForeground |
        (u32)StyleFontSize
    faces.label.foreground = (u32)0x171717ff
    faces.label.font_size = 14.0
    return faces
}

ImageFacesFor :: (rules: StyleRules, image: ImageProps,
    defaults: ImageFaces) -> ImageFaces #export {
    faces: ImageFaces = defaults
    facts: StyleFacts = StyleDefaultFacts(StyleKindImage())
    facts.class_name = image.class_name
    faces.surface = ResolveStyleRules(rules, defaults.surface, facts,
        (i32)ButtonStateNormal)
    facts.role = ImageLabelRole()
    faces.label = ResolveStyleRules(rules, defaults.label, facts,
        (i32)ButtonStateNormal)
    return faces
}

ImageTextureFor :: (image: ImageProps) -> Texture2D #export {
    texture: Texture2D = image.texture
    if texture.id != (u32)0 || image.asset_path == "" {
        return texture
    }
    texture.width = AssetWidth(image.asset_path)
    texture.height = AssetHeight(image.asset_path)
    if texture.width > 0 && texture.height > 0 {
        # This marker makes the pure fit policy treat a host-backed asset as
        # available. RasterImage receives the original id 0 and asset path.
        texture.id = (u32)1
    }
    return texture
}

ImageTint :: (surface: StyleData) -> Color #export {
    packed: u32 = surface.foreground
    if (surface.fields & (u32)StyleForeground) == (u32)0 {
        packed = (u32)0xffffffff
    }
    return ColorFromPacked(Opacity(packed,
        StyleOpacityValue(surface.fields, surface.opacity)))
}

PaintImagePlaceholder :: (node: i32, image: ImageProps,
    label_style: StyleData) #export {
    label: string = image.alt_text
    if label == "" { label = "Missing image" }
    font: i32 = ResolveFont(0,
        StyleFontValue(label_style.fields, label_style.font_size), 14)
    width: i32 = GlyphWidth(label, font, label_style.typeface)
    height: i32 = GlyphLineHeight(font, label_style.typeface)
    layout: ImagePlaceholderLayout = ImagePlaceholderLayoutFor(image.bounds,
        width, height)
    PaintLabel(node, label, layout.label_x, layout.label_y,
        font, ColorFromPacked(Opacity(label_style.foreground,
            StyleOpacityValue(label_style.fields,
                label_style.opacity))))
}

Image :: (image: ImageProps) #export {
    node: i32 = -1
    if TreeIsBuilding() {
        node = TreeSubmitCurrent(image.key, WidgetKindImage, image.bounds)
        if node < 0 { return }
        TreeSetLabel(node, image.alt_text)
    }
    faces: ImageFaces = ImageFacesFor(ActiveStyleRules(), image,
        DefaultImageFaces())
    radius: float = 0.0
    if (faces.surface.fields & (u32)StyleRadius) != (u32)0 {
        radius = faces.surface.radius
    }
    if (faces.surface.fields & (u32)StyleBackground) != (u32)0 {
        PaintRoundedFill(node, image.bounds, radius, 12,
            ColorFromPacked(faces.surface.background))
    }
    texture: Texture2D = ImageTextureFor(image)
    tint: Color = ImageTint(faces.surface)
    plan: ImageDrawPlan = ImageDrawPlanFor(image, texture, tint)
    if plan.draw && tint.a > (u8)0 {
        PaintImage(node, image.asset_path, image.texture.id,
            plan.source, plan.destination, image.bounds,
            image.origin, image.rotation, radius, plan.tint)
    } else if !plan.draw {
        PaintImagePlaceholder(node, image, faces.label)
    }
    if (faces.surface.fields & (u32)StyleBorderWidth) != (u32)0 &&
        faces.surface.border_width > 0.0 {
        PaintRoundedOutline(node, image.bounds, radius, 12,
            faces.surface.border_width,
            ColorFromPacked(faces.surface.border))
    }
}
