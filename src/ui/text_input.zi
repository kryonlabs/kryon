#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style_sheet"

CompositionPhase :: enum {
    CompositionNone :: 0
    CompositionStart :: 1
    CompositionUpdate :: 2
    CompositionCommit :: 3
    CompositionCancel :: 4
}
using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ButtonState;
using StyleField;
using CompositionPhase;


CompositionEvent :: struct {
    phase: CompositionPhase
    text: string
    cursor: s32
    selection_length: s32
}

CompositionState :: struct {
    active: bool
    // The caller owns these bytes until the next state update or cancel.
    text: string
    cursor: s32
    selection_length: s32
}

CompositionTransition :: struct {
    state: CompositionState
    commit: bool
    commit_text: string
    changed: bool
}

#program_export
CompositionBoundaryFor :: (value: string,
    offset: s32) -> s32 {
    offset = TextCursorForLength(offset, (cast(s32)value.count))
    while offset > 0 && offset < (cast(s32)value.count) &&
        TextUtf8Continuation(value[offset]) {
        offset -= 1
    }
    return offset
}

#program_export
CompositionTransitionFor :: (state: CompositionState,
    event: CompositionEvent, focused: bool,
    read_only: bool) -> CompositionTransition {
    transition: CompositionTransition
    if !focused || read_only {
        transition.changed = state.active
        return transition
    }
    transition.state = state
    if event.phase == cast(CompositionPhase)CompositionNone {
        return transition
    }
    if event.phase == cast(CompositionPhase)CompositionStart ||
        event.phase == cast(CompositionPhase)CompositionUpdate {
        transition.state.active = true
        transition.state.text = event.text
        raw_cursor: s32 = TextCursorForLength(
            event.cursor, (cast(s32)event.text.count))
        transition.state.cursor = CompositionBoundaryFor(
            event.text, raw_cursor)
        end: s32 = (cast(s32)event.text.count)
        if event.selection_length <= 0 {
            end = raw_cursor
        } else if event.selection_length <
            (cast(s32)event.text.count) - raw_cursor {
            end = raw_cursor + event.selection_length
        }
        end = CompositionBoundaryFor(event.text, end)
        transition.state.selection_length = end -
            transition.state.cursor
        transition.changed = true
        return transition
    }
    if event.phase == cast(CompositionPhase)CompositionCommit {
        transition.state = CompositionState.{}
        transition.commit = true
        transition.commit_text = event.text
        transition.changed = true
        return transition
    }
    if event.phase == cast(CompositionPhase)CompositionCancel {
        transition.state = CompositionState.{}
        transition.changed = state.active
    }
    return transition
}

TextFieldScroll :: struct {
    scroll: s32
    max_scroll: s32
    clip_width: s32
    text_origin_x: s32
}

TextFieldPaint :: struct {
    clip_bounds: Rectangle
    text_x: s32
    cursor_y: s32
    cursor_height: s32
}

TextAreaPaint :: struct {
    clip_bounds: Rectangle
    wrap_width: s32
    viewport_height: s32
    max_scroll: s32
    scroll_y: s32
    placeholder_x: s32
    placeholder_y: s32
}

TextBufferInsertDecision :: struct {
    can_insert: bool
    tail_count: s32
}

TextBufferDeleteDecision :: struct {
    can_delete: bool
    tail_count: s32
}

TextBufferDeleteRangeDecision :: struct {
    can_delete: bool
    start: s32
    end: s32
    cursor: s32
    tail_count: s32
}

TextBufferEditResult :: struct {
    length: s32
    cursor: s32
    changed: bool
}

TextContextCommandDecision :: struct {
    copy_selection: bool
    copy_all: bool
    delete_selection: bool
    clear_all: bool
    paste: bool
    select_all: bool
    collapse_selection: bool
}

TextInputDoubleClickDecision :: struct {
    double_click: bool
}
TextCompositionPaintSpan :: struct {
    visible: bool
    start: s32
    end: s32
}

TextSelectionPaintSpan :: struct {
    visible: bool
    start: s32
    end: s32
    continues_past_line: bool
}
#program_export
TextCompositionPaintSpanForLine :: (composition_start: s32,
    composition_end: s32, line_start: s32,
    line_end: s32) -> TextCompositionPaintSpan {
    span: TextCompositionPaintSpan
    if composition_end <= composition_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = composition_start
    if span.start < line_start { span.start = line_start }
    span.end = composition_end
    if span.end > line_end { span.end = line_end }
    if span.end <= span.start { return span }
    span.visible = true
    return span
}

#program_export
TextCompositionUnderlineEndX :: (start_x: s32, end_x: s32,
    stroke_width: s32) -> s32 {
    if stroke_width < 1 { stroke_width = 1 }
    if end_x <= start_x { return start_x + stroke_width }
    return end_x
}

#program_export
TextCompositionUnderlineY :: (text_y: s32, line_height: s32,
    stroke_width: s32) -> s32 {
    if stroke_width < 1 { stroke_width = 1 }
    return text_y + line_height - stroke_width
}

#program_export
TextSelectionPaintSpanForLine :: (selection_start: s32,
    selection_end: s32, line_start: s32,
    line_end: s32) -> TextSelectionPaintSpan {
    span: TextSelectionPaintSpan
    if selection_end <= selection_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = selection_start
    if span.start < line_start { span.start = line_start }
    span.end = selection_end
    if span.end > line_end { span.end = line_end }
    span.continues_past_line = selection_start <= line_start &&
        selection_end > line_end
    if span.end < span.start { return span }
    if span.end == span.start && !span.continues_past_line {
        return span
    }
    span.visible = true
    return span
}

TextSelectionRange :: struct {
    start: s32
    end: s32
    has_selection: bool
}

TextSelectionState :: struct {
    anchor: s32
    cursor: s32
    has_selection: bool
}

#program_export
TextContextCommandCut :: () -> s32 {
    return 1
}

#program_export
TextContextCommandCopy :: () -> s32 {
    return 2
}

#program_export
TextContextCommandPaste :: () -> s32 {
    return 3
}

#program_export
TextContextCommandSelectAll :: () -> s32 {
    return 4
}

#program_export
TextEditCommandDecisionFor :: (command: s32, has_selection: bool,
    copy_all_when_empty: bool, clear_all_when_empty: bool, has_text: bool,
    allow_copy: bool, allow_delete: bool,
    allow_paste: bool) -> TextContextCommandDecision {
    decision: TextContextCommandDecision
    if command == TextContextCommandCut() {
        if has_selection {
            decision.copy_selection = allow_copy
            decision.delete_selection = allow_copy && allow_delete
        } else if copy_all_when_empty && has_text {
            decision.copy_all = allow_copy
            decision.clear_all = allow_copy && allow_delete && clear_all_when_empty
        }
        decision.collapse_selection = decision.copy_selection || decision.copy_all ||
            decision.delete_selection || decision.clear_all
        return decision
    }
    if command == TextContextCommandCopy() {
        if has_selection {
            decision.copy_selection = allow_copy
        } else if allow_copy && copy_all_when_empty && has_text {
            decision.copy_all = true
        }
        return decision
    }
    if command == TextContextCommandPaste() {
        if allow_paste {
            decision.delete_selection = allow_delete && has_selection
            decision.paste = true
            decision.collapse_selection = true
        }
        return decision
    }
    if command == TextContextCommandSelectAll() {
        decision.select_all = true
        return decision
    }
    return decision
}

#program_export
TextNativeEditShouldRun :: (read_only: bool, handled: bool) -> bool {
    return !read_only && !handled
}

#program_export
TextAreaRevealCursorShouldRun :: (focused: bool, changed: bool,
    navigation_pressed: bool) -> bool {
    return focused && (changed || navigation_pressed)
}

#program_export
TextAreaRevealScroll :: (scroll: s32, cursor_y: s32, cursor_height: s32,
    viewport_height: s32) -> s32 {
    if cursor_y < scroll {
        return cursor_y
    }
    if cursor_y + cursor_height > scroll + viewport_height {
        return cursor_y + cursor_height - viewport_height
    }
    return scroll
}

#program_export
TextAreaScrollFor :: (scroll: s32, max_scroll: s32) -> s32 {
    if max_scroll < 0 {
        max_scroll = 0
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}
TextInputScaledMetric :: (value: float32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: s32 = cast(s32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}
#program_export
TextAreaMinWrapWidth :: (scale: float32) -> s32 {
    return TextInputScaledMetric(24.0, scale)
}

#program_export
TextAreaMaxScrollFor :: (content_height: s32, bounds_height: float32,
    padding_y: s32) -> s32 {
    viewport_height: s32 = cast(s32)bounds_height - padding_y * 2
    max_scroll: s32 = content_height - viewport_height
    if max_scroll < 0 {
        return 0
    }
    return max_scroll
}

#program_export
TextAreaWheelScrollFor :: (scroll: s32, wheel: float32,
    line_height: s32) -> s32 {
    return scroll - cast(s32)(wheel * cast(float32)line_height * 3.0)
}

#program_export
TextInputDoubleClickSlopFor :: (scale: float32) -> s32 {
    return TextInputScaledMetric(6.0, scale)
}

#program_export
TextInputDoubleClickMaxSeconds :: () -> float32 {
    return 0.45
}

#program_export
TextInputDoubleClickDecisionFor :: (same_owner: bool, same_id: bool,
    elapsed_seconds: float32, dx: s32, dy: s32,
    slop: s32) -> TextInputDoubleClickDecision {
    decision: TextInputDoubleClickDecision
    if slop < 0 { slop = 0 }
    if dx < 0 { dx = -dx }
    if dy < 0 { dy = -dy }
    decision.double_click = same_owner && same_id &&
        elapsed_seconds <= TextInputDoubleClickMaxSeconds() &&
        dx <= slop && dy <= slop
    return decision
}

#program_export
TextFieldMinCursorHeight :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextFieldCursorVerticalPadding :: (scale: float32) -> s32 {
    return TextInputScaledMetric(8.0, scale)
}

#program_export
TextFieldClipGuard :: (scale: float32) -> s32 {
    clip_guard: s32 = TextInputScaledMetric(1.0, scale)
    if clip_guard < 1 { return 1 }
    return clip_guard
}

#program_export
TextInputStrokeWidth :: (scale: float32) -> s32 {
    width: s32 = TextInputScaledMetric(2.0, scale)
    if width < 1 { return 1 }
    return width
}

#program_export
TextInputContentWidth :: (bounds_width: float32, padding_x: s32) -> s32 {
    width: s32 = cast(s32)bounds_width - padding_x * 2
    if width < 0 {
        return 0
    }
    return width
}

#program_export
TextAreaPageRows :: (bounds_height: float32, font: s32, line_gap: s32,
    padding_y: s32) -> s32 {
    line_height: s32 = font + line_gap
    visible_height: s32 = cast(s32)bounds_height - padding_y * 2
    if line_height <= 0 || visible_height < line_height {
        return 1
    }
    rows: s32 = visible_height / line_height
    if rows < 1 {
        return 1
    }
    if rows < 2 {
        return 2
    }
    return rows
}

#program_export
TextAreaWrapWidthFor :: (bounds_width: float32, padding_x: s32,
    wrap: bool, min_wrap_width: s32) -> s32 {
    if !wrap { return 0 }
    width: s32 = cast(s32)bounds_width - padding_x * 2
    if width < min_wrap_width { return 0 }
    return width
}

#program_export
TextAreaPaintFor :: (bounds: Rectangle, font: s32, line_gap: s32,
    padding_x: s32, padding_y: s32, wrap: bool, content_height: s32,
    scroll_y: s32, text_line_height: s32, min_wrap_width: s32) -> TextAreaPaint {
    paint: TextAreaPaint
    line_height: s32 = font + line_gap
    paint.viewport_height = cast(s32)bounds.height - padding_y * 2
    if paint.viewport_height < 0 { paint.viewport_height = 0 }
    paint.max_scroll = TextAreaMaxScrollFor(content_height, bounds.height,
                                            padding_y)
    paint.scroll_y = TextAreaScrollFor(scroll_y, paint.max_scroll)
    paint.wrap_width = TextAreaWrapWidthFor(bounds.width, padding_x, wrap,
                                            min_wrap_width)
    paint.clip_bounds.x = bounds.x + cast(float32)padding_x
    paint.clip_bounds.y = bounds.y + cast(float32)padding_y
    paint.clip_bounds.width = bounds.width - cast(float32)(padding_x * 2)
    paint.clip_bounds.height = bounds.height - cast(float32)(padding_y * 2)
    if paint.clip_bounds.width < 0.0 { paint.clip_bounds.width = 0.0 }
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.placeholder_x = cast(s32)bounds.x + padding_x
    paint.placeholder_y = cast(s32)bounds.y + padding_y +
        (line_height - text_line_height) / 2
    return paint
}

#program_export
TextFieldScrollFor :: (bounds_x: float32, bounds_width: float32, padding_x: s32,
    text_width: s32, scroll: s32) -> TextFieldScroll {
    result: TextFieldScroll
    result.clip_width = TextInputContentWidth(bounds_width, padding_x)
    result.max_scroll = text_width - result.clip_width
    if result.max_scroll < 0 {
        result.max_scroll = 0
    }
    if scroll < 0 {
        result.scroll = 0
    } else if scroll > result.max_scroll {
        result.scroll = result.max_scroll
    } else {
        result.scroll = scroll
    }
    result.text_origin_x = cast(s32)bounds_x + padding_x - result.scroll
    return result
}

#program_export
TextFieldRevealScroll :: (scroll: s32, max_scroll: s32, clip_width: s32,
    cursor_text_x: s32, margin: s32) -> s32 {
    if margin < 0 {
        margin = 0
    }
    if cursor_text_x < scroll + margin {
        scroll = cursor_text_x - margin
    }
    if cursor_text_x > scroll + clip_width - margin {
        scroll = cursor_text_x - clip_width + margin
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

#program_export
TextFieldCursorHeightFor :: (font: s32, bounds_height: float32,
    text_line_height: s32, min_height: s32, vertical_padding: s32) -> s32 {
    height: s32 = text_line_height
    max_height: s32 = cast(s32)bounds_height - vertical_padding
    if height < font { height = font }
    if max_height < min_height { max_height = cast(s32)bounds_height }
    if height > max_height { height = max_height }
    if height < min_height { height = min_height }
    return height
}

#program_export
TextFieldPaintFor :: (bounds: Rectangle, padding_x: s32, scroll_x: s32,
    font: s32, text_line_height: s32, min_cursor_height: s32,
    cursor_vertical_padding: s32, clip_guard: s32) -> TextFieldPaint {
    paint: TextFieldPaint
    clip_width: s32 = TextInputContentWidth(bounds.width, padding_x)

    paint.clip_bounds.x = bounds.x + cast(float32)padding_x
    paint.clip_bounds.y = bounds.y - cast(float32)clip_guard
    paint.clip_bounds.width = cast(float32)clip_width
    paint.clip_bounds.height = bounds.height + cast(float32)(clip_guard * 2)
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.text_x = cast(s32)bounds.x + padding_x - scroll_x
    paint.cursor_height = TextFieldCursorHeightFor(
        font, bounds.height, text_line_height, min_cursor_height,
        cursor_vertical_padding)
    paint.cursor_y = cast(s32)bounds.y +
        (cast(s32)bounds.height - paint.cursor_height) / 2
    return paint
}

#program_export
TextSelectionRangeFor :: (anchor: s32, cursor: s32) -> TextSelectionRange {
    out: TextSelectionRange
    if anchor < cursor {
        out.start = anchor
        out.end = cursor
    } else {
        out.start = cursor
        out.end = anchor
    }
    out.has_selection = out.start != out.end
    return out
}

#program_export
TextSelectionRangeForLength :: (anchor: s32, cursor: s32,
    length: s32) -> TextSelectionRange {
    out: TextSelectionRange = TextSelectionRangeFor(anchor, cursor)
    if length < 0 { length = 0 }
    if out.start < 0 { out.start = 0 }
    if out.end < 0 { out.end = 0 }
    if out.start > length { out.start = length }
    if out.end > length { out.end = length }
    out.has_selection = out.start != out.end
    return out
}

#program_export
TextCursorForLength :: (cursor: s32, length: s32) -> s32 {
    if length < 0 { length = 0 }
    if cursor < 0 { return 0 }
    if cursor > length { return length }
    return cursor
}

#program_export
TextSelectionAfterMove :: (anchor: s32, cursor: s32, target: s32,
    extend: bool) -> TextSelectionState {
    out: TextSelectionState
    if extend {
        if anchor == cursor {
            out.anchor = cursor
        } else {
            out.anchor = anchor
        }
        out.cursor = target
    } else {
        out.anchor = target
        out.cursor = target
    }
    out.has_selection = out.anchor != out.cursor
    return out
}

#program_export
TextBufferInsertDecisionFor :: (text_size: s32, used: s32, at: s32,
    insert_len: s32) -> TextBufferInsertDecision {
    decision: TextBufferInsertDecision
    if text_size <= 0 || used < 0 || at < 0 || at > used || insert_len <= 0 {
        return decision
    }
    if used + insert_len >= text_size {
        return decision
    }
    decision.can_insert = true
    decision.tail_count = used - at + 1
    return decision
}

#program_export
TextBufferDeleteDecisionFor :: (used: s32, at: s32,
    delete_len: s32) -> TextBufferDeleteDecision {
    decision: TextBufferDeleteDecision
    if used < 0 || at < 0 || delete_len <= 0 || at + delete_len > used {
        return decision
    }
    decision.can_delete = true
    decision.tail_count = used - at - delete_len + 1
    return decision
}

#program_export
TextBufferDeleteRangeDecisionFor :: (used: s32, start: s32,
    end: s32) -> TextBufferDeleteRangeDecision {
    decision: TextBufferDeleteRangeDecision
    if used < 0 {
        return decision
    }
    if start < 0 { start = 0 }
    if end < 0 { end = 0 }
    if start > used { start = used }
    if end > used { end = used }
    if end <= start {
        return decision
    }
    decision.can_delete = true
    decision.start = start
    decision.end = end
    decision.cursor = start
    decision.tail_count = used - end + 1
    return decision
}

// The buffer has a trailing zero byte and length excludes it. Insert bytes
// must come from storage separate from the destination buffer.
#program_export
TextBufferInsertBytes :: (buffer: []u8, length: s32, at: s32,
    bytes: []u8) -> TextBufferEditResult {
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(at, length)
    decision: TextBufferInsertDecision = TextBufferInsertDecisionFor(
        (cast(s32)buffer.count), length, at, (cast(s32)bytes.count))
    if !decision.can_insert || length >= (cast(s32)buffer.count) ||
        buffer[length] != cast(u8)0 { return result }
    index: s32 = 0
    while index < (cast(s32)bytes.count) {
        if bytes[index] == cast(u8)0 { return result }
        index += 1
    }
    index = length
    while index >= at {
        buffer[index + (cast(s32)bytes.count)] = buffer[index]
        index -= 1
    }
    index = 0
    while index < (cast(s32)bytes.count) {
        buffer[at + index] = bytes[index]
        index += 1
    }
    result.length = length + (cast(s32)bytes.count)
    result.cursor = at + (cast(s32)bytes.count)
    result.changed = true
    return result
}

#program_export
TextBufferDeleteBytes :: (buffer: []u8, length: s32,
    at: s32, count: s32) -> TextBufferEditResult {
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(at, length)
    decision: TextBufferDeleteDecision = TextBufferDeleteDecisionFor(
        length, at, count)
    if !decision.can_delete || length >= (cast(s32)buffer.count) ||
        buffer[length] != cast(u8)0 { return result }
    index: s32 = at
    while index <= length - count {
        buffer[index] = buffer[index + count]
        index += 1
    }
    result.length = length - count
    result.cursor = at
    result.changed = true
    return result
}

#program_export
TextBufferDeleteRange :: (buffer: []u8, length: s32,
    start: s32, end: s32) -> TextBufferEditResult {
    decision: TextBufferDeleteRangeDecision =
        TextBufferDeleteRangeDecisionFor(length, start, end)
    if decision.can_delete {
        return TextBufferDeleteBytes(buffer, length,
            decision.start, decision.end - decision.start)
    }
    result: TextBufferEditResult
    result.length = length
    result.cursor = TextCursorForLength(start, length)
    return result
}

#program_export
TextUtf8Continuation :: (value: u8) -> bool {
    return (value & cast(u8)0xc0) == cast(u8)0x80
}

#program_export
TextPreviousCodepoint :: (buffer: []u8, length: s32,
    cursor: s32) -> s32 {
    if length < 0 { return 0 }
    if length > (cast(s32)buffer.count) { length = (cast(s32)buffer.count) }
    cursor = TextCursorForLength(cursor, length)
    if cursor == 0 { return 0 }
    cursor -= 1
    while cursor > 0 && TextUtf8Continuation(buffer[cursor]) {
        cursor -= 1
    }
    return cursor
}

#program_export
TextNextCodepoint :: (buffer: []u8, length: s32,
    cursor: s32) -> s32 {
    if length < 0 { return 0 }
    if length > (cast(s32)buffer.count) { length = (cast(s32)buffer.count) }
    cursor = TextCursorForLength(cursor, length)
    if cursor >= length { return length }
    cursor += 1
    while cursor < length && TextUtf8Continuation(buffer[cursor]) {
        cursor += 1
    }
    return cursor
}

TextWordBlank :: (codepoint: s32) -> bool {
    return codepoint == 32 || codepoint == 9 || codepoint == 0x3000
}

TextWordSeparator :: (codepoint: s32) -> bool {
    return codepoint == 44 || codepoint == 0x3001 ||
        codepoint == 46 || codepoint == 0x3002 ||
        codepoint == 59 || codepoint == 0xff1b ||
        codepoint == 40 || codepoint == 0xff08 ||
        codepoint == 41 || codepoint == 0xff09 ||
        codepoint == 123 || codepoint == 0xff5b ||
        codepoint == 125 || codepoint == 0xff5d ||
        codepoint == 91 || codepoint == 0x300c ||
        codepoint == 93 || codepoint == 0x300d ||
        codepoint == 124 || codepoint == 0xff5c ||
        codepoint == 33 || codepoint == 0xff01 ||
        codepoint == 92 || codepoint == 0xffe5 ||
        codepoint == 47 || codepoint == 0x30fb || codepoint == 0xff0f ||
        codepoint == 10 || codepoint == 13
}
