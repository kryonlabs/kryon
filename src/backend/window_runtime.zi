// Presentation and window observations for applications with a custom host.
// Kryon owns backend selection; the application retains its frame policy.
#import "drawing_props"
ANDROID_WINDOW :: #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__)
#if #defined(PLATFORM_WEB) {
    Window :: #import "canvas_window";
    Draw :: #import "canvas_draw";
} else #if ANDROID_WINDOW {
    Surface :: #import "android_surface";
    Native :: #import "android_native";
    android_frame_locked: bool;
} else {
    Desktop :: #import "desktop_runtime";
    Raster :: #import "cairo_raster";
}

#program_export
WindowWidth :: () -> s32 {
    #if #defined(PLATFORM_WEB) {
        return Window.GetScreenWidth()
    } else #if ANDROID_WINDOW {
        width: s32
        unused Surface.SyncAndroidSurfaceSize(*width, null)
        return width
    } else {
        return cast(s32)Desktop.DesktopViewport().width
    }
}

#program_export
WindowHeight :: () -> s32 {
    #if #defined(PLATFORM_WEB) {
        return Window.GetScreenHeight()
    } else #if ANDROID_WINDOW {
        height: s32
        unused Surface.SyncAndroidSurfaceSize(null, *height)
        return height
    } else {
        return cast(s32)Desktop.DesktopViewport().height
    }
}

// Refresh Android's current native extent and the shared touch transform.
// Desktop resize is applied at BeginDesktopFrame, before its raster is used.
#program_export
SyncWindowSurface :: () {
    #if ANDROID_WINDOW && !#defined(PLATFORM_WEB) {
        unused Surface.SyncAndroidSurfaceSize(null, null)
    }
}

#program_export
BeginWindowFrame :: () {
    #if #defined(PLATFORM_WEB) {
        Window.BeginDrawing()
    } else #if ANDROID_WINDOW {
        if android_frame_locked { return }
        SyncWindowSurface()
        if !Native.AndroidNativeWindowReady() || Native.AndroidNativePaused() ||
        Native.AndroidNativeDestroyRequested() { return }
        android_frame_locked = Native.AndroidNativeLock()
    } else {
        Desktop.BeginDesktopFrame()
    }
}

#program_export
ClearWindowFrame :: (color: Color) {
    #if #defined(PLATFORM_WEB) {
        Draw.ClearBackground(color)
    } else #if ANDROID_WINDOW {
        if android_frame_locked {
            Native.AndroidNativeFill((cast(u32)color.a << 24) | (cast(u32)color.r << 16) |
                (cast(u32)color.g << 8) | cast(u32)color.b)
        }
    } else {
        Raster.ClearRasterFrame(color)
    }
}

#program_export
EndWindowFrame :: () {
    #if #defined(PLATFORM_WEB) {
        Window.EndDrawing()
    } else #if ANDROID_WINDOW {
        if !android_frame_locked { return }
        unused Native.AndroidNativePresentDamage(0, 0, Native.android_pixel_width, Native.android_pixel_height)
        unused Native.AndroidNativeUnlock()
        android_frame_locked = false
    } else {
        unused Desktop.EndDesktopFrame()
    }
}

#program_export
CloseNativeWindow :: () {
    #if #defined(PLATFORM_WEB) {
        Window.CloseWindow()
    } else #if ANDROID_WINDOW {
        if android_frame_locked {
            unused Native.AndroidNativeUnlock()
            android_frame_locked = false
        }
        Native.AndroidNativeFinish()
        Native.AndroidNativeClose()
    } else {
        Desktop.CloseDesktop()
    }
}

#program_export
WindowHidden :: () -> bool {
    #if #defined(PLATFORM_WEB) {
        return Window.IsWindowHidden()
    } else #if ANDROID_WINDOW {
        return !Native.AndroidNativeWindowReady()
    } else {
        return !Desktop.WindowVisibleHost()
    }
}

#program_export
WindowMinimized :: () -> bool {
    #if #defined(PLATFORM_WEB) {
        return Window.IsWindowMinimized()
    } else #if ANDROID_WINDOW {
        return Native.AndroidNativePaused()
    } else {
        return Desktop.WindowMinimizedHost()
    }
}

// Observe the current close request without polling or consuming input.
#program_export
WindowClosing :: () -> bool {
    #if #defined(PLATFORM_WEB) {
        return Window.WindowShouldClose()
    } else #if ANDROID_WINDOW {
        app := Native.AndroidNativeApp()
        return app == null || Native.AndroidNativeDestroyRequested() || app.destroy_requested != 0
    } else {
        return Desktop.WindowClosingHost()
    }
}
