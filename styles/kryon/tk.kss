}

TextField {
  background: card;
  foreground: text;
  border: border;
  focus: accent;
  radius: radius;
  border-width: border;
  padding-x: field-x;
  padding-y: space.1;
  font-size: font;
  material: default;
}

TextArea {
  background: card;
  foreground: text;
  border: border;
  focus: accent;
  radius: radius;
  border-width: border;
  padding-x: field-x;
  padding-y: gap;
  font-size: font;
  gap: space.1;
