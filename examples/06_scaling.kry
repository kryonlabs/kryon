#import "kryon.h"

app "Kryon Scaling Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    scale_index: int = 0
    scales: [4] float = {1.0f,1.5f,2.0f,2.5f}
    box_x: int = 100
    box_y: int = 100
}

screen ScalingExample(viewport: Rectangle) {
    SetUIScale(scales[scale_index])
    WidgetBackground(GetThemeBackground())
    box_size: int = ScaleUIPx(100)
    WidgetText(TextFormat("DPI Scale:%.1f",scales[scale_index]), 50, 20, 20, GetThemeText())
    WidgetRect(box_x, box_y, box_size, box_size, GetThemeButton(), GetThemeIcon())
    WidgetText("Scaled Box", box_x + 10, box_y + 10, UI_TEXT_16, GetThemeText())
    WidgetText(TextFormat("Base:100px Scaled:%dpx",box_size), 50, 60, UI_TEXT_16, GetThemeText())
    WidgetText("SPACE cycles DPI,arrows move box", 50, 90, UI_TEXT_16, GetThemeIcon())
    if (UIKeyDown(KEY_RIGHT)) {
        box_x += 3
    }
    if (UIKeyDown(KEY_LEFT)) {
        box_x -= 3
    }
    if (UIKeyDown(KEY_DOWN)) {
        box_y += 3
    }
    if (UIKeyDown(KEY_UP)) {
        box_y -= 3
    }
    if (UIKeyPressed(KEY_SPACE)) {
        scale_index = (scale_index + 1) % 4
    }
}
