host_api :: #system_library "host_api";

// Font rasterizers report physical glyph measurements. UI layout stays in Kryon.
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 #foreign host_api;
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 #foreign host_api;

#program_export
GlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    return MeasureGlyphWidth(value, font, typeface)
}

#program_export
GlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return MeasureGlyphLineHeight(font, typeface)
}
