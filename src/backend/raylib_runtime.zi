// Layout owns metric revisions while a frame pipeline is active. A render
// callback can discover a new glyph; publish that change at the next app
// boundary rather than writing layout state while it is being consumed.
RaylibGlyphMetricsChanged :: () {
    #if RAYLIB_FRAME_THREADS {
        if render_pipeline != null && !RenderOnAppThread() {
            raylib_metrics_pending = true
            return
        }
    }
    SetTextTypefaceSelector(RaylibTextTypeface)
    Metrics.GlyphMetricsChanged()
}

