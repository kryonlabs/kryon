#module "modal_tree"
#import "ui_internal.h"
#import "ui/tree_layout.h"
#import "ui/tree_paint.h"

ui_tree_paint_before_overlay :: () {
    if !ui_tree_building || !IsWindowReady() { return }
    ReconcileTree()
    LayoutTree()
    InvalidateTree(INVALIDATE_PAINT)
    DrawTree()
    index: i32 = 0
    while index < ui_tree_node_count {
        if ui_committed_nodes[index].owned_text != nil {
            size: size_t = TreeOwnedTextSize(
            &ui_committed_nodes[index])
            ui_tree_nodes[index].owned_text = (char*)malloc(size)
            if ui_tree_nodes[index].owned_text != nil {
                memcpy(ui_tree_nodes[index].owned_text,
                ui_committed_nodes[index].owned_text, size)
            }
        }
        ui_tree_nodes[index].flags |= TreeNodeFlagPaintedImmediate
        index += 1
    }
}

Modal :: (modal: ModalProps) -> i32 #export {
    ui_tree_paint_before_overlay()
    ui_tree_add(0, WidgetKindModal,
    (Rectangle){0, 0, 0, 0}, &modal)
    return RenderActionModal(modal)
}
