#import "kryon.h"

app "Kryon Scaling Example" {
    size 800 600
    fps 60
    font examples
}

state {
    scale_index: int = 0
    scales: [4] float = {1.0f,1.5f,2.0f,2.5f}
    box_x: int = 100
    box_y: int = 100
}

ScalingExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        SetUIScale(scales[scale_index])
        Background(GetThemeBackground())
        box_size: int = Scale(100)
        Text((TextProps){.bounds={50, 20, 0, 0}, .text=TextFormat("DPI Scale:%.1f",scales[scale_index]), .font=20, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(box_x, box_y, box_size, box_size, GetThemeButton(), GetThemeIcon())
        Text((TextProps){.bounds={box_x + 10, box_y + 10, 0, 0}, .text="Scaled Box", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={50, 60, 0, 0}, .text=TextFormat("Base:100px Scaled:%dpx",box_size), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={50, 90, 0, 0}, .text="SPACE cycles DPI,arrows move box", .font=Text16, .color=GetThemeIcon(), .wrap=TextWrapNone})
        if (IsKeyDown(KEY_RIGHT)) {
            box_x += 3
        }
        if (IsKeyDown(KEY_LEFT)) {
            box_x -= 3
        }
        if (IsKeyDown(KEY_DOWN)) {
            box_y += 3
        }
        if (IsKeyDown(KEY_UP)) {
            box_y -= 3
        }
        if (IsKeyPressed(KEY_SPACE)) {
            scale_index = (scale_index + 1) % 4
        }
    }
}
