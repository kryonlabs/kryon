#module "layout_props"
#import "kryon_compat.generated.h"
#import "kryon_key.h"

ColumnProps :: struct {
    bounds: Rectangle
    gap: i32
    padding: i32
    key: KeyID
}

FlexDirection :: enum {
    FlexRow = 0
    FlexColumn
}

JustifyContent :: enum {
    JustifyStart = 0
    JustifyCenter
    JustifyEnd
    JustifySpaceBetween
    JustifySpaceAround
    JustifySpaceEvenly
}

AlignItems :: enum {
    AlignStart = 0
    AlignCenter
    AlignEnd
    AlignStretch
}

FlexProps :: struct {
    bounds: Rectangle
    direction: FlexDirection
    justify_content: JustifyContent
    align_items: AlignItems
    gap: i32
    padding: i32
}

FlexCursor :: struct {
    content: Rectangle
    item: Rectangle
    direction: FlexDirection
    align_items: AlignItems
    position: float
    gap: float
    remaining: i32
}

# Implemented by the C-only layout host; declared here for the public ABI.
BeginFlexCursor :: (props: FlexProps, count: i32,
                    total_item_extent: float) -> FlexCursor #extern #export
FlexStep :: (cursor: FlexCursor, width: float, height: float) -> FlexCursor #extern #export
SetViewSize :: (width: i32, height: i32) #extern #export
GetViewWidth :: () -> i32 #extern #export
GetViewHeight :: () -> i32 #extern #export
GetCenteredColumn :: (max_w: i32, side_pad: i32, x: *i32, w: *i32) #extern #export
GetPageSidePadding :: () -> i32 #extern #export
