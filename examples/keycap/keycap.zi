Keycap :: #import "kryon/keycap";
Text :: #import "kryon/text";
#import "kryon/geometry"
#import "kryon/session"


#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .key = 1, .bounds = .{viewport.x + 20.0, viewport.y + 16.0, viewport.width - 40.0, 40.0}, .text = "Keycap", .size = 28})
    bounds := Rectangle.{viewport.x + 20.0, viewport.y + 76.0, viewport.width - 40.0, 180.0}
    Keycap.Draw(session, Keycap.Props.{.disabled = example_disabled, .key = 10, .bounds = .{bounds.x, bounds.y, 160.0, 44.0}, .keys = "Ctrl+K"})
    Keycap.Draw(session, Keycap.Props.{.disabled = example_disabled, .key = 11, .bounds = .{bounds.x, bounds.y + 64.0, 160.0, 44.0}, .keys = "Shift+Enter"})
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
