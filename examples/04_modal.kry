#import "kryon.h"

app "Kryon Modal Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    modal_open: int = 0
    background_clicks: int = 0
    last_label: [64] char = "none"
}

screen ModalExample(viewport: Rectangle) {
    Background(GetThemeBackground())
    Text("Modal capture example", 32, 32, Text24, GetThemeText())
    Text("Open the modal and background clicks are blocked.", 32, 72, Text16, GetThemeIcon())
    if Button((ButtonProps){.bounds = {32, 120, 220, 42}, .label = "Background Button", .style = ButtonStyleSecondary, .font = Text16, .id = 101}) {
        background_clicks++
    }
    Text(TextFormat("Background clicks:%d",background_clicks), 32, 176, Text16, GetThemeText())
    Text(TextFormat("Last modal result:%s",last_label), 32, 204, Text16, GetThemeText())
    if Button((ButtonProps){.bounds = {32, 240, 220, 42}, .label = "Open Modal", .style = ButtonStylePrimary, .font = Text16, .id = 102}) {
        modal_open = 1
    }
    if modal_open {
        actions: [3] UIModalAction = {{"Cancel",ButtonStyleSecondary,0},{"Confirm",ButtonStylePrimary,0},{"Delete",ButtonStyleDanger,0}}
        result: int = ActionModal((ModalProps){"Adaptive Action Modal","Kryon measures action labels and blocks background clicks.",actions,3,420})
        if result == 1 {
            modal_open = 0
            snprintf(last_label,sizeof(last_label),"cancel")
        }
        if result == 2 {
            modal_open = 0
            snprintf(last_label,sizeof(last_label),"confirm")
        }
        if result == 3 {
            modal_open = 0
            snprintf(last_label,sizeof(last_label),"delete")
        }
    }
}
