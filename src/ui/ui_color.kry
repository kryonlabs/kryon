#module "color_host"
#import "kryon_compat.generated.h"

ColorMin :: (a: float, b: float) -> float {
    if a < b { return a }
    return b
}

ColorMax :: (a: float, b: float) -> float {
    if a > b { return a }
    return b
}

ClampColorFloat :: (value: float, minimum: float,
maximum: float) -> float {
    if value < minimum { return minimum }
    if value > maximum { return maximum }
    return value
}

ColorByte :: (value: float) -> unsigned char {
    scaled: i32 = (int)(value * 255.0 + 0.5)
    if scaled < 0 { return 0 }
    if scaled > 255 { return 255 }
    return (unsigned char)scaled
}

ColorToHSL :: (color: Color, hue: *float,
saturation: *float, lightness: *float) {
    red: float = (float)color.r / 255.0
    green: float = (float)color.g / 255.0
    blue: float = (float)color.b / 255.0
    maximum: float = ColorMax(red, ColorMax(green, blue))
    minimum: float = ColorMin(red, ColorMin(green, blue))
    chroma: float = maximum - minimum

    *lightness = (maximum + minimum) * 0.5
    if chroma <= 0.0 {
        *hue = 0.0
        *saturation = 0.0
        return
    }

    absolute_lightness: float = 2.0 * *lightness - 1.0
    if absolute_lightness < 0.0 {
        absolute_lightness = -absolute_lightness
    }
    *saturation = chroma / (1.0 - absolute_lightness)
    if maximum == red {
        *hue = (green - blue) / chroma
        if green < blue { *hue += 6.0 }
    } else if maximum == green {
        *hue = (blue - red) / chroma + 2.0
    } else {
        *hue = (red - green) / chroma + 4.0
    }
    *hue /= 6.0
}

ColorHueToRGB :: (p: float, q: float, t: float) -> float {
    if t < 0.0 { t += 1.0 }
    if t > 1.0 { t -= 1.0 }
    if t < 1.0 / 6.0 { return p + (q - p) * 6.0 * t }
    if t < 1.0 / 2.0 { return q }
    if t < 2.0 / 3.0 {
        return p + (q - p) * (2.0 / 3.0 - t) * 6.0
    }
    return p
}

ColorFromHSL :: (hue: float, saturation: float,
lightness: float, alpha: unsigned char) -> Color {
    hue = ClampColorFloat(hue, 0.0, 1.0)
    saturation = ClampColorFloat(saturation, 0.0, 1.0)
    lightness = ClampColorFloat(lightness, 0.0, 1.0)
    if saturation <= 0.0 {
        gray: unsigned char = ColorByte(lightness)
        return (Color){gray, gray, gray, alpha}
    }

    q: float = lightness + saturation - lightness * saturation
    if lightness < 0.5 {
        q = lightness * (1.0 + saturation)
    }
    p: float = 2.0 * lightness - q
    red: float = ColorHueToRGB(p, q, hue + 1.0 / 3.0)
    green: float = ColorHueToRGB(p, q, hue)
    blue: float = ColorHueToRGB(p, q, hue - 1.0 / 3.0)
    return (Color){ColorByte(red), ColorByte(green),
        ColorByte(blue), alpha}
}

AdjustColorLightness :: (color: Color, amount: i32) -> Color {
    hue: float = 0.0
    saturation: float = 0.0
    lightness: float = 0.0
    ColorToHSL(color, &hue, &saturation, &lightness)
    lightness = ClampColorFloat(lightness + (float)amount / 255.0,
    0.0, 1.0)
    return ColorFromHSL(hue, saturation, lightness, color.a)
}

LightenColor :: (color: Color, amount: i32) -> Color #export {
    if amount < 0 { amount = 0 }
    return AdjustColorLightness(color, amount)
}

DarkenColor :: (color: Color, amount: i32) -> Color #export {
    if amount < 0 { amount = 0 }
    return AdjustColorLightness(color, -amount)
}
