#import "geometry"
#import "paint_queue"
#import "tree"

# Committing and painting are one frame boundary. Raster effects are emitted
# only after the submitted tree is accepted.
#program_export
BeginTree :: (screen_key: u64, bounds: Rectangle) {
    PaintClear()
    TreeStart(screen_key, bounds)
}

#program_export
CommitTree :: () -> bool {
    if PaintOverflow() {
        TreeCancel()
        PaintClear()
        return false
    }
    if !TreeFinish() {
        PaintClear()
        return false
    }
    return true
}

#program_export
EndTree :: () -> bool {
    if !CommitTree() { return false }
    PaintFlush()
    return true
}
