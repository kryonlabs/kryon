#module "dropdown_store_host"
#import "ui_internal.h"
#import "ui_popup_input_internal.h"
#import "runtime/dropdown.h"
#import "stdlib.h"
#import "string.h"
#import "stdint.h"

DropdownState :: struct {
    next: *DropdownState
    id: i32
    open: i32
    just_opened: i32
    scroll_offset: i32
    x: i32
    y: i32
    w: i32
    h: i32
    options: *DropdownOption
    option_count: i32
    selected_index: i32
    class_name: i32
    highlight_index: i32
    pending_changed: i32
    pending_index: i32
    gesture: PopupGesture
    scrollbar_pressed: i32
    clip_top: i32
    clip_bottom: i32
    input_snapshot: PopupInputToken
    frame_seen: unsigned long
    opened_frame: unsigned long
}

DropdownStore :: struct {
    states: *DropdownState
    clip_top: i32
    clip_bottom: i32
    previous_focused: i32
}

fallback_dropdown_store :: DropdownStore #global
active_dropdown_store :: *DropdownStore #global
fallback_dropdown_store_ready :: i32 #global

DropdownFallbackStore :: () -> *DropdownStore {
    if fallback_dropdown_store_ready == 0 {
        fallback_dropdown_store.previous_focused = 1
        fallback_dropdown_store_ready = 1
    }
    return &fallback_dropdown_store
}

dropdown_store_current :: () -> *DropdownStore #export {
    if active_dropdown_store == nil {
        active_dropdown_store = DropdownFallbackStore()
    }
    return (DropdownStore*)active_dropdown_store
}

DropdownOptionsAlloc :: (count: i32) -> *DropdownOption {
    if count <= 0 { return nil }
    if (size_t)count > SIZE_MAX / sizeof(DropdownOption) { abort() }
    options: *DropdownOption = (DropdownOption*)calloc(
    (size_t)count, sizeof(DropdownOption))
    if options == nil { abort() }
    return options
}

DropdownCopyText :: (target: **const char,
text: const char*) #export {
    if text == nil { text = "" }
    if *target != nil && strcmp(*target, text) == 0 { return }
    copy: *char = (char*)malloc(strlen(text) + 1)
    if copy == nil { abort() }
    strcpy(copy, text)
    free((void*)*target)
    *target = copy
}

DropdownResizeOptions :: (state: *DropdownState,
count: i32) #export {
    if state->option_count == count { return }
    options: *DropdownOption = DropdownOptionsAlloc(count)
    keep: i32 = count
    if state->option_count < keep { keep = state->option_count }
    if keep > 0 {
        memcpy(options, state->options,
        (size_t)keep * sizeof(DropdownOption))
    }
    index: i32 = keep
    while index < state->option_count {
        free((void*)state->options[index].label)
        index += 1
    }
    free(state->options)
    state->options = options
    state->option_count = count
}

DropdownFreeStates :: (state: *DropdownState) {
    while state != nil {
        next: *DropdownState = state->next
        DropdownResizeOptions(state, 0)
        free(state)
        state = next
    }
}

dropdown_store_new :: () -> *DropdownStore #export {
    store: *DropdownStore = (DropdownStore*)calloc(
    1, sizeof(DropdownStore))
    if store == nil { abort() }
    store->previous_focused = 1
    return store
}

dropdown_store_free :: (store: *DropdownStore) #export {
    if store == nil { return }
    if store == dropdown_store_current() ||
    store == DropdownFallbackStore() { abort() }
    DropdownFreeStates(store->states)
    free(store)
}

dropdown_store_swap :: (store: *DropdownStore) -> *DropdownStore #export {
    previous: *DropdownStore = dropdown_store_current()
    active_dropdown_store = store
    if active_dropdown_store == nil {
        active_dropdown_store = DropdownFallbackStore()
    }
    return previous
}

dropdown_store_clip :: (top: i32, bottom: i32) #export {
    store: *DropdownStore = dropdown_store_current()
    store->clip_top = top > 0 ? top : 0
    store->clip_bottom = bottom > 0 ? bottom : 0
}
