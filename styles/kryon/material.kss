  border: #d8c0ff;
  focus: accent;
  radius: radius.lg;
  border-width: border;
  opacity: 1;
  material: flat;
}

SliderThumb:disabled {
  background: muted;
  foreground: surface;
  border: border;
  focus: border;
  opacity: 0.5;
}

Scroll {
  background: #202631;
