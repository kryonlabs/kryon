Window :: struct {
    title: string
    width: s32
    height: s32
}

// A frame identifies the session currently being composed. Widgets whose
// bounds are left at zero use that session's root bounds.
Frame :: struct {
    slot: s32
    epoch: u64
}

// Builds one frame's widgets.
Draw :: #type (frame: Frame) -> void;

// Calls `draw` for the frame of session `slot` at `epoch`. The frame hosts
// import this module by name and call through here: Ziran checks a direct
// call of an `App.Draw` against an unqualified `Frame`.
CallDraw :: (draw: Draw, slot: s32, epoch: u64) {
    draw(Frame.{.slot = slot, .epoch = epoch})
}
