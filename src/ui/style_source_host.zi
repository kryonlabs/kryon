#module "style_source_host"
#import "ui_style_pack_props.generated.h"
#import "ui/kss_parser.h"
#import "stdlib.h"
#import "string.h"

StyleSourcePack :: struct {
    id: [64]char
    base_id: [64]char
    source: const char*
    label: const char*
    description: const char*
    token_count: i32
    rules: [320]StyleRule
    sheet: StyleSheet
}

source_packs :: [32]StyleSourcePack #global
# Flat 32x64 token table; .kry has no nested fixed arrays.
source_pack_tokens :: [2048]StyleColorToken #global
source_pack_count :: i32 #global
active_style_theme :: const char* = "" #global

StyleCopyText :: (text: const char*) -> *char {
    if text == nil { return nil }
    length: size_t = strlen(text)
    copy: *char = (char*)malloc(length + 1)
    if copy == nil { return nil }
    memcpy(copy, text, length + 1)
    return copy
}

StyleCopyBounded :: (out: *char, capacity: size_t,
source: const char*) {
    if out == nil || capacity == 0 { return }
    out[0] = '\0'
    if source == nil { return }
    length: size_t = strlen(source)
    if length >= capacity { length = capacity - 1 }
    memcpy(out, source, length)
    out[length] = '\0'
}

StyleSourcePackSlot :: (id: const char*) -> *StyleSourcePack {
    index: i32 = 0
    while index < source_pack_count {
        if strcmp(source_packs[index].id, id) == 0 {
            return &source_packs[index]
        }
        index += 1
    }
    if source_pack_count >= 32 { return nil }
    slot: *StyleSourcePack = &source_packs[source_pack_count]
    source_pack_count += 1
    return slot
}

RegisterStyleVariantSource :: (source: const char*,
base_id: const char*, variant_name: const char*,
variant_label: const char*) -> bool {
    if source == nil || base_id == nil ||
    variant_name == nil || variant_label == nil {
        return false
    }
    result: KssParseResult = (KssParseResult){0}
    rules: [320]StyleRule = {0}
    diagnostic: [256]char
    variant_id: [64]char
    variant_source: [96]char
    base_length: size_t = strlen(base_id)
    variant_length: size_t = strlen(variant_name)
    if base_length + 1 + variant_length >= sizeof(variant_id) ||
    variant_length >= sizeof(variant_source) {
        return false
    }
    memcpy(variant_id, base_id, base_length)
    variant_id[base_length] = '.'
    memcpy(variant_id + base_length + 1, variant_name, variant_length)
    variant_id[base_length + 1 + variant_length] = '\0'
    StyleCopyBounded(variant_source,
    sizeof(variant_source), variant_name)
    if !kss_parse_with_environment(source, variant_source,
    active_style_theme, rules, 320, &result,
    diagnostic, sizeof(diagnostic)) {
        return false
    }
    if result.rule_count <= 0 { return false }
    slot: *StyleSourcePack = StyleSourcePackSlot(variant_id)
    if slot == nil { return false }
    source_copy: *char = StyleCopyText(source)
    label_copy: *char = StyleCopyText(variant_label)
    description_copy: *char = StyleCopyText("")
    if source_copy == nil || label_copy == nil ||
    description_copy == nil {
        free(source_copy)
        free(label_copy)
        free(description_copy)
        return false
    }
    free((void*)slot->source)
    free((void*)slot->label)
    free((void*)slot->description)
    *slot = (StyleSourcePack){0}
    StyleCopyBounded(slot->id, sizeof(slot->id), variant_id)
    StyleCopyBounded(slot->base_id, sizeof(slot->base_id), base_id)
    slot->source = source_copy
    slot->label = label_copy
    slot->description = description_copy
    memcpy(slot->rules, rules,
    (size_t)result.rule_count * sizeof(rules[0]))
    slot->sheet.rules = slot->rules
    slot->sheet.rule_count = result.rule_count
    pack: StylePack = (StylePack){
        .id = slot->id,
        .label = slot->label,
        .description = slot->description,
        .sheet = &slot->sheet}
    return RegisterStylePack(pack)
}

RegisterStyleSource :: (source: const char*,
label: const char*, description: const char*,
id: const char*, colors: const StyleColorToken*,
color_count: i32) -> bool {
    if source == nil { return false }
    source_copy: *char = StyleCopyText(source)
    if source_copy == nil { return false }
    result: KssParseResult = (KssParseResult){0}
    rules: [320]StyleRule = {0}
    diagnostic: [256]char
    parsed: bool = false
    if colors != nil || color_count > 0 {
        parsed = kss_parse_variant(source_copy, colors,
        color_count, rules, 320, &result,
        diagnostic, sizeof(diagnostic))
    } else {
        parsed = kss_parse_with_environment(source_copy,
        nil, active_style_theme, rules, 320,
        &result, diagnostic, sizeof(diagnostic))
    }
    if !parsed || result.pack_id[0] == '\0' ||
    result.rule_count <= 0 {
        free(source_copy)
        return false
    }
    if id != nil {
        if id[0] == '\0' || strlen(id) >= sizeof(result.pack_id) {
            free(source_copy)
            return false
        }
        StyleCopyBounded(result.pack_id,
        sizeof(result.pack_id), id)
    }
    slot: *StyleSourcePack = StyleSourcePackSlot(result.pack_id)
    if slot == nil {
        free(source_copy)
        return false
    }
    label_copy: *char = StyleCopyText(
    label != nil ? label : result.pack_id)
    description_copy: *char = StyleCopyText(
    description != nil ? description : "")
    if label_copy == nil || description_copy == nil {
        free(source_copy)
        free(label_copy)
        free(description_copy)
        return false
    }
    free((void*)slot->source)
    free((void*)slot->label)
    free((void*)slot->description)
    *slot = (StyleSourcePack){0}
    StyleCopyBounded(slot->id, sizeof(slot->id), result.pack_id)
    StyleCopyBounded(slot->base_id, sizeof(slot->base_id), result.pack_id)
    slot->source = source_copy
    slot->label = label_copy
    slot->description = description_copy
    kept: i32 = color_count < 64 ? color_count : 64
    if colors != nil && kept > 0 {
        slot_index: i32 = 0
        while slot_index < source_pack_count {
            if &source_packs[slot_index] == slot { break }
            slot_index += 1
        }
        memcpy(&source_pack_tokens[slot_index * 64], colors,
        (size_t)kept * sizeof(colors[0]))
    }
    slot->token_count = kept
    memcpy(slot->rules, rules,
    (size_t)result.rule_count * sizeof(rules[0]))
    slot->sheet.rules = slot->rules
    slot->sheet.rule_count = result.rule_count
    pack: StylePack = (StylePack){
        .id = slot->id,
        .label = slot->label,
        .description = slot->description,
        .sheet = &slot->sheet}
    if !RegisterStylePack(pack) { return false }
    index: i32 = 0
    while index < result.variant_count && index < 8 {
        if !RegisterStyleVariantSource(source_copy,
        result.pack_id, result.variants[index].name,
        result.variants[index].label) {
            return false
        }
        index += 1
    }
    return true
}

ReapplyStyleTheme :: () -> bool {
    index: i32 = 0
    while index < source_pack_count {
        slot: *StyleSourcePack = &source_packs[index]
        if slot->base_id[0] != '\0' &&
        strcmp(slot->id, slot->base_id) == 0 {
            id: [64]char
            label: [256]char
            description: [256]char
            StyleCopyBounded(id, sizeof(id), slot->id)
            StyleCopyBounded(label, sizeof(label), slot->label)
            StyleCopyBounded(description, sizeof(description),
            slot->description)
            if !RegisterStyleSource(slot->source, label,
            description, id, nil, 0) {
                return false
            }
        }
        index += 1
    }
    return true
}

SetStyleTheme :: (theme: const char*) -> bool #export {
    value: const char* = theme != nil ? theme : ""
    if strcmp(active_style_theme, value) == 0 {
        return true
    }
    active: [64]char
    StyleCopyBounded(active, sizeof(active),
    GetActiveStylePackId())
    active_style_theme = value
    if !ReapplyStyleTheme() {
        active_style_theme = ""
        return false
    }
    if !ReapplyBuiltInStyleTheme(value) {
        active_style_theme = ""
        return false
    }
    if active[0] != '\0' {
        SetActiveStylePack(active)
    }
    return true
}

RegisterStylePackSource :: (source: const char*,
label: const char*, description: const char*) -> bool #export {
    return RegisterStyleSource(source, label,
    description, nil, nil, 0)
}

RegisterStylePackVariant :: (id: const char*,
source: const char*, label: const char*,
colors: const StyleColorToken*, color_count: i32) -> bool #export {
    if id == nil { return false }
    return RegisterStyleSource(source, label, "",
    id, colors, color_count)
}

StyleTokenColorU32 :: (value: u32) -> Color #private {
    unpacked: Color = {0, 0, 0, 255}
    unpacked.r = (unsigned char)((value >> 24) & 255)
    unpacked.g = (unsigned char)((value >> 16) & 255)
    unpacked.b = (unsigned char)((value >> 8) & 255)
    unpacked.a = (unsigned char)(value & 255)
    return unpacked
}

StyleTokenColorOr :: (name: const char*,
fallback: Color) -> Color #export {
    # Read a registered color token from the active style pack; an empty
    # name or a miss returns the fallback so callers can chain lookups.
    if name == nil || name[0] == '\0' { return fallback }
    active: [64]char
    StyleCopyBounded(active, sizeof(active), GetActiveStylePackId())
    if active[0] == '\0' { return fallback }
    index: i32 = 0
    while index < source_pack_count {
        slot: *StyleSourcePack = &source_packs[index]
        if strcmp(slot->id, active) == 0 {
            token: i32 = 0
            while token < slot->token_count {
                entry: *const StyleColorToken =
                &source_pack_tokens[index * 64 + token]
                if entry->name != nil &&
                strcmp(entry->name, name) == 0 {
                    return StyleTokenColorU32(entry->color)
                }
                token += 1
            }
        }
        index += 1
    }
    return fallback
}

StyleTokenColor :: (name: const char*) -> Color #export {
    opaque: Color = {0, 0, 0, 255}
    return StyleTokenColorOr(name, opaque)
}
