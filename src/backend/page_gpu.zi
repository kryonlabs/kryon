    clear: s32
    clear_color: s32
    compile_shader: s32
    create_buffer: s32
    create_framebuffer: s32
    create_program: s32
    create_shader: s32
    create_texture: s32
    delete_buffer: s32
    delete_framebuffer: s32
    delete_program: s32
    delete_shader: s32
    delete_texture: s32
    disable: s32
    enable_vertex_array: s32
    draw_elements: s32
    enable: s32
    framebuffer_texture_2d: s32
    get_program_parameter: s32
    get_shader_parameter: s32
