# Resolve the Button's declared KSS role before any host drawing. Native hosts
# provide the active style pack and overrides; the widget owns the selection.
ButtonControlRoleState :: (button: ButtonProps, state: ButtonState,
style_kind: i32, role: i32, override_style: ControlStyle) -> StyleData #export {
    facts: StyleFacts = ButtonRoleFactsFor(style_kind, button.id,
    button.class_name, role, (int)button.tone, (int)button.emphasis,
    (int)button.size, state)
    value: StyleData = ResolveActiveStyle((StyleData){0}, facts, state)
    value.opacity = StyleOpacityValue(value.fields, value.opacity)
    return ResolveValues(value, ui_pack_style_states(override_style), state)
}

ButtonControlRoleFrame :: (button: ButtonProps, state: ButtonState,
automatic: i32, hover_amount: float, press_amount: float,
focus_amount: float, style_kind: i32, role: i32) -> StyleFrame #export {
    flags: StateFlags = ResolveFlags((int)button.state, button.disabled,
    button.loading, button.selected)
    frame: StyleFrame
    frame.value = ButtonControlRoleState(button, state, style_kind, role,
    (ControlStyle){0})
    frame.fill = FillState(frame.value.fields, frame.value.background,
    frame.value.background_end)
    if automatic && !flags.disabled && !flags.loading && !flags.selected &&
    (hover_amount > 0.0 || press_amount > 0.0 || focus_amount > 0.0) {
        normal: StyleData = frame.value
        if state != ButtonStateNormal {
            normal = ButtonControlRoleState(button, ButtonStateNormal,
            style_kind, role, (ControlStyle){0})
        }
        hover: StyleData = normal
        press: StyleData = normal
        focus: StyleData = normal
        if hover_amount > 0.0 {
            hover = ButtonControlRoleState(button, ButtonStateHover,
            style_kind, role, (ControlStyle){0})
        }
        if press_amount > 0.0 {
            press = ButtonControlRoleState(button, ButtonStatePressed,
            style_kind, role, (ControlStyle){0})
        }
        if focus_amount > 0.0 {
            focus = ButtonControlRoleState(button, ButtonStateFocus,
            style_kind, role, (ControlStyle){0})
        }
        frame = TransitionFrame(frame.value, normal, hover, press, focus,
        hover_amount, press_amount, focus_amount)
    }
    return frame
}

ui_resolve_button_spec_frame :: (button: ButtonSpec, state: ButtonState,
automatic: i32, hover_amount: float, press_amount: float,
focus_amount: float, style_kind: i32) -> StyleFrame #export {
    flags: StateFlags = ResolveFlags((int)button.props.state,
    button.props.disabled, button.props.loading, button.props.selected)
    frame: StyleFrame
    kind: i32 = style_kind
    if kind == 0 { kind = StyleKindButton() }
    frame.value = ButtonControlRoleState(button.props, state, kind,
    StyleAny(), button.style)
    frame.fill = FillState(frame.value.fields, frame.value.background,
    frame.value.background_end)
    if automatic && !flags.disabled && !flags.loading && !flags.selected &&
    (hover_amount > 0.0 || press_amount > 0.0 || focus_amount > 0.0) {
        normal: StyleData = frame.value
        if state != ButtonStateNormal {
            normal = ButtonControlRoleState(button.props, ButtonStateNormal,
            kind, StyleAny(), button.style)
        }
        hover: StyleData = normal
        press: StyleData = normal
        focus: StyleData = normal
        if hover_amount > 0.0 {
            hover = ButtonControlRoleState(button.props, ButtonStateHover,
            kind, StyleAny(), button.style)
        }
        if press_amount > 0.0 {
            press = ButtonControlRoleState(button.props, ButtonStatePressed,
            kind, StyleAny(), button.style)
        }
        if focus_amount > 0.0 {
            focus = ButtonControlRoleState(button.props, ButtonStateFocus,
            kind, StyleAny(), button.style)
        }
        frame = TransitionFrame(frame.value, normal, hover, press, focus,
        hover_amount, press_amount, focus_amount)
    }
    return frame
}

ButtonSpecFor :: (props: ButtonProps, surface_bounds: Rectangle,
disclosure: bool, style_kind: i32) -> ButtonSpec #export {
    props.disabled = props.disabled || props.state == ButtonStateDisabled ||
    ContentDisabled()
    props.loading = props.loading || props.state == ButtonStateLoading
    spec: ButtonSpec
    spec.props = props
    spec.surface_bounds = surface_bounds
    spec.disclosure = disclosure
    spec.style_kind = style_kind
    if spec.style_kind == 0 { spec.style_kind = StyleKindButton() }
    spec.style_resolved = true
    spec.paint = ui_resolve_button_style_kind(props, props.state,
    spec.style_kind)
    spec.paint.radius = ui_radius_px(props.bounds, spec.paint.radius)
    spec.hover_background = spec.paint.background
    return spec
}

ButtonBoundsForKind :: (props: ButtonProps, disclosure: bool,
style_kind: i32, parent_right: float) -> Rectangle #export {
    props.disabled = props.disabled || ContentDisabled()
    metrics: ThemeMetrics = GetThemeMetrics()
    face: Style = ui_resolve_button_style_kind(props, props.state, style_kind)
    minimum_height: i32 = Scale(SizeValue(props.size,
    metrics.control_height_small, metrics.control_height_medium,
    metrics.control_height_large))
    font: i32 = ResolveFont(0,
    StyleFontValue(face.fields, face.font_size), GetFontSize())
    available_width: float = 0.0
    if props.full_width && props.bounds.width <= 0.0 {
        available_width = parent_right - props.bounds.x
    }
    return MeasureButton(props, face, minimum_height, font,
    available_width, (float)Scale(1000) / 1000.0, disclosure)
}

ui_control_style_frame_role_kind :: (button: ButtonProps, state: ButtonState,
automatic: i32, hover_amount: float, press_amount: float,
focus_amount: float, style_kind: i32, role: i32) -> StyleFrame #export {
    kind: i32 = style_kind
    if kind == 0 { kind = StyleKindButton() }
    frame: StyleFrame = ButtonControlRoleFrame(button, state, automatic,
    hover_amount, press_amount, focus_amount, kind, role)
    return ui_style_apply_effects_frame(frame)
}

ui_control_style_frame_kind :: (button: ButtonProps, state: ButtonState,
automatic: i32, hover_amount: float, press_amount: float,
focus_amount: float, style_kind: i32) -> StyleFrame #export {
    return ui_control_style_frame_role_kind(button, state, automatic,
    hover_amount, press_amount, focus_amount, style_kind, StyleAny())
}

ui_button_style_frame :: (button: ButtonProps, state: ButtonState,
automatic: i32, hover_amount: float, press_amount: float,
focus_amount: float) -> StyleFrame #export {
    return ui_control_style_frame_kind(button, state, automatic,
    hover_amount, press_amount, focus_amount, StyleKindButton())
}

ui_resolve_button_style_kind :: (button: ButtonProps, state: ButtonState,
style_kind: i32) -> Style #export {
    frame: StyleFrame = ui_control_style_frame_kind(button, state,
    0, 0.0, 0.0, 0.0, style_kind)
    return ui_unpack_style(frame.value)
}

ResolveButtonStyle :: (button: ButtonProps, state: ButtonState) -> Style #export {
    return ui_resolve_button_style_kind(button, state, StyleKindButton())
}

RenderButtonInfoIndicator :: (props: ButtonProps, center_x: i32,
center_y: i32, diameter: i32) -> i32 #export {
    mouse: Vector2 = ui_mouse_world()
    scale: float = (float)Scale(1000) / 1000.0
    initial: ButtonState = (ButtonState)ResolveState(props.state,
    props.disabled, props.loading, false, false, false, props.selected)
    face: StyleFrame = ui_control_style_frame_kind(props, initial,
    0, 0.0, 0.0, 0.0, StyleKindButton())
    metrics: InfoIndicatorMetrics = InfoIndicatorMetricsFor(diameter,
    scale, face)
    paint: InfoIndicatorPaint = InfoIndicatorPaintFor(center_x, center_y,
    metrics, face, GetFontSize())
    interaction: InputPointerInteraction = InputPointerInteractionFor(
    CheckCollisionPointRec(mouse, paint.hit) != 0,
    InputCapturesClick(mouse) != 0,
    props.disabled || props.loading,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0, false, true)
    if interaction.active { MarkClickable() }
    if !IsWindowReady() {
        if interaction.consume_release { ConsumeRelease() }
        return interaction.activated
    }
    state: ButtonState = (ButtonState)ResolveState(props.state,
    props.disabled, props.loading, false, interaction.hovered,
    false, props.selected)
    face = ui_control_style_frame_kind(props, state,
    0, 0.0, 0.0, 0.0, StyleKindButton())
    paint = InfoIndicatorPaintFor(center_x, center_y, metrics,
    face, GetFontSize())
    DrawCircle(center_x, center_y, paint.radius, GetColor(paint.fill))
    DrawCircleLines(center_x, center_y, paint.radius, GetColor(paint.stroke))
    ui_paint_text_box("i", paint.bounds, paint.font, GetColor(paint.text),
    TextWrapNone, TextAlignCenter, TextAlignCenter, ui_active_font_token(), 0)
    if interaction.consume_release { ConsumeRelease() }
    return interaction.activated
}

ButtonDrawContent :: (button: ButtonSpec, bounds: Rectangle,
font: i32, color: Color) #export {
    paint: StyleData
    paint.icon_size = button.paint.icon_size
    paint.gap = button.paint.gap
    paint.offset_x = button.paint.content_offset.x
    paint.offset_y = button.paint.content_offset.y
    label: const char* = button.props.label
    if label == nil { label = "" }
    content: ContentDrawing = PaintContent(button.props, bounds, paint,
    font, TextWidth(label, font), ColorToInt(color),
    ColorToInt(ui_app_style().background),
    (float)Scale(1000) / 1000.0, GetTime() * 1000.0,
    button.disclosure)
    ui_draw(content.mark)
    ui_draw(content.label)
}

ButtonDrawImage :: (props: ButtonProps, fallback_bounds: Rectangle) #export {
    image: ImageProps = props.image
    if (image.asset_path == nil || image.asset_path[0] == '\0') &&
    image.bounds.width <= 0.0 && image.bounds.height <= 0.0 {
        return
    }
    if image.bounds.width <= 0.0 && image.bounds.height <= 0.0 {
        image.bounds = fallback_bounds
    }
    ImageTextureTinted(LoadImageTexture(image.asset_path), image, WHITE)
}

ButtonDrawSwatch :: (props: ButtonProps, bounds: Rectangle) #export {
    if !props.swatch || !IsWindowReady() { return }
    mouse: Vector2 = ui_mouse_world()
    hovered: bool = CheckCollisionPointRec(mouse, bounds) &&
    !InputCapturesClick(mouse) && HoverEffectsEnabled()
    focused: bool = IsFocusActive(props.id) &&
    !ui_popup_input_focus_captures(props.id)
    state: ButtonState = ButtonStateNormal
    if props.disabled { state = ButtonStateDisabled }
    else if focused { state = ButtonStateFocus }
    else if hovered { state = ButtonStateHover }
    face: StyleFrame = ui_control_style_frame_kind(props, state,
    0, 0.0, 0.0, 0.0, StyleKindButton())
    spec: SwatchSpec
    spec.bounds = bounds
    spec.color = props.swatch_color
    spec.disabled = props.disabled
    spec.hovered = hovered
    spec.focused = focused
    spec.scale = (float)Scale(1000) / 1000.0
    spec.face = face
    paint: SwatchPaint = SwatchPaintFor(spec)
    DrawRectangleRec(paint.checker_base, GetColor(paint.checker_base_color))
    DrawRectangleRec(paint.checker_a, GetColor(paint.checker_alt_color))
    DrawRectangleRec(paint.checker_b, GetColor(paint.checker_alt_color))
    DrawRectangleRounded(paint.swatch, paint.swatch_roundness, 8,
    paint.swatch_color)
    DrawRectangleLinesEx(paint.bounds, paint.border_width,
    GetColor(paint.border_color))
}

RenderIconAction :: (action: IconActionSpec) -> i32 #export {
    spec: ButtonSpec
    scale: float = (float)Scale(1000) / 1000.0
    if scale <= 0.0 { scale = 1.0 }
    empty_frame: StyleFrame
    metrics: IconActionMetrics = IconActionMetricsFor(action.bounds,
    action.icon_size, action.icon_padding, scale, empty_frame)
    spec.props.bounds = action.bounds
    spec.props.id = action.focus_id
    spec.props.disabled = action.disabled
    spec.props.icon = action.icon
    spec.props.icon_type = action.icon_type
    spec.props.icon_only = true
    spec.paint.icon_size = IconActionStyleIconSize(metrics.icon_size, scale)
    spec.props.tone = ButtonToneNeutral
    spec.props.emphasis = ButtonEmphasisGhost
    if action.background.a != 0 { spec.props.emphasis = ButtonEmphasisSoft }
    spec.style_resolved = true
    spec.style.normal.fields = StyleIconSize
    spec.style.normal.icon_size = spec.paint.icon_size
    if action.background.a != 0 {
        spec.style.normal.fields |= StyleBackground
        spec.style.normal.background = action.background
    }
    if action.hover_background.a != 0 {
        spec.style.hover.fields |= StyleBackground
        spec.style.hover.background = action.hover_background
    }
    if action.icon_color.a != 0 {
        spec.style.normal.fields |= StyleForeground
        spec.style.normal.foreground = action.icon_color
    }
    if action.border.a != 0 {
        spec.style.normal.fields |= StyleBorder
        spec.style.normal.border = action.border
    }
    if action.radius > 0.0 {
        spec.style.normal.fields |= StyleRadius
        spec.style.normal.radius = IconActionStyleRadius(action.radius,
        action.bounds, scale)
    }
    spec.paint.background = action.background
    spec.hover_background = action.hover_background
    spec.paint.foreground = action.icon_color
    spec.paint.border = action.border
    spec.paint.radius = action.radius
    return ui_button_render(spec)
}

ui_text_button_render :: (center_x: i32, y: i32, label: const char*,
hover_out: *i32) -> i32 #export {
    style_props: ButtonProps
    style_props.tone = ButtonToneNeutral
    style_props.emphasis = ButtonEmphasisSoft
    style_props.size = ControlSizeMedium
    frame: StyleFrame = ButtonControlRoleFrame(style_props, ButtonStateNormal,
    0, 0.0, 0.0, 0.0, StyleKindButton(), StyleAny())
    font: i32 = ResolveFont(0, StyleFontValue(frame.value.fields,
    frame.value.font_size), GetFontSize())
    text: const char* = label
    if text == nil { text = "" }
    metrics: TextButtonMetrics = TextButtonMetricsFor(
    (float)Scale(1000) / 1000.0, frame)
    width: i32 = (int)TextWidth(text, font) + metrics.padding_x * 2
    height: i32 = TextLineHeight(font) + metrics.padding_y * 2
    if width < metrics.min_width { width = metrics.min_width }
    if height < metrics.min_height { height = metrics.min_height }
    bounds: Rectangle
    bounds.x = (float)(center_x - width / 2)
    bounds.y = (float)y
    bounds.width = (float)width
    bounds.height = (float)height
    mouse: Vector2 = ui_mouse_world()
    hovered: bool = CheckCollisionPointRec(mouse, bounds) &&
    !InputCapturesClick(mouse) && HoverEffectsEnabled()
    if hover_out != nil { *hover_out = hovered }
    spec: ButtonSpec
    spec.props.bounds = bounds
    spec.props.label = text
    spec.style_resolved = true
    spec.style_kind = StyleKindButton()
    return ui_button_render(spec)
}

RenderButtonNative :: (button: ButtonSpec, handle_input: bool,
paint: bool, retained_hovered: bool, retained_pressed: bool,
foreground_out: *Color) -> i32 {
    editor_id: [96]char
    widget: Widget
    style_kind: i32 = button.style_kind
    if style_kind == 0 { style_kind = StyleKindButton() }
    text: Color
    cues: bool = TransitionCuesEnabled()
    termi: bool = ui_backend_is_termi()

    if handle_input {
        widget = BeginWidget("Button", ui_inspect_control_id(editor_id, 96,
        "Button", button.props.id, button.props.label),
        button.props.bounds, WidgetFlagMovable | WidgetFlagResizable)
        button.props.bounds = widget.bounds
        WidgetSetAction(&widget, button.props.label)
    }
    props: ButtonProps = button.props
    input: ButtonInput
    if handle_input {
        flags: StateFlags = ResolveFlags((int)props.state, props.disabled,
        props.loading, props.selected)
        kind: i32 = WidgetKindButton
        if button.style_kind == StyleKindCard() { kind = WidgetKindCard }
        ui_accessibility_prepare(props.id, kind,
        CanActivate(flags.disabled, flags.loading))
        input = ReadButtonInput(props.bounds, props.id, (int)props.state,
        props.disabled, props.loading, props.selected)
    } else {
        sample: Activation
        sample.hovered = retained_hovered
        sample.pressed = retained_pressed
        sample.focused = button.props.id > 0 && IsFocusActive(button.props.id)
        if sample.focused && IsFocusActivatePressed(button.props.id) {
            sample.pressed = true
        }
        input = ResolveButtonInput((int)props.state, props.disabled,
        props.loading, props.selected, sample)
    }
    button.props.disabled = input.flags.disabled
    button.props.loading = input.flags.loading
    button.props.selected = input.flags.selected
    focused: bool = input.interaction.focused
    bounds: Rectangle = button.props.bounds
    if button.props.invisible || !paint || !IsWindowReady() {
        if focused { SetFocusTextInputActive(0) }
        if handle_input { EndWidget(&widget) }
        if handle_input { return input.activated }
        return 0
    }

    if !termi {
        key: u32 = 2166136261u
        label: const char* = button.props.label
        if label == nil { label = "" }
        key = (key ^ (unsigned int)button.props.id) * 16777619u
        if button.props.id == 0 {
            key = (key ^ (unsigned int)(int)button.props.bounds.x) * 16777619u
            key = (key ^ (unsigned int)(int)button.props.bounds.y) * 16777619u
            while label[0] != '\0' {
                key = (key ^ (unsigned char)label[0]) * 16777619u
                label += 1
            }
        }
        props = button.props
        props.disabled = input.flags.disabled
        props.loading = input.flags.loading
        props.selected = input.flags.selected
        metrics: ThemeMetrics = GetThemeMetrics()
        motion: InteractionMotion = AdvanceButtonMotion(key,
        (int)props.state, input, cues, GetFrameTime() * 1000.0,
        metrics.transition_normal_ms, metrics.transition_fast_ms)
        appearance: StyleFrame = ui_resolve_button_spec_frame(button,
        input.interaction.state, (int)props.state == ButtonStateAuto,
        motion.hover.value, motion.press.value, motion.focus.value,
        style_kind)
        style_font: i32 = StyleFontValue(appearance.value.fields,
        appearance.value.font_size)
        if style_font > 0 {
            style_font = (int)((float)style_font * GetScale() + 0.5)
        }
        frame: ButtonFrame = BuildFrame(props, input, appearance, motion,
        button.surface_bounds, ColorToInt(ui_app_style().background),
        GetScale(), style_font, GetFontSize())
        frame.appearance = ui_style_apply_effects_frame(frame.appearance)
        frame.material.value = frame.appearance.value
        frame.material.fill = ui_style_apply_effects_fill(frame.material.fill)
        if motion.active || (button.props.loading && !button.props.disabled) {
            InvalidateTree(INVALIDATE_PAINT)
        }
        text = GetColor(frame.foreground)
        if foreground_out != nil { *foreground_out = text }
        if focused { SetFocusTextInputActive(0) }
        typeface_token: i32 = PushTextFont(frame.appearance.value.typeface.data)
        painted_label: const char* = frame.props.label
        if painted_label == nil { painted_label = "" }
        PaintButton(frame, TextWidth(painted_label, frame.font),
        GetTime() * 1000.0, button.disclosure,
        ui_surface_painter, ui_painter)
        ButtonDrawSwatch(frame.props, frame.props.bounds)
        ButtonDrawImage(frame.props, frame.props.bounds)
        PopTextFont(typeface_token)
        if handle_input { EndWidget(&widget) }
        if handle_input { return input.activated }
        return 0
    }

    appearance: StyleFrame = ui_resolve_button_spec_frame(button,
    input.interaction.state, 0, 0.0, 0.0, 0.0, style_kind)
    appearance = ui_style_apply_effects_frame(appearance)
    background: Color = GetColor(Opacity(appearance.value.background,
    appearance.value.opacity))
    border: Color = GetColor(Opacity(appearance.value.border,
    appearance.value.opacity))
    text = GetColor(Opacity(appearance.value.foreground,
    appearance.value.opacity))
    DrawRectangleRec(bounds, background)
    border_width: float = appearance.value.border_width * GetScale()
    if border_width > 0.0 && border.a != 0 {
        DrawRectangleLinesEx(bounds, border_width, border)
    }
    if focused { SetFocusTextInputActive(0) }
    if foreground_out != nil { *foreground_out = text }
    ButtonDrawSwatch(button.props, bounds)
    typeface_token: i32 = PushTextFont(appearance.value.typeface.data)
    font: i32 = ResolveFont(0, StyleFontValue(appearance.value.fields,
    appearance.value.font_size), GetFontSize())
    ButtonDrawContent(button, bounds, font, text)
    PopTextFont(typeface_token)
    ButtonDrawImage(button.props, bounds)
    if handle_input { EndWidget(&widget) }
    if handle_input { return input.activated }
    return 0
}

ui_button_render :: (button: ButtonSpec) -> i32 #export {
    return RenderButtonNative(button, true, true, false, false, nil)
}

HandleButton :: (button: ButtonSpec) -> i32 #export {
    return RenderButtonNative(button, true, false, false, false, nil)
}

ui_paint_button :: (button: ButtonSpec, hovered: i32,
pressed: i32) -> Color #export {
    foreground: Color = button.paint.foreground
    RenderButtonNative(button, false, true, hovered, pressed, &foreground)
    return foreground
}

resolve_button_bounds_for_kind :: (button: ButtonProps,
disclosure: i32, style_kind: i32) -> Rectangle {
    parent_right: f32 = (float)GetViewWidth()
    if ui_tree_stack_depth > 0 {
        parent: Rectangle = ui_tree_nodes[
        ui_tree_stack[ui_tree_stack_depth - 1]].bounds
        if parent.width > 0 {
            parent_right = parent.x + parent.width
        }
    }
    return ButtonBoundsForKind(button, disclosure,
    style_kind, parent_right)
}

ui_tree_button_spec_for_kind :: (button: ButtonProps,
surface_bounds: Rectangle, disclosure: i32,
style_kind: i32) -> ButtonSpec {
    return ButtonSpecFor(button, surface_bounds,
    disclosure, style_kind)
}

resolve_button_bounds :: (button: ButtonProps,
disclosure: i32) -> Rectangle {
    return resolve_button_bounds_for_kind(button, disclosure,
    StyleKindButton())
}

ui_tree_button_spec :: (button: ButtonProps,
surface_bounds: Rectangle, disclosure: i32) -> ButtonSpec {
    return ui_tree_button_spec_for_kind(button, surface_bounds,
    disclosure, StyleKindButton())
}

ui_tree_surface_button :: (button: ButtonProps,
surface_bounds: Rectangle, disclosure: i32) -> i32 {
    button.bounds = resolve_button_bounds(button, disclosure)
    button.id = ResolveFocusID(button.id)
    spec: ButtonSpec = ui_tree_button_spec(button,
    surface_bounds, disclosure)
    node: NodeId = ui_tree_add(button.id, WidgetKindButton,
    button.bounds, nil)
    if node >= 0 {
        spec.props.bounds = ui_tree_nodes[node].bounds
        ui_tree_nodes[node].owned_text = ui_tree_strdup(button.label)
        ui_tree_nodes[node].data.button = spec
        ui_tree_nodes[node].data.button.props.label =
        ui_tree_nodes[node].owned_text
    }
    clicked: i32 = 0
    if ui_tree_building { clicked = HandleButton(spec) }
    else { clicked = ui_button_render(spec) }
    ui_tree_mark_build_activation(node, clicked)
    return clicked
}

ui_tree_arrow_button_label :: (glyph: i32) -> const char* {
    if glyph == 62 { return ">" }
    if glyph == 94 { return "^" }
    if glyph == 118 { return "v" }
    return "<"
}

Button :: (button: ButtonProps) -> i32 #export {
    if button.info {
        scale: f32 = (float)Scale(1000) / 1000.0f
        indicator: ButtonProps = button
        indicator.pill = true
        flags: StateFlags = ResolveFlags((int)button.state,
        button.disabled, button.loading, button.selected)
        indicator.disabled = flags.disabled || ContentDisabled()
        indicator.loading = flags.loading
        initial_state: ButtonState = (ButtonState)ResolveState(
        indicator.state, indicator.disabled, indicator.loading,
        false, false, false, indicator.selected)
        frame: StyleFrame = ui_control_style_frame_kind(indicator,
        initial_state, 0, 0.0f, 0.0f, 0.0f, StyleKindButton())
        info: ButtonInfoBounds = ButtonInfoBoundsFor(button.bounds,
        scale, frame)
        bounds: Rectangle = info.bounds
        node: NodeId = ui_tree_add(button.id, WidgetKindButton,
        bounds, nil)
        enabled: i32 = CanActivate(flags.disabled, flags.loading) &&
        !ContentDisabled()
        if node >= 0 {
            ui_tree_nodes[node].data.button.props = button
        }
        ui_accessibility_prepare(button.id, WidgetKindButton, enabled)
        activated: i32 = ui_accessibility_take_activation(button.id)
        if enabled && button.id > 0 { RegisterFocus(button.id, bounds) }
        clicked: i32 = RenderButtonInfoIndicator(indicator,
        (int)(bounds.x + bounds.width / 2),
        (int)(bounds.y + bounds.height / 2), info.diameter)
        clicked = enabled &&
        (clicked || activated || IsFocusActivatePressed(button.id))
        ui_tree_mark_build_activation(node, clicked)
        ui_tree_mark_painted_immediate(node)
        return clicked
    }
    if button.arrow {
        if button.direction == ArrowRight ||
        button.direction == ArrowLeft {
            button.label = ""
            if button.direction == ArrowRight {
                button.icon_type = ICON_RIGHT
            } else {
                button.icon_type = ICON_LEFT
            }
            button.icon_only = true
        } else {
            button.label = ui_tree_arrow_button_label(
            ButtonArrowGlyph(button.direction))
        }
        if button.size == ControlSizeMedium {
            button.size = ControlSizeSmall
        }
        return ui_tree_surface_button(button,
        (Rectangle){0}, 0)
    }
    open_local: i32 = 0
    activated: i32 = 0
    if button.menu || button.split {
        if button.open == nil { button.open = &open_local }
        if button.activated_id == nil {
            button.activated_id = &activated
        }
        *button.activated_id = 0
    }
    if button.split {
        action: ButtonProps = button
        menu: ButtonProps = button
        if action.id == 0 {
            action.id = ResolveFocusID(0)
            menu.id = ResolveFocusID(0)
        } else {
            menu.id = action.id + 1
        }
        action.bounds = resolve_button_bounds(action, 0)
        layout: ButtonSplitLayout = ButtonResolveSplitLayout(
        action.bounds.width, action.bounds.height)
        action.bounds.width = layout.action_width
        menu.bounds = (Rectangle){action.bounds.x + layout.menu_offset,
            action.bounds.y, layout.menu_width, action.bounds.height}
        menu.label = "Open menu"
        menu.icon_type = ICON_NONE
        menu.icon_only = true
        menu.square = true
        menu.menu = false
        menu.split = false
        surface_bounds: Rectangle = (Rectangle){action.bounds.x,
            action.bounds.y, layout.width, action.bounds.height}
        clicked: i32 = ui_tree_surface_button(action,
        surface_bounds, 0)
        *button.open = ButtonToggleMenuOpen(*button.open,
        ui_tree_surface_button(menu, surface_bounds, 1))
        divider_style: Style = ui_resolve_button_style_kind(action,
        ButtonStateNormal, StyleKindButton())
        inset: i32 = Scale((int)layout.divider_inset)
        Line((int)menu.bounds.x, (int)menu.bounds.y + inset,
        (int)menu.bounds.x,
        (int)(menu.bounds.y + menu.bounds.height) - inset,
        divider_style.border)
        if *button.open {
            *button.activated_id = RenderPopupMenu(button.menu_id,
            button.class_name, (int)action.bounds.x,
            (int)(action.bounds.y + action.bounds.height),
            button.items, button.item_count)
            *button.open = ButtonCloseMenuAfterActivation(
            *button.open, *button.activated_id)
        }
        return clicked
    }
    if button.menu {
        button.icon_placement = IconPlacementTrailing
        button.icon_type = ICON_NONE
        button.bounds = resolve_button_bounds(button, 1)
        *button.open = ButtonToggleMenuOpen(*button.open,
        ui_tree_surface_button(button, (Rectangle){0}, 1))
        if *button.open {
            *button.activated_id = RenderPopupMenu(button.menu_id,
            button.class_name, (int)button.bounds.x,
            (int)(button.bounds.y + button.bounds.height),
            button.items, button.item_count)
            *button.open = ButtonCloseMenuAfterActivation(
            *button.open, *button.activated_id)
        }
        return *button.activated_id != 0
    }
    return ui_tree_surface_button(button, (Rectangle){0}, 0)
}

ButtonScope :: (button: ButtonProps) -> NodeId #export {
    button.bounds = resolve_button_bounds(button, 0)
    button.id = ResolveFocusID(button.id)
    spec: ButtonSpec = ui_tree_button_spec(button,
    (Rectangle){0}, 0)
    spec.props.label = ""
    node: NodeId = ui_tree_add(button.id, WidgetKindButton,
    button.bounds, nil)
    if node < 0 { return node }
    spec.props.bounds = ui_tree_nodes[node].bounds
    ui_tree_nodes[node].owned_text = ui_tree_strdup(button.label)
    ui_tree_nodes[node].data.button = spec
    if ui_tree_stack_depth < TREE_LAYOUT_DEPTH {
        ui_tree_stack[ui_tree_stack_depth] = node
        ui_tree_stack_depth += 1
    }
    if button.label != nil && button.label[0] != '\0' {
        Text((TextProps){.text = button.label,
            .wrap = TextWrapNone})
    }
    return node
}

Card :: (card: CardProps) -> i32 #export {
    button: ButtonProps = CardButtonProps(card)
    button.bounds = resolve_button_bounds_for_kind(button,
    0, StyleKindCard())
    if card.clickable { button.id = ResolveFocusID(button.id) }
    spec: ButtonSpec = ui_tree_button_spec_for_kind(button,
    (Rectangle){0}, 0, StyleKindCard())
    spec.props.label = ""
    node: NodeId = ui_tree_add(button.id, WidgetKindCard,
    button.bounds, nil)
    if node >= 0 {
        spec.props.bounds = ui_tree_nodes[node].bounds
        ui_tree_nodes[node].data.button = spec
    }
    clicked: i32 = 0
    if card.clickable {
        if ui_tree_building { clicked = HandleButton(spec) }
        else { clicked = ui_button_render(spec) }
        ui_tree_note_build_activation(clicked)
    } else if !ui_tree_building {
        ui_paint_button(spec, 0, 0)
    }
    return clicked
}

Menu :: (menu: MenuProps) -> MenuResult #export {
    bounds: Rectangle = menu.bounds
    if menu.mode == MenuModeContext { bounds = menu.trigger }
    ui_tree_add(menu.id, WidgetKindMenu, bounds, &menu)
    return RenderMenu(menu)
}

CardScope :: (card: CardProps) -> NodeId #export {
    button: ButtonProps = CardButtonProps(card)
    button.bounds = resolve_button_bounds_for_kind(button,
    0, StyleKindCard())
    if card.clickable { button.id = ResolveFocusID(button.id) }
    spec: ButtonSpec = ui_tree_button_spec_for_kind(button,
    (Rectangle){0}, 0, StyleKindCard())
    spec.props.label = ""
    node: NodeId = ui_tree_add(button.id, WidgetKindCard,
    button.bounds, nil)
    if node < 0 { return node }
    spec.props.bounds = ui_tree_nodes[node].bounds
    ui_tree_nodes[node].data.button = spec
    if card.clickable {
        clicked: i32 = 0
        if ui_tree_building { clicked = HandleButton(spec) }
        else { clicked = ui_button_render(spec) }
        ui_tree_mark_build_activation(node, clicked)
    } else if !ui_tree_building {
        ui_paint_button(spec, 0, 0)
    }
    if ui_tree_stack_depth < TREE_LAYOUT_DEPTH {
        ui_tree_stack[ui_tree_stack_depth] = node
        ui_tree_stack_depth += 1
    }
    return node
}
