#import "geometry"
#import "grid"
#import "grid_props"
#import "layout"
#import "semantic"
#import "widget_kind"

# A retained node keeps its identity only when its key, kind, and parent key
# match the previous committed tree. The portable tree owns this decision;
# the old native tree host also calls these pure policy functions.
#program_export
TreeIdentityHash :: (parent: u64, key: u64, kind: s32) -> u64 {
    hash: u64 = key ^ (parent * cast(u64)16777619)
    hash = hash ^ (cast(u64)cast(u32)kind * cast(u64)2166136261)
    hash = (hash ^ (hash >> cast(u64)16)) * cast(u64)2246822519
    return hash ^ (hash >> cast(u64)16)
}

#program_export
TreeSameIdentity :: (old_key: u64, old_kind: s32, old_parent_key: u64,
    new_key: u64, new_kind: s32, new_parent_key: u64) -> bool {
    return old_key == new_key && old_kind == new_kind &&
        old_parent_key == new_parent_key
}

#program_export
TreeButtonLike :: (kind: s32) -> bool {
    return kind == WidgetKindButton || kind == WidgetKindCard
}

#program_export
TreeInteractiveButtonLike :: (kind: s32, focus_id: s32,
    disabled: bool, loading: bool) -> bool {
    if !TreeButtonLike(kind) { return false }
    if kind == WidgetKindCard && focus_id <= 0 { return false }
    return !disabled && !loading
}

# Checked value controls use the same retained press and release routing as
# Buttons. Cards remain opt in through a positive focus id.
#program_export
TreePointerActivatable :: (kind: s32, focus_id: s32,
    disabled: bool, loading: bool) -> bool {
    if disabled || loading { return false }
    if kind == WidgetKindCard { return focus_id > 0 }
    return kind == WidgetKindButton || kind == WidgetKindCheckbox ||
        kind == WidgetKindToggle || kind == WidgetKindRadio ||
        kind == WidgetKindSlider || kind == WidgetKindSelectable ||
        kind == WidgetKindLink || kind == WidgetKindCollapsible ||
        kind == WidgetKindDropdown || kind == WidgetKindTextField ||
        kind == WidgetKindTextArea
}

TreeCommitPlan :: struct {
    keep_committed: bool
    reconcile: bool
    route_input: bool
}

# During activation, a partial submission must preserve the committed tree
# and defer input until the replacement tree is complete.
#program_export
TreeCommitFor :: (activation: bool, committed_count: s32,
    submitted_count: s32) -> TreeCommitPlan {
    plan: TreeCommitPlan
    plan.keep_committed = activation && committed_count > 0 &&
        submitted_count >= 0 && submitted_count < committed_count
    plan.reconcile = !plan.keep_committed
    plan.route_input = !plan.keep_committed
    return plan
}

# The portable tree owns node identity across bundle instance runs. Geometry
# and widget data are values; platform hosts only consume the committed tree.
TreeEntry :: struct {
    key: u64
    parent_key: u64
    kind: s32
    bounds: Rectangle
    clip: Rectangle
    child_clip: Rectangle
    clipped: bool
    clips_children: bool
    measured_bounds: Rectangle
    auto_placed: bool
    layout_gap: s32
    layout_padding: s32
    grid_columns: s32
    grid_min_item_width: s32
    grid_max_columns: s32
    semantic_label: string
    semantic_kind: SemanticKind
    heading_level: s32
    parent: s32
    first_child: s32
    last_child: s32
    next_sibling: s32
    identity_generation: s32
    matched: bool
    interactive: bool
    disabled: bool
    loading: bool
    selected: bool
    focus_id: s32
}

TreeStore :: struct {
    committed: [1024]TreeEntry
    submitted: [1024]TreeEntry
    slots: [2048]s32
    scope: [64]s32
    scope_depth: s32
    committed_count: s32
    submitted_count: s32
    next_identity_generation: s32
    building: bool
    overflow: bool
}

active_tree: TreeStore;

#program_export
TreeStart :: (screen_key: u64, bounds: Rectangle) {
    active_tree.submitted_count = 0
    active_tree.scope_depth = 0
    active_tree.building = true
    active_tree.overflow = false
    key: u64 = screen_key
    if key == 0 { key = 1 }
    if TreeSubmit(key, -1, WidgetKindScreen, bounds) == 0 {
        active_tree.scope[0] = 0
        active_tree.scope_depth = 1
    }
}

# The root is the default scope. A container submits itself, pushes its node,
# composes children, then pops it. Explicit TreeSubmit still accepts a parent
# index for controls such as Spinbox that create their own child nodes.
#program_export
TreeCurrentParent :: () -> s32 {
    if !active_tree.building || active_tree.scope_depth <= 0 {
        return -1
    }
    return active_tree.scope[active_tree.scope_depth - 1]
}

#program_export
TreeCurrentParentKey :: () -> u64 {
    parent: s32 = TreeCurrentParent()
    if parent < 0 { return cast(u64)0 }
    return active_tree.submitted[parent].key
}

#program_export
TreeCurrentParentBounds :: () -> Rectangle {
    parent: s32 = TreeCurrentParent()
    if parent < 0 {
        empty: Rectangle
        return empty
    }
    return active_tree.submitted[parent].bounds
}

#program_export
TreeSubmitCurrent :: (key: u64, kind: s32,
    bounds: Rectangle) -> s32 {
    parent: s32 = TreeCurrentParent()
    if parent < 0 { return -1 }
    return TreeSubmit(key, parent, kind, bounds)
}

#program_export
TreePushScope :: (index: s32) -> bool {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count ||
        active_tree.scope_depth <= 0 ||
        active_tree.scope_depth >= 64 { return false }
    active_tree.scope[active_tree.scope_depth] = index
    active_tree.scope_depth += 1
    return true
}

#program_export
TreePopScope :: () -> bool {
    if !active_tree.building || active_tree.scope_depth <= 1 {
        return false
    }
    active_tree.scope_depth -= 1
    return true
}

# Close the innermost container opened by Page, Section, or another layout
# widget. The root scope closes only through TreeFinish.
#program_export
End :: () -> bool {
    return TreePopScope()
}

#program_export
TreeSubmit :: (key: u64, parent_index: s32, kind: s32,
    bounds: Rectangle) -> s32 {
    if !active_tree.building || active_tree.overflow { return -1 }
    if active_tree.submitted_count >= 1024 {
        active_tree.overflow = true
        return -1
    }
    if parent_index >= active_tree.submitted_count || parent_index < -1 {
        return -1
    }
    index: s32 = active_tree.submitted_count
    entry: TreeEntry
    entry.key = key
    if key == 0 { entry.key = cast(u64)(index + 1) }
    if parent_index >= 0 {
        entry.parent_key = active_tree.submitted[parent_index].key
        parent_clip: TreeEntry = active_tree.submitted[parent_index]
        if parent_clip.clips_children {
            entry.clip = parent_clip.child_clip
            entry.clipped = true
        } else if parent_clip.clipped {
            entry.clip = parent_clip.clip
            entry.clipped = true
        }
    }
    entry.kind = kind
    entry.measured_bounds = bounds
    if parent_index >= 0 && bounds.x == 0.0 && bounds.y == 0.0 {
        parent: TreeEntry = active_tree.submitted[parent_index]
        metrics: LayoutMetrics = LayoutMetricsFor(parent.bounds,
            parent.layout_gap, parent.layout_padding)
        horizontal: bool = parent.kind == WidgetKindRow
        vertical: bool = parent.kind == WidgetKindColumn ||
            parent.kind == WidgetKindPage ||
            parent.kind == WidgetKindSection
        if horizontal || vertical {
            sibling: s32 = parent.first_child
            count: s32 = 0
            extent: float32 = 0.0
            while sibling >= 0 {
                prior: TreeEntry = active_tree.submitted[sibling]
                if prior.auto_placed {
                    count += 1
                    if horizontal { extent += prior.bounds.width }
                    else { extent += prior.bounds.height }
                }
                sibling = prior.next_sibling
            }
            cursor: float32 = LayoutCursorForChild(metrics, horizontal,
                count, extent)
            entry.bounds = LayoutChildBounds(bounds, bounds,
                metrics, horizontal, cursor)
            entry.auto_placed = true
        } else if parent.kind == WidgetKindStack {
            entry.bounds = StackChildBounds(bounds, bounds, metrics)
            entry.auto_placed = true
        } else if parent.kind == WidgetKindGrid {
            props: GridProps
            props.bounds = parent.bounds
            props.gap = parent.layout_gap
            props.padding = parent.layout_padding
            props.columns = parent.grid_columns
            props.min_item_width = parent.grid_min_item_width
            props.max_columns = parent.grid_max_columns
            grid: GridCursor = BeginGridCursor(props)
            sibling: s32 = parent.first_child
            while sibling >= 0 {
                prior: TreeEntry = active_tree.submitted[sibling]
                if prior.auto_placed {
                    grid = GridStep(grid, cast(s32)prior.bounds.height, 1)
                }
                sibling = prior.next_sibling
            }
            grid = GridStep(grid, cast(s32)bounds.height, 1)
            entry.bounds = grid.item
            entry.auto_placed = true
        }
    }
    if !entry.auto_placed { entry.bounds = bounds }
    entry.parent = parent_index
    entry.first_child = -1
    entry.last_child = -1
    entry.next_sibling = -1
    active_tree.submitted[index] = entry
    if parent_index >= 0 {
        last: s32 = active_tree.submitted[parent_index].last_child
        if last < 0 {
            active_tree.submitted[parent_index].first_child = index
        } else {
            active_tree.submitted[last].next_sibling = index
        }
        active_tree.submitted[parent_index].last_child = index
    }
    active_tree.submitted_count += 1
    return index
}

#program_export
TreeSetLayout :: (index: s32, gap: s32, padding: s32,
    columns: s32, min_item_width: s32,
    max_columns: s32) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    active_tree.submitted[index].layout_gap = gap
    active_tree.submitted[index].layout_padding = padding
    active_tree.submitted[index].grid_columns = columns
    active_tree.submitted[index].grid_min_item_width = min_item_width
    active_tree.submitted[index].grid_max_columns = max_columns
}

# A container sets this before submitting children. Its own input is not
# clipped by the child viewport; descendants inherit the intersection.
#program_export
TreeSetChildClip :: (index: s32, bounds: Rectangle) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    entry: TreeEntry = active_tree.submitted[index]
    if entry.clipped {
        entry.child_clip = RectangleIntersection(bounds, entry.clip)
    } else {
        entry.child_clip = bounds
    }
    entry.clips_children = true
    active_tree.submitted[index] = entry
}

#program_export
TreeSubmittedNodeAt :: (index: s32) -> TreeEntry {
    empty: TreeEntry
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return empty }
    return active_tree.submitted[index]
}

#program_export
TreeFinish :: () -> bool {
    if !active_tree.building { return false }
    active_tree.building = false
    if active_tree.overflow || active_tree.scope_depth != 1 {
        active_tree.scope_depth = 0
        return false
    }
    active_tree.scope_depth = 0
    slot: s32 = 0
    while slot < 2048 {
        active_tree.slots[slot] = -1
        slot += 1
    }
    old_index: s32 = 0
    while old_index < active_tree.committed_count {
        active_tree.committed[old_index].matched = false
        old: TreeEntry = active_tree.committed[old_index]
        slot = cast(s32)(TreeIdentityHash(old.parent_key, old.key, old.kind) &
            cast(u64)2047)
        while active_tree.slots[slot] >= 0 {
            slot = (slot + 1) & 2047
        }
        active_tree.slots[slot] = old_index
        old_index += 1
    }
    index: s32 = 0
    while index < active_tree.submitted_count {
        next: TreeEntry = active_tree.submitted[index]
        slot = cast(s32)(TreeIdentityHash(next.parent_key, next.key,
            next.kind) & cast(u64)2047)
        while active_tree.slots[slot] >= 0 {
            old_index = active_tree.slots[slot]
            old: TreeEntry = active_tree.committed[old_index]
            if !old.matched && TreeSameIdentity(old.key, old.kind,
                old.parent_key, next.key, next.kind, next.parent_key) {
                next.identity_generation = old.identity_generation
                active_tree.committed[old_index].matched = true
                break
            }
            slot = (slot + 1) & 2047
        }
        if next.identity_generation == 0 {
            active_tree.next_identity_generation += 1
            next.identity_generation = active_tree.next_identity_generation
        }
        active_tree.submitted[index] = next
        index += 1
    }
    index = 0
    while index < active_tree.submitted_count {
        active_tree.committed[index] = active_tree.submitted[index]
        index += 1
    }
    active_tree.committed_count = active_tree.submitted_count
    return true
}

#program_export
TreeCount :: () -> s32 {
    return active_tree.committed_count
}

#program_export
TreeIsBuilding :: () -> bool {
    return active_tree.building
}

#program_export
TreeNextKey :: () -> u64 {
    if !active_tree.building { return cast(u64)0 }
    return cast(u64)(active_tree.submitted_count + 1)
}

#program_export
TreeRootKey :: () -> u64 {
    if !active_tree.building || active_tree.submitted_count == 0 {
        return cast(u64)0
    }
    return active_tree.submitted[0].key
}

#program_export
TreeRootBounds :: () -> Rectangle {
    empty: Rectangle
    if !active_tree.building || active_tree.submitted_count == 0 {
        return empty
    }
    return active_tree.submitted[0].bounds
}

#program_export
TreeCancel :: () {
    active_tree.building = false
    active_tree.submitted_count = 0
    active_tree.scope_depth = 0
    active_tree.overflow = false
}

#program_export
TreeNodeAt :: (index: s32) -> TreeEntry {
    empty: TreeEntry
    if index < 0 || index >= active_tree.committed_count { return empty }
    return active_tree.committed[index]
}

#program_export
TreeSetLabel :: (index: s32, label: string) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    active_tree.submitted[index].semantic_label = label
}

#program_export
TreeSetSemantic :: (index: s32, kind: SemanticKind,
    heading_level: s32) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    if kind != cast(SemanticKind)SemanticHeading {
        heading_level = 0
    } else {
        if heading_level < 1 { heading_level = 1 }
        if heading_level > 6 { heading_level = 6 }
    }
    active_tree.submitted[index].semantic_kind = kind
    active_tree.submitted[index].heading_level = heading_level
}

#program_export
TreeSetInteractive :: (index: s32, disabled: bool, loading: bool,
    focus_id: s32) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    active_tree.submitted[index].disabled = disabled
    active_tree.submitted[index].loading = loading
    active_tree.submitted[index].focus_id = focus_id
    active_tree.submitted[index].interactive = true
}

#program_export
TreeSetSelected :: (index: s32, selected: bool) {
    if !active_tree.building || index < 0 ||
        index >= active_tree.submitted_count { return }
    active_tree.submitted[index].selected = selected
}

#program_export
TreeFind :: (key: u64, parent_key: u64, kind: s32) -> s32 {
    index: s32 = 0
    while index < active_tree.committed_count {
        entry: TreeEntry = active_tree.committed[index]
        if TreeSameIdentity(entry.key, entry.kind, entry.parent_key,
            key, kind, parent_key) { return index }
        index += 1
    }
    return -1
}
