
// Route arrays belong to the application. A slice supplies capacity; count
// identifies its occupied prefix. All writes stay in that prefix or clear its
// unused tail, so routing policy has no platform pointer or callback ABI.

#program_export
RouteCount :: (routes: []s32, count: s32) -> s32 {
    if count < 0 { return 0 }
    if count > (cast(s32)routes.count) { return (cast(s32)routes.count) }
    return count
}

#program_export
RouteContains :: (routes: []s32, count: s32,
    route: s32) -> bool {
    count = RouteCount(routes, count)
    index: s32 = 0
    while index < count {
        if routes[index] == route { return true }
        index += 1
    }
    return false
}

#program_export
RouteFirstUnused :: (routes: []s32, count: s32,
    candidates: []s32, fallback: s32) -> s32 {
    index: s32 = 0
    while index < (cast(s32)candidates.count) {
        if !RouteContains(routes, count, candidates[index]) {
            return candidates[index]
        }
        index += 1
    }
    return fallback
}

#program_export
RouteSanitizeSet :: (routes: []s32, count: s32,
    allowed: []s32, empty_route: s32) -> s32 {
    count = RouteCount(routes, count)
    read: s32 = 0
    write: s32 = 0
    while read < count {
        route: s32 = routes[read]
        if RouteContains(allowed, (cast(s32)allowed.count), route) &&
            !RouteContains(routes, write, route) {
            routes[write] = route
            write += 1
        }
        read += 1
    }
    read = write
    while read < (cast(s32)routes.count) {
        routes[read] = empty_route
        read += 1
    }
    return write
}

// The application may compute each mask entry with any predicate it owns.
#program_export
RouteSanitizeMask :: (routes: []s32, count: s32,
    allowed: []bool, empty_route: s32) -> s32 {
    count = RouteCount(routes, count)
    read: s32 = 0
    write: s32 = 0
    while read < count {
        route: s32 = routes[read]
        if read < (cast(s32)allowed.count) && allowed[read] &&
            !RouteContains(routes, write, route) {
            routes[write] = route
            write += 1
        }
        read += 1
    }
    read = write
    while read < (cast(s32)routes.count) {
        routes[read] = empty_route
        read += 1
    }
    return write
}

#program_export
RouteMove :: (routes: []s32, count: s32,
    from_index: s32, to_index: s32) -> bool {
    count = RouteCount(routes, count)
    if from_index < 0 || to_index < 0 ||
        from_index >= count || to_index >= count ||
        from_index == to_index { return false }
    route: s32 = routes[from_index]
    if from_index < to_index {
        index: s32 = from_index
        while index < to_index {
            routes[index] = routes[index + 1]
            index += 1
        }
    } else {
        index: s32 = from_index
        while index > to_index {
            routes[index] = routes[index - 1]
            index -= 1
        }
    }
    routes[to_index] = route
    return true
}

RouteStackStep :: struct {
    count: s32
    current: s32
    accepted: bool
}

#program_export
RouteStackCurrent :: (routes: []s32, count: s32,
    root_route: s32) -> s32 {
    count = RouteCount(routes, count)
    if count <= 0 { return root_route }
    return routes[count - 1]
}

#program_export
RouteStackInit :: (routes: []s32,
    root_route: s32) -> RouteStackStep {
    result: RouteStackStep
    result.current = root_route
    if (cast(s32)routes.count) > 0 {
        routes[0] = root_route
        result.count = 1
        result.accepted = true
    }
    return result
}

#program_export
RouteStackPush :: (routes: []s32, count: s32,
    root_route: s32, route: s32) -> RouteStackStep {
    result: RouteStackStep
    result.count = RouteCount(routes, count)
    result.current = RouteStackCurrent(routes, result.count, root_route)
    if (cast(s32)routes.count) <= 0 { return result }
    if result.count == 0 {
        routes[0] = root_route
        result.count = 1
    }
    if result.current == route {
        result.accepted = true
        return result
    }
    if result.count >= (cast(s32)routes.count) { return result }
    routes[result.count] = route
    result.count += 1
    result.current = route
    result.accepted = true
    return result
}

#program_export
RouteStackPop :: (routes: []s32, count: s32,
    root_route: s32) -> RouteStackStep {
    result: RouteStackStep
    result.count = RouteCount(routes, count)
    if result.count > 1 {
        result.count -= 1
        result.accepted = true
    }
    result.current = RouteStackCurrent(routes, result.count, root_route)
    return result
}

#program_export
RouteStackReset :: (routes: []s32,
    root_route: s32) -> RouteStackStep {
    return RouteStackInit(routes, root_route)
}
