#import "kryon.h"
#import "file_dialog.h"
#import "stdio.h"

app "Kryon File Dialog Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    dlg: FileDialog = {0}
    status: [256] char = "Choose an action."
    last_path: [512] char = ""
    dlg_ready: int = 0
}

screen FileDialogExample(viewport: Rectangle) {
    WidgetBackground(GetThemeBackground())
    if dlg_ready == 0 {
        InitFileDialog(&dlg)
        dlg_ready = 1
    }
    WidgetText("Kryon File Dialog", ScaleUIPx(32), ScaleUIPx(28), UI_TEXT_24, GetThemeText())
    WidgetText("Dialog backend and result state", ScaleUIPx(32), ScaleUIPx(66), UI_TEXT_16, GetThemeIcon())
    button "Open File" x: ScaleUIPx(32) y: ScaleUIPx(116) w: ScaleUIPx(180) h: ScaleUIPx(42) style: UI_BUTTON_STYLE_PRIMARY {
        BeginLoadFileDialog(&dlg,"Open File")
        snprintf(status,sizeof(status),"Open file requested.")
    }
    button "Save File" x: ScaleUIPx(226) y: ScaleUIPx(116) w: ScaleUIPx(180) h: ScaleUIPx(42) style: UI_BUTTON_STYLE_SECONDARY {
        BeginSaveFileDialog(&dlg,"Save File","untitled.kry")
        snprintf(status,sizeof(status),"Save file requested.")
    }
    button "Select Folder" x: ScaleUIPx(420) y: ScaleUIPx(116) w: ScaleUIPx(180) h: ScaleUIPx(42) style: UI_BUTTON_STYLE_SECONDARY {
        BeginSelectFileDialogFolder(&dlg,"Select Folder")
        snprintf(status,sizeof(status),"Folder selection requested.")
    }
    dialog_result: int = UpdateFileDialog(&dlg)
    if dialog_result == 1 {
        snprintf(last_path,sizeof(last_path),"%s",GetFileDialogPath(&dlg))
        snprintf(status,sizeof(status),"Selected: %s",last_path)
    }
    if dialog_result < 0 {
        snprintf(status,sizeof(status),"Dialog cancelled.")
    }
    WidgetText("Status", ScaleUIPx(32), ScaleUIPx(210), 18, GetThemeText())
    WidgetText(status, ScaleUIPx(32), ScaleUIPx(242), UI_TEXT_16, GetThemeText())
    WidgetText(last_path, ScaleUIPx(32), ScaleUIPx(274), UI_TEXT_16, GetThemeIcon())
}
