#import "geometry"

// Each control owns one value. Applications compose any number of controls
// with their own arrays and SliderCellBoundsFor; no C pointer crosses the API.
SliderProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    label: string
    semantic_label: string
    value: float32
    min: float32
    max: float32
    disabled: bool
    vertical: bool
    class_name: s32
}

DiscreteSliderProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    label: string
    semantic_label: string
    value: s32
    min: s32
    max: s32
    disabled: bool
    vertical: bool
    class_name: s32
}
