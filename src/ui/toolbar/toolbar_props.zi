Dropdown :: #import "dropdown";
Image :: #import "image";
#import "drawing_props"

IconRowItem :: struct {
    icon: Texture2D
    disabled: bool
}

BottomIconRowProps :: struct {
    center_x: s32
    view_width: s32
    view_height: s32
    count: s32
    items: *IconRowItem
}

IconRowResult :: struct {
    clicked_index: s32
    y: s32
    button_width: s32
}

ToolbarAction :: struct {
    key: u64
    label: string
    image: Image.Props
    disabled: bool
}

Props :: struct {
    key: u64
    id: s32
    class_name: s32
    x: s32
    y: s32
    width: s32
    height: s32
    scale: float32
    draw_menu: bool
    dropdown: Dropdown.Props
    dropdown_min_width: s32
    dropdown_max_width: s32
    dropdown_height: s32
}

ToolbarResult :: struct {
    node: s32
    dropdown: Dropdown.Result
    selected_menu_item: s32
    clicked_action: s32
}
