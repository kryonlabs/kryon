#module "input_capture_host"
#import "ui_internal.h"
#import "ui_popup_input_internal.h"
#import "ui/clip.h"
#import "ui/scroll.h"
#import "runtime/input.h"

InputCapture :: struct {
    bounds: Rectangle
    allow_inside: i32
}

InputClipScopeState :: struct {
    clips: [16]Rectangle
    count: i32
    scroll_depth: i32
}

g_ui_input_capture_stack :: [16]InputCapture #global #export
g_ui_input_capture_stack_count :: i32 #global #export
g_ui_input_clip_stack :: [16]Rectangle #global #export
g_ui_input_clip_stack_count :: i32 #global #export
g_ui_release_consumed :: i32 #global #export
g_ui_pointer_start_x :: i32 #global #export
g_ui_pointer_start_y :: i32 #global #export
g_ui_pointer_start_world :: Vector2 #global #export
g_ui_pointer_down :: i32 #global #export
g_ui_pointer_dragged_this_click :: i32 #global #export
g_ui_modal_capture_next_frame_bounds :: Rectangle #global
g_ui_modal_capture_next_frame :: i32 #global

ui_primary_pointer_screen :: () -> Vector2 #extern
ui_primary_pointer_press_screen :: () -> Vector2 #extern
ui_pointer_world_at :: (screen: Vector2) -> Vector2 #extern

ui_pointer_dx :: () -> i32 {
    pointer: Vector2 = ui_primary_pointer_screen()
    return (int)pointer.x - g_ui_pointer_start_x
}

ui_pointer_dy :: () -> i32 {
    pointer: Vector2 = ui_primary_pointer_screen()
    return (int)pointer.y - g_ui_pointer_start_y
}

ui_pointer_drag_is_horizontal :: () -> i32 #export {
    return InputPointerDragIsHorizontal(ui_pointer_dx(), ui_pointer_dy())
}

ui_pointer_dragged_this_click :: () -> i32 #export {
    return g_ui_pointer_dragged_this_click
}

ui_update_pointer_gesture :: () #export {
    pointer: Vector2 = ui_primary_pointer_screen()
    mx: i32 = (int)pointer.x
    my: i32 = (int)pointer.y
    drag_threshold: i32 = InputPointerDragThresholdFor(
    (float)Scale(1000) / 1000.0)
    if ui_primary_pointer_pressed() {
        g_ui_pointer_down = 1
        g_ui_pointer_dragging = 0
        g_ui_pointer_dragged_this_click = 0
        g_ui_scroll_gesture_pending = 0
        g_ui_release_consumed = 0
        g_ui_pointer_owner = POINTER_OWNER_NONE
        press: Vector2 = ui_primary_pointer_press_screen()
        g_ui_pointer_start_x = (int)press.x
        g_ui_pointer_start_y = (int)press.y
        g_ui_pointer_start_world = ui_pointer_world_at(press)
        if ui_primary_pointer_released() &&
        InputPointerDragShouldStart(mx - g_ui_pointer_start_x,
        my - g_ui_pointer_start_y, drag_threshold) {
            g_ui_pointer_dragged_this_click = 1
        }
    } else if ui_primary_pointer_down() && g_ui_pointer_down {
        if InputPointerDragShouldStart(ui_pointer_dx(),
        ui_pointer_dy(), drag_threshold) {
            g_ui_pointer_dragging = 1
            g_ui_pointer_dragged_this_click = 1
        }
    } else if ui_primary_pointer_released() {
        if !g_ui_pointer_down {
            g_ui_pointer_start_x = (-2147483647 - 1)
            g_ui_pointer_start_y = (-2147483647 - 1)
        }
        g_ui_pointer_down = 0
        g_ui_pointer_dragging = 0
        g_ui_scroll_gesture_pending = 0
        g_ui_pointer_owner = POINTER_OWNER_NONE
    } else if !ui_primary_pointer_down() {
        g_ui_pointer_down = 0
        g_ui_pointer_dragging = 0
        g_ui_pointer_dragged_this_click = 0
        g_ui_scroll_gesture_pending = 0
        g_ui_release_consumed = 0
        g_ui_pointer_owner = POINTER_OWNER_NONE
        g_ui_pointer_start_x = (-2147483647 - 1)
        g_ui_pointer_start_y = (-2147483647 - 1)
    }
}

ClearInputCaptures :: () #export {
    g_ui_input_capture_stack_count = 0
}

PushInputCapture :: (bounds: Rectangle, allow_inside: i32) #export {
    if g_ui_input_capture_stack_count >= 16 { return }
    g_ui_input_capture_stack[g_ui_input_capture_stack_count] =
    (InputCapture){bounds, allow_inside != 0}
    g_ui_input_capture_stack_count += 1
}

PopInputCapture :: () #export {
    if g_ui_input_capture_stack_count > 0 {
        g_ui_input_capture_stack_count -= 1
    }
}

BeginModalLayer :: () #export {
    ClearInputCaptures()
    PushInputCapture((Rectangle){0.0, 0.0,
        (float)ui_view_width, (float)ui_view_height}, 0)
}

SetModalCapture :: (bounds: Rectangle) #export {
    ClearInputCaptures()
    PushInputCapture(bounds, 1)
    g_ui_modal_capture_next_frame_bounds = bounds
    g_ui_modal_capture_next_frame = 1
}

ui_begin_input_capture_frame :: (text_context_open: i32) #export {
    ClearInputCaptures()
    if g_ui_modal_capture_next_frame {
        PushInputCapture(g_ui_modal_capture_next_frame_bounds, 1)
        g_ui_modal_capture_next_frame = 0
    }
    if text_context_open {
        PushInputCapture((Rectangle){0.0, 0.0,
            (float)ui_view_width, (float)ui_view_height}, 0)
    }
    g_ui_input_clip_stack_count = 0
    scroll_scope_depth = 0
}

ui_input_clip_suspend :: () -> InputClipScopeState #export {
    scope: InputClipScopeState = (InputClipScopeState){0}
    scope.count = g_ui_input_clip_stack_count
    scope.scroll_depth = scroll_scope_depth
    index: i32 = 0
    while index < scope.count {
        scope.clips[index] = g_ui_input_clip_stack[index]
        index += 1
    }
    g_ui_input_clip_stack_count = 0
    scroll_scope_depth = 0
    return scope
}

ui_input_clip_resume :: (scope: InputClipScopeState) #export {
    if scope.count < 0 || scope.count > 16 ||
    scope.scroll_depth < 0 || g_ui_input_clip_stack_count != 0 ||
    scroll_scope_depth != 0 { abort() }
    index: i32 = 0
    while index < scope.count {
        g_ui_input_clip_stack[index] = scope.clips[index]
        index += 1
    }
    g_ui_input_clip_stack_count = scope.count
    scroll_scope_depth = scope.scroll_depth
}

ui_current_input_clip :: (bounds: *Rectangle) -> i32 #export {
    if g_ui_input_clip_stack_count <= 0 { return 0 }
    *bounds = g_ui_input_clip_stack[g_ui_input_clip_stack_count - 1]
    return 1
}

PushInputClip :: (bounds: Rectangle) #export {
    if g_ui_input_clip_stack_count > 0 {
        bounds = GetClipIntersection(g_ui_input_clip_stack[
        g_ui_input_clip_stack_count - 1], bounds)
    }
    if g_ui_input_clip_stack_count < 16 {
        g_ui_input_clip_stack[g_ui_input_clip_stack_count] = bounds
        g_ui_input_clip_stack_count += 1
    }
}

PopInputClip :: () #export {
    if g_ui_input_clip_stack_count > 0 {
        g_ui_input_clip_stack_count -= 1
    }
}

ui_base_input_captures_click :: (point: Vector2,
include_pointer_drag: i32) -> i32 #export {
    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) &&
    g_ui_release_consumed != 0 { return 1 }
    clip: Rectangle = (Rectangle){0}
    if ui_current_input_clip(&clip) &&
    !CheckCollisionPointRec(point, clip) { return 1 }
    if g_ui_input_capture_stack_count > 0 {
        capture: InputCapture = g_ui_input_capture_stack[
        g_ui_input_capture_stack_count - 1]
        if !capture.allow_inside ||
        !CheckCollisionPointRec(point, capture.bounds) { return 1 }
    }
    return (include_pointer_drag && g_ui_pointer_dragging) ||
    (include_pointer_drag &&
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) &&
    ui_pointer_dragged_this_click())
}

ui_input_captures_click_internal :: (point: Vector2,
include_pointer_drag: i32) -> i32 #export {
    return ui_base_input_captures_click(point, include_pointer_drag) ||
    ui_popup_input_current_captures(point) || dropdown_captures(point)
}

ui_input_captures_snapshot :: (point: Vector2,
snapshot: PopupInputToken) -> i32 #export {
    return ContentDisabled() || InspectInputCapturesClick(point) ||
    ui_base_input_captures_click(point, 1) ||
    dropdown_captures(point) ||
    ui_popup_input_snapshot_captures(snapshot, point)
}

InputCapturesClick :: (point: Vector2) -> i32 #export {
    return ui_input_captures_snapshot(point, ui_popup_input_snapshot())
}

ReleaseConsumed :: () -> i32 #export {
    return g_ui_release_consumed
}

ConsumeRelease :: () #export {
    if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) {
        g_ui_release_consumed = 1
    }
}

press_started_inside :: (bounds: Rectangle) -> i32 #export {
    if g_ui_pointer_start_x == (-2147483647 - 1) &&
    g_ui_pointer_start_y == (-2147483647 - 1) { return 1 }
    return CheckCollisionPointRec(g_ui_pointer_start_world, bounds)
}

press_started_inside_circle :: (center: Vector2,
radius: float) -> i32 {
    if g_ui_pointer_start_x == (-2147483647 - 1) &&
    g_ui_pointer_start_y == (-2147483647 - 1) { return 1 }
    dx: float = g_ui_pointer_start_world.x - center.x
    dy: float = g_ui_pointer_start_world.y - center.y
    return dx * dx + dy * dy <= radius * radius
}

HandleClick :: (bounds: Rectangle, disabled: i32,
hover: *i32) -> i32 #export {
    mouse_world: Vector2 = ui_mouse_world()
    interaction: InputPointerInteraction = InputPointerInteractionFor(
    CheckCollisionPointRec(mouse_world, bounds) != 0,
    InputCapturesClick(mouse_world) != 0, disabled != 0,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    g_ui_release_consumed != 0, press_started_inside(bounds) != 0)
    if hover != nil { *hover = interaction.hovered }
    if interaction.disabled_marker { MarkDisabled() }
    if interaction.active { MarkClickable() }
    if interaction.consume_release { ConsumeRelease() }
    return interaction.activated
}

ReadActivation :: (bounds: Rectangle, id: i32,
enabled: bool) -> Activation #export {
    input: Activation = (Activation){0}
    hovered: i32 = 0
    accessibility: i32 = ui_accessibility_take_activation(id)
    input.activated = HandleClick(bounds, !enabled, &hovered)
    input.hovered = hovered
    input.focused = enabled && id > 0 && RegisterFocus(id, bounds)
    keyboard: i32 = IsFocusActivatePressed(id)
    input.pressed = (hovered && IsMouseButtonDown(MOUSE_BUTTON_LEFT)) ||
    (input.focused && keyboard)
    input.activated = input.activated || keyboard ||
    (enabled && accessibility)
    input.pressed = input.pressed || (enabled && accessibility)
    return input
}

HandleCircleClick :: (center: Vector2, radius: float,
disabled: i32, hover: *i32) -> i32 #export {
    mouse_world: Vector2 = ui_mouse_world()
    dx: float = mouse_world.x - center.x
    dy: float = mouse_world.y - center.y
    interaction: InputPointerInteraction = InputPointerInteractionFor(
    dx * dx + dy * dy <= radius * radius,
    InputCapturesClick(mouse_world) != 0, disabled != 0,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    g_ui_release_consumed != 0,
    press_started_inside_circle(center, radius) != 0)
    if hover != nil { *hover = interaction.hovered }
    if interaction.disabled_marker { MarkDisabled() }
    if interaction.active { MarkClickable() }
    if interaction.consume_release { ConsumeRelease() }
    return interaction.activated
}
