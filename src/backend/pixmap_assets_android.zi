// Optional Android picture services. Pictures the application ships load
// from its APK assets on first use; it can also supply bytes from downloads
// or a user file. The host owns each decoded cache entry.
#import "android_image_decode"
Images :: #import "android_bundle_images";
#import "ziran_image_decode"
#import "image_reduce"
#import "android_host_cleanup"
#import "pixmap_image_owner"
#import "pixmap"
#import "app_asset"
#import "paint_queue"
#import "std/byte_text_linux"

AndroidPictureBudget :: 268435456;
android_picture_pixels: [1024]*u8;
android_picture_sizes: [1024]s64;
android_picture_bytes: s64;
android_picture_ready: bool;
android_picture_shipped: [1024]bool;
android_picture_failed: [1024]bool;

// Embedded bundle bytes are borrowed only during the current load/prepare.
// Empty results fall back to APK assets and ordinary files.
AndroidPictureAssetRead :: #type (path: string) -> string;
android_picture_asset_read: AndroidPictureAssetRead;

#program_export
AndroidPicturesUseAssets :: (read: AndroidPictureAssetRead) {
    android_picture_asset_read = read
    PixmapImageSourceRetry()
}

AndroidPictureRead :: (path: string, owned: *bool) -> string {
    owned.* = false
    if android_picture_asset_read != null {
        data := android_picture_asset_read(path)
        if data.count > 0 { return data }
    }
    owned.* = true
    return ReadAppAsset(path)
}

AndroidPictureReplacing :: (slot: s32, next: *u32) {
    android_picture_shipped[slot] = false; android_picture_failed[slot] = false
    previous := android_picture_pixels[slot]
    if previous == null || previous == cast(*u8)next { return }
    ImagePixelsFree(previous)
    android_picture_pixels[slot] = null
    android_picture_bytes -= android_picture_sizes[slot]
    android_picture_sizes[slot] = 0
}
AndroidPicturesClose :: () {
    PixmapImageSourceRetry()
    for slot: cast(s32)0..1023 {
        if android_picture_pixels[slot] != null || android_picture_shipped[slot] { PixmapClearImage(slot) }
    }
}
AndroidPicturesUse :: () {
    if android_picture_ready { return }
    PixmapImageOwnerUse(AndroidPictureReplacing)
    PixmapImagePrepareUse(AndroidPicturePrepare)
    AndroidImagesCleanupUse(AndroidPicturesClose)
    android_picture_ready = true
}
// Layout probes headers only. First draw decodes and caches the requested
// resolution; later larger draws upgrade once, smaller draws reuse it.
AndroidPictureLoad :: (path: string) -> bool {
    owned: bool
    data := AndroidPictureRead(path, *owned)
    if data.count == 0 { return false }
    defer { if owned { FreeAppAsset(data) } }
    AndroidPicturesUse()
    size := AndroidImageEncodedSize(data)
    slot: s32 = -1
    for candidate: cast(s32)0..1023 {
        if pixmap_image_lengths[candidate] == 0 { slot = candidate; break }
    }
    loaded: bool
    if slot >= 0 && AndroidImageSizeAllowed(size) {
        loaded = PixmapSetImageInfo(slot, path, cast(s32)size.width, cast(s32)size.height)
    } else { loaded = PixmapLoadImageBytes(path, data, "") }
    slot = PixmapImageIndex(path)
    if loaded && slot >= 0 { android_picture_shipped[slot] = true }
    return loaded
}
android_picture_source: bool = PixmapImageSourceUse(AndroidPictureLoad);

AndroidPicturePrepare :: (slot: s32, width: s32, height: s32) -> bool {
    if !android_picture_shipped[slot] { return true }
    if pixmap_image_widths[slot] >= width && pixmap_image_heights[slot] >= height { return true }
    if android_picture_failed[slot] { return android_picture_pixels[slot] != null }
    // Growing one axis must retain the detail already loaded for the other.
    if width < pixmap_image_widths[slot] { width = pixmap_image_widths[slot] }
    if height < pixmap_image_heights[slot] { height = pixmap_image_heights[slot] }
    name: [256]u8
    length := pixmap_image_lengths[slot]
    for at: cast(s32)0..length - 1 { name[at] = pixmap_image_paths[slot][at] }
    path := TextView(name[0:length])
    owned: bool
    data := AndroidPictureRead(path, *owned)
    loaded := AndroidPictureInstall(path, data, "", width, height)
    if owned { FreeAppAsset(data) }
    android_picture_shipped[slot] = true
    android_picture_failed[slot] = !loaded
    return loaded || android_picture_pixels[slot] != null
}

#program_export
PixmapLoadImageBytes :: (path: string, data: string, file_type: string) -> bool {
    return AndroidPictureInstall(path, data, file_type, 0, 0)
}
AndroidPictureInstall :: (path: string, data: string, file_type: string, width: s32, height: s32) -> bool {
    if path.count <= 0 || path.count >= 256 { return false }
    for byte: path { if byte == cast(u8)0 { return false } }
    AndroidPicturesUse()
    slot := PixmapImageIndex(path)
    if slot < 0 {
        for candidate: cast(s32)0..1023 {
            if pixmap_image_lengths[candidate] == 0 { slot = candidate; break }
        }
    }
    if slot < 0 { return false }
    natural := AndroidImageEncodedSize(data)
    image := AndroidImageDecodeEncoded(data, file_type, false, true, width, height)
    if image.pixels == null { return false }
    natural_width := image.width; natural_height := image.height
    if AndroidImageSizeAllowed(natural) {
        natural_width = cast(s32)natural.width; natural_height = cast(s32)natural.height
    }
    image = ReduceDecodedImage(image, width, height)
    size := cast(s64)image.width * image.height * 4
    if image.width > 16384 || image.height > 16384 ||
        android_picture_bytes - android_picture_sizes[slot] + size > AndroidPictureBudget {
        DecodedImageFree(image); return false
    }
    words := cast(*u32)image.pixels
    for at: cast(s32)0..image.width * image.height - 1 {
        pixel := at * 4
        color := (cast(u32)image.pixels[pixel + 3] << 24) | (cast(u32)image.pixels[pixel] << 16) |
            (cast(u32)image.pixels[pixel + 1] << 8) | cast(u32)image.pixels[pixel + 2]
        words[at] = color
    }
    if !PixmapSetImageStorage(slot, path, image.width, image.height, natural_width, natural_height, Images.AndroidImageWords(words, size / 4)) {
        DecodedImageFree(image); return false
    }
    android_picture_pixels[slot] = image.pixels
    android_picture_sizes[slot] = size; android_picture_bytes += size
    PaintResourcesChanged()
    return true
}

#program_export
RasterInvalidateImage :: (path: string) -> bool {
    PixmapImageSourceRetry()
    slot := PixmapImageIndex(path)
    if slot < 0 { return false }
    PixmapClearImage(slot)
    PaintResourcesChanged()
    return true
}
#program_export
RasterInvalidateImagesIn :: (folder: string) -> s32 {
    if folder.count == 0 { return 0 }
    PixmapImageSourceRetry()
    while folder.count > 1 && folder[folder.count - 1] == cast(u8)47 { folder = folder[0:folder.count - 1] }
    removed: s32
    for slot: cast(s32)0..1023 {
        count := pixmap_image_lengths[slot]
        if count < folder.count { continue }
        path := TextView(pixmap_image_paths[slot][0:count])
        if path[0:folder.count] != folder { continue }
        if path.count != folder.count && folder != "/" && path[folder.count] != cast(u8)47 { continue }
        PixmapClearImage(slot); removed += 1
    }
    if removed > 0 { PaintResourcesChanged() }
    return removed
}
#program_export
RasterInvalidateImages :: () -> s32 {
    PixmapImageSourceRetry()
    removed: s32
    for slot: cast(s32)0..1023 {
        if pixmap_image_lengths[slot] > 0 { PixmapClearImage(slot); removed += 1 }
    }
    if removed > 0 { PaintResourcesChanged() }
    return removed
}
#program_export
ImagePreviewDecode :: (data: string, file_type: string, width: *s32, height: *s32,
    channels: *s32, upright: *bool) -> *u8 {
    width.* = 0; height.* = 0; channels.* = 0; upright.* = true
    image := AndroidImageDecodeEncoded(data, file_type)
    if image.pixels == null { return null }
    width.* = image.width; height.* = image.height; channels.* = 4
    return image.pixels
}
#program_export
ImagePreviewRelease :: (pixels: *u8) { ImagePixelsFree(pixels) }
