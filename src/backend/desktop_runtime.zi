#import "byte_text_linux"
#import "c_string"
#import "cairo_raster"
#import "desktop_keys"
#import "geometry"
#import "tree_input"
#import "utf8"

sdl_library :: #system_library "SDL2";
GetEnvironment :: (name: *u8) -> *u8 #foreign sdl_library "SDL_getenv";

// SDL_Event is 56 bytes on the supported SDL2 ABI. SDL_MouseButtonEvent's
// button byte is at offset 16; the remaining union storage is opaque.
Event :: struct {
    kind: u32
    timestamp: u32
    window_id: u32
    which: u32
    button: u8
    state: u8
    clicks: u8
    padding: u8
    x: s32
    y: s32
    payload: [28]u8
}
Init :: (flags: u32) -> s32 #foreign sdl_library "SDL_Init";
Quit :: () #foreign sdl_library "SDL_Quit";
CreateWindow :: (title: *u8, x: s32, y: s32, width: s32,
    height: s32, flags: u32) -> *void #foreign sdl_library "SDL_CreateWindow";
DestroyWindow :: (window: *void) #foreign sdl_library "SDL_DestroyWindow";
SetWindowSize :: (window: *void, width: s32, height: s32) #foreign sdl_library "SDL_SetWindowSize";
SetWindowPosition :: (window: *void, x: s32, y: s32) #foreign sdl_library "SDL_SetWindowPosition";
GetWindowID :: (window: *void) -> u32 #foreign sdl_library "SDL_GetWindowID";
GetWindowSize :: (window: *void, width: *s32, height: *s32) #foreign sdl_library "SDL_GetWindowSize";
CreateRenderer :: (window: *void, index: s32, flags: u32) -> *void #foreign sdl_library "SDL_CreateRenderer";
DestroyRenderer :: (renderer: *void) #foreign sdl_library "SDL_DestroyRenderer";
CreateTexture :: (renderer: *void, format: u32, access: s32,
    width: s32, height: s32) -> *void #foreign sdl_library "SDL_CreateTexture";
DestroyTexture :: (texture: *void) #foreign sdl_library "SDL_DestroyTexture";
UpdateTexture :: (texture: *void, rect: *void, pixels: *u8,
    pitch: s32) -> s32 #foreign sdl_library "SDL_UpdateTexture";
RenderCopy :: (renderer: *void, texture: *void, source: *void,
    destination: *void) -> s32 #foreign sdl_library "SDL_RenderCopy";
RenderPresent :: (renderer: *void) #foreign sdl_library "SDL_RenderPresent";
PollEvent :: (event: *Event) -> s32 #foreign sdl_library "SDL_PollEvent";
PushEvent :: (event: *Event) -> s32 #foreign sdl_library "SDL_PushEvent";
StartTextInput :: () #foreign sdl_library "SDL_StartTextInput";
StopTextInput :: () #foreign sdl_library "SDL_StopTextInput";
GetMouseState :: (x: *s32, y: *s32) -> u32 #foreign sdl_library "SDL_GetMouseState";
GetModState :: () -> u32 #foreign sdl_library "SDL_GetModState";
Delay :: (milliseconds: u32) #foreign sdl_library "SDL_Delay";
ShowWindow :: (window: *void) #foreign sdl_library "SDL_ShowWindow";
HideWindow :: (window: *void) #foreign sdl_library "SDL_HideWindow";
RaiseWindow :: (window: *void) #foreign sdl_library "SDL_RaiseWindow";
GetWindowFlags :: (window: *void) -> u32 #foreign sdl_library "SDL_GetWindowFlags";
SetHint :: (name: *u8, value: *u8) -> s32 #foreign sdl_library "SDL_SetHint";
GetClipboardText :: () -> *u8 #foreign sdl_library "SDL_GetClipboardText";
SetClipboardText :: (text: *u8) -> s32 #foreign sdl_library "SDL_SetClipboardText";
FreeSdlMemory :: (memory: *void) #foreign sdl_library "SDL_free";

window: *void;
renderer: *void;
texture: *void;
pointer: PointerFrame;
secondary: SecondaryPointerFrame;
desktop_wheel: float32;
desktop_key: s32;
// SDL modifier state recorded with the last key press, or -1 without one.
desktop_key_modifiers: s32 = -1;
desktop_codepoints: [32]s32;
desktop_codepoint_count: s32;
desktop_codepoint_next: s32;
desktop_intercept_close: bool;
desktop_close_requested: bool;
desktop_quit: bool;
desktop_width: s32;
desktop_height: s32;
// A size ResizeDesktop asked for, applied when the next frame begins.
desktop_next_width: s32;
desktop_next_height: s32;

// SDL_PIXELFORMAT_ARGB8888, which matches Cairo's image surface.
DESKTOP_PIXEL_FORMAT :: 0x16362004

#program_export
OpenDesktop :: () -> bool {
    return OpenDesktopSized(960, 600)
}

// Opens the window with a drawing area of `width` by `height` pixels.
#program_export
OpenDesktopSized :: (width: s32, height: s32) -> bool {
    if width <= 0 || height <= 0 { return false }
    if size_of(Event) != 56 { return false }
    if Init(cast(u32)0x20) != 0 { return false }
    title: [32]u8
    if !CopyCString("Kryon Ziran", title[:]) { return false }
    window = CreateWindow(*title[0], cast(s32)0x2fff0000,
        cast(s32)0x2fff0000, width, height, cast(u32)0x20)
    if window == null { return false }
    renderer = CreateRenderer(window, -1, cast(u32)1)
    if renderer == null { return false }
    texture = CreateTexture(renderer, cast(u32)DESKTOP_PIXEL_FORMAT, 1, width,
        height)
    if texture == null { return false }
    desktop_width = width
    desktop_height = height
    StartTextInput()
    return OpenRaster(width, height)
}

// The drawing area of the window, in pixels.
#program_export
DesktopViewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0, cast(float32)desktop_width,
        cast(float32)desktop_height}
}

// Asks for a new window size. A frame in progress keeps drawing at the old
// size; the next BeginDesktopFrame resizes the window and its surface, and
// DesktopViewport then reports the new size. If the new surface cannot be
// made, the window keeps its size.
#program_export
ResizeDesktop :: (width: s32, height: s32) -> bool {
    if window == null || width <= 0 || height <= 0 { return false }
    desktop_next_width = width
    desktop_next_height = height
    return true
}

// Centers the window this desktop host created on its current display.
#program_export
CenterDesktop :: () -> bool {
    if window == null { return false }
    SetWindowPosition(window, cast(s32)0x2fff0000, cast(s32)0x2fff0000)
    return true
}

DesktopApplyResize :: () -> bool {
    width := desktop_next_width
    height := desktop_next_height
    desktop_next_width = 0
    desktop_next_height = 0
    if width <= 0 || (width == desktop_width && height == desktop_height) {
        return true
    }
    next: *void = CreateTexture(renderer, cast(u32)DESKTOP_PIXEL_FORMAT, 1, width,
        height)
    if next == null { return false }
    CloseRaster()
    if !OpenRaster(width, height) {
        DestroyTexture(next)
        // Go back to the old size, which opened before.
        CloseRaster()
        unused OpenRaster(desktop_width, desktop_height)
        return false
    }
    DestroyTexture(texture)
    texture = next
    SetWindowSize(window, width, height)
    desktop_width = width
    desktop_height = height
    return true
}

#program_export
CloseDesktop :: () {
    StopTextInput()
    CloseRaster()
    if texture != null { DestroyTexture(texture) }
    if renderer != null { DestroyRenderer(renderer) }
    if window != null { DestroyWindow(window) }
    Quit()
}

#program_export
SetPointerFrame :: (x: float32, y: float32, down: bool,
    pressed: bool, released: bool) {
    pointer.x = x
    pointer.y = y
    pointer.down = down
    pointer.pressed = pressed
    pointer.released = released
}

#program_export
PollDesktop :: () -> bool {
    event: Event
    pressed: bool = false
    released: bool = false
    right_pressed: bool = false
    right_released: bool = false
    desktop_wheel = 0.0
    desktop_key = 0
    desktop_key_modifiers = -1
    desktop_codepoint_count = 0
    desktop_codepoint_next = 0
    while PollEvent(*event) != 0 {
        // SDL_WINDOWEVENT_RESIZED / SIZE_CHANGED. Resize only our SDL window;
        // its drawing surface follows the window manager at the next frame.
        if event.kind == cast(u32)0x200 && window != null &&
            event.window_id == GetWindowID(window) &&
            ((event.which & cast(u32)255) == cast(u32)5 ||
             (event.which & cast(u32)255) == cast(u32)6) {
            width: s32
            height: s32
            GetWindowSize(window, *width, *height)
            unused ResizeDesktop(width, height)
        }
        // SDL_QUIT comes from the last window closing or from the session
        // ending (SIGTERM, logout); it always quits.
        if event.kind == cast(u32)0x100 { return false }
        // SDL_WINDOWEVENT_CLOSE; SDL_WindowEvent.event is the byte at
        // offset 12, the low byte of Event.which here.
        if event.kind == cast(u32)0x200 &&
            (event.which & cast(u32)255) == cast(u32)14 {
            if !desktop_intercept_close { return false }
            desktop_close_requested = true
        }
        if event.kind == cast(u32)0x300 {
            // SDL_KeyboardEvent.keysym.sym occupies byte offset 20 and
            // keysym.mod the low 16 bits at offset 24.
            desktop_key = DesktopKey(event.x)
            desktop_key_modifiers = event.y & 65535
        }
        if event.kind == cast(u32)0x303 {
            // SDL_TextInputEvent.text is a NUL-terminated UTF-8 array at
            // offset 12 in SDL_Event. The event storage lives through Decode.
            bytes: []u8 = BytesFromPointer(cast(*u8)(*event), cast(u64)56)
            end: s32 = 12
            while end < 44 && bytes[end] != cast(u8)0 { end += 1 }
            if end > 12 {
                value: string = TextFromBytes(bytes[12:end])
                at: s32 = 0
                while at < cast(s32)value.count {
                    decoded: Decoded = Decode(value, at)
                    if desktop_codepoint_count < 32 {
                        desktop_codepoints[desktop_codepoint_count] =
                            cast(s32)decoded.value
                        desktop_codepoint_count += 1
                    }
                    at = decoded.after
                }
            }
        }
        if event.kind == cast(u32)0x403 {
            // SDL_MouseWheelEvent.y occupies byte offset 20 in the event
            // union, which is Event.x in the button-event layout above.
            step: float32 = cast(float32)event.x
            // SDL_MOUSEWHEEL_FLIPPED occupies byte offset 24.
            if event.y == 1 { step = -step }
            desktop_wheel += step
        }
        if event.button == cast(u8)1 {
            if event.kind == cast(u32)0x401 { pressed = true }
            if event.kind == cast(u32)0x402 { released = true }
        }
        // SDL_BUTTON_RIGHT
        if event.button == cast(u8)3 {
            if event.kind == cast(u32)0x401 { right_pressed = true }
            if event.kind == cast(u32)0x402 { right_released = true }
        }
    }
    x: s32 = 0
    y: s32 = 0
    buttons: u32 = GetMouseState(*x, *y)
    down: bool = (buttons & cast(u32)1) != cast(u32)0
    // A press and release inside one poll (a tap) still counts as held for
    // this sample, so the press reaches the widget under it.
    if pressed { down = true }
    SetPointerFrame(cast(float32)x, cast(float32)y, down,
        pressed, released)
    secondary.down = (buttons & cast(u32)4) != cast(u32)0
    secondary.pressed = right_pressed
    secondary.released = right_released
    return !desktop_quit
}

#program_export
DesktopWheelMove :: () -> float32 { return desktop_wheel }

#program_export
DesktopPressedKey :: () -> s32 {
    key: s32 = desktop_key
    desktop_key = 0
    return key
}

// The held modifier keys as KeyModifier bits (SDL's KMOD_SHIFT, KMOD_CTRL,
// and KMOD_ALT masks cover both left and right keys). A key pressed in this
// poll reports the modifiers held with it, even if they were released before
// the poll ended.
#program_export
DesktopModifiers :: () -> s32 {
    state: u32 = GetModState()
    if desktop_key_modifiers >= 0 { state = cast(u32)desktop_key_modifiers }
    modifiers: s32 = 0
    if (state & cast(u32)0x3) != cast(u32)0 { modifiers |= 1 }
    if (state & cast(u32)0xC0) != cast(u32)0 { modifiers |= 2 }
    if (state & cast(u32)0x300) != cast(u32)0 { modifiers |= 4 }
    return modifiers
}

#program_export
DesktopTypedCodepoint :: () -> s32 {
    if desktop_codepoint_next >= desktop_codepoint_count { return 0 }
    codepoint: s32 = desktop_codepoints[desktop_codepoint_next]
    desktop_codepoint_next += 1
    return codepoint
}

#program_export
CheckPointerEvents :: () -> bool {
    event: Event
    event.kind = cast(u32)0x401
    event.button = cast(u8)1
    if PushEvent(*event) != 1 || !PollDesktop() ||
        !pointer.pressed || pointer.released { return false }
    event.kind = cast(u32)0x402
    if PushEvent(*event) != 1 || !PollDesktop() ||
        pointer.pressed || !pointer.released { return false }
    return true
}

#program_export
BeginDesktopFrame :: () {
    unused DesktopApplyResize()
    BeginRasterFrame()
}

#program_export
EndDesktopFrame :: () -> bool {
    if !FinishRasterFrame() { return false }
    // A hidden window keeps running the app's frames without presenting.
    if !WindowVisibleHost() { return true }
    if UpdateTexture(texture, null, RasterSurfaceData(),
        RasterSurfaceStride()) != 0 { return false }
    if RenderCopy(renderer, texture, null, null) != 0 { return false }
    RenderPresent(renderer)
    return true
}

#program_export
PauseDesktop :: () {
    if WindowVisibleHost() {
        Delay(cast(u32)16)
    } else {
        Delay(cast(u32)100)
    }
}

// SDL_WINDOW_HIDDEN
#program_export
WindowVisibleHost :: () -> bool {
    if window == null { return false }
    return (GetWindowFlags(window) & cast(u32)0x8) == cast(u32)0
}

#program_export
WindowSetVisibleHost :: (visible: bool) {
    if window == null { return }
    if visible {
        ShowWindow(window)
        RaiseWindow(window)
    } else {
        HideWindow(window)
    }
}

#program_export
WindowInterceptCloseHost :: (enabled: bool) -> bool {
    // With interception on, closing the window must not also post SDL_QUIT,
    // which is reserved for the session ending.
    name: [48]u8
    value: [2]u8
    if !CopyCString("SDL_QUIT_ON_LAST_WINDOW_CLOSE", name[:]) { return false }
    if enabled {
        CopyCString("0", value[:])
    } else {
        CopyCString("1", value[:])
    }
    if SetHint(*name[0], *value[0]) == 0 { return false }
    desktop_intercept_close = enabled
    return true
}

#program_export
WindowTakeCloseRequestHost :: () -> bool {
    requested: bool = desktop_close_requested
    desktop_close_requested = false
    return requested
}

#program_export
WindowQuitHost :: () {
    desktop_quit = true
}

#program_export
PollPointer :: () -> PointerFrame { return pointer }

// The clipboard snapshot SystemClipboardOpenHost takes, and the text a write
// hands to SDL, which needs it NUL-terminated.
desktop_clipboard: [65536]u8;
desktop_clipboard_length: s32;

// Snapshots the text, cut on a whole character to fit.
#program_export
SystemClipboardOpenHost :: () -> s32 {
    desktop_clipboard_length = 0
    text: *u8 = GetClipboardText()
    if text == null { return -1 }
    length: s32 = 0
    while text[length] != cast(u8)0 && length < 65535 {
        desktop_clipboard[length] = text[length]
        length += 1
    }
    if text[length] != cast(u8)0 {
        while length > 0 && (cast(s32)desktop_clipboard[length - 1] & 192) == 128 { length -= 1 }
        if length > 0 && (cast(s32)desktop_clipboard[length - 1] & 192) == 192 { length -= 1 }
    }
    FreeSdlMemory(cast(*void)text)
    desktop_clipboard_length = length
    return length
}

#program_export
SystemClipboardByteHost :: (index: s32) -> s32 {
    if index < 0 || index >= desktop_clipboard_length { return -1 }
    return cast(s32)desktop_clipboard[index]
}

#program_export
SystemClipboardWriteHost :: (text: string) -> bool {
    length: s32 = cast(s32)text.count
    if length > 65535 { length = 65535 }
    index: s32 = 0
    while index < length {
        desktop_clipboard[index] = text[index]
        index += 1
    }
    desktop_clipboard[length] = cast(u8)0
    return SetClipboardText(*desktop_clipboard[0]) == 0
}

#program_export
PollSecondaryPointer :: () -> SecondaryPointerFrame { return secondary }
