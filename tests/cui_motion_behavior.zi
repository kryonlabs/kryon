#import "transition"
#import "widget_kind"
#import "menu"
#import "menu_props"
#import "tabs"
#import "tab_bar_props"
#import "navigation"
#import "navigation_bar_props"
#import "collapsible"
#import "collapsible_props"
#import "transition_widget"
#import "tree_draw"
#import "tree_input"
#import "tree"
#import "session"
#import "paint_queue"
#import "theme"
#import "cui_overlays_raster_host"
using FrameStatus;
using WidgetKind;
using MenuItemKind;

SpringBehavior :: () -> s32 {
    state: TransitionMotionState
    TransitionMotionBegin(*state, 0.0, false, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
    if TransitionMotionValue(*state, 0, 0.0, 0.28, 0.0) != 0.0 { return 1 }
    // A target change at time zero is active and never mistaken for initialization.
    TransitionMotionBegin(*state, 0.0, false, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
    if TransitionMotionValue(*state, 0, 1.0, 0.28, 0.0) != 0.0 || !state.active { return 2 }
    TransitionMotionBegin(*state, 0.05, false, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
    value := TransitionMotionValue(*state, 0, 1.0, 0.28, 0.0)
    if value <= 0.0 || value >= 1.0 { return 3 }
    velocity := state.channels[0].velocity
    TransitionMotionBegin(*state, 0.05, false, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
    if TransitionMotionValue(*state, 0, 0.0, 0.16, 0.0) != value || state.channels[0].velocity != velocity { return 4 }
    for frame: 1..120 {
        TransitionMotionBegin(*state, 0.05 + cast(float64)frame / 60.0, false, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
        unused TransitionMotionValue(*state, 0, 0.0, 0.16, 0.0)
    }
    if state.active || state.channels[0].value != 0.0 { return 5 }
    TransitionMotionBegin(*state, 3.0, true, 1, cast(u64)1, cast(u64)1, cast(u64)1, 1)
    if TransitionMotionValue(*state, 0, 1.0, 0.28, 0.0) != 1.0 || state.active { return 6 }
    TransitionMotionBegin(*state, 3.0, false, 1, cast(u64)2, cast(u64)1, cast(u64)1, 1)
    if TransitionMotionValue(*state, 0, 90.0, 0.42, 0.16) != 90.0 || state.active { return 7 }
    return 0
}
#import "geometry"
#import "drawing_props"

motion_session: Session;
menu_motion: TransitionMotionState;
tab_motion: TransitionMotionState;
nav_motion: TransitionMotionState;
collapse_motion: TransitionMotionState;
menu_state: MenuState;
menu_result: MenuResult;
tab_result: TabBarResult;
nav_result: NavigationBarResult;
collapse_result: CollapsibleResult;

MotionScene :: (frame: s32, reduced: bool, close: bool) -> s32 {
    if frame == 0 {
        if SessionValid(motion_session) { unused SessionClose(motion_session) }
        motion_session = SessionOpen()
        menu_motion = TransitionMotionState.{}; tab_motion = TransitionMotionState.{}
        nav_motion = TransitionMotionState.{}; collapse_motion = TransitionMotionState.{}
        MenuStateInit(*menu_state)
    }
    if !CuiOverlaysRasterBegin() { return 10 }
    BeginFrame(motion_session, cast(u64)9000, Rectangle.{0.0, 0.0, 480.0, 360.0})
    now := cast(float64)frame / 60.0
    tabs: [2]Tab
    tabs[0] = Tab.{.key = cast(u64)11, .label = "First"}
    tabs[1] = Tab.{.key = cast(u64)12, .label = "Second"}
    tab: TabBarProps
    tab.key = cast(u64)1; tab.bounds = Rectangle.{10.0, 10.0, 400.0, 44.0}
    tab.selected_index = ifx frame > 0 then 1 else 0
    tab.motion = *tab_motion; tab.now = now; tab.reduced_motion = reduced
    tab_result = TabBar(motion_session, tab, tabs[:])
    headers: [1]CollapsibleHeader
    collapse: CollapsibleProps
    collapse.key = cast(u64)2; collapse.bounds = Rectangle.{220.0, 80.0, 240.0, 180.0}
    collapse.label = "Details"; collapse.has_open = true; collapse.open = frame > 0 && !close
    collapse.motion = *collapse_motion; collapse.now = now; collapse.reduced_motion = reduced
    collapse_result = Collapsible(motion_session, collapse, headers[:0])
    if collapse_result.content.height > 0.0 {
        PaintRoundedFill(motion_session, collapse_result.node, collapse_result.content,
            4.0, 8, Color.{80, 140, 220, 255})
    }
    items: [2]NavigationBarItem
    items[0] = NavigationBarItem.{.key = cast(u64)21, .route = 1, .label = "Home", .active = frame == 0}
    items[1] = NavigationBarItem.{.key = cast(u64)22, .route = 2, .label = "Library", .active = frame > 0}
    nav: NavigationBarProps
    nav.key = cast(u64)3; nav.view_width = 480; nav.view_height = 360
    nav.motion = *nav_motion; nav.now = now; nav.reduced_motion = reduced
    nav_result = NavigationBar(motion_session, nav, items[:])
    commands: [2]MenuItem
    commands[0] = MenuItem.{.kind = cast(MenuItemKind)MenuCommand, .label = "Open", .id = 1}
    commands[1] = MenuItem.{.kind = cast(MenuItemKind)MenuCommand, .label = "Disabled", .id = 2, .disabled = true}
    groups: [1]MenuGroup
    groups[0] = MenuGroup.{.label = "File", .items = commands[:]}
    menu: MenuProps
    menu.key = cast(u64)4; menu.bounds = Rectangle.{10.0, 60.0, 200.0, 30.0}
    menu.motion = *menu_motion; menu.now = now; menu.reduced_motion = reduced
    if frame == 1 { menu_state.open_index = 0; menu_state.focused = true }
    menu.input.escape = close
    menu_result = Menu(motion_session, menu, groups[:], *menu_state)
    if EndFrame(motion_session) != cast(FrameStatus)FrameOk { return 11 }
    return 0
}

MotionRegionHash :: (region: s32) -> u64 {
    x: s32 = 10; y: s32 = 90; w: s32 = 200; h: s32 = 160
    if region == 1 { y = 10; w = 400; h = 44 }
    if region == 2 { x = 220; y = 80; w = 240; h = 180 }
    if region == 3 { x = 0; y = 280; w = 480; h = 80 }
    hash := cast(u64)14695981039346656037
    for row: y..y + h - 1 {
        for column: x..x + w - 1 {
            hash = (hash ^ cast(u64)cui_overlays_pixels[row * 480 + column]) * cast(u64)1099511628211
        }
    }
    return hash
}

#program_export
CuiMotionPixel :: (index: s32) -> u32 {
    if index < 0 || index >= 480 * 360 { return cast(u32)0 }
    return cui_overlays_pixels[index]
}

#program_export
CuiMotionEvidence :: (frame: s32) -> s32 {
    for step: 0..frame {
        result := MotionScene(step, false, false)
        if result != 0 { return result }
    }
    return 0
}

#program_export
main :: () -> s32 {
    unused InstallDefaultTheme(false)
    result := SpringBehavior()
    if result != 0 { return result }
    result = IdentityBehavior()
    if result != 0 { return result }
    result = ReorderBehavior()
    if result != 0 { return result }
    if MotionScene(0, false, false) != 0 { return 20 }
    if CuiMotionPixel(0) != cast(u32)0xffffffff { return 208 }
    initial := CuiOverlaysRasterHash()
    starts: [4]u64
    for region: 0..3 { starts[region] = MotionRegionHash(cast(s32)region) }
    if MotionScene(1, false, false) != 0 { return 21 }
    if !menu_result.animating { return 221 }
    if !tab_result.animating { return 222 }
    if !nav_result.animating { return 223 }
    if !collapse_result.animating { return 224 }
    if MotionScene(6, false, false) != 0 { return 23 }
    middle := CuiOverlaysRasterHash()
    mids: [4]u64
    for region: 0..3 {
        mids[region] = MotionRegionHash(cast(s32)region)
        if mids[region] == starts[region] { return 100 + cast(s32)region }
    }
    if middle == initial || collapse_result.content.height <= 0.0 || collapse_result.content.height >= 140.0 { return 24 }
    value := collapse_motion.channels[0].value
    if MotionScene(6, false, true) != 0 { return 25 }
    if collapse_motion.channels[0].value != value || !collapse_result.animating { return 26 }
    if menu_result.open_index != -1 || menu_result.focused { return 27 }
    // Closing paint has no scrim or item nodes; its old input ownership is gone.
    for index: 0..TreeCount(motion_session) - 1 {
        node := TreeNodeAt(motion_session, index)
        if node.kind == WidgetKindSelectable && node.key != MenuGroupKey(cast(u64)4, 0) { return 28 }
    }
    if MotionScene(7, true, true) != 0 { return 29 }
    if menu_result.animating || tab_result.animating || nav_result.animating || collapse_result.animating || collapse_result.content.height != 0.0 { return 30 }
    if CuiMotionEvidence(90) != 0 { return 31 }
    if menu_result.animating || tab_result.animating || nav_result.animating || collapse_result.animating { return 32 }
    settled := CuiOverlaysRasterHash()
    for region: 0..3 {
        if MotionRegionHash(cast(s32)region) == mids[region] { return 110 + cast(s32)region }
    }
    if settled == middle || settled == initial { return 33 }
    if MotionScene(91, false, false) != 0 || CuiOverlaysRasterHash() != settled { return 34 }
    unused SetReducedMotion(true)
    if MotionScene(92, false, true) != 0 { return 35 }
    if menu_result.animating || collapse_result.animating || collapse_result.content.height != 0.0 { return 36 }
    unused SetReducedMotion(false)
    CuiOverlaysRasterClose()
    unused SessionClose(motion_session)
    return 0
}

IdentityFrame :: (session: Session, motion: *TransitionMotionState,
    now: float64, grand_key: u64, shown: bool, open: bool) -> CollapsibleResult {
    unused CuiOverlaysRasterBegin()
    BeginFrame(session, cast(u64)5000, Rectangle.{0.0, 0.0, 480.0, 360.0})
    result: CollapsibleResult
    if shown {
        grand := TreeSubmitCurrent(session, grand_key, WidgetKindCustom, Rectangle.{0.0, 0.0, 480.0, 360.0})
        unused TreePushScope(session, grand)
        parent := TreeSubmitCurrent(session, cast(u64)7, WidgetKindCustom, Rectangle.{0.0, 0.0, 480.0, 360.0})
        unused TreePushScope(session, parent)
        props: CollapsibleProps
        props.key = cast(u64)9; props.has_open = true; props.open = open
        props.bounds = Rectangle.{10.0, 10.0, 200.0, 200.0}
        props.motion = motion; props.now = now
        headers: [1]CollapsibleHeader
        result = Collapsible(session, props, headers[:0])
        unused TreePopScope(session); unused TreePopScope(session)
    }
    if EndFrame(session) != cast(FrameStatus)FrameOk { result.node = -1 }
    return result
}

IdentityBehavior :: () -> s32 {
    state: TransitionMotionState
    a := SessionOpen(); b := SessionOpen()
    first := IdentityFrame(a, *state, 0.0, cast(u64)101, true, false)
    if first.content.height != 0.0 { return 200 }
    first = IdentityFrame(a, *state, 0.0, cast(u64)101, true, true)
    if first.content.height != 0.0 || !first.animating { return 201 }
    first = IdentityFrame(a, *state, 0.05, cast(u64)101, true, true)
    if first.content.height <= 0.0 || !first.animating { return 202 }
    // Same child and immediate-parent keys under a different grandparent.
    next := IdentityFrame(a, *state, 0.05, cast(u64)102, true, true)
    if next.animating || next.content.height <= first.content.height { return 203 }
    // Different live session, then remount under unchanged raw parent keys.
    next = IdentityFrame(b, *state, 0.05, cast(u64)102, true, false)
    if next.animating || next.content.height != 0.0 { return 204 }
    unused IdentityFrame(b, *state, 0.06, cast(u64)102, false, false)
    next = IdentityFrame(b, *state, 0.06, cast(u64)102, true, true)
    if next.animating || next.content.height <= 0.0 { return 205 }
    TreeDispose(a); TreeDispose(b)
    unused SessionClose(a); unused SessionClose(b)
    return 0
}

ReorderBehavior :: () -> s32 {
    session := SessionOpen()
    a: TransitionMotionState; b: TransitionMotionState
    values: [2]float32
    headers: [1]CollapsibleHeader
    for frame: 0..2 {
        unused CuiOverlaysRasterBegin()
        BeginFrame(session, cast(u64)7000, Rectangle.{0.0, 0.0, 480.0, 360.0})
        for position: 0..1 {
            index := ifx frame == 2 then 1 - position else position
            props: CollapsibleProps
            props.key = cast(u64)(index + 10); props.open = frame > 0; props.has_open = true
            props.bounds = Rectangle.{cast(float32)position * 220.0, 0.0, 200.0, 200.0}
            props.motion = ifx index == 0 then *a else *b
            props.now = ifx frame == 0 then 0.0 else 0.05
            result := Collapsible(session, props, headers[:0])
            if frame == 1 { values[index] = result.content.height }
            if frame == 2 && (result.content.height != values[index] || !result.animating) { return 206 }
        }
        if EndFrame(session) != cast(FrameStatus)FrameOk { return 207 }
    }
    TreeDispose(session); unused SessionClose(session)
    return 0
}
