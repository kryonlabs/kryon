#module "frame_lifecycle"

#import "kryon.h"
#import "ui_frame_props.generated.h"

#if #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
    #import "android_surface.h"
}
#if #defined(PLATFORM_WEB) {
    #import "web.h"
}

PostFrameEntry :: struct {
    callback: KryonPostFrameCallback
    userdata: void*
}

POST_FRAME_MAX :: 64

static post_frame_entries: [POST_FRAME_MAX]PostFrameEntry
static post_frame_count: int

SyncFrame :: () #export {
    width := GetScreenWidth()
    height := GetScreenHeight()

    #if #defined(PLATFORM_ANDROID) || #defined(__ANDROID__) {
        viewport: AndroidViewport = {0}
        SyncAndroidViewport(&viewport)
        if viewport.width > 0 {
            width = viewport.width
        }
        if viewport.height > 0 {
            height = viewport.height
        }
    }
    #if #defined(PLATFORM_WEB) {
        SyncWebWindowSize()
        width = GetScreenWidth()
        height = GetScreenHeight()
    }

    if width <= 0 {
        width = GetScreenWidth()
    }
    if height <= 0 {
        height = GetScreenHeight()
    }
    UpdateDPI(width, height)
}

BeginFrame :: () #export {
    if InstanceRejected() {
        return
    }
    SyncFrame()
    BeginDrawing()
    SyncFrame()
}

EndFrame :: () #export {
    if InstanceRejected() {
        return
    }
    EndDrawing()
}

SchedulePostFrameCallback :: (callback: KryonPostFrameCallback,
                               userdata: void*) -> int #export {
    if callback == nil || post_frame_count >= POST_FRAME_MAX {
        return 0
    }
    post_frame_entries[post_frame_count].callback = callback
    post_frame_entries[post_frame_count].userdata = userdata
    post_frame_count++
    return 1
}

kryon_run_post_frame_callbacks :: () #export {
    count := post_frame_count
    if count <= 0 {
        return
    }
    if count > POST_FRAME_MAX {
        count = POST_FRAME_MAX
    }
    entries: [POST_FRAME_MAX]PostFrameEntry = {0}
    for int index = 0; index < count; index++ {
        entries[index] = post_frame_entries[index]
    }
    post_frame_count = 0
    for int index = 0; index < count; index++ {
        if entries[index].callback != nil {
            entries[index].callback(entries[index].userdata)
        }
    }
}

GetFrameWidth :: () -> int #export {
    return GetLayoutWidth()
}

GetFrameHeight :: () -> int #export {
    return GetLayoutHeight()
}

GetFrameScale :: () -> float #export {
    return GetRenderScale()
}
