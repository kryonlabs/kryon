#import "composition_input"
#import "text_input"
#import "ziran_composition_input_host"

using CompositionPhase;

phase: s32;
state_active: bool;
state_cursor: s32;
state_selection_length: s32;
state_text: [64]u8;
state_text_count: s64;

#program_export
Frame :: () -> s32 {
    sample: CompositionSample = SampleComposition()
    previous_text: [64]u8
    previous_count: s64 = state_text_count
    if previous_count > 64 { return -9 }
    previous_byte: s64 = 0
    while previous_byte < previous_count {
        previous_text[previous_byte] = state_text[previous_byte]
        previous_byte += 1
    }
    previous: CompositionState
    previous.active = state_active
    previous.cursor = state_cursor
    previous.selection_length = state_selection_length
    previous.text = TextView(previous_text[:previous_count])
    transition: CompositionTransition = CompositionTransitionFor(
        previous, CompositionEventForSample(sample), true, false)
    next: CompositionState = transition.state
    incoming_text: [64]u8
    incoming_count: s64 = next.text.count
    if incoming_count > 64 { return -8 }
    byte: s64 = 0
    while byte < incoming_count {
        incoming_text[byte] = next.text[byte]
        byte += 1
    }
    next.text = ""
    byte = 0
    while byte < incoming_count {
        state_text[byte] = incoming_text[byte]
        byte += 1
    }
    state_text_count = incoming_count
    state_active = next.active
    state_cursor = next.cursor
    state_selection_length = next.selection_length

    state: CompositionState
    state.active = state_active
    state.cursor = state_cursor
    state.selection_length = state_selection_length
    state.text = TextView(state_text[:state_text_count])
    if phase == 0 {
        if !sample.available ||
            sample.phase != cast(CompositionPhase)CompositionStart ||
            !state.active || state.text != "é" ||
            state.cursor != 0 || state.selection_length != 2 {
            return -1
        }
    } else if phase == 1 {
        if sample.available || !state.active ||
            state.text != "é" || transition.changed {
            return -2
        }
    } else if phase == 2 {
        if !sample.available || !state.active ||
            state.text != "éx" || state.cursor != 3 {
            return -3
        }
    } else if phase == 3 {
        if !sample.available || !transition.commit ||
            transition.commit_text != "Q" ||
            state.active { return -4 }
    } else if phase == 4 {
        if !sample.available || !state.active ||
            state.text != "A" { return -5 }
        canceled: CompositionSample = SampleComposition()
        if !canceled.available ||
            canceled.phase != cast(CompositionPhase)CompositionCancel {
            return -6
        }
        after: CompositionTransition = CompositionTransitionFor(
            state, CompositionEventForSample(canceled), true, false)
        if after.state.active || !after.changed { return -7 }
    }
    old: s32 = phase
    phase += 1
    return old
}

#program_export
main :: () -> s32 {
    frame: s32 = 0
    while frame < 5 {
        SetCompositionHostFrame(frame)
        if Frame() != frame { return frame + 1 }
        frame += 1
    }
    return 0
}
