        KssNameEquals(name, "view-timeline") ||
        KssNameEquals(name, "view-timeline-name") ||
        KssNameEquals(name, "view-timeline-axis") {
        return -2
    }
    if KssNameEquals(name, "view-timeline-inset") ||
        KssNameEquals(name, "timeline-scope") ||
        KssNameEquals(name, "transform") ||
        KssNameEquals(name, "transform-origin") ||
        KssNameEquals(name, "transform-box") ||
        KssNameEquals(name, "transform-style") ||
        KssNameEquals(name, "translate") ||
        KssNameEquals(name, "rotate") {
        return -2
    }
    if KssNameEquals(name, "scale") ||
        KssNameEquals(name, "perspective-origin") ||
        KssNameEquals(name, "backface-visibility") ||
        KssNameEquals(name, "offset-path") ||
        KssNameEquals(name, "offset-rotate") ||
        KssNameEquals(name, "offset-anchor") ||
        KssNameEquals(name, "offset-position") ||
        KssNameEquals(name, "filter") {
        return -2
    }
    if KssNameEquals(name, "backdrop-filter") ||
        KssNameEquals(name, "clip-path") ||
        KssNameEquals(name, "mask") ||
        KssNameEquals(name, "mask-image") ||
        KssNameEquals(name, "mask-size") ||
        KssNameEquals(name, "mask-position") ||
        KssNameEquals(name, "mask-repeat") ||
        KssNameEquals(name, "mask-origin") {
        return -2
    }
    if KssNameEquals(name, "mask-clip") ||
        KssNameEquals(name, "mask-composite") ||
        KssNameEquals(name, "mask-mode") ||
        KssNameEquals(name, "cursor") ||
        KssNameEquals(name, "pointer-events") ||
        KssNameEquals(name, "appearance") ||
        KssNameEquals(name, "user-select") ||
        KssNameEquals(name, "resize") {
        return -2
    }
    if KssNameEquals(name, "outline") ||
        KssNameEquals(name, "outline-style") ||
        KssNameEquals(name, "box-shadow") ||
        KssNameEquals(name, "color-scheme") ||
        KssNameEquals(name, "field-sizing") ||
        KssNameEquals(name, "interpolate-size") ||
        KssNameEquals(name, "overlay") ||
        KssNameEquals(name, "forced-color-adjust") {
        return -2
    }
    if KssNameEquals(name, "print-color-adjust") ||
        KssNameEquals(name, "color-interpolation") ||
        KssNameEquals(name, "color-interpolation-filters") ||
        KssNameEquals(name, "paint-order") ||
        KssNameEquals(name, "shape-outside") ||
        KssNameEquals(name, "shape-image-threshold") ||
        KssNameEquals(name, "contain") ||
        KssNameEquals(name, "content-visibility") {
        return -2
    }
    if KssNameEquals(name, "contain-intrinsic-size") ||
        KssNameEquals(name, "contain-intrinsic-width") ||
        KssNameEquals(name, "contain-intrinsic-height") ||
        KssNameEquals(name, "contain-intrinsic-inline-size") ||
        KssNameEquals(name, "contain-intrinsic-block-size") ||
        KssNameEquals(name, "container") ||
        KssNameEquals(name, "container-type") ||
        KssNameEquals(name, "container-name") {
        return -2
    }
    if KssNameEquals(name, "will-change") ||
        KssNameEquals(name, "anchor-name") ||
        KssNameEquals(name, "position-anchor") ||
        KssNameEquals(name, "position-area") ||
        KssNameEquals(name, "position-try") ||
        KssNameEquals(name, "position-try-fallbacks") ||
        KssNameEquals(name, "position-try-order") ||
        KssNameEquals(name, "position-visibility") {
        return -2
    }
    if KssNameEquals(name, "view-transition-name") ||
        KssNameEquals(name, "isolation") ||
        KssNameEquals(name, "mix-blend-mode") ||
        KssNameEquals(name, "columns") ||
        KssNameEquals(name, "column-fill") ||
        KssNameEquals(name, "column-span") ||
        KssNameEquals(name, "column-rule") ||
        KssNameEquals(name, "column-rule-style") {
        return -2
    }
    if KssNameEquals(name, "break-before") ||
        KssNameEquals(name, "break-after") ||
        KssNameEquals(name, "break-inside") ||
        KssNameEquals(name, "float") ||
        KssNameEquals(name, "clear") ||
        KssNameEquals(name, "order") {
        return -2
    }
    return -1
}

KssCSSValueFromText :: (source: string) -> KssCSSValue #export {
    result: KssCSSValue
    result.valid = true
    start: i32 = 0
    end: i32 = source.length
    while start < end && KssIsSpace(source[start]) {
        start = start + 1
    }
    while end > start && KssIsSpace(source[end - 1]) {
        end = end - 1
    }
    result.text = StringSlice(source, start, end - start)
    c: KssCursor
    c.source = result.text
    scalar: KssScalarResult = KssReadScalar(c)
    if scalar.ok {
        c = scalar.parser
        if KssPeek(c, 0) == 112 && KssPeek(c, 1) == 120 {
            c = KssAdvance(c, 2)
        }
        c = KssSkipSpace(c)
        if KssAtEnd(c) {
            result.kind = (i32)KssCSSNumber
            result.number = scalar.value
        }
    }
    return result
}

KssResolveCSSValue :: (p: KssParser, property: string, source: string) -> KssCSSValue #export {
    result: KssCSSValue = KssCSSValueFromText(source)
    property_kind: i32 = KssCSSPropertyKind(KssMakeName(property))
    if property_kind == -1 {
        result.valid = false
        return result
    }
    if result.kind == (i32)KssCSSNumber || property_kind == -2 {
        return result
    }
    c: KssCursor
    c.source = result.text
    reference: KssNameResult = KssReadName(c)
    c = KssSkipSpace(reference.parser)
    if !reference.ok || !KssAtEnd(c) {
        return result
    }
    index: i32 = -1
    if property_kind == (i32)KssTokenLength {
        index = KssFindNumberToken(p, reference.name)
    } else {
        index = KssFindToken(p, reference.name, property_kind)
    }
    if index < 0 {
        return result
    }
    result.has_token = true
    result.token_name = p.tokens[index].name
    result.token_origin = p.tokens[index].origin
    if property_kind == (i32)KssTokenColor {
        result.kind = (i32)KssCSSColor
        result.color = p.tokens[index].color
    } else if property_kind == (i32)KssTokenMaterial {
        result.kind = (i32)KssCSSMaterial
        result.material = p.tokens[index].material
    } else {
        result.kind = (i32)KssCSSNumber
        result.number = (f64)p.tokens[index].number
    }
    return result
}

KssOverrideCSSValue :: (value: KssCSSValue, replacement: string, provided: bool) -> KssCSSValue #export {
    if !provided || !value.has_token || value.kind != (i32)KssCSSColor {
        return value
    }
    parsed: KssCSSValue = KssCSSValueFromText(replacement)
    value.kind = parsed.kind
    value.number = parsed.number
    value.text = parsed.text
    return value
}

# Selector predicates operate on borrowed UTF-8 bytes. Hosts supply attribute
# values and sibling positions; matching semantics stay shared.
KssTextAt :: (value: string, needle: string, start: i32) -> bool {
    if start < 0 || start > value.length || needle.length > value.length - start {
        return false
    }
    index: i32 = 0
    while index < needle.length {
        if value[start + index] != needle[index] {
            return false
        }
        index = index + 1
    }
    return true
}

KssIdentityFacts :: struct {
    id: string
    name: string
    key: string
}

KssIdentityMatches :: (expected: string, facts: KssIdentityFacts) -> bool #export {
    if expected.length == 0 {
        return false
    }
    return expected == facts.id || expected == facts.name || expected == facts.key
}

KssAttributeMatches :: (value: string, needle: string, operation: string, present: bool) -> bool #export {
    if !present {
        return false
    }
    if operation == "=" || operation == "" {
        return value == needle
    }
    if operation == "|=" {
        return value == needle || (KssTextAt(value, needle, 0) &&
            value.length > needle.length && value[needle.length] == 45)
    }
    if needle.length == 0 {
        return false
    }
    if operation == "^=" {
        return KssTextAt(value, needle, 0)
    }
    if operation == "$=" {
        return KssTextAt(value, needle, value.length - needle.length)
    }
    if operation == "*=" {
        start: i32 = 0
        while start <= value.length - needle.length {
            if KssTextAt(value, needle, start) {
                return true
            }
            start = start + 1
        }
        return false
    }
    if operation == "~=" {
        start: i32 = 0
        while start < value.length {
            while start < value.length && KssIsSpace(value[start]) {
                start = start + 1
            }
            end: i32 = start
            while end < value.length && !KssIsSpace(value[end]) {
                end = end + 1
            }
            if end - start == needle.length && KssTextAt(value, needle, start) {
                return true
            }
            start = end
        }
        return false
    }
    return false
}

KssNthMatches :: (source: string, position: i32) -> bool #export {
    if position <= 0 {
        return false
    }
    c: KssCursor
    c.source = source
    c = KssSkipSpace(c)
    word: KssNameResult = KssReadName(c)
    if word.ok && KssAtEnd(KssSkipSpace(word.parser)) {
        if KssNameEquals(word.name, "odd") {
            return position % 2 == 1
        }
        if KssNameEquals(word.name, "even") {
            return position % 2 == 0
        }
    }
    sign: i64 = 1
    if KssPeek(c, 0) == 45 {
        sign = -1
        c = KssAdvance(c, 1)
    } else if KssPeek(c, 0) == 43 {
        c = KssAdvance(c, 1)
    }
    number: i64 = 0
    digits: bool = false
    while KssIsDigit(KssPeek(c, 0)) {
        number = number * 10 + (i64)(KssPeek(c, 0) - 48)
        if number > 2147483647 {
            return false
        }
        digits = true
        c = KssAdvance(c, 1)
    }
    if KssLower(KssPeek(c, 0)) != 110 {
        return digits && KssAtEnd(KssSkipSpace(c)) && (i64)position == sign * number
    }
    if !digits {
        number = 1
    }
    step: i64 = sign * number
    c = KssSkipSpace(KssAdvance(c, 1))
    offset: i64 = 0
    if !KssAtEnd(c) {
        sign = 1
        if KssPeek(c, 0) == 45 {
            sign = -1
        } else if KssPeek(c, 0) != 43 {
            return false
        }
        c = KssSkipSpace(KssAdvance(c, 1))
        digits = false
        while KssIsDigit(KssPeek(c, 0)) {
            offset = offset * 10 + (i64)(KssPeek(c, 0) - 48)
            if offset > 2147483647 {
                return false
            }
            digits = true
            c = KssAdvance(c, 1)
        }
        if !digits || !KssAtEnd(KssSkipSpace(c)) {
            return false
        }
        offset = sign * offset
    }
    if step == 0 {
        return (i64)position == offset
    }
    delta: i64 = (i64)position - offset
    return delta % step == 0 && delta / step >= 0
}

KssNthSiblingMatches :: (source: string, index: i32, count: i32, from_end: bool) -> bool #export {
    if index < 0 || index >= count {
        return false
    }
    position: i32 = index + 1
    if from_end {
        position = count - index
    }
    return KssNthMatches(source, position)
}

KssStateFacts :: struct {
    kind: string
    tag: string
    any_active: bool
    requested: bool
    hover: bool
    pressed: bool
    focus: bool
    disabled: bool
    node_disabled: bool
    readonly: bool
    readonly_camel: bool
    node_readonly: bool
    required: bool
    node_required: bool
    valid: bool
    invalid: bool
    aria_invalid: bool
    extra_invalid: bool
    placeholder_shown: bool
    placeholder_shown_camel: bool
    placeholder_present: bool
    value_present: bool
}

KssStateName :: (source: string) -> KssName #export {
    name: KssName
    if source.length > 64 {
        return name
    }
    while name.length < source.length {
        name.bytes[name.length] = KssLower(source[name.length])
        name.length = name.length + 1
    }
    return name
}

KssIsFormControl :: (kind: string, tag: string) -> bool {
    if tag == "input" || tag == "select" || tag == "textarea" {
        return true
    }
    if kind == "TextField" || kind == "Input" || kind == "TextArea" ||
        kind == "ColorPicker" || kind == "Slider" || kind == "Spinbox" {
        return true
    }
    return kind == "Dropdown" || kind == "ListBox" || kind == "Checkbox" ||
        kind == "Toggle" || kind == "Radio"
}

KssStateMatches :: (source: string, facts: KssStateFacts) -> bool #export {
    if source.length > 64 {
        return false
    }
    name: KssName = KssStateName(source)
    if name.length == 0 || KssNameEquals(name, "any") {
        return true
    }
    if KssNameEquals(name, "normal") {
        return !facts.any_active && !facts.node_readonly && !facts.node_required
    }
    if KssNameEquals(name, "hover") {
        return facts.requested || facts.hover
    }
    if KssNameEquals(name, "pressed") || KssNameEquals(name, "active") {
        return facts.requested || facts.pressed
    }
    if KssNameEquals(name, "focus") || KssNameEquals(name, "focused") ||
        KssNameEquals(name, "focus-visible") {
        return facts.requested || facts.focus
    }
    if KssNameEquals(name, "enabled") {
        return !facts.disabled && !facts.node_disabled
    }
    if KssNameEquals(name, "readonly") || KssNameEquals(name, "read-only") {
        return facts.node_readonly || facts.readonly || facts.readonly_camel
    }
    if KssNameEquals(name, "required") {
        return facts.node_required || facts.required
    }
    if KssNameEquals(name, "optional") {
        return !facts.node_required && !facts.required
    }
    if KssNameEquals(name, "valid") {
        if facts.valid {
            return true
        }
        return KssIsFormControl(facts.kind, facts.tag) && !facts.invalid &&
            !facts.aria_invalid && !facts.extra_invalid
    }
    if KssNameEquals(name, "placeholder-shown") || KssNameEquals(name, "placeholder_shown") {
        if facts.placeholder_shown || facts.placeholder_shown_camel {
            return true
        }
        return KssIsFormControl(facts.kind, facts.tag) && facts.placeholder_present &&
            !facts.value_present
    }
    return facts.requested
}

KssStructuralFacts :: struct {
    has_parent: bool
    has_scope: bool
    is_scope: bool
    sibling_index: i32
    sibling_count: i32
    type_index: i32
    type_count: i32
    has_children: bool
    has_text: bool
    focus_within: bool
    target: bool
}

# -1 leaves functional pseudos to the selector traversal driver. Zero and one
# are complete decisions from the supplied relationship/content facts.
KssStructuralMatch :: (name: string, facts: KssStructuralFacts) -> i32 #export {
    matched: bool = false
    if name == "root" {
        matched = !facts.has_parent
    } else if name == "scope" {
        if facts.has_scope {
            matched = facts.is_scope
        } else {
            matched = !facts.has_parent
        }
    } else if name == "first-child" {
        matched = facts.sibling_index == 0 && facts.sibling_count > 0
    } else if name == "last-child" {
        matched = facts.sibling_index >= 0 && facts.sibling_index == facts.sibling_count - 1
    } else if name == "only-child" {
        matched = facts.sibling_index == 0 && facts.sibling_count == 1
    } else if name == "first-of-type" {
        matched = facts.type_index == 0 && facts.type_count > 0
    } else if name == "last-of-type" {
        matched = facts.type_index >= 0 && facts.type_index == facts.type_count - 1
    } else if name == "only-of-type" {
        matched = facts.type_index == 0 && facts.type_count == 1
    } else if name == "empty" {
        matched = !facts.has_children && !facts.has_text
    } else if name == "focus-within" {
        matched = facts.focus_within
    } else if name == "target" {
        matched = facts.target
    } else {
        return -1
    }
    if matched {
        return 1
    }
    return 0
}

# Declarative selector lexing. Results borrow spans from the input; the host
# stores the resulting selector objects but does not parse their syntax.
KssSelectorStack :: struct {
    bytes: [64]u8
}

KssSelectorSpan :: struct {
    parser: KssCursor
    start: i32
    length: i32
    combinator: i32
    ok: bool
    done: bool
}

KssSelectorComment :: (c: KssCursor) -> KssExpectResult {
    result: KssExpectResult
    line: bool = KssPeek(c, 1) == 47
    c = KssAdvance(c, 2)
    while !KssAtEnd(c) {
        if line && KssPeek(c, 0) == 10 {
            result.parser = c
            result.ok = true
            return result
        }
        if !line && KssPeek(c, 0) == 42 && KssPeek(c, 1) == 47 {
            result.parser = KssAdvance(c, 2)
            result.ok = true
            return result
        }
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = line
    return result
}

KssSelectorSpace :: (c: KssCursor) -> KssExpectResult {
    result: KssExpectResult
    while !KssAtEnd(c) {
        if KssIsSpace(KssPeek(c, 0)) {
            c = KssAdvance(c, 1)
        } else if KssPeek(c, 0) == 47 && (KssPeek(c, 1) == 42 || KssPeek(c, 1) == 47) {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                return comment
            }
        } else {
            break
        }
    }
    result.parser = c
    result.ok = true
    return result
}

KssSelectorPartMode :: (c: KssCursor, sequence: bool, relative: bool) -> KssSelectorSpan {
    result: KssSelectorSpan
    initial: i32 = c.pos
    skipped: KssExpectResult = KssSelectorSpace(c)
    c = skipped.parser
    result.parser = c
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.ok = !(initial > 0 && c.source[initial - 1] == 44)
        result.done = true
        return result
    }
    if sequence {
        if initial > 0 {
            result.combinator = 32
        }
        byte: u8 = KssPeek(c, 0)
        if byte == 62 || byte == 43 || byte == 126 {
            if initial == 0 && !relative {
                return result
            }
            result.combinator = (i32)byte
            skipped = KssSelectorSpace(KssAdvance(c, 1))
            c = skipped.parser
            result.parser = c
            if !skipped.ok || KssAtEnd(c) {
                return result
            }
        }
    }
    result.start = c.pos
    end: i32 = c.pos
    stack: KssSelectorStack
    depth: i32 = 0
    quote: u8 = 0
    while !KssAtEnd(c) {
        byte: u8 = KssPeek(c, 0)
        if quote != 0 {
            if byte == 92 {
                c = KssAdvance(c, 2)
                end = c.pos
                continue
            }
            if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && (KssPeek(c, 1) == 42 || (depth == 0 && KssPeek(c, 1) == 47)) {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                result.parser = c
                return result
            }
            continue
        } else if byte == 40 || byte == 91 {
            if depth >= 64 {
                result.parser = c
                return result
            }
            stack.bytes[depth] = byte
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            if depth == 0 {
                result.parser = c
                return result
            }
            opening: u8 = stack.bytes[depth - 1]
            if (byte == 41 && opening != 40) || (byte == 93 && opening != 91) {
                result.parser = c
                return result
            }
            depth = depth - 1
        } else if depth == 0 {
            if !sequence && byte == 44 {
                break
            }
            if sequence && (KssIsSpace(byte) || byte == 62 || byte == 43 || byte == 126) {
                break
            }
        }
        c = KssAdvance(c, 1)
        if !KssIsSpace(byte) || depth > 0 || quote != 0 {
            end = c.pos
        }
    }
    result.parser = c
    if depth != 0 || quote != 0 || end <= result.start {
        return result
    }
    result.length = end - result.start
    if !sequence && KssPeek(c, 0) == 44 {
        result.parser = KssAdvance(c, 1)
    }
    result.ok = true
    return result
}

KssSelectorPart :: (c: KssCursor, sequence: bool) -> KssSelectorSpan #export {
    return KssSelectorPartMode(c, sequence, false)
}

KssRelativeSelectorPart :: (c: KssCursor) -> KssSelectorSpan #export {
    result: KssSelectorSpan = KssSelectorPartMode(c, true, true)
    if c.pos == 0 && result.ok && !result.done && result.combinator == 0 {
        result.combinator = 32
    }
    return result
}

KssSelectorGroup :: (c: KssCursor) -> KssSelectorSpan {
    result: KssSelectorSpan
    opening: u8 = KssPeek(c, 0)
    stack: KssSelectorStack
    stack.bytes[0] = opening
    depth: i32 = 1
    quote: u8 = 0
    c = KssAdvance(c, 1)
    result.start = c.pos
    while !KssAtEnd(c) {
        byte: u8 = KssPeek(c, 0)
        if quote != 0 {
            if byte == 92 {
                c = KssAdvance(c, 2)
                continue
            }
            if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && KssPeek(c, 1) == 42 {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                result.parser = c
                return result
            }
            continue
        } else if byte == 40 || byte == 91 {
            if depth >= 64 {
                result.parser = c
                return result
            }
            stack.bytes[depth] = byte
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            opening = stack.bytes[depth - 1]
            if (byte == 41 && opening != 40) || (byte == 93 && opening != 91) {
                result.parser = c
                return result
            }
            depth = depth - 1
            if depth == 0 {
                result.length = c.pos - result.start
                result.parser = KssAdvance(c, 1)
                result.ok = true
                return result
            }
        }
        c = KssAdvance(c, 1)
    }
    result.parser = c
    return result
}

# The host retains a stack of frames and supplies relationships for cursor.
# A popped child means that candidate failed, so the resumed frame tries the
# next ancestor/sibling only for descendant and general-sibling combinators.
KssSelectorChainAction :: enum {
    KssSelectorPop = 0
    KssSelectorPush = 1
    KssSelectorAccept = 2
}

KssSelectorChainFrame :: struct {
    part: i32
    cursor: i32
    entered: bool
    anchored: bool
    anchor: i32
}

KssSelectorChainResult :: struct {
    frame: KssSelectorChainFrame
    next: KssSelectorChainFrame
    action: i32
}

KssSelectorChainBegin :: (count: i32, node: i32) -> KssSelectorChainFrame #export {
    frame: KssSelectorChainFrame
    frame.part = count - 1
    frame.cursor = node
    return frame
}

KssRelativeSelectorBegin :: (count: i32, node: i32, anchor: i32) -> KssSelectorChainFrame #export {
    frame: KssSelectorChainFrame = KssSelectorChainBegin(count, node)
    frame.anchored = count > 0 && anchor >= 0
    frame.anchor = anchor
    if !frame.anchored {
        frame.cursor = -1
    }
    return frame
}

KssSelectorChainStep :: (frame: KssSelectorChainFrame, matched: bool,
    relation: i32, parent: i32, previous: i32) -> KssSelectorChainResult #export {
    result: KssSelectorChainResult
    result.frame = frame
    if frame.cursor < 0 {
        return result
    }
    if frame.part < 0 {
        if frame.part == -1 && frame.anchored && frame.cursor == frame.anchor {
            result.action = (i32)KssSelectorAccept
        }
        return result
    }
    repeated: bool = relation == 0 || relation == 32 || relation == 126
    if frame.entered {
        if !repeated {
            return result
        }
    } else {
        if !matched {
            return result
        }
        if frame.part == 0 && !frame.anchored {
            result.action = (i32)KssSelectorAccept
            return result
        }
    }
    candidate: i32 = -1
    if relation == 0 || relation == 32 || relation == 62 {
        candidate = parent
    } else if relation == 43 || relation == 126 {
        candidate = previous
    }
    if candidate < 0 {
        return result
    }
    result.frame.cursor = candidate
    result.frame.entered = true
    result.next.part = frame.part - 1
    result.next.cursor = candidate
    result.next.anchored = frame.anchored
    result.next.anchor = frame.anchor
    result.action = (i32)KssSelectorPush
    return result
}

# Hosts count matching alternatives; this policy owns selector-list negation.
KssSelectorGroupMatches :: (name: string, count: i32, matching: i32) -> bool #export {
    if count <= 0 || matching < 0 || matching > count {
        return false
    }
    if name == "not" {
        return matching == 0
    }
    if name == "is" || name == "where" {
        return matching > 0
    }
    return false
}

KssSelectorAtomKind :: enum {
    KssSelectorKind = 0
    KssSelectorId = 1
    KssSelectorClass = 2
    KssSelectorAttribute = 3
    KssSelectorPseudo = 4
    KssSelectorState = 5
    KssSelectorNot = 6
    KssSelectorMatches = 7
}

KssSelectorCursor :: struct {
    cursor: KssCursor
    specificity: i32
    has_kind: bool
}

KssSelectorAtom :: struct {
    parser: KssSelectorCursor
    kind: i32
    name: string
    value: string
    operation: string
    argument: string
    canonical: KssName
    has_value: bool
    has_argument: bool
    ok: bool
    done: bool
}

KssBeginSelector :: (source: string) -> KssSelectorCursor #export {
    parser: KssSelectorCursor
    parser.cursor.source = source
    return parser
}

KssPseudoName :: (source: string) -> KssName {
    name: KssName = KssStateName(source)
    index: i32 = 0
    while index < name.length {
        if name.bytes[index] == 95 {
            name.bytes[index] = 45
        }
        index = index + 1
    }
    return name
}

KssPseudoState :: (name: KssName) -> KssName {
    if KssNameEquals(name, "active") {
        return KssMakeName("pressed")
    }
    if KssNameEquals(name, "focused") || KssNameEquals(name, "focus-visible") {
        return KssMakeName("focus")
    }
    if KssNameEquals(name, "read-only") {
        return KssMakeName("readonly")
    }
    if KssNameEquals(name, "hover") || KssNameEquals(name, "pressed") ||
        KssNameEquals(name, "focus") || KssNameEquals(name, "normal") ||
        KssNameEquals(name, "disabled") || KssNameEquals(name, "loading") ||
        KssNameEquals(name, "selected") || KssNameEquals(name, "checked") {
        return name
    }
    if KssNameEquals(name, "invalid") || KssNameEquals(name, "valid") ||
        KssNameEquals(name, "indeterminate") || KssNameEquals(name, "default") ||
        KssNameEquals(name, "autofill") || KssNameEquals(name, "placeholder-shown") ||
        KssNameEquals(name, "expanded") || KssNameEquals(name, "open") {
        return name
    }
    if KssNameEquals(name, "readonly") || KssNameEquals(name, "required") ||
        KssNameEquals(name, "enabled") || KssNameEquals(name, "optional") {
        return name
    }
    empty: KssName
    return empty
}

KssSelectorAttributeAtom :: (result: KssSelectorAtom, group: KssSelectorSpan) -> KssSelectorAtom {
    c: KssCursor
    c.source = StringSlice(group.parser.source, group.start, group.length)
    skipped: KssExpectResult = KssSelectorSpace(c)
    c = skipped.parser
    start: i32 = c.pos
    key: KssNameResult = KssReadName(c)
    if !skipped.ok || !key.ok {
        return result
    }
    result.name = StringSlice(c.source, start, key.parser.pos - start)
    skipped = KssSelectorSpace(key.parser)
    c = skipped.parser
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.ok = true
        return result
    }
    start = c.pos
    byte: u8 = KssPeek(c, 0)
    if byte == 126 || byte == 124 || byte == 94 || byte == 36 || byte == 42 {
        c = KssAdvance(c, 1)
    }
    if KssPeek(c, 0) != 61 {
        return result
    }
    c = KssAdvance(c, 1)
    result.operation = StringSlice(c.source, start, c.pos - start)
    skipped = KssSelectorSpace(c)
    c = skipped.parser
    if !skipped.ok || KssAtEnd(c) {
        return result
    }
    start = c.pos
    end: i32 = c.source.length
    quote: u8 = KssPeek(c, 0)
    if quote == 34 || quote == 39 {
        c = KssAdvance(c, 1)
        start = c.pos
        while !KssAtEnd(c) && KssPeek(c, 0) != quote {
            if KssPeek(c, 0) == 92 {
                c = KssAdvance(c, 2)
            } else {
                c = KssAdvance(c, 1)
            }
        }
        if KssAtEnd(c) {
            return result
        }
        end = c.pos
        skipped = KssSelectorSpace(KssAdvance(c, 1))
        if !skipped.ok || !KssAtEnd(skipped.parser) {
            return result
        }
    } else {
        while !KssAtEnd(c) && !KssIsSpace(KssPeek(c, 0)) {
            if KssPeek(c, 0) == 47 && KssPeek(c, 1) == 42 {
                break
            }
            c = KssAdvance(c, 1)
        }
        end = c.pos
        skipped = KssSelectorSpace(c)
        if !skipped.ok || !KssAtEnd(skipped.parser) {
            return result
        }
    }
    result.value = StringSlice(c.source, start, end - start)
    result.has_value = true
    result.ok = true
    return result
}

# Nested :has is outside the supported selector language. Inspect tokens,
# excluding quoted values, attributes, and comments, rather than searching text.
KssHasArgumentAllowed :: (source: string) -> bool {
    c: KssCursor
    c.source = source
    while !KssAtEnd(c) {
        skipped: KssExpectResult = KssSelectorSpace(c)
        c = skipped.parser
        if !skipped.ok {
            return false
        }
        byte: u8 = KssPeek(c, 0)
        if byte == 91 {
            group: KssSelectorSpan = KssSelectorGroup(c)
            if !group.ok {
                return false
            }
            c = group.parser
        } else if byte == 34 || byte == 39 {
            c = KssAdvance(c, 1)
            while !KssAtEnd(c) && KssPeek(c, 0) != byte {
                if KssPeek(c, 0) == 92 {
                    c = KssAdvance(c, 2)
                } else {
                    c = KssAdvance(c, 1)
                }
            }
            if KssAtEnd(c) {
                return false
            }
            c = KssAdvance(c, 1)
        } else if byte == 58 {
            c = KssAdvance(c, 1)
            start: i32 = c.pos
            name: KssNameResult = KssReadSelectorName(c)
            if !name.ok {
                return false
            }
            c = name.parser
            canonical: KssName = KssPseudoName(StringSlice(source, start, c.pos - start))
            if KssNameEquals(canonical, "has") && KssPeek(c, 0) == 40 {
                return false
            }
        } else {
            c = KssAdvance(c, 1)
        }
    }
    return true
}

KssSelectorNext :: (parser: KssSelectorCursor) -> KssSelectorAtom #export {
    result: KssSelectorAtom
    result.parser = parser
    skipped: KssExpectResult = KssSelectorSpace(parser.cursor)
    c: KssCursor = skipped.parser
    result.parser.cursor = c
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.done = true
        result.ok = true
        return result
    }
    byte: u8 = KssPeek(c, 0)
    start: i32 = c.pos
    if byte == 91 {
        group: KssSelectorSpan = KssSelectorGroup(c)
        result.parser.cursor = group.parser
        if !group.ok {
            return result
        }
        result.kind = (i32)KssSelectorAttribute
        result = KssSelectorAttributeAtom(result, group)
        if result.ok {
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 1, 0, 0)
        }
        return result
    }
    if byte == 35 || byte == 46 || byte == 58 {
        c = KssAdvance(c, 1)
        start = c.pos
        name: KssNameResult = KssReadSelectorName(c)
        if !name.ok || !KssIdentStart(KssPeek(c, 0)) {
            return result
        }
        c = name.parser
        result.name = StringSlice(c.source, start, c.pos - start)
        if byte == 35 {
            result.kind = (i32)KssSelectorId
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 0, 0, 1)
        } else if byte == 46 {
            result.kind = (i32)KssSelectorClass
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 0, 1, 0)
        } else {
            result.kind = (i32)KssSelectorPseudo
            result.canonical = KssPseudoName(result.name)
            if result.canonical.length == 0 {
                return result
            }
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 1, 0, 0)
            if KssPeek(c, 0) == 40 {
                group: KssSelectorSpan = KssSelectorGroup(c)
                result.parser.cursor = group.parser
                if !group.ok {
                    return result
                }
                result.has_argument = true
                result.argument = StringSlice(c.source, group.start, group.length)
                c = group.parser
                if KssNameEquals(result.canonical, "not") || KssNameEquals(result.canonical, "is") ||
                    KssNameEquals(result.canonical, "where") || KssNameEquals(result.canonical, "has") {
                    argument_cursor: KssCursor
                    argument_cursor.source = result.argument
                    argument_space: KssExpectResult = KssSelectorSpace(argument_cursor)
                    if !argument_space.ok || KssAtEnd(argument_space.parser) {
                        return result
                    }
                }
                if KssNameEquals(result.canonical, "has") && !KssHasArgumentAllowed(result.argument) {
                    return result
                }
                if KssNameEquals(result.canonical, "not") {
                    result.kind = (i32)KssSelectorNot
                } else if KssNameEquals(result.canonical, "is") || KssNameEquals(result.canonical, "where") {
                    result.kind = (i32)KssSelectorMatches
                }
            } else {
                state: KssName = KssPseudoState(result.canonical)
                if state.length > 0 {
                    result.kind = (i32)KssSelectorState
                    result.canonical = state
                }
            }
        }
    } else {
        if parser.has_kind || (!KssIdentStart(byte) && byte != 42) {
            return result
        }
        while !KssAtEnd(c) {
            byte = KssPeek(c, 0)
            if KssIsSpace(byte) || byte == 46 || byte == 35 || byte == 91 || byte == 58 {
                break
            }
            if byte == 47 && (KssPeek(c, 1) == 42 || KssPeek(c, 1) == 47) {
                break
            }
            if byte == 44 || byte == 40 || byte == 41 || byte == 93 || byte == 62 || byte == 43 || byte == 126 {
                return result
            }
            c = KssAdvance(c, 1)
        }
        result.name = StringSlice(c.source, start, c.pos - start)
        result.kind = (i32)KssSelectorKind
        result.parser.has_kind = true
        if result.name != "*" {
            result.parser.specificity = result.parser.specificity + StyleSpecificity(1, 0, 0, 0)
        }
    }
    result.parser.cursor = c
    result.ok = true
    return result
}
