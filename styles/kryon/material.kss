}

Toggle {
  background: #2a303b;
  foreground: text;
  border: #3a4250;
  focus: focus;
  radius: radius.lg;
  border-width: border;
  opacity: 1;
  material: default;
}

Toggle[role=Track] {
  opacity: 1;
}

Toggle[role=Label] {
  foreground: text;
}

Toggle:hover {
  background: #343b48;
}

Toggle:pressed {
  background: #202631;
}

