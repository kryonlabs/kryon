#module "style"
#import "surface"
#import "control_props"

# Interaction styling is shared by widgets, independent of activation logic.

StateFlags :: struct {
    disabled: bool
    loading: bool
    selected: bool
}

# Explicit terminal states carry the same flags as their boolean props.
# Normalize before input, motion, or appearance so hosts cannot disagree.
ResolveFlags :: (state: i32, disabled: bool, loading: bool, selected: bool) -> StateFlags #export {
    flags: StateFlags
    flags.disabled = disabled || state == ButtonStateDisabled
    flags.loading = loading || state == ButtonStateLoading
    flags.selected = selected || state == ButtonStateSelected
    return flags
}

ResolveState :: (
    explicit_state: i32,
    disabled: bool,
    loading: bool,
    pressed: bool,
    hovered: bool,
    focused: bool,
    selected: bool
) -> i32 #export {
    if disabled { return ButtonStateDisabled }
    if loading { return ButtonStateLoading }
    if explicit_state != ButtonStateAuto { return explicit_state }
    if pressed { return ButtonStatePressed }
    if hovered { return ButtonStateHover }
    if focused { return ButtonStateFocus }
    if selected { return ButtonStateSelected }
    return ButtonStateNormal
}

InteractionState :: struct {
    state: i32
    hovered: bool
    pressed: bool
    focused: bool
}

# Activation is an action result, not a visual-state override. Explicit
# previews keep their resolved state even when a user activates the control.
ResolveInteraction :: (explicit_state: i32, disabled: bool, loading: bool,
    pressed: bool, hovered: bool, focused: bool, selected: bool) -> InteractionState #export {
    state: i32 = ResolveState(explicit_state, disabled, loading,
        pressed, hovered, focused, selected)
    interaction: InteractionState = (InteractionState){.state = state,
        .hovered = hovered, .pressed = pressed, .focused = focused}
    if explicit_state != ButtonStateAuto {
        interaction.hovered = state == ButtonStateHover
        interaction.pressed = state == ButtonStatePressed
        interaction.focused = state == ButtonStateFocus
    }
    return interaction
}

# Presence is separate from value: zero and transparent are valid overrides.

ControlStyleNone :: () -> ControlStyle #export {
    blank: Style
    blank.fields = StyleBackground | StyleBorder | StyleFocus |
                   StyleRadius | StyleBorderWidth | StylePaddingX |
                   StylePaddingY | StyleOpacity | StyleMaterial
    blank.background = (Color){0, 0, 0, 0}
    blank.border = (Color){0, 0, 0, 0}
    blank.focus = (Color){0, 0, 0, 0}
    blank.radius = 0.0
    blank.border_width = 0.0
    blank.padding_x = 0.0
    blank.padding_y = 0.0
    blank.opacity = 1.0
    blank.material = (MaterialKind)MaterialFlat

    style: ControlStyle
    style.normal = blank
    style.hover = blank
    style.pressed = blank
    style.focused = blank
    style.disabled = blank
    style.loading = blank
    style.selected = blank
    return style
}

# Default styles initialize all basic properties, without a gradient endpoint.
DefaultFields :: () -> u32 #export {
    return (u32)StyleBackground | (u32)StyleForeground | (u32)StyleBorder |
        (u32)StyleFocus | (u32)StyleRadius | (u32)StyleBorderWidth | (u32)StyleOpacity |
        (u32)StylePaddingX | (u32)StylePaddingY | (u32)StyleGap | (u32)StyleFontSize |
        (u32)StyleIconSize | (u32)StyleContentOffset | (u32)StyleMaterial
}


# Zero-initialized props use medium sizing. Unknown sizes use the same fallback.
# Selection belongs to shared style policy, not an individual widget.
SizeValue :: (size: i32, small: float, medium: float, large: float) -> float #export {
    if size == ControlSizeSmall { return small }
    if size == ControlSizeLarge { return large }
    return medium
}

# Resolve at the point of use. Preserve the original request so an inherited
# or styled size is not mistaken for an explicit font on the next frame.
ResolveFont :: (requested: i32, inherited: i32, fallback: i32) -> i32 #export {
    if requested > 0 { return requested }
    if inherited > 0 { return inherited }
    if fallback > 0 { return fallback }
    return 16
}

# Explicit dimensions win. Natural dimensions retain the theme minimum but
# expand to fit content and padding. Hosts pass all values in the same units.
FitHeight :: (requested: float, minimum: float, content: float, padding: float) -> float #export {
    if requested > 0.0 { return requested }
    if padding < 0.0 { padding = 0.0 }
    if content < 0.0 { content = 0.0 }
    height: float = content + 2.0 * padding
    if height < minimum { height = minimum }
    return height
}

# Padding defines the child layout area independently of the painted face.
# Explicit zero removes an inset; oversized padding leaves an empty area.
ContentBounds :: (width: float, height: float, padding_x: float, padding_y: float) -> Rectangle #export {
    box: Rectangle
    if padding_x < 0.0 { padding_x = 0.0 }
    if padding_y < 0.0 { padding_y = 0.0 }
    box.x = padding_x
    box.y = padding_y
    box.width = width - 2.0 * padding_x
    box.height = height - 2.0 * padding_y
    if box.width < 0.0 { box.width = 0.0 }
    if box.height < 0.0 { box.height = 0.0 }
    return box
}

# Packed colors and scalar values keep style policy independent of host types.
# A present field may contain zero or transparent; absence is only a mask bit.
# Physical child bounds from logical style insets. All hosts use the same
# empty-area clamp and scale fallback.
InsetBounds :: (bounds: Rectangle, padding_x: float, padding_y: float,
    scale: float) -> Rectangle #export {
    if scale <= 0.0 { scale = 1.0 }
    content: Rectangle = ContentBounds(bounds.width / scale, bounds.height / scale,
        padding_x, padding_y)
    result: Rectangle
    result.x = bounds.x + content.x * scale
    result.y = bounds.y + content.y * scale
    result.width = content.width * scale
    result.height = content.height * scale
    return result
}

# Explicitly positioned children keep their measured placement. Unpositioned
# children fill missing dimensions and center without consuming a layout cursor.
CenterChild :: (declared: Rectangle, measured: Rectangle, content: Rectangle) -> Rectangle #export {
    if declared.x != 0.0 || declared.y != 0.0 { return measured }
    if measured.width <= 0.0 { measured.width = content.width }
    if measured.height <= 0.0 { measured.height = content.height }
    measured.x = content.x + (content.width - measured.width) * 0.5
    measured.y = content.y + (content.height - measured.height) * 0.5
    return measured
}

StyleData :: struct {
    fields: u32
    background: u32
    foreground: u32
    border: u32
    focus: u32
    radius: float
    border_width: float
    opacity: float
    padding_x: float
    padding_y: float
    gap: float
    font_size: float
    icon_size: float
    offset_x: float
    offset_y: float
    background_end: u32
    material: i32
    typeface: string
}

# Layout metrics remain those of the resolved state. Paint properties use
# the same focus -> hover -> press precedence on every host.
TransitionValues :: (resolved: StyleData, normal: StyleData, hover: StyleData,
                     press: StyleData, focus: StyleData,
                     h: float, p: float, f: float) -> StyleData #export {
    resolved.background = InteractionColor(normal.background, hover.background, press.background, focus.background, h, p, f)
    resolved.foreground = InteractionColor(normal.foreground, hover.foreground, press.foreground, focus.foreground, h, p, f)
    resolved.border = InteractionColor(normal.border, hover.border, press.border, focus.border, h, p, f)
    resolved.focus = InteractionColor(normal.focus, hover.focus, press.focus, focus.focus, h, p, f)
    resolved.radius = InteractionValue(normal.radius, hover.radius, press.radius, focus.radius, h, p, f)
    resolved.border_width = InteractionValue(normal.border_width, hover.border_width, press.border_width, focus.border_width, h, p, f)
    resolved.opacity = InteractionValue(normal.opacity, hover.opacity, press.opacity, focus.opacity, h, p, f)
    resolved.offset_x = InteractionValue(normal.offset_x, hover.offset_x, press.offset_x, focus.offset_x, h, p, f)
    resolved.offset_y = InteractionValue(normal.offset_y, hover.offset_y, press.offset_y, focus.offset_y, h, p, f)
    return resolved
}

# A frame keeps the interpolated values and stateful gradient presence together.
# Hosts convert colors and submit drawing; they do not assemble two policies.
StyleFrame :: struct {
    value: StyleData
    fill: FillStates
}

TransitionFrame :: (resolved: StyleData, normal: StyleData, hover: StyleData,
                    press: StyleData, focus: StyleData,
                    h: float, p: float, f: float) -> StyleFrame #export {
    result: StyleFrame
    result.value = TransitionValues(resolved, normal, hover, press, focus, h, p, f)
    result.fill = FillTransition(
        FillState(normal.fields, normal.background, normal.background_end),
        FillState(hover.fields, hover.background, hover.background_end),
        FillState(press.fields, press.background, press.background_end),
        FillState(focus.fields, focus.background, focus.background_end), h, p, f)
    return result
}

MergeValues :: (base: StyleData, override: StyleData) -> StyleData #export {
    if (override.fields & (u32)StyleBackground) != (u32)0 { base.background = override.background }
    if (override.fields & (u32)StyleForeground) != (u32)0 { base.foreground = override.foreground }
    if (override.fields & (u32)StyleBorder) != (u32)0 { base.border = override.border }
    if (override.fields & (u32)StyleFocus) != (u32)0 { base.focus = override.focus }
    if (override.fields & (u32)StyleRadius) != (u32)0 { base.radius = override.radius }
    if (override.fields & (u32)StyleBorderWidth) != (u32)0 { base.border_width = override.border_width }
    if (override.fields & (u32)StyleOpacity) != (u32)0 { base.opacity = override.opacity }
    if (override.fields & (u32)StylePaddingX) != (u32)0 { base.padding_x = override.padding_x }
    if (override.fields & (u32)StylePaddingY) != (u32)0 { base.padding_y = override.padding_y }
    if (override.fields & (u32)StyleGap) != (u32)0 { base.gap = override.gap }
    if (override.fields & (u32)StyleFontSize) != (u32)0 { base.font_size = override.font_size }
    if (override.fields & (u32)StyleIconSize) != (u32)0 { base.icon_size = override.icon_size }
    if (override.fields & (u32)StyleContentOffset) != (u32)0 { base.offset_x = override.offset_x }
    if (override.fields & (u32)StyleContentOffset) != (u32)0 { base.offset_y = override.offset_y }
    if (override.fields & (u32)StyleBackgroundEnd) != (u32)0 { base.background_end = override.background_end }
    if (override.fields & (u32)StyleMaterial) != (u32)0 { base.material = override.material }
    if (override.fields & (u32)StyleTypeface) != (u32)0 { base.typeface = override.typeface }
    base.fields = base.fields | override.fields
    return base
}

StyleStates :: struct {
    normal: StyleData
    hover: StyleData
    pressed: StyleData
    focused: StyleData
    disabled: StyleData
    loading: StyleData
    selected: StyleData
}

# A widget carries one state-style value, independent of host representation.
ResolveValues :: (base: StyleData, states: StyleStates, state: i32) -> StyleData #export {
    base = MergeValues(base, states.normal)
    if state == ButtonStateHover { return MergeValues(base, states.hover) }
    if state == ButtonStatePressed { return MergeValues(base, states.pressed) }
    if state == ButtonStateFocus { return MergeValues(base, states.focused) }
    if state == ButtonStateDisabled { return MergeValues(base, states.disabled) }
    if state == ButtonStateLoading { return MergeValues(base, states.loading) }
    if state == ButtonStateSelected { return MergeValues(base, states.selected) }
    return base
}
