#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
#import "kryon/style_sheet"
using UI :: #import "kryon/Widgets";
#import "kryon/tooltip"
#import "kryon/tooltip_props"
#import "kryon/sheet"
#import "kryon/sheet_props"
#import "kryon/command_palette"
#import "kryon/command_palette_props"
#import "kryon/hover_card"
#import "kryon/hover_card_props"
#import "kryon/confirm_popover"
#import "kryon/confirm_popover_props"
#import "kryon/guided_tour"
#import "kryon/guided_tour_props"
#import "kryon/tooltip_common"

WidgetContext :: struct { theme: s32; now: float32; disabled: bool; reduced_motion: bool }

WidgetInput :: (session: Session) -> WidgetContext {
    snapshot := CaptureFrameInput(session)
    result: WidgetContext
    result.now = cast(float32)snapshot.elapsed_ms / 1000.0
    result.theme = ifx StyleTokenColor("canvas").r < 128 then 2 else 1
    result.disabled = example_disabled
    result.reduced_motion = example_reduced_motion
    return result
}

gallery_view: Rectangle = Rectangle.{.x = 0.0, .y = 0.0, .width = 480.0, .height = 320.0};

gallery_live: bool;

gallery_now: float32;

gallery_reduced_motion: bool;

SetGalleryViewport :: (view: Rectangle, live: bool, now: float32, reduced_motion: bool) {
    gallery_view = view; gallery_live = live; gallery_now = now
    gallery_reduced_motion = reduced_motion
}

GalleryBounds :: (bounds: Rectangle) -> Rectangle {
    if !gallery_live { return bounds }
    bounds.x = gallery_view.x + bounds.x * gallery_view.width / 480.0
    bounds.y += gallery_view.y
    bounds.width *= gallery_view.width / 480.0
    return bounds
}

viewport: Rectangle;

anchor: Rectangle;

tooltip_state: TooltipState;

sheet_state: SheetState;

palette_state: CommandPaletteState;

hover_state: HoverCardState;

confirm_state: ConfirmPopoverState;

tour_state: GuidedTourState;

commands: [3]CommandPaletteCommand;

tour_steps: [2]GuidedTourStep;

overlays_ready: bool;

live_pointer: OverlayPointer;

live_keys: OverlayKeyInput;

Prepare :: (session: Session, scene: s32) {
    viewport = GalleryBounds(Rectangle.{0.0, 0.0, 480.0, 320.0})
    anchor = GalleryBounds(Rectangle.{38.0, 128.0, 126.0, 34.0})
    if !overlays_ready {
        tooltip_state = TooltipStateFor(700)
        sheet_state = SheetStateFor()
        palette_state = CommandPaletteStateFor(701)
        hover_state = HoverCardStateFor()
        confirm_state = ConfirmPopoverStateFor()
        tour_state = GuidedTourStateFor(0)
        commands[0] = .{.title = "Find component", .group = "Search", .shortcut = "Ctrl+F", .action = 11}
        commands[1] = .{.title = "Format source", .group = "Edit", .shortcut = "Ctrl+Shift+F", .action = 12}
        commands[2] = .{.title = "Focus outline", .group = "Accessibility", .action = 13}
        tour_steps[0] = .{.target_key = 710, .target = GalleryBounds(Rectangle.{168.0, 112.0, 144.0, 42.0}), .title = "Highlight the target", .body = "The scrim leaves the current control available.", .placement = .OverlayPlaceBottomStart}
        tour_steps[1] = .{.target_key = 711, .target = GalleryBounds(Rectangle.{168.0, 180.0, 144.0, 42.0}), .title = "Finish the tour", .body = "Back, Next, Done, and Skip are explicit actions.", .placement = .OverlayPlaceTopStart}
        overlays_ready = true
    }
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := WidgetInput(session)
    SetGalleryViewport(viewport, true, example_input.now, example_input.reduced_motion)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{viewport.x + 24.0, viewport.y + 12.0, viewport.width - 48.0, 36.0}, .text = "Tooltip", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 0
    Prepare(session, scene)
    if gallery_live {
        pointer := PointerSample(session)
        live_pointer = .{.x = pointer.x, .y = pointer.y, .down = pointer.down,
            .pressed = pointer.pressed, .released = pointer.released,
            .over_anchor = PointInBounds(pointer.x, pointer.y, anchor)}
        live_keys = .{}
        if scene != 2 {
            key := KeyboardTake(session)
            live_keys.escape = key == KeyEscape; live_keys.enter = key == KeyEnter
            live_keys.left = key == KeyLeft; live_keys.right = key == KeyRight
        }
        tour_steps[0].target = GalleryBounds(Rectangle.{168.0, 112.0, 144.0, 42.0})
        tour_steps[1].target = GalleryBounds(Rectangle.{168.0, 180.0, 144.0, 42.0})
    }
    Text(session, TextProps.{.key = 700, .bounds = anchor, .text = "Save source", .font = 17})
    props: TooltipProps = .{.key = 701, .anchor = anchor, .viewport = viewport,
        .text = "Save the maintained Ziran source", .shortcut = "Ctrl+S",
        .placement = .OverlayPlaceBottom, .gap = 8.0, .max_width = 240.0,
        .delay_ms = 400.0, .passive_delay_ms = 800.0, .warm_ms = 250.0,
        .now_ms = 0, .disabled = disabled, .style = TooltipDefaultStyle()}
    if gallery_live {
        props.pointer = live_pointer; props.now_ms = cast(s64)(gallery_now * 1000.0)
        props.style.motion_reduced = gallery_reduced_motion
    } else {
        props.pointer.over_anchor = true
        unused TooltipApply(*tooltip_state, props)
        props.now_ms = 500
    }
    unused Tooltip(session, props, *tooltip_state)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
