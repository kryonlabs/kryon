#import "page_core"
#import "page_input"
#import "canvas_events"
#import "canvas_input"
#import "gamepad_navigation"

Step :: () { CanvasGamepadPoll() }
Take :: () -> s32 { return CanvasAppKeyTake() }
Focus :: (focused: bool) {
    unused CanvasEvent(ifx focused then CanvasEventFocus else CanvasEventBlur, 0, 0, 0.0, 0.0, null, null)
}
#program_export
main :: () -> s32 {
    CanvasEventsReset()
    available[0] = true
    Step()
    if Take() != 0 { return 1 }
    native: [8]s32 = .{1, 3, 4, 2, 7, 6, 15, 13}
    expected: [8]s32 = .{265, 264, 263, 262, 257, 256, 77, 290}
    for at: cast(s32)0..7 {
        buttons[0][native[at]] = true
        Step()
        if Take() != expected[at] || Take() != 0 { return 10 + at }
        Step()
        if Take() != 0 { return 20 + at }
        buttons[0][native[at]] = false
        Step()
    }
    // Existing keyboard and repeat queues have priority; an unread gamepad
    // press survives frame cleanup and does not invent another press.
    unused CanvasKeyDown("KeyK", "k", false, false)
    buttons[0][7] = true
    Step()
    if Take() != 75 { return 30 }
    CanvasEventsBeginFrame()
    CanvasEventsEndFrame()
    Step()
    if Take() != 257 || Take() != 0 { return 31 }
    buttons[0][7] = false
    Step()
    unused CanvasKeyDown("KeyK", "k", true, false)
    buttons[0][6] = true
    Step()
    if Take() != 75 || Take() != 256 { return 32 }
    // Left stick has a dead zone and delivers one edge per direction.
    axes[0][0] = -0.49
    Step()
    if Take() != 0 { return 40 }
    axes[0][0] = -0.8
    Step()
    if Take() != 263 { return 41 }
    Step()
    if Take() != 0 { return 42 }
    axes[0][0] = 0.8
    axes[0][1] = -0.8
    Step()
    if Take() != 265 || Take() != 262 || Take() != 0 { return 43 }
    axes[0][0] = 0.0
    axes[0][1] = 0.8
    Step()
    if Take() != 264 { return 44 }
    axes[0][1] = 0.0
    Step()
    // Four pads are sampled; a fifth is neither queried nor delivered.
    for pad: cast(s32)0..4 { available[pad] = true }
    buttons[4][15] = true
    Step()
    if Take() != 0 || max_pad > 3 { return 50 }
    buttons[3][15] = true
    Step()
    if Take() != 77 { return 51 }
    available[3] = false
    Step()
    if Take() != 0 || (canvas_gamepad_navigation.held & (cast(u32)1 << 9)) != cast(u32)0 { return 52 }
    available[3] = true
    Step()
    if Take() != 77 { return 53 }
    // Blur cancels an already queued controller shortcut synchronously.
    buttons[0][1] = true
    Step()
    Focus(false)
    if Take() != 0 { return 60 }
    Step()
    buttons[1][7] = true
    Step()
    if Take() != 0 || canvas_gamepad_navigation.held != cast(u32)0 { return 61 }
    Focus(true)
    Step()
    if Take() != 0 { return 62 }
    canvas_snapshot_focus_lost = false
    Step()
    if Take() != 0 { return 63 }
    buttons[1][7] = false
    Step()
    buttons[1][7] = true
    Step()
    if Take() != 257 { return 64 }
    // Loss/regain between polls is equally safe.
    Focus(false)
    Focus(true)
    buttons[2][15] = true
    Step()
    if Take() != 0 { return 65 }
    CanvasEventsReset()
    if Take() != 0 || canvas_gamepad_navigation.count != 0 { return 66 }
    return 0
}
