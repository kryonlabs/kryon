#module "paned_view"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "paned_view_props"
#import "style"
#import "style_sheet"
#import "paint_queue"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

PanedViewMetrics :: struct {
    grip: i32
    drop_edge: i32
}

PanedViewLayout :: struct {
    size: i32
    limit: i32
    split: i32
    handle: Rectangle
}

PanedViewDragDecision :: struct {
    clear_active: bool
    start_drag: bool
    drag_active: bool
}

PanedViewHandleRole :: () -> i32 #export {
    return 12
}

PanedViewHandleFactsFor :: (class_name: i32, state: i32) -> StyleFacts #export {
    return StyleControlRoleFacts(StyleKindPanedView(), 0, class_name,
        PanedViewHandleRole(), ButtonToneNeutral, ButtonEmphasisSoft,
        ControlSizeMedium, state)
}

PanedViewMetric :: (fields: u32, field: u32, value: float, fallback: float, scale: float) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return (i32)(value * scale)
}

PanedViewMetricsFor :: (scale: float, handle: StyleFrame) -> PanedViewMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: PanedViewMetrics
    metrics.grip = PanedViewMetric(handle.value.fields, (u32)StyleIconSize,
        handle.value.icon_size, 8.0, scale)
    metrics.drop_edge = PanedViewMetric(handle.value.fields, (u32)StylePaddingX,
        handle.value.padding_x, 46.0, scale)
    return metrics
}

PanedViewSize :: (bounds: Rectangle, vertical: bool) -> i32 #export {
    size: i32 = (i32)bounds.height
    if vertical { size = (i32)bounds.width }
    if size < 0 { return 0 }
    return size
}

PanedViewLimit :: (size: i32, min_first: i32, min_second: i32) -> i32 #export {
    if size < 0 { size = 0 }
    if min_first < 0 { min_first = 0 }
    if min_first > size { min_first = size }
    if min_second < 0 { min_second = 0 }
    limit: i32 = size - min_second
    if limit < min_first { limit = min_first }
    return limit
}

PanedViewClampSplit :: (split: i32, min_first: i32, limit: i32) -> i32 #export {
    if min_first < 0 { min_first = 0 }
    if limit < min_first { limit = min_first }
    if split < min_first { return min_first }
    if split > limit { return limit }
    return split
}

PanedViewDefaultSplit :: (limit: i32) -> i32 #export {
    return limit / 2
}

PanedViewSplitFor :: (current_split: i32, has_split: bool,
    size: i32, min_first: i32, min_second: i32) -> i32 #export {
    if min_first > size { min_first = size }
    limit: i32 = PanedViewLimit(size, min_first, min_second)
    split: i32 = current_split
    if !has_split { split = PanedViewDefaultSplit(limit) }
    return PanedViewClampSplit(split, min_first, limit)
}

PanedViewPointerSplit :: (bounds: Rectangle, vertical: bool,
    pointer_x: float, pointer_y: float) -> i32 #export {
    if vertical { return (i32)(pointer_x - bounds.x) }
    return (i32)(pointer_y - bounds.y)
}

PanedViewPointerSplitFor :: (bounds: Rectangle, vertical: bool,
    pointer_x: float, pointer_y: float, min_first: i32,
    min_second: i32) -> i32 #export {
    size: i32 = PanedViewSize(bounds, vertical)
    if min_first > size { min_first = size }
    limit: i32 = PanedViewLimit(size, min_first, min_second)
    split: i32 = PanedViewPointerSplit(bounds, vertical, pointer_x,
        pointer_y)
    return PanedViewClampSplit(split, min_first, limit)
}

PanedViewHandleFor :: (bounds: Rectangle, vertical: bool,
    split: i32, metrics: PanedViewMetrics) -> Rectangle #export {
    handle: Rectangle
    half: float = (float)metrics.grip * 0.5
    if vertical {
        handle.x = bounds.x + (float)split - half
        handle.y = bounds.y
        handle.width = (float)metrics.grip
        handle.height = bounds.height
    } else {
        handle.x = bounds.x
        handle.y = bounds.y + (float)split - half
        handle.width = bounds.width
        handle.height = (float)metrics.grip
    }
    return handle
}

PanedViewLayoutFor :: (bounds: Rectangle, vertical: bool,
    current_split: i32, has_split: bool, min_first: i32, min_second: i32,
    metrics: PanedViewMetrics) -> PanedViewLayout #export {
    layout: PanedViewLayout
    layout.size = PanedViewSize(bounds, vertical)
    if min_first > layout.size { min_first = layout.size }
    layout.limit = PanedViewLimit(layout.size, min_first, min_second)
    layout.split = current_split
    if !has_split {
        layout.split = PanedViewDefaultSplit(layout.limit)
    }
    layout.split = PanedViewClampSplit(layout.split, min_first, layout.limit)
    layout.handle = PanedViewHandleFor(bounds, vertical, layout.split,
        metrics)
    return layout
}

PanedViewChanged :: (previous_split: i32, next_split: i32,
    has_split: bool) -> bool #export {
    if !has_split { return false }
    return previous_split != next_split
}

PanedViewDragFor :: (has_active: bool, active_is_current: bool,
    owner_captured: bool, mouse_down: bool, disabled: bool, has_split: bool,
    handle_hot: bool, mouse_pressed: bool) -> PanedViewDragDecision #export {
    decision: PanedViewDragDecision
    if has_active && owner_captured {
        decision.clear_active = true
    }
    if has_active && !mouse_down {
        decision.clear_active = true
    }
    if disabled && active_is_current {
        decision.clear_active = true
    }
    has_active = has_active && !decision.clear_active
    active_is_current = active_is_current && !decision.clear_active
    if !decision.clear_active && !disabled && has_split && handle_hot &&
        mouse_down && mouse_pressed {
        decision.start_drag = true
        active_is_current = true
    }
    decision.drag_active = active_is_current || decision.start_drag
    return decision
}

PanedViewDropZoneFor :: (bounds: Rectangle, mouse: Vector2,
    metrics: PanedViewMetrics) -> i32 #export {
    if mouse.x < bounds.x || mouse.x > bounds.x + bounds.width ||
       mouse.y < bounds.y || mouse.y > bounds.y + bounds.height {
        return DropNone
    }
    edge: i32 = metrics.drop_edge
    if edge < 0 { edge = 0 }
    if mouse.x < bounds.x + (float)edge { return DropLeft }
    if mouse.x > bounds.x + bounds.width - (float)edge { return DropRight }
    if mouse.y < bounds.y + (float)edge { return DropTop }
    if mouse.y > bounds.y + bounds.height - (float)edge { return DropBottom }
    return DropCenter
}

PanedViewFace :: (class_name: i32, disabled: bool) -> StyleFrame #export {
    defaults: StyleData
    defaults.fields = (u32)StyleBackground | (u32)StyleRadius |
        (u32)StyleOpacity | (u32)StyleIconSize |
        (u32)StylePaddingX
    defaults.background = (u32)0x9ca3afff
    defaults.radius = 4.0
    defaults.opacity = 1.0
    defaults.icon_size = 8.0
    defaults.padding_x = 46.0
    if disabled { defaults.opacity = 0.45 }
    state: i32 = ButtonStateNormal
    if disabled { state = ButtonStateDisabled }
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), defaults,
        PanedViewHandleFactsFor(class_name, state), state)
    return frame
}

PanedViewHandleKey :: () -> u64 #export {
    return (u64)1
}

PaneBounds :: struct {
    first: Rectangle
    second: Rectangle
}

PanedViewPanesFor :: (bounds: Rectangle, handle: Rectangle,
    vertical: bool) -> PaneBounds #export {
    panes: PaneBounds
    panes.first = bounds
    panes.second = bounds
    if vertical {
        panes.first.width = handle.x - bounds.x
        panes.second.x = handle.x + handle.width
        panes.second.width = bounds.x + bounds.width - panes.second.x
        if panes.first.width < 0.0 { panes.first.width = 0.0 }
        if panes.second.width < 0.0 { panes.second.width = 0.0 }
    } else {
        panes.first.height = handle.y - bounds.y
        panes.second.y = handle.y + handle.height
        panes.second.height = bounds.y + bounds.height - panes.second.y
        if panes.first.height < 0.0 { panes.first.height = 0.0 }
        if panes.second.height < 0.0 { panes.second.height = 0.0 }
    }
    return panes
}

PaneDropZone :: (bounds: Rectangle, mouse: Vector2, scale: float,
    class_name: i32) -> DropZone #export {
    face: StyleFrame = PanedViewFace(class_name, false)
    metrics: PanedViewMetrics = PanedViewMetricsFor(scale, face)
    return (DropZone)PanedViewDropZoneFor(bounds, mouse, metrics)
}

# The caller stores the returned split and places its pane content in the
# returned rectangles. The handle uses the retained pointer drag route.
PanedView :: (props: PanedViewProps) -> PanedViewResult #export {
    result: PanedViewResult
    result.node = -1
    bounds: Rectangle = props.bounds
    parent: Rectangle = TreeCurrentParentBounds()
    if bounds.width <= 0.0 { bounds.width = parent.width }
    if bounds.height <= 0.0 { bounds.height = parent.height }
    scale: float = props.scale
    if scale <= 0.0 { scale = 1.0 }
    face: StyleFrame = PanedViewFace(props.class_name, props.disabled)
    metrics: PanedViewMetrics = PanedViewMetricsFor(scale, face)
    key: u64 = props.key
    if key == (u64)0 && props.id > 0 { key = (u64)(u32)props.id }
    if key == (u64)0 { key = TreeNextKey() }
    if TreeIsBuilding() {
        result.node = TreeSubmitCurrent(key, WidgetKindPanedView, bounds)
        if result.node < 0 { return result }
        bounds = TreeSubmittedNodeAt(result.node).bounds
    }
    layout: PanedViewLayout = PanedViewLayoutFor(bounds, props.vertical,
        props.split, props.has_split, props.min_first,
        props.min_second, metrics)
    if TreeIsBuilding() && props.has_split && !props.disabled {
        previous: i32 = TreeFind(PanedViewHandleKey(), key,
            WidgetKindSlider)
        drag: PointerDrag = TreeTakeDragAt(previous)
        if drag.active || drag.ended {
            pointer_x: float = drag.x - drag.grab_x +
                (float)metrics.grip * 0.5
            pointer_y: float = drag.y - drag.grab_y +
                (float)metrics.grip * 0.5
            layout.split = PanedViewPointerSplitFor(bounds,
                props.vertical, pointer_x, pointer_y,
                props.min_first, props.min_second)
            layout.handle = PanedViewHandleFor(bounds, props.vertical,
                layout.split, metrics)
        }
    }
    result.split = layout.split
    result.changed = PanedViewChanged(props.split, result.split,
        props.has_split)
    result.handle = RectangleIntersection(layout.handle, bounds)
    panes: PaneBounds = PanedViewPanesFor(bounds, result.handle,
        props.vertical)
    result.first = panes.first
    result.second = panes.second
    handle_node: i32 = -1
    if TreeIsBuilding() {
        handle_node = TreeSubmit(PanedViewHandleKey(), result.node,
            WidgetKindSlider, result.handle)
        TreeSetInteractive(handle_node,
            props.disabled || !props.has_split, false, props.id)
    }
    if result.handle.width > 0.0 && result.handle.height > 0.0 {
        PaintRoundedFill(handle_node, result.handle,
            face.value.radius, 12,
            ColorFromPacked(Opacity(face.value.background,
                StyleOpacityValue(face.value.fields,
                    face.value.opacity))))
    }
    return result
}
