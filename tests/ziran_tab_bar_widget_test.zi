#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "geometry"
#import "scroll_device"
#import "semantic"
#import "tab_bar"
#import "tab_bar_props"
#import "tab_bar_widget"
#import "tree"
#import "tree_input"
#import "ziran_widget_noop_host"

using SemanticKind;

phase: s32;
selected: s32;
scroll_offset: s32;
dragging: bool;
drag_from: s32;
last_clicked_index: s32;
last_clicked_at: float32;
last_click_valid: bool;
selected_bounds: Rectangle;

Click :: (x: float32, y: float32) {
    TreePointerUpdate(TestSession(), PointerFrame.{x, y,
            true, true, false})
    TreePointerUpdate(TestSession(), PointerFrame.{x, y,
            false, false, true})
}

CloseBounds :: () -> Rectangle {
    index: s32 = 0
    while index < TreeCount(TestSession()) {
        if TreeNodeAt(TestSession(), index).semantic_label == "Close tab" {
            return TreeNodeAt(TestSession(), index).bounds
        }
        index += 1
    }
    return Rectangle.{0.0, 0.0, 0.0, 0.0}
}

#program_export
Frame :: () -> s32 {
    tabs: [4]Tab
    tabs[0].key = cast(u64)10
    tabs[0].label = "Home"
    tabs[1].key = cast(u64)11
    tabs[1].label = "Editor"
    tabs[1].closeable = true
    tabs[2].key = cast(u64)12
    tabs[2].label = "Hidden"
    tabs[2].disabled = true
    tabs[3].key = cast(u64)13
    tabs[3].label = "Build"
    tabs[3].closeable = true
    props: TabBarProps
    props.key = cast(u64)77
    props.bounds = Rectangle.{20.0, 20.0, 240.0, 36.0}
    props.selected_index = selected
    props.scroll_offset = scroll_offset
    props.dragging = dragging
    props.drag_from = drag_from
    props.last_clicked_index = last_clicked_index
    props.last_clicked_at = last_clicked_at
    props.last_click_valid = last_click_valid
    props.id = 77
    props.reorder_enabled = true
    props.input.now = cast(float32)phase * 0.1
    if phase == 3 {
        props.input.focused = true
        props.input.right = true
    }
    if phase == 4 {
        props.input.focused = true
        props.input.close = true
    }
    if phase == 5 {
        props.input.middle_click = true
        props.input.middle_x = selected_bounds.x +
        selected_bounds.width * 0.5
        props.input.middle_y = 38.0
    }
    if phase == 12 { props.input.scroll_delta = -40 }
    if phase == 13 { props.focus_selected = true }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 100.0})
    result: TabBarResult = TabBar(TestSession(), props, tabs[0:4])
    if !TreeFinish(TestSession()) || result.node != 1 ||
    TreeNodeAt(TestSession(), result.node).semantic_kind !=
    cast(SemanticKind)SemanticTabList { return -20 }
    if phase == 0 {
        if result.selected_index != 0 ||
        result.activated_index != -1 ||
        TabBarHeight() != 32 { return -1 }
        Click(180.0, 38.0)
    } else if phase == 1 {
        if result.selected_index != 1 ||
        result.activated_index != 1 ||
        result.scroll_offset <= 0 { return -2 }
        close: Rectangle = CloseBounds()
        if close.width <= 0.0 { return -21 }
        Click(close.x + close.width * 0.5,
            close.y + close.height * 0.5)
    } else if phase == 2 {
        if result.closed_index != 1 ||
        result.activated_index != -1 ||
        result.selected_index != 1 { return -3 }
    } else if phase == 3 {
        if result.selected_index != 3 ||
        result.activated_index != 3 ||
        result.scroll_offset <= scroll_offset ||
        result.selected_tab_bounds.x < 20.0 ||
        result.selected_tab_bounds.x +
        result.selected_tab_bounds.width > 260.0 {
            return -4
        }
    } else if phase == 4 {
        if result.closed_index != 3 ||
        result.activated_index != -1 { return -5 }
    } else if phase == 5 {
        if result.middle_clicked_index != 3 ||
        result.selected_index != 3 { return -6 }
    } else if phase == 6 {
        if result.activated_index != -1 { return -7 }
        Click(selected_bounds.x +
            selected_bounds.width * 0.5, 38.0)
    } else if phase == 7 {
        if result.activated_index != 3 ||
        result.double_clicked_index != -1 { return -8 }
        Click(selected_bounds.x +
            selected_bounds.width * 0.5, 38.0)
    } else if phase == 8 {
        if result.double_clicked_index != 3 { return -9 }
        TreePointerUpdate(TestSession(), PointerFrame.{
                selected_bounds.x + selected_bounds.width * 0.5,
                38.0, true, true, false})
    } else if phase == 9 {
        if result.dragging || result.reordered_from != -1 {
            return -10
        }
        TreePointerUpdate(TestSession(), PointerFrame.{-300.0, 38.0,
                true, false, false})
    } else if phase == 10 {
        if !result.dragging || result.drag_from != 3 ||
        result.drag_to != 0 { return -11 }
        TreePointerUpdate(TestSession(), PointerFrame.{-300.0, 38.0,
                false, false, true})
    } else if phase == 11 {
        if result.reordered_from != 3 ||
        result.reordered_to != 0 ||
        result.activated_index != -1 { return -12 }
    } else if phase == 12 {
        if result.scroll_offset != scroll_offset - 40 ||
        result.selected_index != 3 { return -13 }
        Click(100.0, 38.0)
    } else if phase == 13 {
        if result.activated_index != -1 ||
        result.selected_index != 3 ||
        result.scroll_offset <= scroll_offset {
            return -14
        }
    }
    selected = result.selected_index
    scroll_offset = result.scroll_offset
    dragging = result.dragging
    drag_from = result.drag_from
    last_clicked_index = result.last_clicked_index
    last_clicked_at = result.last_clicked_at
    last_click_valid = result.last_click_valid
    selected_bounds = result.selected_tab_bounds
    old: s32 = phase
    phase += 1
    return old
}

swipe_seconds: float64 = 10.0;

// One frame of a host that gives the pointer to the tree and the scroll
// device before it draws, as a phone's does.
SwipeFrame :: (props: *TabBarProps, tabs: []Tab, x: float32, down: bool,
    pressed: bool, released: bool) -> TabBarResult {
    TreePointerUpdate(TestSession(), PointerFrame.{x, 38.0, down, pressed, released})
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 600.0, 100.0})
    BeginScrollFrame(TestSession(), Vector2.{x, 38.0}, pressed, down, released, 0.0,
        swipe_seconds)
    result: TabBarResult = TabBar(TestSession(), props.*, tabs)
    unused TreeFinish(TestSession())
    swipe_seconds += 0.016
    props.selected_index = result.selected_index
    props.scroll_offset = result.scroll_offset
    return result
}

// The middle of a tab's part in view, or -1 while none of it shows.
TabCenter :: (label: string) -> float32 {
    index: s32 = 0
    while index < TreeCount(TestSession()) {
        node := TreeNodeAt(TestSession(), index)
        if node.semantic_label == label {
            return node.bounds.x + node.bounds.width * 0.5
        }
        index += 1
    }
    return -1.0
}

// Tabs that do not all fit follow a swipe: the drag scrolls them and
// selects none. A tap still selects the tab under it, which then shows
// with a peek of the tab after it.
Swipe :: () -> s32 {
    if TabBarRevealPeek(200.0, 120.0, 1.0) != 32.0 ||
    TabBarRevealPeek(140.0, 120.0, 1.0) != 10.0 ||
    TabBarRevealPeek(100.0, 120.0, 1.0) != 0.0 ||
    TabBarRevealPeek(400.0, 100.0, 2.0) != 64.0 {
        return 11
    }
    row: [5]Tab = .[Tab.{.label = "Installed"}, Tab.{.label = "Meditation"},
        Tab.{.label = "Yoga"}, Tab.{.label = "Martial arts"}, Tab.{.label = "Breathing"}]
    props: TabBarProps
    props.key = cast(u64)900
    // Clear of the disabled bar's wheel above, which nothing took.
    props.bounds = Rectangle.{100.0, 20.0, 200.0, 40.0}
    props.content_sized = true
    rest := SwipeFrame(*props, row[:], 280.0, false, false, false)
    if rest.scroll_offset != 0 || rest.selected_index != 0 {
        return 5
    }
    unused SwipeFrame(*props, row[:], 280.0, true, true, false)
    x: float32 = 280.0
    while x > 160.0 {
        x -= 20.0
        moved := SwipeFrame(*props, row[:], x, true, false, false)
        if moved.activated_index != -1 || moved.selected_index != 0 {
            return 6
        }
    }
    // The finger rests before it lifts, so the tabs do not coast.
    still: s32 = 0
    while still < 20 {
        unused SwipeFrame(*props, row[:], x, true, false, false)
        still += 1
    }
    lifted := SwipeFrame(*props, row[:], x, false, false, true)
    if lifted.activated_index != -1 || lifted.selected_index != 0 ||
    lifted.scroll_offset < 60 {
        return 7
    }
    swiped: s32 = lifted.scroll_offset
    after := SwipeFrame(*props, row[:], x, false, false, false)
    if after.scroll_offset != swiped || after.activated_index != -1 {
        return 12
    }
    // The tab cut off at the right edge, which has another after it.
    edge: s32 = -1
    index: s32 = 0
    while index < 5 {
        if TabCenter(row[index].label) >= 0.0 {
            edge = index
        }
        index += 1
    }
    if edge < 1 || edge > 3 {
        return 8
    }
    tap_x: float32 = TabCenter(row[edge].label)
    unused SwipeFrame(*props, row[:], tap_x, true, true, false)
    tapped := SwipeFrame(*props, row[:], tap_x, false, false, true)
    if tapped.activated_index != edge || tapped.selected_index != edge {
        return 9
    }
    right: float32 = tapped.selected_tab_bounds.x + tapped.selected_tab_bounds.width
    if tapped.selected_tab_bounds.x < 100.0 || right > 300.0 - 31.0 {
        return 10
    }
    unused SwipeFrame(*props, row[:], tap_x, false, false, false)
    if TabCenter(row[edge + 1].label) < 0.0 {
        return 13
    }
    return 0
}

#program_export
main :: () -> s32 {
    index: s32 = 0
    while index < 14 {
        if Frame() != index { return 1 }
        index += 1
    }
    tabs: [2]Tab = .[Tab.{.label = "Home"}, Tab.{.label = "Work"}]
    props: TabBarProps
    props.key = cast(u64)800
    props.bounds = Rectangle.{20.0, 20.0, 500.0, 40.0}
    props.content_sized = true
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 600.0, 100.0})
    compact := TabBar(TestSession(), props, tabs[:])
    if !TreeFinish(TestSession()) || compact.selected_tab_bounds.width >= 250.0 {
        return 2
    }
    props.bounds.width = 100.0
    PointerWheelSend(TestSession(), 30.0, 30.0, -1.0)
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 600.0, 100.0})
    overflow := TabBar(TestSession(), props, tabs[:])
    if !TreeFinish(TestSession()) || overflow.scroll_offset != 40 {
        return 3
    }
    props.disabled = true
    PointerWheelSend(TestSession(), 30.0, 30.0, -1.0)
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 600.0, 100.0})
    disabled := TabBar(TestSession(), props, tabs[:])
    if !TreeFinish(TestSession()) || disabled.scroll_offset != 0 {
        return 4
    }
    return Swipe()
}
