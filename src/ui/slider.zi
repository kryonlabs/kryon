#import "button"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style"
#import "surface"
#import "slider_props"

using MaterialKind;
using StyleField;

SliderSpec :: struct {
    bounds: Rectangle
    ratio: float32
    vertical: bool
    active: bool
    hovered: bool
    disabled: bool
    scale: float32
    track: StyleFrame
    active_track: StyleFrame
    thumb: StyleFrame
}

SliderPaint :: struct {
    bounds: Rectangle
    track_bounds: Rectangle
    active_bounds: Rectangle
    thumb_x: float32
    thumb_y: float32
    thumb_radius: float32
    glow_radius: float32
    thumb_shadow_x: float32
    thumb_shadow_y: float32
    thumb_shadow_radius: float32
    thumb_highlight_x: float32
    thumb_highlight_y: float32
    thumb_highlight_radius: float32
    glow_color: u32
    thumb_fill_color: u32
    thumb_edge_color: u32
    thumb_shadow_color: u32
    thumb_highlight_color: u32
    track: StyleFrame
    active_track: StyleFrame
    thumb: StyleFrame
}
SliderRatioDecision :: struct {
    clear_active: bool
    start_active: bool
    update_ratio: bool
    finish_active: bool
}
// The header belongs to the widget. Only the interaction row is inset for
// optional step buttons; labels always start at the outer bounds.
SliderLayout :: struct {
    bounds: Rectangle
    label: Rectangle
    value: Rectangle
    track: Rectangle
    decrement: Rectangle
    increment: Rectangle
    limits: Rectangle
}

#program_export
SliderLayoutFor :: (bounds: Rectangle, line_height: float32, label_height: float32,
    value_width: float32, scale: float32, multiple: bool, vertical: bool,
    step_buttons: bool, show_limits: bool) -> SliderLayout {
    layout: SliderLayout
    if scale <= 0.0 { scale = 1.0 }
    gap := 12.0 * scale
    target := 48.0 * scale
    label_width := bounds.width - value_width - gap
    if label_width < 1.0 { label_width = 1.0 }
    header := line_height
    if label_height > header { header = label_height }
    layout.label.x = bounds.x
    layout.label.y = bounds.y
    layout.label.width = label_width
    layout.label.height = label_height
    layout.value.x = bounds.x + bounds.width - value_width
    layout.value.y = bounds.y
    layout.value.width = value_width
    layout.value.height = line_height
    if multiple && label_height > 0.0 {
        layout.label.width = bounds.width
        layout.value.y += label_height + gap
        header = label_height + gap + line_height
    }
    footer: float32 = 0.0
    if show_limits { footer = line_height + 4.0 * scale }
    extra: float32 = 0.0
    if !vertical && step_buttons && bounds.width < target * 3.0 + gap * 2.0 {
        extra = target + gap
    }
    minimum := header + gap + target + footer + extra
    if bounds.height < minimum { bounds.height = minimum }
    layout.bounds = bounds
    layout.track.x = bounds.x
    layout.track.y = bounds.y + header + gap
    layout.track.width = bounds.width
    layout.track.height = bounds.height - header - gap - footer - extra
    if !vertical && step_buttons {
        // At very narrow widths retain useful controls and grow vertically.
        if bounds.width < target * 3.0 + gap * 2.0 {
            layout.decrement.x = bounds.x
            layout.decrement.y = layout.track.y
            layout.decrement.width = target
            layout.decrement.height = target
            layout.increment.x = bounds.x + bounds.width - target
            layout.increment.y = layout.track.y
            layout.increment.width = target
            layout.increment.height = target
            layout.track.y += target + gap
        } else {
            layout.decrement.x = bounds.x
            layout.decrement.y = layout.track.y
            layout.decrement.width = target
            layout.decrement.height = target
            layout.increment.x = bounds.x + bounds.width - target
            layout.increment.y = layout.track.y
            layout.increment.width = target
            layout.increment.height = target
            layout.track.x += target + gap
            layout.track.width -= (target + gap) * 2.0
        }
    }
    layout.limits.x = layout.track.x
    layout.limits.y = layout.track.y + layout.track.height +
        4.0 * scale
    layout.limits.width = layout.track.width
    layout.limits.height = line_height
    return layout
}
#program_export
SliderLabelInsetForStyle :: (label: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(label.value.fields, cast(u32)StylePaddingX,
        label.value.padding_x, 6.0, scale, true)
}
#program_export
SliderTrackRole :: () -> s32 {
    return 4
}

#program_export
SliderFillRole :: () -> s32 {
    return 5
}

#program_export
SliderLabelRole :: () -> s32 {
    return 6
}
#program_export
SliderCellBoundsFor :: (bounds: Rectangle, count: s32, index: s32) -> Rectangle {
    cell: Rectangle
    if count <= 0 { return cell }
    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }
    cell.x = bounds.x + bounds.width * cast(float32)index / cast(float32)count
    cell.y = bounds.y
    cell.width = bounds.width / cast(float32)count
    cell.height = bounds.height
    return cell
}

SliderMetric :: (fields: u32, field: u32, value: float32, fallback: float32,
    scale: float32, allow_zero: bool) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

SliderMetricFloat :: (fields: u32, field: u32, value: float32, fallback: float32,
    scale: float32, allow_zero: bool) -> float32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return value * scale
}

#program_export
SliderMinimumLengthForStyle :: (track: StyleFrame, scale: float32) -> s32 {
    return SliderMetric(track.value.fields, cast(u32)StylePaddingX,
        track.value.padding_x, 32.0, scale, false)
}

#program_export
SliderThumbSizeForStyle :: (thumb: StyleFrame, scale: float32) -> s32 {
    return SliderMetric(thumb.value.fields, cast(u32)StyleIconSize,
        thumb.value.icon_size, 22.0, scale, false)
}

#program_export
SliderTrackSizeForStyle :: (vertical: bool, track: StyleFrame,
    scale: float32) -> s32 {
    if vertical {
        return SliderMetric(track.value.fields, cast(u32)StyleIconSize,
            track.value.icon_size, 8.0, scale, false)
    }
    return SliderMetric(track.value.fields, cast(u32)StylePaddingY,
        track.value.padding_y, 6.0, scale, false)
}
#program_export
SliderGlowExpansionForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StyleGap,
        thumb.value.gap, 8.0, scale, true)
}

#program_export
SliderThumbShadowOffsetXForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StyleContentOffset,
        thumb.value.offset_x, 0.0, scale, true)
}

#program_export
SliderThumbShadowOffsetYForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StyleContentOffset,
        thumb.value.offset_y, 2.0, scale, true)
}

#program_export
SliderThumbShadowExpansionForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StyleBorderWidth,
        thumb.value.border_width, 1.0, scale, true)
}

#program_export
SliderThumbHighlightOffsetXForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StylePaddingX,
        thumb.value.padding_x, -3.0, scale, true)
}

#program_export
SliderThumbHighlightOffsetYForStyle :: (thumb: StyleFrame, scale: float32) -> float32 {
    return SliderMetricFloat(thumb.value.fields, cast(u32)StylePaddingY,
        thumb.value.padding_y, -4.0, scale, true)
}

#program_export
SliderClampRatio :: (ratio: float32) -> float32 {
    if ratio < 0.0 { return 0.0 }
    if ratio > 1.0 { return 1.0 }
    return ratio
}

#program_export
SliderPointerRatio :: (pointer: float32, origin: float32, length: float32,
    inverted: bool) -> float32 {
    if length <= 0.0 { return 0.0 }
    ratio: float32 = (pointer - origin) / length
    if inverted {
        ratio = 1.0 - ratio
    }
    return SliderClampRatio(ratio)
}

#program_export
SliderRatio :: (value: float32, minimum: float32, maximum: float32) -> float32 {
    span: float32 = maximum - minimum
    if span <= 0.0 { return 0.0 }
    return SliderClampRatio((value - minimum) / span)
}

#program_export
SliderValue :: (minimum: float32, maximum: float32, ratio: float32) -> float32 {
    span: float32 = maximum - minimum
    if span <= 0.0 { return minimum }
    return minimum + SliderClampRatio(ratio) * span
}
#program_export
SliderDiscreteRatio :: (value: s32, minimum: s32, maximum: s32) -> float32 {
    span: s64 = cast(s64)maximum - cast(s64)minimum
    if span <= 0 { return 0.0 }
    return SliderClampRatio(cast(float32)(cast(s64)value - cast(s64)minimum) / cast(float32)span)
}

#program_export
SliderDiscreteValue :: (minimum: s32, maximum: s32, ratio: float32) -> s32 {
    span: s64 = cast(s64)maximum - cast(s64)minimum
    if span <= 0 { return minimum }
    return cast(s32)(cast(s64)minimum + cast(s64)(SliderClampRatio(ratio) * cast(float32)span + 0.5))
}
#program_export
SliderRatioDecisionFor :: (any_active: bool, active: bool, hot: bool, disabled: bool,
    owner_captured: bool, pressed: bool, down: bool,
    released: bool) -> SliderRatioDecision {
    decision: SliderRatioDecision
    decision.clear_active = (any_active && owner_captured) ||
        (active && disabled)
    decision.start_active = hot && pressed
    effective_active: bool = (active && !decision.clear_active) ||
        decision.start_active
    decision.update_ratio = effective_active && !disabled && (pressed || down)
    decision.finish_active = effective_active && released
    return decision
}

#program_export
SliderDiscreteKeyboardValue :: (value: s32, minimum: s32, maximum: s32,
    direction: s32, home: bool, end: bool, alt: bool, shift: bool) -> SliderDiscreteStep {
    result: SliderDiscreteStep
    result.value = value
    result.changed = false
    span: s64 = cast(s64)maximum - cast(s64)minimum
    if span <= 0 { return result }
    next: s64 = cast(s64)value
    if home {
        next = cast(s64)minimum
    } else if end {
        next = cast(s64)maximum
    } else if direction != 0 {
        step: s64 = 1
        if span > 100 { step = (span + 50) / 100 }
        if alt {
            step = step / 10
            if step < 1 { step = 1 }
        }
        if shift { step = step * 10 }
        next = next + cast(s64)direction * step
        if next < cast(s64)minimum { next = cast(s64)minimum }
        if next > cast(s64)maximum { next = cast(s64)maximum }
    }
    result.value = cast(s32)next
    result.changed = result.value != value
    return result
}

// Half a thumb at each end of the track, when the length leaves room.
SliderThumbInset :: (length: float32, thumb_size: float32) -> float32 {
    if length <= thumb_size { return 0.0 }
    return thumb_size * 0.5
}

#program_export
SliderPaintFor :: (spec: SliderSpec) -> SliderPaint {
    paint: SliderPaint
    scale: float32 = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    ratio: float32 = SliderClampRatio(spec.ratio)
    bounds: Rectangle = spec.bounds
    min_length: float32 = cast(float32)SliderMinimumLengthForStyle(spec.track, scale)
    thumb_size: float32 = cast(float32)SliderThumbSizeForStyle(spec.thumb, scale)
    track_size: float32 = cast(float32)SliderTrackSizeForStyle(spec.vertical,
        spec.track, scale)
    if spec.vertical {
        if bounds.height < min_length { bounds.height = min_length }
        if bounds.width < thumb_size { bounds.width = thumb_size }
        // The thumb travels between the track ends and stays inside bounds.
        inset_y: float32 = SliderThumbInset(bounds.height, thumb_size)
        paint.track_bounds.x = bounds.x + (bounds.width - track_size) * 0.5
        paint.track_bounds.y = bounds.y + inset_y
        paint.track_bounds.width = track_size
        paint.track_bounds.height = bounds.height - inset_y * 2.0
        position_y: float32 = paint.track_bounds.y + paint.track_bounds.height * (1.0 - ratio)
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = position_y
        paint.active_bounds.width = paint.track_bounds.width
        paint.active_bounds.height = paint.track_bounds.y + paint.track_bounds.height - position_y
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * 0.5
        paint.thumb_y = position_y
    } else {
        if bounds.width < min_length { bounds.width = min_length }
        if bounds.height < thumb_size { bounds.height = thumb_size }
        inset_x: float32 = SliderThumbInset(bounds.width, thumb_size)
        paint.track_bounds.x = bounds.x + inset_x
        paint.track_bounds.y = bounds.y + (bounds.height - track_size) * 0.5
        paint.track_bounds.width = bounds.width - inset_x * 2.0
        paint.track_bounds.height = track_size
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = paint.track_bounds.y
        paint.active_bounds.width = paint.track_bounds.width * ratio
        paint.active_bounds.height = paint.track_bounds.height
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * ratio
        paint.thumb_y = paint.track_bounds.y + paint.track_bounds.height * 0.5
    }
    paint.bounds = bounds
    paint.thumb_radius = thumb_size * 0.5
    paint.glow_radius = paint.thumb_radius +
        SliderGlowExpansionForStyle(spec.thumb, scale)
    paint.thumb_shadow_x = paint.thumb_x +
        SliderThumbShadowOffsetXForStyle(spec.thumb, scale)
    paint.thumb_shadow_y = paint.thumb_y +
        SliderThumbShadowOffsetYForStyle(spec.thumb, scale)
    paint.thumb_shadow_radius = paint.thumb_radius +
        SliderThumbShadowExpansionForStyle(spec.thumb, scale)
    paint.thumb_highlight_x = paint.thumb_x +
        SliderThumbHighlightOffsetXForStyle(spec.thumb, scale)
    paint.thumb_highlight_y = paint.thumb_y +
        SliderThumbHighlightOffsetYForStyle(spec.thumb, scale)
    paint.thumb_highlight_radius = paint.thumb_radius * 0.45

    paint.track = spec.track
    paint.active_track = spec.active_track
    paint.thumb = spec.thumb

    thumb_opacity: float32 = paint.thumb.value.opacity
    paint.thumb_fill_color = Opacity(paint.thumb.value.background, thumb_opacity)
    paint.thumb_edge_color = Opacity(paint.thumb.value.border, thumb_opacity)
    shadow_alpha: float32 = 0.36
    highlight_alpha: float32 = 0.20
    if spec.disabled {
        shadow_alpha = 0.18
        highlight_alpha = 0.08
    }
    paint.thumb_shadow_color = Opacity(paint.thumb.value.focus,
        shadow_alpha * thumb_opacity)
    paint.thumb_highlight_color = Opacity(paint.thumb.value.foreground,
        highlight_alpha * thumb_opacity)
    if paint.thumb.value.material == cast(MaterialKind)MaterialFlat {
        paint.thumb_shadow_color = 0
        paint.thumb_highlight_color = 0
    }
    glow_alpha: float32 = 0.0
    if spec.hovered { glow_alpha = 0.18 }
    if spec.active { glow_alpha = 0.32 }
    paint.glow_color = Opacity(paint.thumb.value.focus,
        glow_alpha * thumb_opacity)
    return paint
}
