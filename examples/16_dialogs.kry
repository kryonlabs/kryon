#import "kryon.h"

app "Kryon Dialogs" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    dialog: int = 0
    prompt: [128] char = "value"
    cursor: int = 5
    focused: int = 0
    color: Color = {120,160,220,255}
}

screen DialogsExample(viewport: Rectangle) {
    WidgetBackground(GetThemeBackground())
    if WidgetButton(40, 60, 150, 34, "Message", UI_BUTTON_STYLE_PRIMARY) {
        dialog = 1
    }
    if WidgetButton(40, 104, 150, 34, "Confirm", UI_BUTTON_STYLE_PRIMARY) {
        dialog = 2
    }
    if WidgetButton(40, 148, 150, 34, "Prompt", UI_BUTTON_STYLE_PRIMARY) {
        dialog = 3
    }
    UIColorPickerNode((Rectangle){240,60,320,160},&color)
    if dialog == 1 && UIMessageDialogNode((UIMessageDialog){"Message","Hello from Kryon.","OK"}) > 0 {
        dialog = 0
    }
    if dialog == 2 && UIConfirmDialogNode((UIConfirmDialog){"Confirm","Continue?","No","Yes"}) != 0 {
        dialog = 0
    }
    if dialog == 3 && UIPromptDialogNode((UIPromptDialog){"Prompt",prompt,sizeof(prompt),&cursor,&focused,"Cancel","Save"}) != 0 {
        dialog = 0
    }
}
