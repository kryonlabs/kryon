using Facts :: #import "style_facts";
#import "style"
#import "control_props"
#import "geometry"
#import "text_style"
#import "style_tree"
#import "style_frame"
using Vectors :: #import "std/vec"

using ButtonState;
using StyleField;
using StyleContext;

// Style sheets are a subset of CSS (the css package). The runtime API uses
// plain Style* names; the parser and compiled packs lower sheets into these
// typed rule tables.

StyleRule :: struct {
    selector: StyleSelector
    state: s32
    layer: s32
    order: s32
    style: StyleData
    flex: StyleFlexData
    box: StyleBoxData
}

StyleBoxField :: enum {
    StyleBoxMinWidth :: 1
    StyleBoxMaxWidth :: 2
    StyleBoxMaxHeight :: 4
    StyleBoxClipChildren :: 8
    StyleBoxTextAlign :: 16
    StyleBoxMarginTop :: 32
    StyleBoxMarginRight :: 64
    StyleBoxMarginBottom :: 128
    StyleBoxMarginLeft :: 256
    // Per-side border widths, then colors: top, right, bottom, left.
    StyleBoxBorderTop :: 512
    StyleBoxBorderRight :: 1024
    StyleBoxBorderBottom :: 2048
    StyleBoxBorderLeft :: 4096
    StyleBoxBorderTopColor :: 8192
    StyleBoxBorderRightColor :: 16384
    StyleBoxBorderBottomColor :: 32768
    StyleBoxBorderLeftColor :: 65536
    // A focused widget's ring (CSS outline), not a container field.
    StyleBoxOutlineWidth :: 131072
    StyleBoxOutlineOffset :: 262144
    // A linear gradient past top to bottom with two stops: its angle or
    // corner, stops and middle colors (the face holds the first and last).
    StyleBoxGradient :: 524288
    // CSS transform, the rotate and scale properties, the transform origin
    // on each axis, the transition a change of them eases over, and the
    // translate property.
    StyleBoxTransform :: 1048576
    StyleBoxRotate :: 2097152
    StyleBoxScale :: 4194304
    StyleBoxOriginX :: 8388608
    StyleBoxOriginY :: 16777216
    StyleBoxTransformMotion :: 33554432
    StyleBoxTranslate :: 67108864
    // A radial gradient: its shape, size keywords and center point join
    // the box's linear gradient stops.
    StyleBoxRadial :: 134217728
}
using StyleBoxField;

// The CSS box of a Row, Column or Grid container (and text-align for Text):
// min/max sizes, margins and overflow clipping. A negative maximum is CSS
// `none`; a negative margin is `auto`, which takes the free inline space.
StyleBoxData :: struct {
    fields: u32
    min_width: float32
    max_width: float32
    max_height: float32
    clip_children: bool
    text_align: s32
    margin_top: float32
    margin_right: float32
    margin_bottom: float32
    margin_left: float32
    // The min_width, max_width and max_height fields that hold a
    // percentage of the parent's content box.
    percent: u32
    // Per-side borders, top, right, bottom, left; a side without its own
    // width or color takes the uniform border's.
    border_widths: [4]float32
    border_colors: [4]u32
    outline_width: float32
    outline_offset: float32
    // The radial gradient's shape (0 ellipse, 1 circle) and size keyword
    // (0 farthest-corner, 1 closest-corner, 2 closest-side, 3
    // farthest-side); its center as fractions of the box, 0.5 the middle.
    radial_shape: s32
    radial_size: s32
    radial_cx: float32
    radial_cy: float32
    // Explicit radii: 0 takes the size keyword above, a positive value is
    // px, and a negative one is a fraction of the box's width or height.
    radial_rx: float32
    radial_ry: float32
    // The gradient line's direction for a CSS angle (sin, -cos: 0 degrees
    // points up), or a corner: 1 top right, 2 bottom right, 3 bottom left,
    // 4 top left, which follows the box's diagonal.
    gradient_dx: float32
    gradient_dy: float32
    gradient_corner: s32
    // 2 to 6 stops at increasing positions from 0 to 1.
    gradient_count: s32
    gradient_stops: [6]float32
    // Stops 1 to 4; stop 0 is the face's background, the last its end.
    gradient_colors: [4]u32
    // `transform` as a translation, a rotation in degrees and an x and y
    // scale, applied to a point scale first; then the `rotate` and `scale`
    // properties, then the `translate` property's x and y. The origin is in logical pixels, or with its percent bit
    // a percentage of the box (50% of each side when unset). The paint
    // transform pass (paint_transform) reads these for each node; layout
    // never does.
    transform: [5]float32
    rotate: float32
    scale: [2]float32
    transform_origin: [2]float32
    // A change of transform eases over these seconds along this
    // cubic-bezier curve, in hundredths; all zero is linear.
    transform_seconds: float32
    transform_timing: [4]u8
    translate: [2]float32
}

// Every box field but text-align, which only Text reads.
StyleBoxContainerFields :: 134873071
// Transform, rotate, scale, translate, their origin and their transition;
// then only the four that set a transform.
StyleBoxTransformFields :: 133169152
StyleBoxTransformSets :: 74448896
// The per-side border widths and colors.
StyleBoxBorderSides :: 130560
StyleBoxOutlineFields :: 393216

StyleFlexField :: enum {
    StyleFlexDirection :: 1
    StyleFlexWrap :: 2
    StyleFlexJustify :: 4
    StyleFlexAlign :: 8
    StyleFlexBasis :: 16
    StyleFlexGrow :: 32
    StyleFlexShrink :: 64
    StyleFlexSelf :: 128
    // A Row or Column's line distribution on the cross axis.
    StyleFlexAlignContent :: 256
    // `flex-wrap: wrap-reverse` stacks wrapped lines bottom to top.
    StyleFlexWrapReverse :: 512
    // An item's placement order inside its container.
    StyleFlexOrder :: 1024
}
using StyleFlexField;

StyleFlexData :: struct {
    fields: u32
    // 0/1 select row/column, 2/3 reverse their main direction.
    direction: s32
    wrap: bool
    wrap_reverse: bool
    justify_content: s32
    align_items: s32
    // 0 stretch (the default), 1 start, 2 center, 3 end, 4 space-between,
    // 5 space-around, 6 space-evenly.
    align_content: s32
    // Negative basis and self-alignment represent auto.
    basis: float32
    grow: float32
    shrink: float32
    align_self: s32
    // The item's placement order; earlier siblings precede on ties.
    order: s32
    // StyleFlexBasis when the basis is a percentage of the container's size.
    percent: u32
}

StyleFlexContainerFields :: 783
StyleFlexItemFields :: 1264

// Leave room for app and user rules after a complete shared style pack.
StyleRuleCapacity :: 512

StyleRules :: struct {
    items: [StyleRuleCapacity]StyleRule
    count: s32
}

installed_rules: StyleRules;

// Installation data only: priority-ordered selector columns and rule indices.
// Buckets are conservative candidate sets, never computed style results.
// Exact matching below rejects class/kind/state bucket collisions.
StyleIndexWords :: StyleRuleCapacity / 64
installed_selectors: [StyleRuleCapacity]StyleSelector;
installed_states: [StyleRuleCapacity]s32;
installed_rule_indices: [StyleRuleCapacity]s32;
installed_kind_bits: [64 * StyleIndexWords]u64;
installed_class_bits: [64 * StyleIndexWords]u64;
installed_state_bits: [64 * StyleIndexWords]u64;
installed_any_kind: [StyleIndexWords]u64;
installed_any_class: [StyleIndexWords]u64;
installed_any_state: [StyleIndexWords]u64;
installed_fields: u32;
installed_flex_fields: u32;
installed_face_bits: [StyleIndexWords]u64;
installed_flex_bits: [StyleIndexWords]u64;
installed_box_fields: u32;
installed_box_bits: [StyleIndexWords]u64;

StyleBucket :: (value: s32) -> s32 {
    return cast(s32)(cast(u32)value & cast(u32)63)
}

StyleIndexInstall :: () {
    StyleTreeInstall()
    for i: 0..cast(s32)(64 * StyleIndexWords - 1) {
        installed_kind_bits[i] = 0; installed_class_bits[i] = 0; installed_state_bits[i] = 0
    }
    for i: 0..cast(s32)(StyleIndexWords - 1) {
        installed_any_kind[i] = 0; installed_any_class[i] = 0; installed_any_state[i] = 0
        installed_face_bits[i] = 0; installed_flex_bits[i] = 0
        installed_box_bits[i] = 0
    }
    installed_fields = 0
    installed_flex_fields = 0
    installed_box_fields = 0
    installed_structural_late = false
    priorities: [StyleRuleCapacity]StylePriority
    scratch: [StyleRuleCapacity]s32
    for i: 0..installed_rules.count - 1 {
        priorities[i] = StylePriority.{.present = true, .layer = installed_rules.items[i].layer,
            .specificity = StyleSelectorSpecificity(installed_rules.items[i].selector),
            .order = installed_rules.items[i].order}
        installed_rule_indices[i] = i
    }
    // Bottom-up merge sort of indices: bounded inline scratch, O(n log n).
    // Taking the right run on exact ties gives later source positions priority.
    width: s32 = 1
    while width < installed_rules.count {
        start: s32 = 0
        while start < installed_rules.count {
            middle := start + width
            if middle > installed_rules.count { middle = installed_rules.count }
            end := middle + width
            if end > installed_rules.count { end = installed_rules.count }
            left := start; right := middle; out := start
            while out < end {
                if left >= middle { scratch[out] = installed_rule_indices[right]; right += 1 }
                else if right < end && StylePriorityWins(priorities[installed_rule_indices[right]],
                    priorities[installed_rule_indices[left]]) {
                    scratch[out] = installed_rule_indices[right]; right += 1
                } else { scratch[out] = installed_rule_indices[left]; left += 1 }
                out += 1
            }
            start = end
        }
        for i: 0..installed_rules.count - 1 { installed_rule_indices[i] = scratch[i] }
        width *= 2
    }
    for i: 0..installed_rules.count - 1 {
        source := installed_rule_indices[i]
        selector := installed_rules.items[source].selector
        state := installed_rules.items[source].state
        installed_selectors[i] = selector
        installed_states[i] = state
        word := i / 64
        bit := cast(u64)1 << cast(u32)(i % 64)
        face_fields := installed_rules.items[source].style.fields
        flex_fields := installed_rules.items[source].flex.fields
        installed_fields |= face_fields
        installed_flex_fields |= flex_fields
        box_fields := installed_rules.items[source].box.fields
        installed_box_fields |= box_fields
        if box_fields != 0 { installed_box_bits[word] |= bit }
        if face_fields != 0 { installed_face_bits[word] |= bit }
        if flex_fields != 0 { installed_flex_bits[word] |= bit }
        if selector.kind == 0 { installed_any_kind[word] |= bit }
        else { installed_kind_bits[StyleBucket(selector.kind) * StyleIndexWords + word] |= bit }
        if selector.class_name == 0 { installed_any_class[word] |= bit }
        else { installed_class_bits[StyleBucket(selector.class_name) * StyleIndexWords + word] |= bit }
        if state == StyleStateAny() || state == ButtonStateNormal { installed_any_state[word] |= bit }
        else { installed_state_bits[StyleBucket(state) * StyleIndexWords + word] |= bit }
        if (selector.context & (cast(u32)StyleContextLastChild | cast(u32)StyleContextOnlyChild |
        cast(u32)StyleContextLastOfType | cast(u32)StyleContextOnlyOfType)) != 0 {
            installed_structural_late = true
        }
    }
}

// A nonzero word's lowest candidate. Portable across native and ZX targets.
StyleFirstBit :: (bits: u64) -> s32 {
    index: s32
    if (bits & cast(u64)0xffffffff) == 0 { bits >>= 32; index += 32 }
    if (bits & cast(u64)0xffff) == 0 { bits >>= 16; index += 16 }
    if (bits & cast(u64)0xff) == 0 { bits >>= 8; index += 8 }
    if (bits & cast(u64)0xf) == 0 { bits >>= 4; index += 4 }
    if (bits & cast(u64)3) == 0 { bits >>= 2; index += 2 }
    if (bits & cast(u64)1) == 0 { index += 1 }
    return index
}

StyleWithoutTypeface :: (source: StyleData) -> StyleData {
    return StyleData.{.fields = source.fields, .background = source.background,
        .foreground = source.foreground, .border = source.border, .focus = source.focus,
        .radius = source.radius, .border_width = source.border_width, .opacity = source.opacity,
        .padding_x = source.padding_x, .padding_y = source.padding_y, .gap = source.gap,
        .row_gap = source.row_gap, .column_gap = source.column_gap,
        .font_size = source.font_size, .icon_size = source.icon_size, .offset_x = source.offset_x,
        .offset_y = source.offset_y, .background_end = source.background_end,
        .material = source.material, .letter_spacing = source.letter_spacing,
        .min_height = source.min_height, .line_height = source.line_height,
        .width = source.width, .height = source.height, .grid_tracks = source.grid_tracks,
        .percent = source.percent,
        .line_height_unit = source.line_height_unit,
        .font_weight = source.font_weight, .font_style = source.font_style,
        .font_role = source.font_role, .elevation = source.elevation,
        .motion_duration = source.motion_duration,
        .motion_multiplier = source.motion_multiplier,
        .motion_easing = source.motion_easing, .motion_reduced = source.motion_reduced}
}

#program_export
InstallStyleRules :: (rules: StyleRules) -> bool {
    limit: s32 = rules.count
    if limit < 0 || limit > StyleRuleCapacity { return false }
    total: s64 = 0
    index: s32 = 0
    while index < limit {
        typeface: string = rules.items[index].style.typeface
        if typeface.count > 65536 - total { return false }
        total += typeface.count
        index += 1
    }

    // Publish only a complete snapshot. Earlier rule values retain immutable
    // typeface bytes when another stylesheet is installed.
    snapshot: StyleRules
    snapshot.count = limit
    index = 0
    while index < limit {
        typeface: string = rules.items[index].style.typeface
        builder: Vec(u8)
        if !BuilderAppend(builder, typeface) { return false }
        snapshot.items[index].selector = rules.items[index].selector
        snapshot.items[index].state = rules.items[index].state
        snapshot.items[index].layer = rules.items[index].layer
        snapshot.items[index].order = rules.items[index].order
        snapshot.items[index].flex = rules.items[index].flex
        snapshot.items[index].box = rules.items[index].box
        snapshot.items[index].style =
        StyleWithoutTypeface(rules.items[index].style)
        snapshot.items[index].style.typeface = BuilderFinish(builder)
        index += 1
    }
    installed_rules = snapshot
    StyleIndexInstall()
    resolver: TextStyleResolver = ResolveInstalledTextStyle
    SetTextStyleResolver(resolver)
    return true
}

#program_export
ActiveStyleRules :: () -> StyleRules {
    return installed_rules
}

// The cascade owns full styles; text only carries the typography it paints.
TextFaceStyle :: (face: TextFace) -> StyleData {
    style: StyleData
    if face.foreground_set { style.fields |= cast(u32)StyleForeground }
    if face.font_size > 0.0 { style.fields |= cast(u32)StyleFontSize }
    if face.opacity_set { style.fields |= cast(u32)StyleOpacity }
    if face.typeface != "" { style.fields |= cast(u32)StyleTypeface }
    style.fields |= cast(u32)StyleFontWeight | cast(u32)StyleFontStyle | cast(u32)StyleLetterSpacing
    if face.line_height_set { style.fields |= cast(u32)StyleLineHeight }
    style.foreground = face.foreground
    style.font_size = face.font_size
    style.opacity = face.opacity
    style.typeface = face.typeface
    style.font_weight = face.glyphs.weight
    style.font_style = face.glyphs.style
    style.letter_spacing = face.glyphs.letter_spacing
    style.line_height = face.line_height
    style.line_height_unit = face.line_height_unit
    style.motion_reduced = face.motion_reduced
    return style
}

TextFaceFromStyle :: (base: TextFace, style: StyleData) -> TextFace {
    face := base
    face.foreground_set = (style.fields & cast(u32)StyleForeground) != 0
    face.foreground = style.foreground
    face.font_size = cast(float32)StyleFontValue(style.fields, style.font_size)
    face.opacity_set = (style.fields & cast(u32)StyleOpacity) != 0
    face.opacity = StyleOpacityValue(style.fields, style.opacity)
    face.typeface = style.typeface
    face.glyphs = StyleTextGlyphs(style)
    face.line_height_set = (style.fields & cast(u32)StyleLineHeight) != 0
    face.line_height = style.line_height
    face.line_height_unit = style.line_height_unit
    face.motion_reduced = style.motion_reduced
    return face
}

ResolveInstalledTextStyle :: (request: TextStyleRequest,
    base: TextFace) -> TextFace {
    state: s32 = cast(s32)ButtonStateNormal
    if request.disabled { state = cast(s32)ButtonStateDisabled }
    kind: s32 = request.kind
    if kind <= 0 { kind = StyleKindText() }
    facts := StyleTextFacts(request.id, request.class_name, kind, state)
    style := TextFaceStyle(base)
    if base.align != 0 {
        return TextFaceFromStyle(base, ResolveInstalledStyleRules(style, facts, state))
    }
    box: StyleBoxData
    result := ResolveIndexedStyle(style, facts, state, true, null, cast(u32)0,
        *box, cast(u32)StyleBoxTextAlign)
    face := TextFaceFromStyle(base, result)
    if (box.fields & cast(u32)StyleBoxTextAlign) != 0 { face.align = box.text_align }
    return face
}

StylePriority :: struct {
    present: bool
    layer: s32
    specificity: s32
    order: s32
}

StyleCascade :: struct {
    result: StyleData
    background_priority: StylePriority
    foreground_priority: StylePriority
    border_priority: StylePriority
    focus_priority: StylePriority
    radius_priority: StylePriority
    border_width_priority: StylePriority
    opacity_priority: StylePriority
    padding_x_priority: StylePriority
    padding_y_priority: StylePriority
    gap_priority: StylePriority
    row_gap_priority: StylePriority
    column_gap_priority: StylePriority
    font_size_priority: StylePriority
    font_weight_priority: StylePriority
    font_style_priority: StylePriority
    icon_size_priority: StylePriority
    content_offset_priority: StylePriority
    background_end_priority: StylePriority
    material_priority: StylePriority
    typeface_priority: StylePriority
    letter_spacing_priority: StylePriority
    min_height_priority: StylePriority
    line_height_priority: StylePriority
    font_role_priority: StylePriority
    elevation_priority: StylePriority
    motion_duration_priority: StylePriority
    motion_multiplier_priority: StylePriority
    motion_easing_priority: StylePriority
    motion_reduced_priority: StylePriority
    width_priority: StylePriority
    height_priority: StylePriority
    grid_tracks_priority: StylePriority
}
#program_export
StyleMatchesOptional :: (selector_value: s32, fact_value: s32) -> bool {
    if selector_value == StyleAny() {
        return true
    }
    return selector_value == fact_value
}

// Text-derived widgets still match Text rules, with a second selector kind
// for rules scoped to their presentation.
StyleTextVariant :: (facts: StyleFacts) -> s32 {
    if facts.kind == StyleKindText() && (facts.role == StyleKindHeading() ||
        facts.role == StyleKindParagraphText() || facts.role == StyleKindLink()) {
        return facts.role
    }
    return facts.kind
}

#program_export
StyleSelectorMatches :: (selector: StyleSelector, facts: StyleFacts) -> bool {
    if selector.kind != StyleKindAny() && selector.kind != facts.kind &&
        selector.kind != StyleTextVariant(facts) {
        return false
    }
    if selector.name != 0 && selector.name != facts.name {
        return false
    }
    if selector.class_name != 0 && selector.class_name != facts.class_name {
        return false
    }
    if selector.id != 0 && selector.id != facts.id {
        return false
    }
    if !StyleMatchesOptional(selector.role, facts.role) {
        return false
    }
    if !StyleMatchesOptional(selector.tone, facts.tone) {
        return false
    }
    if !StyleMatchesOptional(selector.emphasis, facts.emphasis) {
        return false
    }
    if !StyleMatchesOptional(selector.size, facts.size) {
        return false
    }
    if !StyleMatchesOptional(selector.state, facts.state) {
        return false
    }
    if !StyleMatchesOptional(selector.validation, facts.validation) {
        return false
    }
    if !StyleMatchesOptional(selector.orientation, facts.orientation) {
        return false
    }
    if !StyleMatchesOptional(selector.placement, facts.placement) {
        return false
    }
    return true
}

// Selector parsers provide counts; weights and cascade ordering live here for
// typed native selectors and the richer declarative web selector surface.
#program_export
StyleSpecificity :: (kinds: s32, attributes: s32, classes: s32, names: s32) -> s32 {
    return kinds + attributes * 10 + classes * 20 + names * 100
}

#program_export
StyleSelectorSpecificity :: (selector: StyleSelector) -> s32 {
    kinds: s32 = 0
    attributes: s32 = 0
    classes: s32 = 0
    names: s32 = 0
    if selector.kind != StyleKindAny() {
        kinds = 1
    }
    if selector.sibling_kind != StyleKindAny() {
        kinds += 1
    }
    if selector.role != StyleAny() {
        attributes += 1
    }
    if selector.tone != StyleAny() {
        attributes += 1
    }
    if selector.emphasis != StyleAny() {
        attributes += 1
    }
    if selector.size != StyleAny() {
        attributes += 1
    }
    if selector.state != StyleAny() {
        attributes += 1
    }
    if selector.validation != StyleAny() {
        attributes += 1
    }
    if selector.orientation != StyleAny() {
        attributes += 1
    }
    if selector.placement != StyleAny() {
        attributes += 1
    }
    if selector.class_name != 0 {
        classes = 1
    }
    if selector.id != 0 {
        names += 2
    }
    if selector.name != 0 {
        names = 1
    }
    if selector.context != 0 {
        if selector.ancestor_class != 0 { classes += 1 }
        if selector.ancestor_id != 0 { names += 2 }
        positions := selector.context & (cast(u32)StyleContextFirstChild |
            cast(u32)StyleContextLastChild | cast(u32)StyleContextOnlyChild |
            cast(u32)StyleContextNthChild | cast(u32)StyleContextFirstOfType |
            cast(u32)StyleContextLastOfType | cast(u32)StyleContextOnlyOfType |
            cast(u32)StyleContextNthOfType)
        while positions != 0 {
            if (positions & cast(u32)1) != 0 { classes += 1 }
            positions = positions >> 1
        }
        if selector.not_class != 0 { classes += 1 }
        if selector.not_state != 0 { classes += 1 }
        if selector.sibling_class != 0 { classes += 1 }
        if selector.sibling_id != 0 { names += 2 }
    }
    return StyleSpecificity(kinds, attributes, classes, names)
}

// A selector's tree context: the :not() exclusions, then the ancestors and
// siblings the frame knows.
#program_export
StyleContextMatches :: (selector: StyleSelector, facts: StyleFacts, active_state: s32) -> bool {
    if selector.not_class != 0 && selector.not_class == facts.class_name { return false }
    if selector.not_state != 0 && selector.not_state == active_state { return false }
    if (selector.context & ~cast(u32)StyleContextNot) == 0 { return true }
    return style_tree_match != null && style_tree_match(selector, facts.kind)
}
#program_export
StyleRuleMatchesState :: (rule_state: s32, active_state: s32) -> bool {
    if rule_state == StyleStateAny() { return true }
    if rule_state == ButtonStateNormal { return true }
    return rule_state == active_state
}

#program_export
StyleRuleMatches :: (rule: StyleRule, facts: StyleFacts, active_state: s32) -> bool {
    if !StyleRuleMatchesState(rule.state, active_state) {
        return false
    }
    return StyleSelectorMatches(rule.selector, facts) &&
        (rule.selector.context == 0 || StyleContextMatches(rule.selector, facts, active_state))
}

#program_export
StyleHasField :: (style: StyleData, field: u32) -> bool {
    return (style.fields & field) != cast(u32)0
}
// A scalar score is useful for display but cannot order arbitrary selector
// counts or source positions without collisions. Compare each tier directly.
#program_export
StylePriorityWins :: (priority: StylePriority, current: StylePriority) -> bool {
    if !priority.present {
        return false
    }
    if !current.present {
        return true
    }
    if priority.layer != current.layer {
        return priority.layer > current.layer
    }
    if priority.specificity != current.specificity {
        return priority.specificity > current.specificity
    }
    return priority.order >= current.order
}

#program_export
BeginStyleCascade :: (base: StyleData) -> StyleCascade {
    cascade: StyleCascade
    cascade.result = base
    return cascade
}

StyleIsContainerLayout :: (kind: s32) -> bool {
    return kind == StyleKindRow() || kind == StyleKindColumn() || kind == StyleKindGrid()
}

// One field's percent bit, taken along with its value.
StyleTakePercent :: (percent: u32, value: StyleData, field: u32) -> u32 {
    return (percent & ~field) | (value.percent & field)
}

// Applies rules to a cascade. The rules are a borrowed view and are read in
// place, so resolving a face copies neither the rule table nor a rule nor the
// cascade per rule; resolution runs for every widget every frame.
#program_export
ApplyStyleRules :: (cascade: StyleCascade, rules: []StyleRule,
    facts: StyleFacts, active_state: s32) -> StyleCascade {
    container_layout := StyleIsContainerLayout(facts.kind)
    index: s64 = 0
    while index < rules.count {
        if StyleRuleMatchesState(rules[index].state, active_state) &&
        StyleSelectorMatches(rules[index].selector, facts) && (rules[index].selector.context == 0 ||
            StyleContextMatches(rules[index].selector, facts, active_state)) {
            priority: StylePriority
            priority.present = true
            priority.layer = rules[index].layer
            priority.specificity = StyleSelectorSpecificity(rules[index].selector)
            priority.order = rules[index].order
            if (rules[index].style.fields & cast(u32)StyleBackground) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.background_priority) {
                cascade.result.background = rules[index].style.background
                cascade.result.fields = cascade.result.fields | cast(u32)StyleBackground
                cascade.background_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleForeground) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.foreground_priority) {
                cascade.result.foreground = rules[index].style.foreground
                cascade.result.fields = cascade.result.fields | cast(u32)StyleForeground
                cascade.foreground_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleBorder) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.border_priority) {
                cascade.result.border = rules[index].style.border
                cascade.result.fields = cascade.result.fields | cast(u32)StyleBorder
                cascade.border_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleFocus) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.focus_priority) {
                cascade.result.focus = rules[index].style.focus
                cascade.result.fields = cascade.result.fields | cast(u32)StyleFocus
                cascade.focus_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleRadius) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.radius_priority) {
                cascade.result.radius = rules[index].style.radius
                cascade.result.fields = cascade.result.fields | cast(u32)StyleRadius
                cascade.radius_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleBorderWidth) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.border_width_priority) {
                cascade.result.border_width = rules[index].style.border_width
                cascade.result.fields = cascade.result.fields | cast(u32)StyleBorderWidth
                cascade.border_width_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleOpacity) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.opacity_priority) {
                cascade.result.opacity = rules[index].style.opacity
                cascade.result.fields = cascade.result.fields | cast(u32)StyleOpacity
                cascade.opacity_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StylePaddingX) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.padding_x_priority) {
                cascade.result.padding_x = rules[index].style.padding_x
                cascade.result.fields = cascade.result.fields | cast(u32)StylePaddingX
                cascade.padding_x_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StylePaddingY) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.padding_y_priority) {
                cascade.result.padding_y = rules[index].style.padding_y
                cascade.result.fields = cascade.result.fields | cast(u32)StylePaddingY
                cascade.padding_y_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleGap) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.gap_priority) {
                cascade.result.gap = rules[index].style.gap
                cascade.result.fields = cascade.result.fields | cast(u32)StyleGap
                cascade.gap_priority = priority
            }
            row_gap := StyleHasField(rules[index].style, cast(u32)StyleRowGap)
            column_gap := StyleHasField(rules[index].style, cast(u32)StyleColumnGap)
            gap_shorthand := container_layout && StyleHasField(rules[index].style, cast(u32)StyleGap)
            if (row_gap || gap_shorthand) && StylePriorityWins(priority, cascade.row_gap_priority) {
                cascade.result.row_gap = ifx row_gap then rules[index].style.row_gap else rules[index].style.gap
                cascade.result.fields |= cast(u32)StyleRowGap
                cascade.row_gap_priority = priority
            }
            if (column_gap || gap_shorthand) && StylePriorityWins(priority, cascade.column_gap_priority) {
                cascade.result.column_gap = ifx column_gap then rules[index].style.column_gap else rules[index].style.gap
                cascade.result.fields |= cast(u32)StyleColumnGap
                cascade.column_gap_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleFontSize) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.font_size_priority) {
                cascade.result.font_size = rules[index].style.font_size
                cascade.result.fields = cascade.result.fields | cast(u32)StyleFontSize
                cascade.font_size_priority = priority
            }
            if StyleHasField(rules[index].style, cast(u32)StyleFontWeight) &&
            StylePriorityWins(priority, cascade.font_weight_priority) {
                cascade.result.font_weight = rules[index].style.font_weight
                cascade.result.fields |= cast(u32)StyleFontWeight
                cascade.font_weight_priority = priority
            }
            if StyleHasField(rules[index].style, cast(u32)StyleFontStyle) &&
            StylePriorityWins(priority, cascade.font_style_priority) {
                cascade.result.font_style = rules[index].style.font_style
                cascade.result.fields |= cast(u32)StyleFontStyle
                cascade.font_style_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleLetterSpacing) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.letter_spacing_priority) {
                cascade.result.letter_spacing = rules[index].style.letter_spacing
                cascade.result.fields = cascade.result.fields | cast(u32)StyleLetterSpacing
                cascade.letter_spacing_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMinHeight) != cast(u32)0 &&
            (container_layout || (rules[index].style.percent & cast(u32)StyleMinHeight) == 0) &&
            StylePriorityWins(priority, cascade.min_height_priority) {
                cascade.result.min_height = rules[index].style.min_height
                cascade.result.percent = StyleTakePercent(cascade.result.percent, rules[index].style, cast(u32)StyleMinHeight)
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMinHeight
                cascade.min_height_priority = priority
            }
            if container_layout && StyleHasField(rules[index].style, cast(u32)StyleWidth) &&
            StylePriorityWins(priority, cascade.width_priority) {
                cascade.result.width = rules[index].style.width
                cascade.result.percent = StyleTakePercent(cascade.result.percent, rules[index].style, cast(u32)StyleWidth)
                cascade.result.fields |= cast(u32)StyleWidth
                cascade.width_priority = priority
            }
            if container_layout && StyleHasField(rules[index].style, cast(u32)StyleHeight) &&
            StylePriorityWins(priority, cascade.height_priority) {
                cascade.result.height = rules[index].style.height
                cascade.result.percent = StyleTakePercent(cascade.result.percent, rules[index].style, cast(u32)StyleHeight)
                cascade.result.fields |= cast(u32)StyleHeight
                cascade.height_priority = priority
            }
            if facts.kind == StyleKindGrid() &&
            StyleHasField(rules[index].style, cast(u32)StyleGridTracks) &&
            StylePriorityWins(priority, cascade.grid_tracks_priority) {
                cascade.result.grid_tracks = rules[index].style.grid_tracks
                cascade.result.fields |= cast(u32)StyleGridTracks
                cascade.grid_tracks_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleLineHeight) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.line_height_priority) {
                cascade.result.line_height = rules[index].style.line_height
                cascade.result.line_height_unit = rules[index].style.line_height_unit
                cascade.result.fields = cascade.result.fields | cast(u32)StyleLineHeight
                cascade.line_height_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleFontRole) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.font_role_priority) {
                cascade.result.font_role = rules[index].style.font_role
                cascade.result.fields = cascade.result.fields | cast(u32)StyleFontRole
                cascade.font_role_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleElevation) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.elevation_priority) {
                cascade.result.elevation = rules[index].style.elevation
                cascade.result.fields = cascade.result.fields | cast(u32)StyleElevation
                cascade.elevation_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMotionDuration) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.motion_duration_priority) {
                cascade.result.motion_duration = rules[index].style.motion_duration
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMotionDuration
                cascade.motion_duration_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMotionMultiplier) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.motion_multiplier_priority) {
                cascade.result.motion_multiplier = rules[index].style.motion_multiplier
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMotionMultiplier
                cascade.motion_multiplier_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMotionEasing) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.motion_easing_priority) {
                cascade.result.motion_easing = rules[index].style.motion_easing
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMotionEasing
                cascade.motion_easing_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMotionReduced) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.motion_reduced_priority) {
                cascade.result.motion_reduced = rules[index].style.motion_reduced
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMotionReduced
                cascade.motion_reduced_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleIconSize) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.icon_size_priority) {
                cascade.result.icon_size = rules[index].style.icon_size
                cascade.result.fields = cascade.result.fields | cast(u32)StyleIconSize
                cascade.icon_size_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleContentOffset) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.content_offset_priority) {
                cascade.result.offset_x = rules[index].style.offset_x
                cascade.result.offset_y = rules[index].style.offset_y
                cascade.result.fields = cascade.result.fields | cast(u32)StyleContentOffset
                cascade.content_offset_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleBackgroundEnd) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.background_end_priority) {
                cascade.result.background_end = rules[index].style.background_end
                cascade.result.fields = cascade.result.fields | cast(u32)StyleBackgroundEnd
                cascade.background_end_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleMaterial) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.material_priority) {
                cascade.result.material = rules[index].style.material
                cascade.result.fields = cascade.result.fields | cast(u32)StyleMaterial
                cascade.material_priority = priority
            }
            if (rules[index].style.fields & cast(u32)StyleTypeface) != cast(u32)0 &&
            StylePriorityWins(priority, cascade.typeface_priority) {
                cascade.result.typeface = rules[index].style.typeface
                cascade.result.fields = cascade.result.fields | cast(u32)StyleTypeface
                cascade.typeface_priority = priority
            }
        }
        index += 1
    }
    return cascade
}
// Caller-owned tables resolve from this copy; the installed table resolves
// in place through ResolveInstalledStyleRules.
resolve_rules: StyleRules;

#program_export
ResolveStyleRules :: (rules: StyleRules, base: StyleData,
    facts: StyleFacts, active_state: s32) -> StyleData {
    resolve_rules = rules
    limit: s32 = resolve_rules.count
    if limit < 0 { limit = 0 }
    if limit > StyleRuleCapacity { limit = StyleRuleCapacity }
    cascade: StyleCascade = ApplyStyleRules(BeginStyleCascade(base),
        resolve_rules.items[0:limit], facts, active_state)
    result: StyleData = cascade.result
    return result
}

// Resolve directly from installation data. The first matching rule wins each
// field because indices are ordered by the complete cascade priority tuple.
#program_export
ResolveInstalledStyleRules :: (base: StyleData, facts: StyleFacts,
    active_state: s32) -> StyleData {
    return ResolveIndexedStyle(base, facts, active_state, true, null, cast(u32)0)
}

// A keyboard focus ring: the rectangle to stroke, its corner radius and
// its stroke width.
FocusRing :: struct {
    bounds: Rectangle
    radius: float32
    width: float32
}

// The ring a focused widget of style `kind` draws around `bounds`: CSS
// outline-width and outline-offset from the rules for its id and class in
// the focus state, else a 2px ring just outside the edge.
#program_export
FocusRingFor :: (kind: s32, id: s32, class_name: s32, bounds: Rectangle, radius: float32) -> FocusRing {
    facts := StyleDefaultFacts(kind)
    facts.id = id
    facts.class_name = class_name
    // Only a widget drawing its ring asks; a sheet without outline rules
    // answers at once.
    outline: StyleBoxData
    unused ResolveIndexedStyle(StyleData.{}, facts, cast(s32)ButtonStateFocus, false, null, cast(u32)0,
        *outline, cast(u32)StyleBoxOutlineFields)
    width: float32 = 2.0
    offset: float32 = 0.0
    if (outline.fields & cast(u32)StyleBoxOutlineWidth) != 0 && outline.outline_width > 0.0 {
        width = outline.outline_width
    }
    if (outline.fields & cast(u32)StyleBoxOutlineOffset) != 0 { offset = outline.outline_offset }
    grow := offset + width
    return .{.bounds = Rectangle.{bounds.x - grow, bounds.y - grow, bounds.width + grow * 2.0,
        bounds.height + grow * 2.0}, .radius = radius + grow, .width = width}
}

#program_export
ResolveInstalledLayoutStyle :: (facts: StyleFacts, flex: *StyleFlexData,
    box: *StyleBoxData = null) -> StyleData {
    defaults: StyleData
    return ResolveIndexedStyle(defaults, facts, StyleStateAny(), true, flex,
        cast(u32)StyleFlexContainerFields, box, cast(u32)StyleBoxContainerFields)
}

#program_export
ResolveInstalledFlexItem :: (facts: StyleFacts) -> StyleFlexData {
    defaults: StyleData
    flex: StyleFlexData
    ResolveIndexedStyle(defaults, facts, StyleStateAny(), false, *flex, cast(u32)StyleFlexItemFields)
    return flex
}

ApplyFlexFields :: (target: *StyleFlexData, value: *StyleFlexData, fields: u32) {
    if (fields & cast(u32)StyleFlexDirection) != 0 { target.direction = value.direction }
    if (fields & cast(u32)StyleFlexJustify) != 0 { target.justify_content = value.justify_content }
    if (fields & cast(u32)StyleFlexAlign) != 0 { target.align_items = value.align_items }
    if (fields & cast(u32)StyleFlexBasis) != 0 { target.basis = value.basis }
    if (fields & cast(u32)StyleFlexGrow) != 0 { target.grow = value.grow }
    if (fields & cast(u32)StyleFlexShrink) != 0 { target.shrink = value.shrink }
    if (fields & cast(u32)StyleFlexSelf) != 0 { target.align_self = value.align_self }
    if (fields & cast(u32)StyleFlexWrap) != 0 {
        target.wrap = value.wrap
        // A wrap value clears a wrap-reverse set earlier in the cascade.
        target.wrap_reverse = false
    }
    if (fields & cast(u32)StyleFlexWrapReverse) != 0 {
        target.wrap = true
        target.wrap_reverse = true
    }
    if (fields & cast(u32)StyleFlexAlignContent) != 0 { target.align_content = value.align_content }
    if (fields & cast(u32)StyleFlexOrder) != 0 { target.order = value.order }
    target.percent = (target.percent & ~fields) | (value.percent & fields)
    target.fields |= fields
}

ApplyBoxFields :: (target: *StyleBoxData, value: *StyleBoxData, fields: u32) {
    if (fields & cast(u32)StyleBoxMinWidth) != 0 { target.min_width = value.min_width }
    if (fields & cast(u32)StyleBoxMaxWidth) != 0 { target.max_width = value.max_width }
    if (fields & cast(u32)StyleBoxMaxHeight) != 0 { target.max_height = value.max_height }
    if (fields & cast(u32)StyleBoxClipChildren) != 0 { target.clip_children = value.clip_children }
    if (fields & cast(u32)StyleBoxTextAlign) != 0 { target.text_align = value.text_align }
    if (fields & cast(u32)StyleBoxMarginTop) != 0 { target.margin_top = value.margin_top }
    if (fields & cast(u32)StyleBoxMarginRight) != 0 { target.margin_right = value.margin_right }
    if (fields & cast(u32)StyleBoxMarginBottom) != 0 { target.margin_bottom = value.margin_bottom }
    if (fields & cast(u32)StyleBoxMarginLeft) != 0 { target.margin_left = value.margin_left }
    if (fields & cast(u32)StyleBoxTransformFields) != 0 {
        if (fields & cast(u32)StyleBoxTransform) != 0 { target.transform = value.transform }
        if (fields & cast(u32)StyleBoxRotate) != 0 { target.rotate = value.rotate }
        if (fields & cast(u32)StyleBoxScale) != 0 { target.scale = value.scale }
        if (fields & cast(u32)StyleBoxTranslate) != 0 { target.translate = value.translate }
        if (fields & cast(u32)StyleBoxOriginX) != 0 { target.transform_origin[0] = value.transform_origin[0] }
        if (fields & cast(u32)StyleBoxOriginY) != 0 { target.transform_origin[1] = value.transform_origin[1] }
        if (fields & cast(u32)StyleBoxTransformMotion) != 0 {
            target.transform_seconds = value.transform_seconds
            target.transform_timing = value.transform_timing
        }
    }
    if (fields & cast(u32)StyleBoxGradient) != 0 {
        target.gradient_dx = value.gradient_dx
        target.gradient_dy = value.gradient_dy
        target.gradient_corner = value.gradient_corner
        target.gradient_count = value.gradient_count
        target.gradient_stops = value.gradient_stops
        target.gradient_colors = value.gradient_colors
    }
    if (fields & cast(u32)StyleBoxRadial) != 0 {
        target.radial_shape = value.radial_shape
        target.radial_size = value.radial_size
        target.radial_cx = value.radial_cx
        target.radial_cy = value.radial_cy
        target.radial_rx = value.radial_rx
        target.radial_ry = value.radial_ry
        // A radial gradient keeps its stops in the box's shared gradient
        // stop storage; its first and last colors stay on the face.
        target.gradient_count = value.gradient_count
        target.gradient_stops = value.gradient_stops
        target.gradient_colors = value.gradient_colors
    }
    if (fields & cast(u32)StyleBoxOutlineWidth) != 0 { target.outline_width = value.outline_width }
    if (fields & cast(u32)StyleBoxOutlineOffset) != 0 { target.outline_offset = value.outline_offset }
    if (fields & cast(u32)StyleBoxBorderSides) != 0 {
        for side: cast(u32)0..3 {
            if (fields & (cast(u32)StyleBoxBorderTop << side)) != 0 {
                target.border_widths[side] = value.border_widths[side]
            }
            if (fields & (cast(u32)StyleBoxBorderTopColor << side)) != 0 {
                target.border_colors[side] = value.border_colors[side]
            }
        }
    }
    target.percent = (target.percent & ~fields) | (value.percent & fields)
    target.fields |= fields
}

ResolveIndexedStyle :: (base: StyleData, facts: StyleFacts, active_state: s32,
    resolve_face: bool, flex: *StyleFlexData, flex_fields: u32,
    box: *StyleBoxData = null, box_fields: u32 = 0) -> StyleData {
    remaining := ifx resolve_face then installed_fields else cast(u32)0
    remaining_flex := ifx flex != null then installed_flex_fields & flex_fields else cast(u32)0
    remaining_box := ifx box != null then installed_box_fields & box_fields else cast(u32)0
    if facts.kind != StyleKindGrid() { remaining &= ~cast(u32)StyleGridTracks }
    container_layout := StyleIsContainerLayout(facts.kind)
    if container_layout {
        if (remaining & cast(u32)StyleGap) != 0 {
            remaining |= cast(u32)StyleRowGap | cast(u32)StyleColumnGap
        }
    } else {
        // Ignore container size bits so they cannot prolong another widget's search.
        remaining &= ~(cast(u32)StyleWidth | cast(u32)StyleHeight)
    }
    if remaining == 0 && remaining_flex == 0 && remaining_box == 0 { return base }
    kind := StyleBucket(facts.kind) * StyleIndexWords
    variant := StyleBucket(StyleTextVariant(facts)) * StyleIndexWords
    class_name := StyleBucket(facts.class_name) * StyleIndexWords
    state := StyleBucket(active_state) * StyleIndexWords
    for word: 0..cast(s32)(StyleIndexWords - 1) {
        candidates := (installed_any_kind[word] | installed_kind_bits[kind + word] |
            installed_kind_bits[variant + word]) &
            (installed_any_class[word] | installed_class_bits[class_name + word]) &
            (installed_any_state[word] | installed_state_bits[state + word])
        relevant: u64 = 0
        if remaining != 0 { relevant |= installed_face_bits[word] }
        if remaining_flex != 0 { relevant |= installed_flex_bits[word] }
        if remaining_box != 0 { relevant |= installed_box_bits[word] }
        candidates &= relevant
        while candidates != 0 {
            index := word * 64 + StyleFirstBit(candidates)
            candidates &= candidates - cast(u64)1
            if StyleRuleMatchesState(installed_states[index], active_state) &&
            StyleSelectorMatches(installed_selectors[index], facts) && (installed_selectors[index].context == 0 ||
                StyleContextMatches(installed_selectors[index], facts, active_state)) {
                rule := *installed_rules.items[installed_rule_indices[index]]
                if remaining != 0 {
                    value := rule.style
                    if container_layout && StyleHasField(value, cast(u32)StyleGap) {
                        if !StyleHasField(value, cast(u32)StyleRowGap) { value.row_gap = value.gap }
                        if !StyleHasField(value, cast(u32)StyleColumnGap) { value.column_gap = value.gap }
                        value.fields |= cast(u32)StyleRowGap | cast(u32)StyleColumnGap
                    }
                    // A percentage sizes only a container; other widgets keep looking.
                    if !container_layout { value.fields &= ~value.percent }
                    value.fields &= remaining
                    base = MergeValues(base, value)
                    remaining &= ~value.fields
                }
                if remaining_flex != 0 {
                    fields := remaining_flex & rule.flex.fields
                    if fields != 0 { ApplyFlexFields(flex, *rule.flex, fields) }
                    remaining_flex &= ~fields
                }
                if remaining_box != 0 {
                    fields := remaining_box & rule.box.fields
                    if fields != 0 { ApplyBoxFields(box, *rule.box, fields) }
                    remaining_box &= ~fields
                }
                if remaining == 0 && remaining_flex == 0 && remaining_box == 0 { return base }
            }
        }
    }
    return base
}
