#import "app"
#import "canvas_host"
#import "dom_tree"
#import "dom_host"
#import "dom_paint"
#import "page_core"
#import "geometry"
#import "session"
#import "std/number_text"
#import "tree"
#import "tree_draw"
#import "tree_input"

using FrameStatus;

libc :: #system_library "libc";
DomWrite :: (fd: s32, input: *u8, count: usize) -> isize #foreign libc "write";

DomError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = cast(u8)10
    DomWrite(2, *output[0], cast(usize)(length + 1))
    return 1
}

DomFrameCommit :: (session: Session) -> FrameStatus {
    if DomDocumentLayout() { return EndFrame(session) }
    return DomPaintFrame(session)
}

DrawDomFrame :: (session: Session, viewport: Rectangle) -> bool {
    BeginCanvasFrame()
    pointer: PointerFrame = PollPointer()
    TreePointerUpdate(session, pointer)
    DomHostFrame(session)
    PointerWheelSend(session, pointer.x, pointer.y, CanvasWheelMove())
    if BeginFrame(session, cast(u64)1, viewport) != cast(FrameStatus)FrameOk {
        EndCanvasFrame()
        DomError("kryon: browser document could not begin")
        return false
    }
    if Frame(session, viewport) != 0 {
        TreeCancel(session)
        EndCanvasFrame()
        DomError("kryon: browser document frame failed")
        return false
    }
    commit_status := DomFrameCommit(session)
    if commit_status != cast(FrameStatus)FrameOk {
        EndCanvasFrame()
        failure := FrameFailureAt(session)
        detail: [240]u8
        length: s64 = 0
        digits: [24]u8
        parts: [7]string = .["kryon: browser document could not commit: ", failure.message,
            " (kind ", FormatInteger(cast(s64)failure.kind, digits[:]), ")"]
        for part: parts {
            for byte: part {
                if length < 239 { detail[length] = byte; length += 1 }
            }
        }
        DomError(TextView(detail[0:length]))
        depth := TreeFramePendingScopes(session)
        depth_detail: [96]u8
        depth_digits: [24]u8
        kind_digits: [24]u8
        depth_parts: [5]string = .["kryon: pending scopes: ", FormatInteger(cast(s64)depth, depth_digits[:]),
            ", kind ", FormatInteger(cast(s64)failure.kind, kind_digits[:]), ", submitted above"]
        depth_length: s64 = 0
        for part: depth_parts {
            for byte: part {
                if depth_length < 95 { depth_detail[depth_length] = byte; depth_length += 1 }
            }
        }
        DomError(TextView(depth_detail[0:depth_length]))
        return false
    }
    if !DomReconcile(session, viewport) {
        EndCanvasFrame()
        DomError("kryon: document layout contains an unsupported widget")
        return false
    }
    if !EndCanvasFrame() {
        DomError("kryon: browser document raster failed")
        return false
    }
    return true
}

#program_export
main :: () -> s32 {
    if !OpenCanvas() {
        CloseCanvas()
        return DomError("kryon: could not open the browser document")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseCanvas()
        return DomError("kryon: could not open a UI session")
    }
    page_native_dom = true
    ok: bool = true
    while ok && PollCanvas() {
        key: s32 = CanvasPressedKey()
        if key != 0 { KeyboardSend(session, key) }
        codepoint: s32 = CanvasTypedCodepoint()
        while codepoint != 0 {
            TypedCodepointSend(session, codepoint)
            codepoint = CanvasTypedCodepoint()
        }
        ok = DrawDomFrame(session, CanvasViewport())
    }
    CloseSession(session)
    DomPaintClose()
    DomClose()
    CloseCanvas()
    if ok { return 0 }
    return DomError("kryon: browser document rendering failed")
}
