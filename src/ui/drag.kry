#module "drag_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_popup_input_internal.h"
#import "ui/widget_store.h"
#import "ui/widget_input.h"
#import "ui/paint_command.h"
#import "ui/numeric_edit.h"
#import "runtime/drag.h"
#import "runtime/input.h"
#import "stdio.h"

DragDelta :: (token: i32, focus_id: i32,
bounds: Rectangle, disabled: i32, delta: *float) -> i32 {
    toolkit: *ToolkitStore = toolkit_store_current()
    mouse: Vector2 = ui_mouse_world()
    disabled = disabled || ContentDisabled()
    hot: i32 = !disabled && ui_hot(bounds)
    *delta = 0.0
    decision: DragPointerDecision = DragPointerDecisionFor(
    toolkit->drag_active != 0, toolkit->drag_active == token,
    hot, disabled != 0,
    toolkit->drag_active != 0 &&
    ui_popup_input_owner_captures(toolkit->drag_owner),
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0)
    if decision.clear_active { toolkit->drag_active = 0 }
    if hot { MarkClickable() }
    if decision.start_active {
        toolkit->drag_active = token
        toolkit->drag_last_x = mouse.x
        toolkit->drag_owner = ui_popup_input_owner()
        if focus_id > 0 { SetFocus(focus_id) }
    }
    if decision.update_delta {
        *delta = mouse.x - toolkit->drag_last_x
        toolkit->drag_last_x = mouse.x
    }
    if decision.finish_active { toolkit->drag_active = 0 }
    return *delta != 0.0
}

DragKeyboardInputNow :: () -> DragKeyboardInput {
    return DragKeyboardInputFor(
    DragKeyboardDirectionFor(IsKeyPressed(KEY_RIGHT) != 0,
    IsKeyPressed(KEY_LEFT) != 0),
    IsKeyPressed(KEY_HOME) != 0, IsKeyPressed(KEY_END) != 0,
    (IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT)) != 0,
    (IsKeyDown(KEY_LEFT_SHIFT) || IsKeyDown(KEY_RIGHT_SHIFT)) != 0)
}

DragKeyboardEnabled :: (focus_id: i32) -> i32 {
    return focus_id > 0 && DragKeyboardShouldRun(
    IsFocusActive(focus_id) != 0,
    IsKeyboardInputEnabled() != 0,
    ui_popup_input_focus_captures(focus_id) != 0)
}

DragContinuousKeyboard :: (focus_id: i32, speed: float,
minimum: float, maximum: float, value: *float) -> i32 {
    if !DragKeyboardEnabled(focus_id) { return 0 }
    step: DragStep = DragKeyboardValue(*value, speed,
    minimum, maximum, DragKeyboardInputNow())
    if !step.changed { return 0 }
    *value = step.value
    return 1
}

DragDiscreteKeyboard :: (focus_id: i32, speed: float,
minimum: i32, maximum: i32, value: *i32) -> i32 {
    if !DragKeyboardEnabled(focus_id) { return 0 }
    step: DragDiscreteStep = DragDiscreteKeyboardValue(*value, speed,
    minimum, maximum, DragKeyboardInputNow())
    if !step.changed { return 0 }
    *value = step.value
    return 1
}

ui_update_drag_continuous :: (drag: DragContinuousProps) -> i32 #export {
    count: i32 = drag.value_count
    if drag.values == nil || count <= 0 { return 0 }
    changed: i32 = 0
    speed: float = DragEffectiveSpeed(drag.speed)
    index: i32 = 0
    while index < count {
        focus_id: i32 = ui_numeric_focus_id(drag.id, index, 0)
        cell: Rectangle = DragCellBoundsFor(drag.bounds, count, index)
        delta: float = 0.0
        enabled: i32 = !drag.disabled && !ContentDisabled()
        editing: i32 = 0
        if enabled && focus_id > 0 { RegisterFocus(focus_id, cell) }
        changed |= ui_numeric_temp_edit(cell, NUMERIC_EDIT_DRAG_FLOAT,
        drag.id, index, focus_id, &drag.values[index], drag.format,
        drag.disabled, 0, &editing)
        if !editing {
            if enabled && DragContinuousKeyboard(focus_id, speed,
            drag.min, drag.max, &drag.values[index]) { changed = 1 }
            if DragDelta(DragComponentTokenFor(drag.id, index),
            focus_id, cell, drag.disabled, &delta) {
                step: DragStep = DragDeltaValue(drag.values[index],
                delta, speed, drag.min, drag.max)
                if step.changed {
                    drag.values[index] = step.value
                    changed = 1
                }
            }
        }
        index += 1
    }
    return changed
}

ui_update_drag_discrete :: (drag: DragDiscreteProps) -> i32 #export {
    count: i32 = drag.value_count
    if drag.values == nil || count <= 0 { return 0 }
    changed: i32 = 0
    speed: float = DragEffectiveSpeed(drag.speed)
    index: i32 = 0
    while index < count {
        focus_id: i32 = ui_numeric_focus_id(drag.id, index, 1)
        cell: Rectangle = DragCellBoundsFor(drag.bounds, count, index)
        delta: float = 0.0
        enabled: i32 = !drag.disabled && !ContentDisabled()
        editing: i32 = 0
        if enabled && focus_id > 0 { RegisterFocus(focus_id, cell) }
        changed |= ui_numeric_temp_edit(cell, NUMERIC_EDIT_DRAG_INT,
        drag.id, index, focus_id, &drag.values[index], drag.format,
        drag.disabled, 1, &editing)
        if !editing {
            if enabled && DragDiscreteKeyboard(focus_id, speed,
            drag.min, drag.max, &drag.values[index]) { changed = 1 }
            if DragDelta(DragComponentTokenFor(drag.id, index),
            focus_id, cell, drag.disabled, &delta) {
                step: DragDiscreteStep = DragDiscreteDeltaValue(
                drag.values[index], delta, speed, drag.min, drag.max)
                if step.changed {
                    drag.values[index] = step.value
                    changed = 1
                }
            }
        }
        index += 1
    }
    return changed
}

DragPaintCell :: (bounds: Rectangle, text: const char*,
disabled: i32, focused: i32, class_name: i32) {
    state: ButtonState = disabled != 0 ?
    ButtonStateDisabled : ButtonStateNormal
    frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, state, disabled, 0, class_name,
    StyleKindDragValue(), StyleAny())
    style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(frame).value)
    font: i32 = ResolveFont(0, StyleFontValue(style.fields,
    style.font_size), GetSmallFontSize())
    scale: float = (float)Scale(1000) / 1000.0
    paint: DragTextPaint = DragCellTextPaintFor(bounds,
    DragTextInsetFor(scale), (float)TextLineHeight(font))
    DrawWidgetFrame(bounds, bounds, frame, 0, 0,
    disabled, focused)
    RenderText(text, (int)paint.text_x, (int)paint.text_y,
    font, Fade(style.foreground, style.opacity))
}

DragPaintLabel :: (bounds: Rectangle, label: const char*,
class_name: i32) {
    if label == nil { return }
    frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindDrag(), StyleAny())
    style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(frame).value)
    font: i32 = ResolveFont(0, StyleFontValue(style.fields,
    style.font_size), GetSmallFontSize())
    scale: float = (float)Scale(1000) / 1000.0
    paint: DragTextPaint = DragLabelTextPaintFor(bounds,
    DragTextInsetFor(scale), font, DragLabelGapFor(scale))
    RenderText(label, (int)paint.text_x, (int)paint.text_y,
    font, Fade(style.foreground, style.opacity))
}

ui_paint_drag_continuous :: (drag: DragContinuousProps) #export {
    if !IsWindowReady() || drag.values == nil ||
    drag.value_count <= 0 { return }
    index: i32 = 0
    while index < drag.value_count {
        cell: Rectangle = DragCellBoundsFor(drag.bounds,
        drag.value_count, index)
        text: [64]char
        focus_id: i32 = ui_numeric_focus_id(drag.id, index, 0)
        state: *NumericInputState = ui_numeric_input_find(
        NUMERIC_EDIT_DRAG_FLOAT, drag.id, index)
        disabled: i32 = drag.disabled || ContentDisabled()
        if state == nil || !state->focused {
            focused: i32 = !disabled && focus_id > 0 &&
            IsFocusActive(focus_id) &&
            !ui_popup_input_focus_captures(focus_id)
            format: const char* = drag.format
            if format == nil { format = InputDefaultFormat(NumericFloat) }
            snprintf(&text[0], sizeof(text), format, drag.values[index])
            DragPaintCell(cell, &text[0], disabled, focused,
            drag.class_name)
        }
        index += 1
    }
    DragPaintLabel(drag.bounds, drag.label, drag.class_name)
}

ui_paint_drag_discrete :: (drag: DragDiscreteProps) #export {
    if !IsWindowReady() || drag.values == nil ||
    drag.value_count <= 0 { return }
    index: i32 = 0
    while index < drag.value_count {
        cell: Rectangle = DragCellBoundsFor(drag.bounds,
        drag.value_count, index)
        text: [64]char
        focus_id: i32 = ui_numeric_focus_id(drag.id, index, 1)
        state: *NumericInputState = ui_numeric_input_find(
        NUMERIC_EDIT_DRAG_INT, drag.id, index)
        disabled: i32 = drag.disabled || ContentDisabled()
        if state == nil || !state->focused {
            focused: i32 = !disabled && focus_id > 0 &&
            IsFocusActive(focus_id) &&
            !ui_popup_input_focus_captures(focus_id)
            format: const char* = drag.format
            if format == nil { format = InputDefaultFormat(NumericInt) }
            snprintf(&text[0], sizeof(text), format, drag.values[index])
            DragPaintCell(cell, &text[0], disabled, focused,
            drag.class_name)
        }
        index += 1
    }
    DragPaintLabel(drag.bounds, drag.label, drag.class_name)
}
