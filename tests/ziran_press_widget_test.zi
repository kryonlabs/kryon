// A press clicks, becomes a hold after its time, reports the pointer while
// it lasts and, with capture, keeps it off the area; Enter and Space click it.
// Releasing the secondary button on it reports a right click there.
#import "session"
#import "geometry"
#import "press_props"
#import "press_widget"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "ziran_keyboard_navigation_host"
#import "scroll_props"
#import "scroll_widget"
Motion :: #import "scroll_device";

using FrameStatus;

session: Session;
result: PressResult;
capture: bool;
disabled: bool;

Frame :: (now: float64) -> bool {
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 300.0})
    result = Press(session, PressProps.{.id = 70, .label = "Message",
            .bounds = Rectangle.{10.0, 10.0, 100.0, 40.0}, .now = now,
            .capture = capture, .disabled = disabled})
    return EndFrame(session) == cast(FrameStatus)FrameOk
}

Pointer :: (x: float32, y: float32, down: bool, pressed: bool, released: bool) {
    unused TreePointerUpdate(session, PointerFrame.{x, y, down, pressed, released})
}

// The secondary button, released this frame or not, with the pointer at x, y.
Secondary :: (x: float32, y: float32, released: bool) {
    Pointer(x, y, false, false, false)
    TreeSecondaryPointerUpdate(session, SecondaryPointerFrame.{false, false, released})
}

#program_export
Answer :: () -> s32 {
    session = SessionOpen()
    if !Frame(0.0) || result.clicked || result.down { return 1 }

    // A short press clicks.
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(0.1) || !result.down || result.held { return 2 }
    Pointer(20.0, 20.0, false, false, true)
    if !Frame(0.2) || !result.clicked || !result.released || result.held { return 3 }

    // A long press holds once and does not click when it lifts.
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(1.0) || !result.down || result.held { return 4 }
    if TreePointerCapturesDrag(session) { return 19 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.3) || result.held { return 5 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.6) || !result.held || !result.down || result.x != 21.0 { return 6 }
    // Once held, the press keeps the pointer from an enclosing scroll.
    if !TreePointerCapturesDrag(session) { return 18 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.7) || result.held || !result.down { return 7 }
    Pointer(21.0, 20.0, false, false, true)
    if !Frame(1.8) || result.clicked || !result.released { return 8 }

    // With capture, the press keeps reporting the pointer off the area.
    capture = true
    if !Frame(2.0) { return 9 }
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(3.0) || !result.down { return 10 }
    Pointer(300.0, 200.0, true, false, false)
    if !Frame(3.1) || !result.down || result.x != 300.0 || result.y != 200.0 { return 11 }
    Pointer(300.0, 200.0, false, false, true)
    if !Frame(3.2) || !result.released || result.clicked { return 12 }
    capture = false

    // After Tab, Space clicks it like a button.
    unused KeyboardSend(session, KeyTab)
    if !Frame(4.0) { return 13 }
    unused KeyboardSend(session, 32)
    if !Frame(4.1) || !result.clicked { return 14 }
    unused KeyboardSend(session, 0)

    // Releasing the secondary button on the area is a right click there,
    // never a click; off the area it is nothing.
    Secondary(40.0, 30.0, true)
    if !Frame(4.5) || !result.right_clicked || result.clicked || result.x != 40.0 || result.y != 30.0 { return 28 }
    Secondary(40.0, 30.0, false)
    if !Frame(4.6) || result.right_clicked { return 29 }
    Secondary(300.0, 200.0, true)
    if !Frame(4.7) || result.right_clicked { return 30 }
    Secondary(300.0, 200.0, false)

    // A disabled area neither clicks nor holds.
    disabled = true
    if !Frame(5.0) { return 15 }
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(5.1) || result.down { return 16 }
    Pointer(20.0, 20.0, false, false, true)
    if !Frame(5.2) || result.clicked { return 17 }
    Secondary(20.0, 20.0, true)
    if !Frame(5.3) || result.right_clicked { return 31 }
    Secondary(20.0, 20.0, false)
    disabled = false

    // In a scrollable list a press arms the list's drag; once the press is
    // a hold it keeps the pointer, so moving on neither scrolls the list
    // nor cancels the press.
    if !ListFrame(10.0, 50.0, false, false, false) || list_offset != 0 { return 20 }
    if !ListFrame(10.1, 50.0, true, true, false) || !result.down { return 21 }
    if !ListFrame(10.7, 50.0, true, false, false) || !result.held { return 22 }
    if !ListFrame(10.8, 150.0, true, false, false) || !result.down || result.y != 150.0 || list_offset != 0 { return 23 }
    if !ListFrame(10.9, 250.0, true, false, false) || !result.down || list_offset != 0 { return 24 }
    if !ListFrame(11.0, 250.0, false, false, true) || !result.released || list_offset != 0 { return 25 }
    // Without a hold the same drag still scrolls the list.
    if !ListFrame(12.0, 250.0, true, true, false) { return 26 }
    if !ListFrame(12.1, 150.0, true, false, false) || !ListFrame(12.2, 100.0, true, false, false) || list_offset == 0 { return 27 }
    SessionClose(session)
    return 42
}

list_offset: s32;

ListFrame :: (now: float64, y: float32, down: bool, pressed: bool, released: bool) -> bool {
    Pointer(20.0, y, down, pressed, released)
    Motion.BeginScrollFrame(session, Vector2.{20.0, y}, pressed, down, released, 0.0, now)
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 300.0})
    list := Scroll(session, ScrollProps.{.key = cast(u64)80, .bounds = Rectangle.{0.0, 0.0, 300.0, 300.0},
            .content_height = 2000, .scroll_offset = list_offset})
    list_offset = list.scroll_offset
    if list.opened {
        result = Press(session, PressProps.{.id = 81, .label = "Item",
                .bounds = Rectangle.{0.0, list.content.y, 280.0, 2000.0}, .now = now})
        End(session)
    }
    return EndFrame(session) == cast(FrameStatus)FrameOk
}

#program_export
main :: () -> s32 {
    answer := Answer()
    if answer != 42 {
        return answer
    }
    return 0
}
