#import "geometry"
#import "scroll"

// Device observations and drag ownership. Scroll observes the shared scroll
// device itself when the host sampled it this frame and `enabled` is false;
// a caller that supplies its own input retains grab and ownership from the
// returned frame.
ScrollInput :: struct {
    enabled: bool
    pointer_allowed: bool
    disabled: bool
    mouse: Vector2
    pressed: bool
    down: bool
    released: bool
    wheel: float32
    owns_drag: bool
    owner_captured: bool
    grab: float32
    content_drag: bool
    drag_origin_y: float32
    drag_origin_offset: s32
    drag_moving: bool
    // Observed from the shared scroll device, which Scroll then updates.
    device: bool
    now_seconds: float64
    sample_seconds: float64
    velocity: float32
    flinging: bool
    gliding: bool
    glide_target: s32
}

ScrollProps :: struct {
    key: u64
    class_name: s32
    scale: float32
    bounds: Rectangle
    content_height: s32
    content_width: s32
    horizontal: bool
    scroll_offset: s32
    scroll_delta: s32
    input: ScrollInput
    metrics: ScrollMetrics
}

ScrollResult :: struct {
    node: s32
    opened: bool
    viewport: Rectangle
    content: Rectangle
    scroll_offset: s32
    max_scroll: s32
    frame: ScrollFrame
}

// Retain the complete drag and momentum state between caller-supplied
// frames. A content press must remain a content drag while held; retaining
// only ownership and grab would reinterpret it as a scrollbar drag.
#program_export
ScrollInputAfter :: (input: ScrollInput, frame: ScrollFrame) -> ScrollInput {
    if frame.start_drag { input.owns_drag = true }
    if frame.clear_drag { input.owns_drag = false }
    input.grab = frame.grab
    input.content_drag = frame.content_drag
    input.drag_origin_y = frame.drag_origin_y
    input.drag_origin_offset = frame.drag_origin_offset
    input.drag_moving = frame.drag_moving
    input.sample_seconds = frame.sample_seconds
    input.velocity = frame.velocity
    input.flinging = frame.flinging
    input.gliding = frame.gliding
    input.glide_target = frame.glide_target
    return input
}
