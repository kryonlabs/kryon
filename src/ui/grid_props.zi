#import "geometry"

GridProps :: struct {
    bounds: Rectangle
    columns: s32
    min_item_width: s32
    max_columns: s32
    gap: s32
    padding: s32
    key: u64
}

GridMetrics :: struct {
    bounds: Rectangle
    content: Rectangle
    columns: s32
    gap: s32
    padding: s32
    cell_width: s32
}

GridCursor :: struct {
    metrics: GridMetrics
    item: Rectangle
    x: s32
    y: s32
    col: s32
    row_height: s32
    used_height: s32
}
