#module "widget_input_host"
#import "ui_internal.h"
#import "ui_popup_input_internal.h"
#import "runtime/input.h"
#import "runtime/text.h"
#import "runtime/scroll.h"

ui_contains :: (bounds: Rectangle, point: Vector2) -> i32 #export {
    return CheckCollisionPointRec(point, bounds)
}

ui_hot :: (bounds: Rectangle) -> i32 #export {
    mouse: Vector2 = ui_mouse_world()
    return ui_contains(bounds, mouse) && !InputCapturesClick(mouse)
}

ui_focusable_pressed :: (bounds: Rectangle, id: i32,
disabled: i32, focused: *i32) -> i32 #export {
    mouse: Vector2 = ui_mouse_world()
    enabled: i32 = !disabled && !ContentDisabled()
    inside: i32 = ui_contains(bounds, mouse)
    captured: i32 = InputCapturesClick(mouse)
    interaction: InputPointerInteraction = InputPointerInteractionFor(
    inside != 0, captured != 0, !enabled,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    ReleaseConsumed() != 0, press_started_inside(bounds) != 0)
    hot: i32 = interaction.active
    active: i32 = ui_accessibility_take_activation(id) && enabled

    *focused = 0
    if enabled != 0 && id > 0 {
        *focused = RegisterFocus(id, bounds) &&
        !ui_popup_input_focus_captures(id)
    }
    if hot != 0 {
        MarkClickable()
    } else if interaction.disabled_marker {
        MarkDisabled()
    }
    if interaction.consume_release { ConsumeRelease() }
    if interaction.activated {
        if id > 0 { SetFocus(id) }
        *focused = id > 0
        active = 1
    }
    if enabled != 0 && id > 0 && IsFocusActivatePressed(id) {
        active = 1
    }
    return active
}

ui_row_text_y :: (bounds: Rectangle, font: i32) -> i32 #export {
    return TextCenteredY(bounds, TextLineHeight(font))
}

ui_selection_button_state :: (hovered: i32, down: i32,
focused: i32, disabled: i32) -> ButtonState #export {
    if disabled != 0 { return ButtonStateDisabled }
    if down != 0 { return ButtonStatePressed }
    if focused != 0 { return ButtonStateFocus }
    if hovered != 0 { return ButtonStateHover }
    return ButtonStateNormal
}

ScrollMaximum :: (content_height: i32,
viewport_height: i32) -> i32 {
    if content_height <= viewport_height { return 0 }
    return content_height - viewport_height
}

ui_update_scroll :: (bounds: Rectangle, content_height: i32,
scroll_offset: *i32, row_height: i32) -> i32 #export {
    if scroll_offset == nil { return 0 }
    maximum: i32 = ScrollMaximum(content_height,
    (int)bounds.height)
    if *scroll_offset < 0 { *scroll_offset = 0 }
    if *scroll_offset > maximum { *scroll_offset = maximum }

    mouse: Vector2 = ui_mouse_world()
    if !ui_contains(bounds, mouse) || InputCapturesClick(mouse) {
        return maximum
    }
    wheel: float = GetMouseWheelMove()
    if wheel != 0.0 {
        scale: float = (float)Scale(1000) / 1000.0
        step: i32 = ScrollRowWheelStepFor(row_height, scale)
        *scroll_offset -= (int)(wheel * (float)step)
        if *scroll_offset < 0 { *scroll_offset = 0 }
        if *scroll_offset > maximum { *scroll_offset = maximum }
    }
    return maximum
}
