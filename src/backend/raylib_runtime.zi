RaylibAsset :: struct {
    path: [1024]u8
    length: s32
    texture: Texture2D
}

// Image textures by asset path. A photo grid draws dozens of thumbnails per
// frame; the cache must hold every visible image or each frame reloads them.
RaylibAssetCapacity :: 128
raylib_assets: [RaylibAssetCapacity]RaylibAsset;
raylib_assets_count: s32;
raylib_assets_next: s32;
raylib_pointer: PointerFrame;
raylib_secondary: SecondaryPointerFrame;
raylib_middle: SecondaryPointerFrame;
raylib_repeat_next: s32;

// The zoom factor the frame is drawn at. Everything drawn after the frame
// begins is scaled by it, so a single number scales the whole application;
// the viewport and pointer are reported in the scaled space, and fonts are
// baked at their scaled size so text stays sharp.
raylib_zoom: float32 = 1.0;
raylib_wheel_move: float32;
raylib_image_error: bool;
raylib_font: RaylibFont;
raylib_font_loaded: bool;
raylib_font_registered: bool;
raylib_active_typeface_index: s32 = -1;

// A typeface keeps its source so glyphs can be added the first time text
// uses them; raylib bakes a fixed codepoint list into each font atlas.
RaylibTypeface :: struct {
    name: [64]u8
    name_length: s32
    font: RaylibFont
    // Atlases baked at the exact pixel sizes text asks for; scaling one
    // atlas to another size blurs glyphs and bleeds their neighbours.
    sized_fonts: [RAYLIB_SIZED_FONT_MAX]RaylibFont
    sized_sizes: [RAYLIB_SIZED_FONT_MAX]s32
    sized_smooth: [RAYLIB_SIZED_FONT_MAX]bool
    sized_uses: [RAYLIB_SIZED_FONT_MAX]u64
    sized_clock: u64
    sized_count: s32
    data: *u8
    data_count: s32
    extension: [16]u8
    path: [1024]u8
    file_face: s32
    from_file: bool
    codepoints: *u8
    codepoint_count: s32
    codepoint_capacity: s32
    loaded: [2048]u32
}

RAYLIB_SIZED_FONT_MAX :: 16

raylib_typefaces: [16]RaylibTypeface;
raylib_typeface_count: s32;

RaylibTypefaceIndex :: (name: string) -> s32 {
    if name.count == 0 || name.count >= 64 {
        return -1
    }
    index: s32 = 0
    while index < raylib_typeface_count {
        if raylib_typefaces[index].name_length == cast(s32)name.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)name.count {
                if raylib_typefaces[index].name[at] != name[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same {
                return index
            }
        }
        index += 1
    }
    return -1
}

// Without an explicit seed a UI font starts with the scripts most locales
// need; anything else is added on first use.
raylib_default_glyph_ranges: [18]s32 = .[
0x0020, 0x007E, 0x00A0, 0x024F, 0x0370, 0x03FF, 0x0400, 0x04FF,
0x2010, 0x205E, 0x20A0, 0x20C0, 0x2190, 0x21FF, 0x2212, 0x2212,
0xFFFD, 0xFFFD];

RaylibHasGlyph :: (typeface: *RaylibTypeface, codepoint: s32) -> bool {
    if codepoint < 0 || codepoint > 0x10FFFF { return false }
    if codepoint > 0xFFFF {
        glyphs := cast(*s32)typeface.codepoints
        for index: 0..typeface.codepoint_count - 1 {
            if glyphs[index] == codepoint { return true }
        }
        return false
    }
    word: u32 = typeface.loaded[codepoint >> 5]
    return (word & (cast(u32)1 << cast(u32)(codepoint & 31))) != cast(u32)0
}

RaylibAddGlyph :: (typeface: *RaylibTypeface, codepoint: s32) -> bool {
    if codepoint < 0 || codepoint > 0x10FFFF ||
    (codepoint >= 0xD800 && codepoint <= 0xDFFF) { return false }
    if RaylibHasGlyph(typeface, codepoint) { return true }
    if typeface.codepoint_count == typeface.codepoint_capacity {
        capacity: s32 = typeface.codepoint_capacity * 2
        if capacity < 256 { capacity = 256 }
        grown: *u8 = HostTypefaceReallocate(typeface.codepoints,
            cast(usize)capacity * cast(usize)4)
        if grown == null { return false }
        typeface.codepoints = grown
        typeface.codepoint_capacity = capacity
    }
    at: *s32 = cast(*s32)(typeface.codepoints)
    at[typeface.codepoint_count] = codepoint
    typeface.codepoint_count += 1
    if codepoint <= 0xFFFF {
        typeface.loaded[codepoint >> 5] |= cast(u32)1 << cast(u32)(codepoint & 31)
    }
    return true
}

RaylibSeedGlyphs :: (typeface: *RaylibTypeface, seed: *s32,
    seed_count: s32) -> bool {
    if seed != null && seed_count > 0 {
        index: s32 = 0
        while index < seed_count {
            if !RaylibAddGlyph(typeface, seed[index]) { return false }
            index += 1
        }
        return true
    }
    range: s32 = 0
    while range < 18 {
        codepoint: s32 = raylib_default_glyph_ranges[range]
        while codepoint <= raylib_default_glyph_ranges[range + 1] {
            if !RaylibAddGlyph(typeface, codepoint) { return false }
            codepoint += 1
        }
        range += 2
    }
    return true
}

RaylibBakeTypeface :: (typeface: *RaylibTypeface,
    size: s32) -> RaylibFont {
    codepoints: *s32 = cast(*s32)(typeface.codepoints)
    font: RaylibFont
    if typeface.from_file {
        font = HostRaylibLoadFont(*typeface.path[0], size, codepoints,
            typeface.codepoint_count)
    } else {
        font = HostRaylibLoadFontFromMemory(*typeface.extension[0],
            typeface.data, typeface.data_count, size, codepoints,
            typeface.codepoint_count)
    }
    if font.texture.id != cast(u32)0 {
        // Native-size glyphs stay sharp; interpolation also keeps oversized
        // text and moving labels smooth when an atlas must be scaled.
        HostRaylibTextureFilter(font.texture, 1)
    }
    return font
}

RaylibUnloadTypefaceFonts :: (typeface: *RaylibTypeface) {
    HostRaylibUnloadFont(typeface.font)
    slot: s32 = 0
    while slot < typeface.sized_count {
        HostRaylibUnloadFont(typeface.sized_fonts[slot])
        slot += 1
    }
    typeface.sized_count = 0
}

RaylibTypefaceFontForPixels :: (typeface: *RaylibTypeface,
    pixels: s32, smooth: bool) -> RaylibFont {
    if pixels <= 0 || (pixels == typeface.font.base_size && smooth) {
        return typeface.font
    }
    typeface.sized_clock += cast(u64)1
    slot: s32 = 0
    oldest: s32 = 0
    while slot < typeface.sized_count {
        if typeface.sized_sizes[slot] == pixels &&
        typeface.sized_smooth[slot] == smooth {
            typeface.sized_uses[slot] = typeface.sized_clock
            return typeface.sized_fonts[slot]
        }
        if typeface.sized_uses[slot] < typeface.sized_uses[oldest] {
            oldest = slot
        }
        slot += 1
    }
    font := RaylibBakeTypeface(typeface, pixels)
    if font.texture.id == cast(u32)0 {
        return typeface.font
    }
    if !smooth {
        // The glyph bitmap already contains antialiasing coverage. Sampling
        // it directly preserves that coverage despite GPU transform rounding.
        HostRaylibTextureFilter(font.texture, 0)
    }
    if typeface.sized_count == RAYLIB_SIZED_FONT_MAX {
        slot = oldest
        // Queued text can still refer to the atlas being replaced.
        HostRaylibFlushBatch()
        HostRaylibUnloadFont(typeface.sized_fonts[slot])
    } else {
        slot = typeface.sized_count
        typeface.sized_count += 1
    }
    typeface.sized_fonts[slot] = font
    typeface.sized_sizes[slot] = pixels
    typeface.sized_smooth[slot] = smooth
    typeface.sized_uses[slot] = typeface.sized_clock
    return font
}

RaylibFreeTypefaceSource :: (typeface: *RaylibTypeface) {
    if typeface.data != null { HostTypefaceFree(typeface.data) }
    if typeface.codepoints != null { HostTypefaceFree(typeface.codepoints) }
    typeface.data = null
    typeface.codepoints = null
}

// Adds every codepoint of the text the active font has not baked yet and
// rebakes it once. Text measured and drawn afterwards uses the same atlas.
RaylibEnsureGlyphs :: (value: string) {
    index: s32 = raylib_active_typeface_index
    if index < 0 || index >= raylib_typeface_count { return }
    typeface: *RaylibTypeface = *raylib_typefaces[index]
    if typeface.codepoints == null { return }
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return }
    missing: bool = false
    at: s32 = 0
    while at < cast(s32)value.count {
        length: s32
        codepoint := HostRaylibCodepoint(*bytes[at], *length)
        at += length
        if codepoint >= 0x20 && !RaylibHasGlyph(typeface, codepoint) {
            if !RaylibAddGlyph(typeface, codepoint) { return }
            missing = true
        }
    }
    if missing && RaylibRebakeTypeface(typeface) { raylib_font = typeface.font }
}

RaylibRebakeTypeface :: (typeface: *RaylibTypeface) -> bool {
    font := RaylibBakeTypeface(typeface, 64)
    if font.texture.id == cast(u32)0 { return false }
    // Earlier text in this frame can still be queued with the old atlas.
    HostRaylibFlushBatch()
    HostRaylibUnloadFont(typeface.font)
    typeface.font = font
    slot: s32 = 0
    while slot < typeface.sized_count {
        font = RaylibBakeTypeface(typeface, typeface.sized_sizes[slot])
        if font.texture.id != cast(u32)0 {
            if !typeface.sized_smooth[slot] {
                HostRaylibTextureFilter(font.texture, 0)
            }
            HostRaylibUnloadFont(typeface.sized_fonts[slot])
            typeface.sized_fonts[slot] = font
        }
        slot += 1
    }
    return true
}

RaylibFontHasCodepoint :: (font: RaylibFont, codepoint: s32) -> bool {
    if font.glyphs == null || font.glyph_count <= 0 { return false }
    index := HostRaylibGlyphIndex(font, codepoint)
    if index < 0 || index >= font.glyph_count { return false }
    glyphs := cast(*RaylibGlyphInfo)font.glyphs
    return glyphs[index].value == codepoint
}

// Registered fonts are available on every host, including hosts without
// Fontconfig. Check the decoded glyph rather than just its requested seed:
// raylib can substitute '?' for a character absent from the source font.
RaylibRegisteredFallback :: (codepoint: s32) -> s32 {
    for index: 0..raylib_typeface_count - 1 {
        if index == raylib_active_typeface_index {
            continue
        }
        typeface := *raylib_typefaces[index]
        if !RaylibHasGlyph(typeface, codepoint) {
            if !RaylibAddGlyph(typeface, codepoint) || !RaylibRebakeTypeface(typeface) {
                continue
            }
        }
        if RaylibFontHasCodepoint(typeface.font, codepoint) {
            return index
        }
    }
    return -1
}

// Fallback sources and misses are bounded and shared by registered faces.
// They do not consume the application's named typeface slots.
raylib_fallback_faces: [16]RaylibTypeface;
raylib_fallback_face_count: s32;
RaylibFallbackEntry :: struct { codepoint: s32; primary: s32; face: s32 }
raylib_fallback_entries: [512]RaylibFallbackEntry;
raylib_fallback_entry_count: s32;
raylib_fallback_entry_next: s32;

RaylibCollectionSource :: (typeface: *RaylibTypeface, data: *u8,
    count: s32, face: s32) -> bool {
    bytes := TypefaceText.BytesFromPointer(data, cast(u64)count)
    size := TypefaceCollection.FaceSize(bytes, face)
    if size <= 0 { return false }
    normalized := HostTypefaceAllocate(cast(usize)size)
    if normalized == null { return false }
    output := TypefaceText.BytesFromPointer(normalized, cast(u64)size)
    if TypefaceCollection.Face(bytes, face, output).count == 0 {
        HostTypefaceFree(normalized); return false
    }
    typeface.data = normalized; typeface.data_count = size; typeface.from_file = false
    extension: string = ".ttf"
    if output[0] == 79 && output[1] == 84 && output[2] == 84 && output[3] == 79 { extension = ".otf" }
    unused CopyCString(extension, typeface.extension[:])
    return true
}

RaylibFileSource :: (typeface: *RaylibTypeface, path: string, face: s32) -> bool {
    if !CopyCString(path, typeface.path[:]) || !HostRaylibFileExists(*typeface.path[0]) { return false }
    typeface.from_file = true
    typeface.file_face = face
    collection: bool = path.count >= 4 &&
    (path[path.count - 4:path.count] == ".ttc" || path[path.count - 4:path.count] == ".TTC" ||
        path[path.count - 4:path.count] == ".otc" || path[path.count - 4:path.count] == ".OTC")
    if !collection { return face == 0 }
    count: s32
    bytes := HostTypefaceFileData(*typeface.path[0], *count)
    if bytes == null { return false }
    defer HostTypefaceFileDataFree(bytes)
    return RaylibCollectionSource(typeface, bytes, count, face)
}

RaylibFindFallback :: (codepoint: s32) -> s32 {
    for index: 0..raylib_fallback_entry_count - 1 {
        entry := raylib_fallback_entries[index]
        if entry.codepoint == codepoint && entry.primary == raylib_active_typeface_index {
            return entry.face
        }
    }
    path_bytes: [1024]u8
    source_face: s32
    path: string = ""
    #if !#defined(_WIN32) {
        family: string = "sans-serif"
        if raylib_active_typeface_index >= 0 {
            family = TypefaceText.TextFromCString(*raylib_typefaces[raylib_active_typeface_index].name[0])
        }
        path = SystemTypeface.FileFor(family, codepoint, path_bytes[:], *source_face)
    }
    face: s32 = -1
    if path != "" {
        for index: 0..raylib_fallback_face_count - 1 {
            if TypefaceText.TextFromCString(*raylib_fallback_faces[index].path[0]) == path &&
            raylib_fallback_faces[index].file_face == source_face {
                face = index
                break
            }
        }
        if face < 0 && raylib_fallback_face_count < 16 {
            staged: RaylibTypeface
            seed: [2]s32 = .[63, codepoint]
            if RaylibFileSource(*staged, path, source_face) && RaylibSeedGlyphs(*staged, *seed[0], 2) {
                staged.font = RaylibBakeTypeface(*staged, 64)
                if staged.font.texture.id != cast(u32)0 &&
                RaylibFontHasCodepoint(staged.font, codepoint) {
                    face = raylib_fallback_face_count
                    raylib_fallback_faces[face] = staged
                    raylib_fallback_face_count += 1
                } else {
                    if staged.font.texture.id != cast(u32)0 { HostRaylibUnloadFont(staged.font) }
                    RaylibFreeTypefaceSource(*staged)
                }
            } else { RaylibFreeTypefaceSource(*staged) }
        } else if face >= 0 {
            typeface := *raylib_fallback_faces[face]
            if !RaylibHasGlyph(typeface, codepoint) {
                if !RaylibAddGlyph(typeface, codepoint) || !RaylibRebakeTypeface(typeface) { face = -1 }
            }
            if face >= 0 && !RaylibFontHasCodepoint(typeface.font, codepoint) { face = -1 }
        }
    }
    slot := raylib_fallback_entry_count
    if slot < 512 { raylib_fallback_entry_count += 1 }
    else {
        slot = raylib_fallback_entry_next
        raylib_fallback_entry_next = (slot + 1) % 512
    }
    raylib_fallback_entries[slot] = .{codepoint, raylib_active_typeface_index, face}
    return face
}

RaylibStoreTypeface :: (name: string, staged: *RaylibTypeface) -> bool {
    if staged.font.texture.id == cast(u32)0 || name.count == 0 ||
    name.count >= 64 {
        return false
    }
    if !CopyCString(name, staged.name[:]) {
        return false
    }
    staged.name_length = cast(s32)name.count
    index: s32 = RaylibTypefaceIndex(name)
    if index < 0 {
        if raylib_typeface_count == 16 {
            return false
        }
        index = raylib_typeface_count
        raylib_typeface_count += 1
    } else {
        RaylibUnloadTypefaceFonts(*raylib_typefaces[index])
        RaylibFreeTypefaceSource(*raylib_typefaces[index])
        raylib_fallback_entry_count = 0
        raylib_fallback_entry_next = 0
    }
    raylib_typefaces[index] = staged.*
    if raylib_active_typeface_index == index {
        raylib_font = staged.font
        raylib_font_loaded = true
        raylib_font_registered = true
    }
    return true
}

#program_export
LoadTypefaceData :: (name: string, extension: string, data: string,
    seed: *s32, seed_count: s32) -> bool {
    if name.count == 0 || extension.count == 0 || data.count == 0 ||
    data.count > 2147483647 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    staged: RaylibTypeface
    if !CopyCString(extension, staged.extension[:]) {
        return false
    }
    // The bytes stay with the typeface so later glyphs can be baked.
    if extension == ".ttc" || extension == ".TTC" || extension == ".otc" || extension == ".OTC" {
        descriptor := cast(*TypefaceText.TextDescriptor)(*data)
        if !RaylibCollectionSource(*staged, descriptor.data, cast(s32)data.count, 0) { return false }
    } else {
        staged.data = HostTypefaceAllocate(cast(usize)data.count)
        if staged.data == null { return false }
        index: s32 = 0
        while index < cast(s32)data.count {
            staged.data[index] = data[index]
            index += 1
        }
        staged.data_count = cast(s32)data.count
    }
    if !RaylibSeedGlyphs(*staged, seed, seed_count) {
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    staged.font = RaylibBakeTypeface(*staged, 64)
    if staged.font.texture.id == cast(u32)0 {
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    if !RaylibStoreTypeface(name, *staged) {
        HostRaylibUnloadFont(staged.font)
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    return true
}

#program_export
LoadTypefaceFile :: (name: string, path: string,
    seed: *s32, seed_count: s32) -> bool {
    return RaylibLoadTypefaceFile(name, path, seed, seed_count, 0)
}

RaylibLoadTypefaceFile :: (name: string, path: string,
    seed: *s32, seed_count: s32, face: s32) -> bool {
    if name.count == 0 || path.count == 0 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    staged: RaylibTypeface
    // LoadFontEx returns raylib's default font for a missing file. That is
    // not a registered file source and must not replace the selected face.
    if !RaylibFileSource(*staged, path, face) { return false }
    if !RaylibSeedGlyphs(*staged, seed, seed_count) {
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    staged.font = RaylibBakeTypeface(*staged, 64)
    if staged.font.texture.id == cast(u32)0 {
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    if !RaylibStoreTypeface(name, *staged) {
        HostRaylibUnloadFont(staged.font)
        RaylibFreeTypefaceSource(*staged)
        return false
    }
    return true
}

#program_export
LoadSystemTypeface :: (name: string) -> bool {
    #if #defined(_WIN32) {
        // Windows uses registered file/data fonts until it has an OS resolver.
        return false
    } else {
        path_bytes: [1024]u8
        if name.count == 0 || name.count >= 64 { return false }
        face: s32
        path := SystemTypeface.FileFor(name, 0, path_bytes[:], *face)
        return path != "" && RaylibLoadTypefaceFile(name, path, null, 0, face)
    }
}

#program_export
SelectTypeface :: (name: string) -> bool {
    index: s32 = RaylibTypefaceIndex(name)
    if index < 0 {
        return false
    }
    if raylib_font_loaded && !raylib_font_registered {
        HostRaylibUnloadFont(raylib_font)
    }
    raylib_font = raylib_typefaces[index].font
    raylib_font_loaded = true
    raylib_font_registered = true
    raylib_active_typeface_index = index
    return true
}

#program_export
ReleaseTypefaces :: () {
    if raylib_font_loaded && !raylib_font_registered {
        HostRaylibUnloadFont(raylib_font)
    }
    index: s32 = 0
    while index < raylib_typeface_count {
        RaylibUnloadTypefaceFonts(*raylib_typefaces[index])
        RaylibFreeTypefaceSource(*raylib_typefaces[index])
        raylib_typefaces[index] = RaylibTypeface.{}
        index += 1
    }
    raylib_typeface_count = 0
    index = 0
    while index < raylib_fallback_face_count {
        RaylibUnloadTypefaceFonts(*raylib_fallback_faces[index])
        RaylibFreeTypefaceSource(*raylib_fallback_faces[index])
        raylib_fallback_faces[index] = RaylibTypeface.{}
        index += 1
    }
    raylib_fallback_face_count = 0
    raylib_fallback_entry_count = 0
    raylib_fallback_entry_next = 0
    raylib_active_typeface_index = -1
    raylib_font = RaylibFont.{}
    raylib_font_loaded = false
    raylib_font_registered = false
}

#program_export
ReleaseTypefaceCpu :: () {
    // raylib owns glyph data until UnloadFont releases the atlas.
}

RaylibTryFont :: (path: *u8) -> bool {
    if path == null || !HostRaylibFileExists(path) { return false }
    raylib_font = HostRaylibLoadFont(path, 32, null, 0)
    raylib_font_loaded = raylib_font.texture.id != cast(u32)0
    raylib_font_registered = false
    return raylib_font_loaded
}

RaylibRoundness :: (bounds: Rectangle, radius: float32) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 || radius <= 0.0 { return 0.0 }
    roundness: float32 = radius * 2.0 / edge
    if roundness > 1.0 { return 1.0 }
    return roundness
}

RaylibDrawImageStrip :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, origin: Vector2, rotation: float32,
    tint: Color, x: s32, y: s32, width: s32, height: s32) {
    if width <= 0 || height <= 0 { return }
    // An unrotated image inside its strip needs no scissor, which would
    // flush the draw batch.
    if rotation == 0.0 && origin.x == 0.0 && origin.y == 0.0 &&
    destination.x >= cast(float32)x && destination.y >= cast(float32)y &&
    destination.x + destination.width <= cast(float32)(x + width) &&
    destination.y + destination.height <= cast(float32)(y + height) {
        HostRaylibDrawTexture(texture, source, destination, origin, rotation, tint)
        return
    }
    saved := BeginRasterClip(Rectangle.{cast(float32)x, cast(float32)y,
            cast(float32)width, cast(float32)height})
    HostRaylibDrawTexture(texture, source, destination, origin, rotation, tint)
    EndRasterClip(saved)
}

// Scissor strips preserve DrawTexturePro's rotation and source mapping while
// following the same rounded clip boundary used by the Cairo host.
RaylibDrawImageClipped :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {
    x: s32 = cast(s32)clip.x
    y: s32 = cast(s32)clip.y
    width: s32 = cast(s32)clip.width
    height: s32 = cast(s32)clip.height
    if width <= 0 || height <= 0 { return }
    if radius <= 0.0 {
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x, y, width, height)
        return
    }
    if radius > cast(float32)width * 0.5 {
        radius = cast(float32)width * 0.5
    }
    if radius > cast(float32)height * 0.5 {
        radius = cast(float32)height * 0.5
    }
    if rotation == 0.0 && origin.x == 0.0 && origin.y == 0.0 &&
    texture.width > 0 && texture.height > 0 {
        RaylibDrawImageRounded(texture, source, destination, clip, radius, tint)
        return
    }
    rounded_rows: s32 = cast(s32)(radius + 0.5)
    if rounded_rows < 1 { rounded_rows = 1 }
    if rounded_rows * 2 > height { rounded_rows = height / 2 }
    row: s32 = 0
    while row < rounded_rows {
        dy: float32 = radius - (cast(float32)row + 0.5)
        inset: s32 = 0
        if dy > 0.0 {
            inset = cast(s32)(radius - HostRaylibSqrt(radius * radius -
                dy * dy) + 0.5)
        }
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + row,
            width - inset * 2, 1)
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + height - 1 - row,
            width - inset * 2, 1)
        row += 1
    }
    RaylibDrawImageStrip(texture, source, destination, origin,
        rotation, tint, x, y + rounded_rows,
        width, height - rounded_rows * 2)
}

// Draws the part of an image inside a destination-space rectangle by
// drawing that rectangle with the matching part of the source: clipping a
// texture to a sub-rectangle needs no scissor.
RaylibDrawImagePart :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, part: Rectangle, tint: Color) {
    part = RectangleIntersection(part, destination)
    if part.width <= 0.0 || part.height <= 0.0 { return }
    sub: Rectangle
    sub.x = source.x + (part.x - destination.x) / destination.width * source.width
    sub.y = source.y + (part.y - destination.y) / destination.height * source.height
    sub.width = part.width / destination.width * source.width
    sub.height = part.height / destination.height * source.height
    if source.width < 0.0 {
        sub.x = source.x - source.width +
        (part.x + part.width - destination.x) / destination.width * source.width
    }
    if source.height < 0.0 {
        sub.y = source.y - source.height +
        (part.y + part.height - destination.y) / destination.height * source.height
    }
    HostRaylibDrawTexture(texture, sub, part, Vector2.{0.0, 0.0}, 0.0, tint)
}

// The part of an image inside a rounded clip, drawn as source-mapped rows:
// one per corner row and one for the straight middle. Clipping it with a
// scissor per row instead flushed the draw batch dozens of times for every
// rounded image.
RaylibDrawImageRounded :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, clip: Rectangle, radius: float32, tint: Color) {
    region: Rectangle = RectangleIntersection(clip, destination)
    if region.width <= 0.0 || region.height <= 0.0 { return }
    if radius > region.width * 0.5 { radius = region.width * 0.5 }
    if radius > region.height * 0.5 { radius = region.height * 0.5 }
    rows: s32 = cast(s32)(radius + 0.5)
    if rows < 1 { rows = 1 }
    row_height: float32 = radius / cast(float32)rows
    row: s32 = 0
    while row < rows {
        dy: float32 = radius - (cast(float32)row + 0.5) * row_height
        inset: float32 = radius - HostRaylibSqrt(radius * radius - dy * dy)
        top: float32 = region.y + cast(float32)row * row_height
        bottom: float32 = region.y + region.height - cast(float32)(row + 1) * row_height
        RaylibDrawImagePart(texture, source, destination,
            Rectangle.{region.x + inset, top, region.width - inset * 2.0, row_height}, tint)
        RaylibDrawImagePart(texture, source, destination,
            Rectangle.{region.x + inset, bottom, region.width - inset * 2.0, row_height}, tint)
        row += 1
    }
    RaylibDrawImagePart(texture, source, destination,
        Rectangle.{region.x, region.y + radius, region.width,
            region.height - radius * 2.0}, tint)
}

RaylibAssetIndex :: (path: string) -> s32 {
    if path.count == 0 || path.count >= 1024 { return -1 }
    index: s32 = 0
    while index < raylib_assets_count {
        if raylib_assets[index].length == cast(s32)path.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)path.count {
                if raylib_assets[index].path[at] != path[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same { return index }
        }
        index += 1
    }
    if raylib_assets_count < RaylibAssetCapacity {
        index = raylib_assets_count
        raylib_assets_count += 1
    } else {
        index = raylib_assets_next
        // The draw batch can still refer to the texture being evicted.
        HostRaylibFlushBatch()
        HostRaylibUnloadTexture(raylib_assets[index].texture)
        raylib_assets_next = (raylib_assets_next + 1) % RaylibAssetCapacity
    }
    if !CopyCString(path, raylib_assets[index].path[:]) {
        raylib_assets[index].length = 0
        return -1
    }
    raylib_assets[index].length = cast(s32)path.count
    raylib_assets[index].texture =
    HostRaylibLoadTexture(*raylib_assets[index].path[0])
    if raylib_assets[index].texture.id == cast(u32)0 {
        raylib_assets[index].length = 0
        return -1
    }
    return index
}

// Resource updates keep the window, fonts and retained targets alive. Flush
// queued draws before releasing image names that the batch may still use.
#program_export
InvalidateRaylibAssets :: () {
    HostRaylibFlushBatch()
    index: s32 = 0
    while index < raylib_assets_count {
        if raylib_assets[index].texture.id != 0 {
            HostRaylibUnloadTexture(raylib_assets[index].texture)
        }
        raylib_assets[index] = RaylibAsset.{}
        index += 1
    }
    raylib_assets_count = 0
    raylib_assets_next = 0
    raylib_image_error = false
}

// Call on the rendering thread after its context is current again. A lost
// context's names may already identify unrelated textures in the new context;
// forget them without sending deletion requests there.
#program_export
ResetRaylibGraphics :: (context_lost: bool = false) {
    if !context_lost {
        HostRaylibFlushBatch()
    }
    index: s32 = 0
    while index < raylib_assets_count {
        if !context_lost && raylib_assets[index].texture.id != 0 {
            HostRaylibUnloadTexture(raylib_assets[index].texture)
        }
        raylib_assets[index] = RaylibAsset.{}
        index += 1
    }
    raylib_assets_count = 0
    raylib_assets_next = 0
    index = 0
    while index < 2 {
        if !context_lost && retained_frame_ready[index] {
            HostRaylibUnloadRenderTexture(retained_frame_targets[index])
        }
        retained_frame_targets[index] = HostRaylibRenderTexture.{}
        retained_frame_ready[index] = false
        index += 1
    }
    retained_frame_previous_index = -1
    retained_frame_render_index = 0
    retained_frame_width = 0
    retained_frame_height = 0
    retained_frame_active = false
    raylib_image_error = false
    if context_lost {
        // UnloadFont still releases its CPU glyphs and rectangles with id 0.
        raylib_font.texture.id = 0
        index = 0
        while index < raylib_typeface_count {
            RaylibDiscardTypefaceTextures(*raylib_typefaces[index])
            index += 1
        }
        index = 0
        while index < raylib_fallback_face_count {
            RaylibDiscardTypefaceTextures(*raylib_fallback_faces[index])
            index += 1
        }
    }
    ReleaseTypefaces()
}

RaylibDiscardTypefaceTextures :: (typeface: *RaylibTypeface) {
    typeface.font.texture.id = 0
    index: s32 = 0
    while index < typeface.sized_count {
        typeface.sized_fonts[index].texture.id = 0
        index += 1
    }
}

#program_export
OpenRaylib :: (width: s32 = 960, height: s32 = 600,
    title: string = "Kryon Ziran", flags: u32 = cast(u32)4) -> bool {
    label: [512]u8
    if width <= 0 || height <= 0 || !CopyCString(title, label[:]) { return false }
    raylib_quit = false
    raylib_pointer = PointerFrame.{}
    raylib_secondary = SecondaryPointerFrame.{}
    raylib_middle = SecondaryPointerFrame.{}
    raylib_repeat_next = 0
    HostRaylibSetConfigFlags(flags)
    HostRaylibInitWindow(width, height, *label[0])
    if !HostRaylibIsWindowReady() { return false }
    HostRaylibSetTargetFPS(60)
    name: [32]u8
    if CopyCString("KRYON_FONT_PATH", name[:]) {
        RaylibTryFont(HostRaylibGetEnvironment(*name[0]))
    }
    if !raylib_font_loaded {
        path: [96]u8
        if CopyCString("../kryon/assets/fonts/LiberationSans-Regular.ttf",
            path[:]) { RaylibTryFont(*path[0]) }
    }
    if !raylib_font_loaded {
        path: [96]u8
        if CopyCString("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
            path[:]) { RaylibTryFont(*path[0]) }
    }
    return true
}

#program_export
CloseRaylib :: () {
    index: s32 = 0
    while index < 2 {
        if retained_frame_ready[index] {
            HostRaylibUnloadRenderTexture(retained_frame_targets[index])
            retained_frame_ready[index] = false
        }
        index += 1
    }
    retained_frame_previous_index = -1
    retained_frame_render_index = 0
    index = 0
    while index < raylib_assets_count {
        if raylib_assets[index].texture.id != cast(u32)0 {
            HostRaylibUnloadTexture(raylib_assets[index].texture)
        }
        index += 1
    }
    raylib_assets_count = 0
    ReleaseTypefaces()
    if HostRaylibIsWindowReady() { HostRaylibCloseWindow() }
}

#program_export
PollRaylib :: () -> bool {
    if raylib_quit || HostRaylibWindowShouldClose() { return false }
    // Screen pixels; PollPointer reports them in zoomed space.
    raylib_pointer.x = cast(float32)HostRaylibMouseX()
    raylib_pointer.y = cast(float32)HostRaylibMouseY()
    raylib_pointer.pressed = HostRaylibMousePressed(0)
    // A press and release inside one frame still counts as held for it.
    raylib_pointer.down = HostRaylibMouseDown(0) || raylib_pointer.pressed
    raylib_pointer.released = HostRaylibMouseReleased(0)
    #if #defined(ANDROID_BUILD) {
        // A touch that began and ended within one frame reports nothing.
        AndroidTouch.AndroidTouchInstall()
        touch := AndroidTouch.AndroidTouchSample(TouchSample.{
            .position = Vector2.{raylib_pointer.x, raylib_pointer.y},
            .pressed = raylib_pointer.pressed, .down = raylib_pointer.down,
            .released = raylib_pointer.released})
        raylib_pointer.x = touch.position.x
        raylib_pointer.y = touch.position.y
        raylib_pointer.pressed = touch.pressed
        raylib_pointer.down = touch.down
        raylib_pointer.released = touch.released
    }
    raylib_secondary.down = HostRaylibMouseDown(1)
    raylib_secondary.pressed = HostRaylibMousePressed(1)
    raylib_secondary.released = HostRaylibMouseReleased(1)
    raylib_middle.down = HostRaylibMouseDown(2)
    raylib_middle.pressed = HostRaylibMousePressed(2)
    raylib_middle.released = HostRaylibMouseReleased(2)
    raylib_repeat_next = 0
    raylib_wheel_move = HostRaylibMouseWheelMove()
    return true
}

#program_export
RaylibViewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0,
        cast(float32)HostRaylibGetScreenWidth() / raylib_zoom,
        cast(float32)HostRaylibGetScreenHeight() / raylib_zoom}
}

// Draw the following frames at this zoom factor, 1.0 for 100%.
#program_export
RaylibSetZoom :: (factor: float32) {
    if !(factor > 0.0) || factor == raylib_zoom { return }
    raylib_zoom = factor
    SetPaintPixelScale(factor)
}

#program_export
RaylibZoom :: () -> float32 {
    return raylib_zoom
}

// The starting zoom from KRYON_ZOOM (for example 1.5), or 0 when unset.
#program_export
RaylibEnvironmentZoom :: () -> float32 {
    name: [16]u8
    if !CopyCString("KRYON_ZOOM", name[:]) { return 0.0 }
    value: *u8 = HostRaylibGetEnvironment(*name[0])
    if value == null { return 0.0 }
    return cast(float32)HostRaylibParseFloat(value)
}

#program_export
RaylibPressedKey :: () -> s32 {
    return HostRaylibGetKeyPressed()
}

// OS repeats are separate from fresh presses in raylib. Return each repeated
// key once per poll; a held key without a repeat event produces no input.
#program_export
RaylibRepeatedKey :: () -> s32 {
    while raylib_repeat_next < 512 {
        key := raylib_repeat_next
        raylib_repeat_next += 1
        if HostRaylibIsKeyPressedRepeat(key) { return key }
    }
    return 0
}

#program_export
RaylibKeyDown :: (key: s32) -> bool {
    return key > 0 && key < 512 && HostRaylibIsKeyDown(key)
}

#program_export
RaylibFocused :: () -> bool { return HostRaylibIsWindowFocused() }

#program_export
RaylibExitKey :: (key: s32) { HostRaylibSetExitKey(key) }

#program_export
RaylibFrameRate :: (fps: s32) -> bool {
    if fps < 0 || fps > 1000 { return false }
    HostRaylibSetTargetFPS(fps)
    return true
}

#program_export
RaylibSetTitle :: (title: string) -> bool {
    bytes: [512]u8
    if !CopyCString(title, bytes[:]) { return false }
    HostRaylibSetWindowTitle(*bytes[0])
    return true
}

#program_export
PollMiddlePointer :: () -> SecondaryPointerFrame { return raylib_middle }

// The held modifier keys as KeyModifier bits, from raylib's left and right
// shift (340, 344), control (341, 345), and alt (342, 346) keys.
#program_export
RaylibModifiers :: () -> s32 {
    modifiers: s32 = 0
    if HostRaylibIsKeyDown(340) || HostRaylibIsKeyDown(344) { modifiers |= 1 }
    if HostRaylibIsKeyDown(341) || HostRaylibIsKeyDown(345) { modifiers |= 2 }
    if HostRaylibIsKeyDown(342) || HostRaylibIsKeyDown(346) { modifiers |= 4 }
    return modifiers
}

#program_export
RaylibTypedCodepoint :: () -> s32 {
    return HostRaylibGetCharPressed()
}

#program_export
RaylibWheelMove :: () -> float32 {
    return raylib_wheel_move
}

#program_export
BeginRaylibFrame :: () {
    raylib_image_error = false
    HostRaylibBeginDrawing()
    HostRaylibClearBackground(Color.{248, 250, 252, 255})
    // Scale the modelview matrix itself rather than pushing a transform:
    // the clip code reads the modelview to place scissors, and BeginDrawing
    // resets it for the next frame.
    if raylib_zoom != 1.0 {
        HostRaylibScale(raylib_zoom, raylib_zoom, 1.0)
    }
}

#program_export
EndRaylibFrame :: () -> bool {
    HostRaylibEndDrawing()
    return !raylib_image_error
}

#program_export
CaptureRequested :: () -> bool {
    name: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", name[:]) { return false }
    return HostRaylibGetEnvironment(*name[0]) != null
}

#program_export
CaptureConfigured :: () -> bool {
    name: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", name[:]) { return false }
    path: *u8 = HostRaylibGetEnvironment(*name[0])
    if path == null { return false }
    // The capture reads the framebuffer, so draw what is still batched.
    HostRaylibFlushBatch()
    HostRaylibTakeScreenshot(path)
    return HostRaylibFileExists(path)
}

// The largest stretch of the actual drawing transform determines the atlas
// resolution. Camera, host density, rotation and shear all count; the frame's
// input/layout zoom alone does not describe where glyphs end up.
RaylibTextScale :: (matrix: RaylibMatrix) -> float32 {
    horizontal := matrix.m0 * matrix.m0 + matrix.m1 * matrix.m1
    vertical := matrix.m4 * matrix.m4 + matrix.m5 * matrix.m5
    cross := matrix.m0 * matrix.m4 + matrix.m1 * matrix.m5
    difference := horizontal - vertical
    scale := HostRaylibSqrt((horizontal + vertical +
        HostRaylibSqrt(difference * difference + 4.0 * cross * cross)) * 0.5)
    if !(scale > 0.0) {
        return 1.0
    }
    return scale
}

RaylibTextPosition :: (position: Vector2, matrix: RaylibMatrix) -> Vector2 {
    // Pixel alignment is valid for an upright, uniformly scaled camera.
    // Rotated and skewed text keeps its original geometry.
    if RaylibTextAligned(matrix) {
        screen := ClipPoint(matrix, position.x, position.y)
        return .{(HostRaylibFloor(screen.x + 0.5) - matrix.m12) / matrix.m0,
            (HostRaylibFloor(screen.y + 0.5) - matrix.m13) / matrix.m5}
    }
    return position
}

RaylibTextAligned :: (matrix: RaylibMatrix) -> bool {
    return matrix.m0 > 0.0 && matrix.m0 == matrix.m5 &&
    matrix.m1 == 0.0 && matrix.m4 == 0.0
}

// Layout always uses the base font's advances in logical units. Drawing uses
// those same advances and chooses a separate atlas at the screen pixel size.
// Zoom changes raster resolution, never logical advances or caret measurements.
RaylibTextWithFallback :: (value: string, x: s32, y: s32, size: s32,
    color: Color, draw: bool) -> Vector2 {
    if size <= 0 {
        return .{0.0, 0.0}
    }
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return .{0.0, 0.0} }
    RaylibEnsureGlyphs(value)
    primary := raylib_font
    logical_size := cast(float32)size
    text_size := logical_size
    position := Vector2.{cast(float32)x, cast(float32)y}
    matrix: RaylibMatrix
    pixels: s32
    if draw {
        matrix = HostRaylibModelview()
        scale := RaylibTextScale(matrix)
        pixels = cast(s32)HostRaylibFloor(logical_size * scale + 0.5)
        if pixels < 1 {
            pixels = 1
        }
        text_size = cast(float32)pixels / scale
    }
    newline: [2]u8 = .[10, 0]
    line_step := HostRaylibMeasureFontText(primary, *newline[0],
        logical_size, 0.0).y - logical_size
    result: Vector2 = .{0.0, logical_size}
    dx: float32
    dy: float32
    at: s32 = 0
    while at < cast(s32)value.count {
        length: s32
        codepoint := HostRaylibCodepoint(*bytes[at], *length)
        if codepoint == 10 {
            dx = 0.0
            dy += line_step
        } else {
            typeface: *RaylibTypeface
            if raylib_active_typeface_index >= 0 {
                typeface = *raylib_typefaces[raylib_active_typeface_index]
            }
            if !RaylibFontHasCodepoint(primary, codepoint) {
                registered := RaylibRegisteredFallback(codepoint)
                if registered >= 0 {
                    typeface = *raylib_typefaces[registered]
                } else {
                    face := RaylibFindFallback(codepoint)
                    if face >= 0 {
                        typeface = *raylib_fallback_faces[face]
                    }
                }
            }
            selected := primary
            if typeface != null {
                selected = typeface.font
            }
            glyph: [5]u8
            for index: 0..length - 1 { glyph[index] = bytes[at + index] }
            glyph[length] = 0
            advance := HostRaylibMeasureFontText(selected, *glyph[0],
                logical_size, 0.0).x
            if draw {
                if typeface != null {
                    selected = RaylibTypefaceFontForPixels(typeface, pixels,
                        !RaylibTextAligned(matrix))
                }
                glyph_position := RaylibTextPosition(
                    .{position.x + dx, position.y + dy}, matrix)
                HostRaylibDrawFontText(selected, *glyph[0], glyph_position,
                    text_size, 0.0, color)
            }
            dx += advance
        }
        if dx > result.x { result.x = dx }
        result.y = dy + logical_size
        at += length
    }
    return result
}

RaylibTextExtent :: (value: string, font: s32) -> Vector2 {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return Vector2.{0.0, 0.0} }
    if raylib_font_loaded {
        return RaylibTextWithFallback(value, 0, 0, font, Color.{}, false)
    }
    lines: s32 = 1
    index: s64 = 0
    while index < value.count {
        if value[index] == #char "\n" { lines += 1 }
        index += 1
    }
    return Vector2.{cast(float32)HostRaylibMeasureText(*bytes[0], font),
        cast(float32)(font * lines)}
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return 0 }
    if raylib_font_loaded {
        extent := RaylibTextWithFallback(value, 0, 0, font, Color.{}, false)
        return cast(s32)(extent.x + 0.5)
    }
    return HostRaylibMeasureText(*bytes[0], font)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return font
}

#program_export
PollPointer :: () -> PointerFrame {
    pointer: PointerFrame = raylib_pointer
    pointer.x = pointer.x / raylib_zoom
    pointer.y = pointer.y / raylib_zoom
    return pointer
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    scale := RasterPixelScale()
    if !RaylibSmoothable(bounds, radius, scale) {
        HostRaylibDrawRounded(bounds, RaylibRoundness(bounds, radius),
            RaylibCornerSegments(bounds, radius, segments), color)
        return
    }
    half: float32 = 0.5 / scale
    offsets: [4]float32
    alphas: [4]float32
    offsets[0] = -half
    alphas[0] = 1.0
    offsets[1] = half
    alphas[1] = 0.0
    RaylibSmoothShape(bounds, radius,
        RaylibCornerSegments(bounds, radius, segments), 2, offsets, alphas,
        true, color)
}

// raylib fills shapes without anti-aliasing, so a small rounded control such
// as a 20 pixel dot shows stair-stepped edges. Curved shapes are drawn here
// with a one-pixel edge whose alpha falls from the colour's to zero across
// the true outline, which approximates each edge pixel's coverage. An edge on
// a pixel boundary stays crisp: the pixel inside is solid, the one outside
// empty. Square corners and shapes under two pixels across keep raylib's fill.
RaylibSmoothable :: (bounds: Rectangle, radius: float32,
    scale: float32) -> bool {
    return radius > 0.0 && bounds.width * scale >= 2.0 &&
    bounds.height * scale >= 2.0
}

// rlgl's mode for independent triangles.
RaylibTriangles :: 4
RaylibSmoothSegments :: 32
RaylibSmoothPoints :: 132

// A point on the outline moved `offset` outward. The rectangle grows by the
// offset on every side and the corner radius grows with it, down to a sharp
// corner, so the corner centres stay put while the radius is positive.
RaylibOutlinePoint :: (bounds: Rectangle, radius: float32, offset: float32,
    corner: s32, direction: Vector2) -> Vector2 {
    left: float32 = bounds.x - offset
    top: float32 = bounds.y - offset
    width: float32 = bounds.width + offset * 2.0
    height: float32 = bounds.height + offset * 2.0
    if width < 0.0 {
        left += width * 0.5
        width = 0.0
    }
    if height < 0.0 {
        top += height * 0.5
        height = 0.0
    }
    arc: float32 = radius + offset
    if arc < 0.0 { arc = 0.0 }
    if arc > width * 0.5 { arc = width * 0.5 }
    if arc > height * 0.5 { arc = height * 0.5 }
    x: float32 = left + arc
    if corner == 1 || corner == 2 { x = left + width - arc }
    y: float32 = top + arc
    if corner >= 2 { y = top + height - arc }
    return Vector2.{x + direction.x * arc, y + direction.y * arc}
}

RaylibFaded :: (color: Color, alpha: float32) -> Color {
    value: float32 = cast(float32)color.a * alpha + 0.5
    if value <= 0.0 { value = 0.0 }
    if value >= 255.0 { value = 255.0 }
    return Color.{color.r, color.g, color.b, cast(u8)value}
}

RaylibVertex :: (point: Vector2, color: Color) {
    HostRaylibVertexColor(color.r, color.g, color.b, color.a)
    HostRaylibVertex(point.x, point.y)
}

// raylib culls triangles wound clockwise on screen, so each triangle is sent
// in its front-facing order. Sharp corners repeat points; those triangles
// have no area and are skipped.
RaylibTriangle :: (a: Vector2, a_color: Color, b: Vector2, b_color: Color,
    c: Vector2, c_color: Color) {
    turn: float32 = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
    if turn == 0.0 { return }
    RaylibVertex(a, a_color)
    if turn < 0.0 {
        RaylibVertex(b, b_color)
        RaylibVertex(c, c_color)
    } else {
        RaylibVertex(c, c_color)
        RaylibVertex(b, b_color)
    }
}

// Draws the rounded rectangle as rings of its outline at the given outward
// offsets, each at its own fraction of the colour's alpha, with the colour
// blending between neighbouring rings. A filled shape also covers the inside
// of the first ring.
RaylibSmoothShape :: (bounds: Rectangle, radius: float32, segments: s32,
    rings: s32, offsets: [4]float32, alphas: [4]float32, filled: bool,
    color: Color) {
    if segments > RaylibSmoothSegments { segments = RaylibSmoothSegments }
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if radius > edge * 0.5 { radius = edge * 0.5 }
    per_corner: s32 = segments + 1
    count: s32 = per_corner * 4
    directions: [RaylibSmoothPoints]Vector2
    corner: s32 = 0
    while corner < 4 {
        step: s32 = 0
        while step < per_corner {
            // Corners run clockwise on screen from the top left, whose arc
            // starts pointing left.
            angle: float32 = 3.14159265 * (1.0 + cast(float32)corner * 0.5 +
                cast(float32)step * 0.5 / cast(float32)segments)
            directions[corner * per_corner + step] = Vector2.{
                HostRaylibCos(angle), HostRaylibSin(angle)}
            step += 1
        }
        corner += 1
    }
    inner: [RaylibSmoothPoints]Vector2
    outer: [RaylibSmoothPoints]Vector2
    index: s32 = 0
    while index < count {
        inner[index] = RaylibOutlinePoint(bounds, radius, offsets[0],
            index / per_corner, directions[index])
        index += 1
    }
    inner_color := RaylibFaded(color, alphas[0])
    HostRaylibBegin(RaylibTriangles)
    if filled {
        center := Vector2.{bounds.x + bounds.width * 0.5,
            bounds.y + bounds.height * 0.5}
        index = 0
        while index < count {
            next: s32 = index + 1
            if next == count { next = 0 }
            RaylibTriangle(center, inner_color, inner[index], inner_color,
                inner[next], inner_color)
            index += 1
        }
    }
    ring: s32 = 1
    while ring < rings {
        index = 0
        while index < count {
            outer[index] = RaylibOutlinePoint(bounds, radius, offsets[ring],
                index / per_corner, directions[index])
            index += 1
        }
        outer_color := RaylibFaded(color, alphas[ring])
        index = 0
        while index < count {
            next: s32 = index + 1
            if next == count { next = 0 }
            RaylibTriangle(inner[index], inner_color, inner[next], inner_color,
                outer[next], outer_color)
            RaylibTriangle(inner[index], inner_color, outer[next], outer_color,
                outer[index], outer_color)
            index += 1
        }
        index = 0
        while index < count {
            inner[index] = outer[index]
            index += 1
        }
        inner_color = outer_color
        ring += 1
    }
    HostRaylibEnd()
}

// Segments per corner for a curve within half a pixel of the true arc at
// its on-screen radius, at most the caller's count. A quarter arc of radius r
// in n chords errs by r(1 - cos(pi/4n)), under half a pixel once n reaches
// about 0.79 sqrt(r). Small controls take a few segments, not a fixed dozen;
// every vertex is built on the CPU and fills the draw batch.
RaylibCornerSegments :: (bounds: Rectangle, radius: float32,
    limit: s32) -> s32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if radius > edge * 0.5 { radius = edge * 0.5 }
    pixels: float32 = radius * raylib_zoom
    segments: s32 = 4
    if pixels > 0.0 {
        segments = cast(s32)(0.79 * HostRaylibSqrt(pixels)) + 1
    }
    if segments > limit { segments = limit }
    // raylib picks its own count below four.
    if segments < 4 { segments = 4 }
    return segments
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 || width <= 0.0 { return }
    segments = RaylibCornerSegments(bounds, radius, segments)
    scale := RasterPixelScale()
    if !RaylibSmoothable(bounds, radius, scale) {
        HostRaylibDrawRoundedOutline(bounds, RaylibRoundness(bounds, radius),
            segments, width, color)
        return
    }
    // Like raylib's, the outline lies inside the bounds.
    half: float32 = 0.5 / scale
    pixels: float32 = width * scale
    offsets: [4]float32
    alphas: [4]float32
    if pixels >= 1.0 {
        offsets[0] = -width - half
        alphas[0] = 0.0
        offsets[1] = -width + half
        alphas[1] = 1.0
        offsets[2] = -half
        alphas[2] = 1.0
        offsets[3] = half
        alphas[3] = 0.0
        RaylibSmoothShape(bounds, radius, segments, 4, offsets, alphas,
            false, color)
        return
    }
    // A hairline spreads over one more pixel at the alpha that keeps its
    // weight, meeting the wide profile at one pixel.
    offsets[0] = -width - half
    alphas[0] = 0.0
    offsets[1] = -width * 0.5
    alphas[1] = pixels * 2.0 / (pixels + 1.0)
    offsets[2] = half
    alphas[2] = 0.0
    RaylibSmoothShape(bounds, radius, segments, 3, offsets, alphas, false,
        color)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    HostRaylibDrawLine(Vector2.{line.x, line.y},
        Vector2.{line.x + line.width, line.y + line.height}, 1.0, color)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return }
    if raylib_font_loaded {
        unused RaylibTextWithFallback(value, x, y, font, color, true)
    } else {
        HostRaylibDrawText(*bytes[0], x, y, font, color)
    }
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    // Most labels fit their clip. A scissor change flushes the draw batch and
    // reads GL state, which costs a frame dozens of GPU round trips on phones,
    // so text wholly inside the clip is drawn without one.
    if cast(float32)x >= clip.x && cast(float32)y >= clip.y {
        extent := RaylibTextExtent(value, font)
        if cast(float32)x + extent.x <= clip.x + clip.width &&
        cast(float32)y + extent.y <= clip.y + clip.height {
            RasterText(value, x, y, font, color)
            return
        }
    }
    saved := BeginRasterClip(clip)
    RasterText(value, x, y, font, color)
    EndRasterClip(saved)
}

// Renders into one of two retained targets. The previous target stays
// sampleable through RetainedPreviousFrameTexture while the next frame renders.
#program_export
BeginRetainedFrame :: (width: s32, height: s32) -> bool {
    if retained_frame_active || width <= 0 || height <= 0 { return false }
    if retained_frame_width != width || retained_frame_height != height {
        index: s32 = 0
        while index < 2 {
            if retained_frame_ready[index] {
                HostRaylibUnloadRenderTexture(retained_frame_targets[index])
                retained_frame_ready[index] = false
            }
            index += 1
        }
        retained_frame_previous_index = -1
        retained_frame_render_index = 0
        retained_frame_width = width
        retained_frame_height = height
    }
    if !retained_frame_ready[retained_frame_render_index] {
        target := HostRaylibLoadRenderTexture(width, height)
        // A framebuffer ID can survive a failed attachment allocation.
        // Release partial targets and let the caller draw directly instead.
        if !HostRaylibRenderTextureValid(target) ||
        target.texture.width != width || target.texture.height != height ||
        !HostRaylibFramebufferComplete(target.id) {
            if target.id != cast(u32)0 { HostRaylibUnloadRenderTexture(target) }
            return false
        }
        retained_frame_targets[retained_frame_render_index] = target
        retained_frame_ready[retained_frame_render_index] = true
    }
    if !retained_frame_ready[retained_frame_render_index] { return false }
    HostRaylibBeginDrawing()
    HostRaylibBeginTextureMode(retained_frame_targets[retained_frame_render_index])
    retained_frame_active = true
    return true
}

RaylibPresentTexture :: (texture: Texture2D) {
    source := Rectangle.{0.0, 0.0, cast(float32)texture.width,
        -cast(float32)texture.height}
    destination := Rectangle.{0.0, 0.0,
        cast(float32)texture.width, cast(float32)texture.height}
    HostRaylibDrawTexture(texture, source, destination,
        Vector2.{}, 0.0, Color.{255, 255, 255, 255})
}

#program_export
EndRetainedFrame :: () -> bool {
    if !retained_frame_active { return false }
    target := retained_frame_targets[retained_frame_render_index]
    HostRaylibEndTextureMode()
    RaylibPresentTexture(target.texture)
    HostRaylibEndDrawing()
    retained_frame_active = false
    rendered := retained_frame_render_index
    retained_frame_previous_index = rendered
    retained_frame_render_index = (rendered + 1) % 2
    return true
}

// An unchanged frame keeps the previous complete target as the presenter and
// as the source for the next transition. The freshly rendered target may be
// missing queued widget paint because the paint stream was unchanged.
#program_export
EndRetainedFrameReusePrevious :: () -> bool {
    if !retained_frame_active { return false }
    if retained_frame_previous_index < 0 { return EndRetainedFrame() }
    previous := retained_frame_targets[retained_frame_previous_index]
    HostRaylibEndTextureMode()
    RaylibPresentTexture(previous.texture)
    HostRaylibEndDrawing()
    retained_frame_active = false
    return true
}

#program_export
RetainedPreviousFrameTexture :: () -> Texture2D {
    if retained_frame_previous_index < 0 { return Texture2D.{} }
    return retained_frame_targets[retained_frame_previous_index].texture
}

#program_export
DisposeFrameTexture :: (texture: Texture2D) {
    if texture.id != cast(u32)0 { HostRaylibUnloadTexture(texture) }
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    index: s32 = RaylibAssetIndex(asset_path)
    if index < 0 { return 0 }
    return raylib_assets[index].texture.width
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    index: s32 = RaylibAssetIndex(asset_path)
    if index < 0 { return 0 }
    return raylib_assets[index].texture.height
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    // Negative source dimensions mirror images and orient render targets.
    if source.width == 0.0 || source.height == 0.0 ||
    destination.width <= 0.0 || destination.height <= 0.0 ||
    clip.width <= 0.0 || clip.height <= 0.0 {
        return
    }
    texture: Texture2D
    if texture_id != cast(u32)0 {
        texture = CurrentPaintTexture()
        if texture.id != texture_id {
            // Keep direct calls to the low-level raster effect usable.
            texture.id = texture_id
            texture.width = cast(s32)(source.x + source.width)
            texture.height = cast(s32)(source.y + source.height)
        }
    } else if asset_path.count > 0 {
        index: s32 = RaylibAssetIndex(asset_path)
        if index < 0 {
            raylib_image_error = true
            return
        }
        texture = raylib_assets[index].texture
    } else {
        raylib_image_error = true
        return
    }
    RaylibDrawImageClipped(texture, source, destination, clip, origin,
        rotation, radius, tint)
}

retained_frame_targets: [2]HostRaylibRenderTexture;
retained_frame_ready: [2]bool;
retained_frame_render_index: s32;
retained_frame_previous_index: s32 = -1;
retained_frame_width: s32;
retained_frame_height: s32;
retained_frame_active: bool;

raylib_quit: bool;

// FLAG_WINDOW_HIDDEN
#program_export
WindowVisibleHost :: () -> bool {
    return !HostRaylibIsWindowHidden()
}

#program_export
WindowFocusedHost :: () -> bool { return !HostRaylibIsWindowHidden() && HostRaylibIsWindowFocused() }

#program_export
WindowSetVisibleHost :: (visible: bool) {
    if visible {
        HostRaylibClearWindowState(cast(u32)128)
    } else {
        HostRaylibSetWindowState(cast(u32)128)
    }
}

// raylib cannot cancel a close once requested, so closing always quits.
#program_export
WindowInterceptCloseHost :: (enabled: bool) -> bool {
    return false
}

#program_export
WindowTakeCloseRequestHost :: () -> bool {
    return false
}

#program_export
WindowQuitHost :: () {
    raylib_quit = true
}

// The clipboard snapshot SystemClipboardOpenHost takes, and the text a write
// hands to the host, which needs it NUL-terminated.
raylib_clipboard: [65536]u8;
raylib_clipboard_length: s32;

// Snapshots the text, cut on a whole character to fit.
#program_export
SystemClipboardOpenHost :: () -> s32 {
    raylib_clipboard_length = 0
    text: *u8 = HostRaylibGetClipboardText()
    if text == null { return -1 }
    length: s32 = 0
    while text[length] != cast(u8)0 && length < 65535 {
        raylib_clipboard[length] = text[length]
        length += 1
    }
    if text[length] != cast(u8)0 {
        while length > 0 && (cast(s32)raylib_clipboard[length - 1] & 192) == 128 { length -= 1 }
        if length > 0 && (cast(s32)raylib_clipboard[length - 1] & 192) == 192 { length -= 1 }
    }
    raylib_clipboard_length = length
    return length
}

#program_export
SystemClipboardByteHost :: (index: s32) -> s32 {
    if index < 0 || index >= raylib_clipboard_length { return -1 }
    return raylib_clipboard[index]
}

#program_export
SystemClipboardWriteHost :: (text: string) -> bool {
    length: s32 = cast(s32)text.count
    if length > 65535 { length = 65535 }
    index: s32 = 0
    while index < length {
        raylib_clipboard[index] = text[index]
        index += 1
    }
    raylib_clipboard[length] = cast(u8)0
    HostRaylibSetClipboardText(*raylib_clipboard[0])
    return true
}

#program_export
PollSecondaryPointer :: () -> SecondaryPointerFrame { return raylib_secondary }
