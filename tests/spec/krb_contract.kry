#import "kryon.h"

ANSWER :: #run 6 * 7
#assert ANSWER == 42, "KRB spec #run assertion failed"

state {
    count: int = 0
}

app "KRB Spec Contract" {
    size 320 240
    fps 60
}

KrbSpec :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeSurface())
        Text("KRB Spec Contract", ScaleUIPx(8), ScaleUIPx(8), Text16, GetThemeText())
        count = count + 1
    }
}
