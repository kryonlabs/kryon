// Dashboard starter entry point.
App :: #import "kryon/app";
#import "kryon/geometry"
#import "kryon/session"
#import "dashboard"

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    DashboardFrame(session, frame.viewport)
}

main :: () -> s32 { return App.Run(App.Window.{.title = "Dashboard"}, Frame) }
