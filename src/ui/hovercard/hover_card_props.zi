#import "control_props"
#import "geometry"
#import "style"
#import "style_sheet"
#import "theme"
#import "tooltip_common"

using ButtonState;
using StyleField;

HoverCardProps :: struct {
    key: u64
    id: s32
    class_name: s32
    anchor: Rectangle
    viewport: Rectangle
    title: string
    body: string
    action_label: string
    action: u64
    placement: OverlayPlacement
    width: float32
    delay_ms: float32
    grace_ms: float32
    movement_tolerance: float32
    gap: float32
    now_ms: s64
    pointer: OverlayPointer
    focus: OverlayFocus
    activate_action: bool
    disabled: bool
    style: StyleData
    action_style: StyleData
    states: StyleStates
}

HoverCardState :: struct {
    open: bool
    enter_ms: s64
    leave_ms: s64
    progress: float32
    transition_start_ms: s64
    previous_open: bool
    last_pointer_x: float32
    last_pointer_y: float32
}

HoverCardResult :: struct {
    node: s32
    title_node: s32
    action_node: s32
    bounds: Rectangle
    fit: OverlayFit
    open: bool
    visible: bool
    changed: bool
    remaining_delay_ms: float32
    remaining_grace_ms: float32
    action: u64
    action_selected: bool
    closed: bool
}

#program_export
HoverCardStateFor :: () -> HoverCardState {
    return HoverCardState.{.enter_ms = -1, .leave_ms = -1,
        .transition_start_ms = -1}
}

#program_export
HoverCardDefaultStyle :: () -> StyleData {
    style: StyleData
    theme := CurrentTheme()
    style.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleRadius | cast(u32)StyleBorderWidth |
        cast(u32)StyleOpacity | cast(u32)StylePaddingX | cast(u32)StylePaddingY |
        cast(u32)StyleGap | cast(u32)StyleFontSize | cast(u32)StyleFontRole |
        cast(u32)StyleTypeface | cast(u32)StyleLineHeight |
        cast(u32)StyleMotionDuration | cast(u32)StyleMotionMultiplier |
        cast(u32)StyleMotionReduced
    style.background = theme.colors.surface_raised
    style.foreground = theme.colors.foreground
    style.border = theme.colors.border
    style.radius = theme.metrics.radius_large
    style.border_width = theme.metrics.border_width
    style.opacity = 1.0
    style.padding_x = 16.0
    style.padding_y = 16.0
    style.gap = 8.0
    style.font_size = theme.metrics.text_lg
    style.font_role = .FontRoleHeading
    style.typeface = theme.fonts.heading
    style.line_height = 1.35
    style.motion_duration = 280.0
    style.motion_multiplier = 1.0
    style.motion_reduced = theme.motion.reduced_motion
    return style
}

#program_export
HoverCardActionDefaultStyle :: () -> StyleData {
    style := HoverCardDefaultStyle()
    theme := CurrentTheme()
    style.background = theme.colors.accent
    style.foreground = theme.colors.on_accent
    style.radius = theme.metrics.radius_medium
    style.padding_x = 12.0
    style.padding_y = 6.0
    style.font_size = theme.metrics.text_sm
    style.font_role = .FontRoleControl
    style.typeface = theme.fonts.control
    return style
}

