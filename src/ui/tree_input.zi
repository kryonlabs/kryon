#module "tree_input"
#import "geometry"
#import "tree"
#import "widget_kind"

# Raw device observations are supplied by the platform. Kryon owns hit order,
# capture, eligibility, and activation across retained frames.
PointerFrame :: struct {
    x: float
    y: float
    down: bool
    pressed: bool
    released: bool
}

PointerState :: struct {
    hovered_generation: i32
    held_generation: i32
    activation_generation: i32
    pressed_generation: i32
    released_generation: i32
    held_x: float
    held_y: float
    released_x: float
    released_y: float
}

PointerDrag :: struct {
    active: bool
    started: bool
    ended: bool
    x: float
    y: float
}

active_pointer :: PointerState #global

PointInBounds :: (x: float, y: float, bounds: Rectangle) -> bool #export {
    return bounds.width > 0.0 && bounds.height > 0.0 &&
        x >= bounds.x && y >= bounds.y &&
        x < bounds.x + bounds.width && y < bounds.y + bounds.height
}

TreeHitAt :: (x: float, y: float) -> i32 #export {
    if TreeCount() == 0 ||
        !PointInBounds(x, y, TreeNodeAt(0).bounds) { return -1 }
    index: i32 = TreeCount() - 1
    while index > 0 {
        entry: TreeEntry = TreeNodeAt(index)
        if entry.interactive &&
            (TreeButtonLike(entry.kind) ||
                entry.kind == WidgetKindCheckbox ||
                entry.kind == WidgetKindToggle ||
                entry.kind == WidgetKindRadio ||
                entry.kind == WidgetKindSlider ||
                entry.kind == WidgetKindSelectable) &&
            PointInBounds(x, y, entry.bounds) {
            if TreePointerActivatable(entry.kind, entry.focus_id,
                entry.disabled, entry.loading) { return index }
            return -1
        }
        index -= 1
    }
    return -1
}

TreePointerUpdate :: (frame: PointerFrame) -> i32 #export {
    if TreeIsBuilding() { return -1 }
    hit: i32 = TreeHitAt(frame.x, frame.y)
    active_pointer.hovered_generation = 0
    if hit >= 0 {
        active_pointer.hovered_generation =
            TreeNodeAt(hit).identity_generation
    }
    if frame.pressed {
        active_pointer.held_generation = 0
        active_pointer.pressed_generation = 0
        active_pointer.released_generation = 0
        if frame.down && hit >= 0 {
            active_pointer.held_generation =
                TreeNodeAt(hit).identity_generation
            active_pointer.pressed_generation =
                active_pointer.held_generation
        }
    }
    if frame.down && active_pointer.held_generation != 0 {
        active_pointer.held_x = frame.x
        active_pointer.held_y = frame.y
    }
    if frame.released {
        if active_pointer.held_generation != 0 {
            active_pointer.released_generation =
                active_pointer.held_generation
            active_pointer.released_x = frame.x
            active_pointer.released_y = frame.y
            if hit >= 0 && active_pointer.held_generation ==
                TreeNodeAt(hit).identity_generation {
                active_pointer.activation_generation =
                    active_pointer.held_generation
            }
        }
        active_pointer.held_generation = 0
    } else if !frame.down {
        active_pointer.held_generation = 0
        active_pointer.pressed_generation = 0
    }
    return hit
}

# A drag keeps its original node identity while held, including when the
# pointer leaves that node or the root. The release sample is consumed once.
TreeTakeDragAt :: (index: i32) -> PointerDrag #export {
    drag: PointerDrag
    if index < 0 || index >= TreeCount() { return drag }
    entry: TreeEntry = TreeNodeAt(index)
    generation: i32 = entry.identity_generation
    if !entry.interactive ||
        !TreePointerActivatable(entry.kind, entry.focus_id,
            entry.disabled, entry.loading) {
        if active_pointer.held_generation == generation {
            active_pointer.held_generation = 0
        }
        if active_pointer.pressed_generation == generation {
            active_pointer.pressed_generation = 0
        }
        if active_pointer.released_generation == generation {
            active_pointer.released_generation = 0
        }
        if active_pointer.activation_generation == generation {
            active_pointer.activation_generation = 0
        }
        return drag
    }
    drag.active = generation != 0 &&
        active_pointer.held_generation == generation
    drag.started = generation != 0 &&
        active_pointer.pressed_generation == generation
    drag.ended = generation != 0 &&
        active_pointer.released_generation == generation
    if drag.active {
        drag.x = active_pointer.held_x
        drag.y = active_pointer.held_y
    }
    if drag.ended {
        drag.x = active_pointer.released_x
        drag.y = active_pointer.released_y
        active_pointer.released_generation = 0
        if active_pointer.activation_generation == generation {
            active_pointer.activation_generation = 0
        }
    }
    if drag.started { active_pointer.pressed_generation = 0 }
    return drag
}

TreeHoveredAt :: (index: i32) -> bool #export {
    if index < 0 || index >= TreeCount() { return false }
    return active_pointer.hovered_generation != 0 &&
        TreeNodeAt(index).identity_generation ==
            active_pointer.hovered_generation
}

TreePressedAt :: (index: i32) -> bool #export {
    if !TreeHoveredAt(index) { return false }
    return active_pointer.held_generation ==
        TreeNodeAt(index).identity_generation
}

TreeTakeActivationAt :: (index: i32) -> bool #export {
    if index < 0 || index >= TreeCount() { return false }
    entry: TreeEntry = TreeNodeAt(index)
    if !entry.interactive ||
        !TreePointerActivatable(entry.kind, entry.focus_id,
        entry.disabled, entry.loading) ||
        active_pointer.activation_generation == 0 ||
        active_pointer.activation_generation != entry.identity_generation {
        return false
    }
    active_pointer.activation_generation = 0
    return true
}
