#import "drawing_props"
#import "geometry"

fills: s32;
failed: bool;

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.x < 10.0 || bounds.y < 20.0 ||
        bounds.x + bounds.width > 130.0 ||
        bounds.y + bounds.height > 100.0 { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) { failed = true }

#program_export
RasterLine :: (bounds: Rectangle, color: Color) { failed = true }

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) { failed = true }

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) { failed = true }

#program_export
RasterImage :: (path: string, texture_id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) { failed = true }

#program_export
RasterImageMesh :: (path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle,
    tint: Color) { failed = true }

#program_export
HostValid :: () -> bool { return !failed && fills == 7 }

#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32, color: Color,
    clip: Rectangle, origin: Vector2, rotation: float32, outer_clip: Rectangle,
    outer_clipped: bool, emphasis: bool, italic: bool) {
    unused value; unused x; unused y; unused font; unused color; unused clip; unused origin
    unused rotation; unused outer_clip; unused outer_clipped; unused emphasis; unused italic
}

#program_export
RasterTriangles :: (points: []Vector2, color: Color) { unused points; unused color }
