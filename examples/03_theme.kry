#import "kryon.h"

app "Kryon Theme Example" {
    size 900 680
    fps 60
    font examples
}

state {
    theme_source: int = THEME_SOURCE_SYSTEM
    theme_mode: int = THEME_MODE_SYSTEM
    theme_id: int = THEME_SKY
    theme_style: int = THEME_STYLE_SYSTEM
    menu_state: ThemeSettingsState = {0}
    slider_value: int = 64
    toggle_value: int = 1
    check_value: int = 1
    text_value: [128] char = "Live Kryon text field"
    text_cursor: int = 21
    text_focused: int = 0
    combo_index: int = 1
}

ClampInt :: (value: int, min_value: int, max_value: int) -> int {
    if value < min_value {
        return min_value
    }
    if value > max_value {
        return max_value
    }
    return value
}

ThemeDarkMode :: () -> int {
    if theme_mode == THEME_MODE_DARK {
        return 1
    }
    if theme_mode == THEME_MODE_LIGHT {
        return 0
    }
    return SystemThemePrefersDark() ? 1 : 0
}

ApplyThemeState :: () {
    theme_source = ClampInt(theme_source, THEME_SOURCE_APP, THEME_SOURCE_SYSTEM)
    theme_mode = ClampInt(theme_mode, THEME_MODE_SYSTEM, THEME_MODE_DARK)
    theme_style = ClampInt(theme_style, THEME_STYLE_SYSTEM, THEME_STYLE_DEFAULT)
    theme_id = ClampInt(theme_id, 0, THEME_COUNT - 1)
    SetThemeSource((ThemeSource)theme_source)
    SetThemeMode((ThemeMode)theme_mode)
    SetThemeStyle((ThemeStyle)theme_style)
    SetCurrentTheme(theme_id, ThemeDarkMode())
}

TokenValue :: (label: const char *, value: int, x: int, y: int) {
    Text((TextProps){.bounds={x, y, 0, 0}, .text=TextFormat("%s %d", label, value), .font=Text12, .color=GetThemeIcon(), .wrap=TextWrapNone})
}

ControlDemo :: (x: int, y: int, w: int) {
    options: [3] const char * = {"One", "Two", "Three"}
    field_style := (TextInputStyle){
        DarkenUIColor(GetThemeBackground(), 6),
        DarkenUIColor(GetThemeBackground(), 38),
        GetThemeButtonHover(),
        GetThemeText(),
        GetThemeText(),
        0.08f,
        Scale(12),
        Scale(8)
    }

    Text((TextProps){.bounds={x, y, 0, 0}, .text="Live controls", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
    y += Scale(46)
    Button((ButtonProps){
        .bounds = {x, y, Scale(190), Scale(44)},
        .label = "Primary",
        .id = 301,
    })
    Button((ButtonProps){
        .bounds = {x + Scale(210), y, Scale(190), Scale(44)},
        .label = "Secondary",
        .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft,
        .id = 302,
    })
    y += Scale(70)

    TextField((TextFieldProps){{x, y, w, Scale(44)}, text_value, sizeof(text_value),
                                  &text_cursor, &text_focused, 80, Text16, 303,
                                  field_style, NULL, NULL, NULL})
    y += Scale(70)
    Dropdown(304, x, y, w, Scale(44), options, 3, &combo_index)
    y += Scale(72)
    Slider(305, x, y, w, "Slider", 0, 100, &slider_value, "", nil)
    y += Scale(72)
    Toggle(306, x, y, Scale(180), Scale(48), &toggle_value, "Off", "On")
    Checkbox(307, x + Scale(230), y + Scale(12), "Checkbox", &check_value)
}

ThemeExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        ApplyThemeState()
        Background(GetThemeBackground())
    
        margin: int = Scale(26)
        panel_w: int = Scale(310)
        right_x: int = margin + panel_w + Scale(42)
        settings := (ThemeSettingsProps){
            .id_base = 101,
            .x = margin,
            .y = Scale(64),
            .w = panel_w,
            .theme_source = &theme_source,
            .theme_mode = &theme_mode,
            .theme_id = &theme_id,
            .theme_style = &theme_style,
            .allow_system_source = 1,
            .allow_system_mode = 1,
            .palette_label = "Color palette",
            .source_system_label = "System colors",
            .style_label = "Widget style",
            .style_system_label = "System style"
        }
    
        Text((TextProps){.bounds={margin, Scale(24), 0, 0}, .text="Kryon Native Theme State", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={right_x, Scale(30), 0, 0}, .text="Switch style and palette here; every control on the right uses Kryon live.", .font=Text16, .color=GetThemeIcon(), .wrap=TextWrapNone})
        result: ThemeSettingsResult = {0}
        ThemeSettings(settings, &menu_state, &result)
    
        ControlDemo(right_x, Scale(88), Scale(420))
    
        tokens := GetThemeMetrics()
        token_y: int = Scale(520)
        Text((TextProps){.bounds={right_x, token_y, 0, 0}, .text="Active style tokens", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        token_y += Scale(30)
        TokenValue("control alpha", tokens.control_alpha, right_x, token_y)
        TokenValue("panel alpha", tokens.panel_alpha, right_x + Scale(150), token_y)
        token_y += Scale(28)
        TokenValue("title bar alpha", tokens.title_bar_alpha,
                   right_x + Scale(150), token_y)
        token_y += Scale(24)
        TokenValue("border alpha", tokens.border_alpha, right_x, token_y)
        TokenValue("shadow alpha", tokens.shadow_alpha, right_x + Scale(150), token_y)
        token_y += Scale(24)
        TokenValue("touch target", tokens.touch_target_min, right_x, token_y)
        TokenValue("shadow y", tokens.shadow_offset_y, right_x + Scale(150), token_y)
    
        if result.changed {
            ApplyThemeState()
        }
    }
}
