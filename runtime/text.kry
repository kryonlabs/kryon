#module "text"
#import "style"

# Typeface lookup, shaping and glyph measurement remain host services.
# Inheritance and layout policy must not differ between renderers.
TextAppearance :: struct {
    font: i32
    color: u32
    letter_spacing: i32
}

ResolveTextStyle :: (font: i32, inherited_font: i32, default_font: i32,
    color: u32, inherited_color: u32, fallback_color: u32, inherited_color_set: bool,
    color_set: bool,
    disabled: bool, inherited_disabled: bool, letter_spacing: i32) -> TextAppearance #export {
    style: TextAppearance
    style.font = ResolveFont(font, inherited_font, default_font)
    style.color = color
    # Both explicit and inherited foregrounds may intentionally be transparent.
    # Presence is independent of alpha; only absent colors use the minimal
    # fallback supplied by the host.
    if !color_set {
        style.color = fallback_color
        if inherited_color_set {
            style.color = inherited_color
        }
    }
    # A parent's resolved foreground already includes its disabled style.
    # An explicit child color still needs disabled presentation of its own.
    if (disabled || inherited_disabled) &&
       (color_set || !inherited_color_set || !inherited_disabled) {
        alpha: u32 = (u32)((float)(style.color & (u32)255) * 0.45)
        style.color = ((style.color >> (u32)8) << (u32)8) | alpha
    }
    style.letter_spacing = letter_spacing
    if style.letter_spacing < 0 {
        style.letter_spacing = 0
    }
    return style
}

TextExtent :: (requested: float, measured: float) -> float #export {
    if requested > 0.0 {
        return requested
    }
    return measured
}

TextWrapPolicy :: (width: float, requested: i32) -> i32 #export {
    if width <= 0.0 {
        return 1
    }
    return requested
}

TextDoubleClickSlopFor :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(6.0 * scale)
}

TextDoubleClickShouldSelectLine :: (same_target: bool, same_line: bool,
    last_time: float, now: float, dx: float, dy: float,
    scale: float) -> bool #export {
    slop: i32 = TextDoubleClickSlopFor(scale)
    if !same_target || !same_line || last_time < 0.0 {
        return false
    }
    if now - last_time > 0.40 {
        return false
    }
    if dx < (float)-slop || dx > (float)slop {
        return false
    }
    if dy < (float)-slop || dy > (float)slop {
        return false
    }
    return true
}

TextControlBaselineSample :: () -> const char* #export {
    return "Hg"
}

TextControlClipGuardFor :: (scale: float) -> i32 #export {
    pad: i32 = 1
    if scale <= 0.0 { scale = 1.0 }
    pad = (i32)(1.0 * scale)
    if pad < 1 { pad = 1 }
    return pad
}

TextControlClipBounds :: (bounds: Rectangle, scale: float) -> Rectangle #export {
    pad: i32 = TextControlClipGuardFor(scale)
    clip: Rectangle = bounds
    clip.y -= (float)pad
    clip.height += (float)(pad * 2)
    return clip
}

TextCenteredY :: (bounds: Rectangle, line_height: i32) -> i32 #export {
    return (i32)bounds.y + ((i32)bounds.height - line_height) / 2
}

TextCenteredX :: (bounds: Rectangle, text_width: i32) -> i32 #export {
    return (i32)(bounds.x + (bounds.width - (float)text_width) * 0.5)
}

TextBaselineYFor :: (box_y: i32, box_h: i32, fallback_height: i32,
    has_glyphs: bool, min_top: float, max_bottom: float) -> i32 #export {
    if !has_glyphs {
        return box_y + (i32)(((float)box_h - (float)fallback_height) * 0.5 + 0.5)
    }
    glyph_height: float = max_bottom - min_top
    return box_y + (i32)(((float)box_h - glyph_height) * 0.5 - min_top + 0.5)
}

TextHeightFor :: (fallback_height: i32, has_glyphs: bool,
    min_top: float, max_bottom: float) -> i32 #export {
    if !has_glyphs {
        return fallback_height
    }
    return (i32)(max_bottom - min_top + 0.5)
}

TextLineHeightFor :: (font_base_size: i32, fallback_base_size: i32,
    scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    base: i32 = font_base_size
    if base <= 0 {
        base = fallback_base_size
    }
    return (i32)((float)base * scale + 0.5)
}

TextSelectionLineEndPaddingFor :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(6.0 * scale)
}

TextSelectionMinWidthFor :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(4.0 * scale)
}

TextSelectionHighlightEndX :: (start_x: i32, end_x: i32,
    continues_past_line: bool, scale: float) -> i32 #export {
    if continues_past_line {
        end_x += TextSelectionLineEndPaddingFor(scale)
    }
    if end_x <= start_x {
        return start_x + TextSelectionMinWidthFor(scale)
    }
    return end_x
}

TextAlignmentOffset :: (available: float, measured: float, alignment: i32) -> float #export {
    if alignment == 1 {
        return (available - measured) * 0.5
    }
    if alignment == 2 {
        return available - measured
    }
    return 0.0
}
