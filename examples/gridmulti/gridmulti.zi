GridMulti :: #import "kryon/grid_multi";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"

selected: [6]bool;
cursor: s32;
anchor: s32;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Grid multi", .size = 28})
    items := GridMulti.GridMultiItem.[.{.label = "Documents"}, .{.label = "Pictures"}, .{.label = "Music"}, .{.label = "Videos"}, .{.label = "Projects"}, .{.label = "Downloads"}]
    result := GridMulti.Draw(session, GridMulti.Props.{.disabled = example_disabled, .bounds = .{height = 224}, .cell_width = 110, .cell_height = 64, .gap = 12, .cursor = cursor, .anchor = anchor}, items[:], selected[:])
    cursor = result.cursor
    anchor = result.anchor
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
