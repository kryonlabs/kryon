#import "session"
#import "checkbox"
#import "checkbox_props"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

#program_export
CheckboxDefaultFace :: (role: s32, disabled: bool) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleFocus |
        cast(u32)StyleBorderWidth | cast(u32)StyleOpacity |
        cast(u32)StyleFontSize
    face.background = cast(u32)0x00000000
    face.foreground = cast(u32)0x171717ff
    face.border = cast(u32)0x737373ff
    face.focus = cast(u32)0x2563ebff
    face.border_width = 1.0
    face.opacity = 1.0
    face.font_size = 14.0
    if role == CheckboxBoxRoleForTone(cast(ButtonTone)ButtonToneAccent) {
        face.background = cast(u32)0x2563ebff
        face.foreground = cast(u32)0xffffffff
        face.border = cast(u32)0x2563ebff
    }
    if disabled {
        face.background = Opacity(face.background, 0.45)
        face.foreground = Opacity(face.foreground, 0.45)
        face.border = Opacity(face.border, 0.45)
    }
    return face
}

#program_export
CheckboxFaceFor :: (rules: StyleRules, props: CheckboxProps,
    role: s32, tone: ButtonTone, state: s32) -> StyleFrame {
    facts: StyleFacts = StyleControlRoleFacts(StyleKindCheckbox(),
        props.id, props.class_name, role, cast(s32)tone,
        cast(s32)ButtonEmphasisFilled, cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(rules,
        CheckboxDefaultFace(role, props.disabled), facts, state)
    return frame
}

#program_export
PaintCheckboxSegment :: (session: Session, node: s32, start: Vector2, end: Vector2,
    width: float32, color: Color) {
    strokes: s32 = cast(s32)(width + 0.5)
    if strokes < 1 { strokes = 1 }
    if strokes > 8 { strokes = 8 }
    index: s32 = 0
    while index < strokes {
        offset: float32 = cast(float32)index - cast(float32)(strokes - 1) * 0.5
        PaintLine(session, node, Rectangle.{start.x, start.y + offset,
            end.x - start.x, end.y - start.y}, color)
        index += 1
    }
}

#program_export
PaintCheckboxForNode :: (session: Session, node: s32, props: CheckboxProps,
    paint: CheckboxPaint, label: StyleFrame, font: s32,
    label_height: s32) {
    box_opacity: float32 = StyleOpacityValue(paint.box.value.fields,
        paint.box.value.opacity)
    active_opacity: float32 = StyleOpacityValue(paint.active.value.fields,
        paint.active.value.opacity)
    if paint.show_state {
        PaintRoundedFill(session, node, paint.state_bounds,
            paint.state_radius, 8,
            ColorFromPacked(Opacity(paint.state_color, box_opacity)))
    }
    if paint.show_focus {
        PaintRoundedOutline(session, node, paint.focus_bounds,
            paint.focus_radius, 8, paint.border_width,
            ColorFromPacked(Opacity(paint.focus_color, box_opacity)))
    }
    if paint.show_fill {
        PaintRoundedFill(session, node, paint.box_bounds, paint.radius, 8,
            ColorFromPacked(Opacity(paint.fill_color, active_opacity)))
    }
    if paint.border_width > 0.0 {
        opacity: float32 = box_opacity
        if paint.show_fill { opacity = active_opacity }
        PaintRoundedOutline(session, node, paint.box_bounds, paint.radius, 8,
            paint.border_width,
            ColorFromPacked(Opacity(paint.border_color, opacity)))
    }
    if paint.show_mark {
        mark: Color = ColorFromPacked(Opacity(paint.mark_color,
            active_opacity))
        PaintCheckboxSegment(session, node, paint.check_start, paint.check_middle,
            paint.mark_width, mark)
        PaintCheckboxSegment(session, node, paint.check_middle, paint.check_end,
            paint.mark_width, mark)
    }
    if props.label != "" {
        x: s32 = cast(s32)CheckboxLabelXFor(paint.slot_bounds,
            1.0, label)
        y: s32 = cast(s32)CheckboxLabelYFor(paint.bounds,
            cast(float32)label_height)
        label_opacity: float32 = StyleOpacityValue(label.value.fields,
            label.value.opacity)
        PaintClippedLabel(session, node, props.label, x, y, font,
            ColorFromPacked(Opacity(paint.label_color,
                label_opacity)), paint.bounds)
    }
}

// The caller owns the current value. A release routed from the previous tree
// returns a proposed value, without a platform pointer or mutable host state.
#program_export
Checkbox :: (session: Session, props: CheckboxProps) -> CheckboxValueResult {
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    previous: s32 = -1
    if TreeIsBuilding(session) {
        previous = TreePrevious(session, TreeCurrentParent(session), key, WidgetKindCheckbox)
    }
    clicked: bool = TreeTakeActivationAt(session, previous)
    result: CheckboxValueResult = CheckboxValueApply(props.checked,
        clicked && !props.disabled, true)
    state: s32 = ResolveState(cast(s32)ButtonStateAuto, props.disabled,
        false, TreePressedAt(session, previous), TreeHoveredAt(session, previous),
        false, result.checked)
    rules: StyleRules = ActiveStyleRules()
    box: StyleFrame = CheckboxFaceFor(rules, props,
        CheckboxBoxRoleForTone(cast(ButtonTone)ButtonToneNeutral),
        cast(ButtonTone)ButtonToneNeutral, state)
    active: StyleFrame = CheckboxFaceFor(rules, props,
        CheckboxBoxRoleForTone(cast(ButtonTone)ButtonToneAccent),
        cast(ButtonTone)ButtonToneAccent, state)
    label: StyleFrame = CheckboxFaceFor(rules, props,
        CheckboxLabelRole(), cast(ButtonTone)ButtonToneNeutral, state)
    font: s32 = ResolveFont(0,
        StyleFontValue(label.value.fields, label.value.font_size), 14)
    label_width: s32 = 0
    label_height: s32 = 0
    if props.label != "" {
        label_width = GlyphWidth(props.label, font,
            label.value.typeface)
        label_height = GlyphLineHeight(font, label.value.typeface)
    }
    layout: CheckboxLayout = CheckboxLayoutForText(props.bounds.x,
        props.bounds.y, cast(float32)label_width, cast(float32)label_height,
        1.0, box, label)
    bounds: Rectangle = layout.bounds
    if props.bounds.width > 0.0 { bounds.width = props.bounds.width }
    if props.bounds.height > 0.0 { bounds.height = props.bounds.height }
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, key, WidgetKindCheckbox, bounds)
        if node < 0 { return result }
        TreeSetInteractive(session, node, props.disabled, false, props.id)
        TreeSetSelected(session, node, result.checked)
        TreeSetLabel(session, node, props.label)
    }
    spec: CheckboxSpec
    spec.bounds = bounds
    spec.checked = result.checked
    spec.enabled = !props.disabled
    spec.hovered = TreeHoveredAt(session, previous)
    spec.pressed = TreePressedAt(session, previous)
    spec.scale = 1.0
    spec.box = box
    spec.active = active
    spec.label = label
    paint: CheckboxPaint = CheckboxPaintFor(spec)
    PaintCheckboxForNode(session, node, props, paint, label, font,
        label_height)
    return result
}
