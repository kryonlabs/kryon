#module "theme_state"
#import "theme.h"
#import "theme_meta.h"
#import "ui_core.h"
#import "ui/theme_color.h"
#import "runtime/theme.h"
#import <stdio.h>

g_theme_content_alpha :: float = 1.0f #global #export

static theme_dark_mode: bool = false
static current_theme_id: i32 = THEME_MONO
static theme_source: ThemeSource = THEME_SOURCE_SYSTEM
static theme_mode: ThemeMode = THEME_MODE_SYSTEM

static active_theme: Theme
static default_theme_enabled: i32 = 1
static active_theme_set: i32
static active_theme_name: [THEME_NAME_SIZE]char
static active_theme_family: ThemeFamily
static active_theme_family_set: i32
static active_theme_family_name: [THEME_NAME_SIZE]char
static active_theme_light_name: [THEME_NAME_SIZE]char
static active_theme_dark_name: [THEME_NAME_SIZE]char
static default_theme_ref: Theme

ThemeStateCurrentId :: () -> i32 #export {
    return current_theme_id
}

ThemeStateContentAlpha :: () -> float #export {
    return g_theme_content_alpha
}

ResetTheme :: () #export {
    active_theme_set = 0
    active_theme_family_set = 0
    ClearThemeMetricsOverride()
}

SetThemeSource :: (source: ThemeSource) #export {
    default_theme_enabled = 0
    theme_source = NormalizeThemeSource(source)
}

GetThemeSource :: () -> ThemeSource #export {
    return theme_source
}

SetThemeMode :: (mode: ThemeMode) #export {
    theme_mode = NormalizeThemeMode(mode)
    theme_dark_mode = ResolveDark((ThemePolicy)theme_mode,
                                  SystemThemePrefersDark())
    if active_theme_family_set {
        selected: Theme = ThemeFamilySelection(active_theme_family,
                                               theme_dark_mode)
        snprintf(active_theme_name, sizeof(active_theme_name), "%s",
                 selected.name != nil ? selected.name : "Theme")
        active_theme = selected
        active_theme.name = active_theme_name
        active_theme_set = 1
        SetThemeMetrics(active_theme.metrics)
    }
    ApplyCurrentTheme()
}

GetThemeMode :: () -> ThemeMode #export {
    return theme_mode
}

SetCurrentTheme :: (theme_id: i32, current_dark_mode: i32) #export {
    default_theme_enabled = 0
    active_theme_family_set = 0
    active_theme_set = 0
    current_theme_id = NormalizeTheme(theme_id)
    theme_dark_mode = current_dark_mode != 0
    ApplyCurrentTheme()
}

SetTheme :: (theme: Theme) #export {
    default_theme_enabled = 0
    active_theme_family_set = 0
    snprintf(active_theme_name, sizeof(active_theme_name), "%s",
             theme.name != nil ? theme.name : "Theme")
    active_theme = theme
    active_theme.name = active_theme_name
    active_theme_set = 1
    theme_mode = ThemeModeFor(theme)
    SetThemeMetrics(theme.metrics)
    ApplyCurrentTheme()
}

SetThemeFamily :: (family: ThemeFamily) #export {
    default_theme_enabled = 0
    snprintf(active_theme_family_name, sizeof(active_theme_family_name), "%s",
             family.name != nil ? family.name : "Theme family")
    snprintf(active_theme_light_name, sizeof(active_theme_light_name), "%s",
             family.light.name != nil ? family.light.name : "Light")
    snprintf(active_theme_dark_name, sizeof(active_theme_dark_name), "%s",
             family.dark.name != nil ? family.dark.name : "Dark")
    active_theme_family = family
    active_theme_family.name = active_theme_family_name
    active_theme_family.light.name = active_theme_light_name
    active_theme_family.dark.name = active_theme_dark_name
    active_theme_family.light.mode = THEME_MODE_LIGHT
    active_theme_family.dark.mode = THEME_MODE_DARK
    active_theme_family_set = 1
    SetThemeMode(GetEffectiveThemeDarkMode() ? THEME_MODE_DARK
                                             : THEME_MODE_LIGHT)
}

GetThemeFamily :: () -> ThemeFamily #export {
    if active_theme_family_set {
        return active_theme_family
    }
    if default_theme_enabled {
        return DefaultThemeFamily()
    }
    return (ThemeFamily){0}
}

GetTheme :: () -> Theme #export {
    if active_theme_set {
        return active_theme
    }
    return GetEffectiveThemeDarkMode() ? ThemeDefaultDark()
                                       : ThemeDefaultLight()
}

GetThemeRef :: () -> const Theme* #export {
    if active_theme_set {
        return &active_theme
    }
    if !default_theme_enabled {
        return nil
    }
    default_theme_ref = GetEffectiveThemeDarkMode() ? ThemeDefaultDark()
                                                    : ThemeDefaultLight()
    return &default_theme_ref
}
