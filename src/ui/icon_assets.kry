#module "icon_assets_host"
#inspect off
#import "ui_icons.h"
#import "string.h"

kry_icon_asset_count :: () -> u32 #extern
kry_icon_assets :: () -> *const IconAsset #extern
kry_icon_sheet_texture :: (sheet: IconSheet) -> Texture2D #extern
kry_draw_texture_region :: (texture: Texture2D, source: Rectangle,
bounds: Rectangle, origin: Vector2, rotation: float,
tint: Color) #extern

GetIconAsset :: (type: IconType) -> *const IconAsset #export {
    count: u32 = kry_icon_asset_count()
    assets: *const IconAsset = kry_icon_assets()
    i: u32 = 0
    while i < count {
        asset: *const IconAsset = &assets[i]
        if asset->type == type { return asset }
        i += 1
    }
    return nil
}

GetIconAssetByName :: (name: const char*) -> *const IconAsset #export {
    if name == nil { return nil }
    count: u32 = kry_icon_asset_count()
    assets: *const IconAsset = kry_icon_assets()
    i: u32 = 0
    while i < count {
        asset: *const IconAsset = &assets[i]
        if strcmp(asset->name, name) == 0 { return asset }
        i += 1
    }
    return nil
}

ui_draw_icon_asset_backend :: (type: IconType, bounds: Rectangle,
tint: Color) #export {
    asset: *const IconAsset = GetIconAsset(type)
    if asset == nil || bounds.width <= 0 || bounds.height <= 0 ||
    tint.a == 0 { return }
    atlas: Texture2D = kry_icon_sheet_texture(asset->sheet)
    if atlas.id == 0 { return }
    if asset->sheet != ICON_SHEET_CORE {
        tint = (Color){255, 255, 255, tint.a}
    }
    kry_draw_texture_region(atlas, asset->source, bounds,
    (Vector2){0}, 0.0, tint)
}
