#import "raylib_runtime"
#import "paint_texture"
#import "drawing_props"
#import "geometry"
ImagePixels :: #import "raylib_image_decode";

allocation_mode: s32;
loads: s32;
unloads: s32;
completeness_checks: s32;
begins: s32;
ends: s32;
presented: u32;
last_source: Rectangle;
last_destination: Rectangle;
retained_blend_valid: bool = true;
retained_blend_active: bool;
copy_mode: s32;
copy_reads: s32;
copy_uploads: s32;
copy_releases: s32;
copy_disposals: s32;
copy_source: Texture2D;
copy_pixel: u32;
copy_framebuffer: u32 = 777;

#program_export
rlGetActiveFramebuffer :: () -> u32 { return copy_framebuffer }

#program_export
rlEnableFramebuffer :: (id: u32) { copy_framebuffer = id }

#if !#defined(RAYLIB_GRAPHICS_HOST) {
#program_export
rlDrawRenderBatchActive :: () {}

#program_export
LoadImageFromTexture :: (texture: Texture2D) -> ImagePixels.RaylibGlyphImage {
    copy_reads += 1
    copy_source = texture
    copy_framebuffer = 0
    if copy_mode == 1 { return ImagePixels.RaylibGlyphImage.{} }
    return ImagePixels.RaylibGlyphImage.{cast(*void)*copy_pixel,
        texture.width, texture.height, 1, 7}
}

#program_export
LoadTextureFromImage :: (image: ImagePixels.RaylibGlyphImage) -> Texture2D {
    copy_uploads += 1
    if copy_mode == 2 { return Texture2D.{} }
    return Texture2D.{900, image.width, image.height, 1, image.format}
}

#program_export
UnloadImage :: (image: ImagePixels.RaylibGlyphImage) {
    unused image
    copy_releases += 1
}

#program_export
UnloadTexture :: (texture: Texture2D) {
    if texture.id == 900 { copy_disposals += 1 }
}
}

#program_export
rlSetBlendFactorsSeparate :: (source_rgb: s32, destination_rgb: s32,
    source_alpha: s32, destination_alpha: s32, rgb_equation: s32, alpha_equation: s32) {
    if source_rgb != 770 || destination_rgb != 771 || source_alpha != 1 ||
    destination_alpha != 771 || rgb_equation != 32774 || alpha_equation != 32774 {
        retained_blend_valid = false
    }
}

#program_export
BeginBlendMode :: (mode: s32) {
    if mode != 7 || retained_blend_active { retained_blend_valid = false }
    retained_blend_active = true
}

#program_export
EndBlendMode :: () {
    if !retained_blend_active { retained_blend_valid = false }
    retained_blend_active = false
}

#program_export
LoadRenderTexture :: (width: s32, height: s32) -> HostRaylibRenderTexture {
    loads += 1
    target: HostRaylibRenderTexture
    if allocation_mode == 4 { return target }
    target.id = cast(u32)loads
    target.texture = Texture2D.{cast(u32)(100 + loads), width, height, 1, 7}
    target.depth = Texture2D.{cast(u32)(200 + loads), width, height, 1, 19}
    if allocation_mode == 1 { target.texture.id = cast(u32)0 }
    if allocation_mode == 3 { target.texture.width = width + 1 }
    return target
}

#program_export
IsRenderTextureValid :: (target: HostRaylibRenderTexture) -> bool {
    return target.id != cast(u32)0 && target.texture.id != cast(u32)0 &&
    target.depth.id != cast(u32)0
}

#program_export
rlFramebufferComplete :: (id: u32) -> bool {
    unused id
    completeness_checks += 1
    return allocation_mode != 2
}

#program_export
UnloadRenderTexture :: (target: HostRaylibRenderTexture) {
    unused target
    unloads += 1
}

#program_export
BeginDrawing :: () { begins += 1 }
#program_export
EndDrawing :: () { ends += 1 }
#program_export
BeginTextureMode :: (target: HostRaylibRenderTexture) { unused target }
#program_export
EndTextureMode :: () {}
#program_export
DrawTexturePro :: (texture: Texture2D, source: Rectangle, destination: Rectangle,
    origin: Vector2, rotation: float32, tint: Color) {
    unused origin
    unused rotation
    unused tint
    presented = texture.id
    last_source = source
    last_destination = destination
}
