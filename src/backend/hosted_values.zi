// Values that cross the portable bundle boundary. Records match fields by
// name, so a bundle and its host may be built against different layouts: a
// missing field keeps its zero value and an unknown one is ignored. The
// usual field order is checked first.
#import "std/bundle_host"
#import "std/byte_text_linux"

using HostValueKind;

HOST_FIELD_LIMIT :: 512

HostTypeFlatSame :: (qualified: string, plain: string) -> bool {
    qualified_at: s64 = 0
    plain_at: s64 = 0
    while qualified_at < qualified.count && plain_at < plain.count {
        if qualified[qualified_at] == cast(u8)46 {
            qualified_at += 1
            continue
        }
        if qualified[qualified_at] != plain[plain_at] { return false }
        qualified_at += 1
        plain_at += 1
    }
    while qualified_at < qualified.count && qualified[qualified_at] == cast(u8)46 {
        qualified_at += 1
    }
    return qualified_at == qualified.count && plain_at == plain.count
}

HostFieldAt :: (value: HostValue, position: s32, name: string) -> s32 {
    count := cast(s32)value.field_count
    if position < count && value.fields[position].name != null &&
    TextFromCString(value.fields[position].name) == name {
        return position
    }
    index: s32 = 0
    while index < count {
        if value.fields[index].name != null && TextFromCString(value.fields[index].name) == name {
            return index
        }
        index += 1
    }
    return -1
}

// A package body names its own record without an import qualifier while its
// host names that record through a package import. Keep those two spellings
// compatible, but do not confuse equally named records from two packages.
// Container prefixes stay exact.
HostTypeSame :: (actual: string, expected: string) -> bool {
    if actual == expected { return true }
    actual_at: s64 = 0
    expected_at: s64 = 0
    while actual_at < actual.count && expected_at < expected.count &&
    actual[actual_at] == cast(u8)91 && expected[expected_at] == cast(u8)91 {
        actual_close := actual_at
        while actual_close < actual.count && actual[actual_close] != cast(u8)93 {
            actual_close += 1
        }
        expected_close := expected_at
        while expected_close < expected.count && expected[expected_close] != cast(u8)93 {
            expected_close += 1
        }
        if actual_close >= actual.count || expected_close >= expected.count ||
        actual[actual_at:actual_close + 1] != expected[expected_at:expected_close + 1] {
            return false
        }
        actual_at = actual_close + 1
        expected_at = expected_close + 1
    }
    while actual_at < actual.count && expected_at < expected.count &&
    actual[actual_at] == cast(u8)42 && expected[expected_at] == cast(u8)42 {
        actual_at += 1
        expected_at += 1
    }
    actual_leaf := actual_at
    for index: actual_at..actual.count - 1 {
        if actual[index] == cast(u8)46 { actual_leaf = index + 1 }
    }
    expected_leaf := expected_at
    for index: expected_at..expected.count - 1 {
        if expected[index] == cast(u8)46 { expected_leaf = index + 1 }
    }
    actual_qualified := actual_leaf != actual_at
    expected_qualified := expected_leaf != expected_at
    if actual_qualified && expected_qualified { return false }
    if actual[actual_leaf:] == expected[expected_leaf:] { return true }
    if actual_qualified {
        return HostTypeFlatSame(actual[actual_at:], expected[expected_at:])
    }
    if expected_qualified {
        return HostTypeFlatSame(expected[expected_at:], actual[actual_at:])
    }
    return false
}

HostTypeValid :: (actual: *u8, expected: string) -> bool {
    return actual != null && HostTypeSame(TextFromCString(actual), expected)
}

HostScalarValid :: (value: HostValue, type_name: string, kind: s32) -> bool {
    if value.kind != kind || !HostTypeValid(value.type_name, type_name) {
        return false
    }
    if kind == cast(s32)HostString {
        return value.length == 0 || value.data != null
    }
    return true
}

HostArrayValid :: (value: HostValue, type_name: string, count: usize) -> bool {
    return value.kind == cast(s32)HostArray && HostTypeValid(value.type_name, type_name) &&
    value.length == count && value.elements != null
}

HostScalar :: (type_name: string, number: s64) -> HostValue {
    value: HostValue
    value.type_name = HostTextData(type_name)
    value.integer = number
    value.bits = cast(u64)number
    value.kind = ifx type_name[0] == cast(u8)117 then cast(s32)HostUnsigned else cast(s32)HostInteger
    return value
}

// Borrows the bytes of text that outlives the call, such as a literal.
HostTextData :: (text: string) -> *u8 {
    descriptor := cast(*TextDescriptor)(*text)
    return descriptor.data
}

// The length of a decoded slice field, matched by name like its elements.
HostSliceLength :: (value: HostValue, position: s32, name: string) -> s32 {
    field_at := HostFieldAt(value, position, name)
    if field_at < 0 {
        return 0
    }
    return cast(s32)value.fields[field_at].value.length
}

// Missing fields retain their zero value; records still match fields by name.
HostFieldValue :: (value: *HostValue, position: s32, name: string,
    zero: *HostValue) -> *HostValue {
    field_at := HostFieldAt(value.*, position, name)
    if field_at >= 0 { return *value.fields[field_at].value }
    return zero
}

HostValueText :: (value: HostValue) -> string {
    return TextFromBytes(BytesFromPointer(value.data, cast(u64)value.length))
}

HostRecordValue :: (type_name: string, fields: []HostField) -> HostValue {
    value: HostValue
    value.kind = cast(s32)HostRecord
    value.type_name = HostTextData(type_name)
    value.field_count = cast(usize)fields.count
    if fields.count > 0 { value.fields = *fields[0] }
    return value
}

HostRecordValid :: (value: *HostValue, type_name: string) -> bool {
    return value.kind == cast(s32)HostRecord && HostTypeValid(value.type_name, type_name) &&
        value.field_count <= cast(usize)HOST_FIELD_LIMIT &&
        (value.field_count == cast(usize)0 || value.fields != null)
}

HostFieldScalarValid :: (value: *HostValue, position: s32, name: string,
    type_name: string, kind: s32) -> bool {
    field_at := HostFieldAt(value.*, position, name)
    return field_at < 0 || HostScalarValid(value.fields[field_at].value, type_name, kind)
}

HostRecordValidator :: #type (value: HostValue) -> bool;

HostElementRule :: struct {
    type_name: string
    kind: s32
    validate_record: HostRecordValidator
}

HostFieldSliceValid :: (value: *HostValue, position: s32, name: string,
    type_name: string, limit: usize, rule: HostElementRule) -> bool {
    field_at := HostFieldAt(value.*, position, name)
    if field_at < 0 { return true }
    field := value.fields[field_at].value
    if field.kind != cast(s32)HostSlice || !HostTypeValid(field.type_name, type_name) ||
    field.length > limit || (field.length > cast(usize)0 && field.elements == null) {
        return false
    }
    index: usize = 0
    while index < field.length {
        if rule.validate_record != null {
            if !rule.validate_record(field.elements[index]) { return false }
        } else {
            if !HostScalarValid(field.elements[index], rule.type_name, rule.kind) { return false }
        }
        index += cast(usize)1
    }
    return true
}

HostFieldRecordValid :: (value: *HostValue, position: s32, name: string,
    valid: HostRecordValidator) -> bool {
    field_at := HostFieldAt(value.*, position, name)
    return field_at < 0 || valid(value.fields[field_at].value)
}
