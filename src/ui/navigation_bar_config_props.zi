#import "dropdown"
#import "geometry"
#import "image_props"

NavigationBarOption :: struct {
    key: u64
    route: s32
    label: string
    image: ImageProps
}

// Routes are a caller owned mutable slice. The returned count and dropdown
// state must be passed back on the next frame.
NavigationBarConfigProps :: struct {
    key: u64
    id: s32
    class_name: s32
    title: string
    bounds: Rectangle
    scale: float32
    route_count: s32
    max_route_count: s32
    scroll_offset: s32
    wheel: float32
    dropdown_open: bool
    dropdown_row: s32
    dropdown_highlight_index: s32
    dropdown_scroll_offset: s32
    dropdown_wheel: float32
    // Route keyboard samples to focused_row; the caller owns focus.
    focused_row: s32
    trigger_input: DropdownTriggerInput
    menu_input: DropdownMenuInput
    close_label: string
    remove_label: string
    add_label: string
    reset_label: string
    cancel_label: string
    save_label: string
}

NavigationBarConfigResult :: struct {
    node: s32
    action: s32
    changed: bool
    route_count: s32
    scroll_offset: s32
    dropdown_open: bool
    dropdown_row: s32
    dropdown_highlight_index: s32
    dropdown_scroll_offset: s32
}
