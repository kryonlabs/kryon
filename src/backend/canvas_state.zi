#import "c_string"
#import "byte_text_linux"
#import "drawing_props"
#import "tree_input"
#import "canvas_types"
#import "canvas_texture"
#import "canvas_text"
#import "canvas_os"
#import "text_typeface"
#import "text_buffer"
Lanczos :: #import "lanczos_cache";
#import "page_core"
#import "paint_queue"
// Text layout stays cached while these fonts stay loaded; see font_metrics.
Metrics :: #import "font_metrics";

c :: #system_library "c";
HostTypefaceAllocate :: (size: usize) -> *u8 #foreign c "malloc";
HostTypefaceFree :: (bytes: *u8) #foreign c "free";

CanvasAsset :: struct {
    path: [1024]u8
    length: s32
    // An FNV-1a hash of the path: a lookup compares bytes only on a match.
    hash: u64
    texture: Texture2D
    // Drawn with the browser's image smoothing.
    smooth: bool
    // Its folder was replaced: the texture stays drawn until its bytes are
    // read again, and only bytes that differ replace it.
    revalidating: bool
    // FNV-1a and length of the bytes the texture was decoded from.
    content: u64
    content_size: s64
    // The lookup clock at its last use: a full cache replaces the image
    // used longest ago.
    used: u64
}

// A scene often draws more images than fit a small cache: one replaced in
// arrival order was decoded again every frame. The cache keeps the images
// used most recently, up to a slot count and a total of decoded pixels.
CANVAS_ASSET_SLOTS :: 128
CANVAS_ASSET_PIXEL_LIMIT :: 100663296

canvas_assets: [CANVAS_ASSET_SLOTS]CanvasAsset;
canvas_assets_count: s32;
canvas_asset_clock: u64;
// The asset found last: an image asks for its width, its height and its
// texture in turn, so most lookups only confirm the same path again.
canvas_asset_last: s32 = -1;
canvas_pointer: PointerFrame;
canvas_secondary: SecondaryPointerFrame;
canvas_wheel_move: float32;
canvas_image_error: bool;
canvas_font: CanvasFont;
canvas_font_loaded: bool;
canvas_font_registered: bool;
canvas_active_typeface_index: s32 = -1;

CanvasTypeface :: struct {
    name: [64]u8
    name_length: s32
    font: CanvasFont
}

canvas_typefaces: [16]CanvasTypeface;
canvas_typeface_count: s32;

CanvasTypefaceIndex :: (name: string) -> s32 {
    if name.count == 0 || name.count >= 64 {
        return -1
    }
    index: s32 = 0
    while index < canvas_typeface_count {
        if canvas_typefaces[index].name_length == cast(s32)name.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)name.count {
                if canvas_typefaces[index].name[at] != name[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same {
                return index
            }
        }
        index += 1
    }
    return -1
}

CanvasStoreTypeface :: (name: string, font: CanvasFont) -> bool {
    SetTextTypefaceSelector(CanvasTextTypeface)
    if font.texture.id == cast(u32)0 || name.count == 0 ||
    name.count >= 64 {
        return false
    }
    name_bytes: [64]u8
    if !CopyCString(name, name_bytes[:]) {
        return false
    }
    index: s32 = CanvasTypefaceIndex(name)
    if index < 0 {
        if canvas_typeface_count == 16 {
            return false
        }
        index = canvas_typeface_count
        canvas_typeface_count += 1
    } else {
        UnloadFont(canvas_typefaces[index].font)
    }
    if !CopyCString(name, canvas_typefaces[index].name[:]) {
        return false
    }
    canvas_typefaces[index].name_length = cast(s32)name.count
    canvas_typefaces[index].font = font
    if canvas_active_typeface_index == index {
        canvas_font = font
        canvas_font_loaded = true
        canvas_font_registered = true
    }
    return true
}

#program_export
LoadTypefaceData :: (name: string, extension: string, data: string,
    seed: *s32, seed_count: s32) -> bool {
    if name.count == 0 || extension.count == 0 || data.count == 0 ||
    data.count > 2147483647 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    extension_bytes: [16]u8
    if !CopyCString(extension, extension_bytes[:]) {
        return false
    }
    bytes: *u8 = HostTypefaceAllocate(cast(usize)data.count)
    if bytes == null {
        return false
    }
    index: s32 = 0
    while index < cast(s32)data.count {
        bytes[index] = data[index]
        index += 1
    }
    font := LoadFontFromMemory(*extension_bytes[0], bytes,
        cast(s32)data.count, 64, seed, seed_count)
    HostTypefaceFree(bytes)
    if font.texture.id == cast(u32)0 {
        return false
    }
    if !CanvasStoreTypeface(name, font) {
        UnloadFont(font)
        return false
    }
    Metrics.GlyphMetricsChanged()
    return true
}

#program_export
LoadTypefaceFile :: (name: string, path: string,
    seed: *s32, seed_count: s32) -> bool {
    if name.count == 0 || path.count == 0 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    path_bytes: [4096]u8
    if !CopyCString(path, path_bytes[:]) {
        return false
    }
    font := LoadFontEx(*path_bytes[0], 64, seed, seed_count)
    if font.texture.id == cast(u32)0 {
        return false
    }
    if !CanvasStoreTypeface(name, font) {
        UnloadFont(font)
        return false
    }
    Metrics.GlyphMetricsChanged()
    return true
}

#program_export
LoadSystemTypeface :: (name: string) -> bool {
    return false
}

CanvasTextTypeface :: (name: string) -> string {
    previous := TextTypefaceSlot(canvas_active_typeface_index)
    if name == "@builtin" {
        canvas_active_typeface_index = -1
        canvas_font_loaded = false
        canvas_font_registered = false
        return previous
    }
    saved_slot := TextTypefaceSlotIndex(name)
    if saved_slot >= 0 && saved_slot < canvas_typeface_count {
        canvas_font = canvas_typefaces[saved_slot].font
        canvas_active_typeface_index = saved_slot
        canvas_font_loaded = true
        canvas_font_registered = true
        return previous
    }
    key := name
    key_buffer: [32]u8
    if name.count >= 64 || (name.count >= 7 && name[:7] == "assets/") ||
    (name.count > 0 && name[0] == #char "/") { key = TextTypefaceKey(name, key_buffer[:]) }
    index := CanvasTypefaceIndex(key)
    if index < 0 && key != name && LoadTypefaceFile(key, name, null, 0) {
        index = CanvasTypefaceIndex(key)
    }
    if index >= 0 { unused SelectTypeface(key) }
    return previous
}

#program_export
SelectTypeface :: (name: string) -> bool {
    index: s32 = CanvasTypefaceIndex(name)
    if index < 0 {
        return false
    }
    if canvas_font_loaded && !canvas_font_registered {
        UnloadFont(canvas_font)
    }
    canvas_font = canvas_typefaces[index].font
    canvas_font_loaded = true
    canvas_font_registered = true
    canvas_active_typeface_index = index
    return true
}

#program_export
ReleaseTypefaces :: () {
    if canvas_font_loaded && !canvas_font_registered {
        UnloadFont(canvas_font)
    }
    index: s32 = 0
    while index < canvas_typeface_count {
        UnloadFont(canvas_typefaces[index].font)
        canvas_typefaces[index] = CanvasTypeface.{}
        index += 1
    }
    canvas_typeface_count = 0
    canvas_active_typeface_index = -1
    canvas_font = CanvasFont.{}
    canvas_font_loaded = false
    canvas_font_registered = false
    Metrics.GlyphMetricsChanged()
}

#program_export
ReleaseTypefaceCpu :: () {
    // canvas owns glyph data until UnloadFont releases the atlas.
}

CanvasTryFont :: (path: *u8) -> bool {
    if path == null || !FileExists(path) { return false }
    canvas_font = LoadFontEx(path, 32, null, 0)
    canvas_font_loaded = canvas_font.texture.id != cast(u32)0
    canvas_font_registered = false
    Metrics.GlyphMetricsChanged()
    return canvas_font_loaded
}

CanvasAssetIs :: (index: s32, path: string) -> bool {
    asset := *canvas_assets[index]
    return asset.length == cast(s32)path.count && TextFromBytes(asset.path[:asset.length]) == path
}

// Releases one cached image; an empty path never matches a lookup.
CanvasForgetAsset :: (index: s32) {
    if canvas_assets[index].texture.id != cast(u32)0 {
        // Queued page paint can still refer to the texture being released.
        PageFlushPaint()
        UnloadTexture(canvas_assets[index].texture)
        Lanczos.LanczosForget(canvas_assets[index].hash)
        PaintResourcesChanged()
    }
    canvas_assets[index] = CanvasAsset.{}
    if canvas_asset_last == index { canvas_asset_last = -1 }
}

// A revalidated image reads its bytes again on its next use. The same bytes
// keep its texture, and different ones replace it in one step once they
// have decoded, so it never leaves the screen; an image whose bytes are
// gone is forgotten.
CanvasRevalidateAsset :: (index: s32) -> bool {
    asset := *canvas_assets[index]
    asset.revalidating = false
    loaded := LoadTextureUnlessContent(*asset.path[0], asset.content, asset.content_size)
    if loaded.size == 0 {
        CanvasForgetAsset(index)
        return false
    }
    // Unchanged bytes, or undecodable replacement bytes, keep the picture.
    if loaded.texture.id == cast(u32)0 { return true }
    PageFlushPaint()
    UnloadTexture(asset.texture)
    asset.texture = loaded.texture
    asset.smooth = false
    asset.content = loaded.content
    asset.content_size = loaded.size
    PaintResourcesChanged()
    return true
}

CanvasAssetIndex :: (path: string) -> s32 {
    if path.count == 0 || path.count >= 1024 { return -1 }
    if canvas_asset_last >= 0 && canvas_asset_last < canvas_assets_count &&
    CanvasAssetIs(canvas_asset_last, path) {
        if canvas_assets[canvas_asset_last].revalidating && !CanvasRevalidateAsset(canvas_asset_last) {
            return -1
        }
        canvas_asset_clock += 1
        canvas_assets[canvas_asset_last].used = canvas_asset_clock
        return canvas_asset_last
    }
    // Every image drawn looks its texture up, and asset paths share long
    // prefixes, so compare a hash before any bytes.
    hash: u64 = cast(u64)2166136261
    for byte: path { hash = (hash ^ cast(u64)byte) * cast(u64)16777619 }
    index: s32 = 0
    while index < canvas_assets_count {
        if canvas_assets[index].hash == hash && CanvasAssetIs(index, path) {
            if canvas_assets[index].revalidating && !CanvasRevalidateAsset(index) {
                return -1
            }
            canvas_asset_clock += 1
            canvas_assets[index].used = canvas_asset_clock
            canvas_asset_last = index
            return index
        }
        index += 1
    }
    index = CanvasAssetSlot()
    if !CopyCString(path, canvas_assets[index].path[:]) {
        canvas_assets[index].length = 0
        return -1
    }
    canvas_assets[index].length = cast(s32)path.count
    canvas_assets[index].hash = hash
    loaded := LoadTextureUnlessContent(*canvas_assets[index].path[0], 0, 0)
    canvas_assets[index].texture = loaded.texture
    canvas_assets[index].content = loaded.content
    canvas_assets[index].content_size = loaded.size
    canvas_assets[index].revalidating = false
    canvas_assets[index].smooth = false
    if canvas_assets[index].texture.id == cast(u32)0 {
        canvas_assets[index].length = 0
        return -1
    }
    canvas_asset_clock += 1
    canvas_assets[index].used = canvas_asset_clock
    canvas_asset_last = index
    CanvasAssetsFitPixels(index)
    return index
}

CanvasAssetPixels :: (index: s32) -> s64 {
    texture := canvas_assets[index].texture
    if texture.id == cast(u32)0 { return 0 }
    return cast(s64)texture.width * cast(s64)texture.height
}

// The cached image used longest ago, other than KEEP; -1 when none is.
CanvasAssetOldest :: (keep: s32) -> s32 {
    oldest: s32 = -1
    for index: cast(s32)0..canvas_assets_count - 1 {
        if index == keep || canvas_assets[index].texture.id == cast(u32)0 { continue }
        if oldest < 0 || canvas_assets[index].used < canvas_assets[oldest].used { oldest = index }
    }
    return oldest
}

// A slot for a new image: a free one, else the one used longest ago.
CanvasAssetSlot :: () -> s32 {
    for index: cast(s32)0..canvas_assets_count - 1 {
        if canvas_assets[index].length == 0 && canvas_assets[index].texture.id == cast(u32)0 { return index }
    }
    if canvas_assets_count < CANVAS_ASSET_SLOTS {
        canvas_assets_count += 1
        return canvas_assets_count - 1
    }
    index := CanvasAssetOldest(-1)
    if index < 0 { index = 0 }
    CanvasForgetAsset(index)
    return index
}

// Releases the images used longest ago until the decoded pixels fit the
// limit; KEEP, the image just loaded, always stays.
CanvasAssetsFitPixels :: (keep: s32) {
    pixels: s64 = 0
    for index: cast(s32)0..canvas_assets_count - 1 { pixels += CanvasAssetPixels(index) }
    while pixels > CANVAS_ASSET_PIXEL_LIMIT {
        oldest := CanvasAssetOldest(keep)
        if oldest < 0 { return }
        pixels -= CanvasAssetPixels(oldest)
        CanvasForgetAsset(oldest)
    }
}
