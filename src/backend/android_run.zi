#if #defined(KRYON_ZX_APP) {
    #import "android_bundle_run"
    #program_export
    AndroidRunMain :: () -> s32 { return AndroidBundleRunMain() }
} else {
// Canonical Android host. raylib's NativeActivity backend owns the window
// and calls the application's C main; the application's generated main
// delegates to AndroidRunMain. Java reports insets, density, dark mode and
// soft-keyboard text through android_device's natives, and this loop keeps
// the session, viewport policy and frame protocol running.
#import "android_device"
#import "android_jni"
#import "android_process"
#import "android_surface"
#import "app"
#import "std/byte_text_linux"
#import "drawing_props"
#import "frame_snapshot"
#import "geometry"
#import "raylib_runtime"
#import "scroll_device"
#import "secondary_pointer"
#import "session"
#import "test_driver"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "input_protocol"
#import "std/number_text"
#import "std/text_buffer"
Clock :: #import "std/timer_linux";

using FrameStatus;

android_log :: #system_library "log";
// Android discards standard error; errors go to the system log (adb logcat).
AndroidLogWrite :: (priority: s32, tag: *u8, text: *u8) -> s32 #foreign android_log "__android_log_write";

AndroidError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = 0
    tag: [8]u8 = .[cast(u8)107, cast(u8)114, cast(u8)121, cast(u8)111, cast(u8)110, 0, 0, 0]
    unused AndroidLogWrite(6, *tag[0], *output[0])
    return 1
}

AndroidCanvas :: () -> u32 {
    // Match the raylib desktop host's clear when the app installs no canvas
    // token, so an unstyled application stays readable on both.
    canvas := StyleTokenColorOr("canvas", Color.{248, 250, 252, 255})
    return (cast(u32)canvas.r << 24) | (cast(u32)canvas.g << 16) |
        (cast(u32)canvas.b << 8) | cast(u32)canvas.a
}

// Why the session refused a frame, with the key and kind it stopped at.
AndroidFrameFailure :: (session: Session, step: string) {
    failure := FrameFailureAt(session)
    message: [240]u8
    length: s64 = 0
    digits: [24]u8
    parts: [7]string = .["kryon: ", step, ": ", failure.message, " (key ", FormatInteger(cast(s64)failure.key, digits[:]), ")"]
    for part: parts {
        for byte: part {
            if length < 239 { message[length] = byte; length += 1 }
        }
    }
    unused AndroidError(TextView(message[0:length]))
}

DrawAndroidFrame :: (session: Session, viewport: AndroidViewport,
    bounds: Rectangle) -> bool {
    // The application reads this frame's polled input through
    // CaptureFrameInput. Presentation may yield to the platform, so the
    // publication closes before every EndRaylibFrame, failures included.
    unused RaylibFrameInputBegin(session)
    BeginRaylibFrame()
    ClearAndroidFrame(viewport, AndroidCanvas(), RaylibZoom())
    pointer: PointerFrame = TestDriverPointer(session, PollPointer())
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    // Touch drags move Scroll views, as BundleApp's host frames do.
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down,
        pointer.released, 0.0, cast(float64)Clock.MonotonicMilliseconds() / 1000.0)
    if AndroidTextInputKeyPressed(259) {
        KeyboardSend(session, 259)
    }
    if AndroidTextInputKeyPressed(257) {
        KeyboardSend(session, 257)
    }
    codepoint := AndroidTextInputCharacter()
    while codepoint != 0 {
        TypedCodepointSend(session, codepoint)
        codepoint = AndroidTextInputCharacter()
    }
    if BeginFrame(session, cast(u64)1, bounds) != cast(FrameStatus)FrameOk {
        AndroidFrameFailure(session, "the frame could not begin")
        FrameInputEnd(session)
        EndRaylibFrame()
        return false
    }
    if Frame(session, bounds) != 0 {
        unused AndroidError("kryon: the application's frame failed")
        TreeCancel(session)
        FrameInputEnd(session)
        EndRaylibFrame()
        return false
    }
    if EndFrame(session) != cast(FrameStatus)FrameOk {
        AndroidFrameFailure(session, "the frame could not finish")
        FrameInputEnd(session)
        EndRaylibFrame()
        return false
    }
    // Provider-backed images can disappear after the application composes
    // the tree, for example when Android revokes access or pauses a gallery.
    // RasterImage skips an unavailable asset; keep the activity alive so the
    // next frame can read the new provider/lifecycle state. Tree and application
    // failures above still stop the host.
    FrameInputEnd(session)
    unused EndRaylibFrame()
    TestDriverFrame(session)
    return true
}

AndroidDrawJob :: struct {
    session: Session
    viewport: AndroidViewport
    bounds: Rectangle
    ok: bool
}
AndroidAppCompose :: (argument: *void) {
    draw := cast(*AndroidDrawJob)argument
    draw.ok = DrawAndroidFrame(draw.session, draw.viewport, draw.bounds)
}

#program_export
AndroidRunMain :: () -> s32 {
    AndroidJniKeepHostThread()
    defer { AndroidJniReleaseHostThread() }
    AndroidProcessPrepare()
    if !OpenRaylib() {
        CloseRaylib()
        return AndroidError("kryon: could not open the android window")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseRaylib()
        return AndroidError("kryon: could not open a UI session")
    }
    AndroidTextInputOpen(session)
    defer { AndroidTextInputClose(session) }
    RaylibExitKey(0)
    // Android's own interface font when the application loaded none.
    system_font := !raylib_font_registered && LoadSystemTypeface("ui") && SelectTypeface("ui")
    ok: bool = true
    first_frame: bool = true
    while ok && PollRaylib() {
        if AndroidTakeGraphicsInvalidate() != 0 {
            DiscardRaylibAppFrame()
            // The surface was recreated; stale texture names may belong to
            // the new context, so forget them without deleting.
            ResetRaylibGraphics(true)
            // The system font's texture went with the old context.
            if system_font { system_font = LoadSystemTypeface("ui") && SelectTypeface("ui") }
        }
        key := RaylibPressedKey()
        if key == 0 {
            // A held key repeats, as Backspace does in any text editor.
            key = RaylibRepeatedKey()
        }
        if key == 0 {
            for candidate: cast(s32)0..269 {
                if TestDriverKeyPressed(candidate) { key = candidate; break }
            }
        }
        if key != 0 {
            // Android Back follows the same in-app navigation and overlay
            // dismissal path as Escape on the other hosts.
            KeyboardSend(session, ifx key == 4 then KeyEscape else key)
        }
        viewport: AndroidViewport
        SyncAndroidViewport(*viewport)
        bounds: Rectangle = Rectangle.{cast(float32)viewport.x,
            cast(float32)viewport.y, cast(float32)viewport.width,
            cast(float32)viewport.height}
        if viewport.ready == 0 || viewport.width <= 0 || viewport.height <= 0 {
            // Insets have not been reported yet; draw over the full surface.
            width: s32
            height: s32
            GetAndroidSurfaceSize(*width, *height)
            bounds = Rectangle.{0.0, 0.0, cast(float32)width,
                cast(float32)height}
            viewport.x = 0
            viewport.y = 0
            viewport.width = width
            viewport.height = height
        }
        // Android apps lay out in density-independent pixels. The host draws
        // and reads the pointer at the device density, so the application's
        // bounds, sizes and fonts mean the same on every screen.
        zoom := AndroidLayoutZoom()
        RaylibSetZoom(zoom)
        bounds = Rectangle.{bounds.x / zoom, bounds.y / zoom, bounds.width / zoom, bounds.height / zoom}
        AndroidTextInputBeginFrame(session)
        draw := AndroidDrawJob.{.session = session, .viewport = viewport, .bounds = bounds}
        ok = RunRaylibAppFrame(AndroidAppCompose, cast(*void)*draw) && draw.ok
        AndroidTextInputFrame(session, false)
        if ok && first_frame {
            first_frame = false
            AndroidNotifyFirstFrame()
        }
        // The application consumes keys while composing its frame. A back
        // key nothing took closes the activity, as Android users expect.
        if ok && key == 4 && KeyboardTake(session) == KeyEscape {
            AndroidJniFinishActivity()
        }
    }
    CloseRaylibAppFrames()
    CloseSession(session)
    CloseRaylib()
    if ok { return 0 }
    return AndroidError("kryon: android frame rendering failed")
}

}
