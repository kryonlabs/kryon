// A reusable portable Kryon host for caller-owned pixel surfaces.
// No application UI is linked into this player. Each instance retains its
// own bundle globals; platform callbacks cannot close the supervising host.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "std/c_string"
#import "std/vec"
#import "geometry"
#import "drawing_props"
#import "pixmap"
using HostValueKind;
Name :: struct { bytes: [128]u8 }
Input :: struct {
    width: s32; height: s32; x: float32; y: float32;
    down: bool; pressed: bool; released: bool;
    secondary_down: bool; secondary_pressed: bool; secondary_released: bool;
    modifiers: s32; key: s32; wheel: float32;
}
Player :: struct {
    fields: [13]HostField; names: [27]Name; bindings: [128]HostBinding;
    bundle: *void; instance: *void; input: Input;
    codepoints: [256]s32; typed_count: s32; typed_at: s32;
    platform: HostCall; context: *void; closed: bool; keyboard: bool;
}
Supported :: (module: string, function: string) -> bool {
    if ModuleName(module,"zib_run") { return function=="ReadBundleInput" || function=="TakeBundleCodepoint" || function=="BundleTextInputHost" }
    if ModuleName(module,"font_metrics") { return function=="MeasureGlyphWidth" || function=="MeasureGlyphLineHeight" }
    if ModuleName(module,"raster_text") { return function=="RasterText" || function=="RasterTextClipped" }
    if ModuleName(module,"raster_shape") { return function=="RasterRoundedRectangle" || function=="RasterRoundedRectangleOutline" }
    if ModuleName(module,"raster") { return function=="RasterLine" }
    if ModuleName(module,"paint_queue") { return function=="RasterImage" }
    if ModuleName(module,"image_raster") { return function=="ImageWidth" || function=="ImageHeight" }
    if ModuleName(module,"system_clipboard") { return function=="SystemClipboardOpenHost" || function=="SystemClipboardByteHost" || function=="SystemClipboardWriteHost" }
    if ModuleName(module,"window") { return function=="WindowSetVisibleHost" || function=="WindowVisibleHost" || function=="WindowFocusedHost" || function=="WindowInterceptCloseHost" || function=="WindowTakeCloseRequestHost" || function=="WindowQuitHost" || function=="WindowCompactHost" || function=="WindowBackgroundHost" || function=="WindowBackgroundDragHost" }
    if ModuleName(module,"media") { return function=="MediaOpenHost" || function=="MediaPauseHost" || function=="MediaStopHost" || function=="MediaStateHost" || function=="MediaMessageHost" || function=="FetchTextHost" || function=="FetchTextStateHost" || function=="FetchTextResultHost" }
    return false
}
ModuleName :: (value: string, name: string) -> bool {
    if value == name { return true }
    separator: s64 = 0
    while separator < value.count && value[separator] != cast(u8)95 {
        separator += 1
    }
    return separator + 1 < value.count &&
    value[separator + 1:value.count] == name
}

TextValue :: (value: HostValue) -> string {
    if value.length == 0 { return "" }
    return TextFromBytes(BytesFromPointer(cast(*u8)value.data, cast(u64)value.length))
}

Field :: (value: HostValue, index: s32, name: string, kind: s32) -> bool {
    return value.kind == HostRecord && value.fields != null &&
    cast(usize)index < value.field_count &&
    TextFromCString(value.fields[index].name) == name &&
    value.fields[index].value.kind == kind
}
RectangleValue :: (value: HostValue) -> bool {
    return value.field_count == cast(usize)4 &&
    Field(value, 0, "x", HostReal) && Field(value, 1, "y", HostReal) &&
    Field(value, 2, "width", HostReal) && Field(value, 3, "height", HostReal)
}
ColorValue :: (value: HostValue) -> bool {
    return value.field_count == cast(usize)4 &&
    Field(value, 0, "r", HostUnsigned) && Field(value, 1, "g", HostUnsigned) &&
    Field(value, 2, "b", HostUnsigned) && Field(value, 3, "a", HostUnsigned)
}
VectorValue :: (value: HostValue) -> bool {
    return value.field_count == cast(usize)2 &&
    Field(value, 0, "x", HostReal) && Field(value, 1, "y", HostReal)
}
RectangleFrom :: (value: HostValue) -> Rectangle {
    return Rectangle.{cast(float32)value.fields[0].value.real,
        cast(float32)value.fields[1].value.real,
        cast(float32)value.fields[2].value.real,
        cast(float32)value.fields[3].value.real}
}
ColorFrom :: (value: HostValue) -> Color {
    return Color.{cast(u8)value.fields[0].value.bits,
        cast(u8)value.fields[1].value.bits,
        cast(u8)value.fields[2].value.bits,
        cast(u8)value.fields[3].value.bits}
}
VectorFrom :: (value: HostValue) -> Vector2 {
    return Vector2.{cast(float32)value.fields[0].value.real,
        cast(float32)value.fields[1].value.real}
}

InputField :: (player: *Player, index: s32, name: string,
    type_name: string, kind: s32) -> bool {
    if !CopyCString(name, player.names[index * 2].bytes[:]) ||
    !CopyCString(type_name, player.names[index * 2 + 1].bytes[:]) {
        return false
    }
    player.fields[index].name = *player.names[index * 2].bytes[0]
    player.fields[index].value.kind = kind
    player.fields[index].value.type_name = *player.names[index * 2 + 1].bytes[0]
    return true
}
PrepareInput :: (player: *Player) -> bool {
    return CopyCString("BundleInput", player.names[26].bytes[:]) &&
    InputField(player, 0, "width", "s32", HostInteger) &&
    InputField(player, 1, "height", "s32", HostInteger) &&
    InputField(player, 2, "x", "float32", HostReal) &&
    InputField(player, 3, "y", "float32", HostReal) &&
    InputField(player, 4, "down", "bool", HostInteger) &&
    InputField(player, 5, "pressed", "bool", HostInteger) &&
    InputField(player, 6, "released", "bool", HostInteger) &&
    InputField(player, 7, "secondary_down", "bool", HostInteger) &&
    InputField(player, 8, "secondary_pressed", "bool", HostInteger) &&
    InputField(player, 9, "secondary_released", "bool", HostInteger) &&
    InputField(player, 10, "modifiers", "s32", HostInteger) &&
    InputField(player, 11, "key", "s32", HostInteger) &&
    InputField(player, 12, "wheel", "float32", HostReal)
}

PlayerCall :: (context: *void, module_name: *u8, function_name: *u8,
    args: *HostValue, count: s32, result: *HostValue) -> s32 {
    player:=cast(*Player)context; module:=TextFromCString(module_name); function:=TextFromCString(function_name)
    if !Supported(module,function) { return 0 }; result.kind=HostVoid
    if function=="BundleTextInputHost" && count==1 && args[0].kind==HostInteger { player.keyboard=args[0].integer!=0; return 1 }
    if function=="ReadBundleInput" && count==0 {
        input:=player.input
        player.fields[0].value.integer=cast(s64)input.width; player.fields[1].value.integer=cast(s64)input.height
        player.fields[2].value.real=cast(float64)input.x; player.fields[3].value.real=cast(float64)input.y
        player.fields[4].value.integer=cast(s64)input.down; player.fields[5].value.integer=cast(s64)input.pressed; player.fields[6].value.integer=cast(s64)input.released
        player.fields[7].value.integer=cast(s64)input.secondary_down; player.fields[8].value.integer=cast(s64)input.secondary_pressed; player.fields[9].value.integer=cast(s64)input.secondary_released
        player.fields[10].value.integer=cast(s64)input.modifiers; player.fields[11].value.integer=cast(s64)input.key; player.fields[12].value.real=cast(float64)input.wheel
        result.kind=HostRecord; result.type_name=*player.names[26].bytes[0]; result.fields=*player.fields[0]; result.field_count=cast(usize)13; return 1
    }
    if function=="TakeBundleCodepoint" && count==0 {
        result.kind=HostInteger
        if player.typed_at<player.typed_count { result.integer=cast(s64)player.codepoints[player.typed_at]; player.typed_at+=1 }
        else { result.integer=0 }; return 1
    }
    if ModuleName(module,"window") {
        if function=="WindowFocusedHost" {
            if count!=0 { return 0 }
            if player.platform!=null {
                status:=player.platform(player.context,module_name,function_name,args,count,result)
                if status==1 && result.kind==HostInteger { return 1 }
            }
            result.kind=HostInteger; result.integer=0; return 1
        }
        if function=="WindowQuitHost" { player.closed=true; return 1 }
        if function=="WindowBackgroundHost" || function=="WindowBackgroundDragHost" || function=="WindowSetVisibleHost" { return 1 }
        result.kind=HostInteger
        result.integer=ifx function=="WindowTakeCloseRequestHost" then cast(s64)0 else cast(s64)1
        return 1
    }
    if function == "MeasureGlyphWidth" && count == 3 &&
    args[0].kind == HostString && args[1].kind == HostInteger &&
    args[2].kind == HostString {
        result.kind = HostInteger
        result.integer = cast(s64)MeasureGlyphWidth(TextValue(args[0]),
            cast(s32)args[1].integer, TextValue(args[2]))
        return 1
    }
    if function == "MeasureGlyphLineHeight" && count == 2 &&
    args[0].kind == HostInteger && args[1].kind == HostString {
        result.kind = HostInteger
        result.integer = cast(s64)MeasureGlyphLineHeight(
            cast(s32)args[0].integer, TextValue(args[1]))
        return 1
    }
    if (function == "ImageWidth" || function == "ImageHeight") && count == 1 &&
    args[0].kind == HostString {
        result.kind = HostInteger
        if function == "ImageWidth" {
            result.integer = cast(s64)ImageWidth(TextValue(args[0]))
        } else {
            result.integer = cast(s64)ImageHeight(TextValue(args[0]))
        }
        return 1
    }
    if function == "RasterLine" && count == 2 &&
    RectangleValue(args[0]) && ColorValue(args[1]) {
        RasterLine(RectangleFrom(args[0]), ColorFrom(args[1]))
        return 1
    }
    if function == "RasterRoundedRectangle" && count == 4 &&
    RectangleValue(args[0]) && args[1].kind == HostReal &&
    args[2].kind == HostInteger && ColorValue(args[3]) {
        RasterRoundedRectangle(RectangleFrom(args[0]), cast(float32)args[1].real,
            cast(s32)args[2].integer, ColorFrom(args[3]))
        return 1
    }
    if function == "RasterRoundedRectangleOutline" && count == 5 &&
    RectangleValue(args[0]) && args[1].kind == HostReal &&
    args[2].kind == HostInteger && args[3].kind == HostReal && ColorValue(args[4]) {
        RasterRoundedRectangleOutline(RectangleFrom(args[0]), cast(float32)args[1].real,
            cast(s32)args[2].integer, cast(float32)args[3].real, ColorFrom(args[4]))
        return 1
    }
    if (function == "RasterText" && count == 5) ||
    (function == "RasterTextClipped" && count == 6) {
        if args[0].kind != HostString || args[1].kind != HostInteger ||
        args[2].kind != HostInteger || args[3].kind != HostInteger ||
        !ColorValue(args[4]) { return 0 }
        if count == 6 {
            if !RectangleValue(args[5]) { return 0 }
            RasterTextClipped(TextValue(args[0]), cast(s32)args[1].integer,
                cast(s32)args[2].integer, cast(s32)args[3].integer,
                ColorFrom(args[4]), RectangleFrom(args[5]))
        } else {
            RasterText(TextValue(args[0]), cast(s32)args[1].integer,
                cast(s32)args[2].integer, cast(s32)args[3].integer, ColorFrom(args[4]))
        }
        return 1
    }
    if function == "RasterImage" && count == 9 &&
    args[0].kind == HostString && args[1].kind == HostUnsigned &&
    RectangleValue(args[2]) && RectangleValue(args[3]) &&
    RectangleValue(args[4]) && VectorValue(args[5]) &&
    args[6].kind == HostReal && args[7].kind == HostReal && ColorValue(args[8]) {
        RasterImage(TextValue(args[0]), cast(u32)args[1].bits,
            RectangleFrom(args[2]), RectangleFrom(args[3]), RectangleFrom(args[4]),
            VectorFrom(args[5]), cast(float32)args[6].real, cast(float32)args[7].real,
            ColorFrom(args[8]))
        return 1
    }
    if player.platform!=null { return player.platform(player.context,module_name,function_name,args,count,result) }
    return 0
}
#program_export
PlayerClose :: (player: *Player) {
    if player.instance!=null { CloseBundleInstance(player.instance); player.instance=null }
    if player.bundle!=null { CloseBundle(player.bundle); player.bundle=null }
    player.closed=true
    for i: 0..127 { PixmapClearImage(cast(s32)(384+i)) }
}
#program_export
PlayerCheck :: (data: []u8) -> bool {
    if data.count==0 { return false }
    bundle:=OpenBundleBytes(*data[0],cast(u64)data.count)
    if bundle==null { return false }; defer { CloseBundle(bundle) }
    if BundleCapabilities(bundle)>128 || BundleAssets(bundle)>128 { return false }
    i: u64=0
    while i<BundleCapabilities(bundle) {
        if !Supported(TextFromCString(BundleCapabilityModuleName(bundle,i)),TextFromCString(BundleCapabilityFunctionName(bundle,i))) { return false }; i+=1
    }
    return true
}
#program_export
PlayerOpen :: (player: *Player, data: []u8, platform: HostCall, context: *void) -> bool {
    PlayerClose(player); player.closed=false; player.platform=platform; player.context=context
    if data.count==0 { return false }
    player.bundle=OpenBundleBytes(*data[0],cast(u64)data.count)
    if player.bundle==null || BundleCapabilities(player.bundle)>128 || BundleAssets(player.bundle)>128 { PlayerClose(player); return false }
    if !PrepareInput(player) { PlayerClose(player); return false }
    for i: 0..cast(s64)BundleCapabilities(player.bundle)-1 {
        module:=BundleCapabilityModuleName(player.bundle,cast(u64)i); function:=BundleCapabilityFunctionName(player.bundle,cast(u64)i)
        if !Supported(TextFromCString(module),TextFromCString(function)) { PlayerClose(player); return false }
        player.bindings[i]=.{module,function,PlayerCall,cast(*void)player}
    }
    player.instance=InstantiateBundle(player.bundle,*player.bindings[0],BundleCapabilities(player.bundle))
    if player.instance==null { PlayerClose(player); return false }
    LimitBundleSteps(player.instance,10000000); return true
}
#program_export
PlayerTyped :: (player: *Player, codepoint: s32) {
    if codepoint>0 && codepoint<=1114111 && player.typed_count<256 { player.codepoints[player.typed_count]=codepoint; player.typed_count+=1 }
}
#program_export
PlayerFrame :: (player: *Player, input: Input, width: s32, height: s32, pixels: []u32) -> bool {
    if player.instance==null || player.closed || input.width<=0 || input.height<=0 { return false }
    if !PixmapScale(cast(float32)width/cast(float32)input.width,cast(float32)height/cast(float32)input.height) || !PixmapBeginInto(4279242768,width,height,pixels,true) { return false }
    player.input=input; player.typed_at=0
    result: s64; has_result: s32
    ok:=RunBundleInstance(player.instance,*result,*has_result)!=0 && (has_result==0 || result==0)
    player.typed_count=0; PixmapEndInto()
    if !ok { player.closed=true }; return ok
}
