using HostValueKind;
using FrameStatus;

// Image sizes for native builds; the photo is 40 px square.
#program_export
ImageWidth :: (asset_path: string) -> s32 {
    unused asset_path
    return 40
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    unused asset_path
    return 40
}

// A bundle may draw its own photo and nothing else.
asset_checks: s32;
AllowPhoto :: (path: string) -> bool {
    asset_checks += 1
    return path == "" || path == "assets/photo.png"
}

resolved_owner: s32;
resolve_checks: s32;
ResolvePhoto :: (path: string) -> string {
    resolve_checks += 1
    if path != "assets/photo.png" { return "" }
    if resolved_owner == 1 { return "apps/owner-a/assets/photo.png" }
    if resolved_owner == 2 { return "apps/owner-b/assets/photo.png" }
    return ""
}

PaintHasAsset :: (session: Session, path: string) -> bool {
    for index: cast(s32)0..PendingPaintCount(session) - 1 {
        if PendingPaintAt(session, index).asset_path == path { return true }
    }
    return false
}

module_name: [64]u8;
function_name: [64]u8;
session_codec: WidgetSessionCodec;
text_codec: WidgetTextPropsCodec;
image_codec: WidgetImagePropsCodec;
button_codec: WidgetButtonPropsCodec;
scroll_codec: WidgetScrollPropsCodec;
area_codec: WidgetTextAreaPropsCodec;
area_decoded: WidgetTextAreaPropsCodec;
tab_bar_codec: WidgetTabBarPropsCodec;
press_codec: WidgetPressPropsCodec;
spinbox_codec: WidgetSpinboxPropsCodec;
spinbox_result: WidgetSpinboxStepResultCodec;
time_picker_codec: WidgetTimePickerPropsCodec;
svg_icon_codec: WidgetSvgIconPropsCodec;
time_picker_result: WidgetTimePickerResultCodec;
tab_codecs: [40]WidgetTabCodec;
tab_values: [40]HostValue;
title_bar_codec: WidgetTitleBarPropsCodec;
dropdown_codec: WidgetDropdownPropsCodec;
dropdown_result: WidgetDropdownResultCodec;
title_bar_result: WidgetTitleBarResultCodec;
modal_codec: WidgetModalFramePropsCodec;
modal_result: WidgetModalFrameResultCodec;
action_modal_codec: WidgetActionModalPropsCodec;
action_modal_result: WidgetActionModalResultCodec;
action_codec: WidgetActionModalActionCodec;
option_codecs: [40]WidgetDropdownOptionCodec;
option_values: [40]HostValue;
menu_codec: WidgetContextMenuPropsCodec;
menu_item_codecs: [3]WidgetContextMenuItemCodec;
menu_values: [3]HostValue;
menu_result_codec: WidgetContextMenuResultCodec;
tile_map_codec: WidgetTileMapPropsCodec;
tile_map_result_codec: WidgetTileMapResultCodec;

// The paint a frame queued, to compare a hosted map with one drawn directly.
TileMapPaint :: struct { kind: s32; bounds: Rectangle; color: Color; asset: [64]u8; smooth: bool }
tile_map_paint: [32]TileMapPaint;

TileMapPaintTake :: (session: Session) -> s32 {
    count := PendingPaintCount(session)
    if count > 32 { return -1 }
    for index: cast(s32)0..count - 1 {
        paint := PendingPaintAt(session, index)
        tile_map_paint[index] = .{.kind = paint.kind, .bounds = paint.bounds, .color = paint.color, .smooth = paint.smooth}
        unused CopyCString(paint.asset_path, tile_map_paint[index].asset[:])
    }
    return count
}

TileMapPaintSame :: (session: Session, count: s32) -> bool {
    if PendingPaintCount(session) != count { return false }
    for index: cast(s32)0..count - 1 {
        paint := PendingPaintAt(session, index)
        kept := tile_map_paint[index]
        if paint.kind != kept.kind || paint.bounds.x != kept.bounds.x || paint.bounds.y != kept.bounds.y ||
        paint.bounds.width != kept.bounds.width || paint.bounds.height != kept.bounds.height ||
        paint.color.r != kept.color.r || paint.color.g != kept.color.g || paint.color.b != kept.color.b ||
        paint.color.a != kept.color.a || paint.smooth != kept.smooth || paint.asset_path != TextFromCString(*tile_map_paint[index].asset[0]) { return false }
    }
    return true
}

// Calls the host as a bundle does: arguments as values, names as C text.
Call :: (module: string, function: string, arguments: []HostValue, result: *HostValue) -> s32 {
    unused CopyCString(module, module_name[:])
    unused CopyCString(function, function_name[:])
    data: *HostValue = null
    if arguments.count > 0 {
        data = *arguments[0]
    }
    return WidgetHostCall(null, *module_name[0], *function_name[0], data,
        cast(s32)arguments.count, result)
}

#program_export
main :: () -> s32 {
    if !WidgetHostSupports("modal_widget", "ActionModalHostedHost") { return 40 }
    if !WidgetHostSupports("toggle_widget", "ToggleHostedHost") ||
    !WidgetHostSupports("press_widget", "PressHostedHost") ||
    !WidgetHostSupports("spinbox_widget", "SpinboxHostedHost") ||
    !WidgetHostSupports("time_picker_widget", "TimePickerHostedHost") ||
    !WidgetHostSupports("title_bar_widget", "TitleBarHostedHost") ||
    !WidgetHostSupports("dropdown_widget", "DropdownHostedHost") ||
    !WidgetHostSupports("modal_frame_widget", "ModalFrameHostedHost") ||
    !WidgetHostSupports("tree", "EndHostedHost") ||
    !WidgetHostSupports("svg_icon_widget", "SvgIconHostedHost") ||
    WidgetHostSupports("text_widget", "TextNativeHost") {
        return 1
    }
    GlyphMetricsChanged()
    session := SessionOpen()
    result: HostValue
    arguments: [3]HostValue
    arguments[0] = WidgetEncodeSession(session, *session_codec)
    arguments[1] = WidgetEncodeTextProps(TextProps.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *text_codec)
    // Outside a bundle frame nothing draws.
    if Call("pointer_input", "PollPointer", arguments[:0], *result) != 0 {
        return 101
    }
    if Call("text_widget", "TextHostedHost", arguments[:2], *result) != 0 {
        return 2
    }
    unused TreePointerUpdate(session, PointerFrame.{.x = 13.0, .y = 21.0, .pressed = true})
    other_pointer_session := SessionOpen()
    unused TreePointerUpdate(other_pointer_session, PointerFrame.{.x = 99.0, .y = 100.0})
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 200.0})
    WidgetHostBegin(session, AllowPhoto)
    if !WidgetHostSupports("pointer_input", "PollPointer") ||
    Call("pointer_input", "PollPointer", arguments[:0], *result) != 1 ||
    !WidgetValidPointerFrame(result) {
        return 102
    }
    pointer_codec: WidgetPointerFrameCodec
    pointer := WidgetDecodePointerFrame(result, *pointer_codec)
    if pointer.x != 13.0 || pointer.y != 21.0 || !pointer.pressed ||
    Call("pointer_input", "PollPointer", arguments[:1], *result) != 0 {
        return 103
    }
    unused SessionClose(other_pointer_session)
    if Call("p0123456789abcdef_text_widget", "TextHostedHost", arguments[:2], *result) != 1 {
        return 3
    }
    // Another frame's session, a missing argument or the wrong record is refused.
    stale := session
    stale.epoch += cast(u64)1
    stale_codec: WidgetSessionCodec
    stale_arguments: [2]HostValue = .[WidgetEncodeSession(stale, *stale_codec), arguments[1]]
    if Call("text_widget", "TextHostedHost", stale_arguments[:], *result) != 0 ||
    Call("text_widget", "TextHostedHost", arguments[:1], *result) != 0 ||
    Call("image_widget", "ImageHostedHost", arguments[:2], *result) != 0 ||
    Call("text_widget", "TextUnknownHost", arguments[:2], *result) != 0 ||
    Call("unrelated_text_widget", "TextHostedHost", arguments[:2], *result) != 0 ||
    Call("p0123456789abcdeg_text_widget", "TextHostedHost", arguments[:2], *result) != 0 {
        return 4
    }
    // Fields match by name: a record from an older layout that lists only
    // its text, in another position, still draws.
    older := arguments[1]
    older.fields = *text_codec.fields[2]
    older.field_count = cast(usize)1
    older_arguments: [2]HostValue = .[arguments[0], older]
    if HostFieldAt(older, 0, "text") != 0 || Call("text_widget", "TextHostedHost", older_arguments[:], *result) != 1 {
        return 5
    }
    // A portable Text's links cross with it, and the host answers which one
    // is under a point; a point that is not a pair of float32 is refused.
    if !WidgetHostSupports("p0123456789abcdef_text_widget", "TextLinkAtHostedHost") { return 90 }
    link_ranges: [1]TextRange = .[TextRange.{0, 6}]
    link_codec: WidgetTextPropsCodec
    link_arguments: [4]HostValue
    link_arguments[0] = arguments[0]
    link_arguments[1] = WidgetEncodeTextProps(TextProps.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}, .links = link_ranges[:]}, *link_codec)
    link_arguments[2] = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = 2.0}
    link_arguments[3] = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = 90.0}
    linked_props := WidgetHostTextProps(link_arguments[1])
    if linked_props.links.count != 1 || linked_props.links[0].start != 0 || linked_props.links[0].end != 6 {
        return 91
    }
    if Call("text_widget", "TextLinkAtHostedHost", link_arguments[:], *result) != 1 ||
    result.integer != -1 || TextFromCString(result.type_name) != "s32" {
        return 92
    }
    link_arguments[3] = HostScalar("s32", 5)
    if Call("text_widget", "TextLinkAtHostedHost", link_arguments[:], *result) != 0 ||
    Call("text_widget", "TextLinkAtHostedHost", link_arguments[:3], *result) != 0 {
        return 93
    }
    // A portable app measures a line of text with the host's own fonts, to
    // place controls beside it.
    if !WidgetHostSupports("p0123456789abcdef_text_measure", "TextWidthHostedHost") { return 94 }
    width_codec: WidgetTextPropsCodec
    width_arguments: [2]HostValue = .[arguments[0], WidgetEncodeTextProps(TextProps.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *width_codec)]
    if Call("text_measure", "TextWidthHostedHost", width_arguments[:], *result) != 1 ||
    TextFromCString(result.type_name) != "s32" || result.integer <= 0 {
        return 95
    }
    short_width := result.integer
    width_arguments[1] = WidgetEncodeTextProps(TextProps.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *width_codec)
    if Call("text_measure", "TextWidthHostedHost", width_arguments[:], *result) != 1 ||
    result.integer <= short_width {
        return 96
    }
    // And the height a paragraph takes, wrapped as Text wraps it by
    // default: a narrow one takes more lines.
    if !WidgetHostSupports("text_measure", "TextHeightHostedHost") { return 97 }
    width_arguments[1] = WidgetEncodeTextProps(TextProps.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, 400.0, 0.0}}, *width_codec)
    if Call("text_measure", "TextHeightHostedHost", width_arguments[:], *result) != 1 ||
    TextFromCString(result.type_name) != "s32" || result.integer <= 0 {
        return 98
    }
    one_line := result.integer
    width_arguments[1] = WidgetEncodeTextProps(TextProps.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, cast(float32)short_width, 0.0}}, *width_codec)
    if Call("text_measure", "TextHeightHostedHost", width_arguments[:], *result) != 1 ||
    result.integer <= one_line {
        return 99
    }
    // Assets pass the host's policy; texture handles never cross.
    arguments[1] = WidgetEncodeImageProps(ImageProps.{.asset_path = "assets/photo.png",
            .bounds = Rectangle.{0.0, 20.0, 40.0, 40.0}}, *image_codec)
    if Call("kryon_image_widget", "ImageHostedHost", arguments[:2], *result) != 1 {
        return 6
    }
    // A warped image's grid crosses with it.
    meshed := ImageProps.{.asset_path = "assets/photo.png",
        .bounds = Rectangle.{0.0, 20.0, 40.0, 40.0}}
    mesh_points: [4]Vector2 = .[Vector2.{0.0, 20.0}, Vector2.{30.0, 20.0},
    Vector2.{0.0, 60.0}, Vector2.{30.0, 55.0}]
    meshed.mesh.columns = 2
    meshed.mesh.rows = 2
    meshed.mesh.points = mesh_points[:]
    before := PendingPaintCount(session)
    arguments[1] = WidgetEncodeImageProps(meshed, *image_codec)
    // A bundle sends the points; image codecs keep no room for them, so
    // they are attached here as the bundle's values would be.
    point_values: [4]HostValue
    point_codecs: [4]WidgetVector2Codec
    for index: cast(s32)0..3 {
        point_values[index] = WidgetEncodeVector2(mesh_points[index], *point_codecs[index])
    }
    mesh_at := HostFieldAt(arguments[1], 12, "mesh")
    points_at := HostFieldAt(arguments[1].fields[mesh_at].value, 2, "points")
    if mesh_at < 0 || points_at < 0 || arguments[1].fields[mesh_at].value.fields[points_at].value.length != cast(usize)0 {
        return 42
    }
    arguments[1].fields[mesh_at].value.fields[points_at].value.length = cast(usize)4
    arguments[1].fields[mesh_at].value.fields[points_at].value.elements = *point_values[0]
    if Call("image_widget", "ImageHostedHost", arguments[:2], *result) != 1 {
        return 40
    }
    queued := PendingPaintAt(session, PendingPaintCount(session) - 1)
    if PendingPaintCount(session) != before + 1 || queued.mesh_columns != 2 ||
    queued.mesh_rows != 2 || queued.mesh_points.count != 4 ||
    queued.mesh_points[3].x != 30.0 || queued.mesh_points[3].y != 55.0 {
        return 41
    }
    arguments[1] = WidgetEncodeImageProps(ImageProps.{.asset_path = "private/key.png"}, *image_codec)
    if Call("image_widget", "ImageHostedHost", arguments[:2], *result) != 0 {
        return 7
    }
    texture := ImageProps.{.asset_path = "assets/photo.png"}
    texture.texture.id = cast(u32)3
    arguments[1] = WidgetEncodeImageProps(texture, *image_codec)
    checks := asset_checks
    if Call("image_widget", "ImageHostedHost", arguments[:2], *result) != 0 || asset_checks != checks {
        return 8
    }
    arguments[1] = WidgetEncodeButtonProps(ButtonProps.{.id = 9, .label = "Save",
            .bounds = Rectangle.{0.0, 60.0, 80.0, 30.0}}, *button_codec)
    if Call("button_widget", "ButtonHostedHost", arguments[:2], *result) != 1 ||
    result.kind != cast(s32)HostInteger || TextFromCString(result.type_name) != "s32" || result.integer != 0 {
        return 9
    }
    // A press area answers with its press state.
    arguments[1] = WidgetEncodePressProps(PressProps.{.id = 12, .label = "Message",
            .bounds = Rectangle.{0.0, 100.0, 200.0, 40.0}, .now = 1.0}, *press_codec)
    if Call("press_widget", "PressHostedHost", arguments[:2], *result) != 1 ||
    result.kind != cast(s32)HostRecord || TextFromCString(result.type_name) != "PressResult" {
        return 30
    }
    // A spinbox answers with its value, kept within its range.
    arguments[1] = WidgetEncodeSpinboxProps(SpinboxProps.{.id = 13, .label = "Length",
            .bounds = Rectangle.{0.0, 140.0, 150.0, 38.0}, .min = 5, .max = 35, .step = 1,
            .value = 16}, *spinbox_codec)
    if Call("spinbox_widget", "SpinboxHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "SpinboxStepResult" ||
    WidgetDecodeSpinboxStepResult(result, *spinbox_result).value != 16 {
        return 31
    }
    // A time picker answers with its time, clamped to the day.
    arguments[1] = WidgetEncodeTimePickerProps(TimePickerProps.{.id = 14, .label = "Start",
            .bounds = Rectangle.{0.0, 180.0, 150.0, 36.0}, .value = 2000, .now = -1}, *time_picker_codec)
    if Call("time_picker_widget", "TimePickerHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "TimePickerResult" ||
    WidgetDecodeTimePickerResult(result, *time_picker_result).value != 1439 ||
    WidgetDecodeTimePickerResult(result, *time_picker_result).changed {
        return 32
    }
    // A vector icon on its own paints its cells and answers nothing.
    icon_before := PendingPaintCount(session)
    icon: SvgIconProps
    icon.bounds = Rectangle.{160.0, 180.0, 24.0, 24.0}
    icon.shape = "F:M4 4H20L12 20Z"
    icon.color = Color.{0, 0, 0, 255}
    arguments[1] = WidgetEncodeSvgIconProps(icon, *svg_icon_codec)
    if Call("svg_icon_widget", "SvgIconHostedHost", arguments[:2], *result) != 1 ||
    PendingPaintCount(session) <= icon_before {
        return 66
    }
    // Slices decode into the codec and are attached by name.
    hidden: [2]TextRange = .[TextRange.{.start = 0, .end = 2}, TextRange.{.start = 6, .end = 8}]
    encoded := WidgetEncodeTextAreaProps(TextAreaProps.{.value = "**bold**", .hidden = hidden[:]}, *area_codec)
    decoded := WidgetDecodeTextAreaProps(encoded, *area_decoded)
    if HostSliceLength(encoded, 25, "hidden") != 2 || decoded.value != "**bold**" ||
    area_decoded.hidden_decoded[1].start != 6 || area_decoded.hidden_decoded[1].end != 8 {
        return 10
    }
    // A tab bar holds at most 32 tabs.
    tabs: [40]Tab
    index: s32 = 0
    while index < 40 {
        tab_values[index] = WidgetEncodeTab(tabs[index], *tab_codecs[index])
        index += 1
    }
    arguments[1] = WidgetEncodeTabBarProps(TabBarProps.{}, *tab_bar_codec)
    arguments[2] = HostValue.{.kind = cast(s32)HostSlice, .type_name = HostTextData("[]Tab"),
        .length = cast(usize)33, .elements = *tab_values[0]}
    if Call("tab_bar_widget", "TabBarHostedHost", arguments[:], *result) != 0 {
        return 11
    }
    // A title bar answers with where the bundle draws its own controls;
    // more than 32 options or a texture handle is refused.
    options: [40]DropdownOption
    index = 0
    while index < 40 {
        options[index].label = "Option"
        option_values[index] = WidgetEncodeDropdownOption(options[index], *option_codecs[index])
        index += 1
    }
    arguments[1] = WidgetEncodeDropdownProps(DropdownProps.{.key = cast(u64)315,
            .bounds = Rectangle.{0.0, 0.0, 200.0, 40.0}, .selected_index = 1}, *dropdown_codec)
    arguments[2] = HostValue.{.kind = cast(s32)HostSlice, .type_name = HostTextData("[]DropdownOption"),
        .length = cast(usize)2, .elements = *option_values[0]}
    if Call("dropdown_widget", "DropdownHostedHost", arguments[:], *result) != 1 ||
    !WidgetValidDropdownResult(result) || WidgetDecodeDropdownResult(result, *dropdown_result).selected_index != 1 {
        return 72
    }
    arguments[2].length = cast(usize)33
    if Call("dropdown_widget", "DropdownHostedHost", arguments[:], *result) != 0 { return 73 }
    arguments[2].length = cast(usize)1
    arguments[2].elements = null
    if Call("dropdown_widget", "DropdownHostedHost", arguments[:], *result) != 0 { return 74 }
    options[0].image.texture.id = cast(u32)4
    option_values[0] = WidgetEncodeDropdownOption(options[0], *option_codecs[0])
    arguments[2].elements = *option_values[0]
    if Call("dropdown_widget", "DropdownHostedHost", arguments[:], *result) != 0 { return 75 }
    options[0].image.texture.id = cast(u32)0
    option_values[0] = WidgetEncodeDropdownOption(options[0], *option_codecs[0])
    arguments[1] = WidgetEncodeTitleBarProps(TitleBarProps.{.key = cast(u64)15, .title = "Lumi",
            .bounds = Rectangle.{0.0, 0.0, 300.0, 40.0}, .trailing_width = 100}, *title_bar_codec)
    arguments[2] = HostValue.{.kind = cast(s32)HostSlice, .type_name = HostTextData("[]DropdownOption"),
        .length = cast(usize)0, .elements = *option_values[0]}
    if Call("title_bar_widget", "TitleBarHostedHost", arguments[:], *result) != 1 ||
    TextFromCString(result.type_name) != "TitleBarResult" ||
    WidgetDecodeTitleBarResult(result, *title_bar_result).trailing_bounds.x != 188.0 ||
    WidgetDecodeTitleBarResult(result, *title_bar_result).trailing_bounds.width != 100.0 {
        return 33
    }
    arguments[2].length = cast(usize)33
    if Call("title_bar_widget", "TitleBarHostedHost", arguments[:], *result) != 0 {
        return 34
    }
    textured := TitleBarProps.{.title = "Lumi", .has_leading_action = true}
    textured.leading_image.texture.id = cast(u32)4
    arguments[1] = WidgetEncodeTitleBarProps(textured, *title_bar_codec)
    arguments[2].length = cast(usize)0
    if Call("title_bar_widget", "TitleBarHostedHost", arguments[:], *result) != 0 {
        return 35
    }
    // A dialog opens its panel for the bundle's content, which the bundle
    // Ends; a runtime texture on its actions is refused.
    arguments[1] = WidgetEncodeModalFrameProps(ModalFrameProps.{.key = cast(u64)16,
            .title = "Share", .width = 200, .height = 120, .has_right_action = true}, *modal_codec)
    if Call("modal_frame_widget", "ModalFrameHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "ModalFrameResult" ||
    !WidgetDecodeModalFrameResult(result, *modal_result).opened ||
    WidgetDecodeModalFrameResult(result, *modal_result).layout.panel.width != 200.0 {
        return 36
    }
    if Call("tree", "EndHostedHost", arguments[:1], *result) != 1 {
        return 37
    }
    dialog := ModalFrameProps.{.title = "Share", .has_right_action = true}
    dialog.right_image.texture.id = cast(u32)4
    arguments[1] = WidgetEncodeModalFrameProps(dialog, *modal_codec)
    if Call("modal_frame_widget", "ModalFrameHostedHost", arguments[:2], *result) != 0 {
        return 38
    }
    // Nothing is open to end yet; a scroll the bundle leaves open is closed
    // by the host, so the frame still balances.
    if Call("tree", "EndHostedHost", arguments[:1], *result) != 0 {
        return 12
    }
    arguments[1] = WidgetEncodeScrollProps(ScrollProps.{.key = cast(u64)7,
            .bounds = Rectangle.{0.0, 100.0, 200.0, 80.0}, .content_height = 400}, *scroll_codec)
    if Call("scroll_widget", "ScrollHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "ScrollResult" {
        return 13
    }
    // Action dialogs validate the entire action list before drawing it.
    arguments[1] = WidgetEncodeActionModalProps(ActionModalProps.{.key = cast(u64)17,
            .title = "Keep changes?", .message = "Your draft stays here."}, *action_modal_codec)
    action_values: [1]HostValue
    action_values[0] = WidgetEncodeActionModalAction(ActionModalAction.{.label = "Keep editing"}, *action_codec)
    arguments[2] = HostValue.{.kind = cast(s32)HostSlice,
        .type_name = HostTextData("[]ActionModalAction"), .length = cast(usize)1,
        .elements = *action_values[0]}
    if Call("modal_widget", "ActionModalHostedHost", arguments[:], *result) != 1 ||
    !WidgetValidActionModalResult(result) ||
    WidgetDecodeActionModalResult(result, *action_modal_result).action != 0 {
        return 41
    }
    arguments[2].length = cast(usize)17
    if Call("modal_widget", "ActionModalHostedHost", arguments[:], *result) != 0 {
        return 42
    }
    arguments[2].length = cast(usize)1
    action_values[0] = HostScalar("s32", 1)
    if Call("modal_widget", "ActionModalHostedHost", arguments[:], *result) != 0 {
        return 43
