#import "session"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "separator"
#import "separator_props"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "widget_kind"

SeparatorFaces :: struct {
    line: StyleFrame
    label: StyleFrame
    scale: float32
    fallback_font: s32
}

#program_export
DefaultSeparatorFaces :: () -> SeparatorFaces {
    faces: SeparatorFaces
    faces.line.value.fields = cast(u32)StyleBackground
    faces.line.value.background = cast(u32)0x66645fff
    faces.label.value.fields = cast(u32)StyleForeground |
        cast(u32)StyleFontSize | cast(u32)StyleGap
    faces.label.value.foreground = cast(u32)0x171717ff
    faces.label.value.font_size = 14.0
    faces.label.value.gap = 12.0
    faces.scale = 1.0
    faces.fallback_font = 14
    return faces
}

#program_export
SeparatorFacts :: (props: SeparatorProps, role: s32,
    state: s32) -> StyleFacts {
    return StyleControlRoleFacts(StyleKindSeparator(), 0,
        props.class_name, role, cast(s32)ButtonToneNeutral,
        cast(s32)ButtonEmphasisFilled, cast(s32)ControlSizeMedium, state)
}

#program_export
SeparatorFacesFor :: (rules: StyleRules, props: SeparatorProps,
    defaults: SeparatorFaces) -> SeparatorFaces {
    faces: SeparatorFaces = defaults
    state: s32 = cast(s32)ButtonStateNormal
    if props.disabled { state = cast(s32)ButtonStateDisabled }
    faces.line.value = ResolveStyleRules(rules, defaults.line.value,
        SeparatorFacts(props, SeparatorLineRole(), state), state)
    faces.label.value = ResolveStyleRules(rules, defaults.label.value,
        SeparatorFacts(props, SeparatorLabelRole(), state), state)
    return faces
}

PreparedSeparator :: struct {
    line: Rectangle
    text: Rectangle
    line_color: u32
    text_color: u32
    font: s32
    show_text: bool
    show_line: bool
}

#program_export
PrepareSeparator :: (props: SeparatorProps,
    faces: SeparatorFaces) -> PreparedSeparator {
    prepared: PreparedSeparator
    prepared.font = ResolveFont(0,
        StyleFontValue(faces.label.value.fields,
            faces.label.value.font_size), faces.fallback_font)
    prepared.line_color = faces.line.value.background
    if props.label == "" {
        plain: SeparatorLine = SeparatorLineFor(props.bounds,
            props.vertical, faces.line)
        prepared.line = plain.line
        prepared.show_line = true
        return prepared
    }
    width: s32 = GlyphWidth(props.label, prepared.font,
        faces.label.value.typeface)
    paint: SeparatorLabelPaint = SeparatorLabelPaintFor(props.bounds,
        cast(float32)width, true, prepared.font, faces.scale,
        faces.label)
    prepared.line = paint.line
    prepared.text = paint.text
    prepared.show_line = paint.show_line
    prepared.show_text = paint.show_text
    prepared.text_color = Opacity(paint.text_color,
        StyleOpacityValue(faces.label.value.fields,
            faces.label.value.opacity))
    return prepared
}

#program_export
PaintSeparatorForNode :: (session: Session, node: s32, props: SeparatorProps,
    faces: SeparatorFaces) {
    prepared: PreparedSeparator = PrepareSeparator(props, faces)
    if prepared.show_text {
        PaintLabel(session, node, props.label, cast(s32)prepared.text.x,
            cast(s32)prepared.text.y, prepared.font,
            ColorFromPacked(prepared.text_color))
    }
    if prepared.show_line {
        PaintLine(session, node, prepared.line,
            ColorFromPacked(prepared.line_color))
    }
}

#program_export
PaintSeparatorProps :: (session: Session, props: SeparatorProps,
    faces: SeparatorFaces) {
    PaintSeparatorForNode(session, -1, props, faces)
}

#program_export
PaintSeparatorFromRules :: (session: Session, props: SeparatorProps, rules: StyleRules,
    defaults: SeparatorFaces) {
    PaintSeparatorProps(session, props, SeparatorFacesFor(rules, props, defaults))
}

#program_export
Separator :: (session: Session, props: SeparatorProps) {
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, props.key, WidgetKindSeparator, props.bounds)
        if node < 0 { return }
    }
    faces: SeparatorFaces = SeparatorFacesFor(ActiveStyleRules(),
        props, DefaultSeparatorFaces())
    PaintSeparatorForNode(session, node, props, faces)
}

#program_export
Bullet :: (session: Session, bounds: Rectangle) {
    defaults: StyleData
    defaults.fields = cast(u32)StyleForeground
    defaults.foreground = cast(u32)0x171717ff
    facts: StyleFacts = StyleControlRoleFacts(StyleKindSeparator(),
        0, 0, SeparatorBulletRole(), cast(s32)ButtonToneNeutral,
        cast(s32)ButtonEmphasisFilled, cast(s32)ControlSizeMedium,
        cast(s32)ButtonStateNormal)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), defaults,
        facts, cast(s32)ButtonStateNormal)
    paint: BulletPaint = BulletPaintFor(bounds, frame)
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, TreeNextKey(session), WidgetKindBullet, bounds)
        if node < 0 { return }
    }
    PaintRoundedFill(session, node, paint.bounds, 0.5, 32,
        ColorFromPacked(Opacity(paint.color,
            StyleOpacityValue(frame.value.fields, frame.value.opacity))))
}
