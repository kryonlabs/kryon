#import "kss_parser"

// The KSS formatter lives here once and lowers to C, Go, and JavaScript with
// the shared transpilers. Formatting is structural re-layout: the shared
// parser supplies every construct's span, and construct text is copied
// verbatim so the output is semantically identical to the input - only
// indentation, line breaks, and blank-line placement change. Comments inside
// constructs travel with them; comments between constructs are preserved as
// their own constructs.

// Output is segment-based so .kry needs no allocator: hosts stitch kind 0
// (copy source[start..start+length]), kind 1 (emit the single atom byte), and
// kind 2 (emit a newline followed by `length` spaces).

KssFormatSegment :: struct {
    kind: s32
    start: s32
    length: s32
    atom: u8
}

KssFormatResult :: struct {
    ok: bool
    segments: [1024]KssFormatSegment
    count: s32
    diagnostic: [128]u8
    diagnostic_length: s32
}

// Construct kinds: 1 tokens, 2 theme, 3 env, 4 variant, 5 directive, 6 rule,
// 7 foreign block, 8 comment. Mirrors the parser's block kinds.

KssFormatConstruct :: struct {
    kind: s32
    start: s32
    end: s32
}

KssFormatState :: struct {
    source: string
    result: KssFormatResult
    constructs: [192]KssFormatConstruct
    construct_count: s32
}

KssFormatFail :: (state: KssFormatState, text: string) -> KssFormatState {
    index: s32 = 0
    state.result.ok = false
    state.result.diagnostic_length = 0
    index = 0
    while index < 128 && index < (cast(s32)text.count) {
        state.result.diagnostic[index] = text[index]
        state.result.diagnostic_length = index + 1
        index = index + 1
    }
    return state
}

KssFormatEmitCopy :: (state: KssFormatState, start: s32, length: s32) -> KssFormatState {
    if length <= 0 {
        return state
    }
    if state.result.count >= 1024 {
        return KssFormatFail(state, "format segment capacity exceeded")
    }
    state.result.segments[state.result.count].kind = 0
    state.result.segments[state.result.count].start = start
    state.result.segments[state.result.count].length = length
    state.result.segments[state.result.count].atom = 0
    state.result.count = state.result.count + 1
    return state
}

KssFormatEmitAtom :: (state: KssFormatState, atom: u8) -> KssFormatState {
    if state.result.count >= 1024 {
        return KssFormatFail(state, "format segment capacity exceeded")
    }
    state.result.segments[state.result.count].kind = 1
    state.result.segments[state.result.count].start = 0
    state.result.segments[state.result.count].length = 0
    state.result.segments[state.result.count].atom = atom
    state.result.count = state.result.count + 1
    return state
}

KssFormatEmitIndent :: (state: KssFormatState, spaces: s32) -> KssFormatState {
    if state.result.count >= 1024 {
        return KssFormatFail(state, "format segment capacity exceeded")
    }
    if spaces > 128 {
        spaces = 128
    }
    state.result.segments[state.result.count].kind = 2
    state.result.segments[state.result.count].start = 0
    state.result.segments[state.result.count].length = spaces
    state.result.segments[state.result.count].atom = 0
    state.result.count = state.result.count + 1
    return state
}

KssFormatAddConstruct :: (state: KssFormatState, kind: s32, start: s32, end: s32) -> KssFormatState {
    if end <= start {
        return state
    }
    if state.construct_count >= 192 {
        return KssFormatFail(state, "format construct capacity exceeded")
    }
    state.constructs[state.construct_count].kind = kind
    state.constructs[state.construct_count].start = start
    state.constructs[state.construct_count].end = end
    state.construct_count = state.construct_count + 1
    return state
}

// Collect every construct by running the shared parser in declarative mode.
// Imports resolve to empty modules: formatting re-layouts one file's text and
// never follows imports.

KssFormatCollect :: (state: KssFormatState) -> KssFormatState {
    env: KssEnvironment = KssDefaultEnvironment()
    p: KssParser = KssBeginDeclarative(state.source, "", env)
    running: bool = true
    while running {
        if p.status == cast(s32)KssStatusRule {
            end: s32 = p.rule_span.end
            if end <= p.rule_span.selector_start {
                end = p.rule_span.body_start + p.rule_span.body_length
            }
            state = KssFormatAddConstruct(state, 6, p.rule_span.selector_start, end)
            p.status = cast(s32)KssStatusContinue
            continue
        }
        if p.status != cast(s32)KssStatusContinue {
            break
        }
        p = KssStep(p)
        if p.status == cast(s32)KssStatusNeedImport {
            // Formatting re-layouts one file; imports resolve to empty modules
            // and the resolved name is irrelevant to the layout.
            p = KssProvideImport(p, "", "import")
        }
    }
    if p.status != cast(s32)KssStatusDone {
        return KssFormatFail(state, "style sheet did not parse")
    }
    index: s32 = 0
    while index < p.block_count {
        state = KssFormatAddConstruct(state, p.blocks[index].kind,
            p.blocks[index].start,
            p.blocks[index].start + p.blocks[index].length)
        index = index + 1
    }
    index = 0
    while index < p.foreign_count {
        end: s32 = p.foreign[index].body_start + p.foreign[index].body_length
        state = KssFormatAddConstruct(state, 7, p.foreign[index].query_start, end)
        index = index + 1
    }
    return state
}

// Comments between constructs are preserved as standalone constructs.

KssFormatScanGaps :: (state: KssFormatState) -> KssFormatState {
    cursor: s32 = 0
    index: s32 = 0
    while index < state.construct_count {
        start: s32 = state.constructs[index].start
        state = KssFormatScanRange(state, cursor, start)
        cursor = state.constructs[index].end
        index = index + 1
    }
    state = KssFormatScanRange(state, cursor, (cast(s32)state.source.count))
    return state
}

KssFormatScanRange :: (state: KssFormatState, from: s32, to: s32) -> KssFormatState {
    cursor: s32 = from
    while cursor < to {
        byte: u8 = 0
        if cursor < (cast(s32)state.source.count) {
            byte = state.source[cursor]
        }
        if byte == 47 && cursor + 1 < to && cursor + 1 < (cast(s32)state.source.count) {
            next: u8 = state.source[cursor + 1]
            if next == 47 {
                end: s32 = cursor
                while end < (cast(s32)state.source.count) && state.source[end] != 10 {
                    end = end + 1
                }
                state = KssFormatAddConstruct(state, 8, cursor, end)
                cursor = end
                continue
            }
            if next == 42 {
                end: s32 = cursor + 2
                while end + 1 < (cast(s32)state.source.count) {
                    if state.source[end] == 42 && state.source[end + 1] == 47 {
                        end = end + 2
                        break
                    }
                    end = end + 1
                }
                state = KssFormatAddConstruct(state, 8, cursor, end)
                cursor = end
                continue
            }
        }
        cursor = cursor + 1
    }
    return state
}

// Sort constructs by start (insertion sort; sheets are small).

KssFormatSortConstructs :: (state: KssFormatState) -> KssFormatState {
    index: s32 = 1
    while index < state.construct_count {
        candidate: KssFormatConstruct = state.constructs[index]
        scan: s32 = index - 1
        while scan >= 0 && state.constructs[scan].start > candidate.start {
            state.constructs[scan + 1] = state.constructs[scan]
            scan = scan - 1
        }
        state.constructs[scan + 1] = candidate
        index = index + 1
    }
    return state
}

// Rules inside container blocks (env, variant) are covered by the block's own
// span; drop them so their text is not emitted twice.

KssFormatDropNested :: (state: KssFormatState) -> KssFormatState {
    kept: s32 = 0
    index: s32 = 0
    while index < state.construct_count {
        candidate: KssFormatConstruct = state.constructs[index]
        nested: bool = false
        scan: s32 = 0
        while scan < state.construct_count {
            other: KssFormatConstruct = state.constructs[scan]
            if scan != index && other.kind != 6 && other.kind != 8 {
                if candidate.start >= other.start && candidate.end <= other.end {
                    nested = true
                    break
                }
            }
            scan = scan + 1
        }
        if !nested {
            state.constructs[kept] = candidate
            kept = kept + 1
        }
        index = index + 1
    }
    state.construct_count = kept
    return state
}

// Emit one construct with its lines re-indented by brace depth. Construct
// text is copied verbatim per line; only leading whitespace is dropped unless a
// single-line declaration block can be reflowed structurally.

KssFormatTrimStart :: (state: KssFormatState, start: s32, end: s32) -> s32 {
    pos: s32 = start
    while pos < end {
        byte: u8 = state.source[pos]
        if byte == 32 || byte == 9 || byte == 13 {
            pos = pos + 1
        } else {
            break
        }
    }
    return pos
}

KssFormatTrimEnd :: (state: KssFormatState, start: s32, end: s32) -> s32 {
    pos: s32 = end
    while pos > start {
        byte: u8 = state.source[pos - 1]
        if byte == 32 || byte == 9 || byte == 13 {
            pos = pos - 1
        } else {
            break
        }
    }
    return pos
}

KssFormatLineHasComments :: (state: KssFormatState, start: s32, end: s32) -> bool {
    pos: s32 = start
    while pos + 1 < end {
        if state.source[pos] == 47 {
            next: u8 = state.source[pos + 1]
            if next == 47 || next == 42 {
                return true
            }
        }
        pos = pos + 1
    }
    return false
}

KssFormatLineCanReflow :: (state: KssFormatState, start: s32, end: s32) -> bool {
    if KssFormatLineHasComments(state, start, end) {
        return false
    }
    open_seen: bool = false
    semicolon_seen: bool = false
    close_seen: bool = false
    pos: s32 = start
    while pos < end {
        byte: u8 = state.source[pos]
        if byte == 123 {
            open_seen = true
        } else if byte == 59 && open_seen {
            semicolon_seen = true
        } else if byte == 125 && semicolon_seen {
            close_seen = true
        }
        pos = pos + 1
    }
    return open_seen && semicolon_seen && close_seen
}

KssFormatEmitLineStart :: (state: KssFormatState, leading_break: bool,
    first_line: bool, spaces: s32) -> KssFormatState {
    if leading_break && first_line {
        state = KssFormatEmitIndent(state, 0)
        state = KssFormatEmitIndent(state, 0)
    } else if !first_line {
        state = KssFormatEmitIndent(state, spaces)
    }
    return state
}

KssFormatEmitTrimmedRange :: (state: KssFormatState, start: s32, end: s32) -> KssFormatState {
    trimmed_start: s32 = KssFormatTrimStart(state, start, end)
    trimmed_end: s32 = KssFormatTrimEnd(state, trimmed_start, end)
    if trimmed_start < trimmed_end {
        state = KssFormatEmitCopy(state, trimmed_start, trimmed_end - trimmed_start)
    }
    return state
}

KssFormatEmitReflowLine :: (state: KssFormatState, start: s32, end: s32,
    base_depth: s32, leading_break: bool, first_line: bool) -> KssFormatState {
    cursor: s32 = start
    token_start: s32 = start
    depth: s32 = base_depth
    emitted: bool = false
    while cursor < end {
        byte: u8 = state.source[cursor]
        if byte == 123 {
            state = KssFormatEmitLineStart(state, leading_break, first_line && !emitted, depth * 4)
            state = KssFormatEmitTrimmedRange(state, token_start, cursor)
            state = KssFormatEmitAtom(state, 32)
            state = KssFormatEmitAtom(state, 123)
            emitted = true
            depth = depth + 1
            token_start = cursor + 1
        } else if byte == 59 {
            state = KssFormatEmitLineStart(state, leading_break, first_line && !emitted, depth * 4)
            state = KssFormatEmitTrimmedRange(state, token_start, cursor + 1)
            emitted = true
            token_start = cursor + 1
        } else if byte == 125 {
            if KssFormatTrimStart(state, token_start, cursor) < KssFormatTrimEnd(state, token_start, cursor) {
                state = KssFormatEmitLineStart(state, leading_break, first_line && !emitted, depth * 4)
                state = KssFormatEmitTrimmedRange(state, token_start, cursor)
                emitted = true
            }
            if depth > 0 {
                depth = depth - 1
            }
            state = KssFormatEmitLineStart(state, leading_break, first_line && !emitted, depth * 4)
            state = KssFormatEmitAtom(state, 125)
            emitted = true
            token_start = cursor + 1
        }
        cursor = cursor + 1
    }
    if KssFormatTrimStart(state, token_start, end) < KssFormatTrimEnd(state, token_start, end) {
        state = KssFormatEmitLineStart(state, leading_break, first_line && !emitted, depth * 4)
        state = KssFormatEmitTrimmedRange(state, token_start, end)
    }
    return state
}

KssFormatEmitConstruct :: (state: KssFormatState, construct: KssFormatConstruct, leading_break: bool) -> KssFormatState {
    depth: s32 = 0
    pos: s32 = construct.start
    first: bool = true
    while pos < construct.end {
        line_end: s32 = pos
        while line_end < construct.end && line_end < (cast(s32)state.source.count) {
            if state.source[line_end] == 10 {
                break
            }
            line_end = line_end + 1
        }
        trimmed: s32 = pos
        while trimmed < line_end {
            byte: u8 = state.source[trimmed]
            if byte == 32 || byte == 9 || byte == 13 {
                trimmed = trimmed + 1
            } else {
                break
            }
        }
        if trimmed < line_end {
            indent: s32 = depth
            if state.source[trimmed] == 125 && depth > 0 {
                indent = depth - 1
            }
            if KssFormatLineCanReflow(state, trimmed, line_end) {
                state = KssFormatEmitReflowLine(state, trimmed, line_end,
                    indent, leading_break, first)
            } else {
                state = KssFormatEmitLineStart(state, leading_break, first,
                    indent * 4)
                state = KssFormatEmitCopy(state, trimmed, line_end - trimmed)
            }
            scan: s32 = trimmed
            while scan < line_end {
                byte: u8 = state.source[scan]
                if byte == 123 {
                    depth = depth + 1
                } else if byte == 125 && depth > 0 {
                    depth = depth - 1
                }
                scan = scan + 1
            }
            first = false
        }
        pos = line_end + 1
    }
    return state
}

// Format a style sheet. Output assembles from segments; hosts emit kind 0 as
// source.slice(start, start + length), kind 1 as the atom byte, and kind 2 as
// a newline plus `length` spaces.

#program_export
KssFormat :: (source: string) -> KssFormatResult {
    state: KssFormatState
    state.source = source
    state.result.ok = true
    state.result.count = 0
    state.result.diagnostic_length = 0
    state.construct_count = 0
    state = KssFormatCollect(state)
    if !state.result.ok {
        return state.result
    }
    state = KssFormatDropNested(state)
    state = KssFormatSortConstructs(state)
    state = KssFormatScanGaps(state)
    state = KssFormatSortConstructs(state)
    index: s32 = 0
    while index < state.construct_count {
        if !state.result.ok {
            return state.result
        }
        leading: bool = index > 0
        state = KssFormatEmitConstruct(state, state.constructs[index], leading)
        index = index + 1
    }
    if state.result.count > 0 {
        state = KssFormatEmitAtom(state, 10)
    }
    return state.result
}
