#module "app_shell_props"
#import "kryon_compat.generated.h"

# Route storage and its callback are still host-owned.
KryRouteAllowedFn :: int (*)(int route, void *user) #type

KryRouteList :: struct {
    routes: *i32
    count: i32
    capacity: i32
    empty_route: i32
}

KryRouteStack :: struct {
    routes: *i32
    count: i32
    capacity: i32
    root_route: i32
}

# Implemented by the C-only route hosts; declared here for the public ABI.
KryRouteListContains :: (routes: const i32*, count: i32, route: i32) -> i32 #extern #export
KryRouteAllowedInSet :: (route: i32, allowed_routes: const i32*, allowed_count: i32) -> i32 #extern #export
KryRouteListSanitize :: (list: KryRouteList, allowed: KryRouteAllowedFn, user: *void) -> i32 #extern #export
KryRouteListSanitizeSet :: (list: KryRouteList, allowed_routes: const i32*, allowed_count: i32) -> i32 #extern #export
KryRouteListMove :: (list: KryRouteList, from_index: i32, to_index: i32) -> i32 #extern #export
KryRouteListFirstUnused :: (routes: const i32*, count: i32, candidates: const i32*, candidate_count: i32, fallback: i32) -> i32 #extern #export
KryRouteStackInit :: (stack: *KryRouteStack, routes: *i32, capacity: i32, root_route: i32) #extern #export
KryRouteStackCurrent :: (stack: const KryRouteStack*) -> i32 #extern #export
KryRouteStackPush :: (stack: *KryRouteStack, route: i32) -> i32 #extern #export
KryRouteStackPop :: (stack: *KryRouteStack) -> i32 #extern #export
KryRouteStackReset :: (stack: *KryRouteStack, root_route: i32) #extern #export
