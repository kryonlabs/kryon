#import "drawing_props"
#import "geometry"

labels: s32;
fills: s32;
outlines: s32;
// The x where the watched label was last drawn, -1 before it is drawn.
watched: string;
watched_x: s32 = -1;

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    return (cast(s32)value.count) * font / 2
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    return font
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    outlines += 1
}

#program_export
RasterLine :: (bounds: Rectangle, color: Color) {}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    labels += 1
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    labels += 1
    if value == watched { watched_x = x }
}

#program_export
RasterImage :: (path: string, texture_id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {}

#program_export
RasterImageMesh :: (path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle,
    tint: Color) {}

#program_export
ContextMenuLabelCount :: () -> s32 { return labels }

#program_export
ContextMenuFillCount :: () -> s32 { return fills }

#program_export
ContextMenuOutlineCount :: () -> s32 { return outlines }

#program_export
ContextMenuWatchLabel :: (value: string) {
    watched = value
    watched_x = -1
}

#program_export
ContextMenuWatchedX :: () -> s32 { return watched_x }

#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32, color: Color,
    clip: Rectangle, origin: Vector2, rotation: float32, outer_clip: Rectangle,
    outer_clipped: bool, emphasis: bool, italic: bool) {
    unused value; unused x; unused y; unused font; unused color; unused clip; unused origin
    unused rotation; unused outer_clip; unused outer_clipped; unused emphasis; unused italic
}

#program_export
RasterTriangles :: (points: []Vector2, color: Color) { unused points; unused color }
