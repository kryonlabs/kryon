#import "kryon.h"

app "Kryon Geometry" {
    size 800 600
    fps 60
    font examples
}

GeometryExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        SetUIViewSize(GetScreenWidth(),GetScreenHeight())
        shell: Rectangle = {40,42,GetUIViewWidth()-80,GetUIViewHeight()-84}
        frame: FrameBox = BeginFrameBox(shell,16,16,12)
        header: Rectangle = FramePack(&frame,SideTop,54)
        footer: Rectangle = FramePack(&frame,SideBottom,46)
        rail: Rectangle = FramePack(&frame,SideLeft,150)
        body: Rectangle = frame.bounds
        grid: GridFrame = {body,2,3,10,10,16,16}
        card0: Rectangle = GridCell(grid,0,0,1,2)
        card1: Rectangle = GridCell(grid,0,2,1,1)
        card2: Rectangle = GridCell(grid,1,0,1,1)
        card3: Rectangle = GridCell(grid,1,1,1,2)
        badge: Rectangle = Place(card1,14,42,92,28)
        action: Rectangle = Place(footer,16,7,150,32)
        Text((TextProps){.bounds={40, 14, 0, 0}, .text="Geometry helpers", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(shell,GetThemeSurface(),GetThemeIcon())
        Box(header,GetThemeButton(),BLANK)
        Box(rail,DarkenUIColor(GetThemeSurface(),8),BLANK)
        Separator((Rectangle){rail.x+rail.width+6,rail.y,1,rail.height},1)
        Text((TextProps){.bounds={header.x+16, header.y+16, 0, 0}, .text="Packed header", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={rail.x+16, rail.y+16, 0, 0}, .text="Left rail", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(card0,DarkenUIColor(GetThemeSurface(),12),GetThemeButton())
        Box(card1,DarkenUIColor(GetThemeSurface(),16),GetThemeButton())
        Box(card2,DarkenUIColor(GetThemeSurface(),18),GetThemeButton())
        Box(card3,DarkenUIColor(GetThemeSurface(),22),GetThemeButton())
        Text((TextProps){.bounds={card0.x+14, card0.y+18, 0, 0}, .text="GridCell 2-column span", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card1.x+14, card1.y+18, 0, 0}, .text="Place badge", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Box(badge,GetThemeButtonHover(),BLANK)
        Text((TextProps){.bounds={badge.x+18, badge.y+7, 0, 0}, .text="badge", .font=Text12, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card2.x+14, card2.y+18, 0, 0}, .text="cell 1,0", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={card3.x+14, card3.y+18, 0, 0}, .text="wide footer cell", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Separator((Rectangle){footer.x,footer.y-7,footer.width,1},0)
        Box(action,GetThemeButton(),BLANK)
        Text((TextProps){.bounds={action.x+14, action.y+9, 0, 0}, .text="placed action", .font=Text12, .color=GetThemeText(), .wrap=TextWrapNone})
    }
}
