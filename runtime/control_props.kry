#module "control_props"
#import "kryon_compat.generated.h"
#import "ui_text_input_props.generated.h"
#import "ui_segmented_control_props.generated.h"

ButtonTone :: enum {
    ButtonToneNeutral = 0
    ButtonToneAccent = 1
    ButtonToneDanger = 2
    ButtonToneSuccess = 3
    ButtonToneWarning = 4
}

ButtonEmphasis :: enum {
    ButtonEmphasisFilled = 0
    ButtonEmphasisSoft = 1
    ButtonEmphasisOutline = 2
    ButtonEmphasisGhost = 3
    ButtonEmphasisLink = 4
}

ControlSize :: enum {
    ControlSizeMedium = 0
    ControlSizeSmall = 1
    ControlSizeLarge = 2
}

IconPlacement :: enum {
    IconPlacementLeading = 0
    IconPlacementTrailing = 1
}

ButtonState :: enum {
    ButtonStateAuto = 0
    ButtonStateNormal = 1
    ButtonStateHover = 2
    ButtonStatePressed = 3
    ButtonStateFocus = 4
    ButtonStateDisabled = 5
    ButtonStateLoading = 6
    ButtonStateSelected = 7
}

MaterialKind :: enum {
    MaterialLightfield = 0
    MaterialFlat = 1
    MaterialGlass = 2
}

StyleField :: enum {
    StyleBackground = (uint32_t)1
    StyleForeground = (uint32_t)2
    StyleBorder = (uint32_t)4
    StyleFocus = (uint32_t)8
    StyleRadius = (uint32_t)16
    StyleBorderWidth = (uint32_t)32
    StyleOpacity = (uint32_t)64
    StylePaddingX = (uint32_t)128
    StylePaddingY = (uint32_t)256
    StyleGap = (uint32_t)512
    StyleFontSize = (uint32_t)1024
    StyleIconSize = (uint32_t)2048
    StyleContentOffset = (uint32_t)4096
    StyleBackgroundEnd = (uint32_t)8192
    StyleMaterial = (uint32_t)16384
    StyleTypeface = (uint32_t)32768
    StyleLetterSpacing = (uint32_t)65536
}

Style :: struct {
    fields: u32
    background: Color
    foreground: Color
    border: Color
    focus: Color
    radius: float
    border_width: float
    opacity: float
    padding_x: float
    padding_y: float
    gap: float
    font_size: float
    icon_size: float
    content_offset: Vector2
    background_end: Color
    material: MaterialKind
    typeface: const char*
    letter_spacing: float
}

ControlStyle :: struct {
    normal: Style
    hover: Style
    pressed: Style
    focused: Style
    disabled: Style
    loading: Style
    selected: Style
}

ThemeScheme :: struct {
    primary: Color
    on_primary: Color
    secondary: Color
    on_secondary: Color
    surface: Color
    on_surface: Color
    surface_container: Color
    surface_variant: Color
    on_surface_variant: Color
    outline: Color
    error: Color
    on_error: Color
    disabled_container: Color
    disabled_content: Color
}

# C-only host types: the callbacks and the TextEdit/ThemeMetrics records carry
# raw C shapes (function-pointer fields, unsigned char metrics) that Go does
# not mirror, so they declare the C ABI only.
TextInputFilter :: int (*)(int codepoint, void *user_data) #type
TextEdit :: struct { char *text; size_t text_size; int *cursor_position; int max_codepoints; TextInputFilter filter; void *filter_user_data; int *commit_pressed; } #type
SliderMarkCallback :: void (*)(void *user_data, int x, int y, int h, int min, int max, int value) #type
ThemeMetrics :: struct ThemeMetrics { float radius_small; float radius_medium; float radius_large; float radius_pill; float border_width; float focus_width; float focus_gap; float space_1; float space_2; float space_3; float space_4; float space_5; float space_6; float control_height_small; float control_height_medium; float control_height_large; float control_padding_small; float control_padding_medium; float control_padding_large; float control_gap; float font_size_small; float font_size_medium; float font_size_large; float icon_size_small; float icon_size_medium; float icon_size_large; float shadow_blur; float disabled_opacity; float transition_fast_ms; float transition_normal_ms; float control_radius; float panel_radius; unsigned char control_alpha; unsigned char panel_alpha; unsigned char title_bar_alpha; unsigned char border_alpha; unsigned char shadow_alpha; unsigned char shine_alpha; int bevel_enabled; int touch_target_min; int shadow_offset_y; } #type

# Implemented by the C-only style, text, and segmented-control hosts; declared
# here for the public ABI.
MergeStyle :: (base: Style, overrides: Style) -> Style #extern #export
GetThemeMetrics :: () -> ThemeMetrics #extern #export
GetDefaultThemeMetrics :: () -> ThemeMetrics #extern #export
GetThemeScheme :: () -> ThemeScheme #extern #export
SetFancyEffectsEnabled :: (enabled: i32) #extern #export
FancyEffectsEnabled :: () -> i32 #extern #export
SetThemeMetrics :: (tokens: ThemeMetrics) #extern #export
ClearThemeMetricsOverride :: () #extern #export
EditText :: (edit: TextEdit) -> i32 #extern #export
QueueTextInputCodepoint :: (codepoint: i32) #extern #export
QueueTextInputBackspace :: () #extern #export
QueueTextInputEnter :: () #extern #export
TextBufferLineAtCursor :: (text: const char*, cursor: i32) -> i32 #extern #export
TextBufferColumnAtCursor :: (text: const char*, cursor: i32) -> i32 #extern #export
TextBufferLineCount :: (text: const char*) -> i32 #extern #export
TextBufferToggleLineComment :: (text: *char, text_size: i32, cursor: *i32) -> i32 #extern #export
TextBufferIndentLine :: (text: *char, text_size: i32, cursor: *i32, outdent: i32) -> i32 #extern #export
TextBufferBracketMatch :: (text: const char*, cursor: i32) -> i32 #extern #export
TextAreaGutter :: (area: TextAreaProps, gutter_width: i32) -> Rectangle #extern #export
GetTextAreaSelection :: (focus_id: i32, start: *i32, end: *i32) -> i32 #extern #export
SetTextAreaSelection :: (focus_id: i32, anchor: i32, cursor: i32) #extern #export
GetSegmentedControlHeight :: (control: SegmentedControlProps) -> i32 #extern #export
SegmentedControl :: (control: SegmentedControlProps) -> SegmentedControlResult #extern #export
