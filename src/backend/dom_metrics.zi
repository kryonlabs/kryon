using Web :: #import "std/web";
using Number :: #import "std/number_text";

// The shared widget calculations need font advances even when HTML/CSS lays
// out the result. This private context measures text and never draws to the page.
dom_font_context: s32;

DomMetricsOpen :: () -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    document := WebGetObject(WebGlobal, WebName("document"))
    canvas := WebAsObject(WebCall1(document, WebName("createElement"), WebText("canvas")))
    context := WebAsObject(WebCall1(canvas, WebName("getContext"), WebText("2d")))
    if context == 0 { return false }
    dom_font_context = WebKeep(context)
    return dom_font_context != 0
}

DomMetricsClose :: () {
    WebRelease(dom_font_context)
    dom_font_context = 0
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    if font <= 0 || value == "" || dom_font_context == 0 { return 0 }
    scope := WebScope()
    defer WebEnd(scope)
    digits: [24]u8
    size := FormatInteger(cast(s64)font, digits[:])
    family := ifx typeface == "" then "sans-serif" else typeface
    prefix := WebAsObject(WebCall1(WebGlobal, WebName("String"), WebText(size)))
    css := WebCall2(prefix, WebName("concat"), WebText("px "), WebText(family))
    WebSet(dom_font_context, WebName("font"), css)
    metrics := WebAsObject(WebCall1(dom_font_context, WebName("measureText"), WebText(value)))
    return cast(s32)(WebAsNumber(WebGet(metrics, WebName("width"))) + 0.5)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    return font
}
