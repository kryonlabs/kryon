#module "image_props"
#import "kryon_compat.generated.h"

ImageFit :: enum {
    ImageFitStretch = 0
    ImageFitContain = 1
    ImageFitCover = 2
}

ImageProps :: struct {
    asset_path: const char*
    texture: Texture2D
    alt_text: const char*
    bounds: Rectangle
    source: Rectangle
    origin: Vector2
    rotation: float
    fit: ImageFit
    class_name: i32
}

# C host entry for the canonical image surface (the .kry form is
# Image(ImageProps)). Implemented by the image host.
RenderImage :: (image: ImageProps) #extern #export
