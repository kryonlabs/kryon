// Editing text comes with the widgets that edit it. The frame and the
// platform (such as its accessibility) reach editing through these slots:
// text_request fills the request slots when the editing widgets register
// their segmentation (see text_boundary), and text_input_platform fills the
// focus slots when an editor first takes focus. A program without a text
// field or area carries neither module.
#import "session"

// The platform edit record is small; request storage stays in text_request.
TextRequest :: struct {
    value: string
    cursor: s32
    anchor: s32
    replace: bool
    pending: bool
}

TextEditingSend :: #type (session: Session, index: s32, value: string,
    replace: bool, cursor: s32, anchor: s32) -> bool;
TextEditingSession :: #type (session: Session) -> void;
TextEditingQuery :: #type (session: Session) -> bool;

text_editing_send: TextEditingSend;
text_editing_clear: TextEditingSession;
text_editing_dispose: TextEditingSession;
text_editing_frame_begin: TextEditingSession;
text_editing_focused: TextEditingQuery;

TextEditingUseRequests :: (send: TextEditingSend, clear: TextEditingSession) -> bool {
    text_editing_send = send
    text_editing_clear = clear
    return true
}

TextEditingUseFocus :: (frame_begin: TextEditingSession, focused: TextEditingQuery) {
    text_editing_frame_begin = frame_begin
    text_editing_focused = focused
}

TextEditingUseDisposal :: (dispose: TextEditingSession) {
    text_editing_dispose = dispose
}

// A platform's edit of node INDEX (see TextRequestSend); false when no
// editing widget could take it.
TextEditingRequest :: (session: Session, index: s32, value: string,
    replace: bool, cursor: s32, anchor: s32) -> bool {
    if text_editing_send == null { return false }
    return text_editing_send(session, index, value, replace, cursor, anchor)
}

// The session closes: its outstanding request goes with it.
TextEditingClear :: (session: Session) {
    if text_editing_clear != null { text_editing_clear(session) }
    if text_editing_dispose != null { text_editing_dispose(session) }
}

// A new frame starts (see TextInputFocusFrameBegin).
TextEditingFrameBegin :: (session: Session) {
    if text_editing_frame_begin != null { text_editing_frame_begin(session) }
}

// True while an editor has focus, so the frame keeps composing.
TextEditingFocused :: (session: Session) -> bool {
    return text_editing_focused != null && text_editing_focused(session)
}
