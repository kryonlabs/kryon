#import "input_props"
#import "geometry"

InputContinuousStep :: struct {
    value: float32
    changed: bool
}

InputDiscreteStep :: struct {
    value: s32
    changed: bool
}

InputStep :: struct {
    value: float64
    changed: bool
}

InputPointerInteraction :: struct {
    active: bool
    hovered: bool
    disabled_marker: bool
    activated: bool
    consume_release: bool
}

InputCellLayout :: struct {
    cell: Rectangle
    field: Rectangle
    minus: Rectangle
    plus: Rectangle
    has_step_buttons: bool
}

InputScaledMetric :: (value: float32, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: s32 = cast(s32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}

#program_export
InputDefaultStepButtonWidth :: (scale: float32) -> s32 {
    return InputScaledMetric(24.0, scale)
}

#program_export
InputDoubleClickSlopFor :: (scale: float32) -> s32 {
    return InputScaledMetric(6.0, scale)
}

#program_export
InputPointerDragThresholdFor :: (scale: float32) -> s32 {
    return InputScaledMetric(5.0, scale)
}

#program_export
InputPointerDragShouldStart :: (dx: s32, dy: s32, threshold: s32) -> bool {
    if threshold < 0 { threshold = 0 }
    return dx > threshold || dx < -threshold ||
        dy > threshold || dy < -threshold
}

#program_export
InputPointerDragIsHorizontal :: (dx: s32, dy: s32) -> bool {
    if dx < 0 { dx = -dx }
    if dy < 0 { dy = -dy }
    return dx >= dy
}

#program_export
InputPointerInteractionFor :: (inside: bool, captured: bool, disabled: bool,
    hover_effects: bool, released: bool, release_consumed: bool,
    press_started_inside: bool) -> InputPointerInteraction {
    interaction: InputPointerInteraction
    interaction.active = inside && !captured && !disabled
    interaction.hovered = interaction.active && hover_effects
    interaction.disabled_marker = inside && !captured && disabled
    interaction.activated = interaction.active && released &&
        !release_consumed && press_started_inside
    interaction.consume_release = interaction.activated
    return interaction
}

#program_export
InputTempEditActivationFor :: (pressed: bool, control: bool,
    same_kind: bool, same_widget: bool, same_component: bool,
    elapsed_seconds: float32, dx: float32, dy: float32, slop: s32) -> bool {
    if !pressed {
        return false
    }
    if control {
        return true
    }
    if slop < 0 { slop = 0 }
    if dx < cast(float32)-slop || dx > cast(float32)slop {
        return false
    }
    if dy < cast(float32)-slop || dy > cast(float32)slop {
        return false
    }
    return same_kind && same_widget && same_component &&
        elapsed_seconds <= 0.30
}

#program_export
InputCellLayoutFor :: (bounds: Rectangle, count: s32, index: s32,
    requested_button_width: s32, has_step: bool) -> InputCellLayout {
    layout: InputCellLayout
    if count <= 0 { return layout }

    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }

    layout.cell.x = bounds.x + bounds.width * cast(float32)index / cast(float32)count
    layout.cell.y = bounds.y
    layout.cell.width = bounds.width / cast(float32)count
    layout.cell.height = bounds.height
    layout.field = layout.cell
    layout.minus = layout.cell
    layout.plus = layout.cell

    if has_step {
        button_width: s32 = requested_button_width
        if button_width < 0 { button_width = 0 }
        max_button: s32 = cast(s32)(layout.cell.width / 2.0)
        if button_width > max_button { button_width = max_button }
        layout.field.width = layout.field.width - cast(float32)(button_width * 2)
        if layout.field.width < 0.0 { layout.field.width = 0.0 }
        layout.minus.x = layout.field.x + layout.field.width
        layout.minus.width = cast(float32)button_width
        layout.plus.x = layout.minus.x + layout.minus.width
        layout.plus.width = cast(float32)button_width
        layout.has_step_buttons = button_width > 0
    }

    return layout
}

#program_export
InputContinuousEffectiveStep :: (step: float32, step_fast: float32, fast: bool) -> float32 {
    if fast && step_fast != 0.0 { return step_fast }
    return step
}

#program_export
InputDiscreteEffectiveStep :: (step: s32, step_fast: s32, fast: bool) -> s32 {
    if fast && step_fast != 0 { return step_fast }
    return step
}

#program_export
InputEffectiveStep :: (step: float64, step_fast: float64, fast: bool) -> float64 {
    if fast && step_fast != 0.0 { return step_fast }
    return step
}

#program_export
InputKindIsFloat :: (kind: NumericValueKind) -> bool {
    return cast(s32)kind == cast(s32)NumericFloat
}

#program_export
InputKindIsInt :: (kind: NumericValueKind) -> bool {
    return cast(s32)kind == cast(s32)NumericInt
}

#program_export
InputKindIsDouble :: (kind: NumericValueKind) -> bool {
    return cast(s32)kind == cast(s32)NumericDouble
}

#program_export
InputDefaultFormat :: (kind: NumericValueKind) -> string {
    if InputKindIsInt(kind) { return "%d" }
    if InputKindIsDouble(kind) { return "%.6f" }
    return "%.3f"
}

#program_export
InputRoundValueForKind :: (kind: NumericValueKind, value: float64) -> float64 {
    if InputKindIsInt(kind) {
        if value < 0.0 { return cast(float64)(cast(s32)(value - 0.5)) }
        return cast(float64)(cast(s32)(value + 0.5))
    }
    return value
}

#program_export
InputContinuousStepValue :: (value: float32, step: float32, step_fast: float32,
    direction: s32, fast: bool) -> InputContinuousStep {
    result: InputContinuousStep
    result.value = value
    result.changed = false
    if direction == 0 || step == 0.0 { return result }
    next: float32 = value + cast(float32)direction *
        InputContinuousEffectiveStep(step, step_fast, fast)
    result.value = next
    result.changed = next != value
    return result
}

#program_export
InputDiscreteStepValue :: (value: s32, step: s32, step_fast: s32,
    direction: s32, fast: bool) -> InputDiscreteStep {
    result: InputDiscreteStep
    result.value = value
    result.changed = false
    if direction == 0 || step == 0 { return result }
    next: s32 = value + direction * InputDiscreteEffectiveStep(step, step_fast, fast)
    result.value = next
    result.changed = next != value
    return result
}

#program_export
InputStepValue :: (value: float64, step: float64, step_fast: float64,
    direction: s32, fast: bool) -> InputStep {
    result: InputStep
    result.value = value
    result.changed = false
    if direction == 0 || step == 0.0 { return result }
    next: float64 = value + cast(float64)direction *
        InputEffectiveStep(step, step_fast, fast)
    result.value = next
    result.changed = next != value
    return result
}

#program_export
InputStepValueForKind :: (kind: NumericValueKind, value: float64, step: float64,
    step_fast: float64, direction: s32, fast: bool) -> InputStep {
    result: InputStep
    result.value = value
    result.changed = false
    if InputKindIsInt(kind) {
        stepped: InputDiscreteStep = InputDiscreteStepValue(cast(s32)value,
            cast(s32)step, cast(s32)step_fast, direction, fast)
        result.value = cast(float64)stepped.value
        result.changed = stepped.changed
        return result
    }
    if InputKindIsFloat(kind) {
        continuous: InputContinuousStep = InputContinuousStepValue(
            cast(float32)value, cast(float32)step, cast(float32)step_fast, direction, fast)
        result.value = cast(float64)continuous.value
        result.changed = continuous.changed
        return result
    }
    return InputStepValue(value, step, step_fast, direction, fast)
}
