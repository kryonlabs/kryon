// Optional hardware GPU 2D backend hooks installed by desktop_runtime when an
// accelerated SDL2 GPU renderer is active. Keeps cairo_raster independent of
// SDL2 for headless/non-SDL tests while letting all desktop apps, zx-desktop
// and libkryon-desktop.so render directly on the GPU via SDL_RenderGeometry.
RasterGpuTextArgs :: struct {
    value: string
    font: s32
    family: s32
    weight: s32
    slant: s32
    spacing: s32
    scale: float64
    offset_x: float64
    offset_y: float64
    x: s32
    y: s32
    color: Color
    has_clip: bool
    clip: Rectangle
    rotated: bool
    origin: Vector2
    rotation: float32
    outer_clipped: bool
    outer_clip: Rectangle
}

RasterGpuImageArgs :: struct {
    surface_ptr: *void
    texture_id: u32
    serial: u64
    img_w: s32
    img_h: s32
    data: *u8
    stride: s32
    source: Rectangle
    dest: Rectangle
    clip: Rectangle
    origin: Vector2
    rotation: float32
    tint: Color
    smooth: bool
    polygon: []Vector2
    scale: float64
    offset_x: float64
    offset_y: float64
}

RasterGpuMeshArgs :: struct {
    surface_ptr: *void
    texture_id: u32
    serial: u64
    img_w: s32
    img_h: s32
    data: *u8
    stride: s32
    source: Rectangle
    points: []Vector2
    columns: s32
    rows: s32
    clip: Rectangle
    tint: Color
    smooth: bool
    scale: float64
    offset_x: float64
    offset_y: float64
}

RasterGpuClearCall :: #type (color: Color) -> void;
RasterGpuRoundedRectCall :: #type (bounds: Rectangle, radius: float32, color: Color,
    scale: float64, offset_x: float64, offset_y: float64) -> void;
RasterGpuRoundedOutlineCall :: #type (bounds: Rectangle, radius: float32, line_width: float32,
    color: Color, scale: float64, offset_x: float64, offset_y: float64) -> void;
RasterGpuLineCall :: #type (line: Rectangle, color: Color,
    scale: float64, offset_x: float64, offset_y: float64) -> void;
RasterGpuTrianglesCall :: #type (points: []Vector2, color: Color,
    scale: float64, offset_x: float64, offset_y: float64) -> void;
RasterGpuTextCachedCall :: #type (args: *RasterGpuTextArgs) -> bool;
RasterGpuTextUploadCall :: #type (args: *RasterGpuTextArgs, bmp_w: s32, bmp_h: s32,
    data: *u8, stride: s32, is_color: bool) -> bool;
RasterGpuImageCall :: #type (args: *RasterGpuImageArgs) -> bool;
RasterGpuImageMeshCall :: #type (args: *RasterGpuMeshArgs) -> bool;
RasterGpuReadbackCall :: #type (pixels: *u8, stride: s32) -> bool;
RasterGpuInvalidateCall :: #type () -> void;

RasterGpuHooks :: struct {
    active: bool
    clear: RasterGpuClearCall
    rounded_rect: RasterGpuRoundedRectCall
    rounded_outline: RasterGpuRoundedOutlineCall
    line: RasterGpuLineCall
    triangles: RasterGpuTrianglesCall
    text_cached: RasterGpuTextCachedCall
    text_upload: RasterGpuTextUploadCall
    image: RasterGpuImageCall
    image_mesh: RasterGpuImageMeshCall
    readback: RasterGpuReadbackCall
    invalidate_images: RasterGpuInvalidateCall
}
raster_gpu: RasterGpuHooks;

RasterGpuInstall :: (hooks: RasterGpuHooks) {
    raster_gpu = hooks
}
RasterGpuClearHooks :: () {
    raster_gpu = .{}
}
RasterGpuOn :: () -> bool {
    return raster_gpu.active && !raster_target_swapped
}

// Lazily allocates/resizes the Cairo readback surface when a GPU frame is
// explicitly read back for PNG capture or FramePreviousSnapshotHost.
RasterReadbackGpuSurface :: () -> bool {
    if !RasterGpuOn() || raster_gpu.readback == null { return true }
    if raster_gpu_width <= 0 || raster_gpu_height <= 0 { return false }
    if surface == null || ImageSurfaceWidth(surface) != raster_gpu_width ||
    ImageSurfaceHeight(surface) != raster_gpu_height {
        if raster_text_close != null { raster_text_close() }
        if paint != null { Destroy(paint); paint = null }
        if surface != null { SurfaceDestroy(surface); surface = null }
        surface = ImageSurfaceCreate(0, raster_gpu_width, raster_gpu_height)
        if surface == null || SurfaceStatus(surface) != 0 { return false }
        paint = Create(surface)
        if paint != null {
            Translate(paint, raster_offset_x, raster_offset_y)
            Scale(paint, raster_scale, raster_scale)
        }
        raster_main_surface = surface
    }
    ok := raster_gpu.readback(ImageSurfaceData(surface), ImageSurfaceStride(surface))
    if ok { SurfaceMarkDirty(surface) }
    return ok
}

// The surface and paint frames draw into. A secondary window swaps its own in
// for its frame and gives the previous back after (see
// desktop_secondary_window); once text is open each paint takes Kryon's font.
RasterTarget :: struct { surface: *void; paint: *void; pending: bool; }
RasterUseTarget :: (next: RasterTarget) -> RasterTarget {
    previous := RasterTarget.{surface, paint, frame_pending}
    surface = next.surface; paint = next.paint; frame_pending = next.pending
    raster_target_swapped = raster_main_surface != null && surface != raster_main_surface
    if layout != null && paint != null { UseKryonFont() }
    return previous
}

// Layout units to pixels for the window's paint (see cairo_render_scale).
raster_scale: float64 = 1.0;
raster_offset_x: float64;
raster_offset_y: float64;
// A program's asset reader (see cairo_assets): the path an embedded asset's
// decoders read, ahead of the files on disk.
RasterAssetPath :: #type (path: string, output: []u8) -> string;
raster_asset_path: RasterAssetPath;
// A typeface the program selected (see cairo_typefaces), else Kryon's font.
raster_family: RasterFontFamily;
Decode :: #import "image_decode_desktop";
CachedImage :: struct {
    path: [4096]u8
    length: s32
    source: [4096]u8
    source_length: s32
    image: *void
    used: u64
    bytes: s64
    serial: u64
}
cached_images: [128]CachedImage;

// Smooth pictures drawn under a plain translation show their Lanczos copy
// at the device pixels they cover (see lanczos_cache). A copy of another
// size, kept while the new one is made, is drawn scaled in its place.
Lanczos :: #import "lanczos_cache";
image_serial: u64;
CairoLanczosRelease :: (argument: *void) {
    entry := cast(*Lanczos.LanczosEntry)argument
    if entry.surface != null { SurfaceDestroy(entry.surface) }
    entry.surface = null
}
CairoImageSerial :: (image: *void) -> u64 {
    for i: 0..127 { if cached_images[i].image == image { return cached_images[i].serial } }
    return 0
}
// A finished copy changes what unchanged widgets paint.
CairoSmoothPump :: () -> bool {
    if !Lanczos.LanczosPump() { return false }
    PaintResourcesChanged()
    return true
}
// The first smooth picture brings the Lanczos cache and its worker.
CairoUseSmooth :: () {
    if raster_smooth_pump != null { return }
    raster_smooth_pump = CairoSmoothPump
    raster_smooth_wait = Lanczos.LanczosWait
    raster_smooth_close = Lanczos.LanczosClose
    #if #defined(POSIX_THREADS) || #defined(ANDROID_BUILD) || #defined(KRYON_FRAME_THREADS) {
        Lanczos.LanczosSetWake(RasterWakeWindow, null)
    }
}
// Snap axis-aligned image edges in actual device pixels, then return to
// layout coordinates. A translated or scaled camera shares the same edge
// between neighboring images; rounding layout coordinates leaves seams.
RasterSnapRectangle :: (bounds: Rectangle) -> Rectangle {
    if paint == null { return bounds }
    left := cast(float64)bounds.x; top := cast(float64)bounds.y
    right := cast(float64)bounds.x + cast(float64)bounds.width
    bottom := cast(float64)bounds.y + cast(float64)bounds.height
    UserToDevice(paint, *left, *top)
    UserToDevice(paint, *right, *bottom)
    left = RoundDown(left + 0.5); top = RoundDown(top + 0.5)
    right = RoundDown(right + 0.5); bottom = RoundDown(bottom + 0.5)
    DeviceToUser(paint, *left, *top)
    DeviceToUser(paint, *right, *bottom)
    return .{cast(float32)left, cast(float32)top, cast(float32)(right - left), cast(float32)(bottom - top)}
}

// The copy to draw for a smooth picture, and in SNAPPED the device pixels
// it covers, or null to draw the picture with Cairo's filter.
ScaledImageFor :: (image: *void, source: Rectangle, destination: Rectangle, snapped: *Rectangle) -> *Lanczos.LanczosEntry {
    if !Finite32(destination.x) || !Finite32(destination.y) || !Finite32(destination.width) ||
    !Finite32(destination.height) || destination.width > 4096.0 || destination.height > 4096.0 ||
    destination.x < -1048576.0 || destination.x > 1048576.0 ||
    destination.y < -1048576.0 || destination.y > 1048576.0 || image == picture_surface { return null }
    format := ImageSurfaceFormat(image)
    serial := CairoImageSerial(image)
    if serial == 0 || (format != 0 && format != 1) { return null }
    matrix: CairoMatrix; GetMatrix(paint, *matrix)
    if matrix.xx != 1.0 || matrix.yy != 1.0 || matrix.xy != 0.0 || matrix.yx != 0.0 ||
    matrix.x0 != 0.0 || matrix.y0 != 0.0 { return null }
    width := ImageSurfaceWidth(image); height := ImageSurfaceHeight(image)
    snapped.* = RasterSnapRectangle(destination)
    if !Lanczos.LanczosEligible(source, width, height, snapped.*) { return null }
    key: Lanczos.LanczosKey = .{serial, 0, 0, source, cast(s32)snapped.width, cast(s32)snapped.height}
    CairoUseSmooth()
    SurfaceFlush(image)
    // Cairo's pixels are premultiplied already, in either format.
    entry := Lanczos.LanczosLookup(key, ImageSurfaceData(image), width, height,
        cast(s64)ImageSurfaceStride(image), Lanczos.LANCZOS_PREMULTIPLIED, Lanczos.LANCZOS_PREMULTIPLIED)
    if entry == null { return null }
    if entry.surface == null {
        sampled := ImageSurfaceBorrow(entry.pixels, format, entry.key.width, entry.key.height, entry.key.width * 4)
        if sampled == null || SurfaceStatus(sampled) != 0 {
            if sampled != null { SurfaceDestroy(sampled) }
            return null
        }
        entry.surface = sampled
        entry.release = CairoLanczosRelease
    }
    return entry
}
image_clock: u64;
image_bytes: s64;

// File pictures arrive with the first picture a program asks the size of:
// every widget that draws one lays it out from its size first (see
// image_raster), so ImageWidth and ImageHeight register loading, decoding
// and smooth copies. A program that draws only managed pixels, such as
// vector icons, carries no decoder, asset path or Lanczos worker.
RasterPictureLoad :: #type (asset_path: string) -> *void;
RasterPictureSmooth :: #type (image: *void, source: Rectangle, destination: Rectangle,
    snapped: *Rectangle) -> *Lanczos.LanczosEntry;
raster_picture_load: RasterPictureLoad;
raster_picture_smooth: RasterPictureSmooth;
CairoUsePictures :: () {
    raster_picture_load = LoadPNG
    raster_picture_smooth = ScaledImageFor
}
// A file picture once pictures are in use; a managed one always.
CairoPictureFor :: (asset_path: string, texture_id: u32) -> *void {
    if texture_id != cast(u32)0 {
        if raster_frame_image != null {
            frame := raster_frame_image(texture_id)
            if frame != null { return frame }
        }
        return CairoManagedImage(texture_id)
    }
    if raster_picture_load == null { return null }
    return raster_picture_load(asset_path)
}

SetColor :: (color: Color) {
    SetSourceRGBA(paint, cast(float64)color.r / 255.0,
        cast(float64)color.g / 255.0, cast(float64)color.b / 255.0,
        cast(float64)color.a / 255.0)
}

RoundBox :: (bounds: Rectangle, requested_radius: float32) {
    x: float64 = bounds.x
    y: float64 = bounds.y
    width: float64 = bounds.width
    height: float64 = bounds.height
    radius: float64 = requested_radius
    NewPath(paint)
    if width <= 0.0 || height <= 0.0 { return }
    if radius < 0.0 { radius = 0.0 }
    if radius > width / 2.0 { radius = width / 2.0 }
    if radius > height / 2.0 { radius = height / 2.0 }
    if radius == 0.0 {
        CanvasRectangle(paint, x, y, width, height)
        return
    }
    half_pi: float64 = 1.5707963267948966
    Arc(paint, x + width - radius, y + radius, radius, -half_pi, 0.0)
    Arc(paint, x + width - radius, y + height - radius, radius,
        0.0, half_pi)
    Arc(paint, x + radius, y + height - radius, radius,
        half_pi, 2.0 * half_pi)
    Arc(paint, x + radius, y + radius, radius,
        2.0 * half_pi, 3.0 * half_pi)
    ClosePath(paint)
}

font_library: *void;
font_face: *void;

// Kryon's font, Liberation Sans, as the canvas and pixmap hosts use:
// the file KRYON_FONT_PATH names, else the system's copy, else whatever
// fontconfig finds by that name. Glyphs are placed at their unhinted widths
// and smoothed in gray, as a browser lays text out, so every host measures a
// string alike.
UseKryonFont :: () {
    path: *u8 = null
    key: [32]u8
    if CopyCString("KRYON_FONT_PATH", key[:]) { path = RasterGetEnvironment(*key[0]) }
    system: [128]u8
    if path == null && CopyCString("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        system[:]) {
        path = *system[0]
    }
    if font_face == null && path != null {
        if font_library != null || FreeTypeInit(*font_library) == 0 {
            face: *void = null
            if FreeTypeNewFace(font_library, path, 0, *face) == 0 && face != null {
                font_face = FontFaceFromFreeType(face, 0)
            }
        }
    }
    if font_face != null {
        SetFontFace(paint, font_face)
    } else {
        family: [32]u8
        if CopyCString("Liberation Sans", family[:]) {
            SelectFontFace(paint, *family[0], 0, 0)
        }
    }
    options: *void = FontOptionsCreate()
    if options == null { return }
    // Gray anti-aliasing, no hinting, unhinted metrics.
    FontOptionsSetAntialias(options, 2)
    FontOptionsSetHintStyle(options, 1)
    FontOptionsSetHintMetrics(options, 1)
    SetFontOptions(paint, options)
    FontOptionsDestroy(options)
}

#program_export
OpenRaster :: (width: s32, height: s32) -> bool {
    if surface != null || paint != null {
        if raster_text_close != null { raster_text_close() }
        if paint != null { Destroy(paint); paint = null }
        if surface != null { SurfaceDestroy(surface); surface = null }
    }
    raster_gpu_width = width
    raster_gpu_height = height
    // When GPU rendering is active, allocate only a 1x1 Cairo surface for
    // Pango font metrics/shaping; full-screen pixel storage lives on the GPU.
    alloc_w := ifx raster_gpu.active then cast(s32)1 else width
    alloc_h := ifx raster_gpu.active then cast(s32)1 else height
    surface = ImageSurfaceCreate(0, alloc_w, alloc_h)
    if surface == null || SurfaceStatus(surface) != 0 { return false }
    paint = Create(surface)
    if paint != null {
        Translate(paint, raster_offset_x, raster_offset_y)
        Scale(paint, raster_scale, raster_scale)
    }
    raster_main_surface = surface
    raster_target_swapped = false
    return paint != null && Status(paint) == 0
}

// Kryon's font and the shaped layouts open with the first text the window
// measures or draws. Every text entry opens them before saving paint state,
// so the font options stay on the window's paint.
CairoTextOpen :: () -> bool {
    if layout != null { return true }
    if paint == null && !OpenRaster(1, 1) { return false }
    UseKryonFont()
    CopyCString("Liberation Sans", font_family[:])
    key: [32]u8
    CopyCString("KRYON_FONT_PATH", key[:])
    path: *u8 = RasterGetEnvironment(*key[0])
    if path != null {
        FontConfigAdd(FontConfigCurrent(), path)
        count: s32 = 0
        pattern: *void = FontQuery(path, 0, null, *count)
        if pattern != null {
            family_key: [16]u8; CopyCString("family", family_key[:])
            family: *u8 = null
            if FontQueryString(pattern, *family_key[0], 0, *family) == 0 && family != null {
                at: s32 = 0
                while at < 255 && family[at] != cast(u8)0 { font_family[at] = family[at]; at += 1 }
                font_family[at] = 0
            }
            FontQueryFree(pattern)
        }
    }
    shaped_next = 1
    layout = LayoutNew(paint)
    shaped_entries[0].layout = layout
    font_description = FontDescriptionNew()
    raster_text_close = CairoTextClose
    if layout == null || font_description == null { CairoTextClose(); return false }
    LayoutSingleParagraph(layout, 1)
    measure: CaretMeasure = ShapedCaret
    GlyphCaretInstall(measure)
    GlyphSpansInstall(ShapedSpans, ShapedSpanAt, ShapedSpansDone)
    return Status(paint) == 0
}

CairoTextClose :: () {
    GlyphCaretClear()
    if layout_bytes != null { LayoutFree(layout_bytes) }; layout_bytes = null; layout_capacity = 0
    for index: cast(s32)0..SHAPED_LAYOUT_LIMIT - 1 {
        if shaped_entries[index].layout != null { LayoutUnref(shaped_entries[index].layout) }
        shaped_entries[index] = .{}
    }
    layout = null
    if font_description != null { FontDescriptionFree(font_description) }; font_description = null
}

// Pictures, their smooth copies and a named source's surface.
CairoPicturesClose :: () {
    if raster_smooth_close != null { raster_smooth_close() }
    if picture_surface != null { SurfaceDestroy(picture_surface); picture_surface = null }
    picture_revision = 0; picture_width = 0; picture_height = 0
    for i: 0..127 {
        if cached_images[i].image != null { SurfaceDestroy(cached_images[i].image) }
        cached_images[i] = .{}
    }
    image_bytes = 0
}

#program_export
CloseRaster :: () {
    // Registered closers stay registered: a closed part closes again as a
    // no-op, and the window reopens its raster on resize.
    if raster_pictures_close != null { raster_pictures_close() }
    if raster_text_close != null { raster_text_close() }
    if paint != null { Destroy(paint) }
    if surface != null { SurfaceDestroy(surface) }
    paint = null
    surface = null
    raster_main_surface = null
    raster_target_swapped = false
    raster_presented_surface = null
}

FrameBackground :: #type (refresh: bool) -> u32;
FrameAppearance :: struct { background: FrameBackground }
raster_appearance: FrameAppearance;

#program_export
SetRasterBackground :: (background: FrameBackground) { raster_appearance.background = background }

raster_background_color: u32;
RasterBackgroundColor :: (refresh: bool) -> u32 {
    unused refresh
    return raster_background_color
}

#program_export
SetRasterBackgroundColor :: (color: u32) {
    raster_background_color = color
    SetRasterBackground(RasterBackgroundColor)
}

#program_export
BeginRasterFrame :: (retain: bool = false) {
    if raster_smooth_pump != null { unused raster_smooth_pump() }
    raster_appearance = .{}
    frame_pending = true
    text_error = false
    if !retain { PrepareRasterPaint() }
}

// A retained host leaves the previous surface intact until actual paint is
// emitted. Clear before clipping or drawing so changed geometry leaves no trail.
PrepareRasterPaint :: () {
    if !frame_pending { return }
    frame_pending = false
    raster_presented_surface = null
    color: Color = .{248, 250, 252, 255}
    // Frame code may install a palette before emitting its first draw.
    if raster_appearance.background != null { color = ColorFromPacked(raster_appearance.background(false)) }
    if RasterGpuOn() && raster_gpu.clear != null {
        raster_gpu.clear(color)
        return
    }
    Save(paint)
    SetSourceRGBA(paint, cast(float64)color.r / 255.0, cast(float64)color.g / 255.0,
        cast(float64)color.b / 255.0, cast(float64)color.a / 255.0)
    Paint(paint)
    Restore(paint)
}

// Replace the whole custom host frame, including transparent pixels. Preserve
// the caller's clip and drawing state for the commands after the clear.
#program_export
ClearRasterFrame :: (color: Color) {
    frame_pending = false
    raster_presented_surface = null
    if RasterGpuOn() && raster_gpu.clear != null {
        raster_gpu.clear(color)
        return
    }
    if paint == null { return }
    Save(paint)
    ResetClip(paint)
    SetOperator(paint, 1) // CAIRO_OPERATOR_SOURCE
    SetSourceRGBA(paint, cast(float64)color.r / 255.0, cast(float64)color.g / 255.0,
        cast(float64)color.b / 255.0, cast(float64)color.a / 255.0)
    Paint(paint)
    Restore(paint)
}

#program_export
FinishRasterFrame :: (retain: bool = false) -> bool {
    // A changed frame with no commands still replaces the previous picture.
    if !retain { PrepareRasterPaint() }
    if RasterGpuOn() { return !text_error }
    if text_error || Status(paint) != 0 { return false }
    SurfaceFlush(surface)
    if SurfaceStatus(surface) != 0 { return false }
    return true
}

// The presenter calls this only after a successful display update. Finished
// off-screen or failed frames must not replace the previous presented frame.
RasterFramePresented :: () {
    if RasterGpuOn() && raster_frame_present != null {
        unused RasterReadbackGpuSurface()
    }
    raster_presented_surface = surface
    if raster_frame_present != null { raster_frame_present(surface) }
}

#program_export
RasterSurfaceData :: () -> *u8 {
    if RasterGpuOn() { unused RasterReadbackGpuSurface() }
    return ImageSurfaceData(surface)
}

#program_export
RasterSurfaceStride :: () -> s32 {
    if RasterGpuOn() { unused RasterReadbackGpuSurface() }
    return ImageSurfaceStride(surface)
}

#program_export
CaptureRequested :: () -> bool {
    key: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", key[:]) { return false }
    return RasterGetEnvironment(*key[0]) != null
}

#program_export
CaptureConfigured :: () -> bool {
    key: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", key[:]) { return false }
    path: *u8 = RasterGetEnvironment(*key[0])
    if path == null { return false }
    if RasterGpuOn() && !RasterReadbackGpuSurface() { return false }
    return SurfaceWritePNG(surface, path) == 0
}

// VALUE at FONT size in COLOR, centred on a transparent WIDTH by HEIGHT
// picture, shaped exactly as the window's text: straight RGBA into PIXELS
// (at least WIDTH * HEIGHT * 4 bytes), for a host that needs text as a
// texture, such as lettering on a 3D surface. False before the window's
// raster exists or when the text cannot be shaped.
#program_export
RasterTextPixels :: (value: string, font: s32, color: Color, width: s32, height: s32, pixels: []u8) -> bool {
    if paint == null || width <= 0 || height <= 0 || width > 4096 || height > 4096 ||
    pixels.count < cast(s64)width * cast(s64)height * 4 { return false }
    if !ShapedLayout(value, font, "") { return false }
    target := ImageSurfaceCreate(0, width, height)
    if target == null { return false }
    context := Create(target)
    if context == null { SurfaceDestroy(target); return false }
    laid_width: s32; laid_height: s32
    LayoutSize(layout, *laid_width, *laid_height)
    MoveTo(context, cast(float64)(width - laid_width) / 2.0, cast(float64)(height - laid_height) / 2.0)
    SetSourceRGBA(context, cast(float64)color.r / 255.0, cast(float64)color.g / 255.0,
        cast(float64)color.b / 255.0, cast(float64)color.a / 255.0)
    LayoutShow(context, layout)
    Destroy(context)
    SurfaceFlush(target)
    // Cairo keeps premultiplied ARGB words; hand back straight RGBA.
    data := ImageSurfaceData(target)
    stride := ImageSurfaceStride(target)
    for y: cast(s32)0..height - 1 {
        for x: cast(s32)0..width - 1 {
            word := cast(*u32)(*data[cast(s64)y * cast(s64)stride + cast(s64)x * 4])
            pixel := word.*
            alpha := pixel >> 24
            at := (cast(s64)y * cast(s64)width + cast(s64)x) * 4
            if alpha == cast(u32)0 { pixels[at] = 0; pixels[at + 1] = 0; pixels[at + 2] = 0; pixels[at + 3] = 0; continue }
            pixels[at] = cast(u8)(((pixel >> 16) & cast(u32)255) * cast(u32)255 / alpha)
            pixels[at + 1] = cast(u8)(((pixel >> 8) & cast(u32)255) * cast(u32)255 / alpha)
            pixels[at + 2] = cast(u8)((pixel & cast(u32)255) * cast(u32)255 / alpha)
            pixels[at + 3] = cast(u8)alpha
        }
    }
    SurfaceDestroy(target)
    return true
}

// Writes the finished frame to PATH as a PNG (a test driver's capture).
#program_export
RasterWritePNG :: (path: string) -> bool {
    name: [4096]u8
    if !CopyCString(path, name[:]) { return false }
    if RasterGpuOn() && !RasterReadbackGpuSurface() { return false }
    return SurfaceWritePNG(surface, *name[0]) == 0
}
#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if !ShapedLayout(value, font, typeface) { return 0 }
    width: s32 = 0; height: s32 = 0
    LayoutSize(layout, *width, *height)
    return width
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if !ShapedLayout("Mg", font, typeface) { return font }
    width: s32 = 0; height: s32 = 0
    LayoutSize(layout, *width, *height)
    return height
}

CairoCeilS32 :: (value: float64) -> s32 {
    n := cast(s32)value
    return ifx value > cast(float64)n then n + 1 else n
}

// Draws text on the GPU using the Pango/Cairo shaped glyph atlas cache.
// On atlas hit, zero Cairo calls occur; on miss, only the small text run is
// rasterized once to a temporary surface and uploaded into GPU VRAM.
CairoGpuDrawText :: (value: string, x: s32, y: s32, font: s32, color: Color,
    has_clip: bool, clip: Rectangle, rotated: bool, origin: Vector2, rotation: float32,
    outer_clipped: bool, outer_clip: Rectangle) -> bool {
    if !RasterGpuOn() || raster_gpu.text_cached == null || raster_gpu.text_upload == null {
        return false
    }
    if value.count == 0 { return true }
    family := ShapedFamily(text_raster_typeface)
    style := text_glyph_style
    weight := ifx style.weight > 0 then style.weight else 400
    slant := cast(s32)style.style
    spacing := cast(s32)(style.letter_spacing * 1024.0)
    args: RasterGpuTextArgs = .{
        value, font, family.id, weight, slant, spacing,
        raster_scale, raster_offset_x, raster_offset_y,
        x, y, color, has_clip, clip, rotated, origin, rotation,
        outer_clipped, outer_clip
    }
    if raster_gpu.text_cached(*args) {
        return true
    }
    if !ShapedLayout(value, font, text_raster_typeface) { text_error = true; return true }
    laid_w: s32 = 0; laid_h: s32 = 0
    LayoutSize(layout, *laid_w, *laid_h)
    if laid_w <= 0 || laid_h <= 0 { return true }
    bmp_w := CairoCeilS32(cast(float64)laid_w * raster_scale) + 2
    bmp_h := CairoCeilS32(cast(float64)laid_h * raster_scale) + 2
    if bmp_w <= 0 || bmp_h <= 0 || bmp_w > 4096 || bmp_h > 4096 { return false }
    scratch := ImageSurfaceCreate(0, bmp_w, bmp_h)
    if scratch == null || SurfaceStatus(scratch) != 0 {
        if scratch != null { SurfaceDestroy(scratch) }
        return false
    }
    ctx := Create(scratch)
    if ctx == null { SurfaceDestroy(scratch); return false }
    Scale(ctx, raster_scale, raster_scale)
    SetSourceRGBA(ctx, 1.0, 1.0, 1.0, 1.0)
    MoveTo(ctx, 0.0, 0.0)
    LayoutShow(ctx, layout)
    Destroy(ctx)
    SurfaceFlush(scratch)
    data := ImageSurfaceData(scratch)
    stride := ImageSurfaceStride(scratch)
    is_color := false
    for py: cast(s32)0..bmp_h - 1 {
        row := *data[cast(s64)py * cast(s64)stride]
        for px: cast(s32)0..bmp_w - 1 {
            word := (cast(*u32)(*row[cast(s64)px * 4])).*
            if (word >> cast(u32)24) != cast(u32)0 {
                r := (word >> cast(u32)16) & cast(u32)255
                g := (word >> cast(u32)8) & cast(u32)255
                b := word & cast(u32)255
                if r != g || g != b { is_color = true; break }
            }
        }
        if is_color { break }
    }
    ok := raster_gpu.text_upload(*args, bmp_w, bmp_h, data, stride, is_color)
    SurfaceDestroy(scratch)
    return ok
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    PrepareRasterPaint()
    if RasterGpuOn() && raster_gpu.rounded_rect != null {
        raster_gpu.rounded_rect(bounds, radius, color, raster_scale, raster_offset_x, raster_offset_y)
        return
    }
    RoundBox(bounds, radius)
    SetColor(color)
    Fill(paint)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    PrepareRasterPaint()
    if RasterGpuOn() && raster_gpu.rounded_outline != null {
        raster_gpu.rounded_outline(bounds, radius, width, color, raster_scale, raster_offset_x, raster_offset_y)
        return
    }
    RoundBox(bounds, radius)
    SetColor(color)
    SetLineWidth(paint, width)
    Stroke(paint)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    PrepareRasterPaint()
    if RasterGpuOn() && raster_gpu.line != null {
        raster_gpu.line(line, color, raster_scale, raster_offset_x, raster_offset_y)
        return
    }
    MoveTo(paint, line.x, line.y)
    LineTo(paint, (line.x + line.width),
        (line.y + line.height))
    SetColor(color)
    SetLineWidth(paint, 1.0)
    Stroke(paint)
}

// The triangles of one call are one shape, filled as one path so that
// antialiasing shows no seam where two of them meet.
#program_export
RasterTriangles :: (points: []Vector2, color: Color) {
    PrepareRasterPaint()
    if RasterGpuOn() && raster_gpu.triangles != null {
        raster_gpu.triangles(points, color, raster_scale, raster_offset_x, raster_offset_y)
        return
    }
    count: s64 = points.count - points.count % 3
    if count == 0 || color.a == cast(u8)0 { return }
    NewPath(paint)
    at: s64 = 0
    while at < count {
        MoveTo(paint, points[at].x, points[at].y)
        LineTo(paint, points[at + 1].x, points[at + 1].y)
        LineTo(paint, points[at + 2].x, points[at + 2].y)
        ClosePath(paint)
        at += 3
    }
    SetColor(color)
    Fill(paint)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    PrepareRasterPaint()
    no_rect: Rectangle; no_origin: Vector2
    if CairoGpuDrawText(value, x, y, font, color, false, no_rect, false, no_origin, 0.0, false, no_rect) {
        return
    }
    if !ShapedLayout(value, font, text_raster_typeface) { text_error = true; return }
    MoveTo(paint, cast(float64)x, cast(float64)y)
    SetColor(color)
    LayoutShow(paint, layout)
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    PrepareRasterPaint()
    no_rect: Rectangle; no_origin: Vector2
    if CairoGpuDrawText(value, x, y, font, color, true, clip, false, no_origin, 0.0, false, no_rect) {
        return
    }
    if !CairoTextOpen() { text_error = true; return }
    Save(paint)
    CanvasRectangle(paint, clip.x, clip.y,
        clip.width, clip.height)
    Clip(paint)
    RasterText(value, x, y, font, color)
    Restore(paint)
}

// The desktop's decoder for cursor pictures. kryon/cursor asks for it once a
// program imports the cursor API, so programs without one link no decoder.
#program_export
CursorPictureHost :: (asset_path: string, width: s32, height: s32,
    pixels: []u32, premultiplied: bool) -> bool {
    return CairoImagePixels(asset_path, width, height, pixels, premultiplied)
}

// Render an asset into caller-owned ARGB pixels, premultiplied as Cairo keeps
// them or straight. Scaling happens in premultiplied space, so transparent
// edges never pick up colour from fully transparent pixels. The image cache
// remains private to the raster host; no Cairo objects escape.
#program_export
CairoImagePixels :: (asset_path: string, width: s32, height: s32, pixels: []u32, premultiplied: bool) -> bool {
    if width <= 0 || height <= 0 || width > 8192 || height > 8192 ||
    cast(s64)width * cast(s64)height > pixels.count { return false }
    image := LoadPNG(asset_path)
    if image == null { return false }
    source_width := ImageSurfaceWidth(image)
    source_height := ImageSurfaceHeight(image)
    if source_width <= 0 || source_height <= 0 { return false }
    scaled := ImageSurfaceCreate(0, width, height)
    if scaled == null { return false }
    defer SurfaceDestroy(scaled)
    if SurfaceStatus(scaled) != 0 { return false }
    context := Create(scaled)
    if context == null { return false }
    Scale(context, cast(float64)width / cast(float64)source_width,
        cast(float64)height / cast(float64)source_height)
    pattern := PatternForSurface(image)
    // GOOD box-filters large reductions without Lanczos ringing at outlines.
    PatternFilter(pattern, CAIRO_FILTER_GOOD)
    SetSource(context, pattern)
    Paint(context)
    ok := Status(context) == 0
    PatternDestroy(pattern)
    Destroy(context)
    if !ok { return false }
    SurfaceFlush(scaled)
    bytes := ImageSurfaceData(scaled)
    for y: 0..height - 1 {
        for x: 0..width - 1 {
            pixel := (cast(*u32)(*bytes[y * ImageSurfaceStride(scaled) + x * 4])).*
            alpha := pixel >> 24
            if alpha == cast(u32)0 {
                pixel = cast(u32)0
            } else if !premultiplied && alpha < cast(u32)255 {
                half := alpha / cast(u32)2
                red := (((pixel >> 16) & cast(u32)255) * cast(u32)255 + half) / alpha
                green := (((pixel >> 8) & cast(u32)255) * cast(u32)255 + half) / alpha
                blue := ((pixel & cast(u32)255) * cast(u32)255 + half) / alpha
                if red > cast(u32)255 { red = cast(u32)255 }
                if green > cast(u32)255 { green = cast(u32)255 }
                if blue > cast(u32)255 { blue = cast(u32)255 }
                pixel = (alpha << 24) | (red << 16) | (green << 8) | blue
            }
            pixels[y * width + x] = pixel
        }
    }
    return true
}

// The named source's current picture, borrowed without copying.
CairoSourcePicture :: (picture: RasterPicture) -> *void {
    if picture.pixels == null || picture.width <= 0 || picture.height <= 0 {
        if picture_surface != null { SurfaceDestroy(picture_surface); picture_surface = null }
        return null
    }
    if picture_surface == null || picture_width != picture.width || picture_height != picture.height {
        if picture_surface != null { SurfaceDestroy(picture_surface) }
        picture_surface = ImageSurfaceBorrow(picture.pixels, 0, picture.width, picture.height, picture.width * 4)
        if picture_surface == null || SurfaceStatus(picture_surface) != 0 {
            if picture_surface != null { SurfaceDestroy(picture_surface) }
            picture_surface = null
            return null
        }
        picture_width = picture.width; picture_height = picture.height; picture_revision = 0
    }
    if picture_revision != picture.revision {
        picture_revision = picture.revision; SurfaceMarkDirty(picture_surface)
    }
    return picture_surface
}

// Retained frame textures use a separate ID range from managed Image uploads.
// Surfaces keep premultiplied Cairo pixels, so capturing never loses alpha.
CairoFrameTexture :: struct { texture: Texture2D; image: *void; bytes: s64; }
frame_textures: [16]CairoFrameTexture;
frame_texture_next: u32 = 1073741825;
frame_texture_bytes: s64;
frame_previous: Texture2D;
frame_source: *void;
frame_memory :: #system_library "c";
FrameCopyMemory :: (destination: *u8, source: *u8, size: usize) -> *void #foreign frame_memory "memcpy";

CairoFrameSlot :: (id: u32) -> s32 {
    if id == cast(u32)0 { return -1 }
    for index: cast(s32)0..15 {
        if frame_textures[index].texture.id == id { return index }
    }
    return -1
}
CairoFrameDrop :: (index: s32) {
    item := *frame_textures[index]
    if item.image == null { return }
    frame_texture_bytes -= item.bytes
    SurfaceDestroy(item.image)
    item.* = .{}
}
CairoFrameOwn :: (original: *void) -> Texture2D {
    if original == null || SurfaceStatus(original) != 0 { return .{} }
    width := ImageSurfaceWidth(original); height := ImageSurfaceHeight(original)
    bytes := cast(s64)width * cast(s64)height * 4
    if width <= 0 || height <= 0 || bytes > 268435456 - frame_texture_bytes ||
    frame_texture_next >= cast(u32)2147483648 { return .{} }
    index: s32 = -1
    for at: cast(s32)0..15 { if frame_textures[at].image == null { index = at; break } }
    if index < 0 { return .{} }
    copy := ImageSurfaceCreate(0, width, height)
    if copy == null || SurfaceStatus(copy) != 0 {
        if copy != null { SurfaceDestroy(copy) }
        return .{}
    }
    SurfaceFlush(original)
    input := ImageSurfaceData(original); output := ImageSurfaceData(copy)
    input_stride := ImageSurfaceStride(original); output_stride := ImageSurfaceStride(copy)
    for y: cast(s32)0..height - 1 {
        unused FrameCopyMemory(*output[cast(s64)y * output_stride],
            *input[cast(s64)y * input_stride], cast(usize)width * 4)
    }
    SurfaceMarkDirty(copy)
    texture := Texture2D.{frame_texture_next, width, height, 1, 7}
    frame_texture_next += cast(u32)1
    frame_textures[index] = CairoFrameTexture.{texture, copy, bytes}
    frame_texture_bytes += bytes
    return texture
}
CairoFrameImage :: (id: u32) -> *void {
    index := CairoFrameSlot(id)
    if index < 0 { return null }
    // RasterImage releases one reference after the synchronous draw.
    return SurfaceReference(frame_textures[index].image)
}
CairoFramePresented :: (finished: *void) {
    // A secondary window must not replace the main window's previous frame.
    if finished != frame_source { return }
    previous := CairoFrameSlot(frame_previous.id)
    if previous >= 0 { CairoFrameDrop(previous) }
    frame_previous = CairoFrameOwn(finished)
}
CairoFramesClose :: () {
    for index: cast(s32)0..15 { CairoFrameDrop(index) }
    frame_previous = .{}
    frame_source = null
}
// The desktop closes the optional frame store at final shutdown. Raster
// resize replaces the paint target, while independent transition copies live.
RasterFramesClose :: () {
    if raster_frames_close != null { raster_frames_close() }
}

#program_export
RetainedPreviousFrameTexture :: () -> Texture2D {
    raster_frame_image = CairoFrameImage
    raster_frame_present = CairoFramePresented
    raster_frames_close = CairoFramesClose
    if RasterGpuOn() { unused RasterReadbackGpuSurface() }
    frame_source = surface
    // First use can copy an intact presented frame. Otherwise begin tracking
    // at the next successful presentation, leaving the snapshot invalid.
    if frame_previous.id == cast(u32)0 && surface != null &&
    raster_presented_surface == surface {
        frame_previous = CairoFrameOwn(surface)
    }
    return frame_previous
}

FrameSurfaceProps :: #import "frame_surface";
#program_export
FramePreviousSnapshotHost :: () -> FrameSurfaceProps.FrameSurface {
    return FrameSurfaceProps.FrameSurface.{CopyFrameTexture(RetainedPreviousFrameTexture()), true}
}

#program_export
CopyFrameTexture :: (texture: Texture2D) -> Texture2D {
    index := CairoFrameSlot(texture.id)
    if index < 0 { return .{} }
    item := frame_textures[index]
    if item.texture.width != texture.width || item.texture.height != texture.height ||
    texture.mipmaps != 1 || texture.format != 7 { return .{} }
    return CairoFrameOwn(item.image)
}

#program_export
DisposeFrameTexture :: (texture: Texture2D) {
    index := CairoFrameSlot(texture.id)
    if index < 0 || texture.id == frame_previous.id { return }
    stored := frame_textures[index].texture
    if stored.width == texture.width && stored.height == texture.height &&
    texture.mipmaps == 1 && texture.format == 7 { CairoFrameDrop(index) }
}

#if OS != .WEB && !#defined(ANDROID_BUILD) {
    // Image previews share the desktop's bounded, oriented memory decoder.
    PreviewDecode :: #import "ziran_image_decode";

    #program_export
    ImagePreviewDecode :: (data: string, file_type: string, width: *s32, height: *s32,
        channels: *s32, upright: *bool) -> *u8 {
        width.* = 0; height.* = 0; channels.* = 0
        upright.* = true
        image := PreviewDecode.ImageDecodeEncoded(data, file_type)
        if image.pixels == null { return null }
        width.* = image.width; height.* = image.height; channels.* = 4
        return image.pixels
    }

    #program_export
    ImagePreviewRelease :: (pixels: *u8) {
        PreviewDecode.ImagePixelsFree(pixels)
    }
}

// File and folder invalidation release both the original and any in-flight
// smooth copies. A fresh load receives a new serial, never the old job's ID.
CairoForgetCachedImage :: (index: s32) {
    item := *cached_images[index]
    if item.image == null { return }
    image_bytes -= item.bytes
    Lanczos.LanczosForget(item.serial)
    if raster_gpu.active && raster_gpu.invalidate_images != null { raster_gpu.invalidate_images() }
    SurfaceDestroy(item.image)
    item.* = .{}
}

CairoImageInFolder :: (path: string, folder: string) -> bool {
    length := folder.count
    while length > 1 && (folder[length - 1] == cast(u8)47 ||
        folder[length - 1] == cast(u8)92) { length -= 1 }
    if length == 0 || path.count < length || path[:length] != folder[:length] { return false }
    return path.count == length || folder[length - 1] == cast(u8)47 ||
    folder[length - 1] == cast(u8)92 || path[length] == cast(u8)47 || path[length] == cast(u8)92
}

#program_export
RasterInvalidateImages :: () -> s32 {
    removed: s32
    for index: cast(s32)0..127 {
        if cached_images[index].image != null {
            CairoForgetCachedImage(index)
            removed += 1
        }
    }
    if removed > 0 { PaintResourcesChanged() }
    return removed
}

#program_export
RasterInvalidateImage :: (path: string) -> bool {
    if path.count == 0 { return false }
    removed := false
    for index: cast(s32)0..127 {
        item := *cached_images[index]
        if item.image == null { continue }
        if TextView(item.path[:item.length]) == path ||
        TextView(item.source[:item.source_length]) == path {
            CairoForgetCachedImage(index)
            removed = true
        }
    }
    if removed { PaintResourcesChanged() }
    return removed
}

// Folder boundaries matter: invalidating icons/ never discards icons-old/.
// Both requested asset names and resolved file paths identify cached pictures.
#program_export
RasterInvalidateImagesIn :: (folder: string) -> s32 {
    if folder.count == 0 { return 0 }
    removed: s32
    for index: cast(s32)0..127 {
        item := *cached_images[index]
        if item.image == null { continue }
        if CairoImageInFolder(TextView(item.path[:item.length]), folder) ||
        CairoImageInFolder(TextView(item.source[:item.source_length]), folder) {
            CairoForgetCachedImage(index)
            removed += 1
        }
    }
    if removed > 0 { PaintResourcesChanged() }
    return removed
}

LoadPNG :: (original_path: string) -> *void {
    raster_pictures_close = CairoPicturesClose
    if raster_picture_source != null {
        picture: RasterPicture
        if raster_picture_source(original_path, *picture) { return CairoSourcePicture(picture) }
    }
    resolved: [4096]u8
    asset_path := ResolveAppAsset(original_path, resolved[:])
    embedded: [64]u8
    if raster_asset_path != null {
        found := raster_asset_path(original_path, embedded[:])
        if found != "" { asset_path = found }
    }
    length: s32 = cast(s32)asset_path.count
    if length == 0 || length >= 4096 { return null }
    image_clock += 1
    for i: 0..127 {
        cached := *cached_images[i]
        if cached.image == null || cached.length != length { continue }
        if TextView(cached.path[:length]) == asset_path {
            cached.used = image_clock
            return cached.image
        }
    }
    path: [4096]u8
    if !CopyCString(asset_path, path[:]) { return null }
    image: *void
    // AVIF and WebP are recognized by content; other formats keep GdkPixbuf
    // and, without it, Cairo's PNG reader.
    webp := Decode.OpenStill(asset_path)
    if webp.pixels != null {
        image = ImageSurfaceCreate(0, webp.width, webp.height)
        if image == null || SurfaceStatus(image) != 0 ||
        !Decode.CopyWebP(webp, ImageSurfaceData(image), ImageSurfaceStride(image)) {
            if image != null { SurfaceDestroy(image) }
            image = null
        }
        Decode.CloseStill(webp)
        if image != null { SurfaceMarkDirty(image) }
    } else if !Decode.AVIFFile(asset_path) {
        decoded := Decode.OpenImage(*path[0])
        if decoded != null {
            image = ImageSurfaceCreate(0, Decode.Width(decoded), Decode.Height(decoded))
            if image == null || SurfaceStatus(image) != 0 ||
            !Decode.CopyPixels(decoded, ImageSurfaceData(image), ImageSurfaceStride(image)) {
                if image != null { SurfaceDestroy(image) }
                image = null
            }
            Decode.CloseImage(decoded)
            if image != null { SurfaceMarkDirty(image) }
        } else {
            image = ImageSurfaceFromPNG(*path[0])
        }
    }
    if image == null { return null }
    if SurfaceStatus(image) != 0 {
        SurfaceDestroy(image)
        return null
    }
    bytes := cast(s64)ImageSurfaceStride(image) * cast(s64)ImageSurfaceHeight(image)
    slot: s32 = -1
    while slot < 0 || image_bytes + bytes > 268435456 {
        oldest: s32 = -1
        for i: 0..127 {
            if cached_images[i].image == null { if slot < 0 { slot = cast(s32)i }; continue }
            if oldest < 0 || cached_images[i].used < cached_images[oldest].used { oldest = cast(s32)i }
        }
        if slot >= 0 && image_bytes + bytes <= 268435456 { break }
        if oldest < 0 { SurfaceDestroy(image); return null }
        CairoForgetCachedImage(oldest)
        if slot < 0 { slot = oldest }
    }
    cached_images[slot].path = path; cached_images[slot].length = length
    if original_path.count < 4096 && CopyCString(original_path, cached_images[slot].source[:]) {
        cached_images[slot].source_length = cast(s32)original_path.count
    }
    cached_images[slot].image = image; cached_images[slot].used = image_clock; cached_images[slot].bytes = bytes
    image_serial += 1; cached_images[slot].serial = image_serial
    image_bytes += bytes
    return image
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    CairoUsePictures()
    image: *void = LoadPNG(asset_path)
    if image == null { return 0 }
    return ImageSurfaceWidth(image)
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    CairoUsePictures()
    image: *void = LoadPNG(asset_path)
    if image == null { return 0 }
    return ImageSurfaceHeight(image)
}

// White RGB with a lower alpha is an image fade. Preserve the source colours;
// coloured tints retain the host's existing alpha-mask recolouring behaviour.
PaintImagePattern :: (pattern: *void, tint: Color) {
    if tint.r == cast(u8)255 && tint.g == cast(u8)255 && tint.b == cast(u8)255 {
        SetSource(paint, pattern)
        if tint.a == cast(u8)255 { Paint(paint) }
        else { PaintAlpha(paint, cast(float64)tint.a / 255.0) }
    } else {
        SetColor(tint)
        MaskPattern(paint, pattern)
    }
}

// A managed source borrows its immutable premultiplied copy only while this
// synchronous paint runs. Never retain a scaled cache keyed by this surface.
// Managed surfaces borrow store pixels for one draw. Callers release them on
// every exit explicitly, because loops below cannot share names with a defer.
CairoReleaseManaged :: (texture_id: u32, image: *void) {
    if texture_id != cast(u32)0 && image != null { SurfaceDestroy(image) }
}
CairoManagedImage :: (id: u32) -> *void {
    at := Bitmaps.BitmapSlot(id)
    if at < 0 { return null }
    item := *Bitmaps.bitmap_images[at]
    image := ImageSurfaceBorrow(cast(*u8)*item.premultiplied[0], 0,
        item.image.width, item.image.height, item.image.width * 4)
    if image != null && SurfaceStatus(image) != 0 { SurfaceDestroy(image); return null }
    return image
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    PrepareRasterPaint()
    if (texture_id == cast(u32)0 && asset_path.count == 0) ||
    !Finite32(source.x) || !Finite32(source.y) || !Finite32(source.width) || !Finite32(source.height) ||
    !Finite32(destination.x) || !Finite32(destination.y) || !Finite32(destination.width) || !Finite32(destination.height) ||
    !Finite32(clip.x) || !Finite32(clip.y) || !Finite32(clip.width) || !Finite32(clip.height) ||
    !Finite32(origin.x) || !Finite32(origin.y) || !Finite32(rotation) || !Finite32(radius) ||
    source.width == 0.0 || source.height == 0.0 ||
    destination.width <= 0.0 || destination.height <= 0.0 ||
    clip.width <= 0.0 || clip.height <= 0.0 {
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    image := CairoPictureFor(asset_path, texture_id)
    if image == null {
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    if RasterGpuOn() && raster_gpu.image != null && radius <= 0.0 {
        SurfaceFlush(image)
        img_w := ImageSurfaceWidth(image)
        img_h := ImageSurfaceHeight(image)
        serial: u64 = 0
        if texture_id == cast(u32)0 {
            serial = CairoImageSerial(image)
            if serial == cast(u64)0 && image == picture_surface { serial = picture_revision }
        } else {
            slot := Bitmaps.BitmapSlot(texture_id)
            if slot >= 0 { serial = Bitmaps.bitmap_images[slot].revision }
        }
        polygon := CurrentPaintPolygon()
        args: RasterGpuImageArgs = .{
            image, texture_id, serial, img_w, img_h,
            ImageSurfaceData(image), ImageSurfaceStride(image),
            source, destination, clip, origin, rotation, tint,
            CurrentPaintSmooth(), polygon, raster_scale, raster_offset_x, raster_offset_y
        }
        if raster_gpu.image(*args) {
            CairoReleaseManaged(texture_id, image)
            return
        }
    }
    if RasterGpuOn() && raster_gpu.image != null && radius > 0.0 {
        // Rounded-corner image: rasterize just the clipped image bounds into a
        // small scratch surface and composite on the GPU.
        bw := CairoCeilS32(cast(float64)clip.width * raster_scale)
        bh := CairoCeilS32(cast(float64)clip.height * raster_scale)
        if bw > 0 && bh > 0 && bw <= 4096 && bh <= 4096 {
            scratch := ImageSurfaceCreate(0, bw, bh)
            if scratch != null && SurfaceStatus(scratch) == 0 {
                ctx := Create(scratch)
                if ctx != null {
                    Scale(ctx, raster_scale, raster_scale)
                    Translate(ctx, -cast(float64)clip.x, -cast(float64)clip.y)
                    prev := RasterUseTarget(RasterTarget.{scratch, ctx, false})
                    RasterImage(asset_path, texture_id, source, destination, clip, origin, rotation, radius, tint)
                    unused RasterUseTarget(prev)
                    Destroy(ctx)
                    SurfaceFlush(scratch)
                    empty_poly: []Vector2
                    no_orig: Vector2
                    white := Color.{255, 255, 255, 255}
                    args: RasterGpuImageArgs = .{
                        null, 0, 0, bw, bh,
                        ImageSurfaceData(scratch), ImageSurfaceStride(scratch),
                        Rectangle.{0.0, 0.0, cast(float32)bw, cast(float32)bh},
                        clip, clip, no_orig, 0.0, white, true, empty_poly,
                        raster_scale, raster_offset_x, raster_offset_y
                    }
                    unused raster_gpu.image(*args)
                }
                SurfaceDestroy(scratch)
                CairoReleaseManaged(texture_id, image)
                return
            }
            if scratch != null { SurfaceDestroy(scratch) }
        }
    }
    mirror_x := source.width < 0.0; mirror_y := source.height < 0.0
    if mirror_x { source.width = -source.width }
    if mirror_y { source.height = -source.height }
    sampled: *Lanczos.LanczosEntry
    snapped: Rectangle
    // Mirrored sources keep Cairo's filter; cached copies have positive axes.
    if !mirror_x && !mirror_y && texture_id == cast(u32)0 && raster_picture_smooth != null && rotation == 0.0 &&
    origin.x == 0.0 && origin.y == 0.0 && CurrentPaintSmooth() {
        sampled = raster_picture_smooth(image, source, destination, *snapped)
    }
    Save(paint)
    polygon := CurrentPaintPolygon()
    // Adjacent rectangular images own whole device pixels at their shared
    // edge. Antialiasing each clip separately blends both with the clear
    // colour and leaves a seam, including over a snapped Lanczos copy.
    // Rounded, polygonal and rotated images retain their smooth outlines.
    rectangular := radius <= 0.0 && rotation == 0.0 && polygon.count < 3
    if rectangular { SetAntialias(paint, 1) }
    matrix: CairoMatrix; GetMatrix(paint, *matrix)
    device_pixels := rectangular && matrix.xx > 0.0 && matrix.yy > 0.0 &&
    matrix.xy == 0.0 && matrix.yx == 0.0
    // Cairo's aliased clip and the cached copy disagree at exact half
    // pixels. Round both to the copy's device edges, also while it loads.
    image_clip := ifx device_pixels then RasterSnapRectangle(clip) else clip
    RoundBox(image_clip, radius)
    Clip(paint)
    if polygon.count >= 3 {
        NewPath(paint)
        MoveTo(paint, destination.x + polygon[0].x * destination.width,
            destination.y + polygon[0].y * destination.height)
        for at: cast(s64)1..polygon.count - 1 {
            LineTo(paint, destination.x + polygon[at].x * destination.width,
                destination.y + polygon[at].y * destination.height)
        }
        ClosePath(paint); Clip(paint)
    }
    if sampled != null {
        // The copy covers whole device pixels: one pixel each, or scaled
        // while it is a copy of another size.
        CanvasRectangle(paint, snapped.x, snapped.y, snapped.width, snapped.height)
        Clip(paint)
        Translate(paint, cast(float64)snapped.x, cast(float64)snapped.y)
        exact := sampled.key.width == cast(s32)snapped.width && sampled.key.height == cast(s32)snapped.height
        if !exact {
            Scale(paint, cast(float64)snapped.width / cast(float64)sampled.key.width,
                cast(float64)snapped.height / cast(float64)sampled.key.height)
        }
        pattern := PatternForSurface(sampled.surface)
        PatternExtend(pattern, 3)
        PatternFilter(pattern, ifx exact then CAIRO_FILTER_NEAREST else CAIRO_FILTER_GOOD)
        PaintImagePattern(pattern, tint)
        PatternDestroy(pattern); Restore(paint)
        CairoReleaseManaged(texture_id, image); return
    }
    if device_pixels {
        covered := destination
        covered.x -= origin.x; covered.y -= origin.y
        covered = RasterSnapRectangle(covered)
        CanvasRectangle(paint, covered.x, covered.y, covered.width, covered.height)
        Clip(paint)
    }
    Translate(paint, destination.x,
        destination.y)
    Rotate(paint, cast(float64)rotation *
        3.14159265358979323846 / 180.0)
    Translate(paint, -cast(float64)origin.x,
        -cast(float64)origin.y)
    if !device_pixels {
        CanvasRectangle(paint, 0.0, 0.0,
            destination.width,
            destination.height)
        Clip(paint)
    }
    if mirror_x { Translate(paint, cast(float64)destination.width, 0.0); Scale(paint, -1.0, 1.0) }
    if mirror_y { Translate(paint, 0.0, cast(float64)destination.height); Scale(paint, 1.0, -1.0) }
    Scale(paint, cast(float64)destination.width /
        cast(float64)source.width,
        cast(float64)destination.height / cast(float64)source.height)
    Translate(paint, -cast(float64)source.x, -cast(float64)source.y)
    pattern: *void = PatternForSurface(image)
    if pattern == null {
        Restore(paint)
        CairoReleaseManaged(texture_id, image)
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    // Without a smooth copy, a smooth image uses Cairo's good filter: the
    // best one reaches far past a source rectangle into the picture around
    // it, so tiles cut from one sheet bleed their neighbours into the seams.
    PatternFilter(pattern, ifx CurrentPaintSmooth() then CAIRO_FILTER_GOOD else CAIRO_FILTER_NEAREST)
    // Filtering a full image at its edge must sample its edge pixel rather
    // than transparent pixels beyond the surface while its copy is loading.
    if rectangular { PatternExtend(pattern, 3) }
    PaintImagePattern(pattern, tint)
    PatternDestroy(pattern)
    Restore(paint)
    CairoReleaseManaged(texture_id, image)
}

// A warped image (see ImageMesh): each triangle of each grid cell is the
// image drawn through the source-to-surface transform of its corners,
// clipped to the triangle. Managed bitmaps use the same source surface.
#program_export
RasterImageMesh :: (asset_path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) {
    PrepareRasterPaint()
    if columns < 2 || rows < 2 || !Finite32(clip.x) || !Finite32(clip.y) ||
    !Finite32(clip.width) || !Finite32(clip.height) || clip.width <= 0.0 || clip.height <= 0.0 ||
    !Finite32(source.x) || !Finite32(source.y) || !Finite32(source.width) || !Finite32(source.height) ||
    source.width == 0.0 || source.height == 0.0 {
        print("Kryon: skipped image mesh: invalid geometry\n"); return
    }
    count: s64 = cast(s64)columns * cast(s64)rows
    if count > cast(s64)ImageSchema.IMAGE_MESH_POINT_LIMIT || points.count < count { return }
    if texture_id == cast(u32)0 && asset_path.count == 0 {
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    image := CairoPictureFor(asset_path, texture_id)
    if image == null {
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    if RasterGpuOn() && raster_gpu.image_mesh != null {
        SurfaceFlush(image)
        img_w := ImageSurfaceWidth(image)
        img_h := ImageSurfaceHeight(image)
        serial: u64 = 0
        if texture_id == cast(u32)0 {
            serial = CairoImageSerial(image)
            if serial == cast(u64)0 && image == picture_surface { serial = picture_revision }
        } else {
            slot := Bitmaps.BitmapSlot(texture_id)
            if slot >= 0 { serial = Bitmaps.bitmap_images[slot].revision }
        }
        args: RasterGpuMeshArgs = .{
            image, texture_id, serial, img_w, img_h,
            ImageSurfaceData(image), ImageSurfaceStride(image),
            source, points, columns, rows, clip, tint, CurrentPaintSmooth(),
            raster_scale, raster_offset_x, raster_offset_y
        }
        if raster_gpu.image_mesh(*args) {
            CairoReleaseManaged(texture_id, image)
            return
        }
    }
    Save(paint)
    CanvasRectangle(paint, cast(float64)clip.x, cast(float64)clip.y,
        cast(float64)clip.width, cast(float64)clip.height)
    Clip(paint)
    for row: cast(s32)0..rows - 2 {
        for column: cast(s32)0..columns - 2 {
            top_left: s32 = row * columns + column
            bottom_left: s32 = top_left + columns
            left_share: float32 = cast(float32)column / cast(float32)(columns - 1)
            right_share: float32 = cast(float32)(column + 1) / cast(float32)(columns - 1)
            top_share: float32 = cast(float32)row / cast(float32)(rows - 1)
            bottom_share: float32 = cast(float32)(row + 1) / cast(float32)(rows - 1)
            a := CairoMeshSource(source, left_share, top_share)
            b := CairoMeshSource(source, right_share, top_share)
            c := CairoMeshSource(source, left_share, bottom_share)
            d := CairoMeshSource(source, right_share, bottom_share)
            CairoMeshTriangle(image, points[top_left], a, points[top_left + 1], b,
                points[bottom_left], c, tint)
            CairoMeshTriangle(image, points[top_left + 1], b, points[bottom_left + 1], d,
                points[bottom_left], c, tint)
        }
    }
    Restore(paint)
    CairoReleaseManaged(texture_id, image)
}

// Cairo samples a picture through its screen-to-picture steps in 16.16
// fixed point. A warped triangle that squeezes more picture pixels than
// this into one screen pixel, such as a sliver whose corners nearly meet,
// cannot be sampled: Cairo fails the whole surface with NO_MEMORY and the
// frame is lost. Such a triangle covers less than a pixel, so it is left
// out. The bound leaves room for the frame's own scale.
CAIRO_SAMPLING_LIMIT :: 4096.0

CairoSamplingFits :: (xx: float64, xy: float64, yx: float64, yy: float64) -> bool {
    steps: [4]float64 = .[xx, xy, yx, yy]
    for step: steps {
        // NaN fails both comparisons.
        if !(step <= CAIRO_SAMPLING_LIMIT && step >= -CAIRO_SAMPLING_LIMIT) { return false }
    }
    return true
}

// The source point at a share of the source rectangle; a negative width or
// height mirrors it, as for RasterImage.
CairoMeshSource :: (source: Rectangle, fx: float32, fy: float32) -> Vector2 {
    x: float32 = source.x + source.width * fx
    if source.width < 0.0 { x = source.x - source.width + source.width * fx }
    y: float32 = source.y + source.height * fy
    if source.height < 0.0 { y = source.y - source.height + source.height * fy }
    return Vector2.{x, y}
}

CairoMeshTriangle :: (image: *void, a: Vector2, a_source: Vector2,
    b: Vector2, b_source: Vector2, c: Vector2, c_source: Vector2, tint: Color) {
    u0: float64 = cast(float64)a_source.x
    v0: float64 = cast(float64)a_source.y
    u1: float64 = cast(float64)b_source.x
    v1: float64 = cast(float64)b_source.y
    u2: float64 = cast(float64)c_source.x
    v2: float64 = cast(float64)c_source.y
    x0: float64 = cast(float64)a.x
    y0: float64 = cast(float64)a.y
    x1: float64 = cast(float64)b.x
    y1: float64 = cast(float64)b.y
    x2: float64 = cast(float64)c.x
    y2: float64 = cast(float64)c.y
    determinant: float64 = (u1 - u0) * (v2 - v0) - (u2 - u0) * (v1 - v0)
    area: float64 = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
    if determinant == 0.0 || area == 0.0 || determinant != determinant || area != area { return }
    // Picture pixels per screen pixel along each axis, which a sliver
    // triangle makes enormous.
    if !CairoSamplingFits(((u1 - u0) * (y2 - y0) - (u2 - u0) * (y1 - y0)) / area,
        ((u2 - u0) * (x1 - x0) - (u1 - u0) * (x2 - x0)) / area,
        ((v1 - v0) * (y2 - y0) - (v2 - v0) * (y1 - y0)) / area,
        ((v2 - v0) * (x1 - x0) - (v1 - v0) * (x2 - x0)) / area) { return }
    Save(paint)
    // An aliased clip gives each pixel to exactly one of two triangles that
    // share an edge, so neighbors leave no seam and never paint twice.
    SetAntialias(paint, 1)
    NewPath(paint)
    MoveTo(paint, x0, y0)
    LineTo(paint, x1, y1)
    LineTo(paint, x2, y2)
    ClosePath(paint)
    Clip(paint)
    matrix: CairoMatrix
    matrix.xx = ((x1 - x0) * (v2 - v0) - (x2 - x0) * (v1 - v0)) / determinant
    matrix.yx = ((y1 - y0) * (v2 - v0) - (y2 - y0) * (v1 - v0)) / determinant
    matrix.xy = ((x2 - x0) * (u1 - u0) - (x1 - x0) * (u2 - u0)) / determinant
    matrix.yy = ((y2 - y0) * (u1 - u0) - (y1 - y0) * (u2 - u0)) / determinant
    matrix.x0 = x0 - matrix.xx * u0 - matrix.xy * v0
    matrix.y0 = y0 - matrix.yx * u0 - matrix.yy * v0
    TransformBy(paint, *matrix)
    pattern: *void = PatternForSurface(image)
    if pattern == null {
        Restore(paint)
        print("Kryon: skipped image: invalid or unavailable picture\n")
        return
    }
    // Use the same smooth filter as an ordinary image. BEST makes a tiny
    // source strip stretched in opposing directions costly per triangle.
    PatternFilter(pattern, ifx CurrentPaintSmooth() then CAIRO_FILTER_GOOD else CAIRO_FILTER_NEAREST)
    // The triangle already clips the geometry. Pad the source so filtering a
    // one-pixel outer row does not blend it with transparent pixels beyond it.
    PatternExtend(pattern, 3)
    PaintImagePattern(pattern, tint)
    PatternDestroy(pattern)
    Restore(paint)
}

#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle, origin: Vector2, rotation: float32,
    outer_clip: Rectangle, outer_clipped: bool, emphasis: bool, italic: bool) {
    PrepareRasterPaint()
    unused italic
    stroke := ifx emphasis then (ifx font / 24 > 0 then font / 24 else 1) else 0
    if CairoGpuDrawText(value, x + stroke, y, font, color, true, clip,
        true, origin, rotation, outer_clipped, outer_clip) {
        return
    }
    Save(paint)
    if outer_clipped { NewPath(paint); CanvasRectangle(paint,outer_clip.x,outer_clip.y,outer_clip.width,outer_clip.height); Clip(paint) }
    Translate(paint,origin.x,origin.y); Rotate(paint,cast(float64)rotation*0.017453292519943295)
    Translate(paint,-origin.x,-origin.y)
    RasterTextClipped(value,x+stroke,y,font,color,clip)
    Restore(paint)
}
