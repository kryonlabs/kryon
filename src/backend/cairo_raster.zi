// Parts of the rasterizer register themselves the first time a frame uses
// them, so a window that never draws text or a picture carries neither:
// pictures (and their smooth copies) and text each leave a procedure that
// CloseRaster runs once and forgets.
RasterRelease :: #type () -> void;
RasterPump :: #type () -> bool;
raster_pictures_close: RasterRelease;
raster_text_close: RasterRelease;
// Smooth copies of pictures: pumped each frame, waited for by a capture.
raster_smooth_pump: RasterPump;
raster_smooth_wait: RasterPump;
raster_smooth_close: RasterRelease;
// Run when a smooth copy finishes on another thread; it must only wake.
RasterWake :: #type (argument: *void) #c_call;
raster_wake: RasterWake;
RasterWakeWindow :: (argument: *void) {
    if raster_wake != null { raster_wake(argument) }
}

#import "raster_picture"
picture_surface: *void;
picture_revision: u64;
picture_width: s32;
picture_height: s32;

// The window's wake for finished smooth copies; see LanczosSetWake.
RasterUseWake :: (wake: RasterWake) { raster_wake = wake }

// True while a smooth copy a capture waits for was still being made.
RasterSettle :: () -> bool {
    return raster_smooth_wait != null && raster_smooth_wait()
}

