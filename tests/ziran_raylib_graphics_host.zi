#import "raylib_image_decode"
#import "raylib_runtime"
#import "ziran_raylib_retained_host"
#import "drawing_props"
#import "raylib_clip"

texture_loads: s32;
texture_unloads: s32;
font_unloads: s32;
flushes: s32;
context_epoch: s32 = 1;
lost_context: bool;
graphics_failed: bool;
// Each texture load advances the fake clock by this many seconds.
load_seconds: float64;
clock_seconds: float64;
// Mipmaps built and trilinear filters set for smooth images.
texture_mipmaps: s32;
smooth_filters: s32;

#program_export
GetTime :: () -> float64 { return clock_seconds }

#program_export
GetScreenWidth :: () -> s32 { return 100 }
#program_export
GetScreenHeight :: () -> s32 { return 100 }

#program_export
ClearBackground :: (color: Color) { unused color }

// The frame is not zoomed here; BeginRaylibFrame only scales a zoomed one.
#program_export
rlScalef :: (x: float32, y: float32, z: float32) { unused x; unused y; unused z; graphics_failed = true }

#program_export
LoadTexture :: (path: *u8) -> Texture2D {
    unused path
    texture_loads += 1
    clock_seconds += load_seconds
    return Texture2D.{cast(u32)(context_epoch * 1000 + texture_loads),
        200, 100, 1, 7}
}

// A sideways camera JPEG: Exif orientation 6, stored turned left.
sideways_jpeg: [40]u8 = .[255, 216, 255, 225, 0, 34, 69, 120, 105, 102, 0, 0,
77, 77, 0, 42, 0, 0, 0, 8, 0, 1, 1, 18, 0, 3, 0, 0, 0, 1, 0, 6,
0, 0, 0, 0, 0, 0, 255, 217];
photo_pixels: [4]u8;
file_frees: s32;
image_unloads: s32;
clockwise_turns: s32;
// Turns and flips other than one clockwise turn.
other_turns: s32;

#program_export
LoadFileData :: (path: *u8, size: *s32) -> *u8 {
    unused path
    size.* = 40
    return *sideways_jpeg[0]
}

#program_export
UnloadFileData :: (data: *u8) {
    if data != *sideways_jpeg[0] { graphics_failed = true }
    file_frees += 1
}

#program_export
LoadImageFromMemory :: (file_type: *u8, data: *u8, size: s32) -> RaylibGlyphImage {
    unused file_type
    if data != *sideways_jpeg[0] || size != 40 { graphics_failed = true }
    return RaylibGlyphImage.{cast(*void)*photo_pixels[0], 100, 200, 1, 7}
}

#program_export
ImageRotateCW :: (image: *RaylibGlyphImage) {
    width := image.width
    image.width = image.height
    image.height = width
    clockwise_turns += 1
}

#program_export
ImageRotateCCW :: (image: *RaylibGlyphImage) { unused image; other_turns += 1 }

#program_export
ImageFlipHorizontal :: (image: *RaylibGlyphImage) { unused image; other_turns += 1 }

#program_export
ImageFlipVertical :: (image: *RaylibGlyphImage) { unused image; other_turns += 1 }

#program_export
LoadTextureFromImage :: (image: RaylibGlyphImage) -> Texture2D {
    texture_loads += 1
    return Texture2D.{cast(u32)(context_epoch * 1000 + texture_loads),
        image.width, image.height, 1, image.format}
}

#program_export
UnloadImage :: (image: RaylibGlyphImage) {
    if image.data != cast(*void)*photo_pixels[0] { graphics_failed = true }
    image_unloads += 1
}

#program_export
UnloadTexture :: (texture: Texture2D) {
    if lost_context || texture.id == 0 || flushes == 0 {
        graphics_failed = true
    }
    texture_unloads += 1
}

#program_export
SetTextureFilter :: (texture: Texture2D, filter: s32) {
    if lost_context || texture.id == 0 || (filter != 1 && filter != 2) {
        graphics_failed = true
    }
    // Trilinear filtering follows the mipmaps of the same texture.
    if filter == 2 {
        smooth_filters += 1
        if texture.mipmaps < 2 { graphics_failed = true }
    }
}

#program_export
GenTextureMipmaps :: (texture: *Texture2D) {
    if lost_context || texture == null || texture.id == 0 || flushes == 0 {
        graphics_failed = true
        return
    }
    texture.mipmaps = 8
    texture_mipmaps += 1
}

#program_export
rlDrawRenderBatchActive :: () {
    if lost_context {
        graphics_failed = true
    }
    flushes += 1
}

#program_export
LoadFontFromMemory :: (extension: *u8, bytes: *u8, byte_count: s32,
    size: s32, codepoints: *s32, count: s32) -> RaylibFont {
    unused extension
    unused bytes
    unused byte_count
    unused size
    unused codepoints
    unused count
    font: RaylibFont
    font.texture = Texture2D.{cast(u32)(context_epoch * 1000 + 900),
        64, 64, 1, 7}
    return font
}

#program_export
UnloadFont :: (font: RaylibFont) {
    if lost_context && font.texture.id != 0 {
        graphics_failed = true
    }
    font_unloads += 1
}

#program_export
LoadFontEx :: (path: *u8, size: s32, codepoints: *s32,
    count: s32) -> RaylibFont {
    unused path
    unused size
    unused codepoints
    unused count
    graphics_failed = true
    return RaylibFont.{}
}

#program_export
rlGetMatrixModelview :: () -> RaylibMatrix {
    graphics_failed = true
    return RaylibMatrix.{}
}

#program_export
glIsEnabled :: (capability: u32) -> u8 {
    unused capability
    graphics_failed = true
    return 0
}

#program_export
glGetIntegerv :: (parameter: u32, values: *s32) {
    unused parameter
    unused values
    graphics_failed = true
}

#program_export
BeginScissorMode :: (x: s32, y: s32, width: s32, height: s32) {
    unused x
    unused y
    unused width
    unused height
    graphics_failed = true
}

#program_export
EndScissorMode :: () {
    graphics_failed = true
}

#program_export
rlEnableScissorTest :: () {
    graphics_failed = true
}

#program_export
rlScissor :: (x: s32, y: s32, width: s32, height: s32) {
    unused x
    unused y
    unused width
    unused height
    graphics_failed = true
}
