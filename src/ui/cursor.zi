#import "widget_kind"
#import "session"

// The shape is a UI decision. The platform only applies the selected shape.
// CursorSet selects an asset, system shape or visibility until changed.
CursorShape :: enum {
    CursorDefault :: 0
    CursorArrow :: 1
    CursorText :: 2
    CursorCrosshair :: 3
    CursorClickable :: 4
    CursorResizeHorizontal :: 5
    CursorResizeVertical :: 6
    CursorResizeDown :: 7
    CursorResizeUp :: 8
    CursorResizeAll :: 9
    CursorDisabled :: 10
}
using CursorShape;
using WidgetKind;


CursorFrame :: struct {
    applied: s32
    requested: s32
    priority: s32
    has_request: bool
}

CursorDecision :: struct {
    state: CursorFrame
    apply: bool
}

#program_export
CursorBeginFrame :: (state: CursorFrame) -> CursorFrame {
    state.requested = state.applied
    state.priority = 0
    state.has_request = false
    return state
}

#program_export
CursorPriorityFor :: (shape: s32) -> s32 {
    if shape == cast(s32)CursorDisabled { return 1 }
    if shape == cast(s32)CursorText { return 2 }
    if shape == cast(s32)CursorResizeHorizontal ||
        shape == cast(s32)CursorResizeVertical ||
        shape == cast(s32)CursorResizeDown ||
        shape == cast(s32)CursorResizeUp ||
        shape == cast(s32)CursorResizeAll { return 4 }
    if shape == cast(s32)CursorDefault { return 0 }
    return 3
}

#program_export
CursorShapeForWidget :: (kind: WidgetKind,
    disabled: bool) -> s32 {
    if disabled { return cast(s32)CursorDisabled }
    if kind == cast(WidgetKind)WidgetKindTextField ||
        kind == cast(WidgetKind)WidgetKindTextArea {
        return cast(s32)CursorText
    }
    if kind == cast(WidgetKind)WidgetKindButton ||
        kind == cast(WidgetKind)WidgetKindCard ||
        kind == cast(WidgetKind)WidgetKindLink ||
        kind == cast(WidgetKind)WidgetKindCheckbox ||
        kind == cast(WidgetKind)WidgetKindToggle ||
        kind == cast(WidgetKind)WidgetKindRadio ||
        kind == cast(WidgetKind)WidgetKindSlider ||
        kind == cast(WidgetKind)WidgetKindDropdown ||
        kind == cast(WidgetKind)WidgetKindCollapsible ||
        kind == cast(WidgetKind)WidgetKindTabBar ||
        kind == cast(WidgetKind)WidgetKindSelectable ||
        kind == cast(WidgetKind)WidgetKindColorPicker {
        return cast(s32)CursorClickable
    }
    return cast(s32)CursorDefault
}

#program_export
CursorRequest :: (state: CursorFrame, shape: s32) -> CursorFrame {
    if shape < cast(s32)CursorDefault || shape > cast(s32)CursorDisabled {
        return state
    }
    priority: s32 = CursorPriorityFor(shape)
    if state.has_request && priority < state.priority { return state }
    state.requested = shape
    state.priority = priority
    state.has_request = true
    return state
}

#program_export
CursorEndFrame :: (state: CursorFrame) -> CursorDecision {
    decision: CursorDecision
    if !state.has_request { state.requested = cast(s32)CursorDefault }
    decision.apply = state.requested != state.applied
    state.applied = state.requested
    decision.state = state
    return decision
}

// A deliberate UI request. Size and hotspot are logical units; each host
// renders the image at its own pixel density. Asset paths never expose native
// cursor handles.
CursorProps :: struct {
    asset_path: string
    width: s32
    height: s32
    hotspot_x: s32
    hotspot_y: s32
    hidden: bool
    shape: s32
}

CursorPropsValid :: (props: CursorProps) -> bool {
    if props.shape < 0 || props.shape > 10 || props.asset_path.count > 4095 { return false }
    for byte: props.asset_path { if byte == cast(u8)0 { return false } }
    if props.asset_path.count == 0 {
        return props.width == 0 && props.height == 0 && props.hotspot_x == 0 && props.hotspot_y == 0
    }
    return !props.hidden && props.width > 0 && props.width <= 128 &&
    props.height > 0 && props.height <= 128 && props.hotspot_x >= 0 &&
    props.hotspot_x < props.width && props.hotspot_y >= 0 && props.hotspot_y < props.height
}

// The empty request (no asset, no shape, not hidden) withdraws a request.
CursorPropsEmpty :: (props: CursorProps) -> bool {
    return props.asset_path.count == 0 && !props.hidden && props.shape == 0
}

CursorPropsSame :: (a: CursorProps, b: CursorProps) -> bool {
    return a.width == b.width && a.height == b.height && a.hotspot_x == b.hotspot_x &&
    a.hotspot_y == b.hotspot_y && a.hidden == b.hidden && a.shape == b.shape &&
    a.asset_path == b.asset_path
}

// An application cursor replaces the pointer shapes. Text editing, crosshair
// and resize shapes still tell the user what a drag or click there does.
CursorReplacesShape :: (shape: s32) -> bool {
    return shape == cast(s32)CursorDefault || shape == cast(s32)CursorArrow ||
    shape == cast(s32)CursorClickable || shape == cast(s32)CursorDisabled
}

// A guest may request only a packed asset, before the host's own asset policy.
CursorPackedPath :: (path: string) -> bool {
    if path.count < 8 || path.count > 4095 || path[:7] != "assets/" { return false }
    start: s32 = 0
    for index: 0..cast(s32)path.count {
        if index < path.count && (path[index] == cast(u8)0 || path[index] == #char "\\" || path[index] == #char ":") { return false }
        if index == path.count || path[index] == #char "/" {
            part := path[start:index]
            if part == "" || part == "." || part == ".." { return false }
            start = index + 1
        }
    }
    return true
}

#if #defined(KRYON_HOSTED_UI) {
    host_api :: #system_library "host_api";
    CursorSetHostedHost :: (session: Session, asset_path: string, width: s32,
        height: s32, hotspot_x: s32, hotspot_y: s32, hidden: bool, shape: s32) -> bool #foreign host_api;
    #program_export
    CursorSet :: (session: Session, props: CursorProps) -> bool {
        if !CursorPropsValid(props) { return false }
        return CursorSetHostedHost(session, props.asset_path, props.width,
            props.height, props.hotspot_x, props.hotspot_y, props.hidden, props.shape)
    }
    CursorHoverHostedHost :: (session: Session, shape: s32) -> bool #foreign host_api;
    #program_export
    CursorHover :: (session: Session, shape: s32) -> bool {
        if shape < cast(s32)CursorDefault || shape > cast(s32)CursorDisabled { return false }
        return CursorHoverHostedHost(session, shape)
    }
} else {
    // Requests persist until the next deliberate change. Hosts compare the
    // resolved cursor each frame and touch the platform only when it differs.
    CursorStorage :: struct {
        epoch: u64
        requested: bool
        props: CursorProps
        length: s32
        path: [4096]u8
    }
    // Slot zero is never a session; it holds the application default.
    cursor_requests: [9]CursorStorage;

    CursorStore :: (storage: *CursorStorage, props: CursorProps) {
        if CursorPropsEmpty(props) { storage.requested = false; return }
        for index: 0..cast(s32)props.asset_path.count - 1 {
            storage.path[index] = props.asset_path[index]
        }
        storage.length = cast(s32)props.asset_path.count
        storage.props = CursorProps.{.width = props.width, .height = props.height,
            .hotspot_x = props.hotspot_x, .hotspot_y = props.hotspot_y,
            .hidden = props.hidden, .shape = props.shape}
        storage.requested = true
    }
    CursorStored :: (slot: s32) -> CursorProps {
        if slot < 0 || slot >= 9 || !cursor_requests[slot].requested { return .{} }
        result := cursor_requests[slot].props
        result.asset_path = TextView(cursor_requests[slot].path[:cursor_requests[slot].length])
        return result
    }

    CursorRequested :: (session: Session) -> bool {
        slot := SessionIndex(session)
        return slot != 0 && cursor_requests[slot].epoch == session.epoch && cursor_requests[slot].requested
    }
    // The session's own request, or the empty request when it has none.
    CursorGet :: (session: Session) -> CursorProps {
        if !CursorRequested(session) { return .{} }
        return CursorStored(session.slot)
    }
    // Replaces this session's request until the next CursorSet; the empty
    // request withdraws it. Repeating the same request changes nothing.
    #program_export
    CursorSet :: (session: Session, props: CursorProps) -> bool {
        slot := SessionIndex(session)
        if slot == 0 || !CursorPropsValid(props) { return false }
        if cursor_requests[slot].epoch != session.epoch {
            cursor_requests[slot] = .{.epoch = session.epoch}
        }
        CursorStore(*cursor_requests[slot], props)
        return true
    }
    // The application cursor every session inherits while it has no request
    // of its own. Hosts set it; hosted guests cannot.
    #program_export
    CursorSetDefault :: (props: CursorProps) -> bool {
        if !CursorPropsValid(props) { return false }
        CursorStore(*cursor_requests[0], props)
        return true
    }
    CursorGetDefault :: () -> CursorProps { return CursorStored(0) }

    // The application's pointing cursor, shown only where a click does
    // something: over clickable widgets and app-drawn targets marked with
    // CursorHover. Everywhere else shows the default. Hosts set it; the empty
    // request withdraws it, and clickable then shows the default again.
    cursor_pointing: CursorStorage;
    #program_export
    CursorSetPointing :: (props: CursorProps) -> bool {
        if !CursorPropsValid(props) { return false }
        CursorStore(*cursor_pointing, props)
        return true
    }
    CursorGetPointing :: () -> CursorProps {
        if !cursor_pointing.requested { return .{} }
        result := cursor_pointing.props
        result.asset_path = TextView(cursor_pointing.path[:cursor_pointing.length])
        return result
    }

    // A target the app hit-tests itself (a painted hotspot, a field) reports
    // what the pointer is over with CursorHover while it builds its frame,
    // from the same test that decides its clicks. The frame collects the
    // highest-priority mark and its commit replaces the last one, so the
    // cursor changes only when the hovered target does, a retained or
    // cancelled frame keeps the committed mark, and a frame without a mark
    // shows the default.
    CursorHoverState :: struct {
        epoch: u64
        building: s32
        committed: s32
    }
    cursor_hovers: [9]CursorHoverState;

    #program_export
    CursorHover :: (session: Session, shape: s32) -> bool {
        slot := SessionIndex(session)
        if slot == 0 || shape < cast(s32)CursorDefault || shape > cast(s32)CursorDisabled { return false }
        if cursor_hovers[slot].epoch != session.epoch { cursor_hovers[slot] = .{.epoch = session.epoch} }
        if CursorPriorityFor(shape) >= CursorPriorityFor(cursor_hovers[slot].building) {
            cursor_hovers[slot].building = shape
        }
        return true
    }
    // TreeStart and a successful TreeFinish call these.
    CursorHoverFrameStart :: (session: Session) {
        slot := SessionIndex(session)
        if slot == 0 { return }
        if cursor_hovers[slot].epoch != session.epoch { cursor_hovers[slot] = .{.epoch = session.epoch} }
        cursor_hovers[slot].building = cast(s32)CursorDefault
    }
    CursorHoverFrameCommit :: (session: Session) {
        slot := SessionIndex(session)
        if slot == 0 || cursor_hovers[slot].epoch != session.epoch { return }
        cursor_hovers[slot].committed = cursor_hovers[slot].building
    }
    // The committed frame's mark; the default when it made none.
    CursorHovered :: (session: Session) -> s32 {
        slot := SessionIndex(session)
        if slot == 0 || cursor_hovers[slot].epoch != session.epoch { return cast(s32)CursorDefault }
        return cursor_hovers[slot].committed
    }

    // What a host shows for SESSION over a widget whose own shape is
    // WIDGET_SHAPE (TreeCursor): its request, else the application pointing
    // cursor over something clickable, else the application cursor for
    // pointer shapes, else the widget's system shape.
    #program_export
    CursorResolve :: (session: Session, widget_shape: s32) -> CursorProps {
        if CursorRequested(session) { return CursorGet(session) }
        if widget_shape == cast(s32)CursorClickable && cursor_pointing.requested {
            return CursorGetPointing()
        }
        if cursor_requests[0].requested && CursorReplacesShape(widget_shape) {
            return CursorStored(0)
        }
        shape := widget_shape
        if shape < 0 || shape > 10 { shape = cast(s32)CursorDefault }
        return .{.shape = shape}
    }

    // A disposed session keeps no request.
    CursorSessionEnd :: (session: Session) {
        slot := SessionIndex(session)
        if slot != 0 { cursor_requests[slot] = .{}; cursor_hovers[slot] = .{} }
    }
}
