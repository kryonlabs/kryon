PaintCapture :: struct {
    target: RenderTexture2D
    projection: Matrix
    modelview: Matrix
    clip: Rectangle
    has_clip: i32
    blend: BlendState
}

TextFieldState :: struct {
    cursor: i32
    anchor: i32
    focused: i32
    dragging: i32
}

AccessibilityRequest :: struct {
    id: i32
    kind: i32
    action: AccessibilityAction
    value: *char
    length: i32
    codepoints: i32
    anchor: i32
    cursor: i32
    item_key: u64
}

ui_tree_nodes :: *TreeNode #global #export
ui_tree_node_count :: i32 #global #export
ui_tree_node_capacity :: i32 #global #export
ui_committed_nodes :: *TreeNode #global #export
ui_committed_node_count :: i32 #global #export
ui_committed_node_capacity :: i32 #global #export
ui_reconcile_old_nodes :: *TreeNode #global #export
ui_reconcile_old_node_capacity :: i32 #global #export
ui_reconcile_slots :: *i32 #global #export
ui_reconcile_slot_capacity :: i32 #global #export
ui_reconcile_matched_old :: *i32 #global #export
ui_reconcile_matched_old_capacity :: i32 #global #export
ui_tree_generation :: u32 #global #export
ui_tree_building :: i32 #global #export
ui_tree_stack :: [128]NodeId #global #export
ui_tree_stack_depth :: i32 #global #export
ui_tree_paint_target :: RenderTexture2D #global #export
ui_tree_paint_captures :: *PaintCapture #global #export
ui_tree_paint_capture_count :: u32 #global #export
ui_tree_paint_capture_capacity :: u32 #global #export
ui_tree_input_captures :: *PopupInputToken #global #export
ui_tree_input_capture_count :: u32 #global #export
ui_tree_input_capture_capacity :: u32 #global #export
ui_committed_input_captures :: *PopupInputToken #global #export
ui_committed_input_capture_capacity :: u32 #global #export
ui_tree_invalid :: u32 = INVALIDATE_TREE | INVALIDATE_LAYOUT |
INVALIDATE_PAINT #global #export
ui_tree_build_activation :: i32 #global #export
ui_tree_declaration :: unsigned long #global #export
ui_tree_screen_key :: KeyID #global #export
ui_tree_screen_id :: i32 #global #export
ui_accessibility_pending :: [32]AccessibilityRequest #global #export
ui_accessibility_active :: [32]AccessibilityRequest #global #export
ui_accessibility_pending_count :: i32 #global #export
ui_accessibility_active_count :: i32 #global #export
ui_accessibility_activation :: i32 #global #export
ui_accessibility_building :: i32 #global #export

ui_accessibility_request_clear :: (
request: *AccessibilityRequest) #export {
    if request->value != nil {
        value: volatile char* = (volatile char*)request->value
        index: i32 = 0
        while index < request->length {
            value[index] = 0
            index += 1
        }
        free(request->value)
    }
    memset(request, 0, sizeof(AccessibilityRequest))
}
ui_event_queue :: *Event #global #export
ui_event_capacity :: i32 #global #export
ui_event_head :: i32 #global #export
ui_event_count :: i32 #global #export
ui_tree_text_last_click_key :: KeyID #global #export
ui_tree_text_last_click_x :: i32 #global #export
ui_tree_text_last_click_y :: i32 #global #export
ui_tree_text_last_click_time :: f64 #global #export
ui_tree_backspace_next_repeat_at :: f64 #global #export
ui_tree_delete_next_repeat_at :: f64 #global #export

ui_tree_key_repeat_count :: (key: i32,
next_repeat_at: *f64) -> i32 #export {
    if IsKeyPressed(key) {
        *next_repeat_at = GetTime() + 0.34
        return 1
    }
    if !IsKeyDown(key) {
        *next_repeat_at = 0.0
        return 0
    }
    now: f64 = GetTime()
    if *next_repeat_at <= 0.0 {
        *next_repeat_at = now + 0.34
        return 0
    }
    count: i32 = 0
    while now >= *next_repeat_at && count < 8 {
        count += 1
        *next_repeat_at += 0.045
    }
    return count
}

ui_event_push :: (event: Event) #export {
    if ui_event_count >= ui_event_capacity {
        next: i32 = 64
        if ui_event_capacity > 0 { next = ui_event_capacity * 2 }
        grown: *Event = (Event*)malloc((size_t)next * sizeof(Event))
        if grown == nil { return }
        index: i32 = 0
        while index < ui_event_count {
            grown[index] = ui_event_queue[(ui_event_head + index) %
            ui_event_capacity]
            index += 1
        }
        free(ui_event_queue)
        ui_event_queue = grown
        ui_event_capacity = next
        ui_event_head = 0
    }
    tail: i32 = (ui_event_head + ui_event_count) % ui_event_capacity
    ui_event_queue[tail] = event
    ui_event_count += 1
}

ui_text_field_event :: (node: *TreeNode, kind: EventKind,
timestamp: f64) #export {
    if node == nil { return }
    event: Event = (Event){0}
    state: *TextFieldState = (TextFieldState*)node->state
    event.key = node->key
    event.kind = kind
    event.timestamp = timestamp
    if kind == EVENT_SELECTION_CHANGED && state != nil {
        range: TextSelectionRange = TextSelectionRangeFor(
        state->anchor, state->cursor)
        event.data.selection.start = range.start
        event.data.selection.end = range.end
    } else if kind == EVENT_TEXT_CHANGED &&
    node->data.text_field.text != nil {
        event.data.text.bytes = (int)strlen(node->data.text_field.text)
    }
    ui_event_push(event)
}

ui_tree_button_like_kind :: (kind: i32) -> i32 #export {
    return TreeButtonLike(kind)
}

ui_tree_interactive_button_like :: (
node: const TreeNode*) -> i32 #export {
    if node == nil || !ui_tree_button_like_kind(node->kind) { return 0 }
    return TreeInteractiveButtonLike(node->kind,
    node->data.button.props.id, node->data.button.props.disabled,
    node->data.button.props.loading)
}

ui_tree_store_text_input_paint :: (node: *TreeNode,
paint: TextInputPaint) #export {
    if sizeof(paint) > sizeof(node->data.internal.words) { abort() }
    memcpy(node->data.internal.words, &paint, sizeof(paint))
}

ui_tree_load_text_input_paint :: (
node: const TreeNode*) -> TextInputPaint #export {
    paint: TextInputPaint
    if sizeof(paint) > sizeof(node->data.internal.words) { abort() }
    memcpy(&paint, node->data.internal.words, sizeof(paint))
    return paint
}

NextEvent :: (event: *Event) -> i32 #export {
    if event == nil || ui_event_count <= 0 { return 0 }
    *event = ui_event_queue[ui_event_head]
    ui_event_head = (ui_event_head + 1) % ui_event_capacity
    ui_event_count -= 1
    return 1
}

SetSelection :: (key: KeyID, anchor: i32,
cursor: i32) -> i32 #export {
    index: i32 = 0
    while index < ui_committed_node_count {
        node: *TreeNode = &ui_committed_nodes[index]
        if node->key == key &&
        (node->kind == WidgetKindTextField ||
        node->kind == WidgetKindTextArea) {
            state: *TextFieldState = (TextFieldState*)node->state
            if state == nil { return 0 }
            length: i32 = 0
            if node->kind == WidgetKindTextField {
                if node->data.text_field.text == nil { return 0 }
                length = (int)strlen(node->data.text_field.text)
            } else {
                if node->data.text_area.text == nil { return 0 }
                length = (int)strlen(node->data.text_area.text)
            }
            state->anchor = TextCursorForLength(anchor, length)
            state->cursor = TextCursorForLength(cursor, length)
            if node->kind == WidgetKindTextField {
                if node->data.text_field.cursor_position != nil {
                    *node->data.text_field.cursor_position = state->cursor
                }
            } else if node->data.text_area.cursor_position != nil {
                *node->data.text_area.cursor_position = state->cursor
            }
            ui_text_field_event(node, EVENT_SELECTION_CHANGED, GetTime())
            ui_tree_invalid |= INVALIDATE_PAINT
            return 1
        }
        index += 1
    }
    return 0
}

ui_tree_input_snapshot :: (node: const TreeNode*) -> PopupInputToken #export {
    captures: *PopupInputToken = ui_tree_input_captures
    if ui_committed_node_count > 0 {
        captures = ui_committed_input_captures
    }
    if node->popup_input_capture == 0 {
        return (PopupInputToken){0}
    }
    return captures[node->popup_input_capture - 1]
}

ui_tree_input_blocked :: (node: const TreeNode*,
point: Vector2) -> i32 #export {
    return ui_input_captures_snapshot(point, ui_tree_input_snapshot(node))
}

UpdateTree :: () #export {
    if ui_committed_node_count <= 0 { return }
    root: *TreeNode = &ui_committed_nodes[0]
    if root->bounds.width != ui_view_width ||
    root->bounds.height != ui_view_height {
        root->bounds.width = (float)ui_view_width
        root->bounds.height = (float)ui_view_height
        ui_tree_invalid |= INVALIDATE_LAYOUT | INVALIDATE_PAINT
    }
}

GetTreeNodes :: (count: *i32) -> const TreeNode* #export {
    if ui_committed_node_count > 0 {
        if count != nil { *count = ui_committed_node_count }
        return ui_committed_nodes
    }
    if count != nil { *count = ui_tree_node_count }
    return ui_tree_nodes
}

GetNode :: (id: NodeId) -> const TreeNode* #export {
    if ui_committed_node_count > 0 {
        if id < 0 || id >= ui_committed_node_count { return nil }
        return &ui_committed_nodes[id]
    }
    return ui_tree_node(id)
}

GetNodeId :: (node: const TreeNode*) -> i32 #export {
    if node == nil { return 0 }
    return node->id
}

GetNodeKind :: (node: const TreeNode*) -> i32 #export {
    if node == nil { return -1 }
    return node->kind
}

