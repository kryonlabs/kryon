#import "kryon/scene"
#import "kryon/scene_render"
#import "std/image"
#import "std/vec"

Check :: (condition: bool, message: string) -> s32 {
    if condition { return 0 }
    print("image material: %\n", message)
    return 1
}

ImageHash :: (image: *Image) -> u64 {
    hash: u64 = 1469598103934665603
    for at: 0..image.pixels.count - 1 {
        hash = (hash ^ cast(u64)image.pixels[at]) * 1099511628211
    }
    return hash
}

ResourceAndProjection :: () -> s32 {
    scene: Scene
    SceneInit(*scene)
    source := NewImage(4, 4)
    defer { SceneFree(*scene); RenderSceneRelease() }
    for y: 0..3 { for x: 0..3 {
        at := (y * 4 + x) * 4
        source.pixels[at] = cast(u8)(40 + x * 60)
        source.pixels[at + 1] = cast(u8)(20 + y * 50)
        source.pixels[at + 2] = cast(u8)(10 + (x + y) * 25)
        source.pixels[at + 3] = 255
    } }
    options: SceneTextureOptions = .{projection=.SceneTextureBox,
        filter=.SceneTextureLinear,wrap=.SceneTextureRepeat,
        scale=.{2.0,3.0},offset=.{0.25,0.5}}
    base := UnlitMaterial(.{255,255,255,255})
    first := ImageMaterial(*scene,*source,base,options)
    other := options; other.filter=.SceneTextureNearest
    second := ImageMaterial(*scene,*source,base,other)
    fail := Check(!scene.failed && first.texture == second.texture &&
        scene.textures.count == 1 && scene.texels.count == 64,
        "equal images with distinct sampling must share one owned scene resource")
    mip := options; mip.mip_level=1
    reduced := ImageMaterial(*scene,*source,base,mip)
    again := ImageMaterial(*scene,*source,base,mip)
    fail += Check(reduced.texture == again.texture && reduced.texture != first.texture &&
        scene.textures.count == 2 && scene.textures[reduced.texture].width == 2 &&
        scene.textures[reduced.texture].height == 2 && scene.texels.count == 80,
        "explicit mip preparation must be deterministic and deduplicated")
    x := SceneTextureCoordinate(first,.{1.0,2.0,3.0},.{-1.0,0.0,0.0},.{})
    y := SceneTextureCoordinate(first,.{1.0,2.0,3.0},.{0.0,1.0,0.0},.{})
    z := SceneTextureCoordinate(first,.{1.0,2.0,3.0},.{0.0,0.0,1.0},.{})
    fail += Check(x.x==6.25 && x.y==6.5 && y.x==2.25 && y.y==9.5 &&
        z.x==2.25 && z.y==6.5,"box projection must use stable object axes")
    unused RoundedBox(*scene,1.0,1.0,1.0,0.0,first)
    VecFree(source.pixels)
    camera:=PerspectiveCamera(45.0,1.0,0.1,20.0);camera.position=.{0.0,0.0,3.0}
    output:=NewImage(64,64);defer VecFree(output.pixels)
    fail += Check(RenderScene(*scene,camera,*output),"owned image must render after source release")
    hash:=ImageHash(*output);retained:=RenderSceneMemoryBytes()
    fail += Check(RenderScene(*scene,camera,*output) && ImageHash(*output)==hash &&
        RenderSceneMemoryBytes()==retained,"unchanged static geometry must render without retained growth")
    SceneClear(*scene)
    fail += Check(scene.textures.count==0 && scene.texels.count==0,
        "SceneClear must release every logical image resource")
    return fail
}

LinearRepeat :: () -> s32 {
    scene: Scene;SceneInit(*scene)
    source:=NewImage(2,2)
    defer {VecFree(source.pixels);SceneFree(*scene);RenderSceneRelease()}
    values: [16]u8=.[255,0,0,255, 0,255,0,255, 0,0,255,255, 255,255,255,255]
    for at:0..15 {source.pixels[at]=values[at]}
    options: SceneTextureOptions=.{filter=.SceneTextureLinear,wrap=.SceneTextureRepeat,
        offset=.{1.0,1.0}}
    material:=ImageMaterial(*scene,*source,UnlitMaterial(.{255,255,255,255}),options)
    unused Plane(*scene,2.0,2.0,material)
    camera:=OrthographicCamera(-1.0,1.0,1.0,-1.0,0.1,10.0);camera.position=.{0.0,0.0,3.0}
    output:=NewImage(33,33);defer VecFree(output.pixels)
    if !RenderScene(*scene,camera,*output) {return 10}
    at:=(16*33+16)*4
    return Check(output.pixels[at]>175&&output.pixels[at]<200&&
        output.pixels[at+1]>175&&output.pixels[at+1]<200&&
        output.pixels[at+2]>175&&output.pixels[at+2]<200,
        "linear repeat sampling must blend four wrapped sRGB texels in linear light")
}

#program_export
// Ingestion copies whole pixels and fingerprints every byte: one changed
// byte, or the same bytes in another shape, makes another texture, and an
// equal picture shares the first.
Ingestion :: () -> s32 {
    scene: Scene
    SceneInit(*scene)
    defer SceneFree(*scene)
    a := NewImage(8, 4); b := NewImage(8, 4); c := NewImage(4, 8)
    defer { VecFree(a.pixels); VecFree(b.pixels); VecFree(c.pixels) }
    for at: 0..a.pixels.count - 1 {
        value := cast(u8)((at * 37 + 11) & 255)
        a.pixels[at] = value; b.pixels[at] = value; c.pixels[at] = value
    }
    last := b.pixels.count - 1
    b.pixels[last] = cast(u8)(b.pixels[last] ^ cast(u8)1)
    base := UnlitMaterial(.{255,255,255,255})
    options: SceneTextureOptions
    first := ImageMaterial(*scene,*a,base,options)
    changed := ImageMaterial(*scene,*b,base,options)
    shaped := ImageMaterial(*scene,*c,base,options)
    again := ImageMaterial(*scene,*a,base,options)
    fail := Check(!scene.failed && scene.textures.count == 3 && scene.texels.count == 384 &&
        again.texture == first.texture && changed.texture != first.texture &&
        shaped.texture != first.texture && shaped.texture != changed.texture,
        "ingestion must tell pictures apart by every byte and their shape")
    copied := true
    for at: 0..127 {
        copied = copied && scene.texels[scene.textures[first.texture].first_texel + at] == a.pixels[at] &&
            scene.texels[scene.textures[changed.texture].first_texel + at] == b.pixels[at] &&
            scene.texels[scene.textures[shaped.texture].first_texel + at] == c.pixels[at]
    }
    fail += Check(copied, "ingestion must copy every texel")
    return fail
}

main :: () -> s32 { return ResourceAndProjection()+LinearRepeat()+Ingestion() }
