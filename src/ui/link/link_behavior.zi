#import "control_props"
#import "geometry"
#import "style"

LinkVisualState :: enum {
    LinkStateNormal :: 0
    LinkStateHover :: 1
    LinkStateDisabled :: 2
}
using ButtonState;
using LinkVisualState;


LinkAppearance :: struct {
    color: u32
    underline: bool
}

LinkInteraction :: struct {
    active: bool
    hovered: bool
    disabled_marker: bool
    activated: bool
    consume_release: bool
    state: ButtonState
}

#program_export
LinkBoundsFor :: (bounds: Rectangle, text_width: s32,
    text_height: s32, font: s32) -> Rectangle {
    result: Rectangle = bounds
    if result.width <= 0.0 {
        result.width = cast(float32)text_width
    }
    if result.height <= 0.0 {
        result.height = cast(float32)text_height
    }
    if result.height <= 0.0 {
        result.height = cast(float32)font
    }
    return result
}

#program_export
LinkUnderlineYFor :: (bounds: Rectangle, scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(bounds.y + bounds.height) - cast(s32)(2.0 * scale)
}

#program_export
LinkInteractionFor :: (disabled: bool, captured: bool, mouse_inside: bool,
    hover_effects: bool, released: bool, release_consumed: bool,
    press_started_inside: bool) -> LinkInteraction {
    interaction: LinkInteraction
    interaction.active = !disabled && !captured && mouse_inside
    interaction.hovered = interaction.active && hover_effects
    interaction.disabled_marker = disabled && !captured && mouse_inside
    interaction.activated = interaction.active && released &&
        !release_consumed && press_started_inside
    interaction.consume_release = interaction.activated
    interaction.state = cast(ButtonState)ButtonStateNormal
    if interaction.hovered {
        interaction.state = cast(ButtonState)ButtonStateHover
    }
    if disabled {
        interaction.state = cast(ButtonState)ButtonStateDisabled
    }
    return interaction
}

#program_export
LinkActivated :: (disabled: bool, clicked: bool, focus_activate: bool) -> bool {
    return !disabled && (clicked || focus_activate)
}

#program_export
ResolveLinkAppearance :: (frame: StyleFrame, hovered: bool,
    disabled: bool) -> LinkAppearance {
    state: s32 = LinkStateNormal
    if hovered {
        state = LinkStateHover
    }
    if disabled {
        state = LinkStateDisabled
    }
    appearance: LinkAppearance
    appearance.color = frame.value.foreground
    appearance.underline = state == LinkStateHover
    return appearance
}
