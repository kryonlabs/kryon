// kryon/app: a window and its frames. Show only shows the window; Run draws
// frames in it. Each platform's window and frame loop are separate modules,
// so a program that only shows a window carries no frame loop. The frame
// loops import app_types by name: a `using` import would keep an unrun loop
// in the checked program.
using Types :: #import "app_types";
ANDROID_HOST :: OS == .ANDROID || #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__)
DESKTOP_HOST :: OS == .WINDOWS || OS == .LINUX

#if TARGET == .ZX {
    // The installed desktop player hosts a bundle's window.
    WindowHost :: #import "zx_window";
    FrameHost :: #import "frames_zx";
} else #if TARGET == .C {
    #if ANDROID_HOST {
        WindowHost :: #import "app_unsupported";
        FrameHost :: #import "frames_android";
    } else #if OS == .WEB {
        WindowHost :: #import "page_window";
        FrameHost :: #import "frames_web";
    } else #if #defined(KRYON_TERMINAL) {
        WindowHost :: #import "app_unsupported";
        FrameHost :: #import "frames_terminal";
    } else #if DESKTOP_HOST && !#defined(KRYON_NO_DESKTOP_HOST) {
        WindowHost :: #import "desktop_window";
        FrameHost :: #import "frames_desktop";
    } else {
        WindowHost :: #import "app_unsupported";
        FrameHost :: #import "app_unsupported";
    }
} else {
    WindowHost :: #import "app_unsupported";
    FrameHost :: #import "app_unsupported";
}

// Shows the window, cleared, until it closes.
Show :: (window: Window) -> s32 {
    return WindowHost.Show(window)
}

// Runs the program's frames: `draw` builds each frame's widgets.
Run :: (window: Window, draw: Draw) -> s32 {
    return FrameHost.Run(window, draw)
}
