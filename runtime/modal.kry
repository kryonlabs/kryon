#module "modal"
#import "control_props"
#import "drawing_props"
#import "style"

ModalMetrics :: struct {
    screen_pad: i32
    min_width: i32
    default_max_width: i32
    edge_pad: i32
    title_height: i32
    padding_x: i32
    padding_bottom: i32
    message_gap: i32
    prompt_height: i32
    prompt_gap: i32
    button_height: i32
    button_gap: i32
    action_padding_x: i32
    action_min_width: i32
    action_max_width: i32
    content_min_width: i32
    min_height: i32
    frame_min_width: i32
    frame_min_height: i32
    frame_title_y: i32
    frame_content_y: i32
    frame_content_bottom_pad: i32
    frame_icon_size: i32
    frame_icon_padding: i32
    frame_icon_edge_gap: i32
    frame_title_side_padding: i32
}

ModalLayout :: struct {
    panel: Rectangle
    content_width: i32
    message_x: i32
    message_y: i32
    button_y: i32
    prompt_y: i32
    prompt_height: i32
    buttons_height: i32
}

ModalFrameLayout :: struct {
    panel: Rectangle
    content: Rectangle
    left_button: Rectangle
    right_button: Rectangle
    title_y: i32
    title_max_width: i32
    icon_size: i32
    icon_padding: i32
}

ModalActionPlacement :: struct {
    start_x: i32
    action_width: i32
    total_width: i32
}

ModalDismissal :: struct {
    dismissed: bool
    release_consumed: bool
}

ModalResultDecision :: struct {
    result: i32
}

ModalHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

ModalMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !ModalHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

ModalMetricsFor :: (scale: float, panel: StyleFrame, title: StyleFrame,
    message: StyleFrame, action: StyleFrame, close: StyleFrame) -> ModalMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: ModalMetrics
    metrics.screen_pad = ModalMetric(panel.value.fields,
        (u32)StyleGap, panel.value.gap, 24.0, scale, true)
    metrics.min_width = ModalMetric(panel.value.fields,
        (u32)StyleIconSize, panel.value.icon_size, 280.0, scale, false)
    metrics.default_max_width = ModalMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_x, 420.0, scale, false)
    metrics.edge_pad = ModalMetric(panel.value.fields,
        (u32)StylePaddingY, panel.value.padding_y, 8.0, scale, true)
    metrics.title_height = ModalMetric(title.value.fields,
        (u32)StyleIconSize, title.value.icon_size, 48.0, scale, true)
    metrics.padding_x = ModalMetric(panel.value.fields,
        (u32)StylePaddingX, panel.value.padding_x, 18.0, scale, true)
    metrics.padding_bottom = ModalMetric(title.value.fields,
        (u32)StylePaddingY, title.value.padding_y, 18.0, scale, true)
    metrics.message_gap = ModalMetric(message.value.fields,
        (u32)StyleGap, message.value.gap, 18.0, scale, true)
    metrics.prompt_height = ModalMetric(message.value.fields,
        (u32)StyleIconSize, message.value.icon_size, 38.0, scale, true)
    metrics.prompt_gap = ModalMetric(message.value.fields,
        (u32)StyleContentOffset, message.value.offset_y, 18.0, scale, true)
    metrics.button_height = ModalMetric(action.value.fields,
        (u32)StyleIconSize, action.value.icon_size, 44.0, scale, false)
    metrics.button_gap = ModalMetric(action.value.fields,
        (u32)StyleGap, action.value.gap, 8.0, scale, true)
    metrics.action_padding_x = ModalMetric(action.value.fields,
        (u32)StylePaddingX, action.value.padding_x, 24.0, scale, true)
    metrics.action_min_width = ModalMetric(action.value.fields,
        (u32)StyleContentOffset, action.value.offset_x, 88.0, scale, false)
    metrics.action_max_width = ModalMetric(action.value.fields,
        (u32)StyleContentOffset, action.value.offset_y, 150.0, scale, false)
    metrics.content_min_width = ModalMetric(message.value.fields,
        (u32)StylePaddingX, message.value.padding_x, 120.0, scale, false)
    metrics.min_height = ModalMetric(message.value.fields,
        (u32)StylePaddingY, message.value.padding_y, 160.0, scale, false)
    metrics.frame_min_width = ModalMetric(close.value.fields,
        (u32)StyleContentOffset, close.value.offset_x, 120.0, scale, false)
    metrics.frame_min_height = ModalMetric(close.value.fields,
        (u32)StyleContentOffset, close.value.offset_y, 96.0, scale, false)
    metrics.frame_title_y = ModalMetric(title.value.fields,
        (u32)StyleContentOffset, title.value.offset_y, 14.0, scale, true)
    metrics.frame_content_y = ModalMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_y, 58.0, scale, true)
    metrics.frame_content_bottom_pad = ModalMetric(close.value.fields,
        (u32)StylePaddingY, close.value.padding_y, 16.0, scale, true)
    metrics.frame_icon_size = ModalMetric(close.value.fields,
        (u32)StyleIconSize, close.value.icon_size, 20.0, scale, true)
    metrics.frame_icon_padding = ModalMetric(close.value.fields,
        (u32)StylePaddingX, close.value.padding_x, 8.0, scale, true)
    metrics.frame_icon_edge_gap = ModalMetric(close.value.fields,
        (u32)StyleGap, close.value.gap, 6.0, scale, true)
    metrics.frame_title_side_padding = ModalMetric(title.value.fields,
        (u32)StylePaddingX, title.value.padding_x, 24.0, scale, true)
    return metrics
}

ModalClampWidth :: (view_width: i32, requested_max_width: i32,
    metrics: ModalMetrics) -> i32 #export {
    width: i32 = requested_max_width
    if width <= 0 { width = metrics.default_max_width }
    if width > view_width - metrics.screen_pad { width = view_width - metrics.screen_pad }
    if width < metrics.min_width { width = metrics.min_width }
    if width > view_width - metrics.edge_pad { width = view_width - metrics.edge_pad }
    if width < 1 { width = 1 }
    return width
}

ModalContentWidth :: (modal_width: i32, metrics: ModalMetrics) -> i32 #export {
    width: i32 = modal_width - metrics.padding_x * 2
    if width < metrics.content_min_width { width = metrics.content_min_width }
    return width
}

ModalActionWidth :: (label_width: i32, metrics: ModalMetrics) -> i32 #export {
    width: i32 = label_width + metrics.action_padding_x
    if width < metrics.action_min_width { width = metrics.action_min_width }
    if width > metrics.action_max_width { width = metrics.action_max_width }
    return width
}

ModalActionRowsStep :: (row_width: i32, rows: i32, action_width: i32,
    content_width: i32, gap: i32) -> i32 #export {
    next_width: i32 = action_width
    if row_width > 0 { next_width = row_width + gap + action_width }
    if row_width > 0 && next_width > content_width { return rows + 1 }
    return rows
}

ModalActionRowWidthStep :: (row_width: i32, action_width: i32,
    content_width: i32, gap: i32) -> i32 #export {
    next_width: i32 = action_width
    if row_width > 0 { next_width = row_width + gap + action_width }
    if row_width > 0 && next_width > content_width { return action_width }
    return next_width
}

ModalActionPlacementFor :: (x: i32, content_width: i32, row_count: i32,
    gap: i32) -> ModalActionPlacement #export {
    placement: ModalActionPlacement
    if row_count <= 0 || content_width <= 0 {
        placement.start_x = x
        return placement
    }
    usable: i32 = content_width - gap * (row_count - 1)
    placement.action_width = usable / row_count
    if placement.action_width < 0 { placement.action_width = 0 }
    placement.total_width = placement.action_width * row_count +
        gap * (row_count - 1)
    placement.start_x = x + (content_width - placement.total_width) / 2
    return placement
}

ModalButtonsHeight :: (rows: i32, metrics: ModalMetrics) -> i32 #export {
    if rows <= 0 { return 0 }
    return rows * metrics.button_height + (rows - 1) * metrics.button_gap
}

ModalFontFor :: (default_font: i32, style_font: i32) -> i32 #export {
    if style_font > 0 { return style_font }
    return default_font
}

ModalMessageLineGap :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(4.0 * scale)
}

ModalPromptFocusIdFor :: (requested_focus_id: i32, fallback_focus_id: i32) -> i32 #export {
    if requested_focus_id > 0 { return requested_focus_id }
    return fallback_focus_id
}

ModalPromptCommitResult :: (action_count: i32) -> i32 #export {
    if action_count > 1 { return 2 }
    return 1
}

ModalPromptResultFor :: (current_result: i32, has_prompt: bool,
    commit_pressed: bool, escape_pressed: bool,
    action_count: i32) -> ModalResultDecision #export {
    decision: ModalResultDecision
    decision.result = current_result
    if current_result != 0 || !has_prompt {
        return decision
    }
    if commit_pressed {
        decision.result = ModalPromptCommitResult(action_count)
        return decision
    }
    if escape_pressed {
        decision.result = 1
    }
    return decision
}

ModalOutsideDismissalFor :: (released: bool, release_consumed: bool,
    pointer_inside: bool) -> ModalDismissal #export {
    dismissal: ModalDismissal
    if released && !release_consumed && !pointer_inside {
        dismissal.dismissed = true
        dismissal.release_consumed = true
        return dismissal
    }
    dismissal.release_consumed = release_consumed
    return dismissal
}

ModalLayoutFor :: (view_width: i32, view_height: i32, max_width: i32,
    message_height: i32, button_rows: i32, has_prompt: bool,
    metrics: ModalMetrics) -> ModalLayout #export {
    layout: ModalLayout
    modal_width: i32 = ModalClampWidth(view_width, max_width, metrics)
    content_width: i32 = ModalContentWidth(modal_width, metrics)
    buttons_height: i32 = ModalButtonsHeight(button_rows, metrics)
    prompt_height: i32 = 0
    prompt_gap: i32 = 0
    if has_prompt {
        prompt_height = metrics.prompt_height
        prompt_gap = metrics.prompt_gap
    }
    modal_height: i32 = metrics.title_height + message_height +
        prompt_gap + prompt_height
    if buttons_height > 0 { modal_height += metrics.message_gap + buttons_height }
    modal_height += metrics.padding_bottom
    if modal_height < metrics.min_height { modal_height = metrics.min_height }
    max_height: i32 = view_height - metrics.screen_pad
    if modal_height > max_height { modal_height = max_height }
    if modal_height < 1 { modal_height = 1 }

    layout.panel.x = (float)((view_width - modal_width) / 2)
    layout.panel.y = (float)((view_height - modal_height) / 2)
    layout.panel.width = (float)modal_width
    layout.panel.height = (float)modal_height
    layout.content_width = content_width
    layout.message_x = (i32)layout.panel.x + metrics.padding_x
    layout.message_y = (i32)layout.panel.y + metrics.title_height
    layout.buttons_height = buttons_height
    layout.button_y = (i32)layout.panel.y + modal_height -
        buttons_height - metrics.padding_bottom
    layout.prompt_y = layout.message_y + message_height + prompt_gap
    layout.prompt_height = prompt_height
    return layout
}

ModalFramePanelFor :: (view_width: i32, view_height: i32, width: i32,
    height: i32, metrics: ModalMetrics) -> Rectangle #export {
    panel: Rectangle
    max_width: i32 = view_width - metrics.screen_pad
    max_height: i32 = view_height - metrics.screen_pad
    if width > max_width { width = max_width }
    if height > max_height { height = max_height }
    if width < 1 { width = 1 }
    if height < 1 { height = 1 }
    panel.x = (float)((view_width - width) / 2)
    panel.y = (float)((view_height - height) / 2)
    panel.width = (float)width
    panel.height = (float)height
    return panel
}

ModalFrameLayoutFor :: (panel: Rectangle, metrics: ModalMetrics) -> ModalFrameLayout #export {
    layout: ModalFrameLayout
    if panel.width < (float)metrics.frame_min_width {
        panel.width = (float)metrics.frame_min_width
    }
    if panel.height < (float)metrics.frame_min_height {
        panel.height = (float)metrics.frame_min_height
    }
    icon_w: i32 = metrics.frame_icon_size + metrics.frame_icon_padding * 2
    layout.panel = panel
    layout.content.x = panel.x + (float)metrics.padding_x
    layout.content.y = panel.y + (float)metrics.frame_content_y
    layout.content.width = panel.width - (float)(metrics.padding_x * 2)
    layout.content.height = panel.height -
        (float)(metrics.frame_content_y + metrics.frame_content_bottom_pad)
    if layout.content.width < 1.0 { layout.content.width = 1.0 }
    if layout.content.height < 1.0 { layout.content.height = 1.0 }

    layout.left_button.x = panel.x + (float)metrics.frame_icon_edge_gap
    layout.left_button.y = panel.y + (float)metrics.frame_icon_edge_gap
    layout.left_button.width = (float)icon_w
    layout.left_button.height = (float)icon_w
    layout.right_button = layout.left_button
    layout.right_button.x = panel.x + panel.width - (float)(icon_w + metrics.frame_icon_edge_gap)

    layout.title_y = (i32)panel.y + metrics.frame_title_y
    layout.title_max_width = (i32)panel.width - icon_w * 2 -
        metrics.frame_title_side_padding
    if layout.title_max_width < 1 { layout.title_max_width = 1 }
    layout.icon_size = metrics.frame_icon_size
    layout.icon_padding = metrics.frame_icon_padding
    return layout
}
