using HostValueKind;
using FrameStatus;

// Image sizes for native builds; the photo is 40 px square. Its preview
// is 10 px, the slow picture is still loading and the gone one unavailable.
image_size_path: [128]u8;
TestImageSize :: (asset_path: string) -> s32 {
    unused CopyCString(asset_path, image_size_path[:])
    if asset_path == "assets/slow.png" { return -1 }
    if asset_path == "assets/gone.png" { return 0 }
    if asset_path == "assets/photo-small.png" { return 10 }
    return 40
}

#program_export
ImageWidth :: (asset_path: string) -> s32 { return TestImageSize(asset_path) }

#program_export
ImageHeight :: (asset_path: string) -> s32 { return TestImageSize(asset_path) }

// A bundle may draw its own pictures and nothing else.
asset_checks: s32;
AllowPhoto :: (path: string) -> bool {
    asset_checks += 1
    return path == "" || path == "assets/photo.png" || path == "assets/photo-small.png" ||
        path == "assets/slow.png" || path == "assets/gone.png"
}

resolved_owner: s32;
resolve_checks: s32;
ResolvePhoto :: (path: string) -> string {
    resolve_checks += 1
    if path != "assets/photo.png" { return "" }
    if resolved_owner == 1 { return "apps/owner-a/assets/photo.png" }
    if resolved_owner == 2 { return "apps/owner-b/assets/photo.png" }
    return ""
}

PaintHasAsset :: (session: Session, path: string) -> bool {
    for index: cast(s32)0..PendingPaintCount(session) - 1 {
        if PendingPaintAt(session, index).asset_path == path { return true }
    }
    return false
}

// What a bundle's ImageShowingOf answers for IMAGE, or -1 when refused.
showing_codec: WidgetImagePropsCodec;
HostedShowing :: (session: Session, image: Image.Props) -> s64 {
    arguments: [2]HostValue
    arguments[0] = WidgetEncodeSession(session, *session_codec)
    arguments[1] = WidgetEncodeImageProps(image, *showing_codec)
    answer: HostValue
    if Call("image_showing", "ImageShowingHostedHost", arguments[:], *answer) != 1 ||
    TextFromCString(answer.type_name) != "s32" { return -1 }
    return answer.integer
}

module_name: [64]u8;
function_name: [64]u8;
session_codec: WidgetSessionCodec;
text_codec: WidgetTextPropsCodec;
image_codec: WidgetImagePropsCodec;
button_codec: WidgetButtonPropsCodec;
scroll_codec: WidgetScrollPropsCodec;
area_codec: WidgetTextAreaPropsCodec;
area_decoded: WidgetTextAreaPropsCodec;
tab_bar_codec: WidgetTabBarPropsCodec;
press_codec: WidgetPressPropsCodec;
spinbox_codec: WidgetSpinboxPropsCodec;
spinbox_result: WidgetSpinboxStepResultCodec;
time_picker_codec: WidgetTimePickerPropsCodec;
svg_icon_codec: WidgetSvgIconPropsCodec;
fieldset_codec: WidgetFieldsetPropsCodec;
line_codec: WidgetLinePropsCodec;
circle_codec: WidgetCirclePropsCodec;
ring_codec: WidgetRingPropsCodec;
triangle_codec: WidgetTrianglePropsCodec;
slider_codec: WidgetSliderPropsCodec;
slider_step: WidgetSliderStepCodec;
discrete_codec: WidgetDiscreteSliderPropsCodec;
discrete_step: WidgetSliderDiscreteStepCodec;
progress_codec: WidgetProgressPropsCodec;
toggle_codec: WidgetTogglePropsCodec;
vector_codec: WidgetVector2Codec;
time_picker_result: WidgetTimePickerResultCodec;
tab_codecs: [40]WidgetTabCodec;
tab_values: [40]HostValue;
segmented_codec: WidgetSegmentedControlPropsCodec;
segmented_result: WidgetSegmentedControlResultCodec;
segment_codecs: [40]WidgetSegmentOptionCodec;
segment_values: [40]HostValue;
title_bar_codec: WidgetTitleBarPropsCodec;
dropdown_codec: WidgetDropdownPropsCodec;
dropdown_result: WidgetDropdownResultCodec;
title_bar_result: WidgetTitleBarResultCodec;
modal_codec: WidgetModalFramePropsCodec;
modal_result: WidgetModalFrameResultCodec;
action_modal_codec: WidgetActionModalPropsCodec;
action_modal_result: WidgetActionModalResultCodec;
action_codec: WidgetActionModalActionCodec;
option_codecs: [40]WidgetDropdownOptionCodec;
option_values: [40]HostValue;
menu_codec: WidgetContextMenuPropsCodec;
menu_item_codecs: [3]WidgetContextMenuItemCodec;
menu_values: [3]HostValue;
menu_result_codec: WidgetContextMenuResultCodec;
tile_map_codec: WidgetTileMapPropsCodec;
tile_map_result_codec: WidgetTileMapResultCodec;

// The paint a frame queued, to compare a hosted map with one drawn directly.
TileMapPaint :: struct { kind: s32; bounds: Rectangle; color: Color; asset: [64]u8; smooth: bool }
tile_map_paint: [32]TileMapPaint;

TileMapPaintTake :: (session: Session) -> s32 {
    count := PendingPaintCount(session)
    if count > 32 { return -1 }
    for index: cast(s32)0..count - 1 {
        paint := PendingPaintAt(session, index)
        tile_map_paint[index] = .{.kind = paint.kind, .bounds = paint.bounds, .color = paint.color, .smooth = paint.smooth}
        unused CopyCString(paint.asset_path, tile_map_paint[index].asset[:])
    }
    return count
}

TileMapPaintSame :: (session: Session, count: s32) -> bool {
    if PendingPaintCount(session) != count { return false }
    for index: cast(s32)0..count - 1 {
        paint := PendingPaintAt(session, index)
        kept := tile_map_paint[index]
        if paint.kind != kept.kind || paint.bounds.x != kept.bounds.x || paint.bounds.y != kept.bounds.y ||
        paint.bounds.width != kept.bounds.width || paint.bounds.height != kept.bounds.height ||
        paint.color.r != kept.color.r || paint.color.g != kept.color.g || paint.color.b != kept.color.b ||
        paint.color.a != kept.color.a || paint.smooth != kept.smooth || paint.asset_path != TextFromCString(*tile_map_paint[index].asset[0]) { return false }
    }
    return true
}

// Calls the host as a bundle does: arguments as values, names as C text.
// Hosted shapes fill triangles through the renderer; this test draws none.
#program_export
RasterTriangles :: (points: []Vector2, color: Color) {
    unused points
    unused color
}

Call :: (module: string, function: string, arguments: []HostValue, result: *HostValue) -> s32 {
    unused CopyCString(module, module_name[:])
    unused CopyCString(function, function_name[:])
    data: *HostValue = null
    if arguments.count > 0 {
        data = *arguments[0]
    }
    return WidgetHostCall(null, *module_name[0], *function_name[0], data,
        cast(s32)arguments.count, result)
}

#program_export
main :: () -> s32 {
    dimensions := HostedImageDimensions()
    if dimensions != 0 { return 1000 + dimensions }
    boundary := HostedPointerBoundary()
    if boundary != 0 { print("hosted pointer boundary failed %\n", boundary); return 950 + boundary }
    if !WidgetHostSupports("modal", "ActionModalHostedHost") { return 40 }
    if !WidgetHostSupports("toggle", "ToggleHostedHost") ||
    !WidgetHostSupports("press", "PressHostedHost") ||
    !WidgetHostSupports("spinbox", "SpinboxHostedHost") ||
    !WidgetHostSupports("timepicker", "TimePickerHostedHost") ||
    !WidgetHostSupports("titlebar", "TitleBarHostedHost") ||
    !WidgetHostSupports("dropdown", "DropdownHostedHost") ||
    !WidgetHostSupports("modal_frame", "ModalFrameHostedHost") ||
    !WidgetHostSupports("tree", "EndHostedHost") ||
    !WidgetHostSupports("svgicon", "SvgIconHostedHost") ||
    WidgetHostSupports("text", "TextNativeHost") {
        return 1
    }
    GlyphMetricsChanged()
    session := SessionOpen()
    result: HostValue
    arguments: [3]HostValue
    arguments[0] = WidgetEncodeSession(session, *session_codec)
    arguments[1] = WidgetEncodeTextProps(Text.Props.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *text_codec)
    // Outside a bundle frame nothing draws.
    if Call("pointer_input", "PollPointer", arguments[:0], *result) != 0 {
        return 101
    }
    if Call("text", "TextHostedHost", arguments[:2], *result) != 0 {
        return 2
    }
    unused TreePointerUpdate(session, PointerFrame.{.x = 13.0, .y = 21.0, .pressed = true})
    other_pointer_session := SessionOpen()
    unused TreePointerUpdate(other_pointer_session, PointerFrame.{.x = 99.0, .y = 100.0})
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 200.0})
    WidgetHostBegin(session, AllowPhoto)
    if !WidgetHostSupports("pointer_input", "PollPointer") ||
    Call("pointer_input", "PollPointer", arguments[:0], *result) != 1 ||
    !WidgetValidPointerFrame(result) {
        return 102
    }
    pointer_codec: WidgetPointerFrameCodec
    pointer := WidgetDecodePointerFrame(result, *pointer_codec)
    if pointer.x != 13.0 || pointer.y != 21.0 || !pointer.pressed ||
    Call("pointer_input", "PollPointer", arguments[:1], *result) != 0 {
        return 103
    }
    unused SessionClose(other_pointer_session)
    if Call("p0123456789abcdef_text", "TextHostedHost", arguments[:2], *result) != 1 {
        return 3
    }
    // Another frame's session, a missing argument or the wrong record is refused.
    stale := session
    stale.epoch += cast(u64)1
    stale_codec: WidgetSessionCodec
    stale_arguments: [2]HostValue = .[WidgetEncodeSession(stale, *stale_codec), arguments[1]]
    stale_result := Call("text", "TextHostedHost", stale_arguments[:], *result)
    missing_result := Call("text", "TextHostedHost", arguments[:1], *result)
    record_result := Call("image", "ImageHostedHost", arguments[:2], *result)
    function_result := Call("text", "TextUnknownHost", arguments[:2], *result)
    module_result := Call("unrelated_text", "TextHostedHost", arguments[:2], *result)
    package_result := Call("p0123456789abcdeg_text", "TextHostedHost", arguments[:2], *result)
    if stale_result != 0 || missing_result != 0 || record_result != 0 ||
    function_result != 0 || module_result != 0 || package_result != 0 {
        print("host rejection mismatch: % % % % % %\n", stale_result, missing_result,
            record_result, function_result, module_result, package_result)
        return 4
    }
    // Fields match by name: a record from an older layout that lists only
    // its text, in another position, still draws.
    older := arguments[1]
    older.fields = *text_codec.fields[2]
    older.field_count = cast(usize)1
    older_arguments: [2]HostValue = .[arguments[0], older]
    if HostFieldAt(older, 0, "text") != 0 || Call("text", "TextHostedHost", older_arguments[:], *result) != 1 {
        return 5
    }
    // A portable Text's links cross with it, and the host answers which one
    // is under a point; a point that is not a pair of float32 is refused.
    if !WidgetHostSupports("p0123456789abcdef_text", "TextLinkAtHostedHost") { return 90 }
    link_ranges: [1]Text.Range = .[Text.Range.{0, 6}]
    link_codec: WidgetTextPropsCodec
    link_arguments: [4]HostValue
    link_arguments[0] = arguments[0]
    link_arguments[1] = WidgetEncodeTextProps(Text.Props.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}, .links = link_ranges[:]}, *link_codec)
    link_arguments[2] = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = 2.0}
    link_arguments[3] = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"), .real = 90.0}
    linked_props := WidgetHostTextProps(link_arguments[1])
    if linked_props.links.count != 1 || linked_props.links[0].start != 0 || linked_props.links[0].end != 6 {
        return 91
    }
    if Call("text", "TextLinkAtHostedHost", link_arguments[:], *result) != 1 ||
    result.integer != -1 || TextFromCString(result.type_name) != "s32" {
        return 92
    }
    link_arguments[3] = HostScalar("s32", 5)
    if Call("text", "TextLinkAtHostedHost", link_arguments[:], *result) != 0 ||
    Call("text", "TextLinkAtHostedHost", link_arguments[:3], *result) != 0 {
        return 93
    }
    // Guest fonts stay within the same asset boundary as their pictures.
    font_codec: WidgetTextPropsCodec
    encoded_font := WidgetEncodeTextProps(Text.Props.{.typeface = "/private/font.ttf", .line_gap = 11}, *font_codec)
    refused_font := WidgetHostTextProps(encoded_font)
    if refused_font.typeface != "" || refused_font.line_gap != 11 { return 94 }
    encoded_font = WidgetEncodeTextProps(Text.Props.{.typeface = "ui"}, *font_codec)
    if WidgetHostTextProps(encoded_font).typeface != "ui" { return 95 }
    encoded_font = WidgetEncodeTextProps(Text.Props.{.typeface = "assets/forbidden.ttf"}, *font_codec)
    if WidgetHostTextProps(encoded_font).typeface != "" { return 96 }
    // A portable app measures a line of text with the host's own fonts, to
    // place controls beside it.
    if !WidgetHostSupports("p0123456789abcdef_text_measure", "TextWidthHostedHost") { return 94 }
    width_codec: WidgetTextPropsCodec
    width_arguments: [2]HostValue = .[arguments[0], WidgetEncodeTextProps(Text.Props.{.text = "Hosted",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *width_codec)]
    if Call("text_measure", "TextWidthHostedHost", width_arguments[:], *result) != 1 ||
    TextFromCString(result.type_name) != "s32" || result.integer <= 0 {
        return 95
    }
    short_width := result.integer
    width_arguments[1] = WidgetEncodeTextProps(Text.Props.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, 200.0, 20.0}}, *width_codec)
    if Call("text_measure", "TextWidthHostedHost", width_arguments[:], *result) != 1 ||
    result.integer <= short_width {
        return 96
    }
    // And the height a paragraph takes, wrapped as Text wraps it by
    // default: a narrow one takes more lines.
    if !WidgetHostSupports("text_measure", "TextHeightHostedHost") { return 97 }
    width_arguments[1] = WidgetEncodeTextProps(Text.Props.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, 400.0, 0.0}}, *width_codec)
    if Call("text_measure", "TextHeightHostedHost", width_arguments[:], *result) != 1 ||
    TextFromCString(result.type_name) != "s32" || result.integer <= 0 {
        return 98
    }
    one_line := result.integer
    width_arguments[1] = WidgetEncodeTextProps(Text.Props.{.text = "Hosted and longer",
            .bounds = Rectangle.{0.0, 0.0, cast(float32)short_width, 0.0}}, *width_codec)
    if Call("text_measure", "TextHeightHostedHost", width_arguments[:], *result) != 1 ||
    result.integer <= one_line {
        return 99
    }
    // Assets pass the host's policy; texture handles never cross.
    arguments[1] = WidgetEncodeImageProps(Image.Props.{.asset_path = "assets/photo.png",
            .bounds = Rectangle.{0.0, 20.0, 40.0, 40.0}}, *image_codec)
    if Call("kryon_image", "ImageHostedHost", arguments[:2], *result) != 1 {
        return 6
    }
    // A warped image's grid crosses with it.
    meshed := Image.Props.{.asset_path = "assets/photo.png",
        .bounds = Rectangle.{0.0, 20.0, 40.0, 40.0}}
    mesh_points: [4]Vector2 = .[Vector2.{0.0, 20.0}, Vector2.{30.0, 20.0},
    Vector2.{0.0, 60.0}, Vector2.{30.0, 55.0}]
    meshed.mesh.columns = 2
    meshed.mesh.rows = 2
    meshed.mesh.points = mesh_points[:]
    before := PendingPaintCount(session)
    arguments[1] = WidgetEncodeImageProps(meshed, *image_codec)
    // A bundle sends the points; image codecs keep no room for them, so
    // they are attached here as the bundle's values would be.
    point_values: [4]HostValue
    point_codecs: [4]WidgetVector2Codec
    for index: cast(s32)0..3 {
        point_values[index] = WidgetEncodeVector2(mesh_points[index], *point_codecs[index])
    }
    mesh_at := HostFieldAt(arguments[1], 13, "mesh")
    points_at := HostFieldAt(arguments[1].fields[mesh_at].value, 2, "points")
    if mesh_at < 0 || points_at < 0 || arguments[1].fields[mesh_at].value.fields[points_at].value.length != cast(usize)0 {
        return 42
    }
    arguments[1].fields[mesh_at].value.fields[points_at].value.length = cast(usize)4
    arguments[1].fields[mesh_at].value.fields[points_at].value.elements = *point_values[0]
    if Call("image", "ImageHostedHost", arguments[:2], *result) != 1 {
        return 40
    }
    queued := PendingPaintAt(session, PendingPaintCount(session) - 1)
    if PendingPaintCount(session) != before + 1 || queued.mesh_columns != 2 ||
    queued.mesh_rows != 2 || queued.mesh_points.count != 4 ||
    queued.mesh_points[3].x != 30.0 || queued.mesh_points[3].y != 55.0 {
        return 41
    }
    arguments[1] = WidgetEncodeImageProps(Image.Props.{.asset_path = "private/key.png"}, *image_codec)
    if Call("image", "ImageHostedHost", arguments[:2], *result) != 0 {
        return 7
    }
    texture := Image.Props.{.asset_path = "assets/photo.png"}
    texture.texture.id = cast(u32)3
    arguments[1] = WidgetEncodeImageProps(texture, *image_codec)
    checks := asset_checks
    if Call("image", "ImageHostedHost", arguments[:2], *result) != 0 || asset_checks != checks {
        return 8
    }
    arguments[1] = WidgetEncodeButtonProps(Button.Props.{.id = 9, .label = "Save",
            .bounds = Rectangle.{0.0, 60.0, 80.0, 30.0}}, *button_codec)
    if Call("button", "ButtonHostedHost", arguments[:2], *result) != 1 ||
    result.kind != cast(s32)HostInteger || TextFromCString(result.type_name) != "s32" || result.integer != 0 {
        return 9
    }
    // A press area answers with its press state.
    arguments[1] = WidgetEncodePressProps(Press.Props.{.id = 12, .label = "Message",
            .bounds = Rectangle.{0.0, 100.0, 200.0, 40.0}, .now = 1.0}, *press_codec)
    if Call("press", "PressHostedHost", arguments[:2], *result) != 1 ||
    result.kind != cast(s32)HostRecord || TextFromCString(result.type_name) != "Press.PressResult" {
        return 30
    }
    // A spinbox answers with its value, kept within its range.
    arguments[1] = WidgetEncodeSpinboxProps(Spinbox.Props.{.id = 13, .label = "Length",
            .bounds = Rectangle.{0.0, 140.0, 150.0, 38.0}, .min = 5, .max = 35, .step = 1,
            .value = 16}, *spinbox_codec)
    if Call("spinbox", "SpinboxHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "Spinbox.SpinboxStepResult" ||
    WidgetDecodeSpinboxStepResult(result, *spinbox_result).value != 16 {
        return 31
    }
    // A time picker answers with its time, clamped to the day.
    arguments[1] = WidgetEncodeTimePickerProps(TimePicker.Props.{.id = 14, .label = "Start",
            .bounds = Rectangle.{0.0, 180.0, 150.0, 36.0}, .value = 2000, .now = -1}, *time_picker_codec)
    if Call("timepicker", "TimePickerHostedHost", arguments[:2], *result) != 1 ||
    TextFromCString(result.type_name) != "TimePicker.TimePickerResult" ||
    WidgetDecodeTimePickerResult(result, *time_picker_result).value != 1439 ||
    WidgetDecodeTimePickerResult(result, *time_picker_result).changed {
        return 32
    }
    // A fieldset paints its frame; a toggle answers the size it needs.
    fieldset_before := PendingPaintCount(session)
    arguments[1] = WidgetEncodeFieldsetProps(Fieldset.Props.{.bounds = Rectangle.{0.0, 220.0, 200.0, 80.0}},
        *fieldset_codec)
    if Call("fieldset", "FieldsetHostedHost", arguments[:2], *result) != 1 ||
    PendingPaintCount(session) <= fieldset_before {
        return 107
    }
    arguments[1] = WidgetEncodeToggleProps(Toggle.Props.{.off_label = "Off", .on_label = "On"},
        *toggle_codec)
    if Call("toggle_measure", "ToggleSizeHostedHost", arguments[:2], *result) != 1 ||
    !WidgetValidVector2(result) || WidgetDecodeVector2(result, *vector_codec).x <= 0.0 ||
    WidgetDecodeVector2(result, *vector_codec).y <= 0.0 {
        return 108
    }
    // Each shape paints itself.
    shape_before := PendingPaintCount(session)
    black := Color.{0, 0, 0, 255}
    arguments[1] = WidgetEncodeLineProps(Shape.Props.{.start = Vector2.{10.0, 300.0},
            .end = Vector2.{60.0, 330.0}, .thickness = 2.0, .color = black}, *line_codec)
    if Call("shape", "LineHostedHost", arguments[:2], *result) != 1 { return 109 }
    arguments[1] = WidgetEncodeCircleProps(Shape.CircleProps.{.center = Vector2.{80.0, 300.0},
            .radius = 6.0, .fill = black}, *circle_codec)
    if Call("shape", "CircleHostedHost", arguments[:2], *result) != 1 { return 110 }
    arguments[1] = WidgetEncodeRingProps(Shape.RingProps.{.center = Vector2.{100.0, 300.0},
            .inner_radius = 3.0, .outer_radius = 6.0, .end_angle = 180.0, .color = black},
        *ring_codec)
    if Call("shape", "RingHostedHost", arguments[:2], *result) != 1 { return 111 }
    arguments[1] = WidgetEncodeTriangleProps(Shape.TriangleProps.{.first = Vector2.{120.0, 300.0},
            .second = Vector2.{130.0, 310.0}, .third = Vector2.{110.0, 310.0}, .color = black},
        *triangle_codec)
    if Call("shape", "TriangleHostedHost", arguments[:2], *result) != 1 ||
    PendingPaintCount(session) < shape_before + 4 {
        return 112
    }
    // Sliders answer with their value as it is, untouched by a pointer;
    // a progress bar paints itself.
    arguments[1] = WidgetEncodeSliderProps(Slider.Props.{.key = cast(u64)317,
            .bounds = Rectangle.{10.0, 340.0, 200.0, 36.0}, .value = 4.0, .max = 10.0}, *slider_codec)
    if Call("slider", "SliderHostedHost", arguments[:2], *result) != 1 ||
    !WidgetValidSliderStep(result) || WidgetDecodeSliderStep(result, *slider_step).value != 4.0 {
        return 113
    }
    arguments[1] = WidgetEncodeDiscreteSliderProps(Slider.DiscreteSliderProps.{.key = cast(u64)318,
            .bounds = Rectangle.{10.0, 380.0, 200.0, 36.0}, .value = 3, .max = 10}, *discrete_codec)
    if Call("slider", "DiscreteSliderHostedHost", arguments[:2], *result) != 1 ||
    !WidgetValidSliderDiscreteStep(result) ||
    WidgetDecodeSliderDiscreteStep(result, *discrete_step).value != 3 {
        return 114
    }
    progress_before := PendingPaintCount(session)
    arguments[1] = WidgetEncodeProgressProps(Progress.Props.{.key = cast(u64)319,
            .bounds = Rectangle.{10.0, 420.0, 200.0, 5.0}, .max = 60, .value = 30}, *progress_codec)
    if Call("progress", "ProgressHostedHost", arguments[:2], *result) != 1 ||
    PendingPaintCount(session) <= progress_before {
        return 115
    }
    // A vector icon on its own paints its cells and answers nothing.
    icon_before := PendingPaintCount(session)
    icon: SvgIcon.Props
    icon.bounds = Rectangle.{160.0, 180.0, 24.0, 24.0}
