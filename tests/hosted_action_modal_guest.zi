// A package consumer's portable action dialog, run by
// tests/ziran_hosted_action_modal_test.sh through Kryon's real widget host.
#import "kryon/session"
#import "kryon/tree"
Modal :: #import "kryon/modal";
TitleBar :: #import "kryon/title_bar";
Dropdown :: #import "kryon/dropdown";

test_host :: #system_library "host_api";
TestSessionHost :: () -> Session #foreign test_host;
TestFrameHost :: () -> s32 #foreign test_host;

#program_export
main :: () -> s32 {
    session := TestSessionHost()
    frame := TestFrameHost()
    options: [1]Dropdown.Option = .[Dropdown.Option.{.label = "Settings"}]
    // Removing the title bar after frame zero changes the modal node index.
    if frame == 0 {
        unused TitleBar.Draw(session, TitleBar.Props.{.key = cast(u64)19, .title = "Customize"}, options[:])
    }
    actions: [2]Modal.ActionModalAction = .[
        Modal.ActionModalAction.{.key = cast(u64)1, .label = "Keep editing"},
        Modal.ActionModalAction.{.key = cast(u64)2, .label = "Discard"},
    ]
    decision := Modal.ActionModal(session, Modal.ActionModalProps.{.key = cast(u64)17,
        .title = "Unsaved changes", .message = "Your draft stays here."}, actions[:])
    // Nothing was clicked, so the open dialog makes no decision yet.
    if decision.action != 0 { return 1 }
    // Match an application that submits its dialog in a hosted root scope.
    // Escape must reach only this upper modal, despite changing node indices.
    if !TreePushScope(session, 0) { return 2 }
    result := Modal.Draw(session, Modal.Props.{.key = cast(u64)29,
        .title = "Habit", .dismiss_disabled = frame >= 3})
    if result.opened { unused End(session) }
    if !End(session) { return 3 }
    if frame == 1 {
        if !result.dismissed || result.opened { return 4 }
    } else {
        if result.dismissed || !result.opened { return 5 }
    }
    return 7
}
