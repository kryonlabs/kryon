#import "drawing_props"
#import "geometry"

fills: s32;
strokes: s32;
labels: s32;
action_fills: s32;
failed: bool;

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return cast(s32)value.count * 8
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 14
}

#program_export
ImageWidth :: (path: string) -> s32 {
    unused path
    failed = true
    return 0
}

#program_export
ImageHeight :: (path: string) -> s32 {
    unused path
    failed = true
    return 0
}

#program_export
RasterImage :: (path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    unused path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused radius
    unused segments
    if bounds.x < 10.0 || bounds.y < 10.0 ||
        bounds.x + bounds.width > 310.0 ||
        bounds.y + bounds.height > 130.0 || color.a == cast(u8)0 {
        failed = true
    }
    if bounds.x == 224.0 && bounds.y == 13.0 &&
        bounds.width == 34.0 && bounds.height == 34.0 {
        if color.r != cast(u8)18 || color.g != cast(u8)52 ||
            color.b != cast(u8)86 { failed = true }
        action_fills += 1
    }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused bounds
    unused radius
    unused segments
    unused width
    unused color
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    if line.x < 10.0 || line.x + line.width > 310.0 ||
        line.y < 10.0 || line.y + line.height > 130.0 ||
        color.a == cast(u8)0 { failed = true }
    strokes += 1
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if value.count == 0 || x < 10 || x > 310 || y < 10 || y > 130 ||
        font != 14 || clip.x < 10.0 ||
        clip.x + clip.width > 310.0 || color.a == cast(u8)0 {
        failed = true
    }
    labels += 1
}

#program_export
ToolbarHostFailed :: () -> bool { return failed }

#program_export
ToolbarFills :: () -> s32 { return fills }

#program_export
ToolbarStrokes :: () -> s32 { return strokes }

#program_export
ToolbarLabels :: () -> s32 { return labels }

#program_export
ToolbarActionFills :: () -> s32 { return action_fills }
