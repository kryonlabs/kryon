// Real DOM events enter through the public Canvas host, then the ordinary
// key decoder, retained secure widget and caller-owned buffer.
using Host :: #import "Canvas";
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "text_input"
#import "text_input_props"
#import "textfield"
#import "text"
#import "key_input"
#import "paint_queue"
#import "frame_snapshot"
#import "web"

bytes: [64]u8;
state: TextFieldState;
frames: s32;
edits: s32;
shortcuts: s32;

Number :: (name: string, value: s32) {
    WebSet(WebGlobal, WebName(name), WebNumber(cast(float64)value))
}

Frame :: (session: Session) -> s32 {
    typed: [64]u8
    key := KeyboardTake(session)
    modifiers := KeyboardModifiers(session)
    if key == 65 && (modifiers & KeyModifierControl) != 0 { shortcuts += 1 }
    snapshot := CaptureFrameInput(session)
    if !snapshot.available { return 12 }
    input := TextFieldInputFor(key, modifiers, TypedTextTake(session, typed[:]))
    if frames == 0 { input.focus = true }
    value := TextView(bytes[:state.length])
    mask := "••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••"
    display := TextSpan(mask, 0, TextFieldCodepoints(value) * 3)
    props := TextFieldProps.{.key = 992, .bounds = .{20.0, 20.0, 280.0, 40.0},
        .label = "Secret", .secure = true, .display_value = display, .input = input}
    result := TextField(session, TextFieldStateProps(state, props))
    if result.clipboard_write || result.clipboard_text != "" { return 1 }
    mask_painted := display.count == 0
    selection_painted := false
    for at: cast(s32)0..PendingPaintCount(session) - 1 {
        paint := PendingPaintAt(session, at)
        if paint.value != "" && paint.value != "Secret" && paint.value != display { return 2 }
        if display.count > 0 && paint.value == display { mask_painted = true }
        // Selection is an additional rounded fill between background and text.
        if paint.kind == cast(s32)PaintKind.PaintKindRoundedFill &&
            paint.bounds.height < props.bounds.height && paint.bounds.width > 0.0 {
            selection_painted = true
        }
    }
    if !mask_painted { return 3 }
    if EndCanvasUiFrame(session) != FrameStatus.FrameOk { return 4 }
    if !TreeNodeAt(session, result.node).secure { return 5 }
    hidden: [64]u8
    if TreeTextRange(session, result.node, 0, state.length, hidden[:]) != "" { return 6 }
    if !TextFieldStateApplyResult(*state, result) { return 7 }
    if result.edit.changed { edits += 1 }
    scope := WebScope()
    Number("passwordFrames", frames + 1)
    Number("passwordLength", state.length)
    Number("passwordCursor", state.cursor)
    Number("passwordAnchor", state.anchor)
    Number("passwordFocused", ifx state.focused then 1 else 0)
    Number("passwordKey", key)
    Number("passwordModifiers", modifiers)
    Number("passwordHeldModifiers", CanvasModifiers())
    Number("passwordSnapshotModifiers", snapshot.modifiers)
    Number("passwordSnapshotControl", cast(s32)snapshot.keys[341])
    Number("passwordShortcuts", shortcuts)
    if key != 0 {
        Number("passwordLastKey", key)
        Number("passwordLastModifiers", modifiers)
    }
    Number("passwordEdits", edits)
    Number("passwordSelectionPainted", ifx selection_painted then 1 else 0)
    // This test uses only synthetic fixture text, never owner credentials.
    WebSet(WebGlobal, WebName("passwordValue"), WebText(TextView(bytes[:state.length])))
    if result.edit.changed {
        Number("passwordEditStart", result.edit.start)
        Number("passwordEditEnd", result.edit.end)
    }
    WebEnd(scope)
    frames += 1
    return 0
}

#program_export
main :: () -> s32 {
    state.bytes = bytes[:]
    state.focused = true
    if !TextFieldStateApplyEdit(*state, TextFieldEdit.{.changed = true,
        .replacement = "Aé🔑xyz"}) { return 8 }
    if !OpenCanvas() { return 9 }
    session := SessionOpen()
    failure: s32 = 0
    while failure == 0 {
        // Hold only the test application's next frame, leaving real DOM
        // listeners running, to reproduce input during a slow drawing frame.
        scope := WebScope()
        paused := WebAsBool(WebGet(WebGlobal, WebName("passwordPauseFrames")))
        Number("passwordPaused", ifx paused then 1 else 0)
        WebEnd(scope)
        if paused { WebSleep(16); continue }
        if !PollCanvas() { break }
        if !CanvasFrameInputBegin(session) { failure = 13; break }
        key := CanvasPressedKey()
        KeyboardModifiersSend(session, CanvasPressedKeyModifiers())
        if key != 0 { unused KeyboardSend(session, key) }
        codepoint := CanvasTypedCodepoint()
        while codepoint != 0 {
            unused TypedCodepointSend(session, codepoint)
            codepoint = CanvasTypedCodepoint()
        }
        BeginCanvasFrame()
        unused TreePointerUpdate(session, PollPointer())
        if BeginFrame(session, 1, CanvasViewport()) != FrameStatus.FrameOk { failure = 10 }
        else { failure = Frame(session) }
        if !EndCanvasFrame() { failure = 11 }
        scope = WebScope()
        Number("passwordFailure", failure)
        WebEnd(scope)
    }
    unused SessionClose(session)
    CloseCanvas()
    return failure
}
