Dropdown :: #import "dropdown";
Image :: #import "image";
#import "geometry"

Props :: struct {
    key: u64
    id: s32
    class_name: s32
    bounds: Rectangle
    title: string
    height: s32
    scale: float32
    leading_image: Image.Props
    leading_label: string
    has_leading_action: bool
    dropdown: Dropdown.Props
    has_dropdown: bool
    dropdown_min_width: s32
    dropdown_height: s32
    // The title drawn with emphasis, as Text's strong ranges.
    strong_title: bool
    // Room kept at the right for the caller's own controls, such as a
    // toggle. The title stays centred clear of it; the result's
    // trailing_bounds says where to draw them.
    trailing_width: s32
}

TitleBarResult :: struct {
    node: s32
    height: s32
    clicked_leading: bool
    dropdown: Dropdown.Result
    // Where the caller draws its controls, the full height of the bar at
    // its right; empty without trailing_width.
    trailing_bounds: Rectangle
}
