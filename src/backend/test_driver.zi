// A test process drives a running app through files in the directory named
// by KRYON_TEST_DRIVER. It reads the committed widget tree, presses widgets
// with the app's own pointer path, types text and presses keys. Without that
// variable nothing here reads files or changes input.
//
// The driver is test code, so an ordinary build leaves it out: the
// procedures below then pass the platform's input through unchanged. A build
// that defines KRYON_TEST_DRIVER (`--define KRYON_TEST_DRIVER`, or the
// variable set in the environment of `kryon build`) includes it.
//
// An app supports it by calling these where it samples input, and once after
// each frame:
//
//     pointer = TestDriverPointer(session, pointer)  // before TreePointerUpdate
//     wheel = TestDriverWheel(wheel)
//     wheel_x = TestDriverWheelX(wheel_x)          // a sideways wheel, if sampled
//     codepoint := TestDriverCodepoint()             // before the platform's typed text
//     pressed := TestDriverKeyPressed(key) || PlatformKeyPressed(key)
//     down := TestDriverKeyDown(key) || PlatformKeyDown(key)
//     TestDriverFrame(session)                       // after the frame ends
//
// The test writes one command at a time to DIR/command (written elsewhere in
// DIR and renamed into place), then waits for DIR/reply, a JSON object, and
// removes it. A command is one line of tab-separated fields: a serial number,
// a verb, then name=value fields. In values, \t, \n and \\ stand for a tab,
// a newline and a backslash.
//
//     status                    no widgets, for waiting until frames settle
//     tree                      every widget of the last committed frame
//     find SELECTOR             the widgets that match
//     press SELECTOR            moves the pointer to the first match's visible
//                               centre, presses and releases it, one frame each
//     pointer x= y= down= wheel= wheel_x=
//                               holds the pointer there for following frames,
//                               for drags; `pointer real=1` returns it.
//                               wheel_x is a sideways wheel, positive to the
//                               right
//     type text=                typed text, at most 8 codepoints a frame
//     key code= control= shift= one key press, raylib's key codes
//
// A selector has any of label= (exact), contains= (ASCII case-insensitive),
// role= (a widget kind such as button or text_field, or a semantic role such
// as heading or tab), key=, focus_id=, value= (an editor's exact text),
// visible=1, enabled=1 and index= (which match, from 0).
//
// A node reports its kind, role, label, detail, an editor's value, bounds,
// the part of them that shows (visible_*), enabled, focused, selected and
// hidden_lines: wrapped lines of its text that its box leaves out.
//
// Every reply has serial, ok, error, frame and stable_frames: how many
// frames in a row ended with the same widgets, bounds, labels and states, so
// a test can wait until animations and loading settle. The reply to a
// command that sends input is written after the frame that received its last
// input has ended.
#import "session"
#import "tree_input"
#import "input_protocol"
#import "input_delivery"
#import "c_string"

#if #defined(KRYON_TEST_DRIVER) {
    Engine :: #import "test_driver_engine";

    // Whether a test drives this process: KRYON_TEST_DRIVER names its directory.
    #program_export
    TestDriverActive :: () -> bool { return Engine.TestDriverActive() }
    // The pointer this frame: the platform's, or the test's while it drives one.
    #program_export
    TestDriverPointer :: (session: Session, real: PointerFrame) -> PointerFrame {
        return Engine.TestDriverPointer(session, real)
    }
    // The wheel this frame: a test's `pointer wheel=` once, else the platform's.
    #program_export
    TestDriverWheel :: (real: float32) -> float32 { return Engine.TestDriverWheel(real) }
    #program_export
    TestDriverWheelX :: (real: float32) -> float32 { return Engine.TestDriverWheelX(real) }
    // The next codepoint a test typed, or 0.
    #program_export
    TestDriverCodepoint :: () -> s32 { return Engine.TestDriverCodepoint() }
    // Whether a test presses, or holds, this key in this frame.
    #program_export
    TestDriverKeyPressed :: (key: s32) -> bool { return Engine.TestDriverKeyPressed(key) }
    #program_export
    TestDriverKeyDown :: (key: s32) -> bool { return Engine.TestDriverKeyDown(key) }
    // Queue this frame's test text and key into a host's ordered input.
    #program_export
    TestDriverInput :: (queue: *InputDelivery) { Engine.TestDriverInput(queue) }
    // Adds this frame's test key to a host's frame input.
    #program_export
    TestDriverFrameInput :: (input: *FrameInputSnapshot) { Engine.TestDriverFrameInput(input) }
    // After each frame: answers the test and starts its next command.
    #program_export
    TestDriverFrame :: (session: Session) { Engine.TestDriverFrame(session) }
} else {
    // A test asked to drive this program, but the build left the driver out.
    // Stop with the reason at once, so the test fails instead of waiting for
    // a reply that cannot come.
    test_driver_c :: #system_library "c";
    TestDriverEnvironment :: (name: *u8) -> *u8 #foreign test_driver_c "getenv";
    TestDriverReport :: (descriptor: s32, text: *u8, count: usize) -> s64 #foreign test_driver_c "write";
    TestDriverStop :: (status: s32) #foreign test_driver_c "exit";
    test_driver_checked: bool;
    TestDriverRequired :: () {
        if test_driver_checked { return }
        test_driver_checked = true
        name: [32]u8
        if !CopyCString("KRYON_TEST_DRIVER", name[:]) { return }
        value: *u8 = TestDriverEnvironment(*name[0])
        if value == null || value.* == cast(u8)0 { return }
        message: string = "kryon: KRYON_TEST_DRIVER is set, but this build has no test driver.\nBuild it with KRYON_TEST_DRIVER set in the environment, or with --define KRYON_TEST_DRIVER.\n"
        bytes: [256]u8
        if CopyCString(message, bytes[:]) {
            unused TestDriverReport(2, *bytes[0], cast(usize)message.count)
        }
        TestDriverStop(2)
    }

    #program_export
    TestDriverActive :: () -> bool { TestDriverRequired(); return false }
    #program_export
    TestDriverPointer :: (session: Session, real: PointerFrame) -> PointerFrame {
        unused session
        TestDriverRequired()
        return real
    }
    #program_export
    TestDriverWheel :: (real: float32) -> float32 { return real }
    #program_export
    TestDriverWheelX :: (real: float32) -> float32 { return real }
    #program_export
    TestDriverCodepoint :: () -> s32 { return 0 }
    #program_export
    TestDriverKeyPressed :: (key: s32) -> bool { unused key; return false }
    #program_export
    TestDriverKeyDown :: (key: s32) -> bool { unused key; return false }
    #program_export
    TestDriverInput :: (queue: *InputDelivery) { unused queue }
    #program_export
    TestDriverFrameInput :: (input: *FrameInputSnapshot) { unused input }
    #program_export
    TestDriverFrame :: (session: Session) { unused session; TestDriverRequired() }
}
