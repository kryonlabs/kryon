#import "drawing_props"
#import "geometry"
#import "image_props"
#import "image"
#import "paint_texture"
#import "raster"
#import "raster_shape"
#import "raster_text"
#import "text_typeface"
#import "session"
#import "tree"
#import "vec"
host_api :: #system_library "host_api";

PaintKind :: enum {
    PaintKindLine :: 1
    PaintKindRoundedFill :: 2
    PaintKindRoundedOutline :: 3
    PaintKindText :: 4
    PaintKindImage :: 5
    PaintKindClippedText :: 6
    PaintKindVerticalGradient :: 7
    // The shape widgets' paint, tessellated into triangles by shape_paint.
    PaintKindShapeLine :: 8
    PaintKindShapeCircle :: 9
    PaintKindShapeRing :: 10
    PaintKindShapeTriangle :: 11
}
using PaintKind;


PaintCommand :: struct {
    node: s32
    overlay_layer: s32
    kind: s32
    bounds: Rectangle
    color: Color
    end_color: Color
    radius: float32
    segments: s32
    line_width: float32
    value: string
    x: s32
    y: s32
    font: s32
    asset_path: string
    texture_id: u32
    texture: Texture2D
    source: Rectangle
    clip: Rectangle
    // Shapes are clipped only when set; their clip stays unset otherwise.
    clip_set: bool
    origin: Vector2
    rotation: float32
    // Queued text is copied into the session's frame text so a caller may
    // pass a label formatted into its own short-lived buffer.
    text_start: s64
    text_count: s64
    text_block: s32
    owns_text: bool
    asset_start: s64
    asset_count: s64
    asset_block: s32
    owns_asset: bool
    // A clipped label drawn as the extra stroke of emphasized text.
    emphasis: bool
    // A clipped label drawn slanted, as italic text.
    italic: bool
    // An image scaled smoothly.
    smooth: bool
    // A warped image's grid (see ImageMesh). Its points are copied into the
    // session's frame storage when queued, starting at mesh_start.
    mesh_columns: s32
    image_clip_count: s32
    mesh_rows: s32
    mesh_points: []Vector2
    mesh_block: s32
    mesh_start: s32
    owns_mesh: bool
}

PaintEmitter :: #type (command: PaintCommand) -> ();
// Keep the parameter distinct from the imported geometry module so the
// concrete tree type resolves both in aggregate imports and native thunks.
PaintClipper :: #type (command: PaintCommand,
    node_geometry: NodeGeometry) -> PaintCommand;

QueuedPaint :: struct {
    data: PaintCommand
    emit: PaintEmitter
    clip_for: PaintClipper
    has_emitter: bool
    // Only the builtin constructors set this: their command kind fixes the
    // callback and every raster input is stored in the command.
    builtin_emitter: bool
    clips: bool
}

PaintCommands :: struct {
    items: Vec(QueuedPaint)
    overflow: bool
    overlays: bool
    ordered: bool
}

pending_paint: [9]PaintCommands;
ordered_paint: [9]Vec(QueuedPaint);
PAINT_TEXT_CAPACITY :: 32768
PAINT_SHORT_TEXT_CAPACITY :: 256
PAINT_MEDIUM_TEXT_CAPACITY :: 4096
PaintTextBlock :: struct { length: s32; bytes: [PAINT_TEXT_CAPACITY]u8; }
PaintShortTextBlock :: struct { length: s32; bytes: [PAINT_SHORT_TEXT_CAPACITY]u8; }
PaintMediumTextBlock :: struct { length: s32; bytes: [PAINT_MEDIUM_TEXT_CAPACITY]u8; }
// Short labels should not reserve eight full 32 KiB blocks. Allocate only
// the sizes the frame uses; retain their capacity for subsequent frames.
pending_text: [9]Vec(PaintTextBlock);
pending_short_text: [9]Vec(PaintShortTextBlock);
pending_medium_text: [9]Vec(PaintMediumTextBlock);
// The grid points of the frame's warped images. One image's grid stays in
// one block.
PaintMeshBlock :: struct { count: s32; points: [IMAGE_MESH_POINT_LIMIT]Vector2; }
pending_mesh: [9]Vec(PaintMeshBlock);

// The previous committed paint plan is retained by value. Strings and asset
// paths are copied byte-for-byte so equality does not depend on borrowed
// pointers or addresses. Byte storage grows with the accepted plan, so many
// individually bounded labels can still reuse their complete frame.
PaintSnapshot :: struct {
    data: PaintCommand
    emit: PaintEmitter
    has_emitter: bool
    builtin_emitter: bool
    value_start: s64
    value_count: s64
    asset_start: s64
    asset_count: s64
    mesh_block: s32
    mesh_start: s32
}

paint_snapshots: [9]Vec(PaintSnapshot);
paint_snapshot_meshes: [9]Vec(PaintMeshBlock);
// Eight initial Vec slots cover the former 32 KiB pool without reserving
// eight full label-sized blocks. A label may span several snapshot blocks.
PAINT_SNAPSHOT_BLOCK_CAPACITY :: 4096
PaintSnapshotBlock :: struct { bytes: [PAINT_SNAPSHOT_BLOCK_CAPACITY]u8; }
paint_snapshot_values: [9]Vec(PaintSnapshotBlock);
paint_snapshot_assets: [9]Vec(PaintSnapshotBlock);
paint_snapshot_value_counts: [9]s64;
paint_snapshot_asset_counts: [9]s64;
paint_snapshots_valid: [9]bool;
frame_paint_unchanged: [9]bool;

// A host replaced raster resources while the widget props stayed the same.
// Keep the buffers alive for an emission already in progress, but require
// composition and painting again on the next frame.
#program_export
PaintResourcesChanged :: () {
    for slot: cast(s32)0..cast(s32)paint_snapshots_valid.count - 1 {
        paint_snapshots_valid[slot] = false
        frame_paint_unchanged[slot] = false
    }
}

// Every queued label owns its text, including large grids of short-lived
// glyph buffers. Blocks grow with the frame's actual text. A label larger
// than one block or an allocation failure cancels the frame before drawing.
PaintTextRange :: struct {
    start: s32
    block: s32
    valid: bool
}

KeepPaintBlockBytes :: (blocks: *Vec($T), slot: s32, value: string,
    capacity: s32, inverted: bool, offset: s32) -> PaintTextRange {
    result: PaintTextRange
    block_index: s32 = cast(s32)blocks.*.count - 1
    start: s32 = 0
    if block_index >= 0 { start = blocks.*[block_index].length }
    if block_index < 0 || value.count > cast(s64)(capacity - start) {
        // Copy before growing: value may refer to another block in this Vec.
        extra: T
        for at: cast(s64)0..value.count - 1 { extra.bytes[at] = value[at] }
        extra.length = cast(s32)value.count
        if !VecPush(blocks.*, extra) {
            pending_paint[slot].overflow = true
            return result
        }
        block_index += 1
        start = 0
    } else {
        for at: cast(s64)0..value.count - 1 {
            blocks.*[block_index].bytes[cast(s64)start + at] = value[at]
        }
        blocks.*[block_index].length = start + cast(s32)value.count
    }
    result.start = start
    if inverted { result.start = -start - offset - 1 }
    result.block = block_index
    result.valid = true
    return result
}

KeepShortPaintBytes :: (slot: s32, value: string) -> PaintTextRange {
    return KeepPaintBlockBytes(*pending_short_text[slot], slot, value,
        PAINT_SHORT_TEXT_CAPACITY, true, 0)
}

KeepMediumPaintBytes :: (slot: s32, value: string) -> PaintTextRange {
    return KeepPaintBlockBytes(*pending_medium_text[slot], slot, value,
        PAINT_MEDIUM_TEXT_CAPACITY, true, PAINT_SHORT_TEXT_CAPACITY)
}

KeepLongPaintBytes :: (slot: s32, value: string) -> PaintTextRange {
    return KeepPaintBlockBytes(*pending_text[slot], slot, value,
        PAINT_TEXT_CAPACITY, false, 0)
}

// The signed offset also records the pool, without enlarging every paint
// command: nonnegative is long, -1..-256 is short, and lower is medium.
KeepPaintBytes :: (slot: s32, value: string) -> PaintTextRange {
    if value.count <= PAINT_SHORT_TEXT_CAPACITY { return KeepShortPaintBytes(slot, value) }
    if value.count <= PAINT_MEDIUM_TEXT_CAPACITY { return KeepMediumPaintBytes(slot, value) }
    if value.count <= PAINT_TEXT_CAPACITY { return KeepLongPaintBytes(slot, value) }
    pending_paint[slot].overflow = true
    invalid: PaintTextRange
    return invalid
}

PendingTextValue :: (slot: s32, block: s32, offset: s64, count: s64) -> string {
    if offset >= 0 {
        return TextView(pending_text[slot][block].bytes[offset:offset + count])
    }
    if offset >= -PAINT_SHORT_TEXT_CAPACITY {
        start := -offset - 1
        return TextView(pending_short_text[slot][block].bytes[start:start + count])
    }
    start := -offset - PAINT_SHORT_TEXT_CAPACITY - 1
    return TextView(pending_medium_text[slot][block].bytes[start:start + count])
}

// Only the ownership fields change; avoid copying the drawing record and
// its nested geometry just to retain a label or image path.
KeepPaintText :: (slot: s32, data: *PaintCommand) {
    if data.value.count == 0 { return }
    retained := KeepPaintBytes(slot, data.value)
    if !retained.valid { return }
    data.text_start = cast(s64)retained.start
    data.text_count = data.value.count
    data.text_block = retained.block
    data.owns_text = true
}

// Asset paths have the same frame lifetime as labels. In particular, an
// image may be composed from a caller's temporary or editable path buffer.
KeepPaintAsset :: (slot: s32, data: *PaintCommand) {
    if data.asset_path.count == 0 { return }
    retained := KeepPaintBytes(slot, data.asset_path)
    if !retained.valid { return }
    data.asset_start = cast(s64)retained.start
    data.asset_count = data.asset_path.count
    data.asset_block = retained.block
    data.owns_asset = true
}

// The number of grid points a warped image draws; 0 when its grid is not
// a mesh (fewer than 2 columns or rows) or is larger than one image draws.
PaintMeshPointCount :: (columns: s32, rows: s32) -> s64 {
    if columns < 2 || rows < 2 { return 0 }
    count: s64 = cast(s64)columns * cast(s64)rows
    if count > cast(s64)IMAGE_MESH_POINT_LIMIT { return 0 }
    return count
}

PaintPointCount :: (data: PaintCommand) -> s64 {
    if data.image_clip_count >= 3 && data.image_clip_count <= IMAGE_MESH_POINT_LIMIT { return data.image_clip_count }
    return PaintMeshPointCount(data.mesh_columns, data.mesh_rows)
}

PaintMeshRange :: struct {
    block: s32
    start: s32
    valid: bool
}

// Copies a grid into the last block of `blocks`, or a new one when it does
// not fit, moved by (dx, dy).
KeepMeshPoints :: (blocks: *Vec(PaintMeshBlock), points: []Vector2,
    count: s64, dx: float32, dy: float32) -> PaintMeshRange {
    result: PaintMeshRange
    if count <= 0 || count > cast(s64)IMAGE_MESH_POINT_LIMIT ||
    points.count < count { return result }
    block_index: s32 = cast(s32)blocks.count - 1
    if block_index < 0 || count > cast(s64)(IMAGE_MESH_POINT_LIMIT -
        blocks.*[block_index].count) {
        empty: PaintMeshBlock
        if !VecPush(blocks.*, empty) { return result }
        block_index += 1
    }
    block := *blocks.*[block_index]
    start: s32 = block.count
    at: s32 = 0
    while cast(s64)at < count {
        point: Vector2 = points[at]
        point.x += dx
        point.y += dy
        block.points[start + at] = point
        at += 1
    }
    block.count = start + at
    result.block = block_index
    result.start = start
    result.valid = true
    return result
}

// A warped image's points live as long as its label would: a caller may
// build them in a short-lived buffer. Points move with their node, as the
// command's bounds and clip do.
KeepPaintMesh :: (slot: s32, data: *PaintCommand, dx: float32, dy: float32) {
    count: s64 = PaintPointCount(data.*)
    if count == 0 { return }
    if data.image_clip_count > 0 { dx = 0.0; dy = 0.0 }
    kept := KeepMeshPoints(*pending_mesh[slot], data.mesh_points, count, dx, dy)
    if !kept.valid {
        pending_paint[slot].overflow = true
        return
    }
    data.mesh_block = kept.block
    data.mesh_start = kept.start
    data.owns_mesh = true
}

// Raw rasterization; the queued source, clip, radius, and tint are chosen in
// checked widget code before this device effect is called.
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) #foreign host_api;

// Draws the source rectangle of a texture warped over a columns × rows grid
// of points (see ImageMesh), each cell as two textured triangles, inside
// the clip. Points beyond columns × rows are ignored; fewer draw nothing.
RasterImageMesh :: (asset_path: string, texture_id: u32,
    source: Rectangle, points: []Vector2, columns: s32, rows: s32,
    clip: Rectangle, tint: Color) #foreign host_api;

#program_export
EmitPaint :: (command: QueuedPaint) {
    if paint_recorder != null && paint_recorder(command) { return }
    EmitPaintDirect(command)
}

// A native host may retain an owned frame for another thread to rasterize.
// The recorder must copy borrowed text and mesh points before returning.
PaintRecorder :: #type (command: QueuedPaint) -> bool;
paint_recorder: PaintRecorder;

EmitPaintDirect :: (command: QueuedPaint) {
    if command.has_emitter {
        emit: PaintEmitter = command.emit
        emit(command.data)
    }
}

// Shapes inside a clipping node, such as cards in a scroll view, draw only
// their visible part. Straight spans become rectangles, and only the rows of
// a cut corner are drawn one at a time, so no backend clip is needed.
ShapeVisible :: (command: PaintCommand) -> Rectangle {
    if !command.clip_set { return command.bounds }
    visible: Rectangle = RectangleIntersection(command.bounds, command.clip)
    if visible.width <= 0.0 || visible.height <= 0.0 {
        return Rectangle.{0.0, 0.0, 0.0, 0.0}
    }
    return visible
}

ShapeWhole :: (command: PaintCommand, visible: Rectangle) -> bool {
    return visible.x == command.bounds.x && visible.y == command.bounds.y &&
    visible.width == command.bounds.width &&
    visible.height == command.bounds.height
}

ShapeRadius :: (bounds: Rectangle, radius: float32) -> float32 {
    if radius < 0.0 { radius = 0.0 }
    if radius > bounds.width * 0.5 { radius = bounds.width * 0.5 }
    if radius > bounds.height * 0.5 { radius = bounds.height * 0.5 }
    return radius
}

ShapeSquareRoot :: (value: float32) -> float32 {
    if value <= 0.0 { return 0.0 }
    root: float32 = value
    if root < 1.0 { root = 1.0 }
    step: s32 = 0
    while step < 12 {
        root = (root + value / root) * 0.5
        step += 1
    }
    return root
}

// How far a corner of radius r curves in from the edge at distance dy from
// the corner's center row; zero outside the corner.
ShapeCornerInset :: (radius: float32, dy: float32) -> float32 {
    if radius <= 0.0 || dy <= 0.0 { return 0.0 }
    if dy >= radius { return radius }
    return radius - ShapeSquareRoot(radius * radius - dy * dy)
}

FillClippedSpan :: (x0: float32, x1: float32, y: float32, height: float32,
    visible: Rectangle, color: Color) {
    left: float32 = x0
    right: float32 = x1
    top: float32 = y
    bottom: float32 = y + height
    if left < visible.x { left = visible.x }
    if right > visible.x + visible.width { right = visible.x + visible.width }
    if top < visible.y { top = visible.y }
    if bottom > visible.y + visible.height { bottom = visible.y + visible.height }
    if right <= left || bottom <= top { return }
    FillRoundedRectangle(Rectangle.{left, top, right - left, bottom - top},
        0.0, 0, color)
}

// Spans of a rounded rectangle, or of its outline when width > 0, for the
// rows from top to bottom, clipped to visible.
FillShapeRows :: (bounds: Rectangle, radius: float32, width: float32,
    top: float32, bottom: float32, visible: Rectangle, color: Color) {
    if top < visible.y { top = visible.y }
    if bottom > visible.y + visible.height { bottom = visible.y + visible.height }
    inner_radius: float32 = radius - width
    if inner_radius < 0.0 { inner_radius = 0.0 }
    y: float32 = top
    while y < bottom {
        height: float32 = 1.0
        if y + height > bottom { height = bottom - y }
        center: float32 = y + height * 0.5
        dy: float32 = bounds.y + radius - center
        if center > bounds.y + bounds.height * 0.5 {
            dy = center - (bounds.y + bounds.height - radius)
        }
        outer: float32 = ShapeCornerInset(radius, dy)
        left: float32 = bounds.x + outer
        right: float32 = bounds.x + bounds.width - outer
        inside: bool = width > 0.0 && center > bounds.y + width &&
        center < bounds.y + bounds.height - width
        if !inside {
            FillClippedSpan(left, right, y, height, visible, color)
        } else {
            inner_dy: float32 = bounds.y + width + inner_radius - center
            if center > bounds.y + bounds.height * 0.5 {
                inner_dy = center - (bounds.y + bounds.height - width - inner_radius)
            }
            inner: float32 = width + ShapeCornerInset(inner_radius, inner_dy)
            FillClippedSpan(left, bounds.x + inner, y, height, visible, color)
            FillClippedSpan(bounds.x + bounds.width - inner, right, y, height,
                visible, color)
        }
        y += height
    }
}

FillShapeClipped :: (bounds: Rectangle, radius: float32, width: float32,
    visible: Rectangle, color: Color) {
    radius = ShapeRadius(bounds, radius)
    band: float32 = radius
    if width > band { band = width }
    if band > bounds.height * 0.5 { band = bounds.height * 0.5 }
    middle_top: float32 = bounds.y + band
    middle_bottom: float32 = bounds.y + bounds.height - band
    FillShapeRows(bounds, radius, width, bounds.y, middle_top, visible, color)
    if middle_bottom > middle_top {
        if width > 0.0 {
            FillClippedSpan(bounds.x, bounds.x + width, middle_top,
                middle_bottom - middle_top, visible, color)
            FillClippedSpan(bounds.x + bounds.width - width,
                bounds.x + bounds.width, middle_top,
                middle_bottom - middle_top, visible, color)
        } else {
            FillClippedSpan(bounds.x, bounds.x + bounds.width, middle_top,
                middle_bottom - middle_top, visible, color)
        }
    }
    FillShapeRows(bounds, radius, width, middle_bottom,
        bounds.y + bounds.height, visible, color)
}

EmitLine :: (command: PaintCommand) {
    if command.clip_set {
        clip: Rectangle = command.clip
        line: Rectangle = command.bounds
        if line.width != 0.0 && line.height != 0.0 {
            // A diagonal line is drawn whole or not at all.
            if line.x < clip.x || line.y < clip.y ||
            line.x + line.width > clip.x + clip.width ||
            line.y + line.height > clip.y + clip.height { return }
        } else if line.height == 0.0 {
            if line.y < clip.y || line.y > clip.y + clip.height { return }
            x0: float32 = line.x
            x1: float32 = line.x + line.width
            if x0 < clip.x { x0 = clip.x }
            if x1 > clip.x + clip.width { x1 = clip.x + clip.width }
            if x1 <= x0 { return }
            line.x = x0
            line.width = x1 - x0
        } else {
            if line.x < clip.x || line.x > clip.x + clip.width { return }
            y0: float32 = line.y
            y1: float32 = line.y + line.height
            if y0 < clip.y { y0 = clip.y }
            if y1 > clip.y + clip.height { y1 = clip.y + clip.height }
            if y1 <= y0 { return }
            line.y = y0
            line.height = y1 - y0
        }
        StrokeLine(line, command.color)
        return
    }
    StrokeLine(command.bounds, command.color)
}

EmitRoundedFill :: (command: PaintCommand) {
    if command.color.a == cast(u8)0 { return }
    visible: Rectangle = ShapeVisible(command)
    if visible.width <= 0.0 { return }
    if ShapeWhole(command, visible) {
        FillRoundedRectangle(command.bounds, command.radius,
            command.segments, command.color)
        return
    }
    FillShapeClipped(command.bounds, command.radius, 0.0, visible,
        command.color)
}

GradientChannel :: (first: u8, second: u8, amount: float32) -> u8 {
    value: float32 = cast(float32)first +
    (cast(float32)second - cast(float32)first) * amount + 0.5
    if value <= 0.0 { return cast(u8)0 }
    if value >= 255.0 { return cast(u8)255 }
    return cast(u8)value
}

#program_export
GradientColorAt :: (first: Color, second: Color, amount: float32) -> Color {
    if amount < 0.0 { amount = 0.0 }
    if amount > 1.0 { amount = 1.0 }
    return Color.{GradientChannel(first.r, second.r, amount),
        GradientChannel(first.g, second.g, amount),
        GradientChannel(first.b, second.b, amount),
        GradientChannel(first.a, second.a, amount)}
}

// Backends rasterize only flat rectangles, so a gradient is drawn as one-pixel
// rows sampled at their centers.
EmitVerticalGradient :: (command: PaintCommand) {
    bounds: Rectangle = command.bounds
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    bottom: float32 = bounds.y + bounds.height
    top: float32 = bounds.y
    while top < bottom {
        height: float32 = 1.0
        if top + height > bottom { height = bottom - top }
        amount: float32 = (top + height * 0.5 - bounds.y) / bounds.height
        row: Rectangle = Rectangle.{bounds.x, top, bounds.width, height}
        if command.clip_set { row = RectangleIntersection(row, command.clip) }
        if row.width > 0.0 && row.height > 0.0 {
            FillRoundedRectangle(row, 0.0, 0,
                GradientColorAt(command.color, command.end_color, amount))
        }
        top += height
    }
}

EmitRoundedOutline :: (command: PaintCommand) {
    visible: Rectangle = ShapeVisible(command)
    if visible.width <= 0.0 { return }
    if ShapeWhole(command, visible) || command.line_width <= 0.0 {
        StrokeRoundedRectangle(command.bounds, command.radius,
            command.segments, command.line_width, command.color)
        return
    }
    FillShapeClipped(command.bounds, command.radius, command.line_width,
        visible, command.color)
}

EmitLabel :: (command: PaintCommand) {
    previous := TextTypefaceUse(command.asset_path)
    defer { unused TextTypefaceUse(previous) }
    if command.italic {
        PaintTextItalicClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip, command.emphasis)
    } else if command.emphasis {
        PaintTextEmphasisClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip)
    } else if command.kind == PaintKindClippedText {
        PaintTextClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip)
    } else {
        PaintText(command.value, command.x, command.y,
            command.font, command.color)
    }
}

EmitImage :: (command: PaintCommand) {
    if command.clip.width > 0.0 && command.clip.height > 0.0 {
        emitting_texture = command.texture
        emitting_smooth = command.smooth
        if command.image_clip_count > 0 { emitting_image_polygon = command.mesh_points }
        if PaintMeshPointCount(command.mesh_columns, command.mesh_rows) > 0 {
            RasterImageMesh(command.asset_path, command.texture_id,
                command.source, command.mesh_points, command.mesh_columns,
                command.mesh_rows, command.clip, command.color)
        } else {
            RasterImage(command.asset_path, command.texture_id,
                command.source, command.bounds, command.clip,
                command.origin, command.rotation, command.radius,
                command.color)
        }
        emitting_texture.id = cast(u32)0
        emitting_smooth = false
        emitting_image_polygon = emitting_image_polygon[:0]
    }
}

ClipLabel :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    if command.kind == PaintKindText {
        command.kind = PaintKindClippedText
        command.clip = geometry.clip
    } else {
        command.clip = RectangleIntersection(command.clip, geometry.clip)
    }
    return command
}

ClipShape :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    if command.clip_set {
        command.clip = RectangleIntersection(command.clip, geometry.clip)
    } else {
        command.clip = geometry.clip
        command.clip_set = true
    }
    return command
}

ClipImage :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    command.clip = RectangleIntersection(command.clip, geometry.clip)
    return command
}

#program_export
SubmitPaint :: (session: Session, command: QueuedPaint) {
    QueuePaint(session, *command)
}

// Widget painters own their local command until this call returns. Borrow it
// while adjusting geometry and copy it once into the pending queue. Public
// SubmitPaint keeps its value semantics for callers that reuse their command.
QueuePaint :: (session: Session, command: *QueuedPaint) {
    if command.data.node < 0 && !TreeIsBuilding(session) {
        EmitPaint(command.*)
        return
    }
    layer_node := command.data.node
    if layer_node < 0 { layer_node = TreeCurrentParent(session) }
    command.data.overlay_layer = TreeOverlayLayerAt(session, layer_node,
        !TreeIsBuilding(session))
    slot := SessionIndex(session)
    if command.data.overlay_layer > 0 { pending_paint[slot].overlays = true }
    pending_paint[slot].ordered = false
    if command.data.node < 0 && TreeIsBuilding(session) &&
    command.clips {
        scope: NodeGeometry = TreeCurrentPaintGeometry(session)
        if scope.clipped {
            clip_for: PaintClipper = command.clip_for
            command.data = clip_for(command.data, scope)
        }
    }
    moved_x: float32 = 0.0
    moved_y: float32 = 0.0
    if command.data.node >= 0 && TreeIsBuilding(session) {
        geometry: NodeGeometry = TreeSubmittedGeometryAt(session,
            command.data.node)
        dx: float32 = geometry.bounds.x - geometry.measured_bounds.x
        dy: float32 = geometry.bounds.y - geometry.measured_bounds.y
        moved_x = dx
        moved_y = dy
        full_bounds: bool = command.data.bounds.x == geometry.measured_bounds.x &&
        command.data.bounds.y == geometry.measured_bounds.y &&
        command.data.bounds.width == geometry.measured_bounds.width &&
        command.data.bounds.height == geometry.measured_bounds.height
        full_clip: bool = command.data.clip.x == geometry.measured_bounds.x &&
        command.data.clip.y == geometry.measured_bounds.y &&
        command.data.clip.width == geometry.measured_bounds.width &&
        command.data.clip.height == geometry.measured_bounds.height
        command.data.bounds.x += dx
        command.data.bounds.y += dy
        command.data.clip.x += dx
        command.data.clip.y += dy
        command.data.x += cast(s32)dx
        command.data.y += cast(s32)dy
        if full_bounds {
            command.data.bounds.width = geometry.bounds.width
            command.data.bounds.height = geometry.bounds.height
        }
        if full_clip {
            command.data.clip.width = geometry.bounds.width
            command.data.clip.height = geometry.bounds.height
        }
        if geometry.clipped && command.clips {
            clip_for: PaintClipper = command.clip_for
            command.data = clip_for(command.data, geometry)
        }
    }
    destination := SessionIndex(session)
    KeepPaintText(destination, *command.data)
    KeepPaintAsset(destination, *command.data)
    KeepPaintMesh(destination, *command.data, moved_x, moved_y)
    if !VecPush(pending_paint[destination].items, command.*) {
        pending_paint[destination].overflow = true
    }
}

#program_export
PaintLine :: (session: Session, node: s32, bounds: Rectangle,
    color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindLine
    command.data.node = node
    command.data.bounds = bounds
    command.data.color = color
    emit: PaintEmitter = EmitLine
    command.emit = emit
    command.has_emitter = true
    command.builtin_emitter = true
    clip_for: PaintClipper = ClipShape
    command.clip_for = clip_for
    command.clips = true
    QueuePaint(session, *command)
}

// Corner radius that turns bounds into a pill, or a circle when square.
// Rounded paints take the radius in pixels.
#program_export
PillRadius :: (bounds: Rectangle) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 { return 0.0 }
    return edge * 0.5
}

