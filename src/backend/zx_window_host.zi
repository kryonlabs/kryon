// Native SDL2/GPU/Cairo desktop host library (libkryon-desktop.so): exports
// Kryon's desktop window, frame-loop, raster, font, clipboard, theme, clock
// and service capabilities by name with the C ABI so `zx2native` executables
// built from portable `.zx` programs (both App.Show and App.Run, as well as
// headless text-measuring tools) link against the platform's real SDL2/GPU
// stack instead of a CPU-only software pixmap host.
Desktop :: #import "desktop_window";
#import "desktop_runtime"
#import "cairo_raster"
#import "cursor"
#import "session"
#import "tree_input"
#import "text_request"
#import "frame_driver"
#import "program_title"
Timer :: #import "std/timer_linux";
#if OS == .LINUX {
    Service :: #import "service_linux";
    Theme :: #import "system_theme_host_linux";
} else #if OS == .WINDOWS {
    Theme :: #import "system_theme_host_windows";
}

// --- Bare App.Show window capabilities (zx_window.zi) ---

opened: Desktop.DesktopWindow;

// Opens the window hidden; the first present shows it.
#program_export
ZxWindowOpenHost :: (title: string, width: s32, height: s32) -> bool {
    if opened.window != null || width <= 0 || width > 16384 || height <= 0 || height > 16384 { return false }
    return Desktop.Open(*opened, title, width, height)
}

// Waits up to a second for the window's next event.
#program_export
ZxWindowEventHost :: () -> s32 {
    return Desktop.NextEvent(*opened)
}

// Clears the window to a 0xRRGGBB colour.
#program_export
ZxWindowClearHost :: (color: u32) -> bool {
    return Desktop.Clear(*opened, color & 0xffffff)
}

#program_export
ZxWindowPresentHost :: () {
    Desktop.Present(*opened)
}

#program_export
ZxWindowCloseHost :: () {
    Desktop.Close(*opened)
}

// --- Full App.Run frame-loop capabilities (frames_zx.zi) ---

BundleInput :: struct {
    width: s32
    height: s32
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
    secondary_down: bool
    secondary_pressed: bool
    secondary_released: bool
    modifiers: s32
    key: s32
    wheel: float32
    closed: bool
}

bundle_open: bool;
bundle_frames: s32;
bundle_input: Session;

#program_export
BundleFrameBackgroundHost :: (color: u32) { SetRasterBackgroundColor(color) }

#program_export
BundleCloseHost :: () {
    DesktopWakeAt(-1.0)
    if SessionValid(bundle_input) {
        TreeInputReset(bundle_input)
        unused SessionClose(bundle_input)
        bundle_input = Session.{}
    }
    if bundle_open {
        CloseDesktop()
        bundle_open = false
    }
    bundle_frames = 0
}

#program_export
BundleWindowHost :: (title: string, width: s32, height: s32) -> bool {
    if bundle_open || width <= 0 || width > 16384 || height <= 0 || height > 16384 { return false }
    if !OpenDesktopTitled(width, height, title) { return false }
    bundle_input = SessionOpen()
    if !SessionValid(bundle_input) {
        CloseDesktop()
        return false
    }
    bundle_open = true
    bundle_frames = 0
    return true
}

#program_export
ReadBundleInput :: () -> BundleInput {
    result: BundleInput
    if !bundle_open && !BundleWindowHost(ProgramTitle(), 960, 600) {
        result.closed = true
        return result
    }
    ok := true
    if bundle_frames > 0 {
        ok = EndDesktopFrame()
        if ok && !CaptureRequested() { PauseDesktop() }
    }
    if ok && !CaptureRequested() { ok = PollDesktop() }
    if ok && CaptureRequested() && bundle_frames >= 2 { ok = false }
    if !ok {
        if CaptureRequested() { unused CaptureConfigured() }
        result.closed = true
        return result
    }
    key, modifiers := DesktopInputTake(bundle_input)
    BeginDesktopFrame()
    viewport := DesktopViewport()
    pointer := PollPointer()
    secondary := PollSecondaryPointer()
    result.width = cast(s32)viewport.width
    result.height = cast(s32)viewport.height
    result.x = pointer.x
    result.y = pointer.y
    result.down = pointer.down
    result.pressed = pointer.pressed
    result.released = pointer.released
    result.secondary_down = secondary.down
    result.secondary_pressed = secondary.pressed
    result.secondary_released = secondary.released
    result.modifiers = modifiers
    result.key = key
    result.wheel = DesktopWheelMove()
    result.closed = false
    bundle_frames += 1
    return result
}

#program_export
TakeBundleCodepoint :: () -> s32 {
    if !SessionValid(bundle_input) { return 0 }
    return TypedCodepointTake(bundle_input)
}

#program_export
BundleTextInputHost :: (focused: bool) {
    unused focused
}

#program_export
BundleFrameCursorHost :: (shape: s32, asset_path: string, width: s32,
    height: s32, hotspot_x: s32, hotspot_y: s32, hidden: bool) {
    cursor := FrameCursor.{asset_path, width, height, hotspot_x, hotspot_y, hidden, shape}
    unused DesktopCursorApply(cursor)
}

#program_export
BundleFrameFinishedHost :: (unchanged: bool) {
    DesktopFrameUnchanged(unchanged)
}

#program_export
BundleWakeAtHost :: (seconds: float64) {
    DesktopWakeAt(seconds)
}

#program_export
BundleFrameReusableHost :: () -> bool {
    return DesktopFrameReusable()
}

#program_export
BundleTextEditorHost :: (identity: u64, value: string, cursor: s32,
    anchor: s32, flags: s32) {
    unused identity; unused value; unused cursor; unused anchor; unused flags
}

#program_export
BundleTextRequestHost :: (identity: u64) -> TextRequest {
    unused identity
    empty: TextRequest
    return empty
}
