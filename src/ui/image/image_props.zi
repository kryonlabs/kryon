#import "drawing_props"
#import "geometry"

ImageFit :: enum {
    ImageFitStretch :: 0
    ImageFitContain :: 1
    ImageFitCover :: 2
}

// A warp grid: `columns` × `rows` screen points, row by row from the top
// left of the image's source rectangle (the whole texture when `source` is
// empty). Grid point (column, row) shows the source point at
// (column / (columns - 1), row / (rows - 1)) of the source; each cell is
// drawn as two textured triangles. Fewer than 2 columns or rows draws the
// image normally. A grid with fewer points than columns × rows draws
// nothing. Mirrored grids draw as well; nothing is culled.
ImageMesh :: struct {
    columns: s32
    rows: s32
    points: []Vector2
}

// The most grid points one warped image draws, such as 64 × 64.
IMAGE_MESH_POINT_LIMIT :: 4096

Props :: struct {
    asset_path: string
    alt_text: string
    bounds: Rectangle
    source: Rectangle
    origin: Vector2
    rotation: float32
    fit: ImageFit
    class_name: s32
    id: s32
    // A positive corner radius overrides the image's style radius.
    radius: float32
    // Runtime texture: honored instead of asset_path when set. Managed RGBA
    // images come from bitmap_image and belong to their creating Session.
    texture: Texture2D
    // A nonzero packed RGBA color tints this image. Zero uses its style color.
    tint: u32
    key: u64
    // Scale the image smoothly: the host blends neighboring pixels and,
    // where it can, smaller copies of the image, so a detailed picture drawn
    // larger or smaller than its pixels stays clean. Off keeps sharp pixels.
    smooth: bool
    // Draws the texture warped over these points, as for a cut-out puppet
    // whose painted limbs bend. `bounds` stays the node's bounds and clip;
    // `fit`, `origin`, `rotation` and the style radius do not apply.
    mesh: ImageMesh
    // Closed polygon in destination-local normalized coordinates (0..1).
    // Clips the sampled image without warping it; empty means no extra clip.
    // A nonempty polygon needs 3..IMAGE_MESH_POINT_LIMIT vertices and cannot
    // be combined with a mesh. The frame retains a copy of these points.
    clip_polygon: []Vector2
    // A small copy of the same picture, such as a few-KB low-resolution
    // version, drawn in the picture's place until the picture itself is
    // ready, so something shows at once and the full picture replaces it
    // cleanly. It is never drawn once the picture is ready, and a texture
    // image does not use it. Empty means no stand-in.
    preview_path: string
    // The full picture's size in pixels. A preview drawing part of the
    // picture (a nonempty `source`, such as a jigsaw piece) maps that
    // rectangle onto its own smaller pixels with this size; without it such
    // an image waits for the full picture. A whole picture needs no size.
    full_size: Vector2
}

// What an image has on screen: nothing yet while its picture and stand-in
// are loading, its preview, its full picture, or neither because both are
// unavailable (the placeholder).
ImageShowing :: enum {
    ImageShowingNone :: 0
    ImageShowingPreview :: 1
    ImageShowingFull :: 2
    ImageShowingUnavailable :: 3
}
