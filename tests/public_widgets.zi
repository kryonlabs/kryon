using UI :: #import "Widgets";

PublicWidgets :: (session: Session, button: ButtonProps,
    image: ImageProps, checkbox: CheckboxProps, slider: SliderProps,
    dropdown: DropdownProps) -> s32 {
    Image(session, image)
    return Button(session, button)
}

// A text field's props and result carry composition state, so an application
// gets that type from the same import as the field.
PublicTextField :: (session: Session, props: TextFieldProps) -> CompositionState {
    result: TextFieldResult = TextField(session, props)
    return result.composition
}
