#module "menu"
#import "drawing_props"
#import "style"
#import "control_props"

MenuMetrics :: struct {
    row_height: i32
    panel_min_width: i32
    panel_padding: i32
    panel_margin: i32
    accelerator_gap: i32
    separator_inset: i32
    checked_mark_inset: i32
    label_inset: i32
    submenu_indicator_inset: i32
    bar_item_min_width: i32
    bar_item_padding: i32
    bar_item_gap: i32
    bar_item_y_padding: i32
    bar_label_inset: i32
}

MenuLine :: struct {
    x1: i32
    y1: i32
    x2: i32
    y2: i32
}

MenuGroupPointerDecision :: struct {
    changed_open: bool
    next_open_id: i32
    clear_submenu: bool
    consume_release: bool
    set_focus: bool
    reset_navigation: bool
    navigation_top: i32
}

MenuItemPointerDecision :: struct {
    consume_release: bool
    set_focus: bool
    reset_navigation: bool
    set_navigation_path: bool
    navigation_depth: i32
    navigation_index: i32
    clear_child_navigation: bool
    set_submenu: bool
    submenu_id: i32
    activate: bool
    activated_id: i32
    close_open: bool
}

MenuKeyboardInput :: struct {
    up: bool
    down: bool
    home: bool
    end: bool
    left: bool
    right: bool
    enter: bool
    space: bool
    escape: bool
}

MenuKeyboardDecision :: struct {
    key_handled: bool
    move_delta: i32
    first: bool
    last: bool
    close_parent: bool
    open_or_activate: bool
}

MenuBarKeyboardDecision :: struct {
    move_top_delta: i32
    first_top: bool
    last_top: bool
    open_top: bool
    close_open: bool
    move_open_delta: i32
    move_open_if_no_submenu_delta: i32
}

MenuOutsideCloseDecision :: struct {
    close_open: bool
    clear_submenu: bool
    consume_release: bool
    open_index: i32
}

MenuContextOutsideCloseDecision :: struct {
    close_open: bool
    consume_release: bool
}

MenuContextOpenResult :: struct {
    open: bool
    changed: bool
}

MenuBarRole :: () -> i32 #export {
    return 1
}

MenuPopupRole :: () -> i32 #export {
    return 2
}

MenuContextRole :: () -> i32 #export {
    return 3
}

MenuHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

MenuKindSeparator :: () -> i32 {
    return 3
}

MenuKindSubmenu :: () -> i32 {
    return 4
}

MenuMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !MenuHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

MenuWrappedItemIndex :: (start: i32, direction: i32, item_count: i32) -> i32 #export {
    if item_count <= 0 { return -1 }
    if direction == 0 { direction = 1 }
    return (start + direction + item_count) % item_count
}

MenuItemSelectable :: (kind: i32, disabled: bool) -> bool #export {
    return kind != MenuKindSeparator() && !disabled
}

MenuItemIsSeparator :: (kind: i32) -> bool #export {
    return kind == MenuKindSeparator()
}

MenuItemShowsSubmenu :: (kind: i32) -> bool #export {
    return kind == MenuKindSubmenu()
}

MenuItemCanOpenSubmenu :: (kind: i32, disabled: bool, has_submenu: bool,
    submenu_count: i32, depth: i32, max_depth: i32) -> bool #export {
    if kind != MenuKindSubmenu() || disabled { return false }
    if !has_submenu || submenu_count <= 0 { return false }
    return depth + 1 < max_depth
}

MenuItemKeyboardActivates :: (kind: i32, disabled: bool,
    opens_submenu: bool) -> bool #export {
    return kind != MenuKindSeparator() && !disabled && !opens_submenu
}

MenuKeyboardInputFor :: (up: bool, down: bool, home: bool, end: bool,
    left: bool, right: bool, enter: bool, space: bool,
    escape: bool) -> MenuKeyboardInput #export {
    input: MenuKeyboardInput
    input.up = up
    input.down = down
    input.home = home
    input.end = end
    input.left = left
    input.right = right
    input.enter = enter
    input.space = space
    input.escape = escape
    return input
}

MenuKeyboardDecisionFor :: (input: MenuKeyboardInput, depth: i32,
    selected: i32) -> MenuKeyboardDecision #export {
    decision: MenuKeyboardDecision
    if selected < 0 { return decision }
    if input.up {
        decision.key_handled = true
        decision.move_delta = -1
        return decision
    }
    if input.down {
        decision.key_handled = true
        decision.move_delta = 1
        return decision
    }
    if input.home {
        decision.key_handled = true
        decision.first = true
        return decision
    }
    if input.end {
        decision.key_handled = true
        decision.last = true
        return decision
    }
    if input.left && depth > 0 {
        decision.key_handled = true
        decision.close_parent = true
        return decision
    }
    if input.right || input.enter || input.space {
        decision.key_handled = true
        decision.open_or_activate = true
    }
    return decision
}

MenuBarKeyboardDecisionFor :: (input: MenuKeyboardInput, open: bool,
    depth: i32) -> MenuBarKeyboardDecision #export {
    decision: MenuBarKeyboardDecision
    if !open {
        if input.left {
            decision.move_top_delta = -1
            return decision
        }
        if input.right {
            decision.move_top_delta = 1
            return decision
        }
        if input.home {
            decision.first_top = true
            return decision
        }
        if input.end {
            decision.last_top = true
            return decision
        }
        if input.enter || input.space || input.down {
            decision.open_top = true
        }
        return decision
    }
    if input.escape {
        decision.close_open = true
        return decision
    }
    if depth == 0 && input.left {
        decision.move_open_delta = -1
        return decision
    }
    if depth == 0 && input.right {
        decision.move_open_if_no_submenu_delta = 1
    }
    return decision
}

MenuItemPointerActivates :: (kind: i32, disabled: bool) -> bool #export {
    return kind != MenuKindSeparator() && kind != MenuKindSubmenu() &&
        !disabled
}

MenuBarCountFor :: (count: i32, limit: i32) -> i32 #export {
    if count < 0 { return 0 }
    if limit >= 0 && count > limit { return limit }
    return count
}

MenuBarOpenIndexFor :: (bar_id: i32, open_id: i32, menu_count: i32) -> i32 #export {
    if bar_id <= 0 || menu_count <= 0 { return -1 }
    index: i32 = open_id - bar_id - 1
    if index < 0 || index >= menu_count { return -1 }
    return index
}

MenuBarOpenIdFor :: (bar_id: i32, index: i32, menu_count: i32) -> i32 #export {
    if bar_id <= 0 || index < 0 || index >= menu_count { return 0 }
    return bar_id + 1 + index
}

MenuBarTopIndexFor :: (top: i32, menu_count: i32) -> i32 #export {
    if menu_count <= 0 { return -1 }
    if top < 0 || top >= menu_count { return 0 }
    return top
}

MenuBarMoveTopIndex :: (top: i32, menu_count: i32,
    direction: i32) -> i32 #export {
    if menu_count <= 0 { return -1 }
    top = MenuBarTopIndexFor(top, menu_count)
    if direction == 0 { return top }
    return (top + direction + menu_count) % menu_count
}

MenuGroupPointerDecisionFor :: (menu_id: i32, index: i32,
    open_id: i32, hot: bool, mouse_released: bool) -> MenuGroupPointerDecision #export {
    decision: MenuGroupPointerDecision
    decision.next_open_id = open_id
    decision.navigation_top = index
    open: bool = open_id == menu_id
    if hot && mouse_released {
        decision.consume_release = true
        decision.set_focus = true
        decision.changed_open = true
        if open {
            decision.next_open_id = 0
            decision.clear_submenu = true
        } else {
            decision.next_open_id = menu_id
            decision.reset_navigation = true
        }
        return decision
    }
    if hot && open_id != 0 && !open {
        decision.changed_open = true
        decision.next_open_id = menu_id
        decision.clear_submenu = true
    }
    return decision
}

MenuItemPointerDecisionFor :: (hot: bool, mouse_released: bool,
    same_focus: bool, kind: i32, disabled: bool, item_id: i32,
    index: i32, depth: i32, max_depth: i32) -> MenuItemPointerDecision #export {
    decision: MenuItemPointerDecision
    decision.navigation_depth = depth
    decision.navigation_index = index
    if !hot || !mouse_released {
        return decision
    }
    decision.consume_release = true
    decision.set_focus = true
    decision.reset_navigation = !same_focus
    if depth < max_depth {
        decision.set_navigation_path = true
        decision.clear_child_navigation = true
    }
    if MenuItemShowsSubmenu(kind) {
        decision.set_submenu = true
        decision.submenu_id = item_id
    } else if MenuItemPointerActivates(kind, disabled) {
        decision.activate = true
        decision.activated_id = item_id
        decision.close_open = true
    }
    return decision
}

MenuOutsideCloseDecisionFor :: (open_id: i32, mouse_released: bool,
    contains_bar: bool, panel_valid: bool,
    contains_panel: bool) -> MenuOutsideCloseDecision #export {
    decision: MenuOutsideCloseDecision
    decision.open_index = -1
    if open_id != 0 && mouse_released && !contains_bar &&
       (!panel_valid || !contains_panel) {
        decision.close_open = true
        decision.clear_submenu = true
        decision.consume_release = true
    }
    return decision
}

MenuContextOutsideCloseDecisionFor :: (open_id: i32, menu_id: i32,
    suppress_close: bool, mouse_released: bool, panel_valid: bool,
    contains_panel: bool) -> MenuContextOutsideCloseDecision #export {
    decision: MenuContextOutsideCloseDecision
    if open_id == menu_id && !suppress_close && mouse_released &&
       (!panel_valid || !contains_panel) {
        decision.close_open = true
        decision.consume_release = true
    }
    return decision
}

MenuContextOpenFor :: (open: bool, open_requested: bool,
    close_requested: bool, has_open: bool) -> MenuContextOpenResult #export {
    result: MenuContextOpenResult
    result.open = open
    if !has_open {
        return result
    }
    if open_requested {
        result.open = true
    }
    if close_requested {
        result.open = false
    }
    result.changed = result.open != open
    return result
}

MenuMetricsFor :: (scale: float, panel: StyleFrame, item: StyleFrame,
    bar: StyleFrame) -> MenuMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: MenuMetrics
    row_height: float = 30.0
    if MenuHas(item.value.fields, (u32)StyleFontSize) &&
       MenuHas(item.value.fields, (u32)StylePaddingY) {
        row_height = item.value.font_size + item.value.padding_y * 2.0
    }
    metrics.row_height = MenuMetric(item.value.fields,
        (u32)StyleContentOffset, item.value.offset_y, row_height, scale, false)
    metrics.panel_min_width = MenuMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_x, 180.0, scale, false)
    metrics.panel_padding = MenuMetric(panel.value.fields,
        (u32)StylePaddingX, panel.value.padding_x, 12.0, scale, true)
    metrics.panel_margin = MenuMetric(panel.value.fields,
        (u32)StyleGap, panel.value.gap, 4.0, scale, true)
    metrics.accelerator_gap = MenuMetric(item.value.fields,
        (u32)StyleContentOffset, item.value.offset_x, 88.0, scale, true)
    metrics.separator_inset = MenuMetric(item.value.fields,
        (u32)StylePaddingX, item.value.padding_x, 8.0, scale, true)
    metrics.checked_mark_inset = metrics.separator_inset
    metrics.label_inset = MenuMetric(item.value.fields,
        (u32)StyleIconSize, item.value.icon_size, 28.0, scale, true)
    metrics.submenu_indicator_inset = MenuMetric(item.value.fields,
        (u32)StylePaddingY, item.value.padding_y, 18.0, scale, true)
    metrics.bar_item_min_width = 0
    metrics.bar_item_padding = MenuMetric(bar.value.fields,
        (u32)StylePaddingX, bar.value.padding_x * 2.0, 24.0, scale, true)
    metrics.bar_item_gap = MenuMetric(bar.value.fields,
        (u32)StyleGap, bar.value.gap, 2.0, scale, true)
    metrics.bar_item_y_padding = MenuMetric(bar.value.fields,
        (u32)StylePaddingY, bar.value.padding_y, 3.0, scale, true)
    metrics.bar_label_inset = MenuMetric(bar.value.fields,
        (u32)StyleIconSize, bar.value.icon_size, 12.0, scale, true)
    return metrics
}

MenuGroupItemWidth :: (label_width: i32, metrics: MenuMetrics) -> i32 #export {
    width: i32 = label_width + metrics.bar_item_padding
    if width < metrics.bar_item_min_width {
        width = metrics.bar_item_min_width
    }
    return width
}

MenuPanelWidthStep :: (current_width: i32, label_width: i32,
    accelerator_width: i32, has_accelerator: bool,
    metrics: MenuMetrics) -> i32 #export {
    width: i32 = current_width
    if width <= 0 { width = metrics.panel_min_width }
    accel: i32 = 0
    if has_accelerator {
        accel = accelerator_width + metrics.accelerator_gap
    }
    candidate: i32 = label_width + accel + metrics.panel_padding * 2
    if candidate > width { width = candidate }
    return width
}

MenuPanelBounds :: (x: i32, y: i32, width: i32, item_count: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    bounds: Rectangle
    if item_count < 0 { item_count = 0 }
    if width < 0 { width = 0 }
    bounds.x = (float)x
    bounds.y = (float)y
    bounds.width = (float)width
    bounds.height = (float)(metrics.row_height * item_count +
        metrics.panel_margin * 2)
    return bounds
}

MenuRowBounds :: (panel: Rectangle, index: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    row: Rectangle
    if index < 0 { index = 0 }
    row.x = panel.x + (float)metrics.panel_margin
    row.y = panel.y + (float)(metrics.panel_margin +
        index * metrics.row_height)
    row.width = panel.width - (float)(metrics.panel_margin * 2)
    row.height = (float)metrics.row_height
    if row.width < 0.0 { row.width = 0.0 }
    return row
}

MenuSubmenuX :: (row: Rectangle) -> i32 #export {
    return (i32)(row.x + row.width)
}

MenuSubmenuOrigin :: (row: Rectangle) -> Vector2 #export {
    origin: Vector2
    origin.x = row.x + row.width
    origin.y = row.y
    return origin
}

MenuSeparatorLineFor :: (row: Rectangle, metrics: MenuMetrics) -> MenuLine #export {
    line: MenuLine
    line.x1 = (i32)row.x + metrics.separator_inset
    line.y1 = (i32)(row.y + row.height / 2.0)
    line.x2 = (i32)(row.x + row.width) - metrics.separator_inset
    line.y2 = line.y1
    if line.x2 < line.x1 {
        line.x2 = line.x1
    }
    return line
}

MenuTextY :: (row: Rectangle, line_height: i32) -> i32 #export {
    return (i32)row.y + ((i32)row.height - line_height) / 2
}

MenuCheckedMarkX :: (row: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)row.x + metrics.checked_mark_inset
}

MenuLabelX :: (row: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)row.x + metrics.label_inset
}

MenuAcceleratorX :: (row: Rectangle, text_width: i32,
    metrics: MenuMetrics) -> i32 #export {
    return (i32)(row.x + row.width) - text_width - metrics.panel_padding
}

MenuAcceleratorShouldFire :: (keyboard_enabled: bool, ctrl_required: bool,
    ctrl_down: bool, shift_required: bool, shift_down: bool,
    alt_required: bool, alt_down: bool,
    key_pressed: bool) -> bool #export {
    if !keyboard_enabled { return false }
    if ctrl_required && !ctrl_down { return false }
    if shift_required && !shift_down { return false }
    if alt_required && !alt_down { return false }
    return key_pressed
}

MenuSubmenuIndicatorX :: (row: Rectangle,
    metrics: MenuMetrics) -> i32 #export {
    return (i32)(row.x + row.width) - metrics.submenu_indicator_inset
}

MenuBarFirstItemX :: (bar: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)bar.x + metrics.panel_margin
}

MenuBarNextItemX :: (x: i32, width: i32,
    metrics: MenuMetrics) -> i32 #export {
    return x + width + metrics.bar_item_gap
}

MenuBarLabelX :: (item: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)item.x + metrics.bar_label_inset
}

MenuBarLabelY :: (item: Rectangle, line_height: i32) -> i32 #export {
    return MenuTextY(item, line_height)
}

MenuGroupItemBounds :: (x: i32, bar: Rectangle, width: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    item: Rectangle
    item.x = (float)x
    item.y = bar.y + (float)metrics.bar_item_y_padding
    item.width = (float)width
    item.height = bar.height - (float)(metrics.bar_item_y_padding * 2)
    if item.height < 0.0 { item.height = 0.0 }
    return item
}
