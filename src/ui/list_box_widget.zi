#import "session"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "list_box"
#import "list_box_multi"
#import "list_box_props"
#import "paint_queue"
#import "scroll"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

ListBoxView :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    scroll_offset: s32
    scroll_delta: s32
    row_height: s32
    scale: float32
    disabled: bool
}

ListBoxViewState :: struct {
    node: s32
    key: u64
    bounds: Rectangle
    layout: ListBoxLayout
    panel: StyleFrame
    item: StyleFrame
    track: StyleFrame
    thumb: StyleFrame
    scroll_metrics: ScrollMetrics
    scale: float32
    max_scroll: s32
    scroll: s32
    valid: bool
    multi: bool
}

#program_export
ListBoxItemKey :: (item: ListBoxItem, index: s32) -> u64 {
    if item.key != cast(u64)0 { return item.key }
    return cast(u64)(index + 1)
}

#program_export
ListBoxThumbKey :: () -> u64 {
    return cast(u64)4294967295
}

#program_export
ListBoxDefaultFace :: (state: s32,
    item: bool) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleBorderWidth |
        cast(u32)StyleRadius | cast(u32)StyleOpacity |
        cast(u32)StyleFontSize | cast(u32)StylePaddingX |
        cast(u32)StyleIconSize
    face.background = cast(u32)0xffffffff
    face.foreground = cast(u32)0x171717ff
    face.border = cast(u32)0xd1d5dbff
    face.border_width = 1.0
    face.radius = 4.0
    face.opacity = 1.0
    face.font_size = 14.0
    face.padding_x = 8.0
    face.icon_size = 8.0
    if item {
        face.background = cast(u32)0x00000000
        face.border = cast(u32)0x00000000
        face.border_width = 0.0
        if state == ButtonStateHover {
            face.background = cast(u32)0xe5e7ebff
        } else if state == ButtonStatePressed {
            face.background = cast(u32)0xd1d5dbff
        } else if state == ButtonStateSelected {
            face.background = cast(u32)0xdbeafeff
            face.foreground = cast(u32)0x1d4ed8ff
        }
    }
    if state == ButtonStateDisabled { face.opacity = 0.45 }
    return face
}

#program_export
ListBoxFace :: (kind: s32, id: s32, class_name: s32,
    state: s32, item: bool) -> StyleFrame {
    facts: StyleFacts = StyleControlRoleFacts(kind, id,
        class_name, StyleAny(), cast(s32)ButtonToneNeutral,
        cast(s32)ButtonEmphasisFilled, cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(),
        ListBoxDefaultFace(state, item), facts, state)
    return frame
}

#program_export
ListBoxSingleView :: (props: ListBoxProps) -> ListBoxView {
    view: ListBoxView
    view.key = props.key
    view.bounds = props.bounds
    view.id = props.id
    view.class_name = props.class_name
    view.scroll_offset = props.scroll_offset
    view.scroll_delta = props.scroll_delta
    view.row_height = props.row_height
    view.scale = props.scale
    view.disabled = props.disabled
    return view
}

#program_export
ListBoxMultiView :: (props: ListBoxMultiProps) -> ListBoxView {
    view: ListBoxView
    view.key = props.key
    view.bounds = props.bounds
    view.id = props.id
    view.class_name = props.class_name
    view.scroll_offset = props.scroll_offset
    view.scroll_delta = props.scroll_delta
    view.row_height = props.row_height
    view.scale = props.scale
    view.disabled = props.disabled
    return view
}

#program_export
ListBoxViewStart :: (session: Session, view: ListBoxView, item_count: s32,
    multi: bool) -> ListBoxViewState {
    result: ListBoxViewState
    result.node = -1
    result.multi = multi
    result.bounds = view.bounds
    parent: Rectangle = TreeCurrentParentBounds(session)
    if result.bounds.width <= 0.0 { result.bounds.width = parent.width }
    if result.bounds.height <= 0.0 { result.bounds.height = parent.height }
    if result.bounds.width <= 0.0 || result.bounds.height <= 0.0 {
        return result
    }
    scale: float32 = view.scale
    if scale <= 0.0 { scale = 1.0 }
    result.scale = scale
    panel_kind: s32 = StyleKindListBox()
    item_kind: s32 = StyleKindListBoxItem()
    if multi {
        panel_kind = StyleKindListBoxMulti()
        item_kind = StyleKindListBoxMultiItem()
    }
    state: s32 = ButtonStateNormal
    if view.disabled { state = ButtonStateDisabled }
    result.panel = ListBoxFace(panel_kind, view.id,
        view.class_name, state, false)
    result.item = ListBoxFace(item_kind, 0,
        view.class_name, state, true)
    result.track = ScrollFace(StyleKindScroll(),
        view.class_name, view.disabled, cast(s32)ButtonStateNormal, 8.0)
    result.thumb = ScrollFace(StyleKindScrollThumb(),
        view.class_name, view.disabled, cast(s32)ButtonStateNormal, 8.0)
    result.scroll_metrics = ScrollMetricsFor(scale,
        result.track, result.thumb)
    row_height: s32 = view.row_height
    if row_height > 0 { row_height = cast(s32)(cast(float32)row_height * scale) }
    if multi {
        row_height = ListBoxMultiRowHeight(row_height, scale, result.item)
    } else {
        row_height = ListBoxRowHeight(row_height, scale, result.item)
    }
    if row_height <= 0 { row_height = 1 }
    content_height: s32 = ListBoxContentHeight(item_count,
        row_height, 0, scale, result.item)
    result.max_scroll = ListBoxMaxScroll(result.bounds.height,
        item_count, row_height, content_height, scale, result.item)
    scroll: s64 = cast(s64)view.scroll_offset
    if !view.disabled { scroll += cast(s64)view.scroll_delta }
    if scroll < 0 { scroll = 0 }
    if scroll > cast(s64)result.max_scroll {
        scroll = cast(s64)result.max_scroll
    }
    result.scroll = cast(s32)scroll
    result.key = view.key
    if result.key == cast(u64)0 && view.id > 0 {
        result.key = cast(u64)cast(u32)view.id
    }
    if result.key == cast(u64)0 { result.key = TreeNextKey(session) }
    measured: Rectangle = result.bounds
    if TreeIsBuilding(session) {
        result.node = TreeSubmitCurrent(session, result.key,
            WidgetKindListBox, result.bounds)
        if result.node < 0 { return result }
        result.bounds = TreeSubmittedNodeAt(session, result.node).bounds
        if !TreePushScope(session, result.node) { return result }
        if result.max_scroll > 0 && !view.disabled {
            previous: s32 = TreePrevious(session, result.node,
                ListBoxThumbKey(), WidgetKindSlider)
            drag: PointerDrag = TreeTakeDragAt(session, previous)
            if drag.active || drag.ended {
                bar: ScrollBarPaint = ScrollBarPaintFor(
                    cast(s32)(result.bounds.x + result.bounds.width) -
                        result.scroll_metrics.scrollbar_width,
                    cast(s32)result.bounds.y, cast(s32)result.bounds.height,
                    content_height, result.scroll, result.max_scroll,
                    result.scroll_metrics)
                result.scroll = ScrollDragOffsetFor(drag.y,
                    bar.track_bounds.y, drag.grab_y,
                    result.max_scroll, bar)
            }
        }
    }
    result.layout = ListBoxLayoutFor(result.bounds, item_count,
        row_height, content_height, result.scroll, scale, result.item)
    opacity: float32 = StyleOpacityValue(result.panel.value.fields,
        result.panel.value.opacity)
    PaintRoundedFill(session, result.node, measured,
        result.panel.value.radius, 12,
        ColorFromPacked(Opacity(result.panel.value.background, opacity)))
    if result.panel.value.border_width > 0.0 {
        PaintRoundedOutline(session, result.node, measured,
            result.panel.value.radius, 12,
            result.panel.value.border_width,
            ColorFromPacked(Opacity(result.panel.value.border, opacity)))
    }
    result.valid = true
    return result
}

#program_export
ListBoxViewScroll :: (view: ListBoxViewState,
    scroll: s32) -> ListBoxViewState {
    view.scroll = ListBoxClampScroll(scroll, view.max_scroll)
    view.layout.scroll = view.scroll
    view.layout.first_row = view.scroll / view.layout.row_height
    view.layout.y_offset = view.scroll % view.layout.row_height
    return view
}

#program_export
ListBoxRow :: (session: Session, view: ListBoxViewState, item: ListBoxItem,
    index: s32, selected: bool, disabled: bool,
    class_name: s32, id: s32) -> bool {
    visible_index: s32 = index - view.layout.first_row
    row: Rectangle = ListBoxRowBounds(view.bounds,
        visible_index, view.layout)
    clipped: Rectangle = RectangleIntersection(row, view.bounds)
    if clipped.width <= 0.0 || clipped.height <= 0.0 { return true }
    item_key: u64 = ListBoxItemKey(item, index)
    previous: s32 = -1
    if TreeIsBuilding(session) {
        previous = TreePrevious(session, view.node, item_key,
            WidgetKindSelectable)
    }
    state: s32 = ResolveState(cast(s32)ButtonStateAuto,
        disabled, false, TreePressedAt(session, previous),
        TreeHoveredAt(session, previous), false, selected)
    kind: s32 = StyleKindListBoxItem()
    if view.multi { kind = StyleKindListBoxMultiItem() }
    face: StyleFrame = ListBoxFace(kind, index + 1,
        class_name, state, true)
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, item_key,
            WidgetKindSelectable, clipped)
        if node < 0 { return false }
        TreeSetInteractive(session, node, disabled, false, id)
        TreeSetSelected(session, node, selected)
        TreeSetLabel(session, node, item.label)
    }
    opacity: float32 = StyleOpacityValue(face.value.fields,
        face.value.opacity)
    if face.value.background != cast(u32)0 {
        PaintRoundedFill(session, node, clipped, face.value.radius, 12,
            ColorFromPacked(Opacity(face.value.background, opacity)))
    }
    if face.value.border_width > 0.0 {
        PaintRoundedOutline(session, node, clipped, face.value.radius, 12,
            face.value.border_width,
            ColorFromPacked(Opacity(face.value.border, opacity)))
    }
    font: s32 = ResolveFont(0,
        StyleFontValue(face.value.fields, face.value.font_size), 14)
    line_height: s32 = GlyphLineHeight(font, face.value.typeface)
    inset: s32 = ListBoxItemLabelInset(view.scale, face)
    if view.multi {
        inset = ListBoxMultiItemLabelInset(view.scale, face)
    }
    paint: ListBoxItemPaint = ListBoxItemPaintFor(row,
        inset, line_height)
    PaintClippedLabel(session, node, item.label, paint.text_x,
        paint.text_y, font,
        ColorFromPacked(Opacity(face.value.foreground, opacity)),
        clipped)
    return true
}

#program_export
ListBoxViewFinish :: (session: Session, view: ListBoxViewState,
    disabled: bool) {
    if !view.valid { return }
    if view.max_scroll > 0 &&
        view.scroll_metrics.scrollbar_width > 0 {
        bar: ScrollBarPaint = ScrollBarPaintFor(
            cast(s32)(view.bounds.x + view.bounds.width) -
                view.scroll_metrics.scrollbar_width,
            cast(s32)view.bounds.y, cast(s32)view.bounds.height,
            view.layout.content_height, view.scroll,
            view.max_scroll, view.scroll_metrics)
        track_node: s32 = -1
        thumb_node: s32 = -1
        if TreeIsBuilding(session) {
            track_node = TreeSubmitCurrent(session, ListBoxThumbKey() + cast(u64)1,
                WidgetKindCustom, bar.track_bounds)
            thumb_node = TreeSubmitCurrent(session, ListBoxThumbKey(),
                WidgetKindSlider, bar.thumb_bounds)
            TreeSetInteractive(session, thumb_node, disabled, false, 0)
        }
        PaintRoundedFill(session, track_node, bar.track_bounds,
            view.track.value.radius, 12,
            ColorFromPacked(Opacity(view.track.value.background,
                StyleOpacityValue(view.track.value.fields,
                    view.track.value.opacity))))
        PaintRoundedFill(session, thumb_node, bar.thumb_bounds,
            view.thumb.value.radius, 12,
            ColorFromPacked(Opacity(view.thumb.value.background,
                StyleOpacityValue(view.thumb.value.fields,
                    view.thumb.value.opacity))))
    }
    if TreeIsBuilding(session) { End(session) }
}

// Selection and scroll are returned as values. Rows keep identity through
// their keys and use the same retained pointer routing as other controls.
#program_export
ListBox :: (session: Session, props: ListBoxProps,
    items: []ListBoxItem) -> ListBoxResult {
    result: ListBoxResult
    result.node = -1
    result.selected_index = props.selected_index
    result.scroll_offset = props.scroll_offset
    view: ListBoxViewState = ListBoxViewStart(session,
        ListBoxSingleView(props), (cast(s32)items.count), false)
    if !view.valid { return result }
    result.node = view.node
    if props.focused && !props.disabled && props.navigation != 0 {
        nav: ListBoxNavigation = ListBoxNavigate(
            result.selected_index, (cast(s32)items.count), props.navigation,
            view.scroll, view.layout.row_height, view.bounds.height,
            view.max_scroll, props.scale, view.item)
        result.selected_index = nav.selected
        view = ListBoxViewScroll(view, nav.scroll)
    }
    visible: s32 = view.layout.visible_rows + 2
    index: s32 = view.layout.first_row
    end: s32 = index + visible
    if end > (cast(s32)items.count) { end = (cast(s32)items.count) }
    if TreeIsBuilding(session) && !props.disabled {
        while index < end {
            previous: s32 = TreePrevious(session, view.node,
                ListBoxItemKey(items[index], index), WidgetKindSelectable)
            if TreeTakeActivationAt(session, previous) {
                result.selected_index = index
            }
            index += 1
        }
    }
    index = view.layout.first_row
    while index < end {
        if !ListBoxRow(session, view, items[index], index,
            index == result.selected_index, props.disabled,
            props.class_name, props.id) { break }
        index += 1
    }
    ListBoxViewFinish(session, view, props.disabled)
    result.scroll_offset = view.scroll
    result.changed = result.selected_index != props.selected_index
    return result
}

#program_export
ListBoxMultiApply :: (selected: []bool, clicked: s32,
    anchor: s32, control: bool, shift: bool,
    range_anchor: s32) -> bool {
    changed: bool = false
    index: s32 = 0
    while index < (cast(s32)selected.count) {
        next: bool = ListBoxMultiSelectionForRow(index,
            selected[index], clicked, (cast(s32)selected.count), anchor,
            control, shift, range_anchor)
        if next != selected[index] { changed = true }
        selected[index] = next
        index += 1
    }
    return changed
}

// The borrowed selection slice is changed in place. Its length must match
// items. The result carries anchor, scroll, count, and activation as values.
#program_export
ListBoxMulti :: (session: Session, props: ListBoxMultiProps, items: []ListBoxItem,
    selected: []bool) -> ListBoxMultiResult {
    result: ListBoxMultiResult
    result.node = -1
    result.clicked_index = -1
    result.anchor = props.anchor
    result.scroll_offset = props.scroll_offset
    if (cast(s32)selected.count) != (cast(s32)items.count) { return result }
    view: ListBoxViewState = ListBoxViewStart(session,
        ListBoxMultiView(props), (cast(s32)items.count), true)
    if !view.valid { return result }
    result.valid = true
    result.node = view.node
    control: bool = props.control
    shift: bool = props.shift
    range_anchor: s32 = -1
    if props.focused && !props.disabled {
        first: s32 = -1
        index: s32 = 0
        while index < (cast(s32)selected.count) {
            if selected[index] {
                first = index
                break
            }
            index += 1
        }
        cursor: s32 = ListBoxMultiFocusedRow(result.anchor,
            first, (cast(s32)items.count))
        nav: ListBoxMultiNavResult = ListBoxMultiNavigate(
            (cast(s32)items.count), cursor, control, shift, props.navigation)
        if nav.anchor_changed { result.anchor = nav.anchor }
        result.clicked_index = nav.clicked
        control = nav.control
        shift = nav.shift
        range_anchor = nav.range_anchor
        if nav.anchor_changed {
            view = ListBoxViewScroll(view, ListBoxRevealScroll(
                result.anchor, view.scroll, view.layout.row_height,
                view.bounds.height, view.max_scroll, props.scale,
                view.item))
        }
    }
    if result.clicked_index >= 0 {
        result.changed = ListBoxMultiApply(selected,
            result.clicked_index, result.anchor, control,
            shift, range_anchor)
        result.anchor = ListBoxMultiAnchorAfterClick(result.anchor,
            result.clicked_index, (cast(s32)items.count),
            control, shift, range_anchor)
    }
    visible: s32 = view.layout.visible_rows + 2
    index: s32 = view.layout.first_row
    end: s32 = index + visible
    if end > (cast(s32)items.count) { end = (cast(s32)items.count) }
    if TreeIsBuilding(session) && !props.disabled {
        while index < end {
            previous: s32 = TreePrevious(session, view.node,
                ListBoxItemKey(items[index], index), WidgetKindSelectable)
            if TreeTakeActivationAt(session, previous) {
                result.clicked_index = index
                if ListBoxMultiApply(selected, index,
                    result.anchor, props.control, props.shift, -1) {
                    result.changed = true
                }
                result.anchor = ListBoxMultiAnchorAfterClick(
                    result.anchor, index, (cast(s32)items.count),
                    props.control, props.shift, -1)
            }
            index += 1
        }
    }
    index = view.layout.first_row
    while index < end {
        if !ListBoxRow(session, view, items[index], index,
            selected[index], props.disabled,
            props.class_name, props.id) { break }
        index += 1
    }
    // Count all selected items, including rows outside the viewport.
    result.selected_count = 0
    index = 0
    while index < (cast(s32)selected.count) {
        if selected[index] { result.selected_count += 1 }
        index += 1
    }
    ListBoxViewFinish(session, view, props.disabled)
    result.scroll_offset = view.scroll
    return result
}
