#module "numeric_edit_host"
#import "ui_internal.h"
#import "ui_popup_input_internal.h"
#import "ui/widget_store.h"
#import "ui/widget_input.h"
#import "ui/disabled.h"
#import "ui/slider.h"
#import "runtime/input.h"
#import "runtime/slider.h"
#import "limits.h"
#import "math.h"
#import "stdio.h"

NumericEditKind :: enum {
    NUMERIC_EDIT_DRAG_FLOAT = 3
    NUMERIC_EDIT_DRAG_INT
    NUMERIC_EDIT_SLIDER_FLOAT
    NUMERIC_EDIT_SLIDER_INT
}

ui_numeric_focus_id :: (id: i32, component: i32,
integer: i32) -> i32 #export {
    return SliderFocusIdFor(id, component, integer != 0)
}

ui_numeric_input_filter :: (codepoint: i32,
user_data: *void) -> i32 #export {
    return (codepoint >= '0' && codepoint <= '9') ||
    codepoint == '-' || codepoint == '+' || codepoint == '.' ||
    codepoint == 'e' || codepoint == 'E'
}

ui_numeric_temp_edit :: (bounds: Rectangle, kind: i32,
widget_id: i32, component: i32, focus_id: i32,
value: *void, format: const char*, disabled: i32,
integer: i32, editing: *i32) -> i32 #export {
    toolkit: *ToolkitStore = toolkit_store_current()
    enabled: i32 = !disabled && !ContentDisabled()
    control: i32 = IsKeyDown(KEY_LEFT_CONTROL) ||
    IsKeyDown(KEY_RIGHT_CONTROL)
    pressed: i32 = enabled &&
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) && ui_hot(bounds)
    mouse: Vector2 = ui_mouse_world()
    now: double = GetTime()
    scale: float = (float)Scale(1000) / 1000.0
    slop: i32 = InputDoubleClickSlopFor(scale)
    dx: float = mouse.x - toolkit->numeric_click.position.x
    dy: float = mouse.y - toolkit->numeric_click.position.y
    activate: i32 = InputTempEditActivationFor(
    pressed, control, toolkit->numeric_click.valid &&
    toolkit->numeric_click.kind == kind,
    toolkit->numeric_click.widget_id == widget_id,
    toolkit->numeric_click.component == component,
    (float)(now - toolkit->numeric_click.time), dx, dy, slop)
    state: *NumericInputState = ui_numeric_input_find(kind,
    widget_id, component)
    commit: i32 = 0
    changed: i32 = 0

    if pressed {
        toolkit->numeric_click.valid = 1
        toolkit->numeric_click.kind = kind
        toolkit->numeric_click.widget_id = widget_id
        toolkit->numeric_click.component = component
        toolkit->numeric_click.position = mouse
        toolkit->numeric_click.time = now
        if activate { toolkit->numeric_click.valid = 0 }
    }

    if state == nil && !activate {
        *editing = 0
        return 0
    }
    if state == nil {
        state = ui_numeric_input_state(kind, widget_id, component)
    }
    if !enabled && state->focused {
        state->focused = 0
        ClearTextInputFocus()
    }
    if activate {
        default_format: const char* = InputDefaultFormat(
        integer != 0 ? NumericInt : NumericFloat)
        if integer {
            snprintf(&state->text[0], sizeof(state->text),
            format != nil ? format : default_format, *(int*)value)
        } else {
            snprintf(&state->text[0], sizeof(state->text),
            format != nil ? format : default_format, *(float*)value)
        }
        state->cursor = (int)strlen(&state->text[0])
        state->focused = 1
        KryonSetFocus(focus_id)
        toolkit->drag_active = 0
        toolkit->slider_active = 0
    }
    if !state->focused {
        *editing = 0
        return 0
    }

    ui_disabled_enter(!enabled)
    field: TextFieldProps = (TextFieldProps){0}
    field.bounds = bounds
    field.text = &state->text[0]
    field.text_size = sizeof(state->text)
    field.cursor_position = &state->cursor
    field.focused = &state->focused
    field.max_codepoints = 63
    field.focus_id = focus_id
    field.commit_pressed = &commit
    field.read_only = !enabled
    if ui_text_field_render_filtered(field,
    ui_numeric_input_filter, nil) {
        end: *char = nil
        if integer {
            parsed: long = strtol(&state->text[0], &end, 0)
            if end != &state->text[0] && *end == '\0' &&
            parsed >= INT_MIN && parsed <= INT_MAX &&
            *(int*)value != (int)parsed {
                *(int*)value = (int)parsed
                changed = 1
            }
        } else {
            parsed: float = strtof(&state->text[0], &end)
            if end != &state->text[0] && *end == '\0' &&
            isfinite(parsed) && *(float*)value != parsed {
                *(float*)value = parsed
                changed = 1
            }
        }
    }
    ui_disabled_leave()
    if commit {
        state->focused = 0
        ClearTextInputFocus()
        KryonSetFocus(focus_id)
    }
    *editing = state->focused
    return changed
}

NumericValueAt :: (values: *void, index: i32,
kind: i32) -> double {
    if kind == 0 { return ((float*)values)[index] }
    if kind == 1 { return ((int*)values)[index] }
    return ((double*)values)[index]
}

NumericSetValue :: (values: *void, index: i32,
kind: i32, value: double) {
    if kind == 0 {
        ((float*)values)[index] = (float)value
    } else if kind == 1 {
        ((int*)values)[index] = (int)value
    } else {
        ((double*)values)[index] = value
    }
}

NumericFormat :: (text: *char, text_size: size_t,
format: const char*, kind: i32, value: double) {
    resolved: const char* = format
    if resolved == nil {
        resolved = InputDefaultFormat((NumericValueKind)kind)
    }
    value = InputRoundValueForKind((NumericValueKind)kind, value)
    if InputKindIsInt((NumericValueKind)kind) {
        snprintf(text, text_size, resolved, (int)value)
    } else if InputKindIsFloat((NumericValueKind)kind) {
        snprintf(text, text_size, resolved, (float)value)
    } else {
        snprintf(text, text_size, resolved, value)
    }
}

NumericInput :: (bounds: Rectangle, id: i32,
label: const char*, values: *void, count: i32,
step: double, step_fast: double, format: const char*,
disabled: i32, kind: i32) -> i32 {
    if values == nil || count <= 0 { return 0 }
    changed: i32 = 0
    button_width: i32 = InputDefaultStepButtonWidth(
    (float)Scale(1000) / 1000.0)
    ui_disabled_enter(disabled)
    index: i32 = 0
    while index < count {
        state: *NumericInputState = ui_numeric_input_state(
        kind, id, index)
        token: i32 = state->token
        layout: InputCellLayout = InputCellLayoutFor(
        bounds, count, index, button_width, step != 0.0)
        commit: i32 = 0
        old_value: double = NumericValueAt(values, index, kind)

        if ContentDisabled() && state->focused {
            pressed_char: i32 = GetCharPressed()
            while pressed_char != 0 {
                pressed_char = GetCharPressed()
            }
        }
        if !state->focused {
            NumericFormat(&state->text[0], sizeof(state->text),
            format, kind, old_value)
            state->cursor = (int)strlen(&state->text[0])
        }
        field: TextFieldProps = (TextFieldProps){0}
        field.bounds = layout.field
        field.text = &state->text[0]
        field.text_size = sizeof(state->text)
        field.cursor_position = &state->cursor
        field.focused = &state->focused
        field.max_codepoints = 63
        field.focus_id = token
        field.commit_pressed = &commit
        field.read_only = disabled
        if ui_text_field_render_filtered(field,
        ui_numeric_input_filter, nil) {
            end: *char = nil
            value: double = strtod(&state->text[0], &end)
            if end != &state->text[0] && *end == '\0' {
                value = InputRoundValueForKind(
                (NumericValueKind)kind, value)
                if value != old_value {
                    NumericSetValue(values, index, kind, value)
                    changed = 1
                }
            }
        }
        if step != 0.0 {
            fast: i32 = IsKeyDown(KEY_LEFT_SHIFT) ||
            IsKeyDown(KEY_RIGHT_SHIFT)
            minus: ButtonProps = (ButtonProps){0}
            minus.bounds = layout.minus
            minus.label = "-"
            minus.id = token + 1
            minus.disabled = disabled
            plus: ButtonProps = (ButtonProps){0}
            plus.bounds = layout.plus
            plus.label = "+"
            plus.id = token + 2
            plus.disabled = disabled
            minus_pressed: i32 = Button(minus)
            plus_pressed: i32 = Button(plus)
            if minus_pressed || plus_pressed {
                direction: i32 = plus_pressed != 0 ? 1 : -1
                value: double = NumericValueAt(values, index, kind)
                result: InputStep = InputStepValueForKind(
                (NumericValueKind)kind, value, step, step_fast,
                direction, fast)
                value = result.value
                NumericSetValue(values, index, kind, value)
                NumericFormat(&state->text[0], sizeof(state->text),
                format, kind, value)
                state->cursor = (int)strlen(&state->text[0])
                changed = 1
            }
        }
        index += 1
    }
    ui_draw_slider_label(bounds, label, 0)
    ui_disabled_leave()
    return changed
}

RenderInputContinuous :: (input: InputContinuousProps) -> i32 #export {
    return NumericInput(input.bounds, input.id, input.label,
    input.values, input.value_count, input.step, input.step_fast,
    input.format, input.disabled, 0)
}

RenderInputDiscrete :: (input: InputDiscreteProps) -> i32 #export {
    return NumericInput(input.bounds, input.id, input.label,
    input.values, input.value_count, input.step, input.step_fast,
    input.format, input.disabled, 1)
}

RenderInputPrecise :: (input: InputPreciseProps) -> i32 #export {
    return NumericInput(input.bounds, input.id, input.label,
    input.values, input.value_count, input.step, input.step_fast,
    input.format, input.disabled, 2)
}
