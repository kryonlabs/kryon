#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "button_props"
#import "button"
#import "button_widget"
#import "control_props"
#import "geometry"
#import "image_props"
#import "style"
#import "style_sheet"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "ziran_button_widget_host"
#import "widget_kind"

using ImageFit;
using ButtonTone;
using IconPlacement;
using ContentAlignment;
using StyleField;
using FrameStatus;
using WidgetKind;

phase: s32;

#program_export
Frame :: () -> s32 {
    props: ButtonProps
    props.key = cast(u64)7
    props.id = 7
    props.class_name = 9
    props.label = "Run"
    props.bounds = Rectangle.{10.0, 20.0, 80.0, 30.0}
    props.tone = cast(ButtonTone)ButtonToneAccent
    if phase == 0 {
        rules: StyleRules
        rules.count = 1
        rule: StyleRule
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = StyleKindButton()
        rule.selector.class_name = 9
        rule.style.fields = cast(u32)StyleBackground |
        cast(u32)StyleForeground | cast(u32)StyleRadius |
        cast(u32)StyleOpacity | cast(u32)StyleFontSize
        rule.style.background = cast(u32)0x123456ff
        rule.style.foreground = cast(u32)0xaabbccff
        rule.style.radius = 4.0
        rule.style.opacity = 0.5
        rule.style.font_size = 14.0
        rules.items[0] = rule
        InstallStyleRules(rules)
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TreeCount(TestSession()) != 2 ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
        phase = 1
        return 0
    }
    if phase == 1 {
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, false, false, true})
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        clicked: s32 = Button(TestSession(), props)
        if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || clicked != 1 { return -2 }
        phase = 2
        return 42
    }
    if phase == 3 {
        props.image.asset_path = "badge.png"
        props.image.fit = cast(ImageFit)ImageFitContain
        props.icon_placement = cast(IconPlacement)IconPlacementTrailing
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -4 }
        phase = 4
        return 44
    }
    if phase == 4 {
        // icon_type without an image draws the built-in icon atlas tile.
        props.icon_type = 7
        props.icon_only = true
        ExpectIcon()
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -5 }
        phase = 5
        return 45
    }
    props.disabled = true
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    clicked: s32 = Button(TestSession(), props)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || clicked != 0 { return -3 }
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, false, false, true})
    phase = 3
    return 43
}

#program_export
main :: () -> s32 {
    expected: [4]s32 = .[0, 42, 43, 44]
    index: s32 = 0
    while index < 4 {
        if Frame() != expected[index] || ButtonHostFailed() ||
        ButtonFills() != index + 1 ||
        ButtonLabels() != index + 1 { return 1 }
        index += 1
    }
    if ButtonImages() != 1 { return 2 }
    if Frame() != 45 { return 30 }
    if ButtonHostFailed() { return 31 }
    if ButtonIcons() != 1 { return 32 }
    if ButtonLabels() != 4 { return 33 }

    // A button with no width measures its label plus the style's padding;
    // one with a width keeps it.
    measured: ButtonProps
    measured.class_name = 9
    measured.label = "Run"
    fit: Rectangle = ButtonMeasure(measured)
    if fit.width != 45.0 || fit.height <= 0.0 || ButtonHostFailed() {
        return 34
    }
    measured.bounds = Rectangle.{0.0, 0.0, 200.0, 40.0}
    fit = ButtonMeasure(measured)
    if fit.width != 200.0 || fit.height != 40.0 { return 35 }
    stacked := ContentLayout(100.0, 80.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, true, 14.0)
    if stacked.icon_x != 38.0 || stacked.icon_y != 17.0 ||
    stacked.text_x != 30.0 || stacked.text_y != 49.0 ||
    stacked.text_height != 14.0 { return 36 }
    compact := ContentLayout(100.0, 40.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, true, 14.0)
    if compact.icon_size != 6.0 || compact.text_y != 20.0 { return 37 }
    measured.bounds = Rectangle.{}
    measured.image.asset_path = "badge.png"
    measured.icon_placement = cast(IconPlacement)IconPlacementAbove
    fit = ButtonMeasure(measured)
    if fit.width != 45.0 || fit.height < 46.0 { return 38 }
    start := ContentLayout(200.0, 56.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, false, 14.0,
        cast(ContentAlignment)ContentAlignmentStart, 16.0)
    if start.icon_x != 16.0 || start.text_x != 48.0 { return 39 }
    end := ContentLayout(200.0, 56.0, 40.0, 24.0, 8.0,
        true, false, true, 0.0, 0.0, false, 14.0,
        cast(ContentAlignment)ContentAlignmentEnd, 16.0)
    if end.text_x != 112.0 || end.icon_x != 160.0 { return 40 }
    // A draggable button keeps its press outside the button, and an enclosing
    // scroll cannot claim the same gesture.
    measured.key = cast(u64)88
    measured.id = 88
    measured.image = ImageProps.{}
    measured.bounds = Rectangle.{10.0, 20.0, 80.0, 30.0}
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    unused Button(TestSession(), measured)
    submitted := TreeSubmitted(TestSession(), TreeCurrentParent(TestSession()),
        measured.key, WidgetKindButton)
    if submitted != 1 || TreeSubmitted(TestSession(), 0, cast(u64)999, WidgetKindButton) != -1 {
        return 46
    }
    TreeSetDragCapture(TestSession(), submitted, true)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk { return 41 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
    if !TreePointerCapturesDrag(TestSession()) { return 42 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{140.0, 90.0, true, false, false})
    drag := TreeTakeDragAt(TestSession(), 1)
    if !drag.active || drag.x != 140.0 || drag.y != 90.0 ||
    drag.grab_x != 10.0 || drag.grab_y != 10.0 { return 43 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{140.0, 90.0, false, false, true})
    drag = TreeTakeDragAt(TestSession(), 1)
    if !drag.ended || drag.active { return 44 }
    if TreeTakeActivationAt(TestSession(), 1) { return 45 }
    return 0
}
