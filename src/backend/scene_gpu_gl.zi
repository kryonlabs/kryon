RawFenceSync :: (condition: u32,flags: u32)->*void #foreign gl "glFenceSync";
RawClientWaitSync :: (sync: *void,flags: u32,timeout: u64)->u32 #foreign gl "glClientWaitSync";
RawDeleteSync :: (sync: *void) #foreign gl "glDeleteSync";
RawFlush :: () #foreign gl "glFlush";
RawGenQueries :: (count: s32, ids: *u32) #foreign gl "glGenQueries";
RawDeleteQueries :: (count: s32, ids: *u32) #foreign gl "glDeleteQueries";
RawGetProcAddress :: (name: *u8) -> *void #foreign egl "eglGetProcAddress";
}
