// Process setup every Android host runs before its first frame, whether it
// uses Kryon's runner (android_run) or its own loop.
#import "android_jni"
#import "std/byte_text_linux"

android_libc :: #system_library "c";
AndroidSetEnvironment :: (name: *u8, value: *u8, overwrite: s32) -> s32 #foreign android_libc "setenv";
AndroidPathExists :: (path: *u8, mode: s32) -> s32 #foreign android_libc "access";
AndroidGetEnvironment :: (name: *u8) -> *u8 #foreign android_libc "getenv";
AndroidMakeDirectory :: (path: *u8, mode: u32) -> s32 #foreign android_libc "mkdir";

AndroidProcessPrepare :: () {
    AndroidTemporaryPrepare()
    AndroidNativeCachePrepare()
    AndroidTestDriverPrepare()
}

// Ziran keeps the native code it compiles for portable apps in a disk cache
// so later starts load it instead of compiling again. Its own guess at an
// app's cache folder misses secondary users and renamed processes, so point
// it at the app's cache folder unless ZIRAN_NATIVE_CACHE names one already.
// Ziran creates the folder.
AndroidNativeCachePrepare :: () {
    variable: [24]u8
    key: string = "ZIRAN_NATIVE_CACHE"
    for index: cast(s64)0..key.count - 1 { variable[index] = key[index] }
    variable[key.count] = 0
    existing := AndroidGetEnvironment(*variable[0])
    if existing != null && existing[0] != 0 { return }
    base := AndroidInternalDataPath()
    if base == null { return }
    path: [4096]u8
    if AndroidNativeCacheFolder(TextFromCString(base), path[:]).count == 0 { return }
    unused AndroidSetEnvironment(*variable[0], *path[0], 1)
}

// The native cache beside an app's private files folder FILES
// (DATA/files becomes DATA/cache/ziran-native), written into output and
// ended with a zero byte; "" when FILES has no parent folder or output is
// too small.
AndroidNativeCacheFolder :: (files: string, output: []u8) -> string {
    cut := files.count
    while cut > 1 && files[cut - 1] == #char "/" { cut -= 1 }
    while cut > 0 && files[cut - 1] != #char "/" { cut -= 1 }
    if cut <= 1 { return "" }
    name: string = "cache/ziran-native"
    if cut + name.count + 1 > output.count { return "" }
    for index: cast(s64)0..cut - 1 { output[index] = files[index] }
    for index: cast(s64)0..name.count - 1 { output[cut + index] = name[index] }
    output[cut + name.count] = 0
    return TextFromCString(*output[0])
}

// Android leaves TMPDIR unset, and native code that needs scratch files
// (Ziran compiles portable apps to native code there) looks for it. Point
// it at a folder in the app's private files.
AndroidTemporaryPrepare :: () {
    variable: [8]u8
    key: string = "TMPDIR"
    for index: cast(s64)0..key.count - 1 { variable[index] = key[index] }
    variable[key.count] = 0
    existing := AndroidGetEnvironment(*variable[0])
    if existing != null && existing[0] != 0 { return }
    base := AndroidInternalDataPath()
    if base == null { return }
    folder: string = TextFromCString(base)
    name: string = "/tmp"
    path: [4096]u8
    if folder.count + name.count + 1 > path.count { return }
    length: s64 = 0
    for byte: folder { path[length] = byte; length += 1 }
    for byte: name { path[length] = byte; length += 1 }
    path[length] = 0
    unused AndroidMakeDirectory(*path[0], 448)
    unused AndroidSetEnvironment(*variable[0], *path[0], 1)
}

// A UI test can drive a debuggable build: creating the folder
// kryon-test-driver in the app's private files before it starts, with
// `adb shell run-as PACKAGE mkdir files/kryon-test-driver`, runs Kryon's test
// driver there (see test_driver). Only the app, or run-as on a debuggable
// build, can write its private files, so an installed release never is.
AndroidTestDriverPrepare :: () {
    base := AndroidInternalDataPath()
    if base == null { return }
    folder: string = TextFromCString(base)
    name: string = "/kryon-test-driver"
    path: [4096]u8
    if folder.count + name.count + 1 > path.count { return }
    length: s64 = 0
    for byte: folder { path[length] = byte; length += 1 }
    for byte: name { path[length] = byte; length += 1 }
    path[length] = 0
    if AndroidPathExists(*path[0], 0) != 0 { return }
    variable: [24]u8
    key: string = "KRYON_TEST_DRIVER"
    for index: cast(s64)0..key.count - 1 { variable[index] = key[index] }
    variable[key.count] = 0
    unused AndroidSetEnvironment(*variable[0], *path[0], 1)
}
