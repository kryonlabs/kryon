#import "component_protocol"
Button :: #import "kryon/button";
Text :: #import "kryon/text";
#import "geometry"

Busy :: () -> s64 {
    value: s64 = 0
    while value < 10000001 { value += 1 }
    return value
}

component_schema_version: s64 = 2;
component_count: s64 = Busy();
component_label_kind: s64 = 2;

#program_export
Frame :: () -> s64 {
    if component_schema_version < 2 { return 1 }
    session := ComponentSession()
    bounds := ComponentBounds()
    Button.Draw(session, Button.Props.{
        .key = 701, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 16.0, 96.0, 36.0
        }, .label = "Increment"
    })
    Text.Draw(session, Text.Props.{
        .key = 702, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 64.0, 180.0, 28.0
        }, .text = "init failure", .size = Text.Text18
    })
    return 0
}
