#module "drag"
#import "drawing_props"

DragStep :: struct {
    value: float
    changed: bool
}

DragWholeStep :: struct {
    value: i32
    changed: bool
}

DragTextPaint :: struct {
    text_x: float
    text_y: float
}

DragCellTextPaintFor :: (bounds: Rectangle, inset: float,
    text_line_height: float) -> DragTextPaint #export {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y + (bounds.height - text_line_height) / 2.0
    return paint
}

DragLabelTextPaintFor :: (bounds: Rectangle, inset: float, font_size: i32,
    gap: float) -> DragTextPaint #export {
    paint: DragTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y - (float)font_size - gap
    return paint
}

DragCellBoundsFor :: (bounds: Rectangle, count: i32, index: i32) -> Rectangle #export {
    cell: Rectangle
    if count <= 0 { return cell }
    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }
    cell.x = bounds.x + bounds.width * (float)index / (float)count
    cell.y = bounds.y
    cell.width = bounds.width / (float)count
    cell.height = bounds.height
    return cell
}

DragEffectiveSpeed :: (speed: float) -> float #export {
    if speed == 0.0 { return 1.0 }
    return speed
}

DragClamp :: (value: float, minimum: float, maximum: float) -> float #export {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

DragWholeClamp :: (value: i32, minimum: i32, maximum: i32) -> i32 #export {
    if minimum < maximum {
        if value < minimum { return minimum }
        if value > maximum { return maximum }
    }
    return value
}

DragWholeRoundedDelta :: (scaled: float, force_minimum_step: bool) -> i32 #export {
    step: i32 = (i32)(scaled + (scaled < 0.0 ? -0.5 : 0.5))
    if force_minimum_step && step == 0 {
        if scaled < 0.0 { return -1 }
        return 1
    }
    return step
}

DragKeyboardValue :: (value: float, speed: float, minimum: float,
    maximum: float, direction: i32, home: bool, end: bool, alt: bool,
    shift: bool) -> DragStep #export {
    result: DragStep
    result.value = value
    result.changed = false
    next: float = value
    if home && minimum < maximum {
        next = minimum
    } else if end && minimum < maximum {
        next = maximum
    } else if direction != 0 {
        step: float = DragEffectiveSpeed(speed)
        if alt { step = step * 0.1 }
        if shift { step = step * 10.0 }
        next = DragClamp(next + (float)direction * step, minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

DragWholeKeyboardValue :: (value: i32, speed: float, minimum: i32,
    maximum: i32, direction: i32, home: bool, end: bool, alt: bool,
    shift: bool) -> DragWholeStep #export {
    result: DragWholeStep
    result.value = value
    result.changed = false
    next: i32 = value
    if home && minimum < maximum {
        next = minimum
    } else if end && minimum < maximum {
        next = maximum
    } else if direction != 0 {
        scaled: float = DragEffectiveSpeed(speed)
        if alt { scaled = scaled * 0.1 }
        if shift { scaled = scaled * 10.0 }
        next = DragWholeClamp(next + direction * DragWholeRoundedDelta(scaled, true),
            minimum, maximum)
    }
    result.value = next
    result.changed = next != value
    return result
}

DragDeltaValue :: (value: float, delta: float, speed: float,
    minimum: float, maximum: float) -> DragStep #export {
    result: DragStep
    result.value = DragClamp(value + delta * DragEffectiveSpeed(speed),
        minimum, maximum)
    result.changed = result.value != value
    return result
}

DragWholeDeltaValue :: (value: i32, delta: float, speed: float,
    minimum: i32, maximum: i32) -> DragWholeStep #export {
    result: DragWholeStep
    scaled: float = delta * DragEffectiveSpeed(speed)
    result.value = DragWholeClamp(value + DragWholeRoundedDelta(scaled, false),
        minimum, maximum)
    result.changed = result.value != value
    return result
}
