// See examples/dashboard/README.md for the native preview and ZX commands.
CSS :: #import "css/Css";
Box :: #import "kryon/box";
Button :: #import "kryon/button";
Card :: #import "kryon/card";
Grid :: #import "kryon/grid";
Layout :: #import "kryon/layout";
Page :: #import "kryon/page";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
Theme :: #import "kryon/theme";
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"

sheet: CSS.CssSheet;
previous: CSS.CssEnvironment;
installed: bool;
show_costs: bool;
ledger_offset: s32;

styles :: #string CSS
:root {
  --panel: #151f30;
  --line: #29384f;
  --ink: #edf4ff;
  --muted: #a9b8ce;
  --accent: #45dfbf;
  --negative: #fa819d;
}
Column.dashboard { gap: 14px; padding: 16px 24px; }
Heading.title { font-size: 46px; font-weight: 700; line-height: 1.05; letter-spacing: -2px; color: var(--ink); }
Heading.panel-title { font-size: 19px; font-weight: 600; color: var(--ink); }
Text.eyebrow { color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: 1.4px; }
Text.muted { color: var(--muted); font-size: 14px; }
Text.positive { color: var(--accent); font-size: 24px; font-weight: 700; letter-spacing: -0.7px; }
Text.negative { color: var(--negative); font-size: 14px; }
Card.panel { background: var(--panel); border: 1px solid; border-color: var(--line); border-radius: 16px; padding: 20px; }
Button.costs { color: var(--accent); background: var(--panel); border-radius: 8px; }
Grid.metrics { grid-template-columns: repeat(auto-fit, minmax(min(165px, 100%), 1fr)); gap: 14px; }
Grid.charts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
Grid.ledger { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 12px; }
@media (max-width: 820px) {
  Column.dashboard { padding: 16px; }
  Heading.title { font-size: 34px; }
  Card.panel { padding: 12px; }
  Grid.charts { grid-template-columns: minmax(0, 1fr); }
}
CSS;

Install :: (viewport: Rectangle) -> bool {
    if !installed {
        unused Theme.InstallDefaultTheme(true)
        if !CSS.CssSheetParse(*sheet, styles, "responsive.css", CSS.CssNoImports) {
            diagnostic: [256]u8
            print("%\n", CSS.CssSheetDiagnostic(*sheet, diagnostic[:]))
            return false
        }
    }
    env := CSS.CssEnvironmentWithViewportWidth(CSS.CssDefaultEnvironment(), viewport.width)
    if installed && CSS.CssSheetSameMedia(*sheet, previous, env) { return true }
    if !CSS.CssSheetInstall(*sheet, env, null) { return false }
    previous = env
    installed = true
    return true
}

Label :: (session: Session, bounds: Rectangle, key: u64, text: string, class_name: string) {
    Text.Draw(session, Text.Props.{.bounds = bounds, .key = key, .text = text,
        .class_name = CSS.StyleClass(class_name), .wrap = .TextWrapNone})
}

// A panel is a card: draw its content, then close it with End.
Panel :: (session: Session, bounds: Rectangle, key: u64) -> Card.CardResult {
    return Card.Draw(session, Card.Props.{.bounds = bounds, .key = key,
        .class_name = CSS.StyleClass("panel"), .variant = .CardOutlined})
}

Metrics :: (session: Session) {
    items: [4]Grid.GridItem = .[.{.height = 82}, .{.height = 82}, .{.height = 82}, .{.height = 82}]
    names: [4]string = .["Total return", "CAGR", "Benchmark", "Trades"]
    values: [4]string = .["+10.87%", "+8.14%", "+6.31%", "212"]
    grid := Layout.Grid(session, Grid.GridProps.{.key = 20, .class_name = CSS.StyleClass("metrics")}, items[:])
    if !grid.container.opened { return }
    cursor := grid.cursor
    for i: 0..3 {
        cursor = Grid.GridStep(cursor, items[i].height, items[i].column_span)
        key := cast(u64)(100 + i * 3)
        panel := Panel(session, cursor.item, key)
        content := panel.content
        Label(session, Rectangle.{content.x, content.y, content.width, 19.0}, key + 1, names[i], "muted")
        Label(session, Rectangle.{content.x, content.y + 20.0, content.width, 28.0}, key + 2, values[i], "positive")
        if panel.opened { unused End(session) }
    }
    unused End(session)
}

ChartSections :: (session: Session) {
    items: [3]Grid.GridItem = .[.{.height = 106, .column_span = -1}, .{.height = 86}, .{.height = 86}]
    titles: [3]string = .["Equity versus benchmark", "Monthly returns", "Drawdown"]
    descriptions: [3]string = .["Shared time axis", "Signed monthly values", "Peak-to-trough values"]
    grid := Layout.Grid(session, Grid.GridProps.{.key = 30, .class_name = CSS.StyleClass("charts")}, items[:])
    if !grid.container.opened { return }
    cursor := grid.cursor
    for i: 0..2 {
        cursor = Grid.GridStep(cursor, items[i].height, items[i].column_span)
        key := cast(u64)(200 + i * 3)
        panel := Panel(session, cursor.item, key)
        content := panel.content
        Page.Heading(session, .{.bounds = Rectangle.{content.x, content.y, content.width, 24.0},
            .key = key + 1, .text = titles[i], .level = 2, .class_name = CSS.StyleClass("panel-title")})
        // Give this content slot to the corresponding Plot chart in an app.
        Label(session, Rectangle.{content.x, content.y + 26.0, content.width, 20.0},
            key + 2, descriptions[i], "muted")
        if panel.opened { unused End(session) }
    }
    unused End(session)
}

Ledger :: (session: Session) {
    width := Layout.ColumnWidth(session)
    table_width: float32 = ifx width < 640.0 then 640.0 else width
    view := Scroll.Draw(session, Scroll.Props.{.key = 41, .bounds = .{0.0, 0.0, width, 75.0},
        .horizontal = true, .content_width = cast(s32)table_width, .scroll_offset = ledger_offset})
    ledger_offset = view.scroll_offset
    if !view.opened { return }
    cells: [8]string = .["Date", "Market", "Notional", "Net P&L", "2024-07-15", "EUR/USD", "4,000.00", "−12.40"]
    items: [8]Grid.GridItem = .[.{.height = 20}, .{.height = 20}, .{.height = 20}, .{.height = 20},
        .{.height = 20}, .{.height = 20}, .{.height = 20}, .{.height = 20}]
    grid := Layout.Grid(session, Grid.GridProps.{.key = 42, .class_name = CSS.StyleClass("ledger"),
        .bounds = .{view.content.x, view.content.y, table_width, 0.0}}, items[:])
    if grid.container.opened {
        cursor := grid.cursor
        for i: 0..7 {
            cursor = Grid.GridStep(cursor, items[i].height, items[i].column_span)
            Label(session, cursor.item, cast(u64)(300 + i), cells[i], ifx i == 7 then "negative" else "muted")
        }
        unused End(session)
    }
    unused End(session)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if !Install(viewport) { print("responsive styles failed\n"); return 1 }
    unused Box.Draw(session, Box.Props.{.key = 1, .bounds = viewport, .fill = ColorFromPacked(0x0d1420ff)})
    bounds := viewport
    if bounds.width > 1480.0 {
        bounds.x += (bounds.width - 1480.0) / 2.0
        bounds.width = 1480.0
    }
    page := Layout.Draw(session, .{.bounds = bounds, .key = 2, .class_name = CSS.StyleClass("dashboard")})
    if !page.opened { return 1 }
    Label(session, Rectangle.{0.0, 0.0, 0.0, 20.0}, 3, "AUTOTRADE · OFFLINE RESEARCH", "eyebrow")
    Page.Heading(session, .{.key = 4, .text = "Strategy DNA", .bounds = .{0.0, 0.0, 0.0, 50.0},
        .level = 1, .class_name = CSS.StyleClass("title")})
    Metrics(session)
    ChartSections(session)
    Page.Heading(session, .{.key = 40, .text = "Trade ledger", .bounds = .{0.0, 0.0, 0.0, 24.0},
        .level = 2, .class_name = CSS.StyleClass("panel-title")})
    Ledger(session)
    if Button.Draw(session, Button.Props.{.key = 43, .bounds = .{0.0, 0.0, 170.0, 32.0},
        .label = ifx show_costs then "Hide costs" else "Show costs", .class_name = CSS.StyleClass("costs")}) != 0 {
        show_costs = !show_costs
        print("dashboard input passed at width %\n", cast(s32)viewport.width)
    }
    if show_costs { Label(session, Rectangle.{0.0, 0.0, 0.0, 20.0}, 44, "Fees included in net P&L", "muted") }
    unused End(session)
    return 0
}
