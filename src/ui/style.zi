#module "style"
#import "control_props"
#import "geometry"
#import "surface"

StateFlags :: struct {
    disabled: bool
    loading: bool
    selected: bool
}

ResolveFlags :: (state: i32, disabled: bool, loading: bool,
    selected: bool) -> StateFlags #export {
    flags: StateFlags
    flags.disabled = disabled || state == ButtonStateDisabled
    flags.loading = loading || state == ButtonStateLoading
    flags.selected = selected || state == ButtonStateSelected
    return flags
}

InteractionState :: struct {
    state: i32
    hovered: bool
    pressed: bool
    focused: bool
}

ResolveInteraction :: (explicit_state: i32, disabled: bool, loading: bool,
    pressed: bool, hovered: bool, focused: bool,
    selected: bool) -> InteractionState #export {
    state: i32 = ResolveState(explicit_state, disabled, loading,
        pressed, hovered, focused, selected)
    interaction: InteractionState
    interaction.state = state
    interaction.hovered = hovered
    interaction.pressed = pressed
    interaction.focused = focused
    if explicit_state != ButtonStateAuto {
        interaction.hovered = state == ButtonStateHover
        interaction.pressed = state == ButtonStatePressed
        interaction.focused = state == ButtonStateFocus
    }
    return interaction
}

StyleData :: struct {
    fields: u32
    background: u32
    foreground: u32
    border: u32
    focus: u32
    radius: float
    border_width: float
    opacity: float
    padding_x: float
    padding_y: float
    gap: float
    font_size: float
    icon_size: float
    offset_x: float
    offset_y: float
    background_end: u32
    material: MaterialKind
    typeface: string
    letter_spacing: float
}

StyleFrame :: struct {
    value: StyleData
    fill: FillStates
}

StyleStates :: struct {
    normal: StyleData
    hover: StyleData
    pressed: StyleData
    focused: StyleData
    disabled: StyleData
    loading: StyleData
    selected: StyleData
}

DefaultFields :: () -> u32 #export {
    return (u32)StyleBackground | (u32)StyleForeground | (u32)StyleBorder |
        (u32)StyleFocus | (u32)StyleRadius | (u32)StyleBorderWidth |
        (u32)StyleOpacity | (u32)StylePaddingX | (u32)StylePaddingY |
        (u32)StyleGap | (u32)StyleFontSize | (u32)StyleIconSize |
        (u32)StyleContentOffset | (u32)StyleMaterial
}

ResolveState :: (explicit_state: i32, disabled: bool, loading: bool,
    pressed: bool, hovered: bool, focused: bool, selected: bool) -> i32 #export {
    if disabled { return ButtonStateDisabled }
    if loading { return ButtonStateLoading }
    if explicit_state != ButtonStateAuto { return explicit_state }
    if pressed { return ButtonStatePressed }
    if hovered { return ButtonStateHover }
    if focused { return ButtonStateFocus }
    if selected { return ButtonStateSelected }
    return ButtonStateNormal
}

ResolveFont :: (requested: i32, inherited: i32,
    fallback: i32) -> i32 #export {
    if requested > 0 { return requested }
    if inherited > 0 { return inherited }
    if fallback > 0 { return fallback }
    return 16
}

StyleFontValue :: (fields: u32, font_size: float) -> i32 #export {
    if (fields & (u32)StyleFontSize) == (u32)0 { return 0 }
    if font_size <= 0.0 { return 0 }
    return (i32)(font_size + 0.5)
}

StyleOpacityValue :: (fields: u32, opacity: float) -> float #export {
    if (fields & (u32)StyleOpacity) == (u32)0 { return 1.0 }
    if opacity < 0.0 { return 0.0 }
    if opacity > 1.0 { return 1.0 }
    return opacity
}

FitHeight :: (requested: float, minimum: float, content: float,
    padding: float) -> float #export {
    if requested > 0.0 { return requested }
    if padding < 0.0 { padding = 0.0 }
    if content < 0.0 { content = 0.0 }
    height: float = content + 2.0 * padding
    if height < minimum { height = minimum }
    return height
}

ContentBounds :: (width: float, height: float, padding_x: float,
    padding_y: float) -> Rectangle #export {
    box: Rectangle
    if padding_x < 0.0 { padding_x = 0.0 }
    if padding_y < 0.0 { padding_y = 0.0 }
    box.x = padding_x
    box.y = padding_y
    box.width = width - 2.0 * padding_x
    box.height = height - 2.0 * padding_y
    if box.width < 0.0 { box.width = 0.0 }
    if box.height < 0.0 { box.height = 0.0 }
    return box
}

InsetBounds :: (bounds: Rectangle, padding_x: float, padding_y: float,
    scale: float) -> Rectangle #export {
    if scale <= 0.0 { scale = 1.0 }
    content: Rectangle = ContentBounds(bounds.width / scale,
        bounds.height / scale, padding_x, padding_y)
    result: Rectangle
    result.x = bounds.x + content.x * scale
    result.y = bounds.y + content.y * scale
    result.width = content.width * scale
    result.height = content.height * scale
    return result
}

MergeValues :: (base: StyleData, override: StyleData) -> StyleData #export {
    if (override.fields & (u32)StyleBackground) != (u32)0 { base.background = override.background }
    if (override.fields & (u32)StyleForeground) != (u32)0 { base.foreground = override.foreground }
    if (override.fields & (u32)StyleBorder) != (u32)0 { base.border = override.border }
    if (override.fields & (u32)StyleFocus) != (u32)0 { base.focus = override.focus }
    if (override.fields & (u32)StyleRadius) != (u32)0 { base.radius = override.radius }
    if (override.fields & (u32)StyleBorderWidth) != (u32)0 { base.border_width = override.border_width }
    if (override.fields & (u32)StyleOpacity) != (u32)0 { base.opacity = override.opacity }
    if (override.fields & (u32)StylePaddingX) != (u32)0 { base.padding_x = override.padding_x }
    if (override.fields & (u32)StylePaddingY) != (u32)0 { base.padding_y = override.padding_y }
    if (override.fields & (u32)StyleGap) != (u32)0 { base.gap = override.gap }
    if (override.fields & (u32)StyleFontSize) != (u32)0 { base.font_size = override.font_size }
    if (override.fields & (u32)StyleIconSize) != (u32)0 { base.icon_size = override.icon_size }
    if (override.fields & (u32)StyleContentOffset) != (u32)0 { base.offset_x = override.offset_x }
    if (override.fields & (u32)StyleContentOffset) != (u32)0 { base.offset_y = override.offset_y }
    if (override.fields & (u32)StyleBackgroundEnd) != (u32)0 { base.background_end = override.background_end }
    if (override.fields & (u32)StyleMaterial) != (u32)0 { base.material = override.material }
    if (override.fields & (u32)StyleTypeface) != (u32)0 { base.typeface = override.typeface }
    if (override.fields & (u32)StyleLetterSpacing) != (u32)0 { base.letter_spacing = override.letter_spacing }
    base.fields = base.fields | override.fields
    return base
}

ResolveValues :: (base: StyleData, states: StyleStates,
    state: i32) -> StyleData #export {
    base = MergeValues(base, states.normal)
    if state == ButtonStateHover { return MergeValues(base, states.hover) }
    if state == ButtonStatePressed { return MergeValues(base, states.pressed) }
    if state == ButtonStateFocus { return MergeValues(base, states.focused) }
    if state == ButtonStateDisabled { return MergeValues(base, states.disabled) }
    if state == ButtonStateLoading { return MergeValues(base, states.loading) }
    if state == ButtonStateSelected { return MergeValues(base, states.selected) }
    return base
}
