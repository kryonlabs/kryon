#import "kryon.h"

app "Kryon Color Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    color_index: int = 0
}

screen ColorExample(viewport: Rectangle) {
    WidgetBackground(GetThemeBackground())
    colors: [5] Color = {GetThemeButton(),GetThemeButtonHover(),GetThemeCircle(),GetThemeSurface(),GetThemeLink()}
    base: Color = colors[color_index]
    light: Color = LightenUIColor(base,40)
    dark: Color = DarkenUIColor(base,40)
    WidgetText("Color Utilities", 50, 20, UI_TEXT_24, GetThemeText())
    WidgetRect(50, 70, 70, 70, base, BLANK)
    WidgetRect(50, 70, 70, 70, BLANK, GetThemeText())
    WidgetText("Original", 50+70+ScaleUIPx(10), 70+ScaleUIPx(10), UI_TEXT_16, GetThemeText())
    WidgetRect(50, 160, 70, 70, light, BLANK)
    WidgetRect(50, 160, 70, 70, BLANK, GetThemeText())
    WidgetText("Lightened", 50+70+ScaleUIPx(10), 160+ScaleUIPx(10), UI_TEXT_16, GetThemeText())
    WidgetRect(50, 250, 70, 70, dark, BLANK)
    WidgetRect(50, 250, 70, 70, BLANK, GetThemeText())
    WidgetText("Darkened", 50+70+ScaleUIPx(10), 250+ScaleUIPx(10), UI_TEXT_16, GetThemeText())
    WidgetText(TextFormat("Color %d/5 - SPACE cycles",color_index+1), 320, 82, 18, GetThemeText())
    WidgetText(TextFormat("RGB:%d,%d,%d",base.r,base.g,base.b), 320, 116, UI_TEXT_16, GetThemeText())
    if (IsKeyPressed(KEY_SPACE)) {
        color_index = (color_index + 1) % 5
    }
}
