#import "scroll"
#import "geometry"
#import "drawing_props"

// Laws for scrolling. Each states the expected behavior independently of the
// implementation; `ziran check` proves it over every listed input. An
// implementation edit may not change this file.

Between :: (value: s32, low: s32, high: s32) -> bool {
    return value >= low && value <= high
}

#law ClampStaysInRange forall value: -40..60, maximum: 0..30 => Between(ScrollClamp(value, maximum), 0, maximum);
#law ClampKeepsInRangeValues forall value: 0..30, maximum: 0..30 => value > maximum || ScrollClamp(value, maximum) == value;
#law MaxNeverNegative forall content: -10..60, viewport: 0..40 => ScrollMax(content, viewport) >= 0;
#law MaxIsOverflow forall content: 0..60, viewport: 0..40 => content <= viewport || ScrollMax(content, viewport) == content - viewport;

// Dragging content up by d pixels scrolls it down by d, within range.
#law DragFollowsFinger forall start: 0..30, delta: -40..40, maximum: 0..30 => start > maximum || ScrollDragDeltaOffsetFor(start, delta, maximum) == ScrollClamp(start - delta, maximum);

// Touch dragging of content (arming on press, the tap threshold, release)
// is covered by tests/ziran_scroll_widget_test.sh: the law evaluator cannot
// yet run ScrollFrameFor, which builds its result field by field.
