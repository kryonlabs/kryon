#import "kryon.h"

app "Generated Basic Controls Parity" {
    size 420 260
    fps 60
}

state {
    slider_value: int = 20
    slider_values: [1] int = {20}
    toggle_value: int = 0
    checkbox_value: int = 0
    selected: int = 0
    choice_selected: int = 0
    choice_flags: int = 0
    choice_radio_actions: int = 0
    options: [3] const char * = {"Alpha","Beta","Gamma"}
}

controls_frame :: () #ui {
    Screen root: {
        Slider((SliderProps){.bounds = {20, 20, 180, 56}, .id = 801, .label = "Slider", .kind = 1, .int_values = slider_values, .value_count = 1, .min = 0.0, .max = 100.0})
        slider_value = slider_values[0]
        Toggle((ToggleProps){.bounds = {20, 80, 120, 34}, .id = 802, .value = &toggle_value, .off_label = "Off", .on_label = "On"})
        Checkbox((CheckboxProps){.bounds = {20, 128, 120, 34}, .id = 803, .label = "Check", .value = &checkbox_value})
        Dropdown((DropdownProps){.bounds = {20, 168, 160, 30}, .id = 804,
            .options = options, .option_count = 3, .selected_index = &selected})
        Selectable((SelectableProps){.bounds = {220,20,160,30}, .id = 805, .label = "Choice", .selected = &choice_selected})
        Checkbox((CheckboxProps){.bounds = {220,60,160,30}, .id = 806, .label = "Feature", .flags = &choice_flags, .flags_value = 4})
        choice_radio: int = Radio((RadioProps){.bounds = {220,100,160,30}, .label = "Radio", .id = 807})
        if choice_radio != 0 {
            choice_radio_actions += 1
        }
    }
}
