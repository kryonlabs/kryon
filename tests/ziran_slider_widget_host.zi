#import "drawing_props"
#import "geometry"

fills: s32;
outlines: s32;
labels: s32;
values: s32;
failed: bool;

// Pills and circles are painted with half their shorter side as radius.
PillRadiusOf :: (bounds: Rectangle) -> float32 {
    if bounds.height < bounds.width { return bounds.height * 0.5 }
    return bounds.width * 0.5
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    if value == "25%" { return 20 }
    if value != "Gain" { failed = true }
    return 28
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if radius != PillRadiusOf(bounds) || segments != 16 { failed = true }
    // The 100-wide slider keeps half its 22-pixel thumb inside each end.
    if fills % 6 == 0 &&
        (bounds.x != 21.0 || bounds.y != 69.0 ||
            bounds.width != 78.0 || color.r != cast(u8)0x12 ||
            color.g != cast(u8)0x34 || color.b != cast(u8)0x56) {
        failed = true
    }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if radius != PillRadiusOf(bounds) || segments != 16 || width != 1.0 ||
        bounds.width != 22.0 || bounds.height != 22.0 ||
        color.r != cast(u8)0x94 { failed = true }
    outlines += 1
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if font != 14 || y != 20 || clip.y != 20.0 || clip.height != 12.0 ||
        color.r != cast(u8)0xaa || color.g != cast(u8)0xbb ||
        color.b != cast(u8)0xcc || color.a != cast(u8)127 {
        failed = true
    }
    // The value takes the end of the label row; the label keeps the rest
    // less one gap.
    if value == "25%" {
        if x != 90 || clip.x != 90.0 || clip.width != 20.0 { failed = true }
        values += 1
        return
    }
    if value != "Gain" || x != 16 || clip.x != 10.0 ||
        clip.width != 68.0 { failed = true }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
SliderHostFailed :: () -> bool { return failed }

#program_export
SliderFills :: () -> s32 { return fills }

#program_export
SliderOutlines :: () -> s32 { return outlines }

#program_export
SliderLabels :: () -> s32 { return labels }

#program_export
SliderValues :: () -> s32 { return values }
