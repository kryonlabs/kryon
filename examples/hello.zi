#import "button_props"
#import "button_widget"
#import "control_props"
#import "geometry"
#import "pointer_input"
#import "tree"
#import "tree_draw"
#import "tree_input"

clicks: s32;

#program_export
Frame :: () -> s32 {
    pointer: PointerFrame = SamplePointer()
    TreePointerUpdate(pointer)
    BeginTree(cast(u64)1, Rectangle.{0.0, 0.0, 320.0, 160.0})
    button: ButtonProps
    button.key = cast(u64)2
    button.bounds = Rectangle.{40.0, 48.0, 240.0, 64.0}
    button.label = "Hello, Ziran"
    if clicks > 0 { button.label = "Clicked!" }
    button.tone = cast(ButtonTone)ButtonToneAccent
    clicks += Button(button)
    if !EndTree() { return -1 }
    return TreeCount() + clicks * 100
}
