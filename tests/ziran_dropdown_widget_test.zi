using SemanticKind;
using WidgetKind;
using StyleField;
using PaintKind;
using ButtonState;

phase: s32;
open_state: bool;
selected_state: s32;

// Whether the long menu's option row is submitted, so on screen.
OptionShown :: (option: DropdownOption, index: s32) -> bool {
    key: u64 = DropdownOptionKey(cast(u64)11, option, index)
    for node: cast(s32)0..TreeCount(TestSession()) - 1 {
        entry := TreeNodeAt(TestSession(), node)
        if entry.kind == WidgetKindSelectable && entry.key == key &&
        entry.bounds.height >= 20.0 { return true }
    }
    return false
}

#program_export
Frame :: () -> s32 {
    if phase == 0 {
        rules: StyleRules
        rules.count = 1
        rule: StyleRule
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = StyleKindDropdown()
        rule.selector.role = 0
        rule.selector.class_name = 9
        rule.style.fields = cast(u32)StyleBackground
        rule.style.background = cast(u32)0x123456ff
        rules.items[0] = rule
        InstallStyleRules(rules)
    }
    options: [3]DropdownOption
    options[0].key = cast(u64)41
    options[0].label = "First"
    options[1].key = cast(u64)42
    options[1].label = "Blocked"
    options[1].disabled = true
    options[2].key = cast(u64)43
    options[2].label = "Third"
    if phase == 13 { options[0].image.asset_path = "badge.png" }
    long_options: [8]DropdownOption
    option_index: s32 = 0
    while option_index < 8 {
        long_options[option_index].key =
        cast(u64)cast(u32)(100 + option_index)
        long_options[option_index].label = "Item"
        option_index += 1
    }
    props: DropdownProps = .{.key = cast(u64)11, .id = 11, .class_name = 9,
        .bounds = Rectangle.{10.0, 10.0, 120.0, 28.0}, .selected_index = selected_state,
        .open = open_state}
    if phase == 4 {
        props.focused = true
        props.trigger_input.down = true
    } else if phase == 5 {
        props.menu_input.home = true
        props.menu_input.navigating = true
    } else if phase == 6 {
        props.menu_input.commit = true
    } else if phase == 7 {
        props.open = true
    } else if phase == 9 {
        props.open = true
        props.disabled = true
    } else if phase >= 10 {
        props.open = true
        if phase == 12 {
            props.menu_input.end = true
            props.menu_input.navigating = true
        }
        if phase == 13 { props.close = true }
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    result: DropdownResult
    if phase >= 10 && phase <= 12 {
        result = Dropdown(TestSession(), props, long_options[0:8])
    } else {
        result = Dropdown(TestSession(), props, options[0:3])
    }
    if !TreeFinish(TestSession()) || result.node != 1 ||
    TreeNodeAt(TestSession(), 1).kind != WidgetKindDropdown ||
    TreeNodeAt(TestSession(), 1).semantic_kind !=
    cast(SemanticKind)SemanticComboBox { return -20 }
    if phase == 0 {
        if result.open || result.changed || TreeCount(TestSession()) != 2 ||
        TreeHitAt(TestSession(), 20.0, 20.0) != 1 { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0,
                true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0,
                false, false, true})
    } else if phase == 1 {
        if !result.open { return -21 }
        if !result.opened { return -22 }
        if TreeCount(TestSession()) != 8 { return -24 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 88.0,
                true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 88.0,
                false, false, true})
    } else if phase == 2 {
        if !result.open || result.changed ||
        TreeCount(TestSession()) != 8 { return -3 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 115.0,
                true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 115.0,
                false, false, true})
    } else if phase == 3 {
        if result.open || !result.changed || !result.closed ||
        result.selected_index != 2 || TreeCount(TestSession()) != 2 ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Third" { return -4 }
    } else if phase == 4 {
        if !result.open || !result.opened { return -5 }
    } else if phase == 5 {
        // Home moves the highlight to the first row; committing it in the
        // next phase chooses that row.
        if !result.open || result.changed { return -6 }
    } else if phase == 6 {
        if result.open || !result.closed || !result.changed ||
        result.selected_index != 0 { return -7 }
    } else if phase == 7 {
        if !result.open || TreeCount(TestSession()) != 8 { return -8 }
        TreePointerUpdate(TestSession(), PointerFrame.{180.0, 180.0,
                true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{180.0, 180.0,
                false, false, true})
    } else if phase == 8 {
        if result.open || !result.closed || result.changed ||
        TreeCount(TestSession()) != 2 { return -9 }
    } else if phase == 9 {
        if result.open || !result.closed ||
        TreeCount(TestSession()) != 2 ||
        TreeHitAt(TestSession(), 20.0, 20.0) != -1 { return -10 }
    } else if phase == 10 {
        // A long menu scrolls its rows in a standard Scroll.
        if !result.open || TreeCount(TestSession()) != 10 ||
        TreeNodeAt(TestSession(), 4).kind != WidgetKindScroll ||
        !OptionShown(long_options[0], 0) || OptionShown(long_options[7], 7) { return -11 }
    } else if phase == 11 {
        if !result.open || TreeCount(TestSession()) != 10 ||
        !OptionShown(long_options[0], 0) { return -12 }
    } else if phase == 12 {
        // Moving the highlight to the last row scrolls it into view.
        if !result.open || !OptionShown(long_options[7], 7) ||
        OptionShown(long_options[0], 0) { return -13 }
    } else if phase == 13 {
        if result.open || TreeCount(TestSession()) != 2 ||
        TreeNodeAt(TestSession(), 1).semantic_label != "First" { return -14 }
    }
    PaintFlush(TestSession())
    open_state = result.open
    selected_state = result.selected_index
    old: s32 = phase
    phase += 1
    return old
}

// A caller that passes only the selected value: the dropdown keeps its menu
// open, its highlight and its scroll offset by itself between frames.
uncontrolled_selected: s32;

UncontrolledFrame :: () -> DropdownResult {
    options: [8]DropdownOption
    index: s32 = 0
    while index < 8 {
        options[index].key = cast(u64)cast(u32)(200 + index)
        options[index].label = "Row"
        index += 1
    }
    props: DropdownProps = .{.key = cast(u64)31, .bounds = Rectangle.{10.0, 10.0, 120.0, 28.0},
        .selected_index = uncontrolled_selected}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    result: DropdownResult = Dropdown(TestSession(), props, options[:])
    unused TreeFinish(TestSession())
    PaintClear(TestSession())
    if result.changed {
        uncontrolled_selected = result.selected_index
    }
    return result
}

Tap :: (x: float32, y: float32) {
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, true, true, false})
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, false, false, true})
}

UncontrolledMenu :: () -> s32 {
    uncontrolled_selected = 0
    result: DropdownResult = UncontrolledFrame()
    if result.open { return 1 }
    Tap(20.0, 20.0)
    result = UncontrolledFrame()
    if !result.open || !result.opened { return 2 }
    // The menu stays open in later frames without any caller state.
    result = UncontrolledFrame()
    if !result.open || result.opened { return 3 }
    // Choosing another visible row selects it and closes the menu.
    row: s32 = -1
    node: s32 = 0
    while node < TreeCount(TestSession()) {
        if TreeNodeAt(TestSession(), node).kind == WidgetKindSelectable {
            row = node
        }
        node += 1
    }
    if row < 0 { return 6 }
    bounds: Rectangle = TreeNodeAt(TestSession(), row).bounds
    Tap(bounds.x + bounds.width / 2.0, bounds.y + bounds.height / 2.0)
    result = UncontrolledFrame()
    if result.open || !result.changed || result.selected_index <= 0 { return 7 }
    result = UncontrolledFrame()
    if result.open || uncontrolled_selected != result.selected_index { return 8 }
    return 0
}

// With the host's scroll device, the open menu scrolls like any Scroll: a
// finger drag over the options scrolls without choosing one, the wheel needs
// no props, a tap still chooses, and the menu reopens at the chosen row.
device_selected: s32;
device_time: float64;
DeviceLabels: [8]string = .["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];

DeviceFrame :: (x: float32, y: float32, pressed: bool, down: bool,
    released: bool, wheel: float32) -> DropdownResult {
    device_time += 0.016
    BeginScrollFrame(TestSession(), Vector2.{x, y}, pressed, down, released,
        wheel, device_time)
    unused TreePointerUpdate(TestSession(), PointerFrame.{x, y, down, pressed, released})
    options: [8]DropdownOption
    for index: cast(s32)0..7 {
        options[index].key = cast(u64)cast(u32)(300 + index)
        options[index].label = DeviceLabels[index]
    }
    props: DropdownProps = .{.key = cast(u64)37, .bounds = Rectangle.{10.0, 10.0, 120.0, 28.0},
        .selected_index = device_selected}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    result: DropdownResult = Dropdown(TestSession(), props, options[:])
    unused TreeFinish(TestSession())
    PaintClear(TestSession())
    if result.changed { device_selected = result.selected_index }
    return result
}

DeviceTap :: (x: float32, y: float32) -> DropdownResult {
    unused DeviceFrame(x, y, true, true, false, 0.0)
    return DeviceFrame(x, y, false, false, true, 0.0)
}

// The bounds of the visible option with this label, or an empty rectangle.
DeviceOption :: (label: string) -> Rectangle {
    for node: cast(s32)0..TreeCount(TestSession()) - 1 {
        entry := TreeNodeAt(TestSession(), node)
        if entry.kind == WidgetKindSelectable && entry.semantic_label == label {
            return entry.bounds
        }
    }
    return Rectangle.{}
}

DeviceMenu :: () -> s32 {
    device_selected = 0
    result: DropdownResult = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
    if result.open { return 1 }
    unused DeviceTap(20.0, 20.0)
    result = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
    if !result.open { return 2 }
    first: Rectangle = DeviceOption("Zero")
    three: Rectangle = DeviceOption("Three")
    if first.height < 20.0 || three.height < 20.0 { return 3 }
    // The wheel over the menu scrolls it without any props.
    x: float32 = first.x + 30.0
    y: float32 = first.y + first.height / 2.0
    result = DeviceFrame(x, y, false, false, false, -1.0)
    wheeled: Rectangle = DeviceOption("Three")
    if !result.open || wheeled.height <= 0.0 || wheeled.y >= three.y { return 4 }
    // A finger drag that starts on an option scrolls back and chooses nothing.
    start: Rectangle = DeviceOption("Two")
    if start.height <= 0.0 { return 5 }
    y = start.y + start.height / 2.0
    result = DeviceFrame(x, y, true, true, false, 0.0)
    step: s32 = 1
    while step <= 6 {
        result = DeviceFrame(x, y + cast(float32)step * 10.0, false, true, false, 0.0)
        step += 1
    }
    result = DeviceFrame(x, y + 60.0, false, false, true, 0.0)
    if !result.open || result.changed || DeviceOption("Three").y <= wheeled.y { return 6 }
    result = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
    if !result.open || result.changed || device_selected != 0 { return 7 }
    // Dragging up to the end, then tapping a row, chooses that row.
    start = DeviceOption("Three")
    if start.height <= 0.0 { return 8 }
    y = start.y + start.height / 2.0
    result = DeviceFrame(x, y, true, true, false, 0.0)
    step = 1
    while step <= 10 {
        result = DeviceFrame(x, y - cast(float32)step * 15.0, false, true, false, 0.0)
        step += 1
    }
    result = DeviceFrame(x, y - 150.0, false, false, true, 0.0)
    if !result.open || result.changed || DeviceOption("Seven").height < 20.0 { return 9 }
    // Let any fling settle before tapping.
    settle: s32 = 0
    while settle < 120 {
        result = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
        settle += 1
    }
    six: Rectangle = DeviceOption("Six")
    if six.height <= 0.0 { return 10 }
    result = DeviceTap(six.x + 30.0, six.y + six.height / 2.0)
    if result.open || !result.changed || result.selected_index != 6 { return 11 }
    // Reopening shows the chosen row.
    result = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
    unused DeviceTap(20.0, 20.0)
    result = DeviceFrame(200.0, 200.0, false, false, false, 0.0)
    if !result.open || DeviceOption("Six").height < 20.0 ||
    DeviceOption("Zero").height > 0.0 { return 12 }
    return 0
}

// The open menu floats above the page without taking it over. A tap on the
// app's sidebar closes the menu and still presses the sidebar button, and a
// page control drawn after the dropdown cannot take a tap on a menu row.
sidebar_selected: s32;
sidebar_clicks: s32;
page_clicks: s32;

SidebarFrame :: () -> DropdownResult {
    options: [8]DropdownOption
    for index: cast(s32)0..7 {
        options[index].key = cast(u64)cast(u32)(400 + index)
        options[index].label = DeviceLabels[index]
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    props: DropdownProps = .{.key = cast(u64)43, .bounds = Rectangle.{10.0, 10.0, 120.0, 28.0},
        .selected_index = sidebar_selected}
    result: DropdownResult = Dropdown(TestSession(), props, options[:])
    page: ButtonProps
    page.key = cast(u64)51
    page.id = 51
    page.label = "Page"
    page.bounds = Rectangle.{10.0, 60.0, 120.0, 28.0}
    page_clicks += Button(TestSession(), page)
    side: ButtonProps
    side.key = cast(u64)52
    side.id = 52
    side.label = "Home"
    side.bounds = Rectangle.{160.0, 20.0, 50.0, 40.0}
    sidebar_clicks += Button(TestSession(), side)
    unused TreeFinish(TestSession())
    PaintClear(TestSession())
    if result.changed { sidebar_selected = result.selected_index }
    return result
}

SidebarTap :: (x: float32, y: float32) -> DropdownResult {
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, true, true, false})
    unused SidebarFrame()
    TreePointerUpdate(TestSession(), PointerFrame.{x, y, false, false, true})
    return SidebarFrame()
}

// The visible option with this label, or an empty rectangle.
SidebarOption :: (label: string) -> Rectangle {
    for node: cast(s32)0..TreeCount(TestSession()) - 1 {
        entry := TreeNodeAt(TestSession(), node)
        if entry.kind == WidgetKindSelectable && entry.semantic_label == label {
            return entry.bounds
        }
    }
    return Rectangle.{}
}

SidebarMenu :: () -> s32 {
    sidebar_selected = 0
    result: DropdownResult = SidebarFrame()
    if result.open { return 1 }
    result = SidebarTap(20.0, 20.0)
    result = SidebarFrame()
    if !result.open { return 2 }
    // A row over the page button belongs to the menu.
    over: s32 = -1
    for index: cast(s32)0..7 {
        row: Rectangle = SidebarOption(DeviceLabels[index])
        if row.height > 0.0 && PointInBounds(40.0, 74.0, row) { over = index }
    }
    if over <= 0 { return 3 }
    result = SidebarTap(40.0, 74.0)
    if result.open || !result.changed || sidebar_selected != over || page_clicks != 0 { return 4 }
    // Open again, then tap the sidebar: one tap closes the menu and presses it.
    result = SidebarTap(20.0, 20.0)
    result = SidebarFrame()
    if !result.open { return 5 }
    result = SidebarTap(185.0, 40.0)
    if result.open || sidebar_clicks != 1 || sidebar_selected != over { return 6 }
    result = SidebarFrame()
    if result.open || sidebar_clicks != 1 { return 7 }
    // With the menu open, the page button outside it takes a tap too.
    result = SidebarTap(20.0, 20.0)
    result = SidebarFrame()
    if !result.open || SidebarOption("Seven").height > 0.0 { return 8 }
    result = SidebarTap(185.0, 40.0)
    if result.open || sidebar_clicks != 2 { return 9 }
    return 0
}

// A page that ends above the app's navigation keeps an open menu inside it:
// the menu scrolls to its last row instead of running under the navigation.
page_selected: s32;
page_to_end: bool;

PageFrame :: () -> DropdownResult {
    options: [8]DropdownOption
    for index: cast(s32)0..7 {
        options[index].key = cast(u64)cast(u32)(500 + index)
        options[index].label = DeviceLabels[index]
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    page: ScrollProps = .{.key = cast(u64)61, .bounds = Rectangle.{0.0, 0.0, 220.0, 120.0},
        .content_height = 120}
    result: DropdownResult
    if Scroll(TestSession(), page).opened {
        props: DropdownProps = .{.key = cast(u64)47, .bounds = Rectangle.{10.0, 10.0, 120.0, 28.0},
            .selected_index = page_selected}
        props.menu_input.end = page_to_end
        props.menu_input.navigating = page_to_end
        result = Dropdown(TestSession(), props, options[:])
        End(TestSession())
    }
    unused TreeFinish(TestSession())
    PaintClear(TestSession())
    return result
}

PageMenu :: () -> s32 {
    page_selected = 0
    page_to_end = false
    result: DropdownResult = PageFrame()
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, true, true, false})
    unused PageFrame()
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, false, false, true})
    result = PageFrame()
    result = PageFrame()
    if !result.open { return 1 }
    rows: s32 = 0
    for node: cast(s32)0..TreeCount(TestSession()) - 1 {
        entry := TreeNodeAt(TestSession(), node)
        if entry.kind == WidgetKindSelectable {
            rows += 1
            if entry.bounds.y + entry.bounds.height > 120.0 { return 2 }
        }
    }
    if rows == 0 || rows >= 8 { return 3 }
    page_to_end = true
    result = PageFrame()
    page_to_end = false
    result = PageFrame()
    seven: Rectangle = SidebarOption("Seven")
    if !result.open || seven.height < 20.0 || seven.y + seven.height > 120.0 { return 4 }
    return 0
}

// A row's action icon, such as download or remove, reports its option and
// keeps the menu open without choosing the row; the rest of the row still
// chooses it.
action_selected: s32;

ActionFrame :: () -> DropdownResult {
    options: [4]DropdownOption
    for index: cast(s32)0..3 {
        options[index].key = cast(u64)cast(u32)(500 + index)
        options[index].label = DeviceLabels[index]
        options[index].action_shape = "F:M4 4H20V20H4Z"
        options[index].action_label = "Download"
    }
    options[3].action_shape = ""
    props: DropdownProps = .{.key = cast(u64)41, .bounds = Rectangle.{10.0, 10.0, 160.0, 28.0},
        .selected_index = action_selected}
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    result: DropdownResult = Dropdown(TestSession(), props, options[:])
    unused TreeFinish(TestSession())
    PaintClear(TestSession())
    if result.changed { action_selected = result.selected_index }
    return result
}

// The action button in this row, or an empty rectangle.
ActionButton :: (row: Rectangle) -> Rectangle {
    for node: cast(s32)0..TreeCount(TestSession()) - 1 {
        entry := TreeNodeAt(TestSession(), node)
        if entry.kind == WidgetKindButton && entry.semantic_label == "Download" &&
        entry.bounds.y == row.y {
            return entry.bounds
        }
    }
    return Rectangle.{}
}

ActionMenu :: () -> s32 {
    action_selected = 0
    result: DropdownResult = ActionFrame()
    if result.open || result.action_index != -1 { return 1 }
    Tap(20.0, 20.0)
    result = ActionFrame()
    if !result.open { return 2 }
    two: Rectangle = SidebarOption("Two")
    action: Rectangle = ActionButton(two)
    if two.height < 20.0 || action.height < 20.0 || action.width != two.height ||
    action.x + action.width != two.x + two.width { return 3 }
    // The row without an action has no action button.
    if ActionButton(SidebarOption("Three")).height > 0.0 { return 4 }
    Tap(action.x + action.width / 2.0, action.y + action.height / 2.0)
    result = ActionFrame()
    if !result.open || result.changed || result.action_index != 2 ||
    action_selected != 0 { return 5 }
    result = ActionFrame()
    if !result.open || result.action_index != -1 { return 6 }
    // The pressed row is not highlighted as if it were chosen.
    if TreePreviousWidgetState(TestSession(), result.node).index != 0 { return 8 }
    Tap(two.x + 20.0, two.y + two.height / 2.0)
    result = ActionFrame()
    if result.open || !result.changed || result.selected_index != 2 ||
    result.action_index != -1 { return 7 }
    return 0
}

// An auto-placed trigger paints at its hit target and opens its popup there.
PlacedDropdown :: () -> s32 {
    session := SessionOpen()
    options: [2]DropdownOption
    options[0].label = "First"; options[1].label = "Second"
    props: DropdownProps = .{.key = 91, .bounds = .{0.0, 0.0, 200.0, 32.0}}
    step: s32 = 0
    while step < 2 {
        props.open = step == 1
        PaintClear(session)
        TreeStart(session, 1, .{0.0, 0.0, 400.0, 300.0})
        column := Column(session, .{.key = 90, .bounds = .{40.0, 60.0, 240.0, 150.0}})
        choice := Dropdown(session, props, options[:])
        if !End(session) || !TreeFinish(session) { return 1 }
        target := TreeNodeAt(session, choice.node).bounds
        if target.x != 40.0 || target.y != 60.0 { return 2 }
        found := false
        for index: cast(s32)0..PendingPaintCount(session) - 1 {
            paint := PendingPaintAt(session, index)
            if paint.node == choice.node && paint.kind == PaintKindRoundedFill {
                if paint.bounds.x != target.x || paint.bounds.y != target.y ||
                paint.bounds.width != target.width || paint.bounds.height != target.height { return 3 }
                found = true
            }
        }
        if !found { return 4 }
        if step == 1 {
            if !choice.open { return 5 }
            option := TreeHitAt(session, 55.0, 108.0)
            if TreeNodeAt(session, option).kind != WidgetKindSelectable { return 6 }
        }
        step += 1
    }
    PaintClear(session)
    unused SessionClose(session)
    return 0
}

#program_export
main :: () -> s32 {
    // Padding inside the colored option is independent of the menu gutter.
    // Check both edges, optional leading artwork and the row's action target.
    for scale_index: cast(s32)1..2 {
        scale := cast(float32)scale_index
        panel: StyleFrame
        panel.value = DropdownDefaultFace(DropdownPanelRole(), cast(s32)ButtonStateNormal, false)
        option: StyleFrame
        option.value = DropdownDefaultFace(DropdownOptionRole(), cast(s32)ButtonStateNormal, false)
        scrollbar: StyleFrame
        scrollbar.value = DropdownDefaultFace(DropdownScrollbarRole(), cast(s32)ButtonStateNormal, false)
        metrics := DropdownMenuMetricsFor(scale, panel, option, scrollbar)
        row: Rectangle = .{20.0, 40.0, 432.0 * scale, 44.0 * scale}
        content := Content(option.value, scale)
        inside_left := row.x + cast(float32)metrics.highlight_inset_x
        inside_right := row.x + row.width - cast(float32)metrics.highlight_inset_x
        plain := DropdownOptionContentFor(row, row, content, metrics, false, 0.0)
        if plain.text_bounds.x < inside_left + content.padding ||
            plain.check_bounds.x + plain.check_bounds.width > inside_right - content.padding { return 90 }
        artwork := DropdownOptionContentFor(row, row, content, metrics, true, 0.0)
        if artwork.icon_bounds.x < inside_left + content.padding ||
            artwork.text_bounds.x < artwork.icon_bounds.x + artwork.icon_bounds.width + content.gap { return 91 }
        action := DropdownOptionContentFor(row, row, content, metrics, false, row.height)
        if action.action_bounds.x + action.action_bounds.width != row.x + row.width ||
            action.check_bounds.x + action.check_bounds.width > action.action_bounds.x - content.padding { return 92 }
    }
    fill_steps: [14]s32 = .[1, 3, 3, 1, 3, 4, 1, 3, 1, 1, 3, 3, 3, 1]
    outline_steps: [14]s32 = .[1, 2, 2, 1, 2, 2, 1, 2, 1, 1, 2, 2, 2, 1]
    stroke_steps: [14]s32 = .[2, 4, 4, 2, 4, 4, 2, 4, 2, 2, 4, 4, 2, 2]
    label_steps: [14]s32 = .[1, 4, 4, 1, 4, 4, 1, 4, 1, 1, 6, 6, 6, 1]
    expected_fills: s32 = 0
    expected_outlines: s32 = 0
    expected_strokes: s32 = 0
    expected_labels: s32 = 0
    index: s32 = 0
    while index < 14 {
        if Frame() != index { return 1 }
        expected_fills += fill_steps[index]
        expected_outlines += outline_steps[index]
        expected_strokes += stroke_steps[index]
        expected_labels += label_steps[index]
        expected_images: s32 = 0
        if index == 13 { expected_images = 1 }
        if DropdownHostFailed() ||
        DropdownFills() != expected_fills ||
        DropdownOutlines() != expected_outlines ||
        DropdownStrokes() != expected_strokes ||
        DropdownLabels() != expected_labels ||
        DropdownImages() != expected_images { return 2 }
        index += 1
    }
    // A narrow trigger must show its complete selected value without changing
    // the control's hit target or clipping the final letters.
    props: DropdownProps
    props.key = cast(u64)29
    props.bounds = Rectangle.{10.0, 10.0, 120.0, 28.0}
    options: [1]DropdownOption
    options[0].label = "Monochrome"
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 220.0, 220.0})
    unused Dropdown(TestSession(), props, options[:])
    if !TreeFinish(TestSession()) { return 3 }
    found := false
    for paint_index: cast(s32)0..PendingPaintCount(TestSession()) - 1 {
        paint := PendingPaintAt(TestSession(), paint_index)
        if paint.kind == PaintKindClippedText && paint.value == "Monochrome" {
            if paint.font < 8 || paint.font >= 14 ||
            cast(float32)MeasureGlyphWidth(paint.value, paint.font, "") >
            paint.clip.width { return 4 }
            found = true
        }
    }
    if !found { return 5 }
    PaintClear(TestSession())
    uncontrolled: s32 = UncontrolledMenu()
    if uncontrolled != 0 { return 10 + uncontrolled }
    device: s32 = DeviceMenu()
    if device != 0 { return 30 + device }
    sidebar: s32 = SidebarMenu()
    if sidebar != 0 { return 50 + sidebar }
    paged: s32 = PageMenu()
    if paged != 0 { return 70 + paged }
    acted: s32 = ActionMenu()
    if acted != 0 { return 90 + acted }
    placed := PlacedDropdown()
    if placed != 0 { return 110 + placed }
    return 0
}
