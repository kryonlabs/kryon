#import "app_context_host"
#import "app_protocol"
#import "hosted_app"
#import "hosted_values"
#import "bundle_host"
#import "file"
#import "c_string"
#import "byte_text_linux"
#import "drawing_props"
#import "tile_map"
#import "widget_codec"
#import "text_input_platform"
#import "session"

writes: s32;
tile_calls: s32;
// Whether the last tile call came after this frame's write: a replayed
// frame asks its reads and writes again before its widgets.
tile_after_write: bool;
frame_writes: s32;
tile_reply: WidgetTileMapResultCodec;

Widgets :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(module) != "tile_map" || TextFromCString(function) != "TileMapHostedHost" || count != 2 { return 0 }
    tile_calls += 1
    tile_after_write = frame_writes > 0
    result.* = WidgetEncodeTileMapResult(TileMapResult.{.cell = 10.0, .columns = 2, .rows = 1}, *tile_reply)
    return 1
}

Allows :: (context: *void, name: string) -> bool {
    return name == "DocumentWriteHost"
}

Call :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if TextFromCString(function) != "DocumentWriteHost" || count != 2 { return 0 }
    if AppArgumentText(arguments[0]) != "entry.json" || AppArgumentText(arguments[1]) != "a saved entry" {
        return 0
    }
    writes += 1
    frame_writes += 1
    result.* = HostScalar("bool", 1)
    return 1
}

Open :: (app: *AppContext, path: string, expected: string) -> bool {
    bytes, ok := ReadEntireFile(path)
    if !ok { return false }
    app.expected_id = expected
    app.allows = Allows
    app.services = Call
    app.widgets = Widgets
    return AppContextOpen(app, bytes)
}

#program_export
main :: () -> s32 {
    app: AppContext
    accent: [6]u8 = .[cast(u8)97, cast(u8)99, cast(u8)99, cast(u8)101, cast(u8)110, cast(u8)116]
    if !SetStyleTokenColorBytes(accent[:], cast(u32)0x2e7d68ff) { return 11 }
    if !Open(*app, "good.zx", "diary") || writes != 0 { return 1 }
    app.session = SessionOpen()
    if TextInputFocused(app.session) { return 15 }
    if !AppContextRun(*app, APP_FRAME) || writes != 1 || tile_calls != 1 { return 2 }
    if !app.keyboard || !TextInputFocused(app.session) { return 16 }
    TextInputFocusFrameBegin(app.session)
    TextInputFocusFrameBegin(app.session)
    if TextInputFocused(app.session) { return 17 }
    if !AppContextRestart(*app) || writes != 1 { return 3 }
    if !AppContextRun(*app, APP_FRAME) || writes != 2 { return 4 }
    // The reply stays readable after the bundle reclaims its run's strings,
    // until the next run replaces it.
    if !AppContextRun(*app, APP_SAVE) || app.reply != "{\"saved\":true,\"day\":18}" { return 9 }
    if !AppContextRun(*app, APP_FRAME) || app.reply != "" || writes != 3 { return 10 }
    // A quiet frame runs and is recorded; the next quiet frame asks the
    // same reads and the write again, then shows the recorded tile map
    // without running the app. A frame that is not quiet runs the app.
    frame_writes = 0
    if !AppContextRunFrame(*app, true) || writes != 4 || tile_calls != 4 || tile_after_write { return 12 }
    frame_writes = 0
    if !AppContextRunFrame(*app, true) || writes != 5 || tile_calls != 5 || !tile_after_write { return 13 }
    frame_writes = 0
    if !AppContextRunFrame(*app, false) || writes != 6 || tile_calls != 6 || tile_after_write { return 14 }
    HostedAppClose(*app.app)
    unused SessionClose(app.session)
    if Open(*app, "good.zx", "other") || writes != 6 { return 5 }
    if Open(*app, "future.zx", "diary") || writes != 6 { return 6 }
    if Open(*app, "identify-write.zx", "diary") || writes != 6 { return 7 }
    if AppIdValid("../pass") || AppIdValid("auth/secret") || !AppIdValid("inbe.diary") { return 8 }
    return 0
}
