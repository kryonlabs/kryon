// An app can draw its widgets in its own colours, whatever host draws them,
// so a game keeps its look inside an app collection. The palette lasts until
// the host's frame for the app ends or its restore, which draws in the
// palette it replaced, so a button's palette inside a screen's palette
// leaves the screen's colours after it. A host that is itself a portable
// bundle passes it on to the host that draws. It stays apart from the widget
// modules, so bundles that never use it keep their reviewed bytes.
#import "session"

// The colours of system_theme's SystemPalette, packed 0xRRGGBBAA. material
// gives buttons the raised lightfield face instead of a flat one.
WidgetPalette :: struct {
    background: u32
    base: u32
    text: u32
    selected: u32
    selected_text: u32
    border: u32
    danger: u32
    warning: u32
    success: u32
    material: bool
}

#if #defined(KRYON_HOSTED_UI) {
    host_api :: #system_library "host_api";
    WidgetPaletteHostedHost :: (session: Session, background: u32, base: u32, text: u32,
        selected: u32, selected_text: u32, border: u32, danger: u32, warning: u32,
        success: u32, material: bool) -> bool #foreign host_api;
    WidgetPaletteRestoreHostedHost :: (session: Session) -> bool #foreign host_api;
    // Asks the host to draw this frame's following widgets in palette.
    #program_export
    WidgetPaletteUse :: (session: Session, palette: WidgetPalette) -> bool {
        return WidgetPaletteHostedHost(session, palette.background, palette.base, palette.text,
            palette.selected, palette.selected_text, palette.border, palette.danger,
            palette.warning, palette.success, true)
    }
    // Draws the following widgets in the host's own style again.
    #program_export
    WidgetPaletteRestore :: (session: Session) -> bool {
        return WidgetPaletteRestoreHostedHost(session)
    }
} else {
    #import "style_sheet"
    #import "text_style"
    #import "system_theme"
    #import "drawing_props"

    // The style the host had before a palette was used, and the rules built
    // for the last palette, so a palette used every frame is built once.
    widget_palette_saved: StyleRules;
    widget_palette_saved_resolver: TextStyleResolver;
    widget_palette_saved_has_resolver: bool;
    widget_palette_saved_tokens: StyleTokenColors;
    widget_palette_active: bool;
    widget_palette_rules: StyleRules;
    widget_palette_built: WidgetPalette;
    widget_palette_ready: bool;
    // Palettes nest: a palette used inside another remembers the one it
    // replaced, and its restore draws in that one again. Deeper than the
    // remembered levels a palette still shows, and its restore draws in the
    // deepest remembered palette, so the levels outside keep their colours
    // and an app that uses a palette every frame without a restore still
    // changes palette.
    WIDGET_PALETTE_DEPTH :: 16;
    widget_palette_outer: [WIDGET_PALETTE_DEPTH]WidgetPalette;
    widget_palette_depth: s32;
    widget_palette_deepest: WidgetPalette;
    widget_palette_beyond: s32;

    WidgetPaletteInstall :: (palette: WidgetPalette) {
        colors := SystemPalette.{.found = true, .background = palette.background,
            .base = palette.base, .text = palette.text, .selected = palette.selected,
            .selected_text = palette.selected_text, .border = palette.border,
            .danger = palette.danger, .warning = palette.warning, .success = palette.success}
        if !widget_palette_ready || !WidgetPaletteSame(palette, widget_palette_built) {
            widget_palette_rules = SystemPaletteRules(colors, true)
            widget_palette_built = palette
            widget_palette_ready = true
        }
        installed_rules = widget_palette_rules
        SystemPaletteTokens(colors)
        StyleCacheInstall()
        resolver: TextStyleResolver = ResolveInstalledTextStyle
        SetTextStyleResolver(resolver)
    }

    WidgetPaletteSame :: (a: WidgetPalette, b: WidgetPalette) -> bool {
        return a.background == b.background && a.base == b.base && a.text == b.text &&
        a.selected == b.selected && a.selected_text == b.selected_text && a.border == b.border &&
        a.danger == b.danger && a.warning == b.warning && a.success == b.success &&
        a.material == b.material
    }

    #program_export
    WidgetPaletteUse :: (session: Session, palette: WidgetPalette) -> bool {
        unused session
        if widget_palette_active {
            if widget_palette_depth < WIDGET_PALETTE_DEPTH {
                widget_palette_outer[widget_palette_depth] = widget_palette_built
                widget_palette_depth += 1
            } else {
                if widget_palette_beyond == 0 { widget_palette_deepest = widget_palette_built }
                if widget_palette_beyond < 0x7fffffff { widget_palette_beyond += 1 }
            }
        } else {
            // The host's rules keep their typeface bytes, so its snapshot
            // can be put back without copying them again.
            widget_palette_saved = installed_rules
            widget_palette_saved_resolver = active_text_style_callback
            widget_palette_saved_has_resolver = has_text_style_resolver
            widget_palette_saved_tokens = CaptureStyleTokenColors()
            widget_palette_active = true
        }
        WidgetPaletteInstall(palette)
        return true
    }

    #program_export
    WidgetPaletteRestore :: (session: Session) -> bool {
        unused session
        if !widget_palette_active { return true }
        if widget_palette_beyond > 0 {
            widget_palette_beyond -= 1
            WidgetPaletteInstall(widget_palette_deepest)
            return true
        }
        if widget_palette_depth > 0 {
            widget_palette_depth -= 1
            WidgetPaletteInstall(widget_palette_outer[widget_palette_depth])
            return true
        }
        installed_rules = widget_palette_saved
        StyleCacheInstall()
        active_text_style_callback = widget_palette_saved_resolver
        has_text_style_resolver = widget_palette_saved_has_resolver
        unused RestoreStyleTokenColors(widget_palette_saved_tokens)
        widget_palette_active = false
        return true
    }
}
