#module "plot_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/plot.h"
#import "ui/paint_command.h"

PlotPaint :: (plot: PlotProps, histogram: bool) {
    if !IsWindowReady() { return }
    plot_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, plot.class_name,
    StyleKindPlot(), StyleAny())
    mark_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneAccent, ButtonStateSelected, 0, 1, plot.class_name,
    StyleKindPlotMark(), StyleAny())
    plot_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(plot_frame).value)
    DrawRectangleRec(plot.bounds, plot_style.background)
    DrawRectangleLinesEx(plot.bounds, plot_style.border_width,
    plot_style.border)
    count: i32 = plot.value_count
    if plot.values == nil || count <= 0 { return }

    offset: i32 = PlotOffset(count, plot.offset)
    minimum: float = plot.scale_min
    maximum: float = plot.scale_max
    if minimum >= maximum {
        minimum = plot.values[offset]
        maximum = minimum
        index: i32 = 1
        while index < count {
            value: float = plot.values[(offset + index) % count]
            if value < minimum { minimum = value }
            if value > maximum { maximum = value }
            index += 1
        }
        if minimum == maximum {
            minimum -= 0.5
            maximum += 0.5
        }
    }
    range: PlotRange = PlotRangeFor(plot.scale_min, plot.scale_max,
    minimum, maximum)
    BeginClip((int)plot.bounds.x, (int)plot.bounds.y,
    (int)plot.bounds.width, (int)plot.bounds.height)
    if histogram {
        index: i32 = 0
        while index < count {
            value: float = plot.values[(offset + index) % count]
            bar: PlotMark = PlotHistogramBar(plot.bounds, index, count,
            value, range, mark_frame)
            DrawRectangleRec(bar.bounds, GetColor(bar.color))
            index += 1
        }
    } else if count == 1 {
        line: PlotMark = PlotSingleLine(plot.bounds, plot.values[offset],
        range, mark_frame)
        DrawLine((int)line.bounds.x, (int)line.bounds.y,
        (int)(line.bounds.x + line.bounds.width),
        (int)line.bounds.y, GetColor(line.color))
    } else {
        index: i32 = 1
        while index < count {
            a: float = plot.values[(offset + index - 1) % count]
            b: float = plot.values[(offset + index) % count]
            line: PlotMark = PlotLineSegment(plot.bounds, index, count,
            a, b, range, mark_frame)
            DrawLine((int)line.bounds.x, (int)line.bounds.y,
            (int)(line.bounds.x + line.bounds.width),
            (int)(line.bounds.y + line.bounds.height),
            GetColor(line.color))
            index += 1
        }
    }
    EndClip()

    font: i32 = ResolveFont(0, StyleFontValue(plot_style.fields,
    plot_style.font_size), GetSmallFontSize())
    runtime_scale: float = (float)Scale(1000) / 1000.0
    label_width: float = 0.0
    overlay_width: float = 0.0
    if plot.label != nil {
        label_width = (float)TextWidth(plot.label, font)
    }
    if plot.overlay != nil {
        overlay_width = (float)TextWidth(plot.overlay, font)
    }
    text: PlotTextPaint = PlotTextPaintFor(plot.bounds, label_width,
    overlay_width, runtime_scale, plot_frame,
    plot.label != nil, plot.overlay != nil)
    if text.show_label {
        RenderText(plot.label, (int)text.label_bounds.x,
        (int)text.label_bounds.y, font,
        Fade(GetColor(text.text_color), plot_style.opacity))
    }
    if text.show_overlay {
        RenderText(plot.overlay, (int)text.overlay_bounds.x,
        (int)text.overlay_bounds.y, font,
        Fade(GetColor(text.text_color), plot_style.opacity))
    }
}

RenderPlotLines :: (plot: PlotProps) #export {
    PlotPaint(plot, false)
}

RenderPlotHistogram :: (plot: PlotProps) #export {
    PlotPaint(plot, true)
}
