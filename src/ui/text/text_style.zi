#import "control_props"
#import "session"

// Only typography crosses the optional stylesheet boundary. A label never
// carries control backgrounds, box geometry, selector tables or materials.
TextFace :: struct {
    font_size: float32
    foreground: u32
    foreground_set: bool
    opacity: float32
    opacity_set: bool
    typeface: string
    glyphs: TextGlyphStyle
    line_height: float32
    line_height_unit: LineHeightUnit
    line_height_set: bool
    fallback_font: s32
    align: s32
    motion_reduced: bool
}

TextStyleMotion :: #type (Session, u64, TextStyleRequest, TextFace) -> TextFace;
text_style_motion: TextStyleMotion;

// A widget can use its default face without carrying a rule table. Installing
// a style sheet supplies the optional resolver for later Text calls.
TextStyleRequest :: struct {
    kind: s32
    id: s32
    class_name: s32
    disabled: bool
}

TextStyleResolver :: #type (request: TextStyleRequest,
    base: TextFace) -> TextFace;

active_text_style_callback: TextStyleResolver;
has_text_style_resolver: bool;

#program_export
SetTextStyleResolver :: (resolver: TextStyleResolver) {
    active_text_style_callback = resolver
    has_text_style_resolver = true
}

#program_export
TextStyleFor :: (request: TextStyleRequest,
    base: TextFace) -> TextFace {
    if !has_text_style_resolver { return base }
    resolver: TextStyleResolver = active_text_style_callback
    return resolver(request, base)
}
