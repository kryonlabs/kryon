App :: #import "kryon/app";
Chip :: #import "kryon/chip";
Flow :: #import "kryon/flow";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/control_props"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"

// Selectable filters and dismissible tags wrapped by a Flow.
filters: [4]bool = .[true, false, false, false];
tags: [3]bool = .[true, true, true];
filter_names: [4]string = .["All", "Design", "Code", "Docs"];
tag_names: [3]string = .["Draft", "Shared", "Pinned"];

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Chip", .size = 28})
    filter_row := Flow.Draw(session, Flow.Props.{.gap = 8})
    if filter_row.opened {
        for i: 0..3 {
            chip := Chip.Draw(session, Chip.Props.{.label = filter_names[i], .selectable = true,
                .selected = filters[i], .tone = .ButtonToneAccent, .disabled = example_disabled})
            if chip.changed { filters[i] = chip.selected }
        }
        unused End(session)
    }
    tag_row := Flow.Draw(session, Flow.Props.{.gap = 8})
    if tag_row.opened {
        for i: 0..2 {
            if tags[i] && Chip.Draw(session, Chip.Props.{.label = tag_names[i], .dismissible = true, .disabled = example_disabled}).dismissed { tags[i] = false }
        }
        unused End(session)
    }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "chip"}, Frame) }
