#module "example_pictures"
#import "kryon.h"
#import "kryon_example_font.h"

app "Kryon Pictures" {
    size 640 420
    fps 60
    font examples
    theme THEME_CHERRY 0
}

screen main {
    Background(GetThemeBackground())
    Text("Pictures are image nodes", ScaleUIPx(32), ScaleUIPx(30),
               Text24, GetThemeText())
    Stack((ColumnProps){
        .bounds = {ScaleUIPx(32), ScaleUIPx(82), ScaleUIPx(260), ScaleUIPx(210)},
        .key = Key("picture-card"),
    })
    Rect(ScaleUIPx(32), ScaleUIPx(82), ScaleUIPx(260), ScaleUIPx(210),
               GetThemeSurface(), GetThemeButton())
    Picture((PictureProps){"tiles/tile.png",
             (Rectangle){ScaleUIPx(52),ScaleUIPx(104),ScaleUIPx(96),ScaleUIPx(96)},
             (Rectangle){0,0,0,0},(Vector2){0,0},0.0f,WHITE,
             PICTURE_FIT_CONTAIN})
    Picture((PictureProps){"pfp/lotus.png",
             (Rectangle){ScaleUIPx(168),ScaleUIPx(104),ScaleUIPx(96),ScaleUIPx(96)},
             (Rectangle){0,0,0,0},(Vector2){0,0},0.0f,WHITE,
             PICTURE_FIT_CONTAIN})
    Text("Pictures keep their node bounds for editing",
               ScaleUIPx(52), ScaleUIPx(226), Text12, GetThemeIcon())
    End()
}
