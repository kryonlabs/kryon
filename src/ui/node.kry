#module "node"

#import "ui_node_props.generated.h"
#import <stdio.h>
#import <string.h>

PropertyKindName :: (kind: PropertyKind) -> const char* #export {
    switch kind {
        case PROPERTY_BOOL: return "bool"
        case PROPERTY_INT: return "int"
        case PROPERTY_FLOAT: return "float"
        case PROPERTY_STRING: return "string"
        case PROPERTY_COLOR: return "color"
        case PROPERTY_ENUM: return "enum"
        case PROPERTY_VECTOR2: return "vector2"
        case PROPERTY_RECTANGLE: return "rectangle"
        case PROPERTY_ASSET_PATH: return "asset_path"
    }
    return "unknown"
}

PropertyBool :: (value: int) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_BOOL
    property.as.bool_value = value != 0 ? 1 : 0
    return property
}

PropertyInt :: (value: int) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_INT
    property.as.int_value = value
    return property
}

PropertyFloat :: (value: float) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_FLOAT
    property.as.float_value = value
    return property
}

PropertyString :: (value: const char*) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_STRING
    snprintf(property.as.string_value, sizeof(property.as.string_value), "%s",
             value != nil ? value : "")
    return property
}

PropertyColor :: (value: Color) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_COLOR
    property.as.color_value = value
    return property
}

PropertyEnum :: (index: int) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_ENUM
    property.as.enum_index = index
    return property
}

PropertyVector2 :: (value: Vector2) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_VECTOR2
    property.as.vector2_value = value
    return property
}

PropertyRectangle :: (value: Rectangle) -> PropertyValue #export {
    property: PropertyValue = {0}
    property.kind = PROPERTY_RECTANGLE
    property.as.rectangle_value = value
    return property
}

KryonNodeKindName :: (kind: KryonNodeKind) -> const char* #export {
    switch kind {
        case KRYON_NODE_KIND_UI: return "ui"
        case KRYON_NODE_KIND_2D: return "2d"
        case KRYON_NODE_KIND_DATA: return "data"
        case KRYON_NODE_KIND_GROUP: return "group"
        case KRYON_NODE_KIND_UNKNOWN: break
    }
    return "unknown"
}

KryonNodeInit :: (node: KryonNode*, id: const char*,
                   type_name: const char*, kind: KryonNodeKind) #export {
    if node == nil {
        return
    }
    memset(node, 0, sizeof(*node))
    snprintf(node->id, sizeof(node->id), "%s", id != nil ? id : "")
    snprintf(node->name, sizeof(node->name), "%s",
             type_name != nil ? type_name : "Node")
    snprintf(node->type, sizeof(node->type), "%s",
             type_name != nil ? type_name : "Node")
    node->kind = kind
    node->flags = KRYON_NODE_FLAG_VISIBLE
    node->scale = (Vector2){1.0f, 1.0f}
}
