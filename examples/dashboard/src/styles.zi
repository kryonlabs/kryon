// The dashboard's stylesheet: tokens, the layout of every container and
// the widget looks. Breakpoints are viewport-width media rules.
CSS :: #import "css/Css";
Theme :: #import "kryon/theme";

sheet: CSS.CssSheet;
sheet_parsed: bool;
applied: bool;
applied_env: CSS.CssEnvironment;
css_reported: bool;

dashboard_css :: #string CSS
:root {
  --surface-page: #f3f5f8;
  --surface-card: #ffffff;
  --surface-sunken: #f3f5f8;
  --surface-hover: #eef2f6;
  --surface-selected: #e2f2eb;
  --text-primary: #0f172a;
  --text-muted: #526072;
  --text-selected: #065f46;
  --border-subtle: #dde3eb;
  --border-strong: #94a3b8;
  --accent: hwb(160deg 2% 41%);
  --accent-text: #ffffff;
  --focus-ring: hwb(199deg 5% 8% / 95%);
  --card-pad: 16px;
  --control-height: 36px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --surface-page: #10141b;
    --surface-card: #181d25;
    --surface-sunken: #10141b;
    --surface-hover: #222936;
    --surface-selected: #133529;
    --text-primary: #f1f5f9;
    --text-muted: #94a3b8;
    --text-selected: #6ee7b7;
    --border-subtle: #2b3340;
    --border-strong: #526072;
    --accent: #34d399;
    --accent-text: #052e1f;
    --focus-ring: #38bdf8;
  }
}

@media (-kryon-density: compact) {
  :root {
    --card-pad: 12px;
    --control-height: 32px;
  }
}

Row.shell { background: var(--surface-page); }

Column.sidebar {
  width: 216px;
  padding: 18px 12px;
  gap: 6px;
  background: var(--surface-card);
}

Column.main { padding: 18px; gap: 12px; }
Row.header, Row.kpi-top, Row.inspector-top, Row.setting { gap: 8px; }
Row.header-actions { width: 246px; margin-left: auto; gap: 6px; }
Row.badge-slot { width: 90px; margin-left: auto; }
Row.toggle-slot { width: 104px; margin-left: auto; }
Row.filters { gap: 6px; }
Row.actions { gap: 12px; }

Grid.nav-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
Grid.kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
Grid.stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
Grid.modal-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

Column.kpi, Column.inspector, Column.state-card {
  background: var(--surface-card);
  border: 1px solid;
  border-color: var(--border-subtle);
  border-radius: 10px;
  padding: var(--card-pad);
  gap: 6px;
}

Column.body, Column.scroll-area { flex: 1; }
Column.state-card { flex: 1; padding: 24px; gap: 12px; }
Row.split { gap: 14px; }
Column.list { flex: 1 1 0; gap: 6px; }
Column.inspector { flex: 0 0 340px; }
Column.rows { gap: 8px; }
Column.stat { gap: 2px; }
Column.settings { gap: 10px; }
Column.centered-action { width: 160px; margin: 0 auto; }

.brand { font-size: 18px; }
.title { font-size: 22px; }
.muted { font-size: 12px; color: var(--text-muted); }
.kpi-value { font-size: 22px; }
.inspector-title { font-size: 18px; }
.summary { font-size: 13px; }
.stat-name { font-size: 11px; color: var(--text-muted); }
.stat-value { font-size: 14px; }
.state-text { font-size: 15px; text-align: center; }
.setting-name { font-size: 14px; }

@media (max-width: 759px) {
  Row.header-actions { width: 176px; }
  Grid.kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  Row.split { flex-direction: column; gap: 10px; }
  Column.inspector { flex: 0 0 210px; }
}

@media (-kryon-density: compact) {
  Column.main { padding: 12px; }
  Button.result-row { min-height: 50px; }
}

Button.nav-item {
  background: transparent;
  color: var(--text-muted);
  border: none;
  border-radius: 8px;
  min-block-size: var(--control-height);
  padding: 6px 12px;
  outline-color: var(--focus-ring);
  -kryon-font-role: control;
}

Button.nav-item:hover {
  background: var(--surface-hover);
  color: var(--text-primary);
  opacity: 96%;
}

Button.nav-item:selected {
  background: var(--surface-selected);
  color: var(--text-selected);
}

Button.chip {
  background: var(--surface-sunken);
  color: var(--text-muted);
  border: 1px solid;
  border-color: var(--border-subtle);
  border-radius: 8px;
  min-height: 30px;
  padding: 4px 10px;
  outline-color: var(--focus-ring);
}

Button.chip:hover {
  background: var(--surface-hover);
  color: var(--text-primary);
}

Button.chip:selected {
  background: var(--surface-selected);
  color: var(--text-selected);
  border-color: var(--accent);
}

Button.result-row {
  min-height: 56px;
  background: var(--surface-card);
  color: var(--text-primary);
  border: 1px solid;
  border-color: var(--border-subtle);
  border-radius: 8px;
  padding: 8px 12px;
  outline-color: var(--focus-ring);
}

Button.result-row:hover {
  background: var(--surface-hover);
}

Button.result-row:selected {
  background: var(--surface-selected);
  color: var(--text-selected);
  border-color: var(--accent);
}

Button.primary-btn {
  background: var(--accent);
  color: var(--accent-text);
  border-radius: 8px;
  min-height: var(--control-height);
  outline-color: var(--focus-ring);
}

TextField.search-field {
  background: var(--surface-sunken);
  color: var(--text-primary);
  border: 1px solid;
  border-color: var(--border-strong);
  border-radius: 8px;
  padding: 0px 12px;
  outline-color: var(--focus-ring);
}

TextField.search-field:focus {
  border-color: var(--accent);
}

Modal {
  background: var(--surface-card);
  color: var(--text-primary);
  border: 1px solid;
  border-color: var(--border-subtle);
  border-radius: 12px;
  -kryon-elevation: floating;
}
CSS;

ClassId :: (name: string) -> s32 {
    return CSS.StyleClass(name)
}

// A rejected stylesheet leaves the default theme; say why, once.
ReportCss :: () -> bool {
    if !css_reported {
        diagnostic: [512]u8
        print("dashboard.css: %\n", CSS.CssSheetDiagnostic(*sheet, diagnostic[:]))
        css_reported = true
    }
    return false
}

EnsureDashboardTheme :: (dark: bool, compact: bool, reduced_motion: bool, width: float32) -> bool {
    env := CSS.CssEnvironmentWithViewportWidth(CSS.CssEnvironmentWithNames(CSS.CssDefaultEnvironment(),
        ifx dark then "dark" else "light", "normal", ifx compact then "compact" else "comfortable",
        "mouse", "desktop"), width)
    if applied && applied_env.scheme == env.scheme && applied_env.density == env.density &&
        CSS.CssSheetSameMedia(*sheet, applied_env, env) {
        return true
    }
    unused Theme.InstallDefaultTheme(dark, reduced_motion)
    if !sheet_parsed {
        CSS.CssSheetReset(*sheet)
        if !CSS.CssSheetParse(*sheet, dashboard_css, "dashboard.css", CSS.CssNoImports) { return ReportCss() }
        sheet_parsed = true
    }
    if !CSS.CssSheetInstall(*sheet, env, null) { return ReportCss() }
    applied_env = env
    applied = true
    return true
}
