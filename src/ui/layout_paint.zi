#import "control_props"
#import "drawing_props"
#import "geometry"
#import "layout_paint_slot"
#import "paint_queue"
#import "session"
#import "style"
#import "style_sheet"
#import "surface"

using StyleField;
using StyleBoxField;

// A container's CSS box, like a styled div: shadow (an elevation role),
// background (a color or two-stop gradient), border and radius at the
// container's bounds. Per-side borders
// paint square edges; with a radius the box keeps its uniform border.
LayoutPaintBox :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData, mark: s64) {
    from := PaintMark(session)
    opacity := StyleOpacityValue(face.fields, face.opacity)
    radius := ifx StyleHasField(face, cast(u32)StyleRadius) && face.radius > 0.0 then face.radius else 0.0
    if StyleHasField(face, cast(u32)StyleElevation) && face.elevation != .ElevationRoleNone {
        PaintElevationForRole(session, -1, bounds, radius, opacity, cast(s32)face.elevation)
    }
    if StyleHasField(face, cast(u32)StyleBackground) {
        top := ColorFromPacked(Opacity(face.background, opacity))
        if StyleHasField(face, cast(u32)StyleBackgroundEnd) {
            PaintVerticalGradient(session, -1, bounds, top,
                ColorFromPacked(Opacity(face.background_end, opacity)))
        } else if top.a != cast(u8)0 {
            PaintRoundedFill(session, -1, bounds, radius, 8, top)
        }
    }
    uniform := ifx StyleHasField(face, cast(u32)StyleBorderWidth) && face.border_width > 0.0 then face.border_width else 0.0
    border := ColorFromPacked(Opacity(face.border, opacity))
    if (box.fields & cast(u32)StyleBoxBorderSides) != 0 && radius == 0.0 {
        LayoutPaintSides(session, bounds, face, box, opacity, uniform)
    } else if uniform > 0.0 && border.a != cast(u8)0 {
        PaintRoundedOutline(session, -1, bounds, radius, 8, uniform, border)
    }
    if mark >= 0 { PaintMoveBelow(session, mark, from) }
}

// Each side is a band inside the border box: top and bottom span its width,
// left and right the height between them.
LayoutPaintSides :: (session: Session, bounds: Rectangle, face: StyleData, box: StyleBoxData,
    opacity: float32, uniform: float32) {
    widths: [4]float32
    colors: [4]Color
    for side: cast(u32)0..3 {
        widths[side] = uniform
        if (box.fields & (cast(u32)StyleBoxBorderTop << side)) != 0 { widths[side] = box.border_widths[side] }
        packed := face.border
        if (box.fields & (cast(u32)StyleBoxBorderTopColor << side)) != 0 { packed = box.border_colors[side] }
        colors[side] = ColorFromPacked(Opacity(packed, opacity))
    }
    middle := bounds.height - widths[0] - widths[2]
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y, bounds.width, widths[0]}, colors[0])
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y + bounds.height - widths[2], bounds.width, widths[2]}, colors[2])
    LayoutPaintBand(session, Rectangle.{bounds.x, bounds.y + widths[0], widths[3], middle}, colors[3])
    LayoutPaintBand(session, Rectangle.{bounds.x + bounds.width - widths[1], bounds.y + widths[0], widths[1], middle}, colors[1])
}

LayoutPaintBand :: (session: Session, band: Rectangle, color: Color) {
    if band.width > 0.0 && band.height > 0.0 && color.a != cast(u8)0 {
        PaintRoundedFill(session, -1, band, 0.0, 8, color)
    }
}

LayoutPaintInstall :: () {
    layout_box_paint = LayoutPaintBox
    layout_paint_mark = PaintMark
}
