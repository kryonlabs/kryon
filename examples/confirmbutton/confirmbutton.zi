ConfirmButton :: #import "kryon/confirm_button";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"

state: ConfirmButton.ConfirmButtonState;
confirmed: bool;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Confirm button", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    result := ConfirmButton.Draw(session, ConfirmButton.Props.{.button = .{.disabled = example_disabled, .bounds = .{width = 220, height = 44}, .label = "Delete item"}, .confirm_button = .{.disabled = example_disabled, .label = "Confirm delete"}, .now = cast(float32)now, .timeout = 3.0}, *state)
    if result.committed { confirmed = true }
    label := "Ready"
    if confirmed { label = "Item deleted" }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 36}, .text = label})
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
