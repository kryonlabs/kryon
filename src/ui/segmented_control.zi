#import "style"
#import "control_props"

SegmentedMetrics :: struct {
    gap: s32
    row_height: s32
    min_item_width: s32
    max_item_width: s32
    label_padding: s32
}

SegmentedRow :: struct {
    start: s32
    count: s32
    width: s32
    button_width: s32
    x: s32
    y: s32
}

SegmentedRowAdvance :: struct {
    row_width: s32
    row_count: s32
    wrap_before: bool
}

SegmentedSelectionResult :: struct {
    selected_index: s32
    changed: bool
}

SegmentedMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
SegmentedDefaultMetrics :: (row_height: s32, min_item_width: s32,
    max_item_width: s32, scale: float32, control: StyleFrame,
    segment: StyleFrame) -> SegmentedMetrics {
    if scale <= 0.0 { scale = 1.0 }
    metrics: SegmentedMetrics
    metrics.gap = SegmentedMetric(segment.value.fields, cast(u32)StyleGap,
        segment.value.gap, -1.0, scale, true)
    if metrics.gap < 0 {
        metrics.gap = SegmentedMetric(control.value.fields, cast(u32)StyleGap,
            control.value.gap, 6.0, scale, true)
    }
    metrics.row_height = row_height
    if metrics.row_height <= 0 {
        metrics.row_height = SegmentedMetric(control.value.fields,
            cast(u32)StyleIconSize, control.value.icon_size, 30.0, scale, false)
    }
    metrics.min_item_width = min_item_width
    if metrics.min_item_width <= 0 {
        metrics.min_item_width = SegmentedMetric(control.value.fields,
            cast(u32)StyleContentOffset, control.value.offset_x, 72.0, scale,
            false)
    }
    metrics.max_item_width = max_item_width
    if metrics.max_item_width <= 0 {
        metrics.max_item_width = SegmentedMetric(control.value.fields,
            cast(u32)StyleContentOffset, control.value.offset_y, 180.0, scale,
            false)
    }
    if metrics.max_item_width > 0 && metrics.max_item_width < metrics.min_item_width {
        metrics.max_item_width = metrics.min_item_width
    }
    label_padding: float32 = segment.value.padding_x * 2.0
    if (segment.value.fields & cast(u32)StylePaddingX) == cast(u32)0 ||
       segment.value.padding_x < 0.0 {
        label_padding = 20.0
    }
    metrics.label_padding = SegmentedMetric(segment.value.fields,
        cast(u32)StyleContentOffset, segment.value.offset_x, label_padding, scale, true)
    return metrics
}

#program_export
SegmentedItemWidth :: (label_width: s32, metrics: SegmentedMetrics) -> s32 {
    width: s32 = label_width + metrics.label_padding
    if width < metrics.min_item_width {
        width = metrics.min_item_width
    }
    if metrics.max_item_width > 0 && width > metrics.max_item_width {
        width = metrics.max_item_width
    }
    return width
}

#program_export
SegmentedNextRowWidth :: (row_width: s32, item_width: s32, gap: s32) -> s32 {
    if row_width > 0 {
        return row_width + gap + item_width
    }
    return item_width
}

#program_export
SegmentedShouldWrap :: (wrap: bool, row_width: s32, next_width: s32,
    available_width: s32) -> bool {
    return wrap && row_width > 0 && next_width > available_width
}

#program_export
SegmentedRowAdvanceFor :: (wrap: bool, row_width: s32, row_count: s32,
    item_width: s32, available_width: s32, metrics: SegmentedMetrics) -> SegmentedRowAdvance {
    advance: SegmentedRowAdvance
    next_width: s32 = SegmentedNextRowWidth(row_width, item_width, metrics.gap)
    advance.wrap_before = SegmentedShouldWrap(wrap, row_width, next_width,
        available_width)
    if advance.wrap_before {
        advance.row_width = item_width
        advance.row_count = 1
    } else {
        advance.row_width = next_width
        advance.row_count = row_count + 1
    }
    return advance
}

#program_export
SegmentedHeightForRows :: (rows: s32, row_height: s32, gap: s32) -> s32 {
    if rows <= 0 || row_height <= 0 {
        return 0
    }
    return rows * row_height + (rows - 1) * gap
}

#program_export
SegmentedFocusIdFor :: (control_id: s32, index: s32) -> s32 {
    if control_id <= 0 || index < 0 {
        return 0
    }
    return control_id * 1000 + index + 1
}

#program_export
SegmentedSelectionFor :: (selected_index: s32, clicked_index: s32,
    has_selected_index: bool) -> SegmentedSelectionResult {
    result: SegmentedSelectionResult
    result.selected_index = selected_index
    result.changed = false
    if clicked_index < 0 {
        return result
    }
    result.selected_index = clicked_index
    result.changed = has_selected_index && selected_index != clicked_index
    return result
}

#program_export
SegmentedRowFor :: (bounds_x: float32, bounds_width: float32, y: s32,
    row_start: s32, row_count: s32, row_width: s32, wrap: bool,
    metrics: SegmentedMetrics) -> SegmentedRow {
    row: SegmentedRow
    row.start = row_start
    row.count = row_count
    row.width = row_width
    row.y = y
    available: s32 = cast(s32)bounds_width
    if row_count <= 0 || available <= 0 {
        return row
    }
    if wrap {
        row.button_width = (available - metrics.gap * (row_count - 1)) / row_count
        row.x = cast(s32)bounds_x + (available -
            (row.button_width * row_count + metrics.gap * (row_count - 1))) / 2
    } else {
        row.button_width = (row_width -
            metrics.gap * (row_count - 1)) / row_count
        row.x = cast(s32)bounds_x
    }
    if row.button_width < 0 {
        row.button_width = 0
    }
    return row
}
