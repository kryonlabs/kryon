#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "drawing_props"
#import "geometry"
#import "overlay_props"
#import "overlay_widget"
#import "paint_queue"
#import "tree"
#import "tree_input"
#import "widget_kind"
#import "ziran_overlay_widget_host"

phase: s32;

#program_export
Frame :: () -> s32 {
    props: DismissibleOverlayProps
    props.key = cast(u64)20
    props.bounds = Rectangle.{120.0, 20.0, 80.0, 70.0}
    props.scrim = Color.{0, 0, 0, 160}
    if phase == 5 {
        props.dismiss_disabled = true
        props.view_width = 240
        props.view_height = 120
    }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 240.0, 120.0})
    beneath: s32 = TreeSubmitCurrent(TestSession(), cast(u64)10,
        WidgetKindButton, Rectangle.{10.0, 10.0, 80.0, 30.0})
    TreeSetInteractive(TestSession(), beneath, false, false, 10)
    overlay: DismissibleOverlayResult = DismissibleOverlay(TestSession(), props)
    if overlay.node < 0 || overlay.panel_node < 0 { return -1 }
    child: s32 = TreeSubmit(TestSession(), cast(u64)3, overlay.panel_node,
        WidgetKindButton, Rectangle.{130.0, 30.0, 50.0, 20.0})
    TreeSetInteractive(TestSession(), child, false, false, 3)
    child_activation: bool = TreeTakeActivationAt(TestSession(),
        TreeChild(TestSession(), overlay.panel_node, cast(u64)3,
            WidgetKindButton))
    beneath_activation: bool = TreeTakeActivationAt(TestSession(),
        TreeChild(TestSession(), 0, cast(u64)10, WidgetKindButton))
    if !TreeFinish(TestSession()) || TreeCount(TestSession()) != 6 ||
        overlay.node != 2 || overlay.panel_node != 4 ||
        TreeHitAt(TestSession(), 20.0, 20.0) != 3 ||
        TreeHitAt(TestSession(), 135.0, 35.0) != 5 ||
        TreeHitAt(TestSession(), 220.0, 110.0) != 3 ||
        beneath_activation { return -2 }
    if phase == 0 {
        if overlay.closed || overlay.release_consumed ||
            child_activation { return -3 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, false, false, true})
    } else if phase == 1 {
        if !overlay.closed || !overlay.outside_released ||
            !overlay.release_consumed || child_activation { return -4 }
        TreePointerUpdate(TestSession(), PointerFrame.{135.0, 35.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{135.0, 35.0, false, false, true})
    } else if phase == 2 {
        if overlay.closed || overlay.release_consumed ||
            !child_activation { return -5 }
        TreePointerUpdate(TestSession(), PointerFrame.{190.0, 80.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{190.0, 80.0, false, false, true})
    } else if phase == 3 {
        if overlay.closed || overlay.release_consumed ||
            child_activation { return -6 }
        TreePointerUpdate(TestSession(), PointerFrame.{190.0, 80.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{250.0, 130.0, false, false, true})
    } else if phase == 4 {
        if !overlay.closed || !overlay.outside_released ||
            !overlay.release_consumed { return -7 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 20.0, false, false, true})
    } else {
        if overlay.closed || overlay.release_consumed ||
            child_activation { return -8 }
    }
    PaintFlush(TestSession())
    old: s32 = phase
    phase += 1
    return old
}

#program_export
main :: () -> s32 {
    expected: s32 = 0
    while expected < 6 {
        if Frame() != expected || OverlayFillCount() != expected + 1 ||
            OverlayHostFailed() { return expected + 1 }
        expected += 1
    }
    return 0
}
