#import "direction_pad"

// Laws for the four-way direction pad. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

// A pad 20 wide: half its side is 10 and the hub reaches 2 from the centre.
A :: (dx: s32, dy: s32) -> s32 {
    return DirectionPadArm(cast(float32)dx, cast(float32)dy, 10.0)
}

S :: (arm: s32, last: s32, now: s32, next: s32) -> DirectionPadHold {
    return DirectionPadStep(arm, last, cast(float64)now, cast(float64)next, 0.5)
}

// The hub in the middle presses no arm.
#law HubPressesNothing forall dx: -2..2, dy: -2..2 => A(dx, dy) == -1;

// Outside the hub the longer offset decides; a tie goes to left or right.
#law LeftArm forall dx: -20..-3, dy: -20..20 => dy * dy > dx * dx || A(dx, dy) == 0;
#law RightArm forall dx: 3..20, dy: -20..20 => dy * dy > dx * dx || A(dx, dy) == 2;
#law UpArm forall dx: -20..20, dy: -20..-3 => dx * dx >= dy * dy || A(dx, dy) == 1;
#law DownArm forall dx: -20..20, dy: 3..20 => dx * dx >= dy * dy || A(dx, dy) == 3;

// Every press outside the hub presses some arm.
#law OutsideHubPressesAnArm forall dx: -20..20, dy: -20..20 => (dx * dx <= 4 && dy * dy <= 4) || A(dx, dy) >= 0;

// Pressing an arm, or sliding onto another one, steps that way at once and
// waits two repeats for the next step, like the first repeat of a held key.
#law PressStepsAtOnce forall arm: 0..3, last: -1..3, now: 0..4, next: 0..8 => arm == last || (S(arm, last, now, next).direction == arm && S(arm, last, now, next).last == arm && S(arm, last, now, next).next == cast(float64)now + 1.0);

// Holding the same arm steps again only when the step is due, then waits
// one repeat.
#law HeldArmRepeats forall arm: 0..3, now: 0..4, next: 0..8 => S(arm, arm, now, next).direction == (ifx now >= next then arm else -1) && S(arm, arm, now, next).last == arm && S(arm, arm, now, next).next == (ifx now >= next then cast(float64)now + 0.5 else cast(float64)next);

// Letting go or resting on the hub never steps and forgets the arm.
#law ReleaseForgets forall last: -1..3, now: 0..4, next: 0..8 => S(-1, last, now, next).direction == -1 && S(-1, last, now, next).last == -1;

// So pressing the same arm again right away steps at once.
#law PressAgainStepsAtOnce forall arm: 0..3, now: 0..4, next: 0..8 => S(arm, S(-1, arm, now, next).last, now, next).direction == arm;

// Without a repeat, a held arm never steps again; a press still steps.
#law NoRepeatOnlyPress forall arm: 0..3, now: 0..4, next: 0..8 => DirectionPadStep(arm, arm, cast(float64)now, cast(float64)next, 0.0).direction == -1 && DirectionPadStep(arm, -1, cast(float64)now, cast(float64)next, 0.0).direction == arm;
