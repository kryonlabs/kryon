#import "dropdown"
#import "geometry"
#import "image_props"

DropdownOption :: struct {
    key: u64
    label: string
    image: ImageProps
    disabled: bool
    separator_before: bool
    // An icon button at the end of the row, such as download or remove, and
    // the name a screen reader gives it. Pressing it reports the option in
    // action_index and leaves the menu open without choosing the option.
    action_shape: string
    action_label: string
}

DropdownProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    placeholder: string
    selected_index: s32
    // The dropdown keeps its menu, highlight and scroll by itself. open asks
    // it to open and close asks it to close; neither is needed to keep a
    // menu open, and the menu scrolls without any props.
    open: bool
    close: bool
    focused: bool
    scale: float32
    trigger_input: DropdownTriggerInput
    menu_input: DropdownMenuInput
    disabled: bool
}

DropdownResult :: struct {
    node: s32
    selected_index: s32
    open: bool
    changed: bool
    opened: bool
    closed: bool
    // The option whose action icon was pressed this frame, or -1.
    action_index: s32
}
