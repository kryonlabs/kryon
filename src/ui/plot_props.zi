#module "plot_props"
#import "geometry"

PlotMode :: enum {
    PlotLines = 0
    PlotBars = 1
}

PlotProps :: struct {
    bounds: Rectangle
    class_name: i32
    label: const char*
    values: const float*
    value_count: i32
    offset: i32
    overlay: const char*
    scale_min: float
    scale_max: float
    mode: PlotMode
}
