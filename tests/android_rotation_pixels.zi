#import, file "../src/backend/android_surface.zi";
#import "drawing_props"
#import "geometry"
Pixels :: #import "pixmap";
#if #defined(PLATFORM_ANDROID) {
    #import "android_jni"
    Native :: #import, file "../src/backend/android_native.zi";
}

native_width: s32 = 360;
native_height: s32 = 640;
pixels: [230400]u32;

#program_export
ANativeWindow_getWidth :: (window: *void) -> s32 { unused window; return native_width }
#program_export
ANativeWindow_getHeight :: (window: *void) -> s32 { unused window; return native_height }

CheckFrame :: () -> u64 {
    viewport: AndroidViewport
    #if #defined(PLATFORM_ANDROID) {
        width: s32; height: s32
        if SyncAndroidSurfaceSize(*width, *height) != 1 ||
            width != native_width || height != native_height { return cast(u64)0 }
        if SyncAndroidViewport(*viewport) != 1 { return cast(u64)0 }
        transform: AndroidSurfaceTransform
        if !ReadAndroidSurfaceTransform(*transform) ||
            transform.screen_width != native_width || transform.screen_height != native_height ||
            transform.render_width != native_width || transform.render_height != native_height ||
            transform.offset_x != 0 || transform.offset_y != 0 ||
            transform.scale_x != 1.0 || transform.scale_y != 1.0 ||
            transform.projection_x != 1.0 || transform.projection_y != 1.0 { return cast(u64)0 }
        Native.android_pixels = pixels[:]
    } else {
        viewport = ResolveViewport(native_width, native_height,
            AndroidWindowInsets.{}, AndroidViewportPolicy.{}, 1)
    }
    if viewport.x != 0 || viewport.y != 0 || viewport.width != native_width ||
        viewport.height != native_height { return cast(u64)0 }
    // The current native host borrows this same Pixmap surface at its new size.
    if !Pixels.PixmapBeginInto(cast(u32)0xff000000, native_width, native_height,
        pixels[:], true) { return cast(u64)0 }
    Pixels.RasterRoundedRectangle(Rectangle.{100.0, 100.0, 80.0, 80.0}, 40.0, 32,
        Color.{255, 255, 255, 255})
    Pixels.RasterText("Lumi", 100, 220, 24, Color.{255, 255, 255, 255})
    Pixels.PixmapEndInto()
    min_x: s32 = native_width; min_y: s32 = native_height
    max_x: s32 = -1; max_y: s32 = -1
    for y: 0..199 {
        for x: 0..249 {
            if (pixels[y * native_width + x] & cast(u32)0xff) > cast(u32)128 {
                if x < min_x { min_x = cast(s32)x }
                if y < min_y { min_y = cast(s32)y }
                if x > max_x { max_x = cast(s32)x }
                if y > max_y { max_y = cast(s32)y }
            }
        }
    }
    if max_x - min_x < 78 || max_x - min_x > 81 || max_y - min_y < 78 ||
        max_y - min_y > 81 || min_x < 98 || min_x > 101 || min_y < 98 || min_y > 101 { return cast(u64)0 }
    glyph_pixels: s32
    hash: u64 = cast(u64)14695981039346656037
    for y: 90..259 {
        for x: 90..249 {
            pixel := pixels[y * native_width + x]
            if y >= 220 && (pixel & cast(u32)0xff) > cast(u32)128 { glyph_pixels += 1 }
            hash = (hash ^ cast(u64)pixel) * cast(u64)1099511628211
        }
    }
    if glyph_pixels < 100 { return cast(u64)0 }
    return hash
}

#program_export
main :: () -> s32 {
    #if #defined(PLATFORM_ANDROID) {
        app: NativeAndroidApp
        app.window = cast(*void)*app
        Native.android_native_app = *app
        SetAndroidWindowInsets(0, 0, 0, 0, 0, 0, 0, 0, 0)
        SetAndroidViewportPolicy(AndroidViewportPolicy.{})
    }
    portrait := CheckFrame()
    if portrait == cast(u64)0 { return 20 }
    native_width = 640; native_height = 360
    landscape := CheckFrame()
    if landscape == cast(u64)0 || landscape != portrait { return 21 }
    native_width = 360; native_height = 640
    if CheckFrame() != portrait { return 22 }
    Pixels.PixmapCloseWorkers()
    return 0
}
