
// A terminal cell is a character and resolved colors. A platform host may
// compare successive buffers and emit ANSI, but it never decides layout.
Cell :: struct {
    glyph: u32
    foreground: u32
    background: u32
    attributes: u32
}

#program_export
CellPut :: (cells: []Cell, columns: s32, rows: s32,
    x: s32, y: s32, cell: Cell) -> bool {
    if columns <= 0 || rows <= 0 || x < 0 || y < 0 ||
       x >= columns || y >= rows { return false }
    at: s64 = cast(s64)y * cast(s64)columns + cast(s64)x
    if at < cast(s64)0 || at >= cast(s64)(cast(s32)cells.count) { return false }
    cells[cast(s32)at] = cell
    return true
}

#program_export
CellFill :: (cells: []Cell, columns: s32, rows: s32,
    x: s32, y: s32, width: s32, height: s32,
    cell: Cell) {
    if width <= 0 || height <= 0 { return }
    row: s32 = 0
    while row < height {
        col: s32 = 0
        while col < width {
            CellPut(cells, columns, rows, x + col, y + row, cell)
            col += 1
        }
        row += 1
    }
}

CellCodepointResult :: struct {
    value: u32
    after: s32
}

// Returns one Unicode scalar and the byte offset after it. Invalid UTF-8
// consumes one byte and yields U+FFFD so the terminal renderer stays aligned.
#program_export
CellCodepoint :: (text: string, at: s32) -> CellCodepointResult {
    result: CellCodepointResult
    result.after = at
    if at < 0 || at >= (cast(s32)text.count) { return result }
    first: u8 = text[at]
    result.after = at + 1
    if first < cast(u8)128 {
        result.value = cast(u32)first
        return result
    }
    result.value = cast(u32)65533
    count: s32 = 0
    codepoint: u32 = cast(u32)0
    minimum: u32 = cast(u32)0
    if first >= cast(u8)194 && first <= cast(u8)223 {
        count = 1
        codepoint = cast(u32)(first & cast(u8)31)
        minimum = cast(u32)128
    } else if first >= cast(u8)224 && first <= cast(u8)239 {
        count = 2
        codepoint = cast(u32)(first & cast(u8)15)
        minimum = cast(u32)2048
    } else if first >= cast(u8)240 && first <= cast(u8)244 {
        count = 3
        codepoint = cast(u32)(first & cast(u8)7)
        minimum = cast(u32)65536
    }
    if count == 0 { return result }
    if at + count >= (cast(s32)text.count) { return result }
    index: s32 = 1
    while index <= count {
        part: u8 = text[at + index]
        if part < cast(u8)128 || part > cast(u8)191 { return result }
        codepoint = (codepoint << cast(u32)6) | cast(u32)(part & cast(u8)63)
        index += 1
    }
    if codepoint < minimum || codepoint > cast(u32)1114111 ||
       (codepoint >= cast(u32)55296 && codepoint <= cast(u32)57343) {
        return result
    }
    result.value = codepoint
    result.after = at + count + 1
    return result
}

// Write one scalar per cell. This primitive covers single-width text; a
// complete terminal layout layer must resolve wide and combining clusters in
// Ziran before submitting cells. The host only encodes and presents them.
#program_export
CellWrite :: (cells: []Cell, columns: s32, rows: s32,
    x: s32, y: s32, text: string, foreground: u32,
    background: u32, attributes: u32) -> s32 {
    at: s32 = 0
    col: s32 = x
    written: s32 = 0
    while at < (cast(s32)text.count) {
        point: CellCodepointResult = CellCodepoint(text, at)
        if point.after <= at { break }
        cell: Cell
        cell.glyph = point.value
        cell.foreground = foreground
        cell.background = background
        cell.attributes = attributes
        if CellPut(cells, columns, rows, col, y, cell) { written += 1 }
        col += 1
        at = point.after
    }
    return written
}
