// Browser input policy. The page's JavaScript only forwards raw DOM events
// here; which keys exist, how presses, repeats, touches, and wheels turn into
// state, and what the page must do about each event is decided in this module.
#import "byte_text_linux"
#import "page_core"
#if #defined(PLATFORM_WEB) {
    CanvasEventMouseMove :: 0
    CanvasEventMouseDown :: 1
    CanvasEventMouseUp :: 2
    CanvasEventWheel :: 3
    CanvasEventKeyDown :: 4
    CanvasEventKeyUp :: 5
    CanvasEventKeyChar :: 6
    CanvasEventTouchBegin :: 7
    CanvasEventTouchPoint :: 8
    CanvasEventTouchEnd :: 9
    CanvasEventFocus :: 10
    CanvasEventBlur :: 11
    CanvasEventPaste :: 12
    CanvasEventCopy :: 13

    // What the page does after an event.
    CanvasEventPreventDefault :: 1
    CanvasEventFocusCanvas :: 2
    CanvasEventCapturePointer :: 4
    CanvasEventClipboardWritten :: 8

    CANVAS_KEY_LIMIT :: 512
    CANVAS_QUEUE_LIMIT :: 64
    CANVAS_BUTTON_LIMIT :: 8
    CANVAS_TOUCH_LIMIT :: 8
    CANVAS_CLIPBOARD_SIZE :: 4096

    CanvasKeyEntry :: struct {
        name: string
        value: s32
    }

    canvas_key_table: [62]CanvasKeyEntry = .[
    CanvasKeyEntry.{"Space", 32}, CanvasKeyEntry.{"Escape", 256},
    CanvasKeyEntry.{"Enter", 257}, CanvasKeyEntry.{"NumpadEnter", 257},
    CanvasKeyEntry.{"Tab", 258}, CanvasKeyEntry.{"Backspace", 259},
    CanvasKeyEntry.{"Insert", 260}, CanvasKeyEntry.{"Delete", 261},
    CanvasKeyEntry.{"ArrowRight", 262}, CanvasKeyEntry.{"ArrowLeft", 263},
    CanvasKeyEntry.{"ArrowDown", 264}, CanvasKeyEntry.{"ArrowUp", 265},
    CanvasKeyEntry.{"PageUp", 266}, CanvasKeyEntry.{"PageDown", 267},
    CanvasKeyEntry.{"Home", 268}, CanvasKeyEntry.{"End", 269},
    CanvasKeyEntry.{"CapsLock", 280}, CanvasKeyEntry.{"ScrollLock", 281},
    CanvasKeyEntry.{"NumLock", 282}, CanvasKeyEntry.{"PrintScreen", 283},
    CanvasKeyEntry.{"Pause", 284}, CanvasKeyEntry.{"F1", 290},
    CanvasKeyEntry.{"F2", 291}, CanvasKeyEntry.{"F3", 292},
    CanvasKeyEntry.{"F4", 293}, CanvasKeyEntry.{"F5", 294},
    CanvasKeyEntry.{"F6", 295}, CanvasKeyEntry.{"F7", 296},
    CanvasKeyEntry.{"F8", 297}, CanvasKeyEntry.{"F9", 298},
    CanvasKeyEntry.{"F10", 299}, CanvasKeyEntry.{"F11", 300},
    CanvasKeyEntry.{"F12", 301}, CanvasKeyEntry.{"ShiftLeft", 340},
    CanvasKeyEntry.{"ShiftRight", 344}, CanvasKeyEntry.{"ControlLeft", 341},
    CanvasKeyEntry.{"ControlRight", 345}, CanvasKeyEntry.{"AltLeft", 342},
    CanvasKeyEntry.{"AltRight", 346}, CanvasKeyEntry.{"MetaLeft", 343},
    CanvasKeyEntry.{"MetaRight", 347}, CanvasKeyEntry.{"Semicolon", 59},
    CanvasKeyEntry.{"Equal", 61}, CanvasKeyEntry.{"Comma", 44},
    CanvasKeyEntry.{"Minus", 45}, CanvasKeyEntry.{"Period", 46},
    CanvasKeyEntry.{"Slash", 47}, CanvasKeyEntry.{"Backquote", 96},
    CanvasKeyEntry.{"BracketLeft", 91}, CanvasKeyEntry.{"Backslash", 92},
    CanvasKeyEntry.{"BracketRight", 93}, CanvasKeyEntry.{"Quote", 39},
    CanvasKeyEntry.{"Digit0", 48}, CanvasKeyEntry.{"Digit1", 49},
    CanvasKeyEntry.{"Digit2", 50}, CanvasKeyEntry.{"Digit3", 51},
    CanvasKeyEntry.{"Digit4", 52}, CanvasKeyEntry.{"Digit5", 53},
    CanvasKeyEntry.{"Digit6", 54}, CanvasKeyEntry.{"Digit7", 55},
    CanvasKeyEntry.{"Digit8", 56}, CanvasKeyEntry.{"Digit9", 57}];
    canvas_key_table_count :: 62

    canvas_keys_down: [CANVAS_KEY_LIMIT]bool;
    canvas_keys_pressed: [CANVAS_QUEUE_LIMIT]s32;
    canvas_keys_pressed_count: s32;
    canvas_keys_released: [CANVAS_QUEUE_LIMIT]s32;
    canvas_keys_released_count: s32;
    canvas_keys_repeated: [CANVAS_QUEUE_LIMIT]s32;
    canvas_keys_repeated_count: s32;
    canvas_chars: [CANVAS_QUEUE_LIMIT]s32;
    canvas_chars_count: s32;

    canvas_buttons_down: [CANVAS_BUTTON_LIMIT]bool;
    canvas_buttons_pressed: [CANVAS_QUEUE_LIMIT]s32;
    canvas_buttons_pressed_count: s32;
    canvas_buttons_released: [CANVAS_QUEUE_LIMIT]s32;
    canvas_buttons_released_count: s32;

    canvas_mouse_x: float64;
    canvas_mouse_y: float64;
    canvas_mouse_delta_x: float64;
    canvas_mouse_delta_y: float64;
    canvas_mouse_offset_x: float64;
    canvas_mouse_offset_y: float64;
    canvas_mouse_scale_x: float64 = 1.0;
    canvas_mouse_scale_y: float64 = 1.0;
    canvas_wheel_x: float64;
    canvas_wheel_y: float64;

    canvas_touch_id: [CANVAS_TOUCH_LIMIT]s32;
    canvas_touch_x: [CANVAS_TOUCH_LIMIT]float64;
    canvas_touch_y: [CANVAS_TOUCH_LIMIT]float64;
    canvas_touch_count: s32;
    canvas_touch_pending: s32;

    canvas_focused: bool = true;
    canvas_cursor_hidden: bool;
    canvas_clipboard_gesture_until: float64;
    canvas_clipboard_text: [CANVAS_CLIPBOARD_SIZE]u8;

    CanvasQueuePush :: (items: *s32, count: *s32, value: s32) {
        if count.* < CANVAS_QUEUE_LIMIT {
            items[count.*] = value
            count.* += 1
        }
    }

    CanvasQueueHas :: (items: *s32, count: s32, value: s32) -> bool {
        index: s32 = 0
        while index < count {
            if items[index] == value { return true }
            index += 1
        }
        return false
    }

    CanvasQueuePop :: (items: *s32, count: *s32) -> s32 {
        if count.* <= 0 { return 0 }
        first: s32 = items[0]
        index: s32 = 1
        while index < count.* {
            items[index - 1] = items[index]
            index += 1
        }
        count.* -= 1
        return first
    }

    CanvasHasPrefix :: (text: string, prefix: string) -> bool {
        if text.count < prefix.count { return false }
        index: s64 = 0
        while index < cast(s64)prefix.count {
            if text[index] != prefix[index] { return false }
            index += 1
        }
        return true
    }

    // The library key number for a DOM key event, or 0 when it has none.
    CanvasKeyOf :: (code: string, key: string) -> s32 {
        if code.count == 0 && key.count > 0 {
            if key.count == 1 {
                letter: s32 = cast(s32)key[0]
                if letter >= 97 && letter <= 122 { letter -= 32 }
                if letter >= 32 && letter <= 126 { return letter }
            }
            code = key
        }
        if code.count == 4 && CanvasHasPrefix(code, "Key") {
            letter: s32 = cast(s32)code[3]
            if letter >= 65 && letter <= 90 { return letter }
        }
        if code.count == 7 && CanvasHasPrefix(code, "Numpad") {
            digit: s32 = cast(s32)code[6]
            if digit >= 48 && digit <= 57 { return digit }
        }
        index: s32 = 0
        while index < canvas_key_table_count {
            if canvas_key_table[index].name == code {
                return canvas_key_table[index].value
            }
            index += 1
        }
        return 0
    }

    // Keys that would scroll or navigate the page while the app has focus.
    CanvasKeyIsPageKey :: (key: s32) -> bool {
        return key == 32 || (key >= 256 && key <= 269)
    }

    // The one code point of `text`, or 0 when it holds none or several.
    CanvasSingleCodepoint :: (text: string) -> s32 {
        if text.count == 0 { return 0 }
        lead: s32 = cast(s32)text[0]
        length: s64 = 1
        codepoint: s32 = lead
        if lead >= 240 {
            length = 4
            codepoint = lead & 7
        } else if lead >= 224 {
            length = 3
            codepoint = lead & 15
        } else if lead >= 192 {
            length = 2
            codepoint = lead & 31
        }
        if cast(s64)text.count != length { return 0 }
        index: s64 = 1
        while index < length {
            codepoint = (codepoint << 6) | (cast(s32)text[index] & 63)
            index += 1
        }
        return codepoint
    }

    CanvasSetMouse :: (x: float64, y: float64) {
        canvas_mouse_delta_x += x - canvas_mouse_x
        canvas_mouse_delta_y += y - canvas_mouse_y
        canvas_mouse_x = x
        canvas_mouse_y = y
    }

    CanvasPointerX :: (x: float64) -> float64 {
        return (x - canvas_mouse_offset_x) * canvas_mouse_scale_x
    }

    CanvasPointerY :: (y: float64) -> float64 {
        return (y - canvas_mouse_offset_y) * canvas_mouse_scale_y
    }

    CanvasClipboardFill :: (text: string) {
        length: s64 = cast(s64)text.count
        if length >= cast(s64)CANVAS_CLIPBOARD_SIZE {
            length = cast(s64)CANVAS_CLIPBOARD_SIZE - 1
        }
        index: s64 = 0
        while index < length {
            canvas_clipboard_text[index] = text[index]
            index += 1
        }
        canvas_clipboard_text[length] = cast(u8)0
    }

    CanvasTouchEnd :: () -> s32 {
        had: bool = canvas_touch_count > 0
        canvas_touch_count = canvas_touch_pending
        if canvas_touch_count > 0 {
            CanvasSetMouse(canvas_touch_x[0], canvas_touch_y[0])
        }
        if !had && canvas_touch_count > 0 {
            canvas_buttons_down[0] = true
            CanvasQueuePush(*canvas_buttons_pressed[0],
                *canvas_buttons_pressed_count, 0)
        } else if had && canvas_touch_count == 0 {
            canvas_buttons_down[0] = false
            CanvasQueuePush(*canvas_buttons_released[0],
                *canvas_buttons_released_count, 0)
        }
        return CanvasEventPreventDefault
    }

    CanvasKeyDown :: (code: string, key: string, repeated: bool,
        shortcut: bool) -> s32 {
        mapped: s32 = CanvasKeyOf(code, key)
        if mapped <= 0 || mapped >= CANVAS_KEY_LIMIT { return 0 }
        flags: s32 = 0
        if canvas_keys_down[mapped] && repeated {
            CanvasQueuePush(*canvas_keys_repeated[0],
                *canvas_keys_repeated_count, mapped)
        } else if !canvas_keys_down[mapped] {
            CanvasQueuePush(*canvas_keys_pressed[0],
                *canvas_keys_pressed_count, mapped)
        }
        canvas_keys_down[mapped] = true
        if shortcut && (mapped == 65 || mapped == 67 || mapped == 86 ||
            mapped == 88) {
            // The browser only allows a clipboard write inside a gesture.
            canvas_clipboard_gesture_until = PageNow() + 1000.0
            flags |= CanvasEventPreventDefault
        }
        // Preventing Space's page scroll also suppresses DOM keypress.
        // Submit its character here so text fields retain typed spaces.
        if mapped == 32 && key == " " {
            CanvasQueuePush(*canvas_chars[0], *canvas_chars_count, 32)
        }
        if CanvasKeyIsPageKey(mapped) { flags |= CanvasEventPreventDefault }
        return flags
    }

    CanvasKeyUp :: (code: string, key: string) -> s32 {
        mapped: s32 = CanvasKeyOf(code, key)
        if mapped <= 0 || mapped >= CANVAS_KEY_LIMIT { return 0 }
        canvas_keys_down[mapped] = false
        CanvasQueuePush(*canvas_keys_released[0],
            *canvas_keys_released_count, mapped)
        if CanvasKeyIsPageKey(mapped) { return CanvasEventPreventDefault }
        return 0
    }

    // Receives every raw DOM event the page forwards. Returns what the page
    // should do with it, as CanvasEvent* flags.
    CanvasEvent :: (kind: s32, a: s32, b: s32, x: float64, y: float64,
        code: *u8, key: *u8) -> s32 {
        if kind == CanvasEventMouseMove {
            CanvasSetMouse(CanvasPointerX(x), CanvasPointerY(y))
            return 0
        }
        if kind == CanvasEventMouseDown {
            canvas_clipboard_gesture_until = PageNow() + 1000.0
            CanvasSetMouse(CanvasPointerX(x), CanvasPointerY(y))
            if a >= 0 && a < CANVAS_BUTTON_LIMIT {
                canvas_buttons_down[a] = true
                CanvasQueuePush(*canvas_buttons_pressed[0],
                    *canvas_buttons_pressed_count, a)
            }
            return CanvasEventFocusCanvas | CanvasEventCapturePointer
        }
        if kind == CanvasEventMouseUp {
            CanvasSetMouse(CanvasPointerX(x), CanvasPointerY(y))
            if a >= 0 && a < CANVAS_BUTTON_LIMIT {
                canvas_buttons_down[a] = false
                CanvasQueuePush(*canvas_buttons_released[0],
                    *canvas_buttons_released_count, a)
            }
            return 0
        }
        if kind == CanvasEventWheel {
            unit: float64 = 120.0
            if a == 1 { unit = 16.0 }
            if a == 2 { unit = cast(float64)PageDimension(1) }
            canvas_wheel_x += -x / unit
            canvas_wheel_y += -y / unit
            return CanvasEventPreventDefault
        }
        if kind == CanvasEventKeyDown {
            return CanvasKeyDown(TextFromCString(code), TextFromCString(key),
                a != 0, b != 0)
        }
        if kind == CanvasEventKeyUp {
            return CanvasKeyUp(TextFromCString(code), TextFromCString(key))
        }
        if kind == CanvasEventKeyChar {
            typed: s32 = CanvasSingleCodepoint(TextFromCString(key))
            if typed != 0 && typed != 32 {
                CanvasQueuePush(*canvas_chars[0], *canvas_chars_count, typed)
            }
            return 0
        }
        if kind == CanvasEventTouchBegin {
            if a > 0 { canvas_clipboard_gesture_until = PageNow() + 1000.0 }
            canvas_touch_pending = 0
            return 0
        }
        if kind == CanvasEventTouchPoint {
            if canvas_touch_pending < CANVAS_TOUCH_LIMIT {
                slot: s32 = canvas_touch_pending
                canvas_touch_id[slot] = a
                canvas_touch_x[slot] = CanvasPointerX(x)
                canvas_touch_y[slot] = CanvasPointerY(y)
                canvas_touch_pending += 1
            }
            return 0
        }
        if kind == CanvasEventTouchEnd { return CanvasTouchEnd() }
        if kind == CanvasEventFocus {
            canvas_focused = true
            return 0
        }
        if kind == CanvasEventBlur {
            canvas_focused = false
            index: s32 = 0
            while index < CANVAS_KEY_LIMIT {
                canvas_keys_down[index] = false
                index += 1
            }
            index = 0
            while index < CANVAS_BUTTON_LIMIT {
                canvas_buttons_down[index] = false
                index += 1
            }
            canvas_touch_count = 0
            return 0
        }
        if kind == CanvasEventPaste {
            text: string = TextFromCString(key)
            if text.count > 0 { CanvasClipboardFill(text) }
            return 0
        }
        if kind == CanvasEventCopy {
            if canvas_clipboard_text[0] == cast(u8)0 { return 0 }
            return CanvasEventClipboardWritten | CanvasEventPreventDefault
        }
        return 0
    }

    // Forget all earlier input.
    CanvasEventsReset :: () {
        index: s32 = 0
        while index < CANVAS_KEY_LIMIT {
            canvas_keys_down[index] = false
            index += 1
        }
        index = 0
        while index < CANVAS_BUTTON_LIMIT {
            canvas_buttons_down[index] = false
            index += 1
        }
        canvas_keys_pressed_count = 0
        canvas_keys_released_count = 0
        canvas_keys_repeated_count = 0
        canvas_chars_count = 0
        canvas_buttons_pressed_count = 0
        canvas_buttons_released_count = 0
        canvas_mouse_x = 0.0
        canvas_mouse_y = 0.0
        canvas_mouse_delta_x = 0.0
        canvas_mouse_delta_y = 0.0
        canvas_mouse_offset_x = 0.0
        canvas_mouse_offset_y = 0.0
        canvas_mouse_scale_x = 1.0
        canvas_mouse_scale_y = 1.0
        canvas_wheel_x = 0.0
        canvas_wheel_y = 0.0
        canvas_touch_count = 0
        canvas_touch_pending = 0
        canvas_focused = true
        canvas_cursor_hidden = false
        canvas_clipboard_gesture_until = 0.0
    }

    // Start with clean input.
    CanvasEventsOpen :: () {
        CanvasEventsReset()
    }

    // Called once per frame after the app has read its input.
    CanvasEventsEndFrame :: () {
        canvas_keys_pressed_count = 0
        canvas_keys_released_count = 0
        canvas_keys_repeated_count = 0
        canvas_buttons_pressed_count = 0
        canvas_buttons_released_count = 0
        canvas_mouse_delta_x = 0.0
        canvas_mouse_delta_y = 0.0
        canvas_wheel_x = 0.0
        canvas_wheel_y = 0.0
    }

    CanvasPageWidth :: () -> s32 {
        return PageDimension(0)
    }

    CanvasPageHeight :: () -> s32 {
        return PageDimension(1)
    }

    // One field of touch point `index`: 0 x, 1 y, 2 id; 0 when it is absent.
    CanvasTouchField :: (index: s32, field: s32) -> s32 {
        if index < 0 || index >= canvas_touch_count { return 0 }
        if field == 0 { return cast(s32)canvas_touch_x[index] }
        if field == 1 { return cast(s32)canvas_touch_y[index] }
        return canvas_touch_id[index]
    }

    // The wheel axis with the larger travel, as Raylib reports one wheel.
    CanvasWheelDominant :: () -> float64 {
        x: float64 = canvas_wheel_x
        y: float64 = canvas_wheel_y
        if x < 0.0 { x = -x }
        if y < 0.0 { y = -y }
        if x > y { return canvas_wheel_x }
        return canvas_wheel_y
    }
}
