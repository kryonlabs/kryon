using SemanticKind;
using WidgetKind;
using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ButtonState;
using StyleField;
using IconPlacement;

#program_export
NavigationBarDefaultFace :: (item: bool, active: bool,
    hovered: bool, disabled: bool) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
    cast(u32)StyleBorder | cast(u32)StyleBorderWidth |
    cast(u32)StyleRadius | cast(u32)StyleOpacity |
    cast(u32)StyleIconSize | cast(u32)StyleFontSize |
    cast(u32)StyleGap
    face.background = cast(u32)0xf1f5f9ff
    face.foreground = cast(u32)0x334155ff
    face.border = cast(u32)0xcbd5e1ff
    face.border_width = 1.0
    face.radius = 20.0
    face.opacity = 1.0
    face.icon_size = 32.0
    face.font_size = 12.0
    face.gap = 4.0
    if item {
        face.background = cast(u32)0x00000000
        face.border_width = 0.0
        face.radius = 29.0
        if active {
            face.background = cast(u32)0x2563ebff
            face.foreground = cast(u32)0xffffffff
        } else if hovered {
            face.background = cast(u32)0xe2e8f0ff
        }
        if disabled { face.opacity = 0.45 }
    }
    return face
}

#program_export
NavigationBarFaceFor :: (props: NavigationBarProps) -> StyleFrame {
    frame: StyleFrame
    frame.value = ResolveInstalledStyleRules(
        NavigationBarDefaultFace(false, false, false, false),
        StyleControlRoleFacts(StyleKindNavigationBar(),
        props.id, props.class_name, StyleAny(),
        cast(s32)ButtonToneNeutral,
        cast(s32)ButtonEmphasisSoft,
        cast(s32)ControlSizeMedium,
        cast(s32)ButtonStateNormal),
        cast(s32)ButtonStateNormal)
    return frame
}

#program_export
NavigationBarItemFaceFor :: (props: NavigationBarProps,
    item: NavigationBarItem, hovered: bool) -> StyleFrame {
    state: s32 = cast(s32)NavigationBarItemStateFor(item.active,
        item.disabled, hovered)
    tone: s32 = cast(s32)ButtonToneNeutral
    emphasis: s32 = cast(s32)ButtonEmphasisGhost
    if item.active {
        tone = cast(s32)ButtonToneAccent
        emphasis = cast(s32)ButtonEmphasisFilled
    }
    facts: StyleFacts = StyleControlRoleFacts(
        StyleKindNavigationBarItem(), props.id, props.class_name,
        StyleAny(), tone, emphasis,
        cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveInstalledStyleRules(
        NavigationBarDefaultFace(true, item.active, hovered,
        item.disabled), facts, state)
    return frame
}

#program_export
NavigationBarKey :: (session: Session, props: NavigationBarProps) -> u64 {
    if props.key != cast(u64)0 { return props.key }
    if props.id > 0 { return cast(u64)cast(u32)props.id }
    return TreeNextKey(session)
}

#program_export
NavigationBarItemKey :: (bar_key: u64, item: NavigationBarItem,
    index: s32) -> u64 {
    if item.key != cast(u64)0 { return item.key }
    return bar_key * cast(u64)131071 + cast(u64)cast(u32)(index + 1)
}

#program_export
NavigationBarPaintImage :: (session: Session, node: s32, image: ImageProps,
    bounds: Rectangle, clip: Rectangle, color: u32, opacity: float32) {
    if image.asset_path == "" && image.texture.id == cast(u32)0 { return }
    image.bounds = bounds
    texture: Texture2D = ImageTextureFor(image)
    if image.tint != cast(u32)0 {
        color = image.tint
    }
    plan: ImageDrawPlan = ImageDrawPlanFor(image, texture,
        ColorFromPacked(Opacity(color, opacity)))
    if plan.draw {
        PaintImage(session, node, image.asset_path, image.texture.id,
            plan.source, plan.destination, clip, image.origin,
            image.rotation, 0.0, plan.tint, image.texture)
    }
}

// The height NavigationBar will take for these props, so a caller can
// reserve the space before the bar is drawn.
#program_export
NavigationBarHeight :: (props: NavigationBarProps) -> s32 {
    if props.compact { return cast(s32)props.bounds.height }
    if props.height > 0 { return props.height }
    spec: NavigationBarSpec
    spec.view_width = props.view_width
    spec.view_height = props.view_height
    spec.count = 1
    spec.side_margin = -1
    spec.bottom_margin = -1
    spec.icon_size = -1
    spec.scale = props.scale
    spec.bar = NavigationBarFaceFor(props)
    return NavigationBarPaintFor(spec).height
}

DrawNavigationDockItem :: (session: Session, props: NavigationBarProps,
    bar_key: u64, item: NavigationBarItem, index: s32, bounds: Rectangle,
    draggable: bool, result: *NavigationBarResult) {
    button: ButtonProps
    button.key = NavigationBarItemKey(bar_key, item, index)
    button.id = props.id
    button.bounds = bounds
    button.label = item.label
    button.image = item.image
    button.icon_shape = item.icon_shape
    button.selected = item.active
    button.disabled = item.disabled
    button.class_name = props.item_class_name
    button.style_kind = StyleKindNavigationBarItem()
    button.emphasis = cast(ButtonEmphasis)ButtonEmphasisGhost
    if item.active {
        button.tone = cast(ButtonTone)ButtonToneAccent
        button.emphasis = cast(ButtonEmphasis)ButtonEmphasisFilled
    }
    button.icon_placement = cast(IconPlacement)IconPlacementAbove
    button.fit_content = props.fit_items
    previous := TreePrevious(session, TreeCurrentParent(session),
        button.key, WidgetKindButton)
    drag: PointerDrag
    if draggable && !item.disabled {
        drag = TreeTakeDragAt(session, previous)
        if drag.started || drag.active || drag.ended {
            result.drag = drag
            result.drag_route = item.route
            result.drag_bounds = bounds
        }
    }
    clicked := Button(session, button) != 0
    if draggable {
        node := TreeSubmitted(session, TreeCurrentParent(session),
            button.key, WidgetKindButton)
        TreeSetDragCapture(session, node, true)
        // Captured release outside the original item is a drop, not a click.
        clicked = clicked || (drag.ended && TreeHoveredAt(session, previous))
    }
    if clicked && !props.dragging && !item.disabled {
        result.clicked_index = index
        result.clicked_route = item.route
    }
}

DrawCompactNavigation :: (session: Session, props: NavigationBarProps,
    items: []NavigationBarItem, result: NavigationBarResult) -> NavigationBarResult {
    if props.bounds.width <= 0.0 || props.bounds.height <= 0.0 { return result }
    key := NavigationBarKey(session, props)
    layout := NavigationBarDockLayoutFor(props.bounds, props.vertical,
        cast(s32)items.count, props.footer_count, props.scale)
    if props.fit_items {
        layout = NavigationBarDockFitLayoutFor(props.bounds, props.vertical,
            cast(s32)items.count, props.footer_count, props.scale)
    }
    result.y = cast(s32)props.bounds.y
    result.height = cast(s32)props.bounds.height
    previous := TreePrevious(session, TreeCurrentParent(session), key,
        WidgetKindNavigationBar)
    reveal := previous < 0
    if previous >= 0 {
        old := TreeNodeAt(session, previous).bounds
        reveal = old.width != props.bounds.width || old.height != props.bounds.height
    }
    offset := props.scroll_offset
    old_scroll := TreePreviousCommitted(session, previous,
        key * cast(u64)65599 + cast(u64)1, WidgetKindScroll)
    for index: cast(s32)0..layout.primary_count - 1 {
        if items[index].active {
            old_item := TreePreviousCommitted(session, old_scroll,
                NavigationBarItemKey(key, items[index], index), WidgetKindButton)
            if reveal || old_item < 0 || !TreeNodeAt(session, old_item).selected {
                offset = NavigationBarDockRevealOffset(layout, index, offset)
            }
        }
    }
    result.node = TreeSubmitCurrent(session, key, WidgetKindNavigationBar, props.bounds)
    if result.node < 0 || !TreePushScope(session, result.node) { return result }
    bar := NavigationBarFaceFor(props)
    PaintRoundedFill(session, result.node, props.bounds, 0.0, 4,
        ColorFromPacked(Opacity(bar.value.background,
        StyleOpacityValue(bar.value.fields, bar.value.opacity))))
    content := layout.scroll_bounds
    if props.fit_items {
        result.scroll_offset = 0
        for index: cast(s32)0..layout.primary_count - 1 {
            bounds := NavigationBarDockItemBounds(layout, content, index)
            DrawNavigationDockItem(session, props, key, items[index],
                index, bounds, props.draggable, *result)
        }
    } else if layout.primary_count > 0 && layout.scroll_bounds.width > 0.0 &&
    layout.scroll_bounds.height > 0.0 {
        scroll: ScrollProps
        scroll.key = key * cast(u64)65599 + cast(u64)1
        scroll.bounds = layout.scroll_bounds
        scroll.scale = props.scale
        scroll.horizontal = !props.vertical
        scroll.scroll_offset = offset
        if props.vertical { scroll.content_height = layout.content_extent }
        else { scroll.content_width = layout.content_extent }
        scrolled := Scroll(session, scroll)
        result.scroll_offset = scrolled.scroll_offset
        content = scrolled.content
        if scrolled.opened {
            for index: cast(s32)0..layout.primary_count - 1 {
                bounds := NavigationBarDockItemBounds(layout, content, index)
                DrawNavigationDockItem(session, props, key, items[index],
                    index, bounds, props.draggable, *result)
            }
            unused TreePopScope(session)
        }
    }
    for index: cast(s32)0..layout.footer_count - 1 {
        bounds := NavigationBarDockItemBounds(layout, layout.footer_bounds, index)
        if !layout.vertical && !props.fit_items {
            step := layout.footer_bounds.width / cast(float32)layout.footer_count
            bounds.x = layout.footer_bounds.x + cast(float32)index * step
            width := step - 8.0 * props.scale
            if props.scale <= 0.0 { width = step - 8.0 }
            if width < bounds.width { bounds.width = width }
        }
        DrawNavigationDockItem(session, props, key, items[layout.primary_count + index],
            layout.primary_count + index, bounds, false, *result)
    }
    if props.dragging {
        result.drop_index = NavigationBarDockDropIndex(layout, content, props.drag_position)
        if result.drop_index >= 0 {
            bounds := NavigationBarDockItemBounds(layout, content, result.drop_index)
            bounds = RectangleIntersection(bounds, layout.scroll_bounds)
            if bounds.width > 0.0 && bounds.height > 0.0 {
                PaintRoundedOutline(session, result.node, bounds, 12.0, 12, 2.0,
                    ColorFromPacked(bar.value.foreground))
            }
        }
    }
    unused TreePopScope(session)
    return result
}

// Items are borrowed values. Each item owns a stable key when routes can
// move. The result reports the activated route; the caller applies routing.
#program_export
NavigationBar :: (session: Session, props: NavigationBarProps,
    items: []NavigationBarItem) -> NavigationBarResult {
    result: NavigationBarResult
    result.node = -1
    result.clicked_index = -1
    result.clicked_route = -1
    result.drop_index = -1
    result.drag_route = -1
    if props.compact { return DrawCompactNavigation(session, props, items, result) }
    if (cast(s32)items.count) <= 0 || props.view_width <= 0 ||
    props.view_height <= 0 { return result }
    key: u64 = NavigationBarKey(session, props)
    bar: StyleFrame = NavigationBarFaceFor(props)
    base_item: NavigationBarItem
    item_face: StyleFrame = NavigationBarItemFaceFor(props,
        base_item, false)
    spec: NavigationBarSpec
    spec.view_width = props.view_width
    spec.view_height = props.view_height
    spec.count = (cast(s32)items.count)
    spec.height = props.height
    spec.side_margin = -1
    spec.bottom_margin = -1
    spec.icon_size = -1
    spec.scale = props.scale
    spec.bar = bar
    spec.item = item_face
    paint: NavigationBarPaint = NavigationBarPaintFor(spec)
    result.y = paint.y
    result.height = paint.height
    if TreeIsBuilding(session) {
        result.node = TreeSubmitCurrent(session, key,
            WidgetKindNavigationBar, paint.bounds)
        if result.node < 0 { return result }
        submitted: Rectangle = TreeSubmittedNodeAt(session, result.node).bounds
        dx: float32 = submitted.x - paint.bounds.x
        dy: float32 = submitted.y - paint.bounds.y
        paint.bounds = submitted
        paint.bar_bounds.x += dx
        paint.bar_bounds.y += dy
        paint.start_x += cast(s32)dx
        paint.y += cast(s32)dy
        result.y = paint.y
    }
    opacity: float32 = StyleOpacityValue(bar.value.fields,
        bar.value.opacity)
    PaintRoundedFill(session, result.node, paint.bar_bounds,
        bar.value.radius, 12,
        ColorFromPacked(Opacity(bar.value.background, opacity)))
    if bar.value.border_width > 0.0 {
        PaintRoundedOutline(session, result.node, paint.bar_bounds,
            bar.value.radius, 12, bar.value.border_width,
            ColorFromPacked(Opacity(bar.value.border, opacity)))
    }
    index: s32 = 0
    while index < paint.count {
        item: NavigationBarItem = items[index]
        item_key: u64 = NavigationBarItemKey(key, item, index)
        previous: s32 = -1
        if TreeIsBuilding(session) {
            previous = TreePrevious(session, result.node, item_key,
                WidgetKindButton)
        }
        if !item.disabled && TreeTakeActivationAt(session, previous) {
            result.clicked_index = index
            result.clicked_route = item.route
        }
        hovered: bool = TreeHoveredAt(session, previous) && !item.disabled
        face: StyleFrame = NavigationBarItemFaceFor(props,
            item, hovered)
        base: StyleFrame = NavigationBarItemFaceFor(props,
            base_item, false)
        font: s32 = ResolveFont(0,
            StyleFontValue(face.value.fields,
            face.value.font_size), 12)
        line_height: s32 = GlyphLineHeight(font,
            face.value.typeface)
        item_spec: NavigationBarItemSpec
        item_spec.bar = paint
        item_spec.index = index
        item_spec.active = item.active
        item_spec.disabled = item.disabled
        item_spec.hovered = hovered
        item_spec.label_height = line_height
        item_spec.base = base
        item_spec.face = face
        layout: NavigationBarItemPaint =
        NavigationBarItemPaintFor(item_spec)
        node: s32 = -1
        if TreeIsBuilding(session) {
            node = TreeSubmit(session, item_key, result.node,
                WidgetKindButton, layout.bounds)
            if node < 0 { return result }
            TreeSetInteractive(session, node, item.disabled, false, 0)
            TreeSetSemantic(session, node,
                cast(SemanticKind)SemanticButton, 0)
            TreeSetLabel(session, node, item.label)
            TreeSetSelected(session, node, item.active)
        }
        if layout.draw_face {
            face_opacity: float32 = StyleOpacityValue(
                layout.face.value.fields,
                layout.face.value.opacity)
            PaintRoundedFill(session, node, layout.state_bounds,
                layout.face.value.radius, 12,
                ColorFromPacked(Opacity(
                layout.face.value.background, face_opacity)))
        }
        image_opacity: float32 = cast(float32)layout.icon_alpha / 255.0
        NavigationBarPaintImage(session, node, item.image,
            layout.icon_bounds, layout.bounds, layout.icon_color,
            image_opacity)
        if item.label != "" {
            label_width: s32 = GlyphWidth(item.label, font,
                face.value.typeface)
            label_x: s32 = cast(s32)layout.label_bounds.x +
            (cast(s32)layout.label_bounds.width - label_width) / 2
            text_opacity: float32 = StyleOpacityValue(
                base.value.fields, base.value.opacity)
            PaintClippedLabel(session, node, item.label,
                label_x,
                cast(s32)layout.label_bounds.y, font,
                ColorFromPacked(Opacity(
                layout.text_color, text_opacity)),
                layout.label_bounds)
        }
        index += 1
    }
    return result
}
