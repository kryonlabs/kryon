#import "control_props"
#import "geometry"
Theme :: #import "theme";

using ElevationRole;

// Fixed contact strips under the straight part of a rounded surface. Drawing
// only these pixels avoids rasterizing a full translucent rounded outline.
#program_export
ElevationEdgeBounds :: (bounds: Rectangle, layer: s32,
    radius: float32 = 0.0) -> Rectangle {
    result: Rectangle
    if layer < 1 || layer > 2 || bounds.width <= 0.0 || bounds.height <= 0.0 { return result }
    if radius < 0.0 { radius = 0.0 }
    if radius > bounds.width * 0.5 { radius = bounds.width * 0.5 }
    result.x = bounds.x + radius
    result.y = bounds.y + bounds.height + cast(float32)(layer - 1)
    result.width = bounds.width - radius * 2.0
    result.height = 1.0
    return result
}

#program_export
ElevationEdgeAlpha :: (layer: s32) -> u32 {
    if layer == 1 { return cast(u32)24 }
    if layer == 2 { return cast(u32)10 }
    return cast(u32)0
}

#program_export
ElevationAlphaForRole :: (role: ElevationRole, layer: s32) -> u32 {
    shadows := Theme.CurrentTheme().shadows
    opacity: float32 = 0.0
    if role == .ElevationRoleRest && layer == 1 { opacity = shadows.rest.opacity }
    if role == .ElevationRoleRaised {
        if layer == 1 { opacity = shadows.raised[0].opacity }
        if layer == 2 { opacity = shadows.raised[1].opacity }
    }
    if role == .ElevationRoleFloating {
        if layer == 1 { opacity = shadows.floating[0].opacity }
        if layer == 2 { opacity = shadows.floating[1].opacity }
    }
    if opacity < 0.0 { opacity = 0.0 }
    if opacity > 1.0 { opacity = 1.0 }
    return cast(u32)(opacity * 255.0 + 0.5)
}
