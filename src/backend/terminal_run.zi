#import "byte_text_linux"
#import "session"
#import "app"
#import "geometry"
#import "terminal"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "utf8"

using FrameStatus;

libc :: #system_library "libc";
RunRead :: (fd: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
RunWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";
RunIsTty :: (fd: s32) -> s32 #foreign libc "isatty";
RunGetAttributes :: (fd: s32, output: *u8) -> s32 #foreign libc "tcgetattr";
RunSetAttributes :: (fd: s32, action: s32, input: *u8) -> s32 #foreign libc "tcsetattr";
RunMakeRaw :: (input: *u8) -> void #foreign libc "cfmakeraw";
TerminalPollDescriptor :: struct {
    fd: s32
    events: s16
    revents: s16
}
RunPoll :: (fds: *TerminalPollDescriptor, count: u64,
    timeout_ms: s32) -> s32 #foreign libc "poll";

TerminalState :: struct {
    active: bool
    original: [128]u8
}

WriteControl :: (value: string) -> bool {
    bytes: [64]u8
    if value.count > 64 { return false }
    at: s32 = 0
    while at < cast(s32)value.count {
        bytes[at] = value[at]
        at += 1
    }
    at = 0
    while at < cast(s32)value.count {
        written: s64 = RunWrite(1, *bytes[at], cast(u64)(cast(s32)value.count - at))
        if written <= 0 { return false }
        at += cast(s32)written
    }
    return true
}

EnterTerminal :: (state: *TerminalState) -> bool {
    if RunGetAttributes(0, *state.original[0]) != 0 { return false }
    raw: [128]u8
    at: s32 = 0
    while at < 128 {
        raw[at] = state.original[at]
        at += 1
    }
    RunMakeRaw(*raw[0])
    if RunSetAttributes(0, 0, *raw[0]) != 0 { return false }
    state.active = true
    if !WriteControl("\x1b[?1049h\x1b[?25l\x1b[2J\x1b[H") {
        WriteControl("\x1b[?25h\x1b[?1049l")
        RunSetAttributes(0, 0, *state.original[0])
        state.active = false
        return false
    }
    return true
}

LeaveTerminal :: (state: *TerminalState) {
    if !state.active { return }
    WriteControl("\x1b[?25h\x1b[?1049l")
    RunSetAttributes(0, 0, *state.original[0])
    state.active = false
}

// The application supplies Frame(session, viewport). The Kryon host owns
// entry, screen storage, rendering effects, and presentation.
RenderFrame :: (session: Session, viewport: Rectangle, interactive: bool) -> s32 {
    TerminalBegin(80, 24)
    if BeginFrame(session, cast(u64)1, viewport) !=
        cast(FrameStatus)FrameOk {
        return 1
    }
    result: s32 = Frame(session, viewport)
    if result != 0 {
        TreeCancel(session)
        return result
    }
    if EndFrame(session) != cast(FrameStatus)FrameOk { result = 1 }
    if result == 0 && interactive && !WriteControl("\x1b[2J\x1b[H") {
        result = 1
    }
    if result == 0 && !TerminalPresent() { result = 1 }
    return result
}

#program_export
main :: () -> s32 {
    session: Session = SessionOpen()
    if !SessionValid(session) { return 1 }
    viewport: Rectangle = Rectangle.{0.0, 0.0, 80.0, 24.0}
    interactive: bool = RunIsTty(0) == 1 && RunIsTty(1) == 1
    state: TerminalState
    if interactive && !EnterTerminal(*state) {
        CloseSession(session)
        return 1
    }
    result: s32 = RenderFrame(session, viewport, interactive)
    if interactive {
        input: TerminalPollDescriptor
        input.fd = 0
        input.events = 1
        pending: [4]u8
        pending_count: s32 = 0
        pending_needed: s32 = 0
        escape_stage: s32 = 0
        while result == 0 && !TerminalQuitRequested() {
            ready: s32 = RunPoll(*input, 1, 30000)
            if ready < 0 {
                result = 1
                break
            }
            if ready == 0 {
                result = RenderFrame(session, viewport, true)
                continue
            }
            key: u8 = 0
            count: s64 = RunRead(0, *key, 1)
            if count == 0 { break }
            if count < 0 {
                result = 1
                break
            }
            if key == cast(u8)3 { break }
            if key == cast(u8)27 {
                escape_stage = 1
                pending_count = 0
                pending_needed = 0
                continue
            }
            if escape_stage == 1 {
                escape_stage = 0
                if key == cast(u8)91 {
                    escape_stage = 2
                    continue
                }
            } else if escape_stage == 2 {
                if key >= cast(u8)64 && key <= cast(u8)126 {
                    escape_stage = 0
                }
                continue
            }
            if pending_needed > 0 {
                if key >= cast(u8)128 && key <= cast(u8)191 {
                    pending[pending_count] = key
                    pending_count += 1
                    if pending_count < pending_needed { continue }
                    value: string = TextFromBytes(pending[0:pending_count])
                    decoded: Decoded = Decode(value, 0)
                    KeyboardSend(session, cast(s32)decoded.value)
                    TypedCodepointSend(session, cast(s32)decoded.value)
                    pending_count = 0
                    pending_needed = 0
                    result = RenderFrame(session, viewport, true)
                    continue
                }
                KeyboardSend(session, 65533)
                TypedCodepointSend(session, 65533)
                pending_count = 0
                pending_needed = 0
            }
            if key < cast(u8)128 {
                KeyboardSend(session, cast(s32)key)
                if key >= cast(u8)32 && key != cast(u8)127 {
                    TypedCodepointSend(session, cast(s32)key)
                }
                result = RenderFrame(session, viewport, true)
                continue
            }
            pending_needed = 0
            if key >= cast(u8)194 && key <= cast(u8)223 {
                pending_needed = 2
            } else if key >= cast(u8)224 && key <= cast(u8)239 {
                pending_needed = 3
            } else if key >= cast(u8)240 && key <= cast(u8)244 {
                pending_needed = 4
            }
            if pending_needed > 0 {
                pending[0] = key
                pending_count = 1
            } else {
                KeyboardSend(session, 65533)
                TypedCodepointSend(session, 65533)
                result = RenderFrame(session, viewport, true)
            }
        }
        LeaveTerminal(*state)
    }
    CloseSession(session)
    return result
}
