        for byte, at: name { bytes[at] = ifx byte == #char "/" then #char "." else byte }
        return NObject(env, loader, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;", NRef(NString(env, TextView(bytes[:name.count]))))
    }
    PStatic :: (env: *JniEnv, context: *void, name: string, method_name: string, signature: string,
        a: JniValue = .{}, b: JniValue = .{}, c: JniValue = .{}, d: JniValue = .{}, void_result: bool = false) -> *void {
