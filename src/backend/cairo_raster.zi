#import "c_string"
#import "drawing_props"
#import "geometry"

libdl :: #system_library "dl";
RasterLookup :: (handle: *void, symbol: *u8) -> *void #foreign libdl "dlsym";

RasterGetEnvironment :: (name: *u8) -> *u8 {
    symbol: [16]u8
    if !CopyCString("environ", symbol[:]) { return null }
    slot: *void = RasterLookup(null, *symbol[0])
    if slot == null { return null }
    environment_ref: ***u8 = cast(***u8)slot
    entries: **u8 = environment_ref.*
    if entries == null { return null }
    index: s32 = 0
    while entries[index] != null {
        entry: *u8 = entries[index]
        at: s32 = 0
        while entry[at] != cast(u8)0 && name[at] != cast(u8)0 &&
            entry[at] == name[at] { at += 1 }
        if name[at] == cast(u8)0 && entry[at] == cast(u8)61 {
            return *entry[at + 1]
        }
        index += 1
    }
    return null
}

cairo_library :: #system_library "cairo";
freetype_library :: #system_library "freetype";

FreeTypeInit :: (library: **void) -> s32 #foreign freetype_library "FT_Init_FreeType";
FreeTypeNewFace :: (library: *void, path: *u8, index: s64,
    face: **void) -> s32 #foreign freetype_library "FT_New_Face";
FontFaceFromFreeType :: (face: *void, flags: s32) -> *void #foreign cairo_library "cairo_ft_font_face_create_for_ft_face";
SetFontFace :: (paint: *void, face: *void) #foreign cairo_library "cairo_set_font_face";
FontOptionsCreate :: () -> *void #foreign cairo_library "cairo_font_options_create";
FontOptionsDestroy :: (options: *void) #foreign cairo_library "cairo_font_options_destroy";
FontOptionsSetAntialias :: (options: *void, antialias: s32) #foreign cairo_library "cairo_font_options_set_antialias";
FontOptionsSetHintStyle :: (options: *void, style: s32) #foreign cairo_library "cairo_font_options_set_hint_style";
FontOptionsSetHintMetrics :: (options: *void, metrics: s32) #foreign cairo_library "cairo_font_options_set_hint_metrics";
SetFontOptions :: (paint: *void, options: *void) #foreign cairo_library "cairo_set_font_options";

ImageSurfaceCreate :: (format: s32, width: s32, height: s32) -> *void #foreign cairo_library "cairo_image_surface_create";
ImageSurfaceFromPNG :: (path: *u8) -> *void #foreign cairo_library "cairo_image_surface_create_from_png";
ImageSurfaceWidth :: (surface: *void) -> s32 #foreign cairo_library "cairo_image_surface_get_width";
ImageSurfaceHeight :: (surface: *void) -> s32 #foreign cairo_library "cairo_image_surface_get_height";
ImageSurfaceData :: (surface: *void) -> *u8 #foreign cairo_library "cairo_image_surface_get_data";
ImageSurfaceStride :: (surface: *void) -> s32 #foreign cairo_library "cairo_image_surface_get_stride";
SurfaceStatus :: (surface: *void) -> s32 #foreign cairo_library "cairo_surface_status";
SurfaceFlush :: (surface: *void) #foreign cairo_library "cairo_surface_flush";
SurfaceMarkDirty :: (surface: *void) #foreign cairo_library "cairo_surface_mark_dirty";
SurfaceWritePNG :: (surface: *void, path: *u8) -> s32 #foreign cairo_library "cairo_surface_write_to_png";
SurfaceDestroy :: (surface: *void) #foreign cairo_library "cairo_surface_destroy";
Create :: (surface: *void) -> *void #foreign cairo_library "cairo_create";
Destroy :: (paint: *void) #foreign cairo_library "cairo_destroy";
Status :: (paint: *void) -> s32 #foreign cairo_library "cairo_status";
Save :: (paint: *void) #foreign cairo_library "cairo_save";
Restore :: (paint: *void) #foreign cairo_library "cairo_restore";
SetSourceRGBA :: (paint: *void, red: float64, green: float64,
    blue: float64, alpha: float64) #foreign cairo_library "cairo_set_source_rgba";
SetSourceSurface :: (paint: *void, surface: *void, x: float64,
    y: float64) #foreign cairo_library "cairo_set_source_surface";
GetSource :: (paint: *void) -> *void #foreign cairo_library "cairo_get_source";
PatternExtend :: (pattern: *void, extend: s32) #foreign cairo_library "cairo_pattern_set_extend";
PatternFilter :: (pattern: *void, filter: s32) #foreign cairo_library "cairo_pattern_set_filter";
Paint :: (paint: *void) #foreign cairo_library "cairo_paint";
MaskSurface :: (paint: *void, surface: *void, x: float64,
    y: float64) #foreign cairo_library "cairo_mask_surface";
NewPath :: (paint: *void) #foreign cairo_library "cairo_new_path";
CanvasRectangle :: (paint: *void, x: float64, y: float64,
    width: float64, height: float64) #foreign cairo_library "cairo_rectangle";
Arc :: (paint: *void, x: float64, y: float64, radius: float64,
    angle1: float64, angle2: float64) #foreign cairo_library "cairo_arc";
ClosePath :: (paint: *void) #foreign cairo_library "cairo_close_path";
Fill :: (paint: *void) #foreign cairo_library "cairo_fill";
Stroke :: (paint: *void) #foreign cairo_library "cairo_stroke";
Clip :: (paint: *void) #foreign cairo_library "cairo_clip";
MoveTo :: (paint: *void, x: float64, y: float64) #foreign cairo_library "cairo_move_to";
LineTo :: (paint: *void, x: float64, y: float64) #foreign cairo_library "cairo_line_to";
SetLineWidth :: (paint: *void, width: float64) #foreign cairo_library "cairo_set_line_width";
SelectFontFace :: (paint: *void, family: *u8, slant: s32, weight: s32) #foreign cairo_library "cairo_select_font_face";
SetFontSize :: (paint: *void, size: float64) #foreign cairo_library "cairo_set_font_size";
FontExtents :: struct {
    ascent: float64
    descent: float64
    height: float64
    max_x_advance: float64
    max_y_advance: float64
}
TextExtents :: struct {
    x_bearing: float64
    y_bearing: float64
    width: float64
    height: float64
    x_advance: float64
    y_advance: float64
}
FontExtentsOf :: (paint: *void, extents: *FontExtents) #foreign cairo_library "cairo_font_extents";
TextExtentsOf :: (paint: *void, value: *u8, extents: *TextExtents) #foreign cairo_library "cairo_text_extents";
ShowText :: (paint: *void, value: *u8) #foreign cairo_library "cairo_show_text";
Translate :: (paint: *void, x: float64, y: float64) #foreign cairo_library "cairo_translate";
Rotate :: (paint: *void, radians: float64) #foreign cairo_library "cairo_rotate";
Scale :: (paint: *void, x: float64, y: float64) #foreign cairo_library "cairo_scale";

surface: *void;
paint: *void;
image_error: bool;
Decode :: #import "image_decode_linux";
CachedImage :: struct { path: [4096]u8; length: s32; image: *void; used: u64; bytes: s64; }
cached_images: [128]CachedImage;
image_clock: u64;
image_bytes: s64;

SetColor :: (color: Color) {
    SetSourceRGBA(paint, cast(float64)color.r / 255.0,
        cast(float64)color.g / 255.0, cast(float64)color.b / 255.0,
        cast(float64)color.a / 255.0)
}

RoundBox :: (bounds: Rectangle, requested_radius: float32) {
    x: float64 = bounds.x
    y: float64 = bounds.y
    width: float64 = bounds.width
    height: float64 = bounds.height
    radius: float64 = requested_radius
    NewPath(paint)
    if width <= 0.0 || height <= 0.0 { return }
    if radius < 0.0 { radius = 0.0 }
    if radius > width / 2.0 { radius = width / 2.0 }
    if radius > height / 2.0 { radius = height / 2.0 }
    if radius == 0.0 {
        CanvasRectangle(paint, x, y, width, height)
        return
    }
    half_pi: float64 = 1.5707963267948966
    Arc(paint, x + width - radius, y + radius, radius, -half_pi, 0.0)
    Arc(paint, x + width - radius, y + height - radius, radius,
        0.0, half_pi)
    Arc(paint, x + radius, y + height - radius, radius,
        half_pi, 2.0 * half_pi)
    Arc(paint, x + radius, y + radius, radius,
        2.0 * half_pi, 3.0 * half_pi)
    ClosePath(paint)
}

font_library: *void;
font_face: *void;

// Kryon's font, Liberation Sans, as the raylib, canvas, and pixmap hosts use:
// the file KRYON_FONT_PATH names, else the system's copy, else whatever
// fontconfig finds by that name. Glyphs are placed at their unhinted widths
// and smoothed in gray, as a browser lays text out, so every host measures a
// string alike.
UseKryonFont :: () {
    path: *u8 = null
    key: [32]u8
    if CopyCString("KRYON_FONT_PATH", key[:]) { path = RasterGetEnvironment(*key[0]) }
    system: [128]u8
    if path == null && CopyCString("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
        system[:]) {
        path = *system[0]
    }
    if font_face == null && path != null {
        if font_library != null || FreeTypeInit(*font_library) == 0 {
            face: *void = null
            if FreeTypeNewFace(font_library, path, 0, *face) == 0 && face != null {
                font_face = FontFaceFromFreeType(face, 0)
            }
        }
    }
    if font_face != null {
        SetFontFace(paint, font_face)
    } else {
        family: [32]u8
        if CopyCString("Liberation Sans", family[:]) {
            SelectFontFace(paint, *family[0], 0, 0)
        }
    }
    options: *void = FontOptionsCreate()
    if options == null { return }
    // Gray anti-aliasing, no hinting, unhinted metrics.
    FontOptionsSetAntialias(options, 2)
    FontOptionsSetHintStyle(options, 1)
    FontOptionsSetHintMetrics(options, 1)
    SetFontOptions(paint, options)
    FontOptionsDestroy(options)
}

#program_export
OpenRaster :: (width: s32, height: s32) -> bool {
    surface = ImageSurfaceCreate(0, width, height)
    if surface == null || SurfaceStatus(surface) != 0 { return false }
    paint = Create(surface)
    if paint == null || Status(paint) != 0 { return false }
    UseKryonFont()
    return Status(paint) == 0
}

#program_export
CloseRaster :: () {
    for i: 0..127 {
        if cached_images[i].image != null { SurfaceDestroy(cached_images[i].image) }
        cached_images[i] = .{}
    }
    image_bytes = 0
    if paint != null { Destroy(paint) }
    if surface != null { SurfaceDestroy(surface) }
    paint = null
    surface = null
}

#program_export
BeginRasterFrame :: () {
    Save(paint)
    SetSourceRGBA(paint, 248.0 / 255.0, 250.0 / 255.0,
        252.0 / 255.0, 1.0)
    Paint(paint)
    Restore(paint)
    image_error = false
}

#program_export
FinishRasterFrame :: () -> bool {
    if image_error || Status(paint) != 0 { return false }
    SurfaceFlush(surface)
    return SurfaceStatus(surface) == 0
}

#program_export
RasterSurfaceData :: () -> *u8 { return ImageSurfaceData(surface) }

#program_export
RasterSurfaceStride :: () -> s32 { return ImageSurfaceStride(surface) }

#program_export
CaptureRequested :: () -> bool {
    key: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", key[:]) { return false }
    return RasterGetEnvironment(*key[0]) != null
}

#program_export
CaptureConfigured :: () -> bool {
    key: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", key[:]) { return false }
    path: *u8 = RasterGetEnvironment(*key[0])
    if path == null { return false }
    return SurfaceWritePNG(surface, path) == 0
}

// Kryon's line box is `font` pixels from the top of the ascent to the bottom
// of the descent, as the raylib and canvas hosts lay text out, while Cairo
// sizes a font by its em. Selects the size whose ascent and descent fill the
// line box and returns the baseline's offset from the top of the box.
SelectLineFont :: (font: s32) -> float64 {
    SetFontSize(paint, cast(float64)font)
    extents: FontExtents
    FontExtentsOf(paint, *extents)
    total: float64 = extents.ascent + extents.descent
    if total <= 0.0 { return cast(float64)font }
    scale: float64 = cast(float64)font / total
    SetFontSize(paint, cast(float64)font * scale)
    return extents.ascent * scale
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    bytes: [1024]u8
    if paint == null || !CopyCString(value, bytes[:]) {
        return (cast(s32)value.count * font * 3) / 5
    }
    unused SelectLineFont(font)
    extents: TextExtents
    TextExtentsOf(paint, *bytes[0], *extents)
    return cast(s32)(extents.x_advance + 0.5)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return font
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    RoundBox(bounds, radius)
    SetColor(color)
    Fill(paint)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    RoundBox(bounds, radius)
    SetColor(color)
    SetLineWidth(paint, width)
    Stroke(paint)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    MoveTo(paint, line.x, line.y)
    LineTo(paint, (line.x + line.width),
        (line.y + line.height))
    SetColor(color)
    SetLineWidth(paint, 1.0)
    Stroke(paint)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    bytes: [1024]u8
    if !CopyCString(value, bytes[:]) { return }
    baseline: float64 = SelectLineFont(font)
    MoveTo(paint, cast(float64)x, cast(float64)y + baseline)
    SetColor(color)
    ShowText(paint, *bytes[0])
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    Save(paint)
    CanvasRectangle(paint, clip.x, clip.y,
        clip.width, clip.height)
    Clip(paint)
    RasterText(value, x, y, font, color)
    Restore(paint)
}

LoadPNG :: (asset_path: string) -> *void {
    length: s32 = cast(s32)asset_path.count
    if length == 0 || length >= 4096 { return null }
    image_clock += 1
    for i: 0..127 {
        same := cached_images[i].image != null && cached_images[i].length == length
        for byte: 0..length - 1 { if cached_images[i].path[byte] != asset_path[byte] { same = false; break } }
        if same { cached_images[i].used = image_clock; return cached_images[i].image }
    }
    path: [4096]u8
    if !CopyCString(asset_path, path[:]) { return null }
    image: *void
    decoded := Decode.OpenImage(*path[0])
    if decoded != null {
        image = ImageSurfaceCreate(0, Decode.Width(decoded), Decode.Height(decoded))
        if image == null || SurfaceStatus(image) != 0 ||
            !Decode.CopyPixels(decoded, ImageSurfaceData(image), ImageSurfaceStride(image)) {
            if image != null { SurfaceDestroy(image) }
            image = null
        }
        Decode.CloseImage(decoded)
        if image != null { SurfaceMarkDirty(image) }
    } else {
        image = ImageSurfaceFromPNG(*path[0])
    }
    if image == null { return null }
    if SurfaceStatus(image) != 0 {
        SurfaceDestroy(image)
        return null
    }
    bytes := cast(s64)ImageSurfaceStride(image) * cast(s64)ImageSurfaceHeight(image)
    slot: s32 = -1
    while slot < 0 || image_bytes + bytes > 268435456 {
        oldest: s32 = -1
        for i: 0..127 {
            if cached_images[i].image == null { if slot < 0 { slot = cast(s32)i }; continue }
            if oldest < 0 || cached_images[i].used < cached_images[oldest].used { oldest = cast(s32)i }
        }
        if slot >= 0 && image_bytes + bytes <= 268435456 { break }
        if oldest < 0 { SurfaceDestroy(image); return null }
        image_bytes -= cached_images[oldest].bytes
        SurfaceDestroy(cached_images[oldest].image); cached_images[oldest] = .{}
        if slot < 0 { slot = oldest }
    }
    cached_images[slot].path = path; cached_images[slot].length = length
    cached_images[slot].image = image; cached_images[slot].used = image_clock; cached_images[slot].bytes = bytes
    image_bytes += bytes
    return image
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    image: *void = LoadPNG(asset_path)
    if image == null { return 0 }
    return ImageSurfaceWidth(image)
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    image: *void = LoadPNG(asset_path)
    if image == null { return 0 }
    return ImageSurfaceHeight(image)
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    if texture_id != cast(u32)0 || asset_path.count == 0 ||
        source.width <= 0.0 || source.height <= 0.0 ||
        destination.width <= 0.0 || destination.height <= 0.0 ||
        clip.width <= 0.0 || clip.height <= 0.0 {
        image_error = true
        return
    }
    image: *void = LoadPNG(asset_path)
    if image == null {
        image_error = true
        return
    }
    Save(paint)
    RoundBox(clip, radius)
    Clip(paint)
    Translate(paint, destination.x,
        destination.y)
    Rotate(paint, cast(float64)rotation *
        3.14159265358979323846 / 180.0)
    Translate(paint, -cast(float64)origin.x,
        -cast(float64)origin.y)
    CanvasRectangle(paint, 0.0, 0.0,
        destination.width,
        destination.height)
    Clip(paint)
    Scale(paint, cast(float64)destination.width /
        cast(float64)source.width,
        cast(float64)destination.height / cast(float64)source.height)
    Translate(paint, -cast(float64)source.x, -cast(float64)source.y)
    if tint.r == cast(u8)255 && tint.g == cast(u8)255 &&
        tint.b == cast(u8)255 && tint.a == cast(u8)255 {
        SetSourceSurface(paint, image, 0.0, 0.0)
        Paint(paint)
    } else {
        SetColor(tint)
        MaskSurface(paint, image, 0.0, 0.0)
    }
    Restore(paint)
}
