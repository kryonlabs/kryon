// GPU drawing for the application's shapes, gradients, transforms, and
// clips. The operations mirror native's 2D drawing; each turns into a batch
// the WebGL2 presenter shades, with the transform baked per vertex so a
// camera change cannot split a batch.
#import "geometry"
#import "drawing_props"
#import "page_core"
#import "drawing_props"
#import "page_gpu"
#import "web"

PAGE_TAU :: 6.28318530718
PAGE_PI :: 3.14159265359

PageOpClear :: 0
PageOpFillRect :: 1
PageOpStrokeRect :: 2
PageOpFillCircle :: 3
PageOpStrokeCircle :: 4
PageOpLine :: 5
PageOpThickLine :: 6
PageOpTriangle :: 7
PageOpScissorBegin :: 9
PageOpScissorEnd :: 10
PageOpCameraPush :: 11
PageOpCameraPop :: 12
PageOpFrameReset :: 13

PageGpuColor :: (r: s32, g: s32, b: s32, a: s32) -> Color {
    return Color.{cast(u8)r, cast(u8)g, cast(u8)b, cast(u8)a}
}

// Whether the presenter's transform is axis aligned: scaled and moved, but
// not turned or skewed.
PageGpuUpright :: (m: [6]float64) -> bool {
    return m[1] == 0.0 && m[2] == 0.0 && m[0] > 0.0 && m[3] > 0.0
}

// The camera the 2D hosts applied to their context, tracked as the
// presenter's logical-to-device matrix.
PageApplyCamera :: () {
    if !page_mode.active { return }
    PageGpuMatrixTranslate(page_mode.offset_x, page_mode.offset_y)
    PageGpuMatrixRotate(page_mode.rotation)
    PageGpuMatrixScale2(page_mode.zoom_x, page_mode.zoom_y)
    PageGpuMatrixTranslate(0.0 - page_mode.target_x, 0.0 - page_mode.target_y)
}

PageResetTransform :: () {
    PageGpuMatrixReset()
}

// Fill a rectangle with its edges snapped to exact device pixels while the
// transform is axis aligned, like the 2D host's aligned fills.
PageRoundedTransformFill :: (x: float64, y: float64, width: float64,
    height: float64) {
    m := PageGpuMatrixOut()
    if PageGpuUpright(m) {
        a := m[0]
        d := m[3]
        e := m[4]
        f := m[5]
        x0: float64 = cast(float64)PageRound(a * x + e)
        y0: float64 = cast(float64)PageRound(d * y + f)
        x1: float64 = cast(float64)PageRound(a * (x + width) + e)
        y1: float64 = cast(float64)PageRound(d * (y + height) + f)
        PageGpuFillRect((x0 - e) / a, (y0 - f) / d, (x1 - x0) / a,
            (y1 - y0) / d, PageGpuLastColor())
        return
    }
    PageGpuFillRect(x, y, width, height, PageGpuLastColor())
}

// The colour of the last fill-like call; PageContextCall carries colours in
// its arguments, and the snapped fill needs it after the matrix read.
page_gpu_fill_color: Color;
PageGpuLastColor :: () -> Color {
    return page_gpu_fill_color
}

// One drawing operation on the current surface. `PageOp*` names the
// operation; the numbers mean what that operation says they do.
PageContextCall :: (op: s32, a: float64, b: float64, c: float64, d: float64,
    e: float64, f: float64, g: float64, r: s32, green: s32, blue: s32, alpha: s32) {
    if !PageIsOpen() { return }
    color := PageGpuColor(r, green, blue, alpha)
    page_gpu_fill_color = color
    if op == PageOpClear {
        // A fill over the whole current surface, like the 2D hosts' clear.
        width: float64 = cast(float64)page_width
        height: float64 = cast(float64)page_height
        if page_target_count > 0 {
            width = cast(float64)page_targets[page_target_count - 1].target_width
            height = cast(float64)page_targets[page_target_count - 1].target_height
        }
        PageGpuFillRect(0.0, 0.0, width, height, color)
    } else if op == PageOpFillRect {
        PageRoundedTransformFill(a, b, c, d)
    } else if op == PageOpStrokeRect {
        // A one-pixel outline centred on the edge, half a pixel in.
        PageGpuRoundedOutline(a + 0.5, b + 0.5, c - 1.0, d - 1.0, 0.0, 1.0, color)
    } else if op == PageOpFillCircle {
        PageGpuCircle(a, b, c, color)
    } else if op == PageOpStrokeCircle {
        PageGpuRing(a, b, c - 0.5, c + 0.5, 0.0, PAGE_TAU, color)
    } else if op == PageOpLine {
        PageGpuSegment(a + 0.5, b + 0.5, c + 0.5, d + 0.5, 1.0, false, color)
    } else if op == PageOpThickLine {
        PageGpuSegment(a, b, c, d, e, true, color)
    } else if op == PageOpTriangle {
        PageGpuTriangle(a, b, c, d, e, f, color)
    } else if op == PageOpScissorBegin {
        // Replace the screen-space clip below the camera.
        saved := PageGpuMatrixOut()
        PageGpuMatrixReset()
        PageGpuScissorPush(a, b, c, d)
        PageGpuMatrixSet(saved[0], saved[1], saved[2], saved[3], saved[4], saved[5])
        page_saved = 1
    } else if op == PageOpScissorEnd {
        if page_saved > 0 {
            PageGpuScissorPop()
            page_saved = 0
        }
    } else if op == PageOpCameraPush {
        page_mode.active = true
        page_mode.zoom_x = a
        page_mode.zoom_y = b
        page_mode.offset_x = c
        page_mode.offset_y = d
        page_mode.target_x = e
        page_mode.target_y = f
        page_mode.rotation = g
        PageApplyCamera()
    } else if op == PageOpCameraPop {
        if page_mode.active {
            PageGpuFrameReset()
            page_mode.active = false
        }
    } else if op == PageOpFrameReset {
        // Logical screen coordinates over the high-density backing store.
        page_mode.active = false
        page_saved = 0
        PageGpuFrameReset()
    }
}

PageAbs :: (value: float64) -> float64 {
    if value < 0.0 { return 0.0 - value }
    return value
}

PageDrawGradientVertical :: (x: float64, y: float64, w: float64, h: float64,
    tr: s32, tg: s32, tb: s32, ta: s32, br: s32, bg: s32, bb: s32, ba: s32) {
    if !PageIsOpen() { return }
    PageGpuGradientVertical(x, y, w, h,
        PageGpuColor(tr, tg, tb, ta), PageGpuColor(br, bg, bb, ba))
}

PageDrawCircleGradient :: (x: float64, y: float64, radius: float64,
    ir: s32, ig: s32, ib: s32, ia: s32, outer_r: s32, og: s32, ob: s32, oa: s32) {
    if !PageIsOpen() || radius <= 0.0 { return }
    PageGpuCircleGradient(x, y, radius,
        PageGpuColor(ir, ig, ib, ia), PageGpuColor(outer_r, og, ob, oa))
}

// Every three points are one triangle; all of them shade with the same
// analytic coverage, so no seam shows where two of them meet.
PageFillTriangles :: (points: []Vector2, r: s32, g: s32, b: s32, a: s32) {
    if !PageIsOpen() { return }
    count: s64 = points.count - points.count % 3
    if count == 0 { return }
    color := PageGpuColor(r, g, b, a)
    at: s64 = 0
    while at < count {
        PageGpuTriangle(cast(float64)points[at].x, cast(float64)points[at].y,
            cast(float64)points[at + 1].x, cast(float64)points[at + 1].y,
            cast(float64)points[at + 2].x, cast(float64)points[at + 2].y, color)
        at += 3
    }
}

// Starts (begin) or ends a blend mode for what is drawn in between.
PageBlendMode :: (mode: s32, begin: bool) {
    if !PageIsOpen() { return }
    if begin {
        PageGpuBlendBegin(mode)
    } else {
        PageGpuBlendEnd()
    }
}

// A filled (0) or outlined (1) rectangle with rounded corners.
PageDrawRounded :: (op: s32, x: float64, y: float64, w: float64, h: float64,
    radius: float64, r: s32, g: s32, b: s32, a: s32) {
    if !PageIsOpen() { return }
    limit: float64 = w
    if h < limit { limit = h }
    limit = limit * 0.5
    corner: float64 = radius
    if limit < corner { corner = limit }
    color := PageGpuColor(r, g, b, a)
    if op == 0 {
        PageGpuFillRectRounded(x, y, w, h, corner, color)
    } else {
        PageGpuRoundedOutline(x, y, w, h, corner, 1.0, color)
    }
}

PageDrawRectLinesEx :: (x: float64, y: float64, w: float64, h: float64,
    thickness: float64, r: s32, g: s32, b: s32, a: s32) {
    if !PageIsOpen() || w <= 0.0 || h <= 0.0 { return }
    line: float64 = thickness
    if line < 1.0 { line = 1.0 }
    color := PageGpuColor(r, g, b, a)
    inner_w: float64 = w - line
    if inner_w < 0.0 { inner_w = 0.0 }
    inner_h: float64 = h - line
    if inner_h < 0.0 { inner_h = 0.0 }
    PageGpuFillRect(x, y, w, line, color)
    PageGpuFillRect(x, y + h - line, w, line, color)
    PageGpuFillRect(x, y + line, line, h - line * 2.0, color)
    PageGpuFillRect(x + w - line, y + line, line, h - line * 2.0, color)
}

PageDrawRing :: (cx: float64, cy: float64, inner: float64, outer: float64,
    start: float64, end: float64, r: s32, g: s32, b: s32, a: s32) {
    if !PageIsOpen() { return }
    from: float64 = start * PAGE_PI / 180.0
    sweep: float64 = (end - start) * PAGE_PI / 180.0
    if PageAbs(end - start) >= 359.999 { sweep = PAGE_TAU }
    if sweep < 0.0 { sweep = 0.0 }
    PageGpuRing(cx, cy, inner, outer, from, sweep, PageGpuColor(r, g, b, a))
}

// The six numbers of the current logical-to-device transform, in the
// application's units (the density scale divided out).
PageGetModelview :: (values: *float32) {
    m := PageGpuMatrixOut()
    scale: float64 = PageSurfaceScale()
    if scale <= 0.0 { scale = 1.0 }
    values[0] = cast(float32)(m[0] / scale)
    values[1] = cast(float32)(m[1] / scale)
    values[2] = cast(float32)(m[2] / scale)
    values[3] = cast(float32)(m[3] / scale)
    values[4] = cast(float32)(m[4] / scale)
    values[5] = cast(float32)(m[5] / scale)
}

// Clips later drawing to a rectangle in the application's coordinates,
// keeping the current transform for what follows.
PageClipPush :: (x: s32, y: s32, width: s32, height: s32) {
    if !PageIsOpen() { return }
    saved := PageGpuMatrixOut()
    PageGpuMatrixReset()
    clip_w: s32 = width
    if clip_w < 0 { clip_w = 0 }
    clip_h: s32 = height
    if clip_h < 0 { clip_h = 0 }
    PageGpuScissorPush(cast(float64)x, cast(float64)y,
        cast(float64)clip_w, cast(float64)clip_h)
    PageGpuMatrixSet(saved[0], saved[1], saved[2], saved[3], saved[4], saved[5])
    page_raster_clips += 1
}

PageClipPop :: () {
    if !PageIsOpen() || page_raster_clips <= 0 { return }
    PageGpuScissorPop()
    page_raster_clips -= 1
}
