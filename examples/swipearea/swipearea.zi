Box :: #import "kryon/box";
Joystick :: #import "kryon/joystick";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
#import "std/number_text"

swipes: s32;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Swipe area", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    // A stack lays the surface, its caption and the swipe target over one area.
    area := Layout.Stack(session, Layout.Props.{.bounds = .{height = 180}})
    if area.opened {
        Box.Draw(session, Box.Props.{.bounds = area.bounds, .fill = StyleTokenColor("surface"), .radius = 12.0})
        caption := Layout.Draw(session, Layout.Props.{.padding = Layout.Gap(.ThemeMetricSpace4), .padding_override = true})
        if caption.opened {
            Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 36}, .text = "Swipe here"})
            unused End(session)
        }
        result := Joystick.SwipeArea(session, Joystick.SwipeAreaProps.{.disabled = example_disabled, .bounds = area.bounds, .label = "Swipe here", .now = now})
        if result.swiped >= 0 { swipes += 1 }
        unused End(session)
    }
    digits: [24]u8
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 36}, .text = FormatInteger(cast(s64)swipes, digits[:])})
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
