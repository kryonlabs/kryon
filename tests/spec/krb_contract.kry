#import "kryon.h"

ANSWER :: #run 6 * 7
#assert ANSWER == 42, "KRB spec #run assertion failed"

state {
    count: int = 0
}

app "KRB Spec Contract" {
    size 320 240
    fps 60
}

KrbSpec :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeSurface())
        Text((TextProps){.bounds={Scale(8), Scale(8), 0, 0}, .text="KRB Spec Contract", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        count = count + 1
    }
}
