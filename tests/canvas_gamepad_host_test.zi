// Link the real Canvas host entry and its ordered gamepad delivery.
// Page gamepad sampling is covered independently by canvas_gamepad_test.
#import "canvas_host"
#import "canvas_events"
#import "canvas_input"
#import "gamepad_navigation"
#import "session"
#import "tree_input"

Take :: (session: Session) -> s32 {
    key, modifiers := CanvasInputTake(session)
    return key
}

#program_export
main :: () -> s32 {
    CanvasEventsReset()
    session := SessionOpen()
    if !SessionValid(session) { return 4 }
    defer { TreeInputReset(session); unused SessionClose(session) }
    buttons: [4]u32
    GamepadNavigationPoll(*canvas_gamepad_navigation, buttons, true)
    buttons[0] = cast(u32)1
    GamepadNavigationPoll(*canvas_gamepad_navigation, buttons, true)
    CanvasGamepadDeliver()
    if Take(session) != 257 || Take(session) != 0 { return 1 }
    GamepadNavigationPoll(*canvas_gamepad_navigation, buttons, true)
    CanvasGamepadDeliver()
    if Take(session) != 0 { return 2 }
    GamepadNavigationBlur(*canvas_gamepad_navigation)
    CanvasGamepadDeliver()
    if Take(session) != 0 { return 3 }
    return 0
}
