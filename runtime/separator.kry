#module "separator"
#import "control_props"
#import "drawing_props"
#import "style"

SeparatorLine :: struct {
    line: Rectangle
    color: u32
}

SeparatorLabelPaint :: struct {
    text: Rectangle
    line: Rectangle
    text_color: u32
    line_color: u32
    show_text: bool
    show_line: bool
}

BulletPaint :: struct {
    bounds: Rectangle
    center: Vector2
    radius: float
    color: u32
}

SeparatorLineRole :: () -> i32 #export {
    return 7
}

SeparatorLabelRole :: () -> i32 #export {
    return 6
}

SeparatorBulletRole :: () -> i32 #export {
    return 8
}

SeparatorLineFor :: (bounds: Rectangle, vertical: bool, frame: StyleFrame) -> SeparatorLine #export {
    paint: SeparatorLine
    paint.color = frame.value.background
    if vertical {
        paint.line.x = bounds.x + bounds.width * 0.5
        paint.line.y = bounds.y
        paint.line.width = 0.0
        paint.line.height = bounds.height
    } else {
        paint.line.x = bounds.x
        paint.line.y = bounds.y + bounds.height * 0.5
        paint.line.width = bounds.width
        paint.line.height = 0.0
    }
    return paint
}

SeparatorLabelPaintFor :: (bounds: Rectangle, label_width: float,
    has_label: bool, font: i32, scale: float, frame: StyleFrame) -> SeparatorLabelPaint #export {
    paint: SeparatorLabelPaint
    if scale <= 0.0 { scale = 1.0 }
    if font <= 0 { font = 14 }

    gap: float = frame.value.gap
    if (frame.value.fields & (u32)StyleGap) == (u32)0 || gap < 0.0 {
        gap = 12.0
    }
    gap *= scale
    line_x: float = bounds.x
    end_x: float = bounds.x + bounds.width

    paint.text.x = bounds.x
    paint.text.y = bounds.y + (bounds.height - (float)font) * 0.5
    paint.text.width = label_width
    paint.text.height = bounds.height
    paint.text_color = frame.value.foreground
    paint.line_color = frame.value.background
    paint.show_text = has_label

    if has_label {
        line_x = bounds.x + label_width + gap
    }

    paint.line.x = line_x
    paint.line.y = bounds.y + bounds.height * 0.5
    paint.line.width = end_x - line_x
    paint.line.height = 0.0
    paint.show_line = line_x < end_x
    if paint.line.width < 0.0 {
        paint.line.width = 0.0
        paint.show_line = false
    }
    return paint
}

BulletPaintFor :: (bounds: Rectangle, frame: StyleFrame) -> BulletPaint #export {
    paint: BulletPaint
    size: float = frame.value.icon_size
    if size <= 0.0 {
        size = bounds.width
        if bounds.height < size {
            size = bounds.height
        }
        size = size * 0.5
    }
    paint.bounds.x = bounds.x + (bounds.width - size) * 0.5
    paint.bounds.y = bounds.y + (bounds.height - size) * 0.5
    paint.bounds.width = size
    paint.bounds.height = size
    paint.center.x = bounds.x + bounds.width * 0.5
    paint.center.y = bounds.y + bounds.height * 0.5
    paint.radius = size * 0.5
    paint.color = frame.value.foreground
    return paint
}
