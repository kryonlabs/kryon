#import "session"
#import "geometry"
#import "layout"
#import "layout_widget"

FlowProps :: struct {
    bounds: Rectangle
    gap: s32
    padding: s32
    key: u64
}

FlowResult :: struct {
    node: s32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
}

// Flow places its children along a row. The caller uses FlowChildBounds before
// submitting each child, then closes the retained scope with End(session).
#program_export
Flow :: (session: Session, props: FlowProps) -> FlowResult {
    row: ColumnProps
    row.bounds = props.bounds
    row.gap = props.gap
    row.padding = props.padding
    row.key = props.key
    container: LayoutContainer = Row(session, row)
    result: FlowResult
    result.node = container.node
    result.opened = container.opened
    result.bounds = container.bounds
    result.content = container.content
    result.gap = container.gap
    result.padding = container.padding
    return result
}

#program_export
FlowChildBounds :: (flow: FlowResult, declared: Rectangle,
    measured: Rectangle, child_index: s32,
    previous_width_sum: float32) -> Rectangle {
    container: LayoutContainer
    container.bounds = flow.bounds
    container.gap = flow.gap
    container.padding = flow.padding
    return RowChildBounds(container, declared, measured,
        child_index, previous_width_sum)
}
