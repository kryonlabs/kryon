#import "geometry"

DropZone :: enum {
    DropNone = 0
    DropCenter = 1
    DropLeft = 2
    DropRight = 3
    DropTop = 4
    DropBottom = 5
}

PanedViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    vertical: bool
    split: s32
    has_split: bool
    min_first: s32
    min_second: s32
    scale: float32
    disabled: bool
}

PanedViewResult :: struct {
    node: s32
    split: s32
    changed: bool
    first: Rectangle
    second: Rectangle
    handle: Rectangle
}
