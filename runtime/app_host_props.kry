#module "app_host_props"
#import "kryon_compat.generated.h"

APP_HOST_ABI_VERSION :: 6

# Input override for embedding: plain data.
KryonInputOverride :: struct {
    enabled: i32
    mouse_inside: i32
    pass_buttons: i32
    pass_keyboard: i32
    mouse_position: Vector2
    mouse_delta: Vector2
}

# C-only host ABI records: routes and hosts carry function pointers, and App
# holds the embedder's opaque handle. The pointer fields are declared as their
# own typedefs first — the #type emitter inserts the record name after the
# first "(*", so a struct body must not contain a "(*" of its own.
AppRouteEnterFn :: void (*)(void *app, int route_index) #type
AppRouteDrawFn :: void (*)(void *app, Rectangle viewport) #type
AppRouteInfo :: struct { const char *id; const char *group; const char *title; const char *source_path; AppRouteEnterFn enter; AppRouteDrawFn draw; } #type
AppScreenInfo :: AppRouteInfo #type
HostScreenCountFn :: int (*)(void *userdata) #type
HostScreenFn :: AppScreenInfo (*)(void *userdata, int index) #type
HostSelectScreenFn :: void (*)(void *userdata, int index) #type
HostSelectSourcePathFn :: int (*)(void *userdata, const char *source_path) #type
HostDrawFn :: void (*)(void *userdata, Rectangle viewport) #type
HostResizeFn :: void (*)(void *userdata, int width, int height) #type
HostSetFocusedFn :: void (*)(void *userdata, int focused) #type
AppHost :: struct { void *userdata; HostScreenCountFn screen_count; HostScreenFn screen; HostSelectScreenFn select_screen; HostSelectSourcePathFn select_source_path; HostDrawFn draw; HostResizeFn resize; HostSetFocusedFn set_focused; } #type
CreateAppHostCallback :: AppHost *(*)(int abi_version, const char *project_path) #type
DestroyAppHostCallback :: void (*)(AppHost *host) #type

# App runtime: the embedder's route table.
App :: struct { void *app; const AppRouteInfo *routes; int route_count; int selected_route; } #type
AppScreen :: AppRouteInfo #type

# Implemented by the C-only host/embedding services; declared here for the
# public ABI.
BeginKryonInputOverride :: (input: KryonInputOverride) #extern #export
EndKryonInputOverride :: () #extern #export
IsInspectActive :: () -> i32 #extern #export
ResizeAppHost :: (host: *AppHost, width: i32, height: i32) #extern #export
SetAppHostFocused :: (host: *AppHost, focused: i32) #extern #export
BindAppHost :: (app: *App, host: *AppHost) #extern #export
GetAppScreenCount :: (host: *AppHost) -> i32 #extern #export
GetAppScreen :: (host: *AppHost, index: i32) -> AppScreenInfo #extern #export
SetAppScreen :: (host: *AppHost, index: i32) #extern #export
SetAppScreenById :: (host: *AppHost, id: const char*) -> i32 #extern #export
SetAppScreenBySourcePath :: (host: *AppHost, source_path: const char*) -> i32 #extern #export
SetAppScreenFromRoute :: (host: *AppHost) -> i32 #extern #export
PushAppScreenRoute :: (host: *AppHost, index: i32) #extern #export
ReplaceAppScreenRoute :: (host: *AppHost, index: i32) #extern #export
DrawAppScreen :: (host: *AppHost, viewport: Rectangle) #extern #export
