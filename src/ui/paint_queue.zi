#import "drawing_props"
#import "geometry"
#import "raster"
#import "raster_shape"
#import "raster_text"
#import "session"
#import "tree"
#import "vec"
host_api :: #system_library "host_api";

PaintKind :: enum {
    PaintKindLine :: 1
    PaintKindRoundedFill :: 2
    PaintKindRoundedOutline :: 3
    PaintKindText :: 4
    PaintKindImage :: 5
    PaintKindClippedText :: 6
}

PaintCommand :: struct {
    node: s32
    kind: s32
    bounds: Rectangle
    color: Color
    radius: float32
    segments: s32
    line_width: float32
    value: string
    x: s32
    y: s32
    font: s32
    asset_path: string
    texture_id: u32
    source: Rectangle
    clip: Rectangle
    origin: Vector2
    rotation: float32
}

PaintEmitter :: #type (command: PaintCommand) -> ();
PaintClipper :: #type (command: PaintCommand,
    geometry: NodeGeometry) -> PaintCommand;

QueuedPaint :: struct {
    data: PaintCommand
    emit: PaintEmitter
    clip_for: PaintClipper
    has_emitter: bool
    clips: bool
}

PaintCommands :: struct {
    items: Vec(QueuedPaint)
    overflow: bool
}

pending_paint: [9]PaintCommands;

// Raw rasterization; the queued source, clip, radius, and tint are chosen in
// checked widget code before this device effect is called.
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) #foreign host_api;

#program_export
EmitPaint :: (command: QueuedPaint) {
    if command.has_emitter {
        emit: PaintEmitter = command.emit
        emit(command.data)
    }
}

EmitLine :: (command: PaintCommand) {
    StrokeLine(command.bounds, command.color)
}

EmitRoundedFill :: (command: PaintCommand) {
    FillRoundedRectangle(command.bounds, command.radius,
        command.segments, command.color)
}

EmitRoundedOutline :: (command: PaintCommand) {
    StrokeRoundedRectangle(command.bounds, command.radius,
        command.segments, command.line_width, command.color)
}

EmitLabel :: (command: PaintCommand) {
    if command.kind == PaintKindClippedText {
        PaintTextClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip)
    } else {
        PaintText(command.value, command.x, command.y,
            command.font, command.color)
    }
}

EmitImage :: (command: PaintCommand) {
    if command.clip.width > 0.0 && command.clip.height > 0.0 {
        RasterImage(command.asset_path, command.texture_id,
            command.source, command.bounds, command.clip,
            command.origin, command.rotation, command.radius,
            command.color)
    }
}

ClipLabel :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    if command.kind == PaintKindText {
        command.kind = PaintKindClippedText
        command.clip = geometry.clip
    } else {
        command.clip = RectangleIntersection(command.clip, geometry.clip)
    }
    return command
}

ClipImage :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    command.clip = RectangleIntersection(command.clip, geometry.clip)
    return command
}

#program_export
SubmitPaint :: (session: Session, command: QueuedPaint) {
    if command.data.node < 0 && !TreeIsBuilding(session) {
        EmitPaint(command)
        return
    }
    if command.data.node >= 0 && TreeIsBuilding(session) {
        geometry: NodeGeometry = TreeSubmittedGeometryAt(session,
            command.data.node)
        dx: float32 = geometry.bounds.x - geometry.measured_bounds.x
        dy: float32 = geometry.bounds.y - geometry.measured_bounds.y
        full_bounds: bool = command.data.bounds.x == geometry.measured_bounds.x &&
            command.data.bounds.y == geometry.measured_bounds.y &&
            command.data.bounds.width == geometry.measured_bounds.width &&
            command.data.bounds.height == geometry.measured_bounds.height
        full_clip: bool = command.data.clip.x == geometry.measured_bounds.x &&
            command.data.clip.y == geometry.measured_bounds.y &&
            command.data.clip.width == geometry.measured_bounds.width &&
            command.data.clip.height == geometry.measured_bounds.height
        command.data.bounds.x += dx
        command.data.bounds.y += dy
        command.data.clip.x += dx
        command.data.clip.y += dy
        command.data.x += cast(s32)dx
        command.data.y += cast(s32)dy
        if full_bounds {
            command.data.bounds.width = geometry.bounds.width
            command.data.bounds.height = geometry.bounds.height
        }
        if full_clip {
            command.data.clip.width = geometry.bounds.width
            command.data.clip.height = geometry.bounds.height
        }
        if geometry.clipped && command.clips {
            clip_for: PaintClipper = command.clip_for
            command.data = clip_for(command.data, geometry)
        }
    }
    if !VecPush(pending_paint[SessionIndex(session)].items, command) {
        pending_paint[SessionIndex(session)].overflow = true
    }
}

#program_export
PaintLine :: (session: Session, node: s32, bounds: Rectangle,
    color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindLine
    command.data.node = node
    command.data.bounds = bounds
    command.data.color = color
    emit: PaintEmitter = EmitLine
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

#program_export
PaintRoundedFill :: (session: Session, node: s32, bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindRoundedFill
    command.data.node = node
    command.data.bounds = bounds
    command.data.radius = radius
    command.data.segments = segments
    command.data.color = color
    emit: PaintEmitter = EmitRoundedFill
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

#program_export
PaintRoundedOutline :: (session: Session, node: s32, bounds: Rectangle, radius: float32,
    segments: s32, line_width: float32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindRoundedOutline
    command.data.node = node
    command.data.bounds = bounds
    command.data.radius = radius
    command.data.segments = segments
    command.data.line_width = line_width
    command.data.color = color
    emit: PaintEmitter = EmitRoundedOutline
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

#program_export
PaintLabel :: (session: Session, node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindText
    command.data.node = node
    command.data.value = value
    command.data.x = x
    command.data.y = y
    command.data.font = font
    command.data.color = color
    emit: PaintEmitter = EmitLabel
    clip_for: PaintClipper = ClipLabel
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintClippedLabel :: (session: Session, node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    command: QueuedPaint
    command.data.kind = PaintKindClippedText
    command.data.node = node
    command.data.value = value
    command.data.x = x
    command.data.y = y
    command.data.font = font
    command.data.color = color
    command.data.clip = clip
    emit: PaintEmitter = EmitLabel
    clip_for: PaintClipper = ClipLabel
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintImage :: (session: Session, node: s32, asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindImage
    command.data.node = node
    command.data.asset_path = asset_path
    command.data.texture_id = texture_id
    command.data.source = source
    command.data.bounds = destination
    command.data.clip = clip
    command.data.origin = origin
    command.data.rotation = rotation
    command.data.radius = radius
    command.data.color = tint
    emit: PaintEmitter = EmitImage
    clip_for: PaintClipper = ClipImage
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintClear :: (session: Session) {
    VecClear(pending_paint[SessionIndex(session)].items)
    pending_paint[SessionIndex(session)].overflow = false
}

#program_export
PaintOverflow :: (session: Session) -> bool {
    return pending_paint[SessionIndex(session)].overflow
}

// The pending commands are inspectable after the tree commits and before
// PaintFlush clears them. A failed commit clears the queue instead.
#program_export
PendingPaintCount :: (session: Session) -> s32 {
    return cast(s32)pending_paint[SessionIndex(session)].items.count
}

#program_export
PendingPaintAt :: (session: Session, index: s32) -> PaintCommand {
    empty: PaintCommand
    if index < 0 || cast(s64)index >= pending_paint[SessionIndex(session)].items.count { return empty }
    return pending_paint[SessionIndex(session)].items[index].data
}

#program_export
PaintFlush :: (session: Session) {
    index: s32 = 0
    while cast(s64)index < pending_paint[SessionIndex(session)].items.count {
        command: QueuedPaint = pending_paint[SessionIndex(session)].items[index]
        EmitPaint(command)
        index += 1
    }
    PaintClear(session)
}

#program_export
PaintDispose :: (session: Session) {
    if !SessionValid(session) { return }
    VecFree(pending_paint[session.slot].items)
    pending_paint[session.slot].overflow = false
}
