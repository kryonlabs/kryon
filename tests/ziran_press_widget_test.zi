// A press clicks, becomes a hold after its time, reports the pointer while
// it lasts and, with capture, keeps it off the area; Enter and Space click it.
#import "session"
#import "geometry"
#import "press_props"
#import "press_widget"
#import "tree"
#import "tree_draw"
#import "tree_input"

using FrameStatus;

session: Session;
result: PressResult;
capture: bool;
disabled: bool;

Frame :: (now: float64) -> bool {
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 300.0})
    result = Press(session, PressProps.{.id = 70, .label = "Message",
            .bounds = Rectangle.{10.0, 10.0, 100.0, 40.0}, .now = now,
            .capture = capture, .disabled = disabled})
    return EndFrame(session) == cast(FrameStatus)FrameOk
}

Pointer :: (x: float32, y: float32, down: bool, pressed: bool, released: bool) {
    unused TreePointerUpdate(session, PointerFrame.{x, y, down, pressed, released})
}

#program_export
Answer :: () -> s32 {
    session = SessionOpen()
    if !Frame(0.0) || result.clicked || result.down { return 1 }

    // A short press clicks.
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(0.1) || !result.down || result.held { return 2 }
    Pointer(20.0, 20.0, false, false, true)
    if !Frame(0.2) || !result.clicked || !result.released || result.held { return 3 }

    // A long press holds once and does not click when it lifts.
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(1.0) || !result.down || result.held { return 4 }
    if TreePointerCapturesDrag(session) { return 19 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.3) || result.held { return 5 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.6) || !result.held || !result.down || result.x != 21.0 { return 6 }
    // Once held, the press keeps the pointer from an enclosing scroll.
    if !TreePointerCapturesDrag(session) { return 18 }
    Pointer(21.0, 20.0, true, false, false)
    if !Frame(1.7) || result.held || !result.down { return 7 }
    Pointer(21.0, 20.0, false, false, true)
    if !Frame(1.8) || result.clicked || !result.released { return 8 }

    // With capture, the press keeps reporting the pointer off the area.
    capture = true
    if !Frame(2.0) { return 9 }
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(3.0) || !result.down { return 10 }
    Pointer(300.0, 200.0, true, false, false)
    if !Frame(3.1) || !result.down || result.x != 300.0 || result.y != 200.0 { return 11 }
    Pointer(300.0, 200.0, false, false, true)
    if !Frame(3.2) || !result.released || result.clicked { return 12 }
    capture = false

    // After Tab, Space clicks it like a button.
    unused KeyboardSend(session, KeyTab)
    if !Frame(4.0) { return 13 }
    unused KeyboardSend(session, 32)
    if !Frame(4.1) || !result.clicked { return 14 }
    unused KeyboardSend(session, 0)

    // A disabled area neither clicks nor holds.
    disabled = true
    if !Frame(5.0) { return 15 }
    Pointer(20.0, 20.0, true, true, false)
    if !Frame(5.1) || result.down { return 16 }
    Pointer(20.0, 20.0, false, false, true)
    if !Frame(5.2) || result.clicked { return 17 }
    SessionClose(session)
    return 42
}

#program_export
main :: () -> s32 {
    answer := Answer()
    if answer != 42 {
        return answer
    }
    return 0
}
