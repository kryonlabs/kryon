// Private document storage for hosts. The harness supplies an app/account
// directory; bundles only name relative files inside that directory.
#import "std/file"
#import "std/vec"
#import "std/text"
#import "std/byte_text_linux"
#import "app_protocol"
#if #defined(PLATFORM_WEB) {
    #import "bundle_storage_web"
    #import "std/web"
    #import "page_files"
}

APP_DOCUMENT_LIMIT :: 16777216

AppFiles :: struct {
    root: string
    status: s32
    lock: FileHandle
    generation: u64
}

libc :: #system_library "libc";
AppFreeBytes :: (bytes: *u8) #foreign libc "free";

AppFileFree :: (value: string) {
    if value.count > 0 {
        descriptor := cast(*TextDescriptor)(*value)
        AppFreeBytes(descriptor.data)
    }
}
#if !#defined(_WIN32) && !#defined(PLATFORM_WEB) {
    FileLock :: (fd: s32, operation: s32) -> s32 #foreign libc "flock";
}
#if #defined(_WIN32) {
    FileError :: () -> *s32 #foreign libc "_errno";
} else #if #defined(ANDROID_BUILD) {
    FileError :: () -> *s32 #foreign libc "__errno";
} else #if #defined(__APPLE__) {
    FileError :: () -> *s32 #foreign libc "__error";
} else {
    FileError :: () -> *s32 #foreign libc "__errno_location";
}
// "No such file or directory". Emscripten numbers errors as WASI does, so
// the browser reports 44 where the other platforms report 2.
#if #defined(PLATFORM_WEB) {
    FILE_MISSING :: 44
} else {
    FILE_MISSING :: 2
}

AppFileNameValid :: (name: string) -> bool {
    if name.count == 0 || name.count > 1024 || name[0] == cast(u8)47 {
        return false
    }
    start: s64 = 0
    for index: 0..name.count {
        if index == name.count || name[index] == cast(u8)47 {
            part := name[start:index]
            if part == "" || part == "." || part == ".." {
                return false
            }
            start = index + 1
        } else if name[index] < cast(u8)32 || name[index] == cast(u8)127 ||
        name[index] == cast(u8)92 || name[index] == cast(u8)58 {
            return false
        }
    }
    return true
}

AppPrivateDirectory :: (path: string) -> bool {
    start: s64 = 1
    absolute := path.count > 0 && path[0] == cast(u8)47
    #if #defined(_WIN32) {
        if path.count >= 3 && path[1] == cast(u8)58 && path[2] == cast(u8)47 &&
        ((path[0] >= cast(u8)65 && path[0] <= cast(u8)90) ||
        (path[0] >= cast(u8)97 && path[0] <= cast(u8)122)) {
            absolute = true
            start = 3
        }
    }
    if !absolute || path.count >= 3072 {
        return false
    }
    for index: start..path.count {
        if index == path.count || path[index] == cast(u8)47 {
            prefix := path[:index]
            if PathIsLink(prefix) || !CreatePrivateDirectory(prefix) {
                return false
            }
        }
    }
    return true
}

AppFilePath :: (files: *AppFiles, name: string, create: bool) -> string {
    if !AppFileNameValid(name) || files.root == "" {
        return ""
    }
    path: Vec(u8)
    BuilderPrint(*path, "%/%", files.root, name)
    result := BuilderFinish(path)
    for index: 1..result.count {
        if index == result.count || result[index] == cast(u8)47 {
            prefix := result[:index]
            if PathIsLink(prefix) {
                AppFileFree(result)
                return ""
            }
            if create && index < result.count && !CreatePrivateDirectory(prefix) {
                AppFileFree(result)
                return ""
            }
        }
    }
    return result
}

AppFilesOpen :: (files: *AppFiles, root: string) -> bool {
    if files.lock.valid { return false }
    files.generation += 1
    #if #defined(PLATFORM_WEB) {
        if AppFilesPersistent(root) && !BundleStorageReady() { return false }
    }
    if !AppPrivateDirectory(root) {
        return false
    }
    files.root = root
    path := AppFilePath(files, ".lock", false)
    defer { AppFileFree(path) }
    files.lock = OpenExclusivePrivate(path)
    if !files.lock.valid {
        files.lock = OpenRead(path)
    }
    if !files.lock.valid {
        return false
    }
    #if !#defined(_WIN32) && !#defined(PLATFORM_WEB) {
        if FileLock(files.lock.fd, 6) != 0 {
            unused CloseFile(files.lock)
            files.lock = FileHandle.{}
            return false
        }
    }
    return true
}

AppFilesClose :: (files: *AppFiles) {
    files.generation += 1
    if files.lock.valid {
        unused CloseFile(files.lock)
    }
    files.root = ""
    files.lock = FileHandle.{}
    files.status = DOCUMENT_ERROR
}

AppFileRead :: (files: *AppFiles, name: string) -> string {
    files.status = DOCUMENT_ERROR
    if !AppFilesAvailable(files) {
        return ""
    }
    path := AppFilePath(files, name, false)
    defer { AppFileFree(path) }
    if path == "" {
        return ""
    }
    file := OpenRead(path)
    if !file.valid {
        if FileError().* == FILE_MISSING {
            files.status = DOCUMENT_MISSING
        }
        return ""
    }
    defer { unused CloseFile(file) }
    size := FileSize(file)
    if size < 0 || size > APP_DOCUMENT_LIMIT {
        return ""
    }
    bytes: Vec(u8)
    for index: 0..size - 1 {
        if !VecPush(bytes, cast(u8)0) {
            return ""
        }
    }
    read: s64
    {
        output := VecSlice(bytes, 0, bytes.count)
        read = ReadAt(file, output, 0)
    }
    if read != size {
        VecFree(bytes)
        return ""
    }
    files.status = DOCUMENT_READY
    return BuilderFinish(bytes)
}

AppFileWrite :: (files: *AppFiles, name: string, value: string) -> bool {
    if !AppFilesAvailable(files) || value.count > APP_DOCUMENT_LIMIT || name == ".lock" {
        return false
    }
    path := AppFilePath(files, name, true)
    defer { AppFileFree(path) }
    if path == "" {
        return false
    }
    #if #defined(PLATFORM_WEB) {
        // IDBFS compares millisecond mtimes, not bytes. Atomic replacements
        // in the same clock tick must still differ from the persisted file.
        previous_time: float64 = -1.0
        if PathExists(path) {
            stat := WebAsObject(WebCall1(PageFileSystem(), WebName("stat"), WebText(path)))
            previous_time = WebAsNumber(WebCall0(WebGetObject(stat, WebName("mtime")), WebName("getTime")))
            if WebFailed() { return false }
        }
    }
    temporary: Vec(u8)
    BuilderPrint(*temporary, "%.new", path)
    next := BuilderFinish(temporary)
    defer { AppFileFree(next) }
    if PathIsLink(next) {
        return false
    }
    unused RemoveFile(next)
    file := OpenExclusivePrivate(next)
    if !file.valid {
        return false
    }
    ok := WriteTextAt(file, value, 0) == value.count
    #if !#defined(PLATFORM_WEB) {
        ok = ok && SyncFile(file)
    }
    // Browser hosts flush their mounted filesystem as a batch. Emscripten's
    // fsync synchronizes the entire IndexedDB mount, so doing it for each
    // document or extracted asset stalls input and startup.
    if !CloseFile(file) {
        ok = false
    }
    if !ok || !RenamePath(next, path) {
        unused RemoveFile(next)
        return false
    }
    #if #defined(PLATFORM_WEB) {
        if previous_time >= 0.0 {
            unused WebCall3(PageFileSystem(), WebName("utime"), WebText(path),
                WebNumber(previous_time + 1.0), WebNumber(previous_time + 1.0))
            if WebFailed() { return false }
        }
    }
    #if !#defined(PLATFORM_WEB) {
        // Persist the rename and any newly created ancestors, leaf first.
        index := path.count - 1
        while index > 0 {
            if path[index] == cast(u8)47 {
                directory := OpenRead(path[:index])
                if !directory.valid { return false }
                synced := SyncFile(directory)
                closed := CloseFile(directory)
                if !synced || !closed { return false }
            }
            index -= 1
        }
    }
    return true
}

// AppFiles also stages packed assets outside the persistent browser mount.
AppFilesPersistent :: (root: string) -> bool {
    return root == "/kryon-apps" || (root.count > 12 && root[:12] == "/kryon-apps/")
}

AppFilesAvailable :: (files: *AppFiles) -> bool {
    if !files.lock.valid || files.root == "" { return false }
    #if #defined(PLATFORM_WEB) {
        if AppFilesPersistent(files.root) { return BundleStorageReady() }
    }
    return true
}

// Nonblocking durable-storage availability, distinct from staging assets.
AppFilesReady :: (files: *AppFiles) -> bool {
    #if #defined(PLATFORM_WEB) {
        if !AppFilesPersistent(files.root) { return false }
    }
    return AppFilesAvailable(files)
}

// Owning-thread barrier. The owner storage must survive the yielding call.
AppFilesFlush :: (files: *AppFiles) -> bool {
    if !AppFilesReady(files) { return false }
    generation := files.generation
    #if #defined(PLATFORM_WEB) {
        if !BundleStorageFlush() { return false }
    }
    return generation == files.generation && AppFilesReady(files)
}
