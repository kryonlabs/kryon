    if kind == WidgetKindButton { return "Button" }
    if kind == WidgetKindTextField { return "TextField" }
    if kind == WidgetKindTextArea { return "TextArea" }
    if kind == WidgetKindDropdown { return "Dropdown" }
    if kind == WidgetKindSlider { return "Slider" }
    if kind == WidgetKindToggle { return "Toggle" }
    if kind == WidgetKindCheckbox { return "Checkbox" }
    if kind == WidgetKindParagraph { return "Paragraph" }
    if kind == WidgetKindNavigationBar { return "NavigationBar" }
    if kind == WidgetKindTabBar { return "TabBar" }
    if kind == WidgetKindTitleBar { return "TitleBar" }
    if kind == WidgetKindGroup { return "Group" }
    if kind == WidgetKindColumn { return "Column" }
    if kind == WidgetKindRow { return "Row" }
    if kind == WidgetKindStack { return "Stack" }
    if kind == WidgetKindGrid { return "Grid" }
    if kind == WidgetKindImage { return "Image" }
    if kind == WidgetKindCustom { return "Custom" }
    if kind == WidgetKindDrag { return "Drag" }
    if kind == WidgetKindRouter { return "Router" }
    if kind == WidgetKindCard { return "Card" }
    if kind == WidgetKindIcon { return "Icon" }
