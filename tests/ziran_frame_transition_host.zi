#import "drawing_props"
#import "geometry"

draws: s32;
disposed: s32;
failed: bool;

#program_export
DisposeFrameTexture :: (texture: Texture2D) {
    if texture.id != cast(u32)7 { failed = true }
    disposed += 1
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    unused asset_path
    return 1
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    unused asset_path
    return 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    unused asset_path
    unused origin
    unused rotation
    unused radius
    if texture_id != cast(u32)7 || source.width != 20.0 ||
    source.height != -10.0 || destination.x != 1.0 ||
    destination.y != 2.0 || destination.width != 30.0 ||
    destination.height != 20.0 || clip.width != 30.0 ||
    tint.r != cast(u8)255 || tint.g != cast(u8)255 ||
    tint.b != cast(u8)255 || tint.a != cast(u8)255 { failed = true }
    draws += 1
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused bounds
    unused radius
    unused segments
    unused color
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused bounds
    unused radius
    unused segments
    unused width
    unused color
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused value
    unused x
    unused y
    unused font
    unused color
    unused clip
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused value
    unused font
    unused typeface
    return 1
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused font
    unused typeface
    return 1
}

#program_export
FrameTransitionHostFailed :: () -> bool { return failed }

#program_export
FrameTransitionDraws :: () -> s32 { return draws }

#program_export
FrameTransitionDisposed :: () -> s32 { return disposed }
