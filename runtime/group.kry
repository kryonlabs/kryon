#module "group"
#import "drawing_props"
#import "layout"

GroupPolicy :: struct {
    bounds: Rectangle
    content: Rectangle
    gap: i32
    padding: i32
}

GroupPolicyFor :: (bounds: Rectangle, gap: i32, padding: i32) -> GroupPolicy #export {
    metrics: LayoutMetrics = LayoutMetricsFor(bounds, gap, padding)
    policy: GroupPolicy
    policy.bounds = bounds
    policy.content = metrics.content
    policy.gap = metrics.gap
    policy.padding = metrics.padding
    return policy
}

ScreenGroupPolicyFor :: (bounds: Rectangle, fallback_width: i32,
    fallback_height: i32, gap: i32, padding: i32) -> GroupPolicy #export {
    scoped: Rectangle = LayoutScopeBounds(bounds, fallback_width, fallback_height)
    return GroupPolicyFor(scoped, gap, padding)
}
