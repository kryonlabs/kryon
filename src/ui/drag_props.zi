#module "drag_props"
#import "geometry"
#import "input_props"

DragMode :: enum {
    DragValue = 0
    DragRange = 1
}

DragProps :: struct {
    bounds: Rectangle
    id: i32
    class_name: i32
    label: const char*
    kind: NumericValueKind
    mode: DragMode
    float_values: float*
    int_values: i32*
    value_count: i32
    float_min: float*
    float_max: float*
    int_min: i32*
    int_max: i32*
    speed: float
    min: double
    max: double
    format: const char*
    format_max: const char*
    disabled: bool
}
