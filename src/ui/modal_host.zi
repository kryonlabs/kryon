#module "modal_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/modal.h"
#import "runtime/style.h"

ModalText :: (value: const char*) -> const char* {
    if value == nil { return "" }
    return value
}

ModalStyle :: (class_name: i32, tone: ButtonTone,
state: ButtonState, role: i32) -> StyleFrame {
    props: ButtonProps = (ButtonProps){0}
    props.tone = tone
    props.emphasis = ButtonEmphasisSoft
    if tone == ButtonToneAccent {
        props.emphasis = ButtonEmphasisFilled
    }
    props.class_name = class_name
    return ui_control_style_frame_role_kind(props, state, 0,
    0.0, 0.0, 0.0, StyleKindModal(), role)
}

ModalMetricsForClass :: (class_name: i32) -> ModalMetrics {
    return ModalMetricsFor((float)GetScale(),
    ModalStyle(class_name, ButtonToneNeutral, ButtonStateNormal,
    ModalPanelRole()),
    ModalStyle(class_name, ButtonToneNeutral, ButtonStateNormal,
    ModalTitleRole()),
    ModalStyle(class_name, ButtonToneNeutral, ButtonStateNormal,
    ModalMessageRole()),
    ModalStyle(class_name, ButtonToneNeutral, ButtonStateNormal,
    ModalActionRole()),
    ModalStyle(class_name, ButtonToneNeutral, ButtonStateNormal,
    ModalCloseRole()))
}

ModalIconButton :: (x: i32, y: i32, size: i32, padding: i32,
icon: Texture2D, class_name: i32) -> i32 {
    props: IconActionSpec = (IconActionSpec){0}
    props.bounds = (Rectangle){(float)x, (float)y,
        (float)(size + padding * 2), (float)(size + padding * 2)}
    props.icon = icon
    props.icon_size = size
    props.icon_padding = padding
    style_props: ButtonProps = (ButtonProps){0}
    style_props.tone = ButtonToneNeutral
    style_props.emphasis = ButtonEmphasisSoft
    style_props.icon_only = true
    style_props.class_name = class_name
    normal: Style = ui_unpack_style(
    ui_control_style_frame_role_kind(style_props,
    ButtonStateNormal, 0, 0.0, 0.0, 0.0,
    StyleKindModal(), ModalCloseRole()).value)
    hovered: Style = ui_unpack_style(
    ui_control_style_frame_role_kind(style_props,
    ButtonStateHover, 0, 0.0, 0.0, 0.0,
    StyleKindModal(), ModalCloseRole()).value)
    props.background = normal.background
    props.hover_background = hovered.background
    props.icon_color = normal.foreground
    props.border = normal.border
    props.radius = StyleLegacyBoxRadius(-1.0)
    return RenderIconAction(props)
}

ModalButton :: (x: i32, y: i32, width: i32, height: i32,
label: const char*, font: i32, tone: ButtonTone,
emphasis: ButtonEmphasis, disabled: i32, class_name: i32,
mouse_world: Vector2) -> i32 {
    bounds: Rectangle = (Rectangle){(float)x, (float)y,
        (float)width, (float)height}
    props: ButtonProps = (ButtonProps){0}
    props.bounds = bounds
    props.label = label
    props.tone = tone
    props.emphasis = emphasis
    props.disabled = disabled
    props.class_name = class_name
    if CheckCollisionPointRec(mouse_world, bounds) &&
    !InputCapturesClick(mouse_world) { MarkClickable() }
    button: ButtonSpec = (ButtonSpec){0}
    button.props = props
    state: ButtonState = ButtonStateNormal
    if disabled != 0 { state = ButtonStateDisabled }
    button.style.normal = ui_unpack_style(ModalActionButtonFrame(
    ui_control_style_frame_role_kind(props, state, 0,
    0.0, 0.0, 0.0, StyleKindModal(), ModalActionRole())).value)
    button.style.normal.font_size = (float)font
    button.style.normal.fields |= StyleFontSize
    button.style.hover = ui_unpack_style(ModalActionButtonFrame(
    ui_control_style_frame_role_kind(props, ButtonStateHover, 0,
    0.0, 0.0, 0.0, StyleKindModal(), ModalActionRole())).value)
    button.style.pressed = ui_unpack_style(ModalActionButtonFrame(
    ui_control_style_frame_role_kind(props, ButtonStatePressed, 0,
    0.0, 0.0, 0.0, StyleKindModal(), ModalActionRole())).value)
    button.style.disabled = ui_unpack_style(ModalActionButtonFrame(
    ui_control_style_frame_role_kind(props, ButtonStateDisabled, 0,
    0.0, 0.0, 0.0, StyleKindModal(), ModalActionRole())).value)
    button.style_kind = StyleKindModal()
    button.style_resolved = 1
    return ui_button_render(button)
}

ModalActionWidthForLabel :: (label: const char*, font: i32,
metrics: ModalMetrics) -> i32 {
    return ModalActionWidth(TextWidth(ModalText(label), font), metrics)
}

ModalMeasureActionRows :: (actions: const ModalAction*, count: i32,
content_width: i32, gap: i32, font: i32,
metrics: ModalMetrics) -> i32 {
    if actions == nil || count <= 0 { return 0 }
    rows: i32 = 1
    row_width: i32 = 0
    index: i32 = 0
    while index < count {
        action_width: i32 = ModalActionWidthForLabel(
        actions[index].label, font, metrics)
        next_rows: i32 = ModalActionRowsStep(row_width, rows,
        action_width, content_width, gap)
        row_width = ModalActionRowWidthStep(row_width,
        action_width, content_width, gap)
        rows = next_rows
        index += 1
    }
    return rows
}

ModalDrawActions :: (actions: const ModalAction*, count: i32,
x: i32, y: i32, content_width: i32, button_height: i32,
gap: i32, font: i32, class_name: i32,
mouse_world: Vector2, metrics: ModalMetrics) -> i32 {
    if actions == nil || count <= 0 { return 0 }
    result: i32 = 0
    row_start: i32 = 0
    row_width: i32 = 0
    row_count: i32 = 0
    index: i32 = 0
    while index <= count {
        end_row: i32 = index == count
        action_width: i32 = 0
        next_rows: i32 = 0
        next_width: i32 = 0
        if !end_row {
            action_width = ModalActionWidthForLabel(
            actions[index].label, font, metrics)
            next_rows = ModalActionRowsStep(row_width, 1,
            action_width, content_width, gap)
            next_width = ModalActionRowWidthStep(row_width,
            action_width, content_width, gap)
        }
        if !end_row && next_rows == 1 {
            row_width = next_width
            row_count += 1
            index += 1
            continue
        }
        if row_count > 0 {
            draw_x: i32 = x + (content_width - row_width) / 2
            row_index: i32 = 0
            while row_index < row_count {
                action_index: i32 = row_start + row_index
                action: ModalAction = actions[action_index]
                draw_width: i32 = ModalActionWidthForLabel(
                action.label, font, metrics)
                if draw_width > content_width {
                    draw_width = content_width
                }
                if ModalButton(draw_x, y, draw_width, button_height,
                action.label, font, action.tone, action.emphasis,
                action.disabled, class_name, mouse_world) {
                    result = action_index + 1
                }
                draw_x += draw_width + gap
                row_index += 1
            }
            y = ModalActionNextY(y, button_height, gap)
        }
        row_start = index
        row_width = action_width
        row_count = 0
        if !end_row { row_count = 1 }
        index += 1
    }
    return result
}

ModalRoleStyle :: (class_name: i32, role: i32) -> Style {
    props: ButtonProps = (ButtonProps){0}
    props.class_name = class_name
    return ui_unpack_style(ui_control_style_frame_role_kind(
    props, ButtonStateNormal, 0, 0.0, 0.0, 0.0,
    StyleKindModal(), role).value)
}

RenderActionModal :: (modal: ModalProps) -> i32 #export {
    metrics: ModalMetrics = ModalMetricsForClass(modal.class_name)
    modal_max_width: i32 = 0
    if modal.max_width > 0 {
        modal_max_width = Scale(modal.max_width)
    }
    has_prompt: i32 = ModalHasPromptFor(modal.text != nil,
    modal.text_size, modal.cursor_position != nil,
    modal.focused != nil)
    mouse_world: Vector2 = ui_mouse_world()
    panel_style: Style = ModalRoleStyle(modal.class_name,
    ModalPanelRole())
    title_style: Style = ModalRoleStyle(modal.class_name,
    ModalTitleRole())
    message_style: Style = ModalRoleStyle(modal.class_name,
    ModalMessageRole())
    action_style: Style = ui_unpack_style(
    ModalStyle(modal.class_name, ButtonToneNeutral,
    ButtonStateNormal, ModalActionRole()).value)
    scrim_style: Style = ModalRoleStyle(modal.class_name,
    ModalScrimRole())

    modal_width: i32 = ModalClampWidth(ui_view_width,
    modal_max_width, metrics)
    message_width: i32 = ModalContentWidth(modal_width, metrics)
    message_font: i32 = ModalFontFor(GetFontSize(),
    StyleFontValue(message_style.fields,
    message_style.font_size))
    button_font: i32 = ModalFontFor(GetFontSize(),
    StyleFontValue(action_style.fields,
    action_style.font_size))
    message_layout: TextLayout = ParseTextLayout(modal.message,
    g_ui_gear_icon, ICON_GEAR, message_font)
    ReflowTextLayout(&message_layout, message_width, message_font,
    ModalMessageLineGap((float)GetScale()))
    button_rows: i32 = ModalMeasureActionRows(modal.actions,
    modal.action_count, message_width, metrics.button_gap,
    button_font, metrics)
    buttons_height: i32 = ModalButtonsHeight(button_rows, metrics)
    layout: ModalLayout = ModalLayoutFor(ui_view_width,
    ui_view_height, modal_max_width,
    GetTextLayoutHeight(&message_layout), button_rows,
    has_prompt != 0, metrics)
    modal_x: i32 = (int)layout.panel.x
    modal_y: i32 = (int)layout.panel.y
    modal_width = (int)layout.panel.width
    modal_height: i32 = (int)layout.panel.height
    message_width = layout.content_width
    capture: Rectangle = (Rectangle){(float)modal_x,
        (float)modal_y, (float)modal_width, (float)modal_height}
    SetModalCapture(capture)
    dismissal: ModalDismissal = ModalOutsideDismissalFor(
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    ReleaseConsumed() != 0,
    CheckCollisionPointRec(mouse_world, capture) != 0)
    result: i32 = 0
    if dismissal.dismissed {
        if dismissal.release_consumed { ConsumeRelease() }
        result = -1
    }
    DrawRectangle(0, 0, ui_view_width, ui_view_height,
    GetColor(Opacity(ColorToInt(scrim_style.background),
    scrim_style.opacity)))
    ui_draw_material(capture, (Rectangle){0},
    panel_style.background, panel_style.border,
    panel_style.border, panel_style.radius,
    panel_style.border_width, 0.0, 0.0, 0,
    panel_style.focus, 0.0, panel_style.opacity,
    ui_style_fill(panel_style), panel_style.material)

    title_font: i32 = ModalFontFor(
    GetTitleFontSize(modal.title, message_width),
    StyleFontValue(title_style.fields, title_style.font_size))
    title: const char* = ModalText(modal.title)
    title_width: i32 = TextWidth(title, title_font)
    RenderText(title, modal_x + (modal_width - title_width) / 2,
    modal_y + metrics.frame_title_y, title_font,
    Fade(title_style.foreground, title_style.opacity))
    message_y: i32 = layout.message_y
    DrawTextLayout(&message_layout, layout.message_x,
    &message_y, message_font,
    Fade(message_style.foreground, message_style.opacity))
    FreeTextLayout(&message_layout)

    commit_pressed: i32 = 0
    if has_prompt {
        field: TextFieldProps = (TextFieldProps){0}
        field.bounds = (Rectangle){(float)layout.message_x,
            (float)layout.prompt_y, (float)message_width,
            (float)metrics.prompt_height}
        field.text = modal.text
        field.text_size = (size_t)modal.text_size
        field.cursor_position = modal.cursor_position
        field_focused: i32 = 0
        if modal.focused != nil { field_focused = *modal.focused }
        field.focused = &field_focused
        field.max_codepoints = modal.text_size - 1
        field.focus_id = ModalPromptFocusIdFor(modal.focus_id)
        field.commit_pressed = &commit_pressed
        ui_text_field_render(field)
        if modal.focused != nil {
            *modal.focused = field_focused != 0
        }
    }

    if result == 0 && modal.close_icon.id != 0 {
        icon_width: i32 = metrics.frame_icon_size +
        metrics.frame_icon_padding * 2
        if ModalIconButton(modal_x + modal_width - icon_width -
        metrics.frame_icon_edge_gap,
        modal_y + metrics.frame_icon_edge_gap,
        metrics.frame_icon_size, metrics.frame_icon_padding,
        modal.close_icon, modal.class_name) {
            result = -1
        }
    }
    if result == 0 && buttons_height > 0 {
        result = ModalDrawActions(modal.actions,
        modal.action_count, layout.message_x, layout.button_y,
        message_width, metrics.button_height,
        metrics.button_gap, button_font, modal.class_name,
        mouse_world, metrics)
    }
    prompt_input: ModalPromptInput = ModalPromptInputFor(
    commit_pressed != 0, IsKeyPressed(KEY_ESCAPE) != 0)
    decision: ModalResultDecision = ModalPromptResultDecisionFor(
    result, has_prompt != 0, prompt_input, modal.action_count)
    return decision.result
}

RenderModalFrame :: (width: i32, height: i32,
title: const char*, left_icon: Texture2D,
right_icon: Texture2D) -> PanelFrame #export {
    editor_id: [96]char
    frame: PanelFrame = (PanelFrame){0}
    metrics: ModalMetrics = ModalMetricsForClass(0)
    layout: ModalFrameLayout = ModalFrameLayoutFor(
    ModalFramePanelFor(ui_view_width, ui_view_height,
    width, height, metrics), metrics)
    name: const char* = "untitled"
    if title != nil && title[0] != '\0' { name = title }
    snprintf(&editor_id[0], 96, "tmp:Modal:%s", name)
    widget: Widget = BeginWidget("Modal", &editor_id[0],
    layout.panel, WidgetFlagMovable | WidgetFlagResizable)
    layout = ModalFrameLayoutFor(widget.bounds, metrics)
    WidgetSetBounds(&widget, layout.panel)
    frame.x = (int)layout.panel.x
    frame.y = (int)layout.panel.y
    frame.w = (int)layout.panel.width
    frame.h = (int)layout.panel.height
    frame.content_x = (int)layout.content.x
    frame.content_y = (int)layout.content.y
    frame.content_w = (int)layout.content.width
    frame.content_h = (int)layout.content.height

    mouse_world: Vector2 = ui_mouse_world()
    SetModalCapture(layout.panel)
    dismissal: ModalDismissal = ModalOutsideDismissalFor(
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    ReleaseConsumed() != 0,
    CheckCollisionPointRec(mouse_world, layout.panel) != 0)
    if dismissal.dismissed {
        if dismissal.release_consumed { ConsumeRelease() }
        frame.right_clicked = 1
    }
    panel_style: Style = ModalRoleStyle(0, ModalPanelRole())
    title_style: Style = ModalRoleStyle(0, ModalTitleRole())
    scrim_style: Style = ModalRoleStyle(0, ModalScrimRole())
    DrawRectangle(0, 0, ui_view_width, ui_view_height,
    GetColor(Opacity(ColorToInt(scrim_style.background),
    scrim_style.opacity)))
    ui_draw_material(layout.panel, (Rectangle){0},
    panel_style.background, panel_style.border,
    panel_style.border, panel_style.radius,
    panel_style.border_width, 0.0, 0.0, 0,
    panel_style.focus, 0.0, panel_style.opacity,
    ui_style_fill(panel_style), panel_style.material)
    title_font: i32 = ModalFontFor(
    GetTitleFontSize(title, layout.title_max_width),
    StyleFontValue(title_style.fields, title_style.font_size))
    safe_title: const char* = ModalText(title)
    title_width: i32 = TextWidth(safe_title, title_font)
    RenderText(safe_title, frame.x + (frame.w - title_width) / 2,
    layout.title_y, title_font,
    Fade(title_style.foreground, title_style.opacity))

    if left_icon.id != 0 {
        frame.left_clicked = ModalIconButton(
        (int)layout.left_button.x, (int)layout.left_button.y,
        layout.icon_size, layout.icon_padding, left_icon, 0)
    }
    if frame.right_clicked == 0 && right_icon.id != 0 {
        frame.right_clicked = ModalIconButton(
        (int)layout.right_button.x, (int)layout.right_button.y,
        layout.icon_size, layout.icon_padding, right_icon, 0)
    }
    EndWidget(&widget)
    return frame
}
