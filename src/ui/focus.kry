#module "focus_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_popup_input_internal.h"
#import "ui_inspect.h"
#import "runtime/focus.h"
#import "runtime/style.h"

FocusLimit :: enum {
    FOCUS_MAX_ITEMS = 256
}

g_ui_focus_active_id :: i32 #global #export
g_ui_focus_ids :: [256]i32 #global #export
g_ui_focus_count :: i32 #global #export
g_ui_focus_tab_dir :: i32 #global #export
g_ui_focus_frame_open :: i32 #global #export
g_ui_focus_pointer_claimed :: i32 #global #export
g_ui_focus_text_input_active :: i32 #global #export
g_ui_text_input_requested :: i32 #global #export
g_ui_text_input_show_requested :: i32 #global #export
g_ui_text_focus_owner :: *i32 #global #export
g_ui_text_focus_frame :: unsigned long #global #export
g_ui_text_focus_owner_frame :: unsigned long #global #export
g_ui_text_focus_owner_this_frame :: *i32 #global #export
g_ui_auto_focus_id :: i32 #global #export

IsKeyboardInputEnabled :: () -> i32 #export {
    return KeyboardInputEnabled() && !ContentDisabled() &&
    !ui_popup_input_keyboard_captures()
}

ResolveFocusID :: (id: i32) -> i32 #export {
    if id != 0 { return id }
    if g_ui_auto_focus_id == 0 { g_ui_auto_focus_id = 0x40000000 }
    resolved: i32 = g_ui_auto_focus_id
    g_ui_auto_focus_id += 1
    return resolved
}

BeginFocusScope :: () #export {
    g_ui_focus_count = 0
    g_ui_focus_pointer_claimed = 0
    g_ui_focus_tab_dir = 0
    g_ui_focus_frame_open = 1
    g_ui_text_focus_frame += 1
    if TextFocusOwnerIsStale(g_ui_text_focus_owner != nil,
    (int64_t)g_ui_text_focus_owner_frame,
    (int64_t)g_ui_text_focus_frame) {
        g_ui_text_focus_owner = nil
    }
    g_ui_text_focus_owner_this_frame = nil
    g_ui_focus_tab_dir = FocusTabDirectionFor(
    IsKeyPressed(KEY_TAB) != 0,
    (IsKeyDown(KEY_LEFT_SHIFT) ||
    IsKeyDown(KEY_RIGHT_SHIFT)) != 0)
}

ui_consume_focus_tab :: () #export {
    g_ui_focus_tab_dir = 0
}

EndFocusScope :: () #export {
    if !g_ui_focus_frame_open { return }
    g_ui_focus_frame_open = 0
    ui_popup_input_retire_missing(ui_popup_input_bound())
    eligible: i32 = 0
    index: i32 = 0
    while index < g_ui_focus_count {
        id: i32 = g_ui_focus_ids[index]
        duplicate: i32 = 0
        if !ui_popup_input_focus_captures(id) {
            previous: i32 = 0
            while previous < eligible {
                if g_ui_focus_ids[previous] == id {
                    duplicate = 1
                    break
                }
                previous += 1
            }
            if !duplicate {
                g_ui_focus_ids[eligible] = id
                eligible += 1
            }
        }
        index += 1
    }
    g_ui_focus_count = eligible
    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
    !g_ui_focus_pointer_claimed {
        ClearFocus()
        ClearTextInputFocus()
    }
    current_index: i32 = -1
    index = 0
    while index < g_ui_focus_count {
        if g_ui_focus_ids[index] == g_ui_focus_active_id {
            current_index = index
            break
        }
        index += 1
    }
    traversal: FocusTraversal = FocusTraversalFor(current_index,
    g_ui_focus_count, g_ui_focus_tab_dir)
    if traversal.clear {
        g_ui_focus_active_id = 0
    } else if traversal.move {
        g_ui_focus_active_id = g_ui_focus_ids[traversal.index]
    }
    g_ui_focus_tab_dir = 0
}

FocusFrameOpen :: () -> i32 #export {
    return g_ui_focus_frame_open
}

ui_register_focus_snapshot :: (id: i32, bounds: Rectangle,
snapshot: PopupInputToken) -> i32 #export {
    if id <= 0 { return 0 }
    focus_point: Vector2 = (Vector2){
        bounds.x + bounds.width * 0.5,
        bounds.y + bounds.height * 0.5}
    ui_popup_input_register_focus(id, snapshot,
    !ContentDisabled() &&
    !InspectInputCapturesClick(focus_point) &&
    !ui_base_input_captures_click(focus_point, 0) &&
    !dropdown_captures(focus_point) &&
    !ui_popup_input_snapshot_captures(snapshot, focus_point))
    if g_ui_focus_count < FOCUS_MAX_ITEMS {
        g_ui_focus_ids[g_ui_focus_count] = id
        g_ui_focus_count += 1
    }
    mouse_world: Vector2 = ui_mouse_world()
    if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
    CheckCollisionPointRec(mouse_world, bounds) &&
    !ui_input_captures_snapshot(mouse_world, snapshot) {
        g_ui_focus_pointer_claimed = 1
        g_ui_focus_active_id = id
    }
    return g_ui_focus_active_id == id
}

RegisterFocus :: (id: i32, bounds: Rectangle) -> i32 #export {
    return ui_register_focus_snapshot(id, bounds,
    ui_popup_input_snapshot())
}

IsFocusActive :: (id: i32) -> i32 #export {
    return id > 0 && g_ui_focus_active_id == id
}

IsFocusActivatePressed :: (id: i32) -> i32 #export {
    return FocusActivationFor(IsFocusActive(id) != 0,
    IsKeyboardInputEnabled() != 0,
    ContentDisabled() != 0,
    ui_popup_input_focus_captures(id) != 0,
    IsKeyPressed(KEY_ENTER) != 0,
    IsKeyPressed(KEY_SPACE) != 0,
    g_ui_focus_text_input_active != 0)
}

SetFocus :: (id: i32) #export {
    g_ui_focus_active_id = id
    if id > 0 && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
        g_ui_focus_pointer_claimed = 1
    }
}

GetFocus :: () -> i32 #export {
    return g_ui_focus_active_id
}

ClearFocus :: () #export {
    g_ui_focus_active_id = 0
}

SetFocusTextInputActive :: (active: i32) #export {
    active = active != 0
    if active {
        g_ui_focus_text_input_active = 1
        g_ui_text_input_requested = 1
    } else {
        g_ui_focus_text_input_active = 0
        g_ui_text_input_requested = 0
    }
}

TextInputActive :: () -> i32 #export {
    return g_ui_focus_text_input_active != 0
}

RenderFocus :: (bounds: Rectangle) #export {
    props: ButtonProps = (ButtonProps){0}
    props.tone = ButtonToneAccent
    props.emphasis = ButtonEmphasisOutline
    frame: StyleFrame = ui_control_style_frame_role_kind(
    props, ButtonStateFocus, 0, 0.0, 0.0, 1.0,
    StyleKindFocus(), FocusBoxRole())
    paint: FocusPaint = FocusPaintFor(bounds,
    (float)GetScale(), frame)
    style: Style = ui_unpack_style(frame.value)
    focus: Color = (style.fields & StyleFocus) != 0 ?
    style.focus : style.border
    DrawRectangleLinesEx(paint.bounds,
    (float)paint.stroke_width,
    Fade(focus, style.opacity))
}
