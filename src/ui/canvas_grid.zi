#import "geometry"

CanvasGridLine :: struct {
    bounds: Rectangle
    color: u32
}

#program_export
CanvasGridSpacing :: (step: s32, minimum: s32) -> s32 {
    if minimum <= 0 {
        minimum = 1
    }
    if step < minimum {
        return minimum
    }
    return step
}

#program_export
CanvasGridLineCount :: (length: float32, spacing: s32) -> s32 {
    if length <= 0.0 {
        return 0
    }
    spacing = CanvasGridSpacing(spacing, 1)
    count: s32 = cast(s32)(length / cast(float32)spacing)
    if cast(float32)count * cast(float32)spacing < length {
        count = count + 1
    }
    return count
}

#program_export
CanvasGridVerticalLine :: (bounds: Rectangle, index: s32,
    spacing: s32, color: u32) -> CanvasGridLine {
    line: CanvasGridLine
    spacing = CanvasGridSpacing(spacing, 1)
    line.bounds.x = bounds.x + cast(float32)(index * spacing)
    line.bounds.y = bounds.y
    line.bounds.width = 0.0
    line.bounds.height = bounds.height
    line.color = color
    return line
}

#program_export
CanvasGridHorizontalLine :: (bounds: Rectangle, index: s32,
    spacing: s32, color: u32) -> CanvasGridLine {
    line: CanvasGridLine
    spacing = CanvasGridSpacing(spacing, 1)
    line.bounds.x = bounds.x
    line.bounds.y = bounds.y + cast(float32)(index * spacing)
    line.bounds.width = bounds.width
    line.bounds.height = 0.0
    line.color = color
    return line
}
