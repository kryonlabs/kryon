#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "link"
#import "link_props"
#import "paint_queue"
#import "semantic"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

#program_export
LinkFaceFor :: (props: LinkProps, state: s32) -> StyleFrame {
    base: StyleData
    base.fields = cast(u32)StyleForeground | cast(u32)StyleFontSize |
        cast(u32)StyleOpacity
    base.foreground = cast(u32)0x2563ebff
    base.font_size = 16.0
    base.opacity = 1.0
    if props.disabled { base.foreground = Opacity(base.foreground, 0.45) }
    facts: StyleFacts = StyleTextFacts(0, props.class_name,
        StyleKindLink(), state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), base,
        facts, state)
    return frame
}

# Navigation is a returned effect. The host opens result.url when open_url is
# true; neither a browser nor a window is required to run this widget.
#program_export
Link :: (props: LinkProps) -> LinkResult {
    result: LinkResult
    result.node = -1
    key: u64 = props.key
    if key == cast(u64)0 && props.focus_id > 0 {
        key = cast(u64)cast(u32)props.focus_id
    }
    if key == cast(u64)0 { key = TreeNextKey() }
    previous: s32 = -1
    if TreeIsBuilding() && key != cast(u64)0 {
        previous = TreeFind(key, TreeCurrentParentKey(),
            WidgetKindLink)
    }
    pointer_activate: bool = TreeTakeActivationAt(previous)
    result.activated = LinkActivated(props.disabled,
        pointer_activate, props.focus_activate)
    result.open_url = result.activated && props.link != ""
    if result.open_url { result.url = props.link }
    hovered: bool = TreeHoveredAt(previous)
    state: s32 = ResolveState(cast(s32)ButtonStateAuto,
        props.disabled, false, TreePressedAt(previous), hovered,
        false, false)
    face: StyleFrame = LinkFaceFor(props, state)
    font: s32 = ResolveFont(0,
        StyleFontValue(face.value.fields, face.value.font_size), 16)
    text_width: s32 = GlyphWidth(props.text, font, face.value.typeface)
    text_height: s32 = GlyphLineHeight(font, face.value.typeface)
    bounds: Rectangle = LinkBoundsFor(props.bounds, text_width,
        text_height, font)
    if TreeIsBuilding() {
        result.node = TreeSubmitCurrent(key, WidgetKindLink, bounds)
        if result.node < 0 { return result }
        TreeSetInteractive(result.node, props.disabled, false,
            props.focus_id)
        TreeSetLabel(result.node, props.text)
        TreeSetSemantic(result.node, cast(SemanticKind)SemanticLink, 0)
    }
    appearance: LinkAppearance = ResolveLinkAppearance(face,
        hovered, props.disabled)
    color: Color = ColorFromPacked(Opacity(appearance.color,
        StyleOpacityValue(face.value.fields, face.value.opacity)))
    if props.text != "" {
        y: s32 = cast(s32)(bounds.y +
            (bounds.height - cast(float32)text_height) * 0.5)
        PaintClippedLabel(result.node, props.text,
            cast(s32)bounds.x, y, font, color, bounds)
    }
    if appearance.underline && text_width > 0 {
        underline_y: s32 = LinkUnderlineYFor(bounds, 1.0)
        PaintLine(result.node,
            Rectangle.{bounds.x, cast(float32)underline_y,
                cast(float32)text_width, 0.0}, color)
    }
    return result
}
