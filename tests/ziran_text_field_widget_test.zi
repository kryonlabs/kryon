#import "session"
#import "widget_test_session"

#import "geometry"
#import "semantic"
#import "text_field_widget"
#import "text_input"
#import "text_input_props"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "widget_kind"
#import "ziran_composition_widget_host"
#import "ziran_system_clipboard_host"
#import "ziran_widget_noop_host"

using SemanticKind;
using WidgetKind;
using CompositionPhase;
using FrameStatus;

phase: s32;
value: string;
cursor: s32;
anchor: s32;
scroll_x: s32;
focused: bool;
ime_active: bool;
ime_cursor: s32;
ime_selection_length: s32;
ime_text: [64]u8;
ime_text_count: s64;

#program_export
Frame :: () -> s32 {
    if phase == 0 {
        value = "AéB"
        cursor = 4
        anchor = 4
        ime_active = false
        ime_cursor = 0
        ime_selection_length = 0
        ime_text_count = 0
    }
    if phase == 8 {
        value = "AéB"
        cursor = 4
        anchor = 1
        focused = true
        ime_active = false
        ime_cursor = 0
        ime_selection_length = 0
        ime_text_count = 0
    }
    if phase == 13 { anchor = 1 }
    if phase == 17 { anchor = 0 }
    frame_value: [256]u8
    frame_value_count: s64 = value.count
    if frame_value_count > 256 { return -28 }
    frame_byte: s64 = 0
    while frame_byte < frame_value_count {
        frame_value[frame_byte] = value[frame_byte]
        frame_byte += 1
    }
    frame_composition_text: [64]u8
    frame_composition_count: s64 = ime_text_count
    if frame_composition_count > 64 { return -29 }
    frame_composition_byte: s64 = 0
    while frame_composition_byte < frame_composition_count {
        frame_composition_text[frame_composition_byte] = ime_text[frame_composition_byte]
        frame_composition_byte += 1
    }
    frame_composition: CompositionState = .{.active = ime_active, .cursor = ime_cursor,
        .selection_length = ime_selection_length}
    frame_composition.text = TextView(frame_composition_text[:frame_composition_count])
    props: TextFieldProps
    props.key = cast(u64)77
    props.bounds = Rectangle.{20.0, 20.0, 220.0, 36.0}
    props.value = TextView(frame_value[:frame_value_count])
    props.label = "Name"
    props.placeholder = "Enter name"
    props.cursor = cursor
    props.anchor = anchor
    props.scroll_x = scroll_x
    props.focused = focused
    props.composition = frame_composition
    props.focus_id = 77
    props.max_bytes = 5
    props.max_codepoints = 4
    if phase == 1 { props.input.text = "Z" }
    if phase == 2 { props.input.left = true }
    if phase == 3 { props.input.backspace = true }
    if phase == 4 { props.input.select_all = true }
    if phase == 5 { props.input.text = "Q" }
    if phase == 6 {
        props.secure = true
        props.display_value = "•"
    }
    if phase == 7 {
        props.disabled = true
        props.input.text = "X"
    }
    if phase == 8 { props.input.copy = true }
    if phase == 9 { props.input.cut = true }
    if phase == 10 {
        props.input.paste = true
        props.input.paste_text = "éB"
    }
    if phase == 11 { props.input.copy = true }
    if phase == 12 {
        props.secure = true
        props.display_value = "•••"
        props.input.copy = true
    }
    if phase == 13 {
        props.read_only = true
        props.input.copy = true
    }
    if phase == 14 {
        props.read_only = true
        props.input.cut = true
    }
    if phase == 15 {
        props.read_only = true
        props.input.paste = true
        props.input.paste_text = "Q"
    }
    if phase == 16 {
        props.input.paste = true
        props.input.paste_text = "Q"
    }
    if phase == 17 {
        props.input.paste = true
        props.input.paste_text = "\n"
    }
    if phase == 18 {
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionStart
        props.input.composition_event.text = "é"
        props.input.composition_event.cursor = 1
        props.input.composition_event.selection_length = 99
        props.input.text = "X"
    }
    if phase == 19 {
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionUpdate
        props.input.composition_event.text = "éx"
        props.input.composition_event.cursor = 3
    }
    if phase == 20 {
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionCommit
        props.input.composition_event.text = "Q"
        props.input.text = "X"
    }
    if phase == 21 {
        props.read_only = true
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionStart
        props.input.composition_event.text = "A"
    }
    if phase == 22 || phase == 24 {
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionStart
        props.input.composition_event.text = "B"
    }
    if phase == 23 {
        props.input.composition_event.phase =
        cast(CompositionPhase)CompositionCancel
    }
    if phase == 25 || phase == 26 { props.input.escape = true }
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 100.0})
    result: TextFieldResult = TextField(TestSession(), props)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || result.node != 1 ||
    TreeNodeAt(TestSession(), result.node).semantic_label != "Name" ||
    TreeNodeAt(TestSession(), result.node).semantic_kind !=
    cast(SemanticKind)SemanticTextField { return -20 }
    if phase == 0 {
        if result.focused || result.edit.changed { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{220.0, 38.0,
                true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{220.0, 38.0,
                false, false, true})
    } else if phase == 1 {
        if !result.focused || !result.edit.changed ||
        result.edit.start != 4 || result.edit.end != 4 ||
        result.edit.replacement != "Z" || result.cursor != 5 {
            return -2
        }
        value = "AéBZ"
    } else if phase == 2 {
        if result.cursor != 4 || result.anchor != 4 ||
        result.edit.changed { return -3 }
    } else if phase == 3 {
        if !result.edit.changed || result.edit.start != 3 ||
        result.edit.end != 4 || result.cursor != 3 {
            return -4
        }
        value = "AéZ"
    } else if phase == 4 {
        if result.cursor != 4 || result.anchor != 0 ||
        result.edit.changed { return -5 }
    } else if phase == 5 {
        if !result.edit.changed || result.edit.start != 0 ||
        result.edit.end != 4 || result.edit.replacement != "Q" ||
        result.cursor != 1 { return -6 }
        value = "Q"
    } else if phase == 6 {
        if !result.focused || result.cursor != 1 ||
        result.edit.changed { return -7 }
    } else if phase == 7 {
        if result.focused || result.edit.changed { return -8 }
    } else if phase == 8 {
        if !result.clipboard_write ||
        result.clipboard_text != "éB" ||
        result.edit.changed { return -9 }
    } else if phase == 9 {
        if !result.clipboard_write ||
        result.clipboard_text != "éB" ||
        !result.edit.changed || result.edit.start != 1 ||
        result.edit.end != 4 || result.cursor != 1 {
            return -10
        }
        value = "A"
    } else if phase == 10 {
        if result.clipboard_write || !result.edit.changed ||
        result.edit.start != 1 || result.edit.end != 1 ||
        result.edit.replacement != "éB" ||
        result.cursor != 4 { return -11 }
        value = "AéB"
    } else if phase == 11 {
        if !result.clipboard_write ||
        result.clipboard_text != "AéB" ||
        result.edit.changed { return -12 }
    } else if phase == 12 {
        if result.clipboard_write || result.edit.changed {
            return -13
        }
    } else if phase == 13 {
        if !result.clipboard_write ||
        result.clipboard_text != "éB" ||
        result.edit.changed { return -14 }
    } else if phase == 14 {
        if result.clipboard_write || result.edit.changed {
            return -15
        }
    } else if phase == 15 {
        if result.clipboard_write || result.edit.changed {
            return -16
        }
    } else if phase == 16 {
        if result.clipboard_write || !result.edit.changed ||
        result.edit.start != 1 || result.edit.end != 4 ||
        result.edit.replacement != "Q" ||
        result.cursor != 2 { return -17 }
        value = "AQ"
    } else if phase == 17 {
        if result.clipboard_write || result.edit.changed ||
        result.cursor != 2 { return -18 }
    } else if phase == 18 {
        sample: CompositionEvent = .{.phase = cast(CompositionPhase)CompositionUpdate,
            .text = "éx", .cursor = 1, .selection_length = 2}
        boundary: CompositionTransition = CompositionTransitionFor(
            CompositionState.{}, sample, true, false)
        if boundary.state.cursor != 0 ||
        boundary.state.selection_length != 3 {
            return -28
        }
        if !result.composition.active ||
        result.composition.text != "é" ||
        result.composition.cursor != 0 ||
        result.composition.selection_length != 2 ||
        !result.composition_changed ||
        result.edit.changed { return -19 }
    } else if phase == 19 {
        if !result.composition.active ||
        result.composition.text != "éx" ||
        result.composition.cursor != 3 ||
        result.edit.changed { return -20 }
    } else if phase == 20 {
        if result.composition.active ||
        !result.composition_changed ||
        !result.edit.changed || result.edit.start != 0 ||
        result.edit.end != 2 ||
        result.edit.replacement != "Q" ||
        result.cursor != 1 { return -21 }
        value = "Q"
    } else if phase == 21 {
        if result.composition.active || result.edit.changed {
            return -22
        }
    } else if phase == 22 {
        if !result.composition.active ||
        result.composition.text != "B" {
            return -23
        }
    } else if phase == 23 {
        if result.composition.active ||
        !result.composition_changed ||
        result.edit.changed { return -24 }
    } else if phase == 24 {
        if !result.composition.active { return -25 }
    } else if phase == 25 {
        if result.composition.active ||
        !result.composition_changed ||
        result.escaped || !result.focused { return -26 }
    } else if phase == 26 {
        if !result.escaped || result.focused {
            return -27
        }
    }
    cursor = result.cursor
    anchor = result.anchor
    scroll_x = result.scroll_x
    focused = result.focused
    if result.composition.text.count > 64 { return -30 }
    incoming_composition: [64]u8
    incoming_composition_count: s64 = result.composition.text.count
    incoming_composition_byte: s64 = 0
    while incoming_composition_byte < incoming_composition_count {
        incoming_composition[incoming_composition_byte] = result.composition.text[incoming_composition_byte]
        incoming_composition_byte += 1
    }
    incoming_composition_byte = 0
    while incoming_composition_byte < incoming_composition_count {
        ime_text[incoming_composition_byte] = incoming_composition[incoming_composition_byte]
        incoming_composition_byte += 1
    }
    ime_text_count = incoming_composition_count
    ime_active = result.composition.active
    ime_cursor = result.composition.cursor
    ime_selection_length = result.composition.selection_length
    old: s32 = phase
    phase += 1
    return old
}

number_session: Session;
number_cursor: s32;
number_anchor: s32;
number_focused: bool;
number_blur: bool;

NumberFrame :: () -> bool {
    props: TextFieldProps = .{.key = cast(u64)78, .bounds = Rectangle.{20.0, 20.0, 120.0, 36.0},
        .value = "1250", .cursor = number_cursor, .anchor = number_anchor,
        .focused = number_focused, .focus_id = 78, .numeric = true}
    props.input.blur = number_blur
    BeginFrame(number_session, cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 100.0})
    result := TextField(number_session, props)
    number_cursor = result.cursor
    number_anchor = result.anchor
    number_focused = result.focused
    return EndFrame(number_session) == cast(FrameStatus)FrameOk
}

// A tap that focuses a numeric field selects the whole number, whether the
// release comes in a later frame or the same one; a tap in the focused field
// places the cursor.
NumberTap :: () -> s32 {
    number_session = SessionOpen()
    if !NumberFrame() || number_focused { return 20 }
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, true, true, false})
    if !NumberFrame() || !number_focused || number_anchor != 0 || number_cursor != 4 { return 21 }
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, true, false, false})
    if !NumberFrame() || number_anchor != 0 || number_cursor != 4 { return 22 }
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, false, false, true})
    if !NumberFrame() || !number_focused || number_anchor != 0 || number_cursor != 4 { return 23 }
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, true, true, false})
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, false, false, true})
    if !NumberFrame() || !number_focused || number_anchor != number_cursor ||
    number_cursor == 4 { return 24 }
    number_blur = true
    if !NumberFrame() || number_focused { return 25 }
    number_blur = false
    number_cursor = 1
    number_anchor = 1
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, true, true, false})
    TreePointerUpdate(number_session, PointerFrame.{30.0, 38.0, false, false, true})
    if !NumberFrame() || !number_focused || number_anchor != 0 || number_cursor != 4 { return 26 }
    unused SessionClose(number_session)
    return 0
}

#program_export
main :: () -> s32 {
    // Editing moves by user-perceived characters; byte ranges remain public.
    complex := "é👨‍👩‍👧‍👦👍🏽🇵🇾"
    if TextFieldNext(complex, 0) != 3 || TextFieldNext(complex, 3) != 28 ||
    TextFieldPrevious(complex, 36) != 28 || TextFieldPrevious(complex, 44) != 36 {
        return 3
    }
    // max_codepoints and secure-display mapping retain scalar semantics.
    if TextFieldCodepoints("é") != 2 || TextFieldByteAfter("é", 1) != 1 { return 4 }
    edit_props: TextFieldProps
    edit_props.value = complex
    edit_props.input.backspace = true
    edit := TextFieldEditFor(edit_props, 28, 28)
    if !edit.changed || edit.start != 3 || edit.end != 28 { return 5 }
    edit_props.input.backspace = false
    edit_props.input.delete_forward = true
    edit = TextFieldEditFor(edit_props, 28, 28)
    if !edit.changed || edit.start != 28 || edit.end != 36 { return 6 }
    // A numeric field takes digits only, typed, pasted or replaced whole.
    number_props: TextFieldProps = .{.numeric = true, .value = "12", .max_codepoints = 4}
    if !TextFieldReplacementAllowed(number_props, 2, 2, "34") ||
    TextFieldReplacementAllowed(number_props, 2, 2, "3a") ||
    TextFieldReplacementAllowed(number_props, 0, 2, "-5") ||
    TextFieldReplacementAllowed(number_props, 2, 2, "345") ||
    !TextFieldReplacementAllowed(number_props, 0, 2, "") { return 7 }
    number_props.input.text = "x"
    if TextFieldEditFor(number_props, 2, 2).changed { return 8 }
    number_props.input.text = "7"
    if !TextFieldEditFor(number_props, 2, 2).changed { return 9 }
    index: s32 = 0
    while index < 27 {
        SetCompositionPhase(index)
        if Frame() != index { return 1 }
        index += 1
    }
    if FieldPreeditPaints() <= 0 || FieldUnderlinePaints() <= 0 {
        return 2
    }
    number_result := NumberTap()
    if number_result != 0 { return number_result }
    // An opt-in clear button appears for text, returns one complete edit and
    // disappears when the caller applies it. The field keeps keyboard focus.
    clear_session := SessionOpen()
    clear_props: TextFieldProps = .{.key = 90, .bounds = Rectangle.{10.0, 10.0, 240.0, 48.0},
        .value = "Find me", .clear_label = "Clear search"}
    TreeStart(clear_session, 1, Rectangle.{0.0, 0.0, 300.0, 160.0})
    unused TextField(clear_session, clear_props)
    if !TreeFinish(clear_session) { return 40 }
    clear_node := TreeHitAt(clear_session, 225.0, 34.0)
    if TreeNodeAt(clear_session, clear_node).kind != WidgetKindButton { return 41 }
    TreePointerUpdate(clear_session, PointerFrame.{225.0, 34.0, true, true, true})
    TreeStart(clear_session, 1, Rectangle.{0.0, 0.0, 300.0, 160.0})
    cleared := TextField(clear_session, clear_props)
    if !TreeFinish(clear_session) { return 42 }
    if !cleared.edit.changed || cleared.edit.start != 0 || cleared.edit.end != 7 ||
    cleared.edit.replacement != "" || !cleared.focused || cleared.cursor != 0 ||
    cleared.anchor != 0 || cleared.scroll_x != 0 { return 43 }
    clear_props.value = ""
    TreeStart(clear_session, 1, Rectangle.{0.0, 0.0, 300.0, 160.0})
    unused TextField(clear_session, clear_props)
    if !TreeFinish(clear_session) { return 44 }
    if TreeNodeAt(clear_session, TreeHitAt(clear_session, 225.0, 34.0)).kind !=
    WidgetKindTextField { return 45 }
    unused SessionClose(clear_session)
    return 0
}
