#module "slider"
#import "button"
#import "control_props"
#import "drawing_props"
#import "style"
#import "surface"
#import "theme"

SliderSpec :: struct {
    bounds: Rectangle
    ratio: float
    vertical: bool
    active: bool
    hovered: bool
    disabled: bool
    scale: float
    palette: Palette
    metrics: Metrics
}

SliderPaint :: struct {
    bounds: Rectangle
    track_bounds: Rectangle
    active_bounds: Rectangle
    thumb_x: float
    thumb_y: float
    thumb_radius: float
    glow_radius: float
    glow_color: u32
    thumb_fill_color: u32
    thumb_edge_color: u32
    thumb_shadow_color: u32
    thumb_highlight_color: u32
    track: StyleFrame
    active_track: StyleFrame
}

SliderScalarStep :: struct {
    value: float
    changed: bool
}

SliderWholeStep :: struct {
    value: i32
    changed: bool
}

SliderMinimumLength :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(32.0 * scale)
}

SliderThumbSize :: (scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return (i32)(22.0 * scale)
}

SliderTrackSize :: (vertical: bool, scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    if vertical { return (i32)(8.0 * scale) }
    return (i32)(6.0 * scale)
}

SliderClampRatio :: (ratio: float) -> float #export {
    if ratio < 0.0 { return 0.0 }
    if ratio > 1.0 { return 1.0 }
    return ratio
}

SliderScalarRatio :: (value: float, minimum: float, maximum: float) -> float #export {
    span: float = maximum - minimum
    if span <= 0.0 { return 0.0 }
    return SliderClampRatio((value - minimum) / span)
}

SliderScalarValue :: (minimum: float, maximum: float, ratio: float) -> float #export {
    span: float = maximum - minimum
    if span <= 0.0 { return minimum }
    return minimum + SliderClampRatio(ratio) * span
}

SliderScalarKeyboardValue :: (value: float, minimum: float, maximum: float,
    direction: i32, home: bool, end: bool, alt: bool, shift: bool) -> SliderScalarStep #export {
    result: SliderScalarStep
    result.value = value
    result.changed = false
    span: float = maximum - minimum
    if span <= 0.0 { return result }
    next: float = value
    if home {
        next = minimum
    } else if end {
        next = maximum
    } else if direction != 0 {
        step: float = span * 0.01
        if alt { step = step * 0.1 }
        if shift { step = step * 10.0 }
        next = next + (float)direction * step
        if next < minimum { next = minimum }
        if next > maximum { next = maximum }
    }
    result.value = next
    result.changed = next != value
    return result
}

SliderWholeRatio :: (value: i32, minimum: i32, maximum: i32) -> float #export {
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return 0.0 }
    return SliderClampRatio((float)((i64)value - (i64)minimum) / (float)span)
}

SliderWholeValue :: (minimum: i32, maximum: i32, ratio: float) -> i32 #export {
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return minimum }
    return (i32)((i64)minimum + (i64)(SliderClampRatio(ratio) * (float)span + 0.5))
}

SliderWholeKeyboardValue :: (value: i32, minimum: i32, maximum: i32,
    direction: i32, home: bool, end: bool, alt: bool, shift: bool) -> SliderWholeStep #export {
    result: SliderWholeStep
    result.value = value
    result.changed = false
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return result }
    next: i64 = (i64)value
    if home {
        next = (i64)minimum
    } else if end {
        next = (i64)maximum
    } else if direction != 0 {
        step: i64 = 1
        if span > 100 { step = (span + 50) / 100 }
        if alt {
            step = step / 10
            if step < 1 { step = 1 }
        }
        if shift { step = step * 10 }
        next = next + (i64)direction * step
        if next < (i64)minimum { next = (i64)minimum }
        if next > (i64)maximum { next = (i64)maximum }
    }
    result.value = (i32)next
    result.changed = result.value != value
    return result
}

SliderPaintFor :: (spec: SliderSpec) -> SliderPaint #export {
    paint: SliderPaint
    scale: float = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    ratio: float = SliderClampRatio(spec.ratio)
    bounds: Rectangle = spec.bounds
    min_length: float = (float)SliderMinimumLength(scale)
    thumb_size: float = (float)SliderThumbSize(scale)
    track_size: float = (float)SliderTrackSize(spec.vertical, scale)
    if spec.vertical {
        if bounds.height < min_length { bounds.height = min_length }
        if bounds.width < thumb_size { bounds.width = thumb_size }
        paint.track_bounds.x = bounds.x + (bounds.width - track_size) * 0.5
        paint.track_bounds.y = bounds.y
        paint.track_bounds.width = track_size
        paint.track_bounds.height = bounds.height
        position_y: float = paint.track_bounds.y + paint.track_bounds.height * (1.0 - ratio)
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = position_y
        paint.active_bounds.width = paint.track_bounds.width
        paint.active_bounds.height = paint.track_bounds.y + paint.track_bounds.height - position_y
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * 0.5
        paint.thumb_y = position_y
    } else {
        if bounds.width < min_length { bounds.width = min_length }
        if bounds.height < thumb_size { bounds.height = thumb_size }
        paint.track_bounds.x = bounds.x
        paint.track_bounds.y = bounds.y + (bounds.height - track_size) * 0.5
        paint.track_bounds.width = bounds.width
        paint.track_bounds.height = track_size
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = paint.track_bounds.y
        paint.active_bounds.width = paint.track_bounds.width * ratio
        paint.active_bounds.height = paint.track_bounds.height
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * ratio
        paint.thumb_y = paint.track_bounds.y + paint.track_bounds.height * 0.5
    }
    paint.bounds = bounds
    paint.thumb_radius = thumb_size * 0.5
    paint.glow_radius = paint.thumb_radius + 8.0 * scale

    state: i32 = ButtonStateNormal
    if spec.hovered { state = ButtonStateHover }
    if spec.active { state = ButtonStatePressed }
    styles: StyleStates
    paint.track = ResolveFrame(ButtonToneNeutral, ButtonEmphasisSoft, state,
        ControlSizeMedium, true, false, spec.disabled, false, false,
        spec.palette, spec.metrics, styles, false, 0.0, 0.0, 0.0)
    paint.active_track = ResolveFrame(ButtonToneAccent, ButtonEmphasisFilled,
        state, ControlSizeMedium, true, false, spec.disabled, false, false,
        spec.palette, spec.metrics, styles, false, 0.0, 0.0, 0.0)

    white: u32 = PackedColor((u32)0xFFFFFF, (u32)255)
    paint.thumb_fill_color = paint.active_track.value.background
    paint.thumb_edge_color = GradientColor(paint.active_track.value.background, white, 0.50)
    paint.thumb_shadow_color = Opacity(spec.palette.shadow, spec.disabled ? 0.28 : 0.60)
    paint.thumb_highlight_color = Opacity(white, spec.disabled ? 0.08 : 0.20)
    paint.glow_color = Opacity(paint.active_track.value.background,
        spec.active ? 0.32 : (spec.hovered ? 0.18 : 0.0))
    if spec.disabled {
        paint.thumb_fill_color = Opacity(paint.thumb_fill_color, 0.45)
        paint.thumb_edge_color = Opacity(paint.thumb_edge_color, 0.38)
    }
    return paint
}
