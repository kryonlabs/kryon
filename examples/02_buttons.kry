    emphases: [8] ButtonEmphasis = {
        ButtonEmphasisFilled, ButtonEmphasisSoft, ButtonEmphasisOutline, ButtonEmphasisGhost,
        ButtonEmphasisFilled, ButtonEmphasisFilled, ButtonEmphasisFilled, ButtonEmphasisLink
