#if #defined(PLATFORM_WEB) {
    // Browser asset audio using owned WebAudio buffers and streams.
    #import "media_audio_host"
    #import "media_audio"
    #import "std/byte_text_linux"
    audio_c :: #system_library "c";
    AssetAudioAllocate :: (count: usize, size: usize) -> *void #foreign audio_c "calloc";
    AssetAudioFree :: (value: *void) #foreign audio_c "free";
    #import "canvas_audio_engine"
    #import "canvas_audio_host"
    AssetAudioResource :: struct { id: s32; pcm: bool; rate: s32; channels: s32; frames: s32; }
    AssetAudioDevice :: () -> MediaAudioCode {
        state := AudioHostState()
        if state == 0 { return .Unavailable }
        if state == 2 { return .Suspended }
        return .Ok
    }
    AssetAudioDispose :: (resource: *AssetAudioResource) {
        if resource == null { return }
        if resource.pcm {
            AudioEngineStreamFree(resource.id)
            AssetAudioFree(cast(*void)resource)
            return
        }
        AudioEngineMusicStop(resource.id)
        AudioEngineRelease(resource.id)
        AssetAudioFree(cast(*void)resource)
    }
    AssetAudioReply :: (voice: *MediaAudioVoice, code: MediaAudioCode = .Ok) -> MediaAudioResult {
        return .{.code = code, .state = voice.state, .capabilities = cast(u32)127,
            .message = ifx code == .Suspended then "Audio context suspended; a user gesture may be required" else
            ifx code == .Unavailable then "Audio device unavailable" else ""}
    }
    AssetAudioRefresh :: (voice: *MediaAudioVoice, resource: *AssetAudioResource) {
        if voice.state == .Playing {
            playing: bool
            playing = AudioEngineMusicPlaying(resource.id) != 0
            if !playing { voice.state = .Finished }
        }
    }
    AssetAudioProvider :: (voice: *MediaAudioVoice, command: MediaAudioCommand, bytes: string) -> MediaAudioResult {
        resource := cast(*AssetAudioResource)voice.resource
        if command.operation == .Unload {
            AssetAudioDispose(resource)
            voice.* = MediaAudioVoice.{}
            return AssetAudioReply(voice)
        }
        if voice.pcm || command.operation == .CreateStream { return PcmAudioProvider(voice, command) }
        if command.operation == .Stop {
            AudioEngineMusicStop(resource.id)
            voice.state = .Stopped
            return AssetAudioReply(voice)
        }
        if command.operation == .Pause || command.operation == .Resume {
            AssetAudioRefresh(voice, resource)
            if command.operation == .Pause && voice.state == .Paused { return AssetAudioReply(voice) }
            if command.operation == .Resume && voice.state == .Playing {
                return AssetAudioReply(voice, AssetAudioDevice())
            }
            if command.operation == .Pause && voice.state != .Playing { return AssetAudioReply(voice, .Invalid) }
            if command.operation == .Resume && voice.state != .Paused { return AssetAudioReply(voice, .Invalid) }
            if command.operation == .Resume {
                ready := AssetAudioDevice()
                if ready != .Ok { return AssetAudioReply(voice, ready) }
            }
            if command.operation == .Pause { AudioEngineMusicPause(resource.id) }
            else {
                AudioEngineMusicResume(resource.id)
                if AudioEngineMusicPlaying(resource.id) == 0 { return AssetAudioReply(voice, .Failed) }
            }
            voice.state = ifx command.operation == .Pause then MediaAudioState.Paused else MediaAudioState.Playing
        }
        device := AssetAudioDevice()
        if device != .Ok && command.operation != .Status && command.operation != .Pause { return AssetAudioReply(voice, device) }
        if command.operation == .Capabilities { return AssetAudioReply(voice) }
        if command.operation == .Load {
            resource = cast(*AssetAudioResource)AssetAudioAllocate(1, size_of(AssetAudioResource))
            if resource == null { return AssetAudioReply(voice, .Limit) }
            data := cast(*TextDescriptor)(*bytes)
            resource.id = AudioEngineLoadMemory(data.data, cast(s32)bytes.count)
            if resource.id == 0 { AssetAudioFree(cast(*void)resource); return AssetAudioReply(voice, .Failed) }
            AudioEngineBufferVolume(resource.id, command.gain)
            voice.resource = cast(*void)resource
            voice.music = command.music
            voice.gain = command.gain
            voice.state = .Ready
        } else if command.operation == .Play {
            if command.looping && !voice.music { return AssetAudioReply(voice, .Invalid) }
            AudioEngineMusicStop(resource.id)
            AudioEngineMusicPlay(resource.id, ifx command.looping then 1 else 0)
            voice.state = .Playing
        } else if command.operation == .Gain {
            AudioEngineBufferVolume(resource.id, command.gain)
            voice.gain = command.gain
        } else if command.operation != .Status && command.operation != .Pause && command.operation != .Resume { return AssetAudioReply(voice, .Invalid) }
        AssetAudioRefresh(voice, resource)
        reply := AssetAudioReply(voice, ifx command.operation == .Status then device else MediaAudioCode.Ok)
        if voice.music {
            position: float64
            position = AudioEngineMusicPosition(resource.id)
            if position - position == 0.0 && position >= 0.0 {
                reply.has_position = true
                reply.position_seconds = position
            }
        }
        return reply
    }
    MediaAudioUseWeb :: () { MediaAudioUseProvider(AssetAudioProvider) }
    // Open-ended streams never finish on underrun: the device emits silence until
    // another complete block arrives. Only Stop/Play or Unload changes that state.
    PcmAudioProvider :: (voice: *MediaAudioVoice, command: MediaAudioCommand) -> MediaAudioResult {
        resource := cast(*AssetAudioResource)voice.resource
        if command.operation == .Stop {
            AudioEngineStreamStop(resource.id)
            voice.state = .Stopped
            return AssetAudioReply(voice)
        }
        if command.operation == .Pause || command.operation == .Resume {
            if command.operation == .Pause && voice.state == .Paused { return AssetAudioReply(voice) }
            if command.operation == .Resume && voice.state == .Playing {
                return AssetAudioReply(voice, AssetAudioDevice())
            }
            if command.operation == .Pause && voice.state != .Playing { return AssetAudioReply(voice, .Invalid) }
            if command.operation == .Resume && voice.state != .Paused { return AssetAudioReply(voice, .Invalid) }
            if command.operation == .Resume {
                ready := AssetAudioDevice()
                if ready != .Ok { return AssetAudioReply(voice, ready) }
            }
            if command.operation == .Pause { AudioEngineStreamPause(resource.id) }
            else {
                AudioEngineStreamResume(resource.id)
                if AudioEngineStreamPlaying(resource.id) == 0 { return AssetAudioReply(voice, .Failed) }
            }
            voice.state = ifx command.operation == .Pause then MediaAudioState.Paused else MediaAudioState.Playing
        }
        device := AssetAudioDevice()
        if device != .Ok && command.operation != .Status && command.operation != .Pause { return AssetAudioReply(voice, device) }
        if command.operation == .CreateStream {
            resource = cast(*AssetAudioResource)AssetAudioAllocate(1, size_of(AssetAudioResource))
            if resource == null { return AssetAudioReply(voice, .Limit) }
            resource.pcm = true
            resource.rate = command.sample_rate
            resource.channels = command.channels
            resource.frames = command.frames_per_block
            resource.id = AudioEngineStreamCreate(resource.rate, 16, resource.channels)
            if resource.id == 0 { AssetAudioFree(cast(*void)resource); return AssetAudioReply(voice, .Limit) }
            AudioEngineStreamVolume(resource.id, command.gain)
            voice.resource = cast(*void)resource
            voice.pcm = true
            voice.block_bytes = resource.frames * resource.channels * 2
            voice.gain = command.gain
            voice.state = .Ready
        } else if command.operation == .Play {
            if command.looping { return AssetAudioReply(voice, .Invalid) }
            AudioEngineStreamStop(resource.id); AudioEngineStreamPlay(resource.id)
            voice.state = .Playing
        } else if command.operation == .Gain {
            AudioEngineStreamVolume(resource.id, command.gain)
            voice.gain = command.gain
        } else if command.operation != .Status && command.operation != .SubmitStream && command.operation != .Pause && command.operation != .Resume { return AssetAudioReply(voice, .Invalid) }
        writable: bool
        if voice.state == .Playing && device == .Ok {
            writable = AudioEngineStreamProcessed(resource.id) != 0
        }
        if command.operation == .SubmitStream {
            if voice.state != .Playing { return AssetAudioReply(voice, .Invalid) }
            if !writable { return AssetAudioReply(voice, .Backpressure) }
            // Copy this block into the engine's owned storage.
            data := cast(*TextDescriptor)(*command.pcm)
            if AudioEngineStreamUpdate(resource.id, cast(*void)data.data, resource.frames, resource.rate, 16, resource.channels) == 0 {
                return AssetAudioReply(voice, .Failed)
            }
            writable = AudioEngineStreamProcessed(resource.id) != 0
        }
        reply := AssetAudioReply(voice, ifx command.operation == .Status then device else MediaAudioCode.Ok)
        reply.writable = writable
        return reply
    }
}
