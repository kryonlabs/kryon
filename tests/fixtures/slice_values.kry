#module "slice_values"
#import "slice_helpers"

Action :: () #slot

Box :: struct {
    values: [2]i32
}

backing :: [2]i32 #global

Global :: () -> []i32 {
    return backing[:]
}

Tail :: (view: []i32) -> []i32 {
    view = view[1:]
    return view
}

Change :: (view: []i32) {
    view[0] = 19
}

Check :: () -> i32 #export {
    values: [4]i32 = {2, 4, 6, 8}
    view := values[1:3]
    if view.length != 2 { return 1 }
    view[0] = 11
    if values[1] != 11 { return 2 }
    alias := view
    alias[1] = 13
    if values[2] != 13 { return 3 }
    view = values[:1]
    if alias.length != 2 || view.length != 1 { return 4 }
    Change(Tail(alias))
    if values[2] != 19 { return 5 }
    empty: []i32
    if empty.length != 0 { return 6 }
    empty = empty[:]
    if empty.length != 0 { return 14 }
    empty = values[4:]
    if empty.length != 0 { return 7 }
    next: i32 = 0
    ordered := values[next++:next++]
    if ordered.length != 1 || next != 2 { return 8 }
    chosen := Pick(view, alias, false)
    Recursive(chosen, 3)[0] = 23
    if values[1] != 23 { return 9 }
    box: Box
    field := box.values[:]
    field[1] = 29
    if box.values[1] != 29 { return 10 }
    words: [2]string = {"one", "two"}
    text := words[:]
    text[0] = "three"
    if words[0] != "three" { return 11 }
    boxes: [2]Box
    records := boxes[:]
    records[0].values[0] = 31
    if boxes[0].values[0] != 31 { return 12 }
    stable := Global()
    stable[0] = 37
    if Global()[0] != 37 { return 13 }
    update: Action = () #slot {
        chosen[0] = 41
    }
    update()
    if values[1] != 41 { return 15 }
    return 0
}

Read :: (index: i32) -> i32 #export {
    values: [2]i32 = {7, 9}
    view := values[:]
    return view[index]
}

Range :: (low: i32, high: i32) -> i32 #export {
    values: [2]i32
    view := values[low:high]
    return view.length
}

Write :: (index: i32) -> i32 #export {
    values: [2]i32
    view := values[:]
    view[index] = 5
    return values[0]
}
