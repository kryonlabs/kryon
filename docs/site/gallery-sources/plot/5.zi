using UI :: #import "kryon/Widgets";
Plot :: #import "plot/PlotWidget";
Charts :: #import "plot/Plot";
Theme :: #import "kryon/theme";
using Example :: #import "plot_examples";
#import "palette"
#import "preview_protocol"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = "BandChart", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 5
    InstallStyles(example_input.theme == 2)
    Prepare(session, scene)
    points: [8]Charts.BandChartPoint
    for index: cast(s32)0..7 { points[index] = Charts.BandChartPoint.{.slot = index, .value = values[index], .good = ifx values[index] >= 4.0 && values[index] <= 9.0 then 1 else 0, .label = "Hover or tap a point"} }
    bands: [1]Charts.BandChartBand
    bands[0] = .{.low = 4.0, .high = 9.0, .has_low = true, .has_high = true}
    unused Charts.BandChart(session, Charts.BandChartProps.{.key = 600, .bounds = bounds, .semantic_label = "Values and a target band", .slots = 8, .min_value = 0.0, .max_value = 12.0, .top_label = "12", .bottom_label = "0", .font = 14, .good_color = .{35, 115, 92, 255}, .other_color = .{180, 125, 70, 255}, .band_color = .{131, 181, 160, 80}, .grid_color = .{180, 200, 210, 150}, .text_color = StyleTokenColor("text"), .label_fill = StyleTokenColor("surface")}, points[:], bands[:])

    return 0
}
