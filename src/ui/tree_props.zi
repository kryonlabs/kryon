Text :: (props: TextProps) #extern #export
Paragraph :: (paragraph: ParagraphSpec, x: i32, y: *i32) #extern #export
Box :: (bounds: Rectangle, fill: Color, border: Color) #extern #export
Circle :: (center_x: i32, center_y: i32, radius: i32, color: Color) #extern #export
