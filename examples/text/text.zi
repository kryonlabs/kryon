Layout :: #import "kryon/layout";
Text :: #import "kryon/text";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/text_selection"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    TextSelectionEnable()
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Text", .size = 28})
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 56}, .text = "Make room for good ideas", .size = 24})
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 144}, .text = "Select and copy this text. Unicode works here too: café, Ω, é.", .size = 18, .selectable = true})
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
