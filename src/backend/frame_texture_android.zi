// NativeActivity route captures use the same managed pixels the Pixmap host
// draws for Image, with a host owner outside the UI session slot range.
#import "android_native"
#import "drawing_props"
Surface :: #import "frame_surface";
Bitmaps :: #import "bitmap_store";
#import "std/vec"

ANDROID_FRAME_OWNER :: Bitmaps.BITMAP_IMAGE_HOST_OWNER
android_frame_epoch: u64;

AndroidFrameTextureSlot :: (texture: Texture2D) -> s32 {
    index := Bitmaps.BitmapSlot(texture.id)
    if index < 0 { return -1 }
    item := *Bitmaps.bitmap_images[index]
    return Bitmaps.BitmapOwnedSlot(ANDROID_FRAME_OWNER, item.owner_epoch, texture)
}
AndroidFrameTextureCopy :: (width: s32, height: s32, pixels: []u32) -> Texture2D {
    count := Bitmaps.BitmapPixelCount(width, height)
    if count <= 0 || pixels.count < count || android_frame_epoch == cast(u64)18446744073709551615 { return .{} }
    rgba: Vec(u8)
    if !VecResizeBounded(rgba, count * 4, count * 4) { return .{} }
    defer VecFree(rgba)
    for at: cast(s64)0..count - 1 {
        pixel := pixels[at]
        rgba[at * 4] = cast(u8)(pixel >> 16)
        rgba[at * 4 + 1] = cast(u8)(pixel >> 8)
        rgba[at * 4 + 2] = cast(u8)pixel
        rgba[at * 4 + 3] = cast(u8)(pixel >> 24)
    }
    android_frame_epoch += cast(u64)1
    return Bitmaps.BitmapCreateOwned(ANDROID_FRAME_OWNER, android_frame_epoch, width, height, rgba[:])
}

#program_export
FramePreviousSnapshotHost :: () -> Surface.FrameSurface {
    texture := AndroidFrameTextureCopy(android_pixel_width, android_pixel_height, AndroidNativePixels())
    return Surface.FrameSurface.{texture, true}
}

#program_export
CopyFrameTexture :: (texture: Texture2D) -> Texture2D {
    index := AndroidFrameTextureSlot(texture)
    if index < 0 { return .{} }
    item := *Bitmaps.bitmap_images[index]
    return AndroidFrameTextureCopy(texture.width, texture.height, item.pixels[:])
}

#program_export
DisposeFrameTexture :: (texture: Texture2D) {
    index := AndroidFrameTextureSlot(texture)
    if index >= 0 { Bitmaps.BitmapDrop(index) }
}

AndroidFrameTexturesClose :: () {
    for at: cast(s32)0..Bitmaps.BITMAP_IMAGE_LIMIT - 1 {
        if Bitmaps.bitmap_images[at].owner_slot == ANDROID_FRAME_OWNER { Bitmaps.BitmapDrop(at) }
    }
}
