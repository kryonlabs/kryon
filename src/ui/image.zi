#module "image"
#import "drawing_props"
#import "geometry"
#import "image_props"

# Matches the ImageFit host contract without exporting a second public enum.
ImagePlaceholderLayout :: struct {
    bounds: Rectangle
    label_x: i32
    label_y: i32
}

ImageLabelRole :: () -> i32 #export {
    return 6
}

ImageFitRect :: (image: ImageProps, texture: Texture2D) -> Rectangle #export {
    return ImageFitBounds(image.bounds, image.source,
        texture.width, texture.height, (i32)image.fit)
}

ImageDrawPlan :: struct {
    draw: bool
    source: Rectangle
    destination: Rectangle
    tint: Color
}

ImageDrawPlanFor :: (image: ImageProps, texture: Texture2D,
    tint: Color) -> ImageDrawPlan #export {
    plan: ImageDrawPlan
    if texture.id == (u32)0 || texture.width <= 0 ||
        texture.height <= 0 || image.bounds.width <= 0.0 ||
        image.bounds.height <= 0.0 {
        return plan
    }
    plan.draw = true
    plan.source = image.source
    if plan.source.width == 0.0 || plan.source.height == 0.0 {
        plan.source = (Rectangle){0.0, 0.0,
            (float)texture.width, (float)texture.height}
    }
    plan.destination = ImageFitRect(image, texture)
    plan.tint = tint
    if plan.tint.a == (u8)0 {
        plan.tint = (Color){(u8)255, (u8)255, (u8)255, (u8)255}
    }
    return plan
}

ImageFitBounds :: (bounds: Rectangle, source: Rectangle,
    texture_width: i32, texture_height: i32, fit: i32) -> Rectangle #export {
    dst: Rectangle = bounds
    src_w: float = source.width
    src_h: float = source.height

    if src_w < 0.0 { src_w = -src_w }
    if src_h < 0.0 { src_h = -src_h }
    if src_w == 0.0 { src_w = (float)texture_width }
    if src_h == 0.0 { src_h = (float)texture_height }

    if fit == 1 || fit == 2 {
        if src_w == 0.0 || src_h == 0.0 {
            return dst
        }
        sx: float = bounds.width / src_w
        sy: float = bounds.height / src_h
        scale: float = sx
        if fit == 2 {
            if sy > scale { scale = sy }
        } else {
            if sy < scale { scale = sy }
        }
        dst.width = src_w * scale
        dst.height = src_h * scale
        dst.x = bounds.x + (bounds.width - dst.width) * 0.5
        dst.y = bounds.y + (bounds.height - dst.height) * 0.5
    }
    return dst
}

ImagePlaceholderLayoutFor :: (bounds: Rectangle, text_width: i32,
    font_height: i32) -> ImagePlaceholderLayout #export {
    layout: ImagePlaceholderLayout
    layout.bounds = bounds
    layout.label_x = (i32)bounds.x + ((i32)bounds.width - text_width) / 2
    layout.label_y = (i32)bounds.y + ((i32)bounds.height - font_height) / 2
    return layout
}

ImagePlaceholderFontFor :: (default_font: i32, style_font: i32) -> i32 #export {
    if style_font > 0 { return style_font }
    return default_font
}

# Maps a clipped destination strip back to the corresponding texture source.
# The image host uses this when drawing rounded or otherwise clipped images.
ImageStripSource :: (source_base: Rectangle, dst: Rectangle,
    strip: Rectangle) -> Rectangle #export {
    source: Rectangle
    if dst.width == 0.0 || dst.height == 0.0 {
        return source
    }
    source.x = source_base.x +
        (strip.x - dst.x) * source_base.width / dst.width
    source.y = source_base.y +
        (strip.y - dst.y) * source_base.height / dst.height
    source.width = strip.width * source_base.width / dst.width
    source.height = strip.height * source_base.height / dst.height
    return source
}
