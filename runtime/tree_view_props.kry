#module "tree_view_props"
#import "kryon_compat.generated.h"

TreeItem :: struct {
    label: const char*
    depth: i32
    id: i32
    expanded: i32
    selectable: i32
}

TreeViewProps :: struct {
    bounds: Rectangle
    id: i32
    items: const TreeItem*
    item_count: i32
    selected_id: *i32
    scroll_offset: *i32
    row_height: i32
    disabled: bool
}
