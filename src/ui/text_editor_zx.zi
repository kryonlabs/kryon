// Portable editor policy belongs to programs with editing widgets. The
// frame loop reaches it through text_host, without retaining edit buffers
// or request queues in a program that only draws labels.
#if TARGET == .ZX {
#import "session"
#import "text_host"
#import "text_request"
#import "tree"
#import "tree_input"
#import "widget_kind"
using WidgetKind;
bundle_editor_owner: Session;
bundle_editor_identity: u64;
bundle_editor_bytes: [65536]u8;
bundle_editor_count: s32;
bundle_editor_cursor: s32;
bundle_editor_anchor: s32;
bundle_editor_flags: s32;

BundleEditorPresent :: (session: Session, index: s32, value: string,
    cursor: s32, anchor: s32, secure: bool, numeric: bool, read_only: bool,
    edited: bool) {
    if bundle_editor_owner.slot != session.slot || bundle_editor_owner.epoch != session.epoch { return }
    node := TreeSubmittedNodeAt(session, index)
    if read_only || !node.selected || node.disabled || !node.has_text ||
    value.count > bundle_editor_bytes.count { return }
    for at: 0..value.count - 1 { bundle_editor_bytes[at] = value[at] }
    bundle_editor_count = cast(s32)value.count
    bundle_editor_identity = node.identity_generation
    // On an edit frame the caller still owns the preceding value. Native
    // editors defer acknowledgement until the next value is submitted.
    bundle_editor_cursor = ifx edited then 0 else cursor
    bundle_editor_anchor = ifx edited then 0 else anchor
    bundle_editor_flags = (ifx secure then 1 else 0) | (ifx numeric then 2 else 0) |
        (ifx node.kind == WidgetKindTextArea then 4 else 0) | (ifx edited then 8 else 0)
}

BundleEditorRequest :: (session: Session) {
    request := TextHostEditorRequest(bundle_editor_identity)
    if !request.pending || bundle_editor_identity == 0 { return }
    for index: cast(s32)1..TreeCount(session) - 1 {
        node := TreeNodeAt(session, index)
        if node.identity_generation == bundle_editor_identity && node.selected &&
        TreeInputAllowedAt(session, index) &&
        (!TreeHasFocus(session) || TreeFocusedAt(session, index)) {
            unused TextRequestSend(session, index, request.value,
                request.replace, request.cursor, request.anchor)
            return
        }
    }
}

BundleEditorBegin :: (session: Session) {
    if bundle_editor_owner.slot != session.slot || bundle_editor_owner.epoch != session.epoch {
        bundle_editor_identity = 0
    }
    bundle_editor_owner = session
    BundleEditorRequest(session)
    bundle_editor_identity = 0
    bundle_editor_count = 0
    bundle_editor_cursor = 0
    bundle_editor_anchor = 0
    bundle_editor_flags = 0
}

BundleEditorEnd :: (session: Session, x: float32, y: float32, pressed: bool) {
    // A platform sees only committed, still-focused field identities.
    if bundle_editor_identity != 0 {
        found := false
        for index: cast(s32)1..TreeCount(session) - 1 {
            node := TreeNodeAt(session, index)
            if node.identity_generation == bundle_editor_identity && node.selected &&
            TreeInputAllowedAt(session, index) &&
            (!TreeHasFocus(session) || TreeFocusedAt(session, index)) {
                found = true
                // Reopening an OS keyboard needs a fresh hit on the actual
                // committed guest field, including clipping/overlay routing.
                if pressed && TreeHitAt(session, x, y) == index {
                    bundle_editor_flags = bundle_editor_flags | 16
                }
                break
            }
        }
        if !found { bundle_editor_identity = 0; bundle_editor_count = 0; bundle_editor_cursor = 0; bundle_editor_anchor = 0 }
    }
    TextHostEditorPresent(bundle_editor_identity, TextView(bundle_editor_bytes[:bundle_editor_count]),
        bundle_editor_cursor, bundle_editor_anchor, bundle_editor_flags)
}

BundleEditorClose :: (session: Session) {
    if bundle_editor_owner.slot != session.slot || bundle_editor_owner.epoch != session.epoch { return }
    for at: 0..bundle_editor_count - 1 { bundle_editor_bytes[at] = 0 }
    bundle_editor_owner = Session.{}
    bundle_editor_identity = 0
    bundle_editor_count = 0
    bundle_editor_cursor = 0
    bundle_editor_anchor = 0
    bundle_editor_flags = 0
    // FrameBegin clears staging before the host can report a closed window;
    // revoke the last committed host editor even when staging is empty.
    TextHostEditorPresent(0, "", 0, 0, 0)
}

BundleEditorInstall :: () -> bool {
    TextHostInstall(BundleEditorPresent)
    TextHostUseFrames(BundleEditorBegin, BundleEditorEnd, BundleEditorClose)
    return true
}

bundle_editor_installed: bool = BundleEditorInstall();
}
