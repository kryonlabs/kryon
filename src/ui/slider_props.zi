#module "slider_props"
#import "geometry"

# Each control owns one value. Applications compose any number of controls
# with their own arrays and SliderCellBoundsFor; no C pointer crosses the API.
SliderProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    label: string
    semantic_label: string
    value: float
    min: float
    max: float
    disabled: bool
    vertical: bool
    class_name: i32
}

DiscreteSliderProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    label: string
    semantic_label: string
    value: i32
    min: i32
    max: i32
    disabled: bool
    vertical: bool
    class_name: i32
}
