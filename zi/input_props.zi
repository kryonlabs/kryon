#module "input_props"
#import "geometry"

NumericValueKind :: enum {
    NumericFloat = 0
    NumericInt = 1
    NumericDouble = 2
}

Activation :: struct {
    activated: bool
    pressed: bool
    hovered: bool
    focused: bool
}

InputProps :: struct {
    bounds: Rectangle
    id: i32
    label: const char*
    kind: NumericValueKind
    float_values: float*
    int_values: i32*
    double_values: double*
    value_count: i32
    step: double
    step_fast: double
    format: const char*
    disabled: bool
}
