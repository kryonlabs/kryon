#module "pager_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_pager_internal.h"
#import "runtime/guide_pager.h"

PagerButton :: (bounds: Rectangle, label: const char*,
emphasis: ButtonEmphasis, focus_id: i32) -> i32 {
    button: ButtonProps
    button.bounds = bounds
    if label != nil { button.label = label }
    button.id = focus_id
    button.emphasis = emphasis
    return Button(button)
}

PagerGuideFrame :: (role: i32) -> StyleFrame {
    button: ButtonProps
    return ui_control_style_frame_role_kind(button, ButtonStateNormal,
    0, 0.0, 0.0, 0.0, StyleKindGuide(), role)
}

GuidePager :: (pager: GuidePagerProps) -> GuidePagerResult #export {
    result: GuidePagerResult
    bar_frame: StyleFrame = PagerGuideFrame(1)
    metrics: GuidePagerMetrics = GuidePagerMetricsFor(GetScale(), bar_frame)
    page_count: i32 = GuidePagerPageCount(pager.page_count)
    page: i32 = GuidePagerPageFor(pager.page, page_count)
    previous: bool = false
    next: bool = false
    close_requested: bool = false
    finish_requested: bool = false
    keyboard_finish: bool = false
    result.page = page

    if pager.swipe != nil && page_count > 1 {
        swipe_spec: SwipeSpec
        swipe_spec.bounds = pager.content_bounds
        swipe_spec.directions = SwipeHorizontal
        swipe_spec.min_distance = metrics.swipe_min_distance
        swipe_spec.axis_bias = metrics.swipe_axis_bias
        swipe_spec.max_duration = metrics.swipe_max_duration
        result.swipe = UpdateSwipe(pager.swipe, swipe_spec)
        previous = result.swipe.direction == SwipeRight
        next = result.swipe.direction == SwipeLeft
    }

    keyboard: GuidePagerInput = GuidePagerInputFor(
    IsKeyPressed(KEY_LEFT) != 0, IsKeyPressed(KEY_RIGHT) != 0,
    IsKeyPressed(KEY_ENTER) != 0, IsKeyPressed(KEY_BACK) != 0,
    IsKeyPressed(KEY_ESCAPE) != 0,
    result.swipe.direction != SwipeNone)
    previous = previous || keyboard.previous_requested
    next = next || keyboard.next_requested
    close_requested = keyboard.close_requested
    keyboard_finish = keyboard.keyboard_finish

    layout: GuidePagerLayout = GuidePagerLayoutFor(pager.footer_bounds,
    metrics)
    if layout.valid {
        if IsWindowReady() {
            bar: Style = ui_unpack_style(bar_frame.value)
            divider: Style = ui_unpack_style(PagerGuideFrame(18).value)
            ui_draw_material(pager.footer_bounds, (Rectangle){0},
            bar.background, bar.border, bar.border, bar.radius,
            bar.border_width, 0.0, 0.0, 0, bar.focus, 0.0,
            bar.opacity, ui_style_fill(bar), bar.material)
            footer_x: i32 = (int)pager.footer_bounds.x
            footer_y: i32 = (int)pager.footer_bounds.y
            footer_w: i32 = (int)pager.footer_bounds.width
            DrawLine(footer_x, footer_y, footer_x + footer_w, footer_y,
            divider.border)
        }

        left_label: const char* = pager.back_label
        if page == 0 { left_label = pager.close_label }
        if PagerButton(layout.left_button, left_label,
        ButtonEmphasisOutline, pager.focus_id) {
            if page == 0 { close_requested = true }
            else { previous = true }
        }

        right_label: const char* = pager.next_label
        if page == page_count - 1 { right_label = pager.finish_label }
        right_id: i32 = 0
        if pager.focus_id > 0 { right_id = pager.focus_id + 1 }
        if PagerButton(layout.right_button, right_label,
        ButtonEmphasisFilled, right_id) {
            if page == page_count - 1 { finish_requested = true }
            else { next = true }
        }
    }

    policy: GuidePagerPolicy = GuidePagerPolicyFor(page, page_count,
    previous, next, close_requested, finish_requested,
    keyboard_finish)
    result.page = policy.page
    result.changed = policy.changed
    result.closed = policy.closed
    result.finished = policy.finished
    return result
}
