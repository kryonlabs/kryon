#import "input"

// Laws for text input. Each states the expected behavior independently of
// the implementation; `ziran check` proves it over every listed input. An
// implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// Starting a temporary text edit with a second click compares the pointer
// travel and the time since the first click as floats. Laws cannot yet pass
// float values through calls, so tests/ziran_input_widget_test.sh covers
// InputTempEditActivationFor.

Pointer :: (inside: s32, captured: s32, disabled: s32, hover: s32,
    released: s32, consumed: s32, started: s32) -> InputPointerInteraction {
    return InputPointerInteractionFor(B(inside), B(captured), B(disabled),
        B(hover), B(released), B(consumed), B(started))
}

// The pointer affects an input only from inside it, uncaptured; a disabled
// input shows its marker instead of reacting.
#law OutsideInert forall captured: 0..1, disabled: 0..1, hover: 0..1, released: 0..1, consumed: 0..1, started: 0..1 => !Pointer(0, captured, disabled, hover, released, consumed, started).active && !Pointer(0, captured, disabled, hover, released, consumed, started).hovered && !Pointer(0, captured, disabled, hover, released, consumed, started).disabled_marker && !Pointer(0, captured, disabled, hover, released, consumed, started).activated;
#law DisabledShowsMarker forall hover: 0..1, released: 0..1 => Pointer(1, 0, 1, hover, released, 0, 1).disabled_marker && !Pointer(1, 0, 1, hover, released, 0, 1).active && !Pointer(1, 0, 1, hover, released, 0, 1).activated;
#law HoverNeedsEffects forall hover: 0..1 => Pointer(1, 0, 0, hover, 0, 0, 0).hovered == B(hover);

// A release activates it once: only after a press that began inside, and
// only when no one else took the release; activating takes the release.
#law ReleaseActivates custom Pointer(1, 0, 0, 1, 1, 0, 1).activated && Pointer(1, 0, 0, 1, 1, 0, 1).consume_release;
#law TakenReleaseIgnored forall started: 0..1 => !Pointer(1, 0, 0, 1, 1, 1, started).activated;
#law OutsidePressIgnored custom !Pointer(1, 0, 0, 1, 1, 0, 0).activated;
#law ConsumesOnlyWhenActivated forall inside: 0..1, captured: 0..1, disabled: 0..1, released: 0..1, consumed: 0..1, started: 0..1 => Pointer(inside, captured, disabled, 1, released, consumed, started).consume_release == Pointer(inside, captured, disabled, 1, released, consumed, started).activated;
