#module "tree_view_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/tree_view.h"
#import "ui/widget_input.h"
#import "ui/paint_command.h"

RenderTreeView :: (tree: TreeViewProps) -> i32 #export {
    paint_enabled: i32 = IsWindowReady()
    state: ButtonState = ButtonStateNormal
    if tree.disabled != 0 { state = ButtonStateDisabled }
    default_item_frame: StyleFrame =
    WidgetFrameForClassRole(ButtonToneNeutral,
    state, tree.disabled, 0, tree.class_name,
    StyleKindTreeViewItem(), StyleAny())
    default_item_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(default_item_frame).value)
    panel_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, state, tree.disabled, 0, tree.class_name,
    StyleKindTreeView(), StyleAny())
    font: i32 = ResolveFont(0,
    StyleFontValue(default_item_style.fields,
    default_item_style.font_size), GetFontSize())
    metrics: TreeViewMetrics = TreeViewMetricsFor((float)GetScale(),
    panel_frame, default_item_frame)
    row_height: i32 = TreeViewRowHeight(tree.row_height,
    (float)GetScale(), metrics)
    content_height: i32 = TreeViewContentHeight(tree.item_count,
    row_height)
    visible: i32 = TreeViewVisibleRows((int)tree.bounds.height,
    row_height)
    scroll_offset: *i32 = tree.scroll_offset
    if tree.disabled != 0 { scroll_offset = nil }
    max_scroll: i32 = ui_update_scroll(tree.bounds, content_height,
    scroll_offset, row_height)
    scroll_y: i32 = 0
    if tree.scroll_offset != nil { scroll_y = *tree.scroll_offset }
    scroll_layout: TreeViewScrollLayout = TreeViewScrollFor(
    scroll_y, row_height)
    changed: i32 = 0
    if paint_enabled != 0 {
        DrawWidgetFrame(tree.bounds, (Rectangle){0},
        panel_frame, 0, 0, tree.disabled, 0)
        BeginClip((int)tree.bounds.x, (int)tree.bounds.y,
        (int)tree.bounds.width, (int)tree.bounds.height)
    }
    visible_index: i32 = 0
    while visible_index < visible &&
    scroll_layout.first + visible_index < tree.item_count {
        index: i32 = scroll_layout.first + visible_index
        item: TreeItem = tree.items[index]
        row: Rectangle = TreeViewRowBounds(tree.bounds,
        visible_index, row_height, scroll_layout.y_offset)
        marker_bounds: Rectangle = TreeViewMarkerBounds(row,
        item.depth, metrics)
        text_bounds: Rectangle = TreeViewTextBounds(row,
        item.depth, metrics)
        hot: i32 = !tree.disabled && ui_hot(row)
        selected: i32 = tree.selected_id != nil &&
        *tree.selected_id == item.id
        item_state: ButtonState = ButtonStateNormal
        if selected != 0 { item_state = ButtonStateSelected }
        if hot != 0 { item_state = ButtonStateHover }
        if tree.disabled != 0 { item_state = ButtonStateDisabled }
        item_frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, item_state, tree.disabled, selected,
        tree.class_name, StyleKindTreeViewItem(), StyleAny())
        item_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(item_frame).value)
        item_font: i32 = ResolveFont(0,
        StyleFontValue(item_style.fields, item_style.font_size), font)
        text_paint: TreeViewTextPaint = TreeViewTextPaintFor(
        marker_bounds, text_bounds, TextLineHeight(item_font))
        item_text: Color = Fade(item_style.foreground,
        item_style.opacity)
        if paint_enabled != 0 &&
        (selected != 0 || hot != 0 || tree.disabled != 0) {
            DrawWidgetFrame(row, tree.bounds, item_frame,
            hot, 0, tree.disabled, 0)
        }
        if paint_enabled != 0 {
            RenderText(TreeViewMarkerText(item.expanded != 0),
            text_paint.marker_x, text_paint.marker_y,
            item_font, item_text)
            label: const char* = item.label
            if label == nil { label = "" }
            RenderText(label, text_paint.text_x, text_paint.text_y,
            item_font, item_text)
        }
        if hot != 0 { MarkClickable() }
        decision: TreeViewRowDecision = TreeViewRowDecisionFor(
        hot, IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
        item.selectable != 0, tree.selected_id != nil, item.id)
        if decision.consume_release { ConsumeRelease() }
        if decision.select {
            *tree.selected_id = decision.selected_id
        }
        if decision.changed { changed = 1 }
        visible_index += 1
    }
    if paint_enabled != 0 { EndClip() }
    if paint_enabled != 0 && tree.scroll_offset != nil &&
    max_scroll > 0 {
        scrollbar: Rectangle = TreeViewScrollbarBoundsFor(
        tree.bounds, metrics.scrollbar_width)
        ui_scrollbar((int)scrollbar.x, (int)scrollbar.y,
        (int)scrollbar.height, content_height,
        tree.scroll_offset, max_scroll, 0)
    }
    return changed
}
