#module "tab_bar_host"
#import "ui_internal.h"
#import "ui_popup_input_internal.h"
#import "ui_style_internal.h"
#import "ui_image_internal.h"
#import "ui/tab_store.h"
#import "runtime/tab_bar.h"
#import "runtime/style.h"

TabBarStyleFrame :: (style_kind: i32, state: ButtonState,
disabled: i32, selected: i32, class_name: i32) -> StyleFrame #export {
    props: ButtonProps = (ButtonProps){0}
    props.class_name = class_name
    props.tone = selected ? ButtonToneAccent : ButtonToneNeutral
    props.emphasis = selected ? ButtonEmphasisFilled : ButtonEmphasisSoft
    props.size = ControlSizeMedium
    props.disabled = disabled
    props.selected = selected
    return ui_control_style_frame_kind(props, state, 0, 0.0,
    0.0, 0.0, style_kind)
}

TabBarFont :: (bar: TabBarProps, disabled: i32) -> i32 #export {
    frame: StyleFrame = TabBarStyleFrame(StyleKindTab(),
    disabled ? ButtonStateDisabled : ButtonStateNormal,
    disabled, 0, bar.class_name)
    return ResolveFont(0, StyleFontValue(frame.value.fields,
    frame.value.font_size), GetSmallFontSize())
}

TabRoundness :: (bounds: Rectangle, radius: float) -> float #export {
    min_side: float = bounds.width
    if bounds.height < min_side { min_side = bounds.height }
    if min_side <= 0.0 || radius <= 0.0 { return 0.0 }
    radius = radius / min_side
    if radius < 0.0 { return 0.0 }
    if radius > 0.5 { return 0.5 }
    return radius
}

TabBarSameIdentity :: (id: i32, bounds: Rectangle, other_id: i32,
other_bounds: Rectangle) -> i32 #export {
    if id > 0 || other_id > 0 {
        return id > 0 && id == other_id
    }
    return bounds.x == other_bounds.x && bounds.y == other_bounds.y &&
    bounds.width == other_bounds.width &&
    bounds.height == other_bounds.height
}

ui_tab_bar_height :: () -> i32 #export {
    frame: StyleFrame = TabBarStyleFrame(StyleKindTabBar(),
    ButtonStateNormal, 0, 0, 0)
    return TabBarPolicyHeight((float)Scale(1000) / 1000.0, frame)
}

GetTabBarHeight :: () -> i32 #export {
    return ui_tab_bar_height()
}

TabBarHeight :: () -> i32 #export {
    return ui_tab_bar_height()
}

TabBarHostTabWidth :: (bar: TabBarProps, index: i32,
min_tab_w: i32, max_tab_w: i32, icon_tab_w: i32,
font: i32) -> i32 #export {
    if index < 0 || index >= bar.count || bar.tabs == nil {
        return min_tab_w
    }
    tab: Tab = bar.tabs[index]
    has_label: i32 = tab.label != nil && tab.label[0] != '\0'
    label_w: i32 = 0
    if has_label != 0 { label_w = TextWidth(tab.label, font) }
    bar_frame: StyleFrame = TabBarStyleFrame(StyleKindTabBar(),
    bar.disabled ? ButtonStateDisabled : ButtonStateNormal,
    bar.disabled, 0, bar.class_name)
    tab_frame: StyleFrame = TabBarStyleFrame(StyleKindTab(),
    tab.disabled ? ButtonStateDisabled : ButtonStateNormal,
    tab.disabled, 0, bar.class_name)
    close_frame: StyleFrame = TabBarStyleFrame(StyleKindTabClose(),
    tab.disabled ? ButtonStateDisabled : ButtonStateNormal,
    tab.disabled, 0, bar.class_name)
    metrics: TabBarMetrics = TabBarDefaultMetrics(min_tab_w,
    max_tab_w, (float)Scale(1000) / 1000.0,
    bar_frame, tab_frame, close_frame)
    if icon_tab_w > 0 { metrics.icon_width = icon_tab_w }
    return TabBarTabWidth(label_w, has_label, tab.icon.id != 0,
    tab.closeable, metrics)
}

TabBarNextEnabled :: (bar: TabBarProps, from: i32,
direction: i32) -> i32 #export {
    step: i32 = 1
    while step <= bar.count {
        index: i32 = TabBarWrappedIndex(from, direction,
        step, bar.count)
        if !bar.tabs[index].disabled { return index }
        step += 1
    }
    return from
}

ui_tab_bar_keyboard_input :: (bar: TabBarProps) -> i32 #export {
    if bar.tabs == nil || bar.count <= 0 || bar.bounds.width <= 0 ||
    bar.bounds.height <= 0 || bar.disabled || ContentDisabled() ||
    bar.id <= 0 || !RegisterFocus(bar.id, bar.bounds) ||
    ui_popup_input_focus_captures(bar.id) { return -1 }
    SetFocusTextInputActive(0)
    selected: i32 = TabBarSelectedIndexFor(bar.selected_index, bar.count)
    input: TabBarKeyboardInput = TabBarKeyboardInputFor(selected, bar.count,
    IsKeyPressed(KEY_LEFT) != 0, IsKeyPressed(KEY_RIGHT) != 0,
    IsKeyPressed(KEY_UP) != 0, IsKeyPressed(KEY_DOWN) != 0,
    IsKeyPressed(KEY_HOME) != 0, IsKeyPressed(KEY_END) != 0,
    IsKeyPressed(KEY_DELETE) != 0, IsKeyPressed(KEY_BACKSPACE) != 0)
    if input.direction != 0 {
        return TabBarNextEnabled(bar, input.from_index, input.direction)
    }
    if input.close_requested && bar.tabs[selected].closeable &&
    bar.closed_index != nil { *bar.closed_index = selected }
    return -1
}

TabBarTotalWidthFor :: (bar: TabBarProps, min_tab_w: i32,
max_tab_w: i32, icon_tab_w: i32, tab_gap: i32,
font: i32) -> i32 #export {
    total: i32 = 0
    index: i32 = 0
    while index < bar.count {
        total += TabBarHostTabWidth(bar, index, min_tab_w,
        max_tab_w, icon_tab_w, font)
        index += 1
    }
    return TabBarTotalWidth(total, bar.count, tab_gap)
}

TabBarRectAt :: (bar: TabBarProps, index: i32,
min_tab_w: i32, max_tab_w: i32, icon_tab_w: i32,
tab_gap: i32, scroll: i32, equal_tabs: i32,
font: i32) -> Rectangle #export {
    bar_x: i32 = (int)bar.bounds.x
    bar_y: i32 = (int)bar.bounds.y
    tab_x: i32 = bar_x
    if equal_tabs == 0 { tab_x = bar_x + tab_gap - scroll }
    if equal_tabs != 0 {
        return TabBarEqualTabBounds(bar.bounds, bar.count, index)
    }
    cursor: i32 = 0
    while cursor <= index && cursor < bar.count {
        tab_w: i32 = TabBarHostTabWidth(bar, cursor, min_tab_w,
        max_tab_w, icon_tab_w, font)
        if cursor == index {
            return (Rectangle){(float)tab_x, (float)bar_y,
                (float)tab_w, bar.bounds.height}
        }
        tab_x += tab_w + tab_gap
        cursor += 1
    }
    return (Rectangle){0.0, 0.0, 0.0, 0.0}
}

TabBarReorderTarget :: (bar: TabBarProps, active_index: i32,
min_tab_w: i32, max_tab_w: i32, icon_tab_w: i32,
tab_gap: i32, scroll: i32, equal_tabs: i32,
pointer_x: i32, font: i32) -> i32 #export {
    if active_index < 0 || active_index >= bar.count { return -1 }
    target: i32 = 0
    index: i32 = 0
    while index < bar.count {
        if index != active_index {
            rect: Rectangle = TabBarRectAt(bar, index, min_tab_w,
            max_tab_w, icon_tab_w, tab_gap, scroll, equal_tabs, font)
            center_x: i32 = (int)(rect.x + rect.width / 2.0)
            if pointer_x > center_x { target += 1 }
        }
        index += 1
    }
    return TabBarClampedIndexFor(target, bar.count)
}

RenderTabBar :: (bar: TabBarProps) -> i32 #export {
    store: *TabBarStore = tab_bar_store_current()
    mouse_world: Vector2 = ui_mouse_world()
    released: i32 = IsMouseButtonReleased(MOUSE_BUTTON_LEFT)
    clicked_tab: i32 = -1
    bar_x: i32 = (int)bar.bounds.x
    bar_y: i32 = (int)bar.bounds.y
    bar_w: i32 = (int)bar.bounds.width
    bar_h: i32 = (int)bar.bounds.height
    disabled: i32 = bar.disabled || ContentDisabled()
    bar_frame: StyleFrame = TabBarStyleFrame(StyleKindTabBar(),
    disabled ? ButtonStateDisabled : ButtonStateNormal,
    disabled, 0, bar.class_name)
    metric_tab_frame: StyleFrame = TabBarStyleFrame(StyleKindTab(),
    disabled ? ButtonStateDisabled : ButtonStateNormal,
    disabled, 0, bar.class_name)
    metric_close_frame: StyleFrame = TabBarStyleFrame(StyleKindTabClose(),
    disabled ? ButtonStateDisabled : ButtonStateNormal,
    disabled, 0, bar.class_name)
    default_metrics: TabBarMetrics = TabBarDefaultMetrics(
    bar.min_tab_width, bar.max_tab_width,
    (float)Scale(1000) / 1000.0, bar_frame, metric_tab_frame,
    metric_close_frame)
    font: i32 = TabBarFont(bar, disabled)
    tab_gap: i32 = default_metrics.gap
    min_tab_w: i32 = default_metrics.min_width
    max_tab_w: i32 = default_metrics.max_width
    icon_tab_w: i32 = default_metrics.icon_width
    focused: i32 = 0
    can_draw: i32 = IsWindowReady()
    default_scroll_offset: i32 = 0
    scroll_offset: *i32 = bar.scroll_offset
    if scroll_offset == nil {
        scroll_offset = ui_tab_bar_owned_scroll(bar.id,
        &default_scroll_offset)
    }
    if bar.closed_index != nil { *bar.closed_index = -1 }
    if bar.double_clicked_index != nil {
        *bar.double_clicked_index = -1
    }
    if bar.reordered_from_index != nil {
        *bar.reordered_from_index = -1
    }
    if bar.reordered_to_index != nil {
        *bar.reordered_to_index = -1
    }
    if bar.selected_tab_bounds != nil {
        *bar.selected_tab_bounds = (Rectangle){0}
    }
    if bar.middle_clicked_index != nil {
        *bar.middle_clicked_index = -1
    }
    if bar.tabs == nil || bar.count <= 0 ||
    bar.bounds.width <= 0 || bar.bounds.height <= 0 {
        return -1
    }
    clicked_tab = ui_tab_bar_keyboard_input(bar)
    focused = !disabled && bar.id > 0 && KryonGetFocus() == bar.id &&
    !ui_popup_input_focus_captures(bar.id)
    if can_draw != 0 {
        bar_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(bar_frame).value)
        ui_draw_material(bar.bounds, bar.bounds,
        bar_style.background, bar_style.border, bar_style.border,
        bar_style.radius, bar_style.border_width, 0.0, 0.0,
        disabled, bar_style.focus, 0.0, bar_style.opacity,
        ui_style_apply_effects_fill(bar_frame.fill),
        bar_style.material)
    }
    if max_tab_w < min_tab_w { max_tab_w = min_tab_w }
    if icon_tab_w > max_tab_w { icon_tab_w = max_tab_w }
    total_tabs_w: i32 = TabBarTotalWidthFor(bar, min_tab_w,
    max_tab_w, icon_tab_w, tab_gap, font)
    scroll_policy: TabBarScroll = TabBarScrollFor(bar.bounds.width,
    total_tabs_w, *scroll_offset)
    needs_scroll: i32 = !scroll_policy.equal_tabs
    equal_tabs: i32 = scroll_policy.equal_tabs
    max_scroll: i32 = scroll_policy.max_scroll
    *scroll_offset = scroll_policy.scroll
    if needs_scroll != 0 && bar.focus_selected &&
    bar.selected_index >= 0 && bar.selected_index < bar.count {
        selected_tab_w: i32 = TabBarHostTabWidth(bar,
        bar.selected_index, min_tab_w, max_tab_w, icon_tab_w, font)
        selected_tab_x: i32 = bar_x + tab_gap - *scroll_offset
        index: i32 = 0
        while index < bar.selected_index {
            selected_tab_x += TabBarHostTabWidth(bar, index,
            min_tab_w, max_tab_w, icon_tab_w, font) + tab_gap
            index += 1
        }
        *scroll_offset = TabBarRevealScroll(
        (float)(selected_tab_x - tab_gap),
        (float)(selected_tab_w + tab_gap * 2),
        bar.bounds, *scroll_offset, max_scroll)
    }
    tab_x: i32 = bar_x
    if equal_tabs == 0 { tab_x = bar_x + tab_gap - *scroll_offset }
    reorder_enabled: i32 = bar.reordered_from_index != nil &&
    bar.reordered_to_index != nil
    drag_target: i32 = -1
    owns_press: i32 = TabBarSameIdentity(bar.id, bar.bounds,
    store->press_bar_id, store->press_bar_bounds)
    owns_drag: i32 = store->reorder_drag_active && owns_press
    if !disabled && reorder_enabled != 0 && owns_press != 0 &&
    store->press_index >= 0 && store->press_index < bar.count &&
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
        dx: i32 = (int)(mouse_world.x - store->press_position.x)
        dy: i32 = (int)(mouse_world.y - store->press_position.y)
        drag_paint: TabBarPaint = TabBarPaintFor(bar_frame,
        metric_tab_frame, metric_close_frame,
        (float)Scale(1000) / 1000.0)
        drag_decision: TabBarReorderDragDecision =
        TabBarReorderDragDecisionFor(disabled != 0,
        reorder_enabled != 0, owns_press != 0,
        store->press_index, bar.count,
        IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0,
        store->reorder_drag_active != 0, dx, dy,
        drag_paint.reorder_drag_threshold)
        if drag_decision.start_drag {
            store->reorder_drag_active = 1
            g_ui_pointer_owner = POINTER_OWNER_REORDER
        }
        if drag_decision.dragging {
            drag_target = TabBarReorderTarget(bar,
            store->press_index, min_tab_w, max_tab_w,
            icon_tab_w, tab_gap, *scroll_offset,
            equal_tabs, (int)mouse_world.x, font)
            if drag_decision.capture_input {
                PushInputCapture((Rectangle){0.0, 0.0,
                    (float)ui_view_width, (float)ui_view_height}, 0)
            }
        }
    }
    if can_draw != 0 { ui_begin_world_clip(bar.bounds) }
    PushInputClip(bar.bounds)
    index: i32 = 0
    while index < bar.count {
        tab: Tab = bar.tabs[index]
        tab_w: i32 = bar_w / bar.count
        if equal_tabs == 0 {
            tab_w = TabBarHostTabWidth(bar, index,
            min_tab_w, max_tab_w, icon_tab_w, font)
        } else if index == bar.count - 1 {
            tab_w = bar_x + bar_w - tab_x
        }
        tab_rect: Rectangle = (Rectangle){(float)tab_x,
            (float)bar_y, (float)tab_w, (float)bar_h}
        input_captured: i32 = InputCapturesClick(mouse_world)
        is_active: i32 = CheckCollisionPointRec(mouse_world,
        tab_rect) && !input_captured
        is_hovered: i32 = is_active && HoverEffectsEnabled()
        is_selected: i32 = index == bar.selected_index
        is_disabled: i32 = disabled || tab.disabled
        tab_state: ButtonState = ButtonStateNormal
        if is_disabled != 0 {
            tab_state = ButtonStateDisabled
        } else if is_active && IsMouseButtonDown(MOUSE_BUTTON_LEFT) {
            tab_state = ButtonStatePressed
        } else if is_hovered != 0 {
            tab_state = ButtonStateHover
        } else if is_selected != 0 {
            tab_state = ButtonStateSelected
        }
        tab_frame: StyleFrame = TabBarStyleFrame(StyleKindTab(),
        tab_state, is_disabled, is_selected, bar.class_name)
        close_frame: StyleFrame = TabBarStyleFrame(StyleKindTabClose(),
        ButtonStateNormal, is_disabled, 0, bar.class_name)
        if is_selected != 0 && bar.selected_tab_bounds != nil {
            *bar.selected_tab_bounds = tab_rect
        }
        paint: TabBarPaint = TabBarPaintFor(bar_frame,
        tab_frame, close_frame, (float)Scale(1000) / 1000.0)
        styled_tab_frame: StyleFrame =
        ui_style_apply_effects_frame(tab_frame)
        tab_style: Style = ui_unpack_style(styled_tab_frame.value)
        close_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(close_frame).value)
        if can_draw != 0 {
            ui_draw_material(tab_rect, bar.bounds,
            tab_style.background, tab_style.border,
            tab_style.border, tab_style.radius,
            tab_style.border_width,
            is_hovered ? 1.0 : 0.0,
            is_active && IsMouseButtonDown(MOUSE_BUTTON_LEFT) ? 1.0 : 0.0,
            is_disabled, tab_style.focus,
            focused && is_selected ? 1.0 : 0.0,
            tab_style.opacity,
            ui_style_apply_effects_fill(styled_tab_frame.fill),
            tab_style.material)
        }
        if can_draw != 0 && is_selected != 0 &&
        paint.tab_border_color != 0 {
            DrawLine(tab_x, bar_y + bar_h - 1,
            tab_x + tab_w - 1, bar_y + bar_h - 1,
            GetColor(paint.tab_border_color))
        }
        icon_size: i32 = paint.icon_size
        has_label: i32 = tab.label != nil && tab.label[0] != '\0'
        close_size: i32 = paint.close_size
        label_w: i32 = 0
        if has_label != 0 { label_w = TextWidth(tab.label, font) }
        content_layout: TabBarContentLayout =
        TabBarContentLayoutFor(tab_rect, label_w, has_label,
        tab.icon.id != 0, tab.closeable, paint)
        close_rect: Rectangle = content_layout.close_bounds
        close_active: i32 = tab.closeable && !is_disabled &&
        CheckCollisionPointRec(mouse_world, close_rect) &&
        !input_captured
        close_hovered: i32 = close_active && HoverEffectsEnabled()
        text_color: Color = Fade(GetColor(paint.text_color),
        tab_style.opacity)
        icon_tint: Color = Fade(GetColor(paint.icon_color),
        tab_style.opacity)
        if tab.icon.id != 0 && icon_size > 0 && can_draw != 0 {
            icon_rect: Rectangle = content_layout.icon_bounds
            ImageTextureTintedRaw(tab.icon, icon_rect, icon_tint)
        }
        text_rect: Rectangle = content_layout.text_bounds
        if can_draw != 0 && text_rect.width > 0 && has_label != 0 {
            RenderControlTextInRect(tab.label, text_rect,
            font, text_color)
        }
        if can_draw != 0 && tab.closeable && close_size > 0 {
            if close_hovered != 0 {
                close_frame = TabBarStyleFrame(StyleKindTabClose(),
                ButtonStateHover, is_disabled, 0, bar.class_name)
                paint = TabBarPaintFor(bar_frame, tab_frame,
                close_frame, (float)Scale(1000) / 1000.0)
                close_style = ui_unpack_style(
                ui_style_apply_effects_frame(close_frame).value)
                DrawRectangleRounded(close_rect,
                TabRoundness(close_rect, close_frame.value.radius),
                6, GetColor(close_frame.value.background))
            }
            close_label: TabBarCloseLabelPaint =
            TabBarCloseLabelPaintFor(close_rect,
            TextWidth("x", font), TextLineHeight(font))
            RenderText("x", close_label.x, close_label.y,
            font, Fade(GetColor(paint.close_color),
            close_style.opacity))
        }
        if is_active != 0 {
            if is_disabled != 0 { MarkDisabled() }
            else { MarkClickable() }
            if !is_disabled && IsMouseButtonPressed(MOUSE_BUTTON_MIDDLE) {
                clicked_tab = -1
                if bar.middle_clicked_index != nil {
                    *bar.middle_clicked_index = index
                }
            }
            if !is_disabled && !close_active &&
            IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
                store->press_index = index
                store->press_bar_id = bar.id
                store->press_bar_bounds = bar.bounds
                store->press_position = mouse_world
                store->reorder_drag_active = 0
            }
            press_matches: i32 = store->press_index < 0 ||
            (TabBarSameIdentity(bar.id, bar.bounds,
            store->press_bar_id, store->press_bar_bounds) &&
            store->press_index == index)
            pointer_decision: TabBarTabPointerDecision =
            TabBarTabPointerDecisionFor(close_active != 0,
            released != 0, owns_drag != 0, press_matches != 0)
            if pointer_decision.close {
                clicked_tab = -1
                if bar.closed_index != nil { *bar.closed_index = index }
                store->last_clicked_tab = -1
                store->last_clicked_bar_id = 0
                store->last_clicked_bar_bounds = (Rectangle){0}
                store->last_click_time = 0.0
            } else if pointer_decision.activate {
                now: double = GetTime()
                if bar.double_clicked_index != nil &&
                TabBarDoubleClickShouldRun(
                TabBarSameIdentity(bar.id, bar.bounds,
                store->last_clicked_bar_id,
                store->last_clicked_bar_bounds),
                store->last_clicked_tab, index,
                (float)store->last_click_time, (float)now) {
                    *bar.double_clicked_index = index
                }
                store->last_clicked_tab = index
                store->last_clicked_bar_id = bar.id
                store->last_clicked_bar_bounds = bar.bounds
                store->last_click_time = now
                clicked_tab = index
                if bar.id > 0 {
                    KryonSetFocus(bar.id)
                    focused = 1
                }
            }
            if pointer_decision.consume_release { ConsumeRelease() }
        }
        if can_draw != 0 && focused != 0 &&
        index == (clicked_tab >= 0 ? clicked_tab : bar.selected_index) {
            RenderFocus(tab_rect)
        }
        tab_x += tab_w + tab_gap
        index += 1
    }
    PopInputClip()
    if can_draw != 0 { EndClip() }
    owns_press = TabBarSameIdentity(bar.id, bar.bounds,
    store->press_bar_id, store->press_bar_bounds)
    owns_drag = store->reorder_drag_active && owns_press
    reorder_release: TabBarReorderReleaseDecision =
    TabBarReorderReleaseDecisionFor(disabled != 0,
    reorder_enabled != 0, owns_drag != 0, released != 0,
    store->press_index, bar.count)
    if reorder_release.finish {
        target: i32 = drag_target
        if target < 0 {
            target = TabBarReorderTarget(bar, store->press_index,
            min_tab_w, max_tab_w, icon_tab_w, tab_gap,
            *scroll_offset, equal_tabs, (int)mouse_world.x, font)
        }
        if target >= 0 && target < bar.count &&
        target != store->press_index {
            *bar.reordered_from_index = store->press_index
            *bar.reordered_to_index = target
        }
        clicked_tab = -1
        if reorder_release.consume_release { ConsumeRelease() }
    }
    cleanup: TabBarPressCleanupDecision =
    TabBarPressCleanupDecisionFor(released != 0,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0,
    owns_press != 0, g_ui_pointer_owner == POINTER_OWNER_REORDER)
    if cleanup.clear_press {
        store->press_index = -1
        store->press_bar_id = 0
        store->press_bar_bounds = (Rectangle){0}
        store->reorder_drag_active = 0
        if cleanup.clear_pointer_owner {
            g_ui_pointer_owner = POINTER_OWNER_NONE
        }
    }
    if !disabled && needs_scroll != 0 &&
    !(reorder_enabled && owns_drag) {
        current_pos: Vector2 = mouse_world
        is_mouse_down: i32 = IsMouseButtonDown(MOUSE_BUTTON_LEFT)
        scroll_area: Rectangle = (Rectangle){(float)bar_x,
            (float)bar_y, (float)bar_w, (float)bar_h}
        is_over_bar: i32 = CheckCollisionPointRec(current_pos,
        scroll_area)
        owns_scroll_drag: i32 = TabBarSameIdentity(bar.id,
        bar.bounds, store->scroll_drag_bar_id,
        store->scroll_drag_bar_bounds)
        if is_mouse_down != 0 && is_over_bar != 0 &&
        !store->dragging_scroll {
            store->dragging_scroll = 1
            store->scroll_drag_bar_id = bar.id
            store->scroll_drag_bar_bounds = bar.bounds
            store->last_drag_position = current_pos
            owns_scroll_drag = 1
        }
        if store->dragging_scroll && owns_scroll_drag != 0 {
            if is_mouse_down != 0 {
                dx: float = current_pos.x -
                store->last_drag_position.x
                *scroll_offset -= (int)dx
                if *scroll_offset < 0 { *scroll_offset = 0 }
                if *scroll_offset > max_scroll {
                    *scroll_offset = max_scroll
                }
                store->last_drag_position = current_pos
            } else {
                store->dragging_scroll = 0
                store->scroll_drag_bar_id = 0
                store->scroll_drag_bar_bounds = (Rectangle){0}
            }
        }
    }
    return clicked_tab
}
