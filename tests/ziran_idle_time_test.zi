#import "idle_time"
#import "c_string"

c :: #system_library "c";
TestSetEnv :: (name: *u8, value: *u8, overwrite: s32) -> s32 #foreign c "setenv";
TestUnsetEnv :: (name: *u8) -> s32 #foreign c "unsetenv";

// A Wayland session is named by XDG_SESSION_TYPE or WAYLAND_DISPLAY; without a
// reachable session bus the idle time is unknown.
#program_export
main :: () -> s32 {
    display_name: [24]u8
    session_name: [24]u8
    x11_name: [8]u8
    wayland_name: [16]u8
    if !CopyCString("WAYLAND_DISPLAY", display_name[:]) ||
        !CopyCString("XDG_SESSION_TYPE", session_name[:]) ||
        !CopyCString("x11", x11_name[:]) ||
        !CopyCString("wayland", wayland_name[:]) {
        return 1
    }
    if TestUnsetEnv(*display_name[0]) != 0 ||
        TestSetEnv(*session_name[0], *x11_name[0], 1) != 0 {
        return 2
    }
    if IsWaylandSession() {
        return 3
    }
    if TestSetEnv(*session_name[0], *wayland_name[0], 1) != 0 {
        return 4
    }
    if !IsWaylandSession() {
        return 5
    }
    if TestSetEnv(*session_name[0], *x11_name[0], 1) != 0 {
        return 6
    }
    if IdleMilliseconds() != -1 ||
        IdleMilliseconds() != -1 {
        return 7
    }
    return 0
}
