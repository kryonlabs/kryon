using Web :: #import "std/web";
using Number :: #import "std/number_text";
#import "geometry"
#import "session"
#import "tree"
#import "tree_input"
#import "semantic"
#import "widget_kind"

using SemanticKind;
using WidgetKind;

dom_document: s32;
dom_root: s32;
dom_objects: s32;
dom_nodes: s32;
dom_clicks: s32;
dom_click_listener: s32;
dom_focus_index: s32;

DomSame :: (a: WebValue, b: WebValue) -> bool {
    return WebAsBool(WebCall2(dom_objects, WebName("is"), a, b))
}

DomAttribute :: (element: s32, name: string, value: string) {
    current := WebCall1(element, WebName("getAttribute"), WebText(name))
    if value == "" {
        if !WebIsUndefined(current) { unused WebCall1(element, WebName("removeAttribute"), WebText(name)) }
    } else if !DomSame(current, WebText(value)) {
        unused WebCall2(element, WebName("setAttribute"), WebText(name), WebText(value))
    }
}

DomNumberAttribute :: (element: s32, name: string, value: s32) {
    buffer: [24]u8
    text := ifx value == 0 then "" else FormatInteger(cast(s64)value, buffer[:])
    DomAttribute(element, name, text)
}

DomNodeTag :: (node: TreeEntry) -> string {
    if node.semantic_kind == cast(SemanticKind)SemanticPage { return "main" }
    if node.semantic_kind == cast(SemanticKind)SemanticSection { return "section" }
    if node.semantic_kind == cast(SemanticKind)SemanticHeading {
        if node.heading_level == 2 { return "h2" }
        if node.heading_level == 3 { return "h3" }
        if node.heading_level == 4 { return "h4" }
        if node.heading_level == 5 { return "h5" }
        if node.heading_level == 6 { return "h6" }
        return "h1"
    }
    if node.semantic_kind == cast(SemanticKind)SemanticParagraph || node.kind == WidgetKindParagraph { return "p" }
    if node.semantic_kind == cast(SemanticKind)SemanticButton || node.kind == WidgetKindButton { return "button" }
    if node.kind == WidgetKindText { return "span" }
    if node.kind == WidgetKindSeparator { return "hr" }
    return "div"
}

DomNodeIsAction :: (node: TreeEntry, tag: string) -> bool {
    return tag == "button" && node.interactive &&
        TreePointerActivatable(node.kind, node.focus_id, false, false)
}

DomNodeText :: (element: s32, label: string) {
    first := WebGetObject(element, WebName("firstChild"))
    if first != 0 && WebAsNumber(WebGet(first, WebName("nodeType"))) == 3.0 {
        name := WebName("nodeValue")
        if !DomSame(WebGet(first, name), WebText(label)) { WebSet(first, name, WebText(label)) }
    } else if label != "" {
        text := WebCall1(dom_document, WebName("createTextNode"), WebText(label))
        before := ifx first != 0 then WebObject(first) else WebNull()
        unused WebCall2(element, WebName("insertBefore"), text, before)
    }
}

DomNodeUpdate :: (element: s32, node: TreeEntry, tag: string, allowed: bool, index: s32) {
    DomAttribute(element, "data-kryon-widget", WidgetKindName(node.kind))
    DomNumberAttribute(element, "data-kryon-id", node.style_id)
    DomNumberAttribute(element, "data-kryon-class", node.style_class)
    DomAttribute(element, "data-kryon-selected", ifx node.selected then "true" else "")
    DomAttribute(element, "aria-disabled", ifx node.disabled then "true" else "")
    DomAttribute(element, "aria-busy", ifx node.loading then "true" else "")
    owns_text := tag == "button" || tag == "span" || tag == "p" ||
        node.semantic_kind == cast(SemanticKind)SemanticHeading
    if owns_text {
        DomNodeText(element, node.semantic_label)
    } else {
        DomAttribute(element, "aria-label", node.semantic_label)
    }
    if tag == "button" {
        DomAttribute(element, "type", "button")
        DomAttribute(element, "aria-description", node.semantic_detail)
        DomAttribute(element, "aria-pressed", ifx node.selected then "true" else "")
        actionable := DomNodeIsAction(node, tag) && allowed
        disabled := node.disabled || node.loading || !actionable
        attr := WebName("disabled")
        if WebAsBool(WebGet(element, attr)) != disabled { WebSet(element, attr, WebBool(disabled)) }
        DomAttribute(element, "data-kryon-action", ifx actionable then "true" else "")
        WebSet(element, WebName("kryonTreeIndex"), WebNumber(cast(float64)index))
    }
}

DomContains :: (element: s32) -> bool {
    return element != 0 && WebAsBool(WebCall1(dom_root, WebName("contains"), WebObject(element)))
}

DomQueueClick :: (context: s32, event: s32, second: s32, third: s32) {
    unused context; unused second; unused third
    scope := WebScope()
    defer WebEnd(scope)
    target := WebGetObject(event, WebName("target"))
    if target == 0 { return }
    node := WebAsObject(WebCall1(target, WebName("closest"), WebText("[data-kryon-action]")))
    if !DomContains(node) || WebAsBool(WebGet(node, WebName("disabled"))) { return }
    unused WebCall1(dom_clicks, WebName("push"), WebObject(node))
}

DomTreeOpen :: () -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    document := WebGetObject(WebGlobal, WebName("document"))
    root := WebAsObject(WebCall1(document, WebName("getElementById"), WebText("kryon-dom-root")))
    objects := WebGetObject(WebGlobal, WebName("Object"))
    nodes := WebNew0(WebGetObject(WebGlobal, WebName("Map")))
    clicks := WebNew0(WebGetObject(WebGlobal, WebName("Array")))
    if root == 0 || objects == 0 || nodes == 0 || clicks == 0 { return false }
    dom_document = WebKeep(document)
    dom_root = WebKeep(root)
    dom_objects = WebKeep(objects)
    dom_nodes = WebKeep(nodes)
    dom_clicks = WebKeep(clicks)
    dom_click_listener = WebFunction(DomQueueClick, 0)
    unused WebCall2(dom_root, WebName("addEventListener"), WebText("click"), WebObject(dom_click_listener))
    if WebFailed() {
        DomTreeClose()
        return false
    }
    return true
}

DomTreeClose :: () {
    scope := WebScope()
    defer WebEnd(scope)
    unused WebCall2(dom_root, WebName("removeEventListener"), WebText("click"), WebObject(dom_click_listener))
    WebRelease(dom_click_listener)
    WebRelease(dom_clicks)
    WebRelease(dom_nodes)
    WebRelease(dom_objects)
    WebRelease(dom_root)
    WebRelease(dom_document)
}

DomViewport :: () -> Rectangle {
    scope := WebScope()
    defer WebEnd(scope)
    viewport := WebGetObject(dom_document, WebName("documentElement"))
    width := cast(float32)WebAsNumber(WebGet(viewport, WebName("clientWidth")))
    height := cast(float32)WebAsNumber(WebGet(viewport, WebName("clientHeight")))
    return Rectangle.{0.0, 0.0, width, height}
}

DomElementIndex :: (element: s32) -> s32 {
    if !DomContains(element) { return 0 }
    return cast(s32)WebAsNumber(WebGet(element, WebName("kryonTreeIndex")))
}

DomTreeInput :: (session: Session) {
    scope := WebScope()
    defer WebEnd(scope)
    index := DomElementIndex(WebGetObject(dom_document, WebName("activeElement")))
    if dom_focus_index != index && dom_focus_index > 0 { TreeBlurAt(session, dom_focus_index) }
    if index > 0 { unused TreeFocusAt(session, index) }
    while true {
        click := WebAsObject(WebCall0(dom_clicks, WebName("shift")))
        if click == 0 { break }
        target := DomElementIndex(click)
        if target > 0 && TreeActivateAt(session, target) { break }
    }
}

DomNodeCollect :: (session: Session, index: s32, nodes: s32, ordered: s32) -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    node := TreeNodeAt(session, index)
    buffer: [24]u8
    identity := WebText(FormatInteger(cast(s64)node.identity_generation, buffer[:]))
    value := WebCall1(dom_nodes, WebName("get"), identity)
    element := WebAsObject(value)
    tag := DomNodeTag(node)
    if element == 0 || !DomSame(WebGet(element, WebName("localName")), WebText(tag)) {
        value = WebCall1(dom_document, WebName("createElement"), WebText(tag))
        element = WebAsObject(value)
        if element == 0 { return false }
    } else {
        unused WebCall1(dom_nodes, WebName("delete"), identity)
    }
    DomNodeUpdate(element, node, tag, TreeInputAllowedAt(session, index), index)
    WebSetAt(ordered, index, value)
    unused WebCall2(nodes, WebName("set"), identity, value)
    return !WebFailed()
}

DomRemoveStale :: () -> bool {
    iterator := WebAsObject(WebCall0(dom_nodes, WebName("values")))
    if iterator == 0 { return false }
    while true {
        scope := WebScope()
        next := WebAsObject(WebCall0(iterator, WebName("next")))
        if next == 0 { WebEnd(scope); return false }
        done := WebAsBool(WebGet(next, WebName("done")))
        if !done { unused WebCall0(WebGetObject(next, WebName("value")), WebName("remove")) }
        failed := WebFailed()
        WebEnd(scope)
        if failed { return false }
        if done { return true }
    }
}

DomNodePlace :: (session: Session, index: s32, ordered: s32) -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    node := TreeNodeAt(session, index)
    element := WebAt(ordered, index)
    handle := WebAsObject(element)
    parent := ifx node.parent > 0 then WebAt(ordered, node.parent) else WebObject(dom_root)
    next := ifx node.next_sibling > 0 then WebAt(ordered, node.next_sibling) else WebNull()
    same_parent := DomSame(WebGet(handle, WebName("parentNode")), parent)
    if same_parent && DomSame(WebGet(handle, WebName("nextElementSibling")), next) { return true }
    target := WebAsObject(parent)
    move := WebName("moveBefore")
    if same_parent && !WebIsUndefined(WebGet(target, move)) {
        unused WebCall2(target, move, element, next)
    } else {
        unused WebCall2(target, WebName("insertBefore"), element, next)
    }
    return !WebFailed()
}

DomTreePublish :: (session: Session) -> bool {
    scope := WebScope()
    defer WebEnd(scope)
    nodes := WebNew0(WebGetObject(WebGlobal, WebName("Map")))
    ordered := WebNew0(WebGetObject(WebGlobal, WebName("Array")))
    if nodes == 0 || ordered == 0 { return false }
    count := TreeCount(session)
    focused := WebGetObject(dom_document, WebName("activeElement"))
    dom_focus_index = 0
    for index: 1..count - 1 {
        if !DomNodeCollect(session, index, nodes, ordered) { return false }
        if TreeFocusedAt(session, index) { dom_focus_index = index }
    }
    if !DomRemoveStale() { return false }
    // Place siblings from the end so their successor is already in position.
    index := count - 1
    while index > 0 {
        if !DomNodePlace(session, index, ordered) { return false }
        index -= 1
    }
    WebRelease(dom_nodes)
    dom_nodes = WebKeep(nodes)
    if dom_focus_index > 0 {
        expected := WebAt(ordered, dom_focus_index)
        actual := WebGet(dom_document, WebName("activeElement"))
        if !DomSame(actual, expected) {
            // Reordering can blur an element. Keep focus on the retained owner.
            if DomSame(actual, WebObject(focused)) || !DomContains(WebAsObject(actual)) {
                unused WebCall0(WebAsObject(expected), WebName("focus"))
            }
        }
    }
    return true
}
