Button :: #import "kryon/button";
ButtonGroup :: #import "kryon/button_group";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"

state: ButtonGroup.ButtonGroupState;
active: s32;
#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return 0 }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Button group", .size = 28})
    items := Button.Props.[.{.label = "Left"}, .{.label = "Center"}, .{.label = "Right"}]
    for index: 0..cast(s32)items.count - 1 { items[index].disabled = example_disabled }
    result := ButtonGroup.Draw(session, ButtonGroup.Props.{.bounds = .{height = 44}, .full_width = true}, items[:], *state)
    if result.activated_index >= 0 { active = result.activated_index }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 36}, .text = items[active].label})
    unused End(session)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
