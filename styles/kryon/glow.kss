  opacity: 0.45;
}

TabClose {
  background: transparent;
  foreground: muted;
  border: transparent;
  radius: radius.sm;
  border-width: border.none;
  opacity: 1;
  material: glow;
}

TabClose:hover {
  background: panel-hover;
  background-end: panel-hover-end;
  foreground: accent;
}

SegmentedControl {
  background: surface;
  foreground: text;
  border: border-soft;
  radius: radius.md;
  border-width: border;
  padding-x: 2;
  padding-y: 2;
  gap: space.2;
  opacity: 1;
  material: glow;
}

Segment {
  background: transparent;
  foreground: muted;
  border: transparent;
  focus: focus;
  radius: radius.sm;
  border-width: border.none;
  padding-x: space.3;
  padding-y: 7;
