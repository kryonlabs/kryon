#import "geometry"
#import "style"

# Typeface lookup, shaping and glyph measurement remain host services.
# Inheritance and layout policy must not differ between renderers.
#program_export
TextContentColorFor :: (fields: u32, field: u32, color: u32,
    fallback: u32) -> u32 {
    if (fields & field) != cast(u32)0 || (color & cast(u32)255) != cast(u32)0 {
        return color
    }
    return fallback
}

#program_export
TextSelectionColorFor :: (color: u32) -> u32 {
    alpha: u32 = (color & cast(u32)255) * cast(u32)TextSelectionDefaultAlpha() / cast(u32)255
    return (color & ~cast(u32)255) | alpha
}

TextAppearance :: struct {
    font: s32
    color: u32
    letter_spacing: s32
}

#program_export
ResolveTextStyle :: (font: s32, inherited_font: s32, default_font: s32,
    color: u32, inherited_color: u32, fallback_color: u32, inherited_color_set: bool,
    color_set: bool,
    disabled: bool, inherited_disabled: bool, letter_spacing: s32) -> TextAppearance {
    style: TextAppearance
    style.font = ResolveFont(font, inherited_font, default_font)
    style.color = color
    # Both explicit and inherited foregrounds may intentionally be transparent.
    # Presence is independent of alpha; only absent colors use the minimal
    # fallback supplied by the host.
    if !color_set {
        style.color = fallback_color
        if inherited_color_set {
            style.color = inherited_color
        }
    }
    # A parent's resolved foreground already includes its disabled style.
    # An explicit child color still needs disabled presentation of its own.
    if (disabled || inherited_disabled) &&
       (color_set || !inherited_color_set || !inherited_disabled) {
        alpha: u32 = cast(u32)(cast(float32)(style.color & cast(u32)255) * 0.45)
        style.color = ((style.color >> cast(u32)8) << cast(u32)8) | alpha
    }
    style.letter_spacing = letter_spacing
    if style.letter_spacing < 0 {
        style.letter_spacing = 0
    }
    return style
}

#program_export
TextExtent :: (requested: float32, measured: float32) -> float32 {
    if requested > 0.0 {
        return requested
    }
    return measured
}

#program_export
TextWrapPolicy :: (width: float32, requested: s32) -> s32 {
    if width <= 0.0 {
        return 1
    }
    return requested
}

#program_export
TextDoubleClickSlopFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(6.0 * scale)
}

#program_export
TextDoubleClickShouldSelectLine :: (same_target: bool, same_line: bool,
    last_time: float32, now: float32, dx: float32, dy: float32,
    scale: float32) -> bool {
    slop: s32 = TextDoubleClickSlopFor(scale)
    if !same_target || !same_line || last_time < 0.0 {
        return false
    }
    if now - last_time > 0.40 {
        return false
    }
    if dx < cast(float32)-slop || dx > cast(float32)slop {
        return false
    }
    if dy < cast(float32)-slop || dy > cast(float32)slop {
        return false
    }
    return true
}

#program_export
TextControlBaselineSample :: () -> string {
    return "Hg"
}

#program_export
TextControlClipGuardFor :: (scale: float32) -> s32 {
    pad: s32 = 1
    if scale <= 0.0 { scale = 1.0 }
    pad = cast(s32)(1.0 * scale)
    if pad < 1 { pad = 1 }
    return pad
}

#program_export
TextControlClipBounds :: (bounds: Rectangle, scale: float32) -> Rectangle {
    pad: s32 = TextControlClipGuardFor(scale)
    clip: Rectangle = bounds
    clip.y -= cast(float32)pad
    clip.height += cast(float32)(pad * 2)
    return clip
}

#program_export
TextCenteredY :: (bounds: Rectangle, line_height: s32) -> s32 {
    return cast(s32)bounds.y + (cast(s32)bounds.height - line_height) / 2
}

#program_export
TextCenteredX :: (bounds: Rectangle, text_width: s32) -> s32 {
    return cast(s32)(bounds.x + (bounds.width - cast(float32)text_width) * 0.5)
}

#program_export
TextBaselineYFor :: (box_y: s32, box_h: s32, fallback_height: s32,
    has_glyphs: bool, min_top: float32, max_bottom: float32) -> s32 {
    if !has_glyphs {
        return box_y + cast(s32)((cast(float32)box_h - cast(float32)fallback_height) * 0.5 + 0.5)
    }
    glyph_height: float32 = max_bottom - min_top
    return box_y + cast(s32)((cast(float32)box_h - glyph_height) * 0.5 - min_top + 0.5)
}

#program_export
TextHeightFor :: (fallback_height: s32, has_glyphs: bool,
    min_top: float32, max_bottom: float32) -> s32 {
    if !has_glyphs {
        return fallback_height
    }
    return cast(s32)(max_bottom - min_top + 0.5)
}

#program_export
TextLineHeightFor :: (font_base_size: s32, fallback_base_size: s32,
    scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    base: s32 = font_base_size
    if base <= 0 {
        base = fallback_base_size
    }
    return cast(s32)(cast(float32)base * scale + 0.5)
}

#program_export
TextSelectionLineEndPaddingFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(6.0 * scale)
}

#program_export
TextSelectionMinWidthFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(4.0 * scale)
}

#program_export
TextSelectionDefaultAlpha :: () -> u8 {
    return cast(u8)88
}

#program_export
TextSelectionHighlightEndX :: (start_x: s32, end_x: s32,
    continues_past_line: bool, scale: float32) -> s32 {
    if continues_past_line {
        end_x += TextSelectionLineEndPaddingFor(scale)
    }
    if end_x <= start_x {
        return start_x + TextSelectionMinWidthFor(scale)
    }
    return end_x
}

TextSelectionPointerDecision :: struct {
    hover: bool
    begin: bool
}

TextSelectionDragDecision :: struct {
    active: bool
    update: bool
    finish: bool
}

TextSelectionCopyDecision :: struct {
    copy: bool
}

#program_export
TextSelectionPointerDecisionFor :: (inside: bool, captured: bool,
    pressed: bool) -> TextSelectionPointerDecision {
    out: TextSelectionPointerDecision
    out.hover = inside && !captured
    out.begin = out.hover && pressed
    return out
}

#program_export
TextSelectionDragDecisionFor :: (same_id: bool, dragging: bool,
    down: bool) -> TextSelectionDragDecision {
    out: TextSelectionDragDecision
    out.active = same_id && dragging
    out.update = out.active && down
    out.finish = out.active && !down
    return out
}

#program_export
TextSelectionCopyDecisionFor :: (same_id: bool, keyboard_enabled: bool,
    modifier_down: bool, copy_pressed: bool) -> TextSelectionCopyDecision {
    out: TextSelectionCopyDecision
    out.copy = same_id && keyboard_enabled && modifier_down && copy_pressed
    return out
}

#program_export
TextSelectionRangeShouldShow :: (same_id: bool) -> bool {
    return same_id
}

#program_export
TextAlignmentOffset :: (available: float32, measured: float32, alignment: s32) -> float32 {
    if alignment == 1 {
        return (available - measured) * 0.5
    }
    if alignment == 2 {
        return available - measured
    }
    return 0.0
}

# Decorations use the same measured line geometry as the glyphs.
#program_export
TextStrikethroughBounds :: (x: float32, y: float32, width: float32,
    line_height: float32, scale: float32) -> Rectangle {
    result: Rectangle
    if scale < 1.0 { scale = 1.0 }
    result.x = x
    result.y = y + line_height * 0.5
    result.width = width
    result.height = scale
    return result
}
