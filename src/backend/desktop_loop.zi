// The desktop frame loop every desktop host runs: the window's events, the
// app's frame and presenting. desktop_run is the default host; a program can
// pass its frame directly to Run. A host that runs frames registers the
// widget tree's frame driver first (TreeFrameUse, see frame_driver); without
// one the window only clears and presents.
#import "secondary_pointer"
#import "desktop_accessibility"
#import "cairo_raster"
#import "desktop_runtime"
#import "frame_driver"
#import "input_protocol"
#import "input_delivery"
using Geometry :: #import "geometry";
#import "program_title"
using SessionModule :: #import "session";
Clock :: #import "frame_clock";
Timer :: #import "std/timer_linux";
#import "std/file_linux"
#import "std/c_string"

frame_activity: Clock.FrameActivity;
last_pointer: Vector2; last_width: float32; last_height: float32;

#if OS == .WINDOWS {
    Process :: #import "desktop_process_windows";
} else {
    Process :: #import "desktop_process_linux";
}

DesktopError :: (message: string) -> s32 {
    output: [256]u8
    length: s32 = cast(s32)message.count
    if length > 254 { length = 254 }
    index: s32 = 0
    while index < length {
        output[index] = message[index]
        index += 1
    }
    output[index] = cast(u8)10
    Process.Report(2, *output[0], cast(usize)(length + 1))
    return 1
}

DrawFrame :: (session: Session, draw: FrameDraw, title: string = "",
    keyboard_activity: bool = false) -> bool {
    origin: Vector2 = DesktopOrigin()
    if access_frame != null { access_frame(cast(s32)origin.x, cast(s32)origin.y) }
    BeginDesktopFrame()
    viewport: Rectangle = DesktopViewport()
    pointer: PointerFrame = PollPointer()
    secondary := PollSecondaryPointer()
    wheel := DesktopWheelMove()
    active := keyboard_activity || pointer.down || pointer.pressed || pointer.released ||
        secondary.down || secondary.pressed || secondary.released || wheel != 0.0 ||
        pointer.x != last_pointer.x || pointer.y != last_pointer.y ||
        viewport.width != last_width || viewport.height != last_height
    last_pointer = .{pointer.x, pointer.y}
    last_width = viewport.width; last_height = viewport.height
    compare := Clock.Observe(*frame_activity, active)
    if frame_run == null {
        // No widgets: the window shows its cleared surface.
        unused draw(session, viewport)
        DesktopFrameUnchanged(DesktopFrameReusable() && compare)
    } else {
        input := FrameDriverInput.{.draw = draw, .viewport = viewport, .pointer = pointer,
            .secondary = secondary, .wheel = wheel,
            .seconds = cast(float64)Timer.MonotonicMilliseconds() / 1000.0,
            .reusable = DesktopFrameReusable(), .compare = compare,
            .frame_input = DesktopFrameInputPrepare()}
        finished := frame_run(session, input)
        if !finished.ok { return false }
        unused DesktopCursorApply(finished.cursor)
        DesktopFrameUnchanged(finished.paint_unchanged)
    }
    // Present before publishing accessibility changes: they never change
    // pixels, and assistive technology reads the same finished tree.
    presented := EndDesktopFrame()
    if !CaptureRequested() && access_publish != null && !access_publish(session, title) {
        unused DesktopError("kryon: accessibility synchronization failed")
    }
    return presented
}

// Runs `draw` in a desktop window of `width` by `height` pixels until it
// closes, and returns the program's exit status. The window takes its title
// from the file the project tool writes beside the program.
Run :: (draw: FrameDraw, width: s32 = 960, height: s32 = 600) -> s32 {
    return RunTitled(draw, width, height, ProgramTitle())
}

// Runs `draw` in a window titled `title`.
RunTitled :: (draw: FrameDraw, width: s32, height: s32, title: string) -> s32 {
    if !OpenDesktopTitled(width, height, title) {
        CloseDesktop()
        return DesktopError("kryon: could not open the desktop window")
    }
    session: Session = SessionOpen()
    if !SessionValid(session) {
        CloseDesktop()
        return DesktopError("kryon: could not open a UI session")
    }
    ok: bool = true
    if CaptureRequested() {
        ok = PollDesktop() && DrawFrame(session, draw, title)
        // A capture shows smooth pictures' finished Lanczos copies.
        settled := 0
        while ok && settled < 64 && RasterSettle() {
            ok = DrawFrame(session, draw, title)
            settled += 1
        }
        if ok { ok = CaptureConfigured() }
    } else {
        while ok {
            if !PollDesktop() { break }
            if frame_test_input != null { frame_test_input(DesktopInputQueue()) }
            keyboard_activity := frame_keys != null &&
                frame_keys(session, DesktopInputQueue(), DesktopModifiers())
            ok = DrawFrame(session, draw, title, keyboard_activity)
            if frame_after != null { frame_after(session) }
            if ok { PauseDesktop() }
        }
    }
    if access_close != null { access_close() }
    if frame_session_end != null { unused frame_session_end(session) }
    CloseDesktop()
    if ok { return 0 }
    return DesktopError("kryon: desktop frame rendering failed")
}

// Starts the program where MARKER, such as "assets/art/title.png", exists:
// the working directory, or else the program's directory or one of its three
// parents, so a program opened from its build folder still finds its files.
DesktopStartBeside :: (marker: string) -> bool {
    if PathExists(marker) { return true }
    bytes: [4096]u8
    program := ProgramPath(bytes[:])
    start := ProgramNameStart(program)
    if start <= 1 { return false }
    directory: [4096]u8
    if !CopyCString(program[0:start - 1], directory[:]) || Process.ChangeDirectory(*directory[0]) != 0 {
        return false
    }
    up: [3]u8 = .[46, 46, 0]
    for level: 0..3 {
        if PathExists(marker) { return true }
        if level < 3 && Process.ChangeDirectory(*up[0]) != 0 { return false }
    }
    return false
}
