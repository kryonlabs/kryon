// Identical installed-resolution workloads for baseline and candidate.
// The Python driver validates results with an independent cascade oracle.
#import "style_sheet"
#import "style"
#import "control_props"
using StyleField;
using ButtonState;

#program_export
Prepare :: (count: s32) -> bool {
    if count < 1 || count > StyleRuleCapacity { return false }
    rules: StyleRules; rules.count = count
    for i: 0..count - 1 {
        rules.items[i].selector = StyleDefaultSelector()
        if i % 3 == 0 { rules.items[i].selector.kind = StyleKindButton() }
        if i % 5 == 0 { rules.items[i].selector.class_name = 2 }
        rules.items[i].state = ifx i % 4 == 0 then cast(s32)ButtonStateHover else StyleStateAny()
        rules.items[i].layer = i % 3; rules.items[i].order = i
        rules.items[i].style.fields = cast(u32)StyleBackground | cast(u32)StyleForeground | cast(u32)StyleFontSize
        rules.items[i].style.background = cast(u32)(i + 100)
        rules.items[i].style.foreground = cast(u32)(i + 200)
        rules.items[i].style.font_size = cast(float32)(12 + i % 9)
    }
    return InstallStyleRules(rules)
}

#program_export
Query :: (mode: s32, calls: s32) -> u64 {
    digest: u64 = 1
    for i: 0..calls - 1 {
        query := ifx mode == 0 then 2 else i
        facts := StyleDefaultFacts(ifx query % 2 == 0 then StyleKindButton() else StyleKindText())
        // Varied selectors deliberately exceed the former 320 result slots.
        facts.name = query; facts.class_name = query % 997
        active := ifx query % 4 < 2 then cast(s32)ButtonStateNormal else cast(s32)ButtonStateHover
        base: StyleData; base.fields = cast(u32)StyleForeground
        base.foreground = cast(u32)i; base.padding_x = cast(float32)(i % 11)
        result: StyleData
        result = ResolveInstalledStyleRules(base, facts, active)
        digest = (digest ^ (cast(u64)result.background + cast(u64)result.foreground + cast(u64)result.font_size + cast(u64)result.padding_x)) * cast(u64)1099511628211
    }
    return digest
}

#program_export
Updates :: (calls: s32, count: s32) -> u64 {
    digest: u64
    for i: 0..calls - 1 {
        if !Prepare(count - i % 2) { return 0 }
        digest = digest ^ Query(1, 13)
    }
    return digest
}
