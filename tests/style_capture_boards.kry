#import "kryon.h"
#import "kry_inject.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

app "Kryon Style Capture Boards" {
    size 900 960
    fps 60
    before_window StyleBoardBeforeWindow
    init StyleBoardInit
    after_frame StyleBoardAfterFrame
    should_continue StyleBoardContinue
}

state {
    board_output_dir: const char*
    board_index: int = 0
    board_selected_index: int = -1
    board_capture_frame: int = 0
    board_field_text: [64]char = {0}
    board_cursor: int = 6
    board_field_focused: int = 0
    board_dropdown_selected: int = 1
    board_checkbox_flags: int = 5
    board_toggle_on: int = 1
}

StyleBoardBeforeWindow :: () -> bool {
    private_display: const char* = getenv("KRYON_PRIVATE_DISPLAY")
    display: const char* = getenv("DISPLAY")
    if private_display == nil || display == nil ||
    strcmp(private_display, "1") != 0 ||
    strncmp(display, ":0", 2) == 0 {
        puts("Style capture requires a private X display")
        return false
    }
    board_output_dir = getenv("KRYON_STYLE_CAPTURE_DIR")
    if board_output_dir == nil || board_output_dir[0] == '\0' {
        puts("Style capture requires an output directory")
        return false
    }
    SetConfigFlags(FLAG_WINDOW_HIDDEN | FLAG_MSAA_4X_HINT)
    return true
}

StyleBoardInit :: () {
    if kry_fs_mkdir_p(board_output_dir) != 0 {
        puts("Could not create style capture directory")
        exit(1)
    }
    snprintf(&board_field_text[0], sizeof(board_field_text),
    "%s", "style board")
    SetThemeMode(THEME_MODE_DARK)
}

StyleBoardContinue :: () -> bool {
    return board_index < 10
}

StyleBoardPack :: (index: int) -> const char* {
    if index < 2 { return "material" }
    if index < 4 { return "classic" }
    if index < 8 { return "lightfield" }
    return "none"
}

StyleBoardName :: (index: int) -> const char* {
    names: [10]const char* = {
        "material-dark", "material-light",
        "classic-dark", "classic-light",
        "lightfield-flat-dark", "lightfield-flat-light",
        "lightfield-glow-dark", "lightfield-glow-light",
        "none-dark", "none-light"
    }
    return names[index]
}

StyleBoardSelectPack :: () {
    if board_selected_index == board_index { return }
    pack: const char* = StyleBoardPack(board_index)
    if board_index >= 8 {
        ClearStylePacks()
    } else {
        if !EnsureBuiltInStylePacks() || !SetActiveStylePack(pack) {
            fprintf(stderr, "style pack '%s' unavailable\n", pack)
            exit(1)
        }
    }
    SetThemeMode(board_index % 2 == 0 ? THEME_MODE_DARK : THEME_MODE_LIGHT)
    SetFancyEffectsEnabled(board_index == 6 || board_index == 7)
    InjectReset()
    InjectMousePosition(-1000, -1000)
    InjectPump()
    board_selected_index = board_index
}

StyleBoardAfterFrame :: () {
    if board_capture_frame < 2 {
        board_capture_frame += 1
        return
    }
    image: Image = LoadImageFromScreen()
    if image.data == nil {
        puts("Could not capture style board")
        exit(1)
    }
    path: [1200]char = {0}
    snprintf(&path[0], sizeof(path), "%s/%s.png",
    board_output_dir, StyleBoardName(board_index))
    if !ExportImage(image, &path[0]) {
        UnloadImage(image)
        puts("Could not save style board PNG")
        exit(1)
    }
    puts(&path[0])
    UnloadImage(image)
    board_capture_frame = 0
    board_index += 1
}

StyleBoardText :: (value: const char*, y: int,
height: int) {
    props: TextProps = {0}
    props.bounds = (Rectangle){24, (float)y, 640, (float)height}
    props.text = value
    props.wrap = TextWrapNone
    Text(props)
}

StyleBoardContent :: () {
    states: [7]ButtonState = {
        ButtonStateNormal, ButtonStateHover, ButtonStatePressed,
        ButtonStateFocus, ButtonStateDisabled, ButtonStateSelected,
        ButtonStateLoading
    }
    state_names: [7]const char* = {
        "normal", "hover", "pressed", "focus", "disabled", "selected",
        "loading"
    }
    tones: [3]ButtonTone = {
        ButtonToneNeutral, ButtonToneAccent, ButtonToneDanger
    }
    emphases: [4]ButtonEmphasis = {
        ButtonEmphasisFilled, ButtonEmphasisSoft,
        ButtonEmphasisOutline, ButtonEmphasisGhost
    }
    emphasis_names: [4]const char* = {
        "filled", "soft", "outline", "ghost"
    }
    items: [3]const char* = {
        "Morning", "Long Session", "Focus"
    }
    y: int = 32
    StyleBoardText("Kryon style capture board", y, 30)
    y += 44

    StyleBoardText("Button states", y, 22)
    y += 30
    for int i = 0; i < 7; i++ {
        props: ButtonProps = {0}
        props.bounds = (Rectangle){(float)(24 + i * 124),
        (float)y, 112, 36}
        props.label = state_names[i]
        props.id = 9000 + i
        props.state = states[i]
        props.disabled = states[i] == ButtonStateDisabled
        props.loading = states[i] == ButtonStateLoading
        props.selected = states[i] == ButtonStateSelected
        props.tone = ButtonToneAccent
        props.emphasis = ButtonEmphasisFilled
        Button(props)
    }
    y += 52

    StyleBoardText("Tones x emphasis", y, 22)
    y += 30
    for int i = 0; i < 3; i++ {
        for int e = 0; e < 4; e++ {
            props: ButtonProps = {0}
            props.bounds = (Rectangle){(float)(24 + e * 160),
            (float)(y + i * 44), 148, 36}
            props.label = emphasis_names[e]
            props.id = 9100 + i * 10 + e
            props.tone = tones[i]
            props.emphasis = emphases[e]
            Button(props)
        }
    }
    y += 3 * 44 + 18
    StyleBoardText("Class selector", y, 22)
    y += 30
    primary: ButtonProps = {0}
    primary.bounds = (Rectangle){24, (float)y, 220, 36}
    primary.label = ".primary"
    primary.id = 9200
    primary.class_name = StyleClassId("primary")
    primary.tone = ButtonToneAccent
    primary.emphasis = ButtonEmphasisFilled
    Button(primary)
    y += 52

    StyleBoardText("TextInput", y, 22)
    y += 30
    field: TextFieldProps = {0}
    field.bounds = (Rectangle){24, (float)y, 320, 40}
    field.text = &board_field_text[0]
    field.text_size = sizeof(board_field_text)
    field.cursor_position = &board_cursor
    field.focused = &board_field_focused
    field.max_codepoints = 63
    field.focus_id = 9300
    TextField(field)
    y += 56

    StyleBoardText("Selection widgets", y, 22)
    y += 30
    feature: CheckboxProps = {0}
    feature.bounds = (Rectangle){24, (float)y, 200, 34}
    feature.id = 9400
    feature.label = "Feature"
    feature.flags = &board_checkbox_flags
    feature.flags_value = 1
    Checkbox(feature)
    disabled: CheckboxProps = feature
    disabled.bounds = (Rectangle){24, (float)(y + 42), 200, 34}
    disabled.id = 9401
    disabled.label = "Disabled"
    disabled.flags_value = 4
    disabled.disabled = true
    Checkbox(disabled)
    toggle: ToggleProps = {0}
    toggle.bounds = (Rectangle){250, (float)y, 220, 34}
    toggle.id = 9410
    toggle.value = &board_toggle_on
    toggle.off_label = "Off"
    toggle.on_label = "On"
    Toggle(toggle)
    progress: ProgressProps = {0}
    progress.bounds = (Rectangle){250, (float)(y + 44), 220, 20}
    progress.min = 0
    progress.max = 100
    progress.value = 62
    progress.label = "Progress"
    Progress(progress)
    y += 96

    StyleBoardText("Dropdown", y, 22)
    y += 30
    dropdown: DropdownProps = {0}
    dropdown.id = 9500
    dropdown.bounds = (Rectangle){24, (float)y, 260, 40}
    dropdown.options = &items[0]
    dropdown.option_count = 3
    dropdown.selected_index = &board_dropdown_selected
    Dropdown(dropdown)
}

StyleCaptureBoard :: (viewport: Rectangle) #ui {
    StyleBoardSelectPack()
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        StyleBoardContent()
    }
}
