// Binds the example's real ZX to a deterministic, display-free host.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "hosted_values"
#import "input_protocol"
Names :: #import "bundle_names";

using HostValueKind;
using BundleBackendPolicy;

Event :: struct {
    kind: s32
    x: s32
    y: s32
    button: s32
    key: s32
    modifiers: s32
    width: s32
    height: s32
    text: string
}

events: [11]Event = .[
    .{.kind = 0},
    .{.kind = 4, .x = 40, .y = 55},
    .{.kind = 5, .x = 40, .y = 55, .button = 1},
    .{.kind = 6, .x = 40, .y = 55, .button = 1},
    .{.kind = 5, .x = 40, .y = 99, .button = 1},
    .{.kind = 6, .x = 40, .y = 99, .button = 1},
    .{.kind = 9, .text = "éx"},
    .{.kind = 7, .key = KeyBackspace},
    .{.kind = 8, .key = KeyBackspace},
    .{.kind = 3, .width = 280, .height = 160},
    .{.kind = 2}
];

IdleSamples :: 24
MotionSamples :: 24

Host :: struct {
    cursor: s32
    presents: s32
    presented_at: u32
    wait_ms: s32
    opened: bool
    closed: bool
    label: u64
    frame_hash: u64
    sequence_hash: u64
    row_end: s32
    row_pending: bool
    row_limit: s32
    largest_strip: s32
    row_frame: [280 * 160 * 4]u8
    event_type: *u8
    fields: [9]HostField
}

EncodeEvent :: (host: *Host, event: Event) -> HostValue {
    names := string.["kind", "x", "y", "button", "key", "modifiers", "width", "height"]
    values := s32.[event.kind, event.x, event.y, event.button, event.key, event.modifiers, event.width, event.height]
    for index: 0..7 {
        host.fields[index] = .{HostTextData(names[index]), HostScalar("s32", cast(s64)values[index])}
    }
    host.fields[8] = .{HostTextData("text"), .{.kind = HostString, .type_name = HostTextData("string"),
        .data = HostTextData(event.text), .length = cast(usize)event.text.count}}
    return .{.kind = HostRecord, .type_name = host.event_type, .fields = *host.fields[0], .field_count = 9}
}

FrameValid :: (host: *Host, args: *HostValue) -> bool {
    width := args[0].integer
    height := args[1].integer
    rgba := args[2]
    expected_width: s64 = ifx host.cursor >= 10 then 280 else 240
    expected_height: s64 = ifx host.cursor >= 10 then 160 else 144
    if width != expected_width || height != expected_height || rgba.kind != HostString ||
        rgba.length != cast(usize)(width * height * 4) || rgba.data == null { return false }
    // This corner is untouched by the widgets. Verify all channel offsets.
    if rgba.data[0] != 248 || rgba.data[1] != 250 || rgba.data[2] != 252 || rgba.data[3] != 255 { return false }
    hash: u64
    glyph := false
    for y: 8..31 {
        for x: 12..42 {
            at := (cast(s64)y * width + x) * 4
            color := rgba.data[at]
            if color < 128 { glyph = true }
            hash = hash * 31 + cast(u64)color
        }
    }
    if !glyph { return false }
    if host.presents == 0 { host.label = hash }
    // A completed click paints a different count with the same layout.
    return host.cursor < 4 || hash != host.label
}

RecordFrame :: (host: *Host, rgba: HostValue) {
    host.presents += 1
    if host.cursor <= cast(s32)events.count { host.presented_at |= cast(u32)1 << cast(u32)host.cursor }
    hash := cast(u64)14695981039346656037
    for index: cast(s64)0..cast(s64)rgba.length - 1 {
        hash = (hash ^ cast(u64)rgba.data[index]) * cast(u64)1099511628211
    }
    host.frame_hash = hash
}

CollectRows :: (host: *Host, args: *HostValue) -> bool {
    width := args[0].integer
    height := args[1].integer
    first := args[2].integer
    rgba := args[3]
    expected_width := ifx host.cursor >= 10 then 280 else 240
    expected_height := ifx host.cursor >= 10 then 160 else 144
    if width != expected_width || height != expected_height || first < 0 || first >= height ||
        rgba.kind != HostString || rgba.data == null || rgba.length == 0 ||
        rgba.length % cast(usize)(width * 4) != 0 { return false }
    rows := cast(s64)rgba.length / (width * 4)
    full := host.cursor == 0 || host.cursor == 10 || host.cursor == 11
    if rows > host.row_limit || first + rows > height || (host.row_pending && first != host.row_end) ||
        (full && !host.row_pending && first != 0) { return false }
    at := first * width * 4
    for index: cast(s64)0..cast(s64)rgba.length - 1 { host.row_frame[at + index] = rgba.data[index] }
    host.row_end = cast(s32)(first + rows)
    if rows > host.largest_strip { host.largest_strip = cast(s32)rows }
    host.row_pending = true
    return true
}

FinishRows :: (host: *Host) -> bool {
    if !host.row_pending { return true }
    width := ifx host.cursor >= 10 then 280 else 240
    height := ifx host.cursor >= 10 then 160 else 144
    full := host.cursor == 0 || host.cursor == 10 || host.cursor == 11
    if full && host.row_end != height { return false }
    args := HostValue.[HostScalar("s32", width), HostScalar("s32", height),
        .{.kind = HostString, .data = *host.row_frame[0], .length = cast(usize)(width * height * 4)}]
    if !FrameValid(host, *args[0]) { return false }
    RecordFrame(host, args[2])
    host.row_pending = false
    return true
}

Call :: (context: *void, module: *u8, function: *u8, args: *HostValue, count: s32, reply: *HostValue) -> s32 {
    unused module
    host := cast(*Host)context
    name := TextFromCString(function)
    if name == "Open" && count == 3 && !host.opened && args[0].kind == HostString &&
        HostValueText(args[0]) == "Kryon hosted surface" && args[1].integer == 240 && args[2].integer == 144 {
        host.opened = true
        reply.* = HostScalar("bool", 1)
        return 1
    }
    if !host.opened || host.closed { return 0 }
    if name == "Present" && count == 3 && FrameValid(host, args) {
        RecordFrame(host, args[2])
        reply.* = HostScalar("bool", 1)
        return 1
    }
    if name == "PresentRows" && count == 4 && CollectRows(host, args) {
        reply.* = HostScalar("bool", 1)
        return 1
    }
    if name == "Event" && count == 1 && args[0].integer == host.wait_ms && FinishRows(host) && host.presents > 0 {
        host.sequence_hash = (host.sequence_hash ^ host.frame_hash) * cast(u64)1099511628211
        scripted := cast(s32)events.count
        event: Event
        if host.cursor < scripted { event = events[host.cursor] }
        else if host.cursor < scripted + IdleSamples { event.kind = 0 }
        else if host.cursor < scripted + IdleSamples + MotionSamples {
            event = .{.kind = 4, .x = 2 + host.cursor % 4, .y = 140}
        } else { event.kind = 1 }
        reply.* = EncodeEvent(host, event)
        host.cursor += 1
        return 1
    }
    if name == "Close" && count == 0 {
        host.closed = true
        reply.kind = HostVoid
        return 1
    }
    print("Unexpected surface call % at event % after % presents\n", name, host.cursor, host.presents)
    return 0
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 && argc != 3 { return 1 }
    bundle := OpenBundle(argv[1])
    if bundle == null { return 2 }
    defer CloseBundle(bundle)
    if BundleCapabilities(bundle) != 4 { return 3 }
    host: Host
    host.row_limit = 32
    pixels := argc == 3 && (TextFromCString(argv[2]) == "pixels" || TextFromCString(argv[2]) == "wake-pixels")
    if pixels { host.row_limit = 32 }
    wake := argc == 3 && (TextFromCString(argv[2]) == "wake" || TextFromCString(argv[2]) == "wake-rows" ||
        TextFromCString(argv[2]) == "wake-pixels")
    full := argc == 3 && TextFromCString(argv[2]) == "timed-full"
    rows := pixels || (argc == 3 && (TextFromCString(argv[2]) == "rows" || TextFromCString(argv[2]) == "wake-rows"))
    timed := full || rows || (argc == 3 && TextFromCString(argv[2]) == "timed")
    host.wait_ms = ifx timed then 250 else 1000
    if wake { host.wait_ms = 2000 }
    bindings: [4]HostBinding
    for index: 0..3 {
        abi: BundleCapabilityAbi
        if ReadBundleCapabilityAbi(bundle, cast(u64)index, *abi) == 0 { return 4 }
        function := TextFromCString(abi.function)
        source := TextFromCString(abi.module)
        if rows && function == "PresentRows" {
            if !Names.ModuleName(source, "hosted_surface_state") { return 4 }
        } else if !Names.ModuleName(source, "zx_surface") { return 4 }
        if function == "Event" { host.event_type = abi.return_type }
        else if function != "Open" && function != "Close" &&
            function != (ifx rows then "PresentRows" else "Present") { return 5 }
        bindings[index] = .{abi.module, abi.function, Call, cast(*void)*host}
    }
    if host.event_type == null { return 6 }
    options: BundleInstanceOptions = .{.backend = cast(BundleBackendPolicy)Engine}
    instance := InstantiateBundleWithOptions(bundle, *bindings[0], 4, *options)
    if instance == null { return 7 }
    defer CloseBundleInstance(instance)
    answer: s64
    has_answer: s32
    if RunBundleInstance(instance, *answer, *has_answer) == 0 || has_answer == 0 || answer != 0 { return 8 }
    print("Hosted surface Engine: % presents, event mask %\n", host.presents, host.presented_at)
    print("Visible RGBA sequence: %\n", host.sequence_hash)
    if !host.closed || host.cursor != cast(s32)events.count + IdleSamples + MotionSamples + 1 ||
        (pixels && host.largest_strip != 32) { return 9 }
    if full { return ifx host.presents == host.cursor then 0 else 9 }
    if !timed {
        // The three-argument default paints every non-idle host event.
        expected: u32 = 1
        count := MotionSamples + 1
        for index: cast(s32)0..cast(s32)events.count - 1 {
            if events[index].kind != 0 {
                expected |= cast(u32)1 << cast(u32)(index + 1)
                count += 1
            }
        }
        if wake { expected |= 1 << 1; count += 2 }
        return ifx host.presents == count && host.presented_at == expected then 0 else 9
    }
    // An unchanged idle frame never presents. A host expose still requests
    // the latest complete image after the resize.
    required: u32 = (1 << 0) | (1 << 2) | (1 << 4) | (1 << 8) | (1 << 10) | (1 << 11)
    if (host.presented_at & required) != required || (host.presented_at & (1 << 1)) != 0 ||
        host.presents >= cast(s32)events.count + 1 { return 9 }
    return 0
}
