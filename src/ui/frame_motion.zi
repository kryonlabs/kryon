Components :: #import "component_frame_slot";
#import "session"

// Hosts supply a monotonic clock. Optional motion modules own their history
// and publish activity only after the tree accepts the frame.
FrameMotionHook :: #type (Session, bool) -> void;
frame_style_motion: FrameMotionHook;
frame_layout_motion: FrameMotionHook;
FrameMotionClock :: #type () -> float64;
frame_motion_clock: FrameMotionClock;

FrameMotionUseClock :: (clock: FrameMotionClock) -> bool {
    frame_motion_clock = clock
    return true
}

// Optional portable providers fill the slot; native hosts supply input time.
// Sample before composition so due timers run before model snapshots are read.
FrameMotionSample :: (session: Session) -> bool {
    if frame_motion_clock == null { return true }
    seconds := frame_motion_clock()
    if seconds < 0.0 { return false }
    SetFrameMotionTime(session, seconds)
    FrameMotionHoldNext(session)
    return true
}

// Optional motion observes portable host time once per frame, at first use.
// Hosts that already supply frame time need no concrete clock here.
FrameMotionTime :: (session: Session, clock: FrameMotionClock) -> float64 {
    slot := SessionIndex(session)
    if slot == 0 { return 0.0 }
    if !SessionFlagGet(frame_motion_observed, slot) {
        SetFrameMotionTime(session, clock())
        frame_motion_observed = SessionFlagSet(frame_motion_observed, slot, true)
    }
    return frame_motion_time[slot]
}

frame_motion_observed: u32;
frame_motion_time: [9]float64;
frame_motion_active: u32;
frame_motion_next: u32;
frame_motion_dirty: u32;
// Set between a structural probe frame and the presented frame that follows
// it: BeginFrame keeps the probe's observed motion time, so transitions and
// animations advance once per displayed frame.
frame_motion_hold: u32;

#program_export
SetFrameMotionTime :: (session: Session, seconds: float64) {
    slot := SessionIndex(session)
    if slot != 0 && seconds >= 0.0 && seconds <= 1.7976931348623157e308 {
        Components.Tick(session, seconds)
        frame_motion_time[slot] = seconds
        frame_motion_observed = SessionFlagSet(frame_motion_observed, slot, true)
    }
}

#program_export
FrameMotionMoving :: (session: Session) -> bool {
    return SessionFlagGet(frame_motion_active, SessionIndex(session))
}

FrameMotionInvalidate :: () { frame_motion_dirty = cast(u32)0x1fe }

FrameMotionMark :: (session: Session) {
    frame_motion_next = SessionFlagSet(frame_motion_next, session.slot, true)
}

FrameMotionBegin :: (session: Session) {
    slot := session.slot
    held := SessionFlagGet(frame_motion_hold, slot)
    frame_motion_hold = SessionFlagSet(frame_motion_hold, slot, false)
    frame_motion_observed = SessionFlagSet(frame_motion_observed, slot,
        SessionFlagGet(frame_motion_observed, slot) && held)
    frame_motion_next = SessionFlagSet(frame_motion_next, session.slot, false)
    if frame_style_motion != null { frame_style_motion(session, false) }
    if frame_layout_motion != null { frame_layout_motion(session, false) }
}

// The next frame on this session reuses the motion time the current frame
// observed. A structural probe frame calls this after its commit so the
// presented frame does not advance animations a second time.
#program_export
FrameMotionHoldNext :: (session: Session) {
    frame_motion_hold = SessionFlagSet(frame_motion_hold, session.slot, true)
}

FrameMotionCommit :: (session: Session) {
    slot := session.slot
    frame_motion_active = SessionFlagSet(frame_motion_active, slot, SessionFlagGet(frame_motion_next, slot))
    frame_motion_dirty = SessionFlagSet(frame_motion_dirty, slot, false)
    if frame_style_motion != null { frame_style_motion(session, true) }
    if frame_layout_motion != null { frame_layout_motion(session, true) }
}

FrameMotionClose :: (session: Session) {
    slot := session.slot
    frame_motion_time[slot] = 0.0
    frame_motion_observed = SessionFlagSet(frame_motion_observed, slot, false)
    frame_motion_active = SessionFlagSet(frame_motion_active, slot, false)
    expired := Session.{.slot = slot}
    if frame_style_motion != null { frame_style_motion(expired, false) }
    if frame_layout_motion != null { frame_layout_motion(expired, false) }
}
