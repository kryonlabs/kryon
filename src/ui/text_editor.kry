#module "text_editor_host"
#import "ui_internal.h"
#import "ui/text_edit.h"
#import "runtime/text_input.h"
#import "string.h"
#import "stdlib.h"

ui_text_copy_range :: (text: const char*, start: i32,
end: i32) -> i32 #export {
    if text == nil { return 0 }
    text_len: i32 = (int)strlen(text)
    range: TextSelectionRange = TextSelectionRangeForLength(
    start, end, text_len)
    start = range.start
    end = range.end
    if end <= start { return 0 }
    length: i32 = end - start
    copy: *char = (char*)malloc((size_t)length + 1)
    if copy == nil { return 0 }
    memcpy(copy, text + start, (size_t)length)
    copy[length] = '\0'
    SetClipboardTextValue(copy)
    free(copy)
    return 1
}

ui_text_paste_clipboard :: (edit: TextEdit,
allow_newlines: i32) -> i32 #export {
    if edit.text == nil || edit.text_size == 0 ||
    edit.cursor_position == nil { return 0 }
    clip: const char* = GetClipboardTextValue()
    if clip == nil { return 0 }
    return ui_text_insert_text(edit.text, edit.text_size,
    edit.cursor_position, clip, allow_newlines,
    edit.filter, edit.filter_user_data, edit.max_codepoints)
}

ui_clipboard_has_text :: () -> i32 #export {
    value: const char* = GetClipboardTextValue()
    return value != nil && value[0] != '\0'
}

g_ui_text_input_codepoints :: [64]i32 #global #export
g_ui_text_input_codepoint_count :: i32 #global #export
g_ui_text_input_backspace_count :: i32 #global #export
g_ui_text_input_enter_count :: i32 #global #export
g_ui_backspace_next_repeat_at :: f64 #global #export

ui_backspace_repeat_count :: () -> i32 #export {
    repeat: TextBackspaceRepeat = TextBackspaceRepeatFor(
    IsKeyPressed(KEY_BACKSPACE) != 0,
    IsKeyDown(KEY_BACKSPACE) != 0,
    GetTime(), g_ui_backspace_next_repeat_at)
    g_ui_backspace_next_repeat_at = repeat.next_repeat_at
    return repeat.count
}

ui_mod_key_down :: () -> i32 #export {
    return IsKeyDown(KEY_LEFT_CONTROL) ||
    IsKeyDown(KEY_RIGHT_CONTROL) ||
    IsKeyDown(KEY_LEFT_SUPER) || IsKeyDown(KEY_RIGHT_SUPER)
}

QueueTextInputCodepoint :: (codepoint: i32) #export {
    if codepoint <= 0 { return }
    if g_ui_text_input_codepoint_count >= 64 { return }
    g_ui_text_input_codepoints[g_ui_text_input_codepoint_count] = codepoint
    g_ui_text_input_codepoint_count += 1
}

QueueTextInputBackspace :: () #export {
    if g_ui_text_input_backspace_count < 64 {
        g_ui_text_input_backspace_count += 1
    }
}

QueueTextInputEnter :: () #export {
    if g_ui_text_input_enter_count < 64 {
        g_ui_text_input_enter_count += 1
    }
}

EditText :: (edit: TextEdit) -> i32 #export {
    changed: i32 = 0
    if edit.commit_pressed != nil { *edit.commit_pressed = 0 }
    if edit.text == nil || edit.text_size == 0 ||
    edit.cursor_position == nil { return 0 }
    length: i32 = (int)strlen(edit.text)
    *edit.cursor_position = ui_grapheme_floor_offset(
    edit.text, *edit.cursor_position)
    if !IsKeyboardInputEnabled() { return 0 }

    navigation: TextNavigationInput = (TextNavigationInput){0}
    navigation.text = edit.text
    navigation.key = ui_text_navigation_key(0)
    navigation.modifier = ui_mod_key_down()
    anchor: i32 = *edit.cursor_position
    ui_text_navigate(navigation, &anchor, edit.cursor_position)

    shortcuts: TextShortcutInput = TextShortcutInputFor(
    ui_mod_key_down(), 0, IsKeyPressed(KEY_C),
    IsKeyPressed(KEY_X), IsKeyPressed(KEY_V))
    if shortcuts.copy {
        decision: TextContextCommandDecision =
        TextEditCommandDecisionFor(TextContextCommandCopy(),
        0, 1, 0, 1, 1, 1, 1)
        if decision.copy_all { SetClipboardTextValue(edit.text) }
    }
    if shortcuts.cut {
        decision: TextContextCommandDecision =
        TextEditCommandDecisionFor(TextContextCommandCut(),
        0, 1, 1, 1, 1, 1, 1)
        if decision.copy_all { SetClipboardTextValue(edit.text) }
        if decision.clear_all {
            edit.text[0] = '\0'
            *edit.cursor_position = 0
            changed = 1
        }
    }
    if shortcuts.paste {
        decision: TextContextCommandDecision =
        TextEditCommandDecisionFor(TextContextCommandPaste(),
        0, 0, 0, 1, 1, 1, 1)
        if decision.paste {
            changed |= ui_text_paste_clipboard(edit, 0)
        }
    }

    repeat: i32 = g_ui_text_input_backspace_count +
    ui_backspace_repeat_count()
    if TextDeleteShortcutShouldRun(0, 0, 0, repeat) {
        anchor = *edit.cursor_position
        index: i32 = 0
        while index < repeat {
            changed |= ui_text_delete_key(edit.text, edit.text_size,
            &anchor, edit.cursor_position, TextDeleteBackspace(),
            ui_mod_key_down(), 0)
            index += 1
        }
    }
    g_ui_text_input_backspace_count = 0
    if TextDeleteShortcutShouldRun(0, 0,
    IsKeyPressed(KEY_DELETE), 0) {
        anchor = *edit.cursor_position
        changed |= ui_text_delete_key(edit.text, edit.text_size,
        &anchor, edit.cursor_position, TextDeleteForward(),
        ui_mod_key_down(), 0)
    }
    if TextEditCommitShouldRun(IsKeyPressed(KEY_ENTER) ||
    IsKeyPressed(KEY_KP_ENTER), g_ui_text_input_enter_count) {
        if edit.commit_pressed != nil { *edit.commit_pressed = 1 }
        g_ui_text_input_enter_count = 0
    }

    codepoint: i32 = GetCharPressed()
    while codepoint > 0 {
        if (edit.filter == nil ||
        edit.filter(codepoint, edit.filter_user_data)) &&
        ui_text_insert_codepoint(edit.text, edit.text_size,
        edit.cursor_position, codepoint, edit.max_codepoints) {
            changed = 1
        }
        codepoint = GetCharPressed()
    }
    index: i32 = 0
    while index < g_ui_text_input_codepoint_count {
        codepoint = g_ui_text_input_codepoints[index]
        if (edit.filter == nil ||
        edit.filter(codepoint, edit.filter_user_data)) &&
        ui_text_insert_codepoint(edit.text, edit.text_size,
        edit.cursor_position, codepoint, edit.max_codepoints) {
            changed = 1
        }
        index += 1
    }
    g_ui_text_input_codepoint_count = 0
    length = (int)strlen(edit.text)
    *edit.cursor_position = TextCursorForLength(
    *edit.cursor_position, length)
    return changed
}
