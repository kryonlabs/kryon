Image :: #import "image_props";
#import "control_props"
#import "geometry"
#import "modal_behavior"

// Caller supplied bounds support movable/resizable panels without making a
// platform host decide the layout. Zero bounds center the requested size.
Props :: struct {
    key: u64
    id: s32
    class_name: s32
    title: string
    bounds: Rectangle
    width: s32
    height: s32
    scale: float32
    left_image: Image.Props
    right_image: Image.Props
    left_label: string
    right_label: string
    has_left_action: bool
    has_right_action: bool
    // Kept as an explicit override for callers that must prevent every
    // dismissal route, including after opting into outside dismissal.
    dismiss_disabled: bool
    // The title drawn with emphasis, as Text's strong ranges, and at the
    // content's start instead of centred.
    strong_title: bool
    title_at_start: bool
    // Modal backdrops consume outside presses without closing by default.
    // Set this to opt into closing on a release outside the panel.
    dismiss_on_outside: bool
    right_action_disabled: bool
}

ModalFrameResult :: struct {
    node: s32
    panel_node: s32
    layout: ModalFrameLayout
    dismissed: bool
    left_clicked: bool
    right_clicked: bool
    // The panel's content scope is open: submit the content, then End it.
    opened: bool
}

// A message and action dialog. Actions are borrowed values supplied to
// ActionModal; the caller keeps any selection and dismissal state.
ActionModalProps :: struct {
    key: u64
    id: s32
    class_name: s32
    title: string
    message: string
    max_width: s32
    scale: float32
    show_close: bool
    close_label: string
}

ActionModalAction :: struct {
    key: u64
    label: string
    tone: ButtonTone
    emphasis: ButtonEmphasis
    disabled: bool
}

ActionModalResult :: struct {
    node: s32
    // Zero means no decision; -1 means dismissed; positive values are the
    // one-based action index.
    action: s32
}
