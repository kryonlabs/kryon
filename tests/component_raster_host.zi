#import "drawing_props"
#import "geometry"
Pixels :: #import "pixmap";

component_raster_calls: s32;
component_raster_failed: bool;
component_pixels: [57600]u32;

ComponentRasterBegin :: () -> bool {
    return Pixels.PixmapBeginInto(cast(u32)0xffffffff, 320, 180, component_pixels[:])
}

ComponentRasterHash :: (right: bool = false) -> u64 {
    hash: u64 = cast(u64)14695981039346656037
    for y: 0..179 {
        for x: 0..319 {
            if right && (x < 140 || y > 48) { continue }
            hash = (hash ^ cast(u64)component_pixels[y * 320 + x]) * cast(u64)1099511628211
        }
    }
    return hash
}

ComponentRasterClose :: () { Pixels.PixmapEndInto(); Pixels.PixmapCloseWorkers() }


#program_export
ComponentRasterReset :: () { component_raster_calls = 0; component_raster_failed = false }

#program_export
ComponentRasterCalls :: () -> s32 { return component_raster_calls }

#program_export
ComponentRasterFailed :: () -> bool { return component_raster_failed }

#program_export
ComponentMeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    if font <= 0 { component_raster_failed = true }
    return (cast(s32)value.count) * font / 2
}

#program_export
ComponentMeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    if font <= 0 { component_raster_failed = true }
    return font
}

#program_export
ComponentImageWidth :: (asset_path: string) -> s32 { unused asset_path; return 0 }

#program_export
ComponentImageHeight :: (asset_path: string) -> s32 { unused asset_path; return 0 }

#program_export
ComponentRasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32, color: Color) {
    Pixels.RasterRoundedRectangle(bounds, radius, segments, color)
    component_raster_calls += 1
}

#program_export
ComponentRasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32, segments: s32, width: float32, color: Color) {
    Pixels.RasterRoundedRectangleOutline(bounds, radius, segments, width, color)
    component_raster_calls += 1
}

#program_export
ComponentRasterLine :: (line: Rectangle, color: Color) {
    Pixels.RasterLine(line, color)
    component_raster_calls += 1
}

#program_export
ComponentRasterTriangles :: (points: []Vector2, color: Color) {
    Pixels.RasterTriangles(points, color)
    component_raster_calls += 1
}

#program_export
ComponentRasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    if value.count == 0 || font <= 0 { component_raster_failed = true }
    Pixels.RasterText(value, x, y, font, color)
    component_raster_calls += 1
}

#program_export
ComponentRasterTextClipped :: (value: string, x: s32, y: s32, font: s32, color: Color, clip: Rectangle) {
    unused clip
    ComponentRasterText(value, x, y, font, color)
}

#program_export
ComponentRasterTextRotated :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle, origin: Vector2, rotation: float32,
    outer_clip: Rectangle, outer_clipped: bool, emphasis: bool, italic: bool) {
    unused clip; unused origin; unused rotation; unused outer_clip
    unused outer_clipped; unused emphasis; unused italic
    ComponentRasterText(value, x, y, font, color)
}

#program_export
ComponentRasterImage :: (asset_path: string, texture_id: u32, source: Rectangle, destination: Rectangle, clip: Rectangle, origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    unused asset_path; unused texture_id; unused source; unused destination
    unused clip; unused origin; unused rotation; unused radius; unused tint
    component_raster_calls += 1
}

#program_export
ComponentRasterImageMesh :: (asset_path: string, texture_id: u32, source: Rectangle,
    points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) {
    unused asset_path; unused texture_id; unused source; unused points
    unused columns; unused rows; unused clip; unused tint
    component_raster_calls += 1
}

clipboard_text: [64]u8;
clipboard_length: s32 = -1;
component_clipboard_writes: s32;
ComponentClipboardWrites :: () -> s32 { return component_clipboard_writes }

#program_export
ComponentSystemClipboardOpenHost :: () -> s32 { return clipboard_length }

#program_export
ComponentSystemClipboardByteHost :: (index: s32) -> s32 {
    if index < 0 || index >= clipboard_length { return -1 }
    return cast(s32)clipboard_text[index]
}

#program_export
ComponentSystemClipboardWriteHost :: (text: string) -> bool {
    component_clipboard_writes += 1
    if text.count > 63 { return false }
    index: s32 = 0
    while index < cast(s32)text.count {
        clipboard_text[index] = text[index]
        index += 1
    }
    clipboard_length = cast(s32)text.count
    return true
}
