#import "ziran_host.h"
#import "image_canvas_types.h"
c :: #system_library "c";
CString :: const char* #type

# Host adapters implement effects requested by Kryon UI modules. The C
# callback typedefs are ABI declarations; their behavior stays in the host.
#program_export
KssStringSliceBinding :: () -> HostBinding #foreign c;
#program_export
TextSliceBinding :: () -> HostBinding #foreign c;

CompositionQueue :: struct CompositionQueue #type
CompositionInputEvent :: struct CompositionInputEvent { int32_t available; int32_t phase; const char *text; size_t length; int32_t cursor; int32_t selection_length; } #type
#program_export
CompositionQueueCreate :: () -> *CompositionQueue #foreign c;
#program_export
CompositionQueueDestroy :: (queue: *CompositionQueue) #foreign c;
#program_export
CompositionQueueBeginFrame :: (queue: *CompositionQueue) #foreign c;
#program_export
CompositionQueueSubmit :: (queue: *CompositionQueue, phase: s32, text: CString, cursor: s32, selection_length: s32) -> s32 #foreign c;
#program_export
CompositionQueueTake :: (queue: *CompositionQueue, event: *CompositionInputEvent) -> s32 #foreign c;
#program_export
PollCompositionBinding :: (queue: *CompositionQueue) -> HostBinding #foreign c;

PointerHost :: struct PointerHost { float x; float y; int32_t down; int32_t pressed; int32_t released; VmHostField fields[5]; } #type
#program_export
PointerBinding :: (pointer: *PointerHost) -> HostBinding #foreign c;

LineDrawFn :: void (*)(void *context, float x1, float y1, float x2, float y2, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
LineRenderer :: struct LineRenderer { LineDrawFn draw; void *context; } #type
#program_export
RasterLineBinding :: (renderer: *LineRenderer) -> HostBinding #foreign c;

RoundedRectangleFillFn :: void (*)(void *context, float x, float y, float width, float height, float radius, int32_t segments, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
RoundedRectangleOutlineFn :: void (*)(void *context, float x, float y, float width, float height, float radius, int32_t segments, float line_width, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
RoundedRectangleRenderer :: struct RoundedRectangleRenderer { RoundedRectangleFillFn fill; RoundedRectangleOutlineFn outline; void *context; } #type
#program_export
RasterRoundedRectangleBinding :: (renderer: *RoundedRectangleRenderer) -> HostBinding #foreign c;
#program_export
RasterRoundedRectangleOutlineBinding :: (renderer: *RoundedRectangleRenderer) -> HostBinding #foreign c;

TextDrawFn :: void (*)(void *context, const char *text, size_t length, int32_t x, int32_t y, int32_t font, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
TextDrawClippedFn :: void (*)(void *context, const char *text, size_t length, int32_t x, int32_t y, int32_t font, const float clip[4], uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
TextRenderer :: struct TextRenderer { TextDrawFn draw; void *context; TextDrawClippedFn draw_clipped; } #type
#program_export
RasterTextBinding :: (renderer: *TextRenderer) -> HostBinding #foreign c;
#program_export
RasterTextClippedBinding :: (renderer: *TextRenderer) -> HostBinding #foreign c;

GlyphWidthFn :: int32_t (*)(void *context, const char *text, size_t text_length, int32_t font, const char *typeface, size_t typeface_length) #type
GlyphLineHeightFn :: int32_t (*)(void *context, int32_t font, const char *typeface, size_t typeface_length) #type
FontMeasurer :: struct FontMeasurer { GlyphWidthFn width; GlyphLineHeightFn line_height; void *context; } #type
#program_export
MeasureGlyphWidthBinding :: (measurer: *FontMeasurer) -> HostBinding #foreign c;
#program_export
MeasureGlyphLineHeightBinding :: (measurer: *FontMeasurer) -> HostBinding #foreign c;

ImageSizeFn :: int32_t (*)(void *context, const char *path, size_t path_length, int32_t *width, int32_t *height) #type
ImageDrawFn :: void (*)(void *context, const char *path, size_t path_length, uint32_t texture_id, const float source[4], const float destination[4], const float clip[4], const float origin[2], float rotation, float radius, const uint8_t tint[4]) #type
ImageRasterizer :: struct ImageRasterizer { ImageSizeFn size; ImageDrawFn draw; void *context; } #type
#program_export
ImageWidthBinding :: (renderer: *ImageRasterizer) -> HostBinding #foreign c;
#program_export
ImageHeightBinding :: (renderer: *ImageRasterizer) -> HostBinding #foreign c;
#program_export
RasterImageBinding :: (renderer: *ImageRasterizer) -> HostBinding #foreign c;
#program_export
ImageCanvasRasterizer :: (canvas: *ImageCanvas) -> ImageRasterizer #foreign c;
