// Native state, host scheduling and pixel callbacks for hosted_surface.tsx.
Surface :: #import "kryon/host/surface";
TextField :: #import "kryon/text_field";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"
#import "std/number_text"

clicks: s32;
value: TextField.State;
value_bytes: [128]u8;
last_width: s32;
last_height: s32;

#if #defined(SURFACE_SMOKE_WAKE) {
    wake_calls: s32;
    wake_draws: s32;
    wake_clock_valid: bool = true;

    WakeClock :: () -> s64 { return 5000 + cast(s64)wake_calls * 2000 }

    Wake :: (now: s64) -> Surface.SurfaceSchedule {
        wake_clock_valid = wake_clock_valid && now == 5000 + cast(s64)wake_calls * 2000
        wake_calls += 1
        return .{wait_ms = 2000, redraw = wake_calls == 2 || wake_calls == 14}
    }
}

#if #defined(SURFACE_SMOKE_ROWS) || #defined(SURFACE_SMOKE_PIXELS) {
    row_host :: #system_library "host_api";
    PresentRows :: (width: s32, height: s32, first: s32, rgba: string) -> bool #reads #foreign row_host;

    SendRows :: (width: s32, height: s32, first: s32, rgba: string) -> bool {
        return PresentRows(width, height, first, rgba)
    }
}

#if #defined(SURFACE_SMOKE_PIXELS) {
    #import "std/vec"
    packed_bytes: Vec(u8);

    SendPixels :: (width: s32, height: s32, first: s32, words: []u32) -> bool {
        count := words.count * 4
        if !VecResizeBounded(packed_bytes, count, cast(s64)16384 * 32 * 4) { return false }
        for at: cast(s64)0..words.count - 1 {
            pixel := words[at]
            packed_bytes[at * 4] = cast(u8)(pixel >> 16)
            packed_bytes[at * 4 + 1] = cast(u8)(pixel >> 8)
            packed_bytes[at * 4 + 2] = cast(u8)pixel
            packed_bytes[at * 4 + 3] = 255
        }
        return PresentRows(width, height, first, TextView(packed_bytes[:]))
    }
}

#if #defined(SURFACE_SMOKE_CLOCK) {
    #import "kryon/frame_snapshot"
    clock_tick: s64;
    clock_ok: bool = true;

    SmokeClock :: () -> s64 {
        clock_tick += 1
        if clock_tick == 3 { return 1001 }
        return 1000 + (clock_tick - 1) * 17
    }
}

ObserveFrame :: (session: Session, viewport: Rectangle) {
    #if #defined(SURFACE_SMOKE_WAKE) {
        wake_draws += 1
    }
    #if #defined(SURFACE_SMOKE_CLOCK) {
        timing := CaptureFrameInput(session)
        elapsed := ifx clock_tick == 3 then 17 else (clock_tick - 1) * 17
        delta := ifx clock_tick == 1 || clock_tick == 3 then 0 else ifx clock_tick == 4 then 34 else 17
        clock_ok = clock_ok && timing.elapsed_ms == elapsed && timing.delta_ms == delta
    }
    if cast(s32)viewport.width != last_width || cast(s32)viewport.height != last_height {
        last_width = cast(s32)viewport.width
        last_height = cast(s32)viewport.height
        print("surface % x %\n", last_width, last_height)
    }
}

CountClick :: () {
    clicks += 1
    print("click %\n", clicks)
}

CountText :: () -> string {
    return FormatInteger(cast(s64)clicks, count_bytes[:])
}
count_bytes: [24]u8;

FieldChanged :: (changed: bool) {
    if changed { print("text %\n", TextView(value.bytes[:value.length])) }
}

Run :: (draw: Surface.Draw) -> s32 {
    defer {
        #if #defined(SURFACE_SMOKE_PIXELS) {
            VecFree(packed_bytes)
        }
    }
    value.bytes = value_bytes[:]
    window: Surface.Window = .{.title = "Kryon hosted surface", .width = 240, .height = 144}
    #if #defined(SURFACE_SMOKE_WAKE) {
        result: s32
        #if #defined(SURFACE_SMOKE_PIXELS) {
            result = Surface.RunRetainedPixels(window, draw, SendPixels,
                clock = WakeClock, wake = Wake)
        } else #if #defined(SURFACE_SMOKE_ROWS) {
            result = Surface.RunRetainedRows(window, draw, SendRows, clock = WakeClock, wake = Wake)
        } else {
            result = Surface.Run(window, draw, clock = WakeClock, wake = Wake)
        }
        return ifx wake_clock_valid && wake_calls == 60 && wake_draws == 37 then result else 2
    } else #if #defined(SURFACE_SMOKE_PIXELS) {
        return Surface.RunRetainedPixels(window, draw, SendPixels, 250)
    } else #if #defined(SURFACE_SMOKE_ROWS) {
        return Surface.RunRetainedRows(window, draw, SendRows, 250)
    } else #if #defined(SURFACE_SMOKE_CLOCK) {
        result := Surface.RunRetained(window, draw, 250, clock = SmokeClock)
        return ifx clock_ok && clock_tick == 60 then result else 2
    } else {
        #if #defined(SURFACE_SMOKE_TIMED) {
            return Surface.RunRetained(window, draw, 250)
        } else {
            return Surface.Run(window, draw)
        }
    }
}
