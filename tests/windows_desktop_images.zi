// The same shared decoder serves Cairo, icons and CPU image consumers.
#import "kryon/image_pixels"
#import "std/image"
#import "std/vec"

#program_export
main :: () -> s32 {
    names: [2]string = .["build/windows-desktop/fixtures/rgba.png",
        "build/windows-desktop/fixtures/rgba.webp"]
    expected: [8]u8 = .[173, 61, 219, 97, 19, 203, 41, 255]
    for name: names {
        image := LoadImagePixels(name)
        defer VecFree(image.pixels)
        if !ImageValid(*image) || image.width != 2 || image.height != 1 { return 1 }
        for at: 0..7 { if image.pixels[at] != expected[at] { return 2 } }
    }
    photo := LoadImagePixels("build/windows-desktop/fixtures/photo.jpg")
    defer VecFree(photo.pixels)
    if !ImageValid(*photo) || photo.width != 3 || photo.height != 2 { return 3 }
    if photo.pixels[0] < 18 || photo.pixels[0] > 22 ||
        photo.pixels[1] < 78 || photo.pixels[1] > 82 ||
        photo.pixels[2] < 138 || photo.pixels[2] > 142 || photo.pixels[3] != 255 { return 4 }
    invalid := LoadImagePixels("build/windows-desktop/fixtures/invalid.png")
    defer VecFree(invalid.pixels)
    if ImageValid(*invalid) { return 5 }
    return 0
}
