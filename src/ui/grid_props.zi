#import "geometry"

GridProps :: struct {
    bounds: Rectangle
    columns: s32
    min_item_width: s32
    max_columns: s32
    gap: s32
    padding: s32
    key: u64
    id: s32
    class_name: s32
    row_gap: s32
    padding_y: s32
    gap_override: bool
    row_gap_override: bool
    padding_override: bool
    padding_y_override: bool
}

GridMeasureHeight :: #type (width: float32, key: u64) -> s32;

GridItem :: struct {
    // Zero uses the optional measurement at the allocated track width.
    height: s32
    // Zero or one uses one column. Negative spans the full grid.
    column_span: s32
    measure_height: GridMeasureHeight
    measure_key: u64
}

GridMetrics :: struct {
    bounds: Rectangle
    content: Rectangle
    columns: s32
    gap: s32
    padding: s32
    cell_width: s32
    row_gap: s32
    padding_y: s32
}

GridCursor :: struct {
    metrics: GridMetrics
    item: Rectangle
    x: s32
    y: s32
    col: s32
    row_height: s32
    used_height: s32
}
