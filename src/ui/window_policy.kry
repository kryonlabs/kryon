#module "window_policy"
#import "ui_window.h"
#import <limits.h>

WindowPoint :: struct {
    x: i32
    y: i32
}

WindowCoordinateClamp :: (value: i64) -> i32 #private {
    if value < (i64)INT_MIN {
        return INT_MIN
    }
    if value > (i64)INT_MAX {
        return INT_MAX
    }
    return (i32)value
}

WindowInitialPosition :: (x: i32, y: i32, width: i32, height: i32,
                          flags: i32, work_x: i32, work_y: i32,
                          work_width: i32, work_height: i32) -> WindowPoint #export {
    position: WindowPoint = (WindowPoint){x, y}
    if (flags & NATIVE_WINDOW_TOP_RIGHT) != 0 {
        position.x = WindowCoordinateClamp((i64)work_x + (i64)work_width -
                                           (i64)width - (i64)x)
        position.y = WindowCoordinateClamp((i64)work_y + (i64)y)
    } else if (flags & NATIVE_WINDOW_CENTER) != 0 {
        position.x = WindowCoordinateClamp((i64)work_x +
                                           ((i64)work_width - (i64)width) / 2)
        position.y = WindowCoordinateClamp((i64)work_y +
                                           ((i64)work_height - (i64)height) / 2)
    }
    return position
}

WindowDragMoved :: (delta_x: i32, delta_y: i32) -> i32 #export {
    if delta_x < -3 || delta_x > 3 || delta_y < -3 || delta_y > 3 {
        return 1
    }
    if delta_x * delta_x + delta_y * delta_y > 9 {
        return 1
    }
    return 0
}

WindowDragPosition :: (x: i32, y: i32, delta_x: i32,
                       delta_y: i32, work_x: i32, work_y: i32,
                       work_width: i32, work_height: i32) -> WindowPoint #export {
    left: i64 = (i64)work_x
    top: i64 = (i64)work_y
    right: i64 = left + (i64)work_width - 24
    bottom: i64 = top + (i64)work_height - 24
    if right < left {
        right = left
    }
    if bottom < top {
        bottom = top
    }

    next_x: i64 = (i64)x + (i64)delta_x
    next_y: i64 = (i64)y + (i64)delta_y
    if next_x < left {
        next_x = left
    }
    if next_x > right {
        next_x = right
    }
    if next_y < top {
        next_y = top
    }
    if next_y > bottom {
        next_y = bottom
    }
    return (WindowPoint){WindowCoordinateClamp(next_x),
                         WindowCoordinateClamp(next_y)}
}
