#import "kryon.h"

app "Kryon Theme Example" {
    size 800 600
    fps 60
    font examples
    theme THEME_SKY light
}

state {
    theme_index: int = 0
    dark_mode: int = 0
}

ThemeAt :: (index: int) -> ThemeId {
    if index == 0 {
        return THEME_SKY
    }
    if index == 1 {
        return THEME_OCEAN
    }
    if index == 2 {
        return THEME_FOREST
    }
    if index == 3 {
        return THEME_SUNSET
    }
    if index == 4 {
        return THEME_LAVENDER
    }
    if index == 5 {
        return THEME_CHERRY
    }
    if index == 6 {
        return THEME_DAWN
    }
    if index == 7 {
        return THEME_SAGE
    }
    if index == 8 {
        return THEME_INK
    }
    if index == 9 {
        return THEME_MONO
    }
    if index == 10 {
        return THEME_MINT
    }
    return THEME_COBALT
}

ThemeSwatch :: (label: const char *, y: int, value: Color, label_color: Color) {
    x: int = ScaleUIPx(20)
    size: int = ScaleUIPx(56)
    WidgetRect(x, y, size, size, value, BLANK)
    WidgetRect(x, y, size, size, BLANK, label_color)
    WidgetText(label, x+size+ScaleUIPx(10), y+ScaleUIPx(10), UI_TEXT_16, label_color)
}

ThemeButton :: (label: const char *, x: int, y: int, w: int) -> int {
    h: int = ScaleUIPx(38)
    return DrawUIGenericButton(x,y,w,h,label,UI_BUTTON_STYLE_SECONDARY,0,NULL)
}

ThemeLabel :: (label: const char *, value: const char *, y: int, size: int, text_color: Color) {
    WidgetText(TextFormat("%s%s",label,value), ScaleUIPx(20), y, size, text_color)
}

ThemeSideLabel :: (label: const char *, value: const char *, y: int, text_color: Color) {
    WidgetText(TextFormat("%s%s",label,value), ScaleUIPx(320), y, UI_TEXT_16, text_color)
}

ThemeSideInt :: (label: const char *, y: int, value: int, text_color: Color) {
    WidgetText(TextFormat("%s%d",label,value), ScaleUIPx(320), y, UI_TEXT_16, text_color)
}

ThemeRGB :: (label: const char *, y: int, value: Color, text_color: Color) {
    rgb_text: const char * = TextFormat("%s RGB:%d,%d,%d",label,value.r,value.g,value.b)
    WidgetText(rgb_text, ScaleUIPx(320), y, 14, text_color)
}

screen ThemeExample(viewport: Rectangle) {
    current_theme: ThemeId = ThemeAt(theme_index)
    left_x: int = ScaleUIPx(300)
    right_x: int = ScaleUIPx(420)
    button_w: int = ScaleUIPx(112)
    mode_w: int = ScaleUIPx(232)
    SetCurrentTheme(current_theme, dark_mode)
    background: Color
    text_color: Color
    button: Color
    button_hover: Color
    circle: Color
    GetThemeCatalogColor(current_theme,dark_mode,"background",&background)
    GetThemeCatalogColor(current_theme,dark_mode,"text",&text_color)
    GetThemeCatalogColor(current_theme,dark_mode,"button",&button)
    GetThemeCatalogColor(current_theme,dark_mode,"button_hover",&button_hover)
    GetThemeCatalogColor(current_theme,dark_mode,"circle",&circle)
    WidgetBackground(background)
    ThemeLabel("Theme:    ",GetThemeLabel(current_theme),ScaleUIPx(20),UI_TEXT_24,text_color)
    ThemeLabel("Mode:",dark_mode?"Dark":"Light",ScaleUIPx(50),UI_TEXT_16,text_color)
    if ThemeButton("Prev Theme", left_x, ScaleUIPx(18), button_w) {
        theme_index = (theme_index + 11) % 12
    }
    if ThemeButton("Next Theme", right_x, ScaleUIPx(18), button_w) {
        theme_index = (theme_index + 1) % 12
    }
    if dark_mode {
        if ThemeButton("Light Mode", left_x, ScaleUIPx(64), mode_w) {
            dark_mode = 0
        }
    } else {
        if ThemeButton("Dark Mode", left_x, ScaleUIPx(64), mode_w) {
            dark_mode = 1
        }
    }
    ThemeSwatch("Background", ScaleUIPx(90), background, text_color)
    ThemeSwatch("Text", ScaleUIPx(160), text_color, text_color)
    ThemeSwatch("Button", ScaleUIPx(230), button, text_color)
    ThemeSwatch("Button Hover", ScaleUIPx(300), button_hover, text_color)
    ThemeSwatch("Circle", ScaleUIPx(370), circle, text_color)
    scope: const char * = GetThemeScopeName(current_theme,dark_mode)
    ThemeSideLabel("Scope:", scope, ScaleUIPx(120), text_color)
    ThemeSideInt("Theme ID:", ScaleUIPx(152), current_theme, text_color)
    ThemeRGB("Background", ScaleUIPx(200), background, text_color)
    ThemeRGB("Text", ScaleUIPx(224), text_color, text_color)
}
