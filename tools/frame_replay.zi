#import "bundle_host"
#import "byte_text_linux"
#import "c_string"
#import "file_linux"
Utf8 :: #import "utf8";

using HostValueKind;

libc :: #system_library "libc";
FormatRealRaw :: (output: *u8, capacity: u64, format: *u8,
                  value: float64) -> s32 #foreign libc "strfromd";

Name :: struct { bytes: [128]u8 }

PointerSample :: struct {
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
}

ReplaySample :: struct {
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
    secondary_down: bool
    secondary_pressed: bool
    secondary_released: bool
    key: s32
    modifiers: s32
    wheel: float32
    width: float32
    height: float32
    elapsed_ms: s64
    text_bytes: [256]u8
    text_count: s32
    ime_phase: s32
    ime_cursor: s32
    ime_selection: s32
    ime_text_bytes: [256]u8
    ime_text_count: s32
    clipboard_bytes: [256]u8
    clipboard_count: s32
    extended: bool
}

ReplayState :: struct {
    output: FileHandle
    offset: s64
    input: ReplaySample
    pointer_calls: s32
    capture_calls: s32
    phase: s32
    nodes: s32
    paints: s32
    expected_nodes: s32
    expected_paints: s32
    effects: s32
    failed: bool
    pointer_fields: [5]HostField
    labels: [12]Name
    bindings: [20]HostBinding
    binding_names: [40]Name
    samples: [1024]ReplaySample
    current_sample: s32
    input_names: [20]Name
    input_fields: [20]HostField
    trace_bytes: [1048576]u8
    extended: bool
    application_failed: bool
    clipboard_written: bool
    clipboard_bytes: [256]u8
    clipboard_count: s32
    sample_count: s32
}

WriteBytes :: (state: *ReplayState, data: []u8) -> bool {
    if state.failed { return false }
    count: s64 = WriteAt(state.output, data, state.offset)
    if count != cast(s64)data.count {
        state.failed = true
        return false
    }
    state.offset += count
    return true
}

WriteLiteral :: (state: *ReplayState, value: string) -> bool {
    if state.failed { return false }
    count: s64 = WriteTextAt(state.output, value, state.offset)
    if count != cast(s64)value.count {
        state.failed = true
        return false
    }
    state.offset += count
    return true
}

WriteByte :: (state: *ReplayState, value: u8) -> bool {
    bytes: [1]u8
    bytes[0] = value
    return WriteBytes(state, bytes[:])
}

WriteUnsigned :: (state: *ReplayState, value: u64) -> bool {
    digits: [20]u8
    count: s32 = 0
    number: u64 = value
    while number > 0 {
        digits[count] = cast(u8)48 + cast(u8)(number % cast(u64)10)
        number /= cast(u64)10
        count += 1
    }
    if count == 0 { digits[0] = cast(u8)48; count = 1 }
    while count > 0 {
        count -= 1
        if !WriteByte(state, digits[count]) { return false }
    }
    return true
}

WriteSigned :: (state: *ReplayState, value: s64) -> bool {
    if value >= 0 { return WriteUnsigned(state, cast(u64)value) }
    if !WriteByte(state, cast(u8)45) { return false }
    return WriteUnsigned(state, cast(u64)(-(value + 1)) + cast(u64)1)
}

WriteReal :: (state: *ReplayState, value: float64,
              single_precision: bool) -> bool {
    if value != value || value - value != 0.0 { return false }
    format: [8]u8
    if single_precision {
        if !CopyCString("%.9g", format[:]) { return false }
    } else {
        if !CopyCString("%.17g", format[:]) { return false }
    }
    bytes: [64]u8
    count: s32 = FormatRealRaw(*bytes[0], cast(u64)64, *format[0], value)
    if count < 0 || count >= 64 { return false }
    return WriteBytes(state, bytes[0:count])
}

HexDigit :: (value: u8) -> u8 {
    if value < cast(u8)10 { return cast(u8)48 + value }
    return cast(u8)97 + value - cast(u8)10
}

WriteHex :: (state: *ReplayState, value: u64) -> bool {
    digits: [16]u8
    count: s32 = 0
    number: u64 = value
    while number > 0 {
        digits[count] = HexDigit(cast(u8)(number % cast(u64)16))
        number /= cast(u64)16
        count += 1
    }
    if count == 0 { digits[0] = cast(u8)48; count = 1 }
    while count > 0 {
        count -= 1
        if !WriteByte(state, digits[count]) { return false }
    }
    return true
}

JsonString :: (state: *ReplayState, data: *u8, length: u64) -> bool {
    if !WriteByte(state, cast(u8)34) { return false }
    index: u64 = 0
    while index < length {
        byte: u8 = data[index]
        if byte == cast(u8)34 || byte == cast(u8)92 {
            if !WriteByte(state, cast(u8)92) || !WriteByte(state, byte) {
                return false
            }
        } else if byte < cast(u8)32 {
            if !WriteLiteral(state, "\\u00") ||
               !WriteByte(state, HexDigit(byte / cast(u8)16)) ||
               !WriteByte(state, HexDigit(byte % cast(u8)16)) { return false }
        } else {
            if !WriteByte(state, byte) { return false }
        }
        index += 1
    }
    return WriteByte(state, cast(u8)34)
}

JsonValue :: (state: *ReplayState, value: *HostValue, depth: s32) -> bool {
    if depth > 32 { return false }
    if value.kind == HostVoid { return WriteLiteral(state, "null") }
    if value.kind == HostInteger {
        if TextFromCString(value.type_name) == "bool" {
            if value.integer != 0 { return WriteLiteral(state, "true") }
            return WriteLiteral(state, "false")
        }
        return WriteSigned(state, value.integer)
    }
    if value.kind == HostUnsigned { return WriteUnsigned(state, value.bits) }
    if value.kind == HostReal { return WriteReal(state, value.real, false) }
    if value.kind == HostString {
        if value.length > 0 && value.data == null { return false }
        return JsonString(state, value.data, cast(u64)value.length)
    }
    if value.kind == HostRecord {
        if value.field_count > 0 && value.fields == null { return false }
        if !WriteByte(state, cast(u8)123) { return false }
        index: usize = 0
        while index < value.field_count {
            if index > 0 && !WriteByte(state, cast(u8)44) { return false }
            field: *HostField = *value.fields[index]
            name: string = TextFromCString(field.name)
            if !JsonString(state, field.name, cast(u64)name.count) ||
               !WriteByte(state, cast(u8)58) ||
               !JsonValue(state, *field.value, depth + 1) { return false }
            index += 1
        }
        return WriteByte(state, cast(u8)125)
    }
    if value.kind == HostSlice || value.kind == HostArray {
        if value.length > 0 && value.elements == null { return false }
        if !WriteByte(state, cast(u8)91) { return false }
        index: usize = 0
        while index < value.length {
            if index > 0 && !WriteByte(state, cast(u8)44) { return false }
            if !JsonValue(state, *value.elements[index], depth + 1) {
                return false
            }
            index += 1
        }
        return WriteByte(state, cast(u8)93)
    }
    if value.kind == HostPointer {
        if !WriteLiteral(state, "\"@") ||
           !WriteHex(state, cast(u64)value.pointer) { return false }
        return WriteByte(state, cast(u8)34)
    }
    return false
}

SetBinding :: (state: *ReplayState, index: s32,
               module: string, function: string, callback: HostCall) -> bool {
    if !CopyCString(module, state.binding_names[index * 2].bytes[:]) ||
       !CopyCString(function, state.binding_names[index * 2 + 1].bytes[:]) {
        return false
    }
    state.bindings[index].module = *state.binding_names[index * 2].bytes[0]
    state.bindings[index].function = *state.binding_names[index * 2 + 1].bytes[0]
    state.bindings[index].call = callback
    state.bindings[index].context = cast(*void)state
    return true
}

PreparePointer :: (state: *ReplayState) -> bool {
    if !CopyCString("x", state.labels[0].bytes[:]) ||
       !CopyCString("y", state.labels[1].bytes[:]) ||
       !CopyCString("down", state.labels[2].bytes[:]) ||
       !CopyCString("pressed", state.labels[3].bytes[:]) ||
       !CopyCString("released", state.labels[4].bytes[:]) ||
       !CopyCString("float32", state.labels[5].bytes[:]) ||
       !CopyCString("bool", state.labels[6].bytes[:]) ||
       !CopyCString("PointerFrame", state.labels[7].bytes[:]) {
        return false
    }
    index: s32 = 0
    while index < 5 {
        state.pointer_fields[index].name = *state.labels[index].bytes[0]
        state.pointer_fields[index].value.kind = HostInteger
        state.pointer_fields[index].value.type_name = *state.labels[6].bytes[0]
        index += 1
    }
    state.pointer_fields[0].value.kind = HostReal
    state.pointer_fields[1].value.kind = HostReal
    state.pointer_fields[0].value.type_name = *state.labels[5].bytes[0]
    state.pointer_fields[1].value.type_name = *state.labels[5].bytes[0]
    return true
}

InputName :: (index: s32) -> string {
    if index == 0 { return "x" }
    if index == 1 { return "y" }
    if index == 2 { return "down" }
    if index == 3 { return "pressed" }
    if index == 4 { return "released" }
    if index == 5 { return "secondary_down" }
    if index == 6 { return "secondary_pressed" }
    if index == 7 { return "secondary_released" }
    if index == 8 { return "key" }
    if index == 9 { return "modifiers" }
    if index == 10 { return "wheel" }
    if index == 11 { return "width" }
    if index == 12 { return "height" }
    if index == 13 { return "elapsed_ms" }
    if index == 14 { return "text" }
    if index == 15 { return "ime_phase" }
    if index == 16 { return "ime_cursor" }
    if index == 17 { return "ime_selection" }
    if index == 18 { return "ime_text" }
    if index == 19 { return "clipboard" }
    return ""
}

PrepareInput :: (state: *ReplayState) -> bool {
    if !CopyCString("FrameInput", state.labels[8].bytes[:]) { return false }
    if !CopyCString("s32", state.labels[9].bytes[:]) { return false }
    if !CopyCString("s64", state.labels[10].bytes[:]) { return false }
    if !CopyCString("string", state.labels[11].bytes[:]) { return false }
    for index: cast(s32)0..19 {
        if !CopyCString(InputName(index), state.input_names[index].bytes[:]) { return false }
        state.input_fields[index].name = *state.input_names[index].bytes[0]
    }
    state.input_fields[0].value.kind = HostReal
    state.input_fields[0].value.type_name = *state.labels[5].bytes[0]
    state.input_fields[1].value.kind = HostReal
    state.input_fields[1].value.type_name = *state.labels[5].bytes[0]
    state.input_fields[2].value.kind = HostInteger
    state.input_fields[2].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[3].value.kind = HostInteger
    state.input_fields[3].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[4].value.kind = HostInteger
    state.input_fields[4].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[5].value.kind = HostInteger
    state.input_fields[5].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[6].value.kind = HostInteger
    state.input_fields[6].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[7].value.kind = HostInteger
    state.input_fields[7].value.type_name = *state.labels[6].bytes[0]
    state.input_fields[8].value.kind = HostInteger
    state.input_fields[8].value.type_name = *state.labels[9].bytes[0]
    state.input_fields[9].value.kind = HostInteger
    state.input_fields[9].value.type_name = *state.labels[9].bytes[0]
    state.input_fields[10].value.kind = HostReal
    state.input_fields[10].value.type_name = *state.labels[5].bytes[0]
    state.input_fields[11].value.kind = HostReal
    state.input_fields[11].value.type_name = *state.labels[5].bytes[0]
    state.input_fields[12].value.kind = HostReal
    state.input_fields[12].value.type_name = *state.labels[5].bytes[0]
    state.input_fields[13].value.kind = HostInteger
    state.input_fields[13].value.type_name = *state.labels[10].bytes[0]
    state.input_fields[14].value.kind = HostString
    state.input_fields[14].value.type_name = *state.labels[11].bytes[0]
    state.input_fields[15].value.kind = HostInteger
    state.input_fields[15].value.type_name = *state.labels[9].bytes[0]
    state.input_fields[16].value.kind = HostInteger
    state.input_fields[16].value.type_name = *state.labels[9].bytes[0]
    state.input_fields[17].value.kind = HostInteger
    state.input_fields[17].value.type_name = *state.labels[9].bytes[0]
    state.input_fields[18].value.kind = HostString
    state.input_fields[18].value.type_name = *state.labels[11].bytes[0]
    state.input_fields[19].value.kind = HostString
    state.input_fields[19].value.type_name = *state.labels[11].bytes[0]
    return true
}

InputResult :: (state: *ReplayState, result: *HostValue) {
    state.input_fields[0].value.real = cast(float64)state.input.x
    state.input_fields[1].value.real = cast(float64)state.input.y
    state.input_fields[2].value.integer = cast(s64)state.input.down
    state.input_fields[3].value.integer = cast(s64)state.input.pressed
    state.input_fields[4].value.integer = cast(s64)state.input.released
    state.input_fields[5].value.integer = cast(s64)state.input.secondary_down
    state.input_fields[6].value.integer = cast(s64)state.input.secondary_pressed
    state.input_fields[7].value.integer = cast(s64)state.input.secondary_released
    state.input_fields[8].value.integer = cast(s64)state.input.key
    state.input_fields[9].value.integer = cast(s64)state.input.modifiers
    state.input_fields[10].value.real = cast(float64)state.input.wheel
    state.input_fields[11].value.real = cast(float64)state.input.width
    state.input_fields[12].value.real = cast(float64)state.input.height
    state.input_fields[13].value.integer = cast(s64)state.input.elapsed_ms
    state.input_fields[14].value.data = *state.samples[state.current_sample].text_bytes[0]
    state.input_fields[14].value.length = cast(usize)state.input.text_count
    state.input_fields[15].value.integer = cast(s64)state.input.ime_phase
    state.input_fields[16].value.integer = cast(s64)state.input.ime_cursor
    state.input_fields[17].value.integer = cast(s64)state.input.ime_selection
    state.input_fields[18].value.data = *state.samples[state.current_sample].ime_text_bytes[0]
    state.input_fields[18].value.length = cast(usize)state.input.ime_text_count
    state.input_fields[19].value.data = *state.samples[state.current_sample].clipboard_bytes[0]
    state.input_fields[19].value.length = cast(usize)state.input.clipboard_count
    result.kind = HostRecord
    result.type_name = *state.labels[8].bytes[0]
    result.fields = *state.input_fields[0]
    result.field_count = 20
}

ReplayCall :: (context: *void, module_name: *u8, function_name: *u8,
              arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    state: *ReplayState = cast(*ReplayState)context
    module: string = TextFromCString(module_name)
    function: string = TextFromCString(function_name)
    result.kind = HostVoid
    if module == "font_metrics" {
        if function == "MeasureGlyphWidth" && count == 3 &&
           arguments[0].kind == HostString &&
           arguments[1].kind == HostInteger {
            result.kind = HostInteger
            result.integer = cast(s64)(cast(float64)arguments[0].length *
                cast(float64)arguments[1].integer * 0.6)
            return 1
        }
        if function == "MeasureGlyphLineHeight" && count == 2 &&
           arguments[0].kind == HostInteger {
            result.kind = HostInteger
            result.integer = arguments[0].integer
            return 1
        }
        return 0
    }
    if module == "image_raster" && count == 1 &&
       (function == "ImageWidth" || function == "ImageHeight") {
        result.kind = HostInteger
        result.integer = 0
        return 1
    }
    if (module == "raster" && function == "RasterLine") ||
       (module == "raster_shape" &&
        (function == "RasterRoundedRectangle" ||
         function == "RasterRoundedRectangleOutline")) ||
       (module == "raster_text" &&
        (function == "RasterText" || function == "RasterTextClipped")) ||
       (module == "paint_queue" && function == "RasterImage") {
        state.effects += 1
        return 1
    }
    if function == "PollPointer" && count == 0 &&
       state.pointer_calls == 0 && module ==
       TextFromCString(state.bindings[10].module) {
        state.pointer_calls += 1
        state.pointer_fields[0].value.real = cast(float64)state.input.x
        state.pointer_fields[1].value.real = cast(float64)state.input.y
        state.pointer_fields[2].value.integer = cast(s64)state.input.down
        state.pointer_fields[3].value.integer = cast(s64)state.input.pressed
        state.pointer_fields[4].value.integer = cast(s64)state.input.released
        result.kind = HostRecord
        result.type_name = *state.labels[7].bytes[0]
        result.fields = *state.pointer_fields[0]
        result.field_count = cast(usize)5
        return 1
    }
    if function == "PollFrameInput" && count == 0 && state.pointer_calls == 0 &&
        module == TextFromCString(state.bindings[15].module) {
        state.pointer_calls += 1
        InputResult(state, result)
        return 1
    }
    if module == "system_clipboard" {
        result.kind = HostInteger
        if function == "SystemClipboardOpenHost" && count == 0 {
            result.integer = state.input.clipboard_count
            if state.clipboard_written { result.integer = state.clipboard_count }
            return 1
        }
        if function == "SystemClipboardByteHost" && count == 1 && arguments[0].kind == HostInteger {
            index: s64 = arguments[0].integer
            result.integer = 0
            if state.clipboard_written {
                if index >= 0 && index < state.clipboard_count { result.integer = state.clipboard_bytes[index] }
            } else if index >= 0 && index < state.input.clipboard_count { result.integer = state.input.clipboard_bytes[index] }
            return 1
        }
        if function == "SystemClipboardWriteHost" && count == 1 && arguments[0].kind == HostString {
            result.type_name = *state.labels[6].bytes[0]
            result.integer = 0
            if arguments[0].length > 256 { return 1 }
            for index: 0..cast(s32)arguments[0].length - 1 { state.clipboard_bytes[index] = arguments[0].data[index] }
            state.clipboard_count = cast(s32)arguments[0].length
            state.clipboard_written = true
            result.integer = 1
            return 1
        }
        return 0
    }
    if module != "frame_capture" { return 0 }
    if function == "RecordFrameFailure" && count == 1 && arguments[0].kind == HostRecord &&
        state.phase == 0 && state.capture_calls == 0 {
        state.capture_calls += 1
        state.phase = 4
        state.application_failed = true
        if WriteLiteral(state, "\"failure\":") && JsonValue(state, *arguments[0], 0) { return 1 }
        return 0
    }
    if function == "RecordFrameStart" && count == 2 &&
       state.phase == 0 && state.capture_calls == 0 &&
       arguments[0].kind == HostInteger &&
       arguments[1].kind == HostInteger &&
       arguments[0].integer >= 0 && arguments[0].integer <= 1024 &&
       arguments[1].integer >= 0 && arguments[1].integer <= 4096 {
        state.expected_nodes = cast(s32)arguments[0].integer
        state.expected_paints = cast(s32)arguments[1].integer
        state.capture_calls += 1
        state.phase = 1
        if WriteLiteral(state, "\"capture\":{\"nodes\":[") { return 1 }
        return 0
    }
    if function == "RecordNode" && count == 2 && state.phase == 1 &&
       state.nodes < state.expected_nodes &&
       arguments[0].kind == HostInteger &&
       arguments[0].integer == cast(s64)state.nodes &&
       arguments[1].kind == HostRecord {
        if state.nodes > 0 && !WriteByte(state, cast(u8)44) { return 0 }
        if !JsonValue(state, *arguments[1], 0) { return 0 }
        state.nodes += 1
        return 1
    }
    if function == "RecordPaint" && count == 2 &&
       state.phase != 0 && state.nodes == state.expected_nodes &&
       state.paints < state.expected_paints &&
       arguments[0].kind == HostInteger &&
       arguments[0].integer == cast(s64)state.paints &&
       arguments[1].kind == HostRecord {
        if state.phase == 1 {
            if !WriteLiteral(state, "],\"paint\":[") { return 0 }
            state.phase = 2
        }
        if state.paints > 0 && !WriteByte(state, cast(u8)44) { return 0 }
        if !JsonValue(state, *arguments[1], 0) { return 0 }
        state.paints += 1
        return 1
    }
    if function == "RecordFrameEnd" && count == 0 &&
       state.phase != 0 && state.nodes == state.expected_nodes &&
       state.paints == state.expected_paints {
        if state.phase == 1 &&
           !WriteLiteral(state, "],\"paint\":[") { return 0 }
        if !WriteLiteral(state, "]}") { return 0 }
        state.phase = 3
        return 1
    }
    return 0
}

SkipSpace :: (line: string, at: *s32) {
    while at.* < cast(s32)line.count &&
          (line[at.*] == cast(u8)32 || line[at.*] == cast(u8)9 ||
           line[at.*] == cast(u8)13) { at.* += 1 }
}

ParseReal :: (line: string, at: *s32, result: *float32) -> bool {
    SkipSpace(line, at)
    sign: float64 = 1.0
    if at.* < cast(s32)line.count && line[at.*] == cast(u8)45 {
        sign = -1.0
        at.* += 1
    } else if at.* < cast(s32)line.count && line[at.*] == cast(u8)43 {
        at.* += 1
    }
    value: float64 = 0.0
    digits: s32 = 0
    while at.* < cast(s32)line.count &&
          line[at.*] >= cast(u8)48 && line[at.*] <= cast(u8)57 {
        value = value * 10.0 + cast(float64)(line[at.*] - cast(u8)48)
        at.* += 1
        digits += 1
    }
    if at.* < cast(s32)line.count && line[at.*] == cast(u8)46 {
        at.* += 1
        scale: float64 = 0.1
        while at.* < cast(s32)line.count &&
              line[at.*] >= cast(u8)48 && line[at.*] <= cast(u8)57 {
            value += cast(float64)(line[at.*] - cast(u8)48) * scale
            scale *= 0.1
            at.* += 1
            digits += 1
        }
    }
    if digits == 0 { return false }
    if at.* < cast(s32)line.count &&
       (line[at.*] == cast(u8)101 || line[at.*] == cast(u8)69) {
        at.* += 1
        negative_exponent: bool = false
        if at.* < cast(s32)line.count && line[at.*] == cast(u8)45 {
            negative_exponent = true
            at.* += 1
        } else {
            if at.* < cast(s32)line.count &&
               line[at.*] == cast(u8)43 { at.* += 1 }
        }
        exponent_digits: s32 = 0
        exponent: s32 = 0
        while at.* < cast(s32)line.count &&
              line[at.*] >= cast(u8)48 && line[at.*] <= cast(u8)57 {
            if exponent < 1000 {
                exponent = exponent * 10 + cast(s32)(line[at.*] - cast(u8)48)
                if exponent > 1000 { exponent = 1000 }
            }
            exponent_digits += 1
            at.* += 1
        }
        if exponent_digits == 0 { return false }
        if negative_exponent {
            while exponent > 0 {
                value /= 10.0
                exponent -= 1
            }
        } else {
            while exponent > 0 {
                value *= 10.0
                exponent -= 1
            }
        }
    }
    if value != value || value - value != 0.0 ||
       value > 3.4028234663852886e38 { return false }
    result.* = cast(float32)(value * sign)
    return true
}

ParseFlag :: (line: string, at: *s32, result: *bool) -> bool {
    SkipSpace(line, at)
    if at.* >= cast(s32)line.count { return false }
    if line[at.*] == cast(u8)48 { result.* = false }
    else if line[at.*] == cast(u8)49 { result.* = true }
    else { return false }
    at.* += 1
    if at.* < cast(s32)line.count &&
       line[at.*] != cast(u8)32 && line[at.*] != cast(u8)9 &&
       line[at.*] != cast(u8)13 { return false }
    return true
}

ParseInteger :: (line: string, at: *s32, output: *s64) -> bool {
    SkipSpace(line, at)
    negative: bool = false
    if at.* < line.count && line[at.*] == cast(u8)45 { negative = true; at.* += 1 }
    digits: s32 = 0
    value: s64 = 0
    while at.* < line.count && line[at.*] >= cast(u8)48 && line[at.*] <= cast(u8)57 {
        digit: s64 = cast(s64)(line[at.*] - cast(u8)48)
        if value > (9223372036854775807 - digit) / 10 { return false }
        value = value * 10 + digit; digits += 1; at.* += 1
    }
    if digits == 0 || (at.* < line.count && line[at.*] != cast(u8)32 && line[at.*] != cast(u8)9 && line[at.*] != cast(u8)13) { return false }
    if negative { value = -value }
    output.* = value
    return true
}

ParseInt32 :: (line: string, at: *s32, output: *s32) -> bool {
    value: s64 = 0
    if !ParseInteger(line, at, *value) || value < -2147483648 || value > 2147483647 { return false }
    output.* = cast(s32)value
    return true
}

HexValue :: (byte: u8) -> s32 {
    if byte >= cast(u8)48 && byte <= cast(u8)57 { return cast(s32)byte - 48 }
    if byte >= cast(u8)97 && byte <= cast(u8)102 { return cast(s32)byte - 87 }
    if byte >= cast(u8)65 && byte <= cast(u8)70 { return cast(s32)byte - 55 }
    return -1
}

ParseText :: (line: string, at: *s32, output: []u8, length: *s32) -> bool {
    SkipSpace(line, at)
    length.* = 0
    if at.* >= line.count { return false }
    if line[at.*] == cast(u8)45 { at.* += 1 }
    else {
        while at.* < line.count && line[at.*] != cast(u8)32 && line[at.*] != cast(u8)9 && line[at.*] != cast(u8)13 {
            if at.* + 1 >= line.count || length.* >= output.count { return false }
            high: s32 = HexValue(line[at.*]); low: s32 = HexValue(line[at.* + 1])
            if high < 0 || low < 0 { return false }
            output[length.*] = cast(u8)(high * 16 + low)
            length.* += 1; at.* += 2
        }
    }
    if at.* < line.count && line[at.*] != cast(u8)32 && line[at.*] != cast(u8)9 && line[at.*] != cast(u8)13 { return false }
    return Utf8.Valid(TextView(output[:length.*]))
}

ReadTrace :: (state: *ReplayState, path: string) -> bool {
    file: FileHandle = OpenRead(path)
    if !file.valid { return false }
    length: s64 = FileSize(file)
    if length <= 0 || length > 1048576 { CloseFile(file); return false }
    read: s64 = ReadAt(file, state.trace_bytes[0:length], 0)
    CloseFile(file)
    if read != length { return false }
    start: s64 = 0
    while start < length {
        stop: s64 = start
        while stop < length && state.trace_bytes[stop] != cast(u8)10 { stop += 1 }
        line: string = TextFromBytes(state.trace_bytes[start:stop])
        at: s32 = 0
        SkipSpace(line, *at)
        if at < cast(s32)line.count && line[at] != cast(u8)35 {
            if state.sample_count >= 1024 { return false }
            sample: ReplaySample
            sample.width = 320.0; sample.height = 160.0
            sample.elapsed_ms = cast(s64)state.sample_count * 16
            if !ParseReal(line, *at, *sample.x) ||
               !ParseReal(line, *at, *sample.y) ||
               !ParseFlag(line, *at, *sample.down) ||
               !ParseFlag(line, *at, *sample.pressed) ||
               !ParseFlag(line, *at, *sample.released) { return false }
            SkipSpace(line, *at)
            if at < line.count {
                sample.extended = true; state.extended = true
                if !ParseFlag(line, *at, *sample.secondary_down) { return false }
                if !ParseFlag(line, *at, *sample.secondary_pressed) { return false }
                if !ParseFlag(line, *at, *sample.secondary_released) { return false }
                if !ParseInt32(line, *at, *sample.key) { return false }
                if !ParseInt32(line, *at, *sample.modifiers) { return false }
                if !ParseReal(line, *at, *sample.wheel) { return false }
                if !ParseReal(line, *at, *sample.width) { return false }
                if !ParseReal(line, *at, *sample.height) { return false }
                if !ParseInteger(line, *at, *sample.elapsed_ms) { return false }
                if !ParseText(line, *at, sample.text_bytes[:], *sample.text_count) { return false }
                if !ParseInt32(line, *at, *sample.ime_phase) { return false }
                if !ParseInt32(line, *at, *sample.ime_cursor) { return false }
                if !ParseInt32(line, *at, *sample.ime_selection) { return false }
                if !ParseText(line, *at, sample.ime_text_bytes[:], *sample.ime_text_count) { return false }
                if !ParseText(line, *at, sample.clipboard_bytes[:], *sample.clipboard_count) { return false }
                if sample.width <= 0.0 || sample.height <= 0.0 || sample.elapsed_ms < 0 ||
                    sample.key < 0 || sample.modifiers < 0 || sample.modifiers > 7 ||
                    sample.ime_phase < 0 || sample.ime_phase > 4 || sample.ime_cursor < 0 ||
                    sample.ime_selection < 0 || sample.ime_cursor + cast(s64)sample.ime_selection > sample.ime_text_count { return false }
                SkipSpace(line, *at)
            }
            if at != cast(s32)line.count { return false }
            state.samples[state.sample_count] = sample
            state.sample_count += 1
        }
        start = stop + 1
    }
    return state.sample_count > 0
}

InitializeBindings :: (state: *ReplayState, pointer_module: string) -> bool {
    callback: HostCall = ReplayCall
    if !PreparePointer(state) || !PrepareInput(state) { return false }
    return SetBinding(state, 0, "font_metrics", "MeasureGlyphWidth", callback) &&
        SetBinding(state, 1, "font_metrics", "MeasureGlyphLineHeight", callback) &&
        SetBinding(state, 2, "raster_shape", "RasterRoundedRectangle", callback) &&
        SetBinding(state, 3, "raster_shape", "RasterRoundedRectangleOutline", callback) &&
        SetBinding(state, 4, "raster_text", "RasterText", callback) &&
        SetBinding(state, 5, "raster_text", "RasterTextClipped", callback) &&
        SetBinding(state, 6, "raster", "RasterLine", callback) &&
        SetBinding(state, 7, "paint_queue", "RasterImage", callback) &&
        SetBinding(state, 8, "image_raster", "ImageWidth", callback) &&
        SetBinding(state, 9, "image_raster", "ImageHeight", callback) &&
        SetBinding(state, 10, pointer_module, "PollPointer", callback) &&
        SetBinding(state, 11, "frame_capture", "RecordFrameStart", callback) &&
        SetBinding(state, 12, "frame_capture", "RecordNode", callback) &&
        SetBinding(state, 13, "frame_capture", "RecordPaint", callback) &&
        SetBinding(state, 14, "frame_capture", "RecordFrameEnd", callback) &&
        SetBinding(state, 15, pointer_module, "PollFrameInput", callback) &&
        SetBinding(state, 16, "system_clipboard", "SystemClipboardOpenHost", callback) &&
        SetBinding(state, 17, "system_clipboard", "SystemClipboardByteHost", callback) &&
        SetBinding(state, 18, "system_clipboard", "SystemClipboardWriteHost", callback) &&
        SetBinding(state, 19, "frame_capture", "RecordFrameFailure", callback)
}

Replay :: (state: *ReplayState, bundle_path: string,
           output_path: string) -> bool {
    bundle_name: [4096]u8
    if !CopyCString(bundle_path, bundle_name[:]) { return false }
    bundle: *void = OpenBundle(*bundle_name[0])
    if bundle == null { return false }
    instance: *void = InstantiateBundle(bundle, *state.bindings[0],
                                        cast(u64)20)
    if instance == null { CloseBundle(bundle); return false }
    state.output = OpenReplace(output_path)
    if !state.output.valid {
        CloseBundleInstance(instance)
        CloseBundle(bundle)
        return false
    }
    ok: bool = WriteLiteral(state, "{\"version\":")
    if ok { ok = WriteUnsigned(state, ifx state.extended then cast(u64)2 else cast(u64)1) }
    if ok { ok = WriteLiteral(state, ",\"frames\":[") }
    index: s32 = 0
    while ok && index < state.sample_count {
        state.input = state.samples[index]
        state.current_sample = index
        state.clipboard_written = false
        state.pointer_calls = 0
        state.capture_calls = 0
        state.phase = 0
        state.nodes = 0
        state.paints = 0
        state.effects = 0
        if index > 0 { ok = WriteByte(state, cast(u8)44) }
        sample: ReplaySample = state.input
        if ok { ok = WriteLiteral(state, "{\"input\":{\"x\":") }
        if ok { ok = WriteReal(state, cast(float64)sample.x, true) }
        if ok { ok = WriteLiteral(state, ",\"y\":") }
        if ok { ok = WriteReal(state, cast(float64)sample.y, true) }
        if ok { ok = WriteLiteral(state, ",\"down\":") }
        if ok {
            if sample.down { ok = WriteLiteral(state, "true") }
            else { ok = WriteLiteral(state, "false") }
        }
        if ok { ok = WriteLiteral(state, ",\"pressed\":") }
        if ok {
            if sample.pressed { ok = WriteLiteral(state, "true") }
            else { ok = WriteLiteral(state, "false") }
        }
        if ok { ok = WriteLiteral(state, ",\"released\":") }
        if ok {
            if sample.released { ok = WriteLiteral(state, "true") }
            else { ok = WriteLiteral(state, "false") }
        }
        if ok && sample.extended {
            input_value: HostValue
            InputResult(state, *input_value)
            for field: cast(s32)5..19 {
                if ok { ok = WriteByte(state, cast(u8)44) }
                if ok { ok = JsonString(state, state.input_fields[field].name, cast(u64)InputName(field).count) }
                if ok { ok = WriteByte(state, cast(u8)58) }
                if ok { ok = JsonValue(state, *state.input_fields[field].value, 0) }
            }
        }
        if ok { ok = WriteLiteral(state, "},") }
        value: s64 = 0
        has_value: s32 = 0
        if ok { ok = RunBundleInstance(instance, *value, *has_value) != 0 }
        ok = ok && has_value != 0 && state.pointer_calls == 1 &&
             state.capture_calls == 1 && (state.phase == 3 || state.phase == 4)
        if ok { ok = WriteLiteral(state, ",\"result\":") }
        if ok { ok = WriteSigned(state, value) }
        if ok { ok = WriteLiteral(state, ",\"effects\":") }
        if ok { ok = WriteSigned(state, cast(s64)state.effects) }
        if ok && state.clipboard_written {
            ok = WriteLiteral(state, ",\"clipboard_output\":") &&
                JsonString(state, *state.clipboard_bytes[0], cast(u64)state.clipboard_count)
        }
        if ok { ok = WriteByte(state, cast(u8)125) }
        index += 1
    }
    if ok { ok = WriteLiteral(state, "]}\n") }
    if !CloseFile(state.output) { ok = false }
    CloseBundleInstance(instance)
    CloseBundle(bundle)
    return ok && !state.failed && !state.application_failed
}

#program_export
main :: () -> s32 {
    arguments: [5]string
    command_bytes: [8192]u8
    file: FileHandle = OpenRead("/proc/self/cmdline")
    if !file.valid { return 2 }
    read: s64 = ReadAt(file, command_bytes[:], 0)
    CloseFile(file)
    if read <= 0 || read > 8192 { return 2 }
    count: s32 = 0
    start: s64 = 0
    index: s64 = 0
    while index < read {
        if command_bytes[index] == cast(u8)0 {
            if count >= 5 { return 2 }
            arguments[count] = TextFromBytes(command_bytes[start:index])
            count += 1
            start = index + 1
        }
        index += 1
    }
    if count != 5 || start != read { return 2 }
    if arguments[3] == arguments[4] { return 2 }
    state: ReplayState
    if !ReadTrace(*state, arguments[3]) ||
       !InitializeBindings(*state, arguments[2]) { return 1 }
    if !Replay(*state, arguments[1], arguments[4]) { return 1 }
    return 0
}
