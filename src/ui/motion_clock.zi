// The concrete portable clock belongs to motion, never to the app loop.
#import "frame_motion"
#import "session"
#if TARGET == .ZX {
    Time :: #import "clock";
    MotionTime :: (session: Session) -> float64 {
        return FrameMotionTime(session, Time.Seconds)
    }
} else {
    // Native frame hosts already supply time with the input record.
    MotionTime :: (session: Session) -> float64 { return frame_motion_time[SessionIndex(session)] }
}
