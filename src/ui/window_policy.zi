#import "window_flags"

using NativeWindowFlags;

WindowPoint :: struct {
    x: s32
    y: s32
}

#scope_file
WindowCoordinateClamp :: (value: s64) -> s32 {
    if value < cast(s64)(-2147483648) {
        return -2147483648
    }
    if value > cast(s64)2147483647 {
        return 2147483647
    }
    return cast(s32)value
}

#scope_export
#program_export
WindowInitialPosition :: (x: s32, y: s32, width: s32, height: s32,
                          flags: s32, work_x: s32, work_y: s32,
                          work_width: s32, work_height: s32) -> WindowPoint {
    position: WindowPoint = WindowPoint.{x, y}
    if (flags & NATIVE_WINDOW_TOP_RIGHT) != 0 {
        position.x = WindowCoordinateClamp(cast(s64)work_x + cast(s64)work_width -
                                           cast(s64)width - cast(s64)x)
        position.y = WindowCoordinateClamp(cast(s64)work_y + cast(s64)y)
    } else if (flags & NATIVE_WINDOW_CENTER) != 0 {
        position.x = WindowCoordinateClamp(cast(s64)work_x +
                                           (cast(s64)work_width - cast(s64)width) / 2)
        position.y = WindowCoordinateClamp(cast(s64)work_y +
                                           (cast(s64)work_height - cast(s64)height) / 2)
    }
    return position
}

#program_export
WindowDragMoved :: (delta_x: s32, delta_y: s32) -> s32 {
    if delta_x < -3 || delta_x > 3 || delta_y < -3 || delta_y > 3 {
        return 1
    }
    if delta_x * delta_x + delta_y * delta_y > 9 {
        return 1
    }
    return 0
}

#program_export
WindowDragPosition :: (x: s32, y: s32, delta_x: s32,
                       delta_y: s32, work_x: s32, work_y: s32,
                       work_width: s32, work_height: s32) -> WindowPoint {
    left: s64 = cast(s64)work_x
    top: s64 = cast(s64)work_y
    right: s64 = left + cast(s64)work_width - 24
    bottom: s64 = top + cast(s64)work_height - 24
    if right < left {
        right = left
    }
    if bottom < top {
        bottom = top
    }

    next_x: s64 = cast(s64)x + cast(s64)delta_x
    next_y: s64 = cast(s64)y + cast(s64)delta_y
    if next_x < left {
        next_x = left
    }
    if next_x > right {
        next_x = right
    }
    if next_y < top {
        next_y = top
    }
    if next_y > bottom {
        next_y = bottom
    }
    return WindowPoint.{WindowCoordinateClamp(next_x),
                         WindowCoordinateClamp(next_y)}
}
