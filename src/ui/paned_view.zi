#import "session"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "paned_view_props"
#import "style"
#import "style_sheet"
#import "paint_queue"
#import "surface"
#import "tree"
#import "tree_input"
#import "widget_kind"

PanedViewMetrics :: struct {
    grip: s32
    drop_edge: s32
}

PanedViewLayout :: struct {
    size: s32
    limit: s32
    split: s32
    handle: Rectangle
}

PanedViewDragDecision :: struct {
    clear_active: bool
    start_drag: bool
    drag_active: bool
}

#program_export
PanedViewHandleRole :: () -> s32 {
    return 12
}

#program_export
PanedViewHandleFactsFor :: (class_name: s32, state: s32) -> StyleFacts {
    return StyleControlRoleFacts(StyleKindPanedView(), 0, class_name,
        PanedViewHandleRole(), ButtonToneNeutral, ButtonEmphasisSoft,
        ControlSizeMedium, state)
}

PanedViewMetric :: (fields: u32, field: u32, value: float32, fallback: float32, scale: float32) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0.0 { value = fallback }
    return cast(s32)(value * scale)
}

#program_export
PanedViewMetricsFor :: (scale: float32, handle: StyleFrame) -> PanedViewMetrics {
    if scale <= 0.0 { scale = 1.0 }
    metrics: PanedViewMetrics
    metrics.grip = PanedViewMetric(handle.value.fields, cast(u32)StyleIconSize,
        handle.value.icon_size, 8.0, scale)
    metrics.drop_edge = PanedViewMetric(handle.value.fields, cast(u32)StylePaddingX,
        handle.value.padding_x, 46.0, scale)
    return metrics
}

#program_export
PanedViewSize :: (bounds: Rectangle, vertical: bool) -> s32 {
    size: s32 = cast(s32)bounds.height
    if vertical { size = cast(s32)bounds.width }
    if size < 0 { return 0 }
    return size
}

#program_export
PanedViewLimit :: (size: s32, min_first: s32, min_second: s32) -> s32 {
    if size < 0 { size = 0 }
    if min_first < 0 { min_first = 0 }
    if min_first > size { min_first = size }
    if min_second < 0 { min_second = 0 }
    limit: s32 = size - min_second
    if limit < min_first { limit = min_first }
    return limit
}

#program_export
PanedViewClampSplit :: (split: s32, min_first: s32, limit: s32) -> s32 {
    if min_first < 0 { min_first = 0 }
    if limit < min_first { limit = min_first }
    if split < min_first { return min_first }
    if split > limit { return limit }
    return split
}

#program_export
PanedViewDefaultSplit :: (limit: s32) -> s32 {
    return limit / 2
}

#program_export
PanedViewSplitFor :: (current_split: s32, has_split: bool,
    size: s32, min_first: s32, min_second: s32) -> s32 {
    if min_first > size { min_first = size }
    limit: s32 = PanedViewLimit(size, min_first, min_second)
    split: s32 = current_split
    if !has_split { split = PanedViewDefaultSplit(limit) }
    return PanedViewClampSplit(split, min_first, limit)
}

#program_export
PanedViewPointerSplit :: (bounds: Rectangle, vertical: bool,
    pointer_x: float32, pointer_y: float32) -> s32 {
    if vertical { return cast(s32)(pointer_x - bounds.x) }
    return cast(s32)(pointer_y - bounds.y)
}

#program_export
PanedViewPointerSplitFor :: (bounds: Rectangle, vertical: bool,
    pointer_x: float32, pointer_y: float32, min_first: s32,
    min_second: s32) -> s32 {
    size: s32 = PanedViewSize(bounds, vertical)
    if min_first > size { min_first = size }
    limit: s32 = PanedViewLimit(size, min_first, min_second)
    split: s32 = PanedViewPointerSplit(bounds, vertical, pointer_x,
        pointer_y)
    return PanedViewClampSplit(split, min_first, limit)
}

#program_export
PanedViewHandleFor :: (bounds: Rectangle, vertical: bool,
    split: s32, metrics: PanedViewMetrics) -> Rectangle {
    handle: Rectangle
    half: float32 = cast(float32)metrics.grip * 0.5
    if vertical {
        handle.x = bounds.x + cast(float32)split - half
        handle.y = bounds.y
        handle.width = cast(float32)metrics.grip
        handle.height = bounds.height
    } else {
        handle.x = bounds.x
        handle.y = bounds.y + cast(float32)split - half
        handle.width = bounds.width
        handle.height = cast(float32)metrics.grip
    }
    return handle
}

#program_export
PanedViewLayoutFor :: (bounds: Rectangle, vertical: bool,
    current_split: s32, has_split: bool, min_first: s32, min_second: s32,
    metrics: PanedViewMetrics) -> PanedViewLayout {
    layout: PanedViewLayout
    layout.size = PanedViewSize(bounds, vertical)
    if min_first > layout.size { min_first = layout.size }
    layout.limit = PanedViewLimit(layout.size, min_first, min_second)
    layout.split = current_split
    if !has_split {
        layout.split = PanedViewDefaultSplit(layout.limit)
    }
    layout.split = PanedViewClampSplit(layout.split, min_first, layout.limit)
    layout.handle = PanedViewHandleFor(bounds, vertical, layout.split,
        metrics)
    return layout
}

#program_export
PanedViewChanged :: (previous_split: s32, next_split: s32,
    has_split: bool) -> bool {
    if !has_split { return false }
    return previous_split != next_split
}

#program_export
PanedViewDragFor :: (has_active: bool, active_is_current: bool,
    owner_captured: bool, mouse_down: bool, disabled: bool, has_split: bool,
    handle_hot: bool, mouse_pressed: bool) -> PanedViewDragDecision {
    decision: PanedViewDragDecision
    if has_active && owner_captured {
        decision.clear_active = true
    }
    if has_active && !mouse_down {
        decision.clear_active = true
    }
    if disabled && active_is_current {
        decision.clear_active = true
    }
    has_active = has_active && !decision.clear_active
    active_is_current = active_is_current && !decision.clear_active
    if !decision.clear_active && !disabled && has_split && handle_hot &&
        mouse_down && mouse_pressed {
        decision.start_drag = true
        active_is_current = true
    }
    decision.drag_active = active_is_current || decision.start_drag
    return decision
}

#program_export
PanedViewDropZoneFor :: (bounds: Rectangle, mouse: Vector2,
    metrics: PanedViewMetrics) -> s32 {
    if mouse.x < bounds.x || mouse.x > bounds.x + bounds.width ||
       mouse.y < bounds.y || mouse.y > bounds.y + bounds.height {
        return DropNone
    }
    edge: s32 = metrics.drop_edge
    if edge < 0 { edge = 0 }
    if mouse.x < bounds.x + cast(float32)edge { return DropLeft }
    if mouse.x > bounds.x + bounds.width - cast(float32)edge { return DropRight }
    if mouse.y < bounds.y + cast(float32)edge { return DropTop }
    if mouse.y > bounds.y + bounds.height - cast(float32)edge { return DropBottom }
    return DropCenter
}

#program_export
PanedViewFace :: (class_name: s32, disabled: bool) -> StyleFrame {
    defaults: StyleData
    defaults.fields = cast(u32)StyleBackground | cast(u32)StyleRadius |
        cast(u32)StyleOpacity | cast(u32)StyleIconSize |
        cast(u32)StylePaddingX
    defaults.background = cast(u32)0x9ca3afff
    defaults.radius = 4.0
    defaults.opacity = 1.0
    defaults.icon_size = 8.0
    defaults.padding_x = 46.0
    if disabled { defaults.opacity = 0.45 }
    state: s32 = ButtonStateNormal
    if disabled { state = ButtonStateDisabled }
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), defaults,
        PanedViewHandleFactsFor(class_name, state), state)
    return frame
}

#program_export
PanedViewHandleKey :: () -> u64 {
    return cast(u64)1
}

PaneBounds :: struct {
    first: Rectangle
    second: Rectangle
}

#program_export
PanedViewPanesFor :: (bounds: Rectangle, handle: Rectangle,
    vertical: bool) -> PaneBounds {
    panes: PaneBounds
    panes.first = bounds
    panes.second = bounds
    if vertical {
        panes.first.width = handle.x - bounds.x
        panes.second.x = handle.x + handle.width
        panes.second.width = bounds.x + bounds.width - panes.second.x
        if panes.first.width < 0.0 { panes.first.width = 0.0 }
        if panes.second.width < 0.0 { panes.second.width = 0.0 }
    } else {
        panes.first.height = handle.y - bounds.y
        panes.second.y = handle.y + handle.height
        panes.second.height = bounds.y + bounds.height - panes.second.y
        if panes.first.height < 0.0 { panes.first.height = 0.0 }
        if panes.second.height < 0.0 { panes.second.height = 0.0 }
    }
    return panes
}

#program_export
PaneDropZone :: (bounds: Rectangle, mouse: Vector2, scale: float32,
    class_name: s32) -> DropZone {
    face: StyleFrame = PanedViewFace(class_name, false)
    metrics: PanedViewMetrics = PanedViewMetricsFor(scale, face)
    return cast(DropZone)PanedViewDropZoneFor(bounds, mouse, metrics)
}

// The caller stores the returned split and places its pane content in the
// returned rectangles. The handle uses the retained pointer drag route.
#program_export
PanedView :: (session: Session, props: PanedViewProps) -> PanedViewResult {
    result: PanedViewResult
    result.node = -1
    bounds: Rectangle = props.bounds
    parent: Rectangle = TreeCurrentParentBounds(session)
    if bounds.width <= 0.0 { bounds.width = parent.width }
    if bounds.height <= 0.0 { bounds.height = parent.height }
    scale: float32 = props.scale
    if scale <= 0.0 { scale = 1.0 }
    face: StyleFrame = PanedViewFace(props.class_name, props.disabled)
    metrics: PanedViewMetrics = PanedViewMetricsFor(scale, face)
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    if key == cast(u64)0 { key = TreeNextKey(session) }
    if TreeIsBuilding(session) {
        result.node = TreeSubmitCurrent(session, key, WidgetKindPanedView, bounds)
        if result.node < 0 { return result }
        bounds = TreeSubmittedNodeAt(session, result.node).bounds
    }
    layout: PanedViewLayout = PanedViewLayoutFor(bounds, props.vertical,
        props.split, props.has_split, props.min_first,
        props.min_second, metrics)
    if TreeIsBuilding(session) && props.has_split && !props.disabled {
        previous_view: s32 = TreePrevious(session,
            TreeCurrentParent(session), key, WidgetKindPanedView)
        previous: s32 = TreePreviousCommitted(session, previous_view,
            PanedViewHandleKey(), WidgetKindSlider)
        drag: PointerDrag = TreeTakeDragAt(session, previous)
        if drag.active || drag.ended {
            pointer_x: float32 = drag.x - drag.grab_x +
                cast(float32)metrics.grip * 0.5
            pointer_y: float32 = drag.y - drag.grab_y +
                cast(float32)metrics.grip * 0.5
            layout.split = PanedViewPointerSplitFor(bounds,
                props.vertical, pointer_x, pointer_y,
                props.min_first, props.min_second)
            layout.handle = PanedViewHandleFor(bounds, props.vertical,
                layout.split, metrics)
        }
    }
    result.split = layout.split
    result.changed = PanedViewChanged(props.split, result.split,
        props.has_split)
    result.handle = RectangleIntersection(layout.handle, bounds)
    panes: PaneBounds = PanedViewPanesFor(bounds, result.handle,
        props.vertical)
    result.first = panes.first
    result.second = panes.second
    handle_node: s32 = -1
    if TreeIsBuilding(session) {
        handle_node = TreeSubmit(session, PanedViewHandleKey(), result.node,
            WidgetKindSlider, result.handle)
        TreeSetInteractive(session, handle_node,
            props.disabled || !props.has_split, false, props.id)
    }
    if result.handle.width > 0.0 && result.handle.height > 0.0 {
        PaintRoundedFill(session, handle_node, result.handle,
            face.value.radius, 12,
            ColorFromPacked(Opacity(face.value.background,
                StyleOpacityValue(face.value.fields,
                    face.value.opacity))))
    }
    return result
}
