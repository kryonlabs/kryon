#module "guide"
#import "control_props"
#import "drawing_props"
#import "style"

GuideMetrics :: struct {
    margin: i32
    anchor_padding: i32
    anchor_stroke: i32
    gap: i32
    pad: i32
    button_size: i32
    close_size: i32
    close_icon_size: i32
    close_icon_padding: i32
    nav_icon_size: i32
    nav_icon_padding: i32
    nav_gap: i32
    text_gap: i32
    default_line_gap: i32
    controls_gap: i32
    text_guard: i32
    min_tip_height: i32
    default_tip_width: i32
}

GuideScrim :: struct {
    top: Rectangle
    bottom: Rectangle
    left: Rectangle
    right: Rectangle
}

GuideArrow :: struct {
    line_start: Vector2
    line_end: Vector2
    tip0: Vector2
    tip1: Vector2
    tip2: Vector2
    stroke_width: float
}

GuideLayout :: struct {
    tip: Rectangle
    text: Rectangle
    close_button: Rectangle
    back_button: Rectangle
    next_button: Rectangle
    controls_y: i32
    text_clip_height: i32
    text_clipped: bool
    finish: bool
}

GuidePolicy :: struct {
    step: i32
    changed: bool
    closed: bool
    finished: bool
}

guide_clampi :: (value: i32, minimum: i32, maximum: i32) -> i32 {
    if value < minimum { return minimum }
    if value > maximum { return maximum }
    return value
}

GuideHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

GuideMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !GuideHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

GuideMetricsFor :: (scale: float, panel: StyleFrame, anchor: StyleFrame,
    label: StyleFrame, action: StyleFrame, close: StyleFrame) -> GuideMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: GuideMetrics
    metrics.margin = GuideMetric(panel.value.fields,
        (u32)StylePaddingY, panel.value.padding_y, 12.0, scale, true)
    metrics.anchor_padding = GuideMetric(anchor.value.fields,
        (u32)StylePaddingX, anchor.value.padding_x, 4.0, scale, true)
    metrics.anchor_stroke = GuideMetric(anchor.value.fields,
        (u32)StyleBorderWidth, anchor.value.border_width, 2.0, scale, true)
    metrics.gap = GuideMetric(panel.value.fields,
        (u32)StyleGap, panel.value.gap, 20.0, scale, true)
    metrics.pad = GuideMetric(panel.value.fields,
        (u32)StylePaddingX, panel.value.padding_x, 12.0, scale, true)
    metrics.button_size = GuideMetric(action.value.fields,
        (u32)StyleContentOffset, action.value.offset_y, 34.0, scale, false)
    metrics.close_size = GuideMetric(close.value.fields,
        (u32)StyleContentOffset, close.value.offset_y, 28.0, scale, false)
    metrics.close_icon_size = GuideMetric(close.value.fields,
        (u32)StyleIconSize, close.value.icon_size, 16.0, scale, true)
    metrics.close_icon_padding = GuideMetric(close.value.fields,
        (u32)StylePaddingX, close.value.padding_x, 6.0, scale, true)
    metrics.nav_icon_size = GuideMetric(action.value.fields,
        (u32)StyleIconSize, action.value.icon_size, 19.0, scale, true)
    metrics.nav_icon_padding = GuideMetric(action.value.fields,
        (u32)StylePaddingX, action.value.padding_x, 7.0, scale, true)
    metrics.nav_gap = GuideMetric(action.value.fields,
        (u32)StyleGap, action.value.gap, 8.0, scale, true)
    metrics.text_gap = GuideMetric(label.value.fields,
        (u32)StyleGap, label.value.gap, 8.0, scale, true)
    metrics.default_line_gap = GuideMetric(label.value.fields,
        (u32)StylePaddingY, label.value.padding_y, 6.0, scale, true)
    metrics.controls_gap = GuideMetric(close.value.fields,
        (u32)StyleGap, close.value.gap, 12.0, scale, true)
    metrics.text_guard = GuideMetric(label.value.fields,
        (u32)StylePaddingX, label.value.padding_x, 8.0, scale, true)
    metrics.min_tip_height = GuideMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_y, 112.0, scale, false)
    metrics.default_tip_width = GuideMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_x, 300.0, scale, false)
    return metrics
}

GuideStepFor :: (step: i32, count: i32) -> i32 #export {
    if count <= 0 { return 0 }
    return guide_clampi(step, 0, count - 1)
}

GuidePolicyFor :: (step: i32, count: i32, previous: bool, next: bool,
    close_requested: bool) -> GuidePolicy #export {
    policy: GuidePolicy
    step = GuideStepFor(step, count)
    policy.step = step
    if close_requested {
        policy.closed = true
        return policy
    }
    if previous && step > 0 {
        policy.step = step - 1
        policy.changed = true
    } else if next {
        if step >= count - 1 {
            policy.finished = true
        } else {
            policy.step = step + 1
            policy.changed = true
        }
    }
    return policy
}

GuideTipWidth :: (view_width: i32, max_width: i32,
    metrics: GuideMetrics) -> i32 #export {
    width: i32 = view_width - metrics.margin * 2
    if max_width > 0 && width > max_width {
        width = max_width
    } else if width > metrics.default_tip_width {
        width = metrics.default_tip_width
    }
    if width < 1 { width = 1 }
    return width
}

GuideMaxTipHeight :: (view_height: i32, reserved_top: i32,
    reserved_bottom: i32, metrics: GuideMetrics) -> i32 #export {
    max_h: i32 = view_height - reserved_top - reserved_bottom -
                 metrics.margin * 2
    if max_h < metrics.min_tip_height {
        max_h = view_height - metrics.margin * 2
    }
    if max_h < 1 { max_h = 1 }
    return max_h
}

GuideChromeHeight :: (metrics: GuideMetrics) -> i32 #export {
    return metrics.pad + metrics.close_size + metrics.text_gap +
           metrics.text_guard + metrics.controls_gap +
           metrics.button_size + metrics.pad
}

GuideLineGapFor :: (requested_line_gap: i32, metrics: GuideMetrics) -> i32 #export {
    if requested_line_gap > 0 { return requested_line_gap }
    return metrics.default_line_gap
}

GuideParagraphFontFor :: (requested_font: i32, style_font: i32,
    default_font: i32) -> i32 #export {
    font: i32 = default_font
    if requested_font > 0 { font = requested_font }
    if style_font > 0 { font = style_font }
    return font
}

GuideParagraphHeightLimit :: (max_tip_height: i32,
    metrics: GuideMetrics) -> i32 #export {
    return max_tip_height - GuideChromeHeight(metrics)
}

GuideShouldShrinkParagraphFont :: (paragraph_height: i32, height_limit: i32,
    font: i32, min_font: i32) -> bool #export {
    return font > min_font && paragraph_height > height_limit
}

GuideShrinkParagraphFontStep :: (paragraph_height: i32, height_limit: i32,
    font: i32, min_font: i32) -> i32 #export {
    if GuideShouldShrinkParagraphFont(paragraph_height, height_limit, font, min_font) {
        return font - 1
    }
    return font
}

GuideTipHeight :: (paragraph_height: i32, max_tip_height: i32,
    metrics: GuideMetrics) -> i32 #export {
    height: i32 = GuideChromeHeight(metrics) + paragraph_height
    if height < metrics.min_tip_height { height = metrics.min_tip_height }
    if height > max_tip_height { height = max_tip_height }
    if height < 1 { height = 1 }
    return height
}

GuideTipBounds :: (anchor: Rectangle, width: i32, height: i32,
    view_width: i32, view_height: i32, reserved_top: i32,
    reserved_bottom: i32, metrics: GuideMetrics) -> Rectangle #export {
    bottom: i32 = view_height - reserved_bottom
    x: i32 = (i32)(anchor.x + anchor.width / 2.0) - width / 2
    y: i32
    rect: Rectangle

    if bottom < reserved_top + metrics.margin {
        bottom = view_height - metrics.margin
    }
    if x < metrics.margin { x = metrics.margin }
    if x + width > view_width - metrics.margin {
        x = view_width - metrics.margin - width
    }
    if x < metrics.margin { x = metrics.margin }

    if anchor.y + anchor.height + (float)metrics.gap + (float)height <
       (float)bottom {
        y = (i32)(anchor.y + anchor.height + (float)metrics.gap)
    } else {
        y = (i32)(anchor.y - (float)metrics.gap - (float)height)
    }
    if y < reserved_top + metrics.margin {
        y = reserved_top + metrics.margin
    }
    if y + height > bottom - metrics.margin {
        y = bottom - metrics.margin - height
    }
    if y < metrics.margin { y = metrics.margin }

    rect.x = (float)x
    rect.y = (float)y
    rect.width = (float)width
    rect.height = (float)height
    return rect
}

GuideScrimFor :: (view_width: i32, view_height: i32,
    anchor: Rectangle, metrics: GuideMetrics) -> GuideScrim #export {
    scrim: GuideScrim
    left: i32 = guide_clampi((i32)anchor.x - metrics.anchor_padding, 0, view_width)
    top: i32 = guide_clampi((i32)anchor.y - metrics.anchor_padding, 0, view_height)
    right: i32 = guide_clampi((i32)(anchor.x + anchor.width) +
        metrics.anchor_padding, 0, view_width)
    bottom: i32 = guide_clampi((i32)(anchor.y + anchor.height) +
        metrics.anchor_padding, 0, view_height)

    scrim.top = (Rectangle){0.0, 0.0, (float)view_width, (float)top}
    scrim.bottom = (Rectangle){0.0, (float)bottom, (float)view_width,
        (float)(view_height - bottom)}
    scrim.left = (Rectangle){0.0, (float)top, (float)left,
        (float)(bottom - top)}
    scrim.right = (Rectangle){(float)right, (float)top,
        (float)(view_width - right), (float)(bottom - top)}
    return scrim
}

GuideArrowFor :: (tip: Rectangle, anchor: Rectangle,
    metrics: GuideMetrics) -> GuideArrow #export {
    arrow: GuideArrow
    anchor_cx: i32 = (i32)(anchor.x + anchor.width / 2.0)
    anchor_cy: i32 = (i32)(anchor.y + anchor.height / 2.0)
    tip_left: i32 = (i32)tip.x
    tip_right: i32 = (i32)(tip.x + tip.width)
    tip_top: i32 = (i32)tip.y
    tip_bottom: i32 = (i32)(tip.y + tip.height)
    arrow_size: i32 = metrics.gap / 2
    if arrow_size < 0 { arrow_size = 0 }
    arrow.stroke_width = (float)metrics.anchor_stroke

    if anchor_cy < tip_top {
        arrow.line_start.x = (float)anchor_cx
        arrow.line_start.y = (float)(anchor_cy + (i32)(anchor.height / 2.0))
        arrow.line_end.x = (float)anchor_cx
        arrow.line_end.y = (float)tip_top
        arrow.tip0 = arrow.line_end
        arrow.tip1.x = arrow.line_end.x - (float)arrow_size
        arrow.tip1.y = arrow.line_end.y - (float)arrow_size
        arrow.tip2.x = arrow.line_end.x + (float)arrow_size
        arrow.tip2.y = arrow.line_end.y - (float)arrow_size
    } else if anchor_cy > tip_bottom {
        arrow.line_start.x = (float)anchor_cx
        arrow.line_start.y = (float)(anchor_cy - (i32)(anchor.height / 2.0))
        arrow.line_end.x = (float)anchor_cx
        arrow.line_end.y = (float)tip_bottom
        arrow.tip0 = arrow.line_end
        arrow.tip1.x = arrow.line_end.x + (float)arrow_size
        arrow.tip1.y = arrow.line_end.y + (float)arrow_size
        arrow.tip2.x = arrow.line_end.x - (float)arrow_size
        arrow.tip2.y = arrow.line_end.y + (float)arrow_size
    } else if anchor_cx < tip_left {
        arrow.line_start.x = (float)(anchor_cx + (i32)(anchor.width / 2.0))
        arrow.line_start.y = (float)anchor_cy
        arrow.line_end.x = (float)tip_left
        arrow.line_end.y = (float)anchor_cy
        arrow.tip0 = arrow.line_end
        arrow.tip1.x = arrow.line_end.x - (float)arrow_size
        arrow.tip1.y = arrow.line_end.y - (float)arrow_size
        arrow.tip2.x = arrow.line_end.x - (float)arrow_size
        arrow.tip2.y = arrow.line_end.y + (float)arrow_size
    } else {
        arrow.line_start.x = (float)(anchor_cx - (i32)(anchor.width / 2.0))
        arrow.line_start.y = (float)anchor_cy
        arrow.line_end.x = (float)tip_right
        arrow.line_end.y = (float)anchor_cy
        arrow.tip0 = arrow.line_end
        arrow.tip1.x = arrow.line_end.x + (float)arrow_size
        arrow.tip1.y = arrow.line_end.y - (float)arrow_size
        arrow.tip2.x = arrow.line_end.x + (float)arrow_size
        arrow.tip2.y = arrow.line_end.y + (float)arrow_size
    }
    return arrow
}

GuideLayoutFor :: (tip: Rectangle, paragraph_width: i32,
    paragraph_height: i32, step: i32, count: i32,
    metrics: GuideMetrics) -> GuideLayout #export {
    layout: GuideLayout
    y: i32 = (i32)tip.y + metrics.pad + metrics.close_size +
             metrics.text_gap
    layout.tip = tip
    layout.controls_y = (i32)tip.y + (i32)tip.height - metrics.pad -
                        metrics.button_size
    layout.text_clip_height = layout.controls_y - metrics.controls_gap - y
    layout.text_clipped = layout.text_clip_height <
                          paragraph_height + metrics.text_guard
    layout.finish = step >= count - 1
    layout.text = (Rectangle){(float)((i32)tip.x + metrics.pad),
        (float)y, (float)paragraph_width, (float)layout.text_clip_height}
    layout.close_button = (Rectangle){
        tip.x + tip.width - (float)metrics.pad - (float)metrics.close_size,
        tip.y + (float)metrics.pad,
        (float)metrics.close_size,
        (float)metrics.close_size
    }
    layout.back_button = (Rectangle){
        tip.x + tip.width - (float)metrics.pad -
            (float)(metrics.button_size * 2) - (float)metrics.nav_gap,
        (float)layout.controls_y,
        (float)metrics.button_size,
        (float)metrics.button_size
    }
    layout.next_button = (Rectangle){
        tip.x + tip.width - (float)metrics.pad -
            (float)metrics.button_size,
        (float)layout.controls_y,
        (float)metrics.button_size,
        (float)metrics.button_size
    }
    return layout
}
