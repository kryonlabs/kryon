// Warped images use the page's presenter and its existing texture table.
// Each cell contributes two triangles in painter order to the same GPU batch.
#import "geometry"
#import "drawing_props"
#import "page_core"
#import "page_gpu"
#import "page_texture"
#import "canvas_clip"

PageMeshReset :: () { PageGpuFlush() }
PageMeshFlush :: () { PageGpuFlush() }

PageMeshSource :: (source: Rectangle, fx: float32, fy: float32) -> Vector2 {
    x := source.x + source.width * fx
    if source.width < 0.0 { x = source.x - source.width + source.width * fx }
    y := source.y + source.height * fy
    if source.height < 0.0 { y = source.y - source.height + source.height * fy }
    return Vector2.{x, y}
}

PageMeshDraw :: (id: s32, source: Rectangle, points: []Vector2,
    columns: s32, rows: s32, clip: Rectangle, tint: Color, filter: s32) -> bool {
    if !PageIsOpen() || !PageGpuAttached() || columns < 2 || rows < 2 ||
    points.count < cast(s64)columns * cast(s64)rows || PageTextureFind(id) < 0 { return false }
    for point: points {
        if point.x != point.x || point.y != point.y ||
        point.x > 10000000.0 || point.x < -10000000.0 ||
        point.y > 10000000.0 || point.y < -10000000.0 { return false }
    }
    saved := BeginRasterClip(clip)
    for row: cast(s32)0..rows - 2 {
        for column: cast(s32)0..columns - 2 {
            tl := row * columns + column
            indices: [6]s32 = .{tl, tl + 1, tl + columns, tl + 1, tl + columns + 1, tl + columns}
            for triangle: cast(s32)0..1 {
                first := triangle * 3
                a := indices[first]
                b := indices[first + 1]
                c := indices[first + 2]
                auv := PageMeshSource(source, cast(float32)(a % columns) / cast(float32)(columns - 1),
                    cast(float32)(a / columns) / cast(float32)(rows - 1))
                buv := PageMeshSource(source, cast(float32)(b % columns) / cast(float32)(columns - 1),
                    cast(float32)(b / columns) / cast(float32)(rows - 1))
                cuv := PageMeshSource(source, cast(float32)(c % columns) / cast(float32)(columns - 1),
                    cast(float32)(c / columns) / cast(float32)(rows - 1))
                PageDrawTextureTriangle(id,
                    points[a].x, points[a].y, points[b].x, points[b].y, points[c].x, points[c].y,
                    auv.x, auv.y, buv.x, buv.y, cuv.x, cuv.y,
                    cast(s32)tint.r, cast(s32)tint.g, cast(s32)tint.b, cast(s32)tint.a, filter)
            }
        }
    }
    EndRasterClip(saved)
    return true
}
