#module "slider"
#import "button"
#import "control_props"
#import "drawing_props"
#import "style"
#import "surface"

SliderSpec :: struct {
    bounds: Rectangle
    ratio: float
    vertical: bool
    active: bool
    hovered: bool
    disabled: bool
    scale: float
    track: StyleFrame
    active_track: StyleFrame
    thumb: StyleFrame
}

SliderPaint :: struct {
    bounds: Rectangle
    track_bounds: Rectangle
    active_bounds: Rectangle
    thumb_x: float
    thumb_y: float
    thumb_radius: float
    glow_radius: float
    thumb_shadow_x: float
    thumb_shadow_y: float
    thumb_shadow_radius: float
    thumb_highlight_x: float
    thumb_highlight_y: float
    thumb_highlight_radius: float
    glow_color: u32
    thumb_fill_color: u32
    thumb_edge_color: u32
    thumb_shadow_color: u32
    thumb_highlight_color: u32
    track: StyleFrame
    active_track: StyleFrame
    thumb: StyleFrame
}

SliderStep :: struct {
    value: float
    changed: bool
}

SliderDiscreteStep :: struct {
    value: i32
    changed: bool
}

SliderEditorLayout :: struct {
    editor_bounds: Rectangle
    hit_bounds: Rectangle
    paint_bounds: Rectangle
}

SliderTextPaint :: struct {
    text_x: float
    text_y: float
}

SliderCellTextPaintFor :: (bounds: Rectangle, inset: float,
    text_line_height: float) -> SliderTextPaint #export {
    paint: SliderTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y + (bounds.height - text_line_height) / 2.0
    return paint
}

SliderLabelTextPaintFor :: (bounds: Rectangle, inset: float, font_size: i32,
    gap: float) -> SliderTextPaint #export {
    paint: SliderTextPaint
    paint.text_x = bounds.x + inset
    paint.text_y = bounds.y - (float)font_size - gap
    return paint
}

SliderLabelInsetForStyle :: (label: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(label.value.fields, (u32)StylePaddingX,
        label.value.padding_x, 6.0, scale, true)
}

SliderLabelGapForStyle :: (label: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(label.value.fields, (u32)StyleGap,
        label.value.gap, 2.0, scale, true)
}

SliderCenteredHitBounds :: (x: i32, y: i32, width: i32, height: i32,
    min_width: i32, min_height: i32) -> Rectangle #export {
    hit: Rectangle
    hit_width: i32 = width
    hit_height: i32 = height
    if hit_width < min_width { hit_width = min_width }
    if hit_height < min_height { hit_height = min_height }
    hit.x = (float)(x + width / 2 - hit_width / 2)
    hit.y = (float)(y + height / 2 - hit_height / 2)
    hit.width = (float)hit_width
    hit.height = (float)hit_height
    return hit
}

SliderHorizontalEditorLayoutFor :: (x: i32, y: i32, width: i32,
    min_touch_height: i32, scale: float, track: StyleFrame,
    thumb: StyleFrame) -> SliderEditorLayout #export {
    layout: SliderEditorLayout
    if scale <= 0.0 { scale = 1.0 }
    if width < SliderMinimumLengthForStyle(track, scale) {
        width = SliderMinimumLengthForStyle(track, scale)
    }
    center_offset: i32 = SliderTrackCenterOffsetForStyle(track, scale)
    editor_height: i32 = center_offset * 2
    track_y: i32 = y + center_offset
    thumb_height: i32 = SliderThumbSizeForStyle(thumb, scale)
    track_height: i32 = SliderTrackSizeForStyle(false, track, scale)
    thumb_y: i32 = track_y - (thumb_height - track_height) / 2
    layout.editor_bounds.x = (float)x
    layout.editor_bounds.y = (float)y
    layout.editor_bounds.width = (float)width
    layout.editor_bounds.height = (float)editor_height
    layout.hit_bounds = SliderCenteredHitBounds(x, thumb_y, width,
        thumb_height, width, min_touch_height)
    layout.paint_bounds.x = (float)x
    layout.paint_bounds.y = (float)thumb_y
    layout.paint_bounds.width = (float)width
    layout.paint_bounds.height = (float)thumb_height
    return layout
}

SliderVerticalEditorLayoutFor :: (center_x: i32, y: i32, height: i32,
    min_touch_width: i32, scale: float, track: StyleFrame,
    thumb: StyleFrame) -> SliderEditorLayout #export {
    layout: SliderEditorLayout
    if scale <= 0.0 { scale = 1.0 }
    if height < SliderMinimumLengthForStyle(track, scale) {
        height = SliderMinimumLengthForStyle(track, scale)
    }
    editor_width: i32 = SliderVerticalEditorWidthForStyle(track, thumb, scale)
    track_width: i32 = SliderTrackSizeForStyle(true, track, scale)
    thumb_width: i32 = SliderThumbSizeForStyle(thumb, scale)
    track_x: i32 = center_x - track_width / 2
    layout.editor_bounds.x = (float)(center_x - editor_width / 2)
    layout.editor_bounds.y = (float)y
    layout.editor_bounds.width = (float)editor_width
    layout.editor_bounds.height = (float)height
    layout.hit_bounds = SliderCenteredHitBounds(track_x, y, track_width,
        height, min_touch_width, height)
    layout.paint_bounds.x = (float)(center_x - thumb_width / 2)
    layout.paint_bounds.y = (float)y
    layout.paint_bounds.width = (float)thumb_width
    layout.paint_bounds.height = (float)height
    return layout
}

SliderCellBoundsFor :: (bounds: Rectangle, count: i32, index: i32) -> Rectangle #export {
    cell: Rectangle
    if count <= 0 { return cell }
    if index < 0 { index = 0 }
    if index >= count { index = count - 1 }
    cell.x = bounds.x + bounds.width * (float)index / (float)count
    cell.y = bounds.y
    cell.width = bounds.width / (float)count
    cell.height = bounds.height
    return cell
}

SliderMetric :: (fields: u32, field: u32, value: float, fallback: float,
    scale: float, allow_zero: bool) -> i32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == (u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

SliderMetricFloat :: (fields: u32, field: u32, value: float, fallback: float,
    scale: float, allow_zero: bool) -> float {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == (u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return value * scale
}

SliderMinimumLengthForStyle :: (track: StyleFrame, scale: float) -> i32 #export {
    return SliderMetric(track.value.fields, (u32)StylePaddingX,
        track.value.padding_x, 32.0, scale, false)
}

SliderThumbSizeForStyle :: (thumb: StyleFrame, scale: float) -> i32 #export {
    return SliderMetric(thumb.value.fields, (u32)StyleIconSize,
        thumb.value.icon_size, 22.0, scale, false)
}

SliderTrackSizeForStyle :: (vertical: bool, track: StyleFrame,
    scale: float) -> i32 #export {
    if vertical {
        return SliderMetric(track.value.fields, (u32)StyleIconSize,
            track.value.icon_size, 8.0, scale, false)
    }
    return SliderMetric(track.value.fields, (u32)StylePaddingY,
        track.value.padding_y, 6.0, scale, false)
}

SliderTrackCenterOffsetForStyle :: (track: StyleFrame,
    scale: float) -> i32 #export {
    return SliderMetric(track.value.fields, (u32)StyleContentOffset,
        track.value.offset_y, 28.0, scale, false)
}

SliderVerticalEditorWidthForStyle :: (track: StyleFrame, thumb: StyleFrame,
    scale: float) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    width: float = track.value.offset_x
    if (track.value.fields & (u32)StyleContentOffset) != (u32)0 &&
       width >= 0.0 {
        return (i32)(width * scale)
    }
    thumb_size: i32 = SliderThumbSizeForStyle(thumb, scale)
    track_size: i32 = SliderTrackSizeForStyle(true, track, scale)
    content: i32 = thumb_size
    if track_size > content { content = track_size }
    return content + SliderMetric(track.value.fields, (u32)StyleGap,
        track.value.gap, 14.0, scale, true)
}

SliderGlowExpansionForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StyleGap,
        thumb.value.gap, 8.0, scale, true)
}

SliderThumbShadowOffsetXForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StyleContentOffset,
        thumb.value.offset_x, 0.0, scale, true)
}

SliderThumbShadowOffsetYForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StyleContentOffset,
        thumb.value.offset_y, 2.0, scale, true)
}

SliderThumbShadowExpansionForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StyleBorderWidth,
        thumb.value.border_width, 1.0, scale, true)
}

SliderThumbHighlightOffsetXForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StylePaddingX,
        thumb.value.padding_x, -3.0, scale, true)
}

SliderThumbHighlightOffsetYForStyle :: (thumb: StyleFrame, scale: float) -> float #export {
    return SliderMetricFloat(thumb.value.fields, (u32)StylePaddingY,
        thumb.value.padding_y, -4.0, scale, true)
}

SliderClampRatio :: (ratio: float) -> float #export {
    if ratio < 0.0 { return 0.0 }
    if ratio > 1.0 { return 1.0 }
    return ratio
}

SliderPointerRatio :: (pointer: float, origin: float, length: float,
    inverted: bool) -> float #export {
    if length <= 0.0 { return 0.0 }
    ratio: float = (pointer - origin) / length
    if inverted {
        ratio = 1.0 - ratio
    }
    return SliderClampRatio(ratio)
}

SliderRatio :: (value: float, minimum: float, maximum: float) -> float #export {
    span: float = maximum - minimum
    if span <= 0.0 { return 0.0 }
    return SliderClampRatio((value - minimum) / span)
}

SliderValue :: (minimum: float, maximum: float, ratio: float) -> float #export {
    span: float = maximum - minimum
    if span <= 0.0 { return minimum }
    return minimum + SliderClampRatio(ratio) * span
}

SliderKeyboardValue :: (value: float, minimum: float, maximum: float,
    direction: i32, home: bool, end: bool, alt: bool, shift: bool) -> SliderStep #export {
    result: SliderStep
    result.value = value
    result.changed = false
    span: float = maximum - minimum
    if span <= 0.0 { return result }
    next: float = value
    if home {
        next = minimum
    } else if end {
        next = maximum
    } else if direction != 0 {
        step: float = span * 0.01
        if alt { step = step * 0.1 }
        if shift { step = step * 10.0 }
        next = next + (float)direction * step
        if next < minimum { next = minimum }
        if next > maximum { next = maximum }
    }
    result.value = next
    result.changed = next != value
    return result
}

SliderDiscreteRatio :: (value: i32, minimum: i32, maximum: i32) -> float #export {
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return 0.0 }
    return SliderClampRatio((float)((i64)value - (i64)minimum) / (float)span)
}

SliderDiscreteValue :: (minimum: i32, maximum: i32, ratio: float) -> i32 #export {
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return minimum }
    return (i32)((i64)minimum + (i64)(SliderClampRatio(ratio) * (float)span + 0.5))
}

SliderDiscretePointerValue :: (pointer: float, origin: float, length: float,
    minimum: i32, maximum: i32, inverted: bool) -> i32 #export {
    return SliderDiscreteValue(minimum, maximum,
        SliderPointerRatio(pointer, origin, length, inverted))
}

SliderDiscreteKeyboardValue :: (value: i32, minimum: i32, maximum: i32,
    direction: i32, home: bool, end: bool, alt: bool, shift: bool) -> SliderDiscreteStep #export {
    result: SliderDiscreteStep
    result.value = value
    result.changed = false
    span: i64 = (i64)maximum - (i64)minimum
    if span <= 0 { return result }
    next: i64 = (i64)value
    if home {
        next = (i64)minimum
    } else if end {
        next = (i64)maximum
    } else if direction != 0 {
        step: i64 = 1
        if span > 100 { step = (span + 50) / 100 }
        if alt {
            step = step / 10
            if step < 1 { step = 1 }
        }
        if shift { step = step * 10 }
        next = next + (i64)direction * step
        if next < (i64)minimum { next = (i64)minimum }
        if next > (i64)maximum { next = (i64)maximum }
    }
    result.value = (i32)next
    result.changed = result.value != value
    return result
}

SliderPaintFor :: (spec: SliderSpec) -> SliderPaint #export {
    paint: SliderPaint
    scale: float = spec.scale
    if scale <= 0.0 { scale = 1.0 }
    ratio: float = SliderClampRatio(spec.ratio)
    bounds: Rectangle = spec.bounds
    min_length: float = (float)SliderMinimumLengthForStyle(spec.track, scale)
    thumb_size: float = (float)SliderThumbSizeForStyle(spec.thumb, scale)
    track_size: float = (float)SliderTrackSizeForStyle(spec.vertical,
        spec.track, scale)
    if spec.vertical {
        if bounds.height < min_length { bounds.height = min_length }
        if bounds.width < thumb_size { bounds.width = thumb_size }
        paint.track_bounds.x = bounds.x + (bounds.width - track_size) * 0.5
        paint.track_bounds.y = bounds.y
        paint.track_bounds.width = track_size
        paint.track_bounds.height = bounds.height
        position_y: float = paint.track_bounds.y + paint.track_bounds.height * (1.0 - ratio)
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = position_y
        paint.active_bounds.width = paint.track_bounds.width
        paint.active_bounds.height = paint.track_bounds.y + paint.track_bounds.height - position_y
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * 0.5
        paint.thumb_y = position_y
    } else {
        if bounds.width < min_length { bounds.width = min_length }
        if bounds.height < thumb_size { bounds.height = thumb_size }
        paint.track_bounds.x = bounds.x
        paint.track_bounds.y = bounds.y + (bounds.height - track_size) * 0.5
        paint.track_bounds.width = bounds.width
        paint.track_bounds.height = track_size
        paint.active_bounds.x = paint.track_bounds.x
        paint.active_bounds.y = paint.track_bounds.y
        paint.active_bounds.width = paint.track_bounds.width * ratio
        paint.active_bounds.height = paint.track_bounds.height
        paint.thumb_x = paint.track_bounds.x + paint.track_bounds.width * ratio
        paint.thumb_y = paint.track_bounds.y + paint.track_bounds.height * 0.5
    }
    paint.bounds = bounds
    paint.thumb_radius = thumb_size * 0.5
    paint.glow_radius = paint.thumb_radius +
        SliderGlowExpansionForStyle(spec.thumb, scale)
    paint.thumb_shadow_x = paint.thumb_x +
        SliderThumbShadowOffsetXForStyle(spec.thumb, scale)
    paint.thumb_shadow_y = paint.thumb_y +
        SliderThumbShadowOffsetYForStyle(spec.thumb, scale)
    paint.thumb_shadow_radius = paint.thumb_radius +
        SliderThumbShadowExpansionForStyle(spec.thumb, scale)
    paint.thumb_highlight_x = paint.thumb_x +
        SliderThumbHighlightOffsetXForStyle(spec.thumb, scale)
    paint.thumb_highlight_y = paint.thumb_y +
        SliderThumbHighlightOffsetYForStyle(spec.thumb, scale)
    paint.thumb_highlight_radius = paint.thumb_radius * 0.45

    paint.track = spec.track
    paint.active_track = spec.active_track
    paint.thumb = spec.thumb

    thumb_opacity: float = paint.thumb.value.opacity
    paint.thumb_fill_color = Opacity(paint.thumb.value.background, thumb_opacity)
    paint.thumb_edge_color = Opacity(paint.thumb.value.border, thumb_opacity)
    paint.thumb_shadow_color = Opacity(paint.thumb.value.focus,
        (spec.disabled ? 0.18 : 0.36) * thumb_opacity)
    paint.thumb_highlight_color = Opacity(paint.thumb.value.foreground,
        (spec.disabled ? 0.08 : 0.20) * thumb_opacity)
    paint.glow_color = Opacity(paint.thumb.value.focus,
        (spec.active ? 0.32 : (spec.hovered ? 0.18 : 0.0)) * thumb_opacity)
    return paint
}
