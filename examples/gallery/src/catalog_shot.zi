using UI :: #import "kryon/Widgets";
#import "catalog"
#import "palette"

shot_active: bool;
shot_scene: s32;
shot_dark: bool;

CatalogShotConfigure :: (scene: s32, dark: bool) {
    if scene < 0 || scene >= GallerySceneCount { scene = 0 }
    shot_scene = scene
    shot_dark = dark
    shot_active = true
}

CatalogShotActive :: () -> bool { return shot_active }

#program_export
CatalogShotFrame :: (session: Session, viewport: Rectangle) -> s32 {
    SetGalleryPreview(viewport, false, 0.0, true)
    InstallGalleryPalette(shot_dark)
    Box(session, BoxProps.{.key = 9100, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    ComposeGallery(session, shot_scene, false)
    return 0
}
