// Fixed-pitch text for grids, using Liberation Mono's natural outlines and
// advance. Missing symbols retain the ordinary pixmap font's fallback.
Pixels :: #import "pixmap";
Glyphs :: #import "pixmap_text";
Paint :: #import "paint_queue";
Sessions :: #import "session";
using Geometry :: #import "geometry";
using Drawing :: #import "drawing_props";

TextCellWidth :: (font: s32) -> s32 { return Glyphs.PixmapCellWidth(font) }

// Bounds, clip and font are already in device pixels. Both Unicode cells and
// printable runs use this mask path, including narrow-cell resampling.
RasterCellGlyph :: (glyph: s32, bounds: Rectangle, font: s32,
    color: Color, advance: s32) {
    baseline := cast(s64)bounds.y * 256 + Glyphs.PixmapCellBaseline(glyph, font)
    mask: Glyphs.PixmapGlyphMask
    origin := cast(s32)bounds.x + (cast(s32)bounds.width - advance) / 2
    coverage := Glyphs.PixmapCachedGlyph(glyph, cast(s64)origin * 256, baseline, font, *mask)
    if mask.width <= 0 || mask.height <= 0 || coverage.count == 0 { return }
    width := mask.width
    if width > cast(s32)bounds.width - 1 { width = cast(s32)bounds.width - 1 }
    // Natural-width glyphs need no horizontal resampling.
    if width == mask.width { Pixels.PixmapBlendMask(mask, coverage, color); return }
    left := cast(s32)bounds.x + (cast(s32)bounds.width - width) / 2
    for row: 0..mask.height - 1 {
        y := mask.top + row
        if y < Pixels.pixmap_clip_top || y >= Pixels.pixmap_clip_bottom { continue }
        for column: 0..width - 1 {
            x := left + column
            if x < Pixels.pixmap_clip_left || x >= Pixels.pixmap_clip_right { continue }
            start := column * mask.width / width
            end := (column + 1) * mask.width / width
            sum: s32
            for source: start..end - 1 { sum += cast(s32)coverage[row * mask.width + source] }
            Pixels.PixmapBlend(x, y, color, sum / (end - start))
        }
    }
}

RasterTextCell :: (value: string, bounds: Rectangle, font: s32,
    color: Color, clip: Rectangle) {
    if font <= 0 || bounds.width <= 1.0 || bounds.height <= 0.0 { return }
    bounds = Pixels.PixmapDeviceBounds(bounds); clip = Pixels.PixmapDeviceBounds(clip)
    font = Pixels.PixmapDeviceFont(font)
    Pixels.PixmapClipPixels(RectangleIntersection(bounds, clip))
    at: s32
    while at < cast(s32)value.count {
        unit := Glyphs.PixmapNextUnit(value, at)
        if unit.after <= at { break }; at = unit.after
        if unit.emoji >= 0 {
            size := font
            if size > cast(s32)bounds.width - 1 { size = cast(s32)bounds.width - 1 }
            Pixels.PixmapDrawEmoji(unit.emoji, cast(s32)bounds.x + (cast(s32)bounds.width - size) / 2,
                cast(s32)bounds.y, size)
            continue
        }
        if unit.glyph < 0 { continue }
        glyph := Glyphs.PixmapCellGlyph(unit.glyph)
        RasterCellGlyph(glyph, bounds, font, color, TextCellWidth(font))
    }
    Pixels.PixmapClipAll()
}

EmitTextCell :: (command: Paint.PaintCommand) {
    RasterTextCell(command.value, command.bounds, command.font, command.color, command.clip)
}

PaintTextCell :: (session: Sessions.Session, node: s32, value: string,
    bounds: Rectangle, font: s32, color: Color, clip: Rectangle) {
    command: Paint.QueuedPaint
    command.data.kind = cast(s32)Paint.PaintKind.PaintKindClippedText
    command.data.node = node; command.data.value = value
    command.data.bounds = bounds; command.data.font = font
    command.data.color = color; command.data.clip = clip
    command.emit = EmitTextCell; command.clip_for = Paint.ClipLabel
    command.has_emitter = true; command.clips = true
    Paint.SubmitPaint(session, command)
}

// One printable ASCII byte per fixed-pitch cell. The row origin and first
// column retain the same coordinate calculation as separate cell commands,
// including fractional density. Wider and combining glyphs use TextCell.
CellRunValid :: (value: string, first: s32, cell_width: s32, font: s32) -> bool {
    if value.count < 1 || value.count > 2147483647 || first < 0 || cell_width < 1 || font < 1 { return false }
    // Validate the complete grid in wide arithmetic before indexing or
    // multiplying in the renderer's signed pixel coordinate type.
    if (cast(s64)first + value.count) * cast(s64)cell_width > 2147483647 { return false }
    for at: 0..cast(s32)value.count - 1 {
        if value[at] < cast(u8)32 || value[at] > cast(u8)126 { return false }
    }
    return true
}

RasterTextCells :: (value: string, row: Rectangle, first: s32,
    cell_width: s32, font: s32, color: Color, clip: Rectangle) {
    if !CellRunValid(value, first, cell_width, font) { return }
    if cell_width <= 1 || row.height <= 0.0 { return }
    device_font := Pixels.PixmapDeviceFont(font)
    device_clip := Pixels.PixmapDeviceBounds(clip)
    advance: s32
    // Lookup once for each distinct ASCII byte in this run. Coverage remains
    // borrowed for only one glyph, so cache eviction cannot stale a mask.
    glyphs: [95]s32
    found: [95]bool
    clipped: bool
    for at: 0..cast(s32)value.count - 1 {
        byte := value[at]
        if byte == cast(u8)32 { continue }
        if !clipped { advance = TextCellWidth(device_font); clipped = true }
        index := cast(s32)byte - 32
        if !found[index] {
            glyphs[index] = Glyphs.PixmapCellGlyph(Glyphs.PixmapGlyphFor(cast(u32)byte))
            found[index] = true
        }
        glyph := glyphs[index]
        if glyph < 0 { continue }
        cell := row
        cell.x = row.x + cast(float32)((first + at) * cell_width)
        cell.width = cast(float32)cell_width
        // Preserve each original logical-to-device conversion, including
        // fractional origins and densities; do not round a row once and step.
        cell = Pixels.PixmapDeviceBounds(cell)
        Pixels.PixmapClipPixels(RectangleIntersection(cell, device_clip))
        RasterCellGlyph(glyph, cell, device_font, color, advance)
    }
    if clipped { Pixels.PixmapClipAll() }
}

EmitTextCells :: (command: Paint.PaintCommand) {
    RasterTextCells(command.value, command.bounds,
        cast(s32)command.source.x, cast(s32)command.source.width,
        command.font, command.color, command.clip)
}

PaintTextCells :: (session: Sessions.Session, node: s32, value: string,
    row: Rectangle, first: s32, cell_width: s32, font: s32,
    color: Color, clip: Rectangle) {
    if !CellRunValid(value, first, cell_width, font) { return }
    // The untranslated source rectangle carries the grid. If its float
    // fields cannot represent an integer exactly, retain separate cells.
    if cast(s64)cast(float32)first != cast(s64)first ||
        cast(s64)cast(float32)cell_width != cast(s64)cell_width {
        for at: 0..cast(s32)value.count - 1 {
            cell := row; cell.x += cast(float32)((first + at) * cell_width)
            cell.width = cast(float32)cell_width
            PaintTextCell(session, node, value[at:at + 1], cell, font, color, clip)
        }
        return
    }
    command: Paint.QueuedPaint
    command.data.kind = cast(s32)Paint.PaintKind.PaintKindClippedText
    command.data.node = node; command.data.value = value
    command.data.bounds = row
    right := row.x + cast(float32)((first + cast(s32)value.count - 1) * cell_width) + cast(float32)cell_width
    // Include the empty prefix in coverage so bounds retain the row origin
    // through ordinary tree translation. Source describes the fixed grid;
    // unlike world-space x/y fields it is never translated by the paint queue.
    command.data.bounds.width = right - row.x
    command.data.source.x = cast(float32)first
    command.data.source.width = cast(float32)cell_width
    command.data.font = font; command.data.color = color; command.data.clip = clip
    command.emit = EmitTextCells; command.clip_for = Paint.ClipLabel
    command.has_emitter = true; command.clips = true
    Paint.SubmitPaint(session, command)
}
