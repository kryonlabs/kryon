#import, file "../src/backend/android_surface.zi";

PolicyCheck :: () -> s32 {
    insets: AndroidWindowInsets = .{.system_left = -1, .system_top = 53, .system_right = 84,
        .system_bottom = 24, .ime_bottom = 120, .cutout_left = 4, .cutout_top = 60,
        .cutout_right = 80, .cutout_bottom = 8}
    viewport := ResolveViewport(320, 560, insets,
        AndroidViewportPolicySafeArea(), 1)
    if viewport.x != 4 || viewport.y != 60 || viewport.width != 232 ||
        viewport.height != 476 || viewport.insets.bottom != 24 || viewport.ready != 1 {
        return 1
    }
    viewport = ResolveViewport(320, 560, insets,
        AndroidViewportPolicy.{}, 1)
    if viewport.x != 0 || viewport.y != 0 || viewport.width != 320 ||
        viewport.height != 560 || viewport.insets.bottom != 0 {
        return 2
    }
    viewport = ResolveViewport(320, 560, insets,
        AndroidViewportPolicyResizeForIme(), 1)
    if viewport.insets.bottom != 120 || viewport.height != 380 {
        return 3
    }
    // Back from the floating window, the surface keeps the shadow's margin
    // around the frame; the insets stay relative to the frame.
    margin := SurfaceMargin(356, 596, 320, 560)
    if margin.left != 18 || margin.top != 18 || margin.right != 18 ||
        margin.bottom != 18 {
        return 6
    }
    viewport = ResolveViewport(356, 596, insets,
        AndroidViewportPolicySafeArea(), 1, margin)
    if viewport.x != 22 || viewport.y != 78 || viewport.width != 232 ||
        viewport.height != 476 {
        return 7
    }
    viewport = ResolveViewport(356, 596, insets,
        AndroidViewportPolicy.{}, 1, margin)
    if viewport.x != 18 || viewport.y != 18 || viewport.width != 320 ||
        viewport.height != 560 {
        return 8
    }
    // A resize in flight is not a margin: unequal, odd, unknown or smaller.
    if SurfaceMargin(356, 600, 320, 560).left != 0 ||
        SurfaceMargin(321, 561, 320, 560).left != 0 ||
        SurfaceMargin(356, 596, 0, 0).left != 0 ||
        SurfaceMargin(277, 337, 720, 1560).left != 0 {
        return 9
    }
    // A camera taller than the status bar pushes the top down, and a sideways
    // cutout with the navigation bar does the same for each side in landscape.
    camera: AndroidWindowInsets = .{.system_top = 53, .system_bottom = 84, .cutout_top = 70}
    viewport = ResolveViewport(720, 1560, camera, GetAndroidViewportPolicy(), 1)
    if viewport.x != 0 || viewport.y != 70 || viewport.width != 720 ||
        viewport.height != 1406 || viewport.insets.bottom != 84 {
        return 10
    }
    camera = .{.system_top = 53, .system_right = 84, .cutout_left = 70}
    viewport = ResolveViewport(1560, 720, camera, GetAndroidViewportPolicy(), 1)
    if viewport.x != 70 || viewport.y != 53 || viewport.width != 1406 ||
        viewport.height != 667 || viewport.insets.right != 84 {
        return 11
    }
    policy := AndroidViewportPolicySafeArea()
    policy.min_width = 260
    viewport = ResolveViewport(320, 560, insets, policy, 1)
    if viewport.x != 0 || viewport.width != 320 {
        return 4
    }
    insets.system_left = 2147483647
    insets.system_right = 2147483647
    viewport = ResolveViewport(320, 560, insets, policy, 0)
    if viewport.x != 0 || viewport.width != 320 || viewport.ready != 0 {
        return 5
    }
    return 42
}

#if !#defined(ANDROID_BUILD) {
    #program_export
    main :: () -> s32 {
        if PolicyCheck() != 42 {
            return 1
        }
        return 0
    }
}
