#import "session"
#import "geometry"
#import "navigation_bar"
#import "navigation_bar_props"
#import "navigation_bar_widget"
#import "control_props"
#import "style"
#import "style_sheet"
#import "tree"
#import "tree_input"
#import "paint_queue"
#import "widget_kind"
#import "ziran_navigation_bar_widget_host"

using StyleField;
using ButtonState;
using ButtonTone;
using ButtonEmphasis;
using PaintKind;
using WidgetKind;

#program_export
DockImageWidth :: (path: string) -> s32 { unused path; return 24 }

#program_export
DockImageHeight :: (path: string) -> s32 { unused path; return 24 }

#program_export
DockMeasureWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    return cast(s32)value.count * font / 2
}

#program_export
DockMeasureHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    return font
}

#program_export
main :: () -> s32 {
    bounds := Rectangle.{0.0, 0.0, 88.0, 476.0}
    layout := NavigationBarDockLayoutFor(bounds, true, 7, 2, 1.0)
    if layout.primary_count != 5 || layout.footer_bounds.y != 296.0 ||
    layout.scroll_bounds.y != 24.0 || layout.scroll_bounds.height != 264.0 {
        return 1
    }
    if NavigationBarDockDropIndex(layout, layout.scroll_bounds,
        Vector2.{44.0, 130.0}) != 1 ||
    NavigationBarDockDropIndex(layout, layout.scroll_bounds,
        Vector2.{44.0, 330.0}) != -1 { return 2 }
    dock := NavigationBarDockLayoutFor(Rectangle.{0.0, 700.0, 390.0, 84.0},
        false, 6, 1, 1.0)
    if dock.footer_bounds.x != 278.0 || dock.scroll_bounds.width != 266.0 ||
    dock.content_extent != 452 { return 3 }
    empty := NavigationBarDockLayoutFor(bounds, true, 2, 2, 1.0)
    if empty.primary_count != 0 || empty.footer_bounds.y != layout.footer_bounds.y {
        return 4
    }
    for count: cast(s32)3..cast(s32)6 {
        narrow := NavigationBarDockLayoutFor(Rectangle.{0.0, 0.0, 156.0, 84.0},
            false, count, 1, 1.0)
        if narrow.item_width < 76 || narrow.scroll_bounds.width <
        cast(float32)narrow.item_width || narrow.footer_bounds.width < 52.0 {
            return 12
        }
        offset := NavigationBarDockRevealOffset(narrow, count - 2, 0)
        selected := NavigationBarDockItemBounds(narrow,
            narrow.scroll_bounds, count - 2)
        if selected.x - cast(float32)offset < narrow.scroll_bounds.x ||
        selected.x + selected.width - cast(float32)offset >
        narrow.scroll_bounds.x + narrow.scroll_bounds.width { return 13 }
    }
    rules: StyleRules
    rules.count = 3
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.selector.kind = StyleKindNavigationBar()
    rule.style.fields = cast(u32)StyleBackground
    rule.style.background = cast(u32)0x14202bff
    rules.items[0] = rule
    rule.selector.kind = StyleKindNavigationBarItem()
    rule.style.fields = cast(u32)StyleForeground | cast(u32)StyleFontSize
    rule.style.foreground = cast(u32)0xe6eff3ff
    rule.style.font_size = 12.0
    rules.items[1] = rule
    // Selection remains a styling fact while a pointer hovers over the item.
    rule.selector.tone = cast(s32)ButtonToneAccent
    rule.selector.emphasis = cast(s32)ButtonEmphasisFilled
    rule.style.foreground = cast(u32)0x102030ff
    rules.items[2] = rule
    InstallStyleRules(rules)
    session := SessionOpen()
    props: NavigationBarProps
    props.key = cast(u64)10
    props.compact = true
    props.vertical = true
    props.bounds = bounds
    props.footer_count = 2
    props.draggable = true
    items: [7]NavigationBarItem
    for index: cast(s32)0..cast(s32)6 {
        items[index].key = cast(u64)(100 + index)
        items[index].route = index
        items[index].label = "App"
    }
    items[5].label = "Apps"
    items[5].active = true
    items[6].label = "Profile"
    for phase: cast(s32)0..cast(s32)2 {
        if phase == 1 { props.scroll_offset = 999 }
        if phase == 2 { items[5].disabled = true }
        TreeStart(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 476.0})
        result := NavigationBar(session, props, items[:])
        if !TreeFinish(session) || result.node != 1 { return 5 }
        apps: s32 = -1
        profile: s32 = -1
        for index: cast(s32)0..TreeCount(session) - 1 {
            node := TreeNodeAt(session, index)
            if node.semantic_label == "Apps" { apps = index }
            if node.semantic_label == "Profile" { profile = index }
        }
        if apps < 0 || profile < 0 ||
        TreeNodeAt(session, apps).bounds.y != 296.0 ||
        TreeNodeAt(session, profile).bounds.y != 380.0 { return 6 }
        if phase < 2 {
            selected_label := false
            for index: cast(s32)0..PendingPaintCount(session) - 1 {
                paint := PendingPaintAt(session, index)
                if paint.node == apps && paint.kind == PaintKindClippedText {
                    if paint.color.r != 0x10 || paint.color.g != 0x20 ||
                    paint.color.b != 0x30 { return 10 }
                    selected_label = true
                }
            }
            if !selected_label { return 11 }
        }
        if phase == 0 {
            if result.clicked_route != -1 { return 7 }
            TreePointerUpdate(session, PointerFrame.{44.0, 330.0, true, true, false})
            TreePointerUpdate(session, PointerFrame.{44.0, 330.0, false, false, true})
        } else if phase == 1 {
            if result.clicked_route != 5 || result.scroll_offset != 148 { return 8 }
        } else {
            if result.clicked_route != -1 || TreeHitAt(session, 44.0, 330.0) != -1 {
                return 9
            }
        }
        PaintClear(session)
    }
    // Selection and resize reveal a full shortcut; a later manual scroll is
    // preserved until the active route or viewport changes again.
    props.vertical = false
    props.bounds = Rectangle.{0.0, 0.0, 156.0, 84.0}
    props.footer_count = 1
    props.draggable = false
    props.scroll_offset = 0
    items[5].disabled = false
    items[5].active = false
    items[2].active = true
    TreePointerUpdate(session, PointerFrame.{390.0, 290.0, false, false, false})
    for phase: cast(s32)0..cast(s32)3 {
        if phase == 1 {
            items[2].active = false
            items[0].active = true
        }
        if phase == 2 { props.scroll_offset = 60 }
        if phase == 3 { props.bounds.width = 164.0 }
        TreeStart(session, cast(u64)1, Rectangle.{0.0, 0.0, 400.0, 476.0})
        result := NavigationBar(session, props, items[0:6])
        if !TreeFinish(session) { return 14 }
        expected: s32 = 0
        if phase == 0 { expected = 176 }
        if phase == 2 { expected = 60 }
        if result.scroll_offset != expected { return 15 }
        props.scroll_offset = result.scroll_offset
        PaintClear(session)
    }
    // Every fitted shortcut and footer is visible, clickable, and painted
    // without a scrolling container at narrow widths and enlarged scales.
    props.fit_items = true
    props.scroll_offset = 999
    items[0].label = "Practices"
    items[0].icon_shape = "M4 4L20 20"
    items[5].active = true
    for scenario: cast(s32)0..cast(s32)5 {
        props.vertical = scenario >= 4
        props.scale = 1.0
        props.bounds = Rectangle.{0.0, 0.0, 390.0, 84.0}
        if scenario == 1 {
            props.bounds.width = 320.0
        }
        if scenario == 2 {
            props.bounds.width = 156.0
        }
        if scenario == 3 {
            props.bounds.width = 320.0
            props.bounds.height = 210.0
            props.scale = 2.5
        }
        if props.vertical {
            props.bounds = Rectangle.{0.0, 0.0, 88.0, 476.0}
        }
        if scenario == 5 {
            props.bounds.height = 280.0
        }
        fitted := NavigationBarDockFitLayoutFor(props.bounds, props.vertical,
            6, 1, props.scale)
        extent := fitted.scroll_bounds.width
        if props.vertical {
            extent = fitted.scroll_bounds.height
        }
        if cast(float32)fitted.content_extent > extent {
            return 16
        }
        for phase: cast(s32)0..cast(s32)6 {
            TreeStart(session, cast(u64)1, props.bounds)
            result := NavigationBar(session, props, items[0:6])
            if !TreeFinish(session) || result.scroll_offset != 0 {
                return 17
            }
            if phase > 0 && result.clicked_route != phase - 1 {
                return 18
            }
            buttons: s32 = 0
            for index: cast(s32)0..TreeCount(session) - 1 {
                node := TreeNodeAt(session, index)
                if node.kind == WidgetKindScroll {
                    return 19
                }
                if node.kind == WidgetKindButton {
                    tile := node.bounds
                    if tile.x < props.bounds.x || tile.y < props.bounds.y ||
                    tile.x + tile.width > props.bounds.x + props.bounds.width ||
                    tile.y + tile.height > props.bounds.y + props.bounds.height ||
                    TreeHitAt(session, tile.x + tile.width / 2.0,
                        tile.y + tile.height / 2.0) != index {
                        return 20
                    }
                    for paint_index: cast(s32)0..PendingPaintCount(session) - 1 {
                        paint := PendingPaintAt(session, paint_index)
                        if paint.node == index && paint.kind == PaintKindClippedText {
                            if cast(float32)DockMeasureWidth(paint.value, paint.font, "") > tile.width {
                                return 21
                            }
                        }
                    }
                    if buttons == phase {
                        x := tile.x + tile.width / 2.0
                        y := tile.y + tile.height / 2.0
                        TreePointerUpdate(session, PointerFrame.{x, y, true, true, false})
                        TreePointerUpdate(session, PointerFrame.{x, y, false, false, true})
                    }
                    buttons += 1
                }
            }
            if buttons != 6 {
                return 22
            }
            PaintClear(session)
        }
    }
    return 0
}
