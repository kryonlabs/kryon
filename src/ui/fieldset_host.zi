#module "fieldset_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/fieldset.h"
#import "ui/paint_command.h"

RenderFieldset :: (frame: FieldsetProps) #export {
    title: const char* = frame.title
    if title == nil { title = "" }
    style: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, frame.class_name,
    StyleKindFieldset(), StyleAny())
    font: i32 = ResolveFont(0, StyleFontValue(style.value.fields,
    style.value.font_size), GetSmallFontSize())
    title_width: i32 = 0
    if title[0] != 0 { title_width = TextWidth(title, font) }
    paint: FieldsetPaint = FieldsetPaintFor(frame.bounds,
    (float)title_width, title[0] != 0,
    (float)Scale(1000) / 1000.0, style)

    DrawWidgetFrame(paint.frame, (Rectangle){0},
    paint.face, 0, 0, 0, 0)
    if paint.show_title {
        DrawRectangleRec(paint.title_background,
        GetColor(paint.background_color))
        RenderText(title, (int)paint.title_text.x,
        (int)paint.title_text.y, font,
        GetColor(Opacity(paint.text_color, style.value.opacity)))
    }
}
