using UI :: #import "kryon/Widgets";
#import "kryon/system_theme"
#import "std/number_text"
using Example :: #import "scenes";
#import "palette"
#import "preview_protocol"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = "ContextMenu", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 24
    scene_image = "catalog-image.png"
    input := Prepare(session, scene)
    field_input := input.field
    area_input := input.area
    items: [3]ContextMenuItem
    items[0].label = "Open"; items[0].id = 1; items[1].label = "Rename"; items[1].id = 2; items[2].label = "Remove"; items[2].id = 3; items[2].disabled = disabled
    if dismissed {
        if Button(session, ButtonProps.{.bounds = b, .label = "Open context menu"}) == 1 { dismissed = false }
    } else {
        result := ContextMenu(session, ContextMenuProps.{.open = true, .x = 24.0, .y = 64.0}, items[:])
        if result.closed { dismissed = true }
        if result.activated_id > 0 { clicks += 1 }
    }

    return 0
}
