#import "reorder"

// Laws for reordering a list by dragging. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A release captures the pointer and commits exactly when a drag was in
// progress; the active drag ends either way.
#law ReleaseRule forall released: 0..1, dragging: 0..1 => ReorderReleaseFor(B(released), B(dragging)).capture_input == B(released) && ReorderReleaseFor(B(released), B(dragging)).commit == (B(released) && B(dragging)) && ReorderReleaseFor(B(released), B(dragging)).cancel_active;

// Another list's drag makes this list ignore the pointer, and is cancelled
// once the pointer is up; the list that owns the drag is never ignored.
#law ForeignIgnored forall down: 0..1 => ReorderForeignActiveListFor(true, 2, 5, B(down)).ignore_list && ReorderForeignActiveListFor(true, 2, 5, B(down)).cancel_active == !B(down);
#law OwnListKept forall down: 0..1 => !ReorderForeignActiveListFor(true, 5, 5, B(down)).ignore_list && !ReorderForeignActiveListFor(true, 5, 5, B(down)).cancel_active;
#law NoDragNothingIgnored forall other: 0..6, down: 0..1 => !ReorderForeignActiveListFor(false, other, 5, B(down)).ignore_list;

// A drag of an item that is gone or disabled is cancelled.
#law GoneItemCancels forall index: -2..6, count: 0..4 => (index >= 0 && index < count) || ReorderActiveItemLifecycleFor(index, count, true, false).cancel_active;
#law DisabledItemCancels forall index: 0..3 => ReorderActiveItemLifecycleFor(index, 4, true, true).cancel_active;
#law LiveItemContinues forall index: 0..3 => !ReorderActiveItemLifecycleFor(index, 4, true, false).cancel_active;

// A press starts a reorder only in a real list with items, inside it, when
// nothing else holds the pointer.
#law PressRule forall list: 0..1, items: 0..1, count: 0..2, pressed: 0..1, captured: 0..1, free: 0..1, inside: 0..1 => ReorderPressFor(list, B(items), count, B(pressed), B(captured), B(free), B(inside)).can_press == (list != 0 && B(items) && count > 0 && B(pressed) && !B(captured) && B(free) && B(inside));
