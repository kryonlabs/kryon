App :: #import "kryon/app";
ListBox :: #import "kryon/list_box";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"

choice: s32;
selected: [3]bool;

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "List box", .size = 28})
    items := ListBox.ListBoxItem.[.{.label = "Morning walk"}, .{.label = "Read a chapter"}, .{.label = "Make something"}]
    choice = ListBox.Draw(session, ListBox.Props.{.disabled = example_disabled, .bounds = .{height = 100}, .row_height = 32, .selected_index = choice}, items[:]).selected_index
    ListBox.ListBoxMulti(session, ListBox.ListBoxMultiProps.{.disabled = example_disabled, .bounds = .{height = 100}, .row_height = 32}, items[:], selected[:])
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "listbox"}, Frame) }
