#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style"
#import "style_sheet"

using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ButtonState;
using StyleField;

ScrollMetrics :: struct {
    scrollbar_width: s32
    reserved_width: s32
    safe_gap: s32
    default_wheel_step: s32
    drag_threshold: s32
    visual_bleed: s32
    thumb_min_height: s32
    thumb_inset: s32
}

ScrollPolicyView :: struct {
    content_x: s32
    content_y: s32
    content_w: s32
    viewport_h: s32
    content_h: s32
    max_scroll: s32
    scrollbar_x: s32
}

ScrollBarPaint :: struct {
    track_bounds: Rectangle
    thumb_bounds: Rectangle
    track_span: s32
    scroll_per_pixel: float32
}

ScrollBarDragDecision :: struct {
    start_drag: bool
    continue_drag: bool
    cancel_drag: bool
    claim_scroll_owner: bool
    scroll_offset: s32
}

ScrollBarDragReleaseDecision :: struct {
    clear_drag: bool
    consume_release: bool
}

ScrollContentDragDecision :: struct {
    start_drag: bool
    active: bool
    dragging: bool
    gesture_pending: bool
    claim_scroll_owner: bool
    capture_input: bool
    scroll_offset: s32
}

ScrollClipGeometry :: struct {
    screen_bounds: Rectangle
    clipped_world_bounds: Rectangle
    visual_screen_bounds: Rectangle
    visual_bleed: s32
}

ScrollMetric :: (fields: u32, field: u32, value: float32, fallback: float32,
scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) != cast(u32)0 && value >= 0.0 {
        return cast(s32)(value * scale)
    }
    return cast(s32)(fallback * scale)
}

#program_export
ScrollMetricsFor :: (scale: float32, track: StyleFrame, thumb: StyleFrame) -> ScrollMetrics {
    if scale <= 0.0 { scale = 1.0 }
    metrics: ScrollMetrics
    metrics.scrollbar_width = ScrollMetric(track.value.fields,
    cast(u32)StyleIconSize, track.value.icon_size, 10.0, scale)
    metrics.reserved_width = ScrollMetric(track.value.fields,
    cast(u32)StylePaddingX, track.value.padding_x, 16.0, scale)
    metrics.safe_gap = ScrollMetric(track.value.fields,
    cast(u32)StyleGap, track.value.gap, 20.0, scale)
    metrics.default_wheel_step = ScrollMetric(track.value.fields,
    cast(u32)StyleContentOffset, track.value.offset_y, 42.0, scale)
    metrics.drag_threshold = ScrollMetric(track.value.fields,
    cast(u32)StyleContentOffset, track.value.offset_x, 5.0, scale)
    metrics.visual_bleed = ScrollMetric(track.value.fields,
    cast(u32)StylePaddingY, track.value.padding_y, 8.0, scale)
    metrics.thumb_min_height = ScrollMetric(thumb.value.fields,
    cast(u32)StyleIconSize, thumb.value.icon_size, 16.0, scale)
    metrics.thumb_inset = ScrollMetric(thumb.value.fields,
    cast(u32)StylePaddingX, thumb.value.padding_x, 2.0, scale)
    return metrics
}

#program_export
ScrollFace :: (kind: s32, class_name: s32, disabled: bool,
    state: s32, track_width: float32) -> StyleFrame {
    if track_width <= 0.0 { track_width = 10.0 }
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleRadius |
        cast(u32)StyleOpacity | cast(u32)StyleIconSize | cast(u32)StylePaddingX
    face.background = cast(u32)0xe5e7ebff
    face.radius = 4.0
    face.opacity = 1.0
    face.icon_size = track_width
    face.padding_x = 2.0
    if kind == StyleKindScrollThumb() {
        face.background = cast(u32)0x9ca3afff
        face.icon_size = 16.0
    }
    if disabled { state = cast(s32)ButtonStateDisabled }
    facts: StyleFacts = StyleControlRoleFacts(kind, 0,
        class_name, StyleAny(), cast(s32)ButtonToneNeutral,
        cast(s32)ButtonEmphasisFilled, cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(), face, facts, state)
    return frame
}

#program_export
ScrollClamp :: (value: s32, maximum: s32) -> s32 {
    if value < 0 { return 0 }
    if value > maximum { return maximum }
    return value
}

#program_export
ScrollMax :: (content_height: s32, viewport_height: s32) -> s32 {
    maximum: s32 = content_height - viewport_height
    if maximum < 0 { maximum = 0 }
    return maximum
}

#program_export
ScrollReservedWidth :: (max_scroll: s32, metrics: ScrollMetrics) -> s32 {
    if max_scroll > 0 { return metrics.reserved_width }
    return 0
}

#program_export
ScrollContentWidth :: (content_width: s32, max_scroll: s32,
metrics: ScrollMetrics) -> s32 {
    reserved: s32 = ScrollReservedWidth(max_scroll, metrics)
    if reserved <= 0 { return content_width }
    if content_width <= reserved { return 0 }
    return content_width - reserved
}

#program_export
ScrollPageContentWidthFor :: (view_width: s32, max_content_width: s32,
min_content_width: s32, side_padding: s32) -> s32 {
    if max_content_width <= 0 { max_content_width = view_width }
    available: s32 = view_width - side_padding * 2
    if max_content_width > available { max_content_width = available }
    if min_content_width > 0 && max_content_width < min_content_width {
        max_content_width = min_content_width
    }
    if max_content_width < 0 { max_content_width = 0 }
    return max_content_width
}

#program_export
ScrollSafeContentWidth :: (content_x: s32, content_width: s32,
scrollbar_x: s32, max_scroll: s32, metrics: ScrollMetrics) -> s32 {
    safe_width: s32 = content_width
    if max_scroll <= 0 || scrollbar_x <= 0 { return content_width }
    safe_width = scrollbar_x - content_x - metrics.safe_gap
    if safe_width > content_width { return content_width }
    if safe_width < 0 { return 0 }
    return safe_width
}

#program_export
ScrollContentBounds :: (bounds: Rectangle, has_scroll: bool,
metrics: ScrollMetrics) -> Rectangle {
    content: Rectangle = bounds
    if has_scroll {
        content.width = bounds.width - cast(float32)metrics.scrollbar_width
        if content.width < 0.0 { content.width = 0.0 }
    }
    return content
}

#program_export
ScrollScreenBoundsFor :: (bounds: Rectangle, camera_offset: Vector2,
zoom: float32) -> Rectangle {
    if zoom <= 0.0 { zoom = 1.0 }
    screen: Rectangle
    screen.x = camera_offset.x + bounds.x * zoom
    screen.y = camera_offset.y + bounds.y * zoom
    screen.width = bounds.width * zoom
    screen.height = bounds.height * zoom
    return screen
}

#program_export
ScrollWorldBoundsFor :: (screen_bounds: Rectangle, camera_offset: Vector2,
zoom: float32) -> Rectangle {
    if zoom <= 0.0 { zoom = 1.0 }
    world: Rectangle
    world.x = (screen_bounds.x - camera_offset.x) / zoom
    world.y = (screen_bounds.y - camera_offset.y) / zoom
    world.width = screen_bounds.width / zoom
    world.height = screen_bounds.height / zoom
    return world
}

#program_export
ScrollVisualBoundsFor :: (screen_bounds: Rectangle, visual_bleed: s32,
zoom: float32, screen_width: s32, screen_height: s32, view_width: s32,
view_height: s32, camera_offset: Vector2) -> Rectangle {
    if zoom <= 0.0 { zoom = 1.0 }
    bleed: s32 = cast(s32)(cast(float32)visual_bleed * zoom)
    if bleed < 1 { bleed = 1 }

    visual: Rectangle
    visual.x = screen_bounds.x - cast(float32)bleed
    visual.y = screen_bounds.y - cast(float32)bleed
    visual.width = screen_bounds.width + cast(float32)(bleed * 2)
    visual.height = screen_bounds.height + cast(float32)(bleed * 2)

    if visual.x < 0.0 {
        visual.width += visual.x
        visual.x = 0.0
    }
    if visual.y < 0.0 {
        visual.height += visual.y
        visual.y = 0.0
    }

    if screen_width <= 0 {
        screen_width = cast(s32)(camera_offset.x + cast(float32)view_width * zoom)
    }
    if screen_height <= 0 {
        screen_height = cast(s32)(camera_offset.y + cast(float32)view_height * zoom)
    }
    if visual.x + visual.width > cast(float32)screen_width {
        visual.width = cast(float32)screen_width - visual.x
    }
    if visual.y + visual.height > cast(float32)screen_height {
        visual.height = cast(float32)screen_height - visual.y
    }
    if visual.width < 0.0 { visual.width = 0.0 }
    if visual.height < 0.0 { visual.height = 0.0 }
    return visual
}

#program_export
ScrollClipGeometryFor :: (bounds: Rectangle, clipped_screen_bounds: Rectangle,
visual_bleed: s32, camera_offset: Vector2, zoom: float32, screen_width: s32,
screen_height: s32, view_width: s32, view_height: s32) -> ScrollClipGeometry {
    if zoom <= 0.0 { zoom = 1.0 }
    geometry: ScrollClipGeometry
    geometry.screen_bounds = ScrollScreenBoundsFor(bounds, camera_offset, zoom)
    geometry.clipped_world_bounds = ScrollWorldBoundsFor(clipped_screen_bounds,
    camera_offset, zoom)
    geometry.visual_screen_bounds = ScrollVisualBoundsFor(geometry.screen_bounds,
    visual_bleed, zoom, screen_width, screen_height, view_width,
    view_height, camera_offset)
    geometry.visual_bleed = cast(s32)(cast(float32)visual_bleed * zoom)
    if geometry.visual_bleed < 1 { geometry.visual_bleed = 1 }
    return geometry
}

#program_export
ScrollWheelOffsetFor :: (scroll_offset: s32, wheel_move: float32,
max_scroll: s32, wheel_step: s32) -> s32 {
    delta: s32 = cast(s32)(wheel_move * cast(float32)wheel_step)
    return ScrollClamp(scroll_offset - delta, max_scroll)
}

#program_export
ScrollRowWheelStepFor :: (row_height: s32, scale: float32) -> s32 {
    if row_height > 0 { return row_height * 3 }
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(90.0 * scale)
}

#program_export
ScrollDragOffsetFor :: (mouse_y: float32, track_y: float32, grab_y: float32,
max_scroll: s32, paint: ScrollBarPaint) -> s32 {
    if paint.scroll_per_pixel <= 0.0 {
        return ScrollClamp(0, max_scroll)
    }
    offset: s32 = cast(s32)((mouse_y - track_y - grab_y) * paint.scroll_per_pixel)
    return ScrollClamp(offset, max_scroll)
}

#program_export
ScrollDragDeltaOffsetFor :: (start_scroll: s32, delta_y: s32,
max_scroll: s32) -> s32 {
    return ScrollClamp(start_scroll - delta_y, max_scroll)
}

#program_export
ScrollThumbDragDeltaOffsetFor :: (start_scroll: s32, delta_y: s32,
max_scroll: s32, paint: ScrollBarPaint) -> s32 {
    offset: s32 = start_scroll
    if paint.scroll_per_pixel > 0.0 {
        offset += cast(s32)(cast(float32)delta_y * paint.scroll_per_pixel)
    }
    return ScrollClamp(offset, max_scroll)
}

#program_export
ScrollBarDragFor :: (mouse_down: bool, input_captured: bool,
thumb_active: bool, pointer_owner_none: bool, drag_active: bool,
owns_drag: bool, current_scroll: s32, start_scroll: s32,
delta_y: s32, max_scroll: s32,
paint: ScrollBarPaint) -> ScrollBarDragDecision {
    decision: ScrollBarDragDecision
    decision.scroll_offset = ScrollClamp(current_scroll, max_scroll)
    if mouse_down && (!input_captured || owns_drag) {
        if !drag_active {
            if thumb_active && pointer_owner_none {
                decision.start_drag = true
                decision.claim_scroll_owner = true
            }
            return decision
        }
        if owns_drag {
            decision.continue_drag = true
            decision.claim_scroll_owner = true
            decision.scroll_offset = ScrollThumbDragDeltaOffsetFor(
            start_scroll, delta_y, max_scroll, paint)
        }
        return decision
    }
    if owns_drag {
        decision.cancel_drag = true
    }
    return decision
}

#program_export
ScrollBarDragReleaseFor :: (drag_active: bool, mouse_released: bool,
content_disabled: bool) -> ScrollBarDragReleaseDecision {
    decision: ScrollBarDragReleaseDecision
    decision.clear_drag = drag_active && (mouse_released || content_disabled)
    decision.consume_release = drag_active && mouse_released
    return decision
}

#program_export
ScrollContentDragFor :: (max_scroll: s32, mouse_pressed: bool,
mouse_down: bool, inside: bool, input_captured: bool,
on_scrollbar: bool, pointer_owner_none: bool, pointer_owner_scroll: bool,
blocked_by_other_drag: bool, active: bool, dragging: bool,
current_scroll: s32, start_scroll: s32, delta_y: s32,
drag_threshold: s32) -> ScrollContentDragDecision {
    decision: ScrollContentDragDecision
    decision.scroll_offset = ScrollClamp(current_scroll, max_scroll)
    if blocked_by_other_drag {
        return decision
    }
    if max_scroll > 0 && pointer_owner_none && mouse_pressed && inside &&
    !input_captured && !on_scrollbar {
        decision.start_drag = true
        decision.active = true
        decision.gesture_pending = true
        return decision
    }
    if active && mouse_down && (pointer_owner_none || pointer_owner_scroll) {
        decision.active = true
        if dragging || delta_y > drag_threshold || delta_y < -drag_threshold {
            decision.dragging = true
            decision.claim_scroll_owner = true
            decision.capture_input = true
            decision.scroll_offset = ScrollDragDeltaOffsetFor(
            start_scroll, delta_y, max_scroll)
        }
        return decision
    }
    if active && dragging {
        decision.capture_input = true
    }
    return decision
}

#program_export
ScrollRectVisibleOffsetFor :: (scroll_offset: s32, viewport_y: s32,
viewport_height: s32, rect_y: s32, rect_height: s32, margin: s32,
max_scroll: s32) -> s32 {
    if margin < 0 { margin = 0 }
    next_scroll: s32 = ScrollClamp(scroll_offset, max_scroll)
    viewport_top: s32 = viewport_y + margin
    viewport_bottom: s32 = viewport_y + viewport_height - margin
    rect_top: s32 = rect_y
    rect_bottom: s32 = rect_y + rect_height

    if viewport_bottom < viewport_top { viewport_bottom = viewport_top }
    if rect_bottom > viewport_bottom {
        next_scroll += rect_bottom - viewport_bottom
    }
    if rect_top < viewport_top {
        next_scroll -= viewport_top - rect_top
    }
    return ScrollClamp(next_scroll, max_scroll)
}

#program_export
ScrollMeasure :: (bounds: Rectangle, content_height: s32, content_x: s32,
content_width: s32, scroll_offset: s32, scrollbar_x: s32,
metrics: ScrollMetrics) -> ScrollPolicyView {
    view: ScrollPolicyView
    x: s32 = cast(s32)bounds.x
    y: s32 = cast(s32)bounds.y
    w: s32 = cast(s32)bounds.width
    h: s32 = cast(s32)bounds.height
    if content_height < 0 { content_height = 0 }
    if content_x <= 0 { content_x = x }
    if content_width <= 0 { content_width = w }
    if scrollbar_x <= 0 { scrollbar_x = x + w - metrics.scrollbar_width }

    view.content_x = content_x
    view.viewport_h = h
    view.content_h = content_height
    view.max_scroll = ScrollMax(content_height, h)
    scroll_offset = ScrollClamp(scroll_offset, view.max_scroll)
    view.content_y = y - scroll_offset
    view.scrollbar_x = scrollbar_x
    view.content_w = ScrollSafeContentWidth(content_x, content_width,
    scrollbar_x, view.max_scroll, metrics)
    return view
}

#program_export
ScrollBarPaintFor :: (x: s32, y: s32, viewport_h: s32, content_h: s32,
scroll_offset: s32, max_scroll: s32, metrics: ScrollMetrics) -> ScrollBarPaint {
    paint: ScrollBarPaint
    scrollbar_w: s32 = metrics.scrollbar_width
    if scrollbar_w < 0 { scrollbar_w = 0 }
    if viewport_h < 0 { viewport_h = 0 }
    if content_h < 0 { content_h = 0 }

    thumb_h: s32 = viewport_h
    if content_h > 0 {
        thumb_h = cast(s32)(cast(float32)viewport_h * (cast(float32)viewport_h / cast(float32)content_h))
    }
    if thumb_h < metrics.thumb_min_height { thumb_h = metrics.thumb_min_height }
    max_thumb_h: s32 = cast(s32)(cast(float32)viewport_h * 0.28)
    if max_thumb_h < metrics.thumb_min_height { max_thumb_h = metrics.thumb_min_height }
    if thumb_h > max_thumb_h { thumb_h = max_thumb_h }
    if thumb_h > viewport_h { thumb_h = viewport_h }
    if thumb_h < 0 { thumb_h = 0 }

    clamped_scroll: s32 = ScrollClamp(scroll_offset, max_scroll)
    scroll_ratio: float32 = 0.0
    if max_scroll > 0 {
        scroll_ratio = cast(float32)clamped_scroll / cast(float32)max_scroll
    }
    if scroll_ratio < 0.0 { scroll_ratio = 0.0 }
    if scroll_ratio > 1.0 { scroll_ratio = 1.0 }
    track_span: s32 = viewport_h - thumb_h
    if track_span < 0 { track_span = 0 }
    thumb_y: s32 = y + cast(s32)(scroll_ratio * cast(float32)track_span)
    if thumb_y < y { thumb_y = y }
    if thumb_y + thumb_h > y + viewport_h {
        thumb_y = y + viewport_h - thumb_h
    }

    inset: s32 = metrics.thumb_inset
    if inset < 0 { inset = 0 }
    thumb_w: s32 = scrollbar_w - inset * 2
    if thumb_w < 0 { thumb_w = 0 }

    paint.track_bounds.x = cast(float32)x
    paint.track_bounds.y = cast(float32)y
    paint.track_bounds.width = cast(float32)scrollbar_w
    paint.track_bounds.height = cast(float32)viewport_h
    paint.thumb_bounds.x = cast(float32)(x + inset)
    paint.thumb_bounds.y = cast(float32)thumb_y
    paint.thumb_bounds.width = cast(float32)thumb_w
    paint.thumb_bounds.height = cast(float32)thumb_h
    paint.track_span = track_span
    paint.scroll_per_pixel = 0.0
    if track_span > 0 {
        paint.scroll_per_pixel = cast(float32)max_scroll / cast(float32)track_span
    }
    return paint
}

ScrollFrameInput :: struct {
    bounds: Rectangle
    content_height: s32
    has_offset: bool
    offset: s32
    pointer_allowed: bool
    disabled: bool
    mouse: Vector2
    pressed: bool
    down: bool
    released: bool
    wheel: float32
    owns_drag: bool
    owner_captured: bool
    grab: float32
}

ScrollFrame :: struct {
    clip: Rectangle
    content: Rectangle
    paint: ScrollBarPaint
    offset: s32
    grab: float32
    scrollbar: bool
    start_drag: bool
    clear_drag: bool
    consume_release: bool
    consume_wheel: bool
    thumb_state: s32
}

ScrollPointInside :: (point: Vector2, bounds: Rectangle) -> bool {
    return point.x >= bounds.x && point.y >= bounds.y &&
    point.x < bounds.x + bounds.width && point.y < bounds.y + bounds.height
}

#program_export
ScrollFrameFor :: (input: ScrollFrameInput, metrics: ScrollMetrics) -> ScrollFrame {
    frame: ScrollFrame
    frame.clip = input.bounds
    frame.grab = input.grab
    frame.thumb_state = cast(s32)ButtonStateNormal
    maximum: s32 = ScrollMax(input.content_height, cast(s32)input.bounds.height)
    active: bool = input.owns_drag
    if input.has_offset {
        frame.offset = ScrollClamp(input.offset, maximum)
        if input.pointer_allowed && !input.disabled && input.wheel != 0.0 {
            frame.offset = ScrollWheelOffsetFor(frame.offset, input.wheel,
            maximum, metrics.default_wheel_step)
            frame.consume_wheel = true
        }
        frame.scrollbar = maximum > 0 &&
        input.bounds.width > cast(float32)metrics.scrollbar_width && input.bounds.height > 0.0
    }
    if !frame.scrollbar || input.disabled || input.owner_captured {
        frame.clear_drag = active
        frame.consume_release = active && input.released
        active = false
    }
    if frame.scrollbar {
        x: s32 = cast(s32)(input.bounds.x + input.bounds.width) - metrics.scrollbar_width
        frame.paint = ScrollBarPaintFor(x, cast(s32)input.bounds.y, cast(s32)input.bounds.height,
        input.content_height, frame.offset, maximum, metrics)
        if !input.disabled && !input.owner_captured && input.pointer_allowed &&
        input.pressed && ScrollPointInside(input.mouse, frame.paint.track_bounds) {
            frame.start_drag = true
            frame.clear_drag = false
            active = true
            frame.grab = frame.paint.thumb_bounds.height / 2.0
            if ScrollPointInside(input.mouse, frame.paint.thumb_bounds) {
                frame.grab = input.mouse.y - frame.paint.thumb_bounds.y
            }
        }
        if active {
            if frame.paint.track_span > 0 && (input.down || input.pressed) {
                frame.offset = ScrollDragOffsetFor(input.mouse.y,
                frame.paint.track_bounds.y, frame.grab, maximum, frame.paint)
            }
            if input.released {
                frame.consume_release = true
                frame.clear_drag = true
                active = false
            }
        }
        frame.paint = ScrollBarPaintFor(x, cast(s32)input.bounds.y, cast(s32)input.bounds.height,
        input.content_height, frame.offset, maximum, metrics)
        if active {
            frame.thumb_state = cast(s32)ButtonStatePressed
        } else if !input.disabled && input.pointer_allowed &&
        ScrollPointInside(input.mouse, frame.paint.thumb_bounds) {
            frame.thumb_state = cast(s32)ButtonStateHover
        }
        frame.clip = ScrollContentBounds(input.bounds, true, metrics)
    }
    frame.content = frame.clip
    frame.content.y -= cast(float32)frame.offset
    frame.content.height = cast(float32)input.content_height
    if frame.content.height < 0.0 { frame.content.height = 0.0 }
    return frame
}
