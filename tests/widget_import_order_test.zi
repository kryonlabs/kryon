ForeignNavigation :: #import "navigation";
Image :: #import "kryon/image";
Layout :: #import "kryon/layout";
Modal :: #import "kryon/modal";
Navigation :: #import "kryon/navigation";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
TextMeasure :: #import "kryon/text_measure";
Toolbar :: #import "kryon/toolbar";
#import "kryon/session"
StdText :: #import "std/text";
// Widget packages must retain their identity with either module-root order.
#import "kryon/image_showing"

#program_export
main :: () -> s32 {
    if !StdText.StartsWithFoldASCII("Probe", "pro") { return 1 }
    if ForeignNavigation.ForeignNavigationSentinel() != 37 { return 2 }
    column := Layout.CenteredColumnFor(800, 640, 24)
    unused Layout.IsDesktopWidth(800, 1.0)
    unused Layout.Clamp(column.width, 0, 800)
    unused Modal.ModalPanelRole()
    unused Modal.ModalScrimRole()
    row := Toolbar.BottomIconRowLayoutFor(.{.center_x = 400, .view_width = 800, .view_height = 600, .count = 1}, 1.0)
    unused Toolbar.BottomIconRowButtonBoundsFor(row, 0)
    unused Scroll.ScrollClamp(10, Scroll.ScrollMax(100, 40))
    session := SessionOpen()
    Text.Draw(session, Text.Props.{.key = Layout.KeyHash("text"), .text = "Probe"})
    Image.Draw(session, Image.Props.{.key = Layout.KeyHash("image")})
    unused TextMeasure.TextWidth(session, Text.Props.{})
    unused ImageShowingOf(session, Image.Props.{})
    items: [1]Navigation.NavigationBarItem
    unused Navigation.Draw(session, Navigation.Props.{}, items[:])
    SessionClose(session)
    return 0
}
