// Bounded GTK raster composition for native Kryon widgets. No disk assets or
// host-specific texture drawing: the finished surface uses Image(ImageProps).
using Gtk :: #import "gtk_style_linux";
Scroll :: #import "gtk_scroll_linux";
#import "session"
#import "geometry"
#import "drawing_props"
#import "image_props"
#import "kryon/image_widget"
using Bitmaps :: #import "bitmap_image";
using Bytes :: #import "std/vec";

painter_c :: #system_library "c";
PainterCopy :: (destination: *void, source: *void, bytes: usize) -> *void #foreign painter_c "memcpy";
PainterFill :: (destination: *void, value: s32, bytes: usize) -> *void #foreign painter_c "memset";
PainterCompare :: (first: *void, second: *void, bytes: usize) -> s32 #foreign painter_c "memcmp";

GtkPaintTile :: struct { signature: u64; bitmap: GtkStyleBitmap }
// A CSS layer drawn over an exact backdrop. Reuse requires the same nodes,
// region and style generation and a byte-identical backdrop.
GtkStyleOverEntry :: struct { key: u64; backdrop: Vec(u8); output: Vec(u8) }
GTK_STYLE_OVER_ENTRIES :: 16
GTK_STYLE_OVER_BUDGET :: 16777216
GtkPainter :: struct {
    pixels: Vec(u8)
    // The exact pixels last given to texture; valid only while presented_valid.
    presented: Vec(u8)
    presented_valid: bool
    atlas: Vec(u8)
    regions: Vec(s32)
    region_count: s32
    tiles: [256]GtkPaintTile
    next_tile: s32
    overs: [GTK_STYLE_OVER_ENTRIES]GtkStyleOverEntry
    next_over: s32
    over_bytes: s64
    tile_bytes: s64
    generation: u64
    signature: u64
    width: s32
    height: s32
    bounds: Rectangle
    clip: Rectangle
    session: Session
    texture: Texture2D
}

StyleOverDrop :: (p: *GtkPainter, at: s32) {
    entry := *p.overs[at]
    p.over_bytes -= entry.backdrop.count + entry.output.count
    VecFree(entry.backdrop); VecFree(entry.output); entry.key = 0
}

GtkPainterRelease :: (p: *GtkPainter) {
    for i: 0..255 { GtkStyleBitmapRelease(*p.tiles[i].bitmap); p.tiles[i].signature = 0 }
    for i: cast(s32)0..GTK_STYLE_OVER_ENTRIES-1 { StyleOverDrop(p, i) }
    BitmapImageRelease(p.session, p.texture)
    VecFree(p.pixels); VecFree(p.presented); VecFree(p.atlas); VecFree(p.regions)
    p.texture = .{}; p.signature = 0; p.presented_valid = false; p.tile_bytes = 0; p.region_count = 0
}

GtkPainterBegin :: (p: *GtkPainter, session: Session, bounds: Rectangle) -> bool {
    unused GtkStylePoll()
    generation := GtkStyleGeneration()
    if p.generation != generation {
        for i: 0..255 { GtkStyleBitmapRelease(*p.tiles[i].bitmap); p.tiles[i].signature = 0 }
        for i: cast(s32)0..GTK_STYLE_OVER_ENTRIES-1 { StyleOverDrop(p, i) }
        p.generation = generation
        p.tile_bytes = 0
    }
    if p.session.slot != session.slot || p.session.epoch != session.epoch {
        BitmapImageRelease(p.session, p.texture); p.texture = .{}; p.signature = 0
        p.presented_valid = false
    }
    p.session = session; p.bounds = bounds; p.clip = bounds
    p.width = cast(s32)bounds.width; p.height = cast(s32)bounds.height
    if p.width < 1 || p.height < 1 || p.width > 8192 || p.height > 8192 ||
        cast(s64)p.width * cast(s64)p.height > 16777216 { return false }
    if !VecResize(p.pixels, cast(s64)p.width * cast(s64)p.height * 4) { return false }
    unused PainterFill(cast(*void)*p.pixels[0], 0, cast(usize)p.pixels.count)
    return true
}

#scope_file
Hash :: (hash: u64, text: string) -> u64 {
    hash = (hash ^ cast(u64)text.count) * cast(u64)1099511628211
    for c: text { hash = (hash ^ cast(u64)c) * cast(u64)1099511628211 }
    return hash
}
TileKey :: (nodes: []GtkStyleNode, bounds: Rectangle, text: string, kind: s32, align: s32) -> u64 {
    hash := Hash(cast(u64)1469598103934665603, text)
    hash = (hash ^ cast(u64)cast(s32)bounds.width) * cast(u64)1099511628211
    hash = (hash ^ cast(u64)cast(s32)bounds.height) * cast(u64)1099511628211
    hash = (hash ^ cast(u64)(kind * 4 + align)) * cast(u64)1099511628211
    for node: nodes {
        hash = Hash(Hash(Hash(hash, node.widget_type), node.element), node.name)
        hash = (hash ^ cast(u64)node.state) * cast(u64)1099511628211
        hash = (hash ^ cast(u64)node.sibling_count) * cast(u64)1099511628211
        hash = (hash ^ cast(u64)node.sibling_index) * cast(u64)1099511628211
        for cls: node.classes { hash = Hash(hash, cls) }
        for provider: node.providers { hash = (hash ^ provider.provider ^ cast(u64)provider.priority) * cast(u64)1099511628211 }
    }
    return ifx hash == 0 then cast(u64)1 else hash
}
Composite :: (p: *GtkPainter, bitmap: GtkStyleBitmap, bounds: Rectangle) {
    x := cast(s32)(bounds.x - p.bounds.x); y := cast(s32)(bounds.y - p.bounds.y)
    // Clip once per bitmap, retaining the exact pixel-origin comparisons
    // for fractional bounds. The inner loop only composites visible pixels.
    first_col: s32=0; last_col:=bitmap.width
    first_row: s32=0; last_row:=bitmap.height
    if x<0 { first_col= -x }; if x+last_col>p.width { last_col=p.width-x }
    if y<0 { first_row= -y }; if y+last_row>p.height { last_row=p.height-y }
    while first_col<last_col && cast(float32)(x+first_col)+p.bounds.x<p.clip.x { first_col+=1 }
    while last_col>first_col && cast(float32)(x+last_col-1)+p.bounds.x>=p.clip.x+p.clip.width { last_col-=1 }
    while first_row<last_row && cast(float32)(y+first_row)+p.bounds.y<p.clip.y { first_row+=1 }
    while last_row>first_row && cast(float32)(y+last_row-1)+p.bounds.y>=p.clip.y+p.clip.height { last_row-=1 }
    for row: first_row..last_row-1 {
        yy := y + row
        col := first_col
        while col < last_col {
            xx := x + col
            src := (row * bitmap.width + col) * 4; dst := (yy * p.width + xx) * 4
            a := cast(s32)bitmap.rgba[src + 3]
            if a == 0 { col += 1; continue }
            // Opaque native surfaces replace the backdrop exactly. Copy each
            // opaque run at once, avoiding straight/premultiplied conversions
            // for background and control pixels; translucent edges keep
            // Cairo's rounding below.
            if a == 255 {
                end := col + 1
                while end < last_col && bitmap.rgba[(row * bitmap.width + end) * 4 + 3] == 255 { end += 1 }
                unused PainterCopy(cast(*void)*p.pixels[dst], cast(*void)*bitmap.rgba[src], cast(usize)((end - col) * 4))
                col = end
                continue
            }
            col += 1
            da := cast(s32)p.pixels[dst + 3]
            // GTK/Cairo quantizes each premultiplied component before OVER.
            // Combining the straight-alpha fractions rounds glyph coverage
            // differently, even when the destination is fully opaque.
            out_a := a + (da * (255-a) + 127)/255
            for c: 0..2 {
                source := (cast(s32)bitmap.rgba[src+c]*a+127)/255
                destination := (cast(s32)p.pixels[dst+c]*da+127)/255
                component := source + (destination*(255-a)+127)/255
                value := (component*255+out_a/2)/out_a
                if value>255 { value=255 }
                p.pixels[dst+c]=cast(u8)value
            }
            p.pixels[dst+3] = cast(u8)out_a
        }
    }
}

RegionPaint :: (p: *GtkPainter, nodes: []GtkStyleNode, bounds: Rectangle) {
    width:=cast(s32)bounds.width; height:=cast(s32)bounds.height
    if width>8192 || height>8192 { return }
    base:=TileKey(nodes,bounds,"",0,0)
    yy: s32=0
    while yy<height {
        hh:=height-yy; if hh>256 { hh=256 }
        xx: s32=0
        while xx<width {
            ww:=width-xx; if ww>512 { ww=512 }
            box:=Rectangle.{bounds.x+cast(float32)xx,bounds.y+cast(float32)yy,cast(float32)ww,cast(float32)hh}
            if box.x<p.clip.x+p.clip.width && box.y<p.clip.y+p.clip.height && box.x+box.width>p.clip.x && box.y+box.height>p.clip.y {
                signature:=(base ^ cast(u64)(xx+1))*cast(u64)1099511628211 ^ cast(u64)(yy+1)
                if signature==0 { signature=1 }
                at: s32= -1
                for i: 0..255 { if p.tiles[i].signature==signature { at=cast(s32)i; break } }
                if at<0 {
                    at=p.next_tile; p.next_tile=(p.next_tile+1)%256
                    p.tile_bytes-=p.tiles[at].bitmap.rgba.count
                    GtkStyleBitmapRelease(*p.tiles[at].bitmap)
                    bitmap:=GtkStyleRasterRegion(nodes,width,height,1,xx,yy,ww,hh)
                    while p.tile_bytes+bitmap.rgba.count>33554432 {
                        evict:=p.next_tile; p.next_tile=(p.next_tile+1)%256
                        p.tile_bytes-=p.tiles[evict].bitmap.rgba.count
                        GtkStyleBitmapRelease(*p.tiles[evict].bitmap); p.tiles[evict].signature=0
                    }
                    p.tile_bytes+=bitmap.rgba.count; p.tiles[at].bitmap=bitmap
                    p.tiles[at].signature=ifx bitmap.rgba.count>0 then signature else cast(u64)0
                }
                Composite(p,p.tiles[at].bitmap,box)
            }
            xx+=ww
        }
        yy+=hh
    }
}
#scope_export
// kind: 0 CSS surface, 1 Pango label, 2 themed icon, 3 GIO file icon.
// Composite a borrowed native raster at its exact pixel size. This keeps
// temporary widget layers out of the tile cache and preserves draw order.
GtkPainterBitmap :: (p: *GtkPainter, bounds: Rectangle, bitmap: GtkStyleBitmap) -> bool {
    if p==null || p.width<1 || p.height<1 ||
        p.pixels.count!=cast(s64)p.width*cast(s64)p.height*4 ||
        bitmap.width<1 || bitmap.height<1 || bitmap.width>4096 || bitmap.height>4096 ||
        cast(s64)bitmap.width*cast(s64)bitmap.height>4194304 ||
        bitmap.rgba.count!=cast(s64)bitmap.width*cast(s64)bitmap.height*4 ||
        bounds.width!=cast(float32)bitmap.width || bounds.height!=cast(float32)bitmap.height ||
        bounds.x!=bounds.x || bounds.y!=bounds.y { return false }
    if bounds.x>=p.bounds.x+p.bounds.width || bounds.y>=p.bounds.y+p.bounds.height ||
        bounds.x+bounds.width<=p.bounds.x || bounds.y+bounds.height<=p.bounds.y ||
        p.clip.width<=0.0 || p.clip.height<=0.0 { return true }
    Composite(p,bitmap,bounds)
    return true
}

// Paint CSS layers on the current backdrop without flattening them first.
// The output replaces this crop; a second OVER would apply its alpha twice.
GtkPainterStyleOver :: (p: *GtkPainter, nodes: []GtkStyleNode, bounds: Rectangle) -> bool {
    width:=cast(s32)bounds.width; height:=cast(s32)bounds.height
    if width<1 || height<1 || width>8192 || height>8192 { return false }
    box:=RectangleIntersection(RectangleIntersection(bounds,p.bounds),p.clip)
    x:=cast(s32)(box.x-p.bounds.x); y:=cast(s32)(box.y-p.bounds.y)
    w:=cast(s32)box.width; h:=cast(s32)box.height
    if w<1 || h<1 || x<0 || y<0 || x>p.width-w || y>p.height-h ||
        cast(s64)w*cast(s64)h>4194304 || p.pixels.count!=cast(s64)p.width*cast(s64)p.height*4 { return false }
    background: Vec(u8)
    if !VecResize(background,cast(s64)w*cast(s64)h*4) { return false }
    defer VecFree(background)
    for yy: cast(s32)0..h-1 {
        unused PainterCopy(cast(*void)*background[yy*w*4], cast(*void)*p.pixels[((y+yy)*p.width+x)*4], cast(usize)(w*4))
    }
    backdrop: *void=cast(*void)*background[0]
    key:=TileKey(nodes,bounds,"",0,0)
    key=(key ^ cast(u64)(box.x-bounds.x+1.0))*cast(u64)1099511628211
    key=(key ^ cast(u64)(box.y-bounds.y+1.0))*cast(u64)1099511628211
    key=(key ^ cast(u64)w)*cast(u64)1099511628211 ^ cast(u64)h
    if key==0 { key=1 }
    bytes:=background.count
    hit: s32= -1
    for i: cast(s32)0..GTK_STYLE_OVER_ENTRIES-1 {
        entry:=*p.overs[i]
        if entry.key==key && entry.backdrop.count==bytes && entry.output.count==bytes &&
            PainterCompare(cast(*void)*entry.backdrop[0],backdrop,cast(usize)bytes)==0 { hit=i; break }
    }
    if hit>=0 {
        cached:=*p.overs[hit]
        for yy: cast(s32)0..h-1 {
            unused PainterCopy(cast(*void)*p.pixels[((y+yy)*p.width+x)*4], cast(*void)*cached.output[yy*w*4], cast(usize)(w*4))
        }
        return true
    }
    // Keep the result for an identical later backdrop, within a fixed budget.
    // The backdrop is stored before GTK consumes it.
    at: s32= -1
    if bytes*2<=GTK_STYLE_OVER_BUDGET {
        at=p.next_over; p.next_over=(p.next_over+1)%GTK_STYLE_OVER_ENTRIES
        StyleOverDrop(p,at)
        while p.over_bytes+bytes*2>GTK_STYLE_OVER_BUDGET {
            evict:=p.next_over; p.next_over=(p.next_over+1)%GTK_STYLE_OVER_ENTRIES
            StyleOverDrop(p,evict)
        }
        entry:=*p.overs[at]
        if VecResize(entry.backdrop,bytes) {
            unused PainterCopy(cast(*void)*entry.backdrop[0],backdrop,cast(usize)bytes)
            p.over_bytes+=bytes
        } else { StyleOverDrop(p,at); at= -1 }
    }
    bitmap:=GtkStyleRasterRegionOver(nodes,width,height,1,cast(s32)(box.x-bounds.x),cast(s32)(box.y-bounds.y),w,h,background[:])
    defer GtkStyleBitmapRelease(*bitmap)
    if bitmap.width!=w || bitmap.height!=h || bitmap.rgba.count!=bytes {
        if at>=0 { StyleOverDrop(p,at) }
        return false
    }
    for yy: cast(s32)0..h-1 {
        unused PainterCopy(cast(*void)*p.pixels[((y+yy)*p.width+x)*4], cast(*void)*bitmap.rgba[yy*w*4], cast(usize)(w*4))
    }
    if at>=0 {
        entry:=*p.overs[at]
        if VecResize(entry.output,bytes) {
            unused PainterCopy(cast(*void)*entry.output[0],cast(*void)*bitmap.rgba[0],cast(usize)bytes)
            p.over_bytes+=bytes; entry.key=key
        } else { StyleOverDrop(p,at) }
    }
    return true
}

// Draw an allocated GTK scrollbar on its actual backdrop, retaining native
// curve coverage and clipping the replacement to the painter's visible area.
GtkPainterScrollOver :: (p: *GtkPainter, handle: u64, bounds: Rectangle, horizontal: bool=false) -> bool {
    if p==null || p.width<1 || p.height<1 ||
        p.pixels.count!=cast(s64)p.width*cast(s64)p.height*4 { return false }
    width:=cast(s32)bounds.width; height:=cast(s32)bounds.height
    if width<1 || height<1 || width>4096 || height>4096 ||
        cast(s64)width*cast(s64)height>4194304 ||
        bounds.x!=bounds.x || bounds.y!=bounds.y { return false }
    box:=RectangleIntersection(RectangleIntersection(bounds,p.bounds),p.clip)
    if box.width<=0.0 || box.height<=0.0 { return true }
    x:=cast(s32)(bounds.x-p.bounds.x); y:=cast(s32)(bounds.y-p.bounds.y)
    background: Vec(u8)
    if !VecResize(background,cast(s64)width*cast(s64)height*4) { return false }
    defer VecFree(background)
    for yy: cast(s32)0..height-1 { for xx: cast(s32)0..width-1 { for c: cast(s32)0..3 {
        px:=x+xx; py:=y+yy
        value: u8
        if px>=0 && py>=0 && px<p.width && py<p.height { value=p.pixels[(py*p.width+px)*4+c] }
        background[(yy*width+xx)*4+c]=value
    } } }
    bitmap:=Scroll.GtkScrollRasterOver(handle,background[:],horizontal,1)
    defer GtkStyleBitmapRelease(*bitmap)
    if bitmap.width!=width || bitmap.height!=height || bitmap.rgba.count!=background.count { return false }
    for yy: cast(s32)0..height-1 { for xx: cast(s32)0..width-1 {
        px:=bounds.x+cast(float32)xx; py:=bounds.y+cast(float32)yy
        if px<box.x || py<box.y || px>=box.x+box.width || py>=box.y+box.height { continue }
        for c: cast(s32)0..3 { p.pixels[((y+yy)*p.width+x+xx)*4+c]=bitmap.rgba[(yy*width+xx)*4+c] }
    } }
    return true
}

GtkPainterPaint :: (p: *GtkPainter, nodes: []GtkStyleNode, bounds: Rectangle,
    text: string = "", kind: s32 = 0, align: s32 = 0, revision: u64 = 0) {
    if bounds.width < 1.0 || bounds.height < 1.0 || bounds.x >= p.bounds.x+p.bounds.width ||
        bounds.y >= p.bounds.y+p.bounds.height || bounds.x+bounds.width <= p.bounds.x ||
        bounds.y+bounds.height <= p.bounds.y { return }
    if kind==0 && (bounds.width>4096.0 || bounds.height>4096.0 ||
        cast(s64)bounds.width*cast(s64)bounds.height>4194304) {
        RegionPaint(p,nodes,bounds); return
    }
    signature := TileKey(nodes,bounds,text,kind,align) ^ revision
    if signature==0 { signature=1 }
    at: s32 = -1
    for i: 0..255 { if p.tiles[i].signature == signature { at = cast(s32)i; break } }
    if at < 0 {
        at = p.next_tile; p.next_tile = (p.next_tile+1)%256
        p.tile_bytes -= p.tiles[at].bitmap.rgba.count
        GtkStyleBitmapRelease(*p.tiles[at].bitmap)
        bitmap: GtkStyleBitmap
        w := cast(s32)bounds.width; h := cast(s32)bounds.height
        if kind == 0 { bitmap = GtkStyleRaster(nodes,w,h,1) }
        else if kind == 1 { bitmap = GtkTextRaster(nodes,text,w,h,1,align,"",false,true,true) }
        else if kind == 2 { bitmap = GtkIconRaster(text,w,1,nodes) }
        else if kind == 3 { bitmap = GtkFileIconRaster(text,w,1,nodes) }
        else if kind == 4 { bitmap = GtkImageRaster(text,w,h) }
        else if kind == 5 { bitmap = GtkTextRaster(nodes,text,w,h,1,align,"",true,true,true) }
        else if kind == 6 { bitmap = GtkSerializedIconRaster(text,w,1,nodes) }
        else if kind == 7 { bitmap = GtkIconRaster(text,w,1,nodes,false,true) }
        else if kind == 8 { bitmap = GtkTextRaster(nodes,text,w,h,1,align,"",false,false,true) }
        while p.tile_bytes+bitmap.rgba.count > 33554432 {
            evict := p.next_tile; p.next_tile=(p.next_tile+1)%256
            p.tile_bytes-=p.tiles[evict].bitmap.rgba.count
            GtkStyleBitmapRelease(*p.tiles[evict].bitmap); p.tiles[evict].signature=0
        }
        p.tile_bytes+=bitmap.rgba.count
        p.tiles[at].bitmap = bitmap
        p.tiles[at].signature = ifx bitmap.rgba.count > 0 then signature else cast(u64)0
    }
    image_bounds:=bounds
    if kind==4 || kind==7 {
        image_bounds.x+=(bounds.width-cast(float32)p.tiles[at].bitmap.width)*0.5
        image_bounds.y+=(bounds.height-cast(float32)p.tiles[at].bitmap.height)*0.5
    }
    Composite(p,p.tiles[at].bitmap,image_bounds)
}

#scope_file
// Large desktops share identical 64px raster regions in a bounded atlas. This
// stores exact native pixels, including alpha, without increasing BitmapImage
// ownership limits. Hash matches are always checked byte for byte.
AtlasEnd :: (p: *GtkPainter, key: u64) -> bool {
    columns: s32=(p.width+63)/64; rows: s32=(p.height+63)/64
    if !VecResize(p.regions,cast(s64)(columns*rows)) || !VecResize(p.atlas,16777216) { return false }
    hashes: [1024]u64
    count: s32=0
    for row: cast(s32)0..rows-1 {
        for column: cast(s32)0..columns-1 {
            hash: u64=1469598103934665603
            for yy: cast(s32)0..63 {
                for xx: cast(s32)0..63 {
                    x:=column*64+xx; y:=row*64+yy
                    for channel: cast(s32)0..3 {
                        value: u8=0
                        if x<p.width && y<p.height { value=p.pixels[(y*p.width+x)*4+channel] }
                        hash=(hash ^ cast(u64)value)*cast(u64)1099511628211
                    }
                }
            }
            found: s32= -1
            for candidate: cast(s32)0..count-1 {
                if hashes[candidate]!=hash { continue }
                matches:=true
                for yy: cast(s32)0..63 {
                    for xx: cast(s32)0..63 {
                        x:=column*64+xx; y:=row*64+yy
                        for channel: cast(s32)0..3 {
                            value: u8=0
                            if x<p.width && y<p.height { value=p.pixels[(y*p.width+x)*4+channel] }
                            offset:=(((candidate/32)*64+yy)*2048+(candidate%32)*64+xx)*4+channel
                            if value!=p.atlas[offset] { matches=false; break }
                        }
                        if !matches { break }
                    }
                    if !matches { break }
                }
                if matches { found=candidate; break }
            }
            if found<0 {
                if count>=1024 { return false }
                found=count; hashes[count]=hash; count+=1
                for yy: cast(s32)0..63 {
                    for xx: cast(s32)0..63 {
                        x:=column*64+xx; y:=row*64+yy
                        for channel: cast(s32)0..3 {
                            value: u8=0
                            if x<p.width && y<p.height { value=p.pixels[(y*p.width+x)*4+channel] }
                            offset:=(((found/32)*64+yy)*2048+(found%32)*64+xx)*4+channel
                            p.atlas[offset]=value
                        }
                    }
                }
            }
            p.regions[row*columns+column]=found
        }
    }
    p.region_count=count
    height:=((count+31)/32)*64
    // Clear unused slots so resizing/reuse cannot retain pixels from a prior frame.
    for slot: count..((count+31)/32)*32-1 {
        for yy: cast(s32)0..63 {
            for xx: cast(s32)0..255 { p.atlas[((slot/32)*64+yy)*8192+(slot%32)*256+xx]=0 }
        }
    }
    if !VecResize(p.atlas,cast(s64)2048*cast(s64)height*4) { return false }
    hash: u64=1469598103934665603
    for value: p.atlas { hash=(hash ^ cast(u64)value)*cast(u64)1099511628211 }
    // The atlas replaces this texture's pixels; the direct copy is stale.
    p.presented_valid=false
    if p.texture.width!=2048 || p.texture.height!=height {
        BitmapImageRelease(p.session,p.texture); p.texture=.{}; p.signature=0
    }
    if p.texture.id==0 { p.texture=BitmapImageCreate(p.session,2048,height,p.atlas[:]); p.signature=hash }
    else if p.signature!=hash { if BitmapImageUpdate(p.session,p.texture,p.atlas[:]) { p.signature=hash } }
    if p.texture.id==0 { return false }
    for row: cast(s32)0..rows-1 {
        for column: cast(s32)0..columns-1 {
            slot:=p.regions[row*columns+column]
            width:=p.width-column*64; if width>64 { width=64 }
            hh:=p.height-row*64; if hh>64 { hh=64 }
            Image(p.session,ImageProps.{.key=key+cast(u64)(row*columns+column),
                .bounds=.{p.bounds.x+cast(float32)(column*64),p.bounds.y+cast(float32)(row*64),cast(float32)width,cast(float32)hh},
                .source=.{cast(float32)((slot%32)*64),cast(float32)((slot/32)*64),cast(float32)width,cast(float32)hh},
                .texture=p.texture,.tint=cast(u32)0xffffffff})
        }
    }
    return true
}
#scope_export
GtkPainterEnd :: (p: *GtkPainter, key: u64) -> bool {
    if p.width>4096 || p.height>4096 || cast(s64)p.width*cast(s64)p.height>4194304 { return AtlasEnd(p,key) }
    p.region_count=0
    if p.texture.width != p.width || p.texture.height != p.height {
        BitmapImageRelease(p.session,p.texture); p.texture = .{}; p.signature = 0
        p.presented_valid = false
    }
    // Compare exact bytes with the last upload instead of hashing every pixel
    // each frame: unchanged frames skip the texture update entirely.
    bytes := p.pixels.count
    unchanged := p.texture.id != 0 && p.presented_valid && bytes > 0 && p.presented.count == bytes &&
        PainterCompare(cast(*void)*p.pixels[0], cast(*void)*p.presented[0], cast(usize)bytes) == 0
    if !unchanged {
        uploaded := false
        if p.texture.id == 0 {
            p.texture = BitmapImageCreate(p.session,p.width,p.height,p.pixels[:])
            uploaded = p.texture.id != 0
        } else { uploaded = BitmapImageUpdate(p.session,p.texture,p.pixels[:]) }
        p.presented_valid = false
        if uploaded && bytes > 0 && VecResize(p.presented,bytes) {
            unused PainterCopy(cast(*void)*p.presented[0], cast(*void)*p.pixels[0], cast(usize)bytes)
            p.presented_valid = true
        }
    }
    Image(p.session,ImageProps.{.key=key,.bounds=p.bounds,.texture=p.texture,.tint=cast(u32)0xffffffff})
    return p.texture.id!=0
}
