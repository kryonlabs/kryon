#module "icon_sheet_props"
#import "kryon_compat.generated.h"
#import "ui_icon_types.h"

# Emitted as a C enum ahead of the IconAsset record that references it
# (#type declarations emit before the enum pass).
IconSheet :: enum { ICON_SHEET_CORE = 0, ICON_SHEET_PFP = 1, ICON_SHEET_PLATFORMS = 2, ICON_SHEET_PAYMENTS = 3, ICON_SHEET_LANGUAGE = 4, ICON_SHEET_TILES = 5, ICON_SHEET_LOGOS = 6, ICON_SHEET_COUNT = 7 } #type

# C-only record: the asset table lives in the script-generated icon atlas.
IconAsset :: struct { IconType type; const char *name; IconSheet sheet; Rectangle source; } #type

# Implemented by the C-only icon host; declared here for the public ABI.
GetIconAsset :: (type: IconType) -> const IconAsset* #extern #export
GetIconAssetByName :: (name: const char*) -> const IconAsset* #extern #export
