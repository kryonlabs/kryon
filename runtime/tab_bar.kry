#module "tab_bar"
#import "drawing_props"
#import "style"
#import "control_props"

TabBarMetrics :: struct {
    min_width: i32
    max_width: i32
    icon_width: i32
    gap: i32
    close_width: i32
    label_padding: i32
}

TabBarScroll :: struct {
    scroll: i32
    max_scroll: i32
    equal_tabs: bool
}

TabBarPaint :: struct {
    bar: StyleFrame
    tab: StyleFrame
    close: StyleFrame
    bar_color: u32
    bar_border_color: u32
    tab_color: u32
    tab_border_color: u32
    text_color: u32
    icon_color: u32
    close_color: u32
    focus_color: u32
    radius: float
    border_width: float
    opacity: float
    text_padding: i32
    icon_size: i32
    icon_gap: i32
    content_inset_y: i32
    close_size: i32
    close_gap: i32
    reorder_drag_threshold: i32
}

TabBarPaintFor :: (bar: StyleFrame, tab: StyleFrame,
    close: StyleFrame, scale: float) -> TabBarPaint #export {
    if scale <= 0.0 { scale = 1.0 }
    paint: TabBarPaint
    paint.bar = bar
    paint.tab = tab
    paint.close = close
    paint.bar_color = bar.value.background
    paint.bar_border_color = bar.value.border
    paint.tab_color = tab.value.background
    paint.tab_border_color = tab.value.border
    paint.text_color = tab.value.foreground
    paint.icon_color = tab.value.foreground
    paint.close_color = close.value.foreground
    paint.focus_color = tab.value.focus
    paint.radius = tab.value.radius
    paint.border_width = tab.value.border_width
    paint.opacity = tab.value.opacity
    paint.text_padding = TabBarMetric(tab.value.fields,
        (u32)StylePaddingX, tab.value.padding_x, 8.0, scale, true)
    paint.icon_size = TabBarMetric(tab.value.fields,
        (u32)StyleIconSize, tab.value.icon_size, 16.0, scale, true)
    paint.icon_gap = TabBarMetric(tab.value.fields,
        (u32)StyleGap, tab.value.gap, 4.0, scale, true)
    paint.content_inset_y = TabBarMetric(tab.value.fields,
        (u32)StylePaddingY, tab.value.padding_y, 8.0, scale, true)
    paint.close_size = TabBarMetric(close.value.fields,
        (u32)StyleIconSize, close.value.icon_size, 18.0, scale, true)
    paint.close_gap = TabBarMetric(close.value.fields,
        (u32)StyleGap, close.value.gap, 6.0, scale, true)
    paint.reorder_drag_threshold = TabBarMetric(bar.value.fields,
        (u32)StylePaddingY, bar.value.padding_y, 6.0, scale, false)
    return paint
}

TabBarHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

TabBarMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !TabBarHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

TabBarPolicyHeight :: (scale: float, bar: StyleFrame) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    return TabBarMetric(bar.value.fields, (u32)StyleIconSize,
        bar.value.icon_size, 32.0, scale, false)
}

TabBarDefaultMetrics :: (min_width: i32, max_width: i32, scale: float,
    bar: StyleFrame, tab: StyleFrame, close: StyleFrame) -> TabBarMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: TabBarMetrics
    metrics.min_width = min_width
    if metrics.min_width <= 0 {
        metrics.min_width = TabBarMetric(bar.value.fields,
            (u32)StylePaddingX, bar.value.padding_x, 120.0, scale, false)
    }
    metrics.max_width = max_width
    if metrics.max_width <= 0 {
        metrics.max_width = TabBarMetric(bar.value.fields,
            (u32)StyleContentOffset, bar.value.offset_x,
            (float)metrics.min_width / scale, scale, false)
    }
    if metrics.max_width < metrics.min_width {
        metrics.max_width = metrics.min_width
    }
    metrics.icon_width = TabBarMetric(tab.value.fields,
        (u32)StyleIconSize, tab.value.icon_size, 44.0, scale, true)
    metrics.gap = TabBarMetric(bar.value.fields, (u32)StyleGap,
        bar.value.gap, 0.0, scale, true)
    metrics.close_width = TabBarMetric(close.value.fields,
        (u32)StyleIconSize, close.value.icon_size, 24.0, scale, true)
    metrics.label_padding = TabBarMetric(tab.value.fields,
        (u32)StylePaddingX, tab.value.padding_x * 2.0, 16.0, scale, true)
    return metrics
}

TabBarTabWidth :: (label_width: i32, has_label: bool, has_icon: bool,
    closeable: bool, metrics: TabBarMetrics) -> i32 #export {
    if !has_label && has_icon {
        return metrics.icon_width
    }
    if !has_label {
        return metrics.min_width
    }
    width: i32 = label_width + metrics.label_padding
    if closeable {
        width += metrics.close_width
    }
    if width < metrics.min_width {
        width = metrics.min_width
    }
    if width > metrics.max_width {
        width = metrics.max_width
    }
    return width
}

TabBarTotalWidth :: (tab_width_sum: i32, count: i32, gap: i32) -> i32 #export {
    if count <= 0 {
        return 0
    }
    total: i32 = tab_width_sum + gap * (count - 1)
    if total < 0 {
        return 0
    }
    return total
}

TabBarScrollFor :: (bounds_width: float, total_width: i32, scroll: i32) -> TabBarScroll #export {
    result: TabBarScroll
    result.equal_tabs = (float)total_width <= bounds_width
    result.max_scroll = total_width - (i32)bounds_width
    if result.max_scroll < 0 || result.equal_tabs {
        result.max_scroll = 0
    }
    if result.equal_tabs {
        result.scroll = 0
    } else if scroll < 0 {
        result.scroll = 0
    } else if scroll > result.max_scroll {
        result.scroll = result.max_scroll
    } else {
        result.scroll = scroll
    }
    return result
}

TabBarRevealScroll :: (tab_x: float, tab_width: float, bounds: Rectangle,
    scroll: i32, max_scroll: i32) -> i32 #export {
    if tab_x < bounds.x {
        scroll = scroll - (i32)(bounds.x - tab_x)
    } else if tab_x + tab_width > bounds.x + bounds.width {
        scroll = scroll + (i32)((tab_x + tab_width) - (bounds.x + bounds.width))
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

TabBarDragMarkerBounds :: (tab_x: i32, tab_width: i32, bar_y: i32,
    bar_height: i32, after_tab: bool, scale: float) -> Rectangle #export {
    marker: Rectangle
    if scale <= 0.0 { scale = 1.0 }
    marker_x: i32 = tab_x
    if after_tab {
        marker_x = tab_x + tab_width
    }
    marker.x = (float)marker_x - scale
    marker.y = (float)bar_y + 4.0 * scale
    marker.width = 2.0 * scale
    marker.height = (float)bar_height - 8.0 * scale
    if marker.height < 0.0 {
        marker.height = 0.0
    }
    return marker
}

TabBarEqualTabBounds :: (bounds: Rectangle, count: i32, index: i32) -> Rectangle #export {
    rect: Rectangle
    if count <= 0 || index < 0 || index >= count {
        return rect
    }
    width: float = bounds.width / (float)count
    rect.x = bounds.x + width * (float)index
    rect.y = bounds.y
    rect.width = width
    rect.height = bounds.height
    if index == count - 1 {
        rect.width = bounds.x + bounds.width - rect.x
    }
    return rect
}
