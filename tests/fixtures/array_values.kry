#module "array_values"
#import "record_types"
#import "array_bound_types"

BASE_CAPACITY :: 2
CAPACITY :: BASE_CAPACITY + 1
OTHER_CAPACITY :: #run 6 / 2
ALIAS_CAPACITY :: CAPACITY
Mode :: enum {
    ModeOff = 0
    ModeOn = 1
}
Entry :: struct {
    value: i32
    label: string
    flags: [2]bool
}
Buffer :: struct {
    values: [3]i32
}
Action :: () #slot

Check :: () -> i32 #export {
    values: [3]i32 = {2, 4}
    if values[2] != 0 { return 1 }
    copy: [3] i32 = values
    copy[0] = 9
    if values[0] != 2 { return 2 }
    values = copy
    copy[1] = 7
    if values[1] != 4 { return 3 }
    values = values
    if values[0] != 9 { return 4 }
    inferred := values
    inferred[0] = 11
    if values[0] != 9 { return 5 }

    # The elements execute in source order, and unspecified elements are zero.
    next: i32 = 0
    sequence: [4]i32 = {
        next++, next++, next++,
    }
    if next != 3 || sequence[0] != 0 || sequence[1] != 1 || sequence[2] != 2 || sequence[3] != 0 { return 6 }
    chosen: [3]i32 = true ? values : copy
    chosen[1] = 19
    if values[1] != 4 { return 7 }
    chosen = false ? ([3]i32){next++} : ([3]i32){next++, next++}
    if next != 5 || chosen[0] != 3 || chosen[1] != 4 || chosen[2] != 0 { return 8 }

    box: Buffer = (Buffer){.values = {1, 2, 3}}
    from_box: [3]i32 = box.values
    box.values = values
    if from_box[0] != 1 || box.values[0] != 9 { return 9 }
    box = (Buffer){.values = from_box}
    from_box[0] = 10
    if box.values[0] != 1 { return 10 }

    entries: [2]Entry = {{7, "日本語", {true}}}
    entries_copy: [2]Entry = entries
    entries_copy[0].value = 8
    entries_copy[0].flags[0] = false
    if entries[0].value != 7 || !entries[0].flags[0] { return 11 }
    if entries[0].label.length != 9 || entries[1].label.length != 0 || entries[1].flags[0] { return 12 }
    names: [2]string = {"a\x00b"}
    if names[0].length != 3 || names[1] != "" { return 13 }
    modes: [2]Mode = {(Mode)ModeOn}
    if modes[0] != (Mode)ModeOn || modes[1] != (Mode)ModeOff { return 14 }
    small: [3]u8 = {(u8)255}
    small_copy: [03]u8 = small
    if small_copy[0] != (u8)255 || small_copy[2] != (u8)0 { return 15 }
    named: [CAPACITY]i32 = {0}
    named_copy: [ALIAS_CAPACITY]i32 = named
    named_copy[1] = 6
    named = named_copy
    if named[0] != 0 || named[1] != 6 { return 16 }
    numeric_copy: [3]i32 = named
    if numeric_copy[1] != 6 { return 19 }
    run_copy: [OTHER_CAPACITY]i32 = numeric_copy
    if run_copy[1] != 6 { return 21 }

    # A borrowed callback captures the array itself, including whole copies.
    update: Action = () #slot {
        values[0] = 42
        copy = values
    }
    update()
    if values[0] != 42 || copy[0] != 42 { return 17 }
    imported: [2]Sample = {{.count = 3}}
    imported_copy: [2]Sample = imported
    imported_copy[0].count = 5
    if imported[0].count != 3 || imported[1].active { return 18 }
    imported_buffer: ImportedBuffer = (ImportedBuffer){.values = {1, 2, 3, 4}}
    imported_values: [IMPORTED_COUNT]i32 = imported_buffer.values
    four: [4]i32 = imported_values
    imported_buffer.values = four
    if imported_buffer.values[3] != 4 { return 20 }
    calls: [3]i32 = {2, 3, 4}
    changed: [CAPACITY]i32 = ChangeArray(calls, false)
    if calls[0] != 2 || changed[0] != 12 { return 22 }
    replaced: [3]i32 = ChangeArray(calls, true)
    if calls[0] != 2 || replaced[0] != 7 || replaced[2] != 0 { return 23 }
    forwarded: [3]i32 = ForwardArray(calls)
    if forwarded[0] != 22 || calls[0] != 2 { return 24 }
    order: i32 = ObserveArray(calls, calls[0]++)
    if order != 2 || calls[0] != 3 { return 25 }
    external: [4]i32 = ImportedCopy(four)
    if external[0] != 11 || four[0] != 1 { return 26 }
    if ForwardArray(replaced)[0] != 27 { return 27 }
    records: [2]Entry = {(Entry){.value = 3, .label = "yes"}}
    returned_records: [2]Entry = CopyEntries(records)
    returned_records[0].value = 9
    if records[0].value != 3 || returned_records[0].label != "yes" { return 28 }
    picked: [3]i32 = PickArray(calls, forwarded, true)
    other: [3]i32 = PickArray(calls, forwarded, false)
    if picked[0] != 3 || other[0] != 22 { return 29 }
    empty: [3]i32 = EmptyArray()
    if empty[0] != 0 || empty[2] != 0 { return 30 }
    words: [2]string = {"first", "second"}
    copied_words: [2]string = CopyWords(words)
    copied_words[0] = "changed"
    if words[0] != "first" || copied_words[1] != "second" { return 31 }
    return 0
}

Read :: (index: i32) -> i32 #export {
    values: [2]i32 = {7, 9}
    return CopyPair(values)[index]
}

Write :: (index: i32) -> i32 #export {
    values: [2]i32
    changed: [2]i32 = WritePair(values, index)
    return changed[0]
}

ChangeArray :: (values: [ALIAS_CAPACITY]i32, replace: bool) -> [CAPACITY]i32 {
    array_input_0_0: i32 = 10
    if replace {
        values = ([3]i32){7}
        return values
    }
    update: Action = () #slot {
        values[0] = values[0] + array_input_0_0
    }
    update()
    return values
}

ForwardArray :: (values: [3]i32) -> [3]i32 {
    return ChangeArray(ChangeArray(values, false), false)
}

ObserveArray :: (values: [3]i32, later: i32) -> i32 {
    if later != 2 { return -1 }
    return values[0]
}

CopyEntries :: (values: [2]Entry) -> [2]Entry {
    return values
}

CopyPair :: (values: [2]i32) -> [2]i32 {
    return values
}

WritePair :: (values: [2]i32, index: i32) -> [2]i32 {
    values[index] = 11
    return values
}

PickArray :: (first: [3]i32, second: [3]i32, choose: bool) -> [3]i32 {
    if choose {
        return first
    } else {
        return second
    }
}

EmptyArray :: () -> [3]i32 {
    values: [3]i32
    return values
}

CopyWords :: (values: [2]string) -> [2]string {
    return values
}
