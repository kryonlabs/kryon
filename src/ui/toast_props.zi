#import "geometry"

ToastState :: struct {
    message: string
    class_name: s32
    until_seconds: float64
}

ToastProps :: struct {
    key: u64
    viewport: Rectangle
    state: ToastState
    message: string
    class_name: s32
    seconds: float64
    now_seconds: float64
    scale: float32
    clear: bool
}

ToastResult :: struct {
    state: ToastState
    visible: bool
    node: s32
    bounds: Rectangle
    display: string
    ellipsis: bool
}
