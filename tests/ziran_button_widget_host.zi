#import "drawing_props"
#import "geometry"

fills: s32;
labels: s32;
images: s32;
icons: s32;
icon_phase: bool;
swatch_phase: bool;
swatch_fills: s32;
swatch_rings: s32;
detail_phase: bool;
detail_texts: s32;
detail_label_y: s32;
detail_line_y: s32;
detail_line_font: s32;
detail_label_alpha: u8;
detail_line_alpha: u8;
failed: bool;

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    if asset_path == "icons/ui.png" { return 512 }
    if asset_path != "badge.png" { failed = true }
    return 32
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    if asset_path == "icons/ui.png" { return 512 }
    if asset_path != "badge.png" { failed = true }
    return 16
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if swatch_phase && value.count == 0 { return 0 }
    if detail_phase && value == "Uses Sunup" && font == 11 && typeface.count == 0 {
        return 50
    }
    if value != "Run" || font != 14 || typeface.count != 0 {
        failed = true
    }
    return 21
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if detail_phase && font == 11 && typeface.count == 0 {
        return 10
    }
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if detail_phase {
        return
    }
    // A swatch fills with its own colour, never the style's background.
    if swatch_phase {
        if color.r != cast(u8)0xd8 || color.g != cast(u8)0x74 ||
            color.b != cast(u8)0xa4 || color.a != cast(u8)255 {
            failed = true
        }
        swatch_fills += 1
        return
    }
    // Icon-only buttons use their own face; the icon phase checks the atlas.
    if icon_phase {
        fills += 1
        return
    }
    if bounds.x != 10.0 || bounds.y != 20.0 ||
        bounds.width != 80.0 || bounds.height != 30.0 ||
        radius != 4.0 || segments != 12 ||
        color.r != cast(u8)0x12 || color.g != cast(u8)0x34 ||
        color.b != cast(u8)0x56 || color.a != cast(u8)127 {
        failed = true
    }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused radius
    unused segments
    // Only a chosen swatch draws rings: a light one inside, a dark edge.
    if !swatch_phase || bounds.width <= 0.0 || width <= 0.0 ||
        (color.r != cast(u8)255 && color.r != cast(u8)0) {
        failed = true
    }
    swatch_rings += 1
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if detail_phase {
        if value == "Run" && font == 14 {
            detail_label_y = y
            detail_label_alpha = color.a
        } else if value == "Uses Sunup" {
            detail_line_y = y
            detail_line_font = font
            detail_line_alpha = color.a
        } else {
            failed = true
        }
        unused x
        unused clip
        detail_texts += 1
        return
    }
    expected_x: s32 = 39
    if images > 0 { expected_x = 26 }
    if value != "Run" || x != expected_x || y != 29 || font != 14 ||
        clip.x != 10.0 || clip.y != 20.0 ||
        clip.width != 80.0 || clip.height != 30.0 ||
        color.r != cast(u8)0xaa || color.g != cast(u8)0xbb ||
        color.b != cast(u8)0xcc || color.a != cast(u8)127 {
        failed = true
    }
    labels += 1
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    if asset_path == "icons/ui.png" {
        // IconEdit is the seventh tile of the eight-column UI atlas.
        if source.x != 384.0 || source.y != 0.0 ||
            source.width != 64.0 || source.height != 64.0 ||
            destination.width <= 0.0 || destination.height <= 0.0 ||
            tint.r != cast(u8)0xaa || tint.g != cast(u8)0xbb ||
            tint.b != cast(u8)0xcc || tint.a != cast(u8)127 {
            failed = true
        }
        icons += 1
        return
    }
    if asset_path != "badge.png" || texture_id != cast(u32)0 ||
        source.x != 0.0 || source.y != 0.0 ||
        source.width != 32.0 || source.height != 16.0 ||
        destination.x != 55.5 || destination.y != 30.5 ||
        destination.width != 18.0 || destination.height != 9.0 ||
        clip.x != 10.0 || clip.y != 20.0 ||
        clip.width != 80.0 || clip.height != 30.0 ||
        origin.x != 0.0 || origin.y != 0.0 ||
        rotation != 0.0 || radius != 4.0 ||
        tint.r != cast(u8)255 || tint.g != cast(u8)255 ||
        tint.b != cast(u8)255 || tint.a != cast(u8)127 {
        failed = true
    }
    images += 1
}

#program_export
ButtonHostFailed :: () -> bool { return failed }

#program_export
ButtonFills :: () -> s32 { return fills }

#program_export
ButtonLabels :: () -> s32 { return labels }

#program_export
ButtonImages :: () -> s32 { return images }

#program_export
ButtonIcons :: () -> s32 { return icons }

#program_export
ExpectIcon :: () { icon_phase = true }

#program_export
ExpectSwatch :: () {
    // The drag checks before draw labels without the earlier image; only
    // the swatch frames that follow are checked.
    swatch_phase = true
    icon_phase = false
    failed = false
}

#program_export
SwatchFills :: () -> s32 { return swatch_fills }

#program_export
ExpectDetail :: () {
    detail_phase = true
    swatch_phase = false
    failed = false
}

// 0 when the label and its detail line were drawn as expected.
#program_export
DetailProblem :: () -> s32 {
    if detail_texts != 2 { return 1 }
    if detail_label_y != 34 || detail_line_y != 46 { return 2 }
    if detail_line_font != 11 { return 3 }
    if detail_line_alpha >= detail_label_alpha { return 4 }
    return 0
}

#program_export
SwatchRings :: () -> s32 { return swatch_rings }
