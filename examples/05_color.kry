#import "kryon.h"

app "Kryon Color Example" {
    size 800 600
    fps 60
    font examples
}

state {
    color_index: int = 0
}

ColorExample :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        colors: [5] Color = {GetThemeButton(),GetThemeButtonHover(),GetThemeCircle(),GetThemeSurface(),GetThemeLink()}
        base: Color = colors[color_index]
        light: Color = LightenUIColor(base,40)
        dark: Color = DarkenUIColor(base,40)
        Text((TextProps){.bounds={50, 20, 0, 0}, .text="Color Utilities", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(50, 70, 70, 70, base, BLANK)
        Rect(50, 70, 70, 70, BLANK, GetThemeText())
        Text((TextProps){.bounds={50+70+Scale(10), 70+Scale(10), 0, 0}, .text="Original", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(50, 160, 70, 70, light, BLANK)
        Rect(50, 160, 70, 70, BLANK, GetThemeText())
        Text((TextProps){.bounds={50+70+Scale(10), 160+Scale(10), 0, 0}, .text="Lightened", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(50, 250, 70, 70, dark, BLANK)
        Rect(50, 250, 70, 70, BLANK, GetThemeText())
        Text((TextProps){.bounds={50+70+Scale(10), 250+Scale(10), 0, 0}, .text="Darkened", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={320, 82, 0, 0}, .text=TextFormat("Color %d/5 - SPACE cycles",color_index+1), .font=18, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={320, 116, 0, 0}, .text=TextFormat("RGB:%d,%d,%d",base.r,base.g,base.b), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        if (IsKeyPressed(KEY_SPACE)) {
            color_index = (color_index + 1) % 5
        }
    }
}
