#import "manifest"

#program_export
ProjectManifestTest :: () -> s32 {
    source: string = "# app config\n[package]\nname = \"demo\"\nentry = \"src/custom.zi\"\nmodule_roots = [\"src\"]\n[tool.kryon]\ndefault_profile = \"tui\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\ncodegen = \"c99\"\nlibrary = \"crypto\"\n[tool.kryon.profiles.other]\nbackend = \"terminal\"\n"
    config: ProjectConfig = ParseProject(source)
    if !config.ok || config.name != "demo" ||
        config.entry != "src/custom.zi" ||
        config.profile_count != 2 ||
        config.default_profile != "tui" { return 1 }
    selected: ProjectProfile = ProjectProfileNamed(config, config.default_profile)
    if selected.name != "tui" || selected.backend != "terminal" ||
        selected.codegen != "c99" || selected.library != "crypto" { return 2 }
    if ProjectProfileNamed(config, "missing").name != "" { return 3 }

    minimal: ProjectConfig = ParseProject(
        "[package]\nname = \"demo\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n")
    if !minimal.ok || minimal.entry != "src/app.zi" ||
        minimal.default_profile != "tui" ||
        minimal.profiles[0].codegen != "c99" { return 4 }

    package: ProjectConfig = ParseProject(
        "[package]\nname = \"plot\"\nentry = \"src/app.zi\"\nmodule_roots = [\"src\"]\n[toolchain]\ngit = \"https://example.com/ziran.git\"\n[dependencies.Kryon]\ngit = \"https://example.com/kryon.git\"\n[tool.kryon]\ndefault_profile = \"cairo\"\n[tool.kryon.profiles.cairo]\nbackend = \"desktop\"\n")
    if !package.ok || package.name != "plot" ||
        package.default_profile != "cairo" ||
        package.profiles[0].backend != "desktop" { return 5 }

    bad_path: ProjectConfig = ParseProject(
        "[package]\nname = \"demo\"\nentry = \"src/$oops.zi\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n")
    if bad_path.ok { return 6 }
    missing_default: ProjectConfig = ParseProject(
        "[package]\nname = \"demo\"\n[tool.kryon]\ndefault_profile = \"other\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n")
    if missing_default.ok { return 7 }
    duplicate: ProjectConfig = ParseProject(
        "[package]\nname = \"demo\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n")
    if duplicate.ok { return 8 }
    unsafe_library: ProjectConfig = ParseProject(
        "[package]\nname = \"demo\"\n[tool.kryon.profiles.tui]\nbackend = \"terminal\"\nlibrary = \"crypto;touch /tmp/unsafe\"\n")
    if unsafe_library.ok { return 9 }
    legacy: ProjectConfig = ParseProject(
        "[project]\nname = \"demo\"\n[profiles.tui]\nbackend = \"terminal\"\n")
    if legacy.ok { return 10 }
    missing_name: ProjectConfig = ParseProject(
        "[tool.kryon.profiles.tui]\nbackend = \"terminal\"\n")
    if missing_name.ok { return 11 }
    return 42
}
