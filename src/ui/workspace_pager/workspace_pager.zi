#import "tree"
#import "geometry"
#import "drawing_props"
#import "session"
Button :: #import "button";
Box :: #import "box";

Window :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
    workspace: s32
    focused: bool
}

Props :: struct {
    key: u64
    bounds: Rectangle
    count: s32
    current: s32
    rows: s32
    desktop_width: s32
    desktop_height: s32
    disabled: bool
    background: u32
    border: u32
    active: u32
    window: u32
    focused_window: u32
}

#program_export
WorkspacePagerRows :: (props: Props) -> s32 {
    if props.count < 1 { return 0 }
    rows := props.rows
    if rows < 1 { rows = 2 }
    if rows > props.count { rows = props.count }
    return rows
}

#program_export
Width :: (props: Props) -> float32 {
    rows := WorkspacePagerRows(props)
    if rows == 0 { return 0.0 }
    columns := (props.count + rows - 1) / rows
    height := (props.bounds.height - 2.0) / cast(float32)rows
    if height < 1.0 { height = 1.0 }
    aspect: float32 = 1.6
    if props.desktop_width > 0 && props.desktop_height > 0 {
        aspect = cast(float32)props.desktop_width / cast(float32)props.desktop_height
    }
    return (height * aspect + 1.0) * cast(float32)columns + 2.0
}

#program_export
Cell :: (props: Props, index: s32) -> Rectangle {
    rows := WorkspacePagerRows(props)
    if rows == 0 || index < 0 || index >= props.count { return .{} }
    columns := (props.count + rows - 1) / rows
    width := (props.bounds.width - 2.0) / cast(float32)columns
    height := (props.bounds.height - 2.0) / cast(float32)rows
    if width <= 1.0 || height <= 1.0 { return .{} }
    return .{props.bounds.x + 1.0 + cast(float32)(index % columns) * width,
        props.bounds.y + 1.0 + cast(float32)(index / columns) * height,
        width - 1.0, height - 1.0}
}

#program_export
WindowBounds :: (props: Props, window: Window, workspace: s32) -> Rectangle {
    cell := Cell(props, workspace)
    if cell.width <= 2.0 || cell.height <= 2.0 || props.desktop_width <= 0 ||
        props.desktop_height <= 0 || window.width <= 0 || window.height <= 0 ||
        (window.workspace != -1 && window.workspace != workspace) { return .{} }
    left := cast(float32)window.x / cast(float32)props.desktop_width
    top := cast(float32)window.y / cast(float32)props.desktop_height
    right := (cast(float32)window.x + cast(float32)window.width) / cast(float32)props.desktop_width
    bottom := (cast(float32)window.y + cast(float32)window.height) / cast(float32)props.desktop_height
    if left < 0.0 { left = 0.0 }; if top < 0.0 { top = 0.0 }
    if right > 1.0 { right = 1.0 }; if bottom > 1.0 { bottom = 1.0 }
    if right <= left || bottom <= top { return .{} }
    return .{cell.x + 1.0 + left * (cell.width - 2.0),
        cell.y + 1.0 + top * (cell.height - 2.0),
        (right - left) * (cell.width - 2.0), (bottom - top) * (cell.height - 2.0)}
}

#program_export
#scope_package
Draw :: (session: Session, props: Props, windows: []Window, location := #caller_location) -> s32 {
    site := TreeCallSite(session, location)
    defer { TreeCallSiteEnd(session, site) }
    if props.background == cast(u32)0 { props.background = cast(u32)0x0c0e14ff }
    if props.border == cast(u32)0 { props.border = cast(u32)0x252834ff }
    if props.active == cast(u32)0 { props.active = cast(u32)0xc50ed2ff }
    if props.window == cast(u32)0 { props.window = cast(u32)0x626878ff }
    if props.focused_window == cast(u32)0 { props.focused_window = cast(u32)0xe1d9edff }
    selected: s32 = -1
    if props.count < 1 || props.count > 128 { return selected }
    for index: cast(s32)0..props.count - 1 {
        cell := Cell(props, index)
        if cell.width <= 0.0 || cell.height <= 0.0 { continue }
        key := props.key + cast(u64)(index * 1024)
        button := Button.Props.{.key = key + cast(u64)1, .bounds = cell,
            .label = "Workspace", .selected = index == props.current,
            .disabled = props.disabled, .invisible = true}
        if Button.Draw(session, button) > 0 { selected = index }
        border := props.border
        if index == props.current { border = props.active }
        Box.Draw(session, Box.Props.{.key = key + cast(u64)2, .bounds = cell,
            .fill = ColorFromPacked(props.background), .border = ColorFromPacked(border)})
        for item: cast(s32)0..cast(s32)windows.count - 1 {
            window := windows[item]
            rectangle := WindowBounds(props, window, index)
            if rectangle.width <= 0.0 || rectangle.height <= 0.0 { continue }
            color := props.window
            if window.focused { color = props.focused_window }
            Box.Draw(session, Box.Props.{.key = key + cast(u64)(16 + item),
                .bounds = rectangle, .fill = ColorFromPacked(color)})
        }
    }
    return selected
}
