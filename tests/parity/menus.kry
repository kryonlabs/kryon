#import "kryon.h"

app "Generated Menu Parity" {
    size 360 280
    fps 60
}

state {
    open_menu: int = -1
    context_open: int = 0
    context_x: int = 0
    context_y: int = 0
}

menus_frame :: () #ui {
    Screen menus_root: {
        bounds = {0,0,360,280}
        child_items: [1] MenuItem = {{MenuCommand,"Child",NULL,23,0,0,NULL,0}}
        items: [4] MenuItem = {{MenuCommand,"Open","Ctrl+O",21,0,0,NULL,0},{MenuSeparator,NULL,NULL,0,0,0,NULL,0},{MenuCheck,"Grid",NULL,22,0,1,NULL,0},{MenuSubmenu,"More",NULL,24,0,0,child_items,1}}
        menus: [1] Menu = {{(Rectangle){0,0,0,0},"File",items,4}}
        result: MenuBarResult = MenuBar(940,(Rectangle){0,0,360,30},menus,1,&open_menu)
        PopupMenu(941,20,50,items,4)
        ContextMenu((ContextMenuProps){.id = 942, .trigger = {20,190,180,60}, .items = items, .item_count = 4, .open = &context_open, .x = &context_x, .y = &context_y})
        Tooltip((TooltipProps){.trigger = {220,50,120,40}, .text = "Menu help", .font = Text14, .max_width = 120})
        Progress((ProgressBarProps){{220,200,100,10},0,100,result.activated_id,""})
    }
}
