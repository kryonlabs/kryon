// Batched textured triangles for the Canvas host. The page remains Canvas2D;
// a private WebGL surface paints each mesh before the page composites it.
#import "geometry"
#import "drawing_props"
#import "image_props"
#import "page_core"
#import "page_texture"
#import "paint_queue"
#import "raylib_clip"
#import "web"

PAGE_MESH_TEXTURES :: 32
PAGE_MESH_RUNS :: 64
PAGE_MESH_BUCKET :: 32

PageMeshTexture :: struct {
    id: s32
    revision: u64
    texture: s32
    bytes: s64
    sampling: s32
    width: s32
    height: s32
}

PageMeshVertex :: struct {
    position: Vector2
    uv: Vector2
    color: Color
}

PageMeshRun :: struct {
    id: s32
    filter: s32
    first: s32
    count: s32
}

page_mesh_attempted: bool;
page_mesh_canvas: s32;
page_mesh_gl: s32;
page_mesh_program: s32;
page_mesh_buffer: s32;
page_mesh_element_buffer: s32;
page_mesh_color: s32;
page_mesh_view: s32;
page_mesh_lost_handler: s32;
page_mesh_position: s32;
page_mesh_uv: s32;
page_mesh_draws: s32;
page_mesh_size_limit: s32;
page_mesh_texture_limit: s32;
page_mesh_pending: bool;
page_mesh_context: s32;
page_mesh_clip: Rectangle;
page_mesh_x: s32;
page_mesh_y: s32;
page_mesh_width: s32;
page_mesh_height: s32;
page_mesh_pixels_w: s32;
page_mesh_pixels_h: s32;
page_mesh_left: float32;
page_mesh_top: float32;
page_mesh_right: float32;
page_mesh_bottom: float32;
page_mesh_textures: [PAGE_MESH_TEXTURES]PageMeshTexture;
// This bounded vertex stream fits WebGL's core 16-bit index range.
page_mesh_vertices: [IMAGE_MESH_POINT_LIMIT * 6]PageMeshVertex;
page_mesh_indices: [IMAGE_MESH_POINT_LIMIT * 6]u16;
page_mesh_vertex_count: s32;
page_mesh_index_count: s32;
page_mesh_runs: [PAGE_MESH_RUNS]PageMeshRun;
page_mesh_run_count: s32;

PageMeshReset :: () {
    PageMeshFlush()
    page_paint_hooks = PagePaintHooks.{}
    if page_mesh_gl != 0 {
        if page_mesh_lost_handler != 0 {
            unused WebCall2(page_mesh_canvas, page_names.remove_event_listener,
                WebText("webglcontextlost"), WebObject(page_mesh_lost_handler))
            WebRelease(page_mesh_lost_handler)
            page_mesh_lost_handler = 0
        }
        for index: cast(s32)0..PAGE_MESH_TEXTURES - 1 {
            texture := page_mesh_textures[index].texture
            if texture != 0 {
                unused WebCall1(page_mesh_gl, WebName("deleteTexture"), WebObject(texture))
                WebRelease(texture)
            }
            page_mesh_textures[index] = PageMeshTexture.{}
        }
        unused WebCall1(page_mesh_gl, WebName("deleteBuffer"), WebObject(page_mesh_buffer))
        unused WebCall1(page_mesh_gl, WebName("deleteBuffer"), WebObject(page_mesh_element_buffer))
        unused WebCall1(page_mesh_gl, WebName("deleteProgram"), WebObject(page_mesh_program))
        WebRelease(page_mesh_buffer)
        WebRelease(page_mesh_element_buffer)
        WebRelease(page_mesh_program)
        WebRelease(page_mesh_view)
        WebRelease(page_mesh_gl)
        WebRelease(page_mesh_canvas)
    }
    page_mesh_gl = 0
    page_mesh_canvas = 0
    page_mesh_attempted = false
    page_mesh_draws = 0
    page_mesh_vertex_count = 0
    page_mesh_index_count = 0
    page_mesh_run_count = 0
}

PageMeshLost :: (context: s32, event: s32, second: s32, third: s32) {
    unused context
    unused event
    unused second
    unused third
    page_mesh_pending = false
    page_mesh_vertex_count = 0
    page_mesh_index_count = 0
    page_mesh_run_count = 0
    PaintResourcesChanged()
    PageMeshReset()
}

PageMeshShader :: (gl: s32, kind: s32, text: string) -> s32 {
    shader := WebAsObject(WebCall1(gl, WebName("createShader"), WebNumber(cast(float64)(kind))))
    if shader == 0 { return 0 }
    unused WebCall2(gl, WebName("shaderSource"), WebObject(shader), WebText(text))
    unused WebCall1(gl, WebName("compileShader"), WebObject(shader))
    if !WebAsBool(WebCall2(gl, WebName("getShaderParameter"),
        WebObject(shader), WebNumber(35713))) {
        unused WebCall1(gl, WebName("deleteShader"), WebObject(shader))
        return 0
    }
    return shader
}

PageMeshOpen :: () -> bool {
    if page_mesh_attempted { return page_mesh_gl != 0 }
    page_mesh_attempted = true
    scope := WebScope()
    canvas := PageMakeCanvas(1, 1)
    if canvas == 0 { WebEnd(scope); return false }
    options := WebNewObject()
    WebSet(options, WebName("alpha"), WebBool(true))
    // Feathered image edges already provide smoothing for the shared surface.
    WebSet(options, WebName("antialias"), WebBool(false))
    WebSet(options, WebName("premultipliedAlpha"), WebBool(true))
    // Each batch is cleared, drawn and copied in one turn. Keeping a second
    // preserved drawing buffer between frames is unnecessary.
    WebSet(options, WebName("preserveDrawingBuffer"), WebBool(false))
    gl := WebAsObject(WebCall2(canvas, page_names.get_context,
        WebText("webgl"), WebObject(options)))
    if gl == 0 { WebEnd(scope); return false }
    vertex := PageMeshShader(gl, 35633,
        "attribute vec2 position; attribute vec2 uv; attribute vec4 color; uniform vec4 view; varying vec2 texel; varying vec4 paint; void main(){gl_Position=vec4((position-view.xy)*view.zw+vec2(-1.0,1.0),0.0,1.0);texel=uv;paint=color;}")
    fragment := PageMeshShader(gl, 35632,
        "precision highp float; varying vec2 texel; varying vec4 paint; uniform sampler2D image; void main(){vec4 c=texture2D(image,texel);gl_FragColor=vec4(c.rgb*paint.rgb*paint.a,c.a*paint.a);}")
    if vertex == 0 || fragment == 0 {
        if vertex != 0 { unused WebCall1(gl, WebName("deleteShader"), WebObject(vertex)) }
        if fragment != 0 { unused WebCall1(gl, WebName("deleteShader"), WebObject(fragment)) }
        WebEnd(scope)
        return false
    }
    program := WebAsObject(WebCall0(gl, WebName("createProgram")))
    if program == 0 {
        unused WebCall1(gl, WebName("deleteShader"), WebObject(vertex))
        unused WebCall1(gl, WebName("deleteShader"), WebObject(fragment))
        WebEnd(scope)
        return false
    }
    unused WebCall2(gl, WebName("attachShader"), WebObject(program), WebObject(vertex))
    unused WebCall2(gl, WebName("attachShader"), WebObject(program), WebObject(fragment))
    unused WebCall1(gl, WebName("linkProgram"), WebObject(program))
    unused WebCall1(gl, WebName("deleteShader"), WebObject(vertex))
    unused WebCall1(gl, WebName("deleteShader"), WebObject(fragment))
    if !WebAsBool(WebCall2(gl, WebName("getProgramParameter"),
        WebObject(program), WebNumber(35714))) {
        unused WebCall1(gl, WebName("deleteProgram"), WebObject(program))
        WebEnd(scope)
        return false
    }
    buffer := WebAsObject(WebCall0(gl, WebName("createBuffer")))
    elements := WebAsObject(WebCall0(gl, WebName("createBuffer")))
    view := WebAsObject(WebCall2(gl, WebName("getUniformLocation"),
        WebObject(program), WebText("view")))
    if buffer == 0 || elements == 0 || view == 0 {
        if buffer != 0 { unused WebCall1(gl, WebName("deleteBuffer"), WebObject(buffer)) }
        if elements != 0 { unused WebCall1(gl, WebName("deleteBuffer"), WebObject(elements)) }
        unused WebCall1(gl, WebName("deleteProgram"), WebObject(program))
        WebEnd(scope)
        return false
    }
    page_mesh_canvas = WebKeep(canvas)
    page_mesh_gl = WebKeep(gl)
    page_mesh_program = WebKeep(program)
    page_mesh_buffer = WebKeep(buffer)
    page_mesh_element_buffer = WebKeep(elements)
    page_mesh_view = WebKeep(view)
    page_mesh_color = cast(s32)WebAsNumber(WebCall2(gl, WebName("getAttribLocation"),
        WebObject(program), WebText("color")))
    page_mesh_position = cast(s32)WebAsNumber(WebCall2(gl, WebName("getAttribLocation"),
        WebObject(program), WebText("position")))
    page_mesh_uv = cast(s32)WebAsNumber(WebCall2(gl, WebName("getAttribLocation"),
        WebObject(program), WebText("uv")))
    page_mesh_size_limit = cast(s32)WebAsNumber(WebCall1(gl, WebName("getParameter"), WebNumber(34024)))
    page_mesh_texture_limit = cast(s32)WebAsNumber(WebCall1(gl, WebName("getParameter"), WebNumber(3379)))
    page_mesh_lost_handler = WebFunction(PageMeshLost, 0)
    unused WebCall2(canvas, page_names.add_event_listener,
        WebText("webglcontextlost"), WebObject(page_mesh_lost_handler))
    page_paint_hooks.flush = PageMeshFlush
    WebEnd(scope)
    return true
}

PageMeshSource :: (source: Rectangle, fx: float32, fy: float32) -> Vector2 {
    x := source.x + source.width * fx
    if source.width < 0.0 { x = source.x - source.width + source.width * fx }
    y := source.y + source.height * fy
    if source.height < 0.0 { y = source.y - source.height + source.height * fy }
    return Vector2.{x, y}
}

PageMeshUpload :: (slot: s32, filter: s32) -> bool {
    id := page_textures[slot].id
    index := id % PAGE_MESH_TEXTURES
    cached := *page_mesh_textures[index]
    gl := page_mesh_gl
    if cached.texture == 0 {
        cached.texture = WebKeep(WebAsObject(WebCall0(gl, WebName("createTexture"))))
    }
    if cached.texture == 0 { return false }
    unused WebCall2(gl, WebName("bindTexture"), WebNumber(3553), WebObject(cached.texture))
    if cached.id != id || cached.revision != page_textures[slot].revision {
        width := WebGetNumber(page_textures[slot].canvas, page_names.width)
        height := WebGetNumber(page_textures[slot].canvas, page_names.height)
        bytes := cast(s64)(width * height * 4.0)
        if width > cast(float64)page_mesh_texture_limit ||
        height > cast(float64)page_mesh_texture_limit || bytes > 16777216 {
            return false
        }
        total: s64 = 0
        for entry: page_mesh_textures { total += entry.bytes }
        for other: cast(s32)0..PAGE_MESH_TEXTURES - 1 {
            if total - cached.bytes + bytes <= 16777216 { break }
            entry := *page_mesh_textures[other]
            if other != index && entry.texture != 0 {
                unused WebCall1(gl, WebName("deleteTexture"), WebObject(entry.texture))
                WebRelease(entry.texture)
                total -= entry.bytes
                entry.* = PageMeshTexture.{}
            }
        }
        args: [6]WebValue
        args[0] = WebNumber(3553)
        args[1] = WebNumber(0)
        args[2] = WebNumber(6408)
        args[3] = WebNumber(6408)
        args[4] = WebNumber(5121)
        args[5] = WebObject(page_textures[slot].canvas)
        // Interpolate premultiplied pixels so transparent source colours
        // cannot bleed into the visible edge of a smoothly sampled image.
        unused WebCall2(gl, WebName("pixelStorei"),
            WebNumber(WebGetNumber(gl, WebName("UNPACK_PREMULTIPLY_ALPHA_WEBGL"))), WebBool(true))
        unused WebCall(gl, WebName("texImage2D"), *args[0], 6)
        if WebFailed() { return false }
        if WebAsNumber(WebCall0(gl, WebName("getError"))) != 0.0 { return false }
        for parameter: cast(s32)10242..10243 {
            unused WebCall3(gl, WebName("texParameteri"), WebNumber(3553),
                WebNumber(cast(float64)(parameter)), WebNumber(33071))
        }
        cached.id = id
        cached.revision = page_textures[slot].revision
        cached.bytes = bytes
        cached.width = cast(s32)width
        cached.height = cast(s32)height
    }
    sampling: s32 = ifx filter == 0 then 9728 else 9729
    if cached.sampling != sampling {
        for parameter: cast(s32)10240..10241 {
            unused WebCall3(gl, WebName("texParameteri"), WebNumber(3553),
                WebNumber(cast(float64)parameter), WebNumber(cast(float64)sampling))
        }
        cached.sampling = sampling
    }
    return true
}

// Flush before another painter, transform, target, readback or presentation.
// The GPU surface covers the visible meshes, aligned to the original pixel
// grid. Texture runs keep their order and share one copy to the page.
PageMeshFlush :: () {
    if !page_mesh_pending { return }
    page_mesh_pending = false
    if page_mesh_index_count == 0 {
        page_mesh_vertex_count = 0
        return
    }
    scope := WebScope()
    sx := cast(float64)page_mesh_pixels_w / cast(float64)page_mesh_width
    sy := cast(float64)page_mesh_pixels_h / cast(float64)page_mesh_height
    left := cast(s32)((cast(float64)page_mesh_left - cast(float64)page_mesh_x) * sx) - 1
    top := cast(s32)((cast(float64)page_mesh_top - cast(float64)page_mesh_y) * sy) - 1
    right := cast(s32)((cast(float64)page_mesh_right - cast(float64)page_mesh_x) * sx) + 2
    bottom := cast(s32)((cast(float64)page_mesh_bottom - cast(float64)page_mesh_y) * sy) + 2
    if left < 0 { left = 0 }
    if top < 0 { top = 0 }
    if right > page_mesh_pixels_w { right = page_mesh_pixels_w }
    if bottom > page_mesh_pixels_h { bottom = page_mesh_pixels_h }
    pixels_w := right - left
    pixels_h := bottom - top
    // Small motion must not reallocate the multisample drawing buffer on
    // every frame. Keep one 32-pixel bucket of slack before shrinking.
    pixels_w = (pixels_w + PAGE_MESH_BUCKET - 1) / PAGE_MESH_BUCKET * PAGE_MESH_BUCKET
    pixels_h = (pixels_h + PAGE_MESH_BUCKET - 1) / PAGE_MESH_BUCKET * PAGE_MESH_BUCKET
    if pixels_w > page_mesh_pixels_w { pixels_w = page_mesh_pixels_w }
    if pixels_h > page_mesh_pixels_h { pixels_h = page_mesh_pixels_h }
    current_w := cast(s32)WebGetNumber(page_mesh_canvas, page_names.width)
    current_h := cast(s32)WebGetNumber(page_mesh_canvas, page_names.height)
    if current_w >= pixels_w && current_w <= pixels_w + PAGE_MESH_BUCKET && current_w <= page_mesh_pixels_w {
        pixels_w = current_w
    }
    if current_h >= pixels_h && current_h <= pixels_h + PAGE_MESH_BUCKET && current_h <= page_mesh_pixels_h {
        pixels_h = current_h
    }
    if left + pixels_w > page_mesh_pixels_w { left = page_mesh_pixels_w - pixels_w }
    if top + pixels_h > page_mesh_pixels_h { top = page_mesh_pixels_h - pixels_h }
    x := cast(float64)page_mesh_x + cast(float64)left / sx
    y := cast(float64)page_mesh_y + cast(float64)top / sy
    width := cast(float64)pixels_w / sx
    height := cast(float64)pixels_h / sy
    gl := page_mesh_gl
    if current_w != pixels_w {
        WebSet(page_mesh_canvas, page_names.width, WebNumber(cast(float64)pixels_w))
    }
    if current_h != pixels_h {
        WebSet(page_mesh_canvas, page_names.height, WebNumber(cast(float64)pixels_h))
    }
    unused WebCall4(gl, WebName("viewport"), WebNumber(0), WebNumber(0),
        WebNumber(cast(float64)pixels_w), WebNumber(cast(float64)pixels_h))
    unused WebCall4(gl, WebName("clearColor"), WebNumber(0), WebNumber(0), WebNumber(0), WebNumber(0))
    unused WebCall1(gl, WebName("clear"), WebNumber(16384))
    unused WebCall1(gl, WebName("useProgram"), WebObject(page_mesh_program))
    unused WebCall2(gl, WebName("bindBuffer"), WebNumber(34962), WebObject(page_mesh_buffer))
    stride := cast(s32)size_of(type_of(page_mesh_vertices[0]))
    attributes: [6]WebValue
    attributes[4] = WebNumber(cast(float64)stride)
    for attribute: cast(s32)0..2 {
        location := page_mesh_position
        if attribute == 1 { location = page_mesh_uv }
        if attribute == 2 { location = page_mesh_color }
        attributes[0] = WebNumber(cast(float64)location)
        attributes[1] = WebNumber(ifx attribute == 2 then 4.0 else 2.0)
        attributes[2] = WebNumber(ifx attribute == 2 then 5121.0 else 5126.0)
        attributes[3] = WebBool(attribute == 2)
        attributes[5] = WebNumber(cast(float64)(attribute * 8))
        unused WebCall1(gl, WebName("enableVertexAttribArray"), WebNumber(cast(float64)location))
        unused WebCall(gl, WebName("vertexAttribPointer"), *attributes[0], 6)
    }
    view: [5]WebValue = .{WebObject(page_mesh_view), WebNumber(x), WebNumber(y),
        WebNumber(2.0 / width), WebNumber(-2.0 / height)}
    unused WebCall(gl, WebName("uniform4f"), *view[0], 5)
    unused WebCall1(gl, WebName("enable"), WebNumber(3042))
    unused WebCall2(gl, WebName("blendFunc"), WebNumber(1), WebNumber(771))
    vertices := WebBytes(WebBytesUint8, cast(*void)(*page_mesh_vertices[0]),
        page_mesh_vertex_count * stride)
    unused WebCall3(gl, WebName("bufferData"), WebNumber(34962), WebObject(vertices), WebNumber(35040))
    unused WebCall2(gl, WebName("bindBuffer"), WebNumber(34963), WebObject(page_mesh_element_buffer))
    indices := WebBytes(WebBytesInt16, cast(*void)(*page_mesh_indices[0]), page_mesh_index_count)
    unused WebCall3(gl, WebName("bufferData"), WebNumber(34963), WebObject(indices), WebNumber(35040))
    for index: cast(s32)0..page_mesh_run_count - 1 {
        run := page_mesh_runs[index]
        slot := PageTextureFind(run.id)
        if slot >= 0 && PageMeshUpload(slot, run.filter) {
            unused WebCall4(gl, WebName("drawElements"), WebNumber(4),
                WebNumber(cast(float64)run.count), WebNumber(5123), WebNumber(cast(float64)(run.first * 2)))
            page_mesh_draws += 1
        }
    }
    page_mesh_vertex_count = 0
    page_mesh_index_count = 0
    page_mesh_run_count = 0
    saved := BeginRasterClip(page_mesh_clip)
    ctx := page_mesh_context
    unused WebCall0(ctx, page_names.save)
    WebSet(ctx, WebName("globalAlpha"), WebNumber(1.0))
    args: [5]WebValue
    args[0] = WebObject(page_mesh_canvas)
    args[1] = WebNumber(x)
    args[2] = WebNumber(y)
    args[3] = WebNumber(width)
    args[4] = WebNumber(height)
    unused WebCall(ctx, WebName("drawImage"), *args[0], 5)
    unused WebCall0(ctx, page_names.restore)
    EndRasterClip(saved)
    WebEnd(scope)
}

PageMeshDraw :: (id: s32, source: Rectangle, points: []Vector2,
    columns: s32, rows: s32, clip: Rectangle, tint: Color, filter: s32) -> bool {
    slot := PageTextureFind(id)
    if slot < 0 || !PageMeshOpen() { return false }
    scope := WebScope()
    cached := *page_mesh_textures[id % PAGE_MESH_TEXTURES]
    texture_w := cast(float32)cached.width
    texture_h := cast(float32)cached.height
    if cached.id != id || cached.revision != page_textures[slot].revision {
        texture_w = cast(float32)WebGetNumber(page_textures[slot].canvas, page_names.width)
        texture_h = cast(float32)WebGetNumber(page_textures[slot].canvas, page_names.height)
    }
    // Canvas clips an out-of-bounds source; clamping its UVs would instead
    // stretch edge pixels into that empty area. Preserve the Canvas painter.
    corners: [2]Vector2 = .{PageMeshSource(source, 0.0, 0.0), PageMeshSource(source, 1.0, 1.0)}
    for corner: corners {
        if corner.x != corner.x || corner.y != corner.y ||
        corner.x < 0.0 || corner.y < 0.0 || corner.x > texture_w || corner.y > texture_h {
            WebEnd(scope)
            return false
        }
    }
    gl := page_mesh_gl
    if !page_mesh_pending && WebAsBool(WebCall0(gl, WebName("isContextLost"))) {
        WebEnd(scope)
        PageMeshLost(0, 0, 0, 0)
        return false
    }
    mesh_left := points[0].x
    mesh_top := points[0].y
    mesh_right := mesh_left
    mesh_bottom := mesh_top
    for point: points {
        if point.x != point.x || point.y != point.y ||
        point.x < -10000000.0 || point.x > 10000000.0 ||
        point.y < -10000000.0 || point.y > 10000000.0 {
            WebEnd(scope)
            return false
        }
        if point.x < mesh_left { mesh_left = point.x }
        if point.y < mesh_top { mesh_top = point.y }
        if point.x > mesh_right { mesh_right = point.x }
        if point.y > mesh_bottom { mesh_bottom = point.y }
    }
    left := clip.x
    top := clip.y
    right := clip.x + clip.width
    bottom := clip.y + clip.height
    if mesh_left < left { mesh_left = left }
    if mesh_top < top { mesh_top = top }
    if mesh_right > right { mesh_right = right }
    if mesh_bottom > bottom { mesh_bottom = bottom }
    if mesh_right <= mesh_left || mesh_bottom <= mesh_top {
        WebEnd(scope)
        return true
    }
    x := cast(s32)left
    y := cast(s32)top
    if cast(float32)x > left { x -= 1 }
    if cast(float32)y > top { y -= 1 }
    width := cast(s32)(right - cast(float32)x)
    height := cast(s32)(bottom - cast(float32)y)
    if cast(float32)(x + width) < right { width += 1 }
    if cast(float32)(y + height) < bottom { height += 1 }
    scale := PageSurfaceScale()
    if page_mode.active {
        zoom := page_mode.zoom_x
        if zoom < 0.0 { zoom = -zoom }
        zy := page_mode.zoom_y
        if zy < 0.0 { zy = -zy }
        if zy > zoom { zoom = zy }
        scale *= zoom
    }
    pixels_w := cast(s32)(cast(float64)width * scale + 0.999)
    pixels_h := cast(s32)(cast(float64)height * scale + 0.999)
    if width <= 0 || height <= 0 || pixels_w <= 0 || pixels_h <= 0 ||
    pixels_w > 4096 || pixels_h > 4096 ||
    pixels_w > page_mesh_size_limit || pixels_h > page_mesh_size_limit ||
    cast(s64)pixels_w * cast(s64)pixels_h > 4194304 {
        WebEnd(scope)
        return false
    }
    ctx := PageDrawingContext()
    needed := (columns - 1) * (rows - 1) * 6
    point_count := columns * rows
    new_run := page_mesh_run_count == 0
    if page_mesh_run_count > 0 {
        last := page_mesh_runs[page_mesh_run_count - 1]
        new_run = last.id != id || last.filter != filter
    }
    // A cache replacement must not mutate pixels needed by queued runs.
    cache_missing := cached.id != id || cached.revision != page_textures[slot].revision
    if page_mesh_pending && (ctx != page_mesh_context ||
        clip.x != page_mesh_clip.x || clip.y != page_mesh_clip.y ||
        clip.width != page_mesh_clip.width || clip.height != page_mesh_clip.height ||
        page_mesh_vertex_count + point_count > cast(s32)page_mesh_vertices.count ||
        page_mesh_index_count + needed > cast(s32)page_mesh_indices.count ||
        (new_run && page_mesh_run_count == PAGE_MESH_RUNS) || cache_missing) {
        PageMeshFlush()
    }
    if !page_mesh_pending || new_run {
        if !PageMeshUpload(slot, filter) { WebEnd(scope); return false }
    }
    if !page_mesh_pending {
        page_mesh_context = ctx
        page_mesh_clip = clip
        page_mesh_x = x
        page_mesh_y = y
        page_mesh_width = width
        page_mesh_height = height
        page_mesh_pixels_w = pixels_w
        page_mesh_pixels_h = pixels_h
        page_mesh_left = mesh_left
        page_mesh_top = mesh_top
        page_mesh_right = mesh_right
        page_mesh_bottom = mesh_bottom
        page_mesh_pending = true
    } else {
        if mesh_left < page_mesh_left { page_mesh_left = mesh_left }
        if mesh_top < page_mesh_top { page_mesh_top = mesh_top }
        if mesh_right > page_mesh_right { page_mesh_right = mesh_right }
        if mesh_bottom > page_mesh_bottom { page_mesh_bottom = mesh_bottom }
    }
    // Keep each grid point once. The index stream reuses shared vertices
    // on the GPU, while preserving the triangles' exact painter order.
    first_vertex := page_mesh_vertex_count
    for row: cast(s32)0..rows - 1 {
        for column: cast(s32)0..columns - 1 {
            index := row * columns + column
            point := points[index]
            uv := PageMeshSource(source, cast(float32)column / cast(float32)(columns - 1),
                cast(float32)row / cast(float32)(rows - 1))
            page_mesh_vertices[first_vertex + index] = PageMeshVertex.{point,
                Vector2.{uv.x / texture_w, uv.y / texture_h}, tint}
        }
    }
    first_index := page_mesh_index_count
    count := first_index
    for row: cast(s32)0..rows - 2 {
        for column: cast(s32)0..columns - 2 {
            tl := row * columns + column
            indices: [6]s32 = .{tl, tl + 1, tl + columns, tl + 1, tl + columns + 1, tl + columns}
            for triangle: cast(s32)0..1 {
                first := triangle * 3
                a := points[indices[first]]
                b := points[indices[first + 1]]
                c := points[indices[first + 2]]
                // A folded grid can have repeated or collinear points.
                // Such triangles cover no pixels and need no GPU work.
                area := (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
                if area != 0.0 {
                    page_mesh_indices[count] = cast(u16)(first_vertex + indices[first])
                    page_mesh_indices[count + 1] = cast(u16)(first_vertex + indices[first + 1])
                    page_mesh_indices[count + 2] = cast(u16)(first_vertex + indices[first + 2])
                    count += 3
                }
            }
        }
    }
    page_mesh_index_count = count
    if count > first_index {
        page_mesh_vertex_count = first_vertex + point_count
        append := true
        if page_mesh_run_count > 0 {
            last := *page_mesh_runs[page_mesh_run_count - 1]
            if last.id == id && last.filter == filter {
                last.count += count - first_index
                append = false
            }
        }
        if append {
            page_mesh_runs[page_mesh_run_count] = PageMeshRun.{id, filter, first_index, count - first_index}
            page_mesh_run_count += 1
        }
    }
    WebEnd(scope)
    return true
}
