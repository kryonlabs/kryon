#import "kryon.h"

app "Text Area and Slider" {
    size 800 600
    fps 60
    theme THEME_OCEAN light
}

state {
    hue: int = 200
    note: [4096] char = "Type something here..."
    note_cursor: int = 0
    note_focused: int = 0
    note_scroll: int = 0
}

TextAreaSliderExample :: (viewport: Rectangle) #ui {
    bg: Color = ColorFromHSV((float)hue, 0.6f, 0.9f)
    panel: Rectangle = {viewport.width / 2.0f - 240.0f, viewport.height - 80.0f, 480.0f, 60.0f}
    ta_bounds: Rectangle = {40.0f, 80.0f, viewport.width - 80.0f, viewport.height - 180.0f}
    ta_style: TextInputStyle = {{255,255,255,220}, {180,180,180,255}, {80,80,80,255}, {20,20,20,255}, {0,0,0,255}, 6.0f, 8, 8}
    Screen root: {
        bounds = viewport
        Background(bg)
        Text("Text area and slider", 40, 40, Text24, (Color){255, 255, 255, 255})
        TextArea((TextAreaProps){ta_bounds, note, sizeof(note), &note_cursor, &note_focused, &note_scroll, 4000, Text16, 6, 200, "Type something here...", SyntaxNone, ta_style, 0, 0, 0, 0, 1})
        DrawRectangleRounded(panel, 0.3f, 8, (Color){30, 30, 30, 200})
        Slider(100, (int)panel.x + 20, (int)panel.y + 16, (int)panel.width - 40, "Hue", 0, 360, &hue, "", 0)
    }
}
