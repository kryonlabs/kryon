App :: #import "kryon/app";
Banner :: #import "kryon/banner";
Button :: #import "kryon/button";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
DemoTheme :: #import "kryon/Theme";

state: Banner.BannerState;
initialized: bool;
requested: bool;
Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Banner", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    if !initialized { state = Banner.BannerStateFor(true); initialized = true }
    Banner.BannerAdvance(*state, cast(float32)input.delta_ms / 1000.0, (example_reduced_motion || DemoTheme.CurrentTheme().motion.reduced_motion))
    result := Banner.Draw(session, Banner.Props.{.disabled = example_disabled, .bounds = .{height = 180}, .text = "A new version is available.", .action = "Update", .dismissible = true}, *state)
    if result.action { requested = true; state.open = false }
    if requested { Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 180}, .text = "Update requested"}) }
    if Button.Draw(session, Button.Props.{.disabled = example_disabled, .bounds = .{width = 160, height = 40}, .label = "Show banner"}) != 0 { state.open = true; requested = false }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "banner"}, Frame) }
