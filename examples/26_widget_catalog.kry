            Text((TextProps){.bounds={x, y + ScaleUIPx(502), 0, 0}, .text="InputInt", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            InputInt((InputIntProps){.bounds = {x,y + ScaleUIPx(534),ScaleUIPx(350),ScaleUIPx(36)}, .id = 308, .values = integers, .value_count = 3, .step = 1, .step_fast = 10})
