#import "ziran_mesh_noop_host"
#import "drawing_props"
#import "geometry"

fills: s32;
outlines: s32;
letters: [64]u8;
length: s64;
failed: bool;

#program_export
ResetSpinLetters :: () { length = 0 }

#program_export
SpinLetters :: () -> string { return TextView(letters[:length]) }

#program_export
SpinFills :: () -> s32 { return fills }

#program_export
SpinOutlines :: () -> s32 { return outlines }

#program_export
SpinHostFailed :: () -> bool { return failed }

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    unused asset_path
    failed = true
    return 0
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    unused asset_path
    failed = true
    return 0
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return (cast(s32)value.count) * 7
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused bounds
    unused radius
    unused segments
    if bounds.x == 38.0 && bounds.width == 64.0 &&
        (color.r != cast(u8)0x12 || color.g != cast(u8)0x34 ||
            color.b != cast(u8)0x56) { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if bounds.x != 10.0 || bounds.y != 20.0 ||
        bounds.width != 120.0 || bounds.height != 36.0 || width != 1.0 {
        failed = true
    }
    outlines += 1
    unused radius
    unused segments
    unused color
}

#load "unexpected_raster_line.zi";

#load "unexpected_raster_text.zi";

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused x
    unused y
    unused color
    unused clip
    if font != 14 || length + value.count >= 64 {
        failed = true
        return
    }
    byte: s64 = 0
    while byte < value.count {
        letters[length + byte] = value[byte]
        byte += 1
    }
    length += value.count
}

#load "unexpected_raster_image.zi";
