#module "inspect_state_host"
#import "ui_internal.h"
#import "ui_inspect_props.generated.h"
#import "ui/frame.h"
#import "stdlib.h"
#import "string.h"
#import "stdio.h"

InspectWidget :: struct {
    id: [96]char
    kind: [32]char
    action: [64]char
    source_path: [512]char
    bounds: Rectangle
    screen_bounds: Rectangle
    screen_zoom: float
    flags: i32
    order: i32
    parent: i32
    depth: i32
    source_line: i32
}

InspectOverride :: struct {
    id: [96]char
    bounds: Rectangle
    enabled: i32
}

InspectSourcePath :: struct {
    value: [512]char
}

InspectState :: struct {
    initialized: i32
    enabled: i32
    visible: i32
    dirty: i32
    dragging: i32
    resizing: i32
    selected: i32
    chrome_depth: i32
    canvas_active: i32
    canvas_bounds: Rectangle
    transform_stack: [16]Camera2D
    transform_depth: i32
    drag_start: Vector2
    edit_start: Rectangle
    project_root: [512]char
    source_path_stack: [32]InspectSourcePath
    source_line_stack: [32]i32
    source_depth: i32
    widget_stack: [512]i32
    widget_depth: i32
    widgets: [512]InspectWidget
    widget_count: i32
    overrides: [512]InspectOverride
    override_count: i32
}

g_ui_inspect :: InspectState #global #export

ui_inspect_select_at :: (mouse: Vector2) #extern

ui_inspect_bypass_down :: () -> i32 #export {
    return IsKeyDown(KEY_LEFT_ALT) || IsKeyDown(KEY_RIGHT_ALT)
}

ui_inspect_strncpy :: (dst: *char, dst_size: size_t,
src: const char*) #export {
    if dst == nil || dst_size == 0 {
        return
    }
    if src == nil {
        src = ""
    }
    length: size_t = strlen(src)
    if length >= dst_size {
        length = dst_size - 1
    }
    memmove(dst, src, length)
    dst[length] = '\0'
}

ui_inspect_streq :: (a: const char*,
b: const char*) -> i32 #export {
    return a != nil && b != nil && strcmp(a, b) == 0
}

ui_inspect_persistent_id :: (id: const char*) -> i32 #export {
    return id != nil && id[0] != '\0' &&
    strncmp(id, "tmp:", 4) != 0
}

InspectDefaultProjectRoot :: () {
    if g_ui_inspect.project_root[0] != '\0' {
        return
    }
    root: const char* = getenv("KRYON_PROJECT_ROOT")
    if root != nil && root[0] != '\0' {
        ui_inspect_strncpy(g_ui_inspect.project_root,
        sizeof(g_ui_inspect.project_root), root)
        return
    }
    ui_inspect_strncpy(g_ui_inspect.project_root,
    sizeof(g_ui_inspect.project_root), ".")
}

ui_inspect_init_from_env :: () #export {
    if g_ui_inspect.initialized {
        return
    }
    g_ui_inspect.initialized = 1
    env: const char* = getenv("KRYON_INSPECT")
    g_ui_inspect.enabled = env != nil &&
    env[0] != '\0' && env[0] != '0'
    g_ui_inspect.visible = g_ui_inspect.enabled
    InspectDefaultProjectRoot()
}

ui_inspect_find_override :: (id: const char*) -> *InspectOverride #export {
    i: i32 = 0
    while i < g_ui_inspect.override_count {
        if ui_inspect_streq(g_ui_inspect.overrides[i].id, id) {
            return &g_ui_inspect.overrides[i]
        }
        i += 1
    }
    return nil
}

ui_inspect_get_override :: (id: const char*) -> *InspectOverride #export {
    override: *InspectOverride = ui_inspect_find_override(id)
    if override != nil {
        return override
    }
    if g_ui_inspect.override_count >= 512 {
        return nil
    }
    override = &g_ui_inspect.overrides[g_ui_inspect.override_count]
    g_ui_inspect.override_count += 1
    *override = (InspectOverride){0}
    ui_inspect_strncpy(override->id, sizeof(override->id), id)
    override->enabled = 1
    return override
}

BeginInspectFrame :: (project_root: const char*) #export {
    ui_inspect_init_from_env()
    if project_root != nil && project_root[0] != '\0' &&
    !ui_inspect_streq(project_root, g_ui_inspect.project_root) {
        ui_inspect_strncpy(g_ui_inspect.project_root,
        sizeof(g_ui_inspect.project_root), project_root)
        g_ui_inspect.override_count = 0
        g_ui_inspect.dirty = 0
    }
    if !g_ui_inspect.enabled {
        return
    }
    if project_root != nil {
        g_ui_inspect.transform_depth = 0
    }
    g_ui_inspect.widget_count = 0
    if project_root != nil || g_ui_inspect.transform_depth <= 0 {
        g_ui_inspect.canvas_active = 0
    }
    g_ui_inspect.source_depth = 0
    g_ui_inspect.widget_depth = 0
    if IsKeyPressed(KEY_F12) {
        g_ui_inspect.visible = !g_ui_inspect.visible
    }
}

EndInspectFrame :: () #export {
    return
}

SetInspectEnabled :: (enabled: i32) #export {
    ui_inspect_init_from_env()
    g_ui_inspect.enabled = enabled ? 1 : 0
    g_ui_inspect.visible = g_ui_inspect.enabled
}

InspectEnabled :: () -> i32 #export {
    ui_inspect_init_from_env()
    return g_ui_inspect.enabled
}

SetInspectVisible :: (visible: i32) #export {
    ui_inspect_init_from_env()
    g_ui_inspect.visible = visible ? 1 : 0
}

InspectWidgetCount :: () -> i32 #export {
    ui_inspect_init_from_env()
    return g_ui_inspect.widget_count
}

InspectFillNode :: (node: *InspectNode,
widget: *const InspectWidget) {
    if node == nil || widget == nil {
        return
    }
    *node = (InspectNode){0}
    ui_inspect_strncpy(node->name, sizeof(node->name), widget->id)
    ui_inspect_strncpy(node->role, sizeof(node->role), widget->kind)
    ui_inspect_strncpy(node->text, sizeof(node->text), widget->action)
    ui_inspect_strncpy(node->source_path,
    sizeof(node->source_path), widget->source_path)
    node->bounds = widget->bounds
    node->flags = widget->flags
    node->order = widget->order
    node->parent = widget->parent
    node->source_line = widget->source_line
    node->valid = 1
}

InspectNodeCount :: () -> i32 #export {
    ui_inspect_init_from_env()
    return g_ui_inspect.widget_count
}

InspectGetNode :: (index: i32,
node: *InspectNode) -> i32 #export {
    ui_inspect_init_from_env()
    if index < 0 || index >= g_ui_inspect.widget_count ||
    node == nil { return 0 }
    InspectFillNode(node, &g_ui_inspect.widgets[index])
    return 1
}

InspectMatchSelector :: (widget: *const InspectWidget,
selector: const char*) -> i32 {
    if widget == nil || selector == nil ||
    selector[0] == '\0' { return 0 }
    if selector[0] == '@' {
        return ui_inspect_streq(widget->id, selector + 1)
    }
    if strncmp(selector, "role=", 5) == 0 {
        return ui_inspect_streq(widget->kind, selector + 5)
    }
    if strncmp(selector, "text=", 5) == 0 {
        return ui_inspect_streq(widget->action, selector + 5)
    }
    if strchr(selector, ':') != nil &&
    widget->source_path[0] != '\0' {
        source: [544]char
        snprintf(source, sizeof(source), "%s:%d",
        widget->source_path, widget->source_line)
        return ui_inspect_streq(source, selector)
    }
    return ui_inspect_streq(widget->id, selector) ||
    ui_inspect_streq(widget->kind, selector) ||
    ui_inspect_streq(widget->action, selector)
}

InspectFindNode :: (selector: const char*,
node: *InspectNode) -> i32 #export {
    ui_inspect_init_from_env()
    i: i32 = g_ui_inspect.widget_count - 1
    while i >= 0 {
        if InspectMatchSelector(&g_ui_inspect.widgets[i], selector) {
            InspectFillNode(node, &g_ui_inspect.widgets[i])
            return 1
        }
        i -= 1
    }
    return 0
}

InspectGetSelection :: () -> InspectSelection #export {
    selection: InspectSelection = (InspectSelection){0}
    ui_inspect_init_from_env()
    if g_ui_inspect.selected < 0 ||
    g_ui_inspect.selected >= g_ui_inspect.widget_count {
        return selection
    }
    widget: *InspectWidget =
    &g_ui_inspect.widgets[g_ui_inspect.selected]
    ui_inspect_strncpy(selection.id, sizeof(selection.id), widget->id)
    ui_inspect_strncpy(selection.kind,
    sizeof(selection.kind), widget->kind)
    ui_inspect_strncpy(selection.action,
    sizeof(selection.action), widget->action)
    ui_inspect_strncpy(selection.source_path,
    sizeof(selection.source_path), widget->source_path)
    selection.bounds = widget->bounds
    selection.flags = widget->flags
    selection.source_line = widget->source_line
    selection.kind_index = 1
    i: i32 = 0
    while i < g_ui_inspect.selected {
        if ui_inspect_streq(g_ui_inspect.widgets[i].kind,
        widget->kind) { selection.kind_index += 1 }
        i += 1
    }
    selection.valid = 1
    return selection
}

InspectSelectAt :: (point: Vector2) -> i32 #export {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled || !g_ui_inspect.visible ||
    ui_inspect_bypass_down() { return 0 }
    if g_ui_inspect.canvas_active &&
    !CheckCollisionPointRec(point, g_ui_inspect.canvas_bounds) {
        return 0
    }
    ui_inspect_select_at(point)
    return g_ui_inspect.selected >= 0
}

SetInspectCanvasBounds :: (bounds: Rectangle) #export {
    ui_inspect_init_from_env()
    g_ui_inspect.canvas_bounds = bounds
    g_ui_inspect.canvas_active = bounds.width > 0 &&
    bounds.height > 0
}

ui_inspect_rect_to_screen :: (bounds: Rectangle) -> Rectangle #export {
    camera: Camera2D = g_ui_camera
    if g_ui_inspect.transform_depth > 0 {
        camera = g_ui_inspect.transform_stack[
        g_ui_inspect.transform_depth - 1]
    }
    return (Rectangle){camera.offset.x + bounds.x * camera.zoom,
        camera.offset.y + bounds.y * camera.zoom,
        bounds.width * camera.zoom, bounds.height * camera.zoom}
}

ui_inspect_screen_zoom :: () -> float #export {
    camera: Camera2D = g_ui_camera
    if g_ui_inspect.transform_depth > 0 {
        camera = g_ui_inspect.transform_stack[
        g_ui_inspect.transform_depth - 1]
    }
    return camera.zoom > 0 ? camera.zoom : 1
}

PushInspectTransform :: (camera: Camera2D) -> i32 #export {
    ui_inspect_init_from_env()
    token: i32 = g_ui_inspect.transform_depth
    if g_ui_inspect.transform_depth >= 16 {
        return token
    }
    if camera.zoom <= 0 {
        camera.zoom = 1
    }
    g_ui_inspect.transform_stack[
    g_ui_inspect.transform_depth] = camera
    g_ui_inspect.transform_depth += 1
    return token
}

PopInspectTransform :: (token: i32) #export {
    ui_inspect_init_from_env()
    if token < 0 {
        token = 0
    }
    if token > g_ui_inspect.transform_depth {
        token = g_ui_inspect.transform_depth
    }
    g_ui_inspect.transform_depth = token
}

PushInspectChrome :: (enabled: i32) -> i32 #export {
    ui_inspect_init_from_env()
    token: i32 = g_ui_inspect.chrome_depth
    if enabled {
        g_ui_inspect.chrome_depth += 1
    }
    return token
}

PopInspectChrome :: (token: i32) #export {
    ui_inspect_init_from_env()
    if token < 0 {
        token = 0
    }
    g_ui_inspect.chrome_depth = token
}

InspectInputCapturesClick :: (point: Vector2) -> i32 #export {
    ui_inspect_init_from_env()
    if g_ui_inspect.chrome_depth > 0 ||
    ui_inspect_bypass_down() { return 0 }
    if g_ui_inspect.dragging || g_ui_inspect.resizing {
        return 1
    }
    if g_ui_inspect.canvas_active &&
    !CheckCollisionPointRec(GetMousePosition(),
    g_ui_inspect.canvas_bounds) { return 0 }
    return g_ui_inspect.enabled && g_ui_inspect.visible
}

InspectApplyBounds :: (id: const char*, bounds: *Rectangle) {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled || id == nil || bounds == nil {
        return
    }
    override: *InspectOverride = ui_inspect_find_override(id)
    if override == nil || !override->enabled {
        return
    }
    if override->bounds.width > 0 &&
    override->bounds.height > 0 { *bounds = override->bounds }
}

PushInspectSource :: (path: const char*, line: i32) #export {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled || g_ui_inspect.source_depth >= 32 {
        return
    }
    index: i32 = g_ui_inspect.source_depth
    g_ui_inspect.source_depth += 1
    ui_inspect_strncpy(
    g_ui_inspect.source_path_stack[index].value,
    sizeof(g_ui_inspect.source_path_stack[index].value), path)
    g_ui_inspect.source_line_stack[index] = line
}

PopInspectSource :: () #export {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled {
        return
    }
    if g_ui_inspect.source_depth > 0 {
        g_ui_inspect.source_depth -= 1
    }
}

InspectRegisterWidget :: (id: const char*,
kind: const char*, bounds: *Rectangle,
flags: i32) -> i32 {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled || id == nil || id[0] == '\0' ||
    bounds == nil || g_ui_inspect.widget_count >= 512 ||
    g_ui_inspect.chrome_depth > 0 { return -1 }
    screen_bounds: Rectangle = ui_inspect_rect_to_screen(*bounds)
    if g_ui_inspect.canvas_active &&
    !CheckCollisionRecs(screen_bounds,
    g_ui_inspect.canvas_bounds) { return -1 }
    index: i32 = g_ui_inspect.widget_count
    g_ui_inspect.widget_count += 1
    widget: *InspectWidget = &g_ui_inspect.widgets[index]
    *widget = (InspectWidget){0}
    ui_inspect_strncpy(widget->id, sizeof(widget->id), id)
    ui_inspect_strncpy(widget->kind, sizeof(widget->kind),
    kind != nil ? kind : "widget")
    widget->bounds = *bounds
    widget->screen_bounds = screen_bounds
    widget->screen_zoom = ui_inspect_screen_zoom()
    widget->flags = flags
    widget->parent = g_ui_inspect.widget_depth > 0
    ? g_ui_inspect.widget_stack[g_ui_inspect.widget_depth - 1] : -1
    widget->depth = g_ui_inspect.widget_depth
    if g_ui_inspect.source_depth > 0 {
        source: i32 = g_ui_inspect.source_depth - 1
        ui_inspect_strncpy(widget->source_path,
        sizeof(widget->source_path),
        g_ui_inspect.source_path_stack[source].value)
        widget->source_line =
        g_ui_inspect.source_line_stack[source]
    }
    if !ui_inspect_persistent_id(id) {
        widget->flags |= WidgetFlagTemporaryId
    }
    widget->order = g_ui_inspect.widget_count
    override: *InspectOverride = ui_inspect_find_override(id)
    if override == nil && ui_inspect_persistent_id(id) &&
    (flags & (WidgetFlagMovable | WidgetFlagResizable)) != 0 {
        override = ui_inspect_get_override(id)
        if override != nil {
            override->bounds = *bounds
        }
    }
    return index
}

InspectSetWidgetAction :: (index: i32,
action: const char*) {
    ui_inspect_init_from_env()
    if !g_ui_inspect.enabled || action == nil ||
    index < 0 || index >= g_ui_inspect.widget_count { return }
    widget: *InspectWidget = &g_ui_inspect.widgets[index]
    ui_inspect_strncpy(widget->action,
    sizeof(widget->action), action)
}

BeginWidget :: (kind: const char*, id: const char*,
bounds: Rectangle, flags: WidgetFlag) -> Widget #export {
    ui_inspect_init_from_env()
    widget: Widget = (Widget){0}
    ui_inspect_strncpy(widget.kind, sizeof(widget.kind),
    kind != nil ? kind : "widget")
    if id != nil && id[0] != '\0' {
        ui_inspect_strncpy(widget.id, sizeof(widget.id), id)
    } else {
        snprintf(widget.id, sizeof(widget.id), "tmp:%s:%d",
        widget.kind, g_ui_inspect.widget_count)
    }
    widget.bounds = bounds
    widget.flags = flags
    widget.index = -1
    if (flags & (WidgetFlagMovable | WidgetFlagResizable)) != 0 {
        InspectApplyBounds(widget.id, &widget.bounds)
    }
    index: i32 = InspectRegisterWidget(widget.id,
    widget.kind, &widget.bounds, flags)
    if index >= 0 {
        widget.index = index
        widget.active = 1
        if g_ui_inspect.widget_depth < 512 {
            g_ui_inspect.widget_stack[g_ui_inspect.widget_depth] = index
            g_ui_inspect.widget_depth += 1
        }
    }
    return widget
}

WidgetSetBounds :: (widget: *Widget,
bounds: Rectangle) #export {
    ui_inspect_init_from_env()
    if widget == nil || !widget->active {
        return
    }
    widget->bounds = bounds
    if widget->index < 0 ||
    widget->index >= g_ui_inspect.widget_count { return }
    inspect: *InspectWidget =
    &g_ui_inspect.widgets[widget->index]
    inspect->bounds = bounds
    inspect->screen_bounds = ui_inspect_rect_to_screen(bounds)
    inspect->screen_zoom = ui_inspect_screen_zoom()
}

WidgetSetAction :: (widget: *Widget,
action: const char*) #export {
    if widget == nil || !widget->active {
        return
    }
    InspectSetWidgetAction(widget->index, action)
}

EndWidget :: (widget: *Widget) #export {
    if widget == nil || !widget->active {
        return
    }
    if g_ui_inspect.widget_depth > 0 {
        g_ui_inspect.widget_depth -= 1
    }
    widget->active = 0
}
