// The browser host's GPU presenter. One WebGL2 context on the visible canvas
// keeps the drawing buffer between composites, so a repaint only rasterises
// its damage rectangle and the browser shows the rest of the frame unchanged:
// there is no second canvas and no full-frame copy. Shapes stream into one
// batched vertex buffer and shade with analytic coverage; text runs and
// images draw as textured quads. Hidden 2D canvases only rasterise the glyph
// bitmaps that feed the atlases; no pixel is ever presented through a 2D
// context.
#import "geometry"
#import "drawing_props"
#import "web"

// Prepare the root frame before its first submitted primitive. Observing
// textures or measuring text does not begin a repaint.
PageDrawBefore :: #type () -> void;
PageDrawHooks :: struct { before: PageDrawBefore }
page_draw_hooks: PageDrawHooks;

PAGE_GPU_VERTEX_MAX :: 64000
PAGE_GPU_RUN_MAX :: 256
PAGE_GPU_SCISSOR_MAX :: 32

GL_GPU_ARRAY_BUFFER :: 34962
GL_GPU_ELEMENT_BUFFER :: 34963
GL_GPU_DYNAMIC_DRAW :: 35040
GL_GPU_UNSIGNED_SHORT :: 5123
GL_GPU_TRIANGLES :: 4
GL_GPU_BLEND :: 3042
GL_GPU_ONE :: 1
GL_GPU_SRC_ALPHA :: 770
GL_GPU_ONE_MINUS_SRC_ALPHA :: 771
GL_GPU_DST_COLOR :: 774
GL_GPU_SCISSOR_TEST :: 3089
GL_GPU_RGBA :: 6408
GL_GPU_TEXTURE_2D :: 3553
GL_GPU_TEXTURE0 :: 33984
GL_GPU_NEAREST :: 9728
GL_GPU_LINEAR :: 9729
GL_GPU_CLAMP_TO_EDGE :: 33071
GL_GPU_FRAGMENT_SHADER :: 35632
GL_GPU_VERTEX_SHADER :: 35633
GL_GPU_COMPILE_STATUS :: 35713
GL_GPU_LINK_STATUS :: 35714
GL_GPU_FRAMEBUFFER :: 36160
GL_GPU_COLOR_ATTACHMENT0 :: 36064
GL_GPU_FRAMEBUFFER_COMPLETE :: 36053
GL_GPU_COLOR_BUFFER_BIT :: 16384
GL_GPU_UNPACK_PREMULTIPLY :: 37441
GL_GPU_BYTES :: 4

