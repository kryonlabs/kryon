#import "session"
#import "widget_test_session"

#import "control_props"
#import "drawing_props"
#import "geometry"
#import "style"
#import "style_sheet"
#import "text_align"
Text :: #import "kryon/text";
#import "tree"
#import "tree_draw"
#import "widget_kind"
#import "ziran_text_widget_host"

using TextAlign;
using Text.Wrap;
using WidgetKind;
using StyleField;
using FrameStatus;

phase: s32;

#program_export
Frame :: () -> s32 {
    if phase == 1 {
        if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TreeCount(TestSession()) != 2 { return -1 }
        node: TreeEntry = TreeNodeAt(TestSession(), 1)
        if node.kind != WidgetKindText || node.key != cast(u64)7 ||
        node.bounds.width != 50.0 || node.bounds.height != 24.0 ||
        node.semantic_label != "Alpha beta\nGamma" { return -2 }
        phase = 2
        return 42
    }
    rules: StyleRules
    rules.count = 1
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.selector.kind = StyleKindText()
    rule.selector.class_name = 7
    rule.style.fields = cast(u32)StyleForeground |
    cast(u32)StyleFontSize | cast(u32)StyleOpacity
    rule.style.foreground = cast(u32)0x112233ff
    rule.style.font_size = 14.0
    rule.style.opacity = 0.5
    rules.items[0] = rule
    InstallStyleRules(rules)
    props: Text.Props = .{.key = cast(u64)7, .bounds = Rectangle.{10.0, 20.0, 50.0, 24.0},
        .text = "Alpha beta\nGamma", .class_name = 7, .wrap = cast(Text.Wrap)TextWrapAuto,
        .align = cast(TextAlign)TextAlignCenter, .strikethrough = true}
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 200.0, 100.0})
    Text.Draw(TestSession(), props)
    phase = 1
    return 0
}

#program_export
main :: () -> s32 {
    if Frame() != 0 || TextHostFailed() ||
    TextHostLabels() != 0 || TextHostFills() != 0 { return 1 }
    if Frame() != 42 || TextHostFailed() ||
    TextHostLabels() != 3 || TextHostFills() != 2 { return 2 }
    TextHostEmphasis()
    ranges: [6]Text.Range = .[Text.Range.{1, 8}, Text.Range.{2, 4},
    Text.Range.{9, 11}, Text.Range.{8, 11}, Text.Range.{-1, 2}, Text.Range.{0, 99}]
    props := Text.Props.{.key = cast(u64)8, .bounds = Rectangle.{0.0, 0.0, 50.0, 28.0},
        .text = "ab cd\né水", .class_name = 7, .strong = ranges[:]}
    BeginFrame(TestSession(), cast(u64)2, Rectangle.{0.0, 0.0, 200.0, 100.0})
    Text.Draw(TestSession(), props)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TextHostFailed() ||
    TextHostLabels() != 5 || TextHostFills() != 0 ||
    TreeNodeAt(TestSession(), 1).semantic_label != props.text {
        return 3
    }
    // Typed text keeps the whole text's layout and label and paints only
    // its typed characters, never part of one.
    TextHostTyping()
    typed := Text.Props.{.key = cast(u64)9, .bounds = Rectangle.{0.0, 0.0, 60.0, 28.0},
        .text = "ab cd\né水", .class_name = 7, .align = cast(TextAlign)TextAlignCenter,
        .typing = true, .typed = 4}
    if TypedFrame(typed, 3) != 1 || TextHostTypedValue(0) != "ab c" ||
    TextHostTypedX(0) != 5 ||
    TreeNodeAt(TestSession(), 1).semantic_label != typed.text {
        return 4
    }
    TextHostTyping()
    typed.typed = 7
    if TypedFrame(typed, 4) != 2 || TextHostTypedValue(0) != "ab cd" ||
    TextHostTypedValue(1) != "é" || TextHostTypedX(1) != 5 {
        return 5
    }
    TextHostTyping()
    typed.typed = 0
    if TypedFrame(typed, 5) != 0 {
        return 6
    }
    TextHostTyping()
    typed.text = "éx"
    typed.typed = 1
    if TypedFrame(typed, 6) != 1 || TextHostTypedValue(0) != "é" ||
    TextHostTypedX(0) != 10 {
        return 7
    }
    TextHostTyping()
    typed.typing = false
    if TypedFrame(typed, 7) != 1 || TextHostTypedValue(0) != typed.text {
        return 8
    }
    return LinkChecks()
}

SameColor :: (color: Color, r: s32, g: s32, b: s32, a: s32) -> bool {
    return cast(s32)color.r == r && cast(s32)color.g == g && cast(s32)color.b == b &&
    cast(s32)color.a == a
}

// A link is painted inside the ordinary text in the theme's link color,
// with the text's opacity, and underlined on each line it reaches.
// TextLinkAt finds it under a point on any of those lines.
LinkChecks :: () -> s32 {
    name: [4]u8 = .[cast(u8)108, cast(u8)105, cast(u8)110, cast(u8)107]
    if !SetStyleTokenColorBytes(name[:], cast(u32)0x80a0ffff) { return 9 }
    TextHostLinks()
    ranges: [1]Text.Range = .[Text.Range.{3, 10}]
    linked := Text.Props.{.key = cast(u64)10, .bounds = Rectangle.{0.0, 0.0, 80.0, 28.0},
        .text = "ab cdef gh", .class_name = 7, .links = ranges[:]}
    BeginFrame(TestSession(), cast(u64)8, Rectangle.{0.0, 0.0, 200.0, 100.0})
    Text.Draw(TestSession(), linked)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TextHostFailed() ||
    TextHostLabels() != 3 || TextHostFills() != 2 {
        return 10
    }
    if TextHostLinkValue(0) != "ab " || TextHostLinkX(0) != 0 ||
    !SameColor(TextHostLinkColor(0), 0x11, 0x22, 0x33, 127) {
        return 11
    }
    if TextHostLinkValue(1) != "cdef" || TextHostLinkX(1) != 30 || TextHostLinkY(1) != 0 ||
    !SameColor(TextHostLinkColor(1), 0x80, 0xa0, 0xff, 127) {
        return 12
    }
    if TextHostLinkValue(2) != "gh" || TextHostLinkX(2) != 0 || TextHostLinkY(2) != 16 ||
    !SameColor(TextHostLinkColor(2), 0x80, 0xa0, 0xff, 127) {
        return 13
    }
    first := TextHostLinkFill(0)
    second := TextHostLinkFill(1)
    if first.x != 30.0 || first.y != 11.0 || first.width != 40.0 || first.height != 1.0 ||
    second.x != 0.0 || second.y != 27.0 || second.width != 20.0 ||
    !SameColor(TextHostLinkFillColor(0), 0x80, 0xa0, 0xff, 127) {
        return 14
    }
    if Text.TextLinkAt(TestSession(), linked, 35.0, 5.0) != 0 ||
    Text.TextLinkAt(TestSession(), linked, 15.0, 5.0) != -1 ||
    Text.TextLinkAt(TestSession(), linked, 5.0, 20.0) != 0 ||
    Text.TextLinkAt(TestSession(), linked, 45.0, 20.0) != -1 ||
    Text.TextLinkAt(TestSession(), linked, 35.0, 40.0) != -1 {
        return 15
    }
    plain := linked
    plain.links = ranges[:0]
    if Text.TextLinkAt(TestSession(), plain, 35.0, 5.0) != -1 { return 16 }
    // Disabled text receives one fade, with or without a palette rule.
    face := Text.TextFace.{.fallback_font = 14,
        .value = StyleData.{.fields = cast(u32)StyleForeground | cast(u32)StyleOpacity,
            .foreground = cast(u32)0xf2f0ffff, .opacity = 0.45}}
    dim := Text.PrepareText(Text.Props.{.size = 14, .disabled = true}, face)
    if dim.color.a != cast(u8)114 { return 17 }
    face.value.fields = cast(u32)StyleForeground
    dim = Text.PrepareText(Text.Props.{.size = 14, .disabled = true}, face)
    if dim.color.a != cast(u8)114 { return 18 }
    ClearStyleTokenColors()
    return 0
}

// Paints one frame of typed text and returns how many lines it painted, or
// -1 when the frame failed.
TypedFrame :: (props: Text.Props, frame: u64) -> s32 {
    BeginFrame(TestSession(), frame, Rectangle.{0.0, 0.0, 200.0, 100.0})
    Text.Draw(TestSession(), props)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TextHostFailed() {
        return -1
    }
    return TextHostLabels()
}
