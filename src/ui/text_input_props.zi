#import "geometry"
#import "syntax"
#import "text_input"

TextFieldInput :: struct {
    text: string
    paste_text: string
    composition_event: CompositionEvent
    left: bool
    right: bool
    home: bool
    end: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
}

TextFieldProps :: struct {
    key: u64
    bounds: Rectangle
    value: string
    display_value: string
    label: string
    placeholder: string
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    composition: CompositionState
    focus_id: s32
    class_name: s32
    scale: float32
    max_bytes: s32
    max_codepoints: s32
    secure: bool
    read_only: bool
    disabled: bool
    input: TextFieldInput
}

TextFieldEdit :: struct {
    start: s32
    end: s32
    replacement: string
    changed: bool
}

TextFieldResult :: struct {
    node: s32
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    committed: bool
    escaped: bool
    composition: CompositionState
    composition_changed: bool
    clipboard_write: bool
    clipboard_text: string
    edit: TextFieldEdit
}

TextAreaInput :: struct {
    text: string
    paste_text: string
    composition_event: CompositionEvent
    left: bool
    right: bool
    up: bool
    down: bool
    home: bool
    end: bool
    document_home: bool
    document_end: bool
    page_up: bool
    page_down: bool
    shift: bool
    backspace: bool
    delete_forward: bool
    select_all: bool
    copy: bool
    cut: bool
    paste: bool
    enter: bool
    commit: bool
    escape: bool
    focus: bool
    blur: bool
    wheel: float32
}

TextAreaProps :: struct {
    key: u64
    bounds: Rectangle
    value: string
    label: string
    placeholder: string
    cursor: s32
    anchor: s32
    scroll_y: s32
    focused: bool
    composition: CompositionState
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    max_bytes: s32
    max_codepoints: s32
    focus_id: s32
    syntax: SyntaxMode
    composition_start: s32
    composition_end: s32
    read_only: bool
    wrap: bool
    class_name: s32
    scale: float32
    disabled: bool
    input: TextAreaInput
}

TextAreaEdit :: struct {
    start: s32
    end: s32
    replacement: string
    changed: bool
}

TextAreaResult :: struct {
    node: s32
    cursor: s32
    anchor: s32
    scroll_y: s32
    focused: bool
    selecting: bool
    preferred_x: s32
    preferred_x_valid: bool
    committed: bool
    escaped: bool
    composition: CompositionState
    composition_changed: bool
    clipboard_write: bool
    clipboard_text: string
    edit: TextAreaEdit
}
