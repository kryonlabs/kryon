#module "text_area_widget"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "semantic"
#import "style"
#import "style_sheet"
#import "surface"
#import "syntax"
#import "text_field_widget"
#import "text_input"
#import "text_input_props"
#import "text_rows"
#import "text_widget"
#import "tree"
#import "tree_input"
#import "widget_kind"

TextAreaRow :: struct {
    start: i32
    end: i32
    next: i32
    soft_wrap: bool
}

TextAreaCaret :: struct {
    x: i32
    y: i32
    row_start: i32
    row_end: i32
    row_index: i32
}

TextAreaKey :: (props: TextAreaProps) -> u64 #export {
    if props.key != (u64)0 { return props.key }
    if props.focus_id > 0 { return (u64)(u32)props.focus_id }
    return TreeNextKey()
}

TextAreaDefaultFace :: () -> StyleData #export {
    face: StyleData
    face.fields = (u32)StyleBackground | (u32)StyleForeground |
        (u32)StyleBorder | (u32)StyleFocus |
        (u32)StyleRadius | (u32)StyleBorderWidth |
        (u32)StyleOpacity | (u32)StylePaddingX |
        (u32)StylePaddingY | (u32)StyleFontSize |
        (u32)StyleGap
    face.background = (u32)0xffffffff
    face.foreground = (u32)0x111827ff
    face.border = (u32)0x94a3b8ff
    face.focus = (u32)0x3b82f6ff
    face.radius = 4.0
    face.border_width = 1.0
    face.opacity = 1.0
    face.padding_x = 10.0
    face.padding_y = 8.0
    face.font_size = 14.0
    face.gap = 4.0
    return face
}

TextAreaFaceFor :: (props: TextAreaProps,
    focused: bool) -> StyleFrame #export {
    state: i32 = (i32)ButtonStateNormal
    if focused { state = (i32)ButtonStateFocus }
    if props.disabled { state = (i32)ButtonStateDisabled }
    frame: StyleFrame
    frame.value = ResolveStyleRules(ActiveStyleRules(),
        TextAreaDefaultFace(),
        StyleControlRoleFacts(StyleKindTextArea(),
            props.focus_id, props.class_name, 0,
            (i32)ButtonToneNeutral,
            (i32)ButtonEmphasisSoft,
            (i32)ControlSizeMedium, state), state)
    return frame
}

# Rows preserve every byte, including spaces at wrap boundaries. The cursor
# can therefore address the original value without a shadow text buffer.
TextAreaNextRow :: (value: string, start: i32,
    wrap_width: i32, font: i32,
    typeface: string) -> TextAreaRow #export {
    row: TextAreaRow
    row.start = start
    row.end = start
    row.next = value.length + 1
    if start < 0 || start > value.length { return row }
    line: TextLogicalLine = TextLogicalLineFor(value, start)
    row.end = line.end
    row.next = line.next
    if wrap_width <= 0 || line.end <= start { return row }
    cursor: i32 = start
    fitted: i32 = start
    break_after: i32 = -1
    while cursor < line.end {
        next: i32 = TextFieldNext(value, cursor)
        width: i32 = GlyphWidth(TextSpan(value,
            start, next - start), font, typeface)
        if width > wrap_width {
            if fitted == start { fitted = next }
            if break_after > start && break_after <= fitted {
                fitted = break_after
            }
            if fitted < line.end {
                row.end = fitted
                row.next = fitted
                row.soft_wrap = true
            }
            return row
        }
        fitted = next
        if value[cursor] == (u8)32 ||
            value[cursor] == (u8)9 { break_after = next }
        cursor = next
    }
    return row
}

TextAreaRowCount :: (value: string, wrap_width: i32,
    font: i32, typeface: string) -> i32 #export {
    count: i32 = 0
    offset: i32 = 0
    while offset <= value.length {
        row: TextAreaRow = TextAreaNextRow(value, offset,
            wrap_width, font, typeface)
        count += 1
        if row.next <= offset { break }
        offset = row.next
    }
    return count
}

TextAreaCaretFor :: (value: string, cursor: i32,
    wrap_width: i32, font: i32, typeface: string,
    advance: i32) -> TextAreaCaret #export {
    caret: TextAreaCaret
    cursor = TextCursorForLength(cursor, value.length)
    offset: i32 = 0
    index: i32 = 0
    while offset <= value.length {
        row: TextAreaRow = TextAreaNextRow(value, offset,
            wrap_width, font, typeface)
        if cursor < row.end ||
            (cursor == row.end && !row.soft_wrap) ||
            row.next > value.length {
            within: i32 = cursor
            if within < row.start { within = row.start }
            if within > row.end { within = row.end }
            caret.x = GlyphWidth(TextSpan(value,
                row.start, within - row.start), font,
                typeface)
            caret.y = index * advance
            caret.row_start = row.start
            caret.row_end = row.end
            caret.row_index = index
            return caret
        }
        if row.next <= offset { break }
        offset = row.next
        index += 1
    }
    return caret
}

TextAreaCursorAtPoint :: (value: string, x: i32,
    y: i32, wrap_width: i32, font: i32,
    typeface: string, advance: i32) -> i32 #export {
    if advance < 1 { advance = 1 }
    if y < 0 { y = 0 }
    wanted: i32 = y / advance
    offset: i32 = 0
    index: i32 = 0
    while offset <= value.length {
        row: TextAreaRow = TextAreaNextRow(value, offset,
            wrap_width, font, typeface)
        if index >= wanted || row.next > value.length {
            span: string = TextSpan(value, row.start,
                row.end - row.start)
            return row.start + TextFieldCursorAtX(span,
                x, font, typeface)
        }
        if row.next <= offset { break }
        offset = row.next
        index += 1
    }
    return value.length
}

TextAreaInputTextAllowed :: (value: string) -> bool #export {
    if value == "" { return false }
    index: i32 = 0
    while index < value.length {
        byte: u8 = value[index]
        if (byte < (u8)32 && byte != (u8)9 &&
            byte != (u8)10) || byte == (u8)127 {
            return false
        }
        index += 1
    }
    return true
}

TextAreaReplacementAllowed :: (props: TextAreaProps,
    start: i32, end: i32,
    replacement: string) -> bool #export {
    if start < 0 || end < start || end > props.value.length {
        return false
    }
    bytes: i32 = props.value.length - (end - start) +
        replacement.length
    if props.max_bytes > 0 && bytes > props.max_bytes {
        return false
    }
    if props.max_codepoints > 0 {
        removed: string = TextSpan(props.value,
            start, end - start)
        count: i32 = TextFieldCodepoints(props.value) -
            TextFieldCodepoints(removed) +
            TextFieldCodepoints(replacement)
        if count > props.max_codepoints { return false }
    }
    return true
}

TextAreaEditFor :: (props: TextAreaProps,
    cursor: i32, anchor: i32) -> TextAreaEdit #export {
    edit: TextAreaEdit
    selection: TextSelectionRange = TextSelectionRangeForLength(
        anchor, cursor, props.value.length)
    replacement: string = props.input.text
    if replacement == "" && props.input.enter {
        replacement = "\n"
    }
    if TextAreaInputTextAllowed(replacement) {
        if !TextAreaReplacementAllowed(props,
            selection.start, selection.end,
            replacement) { return edit }
        edit.start = selection.start
        edit.end = selection.end
        edit.replacement = replacement
        edit.changed = true
        return edit
    }
    if props.input.backspace {
        edit.start = selection.start
        edit.end = selection.end
        if !selection.has_selection {
            edit.start = TextFieldPrevious(props.value, cursor)
        }
    } else if props.input.delete_forward {
        edit.start = selection.start
        edit.end = selection.end
        if !selection.has_selection {
            edit.end = TextFieldNext(props.value, cursor)
        }
    }
    edit.changed = edit.end > edit.start
    return edit
}

# The caller stores text, focus, selection, and scroll state. Kryon returns
# UTF-8 byte edits and paints from the immutable value for this frame.
TextArea :: (props: TextAreaProps) -> TextAreaResult #export {
    result: TextAreaResult
    result.node = -1
    result.cursor = TextCursorForLength(props.cursor,
        props.value.length)
    result.anchor = TextCursorForLength(props.anchor,
        props.value.length)
    result.scroll_y = props.scroll_y
    result.focused = props.focused
    result.composition = props.composition
    result.selecting = props.selecting
    result.preferred_x = props.preferred_x
    result.preferred_x_valid = props.preferred_x_valid
    bounds: Rectangle = props.bounds
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return result }
    key: u64 = TextAreaKey(props)
    previous: i32 = -1
    if TreeIsBuilding() {
        previous = TreeFind(key, TreeCurrentParentKey(),
            WidgetKindTextArea)
    }
    activated: bool = TreeTakeActivationAt(previous)
    drag: PointerDrag = TreeTakeDragAt(previous)
    if props.disabled || props.input.blur { result.focused = false }
    if !props.disabled && props.input.focus { result.focused = true }
    face: StyleFrame = TextAreaFaceFor(props, result.focused)
    scale: float = props.scale
    if scale <= 0.0 { scale = 1.0 }
    font: i32 = ResolveFont(0,
        StyleFontValue(face.value.fields,
            face.value.font_size), 14)
    line_height: i32 = GlyphLineHeight(font,
        face.value.typeface)
    gap: i32 = TextInputScaledMetric(face.value.gap, scale)
    if gap < 0 { gap = 0 }
    advance: i32 = line_height + gap
    if advance < 1 { advance = 1 }
    padding_x: i32 = TextInputScaledMetric(
        face.value.padding_x, scale)
    padding_y: i32 = TextInputScaledMetric(
        face.value.padding_y, scale)
    if padding_x < 0 { padding_x = 0 }
    if padding_y < 0 { padding_y = 0 }
    wrap_width: i32 = TextAreaWrapWidthFor(bounds.width,
        padding_x, props.wrap, TextAreaMinWrapWidth(scale))
    content_height: i32 = TextAreaRowCount(props.value,
        wrap_width, font, face.value.typeface) * advance
    paint: TextAreaPaint = TextAreaPaintFor(bounds,
        font, gap, padding_x, padding_y, props.wrap,
        content_height, result.scroll_y, line_height,
        TextAreaMinWrapWidth(scale))
    result.scroll_y = paint.scroll_y
    if !props.disabled && props.input.wheel != 0.0 {
        result.scroll_y = TextAreaScrollFor(
            TextAreaWheelScrollFor(result.scroll_y,
                props.input.wheel, advance),
            paint.max_scroll)
    }
    pointer_moved: bool = false
    if !props.disabled && previous >= 0 &&
        (drag.started || drag.active || drag.ended || activated) {
        result.focused = true
        prior: Rectangle = TreeNodeAt(previous).bounds
        origin_x: float = prior.x + drag.grab_x
        origin_y: float = prior.y + drag.grab_y
        sample_x: float = drag.x
        sample_y: float = drag.y
        if drag.started {
            sample_x = origin_x
            sample_y = origin_y
        }
        initial: i32 = TextAreaCursorAtPoint(props.value,
            (i32)origin_x - ((i32)bounds.x + padding_x),
            (i32)origin_y - ((i32)bounds.y + padding_y) +
                result.scroll_y,
            wrap_width, font, face.value.typeface, advance)
        selected: i32 = TextAreaCursorAtPoint(props.value,
            (i32)sample_x - ((i32)bounds.x + padding_x),
            (i32)sample_y - ((i32)bounds.y + padding_y) +
                result.scroll_y,
            wrap_width, font, face.value.typeface, advance)
        dx: float = sample_x - origin_x
        dy: float = sample_y - origin_y
        if dx < 0.0 { dx = -dx }
        if dy < 0.0 { dy = -dy }
        pointer_moved = dx > 2.0 || dy > 2.0 ||
            props.selecting
        if drag.started {
            result.anchor = initial
            result.cursor = initial
            result.selecting = false
        }
        if drag.active || drag.ended || activated {
            if pointer_moved {
                if !props.selecting { result.anchor = initial }
                result.cursor = selected
                result.selecting = drag.active
            } else {
                result.anchor = selected
                result.cursor = selected
                result.selecting = false
            }
        }
        result.preferred_x_valid = false
    }
    composition_state: CompositionState = props.composition
    if activated || drag.started || drag.active || drag.ended {
        if composition_state.active {
            composition_state = (CompositionState){}
            result.composition_changed = true
        }
    }
    transition: CompositionTransition = CompositionTransitionFor(
        composition_state, props.input.composition_event,
        result.focused, props.read_only || props.disabled)
    result.composition = transition.state
    result.composition_changed = result.composition_changed ||
        transition.changed
    navigation: bool = false
    if result.focused && !props.disabled &&
        !props.input.escape && !result.composition.active &&
        props.input.composition_event.phase ==
            (CompositionPhase)CompositionNone {
        if props.input.select_all {
            result.anchor = 0
            result.cursor = props.value.length
            navigation = true
        } else {
            target: i32 = result.cursor
            moved: bool = false
            selection: TextSelectionRange =
                TextSelectionRangeForLength(result.anchor,
                    result.cursor, props.value.length)
            caret: TextAreaCaret = TextAreaCaretFor(props.value,
                result.cursor, wrap_width, font,
                face.value.typeface, advance)
            if props.input.left {
                target = TextFieldPrevious(props.value,
                    result.cursor)
                if selection.has_selection && !props.input.shift {
                    target = selection.start
                }
                moved = true
            } else if props.input.right {
                target = TextFieldNext(props.value,
                    result.cursor)
                if selection.has_selection && !props.input.shift {
                    target = selection.end
                }
                moved = true
            } else if props.input.home {
                target = caret.row_start
                moved = true
            } else if props.input.end {
                target = caret.row_end
                moved = true
            } else if props.input.document_home {
                target = 0
                moved = true
            } else if props.input.document_end {
                target = props.value.length
                moved = true
            } else if props.input.up || props.input.down ||
                props.input.page_up || props.input.page_down {
                rows: i32 = 1
                if props.input.page_up || props.input.page_down {
                    rows = TextAreaPageRows(bounds.height,
                        font, gap, padding_y)
                }
                direction: i32 = 1
                if props.input.up || props.input.page_up {
                    direction = -1
                }
                preferred: i32 = caret.x
                if result.preferred_x_valid {
                    preferred = result.preferred_x
                }
                result.preferred_x = preferred
                result.preferred_x_valid = true
                target = TextAreaCursorAtPoint(props.value,
                    preferred,
                    (caret.row_index + direction * rows) *
                        advance + 1,
                    wrap_width, font, face.value.typeface,
                    advance)
                moved = true
            }
            if moved {
                state: TextSelectionState = TextSelectionAfterMove(
                    result.anchor, result.cursor, target,
                    props.input.shift)
                result.anchor = state.anchor
                result.cursor = state.cursor
                navigation = true
                if !props.input.up && !props.input.down &&
                    !props.input.page_up && !props.input.page_down {
                    result.preferred_x_valid = false
                }
            }
        }
    }
    if result.focused && !props.disabled && !props.input.escape {
        result.committed = props.input.commit &&
            !result.composition.active &&
            props.input.composition_event.phase ==
                (CompositionPhase)CompositionNone
        command: i32 = 0
        if props.input.copy {
            command = TextContextCommandCopy()
        } else if props.input.cut {
            command = TextContextCommandCut()
        } else if props.input.paste {
            command = TextContextCommandPaste()
        }
        if transition.commit {
            selection: TextSelectionRange = TextSelectionRangeForLength(
                result.anchor, result.cursor, props.value.length)
            if TextAreaInputTextAllowed(transition.commit_text) &&
                TextAreaReplacementAllowed(props, selection.start,
                    selection.end, transition.commit_text) {
                result.edit.start = selection.start
                result.edit.end = selection.end
                result.edit.replacement = transition.commit_text
                result.edit.changed = true
            }
        } else if props.input.composition_event.phase ==
            (CompositionPhase)CompositionNone &&
            !result.composition.active && command != 0 {
            selection: TextSelectionRange = TextSelectionRangeForLength(
                result.anchor, result.cursor, props.value.length)
            allow_copy: bool = command != TextContextCommandCut() ||
                !props.read_only
            decision: TextContextCommandDecision =
                TextEditCommandDecisionFor(command,
                    selection.has_selection, false, false,
                    props.value.length > 0, allow_copy,
                    !props.read_only, !props.read_only)
            if decision.copy_selection {
                result.clipboard_write = true
                result.clipboard_text = TextSpan(props.value,
                    selection.start, selection.end - selection.start)
            }
            if decision.paste &&
                TextAreaInputTextAllowed(props.input.paste_text) &&
                TextAreaReplacementAllowed(props, selection.start,
                    selection.end, props.input.paste_text) {
                result.edit.start = selection.start
                result.edit.end = selection.end
                result.edit.replacement = props.input.paste_text
                result.edit.changed = true
            } else if !decision.paste &&
                decision.delete_selection {
                result.edit.start = selection.start
                result.edit.end = selection.end
                result.edit.changed = result.edit.end >
                    result.edit.start
            }
        } else if !props.read_only &&
            props.input.composition_event.phase ==
                (CompositionPhase)CompositionNone &&
            !result.composition.active {
            result.edit = TextAreaEditFor(props,
                result.cursor, result.anchor)
        }
        if result.edit.changed {
            result.cursor = result.edit.start +
                result.edit.replacement.length
            result.anchor = result.cursor
            result.preferred_x_valid = false
            if result.composition.active {
                result.composition = (CompositionState){}
                result.composition_changed = true
            }
        }
    }
    if props.input.escape && result.composition.active {
        result.composition = (CompositionState){}
        result.composition_changed = true
    }
    result.escaped = props.input.escape && result.focused &&
        !props.composition.active &&
        props.input.composition_event.phase ==
            (CompositionPhase)CompositionNone
    if result.escaped { result.focused = false }
    if props.disabled || props.input.blur { result.focused = false }
    if TextAreaRevealCursorShouldRun(result.focused,
        result.edit.changed, navigation || pointer_moved ||
        props.input.focus) {
        caret: TextAreaCaret = TextAreaCaretFor(props.value,
            result.cursor, wrap_width, font,
            face.value.typeface, advance)
        viewport: i32 = (i32)bounds.height - padding_y * 2
        result.scroll_y = TextAreaScrollFor(
            TextAreaRevealScroll(result.scroll_y,
                caret.y, line_height, viewport),
            paint.max_scroll)
    }
    face = TextAreaFaceFor(props, result.focused)
    opacity: float = StyleOpacityValue(face.value.fields,
        face.value.opacity)
    if TreeIsBuilding() {
        result.node = TreeSubmitCurrent(key,
            WidgetKindTextArea, bounds)
        if result.node < 0 { return result }
        TreeSetInteractive(result.node, props.disabled,
            false, props.focus_id)
        TreeSetSemantic(result.node,
            (SemanticKind)SemanticTextArea, 0)
        TreeSetLabel(result.node, props.label)
        TreeSetSelected(result.node, result.focused)
        bounds = TreeSubmittedNodeAt(result.node).bounds
    }
    PaintRoundedFill(result.node, bounds,
        face.value.radius, 12,
        ColorFromPacked(Opacity(face.value.background,
            opacity)))
    border: u32 = face.value.border
    if result.focused { border = face.value.focus }
    if face.value.border_width > 0.0 {
        PaintRoundedOutline(result.node, bounds,
            face.value.radius, 12,
            face.value.border_width,
            ColorFromPacked(Opacity(border, opacity)))
    }
    paint = TextAreaPaintFor(bounds, font, gap,
        padding_x, padding_y, props.wrap,
        content_height, result.scroll_y, line_height,
        TextAreaMinWrapWidth(scale))
    if props.value == "" && props.placeholder != "" {
        PaintClippedLabel(result.node, props.placeholder,
            paint.placeholder_x, paint.placeholder_y,
            font, ColorFromPacked(Opacity(
                (u32)0x64748bff, opacity)),
            paint.clip_bounds)
    }
    selection: TextSelectionRange = TextSelectionRangeForLength(
        result.anchor, result.cursor, props.value.length)
    caret: TextAreaCaret = TextAreaCaretFor(props.value,
        result.cursor, wrap_width, font,
        face.value.typeface, advance)
    offset: i32 = 0
    row_index: i32 = 0
    first_token: bool = true
    block_comment: bool = false
    dark_syntax: bool = SyntaxDarkBackground(
        face.value.background)
    while offset <= props.value.length {
        row: TextAreaRow = TextAreaNextRow(props.value,
            offset, wrap_width, font,
            face.value.typeface)
        y: i32 = (i32)paint.clip_bounds.y +
            row_index * advance - result.scroll_y
        row_visible: bool = y + advance >
            (i32)paint.clip_bounds.y &&
            y < (i32)(paint.clip_bounds.y +
                paint.clip_bounds.height)
        if row_visible {
            if selection.has_selection && result.focused {
                span: TextSelectionPaintSpan =
                    TextSelectionPaintSpanForLine(
                        selection.start, selection.end,
                        row.start, row.end)
                if span.visible {
                    left: i32 = GlyphWidth(TextSpan(props.value,
                        row.start, span.start - row.start),
                        font, face.value.typeface)
                    right: i32 = GlyphWidth(TextSpan(props.value,
                        row.start, span.end - row.start),
                        font, face.value.typeface)
                    highlight: Rectangle = RectangleIntersection(
                        (Rectangle){paint.clip_bounds.x +
                            (float)left, (float)y,
                            (float)(right - left),
                            (float)line_height},
                        paint.clip_bounds)
                    if highlight.width > 0.0 &&
                        highlight.height > 0.0 {
                        PaintRoundedFill(result.node,
                            highlight, 0.0, 1,
                            ColorFromPacked(Opacity(
                                (u32)0x93c5fd88, opacity)))
                    }
                }
            }
        }
        if row.end > row.start {
            if props.syntax == (SyntaxMode)SyntaxNone {
                if row_visible {
                PaintClippedLabel(result.node,
                    TextSpan(props.value, row.start,
                        row.end - row.start),
                    (i32)paint.clip_bounds.x, y,
                    font, ColorFromPacked(Opacity(
                        face.value.foreground, opacity)),
                    paint.clip_bounds)
                }
            } else {
                token_start: i32 = row.start
                while token_start < row.end {
                    token: SyntaxToken = SyntaxTokenAt(
                        props.value, token_start, row.end,
                        props.syntax, first_token,
                        block_comment)
                    if token.length <= 0 { break }
                    if row_visible {
                        prefix: string = TextSpan(props.value,
                            row.start, token_start - row.start)
                        token_x: i32 = (i32)paint.clip_bounds.x +
                            GlyphWidth(prefix, font,
                                face.value.typeface)
                        PaintClippedLabel(result.node,
                            TextSpan(props.value,
                                token_start, token.length),
                            token_x, y, font,
                            ColorFromPacked(Opacity(
                                SyntaxColorFor(token.kind,
                                    dark_syntax,
                                    face.value.foreground),
                                opacity)), paint.clip_bounds)
                    }
                    if token.kind !=
                        (SyntaxTokenKind)SyntaxWhitespace {
                        first_token = false
                    }
                    block_comment = token.block_comment
                    token_start += token.length
                }
            }
        }
        if result.focused && row_visible &&
            props.composition_end > props.composition_start {
            composition: TextCompositionPaintSpan =
                TextCompositionPaintSpanForLine(
                    props.composition_start,
                    props.composition_end,
                    row.start, row.end)
            if composition.visible {
                stroke: i32 = TextInputStrokeWidth(scale)
                left: i32 = GlyphWidth(TextSpan(props.value,
                    row.start, composition.start - row.start),
                    font, face.value.typeface)
                right: i32 = GlyphWidth(TextSpan(props.value,
                    row.start, composition.end - row.start),
                    font, face.value.typeface)
                right = TextCompositionUnderlineEndX(left,
                    right, stroke)
                underline: Rectangle = RectangleIntersection(
                    (Rectangle){paint.clip_bounds.x +
                        (float)left,
                        (float)TextCompositionUnderlineY(y,
                            line_height, stroke),
                        (float)(right - left), (float)stroke},
                    paint.clip_bounds)
                if underline.width > 0.0 &&
                    underline.height > 0.0 {
                    PaintRoundedFill(result.node, underline,
                        0.0, 1,
                        ColorFromPacked(Opacity(
                            face.value.focus, opacity)))
                }
            }
        }
        if !row.soft_wrap { first_token = true }
        if row.next <= offset { break }
        offset = row.next
        row_index += 1
    }
    if result.focused && !props.disabled {
        x: i32 = (i32)paint.clip_bounds.x + caret.x
        y: i32 = (i32)paint.clip_bounds.y +
            caret.y - result.scroll_y
        if x >= (i32)paint.clip_bounds.x &&
            x <= (i32)(paint.clip_bounds.x +
                paint.clip_bounds.width) &&
            y + line_height > (i32)paint.clip_bounds.y &&
            y < (i32)(paint.clip_bounds.y +
                paint.clip_bounds.height) {
            PaintLine(result.node,
                (Rectangle){(float)x, (float)y,
                    0.0, (float)line_height},
                ColorFromPacked(Opacity(
                    face.value.foreground, opacity)))
        }
    }
    return result
}
