#import "options"

#program_export
ProjectOptionsTest :: () -> s32 {
    source: string = "default_profile=tui\nprofiles=tui other\nprofiles.tui.backend=terminal\nprofiles.tui.codegen=c99\nprofiles.tui.library=crypto\nprofiles.tui.static_archive=build/libdemo.a\nprofiles.other.backend=terminal\ninstall.autostart=false\n"
    config: ProjectConfig = ParseProject(source, "demo", "src/custom.zi")
    if !config.ok || config.name != "demo" ||
    config.entry != "src/custom.zi" ||
    config.profile_count != 2 ||
    config.default_profile != "tui" { return 1 }
    selected: ProjectProfile = ProjectProfileNamed(config, config.default_profile)
    if selected.name != "tui" || selected.backend != "terminal" ||
    selected.codegen != "c99" || selected.library != "crypto" ||
    selected.static_archive != "build/libdemo.a" { return 2 }
    if ProjectProfileNamed(config, "missing").name != "" { return 3 }

    minimal: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\n", "demo", "")
    if !minimal.ok || minimal.entry != "src/app.zi" ||
    minimal.default_profile != "tui" ||
    minimal.profiles[0].codegen != "c99" { return 4 }

    installed: ProjectConfig = ParseProject(
        "default_profile=cairo\nprofiles=cairo\nprofiles.cairo.backend=desktop\ninstall.profile=cairo\ninstall.name=Demo App\ninstall.icon=assets/icon.png\ninstall.working_directory=.\ninstall.autostart=true\ninstall.autostart_env=DEMO_HIDDEN=1\n",
        "demo", "src/app.zi")
    if !installed.ok || installed.install.profile != "cairo" ||
    installed.install.name != "Demo App" || !installed.install.autostart ||
    installed.install.autostart_env != "DEMO_HIDDEN=1" { return 5 }

    bad_path: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\n", "demo", "src/$oops.zi")
    if bad_path.ok { return 6 }
    missing_default: ProjectConfig = ParseProject(
        "default_profile=other\nprofiles=tui\nprofiles.tui.backend=terminal\n",
        "demo", "")
    if missing_default.ok { return 7 }
    duplicate: ProjectConfig = ParseProject(
        "profiles=tui tui\nprofiles.tui.backend=terminal\n", "demo", "")
    if duplicate.ok { return 8 }
    unsafe_library: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\nprofiles.tui.library=crypto;touch\n",
        "demo", "")
    if unsafe_library.ok { return 9 }
    unsafe_install: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\ninstall.autostart_env=A=1;touch x\n",
        "demo", "")
    if unsafe_install.ok { return 10 }
    missing_name: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\n", "", "")
    if missing_name.ok { return 11 }
    unknown_install_profile: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\ninstall.profile=cairo\n",
        "demo", "")
    if unknown_install_profile.ok { return 12 }
    absolute_archive: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\nprofiles.tui.static_archive=/opt/libdemo.a\n",
        "demo", "")
    if absolute_archive.ok { return 13 }
    escaping_archive: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\nprofiles.tui.static_archive=../libdemo.a\n",
        "demo", "")
    if escaping_archive.ok { return 14 }
    // [tool.kryon] entry names the window's program over the package entry.
    windowed: ProjectConfig = ParseProject(
        "entry=src/app.zi\nprofiles=tui\nprofiles.tui.backend=terminal\n",
        "demo", "src/main.zi")
    if !windowed.ok || windowed.entry != "src/app.zi" { return 15 }
    unsafe_entry: ProjectConfig = ParseProject(
        "entry=src/$(x).zi\nprofiles=tui\nprofiles.tui.backend=terminal\n",
        "demo", "src/main.zi")
    if unsafe_entry.ok { return 16 }
    custom_host: ProjectConfig = ParseProject(
        "profiles=tui\nprofiles.tui.backend=terminal\nprofiles.tui.host=src/runner.zi\n",
        "demo", "src/app.zi")
    if !custom_host.ok || custom_host.profiles[0].host != "src/runner.zi" {
        return 17
    }
    if ProjectHostValid("../runner.zi") || ProjectHostValid("src/../runner.zi") ||
    ProjectHostValid("/tmp/runner.zi") || ProjectHostValid("src/runner.c") ||
    ProjectHostValid("src/$(touch).zi") { return 18 }
    return 42
}
