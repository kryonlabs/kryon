#module "locale_props"
#import "kryon_compat.generated.h"

# C-only records: the catalog hands out mutable char* spans owned by the
# loader, so both pass through as C text.
LocaleEntry :: struct { char *key; char *value; } #type
LocaleLanguage :: struct { char *code; char *label; } #type

# Implemented by the C-only locale host; declared here for the public ABI.
# FormatLocaleText keeps its C varargs tail verbatim.
InitLocale :: () #extern #export
SetLocale :: (code: const char*) -> i32 #extern #export
GetSystemLocaleCode :: () -> const char* #extern #export
GetDefaultLocaleCode :: () -> const char* #extern #export
GetLocaleText :: (key: const char*) -> const char* #extern #export
FormatLocaleText :: (dst: *char, dst_size: size_t, key: const char*, ...) #extern #export
GetLocaleCount :: () -> i32 #extern #export
GetLocaleCode :: (index: i32) -> const char* #extern #export
GetLocaleLabel :: (index: i32) -> const char* #extern #export
GetLocaleIndex :: (code: const char*) -> i32 #extern #export
GetCurrentLocaleCode :: () -> const char* #extern #export
GetCurrentLocaleIndex :: () -> i32 #extern #export
