#import "motion_clock"
#import "frame_motion"
#import "geometry"
#import "layout_motion_slot"
#import "motion_history"
#import "session"
#import "tree"
Motion :: #import "motion";
Theme :: #import "theme";
#import "vec"

Options :: struct {
    seconds: float64
    timing: Motion.Timing
    reduced_motion: bool
    resize: bool
    enter: bool
}

LayoutTransition :: struct {
    x: Motion.TweenState
    y: Motion.TweenState
    width: Motion.TweenState
    height: Motion.TweenState
    entering: bool
}

layout_history: [9]MotionHistory(LayoutTransition);
LayoutScope :: struct {
    enabled: bool
    options: Options
}

layout_scopes: [9]Vec(LayoutScope);

LayoutMotionFrame :: (session: Session, commit: bool) {
    history := *layout_history[session.slot]
    if commit {
        MotionHistoryCommit(history)
        return
    }
    MotionHistoryStart(history, session.epoch)
    if session.epoch == 0 { VecFree(layout_scopes[session.slot]) }
    else { unused VecResize(layout_scopes[session.slot], 0) }
}

LayoutMotionPlace :: (session: Session, parent: s32, identity: u64,
    target: Rectangle, previous: Rectangle, retained: bool) -> Rectangle {
    scopes := *layout_scopes[session.slot]
    if parent >= scopes.count || !scopes.*[parent].enabled { return target }
    options := scopes.*[parent].options
    if !retained && !options.enter { return target }
    now := MotionTime(session)
    row: LayoutTransition
    history := *layout_history[session.slot]
    if !MotionHistoryRead(history, identity, *row) {
        unused Motion.TweenTo(*row.x, previous.x, now, 0.0, options.timing)
        unused Motion.TweenTo(*row.y, previous.y, now, 0.0, options.timing)
    }
    x := Motion.TweenTo(*row.x, target.x, now, options.seconds, options.timing, options.reduced_motion)
    y := Motion.TweenTo(*row.y, target.y, now, options.seconds, options.timing, options.reduced_motion)
    placed := target
    placed.x = x.value
    placed.y = y.value
    row.entering = options.enter && (!retained || row.entering)
    moving := x.active || y.active
    if options.resize || row.entering {
        if !row.width.initialized {
            initial_width := ifx retained then previous.width else 0.0
            initial_height := ifx retained then previous.height else 0.0
            unused Motion.TweenTo(*row.width, initial_width, now, 0.0, options.timing)
            unused Motion.TweenTo(*row.height, initial_height, now, 0.0, options.timing)
        }
        width := Motion.TweenTo(*row.width, target.width, now, options.seconds, options.timing, options.reduced_motion)
        height := Motion.TweenTo(*row.height, target.height, now, options.seconds, options.timing, options.reduced_motion)
        placed.width = ifx width.value > 0.0 then width.value else 0.0
        placed.height = ifx height.value > 0.0 then height.value else 0.0
        row.entering = row.entering && (width.active || height.active)
        moving = moving || width.active || height.active
    } else {
        row.width.initialized = false
        row.height.initialized = false
    }
    if !MotionHistoryWrite(history, identity, row) { return target }
    if moving { FrameMotionMark(session) }
    return placed
}

// Call in an open Row, Column, Grid or other group before drawing its children.
// Keyed children keep their visual position during a reorder or reflow.
// Opt into size transitions with resize and grow new children with enter.
Children :: (session: Session, options: Options = .{.seconds = 0.24, .timing = .{.curved = true, .x2 = 0.58, .y2 = 1.0}}) -> bool {
    if !SessionValid(session) || !TreeIsBuilding(session) { return false }
    parent := TreeCurrentParent(session)
    if parent < 0 { return false }
    history := *layout_history[session.slot]
    if history.epoch != session.epoch { MotionHistoryStart(history, session.epoch) }
    frame_layout_motion = LayoutMotionFrame
    layout_motion_sample = LayoutMotionPlace
    theme := Theme.CurrentTheme()
    options.reduced_motion = options.reduced_motion || theme.motion.reduced_motion
    options.seconds *= cast(float64)theme.motion.multiplier
    scopes := *layout_scopes[session.slot]
    if parent >= scopes.count && !VecResize(<<scopes, cast(s64)parent + 1) { return false }
    scopes.*[parent] = .{true, options}
    return true
}

PresenceOptions :: struct {
    seconds: float64
    timing: Motion.Timing
    reduced_motion: bool
}

PresenceState :: struct {
    session: Session
    tween: Motion.TweenState
}

PresenceSample :: struct {
    fraction: float32
    draw: bool
    interactive: bool
}

// Keep one state per child. The first sample uses the requested endpoint.
// During exit, keep submitting the child while draw is true and disable input.
Presence :: (session: Session, state: *PresenceState, present: bool,
    options: PresenceOptions = .{.seconds = 0.24, .timing = .{.curved = true, .x2 = 0.58, .y2 = 1.0}}) -> PresenceSample {
    target: float32 = ifx present then 1.0 else 0.0
    if state == null || !SessionValid(session) || !TreeIsBuilding(session) {
        return .{target, present, present}
    }
    if state.session.slot != session.slot || state.session.epoch != session.epoch {
        state.* = PresenceState.{.session = session}
    }
    motion := Theme.CurrentTheme().motion
    seconds := options.seconds * cast(float64)motion.multiplier
    reduced := options.reduced_motion || motion.reduced_motion
    sample := Motion.TweenTo(*state.tween, target, MotionTime(session),
        seconds, options.timing, reduced)
    if sample.active { FrameMotionMark(session) }
    fraction := sample.value
    if fraction < 0.0 { fraction = 0.0 }
    if fraction > 1.0 { fraction = 1.0 }
    return .{fraction, present || sample.active, present}
}
