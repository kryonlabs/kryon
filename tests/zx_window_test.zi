// examples/window.tsx as a portable bundle, run as native code on a private
// Xvfb two ways, each through a private host registry: `ziran run --backend
// native` finds the installed desktop player, and `zx2native` writes a Linux
// executable that links the desktop host library's zx_window capabilities.
// Each time the bundle's own loop shows one 320 by 160 window titled
// "Window" in an empty frame's colour, which closes with status 0 on a window
// manager's close request. With no host library registered, zx2native stops
// at the gap that names the capability and writes nothing.
//
// Run from the Kryon root after make zx-player zx-window-host, never against
// the live desktop, with an absolute work folder, the player, the host
// library and zx2native:
//     ziran run --target=c tests/zx_window_test.zi -- $PWD/build/test/zx-window \
//         $PWD/build/bin/zx $PWD/build/lib/libkryon-desktop.so ZIRAN/build/bin/zx2native
// ZIRAN_BIN names the ziran command (default ziran); ZIRAN_IDENTITY is what
// `ziran version --identity` prints for it.
#import "private_display_linux"
#import "c_string"
#import "byte_text_linux"
#import "format"
#import "file"
#import "file_tree_linux"
#import "timer_linux"
#import "environment_linux"
#import "process_run_linux"
#import "text_tools"
using Vectors :: #import "vec";

// The empty frame's colour, as desktop_window and zx_window clear to.
EMPTY_COLOR :: 0xf8fafc

Path :: (folder: string, name: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", folder, name)
    return BuilderFinish(path)
}

Setting :: (name: string, value: string) -> string {
    entry: Vec(u8)
    BuilderPrint(*entry, "%=%", name, value)
    return BuilderFinish(entry)
}

Fail :: (message: string) -> s32 {
    print("zx window: %\n", message)
    return 1
}

// A registration holding one absolute path.
// A registration names its target; a provider's also names the toolchain
// identity it was built for, which `ziran run` requires.
Register :: (path: string, target: string, identity: string = "") -> bool {
    registration: Vec(u8)
    BuilderPrint(*registration, "%\n", target)
    if identity != "" { BuilderPrint(*registration, "ziran %\n", identity) }
    return WriteEntireFile(path, BuilderFinish(registration))
}

// Runs COMMAND to completion with EXTRA settings, its output in LOG.
Run :: (command: []string, extra: []string, log: string) -> s32 {
    finished: ProcessRun
    options: ProcessOptions = .{.arguments = command, .environment = extra, .output_path = log, .merge_error = true}
    if !RunProcess(options, *finished) { return -1 }
    return finished.code
}

// Waits for the run's window, checks its title, size and colour, asks it to
// close and checks the run then ends with status 0.
CheckWindow :: (display: *PrivateDisplay, app: *ProcessRun, route: string) -> s32 {
    window := FindSessionWindow(display, app, 30000)
    if window == 0 {
        unused StopOwnedProcess(app, 2000)
        print("zx window: % showed no window\n", route)
        return 1
    }
    status: s32
    title := WindowTitle(display, window)
    width, height := WindowSize(display, window)
    image: DisplayImage
    if title != "Window" {
        print("zx window: % titled the window \"%\"\n", route, title)
        status = 1
    } else if width != 320 || height != 160 {
        print("zx window: % opened a % by % window\n", route, width, height)
        status = 1
    } else {
        // The window maps before its first frame is presented, and X shows
        // black until then, longer while other tests load the machine. Wait
        // up to 10 s for the presented frame; the assertion stays exact.
        painted_deadline := MonotonicMilliseconds() + 10000
        while true {
            if !CaptureWindow(display, window, *image) {
                status = Fail("cannot capture the window")
                break
            }
            if ImagePixel(*image, 0, 0) == cast(u32)EMPTY_COLOR && ImageColorCount(*image) == 1 { break }
            if MonotonicMilliseconds() < painted_deadline && !PollProcess(app) {
                unused SleepMilliseconds(20)
                continue
            }
            first := ImagePixel(*image, 0, 0)
            print("zx window: % showed % colours, the first %, %, %\n", route, ImageColorCount(*image),
                PixelRed(first), PixelGreen(first), PixelBlue(first))
            status = 1
            break
        }
    }
    if !RequestWindowClose(display, window) {
        unused StopOwnedProcess(app, 2000)
        return Fail("cannot ask the window to close")
    }
    deadline := MonotonicMilliseconds() + 10000
    while !PollProcess(app) && MonotonicMilliseconds() < deadline { unused SleepMilliseconds(20) }
    if !app.finished {
        unused StopOwnedProcess(app, 2000)
        print("zx window: closing the window did not end %\n", route)
        return 1
    }
    if app.code != 0 {
        print("zx window: % exited with status %\n", route, app.code)
        return 1
    }
    return status
}

// Waits for an App.Run UI window, checks that it painted multiple colours
// (rendered text over background), closes it and checks status 0.
CheckUiWindow :: (display: *PrivateDisplay, app: *ProcessRun, route: string) -> s32 {
    window := FindSessionWindow(display, app, 30000)
    if window == 0 {
        unused StopOwnedProcess(app, 2000)
        print("zx window: % showed no window\n", route)
        return 1
    }
    status: s32
    image: DisplayImage
    painted_deadline := MonotonicMilliseconds() + 10000
    while true {
        if !CaptureWindow(display, window, *image) {
            status = Fail("cannot capture the UI window")
            break
        }
        if ImageColorCount(*image) > 1 { break }
        if MonotonicMilliseconds() < painted_deadline && !PollProcess(app) {
            unused SleepMilliseconds(20)
            continue
        }
        print("zx window: % showed only % colour(s)\n", route, ImageColorCount(*image))
        status = 1
        break
    }
    if !RequestWindowClose(display, window) {
        unused StopOwnedProcess(app, 2000)
        return Fail("cannot ask the UI window to close")
    }
    deadline := MonotonicMilliseconds() + 10000
    while !PollProcess(app) && MonotonicMilliseconds() < deadline { unused SleepMilliseconds(20) }
    if !app.finished {
        unused StopOwnedProcess(app, 2000)
        print("zx window: closing the UI window did not end %\n", route)
        return 1
    }
    if app.code != 0 {
        print("zx window: % exited with status %\n", route, app.code)
        return 1
    }
    return status
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 5 { return Fail("usage: zx_window_test FOLDER PLAYER LIBRARY ZX2NATIVE") }
    folder := TextFromCString(argv[1])
    player := TextFromCString(argv[2])
    library := TextFromCString(argv[3])
    zx2native := TextFromCString(argv[4])
    for path: string.[folder, player, library, zx2native] {
        if path == "" || path[0] != #char "/" { return Fail("every path must be absolute") }
    }
    ziran := EnvironmentText("ZIRAN_BIN")
    if ziran == "" { ziran = "ziran" }
    hosts := Path(folder, "hosts")
    empty := Path(folder, "no-hosts")
    if !CreateDirectories(hosts) || !CreateDirectories(empty) { return Fail("cannot create the host registries") }
    // The registry holds only this checkout's player and host library.
    identity := EnvironmentText("ZIRAN_IDENTITY")
    if identity == "" { return Fail("ZIRAN_IDENTITY must name the toolchain identity") }
    if !Register(Path(hosts, "kryon-desktop.host"), player, identity) ||
        !Register(Path(hosts, "kryon-desktop.library"), library) {
        return Fail("cannot register the player and the host library")
    }
    bundle := Path(folder, "window.zx")
    build: [10]string = .[ziran, "bundle", "--project", "--root", "examples", "--entry", "window:main",
    "-o", bundle, "examples/window.tsx"]
    none: [0]string
    if Run(build[:], none[:], Path(folder, "bundle.log")) != 0 { return Fail("window.tsx does not bundle") }

    // No registered library defines the capabilities: a named gap, no file.
    gap := Path(folder, "gap.elf")
    lower: [4]string = .[zx2native, "-o", gap, bundle]
    unlinked: [1]string = .[Setting("ZIRAN_HOST_PATH", empty)]
    gap_log := Path(folder, "gap.log")
    if Run(lower[:], unlinked[:], gap_log) == 0 { return Fail("zx2native linked window.zx with no host library") }
    gap_text, read := ReadEntireFile(gap_log)
    if !read || !TextContains(gap_text, "assembly.gap.machine-host") || !TextContains(gap_text, "ZxWindowOpenHost") ||
        PathExists(gap) {
        return Fail("an unlinked window.zx did not stop at the gap naming ZxWindowOpenHost; see gap.log")
    }
    // With the host library registered, the executable links it.
    executable := Path(folder, "window.elf")
    lower[2] = executable
    linked: [1]string = .[Setting("ZIRAN_HOST_PATH", hosts)]
    if Run(lower[:], linked[:], Path(folder, "elf.log")) != 0 { return Fail("zx2native did not lower window.zx; see elf.log") }

    display := OpenPrivateDisplay(1024, 768, Path(folder, "xvfb.log"))
    if !display.valid { return Fail(display.error) }
    defer ClosePrivateDisplay(*display)
    run: [5]string = .[ziran, "run", "--backend", "native", bundle]
    extra: [2]string = .[Setting("ZIRAN_HOST_PATH", hosts), Setting("ZIRAN_NATIVE_CACHE", Path(folder, "native"))]
    // ziran run starts the player, which draws the window.
    app := StartOnDisplay(*display, run[:], extra[:], "", Path(folder, "app.log"))
    if !app.started { return Fail("ziran run did not start") }
    if CheckWindow(*display, *app, "ziran run") != 0 { return 1 }
    // The executable calls the library's capabilities itself.
    direct: [1]string = .[executable]
    elf := StartOnDisplay(*display, direct[:], none[:], "", Path(folder, "elf-run.log"))
    if !elf.started { return Fail("window.elf did not start") }
    if CheckWindow(*display, *elf, "window.elf") != 0 { return 1 }

    // Headless text measurement links directly from libkryon-desktop.so
    // (no separate CPU-only pixmap library and no X display needed).
    measure_src := Path(folder, "measure.zi")
    if !WriteEntireFile(measure_src, "Font :: #import \"kryon/font_metrics\";\nmain :: () -> s32 {\n    if Font.MeasureGlyphWidth(\"Hello, world!\", 24, \"\") <= 0 || Font.MeasureGlyphLineHeight(24, \"\") <= 0 { return 1 }\n    return 0\n}\n") {
        return Fail("cannot write measure.zi")
    }
    measure_bundle := Path(folder, "measure.zx")
    measure_build: [10]string = .[ziran, "bundle", "--project", "--root", folder, "--entry", "measure:main",
        "-o", measure_bundle, measure_src]
    if Run(measure_build[:], none[:], Path(folder, "measure-bundle.log")) != 0 {
        return Fail("measure.zi does not bundle")
    }
    measure_elf := Path(folder, "measure.elf")
    measure_lower: [4]string = .[zx2native, "-o", measure_elf, measure_bundle]
    if Run(measure_lower[:], linked[:], Path(folder, "measure-elf.log")) != 0 {
        return Fail("zx2native did not lower measure.zx against libkryon-desktop.so")
    }
    measure_cmd: [1]string = .[measure_elf]
    if Run(measure_cmd[:], none[:], Path(folder, "measure-run.log")) != 0 {
        return Fail("measure.elf failed headless glyph measurement")
    }

    // A full App.Run UI bundle (examples/hello.tsx) also lowers via zx2native
    // against libkryon-desktop.so and opens a real SDL2/Cairo window.
    if PathExists("src/backend/frames_zx.zi") {
        hello_bundle := Path(folder, "hello.zx")
        hello_build: [10]string = .[ziran, "bundle", "--project", "--root", "examples", "--entry", "hello:main",
            "-o", hello_bundle, "examples/hello.tsx"]
        if Run(hello_build[:], none[:], Path(folder, "hello-bundle.log")) != 0 {
            return Fail("hello.tsx does not bundle")
        }
        hello_elf := Path(folder, "hello.elf")
        hello_lower: [4]string = .[zx2native, "-o", hello_elf, hello_bundle]
        if Run(hello_lower[:], linked[:], Path(folder, "hello-elf.log")) != 0 {
            return Fail("zx2native did not lower hello.zx against libkryon-desktop.so; see hello-elf.log")
        }
        hello_cmd: [1]string = .[hello_elf]
        hello_run := StartOnDisplay(*display, hello_cmd[:], none[:], "", Path(folder, "hello-run.log"))
        if !hello_run.started { return Fail("hello.elf did not start") }
        if CheckUiWindow(*display, *hello_run, "hello.elf") != 0 { return 1 }
    }

    print("zx window: window.zx, headless measurement and hello.zx ran natively linking libkryon-desktop.so (SDL2/Cairo) and exited 0; with no host library zx2native named the gap\n")
    return 0
}
