#module "plot_props"
#import "geometry"

PlotMode :: enum {
    PlotLines = 0
    PlotBars = 1
}

PlotProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    class_name: i32
    label: string
    overlay: string
    offset: i32
    scale_min: float
    scale_max: float
    scale: float
    mode: PlotMode
}
