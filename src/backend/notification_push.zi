            !PEqual(env, PGet(env, prefs, "auth"), NString(env, TextFromCString(*auth_bytes[0]))) ||
            !PEqual(env, PGet(env, prefs, "p256dh"), NString(env, TextFromCString(*key_bytes[0]))) || PInt(env, prefs, "status") != PushReady
