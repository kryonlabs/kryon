#module "inspect_props"
#import "kryon_compat.generated.h"

InspectSelection :: struct {
    id: [96]char
    kind: [32]char
    action: [64]char
    source_path: [512]char
    bounds: Rectangle
    flags: int
    kind_index: int
    source_line: int
    valid: int
}

InspectNode :: struct {
    name: [96]char
    role: [32]char
    text: [64]char
    value: [128]char
    source_path: [512]char
    bounds: Rectangle
    flags: int
    order: int
    parent: int
    source_line: int
    valid: int
}
