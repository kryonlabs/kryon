#module "spinbox_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/input.h"
#import "runtime/spinbox.h"
#import "ui/paint_command.h"

SpinboxStepButton :: (bounds: Rectangle, label: const char*,
id: i32, class_name: i32, disabled: i32,
surface_bounds: Rectangle) -> i32 {
    button: ButtonSpec
    button.props.bounds = bounds
    button.props.label = label
    button.props.id = id
    button.props.class_name = class_name
    button.props.disabled = disabled
    button.style_resolved = 1
    button.surface_bounds = surface_bounds
    button.style_kind = StyleKindButton()
    return ui_button_render(button)
}

RenderSpinbox :: (spinbox: SpinboxProps) -> i32 #export {
    runtime_scale: float = (float)Scale(1000) / 1000.0
    layout: SpinboxLayout = SpinboxLayoutFor(spinbox.bounds,
    SpinboxDefaultButtonWidth(runtime_scale))
    disabled: i32 = spinbox.disabled || ContentDisabled()
    if disabled != 0 { MarkDisabled() }

    value_text: [32]char
    if spinbox.value_text != nil {
        snprintf(&value_text[0], sizeof(value_text), "%s",
        spinbox.value_text)
    } else {
        value: i32 = 0
        if spinbox.value != nil { value = *spinbox.value }
        snprintf(&value_text[0], sizeof(value_text),
        InputDefaultFormat(NumericInt), value)
    }
    if IsWindowReady() {
        state: ButtonState = ButtonStateNormal
        if disabled != 0 { state = ButtonStateDisabled }
        frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, state, disabled, 0, spinbox.class_name,
        StyleKindSpinbox(), StyleAny())
        value_frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, state, disabled, 0, spinbox.class_name,
        StyleKindSpinboxValue(), StyleAny())
        value_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(value_frame).value)
        value_font: i32 = ResolveFont(0, StyleFontValue(value_style.fields,
        value_style.font_size), GetFontSize())
        DrawWidgetFrame(spinbox.bounds, (Rectangle){0},
        frame, 0, 0, disabled, 0)
        DrawWidgetFrame(layout.text, spinbox.bounds,
        value_frame, 0, 0, disabled, 0)
        DrawCenteredText(&value_text[0],
        (int)(layout.text.x + layout.text.width / 2.0),
        (int)(layout.text.y + layout.text.height / 2.0), value_font,
        Fade(value_style.foreground, value_style.opacity))
    }

    decrement: i32 = SpinboxStepButton(layout.left, "-",
    SpinboxDecrementIdFor(spinbox.id), spinbox.class_name, disabled,
    spinbox.bounds)
    increment: i32 = SpinboxStepButton(layout.right, "+",
    SpinboxIncrementIdFor(spinbox.id), spinbox.class_name, disabled,
    spinbox.bounds)
    if spinbox.value == nil { return 0 }
    step: SpinboxStepResult = SpinboxStepButtonsValue(*spinbox.value,
    spinbox.min, spinbox.max, spinbox.step,
    decrement != 0, increment != 0, spinbox.wrap != 0)
    *spinbox.value = step.value
    return step.changed
}
