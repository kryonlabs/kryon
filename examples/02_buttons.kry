    icon_label_x: [8] int = {30, 114, 209, 294, 402, 481, 557, 671}
    text_labels: [2] const char* = {"Run", "Cancel"}
    leading_labels: [2] const char* = {"Run", "Delete"}
    trailing_labels: [2] const char* = {"Run", "Save"}
    leading_icons: [2] int = {UI_ICON_TYPE_PLAY, UI_ICON_TYPE_TRASH}
