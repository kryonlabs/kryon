// Pay per import: an example's generated C holds only what it imports.
// Each case builds an example to C the way an application does, then checks
// which modules the output carries. A module counts as present when a
// generated file is named after it (packages prefix their modules, as in
// p1f51d1621a97ce31_riff.c) or when the C names it as the module a part was
// generated from, so the check holds for one file per module and for one
// file per program.
//
// Run from the Kryon root: ziran run --target=c tests/pay_per_import_test.zi
// ZIRAN_BIN names the ziran command (default ziran).
#import "std/process_run_linux"
#import "std/file_tree_linux"
#import "std/file"
#import "std/text_tools"
#import "std/environment_linux"
#import "toolchain_pin"
using Vectors :: #import "vec";

// What an empty window must never carry: the frame loop and desktop
// runtime, the raster, accessibility, sessions, input, widgets, text,
// fonts, pictures, video, threads, the test driver, asset paths and title
// files.
not_in_a_window: [48]string = .["frames_desktop", "desktop_loop", "desktop_runtime",
    "cairo_raster", "raster_picture", "accessibility_linux", "atspi_protocol", "session",
    "frame_clock", "frame_driver", "frame_input_provider", "frame_snapshot",
    "input_protocol", "input_delivery", "secondary_pointer", "desktop_keys", "std_utf8",
    "std_timer_linux", "std_byte_text_linux", "app_types",
    "tree", "tree_draw", "tree_input", "tree_frame", "paint_queue", "font_metrics",
    "text_layout", "text_request", "text_input_platform", "cursor", "scroll_device",
    "gamepad_navigation", "input_take", "test_driver", "test_driver_frame",
    "bitmap_store", "image_decode_desktop", "avif_decode", "lanczos_cache",
    "ziran_image_decode", "riff", "bmff", "video_linux", "std_thread_linux",
    "std_parallel_linux", "program_title", "app_asset_path", "accessibility_tree_linux"];

// The checked program of an empty window on Linux: the window, kryon/app,
// its types, the SDL window and presenter, and C strings.
window_checked: [8]string = .["window", "app", "app_types", "desktop_window",
    "desktop_process_linux", "sdl_event", "pixmap_sdl", "std_c_string"];

// The checked program of an empty window as a portable bundle: the window,
// kryon/app, its types and the bundle's window.
zx_window_checked: [4]string = .["window", "app", "app_types", "zx_window"];

// The bundle's instructions: the window, kryon/app and the bundle's window,
// which asks its host for nothing but the window, its events, clearing and
// presenting. The lists are exact, so no font measurement, text, raster or
// frame module or capability can come with them.
zx_window_modules: [3]string = .["window", "app", "zx_window"];
zx_window_capabilities: [5]string = .["ZxWindowOpenHost", "ZxWindowEventHost", "ZxWindowClearHost",
    "ZxWindowPresentHost", "ZxWindowCloseHost"];

// The checked program of an empty window on the web: the window, kryon/app,
// its types, the page window and the page it opens.
web_window_checked: [10]string = .["window", "app", "app_types", "page_window", "page_core",
    "page_geometry", "std_web", "std_text_buffer", "std_number_text", "std_byte_text_linux"];

// What a web program that warps or smooths no picture carries none of.
not_in_a_plain_page: [5]string = .["image", "lanczos_cache", "std_resample", "page_mesh",
    "test_driver"];

// What a web frame example with no picture, text field or scroll carries none of.
not_in_a_plain_web_frame: [11]string = .["image", "lanczos_cache", "std_resample", "page_mesh",
    "test_driver", "text_request", "text_input_platform", "scroll_device",
    "style_motion", "layout_motion", "motion_history"];

// What no example that shows no picture or video carries.
not_without_pictures: [10]string = .["image_decode_desktop", "avif_decode", "lanczos_cache",
    "ziran_image_decode", "riff", "bmff", "video_linux", "std_thread_linux",
    "std_parallel_linux", "app_asset_path"];

// What a frame example carries none of when it shows no picture, edits no
// text and has no scroll, tabs, text area or grid: the picture chain, text
// input and the scroll device.
not_in_a_plain_frame: [17]string = .["image_decode_desktop", "avif_decode", "lanczos_cache",
    "ziran_image_decode", "riff", "bmff", "native_api", "video_linux", "std_thread_linux",
    "std_parallel_linux", "app_asset_path", "text_request", "text_input_platform",
    "scroll_device", "style_motion", "layout_motion", "motion_history"];

failures: s32;

Fail :: (example: string, message: string, module: string) {
    print("pay per import: % % %\n", example, message, module)
    failures += 1
}

EndsWith :: (text: string, suffix: string) -> bool {
    return text.count >= suffix.count && text[text.count - suffix.count:] == suffix
}

// FILE is MODULE's own generated C: MODULE.c, or PACKAGE_MODULE.c.
NamedFor :: (file: string, module: string) -> bool {
    if !EndsWith(file, ".c") { return false }
    stem := file[:file.count - 2]
    if stem == module { return true }
    return stem.count > module.count && EndsWith(stem, module) &&
        stem[stem.count - module.count - 1] == #char "_"
}

// TEXT says MODULE.zi went into it: "generated by zi2c from MODULE.zi" when
// each module has its own file, "Program unit: MODULE.zi" when the program is
// one file, with a package's prefix (p and 16 hex digits, then _) before a
// package's module.
MarkedFor :: (text: string, module: string) -> bool {
    at := TextFind(text, module)
    while at >= 0 {
        after := at + module.count
        if after + 3 <= text.count && text[after:after + 3] == ".zi" {
            start := at
            if start >= 18 && text[start - 1] == #char "_" && text[start - 18] == #char "p" {
                start -= 18
            }
            if (start >= 5 && text[start - 5:start] == "from ") ||
                (start >= 6 && text[start - 6:start] == "unit: ") { return true }
        }
        at = TextFind(text, module, at + 1)
    }
    return false
}

Carries :: (directory: string, module: string) -> bool {
    files: Vec(string)
    if !ListDirectory(directory, *files) { return false }
    found := false
    for file: files {
        if found || !EndsWith(file, ".c") { continue }
        if NamedFor(file, module) { found = true; continue }
        text, ok := ReadEntireFile(JoinPath(directory, file))
        found = ok && MarkedFor(text, module)
    }
    FreeDirectoryNames(*files)
    return found
}

Expect :: (example: string, directory: string, present: []string, absent: []string) {
    files: Vec(string)
    if !ListDirectory(directory, *files) {
        Fail(example, "has no generated C in", directory)
        return
    }
    FreeDirectoryNames(*files)
    for module: present {
        if !Carries(directory, module) { Fail(example, "lacks", module) }
    }
    for module: absent {
        if Carries(directory, module) { Fail(example, "carries", module) }
    }
}

Run :: (arguments: []string, directory: string) -> bool {
    options: ProcessOptions = .{.arguments = arguments, .directory = directory}
    run: ProcessRun
    return RunProcess(options, *run) && run.code == 0
}

// A program entry, built as `ziran build` builds an application's main.
BuildProgram :: (ziran: string, entry: string, source: string, output: string) -> bool {
    arguments: [12]string = .[ziran, "build", "--target=c", "--project", "--root",
        "examples", "--exe", "--entry", entry, "-o", output, source]
    return Run(arguments[:], "")
}

// A program entry's checked program for C on Linux, saved as one .zir file
// per module: the modules an editor shows for it.
CheckProgram :: (ziran: string, entry: string, source: string, output: string) -> bool {
    arguments: [11]string = .[ziran, "ir", "--target=c", "--project", "--root",
        "examples", "--entry", entry, "-o", output, source]
    return Run(arguments[:], "")
}

// The same checked program for the web page, as the web profile builds it.
CheckWebProgram :: (ziran: string, entry: string, source: string, output: string) -> bool {
    arguments: [15]string = .[ziran, "ir", "--target=c", "--target-os", "web", "--target-cpu",
        "wasm32", "--project", "--root", "examples", "--entry", entry, "-o", output, source]
    return Run(arguments[:], "")
}

// The same checked program as a portable bundle checks it.
CheckZxProgram :: (ziran: string, entry: string, source: string, output: string) -> bool {
    arguments: [11]string = .[ziran, "ir", "--target=zx", "--project", "--root",
        "examples", "--entry", entry, "-o", output, source]
    return Run(arguments[:], "")
}

// A program entry's portable bundle, as `ziran bundle` writes it, and its
// instruction listing beside it (zi2zx --emit lir, from ziran's own folder).
BundleProgram :: (ziran: string, entry: string, source: string, bundle: string, listing: string) -> bool {
    arguments: [10]string = .[ziran, "bundle", "--project", "--root", "examples", "--entry", entry,
        "-o", bundle, source]
    return Run(arguments[:], "") && ListBundle(ziran, bundle, listing)
}

// The same for a hosted-UI program in tests/, whose host draws its widgets.
BundleHostedProgram :: (ziran: string, entry: string, source: string, bundle: string, listing: string) -> bool {
    arguments: [12]string = .[ziran, "bundle", "--project", "--root", "tests", "--define",
        "KRYON_HOSTED_UI", "--entry", entry, "-o", bundle, source]
    return Run(arguments[:], "") && ListBundle(ziran, bundle, listing)
}

ListBundle :: (ziran: string, bundle: string, listing: string) -> bool {
    tool: Vec(u8)
    slash := ziran.count - 1
    while slash >= 0 && ziran[slash] != #char "/" { slash -= 1 }
    if slash >= 0 { BuilderPrint(*tool, "%/zi2zx", ziran[:slash]) } else { BuilderPrint(*tool, "zi2zx") }
    list: [6]string = .[BuilderFinish(tool), "--emit", "lir", "-o", listing, bundle]
    return Run(list[:], "")
}

// The first double-quoted text in LINE from AT on.
Quoted :: (line: string, at: s64) -> string {
    start := at
    while start < line.count && line[start] != cast(u8)34 { start += 1 }
    end := start + 1
    while end < line.count && line[end] != cast(u8)34 { end += 1 }
    if end >= line.count { return "" }
    return line[start + 1:end]
}

Listed :: (name: string, names: []string) -> bool {
    for names { if it == name { return true } }
    return false
}

// FOUND holds exactly EXPECTED: EXTRA names one it should not hold, MISSING
// one it lacks.
ExpectSame :: (example: string, extra: string, missing: string, found: []string, expected: []string) {
    for found { if !Listed(it, expected) { Fail(example, extra, it) } }
    for expected { if !Listed(it, found) { Fail(example, missing, it) } }
}

// The bundle's instruction listing names exactly MODULES (its `module`
// lines) and asks its host for exactly CAPABILITIES (its external
// procedures, which the host supplies).
ExpectBundle :: (example: string, listing: string, modules: []string, capabilities: []string) {
    text, ok := ReadEntireFile(listing)
    if !ok {
        Fail(example, "has no instruction listing", listing)
        return
    }
    found_modules: Vec(string)
    found_capabilities: Vec(string)
    start: s64
    for i: 0..text.count {
        if i < text.count && text[i] != #char "\n" { continue }
        line := text[start:i]
        start = i + 1
        if line.count > 7 && line[:7] == "module " {
            VecPush(found_modules, Quoted(line, 0))
        } else if line.count > 9 && line[:9] == "function " && TextFind(line, " external=1 ") >= 0 {
            VecPush(found_capabilities, Quoted(line, TextFind(line, " name=")))
        }
    }
    ExpectSame(example, "bundles", "does not bundle", VecSlice(found_modules, 0, found_modules.count), modules)
    ExpectSame(example, "asks its host for", "does not ask its host for",
        VecSlice(found_capabilities, 0, found_capabilities.count), capabilities)
    VecFree(found_modules)
    VecFree(found_capabilities)
}

// The checked program in DIRECTORY holds each of PRESENT and none of ABSENT.
ExpectCheckedModules :: (example: string, directory: string, present: []string, absent: []string) {
    files: Vec(string)
    if !ListDirectory(directory, *files) {
        Fail(example, "has no checked program in", directory)
        return
    }
    for module: present {
        found := false
        for file: files { found = found || SavedFor(file, module) }
        if !found { Fail(example, "does not check", module) }
    }
    for module: absent {
        for file: files { if SavedFor(file, module) { Fail(example, "checks", module) } }
    }
    FreeDirectoryNames(*files)
}

// FILE is MODULE's saved checked IR.
SavedFor :: (file: string, module: string) -> bool {
    return EndsWith(file, ".zir") && file[:file.count - 4] == module
}

// The checked program in DIRECTORY holds exactly MODULES.
ExpectChecked :: (example: string, directory: string, modules: []string) {
    files: Vec(string)
    if !ListDirectory(directory, *files) {
        Fail(example, "has no checked program in", directory)
        return
    }
    for file: files {
        listed := !EndsWith(file, ".zir")
        for module: modules { listed = listed || SavedFor(file, module) }
        if !listed { Fail(example, "checks", file) }
    }
    for module: modules {
        found := false
        for file: files { found = found || SavedFor(file, module) }
        if !found { Fail(example, "does not check", module) }
    }
    FreeDirectoryNames(*files)
}

// A frame example's own lock pins a published Kryon, and a developer's
// ziran.local.toml may point anywhere. The test builds a copy of the example
// in its scratch folder instead, whose own ziran.local.toml points kryon at
// this checkout and uses the same toolchain as the starter projects. Returns
// the copy, or "" when it cannot be made.
PrepareFrame :: (ziran: string, name: string) -> string {
    source := JoinPath("examples", name)
    copy := JoinPath("build/test/pay-per-import/examples", name)
    if !CreateDirectories(copy) { return "" }
    entries: Vec(string)
    if !ListDirectory(source, *entries) { return "" }
    copied := true
    for entry: entries {
        if entry == "build" || entry == "ziran.local.toml" { continue }
        from := JoinPath(source, entry)
        to := JoinPath(copy, entry)
        copied = copied && (ifx IsDirectory(from) then CopyTree(from, to) else CopyFile(from, to))
    }
    FreeDirectoryNames(*entries)
    manifest_path := JoinPath(copy, "ziran.toml")
    manifest, readable := ReadEntireFile(manifest_path)
    manifest_bytes: [65536]u8
    pins: [1]TablePin = .[.{table = "[toolchain]", git = KryonZiranGit, ref = KryonZiranRef}]
    if !readable || !WriteEntireFile(manifest_path, PinTables(manifest, pins[:], manifest_bytes[:])) { return "" }
    overrides: Vec(u8)
    BuilderPrint(*overrides, "[overrides]\nkryon = \"%\"\n", WorkingDirectory())
    lock: [2]string = .[ziran, "lock"]
    if !copied || !WriteEntireFile(JoinPath(copy, "ziran.local.toml"), BuilderFinish(overrides)) ||
        !Run(lock[:], copy) { return "" }
    return copy
}

// A frame example, built by the project tool's desktop profile into
// DIRECTORY/build/generated/desktop/c.
BuildFrame :: (ziran: string, directory: string) -> bool {
    if directory == "" { return false }
    arguments: [6]string = .[ziran, "tool", "kryon", "build", "--profile", "desktop"]
    return Run(arguments[:], directory)
}

// The same frame example as a web page, into .../build/generated/web/c.
BuildWebFrame :: (ziran: string, directory: string) -> bool {
    if directory == "" { return false }
    arguments: [6]string = .[ziran, "tool", "kryon", "build", "--profile", "web"]
    return Run(arguments[:], directory)
}

main :: () -> s32 {
    ziran := EnvironmentText("ZIRAN_BIN")
    if ziran == "" { ziran = "ziran" }

    window_present: [4]string = .["window", "app", "desktop_window", "pixmap_sdl"]
    if !BuildProgram(ziran, "window:main", "examples/window.tsx", "build/test/pay-per-import/window") {
        Fail("window", "does not build", "examples/window.tsx")
    } else {
        Expect("window", "build/test/pay-per-import/window", window_present[:], not_in_a_window[:])
    }
    if !CheckProgram(ziran, "window:main", "examples/window.tsx", "build/test/pay-per-import/window-ir") {
        Fail("window", "does not check", "examples/window.tsx")
    } else {
        ExpectChecked("window", "build/test/pay-per-import/window-ir", window_checked[:])
    }

    // As a portable bundle, the window is the bundle's window and its host
    // calls; the desktop player opens it.
    if !CheckZxProgram(ziran, "window:main", "examples/window.tsx", "build/test/pay-per-import/window-zx-ir") {
        Fail("window (zx)", "does not check", "examples/window.tsx")
    } else {
        ExpectChecked("window (zx)", "build/test/pay-per-import/window-zx-ir", zx_window_checked[:])
    }
    if !BundleProgram(ziran, "window:main", "examples/window.tsx", "build/test/pay-per-import/window.zx",
        "build/test/pay-per-import/window-zx.lir") {
        Fail("window (zx)", "does not bundle", "examples/window.tsx")
    } else {
        ExpectBundle("window (zx)", "build/test/pay-per-import/window-zx.lir", zx_window_modules[:],
            zx_window_capabilities[:])
    }

    // A hosted program that builds its own menu bar from kryon/menu's props,
    // types and state carries no retained menu, tree or paint queue.
    hosted_menu_modules: [2]string = .["hosted_menu_types", "menu_props"]
    no_capabilities: []string
    if !BundleHostedProgram(ziran, "hosted_menu_types:Main", "tests/hosted_menu_types.zi",
        "build/test/pay-per-import/hosted-menu.zx", "build/test/pay-per-import/hosted-menu.lir") {
        Fail("hosted menu types (zx)", "does not bundle", "tests/hosted_menu_types.zi")
    } else {
        ExpectBundle("hosted menu types (zx)", "build/test/pay-per-import/hosted-menu.lir",
            hosted_menu_modules[:], no_capabilities)
    }

    // The same holds for kryon/layout's behavior and kryon/toolbar's props
    // and behavior.
    hosted_layout_modules: [3]string = .["hosted_layout_toolbar", "layout_behavior", "toolbar_behavior"]
    if !BundleHostedProgram(ziran, "hosted_layout_toolbar:Main", "tests/hosted_layout_toolbar.zi",
        "build/test/pay-per-import/hosted-layout.zx", "build/test/pay-per-import/hosted-layout.lir") {
        Fail("hosted layout and toolbar (zx)", "does not bundle", "tests/hosted_layout_toolbar.zi")
    } else {
        ExpectBundle("hosted layout and toolbar (zx)", "build/test/pay-per-import/hosted-layout.lir",
            hosted_layout_modules[:], no_capabilities)
    }

    // kryon/app's frame loop arrives with App.Run.
    hello_present: [7]string = .["app", "frames_desktop", "desktop_loop", "tree", "tree_frame",
        "text", "paint_queue"]
    if !BuildProgram(ziran, "hello:main", "examples/hello.tsx", "build/test/pay-per-import/hello") {
        Fail("hello", "does not build", "examples/hello.tsx")
    } else {
        Expect("hello", "build/test/pay-per-import/hello", hello_present[:], not_without_pictures[:])
    }

    // A label asks its parent for width and the frame for paint operations.
    // It does not build containers, own pictures or edit text.
    zx_hello_present: [3]string = .["text", "tree", "paint_queue"]
    zx_hello_absent: [24]string = .["layout", "layout_props", "layout_behavior",
        "grid", "grid_props", "layout_paint", "layout_paint_slot", "bitmap_store",
        "text_request", "text_input_platform", "text_editor_zx", "style_sheet",
        "surface", "image", "style", "style_facts", "style_tree", "style_motion_slot",
        "elevation", "theme", "clock", "motion_clock", "style_motion", "layout_motion"]
    if !CheckZxProgram(ziran, "hello:main", "examples/hello.tsx", "build/test/pay-per-import/hello-zx-ir") {
        Fail("hello (zx)", "does not check", "examples/hello.tsx")
    } else {
        ExpectCheckedModules("hello (zx)", "build/test/pay-per-import/hello-zx-ir",
            zx_hello_present[:], zx_hello_absent[:])
    }

    box := PrepareFrame(ziran, "box")
    button := PrepareFrame(ziran, "button")
    image := PrepareFrame(ziran, "image")
    textfield := PrepareFrame(ziran, "textfield")
    box_present: [3]string = .["box", "tree", "tree_frame"]
    if !BuildFrame(ziran, box) {
        Fail("box", "does not build", "examples/box")
    } else {
        Expect("box", JoinPath(box, "build/generated/desktop/c"), box_present[:], not_in_a_plain_frame[:])
    }

    // A button without an icon: no picture, no text input, no scrolls.
    button_present: [3]string = .["button", "tree", "tree_frame"]
    if !BuildFrame(ziran, button) {
        Fail("button", "does not build", "examples/button")
    } else {
        Expect("button", JoinPath(button, "build/generated/desktop/c"), button_present[:],
            not_in_a_plain_frame[:])
    }

    image_present: [11]string = .["image", "image_decode_desktop", "avif_decode",
        "ziran_image_decode", "lanczos_cache", "riff", "bmff", "native_api",
        "std_thread_linux", "std_parallel_linux", "app_asset_path"]
    image_absent: [3]string = .["video_linux", "text_request", "text_input_platform"]
    if !BuildFrame(ziran, image) {
        Fail("image", "does not build", "examples/image")
    } else {
        Expect("image", JoinPath(image, "build/generated/desktop/c"), image_present[:], image_absent[:])
    }

    textfield_present: [5]string = .["textfield", "text_request", "text_input_platform",
        "text_boundary", "scroll_device"]
    textfield_absent: [1]string = .["video_linux"]
    if !BuildFrame(ziran, textfield) {
        Fail("textfield", "does not build", "examples/textfield")
    } else {
        Expect("textfield", JoinPath(textfield, "build/generated/desktop/c"), textfield_present[:],
            textfield_absent[:])
    }

    // The web: an empty window is the window and its page, and frame
    // examples carry only what they import, as on Linux.
    if !CheckWebProgram(ziran, "window:main", "examples/window.tsx", "build/test/pay-per-import/window-web-ir") {
        Fail("window (web)", "does not check", "examples/window.tsx")
    } else {
        ExpectChecked("window (web)", "build/test/pay-per-import/window-web-ir", web_window_checked[:])
    }
    web_hello_present: [5]string = .["app", "frames_web", "tree", "text", "paint_queue"]
    if !CheckWebProgram(ziran, "hello:main", "examples/hello.tsx", "build/test/pay-per-import/hello-web-ir") {
        Fail("hello (web)", "does not check", "examples/hello.tsx")
    } else {
        ExpectCheckedModules("hello (web)", "build/test/pay-per-import/hello-web-ir", web_hello_present[:],
            not_in_a_plain_page[:])
    }
    web_box_present: [2]string = .["box", "tree"]
    if !BuildWebFrame(ziran, box) {
        Fail("box", "does not build for the web", "examples/box")
    } else {
        Expect("box", JoinPath(box, "build/generated/web/c"), web_box_present[:], not_in_a_plain_web_frame[:])
    }
    web_button_present: [2]string = .["button", "tree"]
    if !BuildWebFrame(ziran, button) {
        Fail("button", "does not build for the web", "examples/button")
    } else {
        Expect("button", JoinPath(button, "build/generated/web/c"), web_button_present[:],
            not_in_a_plain_web_frame[:])
    }
    web_image_present: [3]string = .["image", "lanczos_cache", "page_mesh"]
    web_image_absent: [3]string = .["test_driver", "text_request", "text_input_platform"]
    if !BuildWebFrame(ziran, image) {
        Fail("image", "does not build for the web", "examples/image")
    } else {
        Expect("image", JoinPath(image, "build/generated/web/c"), web_image_present[:], web_image_absent[:])
    }

    if failures > 0 { return 1 }
    print("pay per import: window, hello, box, button, image and textfield carry only what they import, on Linux and the web; window's bundle asks its host only for the window; a hosted program gets kryon/menu's types without the retained menu, and kryon/layout's and kryon/toolbar's behavior without their retained halves\n")
    return 0
}
