RawTexImage :: (target: u32, level: s32, internal: s32, width: s32, height: s32, border: s32, format: u32, kind: u32, data: *void) #foreign gl "glTexImage2D";
RawGenBuffers :: (count: s32, ids: *u32) #foreign gl "glGenBuffers";
RawDeleteBuffers :: (count: s32, ids: *u32) #foreign gl "glDeleteBuffers";
RawBindBuffer :: (target: u32, id: u32) #foreign gl "glBindBuffer";
RawBufferData :: (target: u32, bytes: s64, data: *void, usage: u32) #foreign gl "glBufferData";
RawMapBufferRange :: (target: u32,offset: s64,bytes: s64,access: u32)->*void #foreign gl "glMapBufferRange";
RawUnmapBuffer :: (target: u32)->u8 #foreign gl "glUnmapBuffer";
RawFenceSync :: (condition: u32,flags: u32)->*void #foreign gl "glFenceSync";
RawClientWaitSync :: (sync: *void,flags: u32,timeout: u64)->u32 #foreign gl "glClientWaitSync";
