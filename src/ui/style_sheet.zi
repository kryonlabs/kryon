StyleFacts :: struct {
    kind: i32
    name: i32
    class_name: i32
    role: i32
    tone: i32
    emphasis: i32
    size: i32
    state: i32
    validation: i32
    orientation: i32
    placement: i32
}

StyleSelector :: struct {
    kind: i32
    name: i32
    class_name: i32
    role: i32
    tone: i32
    emphasis: i32
    size: i32
    state: i32
    validation: i32
    orientation: i32
    placement: i32
}

StyleRule :: struct {
    selector: StyleSelector
    state: i32
    layer: i32
    order: i32
    style: StyleData
}

StyleSheet :: struct {
    rules: const StyleRule*
    rule_count: i32
}

# Owned rule storage for portable programs. The pointer-based StyleSheet above
# remains the input shape of the old native loader during migration.
StyleRules :: struct {
    items: [320]StyleRule
    count: i32
}

installed_rules :: StyleRules #global

InstallStyleRules :: (rules: StyleRules) #export {
    installed_rules = rules
}

ActiveStyleRules :: () -> StyleRules #export {
    return installed_rules
}

StylePriority :: struct {
    present: bool
    layer: i32
    specificity: i32
    order: i32
}

StyleCascade :: struct {
    result: StyleData
    background_priority: StylePriority
    foreground_priority: StylePriority
    border_priority: StylePriority
    focus_priority: StylePriority
    radius_priority: StylePriority
    border_width_priority: StylePriority
    opacity_priority: StylePriority
    padding_x_priority: StylePriority
    padding_y_priority: StylePriority
    gap_priority: StylePriority
    font_size_priority: StylePriority
    icon_size_priority: StylePriority
    content_offset_priority: StylePriority
    background_end_priority: StylePriority
    material_priority: StylePriority
    typeface_priority: StylePriority
    letter_spacing_priority: StylePriority
}

StyleFieldDecision :: struct {
    matched: bool
    field_present: bool
    wins: bool
    layer: i32
    specificity: i32
    order: i32
    current_present: bool
    current_layer: i32
    current_specificity: i32
    current_order: i32
}

StyleDefaultFacts :: (kind: i32) -> StyleFacts #export {
    facts: StyleFacts
    facts.kind = kind
    facts.role = StyleAny()
    facts.tone = StyleAny()
    facts.emphasis = StyleAny()
    facts.size = StyleAny()
    facts.state = StyleAny()
    facts.validation = StyleAny()
    facts.orientation = StyleAny()
    facts.placement = StyleAny()
    return facts
}

StyleControlFacts :: (kind: i32, name: i32, class_name: i32, tone: i32,
    emphasis: i32, size: i32, state: i32) -> StyleFacts #export {
    facts: StyleFacts = StyleDefaultFacts(kind)
    facts.name = name
    facts.class_name = class_name
    facts.tone = tone
    facts.emphasis = emphasis
    facts.size = size
    facts.state = state
    return facts
}

StyleControlRoleFacts :: (kind: i32, name: i32, class_name: i32, role: i32,
    tone: i32, emphasis: i32, size: i32, state: i32) -> StyleFacts #export {
    facts: StyleFacts = StyleControlFacts(kind, name, class_name, tone,
        emphasis, size, state)
    facts.role = role
    return facts
}

StyleTextFacts :: (name: i32, class_name: i32, role: i32,
    state: i32) -> StyleFacts #export {
    facts: StyleFacts = StyleDefaultFacts(StyleKindText())
    facts.name = name
    facts.class_name = class_name
    facts.role = role
    facts.state = state
    return facts
}

StyleDefaultSelector :: () -> StyleSelector #export {
    selector: StyleSelector
    selector.kind = StyleKindAny()
    selector.role = StyleAny()
    selector.tone = StyleAny()
    selector.emphasis = StyleAny()
    selector.size = StyleAny()
    selector.state = StyleAny()
    selector.validation = StyleAny()
    selector.orientation = StyleAny()
    selector.placement = StyleAny()
    return selector
}

StyleMatchesOptional :: (selector_value: i32, fact_value: i32) -> bool #export {
    if selector_value == StyleAny() {
        return true
    }
    return selector_value == fact_value
}

StyleSelectorMatches :: (selector: StyleSelector, facts: StyleFacts) -> bool #export {
    if selector.kind != StyleKindAny() && selector.kind != facts.kind {
        return false
    }
    if selector.name != 0 && selector.name != facts.name {
        return false
    }
    if selector.class_name != 0 && selector.class_name != facts.class_name {
        return false
    }
    if !StyleMatchesOptional(selector.role, facts.role) {
        return false
    }
    if !StyleMatchesOptional(selector.tone, facts.tone) {
        return false
    }
    if !StyleMatchesOptional(selector.emphasis, facts.emphasis) {
        return false
    }
    if !StyleMatchesOptional(selector.size, facts.size) {
        return false
    }
    if !StyleMatchesOptional(selector.state, facts.state) {
        return false
    }
    if !StyleMatchesOptional(selector.validation, facts.validation) {
        return false
    }
    if !StyleMatchesOptional(selector.orientation, facts.orientation) {
        return false
    }
    if !StyleMatchesOptional(selector.placement, facts.placement) {
        return false
    }
    return true
}

# Selector parsers provide counts; weights and cascade ordering live here for
# typed native selectors and the richer declarative web selector surface.
StyleSpecificity :: (kinds: i32, attributes: i32, classes: i32, names: i32) -> i32 #export {
    return kinds + attributes * 10 + classes * 20 + names * 100
}

StyleSelectorSpecificity :: (selector: StyleSelector) -> i32 #export {
    kinds: i32 = 0
    attributes: i32 = 0
    classes: i32 = 0
    names: i32 = 0
    if selector.kind != StyleKindAny() {
        kinds = 1
    }
    if selector.role != StyleAny() {
        attributes += 1
    }
    if selector.tone != StyleAny() {
        attributes += 1
    }
    if selector.emphasis != StyleAny() {
        attributes += 1
    }
    if selector.size != StyleAny() {
        attributes += 1
    }
    if selector.state != StyleAny() {
        attributes += 1
    }
    if selector.validation != StyleAny() {
        attributes += 1
    }
    if selector.orientation != StyleAny() {
        attributes += 1
    }
    if selector.placement != StyleAny() {
        attributes += 1
    }
    if selector.class_name != 0 {
        classes = 1
    }
    if selector.name != 0 {
        names = 1
    }
    return StyleSpecificity(kinds, attributes, classes, names)
}

StylePriorityScore :: (layer: i32, specificity: i32, order: i32) -> i32 #export {
    return layer * 1000000 + specificity * 1000 + order
}

StyleRulePriority :: (rule: StyleRule) -> StylePriority #export {
    priority: StylePriority
    priority.present = true
    priority.layer = rule.layer
    priority.specificity = StyleSelectorSpecificity(rule.selector)
    priority.order = rule.order
    return priority
}

StyleRuleMatchesState :: (rule_state: i32, active_state: i32) -> bool #export {
    if rule_state == StyleStateAny() { return true }
    if rule_state == ButtonStateNormal { return true }
    return rule_state == active_state
}

StyleRuleMatches :: (rule: StyleRule, facts: StyleFacts, active_state: i32) -> bool #export {
    if !StyleRuleMatchesState(rule.state, active_state) {
        return false
    }
    return StyleSelectorMatches(rule.selector, facts)
}

StyleHasField :: (style: StyleData, field: u32) -> bool #export {
    return (style.fields & field) != (u32)0
}

StyleCascadeFieldPriority :: (cascade: StyleCascade, field: u32) -> StylePriority #export {
    if field == (u32)StyleBackground { return cascade.background_priority }
    if field == (u32)StyleForeground { return cascade.foreground_priority }
    if field == (u32)StyleBorder { return cascade.border_priority }
    if field == (u32)StyleFocus { return cascade.focus_priority }
    if field == (u32)StyleRadius { return cascade.radius_priority }
    if field == (u32)StyleBorderWidth { return cascade.border_width_priority }
    if field == (u32)StyleOpacity { return cascade.opacity_priority }
    if field == (u32)StylePaddingX { return cascade.padding_x_priority }
    if field == (u32)StylePaddingY { return cascade.padding_y_priority }
    if field == (u32)StyleGap { return cascade.gap_priority }
    if field == (u32)StyleFontSize { return cascade.font_size_priority }
    if field == (u32)StyleLetterSpacing { return cascade.letter_spacing_priority }
    if field == (u32)StyleIconSize { return cascade.icon_size_priority }
    if field == (u32)StyleContentOffset { return cascade.content_offset_priority }
    if field == (u32)StyleBackgroundEnd { return cascade.background_end_priority }
    if field == (u32)StyleMaterial { return cascade.material_priority }
    if field == (u32)StyleTypeface { return cascade.typeface_priority }
    priority: StylePriority
    return priority
}

StyleRuleFieldDecision :: (current: StylePriority, rule: StyleRule,
    facts: StyleFacts, active_state: i32, field: u32) -> StyleFieldDecision #export {
    decision: StyleFieldDecision
    decision.current_present = current.present
    decision.current_layer = current.layer
    decision.current_specificity = current.specificity
    decision.current_order = current.order
    if !StyleRuleMatches(rule, facts, active_state) {
        return decision
    }
    decision.matched = true
    if !StyleHasField(rule.style, field) {
        return decision
    }
    decision.field_present = true
    priority: StylePriority = StyleRulePriority(rule)
    decision.layer = priority.layer
    decision.specificity = priority.specificity
    decision.order = priority.order
    decision.wins = StylePriorityWins(priority, current)
    return decision
}

# A scalar score is useful for display but cannot order arbitrary selector
# counts or source positions without collisions. Compare each tier directly.
StylePriorityWins :: (priority: StylePriority, current: StylePriority) -> bool #export {
    if !priority.present {
        return false
    }
    if !current.present {
        return true
    }
    if priority.layer != current.layer {
        return priority.layer > current.layer
    }
    if priority.specificity != current.specificity {
        return priority.specificity > current.specificity
    }
    return priority.order >= current.order
}

BeginStyleCascade :: (base: StyleData) -> StyleCascade #export {
    cascade: StyleCascade
    cascade.result = base
    return cascade
}

ApplyStyleRule :: (cascade: StyleCascade, rule: StyleRule,
    facts: StyleFacts, active_state: i32) -> StyleCascade #export {
    if !StyleRuleMatches(rule, facts, active_state) {
        return cascade
    }
    priority: StylePriority = StyleRulePriority(rule)
    style: StyleData = rule.style
    if (style.fields & (u32)StyleBackground) != (u32)0 &&
       StylePriorityWins(priority, cascade.background_priority) {
        cascade.result.background = style.background
        cascade.result.fields = cascade.result.fields | (u32)StyleBackground
        cascade.background_priority = priority
    }
    if (style.fields & (u32)StyleForeground) != (u32)0 &&
       StylePriorityWins(priority, cascade.foreground_priority) {
        cascade.result.foreground = style.foreground
        cascade.result.fields = cascade.result.fields | (u32)StyleForeground
        cascade.foreground_priority = priority
    }
    if (style.fields & (u32)StyleBorder) != (u32)0 &&
       StylePriorityWins(priority, cascade.border_priority) {
        cascade.result.border = style.border
        cascade.result.fields = cascade.result.fields | (u32)StyleBorder
        cascade.border_priority = priority
    }
    if (style.fields & (u32)StyleFocus) != (u32)0 &&
       StylePriorityWins(priority, cascade.focus_priority) {
        cascade.result.focus = style.focus
        cascade.result.fields = cascade.result.fields | (u32)StyleFocus
        cascade.focus_priority = priority
    }
    if (style.fields & (u32)StyleRadius) != (u32)0 &&
       StylePriorityWins(priority, cascade.radius_priority) {
        cascade.result.radius = style.radius
        cascade.result.fields = cascade.result.fields | (u32)StyleRadius
        cascade.radius_priority = priority
    }
    if (style.fields & (u32)StyleBorderWidth) != (u32)0 &&
       StylePriorityWins(priority, cascade.border_width_priority) {
        cascade.result.border_width = style.border_width
        cascade.result.fields = cascade.result.fields | (u32)StyleBorderWidth
        cascade.border_width_priority = priority
    }
    if (style.fields & (u32)StyleOpacity) != (u32)0 &&
       StylePriorityWins(priority, cascade.opacity_priority) {
        cascade.result.opacity = style.opacity
        cascade.result.fields = cascade.result.fields | (u32)StyleOpacity
        cascade.opacity_priority = priority
    }
    if (style.fields & (u32)StylePaddingX) != (u32)0 &&
       StylePriorityWins(priority, cascade.padding_x_priority) {
        cascade.result.padding_x = style.padding_x
        cascade.result.fields = cascade.result.fields | (u32)StylePaddingX
        cascade.padding_x_priority = priority
    }
    if (style.fields & (u32)StylePaddingY) != (u32)0 &&
       StylePriorityWins(priority, cascade.padding_y_priority) {
        cascade.result.padding_y = style.padding_y
        cascade.result.fields = cascade.result.fields | (u32)StylePaddingY
        cascade.padding_y_priority = priority
    }
    if (style.fields & (u32)StyleGap) != (u32)0 &&
       StylePriorityWins(priority, cascade.gap_priority) {
        cascade.result.gap = style.gap
        cascade.result.fields = cascade.result.fields | (u32)StyleGap
        cascade.gap_priority = priority
    }
    if (style.fields & (u32)StyleFontSize) != (u32)0 &&
       StylePriorityWins(priority, cascade.font_size_priority) {
        cascade.result.font_size = style.font_size
        cascade.result.fields = cascade.result.fields | (u32)StyleFontSize
        cascade.font_size_priority = priority
    }
    if (style.fields & (u32)StyleLetterSpacing) != (u32)0 &&
       StylePriorityWins(priority, cascade.letter_spacing_priority) {
        cascade.result.letter_spacing = style.letter_spacing
        cascade.result.fields = cascade.result.fields | (u32)StyleLetterSpacing
        cascade.letter_spacing_priority = priority
    }
    if (style.fields & (u32)StyleIconSize) != (u32)0 &&
       StylePriorityWins(priority, cascade.icon_size_priority) {
        cascade.result.icon_size = style.icon_size
        cascade.result.fields = cascade.result.fields | (u32)StyleIconSize
        cascade.icon_size_priority = priority
    }
    if (style.fields & (u32)StyleContentOffset) != (u32)0 &&
       StylePriorityWins(priority, cascade.content_offset_priority) {
        cascade.result.offset_x = style.offset_x
        cascade.result.offset_y = style.offset_y
        cascade.result.fields = cascade.result.fields | (u32)StyleContentOffset
        cascade.content_offset_priority = priority
    }
    if (style.fields & (u32)StyleBackgroundEnd) != (u32)0 &&
       StylePriorityWins(priority, cascade.background_end_priority) {
        cascade.result.background_end = style.background_end
        cascade.result.fields = cascade.result.fields | (u32)StyleBackgroundEnd
        cascade.background_end_priority = priority
    }
    if (style.fields & (u32)StyleMaterial) != (u32)0 &&
       StylePriorityWins(priority, cascade.material_priority) {
        cascade.result.material = style.material
        cascade.result.fields = cascade.result.fields | (u32)StyleMaterial
        cascade.material_priority = priority
    }
    if (style.fields & (u32)StyleTypeface) != (u32)0 &&
       StylePriorityWins(priority, cascade.typeface_priority) {
        cascade.result.typeface = style.typeface
        cascade.result.fields = cascade.result.fields | (u32)StyleTypeface
        cascade.typeface_priority = priority
    }
    return cascade
}

FinishStyleCascade :: (cascade: StyleCascade) -> StyleData #export {
    return cascade.result
}

ResolveStyleRule :: (base: StyleData, facts: StyleFacts,
    rule: StyleRule, active_state: i32) -> StyleData #export {
    cascade: StyleCascade = BeginStyleCascade(base)
    cascade = ApplyStyleRule(cascade, rule, facts, active_state)
    return FinishStyleCascade(cascade)
}

ResolveStyleRules :: (rules: StyleRules, base: StyleData,
    facts: StyleFacts, active_state: i32) -> StyleData #export {
    cascade: StyleCascade = BeginStyleCascade(base)
    limit: i32 = rules.count
    if limit < 0 { limit = 0 }
    if limit > 320 { limit = 320 }
    index: i32 = 0
    while index < limit {
        cascade = ApplyStyleRule(cascade, rules.items[index],
            facts, active_state)
        index += 1
    }
    return FinishStyleCascade(cascade)
}
