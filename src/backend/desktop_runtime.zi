sdl_library :: #system_library "SDL2";
GetEnvironment :: (name: *u8) -> *u8 #foreign sdl_library "SDL_getenv";

// SDL_Event is 56 bytes on the supported SDL2 ABI. SDL_MouseButtonEvent's
// button byte is at offset 16; the remaining union storage is opaque.
Event :: struct {
    kind: u32
    timestamp: u32
    window_id: u32
    which: u32
    button: u8
    state: u8
    clicks: u8
    padding: u8
    x: s32
    y: s32
    payload: [28]u8
}
Init :: (flags: u32) -> s32 #foreign sdl_library "SDL_Init";
Quit :: () #foreign sdl_library "SDL_Quit";
CreateWindow :: (title: *u8, x: s32, y: s32, width: s32,
    height: s32, flags: u32) -> *void #foreign sdl_library "SDL_CreateWindow";
DestroyWindow :: (window: *void) #foreign sdl_library "SDL_DestroyWindow";
SetWindowTitle :: (window: *void, title: *u8) #foreign sdl_library "SDL_SetWindowTitle";
SetWindowIcon :: (window: *void, surface: *void) #foreign sdl_library "SDL_SetWindowIcon";
SetWindowSize :: (window: *void, width: s32, height: s32) #foreign sdl_library "SDL_SetWindowSize";
SetWindowPosition :: (window: *void, x: s32, y: s32) #foreign sdl_library "SDL_SetWindowPosition";
GetWindowID :: (window: *void) -> u32 #foreign sdl_library "SDL_GetWindowID";
GetWindowSize :: (window: *void, width: *s32, height: *s32) #foreign sdl_library "SDL_GetWindowSize";
GetWindowPosition :: (window: *void, x: *s32, y: *s32) #foreign sdl_library "SDL_GetWindowPosition";
OpenURL :: (url: *u8) -> s32 #foreign sdl_library "SDL_OpenURL";
DestroyRenderer :: (renderer: *void) #foreign sdl_library "SDL_DestroyRenderer";
CreateTexture :: (renderer: *void, format: u32, access: s32,
    width: s32, height: s32) -> *void #foreign sdl_library "SDL_CreateTexture";
DestroyTexture :: (texture: *void) #foreign sdl_library "SDL_DestroyTexture";
UpdateTexture :: (texture: *void, rect: *void, pixels: *u8,
    pitch: s32) -> s32 #foreign sdl_library "SDL_UpdateTexture";
RenderCopy :: (renderer: *void, texture: *void, source: *void,
    destination: *void) -> s32 #foreign sdl_library "SDL_RenderCopy";
RenderPresent :: (renderer: *void) #foreign sdl_library "SDL_RenderPresent";
EventFilter :: #type (argument: *void, event: *Event) -> s32 #c_call;
FilterEvents :: (filter: EventFilter, argument: *void) #foreign sdl_library "SDL_FilterEvents";
PumpEvents :: () #foreign sdl_library "SDL_PumpEvents";
PeepEvents :: (events: *Event, count: s32, action: s32, first: u32, last: u32) -> s32 #foreign sdl_library "SDL_PeepEvents";
WaitEventTimeout :: (event: *Event, milliseconds: s32) -> s32 #foreign sdl_library "SDL_WaitEventTimeout";
PushEvent :: (event: *Event) -> s32 #foreign sdl_library "SDL_PushEvent";
StartTextInput :: () #foreign sdl_library "SDL_StartTextInput";
StopTextInput :: () #foreign sdl_library "SDL_StopTextInput";
GetMouseState :: (x: *s32, y: *s32) -> u32 #foreign sdl_library "SDL_GetMouseState";
GetGlobalMouseState :: (x: *s32, y: *s32) -> u32 #foreign sdl_library "SDL_GetGlobalMouseState";
GetModState :: () -> u32 #foreign sdl_library "SDL_GetModState";
Delay :: (milliseconds: u32) #foreign sdl_library "SDL_Delay";
PerformanceCounter :: () -> u64 #foreign sdl_library "SDL_GetPerformanceCounter";
PerformanceFrequency :: () -> u64 #foreign sdl_library "SDL_GetPerformanceFrequency";
ShowWindow :: (window: *void) #foreign sdl_library "SDL_ShowWindow";
HideWindow :: (window: *void) #foreign sdl_library "SDL_HideWindow";
RaiseWindow :: (window: *void) #foreign sdl_library "SDL_RaiseWindow";
GetWindowFlags :: (window: *void) -> u32 #foreign sdl_library "SDL_GetWindowFlags";
SetHint :: (name: *u8, value: *u8) -> s32 #foreign sdl_library "SDL_SetHint";
GetClipboardText :: () -> *u8 #foreign sdl_library "SDL_GetClipboardText";
SetClipboardText :: (text: *u8) -> s32 #foreign sdl_library "SDL_SetClipboardText";
FreeSdlMemory :: (memory: *void) #foreign sdl_library "SDL_free";
GetDefaultCursor :: () -> *void #foreign sdl_library "SDL_GetDefaultCursor";
GetCurrentVideoDriver :: () -> *u8 #foreign sdl_library "SDL_GetCurrentVideoDriver";
ShowCursor :: (toggle: s32) -> s32 #foreign sdl_library "SDL_ShowCursor";
CreateColorCursor :: (surface: *void, x: s32, y: s32) -> *void #foreign sdl_library "SDL_CreateColorCursor";
CursorSurface :: (pixels: *u8, width: s32, height: s32, depth: s32, pitch: s32,
    red: u32, green: u32, blue: u32, alpha: u32) -> *void #foreign sdl_library "SDL_CreateRGBSurfaceFrom";
FreeSurface :: (surface: *void) #foreign sdl_library "SDL_FreeSurface";
CreateSystemCursor :: (shape: s32) -> *void #foreign sdl_library "SDL_CreateSystemCursor";
SetCursor :: (cursor: *void) #foreign sdl_library "SDL_SetCursor";
FreeCursor :: (cursor: *void) #foreign sdl_library "SDL_FreeCursor";

NumJoysticks :: () -> s32 #foreign sdl_library "SDL_NumJoysticks";
IsGameController :: (index: s32) -> s32 #foreign sdl_library "SDL_IsGameController";
GameControllerOpen :: (index: s32) -> *void #foreign sdl_library "SDL_GameControllerOpen";
GameControllerClose :: (controller: *void) #foreign sdl_library "SDL_GameControllerClose";
GameControllerJoystick :: (controller: *void) -> *void #foreign sdl_library "SDL_GameControllerGetJoystick";
JoystickInstanceID :: (joystick: *void) -> s32 #foreign sdl_library "SDL_JoystickInstanceID";
JoystickDeviceInstanceID :: (index: s32) -> s32 #foreign sdl_library "SDL_JoystickGetDeviceInstanceID";

DesktopController :: struct {
    handle: *void
    instance: s32
    buttons: u32
}
desktop_controllers: [4]DesktopController;
desktop_gamepad_keys: [512]u8;

DesktopControllerFind :: (instance: s32) -> s32 {
    for slot: cast(s32)0..3 {
        if desktop_controllers[slot].handle != null &&
        desktop_controllers[slot].instance == instance { return slot }
    }
    return -1
}
DesktopControllerOpen :: (index: s32) {
    if index < 0 || IsGameController(index) == 0 { return }
    instance := JoystickDeviceInstanceID(index)
    if instance < 0 || DesktopControllerFind(instance) >= 0 { return }
    for slot: cast(s32)0..3 {
        if desktop_controllers[slot].handle == null {
            handle := GameControllerOpen(index)
            if handle == null { return }
            desktop_controllers[slot].handle = handle
            desktop_controllers[slot].instance = JoystickInstanceID(GameControllerJoystick(handle))
            desktop_controllers[slot].buttons = cast(u32)0
            return
        }
    }
}
DesktopControllersScan :: () {
    count := NumJoysticks()
    for index: cast(s32)0..count - 1 { DesktopControllerOpen(index) }
}
DesktopControllerHeld :: (button: s32) -> bool {
    for slot: cast(s32)0..3 {
        if (desktop_controllers[slot].buttons & (cast(u32)1 << cast(u32)button)) != cast(u32)0 { return true }
    }
    return false
}
DesktopControllerRelease :: (slot: s32) {
    desktop_controllers[slot].buttons = cast(u32)0
    for button: cast(s32)0..14 {
        key := DesktopGamepadKey(button)
        if key != 0 && !DesktopControllerHeld(button) &&
        (desktop_gamepad_keys[key] & cast(u8)FrameKeyHeld) != cast(u8)0 {
            desktop_gamepad_keys[key] &= cast(u8)(FrameKeyPressed | FrameKeyRepeated)
            desktop_gamepad_keys[key] |= cast(u8)FrameKeyReleased
        }
    }
}

window: *void;
#program_export
DesktopWindow :: () -> *void { return window }

#program_export
DesktopOrigin :: () -> Vector2 {
    x: s32; y: s32
    if window != null { GetWindowPosition(window, *x, *y) }
    return .{cast(float32)x, cast(float32)y}
}
renderer: *void;
texture: *void;
pointer: PointerFrame;
desktop_physical_buttons: u32;
desktop_physical_sampled: bool;
secondary: SecondaryPointerFrame;
desktop_wheel: float32;
desktop_key: s32;
desktop_frame_input: FrameInputProvider;
desktop_frame_input_pending_carry: bool;
desktop_raw_keys: [512]u8;
desktop_input_focused: bool;
desktop_input_started: s64;
desktop_keys: DesktopKeyBuffer;
// Durable UI delivery is independent of the current poll observations.
DesktopInputEvent :: struct { code: s32; modifiers: s32; text: bool; editing: bool }
desktop_ordered: bool;
desktop_input: [32]DesktopInputEvent;
desktop_input_head: s32;
desktop_input_count: s32;
// File drops are copied before SDL releases its event-owned path. Applications
// consume them on the UI thread; unrelated windows and drop text stay separate.
desktop_dropped_files: [16][4096]u8;
desktop_drop_first: s32;
desktop_drop_count: s32;
DropEvent :: struct {
    kind: u32
    timestamp: u32
    path: *u8
    window_id: u32
}
// SDL modifier state recorded with the last key press, or -1 without one.
desktop_key_modifiers: s32 = -1;
desktop_codepoints: [32]s32;
desktop_codepoint_count: s32;
desktop_codepoint_next: s32;
desktop_intercept_close: bool;
desktop_close_requested: bool;
desktop_quit: bool;
desktop_width: s32;
desktop_height: s32;
frame_clock: Clock.FrameClock;
frame_frequency: u64;
desktop_frame_unchanged: bool;
// Unchanged app paint does not need another full-window pixel transfer.
// Exposure still presents the current texture; resets require fresh pixels.
desktop_present_pending: bool;
desktop_texture_dirty: bool;
desktop_texture_reset: bool;
desktop_pixels_valid: bool;
// Keep the native window hidden until its first complete frame is presented.
desktop_first_frame: bool;
desktop_first_frame_show: bool;
// A size ResizeDesktop asked for, applied when the next frame begins.
desktop_next_width: s32;
desktop_next_height: s32;
desktop_cursors: [11]*void;

// Bitmap cursors stay cached by request, so switching between an application
// hand and a tool never re-decodes, frees or briefly shows another cursor.
DESKTOP_CUSTOM_CURSORS :: 8
DesktopCustomCursor :: struct {
    cursor: *void
    props: CursorProps
    used: u64
    length: s32
    path: [4096]u8
}
desktop_custom: [DESKTOP_CUSTOM_CURSORS]DesktopCustomCursor;
desktop_custom_clock: u64;
// The last resolved request and what it selected. SDL is called only when
// the resolved request changes.
desktop_cursor_applied: DesktopCustomCursor;
desktop_cursor_applied_valid: bool;
desktop_cursor_applied_loaded: bool;
desktop_cursor_selected: *void;
desktop_cursor_hidden: bool;
desktop_cursor_scale: s32;

// XCURSOR_SIZE is the desktop's cursor size; 24 is one-to-one. Logical
// cursor units scale with it, in quarter steps from 1x to 4x.
DesktopCursorScaleQuarters :: () -> s32 {
    if desktop_cursor_scale > 0 { return desktop_cursor_scale }
    desktop_cursor_scale = 4
    name: [16]u8
    if !CopyCString("XCURSOR_SIZE", name[:]) { return desktop_cursor_scale }
    value := GetEnvironment(*name[0])
    if value == null { return desktop_cursor_scale }
    size: s32 = 0
    text := TextFromCString(value)
    for byte: text {
        if byte < #char "0" || byte > #char "9" || size > 1000 { size = 0; break }
        size = size * 10 + cast(s32)(byte - #char "0")
    }
    if size > 0 {
        quarters := (size * 4 + 12) / 24
        if quarters < 4 { quarters = 4 }
        if quarters > 16 { quarters = 16 }
        desktop_cursor_scale = quarters
    }
    return desktop_cursor_scale
}

DesktopCursorPixels :: (logical: s32) -> s32 {
    pixels := (logical * DesktopCursorScaleQuarters() + 2) / 4
    if pixels < 1 { pixels = 1 }
    if pixels > 128 { pixels = 128 }
    return pixels
}

// X11's Xcursor expects premultiplied ARGB and SDL copies it unchanged there;
// Wayland and other SDL drivers premultiply straight ARGB themselves.
DesktopCursorPremultiplied :: () -> bool {
    driver := GetCurrentVideoDriver()
    return driver != null && TextFromCString(driver) == "x11"
}

DesktopCursorKey :: (entry: *DesktopCustomCursor, props: CursorProps) -> bool {
    return CursorPropsSame(entry.props, CursorProps.{.width = props.width, .height = props.height,
        .hotspot_x = props.hotspot_x, .hotspot_y = props.hotspot_y, .hidden = props.hidden,
        .shape = props.shape}) && TextFromBytes(entry.path[:entry.length]) == props.asset_path
}

DesktopCursorRemember :: (entry: *DesktopCustomCursor, props: CursorProps) {
    unused CopyCString(props.asset_path, entry.path[:])
    entry.length = cast(s32)props.asset_path.count
    entry.props = CursorProps.{.width = props.width, .height = props.height,
        .hotspot_x = props.hotspot_x, .hotspot_y = props.hotspot_y, .hidden = props.hidden,
        .shape = props.shape}
}

DesktopBitmapCursor :: (props: CursorProps) -> *void {
    oldest: s32 = 0
    for index: cast(s32)0..DESKTOP_CUSTOM_CURSORS - 1 {
        entry := *desktop_custom[index]
        if entry.cursor != null && DesktopCursorKey(entry, props) {
            desktop_custom_clock += cast(u64)1
            entry.used = desktop_custom_clock
            return entry.cursor
        }
        if entry.cursor == null || (desktop_custom[oldest].cursor != null && entry.used < desktop_custom[oldest].used) {
            oldest = index
        }
    }
    width := DesktopCursorPixels(props.width)
    height := DesktopCursorPixels(props.height)
    hot_x := (props.hotspot_x * width + props.width / 2) / props.width
    hot_y := (props.hotspot_y * height + props.height / 2) / props.height
    if hot_x >= width { hot_x = width - 1 }
    if hot_y >= height { hot_y = height - 1 }
    pixels: [16384]u32
    if !RasterCursor.CairoImagePixels(props.asset_path, width, height, pixels[:], DesktopCursorPremultiplied()) { return null }
    surface := CursorSurface(cast(*u8)*pixels[0], width, height, 32,
        width * 4, cast(u32)0xff0000, cast(u32)0xff00,
        cast(u32)0xff, cast(u32)0xff000000)
    if surface == null { return null }
    next := CreateColorCursor(surface, hot_x, hot_y)
    FreeSurface(surface)
    if next == null { return null }
    entry := *desktop_custom[oldest]
    if entry.cursor != null {
        // Never free the cursor SDL is showing; select the replacement first.
        if entry.cursor == desktop_cursor_selected {
            SetCursor(next)
            desktop_cursor_selected = next
        }
        FreeCursor(entry.cursor)
    }
    entry.cursor = next
    desktop_custom_clock += cast(u64)1
    entry.used = desktop_custom_clock
    DesktopCursorRemember(entry, props)
    return next
}

DesktopSystemCursor :: (shape: s32) -> *void {
    native: [11]s32 = .{0, 0, 1, 3, 11, 7, 8, 5, 6, 9, 10}
    if shape < 0 || shape >= 11 { shape = 0 }
    if desktop_cursors[shape] == null { desktop_cursors[shape] = CreateSystemCursor(native[shape]) }
    return desktop_cursors[shape]
}

// Restores SDL's own cursor and visibility at teardown.
DesktopCursorRelease :: () {
    if desktop_cursor_selected != null || desktop_cursor_hidden {
        SetCursor(GetDefaultCursor())
        unused ShowCursor(1)
    }
    desktop_cursor_selected = null
    desktop_cursor_hidden = false
    desktop_cursor_applied_valid = false
}

// UI chooses the cursor; SDL applies it to this process's own window only.
// The resolved request is compared every frame and applied only on change.
#program_export
DesktopCursor :: (session: Session) -> bool {
    if window == null || !SessionValid(session) { return false }
    props := CursorResolve(session, TreeCursor(session))
    if desktop_cursor_applied_valid && DesktopCursorKey(*desktop_cursor_applied, props) {
        return desktop_cursor_applied_loaded
    }
    loaded: bool = true
    selected: *void
    if !props.hidden {
        if props.asset_path != "" {
            selected = DesktopBitmapCursor(props)
            loaded = selected != null
        }
        if selected == null { selected = DesktopSystemCursor(props.shape) }
        if selected == null { return false }
        if selected != desktop_cursor_selected {
            SetCursor(selected)
            desktop_cursor_selected = selected
        }
    }
    if props.hidden != desktop_cursor_hidden {
        unused ShowCursor(ifx props.hidden then 0 else 1)
        desktop_cursor_hidden = props.hidden
    }
    DesktopCursorRemember(*desktop_cursor_applied, props)
    desktop_cursor_applied_valid = true
    desktop_cursor_applied_loaded = loaded
    return loaded
}

// SDL_PIXELFORMAT_ARGB8888, which matches Cairo's image surface.
DESKTOP_PIXEL_FORMAT :: 0x16362004

#program_export
OpenDesktop :: () -> bool {
    return OpenDesktopSized(960, 600)
}

// A finished Lanczos copy wakes a window waiting for its next event.
DesktopLanczosWake :: (argument: *void) {
    event: Event
    event.kind = cast(u32)0x8000
    unused PushEvent(*event)
}

// Opens the window with a drawing area of `width` by `height` pixels.
#program_export
OpenDesktopSized :: (width: s32, height: s32) -> bool {
    if width <= 0 || height <= 0 { return false }
    if size_of(Event) != 56 { return false }
    if Init(cast(u32)0x2020) != 0 { return false }
    #if #defined(POSIX_THREADS) || #defined(ANDROID_BUILD) || #defined(KRYON_FRAME_THREADS) {
        Lanczos.LanczosSetWake(DesktopLanczosWake, null)
    }
    FrameInputProviderReset(*desktop_frame_input)
    desktop_physical_buttons=0; desktop_physical_sampled=false
    desktop_frame_input_pending_carry = false
    desktop_ordered = false
    desktop_quit = false
    desktop_intercept_close = false
    desktop_close_requested = false
    desktop_input_head = 0
    desktop_input_count = 0
    desktop_raw_keys = .{}
    desktop_gamepad_keys = .{}
    desktop_input_focused = false
    desktop_input_started = Timer.MonotonicMilliseconds()
    frame_frequency = PerformanceFrequency()
    frame_clock.deadline = cast(u64)0
    // The click that focuses this window must still reach its widgets.
    // SDL's default swallows it, including the first right-click menu request.
    hint: [32]u8
    enabled: [2]u8
    if !CopyCString("SDL_MOUSE_FOCUS_CLICKTHROUGH", hint[:]) ||
    !CopyCString("1", enabled[:]) { return false }
    unused SetHint(*hint[0], *enabled[0])
    title: [512]u8
    if !CopyCString(ProgramTitle(), title[:]) { return false }
    window = CreateWindow(*title[0], cast(s32)0x2fff0000,
        cast(s32)0x2fff0000, width, height, cast(u32)0x28)
    if window == null { return false }
    // Select an explicit native arrow before the first frame is drawn. This
    // also covers hosts that own their loop and have no retained tree yet.
    arrow:=DesktopSystemCursor(0)
    if arrow!=null { SetCursor(arrow); desktop_cursor_selected=arrow }
    unused ShowCursor(1)
    desktop_cursor_hidden=false
    desktop_cursor_applied_valid=false
    renderer = Presenter.CreatePixmapRenderer(window)
    if renderer == null { return false }
    texture = CreateTexture(renderer, cast(u32)DESKTOP_PIXEL_FORMAT, 1, width,
        height)
    if texture == null { return false }
    desktop_width = width
    desktop_height = height
    desktop_present_pending = true
    desktop_texture_dirty = true
    desktop_texture_reset = false
    desktop_pixels_valid = false
    desktop_first_frame = true
    desktop_first_frame_show = true
    StartTextInput()
    if !OpenRaster(width, height) { return false }
    DesktopControllersScan()
    return true
}

// The drawing area of the window, in pixels.
#program_export
DesktopViewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0, cast(float32)desktop_width,
        cast(float32)desktop_height}
}

// Asks for a new window size. A frame in progress keeps drawing at the old
// size; the next BeginDesktopFrame resizes the window and its surface, and
// DesktopViewport then reports the new size. If the new surface cannot be
// made, the window keeps its size.
#program_export
ResizeDesktop :: (width: s32, height: s32) -> bool {
    if window == null || width <= 0 || height <= 0 { return false }
    desktop_next_width = width
    desktop_next_height = height
    return true
}

// Centers the window this desktop host created on its current display.
#program_export
CenterDesktop :: () -> bool {
    if window == null { return false }
    SetWindowPosition(window, cast(s32)0x2fff0000, cast(s32)0x2fff0000)
    return true
}

// Sets only the window created by this host. Reject paths/titles that cannot
// be represented completely rather than silently shortening their bytes.
#program_export
DesktopSetTitle :: (title: string) -> bool {
    if window == null { return false }
    bytes: [4096]u8
    if !CopyCString(title, bytes[:]) { return false }
    SetWindowTitle(window, *bytes[0])
    return true
}

// Straight RGBA supplied by the application's asset/theme resolver. SDL copies
// the icon into this host's window; the caller retains ownership of its pixels.
#program_export
DesktopSetIcon :: (width: s32, height: s32, rgba: []u8) -> bool {
    if window==null || width<1 || height<1 || width>512 || height>512 { return false }
    count:=cast(s64)width*cast(s64)height
    if rgba.count!=count*4 { return false }
    pixels: Vec(u32)
    if !VecResizeBounded(pixels,count,262144) { return false }
    defer VecFree(pixels)
    for i: 0..count-1 {
        pixels[i]=(cast(u32)rgba[i*4+3]<<cast(u32)24) |
            (cast(u32)rgba[i*4]<<cast(u32)16) |
            (cast(u32)rgba[i*4+1]<<cast(u32)8) | cast(u32)rgba[i*4+2]
    }
    surface:=CursorSurface(cast(*u8)*pixels[0],width,height,32,width*4,
        cast(u32)0xff0000,cast(u32)0xff00,cast(u32)0xff,cast(u32)0xff000000)
    if surface==null { return false }
    SetWindowIcon(window,surface)
    FreeSurface(surface)
    return true
}

// Takes the oldest pending file. A small output leaves it queued for a caller
// with enough room. Paths are UTF-8, NUL terminated, and never truncated.
#program_export
DesktopTakeDroppedFile :: (output: []u8) -> bool {
    if desktop_drop_count == 0 { return false }
    path := TextFromCString(*desktop_dropped_files[desktop_drop_first][0])
    if !CopyCString(path, output) { return false }
    desktop_drop_first = (desktop_drop_first + 1) % 16
    desktop_drop_count -= 1
    return true
}

DesktopDropEvent :: (event: *Event) {
    drop := cast(*DropEvent)event
    if drop.path == null { return }
    // SDL_DROPFILE / SDL_DROPTEXT own their path even when ignored.
    if drop.kind == cast(u32)0x1000 && window != null &&
    drop.window_id == GetWindowID(window) && desktop_drop_count < 16 {
        length: s32 = 0
        while length < 4096 && drop.path[length] != 0 { length += 1 }
        if length > 0 && length < 4096 {
            at := (desktop_drop_first + desktop_drop_count) % 16
            for index: 0..length { desktop_dropped_files[at][index] = drop.path[index] }
            desktop_drop_count += 1
        }
    }
    FreeSdlMemory(cast(*void)drop.path)
}

// Open an absolute URL with the desktop's configured handler. No shell text
// is evaluated, and embedded NULs must never truncate the destination.
#program_export
DesktopOpenURL :: (url: string) -> bool {
    if url.count == 0 || url.count >= 8192 { return false }
    index: s32 = 0
    while index < url.count {
        if url[index] < cast(u8)32 || url[index] == cast(u8)127 { return false }
        index += 1
    }
    destination: [8192]u8
    if !CopyCString(url, destination[:]) { return false }
    return OpenURL(*destination[0]) == 0
}

DesktopApplyResize :: () -> bool {
    width := desktop_next_width
    height := desktop_next_height
    desktop_next_width = 0
    desktop_next_height = 0
    if width <= 0 || (width == desktop_width && height == desktop_height) {
        return true
    }
    next: *void = CreateTexture(renderer, cast(u32)DESKTOP_PIXEL_FORMAT, 1, width,
        height)
    if next == null { return false }
    CloseRaster()
    desktop_pixels_valid = false
    desktop_texture_dirty = true
    desktop_present_pending = true
    if !OpenRaster(width, height) {
        DestroyTexture(next)
        // Go back to the old size, which opened before.
        CloseRaster()
        unused OpenRaster(desktop_width, desktop_height)
        return false
    }
    DestroyTexture(texture)
    texture = next
    SetWindowSize(window, width, height)
    desktop_width = width
    desktop_height = height
    return true
}

#program_export
CloseDesktop :: () {
    FrameInputProviderReset(*desktop_frame_input)
    desktop_physical_buttons=0; desktop_physical_sampled=false
    desktop_frame_input_pending_carry = false
    desktop_ordered = false
    desktop_quit = false
    desktop_intercept_close = false
    desktop_close_requested = false
    desktop_input_head = 0
    desktop_input_count = 0
    desktop_raw_keys = .{}
    desktop_gamepad_keys = .{}
    desktop_input_focused = false
    desktop_key = 0
    desktop_keys = .{}
    desktop_key_modifiers = -1
    desktop_codepoint_count = 0
    desktop_codepoint_next = 0
    for slot: cast(s32)0..3 {
        if desktop_controllers[slot].handle != null { GameControllerClose(desktop_controllers[slot].handle) }
        desktop_controllers[slot] = .{}
    }
    DesktopCursorRelease()
    for index: cast(s32)0..DESKTOP_CUSTOM_CURSORS - 1 {
        if desktop_custom[index].cursor != null { FreeCursor(desktop_custom[index].cursor) }
        desktop_custom[index] = .{}
    }
    desktop_cursor_scale = 0
    for index: 0..10 {
        if desktop_cursors[index] != null { FreeCursor(desktop_cursors[index]) }
        desktop_cursors[index] = null
    }
    Video.VideoStopHost()
    StopTextInput()
    CloseRaster()
    if texture != null { DestroyTexture(texture) }
    if renderer != null { DestroyRenderer(renderer) }
    if window != null { DestroyWindow(window) }
    Quit()
    window = null
    desktop_drop_first = 0
    desktop_drop_count = 0
}

#program_export
SetPointerFrame :: (x: float32, y: float32, down: bool,
    pressed: bool, released: bool) {
    pointer.x = x
    pointer.y = y
    pointer.down = down
    pointer.pressed = pressed
    pointer.released = released
}

DesktopEventText :: (event: *Event) -> string {
    bytes: []u8 = BytesFromPointer(cast(*u8)event, cast(u64)56)
    end: s32 = 12
    while end < 44 && bytes[end] != cast(u8)0 { end += 1 }
    return TextFromBytes(bytes[12:end])
}

DesktopInputEditing :: (code: s32, modifiers: s32) -> bool {
    return (code >= 256 && code < 340) ||
        ((modifiers & 0xFC0) != 0 && code >= 32 && code < 127)
}

// Opt into ordered UI delivery before the first poll. Raw last/all-key
// observations retain their meaning for custom hosts and games.
#program_export
DesktopInputEnable :: () {
    desktop_ordered = true
    desktop_input_head = 0
    desktop_input_count = 0
}

DesktopInputPush :: (code: s32, modifiers: s32, text: bool) {
    if !desktop_ordered || code == 0 { return }
    // Physical modifier transitions belong to raw observations. Each actual
    // shortcut already carries its own modifiers; merging a later Ctrl press
    // into preceding text would wrongly turn that text into a shortcut.
    if !text && code >= 340 && code <= 347 { return }
    at := (desktop_input_head + desktop_input_count) % 32
    desktop_input[at] = .{code, modifiers, text, !text && DesktopInputEditing(code, modifiers)}
    desktop_input_count += 1
}

// Transfer one editing action or a run of printable keys/text. Never cross
// an editing boundary while previously delivered text remains unconsumed.
#program_export
DesktopInputTake :: (session: Session) -> (key: s32, modifiers: s32) {
    if !SessionValid(session) { return 0, 0 }
    key: s32 = 0
    modifiers: s32 = 0
    // Unread text blocks editing actions, while physical printable keys
    // and further text can still use the existing bounded delivery queue.
    consumed: bool = TypedCodepointPeek(session) != 0
    while desktop_input_count > 0 {
        item := desktop_input[desktop_input_head]
        if item.editing && consumed { break }
        if item.text {
            if !TypedCodepointSend(session, item.code) { break }
        } else {
            key = item.code
            modifiers = item.modifiers
        }
        desktop_input_head = (desktop_input_head + 1) % 32
        desktop_input_count -= 1
        consumed = true
        if item.editing { break }
    }
    if !consumed { return 0, DesktopModifiers() }
    result: s32 = 0
    if (modifiers & 0x3) != 0 { result |= 1 }
    if (modifiers & 0xC0) != 0 { result |= 2 }
    if (modifiers & 0x300) != 0 { result |= 4 }
    return key, result
}

// Remove only lifecycle requests; keep all other SDL events in place.
DesktopLifecycleEvent :: (argument: *void, event: *Event) -> s32 {
    if event.kind == cast(u32)0x100 {
        desktop_quit = true
        return 0
    }
    if window != null && event.kind == cast(u32)0x200 &&
        event.window_id == GetWindowID(window) &&
        (event.which & cast(u32)255) == cast(u32)14 {
        if desktop_intercept_close { desktop_close_requested = true }
        else { desktop_quit = true }
        return 0
    }
    return 1
}

DesktopEventBackpressured :: (event: *Event) -> bool {
    if window != null && event.window_id == GetWindowID(window) {
        if event.kind == cast(u32)0x303 {
            count := Count(DesktopEventText(event))
            return desktop_codepoint_count + count > 32 ||
                (desktop_ordered && desktop_input_count + count > 32)
        }
        if event.kind == cast(u32)0x300 {
            code := DesktopKeyWithModifiers(event.x,event.y & 65535)
            return code != 0 && (desktop_keys.count >= 32 ||
                (desktop_ordered && desktop_input_count >= 32 && (code < 340 || code > 347)))
        }
    }
    if event.kind == cast(u32)0x651 {
        slot := DesktopControllerFind(cast(s32)event.window_id)
        button := cast(s32)(event.which & cast(u32)255)
        code := DesktopGamepadKey(button)
        mask := cast(u32)1 << cast(u32)button
        held := slot >= 0 && code != 0 &&
            (desktop_controllers[slot].buttons & mask) != cast(u32)0
        return slot >= 0 && !held && code != 0 && desktop_input_focused &&
            !desktop_frame_input.focus_lost && desktop_frame_input.sample.focused &&
            (desktop_keys.count >= 32 || (desktop_ordered && desktop_input_count >= 32))
    }
    return false
}

#program_export
PollDesktop :: () -> bool {
    FrameInputProviderEnd(*desktop_frame_input)
    desktop_frame_input_pending_carry = false
    if window == null { return false }
    for key: cast(s32)1..511 { desktop_raw_keys[key] &= cast(u8)FrameKeyHeld }
    for key: cast(s32)1..511 { desktop_gamepad_keys[key] &= cast(u8)FrameKeyHeld }
    Clock.Begin(*frame_clock, PerformanceCounter(), frame_frequency)
    event: Event
    pressed: bool = false
    released: bool = false
    right_pressed: bool = false
    right_released: bool = false
    desktop_wheel = 0.0
    desktop_key = 0
    desktop_keys = .{}
    desktop_key_modifiers = -1
    remaining := ifx desktop_ordered then 0 else desktop_codepoint_count - desktop_codepoint_next
    for index: cast(s32)0..remaining-1 {
        desktop_codepoints[index] = desktop_codepoints[desktop_codepoint_next + index]
    }
    desktop_codepoint_count = remaining
    desktop_codepoint_next = 0
    // SDL_PollEvent stops at the marker its last pump left at the end of the
    // queue, so events another thread pushed after that pump would wait for
    // the next frame. Pump once and take every queued event; SDL_GETEVENT
    // drops the marker. The bound keeps a flooding sender from holding a frame.
    PumpEvents()
    lifecycle: EventFilter = DesktopLifecycleEvent
    FilterEvents(lifecycle, null)
    if desktop_quit {
        FrameInputProviderReset(*desktop_frame_input)
        DesktopCursorRelease()
        return false
    }
    taken: s32 = 0
    while taken < 4096 &&
    PeepEvents(*event, 1, 1, cast(u32)0, cast(u32)0xFFFF) > 0 {
        // Keep input in SDL's bounded queue until its Kryon queue has room.
        if DesktopEventBackpressured(*event) { break }
        if PeepEvents(*event,1,2,cast(u32)0,cast(u32)0xFFFF)<=0 { break }
        taken += 1
        if event.kind == cast(u32)0x1000 || event.kind == cast(u32)0x1001 {
            DesktopDropEvent(*event)
            continue
        }
        if event.kind == cast(u32)0x200 && window != null &&
        event.window_id == GetWindowID(window) {
            detail := event.which & cast(u32)255
            if detail == cast(u32)12 { desktop_input_focused = true }
            if detail == cast(u32)13 {
                desktop_input_focused = false
                desktop_frame_input.focus_lost = true
                desktop_key = 0
                desktop_keys = .{}
                desktop_key_modifiers = -1
                for slot: cast(s32)0..3 { DesktopControllerRelease(slot) }
                for key: cast(s32)1..511 {
                    held := (desktop_raw_keys[key] & cast(u8)FrameKeyHeld) != cast(u8)0
                    desktop_raw_keys[key] = ifx held then cast(u8)FrameKeyReleased else cast(u8)0
                }
            }
            // SDL_WINDOWEVENT_SHOWN / EXPOSED / RESTORED / DISPLAY_CHANGED.
            if detail == cast(u32)1 || detail == cast(u32)3 ||
            detail == cast(u32)9 || detail == cast(u32)18 {
                desktop_present_pending = true
            }
        }
        // Controller events have no window ID: offset 8 is the device index
        // for ADDED, instance ID otherwise; the button byte is at offset 12.
        if event.kind == cast(u32)0x653 { DesktopControllerOpen(cast(s32)event.window_id) }
        if event.kind == cast(u32)0x654 {
            slot := DesktopControllerFind(cast(s32)event.window_id)
            if slot >= 0 {
                DesktopControllerRelease(slot)
                GameControllerClose(desktop_controllers[slot].handle)
                desktop_controllers[slot] = .{}
                DesktopControllersScan()
            }
        }
        if event.kind == cast(u32)0x651 || event.kind == cast(u32)0x652 {
            slot := DesktopControllerFind(cast(s32)event.window_id)
            button := cast(s32)(event.which & cast(u32)255)
            code := DesktopGamepadKey(button)
            if slot >= 0 && code != 0 && desktop_input_focused {
                mask := cast(u32)1 << cast(u32)button
                held := (desktop_controllers[slot].buttons & mask) != cast(u32)0
                if event.kind == cast(u32)0x651 && !held {
                    desktop_controllers[slot].buttons |= mask
                    desktop_gamepad_keys[code] |= cast(u8)(FrameKeyHeld | FrameKeyPressed)
                    if !desktop_frame_input.focus_lost && desktop_frame_input.sample.focused {
                        desktop_key = code
                        desktop_key_modifiers = 0
                        unused DesktopKeyPush(*desktop_keys, code, 0)
                        DesktopInputPush(code, 0, false)
                    }
                } else if event.kind == cast(u32)0x652 && held {
                    desktop_controllers[slot].buttons &= ~mask
                    if !DesktopControllerHeld(button) {
                        desktop_gamepad_keys[code] &= cast(u8)FrameKeyPressed
                        desktop_gamepad_keys[code] |= cast(u8)FrameKeyReleased
                    }
                }
            }
        }
        // SDL renderer resets have no window ID. They invalidate the texture
        // or its contents, even if the app's accepted paint is unchanged.
        if event.kind == cast(u32)0x2000 || event.kind == cast(u32)0x2001 {
            desktop_texture_dirty = true
            desktop_present_pending = true
            if event.kind == cast(u32)0x2001 { desktop_texture_reset = true }
        }
        // SDL_WINDOWEVENT_RESIZED / SIZE_CHANGED. Resize only our SDL window;
        // its drawing surface follows the window manager at the next frame.
        if event.kind == cast(u32)0x200 && window != null &&
        event.window_id == GetWindowID(window) &&
        ((event.which & cast(u32)255) == cast(u32)5 ||
            (event.which & cast(u32)255) == cast(u32)6) {
            width: s32
            height: s32
            GetWindowSize(window, *width, *height)
            unused ResizeDesktop(width, height)
        }
        // SDL_QUIT comes from the last window closing or from the session
        // ending (SIGTERM, logout); it always quits.
        if event.kind == cast(u32)0x100 {
            FrameInputProviderReset(*desktop_frame_input)
            DesktopCursorRelease()
            return false
        }
        // SDL_WINDOWEVENT_CLOSE; SDL_WindowEvent.event is the byte at
        // offset 12, the low byte of Event.which here.
        if event.kind == cast(u32)0x200 &&
        event.window_id == GetWindowID(window) &&
        (event.which & cast(u32)255) == cast(u32)14 {
            if !desktop_intercept_close {
                FrameInputProviderReset(*desktop_frame_input)
                DesktopCursorRelease()
                return false
            }
            desktop_close_requested = true
        }
        // Only this host's window contributes input; never another SDL session.
        if event.kind >= cast(u32)0x300 && event.kind <= cast(u32)0x403 &&
        event.window_id != GetWindowID(window) { continue }
        if event.kind == cast(u32)0x300 || event.kind == cast(u32)0x301 {
            code := DesktopKeyWithModifiers(event.x,event.y & 65535)
            if code > 0 && code < 512 && desktop_input_focused {
                if event.kind == cast(u32)0x301 {
                    desktop_raw_keys[code] &= cast(u8)(FrameKeyPressed | FrameKeyRepeated)
                    desktop_raw_keys[code] |= cast(u8)FrameKeyReleased
                } else {
                    held := (desktop_raw_keys[code] & cast(u8)FrameKeyHeld) != cast(u8)0
                    desktop_raw_keys[code] |= cast(u8)FrameKeyHeld
                    // SDL_KeyboardEvent.repeat is byte 13 (inside Event.which).
                    if (event.which & cast(u32)0xFF00) != cast(u32)0 { desktop_raw_keys[code] |= cast(u8)FrameKeyRepeated }
                    else if !held { desktop_raw_keys[code] |= cast(u8)FrameKeyPressed }
                }
            }
        }
        if event.kind == cast(u32)0x300 {
            // SDL_KeyboardEvent.keysym.sym occupies byte offset 20 and
            // keysym.mod the low 16 bits at offset 24.
            desktop_key = DesktopKeyWithModifiers(event.x,event.y & 65535)
            desktop_key_modifiers = event.y & 65535
            key := desktop_key
            modifiers := desktop_key_modifiers
            unused DesktopKeyPush(*desktop_keys, key, modifiers)
            DesktopInputPush(key, modifiers, false)
        }
        if event.kind == cast(u32)0x303 {
            // SDL_TextInputEvent.text is a NUL-terminated UTF-8 array at
            // offset 12 in SDL_Event. The event storage lives through Decode,
            // and the preflight above reserved space for every scalar.
            value: string = DesktopEventText(*event)
            at: s32 = 0
            while at < cast(s32)value.count {
                decoded: Decoded = Decode(value, at)
                desktop_codepoints[desktop_codepoint_count] = cast(s32)decoded.value
                desktop_codepoint_count += 1
                DesktopInputPush(cast(s32)decoded.value, 0, true)
                at = decoded.after
            }
        }
        if event.kind == cast(u32)0x403 {
            // SDL_MouseWheelEvent.y occupies byte offset 20 in the event
            // union, which is Event.x in the button-event layout above.
            step: float32 = cast(float32)event.x
            // SDL_MOUSEWHEEL_FLIPPED occupies byte offset 24.
            if event.y == 1 { step = -step }
            desktop_wheel += step
        }
        if event.button == cast(u8)1 {
            if event.kind == cast(u32)0x401 { pressed = true }
            if event.kind == cast(u32)0x402 { released = true }
        }
        // SDL_BUTTON_RIGHT
        if event.button == cast(u8)3 {
            if event.kind == cast(u32)0x401 { right_pressed = true }
            if event.kind == cast(u32)0x402 { right_released = true }
        }
    }
    x: s32 = 0
    y: s32 = 0
    buttons: u32 = GetMouseState(*x, *y)
    // X11's SDL event cache can miss a release while another window has
    // keyboard focus, then suppress the next press as already held. Query
    // actual button state there and retain event edges for taps between polls.
    // Other drivers keep their existing event-backed sampling.
    driver:=GetCurrentVideoDriver()
    if driver!=null && TextFromCString(driver)=="x11" {
        buttons=GetGlobalMouseState(null,null)
        if desktop_physical_sampled {
            if (buttons&cast(u32)1)!=0 && (desktop_physical_buttons&cast(u32)1)==0 { pressed=true }
            if (buttons&cast(u32)1)==0 && (desktop_physical_buttons&cast(u32)1)!=0 { released=true }
            if (buttons&cast(u32)4)!=0 && (desktop_physical_buttons&cast(u32)4)==0 { right_pressed=true }
            if (buttons&cast(u32)4)==0 && (desktop_physical_buttons&cast(u32)4)!=0 { right_released=true }
        }
        desktop_physical_buttons=buttons; desktop_physical_sampled=true
    }
    down: bool = (buttons & cast(u32)1) != cast(u32)0
    // A press and release inside one poll (a tap) still counts as held for
    // this sample, so the press reaches the widget under it.
    if pressed { down = true }
    SetPointerFrame(cast(float32)x, cast(float32)y, down,
        pressed, released)
    secondary.down = (buttons & cast(u32)4) != cast(u32)0
    secondary.pressed = right_pressed
    secondary.released = right_released
    if desktop_quit {
        FrameInputProviderReset(*desktop_frame_input)
        DesktopCursorRelease()
        return false
    }
    raw: FrameInputSnapshot
    raw.keys = desktop_raw_keys
    for key: cast(s32)1..511 {
        raw.keys[key] |= desktop_gamepad_keys[key]
        // Releasing one source must not release another held source.
        if ((desktop_raw_keys[key] & cast(u8)FrameKeyHeld) != cast(u8)0 &&
            (desktop_gamepad_keys[key] & cast(u8)FrameKeyReleased) != cast(u8)0) ||
        ((desktop_gamepad_keys[key] & cast(u8)FrameKeyHeld) != cast(u8)0 &&
            (desktop_raw_keys[key] & cast(u8)FrameKeyReleased) != cast(u8)0) {
            raw.keys[key] &= ~cast(u8)FrameKeyReleased
        }
    }
    raw.focused = desktop_input_focused
    raw.pointer = pointer
    raw.secondary = secondary
    raw.modifiers = DesktopModifiers()
    raw.wheel = desktop_wheel
    raw.elapsed_ms = Timer.MonotonicMilliseconds() - desktop_input_started
    FrameInputProviderGather(*desktop_frame_input, raw)
    return true
}

// Publish the observations frozen by PollDesktop, never a consumed widget queue.
#program_export
DesktopFrameInputBegin :: (session: Session) -> bool {
    if desktop_frame_input_pending_carry {
        DesktopFrameInputAdvance()
        desktop_frame_input_pending_carry = false
    }
    return FrameInputProviderBegin(*desktop_frame_input, session)
}

#program_export
DesktopWheelMove :: () -> float32 { return desktop_wheel }

#program_export
DesktopPressedKey :: () -> s32 {
    // Existing widget loops use the last key and its modifiers.
    key := desktop_key
    desktop_key = 0
    return key
}

// Games with several input targets drain the complete ordered snapshot.
// Reading it does not change the ordinary single-widget event above.
#program_export
DesktopNextKey :: () -> s32 {
    key, modifiers := DesktopKeyTake(*desktop_keys)
    if key != 0 { desktop_key_modifiers = modifiers }
    return key
}

// The held modifier keys as KeyModifier bits (SDL's KMOD_SHIFT, KMOD_CTRL,
// and KMOD_ALT masks cover both left and right keys). A key pressed in this
// poll reports the modifiers held with it, even if they were released before
// the poll ended.
#program_export
DesktopModifiers :: () -> s32 {
    state: u32 = GetModState()
    if desktop_key_modifiers >= 0 { state = cast(u32)desktop_key_modifiers }
    modifiers: s32 = 0
    if (state & cast(u32)0x3) != cast(u32)0 { modifiers |= 1 }
    if (state & cast(u32)0xC0) != cast(u32)0 { modifiers |= 2 }
    if (state & cast(u32)0x300) != cast(u32)0 { modifiers |= 4 }
    return modifiers
}

#program_export
DesktopTypedCodepoint :: () -> s32 {
    if desktop_codepoint_next >= desktop_codepoint_count { return 0 }
    codepoint: s32 = desktop_codepoints[desktop_codepoint_next]
    desktop_codepoint_next += 1
    return codepoint
}

#program_export
CheckPointerEvents :: () -> bool {
    if window == null { return false }
    event: Event
    event.window_id = GetWindowID(window)
    event.kind = cast(u32)0x401
    event.button = cast(u8)1
    if PushEvent(*event) != 1 || !PollDesktop() ||
    !pointer.pressed || pointer.released { return false }
    event.kind = cast(u32)0x402
    if PushEvent(*event) != 1 || !PollDesktop() ||
    pointer.pressed || !pointer.released { return false }
    return true
}

#program_export
BeginDesktopFrame :: () {
    desktop_frame_unchanged = false
    unused DesktopApplyResize()
    BeginRasterFrame(true)
}

// GPU exposure/reset can reuse the held Cairo pixels. A new surface needs
// paint, and a video pipeline can change pixels without changing widget props.
#program_export
DesktopFrameReusable :: () -> bool {
    return desktop_pixels_valid && Video.pipeline == null
}

DesktopFrameInputNeutralize :: () {
    sample := desktop_frame_input.sample
    if !sample.available { return }
    for key: cast(s32)1..511 {
        sample.keys[key] &= cast(u8)FrameKeyHeld
    }
    sample.pointer.pressed = false
    sample.pointer.released = false
    sample.secondary.pressed = false
    sample.secondary.released = false
    sample.wheel = 0.0
    desktop_frame_input.sample = sample
    desktop_frame_input.focus_lost = false
}

DesktopFrameInputAdvance :: () {
    sample := desktop_frame_input.sample
    if !sample.available { return }
    elapsed := Timer.MonotonicMilliseconds() - desktop_input_started
    sample.delta_ms = elapsed - sample.elapsed_ms
    sample.elapsed_ms = elapsed
    sample.sequence += cast(u64)1
    desktop_frame_input.sample = sample
}

#program_export
EndDesktopFrame :: () -> bool {
    FrameInputProviderEnd(*desktop_frame_input)
    DesktopFrameInputNeutralize()
    desktop_frame_input_pending_carry = true
    desktop_key = 0
    desktop_keys = .{}
    desktop_key_modifiers = -1
    pointer.pressed = false
    pointer.released = false
    secondary.pressed = false
    secondary.released = false
    desktop_wheel = 0.0
    if !FinishRasterFrame(desktop_frame_unchanged && desktop_pixels_valid) { return false }
    desktop_pixels_valid = true
    if !desktop_frame_unchanged { desktop_texture_dirty = true }
    // A hidden window keeps running the app's frames without presenting.
    if !WindowVisibleHost() && !desktop_first_frame { return true }
    if !desktop_texture_dirty && !desktop_present_pending { return true }
    if desktop_texture_reset {
        next := CreateTexture(renderer, cast(u32)DESKTOP_PIXEL_FORMAT, 1,
            desktop_width, desktop_height)
        if next == null { return false }
        DestroyTexture(texture)
        texture = next
        desktop_texture_reset = false
    }
    if desktop_texture_dirty {
        if UpdateTexture(texture, null, RasterSurfaceData(),
            RasterSurfaceStride()) != 0 { return false }
        desktop_texture_dirty = false
        desktop_present_pending = true
    }
    if RenderCopy(renderer, texture, null, null) != 0 { return false }
    if desktop_first_frame {
        desktop_first_frame = false
        // SDL recreates a software window surface when it is shown. Present
        // after that transition, before any application loading can resume.
        if desktop_first_frame_show { ShowWindow(window) }
    }
    RenderPresent(renderer)
    desktop_present_pending = false
    return true
}

#program_export
DesktopFrameUnchanged :: (unchanged: bool) {
    desktop_frame_unchanged = unchanged && Video.pipeline == null
}

#program_export
PauseDesktop :: () {
    milliseconds := Clock.Wait(*frame_clock, PerformanceCounter(),
        frame_frequency, WindowVisibleHost(), desktop_frame_unchanged)
    if milliseconds > cast(u32)0 {
        // A null event pointer leaves the first event queued for PollDesktop.
        // Input wakes a stable screen immediately rather than waiting for its
        // next idle deadline; the next frame receives a fresh active budget.
        if WaitEventTimeout(null, cast(s32)milliseconds) != 0 {
            Clock.Wake(*frame_clock)
        }
    }
}

// SDL_WINDOW_HIDDEN
#program_export
WindowVisibleHost :: () -> bool {
    if window == null { return false }
    return (GetWindowFlags(window) & cast(u32)0x8) == cast(u32)0
}

// SDL_WINDOW_INPUT_FOCUS, excluding hidden and minimized windows. Inspect only
// the SDL window owned by this host; no desktop-wide window query is needed.
#program_export
WindowFocusedHost :: () -> bool {
    if window == null { return false }
    return (GetWindowFlags(window) & cast(u32)0x248) == cast(u32)0x200
}

#program_export
WindowSetVisibleHost :: (visible: bool) {
    if window == null { return }
    if desktop_first_frame {
        // Explicit visibility still waits for fully painted initial pixels.
        desktop_first_frame_show = visible
        return
    }
    if visible {
        ShowWindow(window)
        RaiseWindow(window)
    } else {
        HideWindow(window)
    }
}

#program_export
WindowInterceptCloseHost :: (enabled: bool) -> bool {
    // With interception on, closing the window must not also post SDL_QUIT,
    // which is reserved for the session ending.
    name: [48]u8
    value: [2]u8
    if !CopyCString("SDL_QUIT_ON_LAST_WINDOW_CLOSE", name[:]) { return false }
    if enabled {
        CopyCString("0", value[:])
    } else {
        CopyCString("1", value[:])
    }
    if SetHint(*name[0], *value[0]) == 0 { return false }
    desktop_intercept_close = enabled
    return true
}

#program_export
WindowTakeCloseRequestHost :: () -> bool {
    requested: bool = desktop_close_requested
    desktop_close_requested = false
    return requested
}

#program_export
WindowQuitHost :: () {
    desktop_quit = true
}

#program_export
PollPointer :: () -> PointerFrame {
    // Legacy retained widgets must receive the same focus-loss cancellation
    // as the frame snapshot. SDL can retain a held bit after release in a
    // different window. PollDesktop gathers raw `pointer`, never this view.
    if desktop_frame_input.sample.available { return desktop_frame_input.sample.pointer }
    return pointer
}

// The clipboard snapshot SystemClipboardOpenHost takes, and the text a write
// hands to SDL, which needs it NUL-terminated.
desktop_clipboard: [65536]u8;
desktop_clipboard_length: s32;

// Snapshots the text, cut on a whole character to fit.
#program_export
SystemClipboardOpenHost :: () -> s32 {
    desktop_clipboard_length = 0
    text: *u8 = GetClipboardText()
    if text == null { return -1 }
    length: s32 = 0
    while text[length] != cast(u8)0 && length < 65535 {
        desktop_clipboard[length] = text[length]
        length += 1
    }
    if text[length] != cast(u8)0 {
        while length > 0 && (cast(s32)desktop_clipboard[length - 1] & 192) == 128 { length -= 1 }
        if length > 0 && (cast(s32)desktop_clipboard[length - 1] & 192) == 192 { length -= 1 }
    }
    FreeSdlMemory(cast(*void)text)
    desktop_clipboard_length = length
    return length
}

#program_export
SystemClipboardByteHost :: (index: s32) -> s32 {
    if index < 0 || index >= desktop_clipboard_length { return -1 }
    return desktop_clipboard[index]
}

#program_export
SystemClipboardWriteHost :: (text: string) -> bool {
    length: s32 = cast(s32)text.count
    if length > 65535 { length = 65535 }
    index: s32 = 0
    while index < length {
        desktop_clipboard[index] = text[index]
        index += 1
    }
    desktop_clipboard[length] = cast(u8)0
    return SetClipboardText(*desktop_clipboard[0]) == 0
}

#program_export
PollSecondaryPointer :: () -> SecondaryPointerFrame {
    if desktop_frame_input.sample.available { return desktop_frame_input.sample.secondary }
    return secondary
}
