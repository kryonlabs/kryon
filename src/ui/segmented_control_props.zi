#module "segmented_control_props"
#import "geometry"

SegmentOption :: struct {
    key: u64
    label: string
    disabled: bool
}

SegmentedControlProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    class_name: i32
    selected_index: i32
    has_selection: bool
    height: i32
    min_item_width: i32
    max_item_width: i32
    wrap: bool
    scale: float
    disabled: bool
}

SegmentedControlResult :: struct {
    node: i32
    selected_index: i32
    clicked_index: i32
    changed: bool
    height: i32
}
