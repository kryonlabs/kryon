// Optional system image codecs, loaded without adding a backend link dependency.
// GdkPixbuf decodes and scales; the host converts its pixels to Cairo ARGB32.
// Preserve original pixels within the raster host's 256 MiB image budget.
ImagePixelLimit :: 67108864;
dl :: #system_library "dl";
c :: #system_library "c";
Copy :: (target: *void, source: *void, size: usize) -> *void #foreign c "memcpy";
Open :: (path: *u8, flags: s32) -> *void #foreign dl "dlopen";
Symbol :: (library: *void, name: *u8) -> *void #foreign dl "dlsym";
NewImage :: #type (path: *u8, width: s32, height: s32, preserve: s32, error: *void) -> *void #c_call;
Integer :: #type (image: *void) -> s32 #c_call;
Pixels :: #type (image: *void) -> *u8 #c_call;
Release :: #type (image: *void) -> void #c_call;
Info :: #type (path: *u8, width: *s32, height: *s32) -> *void #c_call;
Orient :: #type (image: *void) -> *void #c_call;
new_image: NewImage;
width_of: Integer;
height_of: Integer;
stride_of: Integer;
channels_of: Integer;
pixels_of: Pixels;
release: Release;
info: Info;
orient: Orient;
initialized: bool;
available: bool;
library: *void;

#import "std/c_string"
Resolve :: (slot: *void, name: string) -> bool {
    bytes: [128]u8
    if !CopyCString(name, bytes[:]) { return false }
    symbol := Symbol(library, *bytes[0])
    if symbol == null { return false }
    unused Copy(slot, cast(*void)*symbol, size_of(*void))
    return true
}

Init :: () -> bool {
    if initialized { return available }
    initialized = true
    name: [64]u8
    unused CopyCString("libgdk_pixbuf-2.0.so.0", name[:])
    library = Open(*name[0], 1)
    if library == null { return false }
    available = Resolve(cast(*void)*new_image, "gdk_pixbuf_new_from_file_at_scale") &&
        Resolve(cast(*void)*width_of, "gdk_pixbuf_get_width") &&
        Resolve(cast(*void)*height_of, "gdk_pixbuf_get_height") &&
        Resolve(cast(*void)*stride_of, "gdk_pixbuf_get_rowstride") &&
        Resolve(cast(*void)*channels_of, "gdk_pixbuf_get_n_channels") &&
        Resolve(cast(*void)*pixels_of, "gdk_pixbuf_get_pixels") &&
        Resolve(cast(*void)*release, "g_object_unref") &&
        Resolve(cast(*void)*info, "gdk_pixbuf_get_file_info") &&
        Resolve(cast(*void)*orient, "gdk_pixbuf_apply_embedded_orientation")
    return available
}

OpenImage :: (path: *u8) -> *void {
    if !Init() { return null }
    width: s32; height: s32
    if info(path, *width, *height) == null || width <= 0 || height <= 0 { return null }
    if width > 32768 || height > 32768 || cast(s64)width * cast(s64)height > ImagePixelLimit {
        if width > 4096 { width = 4096 }
        if height > 4096 { height = 4096 }
    }
    image := new_image(path, width, height, 1, null)
    if image == null { return null }
    oriented := orient(image)
    release(image)
    return oriented
}

Width :: (image: *void) -> s32 { return width_of(image) }
Height :: (image: *void) -> s32 { return height_of(image) }
CloseImage :: (image: *void) { release(image) }

CopyPixels :: (image: *void, destination: *u8, stride: s32) -> bool {
    width := width_of(image); height := height_of(image)
    channels := channels_of(image); source_stride := stride_of(image)
    if width <= 0 || height <= 0 || width > 32768 || height > 32768 ||
        cast(s64)width * cast(s64)height > ImagePixelLimit ||
        (channels != 3 && channels != 4) || source_stride < width * channels || stride < width * 4 { return false }
    source := pixels_of(image)
    if source == null || destination == null { return false }
    for y: 0..height - 1 {
        for x: 0..width - 1 {
            input := y * source_stride + x * channels
            output := y * stride + x * 4
            alpha: u32 = ifx channels == 4 then cast(u32)source[input + 3] else 255
            red := (cast(u32)source[input] * alpha + 127) / 255
            green := (cast(u32)source[input + 1] * alpha + 127) / 255
            blue := (cast(u32)source[input + 2] * alpha + 127) / 255
            pixel := cast(*u32)(*destination[output])
            pixel.* = (alpha << 24) | (red << 16) | (green << 8) | blue
        }
    }
    return true
}

// WebP through the system libwebp demuxer (libwebpdemux.so.2 and its
// libwebp.so.7), also loaded on first use: lossy, lossless and alpha pictures
// decode to straight RGBA, and an animation to its first complete frame.
#import "std/file_linux"
#import "std/byte_text_linux"
WebPInfo :: #type (data: *u8, size: usize, width: *s32, height: *s32) -> s32 #c_call;
WebPDecode :: #type (data: *u8, size: usize, width: *s32, height: *s32) -> *u8 #c_call;
WebPBuffer :: #type (size: usize) -> *u8 #c_call;
WebPRelease :: #type (pixels: *u8) -> void #c_call;
WebPOptionsInit :: #type (options: *void, version: s32) -> s32 #c_call;
WebPAnimationNew :: #type (data: *void, options: *void, version: s32) -> *void #c_call;
WebPAnimationInfo :: #type (decoder: *void, info: *void) -> s32 #c_call;
WebPAnimationNext :: #type (decoder: *void, frame: **u8, timestamp: *s32) -> s32 #c_call;
WebPAnimationDelete :: #type (decoder: *void) -> void #c_call;
WebPSource :: struct { bytes: *u8; size: usize; }
WebPOptions :: struct { color_mode: s32; use_threads: s32; padding: [7]u32; }
WebPCanvas :: struct { width: u32; height: u32; loop_count: u32; background: u32; frames: u32; padding: [4]u32; }
webp_info: WebPInfo;
webp_decode: WebPDecode;
webp_malloc: WebPBuffer;
webp_free: WebPRelease;
webp_options_init: WebPOptionsInit;
webp_animation_new: WebPAnimationNew;
webp_animation_info: WebPAnimationInfo;
webp_animation_next: WebPAnimationNext;
webp_animation_delete: WebPAnimationDelete;
webp_initialized: bool;
webp_available: bool;
webp_library: *void;

WebPImage :: struct {
    pixels: *u8
    width: s32
    height: s32
}

WebPInit :: () -> bool {
    if webp_initialized { return webp_available }
    webp_initialized = true
    name: [64]u8
    unused CopyCString("libwebpdemux.so.2", name[:])
    webp_library = Open(*name[0], 1)
    if webp_library == null { return false }
    webp_available = WebPResolve(cast(*void)*webp_info, "WebPGetInfo") &&
        WebPResolve(cast(*void)*webp_decode, "WebPDecodeRGBA") &&
        WebPResolve(cast(*void)*webp_malloc, "WebPMalloc") &&
        WebPResolve(cast(*void)*webp_free, "WebPFree") &&
        WebPResolve(cast(*void)*webp_options_init, "WebPAnimDecoderOptionsInitInternal") &&
        WebPResolve(cast(*void)*webp_animation_new, "WebPAnimDecoderNewInternal") &&
        WebPResolve(cast(*void)*webp_animation_info, "WebPAnimDecoderGetInfo") &&
        WebPResolve(cast(*void)*webp_animation_next, "WebPAnimDecoderGetNext") &&
        WebPResolve(cast(*void)*webp_animation_delete, "WebPAnimDecoderDelete")
    return webp_available
}

// dlsym also searches libwebpdemux's own dependency, libwebp.
WebPResolve :: (slot: *void, name: string) -> bool {
    bytes: [64]u8
    if !CopyCString(name, bytes[:]) { return false }
    symbol := Symbol(webp_library, *bytes[0])
    if symbol == null { return false }
    unused Copy(slot, cast(*void)*symbol, size_of(*void))
    return true
}

// The first animation frame, in a WebPMalloc copy of the demuxer's canvas.
WebPFirstFrame :: (data: *u8, size: usize, width: *s32, height: *s32) -> *u8 {
    options: WebPOptions
    // libwebp's demux ABI 1.7 and MODE_RGBA.
    if webp_options_init(cast(*void)*options, 0x0107) == 0 { return null }
    options.color_mode = 1
    options.use_threads = 0
    source := WebPSource.{data, size}
    decoder := webp_animation_new(cast(*void)*source, cast(*void)*options, 0x0107)
    if decoder == null { return null }
    pixels: *u8 = null
    canvas: WebPCanvas
    frame: *u8 = null
    timestamp: s32 = 0
    if webp_animation_info(decoder, cast(*void)*canvas) != 0 && canvas.width > 0 &&
        canvas.height > 0 && canvas.width <= 32768 && canvas.height <= 32768 &&
        cast(s64)canvas.width * cast(s64)canvas.height <= ImagePixelLimit &&
        webp_animation_next(decoder, *frame, *timestamp) != 0 && frame != null {
        count := cast(usize)canvas.width * cast(usize)canvas.height * cast(usize)4
        pixels = webp_malloc(count)
        if pixels != null {
            unused Copy(cast(*void)pixels, cast(*void)frame, count)
            width.* = cast(s32)canvas.width
            height.* = cast(s32)canvas.height
        }
    }
    webp_animation_delete(decoder)
    return pixels
}

// The file's pixels when it is a WebP file and libwebp is installed; empty
// otherwise, so other formats keep their GdkPixbuf and Cairo PNG paths.
OpenWebP :: (path: string) -> WebPImage {
    file := OpenRead(path)
    if !file.valid { return WebPImage.{} }
    header: [12]u8
    size := FileSize(file)
    if size < 12 || size > 268435456 || ReadAt(file, header[:], 0) != 12 ||
        header[0] != 82 || header[1] != 73 || header[2] != 70 || header[3] != 70 ||
        header[8] != 87 || header[9] != 69 || header[10] != 66 || header[11] != 80 ||
        !WebPInit() {
        unused CloseFile(file)
        return WebPImage.{}
    }
    data := webp_malloc(cast(usize)size)
    read: s64 = 0
    while data != null && read < size {
        count := ReadAt(file, BytesFromPointer(*data[read], cast(u64)(size - read)), read)
        if count <= 0 { break }
        read += count
    }
    unused CloseFile(file)
    image: WebPImage
    if data != null && read == size {
        width: s32 = 0
        height: s32 = 0
        if webp_info(data, cast(usize)size, *width, *height) != 0 && width > 0 && height > 0 &&
            width <= 32768 && height <= 32768 &&
            cast(s64)width * cast(s64)height <= ImagePixelLimit {
            pixels := webp_decode(data, cast(usize)size, *width, *height)
            if pixels == null { pixels = WebPFirstFrame(data, cast(usize)size, *width, *height) }
            if pixels != null { image = WebPImage.{pixels, width, height} }
        }
    }
    if data != null { webp_free(data) }
    return image
}

// Straight RGBA to Cairo's premultiplied ARGB32 rows of the given stride.
CopyWebP :: (image: WebPImage, destination: *u8, stride: s32) -> bool {
    if image.pixels == null || destination == null || stride < image.width * 4 { return false }
    for y: 0..image.height - 1 {
        for x: 0..image.width - 1 {
            input := (y * image.width + x) * 4
            alpha := cast(u32)image.pixels[input + 3]
            red := (cast(u32)image.pixels[input] * alpha + 127) / 255
            green := (cast(u32)image.pixels[input + 1] * alpha + 127) / 255
            blue := (cast(u32)image.pixels[input + 2] * alpha + 127) / 255
            pixel := cast(*u32)(*destination[y * stride + x * 4])
            pixel.* = (alpha << 24) | (red << 16) | (green << 8) | blue
        }
    }
    return true
}

CloseWebP :: (image: WebPImage) {
    if image.pixels != null { webp_free(image.pixels) }
}
