#module "paned_view_props"
#import "kryon_compat.generated.h"

DropZone :: enum {
    DropNone = 0
    DropCenter = 1
    DropLeft = 2
    DropRight = 3
    DropTop = 4
    DropBottom = 5
}

PanedViewProps :: struct {
    bounds: Rectangle
    id: i32
    class_name: i32
    vertical: bool
    split: *i32
    min_first: i32
    min_second: i32
}

# Implemented by the C-only paned-view host; declared here for the public ABI.
GetPaneDropZone :: (bounds: Rectangle, mouse: Vector2) -> DropZone #extern #export
