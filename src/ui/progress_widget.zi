#module "progress_widget"
#import "font_metrics"
#import "geometry"
#import "progress"
#import "progress_props"
#import "progress_raster"
#import "progress_style"
#import "style"
#import "style_sheet"
#import "tree"
#import "widget_kind"

# Resolved faces are values supplied by Kryon's style cascade. The platform
# only measures glyphs and rasterizes commands.
PreparedProgress :: struct {
    paint: ProgressPaint
    font: i32
    label_opacity: float
}

ProgressQueue :: struct {
    items: [1024]ProgressProps
    indices: [1024]i32
    present: [1024]bool
    count: i32
}

queued_progress :: ProgressQueue #global

PrepareProgress :: (props: ProgressProps,
    faces: ProgressFaces) -> PreparedProgress #export {
    prepared: PreparedProgress
    prepared.font = ResolveFont(0,
        StyleFontValue(faces.label.value.fields,
            faces.label.value.font_size), faces.fallback_font)
    prepared.label_opacity = StyleOpacityValue(faces.label.value.fields,
        faces.label.value.opacity)
    label_width: i32 = 0
    label_height: i32 = 0
    if props.label != "" {
        label_width = GlyphWidth(props.label, prepared.font,
            faces.label.value.typeface)
        label_height = GlyphLineHeight(prepared.font,
            faces.label.value.typeface)
    }
    prepared.paint = ProgressPaintFor(props.bounds, props.min, props.max,
        props.value, (float)label_width, (float)label_height, faces.scale,
        faces.track, faces.fill, faces.label)
    return prepared
}

PaintProgressProps :: (props: ProgressProps, faces: ProgressFaces) #export {
    prepared: PreparedProgress = PrepareProgress(props, faces)
    PaintProgress(props.bounds, prepared.paint, props.label,
        prepared.font, prepared.label_opacity)
}

PaintProgressFromRules :: (props: ProgressProps, rules: StyleRules,
    defaults: ProgressFaces) #export {
    faces: ProgressFaces = ProgressFacesFor(rules, props.class_name, defaults)
    PaintProgressProps(props, faces)
}

Progress :: (props: ProgressProps) #export {
    if TreeIsBuilding() {
        index: i32 = TreeSubmit(props.key, 0,
            WidgetKindProgress, props.bounds)
        if index >= 0 {
            queued_progress.items[index] = props
            queued_progress.indices[queued_progress.count] = index
            queued_progress.present[index] = true
            queued_progress.count += 1
        }
        return
    }
    PaintProgressFromRules(props, ActiveStyleRules(),
        DefaultProgressFaces())
}

PaintQueuedProgress :: (index: i32, bounds: Rectangle) #export {
    if index < 0 || index >= 1024 ||
        !queued_progress.present[index] { return }
    props: ProgressProps = queued_progress.items[index]
    props.bounds = bounds
    PaintProgressFromRules(props,
        ActiveStyleRules(), DefaultProgressFaces())
}

ClearQueuedProgress :: () #export {
    index: i32 = 0
    while index < queued_progress.count {
        empty: ProgressProps
        slot: i32 = queued_progress.indices[index]
        queued_progress.items[slot] = empty
        queued_progress.present[slot] = false
        index += 1
    }
    queued_progress.count = 0
}
