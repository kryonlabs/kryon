#module "syntax_paint_host"
#import "ui_internal.h"
#import "ui/text_rows.h"
#import "ui/text_navigation.h"
#import "runtime/text_input.h"
#import "runtime/text_rows.h"
#import "runtime/text.h"
#import "runtime/style.h"
#import "ctype.h"
#import "stdlib.h"
#import "string.h"

SyntaxIdentStart :: (value: char) -> i32 {
    return (value >= 'A' && value <= 'Z') ||
    (value >= 'a' && value <= 'z') || value == '_'
}

SyntaxIdent :: (value: char) -> i32 {
    return SyntaxIdentStart(value) ||
    (value >= '0' && value <= '9') || value == '-'
}

SyntaxWordInList :: (text: const char*, length: i32,
words: const char*) -> i32 {
    if length <= 0 || length > 92 { return 0 }
    needle: [96]char
    needle[0] = '|'
    memcpy(needle + 1, text, (size_t)length)
    needle[length + 1] = '|'
    needle[length + 2] = '\0'
    return strstr(words, needle) != nil
}

SyntaxZiranKeyword :: (text: const char*, length: i32) -> i32 {
    words: const char* = "|#defined|#else|#enum|#extern|#export|#global|#if|#import|#module|#private|#type|#ui|app|args|background|button|c|c_rect|call|cimport|clamp_max|clamp_min|do|draw|else|endraw|event|fn|font|for|fps|global|goto|guard|icon_button|if|import|in|key|key_down|line|mod|native|on|page|pub|raw|rect|return|returns|screen|set|set_theme|size|state|swatch|text|texture|theme|use|var|widget|"
    return SyntaxWordInList(text, length, words)
}

SyntaxCKeyword :: (text: const char*, length: i32) -> i32 {
    words: const char* = "|break|case|char|const|continue|default|do|double|else|enum|float|for|goto|if|int|long|return|short|sizeof|static|struct|switch|typedef|void|while|"
    return SyntaxWordInList(text, length, words)
}

SyntaxMakeKeyword :: (text: const char*, length: i32) -> i32 {
    words: const char* = "|define|else|endef|endif|export|ifdef|ifeq|ifndef|ifneq|include|override|private|undefine|unexport|vpath|"
    return SyntaxWordInList(text, length, words)
}

SyntaxTokenColor :: (syntax: SyntaxMode, text: const char*,
length: i32, first_token: i32,
style: TextInputAppearance) -> Color {
    dark: i32 = GetEffectiveThemeDarkMode()
    keyword: Color = dark ? (Color){142, 160, 240, 255} :
    (Color){36, 72, 172, 255}
    string_color: Color = dark ? (Color){110, 200, 176, 255} :
    (Color){34, 126, 82, 255}
    number: Color = dark ? (Color){213, 145, 82, 255} :
    (Color){150, 72, 126, 255}
    path: Color = dark ? (Color){205, 170, 110, 255} :
    (Color){138, 96, 32, 255}
    comment: Color = dark ? (Color){138, 146, 160, 255} :
    (Color){104, 112, 124, 255}
    if length <= 0 { return style.text }
    if (syntax == SyntaxZiran || syntax == SyntaxMake) &&
    first_token && text[0] == '#' &&
    !(syntax == SyntaxZiran && SyntaxZiranKeyword(text, length)) {
        return comment
    }
    if text[0] == '"' { return string_color }
    if (text[0] >= '0' && text[0] <= '9') ||
    (text[0] == '-' && length > 1 &&
    text[1] >= '0' && text[1] <= '9') { return number }
    if syntax == SyntaxZiran &&
    (text[0] == '/' ||
    (text[0] == '.' && length > 1 &&
    (text[1] == '/' || text[1] == '.')) ||
    text[0] == '%') { return path }
    if syntax == SyntaxZiran && SyntaxZiranKeyword(text, length) {
        return keyword
    }
    if syntax == SyntaxC && SyntaxCKeyword(text, length) {
        return keyword
    }
    if syntax == SyntaxMake && SyntaxMakeKeyword(text, length) {
        return keyword
    }
    if syntax == SyntaxMake && length > 1 && text[0] == '$' {
        return path
    }
    return style.text
}

SyntaxTokenLength :: (line: const char*, length: i32,
index: i32, syntax: SyntaxMode,
first_token: i32) -> i32 {
    position: i32 = index
    if position >= length { return 0 }
    if line[position] == ' ' || line[position] == '\t' {
        while position < length &&
        (line[position] == ' ' || line[position] == '\t') {
            position += 1
        }
        return position - index
    }
    if syntax == SyntaxZiran && first_token &&
    line[position] == '#' &&
    SyntaxIdentStart(line[position + 1]) {
        position += 1
        while position < length && SyntaxIdent(line[position]) {
            position += 1
        }
        return position - index
    }
    if (syntax == SyntaxZiran || syntax == SyntaxMake) &&
    first_token && line[position] == '#' {
        return length - index
    }
    if syntax == SyntaxC && line[position] == '/' &&
    position + 1 < length && line[position + 1] == '/' {
        return length - index
    }
    if line[position] == '"' {
        position += 1
        while position < length {
            if line[position] == '\\' && position + 1 < length {
                position += 2
                continue
            }
            if line[position] == '"' {
                position += 1
                break
            }
            position += 1
        }
        return position - index
    }
    if line[position] == '/' || line[position] == '%' ||
    (syntax == SyntaxMake && line[position] == '$') ||
    (line[position] == '.' && position + 1 < length &&
    (line[position + 1] == '/' || line[position + 1] == '.')) {
        position += 1
        while position < length &&
        !isspace((unsigned char)line[position]) &&
        strchr("{}[](),", line[position]) == nil {
            position += 1
        }
        return position - index
    }
    if (line[position] >= '0' && line[position] <= '9') ||
    (line[position] == '-' && position + 1 < length &&
    line[position + 1] >= '0' && line[position + 1] <= '9') {
        position += 1
        while position < length &&
        ((line[position] >= '0' && line[position] <= '9') ||
        line[position] == '.' || line[position] == 'x' ||
        (line[position] >= 'A' && line[position] <= 'F') ||
        (line[position] >= 'a' && line[position] <= 'f')) {
            position += 1
        }
        return position - index
    }
    if SyntaxIdentStart(line[position]) {
        position += 1
        while position < length && SyntaxIdent(line[position]) {
            position += 1
        }
        return position - index
    }
    return 1
}

DrawTextAreaSelection :: (text: const char*, line_start: i32,
line_end: i32, x: i32, y: i32, font: i32,
color: Color, selection_start: i32, selection_end: i32) {
    if text == nil || selection_end <= selection_start { return }
    span: TextSelectionPaintSpan = TextSelectionPaintSpanForLine(
    selection_start, selection_end, line_start, line_end)
    if !span.visible { return }
    start_x: i32 = x + ui_text_column_x(text,
    line_start, span.start, font)
    end_x: i32 = x + ui_text_column_x(text,
    line_start, span.end, font)
    end_x = TextSelectionHighlightEndX(start_x, end_x,
    span.continues_past_line, (float)Scale(1000) / 1000.0)
    DrawRectangle(start_x, y, end_x - start_x,
    TextLineHeight(font), color)
}

DrawTextAreaComposition :: (text: const char*,
line_start: i32, line_end: i32, x: i32, y: i32,
font: i32, color: Color, composition_start: i32,
composition_end: i32) {
    if text == nil || composition_end <= composition_start { return }
    stroke_width: i32 = TextInputStrokeWidth(
    (float)Scale(1000) / 1000.0)
    span: TextCompositionPaintSpan = TextCompositionPaintSpanForLine(
    composition_start, composition_end, line_start, line_end)
    if !span.visible { return }
    start_x: i32 = x + ui_text_column_x(text,
    line_start, span.start, font)
    end_x: i32 = x + ui_text_column_x(text,
    line_start, span.end, font)
    end_x = TextCompositionUnderlineEndX(start_x, end_x,
    stroke_width)
    DrawRectangle(start_x, TextCompositionUnderlineY(y,
    TextLineHeight(font), stroke_width),
    end_x - start_x, stroke_width, color)
}

DrawSyntaxLine :: (line: const char*, length: i32,
x: i32, y: i32, font: i32, syntax: SyntaxMode,
style: TextInputAppearance) {
    local: [1024]char
    offset: i32 = 0
    first_token: i32 = 1
    while offset < length {
        token_len: i32 = SyntaxTokenLength(line, length,
        offset, syntax, first_token)
        if token_len <= 0 { break }
        token: *char = local
        if token_len >= (int)sizeof(local) {
            token = (char*)malloc((size_t)token_len + 1)
            if token == nil { break }
        }
        memcpy(token, line + offset, (size_t)token_len)
        token[token_len] = '\0'
        color: Color = SyntaxTokenColor(syntax, token,
        token_len, first_token, style)
        if token[0] != ' ' && token[0] != '\t' {
            first_token = 0
        }
        RenderText(token, x, y, font, color)
        x += TextWidth(token, font)
        if token != local { free(token) }
        offset += token_len
    }
}

ui_draw_text_area_text :: (text: const char*, cursor: i32,
focused: i32, bounds: Rectangle, font: i32,
line_gap: i32, scroll_y: i32, wrap_width: i32,
syntax: SyntaxMode, style: TextInputAppearance,
selection_start: i32, selection_end: i32,
composition_start: i32, composition_end: i32) #export {
    selectable: i32 = PushTextSelectable(0)
    local: [1024]char
    metrics: TextInputMetrics = ui_text_input_metrics_for_appearance(
    style, StyleKindTextArea(), 0, 0)
    text_x: i32 = (int)bounds.x + metrics.padding_x
    text_y: i32 = (int)bounds.y + metrics.padding_y - scroll_y
    clip_top: i32 = (int)bounds.y + metrics.padding_y
    clip_bottom: i32 = (int)(bounds.y + bounds.height) -
    metrics.padding_y
    stroke_width: i32 = TextInputStrokeWidth(
    (float)Scale(1000) / 1000.0)
    style.text = GetColor(TextContentColorFor(style.fields,
    StyleForeground, ColorToInt(style.text), ColorToInt(BLACK)))
    style.cursor = GetColor(TextContentColorFor(style.fields,
    StyleFocus, ColorToInt(style.cursor), ColorToInt(style.text)))
    rows: TextRowCursor = ui_text_rows(text, font,
    line_gap, wrap_width, 1, 0)
    row: TextMeasuredRow = (TextMeasuredRow){0}
    text = rows.source.data
    while ui_text_row_next(&rows, &row) {
        chunk_start: i32 = row.start
        chunk_end: i32 = row.end
        line_font: i32 = row.font
        line_h: i32 = row.height
        draw_y: i32 = text_y + row.y
        line_len: i32 = chunk_end - chunk_start
        if draw_y + line_h >= clip_top && draw_y <= clip_bottom {
            line: *char = local
            if line_len >= (int)sizeof(local) {
                line = (char*)malloc((size_t)line_len + 1)
                if line == nil { break }
            }
            if line_len > 0 {
                memcpy(line, text + chunk_start, (size_t)line_len)
            }
            line[line_len] = '\0'
            DrawTextAreaSelection(text, chunk_start, chunk_end,
            text_x, draw_y, line_font,
            GetColor(TextSelectionColorFor(ColorToInt(style.cursor))),
            selection_start, selection_end)
            if syntax == SyntaxNone {
                RenderText(line, text_x, draw_y,
                line_font, style.text)
            } else {
                DrawSyntaxLine(line, line_len, text_x,
                draw_y, line_font, syntax, style)
            }
            if line != local { free(line) }
            DrawTextAreaComposition(text, chunk_start,
            chunk_end, text_x, draw_y, line_font,
            style.cursor, composition_start, composition_end)
            if focused && TextRowHasCursor(row.start, row.end,
            row.line_end, cursor) && ui_caret_blink_visible() {
                cursor_x: i32 = text_x + ui_text_column_x(text,
                chunk_start, cursor, line_font)
                DrawRectangle(cursor_x, draw_y, stroke_width,
                TextLineHeight(line_font), style.cursor)
            }
        }
        if draw_y > clip_bottom { break }
    }
    PopTextSelectable(selectable)
}
