#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/geometry"
Button :: #import "kryon/button";
DirectionPad :: #import "kryon/direction_pad";
Image :: #import "kryon/image";
Joystick :: #import "kryon/joystick";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
#import "kryon/tree"

loaded: bool;
clicked: bool;
swipe_was_down: bool;
joystick_was_active: bool;
swipe_leaned: bool;
scroll_offset: s32;
scroll_at_end: bool;

#program_export
main :: () -> s32 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        #if #defined(HOSTED_OTHER) {
            AppIdentity("portable.other")
        } else {
            AppIdentity("portable.probe")
        }
        AppDescribe("Portable hosted app", "")
        return APP_PROTOCOL
    }
    if mode == APP_SAVE {
        return ifx DocumentWrite("state.txt", ifx clicked then "clicked" else "new") then 0 else 1
    }
    if mode != APP_FRAME { return 0 }
    if !loaded {
        loaded = true
        clicked = DocumentRead("state.txt") == "clicked"
        if clicked { print("Hosted document restored\n") }
        if AppNow() < 1700000000.0 || AppLocalOffset() < -43200 || AppLocalOffset() > 50400 { return 1 }
        if AppSupports("unavailable.service") { return 2 }
        if AppService("unavailable.service", "") != "{\"status\":\"unavailable\"}" { return 3 }
    }
    button: Button.Props
    button.key = cast(u64)1
    button.bounds = Rectangle.{40.0, 40.0, 240.0, 64.0}
    button.label = "Save a portable document"
    if Button.Draw(AppSession(), button) > 0 {
        // Several documents in one interaction must share the browser host's
        // flush, rather than synchronizing the whole mount for each file.
        names: [8]string = .["batch/1", "batch/2", "batch/3", "batch/4",
        "batch/5", "batch/6", "batch/7", "batch/8"]
        for name: names {
            if !DocumentWrite(name, "saved") { return 4 }
        }
        clicked = true
        print("Hosted document clicked\n")
    }
    label: Text.Props
    label.bounds = Rectangle.{40.0, 128.0, 400.0, 40.0}
    label.text = ifx clicked then "Saved document" else "New document"
    label.size = 24
    Text.Draw(AppSession(), label)
    image: Image.Props
    image.bounds = Rectangle.{500.0, 80.0, 200.0, 200.0}
    image.asset_path = AppAssetPath("assets/red.png")
    Image.Draw(AppSession(), image)
    if AppKey() == 263 { print("Hosted key step\n") }
    swipe := Joystick.SwipeArea(AppSession(), Joystick.SwipeAreaProps.{.key = cast(u64)31000, .id = 31000,
            .bounds = Rectangle.{40.0, 320.0, 300.0, 120.0}, .now = AppNow(), .repeat_seconds = 0.1})
    if swipe.held { print("Hosted swipe step\n") }
    if swipe.lean == 2 && !swipe_leaned { print("Hosted swipe leans right\n") }
    swipe_leaned = swipe.lean == 2
    if swipe_was_down && !swipe.down { print("Hosted swipe released\n") }
    swipe_was_down = swipe.down
    stick := Joystick.Draw(AppSession(), Joystick.Props.{.key = cast(u64)32000, .id = 32000,
            .bounds = Rectangle.{400.0, 320.0, 200.0, 120.0}, .now = AppNow(), .repeat_seconds = 0.1})
    if stick.step { print("Hosted joystick step\n") }
    if joystick_was_active && stick.direction < 0 { print("Hosted joystick released\n") }
    joystick_was_active = stick.direction >= 0
    pad := DirectionPad.Draw(AppSession(), DirectionPad.Props.{.key = cast(u64)34000, .id = 34000,
            .bounds = Rectangle.{640.0, 300.0, 160.0, 160.0}, .now = AppNow(), .repeat_seconds = 0.1, .floating = true})
    if pad.step {
        if pad.direction == 0 { print("Hosted pad step left\n") }
        if pad.direction == 1 { print("Hosted pad step up\n") }
        if pad.direction == 2 { print("Hosted pad step right\n") }
        if pad.direction == 3 { print("Hosted pad step down\n") }
    }
    scroll := Scroll.Draw(AppSession(), Scroll.Props.{.key = cast(u64)33000,
            .bounds = Rectangle.{40.0, 460.0, 300.0, 120.0},
            .content_height = 480, .scroll_offset = scroll_offset})
    scroll_offset = scroll.scroll_offset
    at_end := scroll_offset >= 350
    if at_end && !scroll_at_end { print("Hosted scroll reached end\n") }
    if !at_end && scroll_at_end { print("Hosted scroll left end\n") }
    scroll_at_end = at_end
    if scroll.opened {
        Text.Draw(AppSession(), Text.Props.{.bounds = Rectangle.{scroll.content.x,
                    scroll.content.y, 240.0, 40.0}, .text = "First row", .size = 24})
        Text.Draw(AppSession(), Text.Props.{.bounds = Rectangle.{scroll.content.x,
                    scroll.content.y + 440.0, 240.0, 40.0}, .text = "Last row", .size = 24})
        End(AppSession())
    }
    return 0
}
