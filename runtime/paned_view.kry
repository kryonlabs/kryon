#module "paned_view"
#import "control_props"
#import "drawing_props"
#import "style"

PanedViewMetrics :: struct {
    grip: i32
    drop_edge: i32
}

PanedViewMetric :: (fields: u32, field: u32, value: float, fallback: float, scale: float) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return (i32)(value * scale)
}

PanedViewMetricsFor :: (scale: float, handle: StyleFrame) -> PanedViewMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: PanedViewMetrics
    metrics.grip = PanedViewMetric(handle.value.fields, (u32)StyleIconSize,
        handle.value.icon_size, 8.0, scale)
    metrics.drop_edge = PanedViewMetric(handle.value.fields, (u32)StylePaddingX,
        handle.value.padding_x, 46.0, scale)
    return metrics
}

PanedViewDropNone :: () -> i32 #export {
    return 0
}

PanedViewDropCenter :: () -> i32 #export {
    return 1
}

PanedViewDropLeft :: () -> i32 #export {
    return 2
}

PanedViewDropRight :: () -> i32 #export {
    return 3
}

PanedViewDropTop :: () -> i32 #export {
    return 4
}

PanedViewDropBottom :: () -> i32 #export {
    return 5
}

PanedViewSize :: (bounds: Rectangle, vertical: bool) -> i32 #export {
    if vertical { return (i32)bounds.width }
    return (i32)bounds.height
}

PanedViewLimit :: (size: i32, min_first: i32, min_second: i32) -> i32 #export {
    limit: i32 = size - min_second
    if limit < min_first { limit = min_first }
    return limit
}

PanedViewClampSplit :: (split: i32, min_first: i32, limit: i32) -> i32 #export {
    if split < min_first { return min_first }
    if split > limit { return limit }
    return split
}

PanedViewDefaultSplit :: (limit: i32) -> i32 #export {
    return limit / 2
}

PanedViewPointerSplit :: (bounds: Rectangle, vertical: bool,
    pointer_x: float, pointer_y: float) -> i32 #export {
    if vertical { return (i32)(pointer_x - bounds.x) }
    return (i32)(pointer_y - bounds.y)
}

PanedViewHandleFor :: (bounds: Rectangle, vertical: bool,
    split: i32, metrics: PanedViewMetrics) -> Rectangle #export {
    handle: Rectangle
    half: float = (float)metrics.grip * 0.5
    if vertical {
        handle.x = bounds.x + (float)split - half
        handle.y = bounds.y
        handle.width = (float)metrics.grip
        handle.height = bounds.height
    } else {
        handle.x = bounds.x
        handle.y = bounds.y + (float)split - half
        handle.width = bounds.width
        handle.height = (float)metrics.grip
    }
    return handle
}

PanedViewDropZoneFor :: (bounds: Rectangle, mouse: Vector2,
    metrics: PanedViewMetrics) -> i32 #export {
    if mouse.x < bounds.x || mouse.x > bounds.x + bounds.width ||
       mouse.y < bounds.y || mouse.y > bounds.y + bounds.height {
        return PanedViewDropNone()
    }
    edge: i32 = metrics.drop_edge
    if edge < 0 { edge = 0 }
    if mouse.x < bounds.x + (float)edge { return PanedViewDropLeft() }
    if mouse.x > bounds.x + bounds.width - (float)edge { return PanedViewDropRight() }
    if mouse.y < bounds.y + (float)edge { return PanedViewDropTop() }
    if mouse.y > bounds.y + bounds.height - (float)edge { return PanedViewDropBottom() }
    return PanedViewDropCenter()
}
