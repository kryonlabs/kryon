#module "menu"
#import "drawing_props"
#import "style"
#import "control_props"

MenuMetrics :: struct {
    row_height: i32
    panel_min_width: i32
    panel_padding: i32
    panel_margin: i32
    accelerator_gap: i32
    separator_inset: i32
    checked_mark_inset: i32
    label_inset: i32
    submenu_indicator_inset: i32
    bar_item_min_width: i32
    bar_item_padding: i32
    bar_item_gap: i32
    bar_item_y_padding: i32
    bar_label_inset: i32
}

MenuLine :: struct {
    x1: i32
    y1: i32
    x2: i32
    y2: i32
}

MenuHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != (u32)0
}

MenuMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if !MenuHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

MenuWrappedItemIndex :: (start: i32, direction: i32, item_count: i32) -> i32 #export {
    if item_count <= 0 { return -1 }
    if direction == 0 { direction = 1 }
    return (start + direction + item_count) % item_count
}

MenuItemSelectable :: (kind: i32, disabled: bool) -> bool #export {
    return kind != 3 && !disabled
}

MenuMetricsFor :: (scale: float, panel: StyleFrame, item: StyleFrame,
    bar: StyleFrame) -> MenuMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: MenuMetrics
    row_height: float = 30.0
    if MenuHas(item.value.fields, (u32)StyleFontSize) &&
       MenuHas(item.value.fields, (u32)StylePaddingY) {
        row_height = item.value.font_size + item.value.padding_y * 2.0
    }
    metrics.row_height = MenuMetric(item.value.fields,
        (u32)StyleContentOffset, item.value.offset_y, row_height, scale, false)
    metrics.panel_min_width = MenuMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_x, 180.0, scale, false)
    metrics.panel_padding = MenuMetric(panel.value.fields,
        (u32)StylePaddingX, panel.value.padding_x, 12.0, scale, true)
    metrics.panel_margin = MenuMetric(panel.value.fields,
        (u32)StyleGap, panel.value.gap, 4.0, scale, true)
    metrics.accelerator_gap = MenuMetric(item.value.fields,
        (u32)StyleContentOffset, item.value.offset_x, 88.0, scale, true)
    metrics.separator_inset = MenuMetric(item.value.fields,
        (u32)StylePaddingX, item.value.padding_x, 8.0, scale, true)
    metrics.checked_mark_inset = metrics.separator_inset
    metrics.label_inset = MenuMetric(item.value.fields,
        (u32)StyleIconSize, item.value.icon_size, 28.0, scale, true)
    metrics.submenu_indicator_inset = MenuMetric(item.value.fields,
        (u32)StylePaddingY, item.value.padding_y, 18.0, scale, true)
    metrics.bar_item_min_width = 0
    metrics.bar_item_padding = MenuMetric(bar.value.fields,
        (u32)StylePaddingX, bar.value.padding_x * 2.0, 24.0, scale, true)
    metrics.bar_item_gap = MenuMetric(bar.value.fields,
        (u32)StyleGap, bar.value.gap, 2.0, scale, true)
    metrics.bar_item_y_padding = MenuMetric(bar.value.fields,
        (u32)StylePaddingY, bar.value.padding_y, 3.0, scale, true)
    metrics.bar_label_inset = MenuMetric(bar.value.fields,
        (u32)StyleIconSize, bar.value.icon_size, 12.0, scale, true)
    return metrics
}

MenuGroupItemWidth :: (label_width: i32, metrics: MenuMetrics) -> i32 #export {
    width: i32 = label_width + metrics.bar_item_padding
    if width < metrics.bar_item_min_width {
        width = metrics.bar_item_min_width
    }
    return width
}

MenuPanelWidthStep :: (current_width: i32, label_width: i32,
    accelerator_width: i32, has_accelerator: bool,
    metrics: MenuMetrics) -> i32 #export {
    width: i32 = current_width
    if width <= 0 { width = metrics.panel_min_width }
    accel: i32 = 0
    if has_accelerator {
        accel = accelerator_width + metrics.accelerator_gap
    }
    candidate: i32 = label_width + accel + metrics.panel_padding * 2
    if candidate > width { width = candidate }
    return width
}

MenuPanelBounds :: (x: i32, y: i32, width: i32, item_count: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    bounds: Rectangle
    if item_count < 0 { item_count = 0 }
    if width < 0 { width = 0 }
    bounds.x = (float)x
    bounds.y = (float)y
    bounds.width = (float)width
    bounds.height = (float)(metrics.row_height * item_count +
        metrics.panel_margin * 2)
    return bounds
}

MenuRowBounds :: (panel: Rectangle, index: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    row: Rectangle
    if index < 0 { index = 0 }
    row.x = panel.x + (float)metrics.panel_margin
    row.y = panel.y + (float)(metrics.panel_margin +
        index * metrics.row_height)
    row.width = panel.width - (float)(metrics.panel_margin * 2)
    row.height = (float)metrics.row_height
    if row.width < 0.0 { row.width = 0.0 }
    return row
}

MenuSubmenuX :: (row: Rectangle) -> i32 #export {
    return (i32)(row.x + row.width)
}

MenuSubmenuOrigin :: (row: Rectangle) -> Vector2 #export {
    origin: Vector2
    origin.x = row.x + row.width
    origin.y = row.y
    return origin
}

MenuSeparatorLineFor :: (row: Rectangle, metrics: MenuMetrics) -> MenuLine #export {
    line: MenuLine
    line.x1 = (i32)row.x + metrics.separator_inset
    line.y1 = (i32)(row.y + row.height / 2.0)
    line.x2 = (i32)(row.x + row.width) - metrics.separator_inset
    line.y2 = line.y1
    if line.x2 < line.x1 {
        line.x2 = line.x1
    }
    return line
}

MenuTextY :: (row: Rectangle, line_height: i32) -> i32 #export {
    return (i32)row.y + ((i32)row.height - line_height) / 2
}

MenuCheckedMarkX :: (row: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)row.x + metrics.checked_mark_inset
}

MenuLabelX :: (row: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)row.x + metrics.label_inset
}

MenuAcceleratorX :: (row: Rectangle, text_width: i32,
    metrics: MenuMetrics) -> i32 #export {
    return (i32)(row.x + row.width) - text_width - metrics.panel_padding
}

MenuSubmenuIndicatorX :: (row: Rectangle,
    metrics: MenuMetrics) -> i32 #export {
    return (i32)(row.x + row.width) - metrics.submenu_indicator_inset
}

MenuBarFirstItemX :: (bar: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)bar.x + metrics.panel_margin
}

MenuBarNextItemX :: (x: i32, width: i32,
    metrics: MenuMetrics) -> i32 #export {
    return x + width + metrics.bar_item_gap
}

MenuBarLabelX :: (item: Rectangle, metrics: MenuMetrics) -> i32 #export {
    return (i32)item.x + metrics.bar_label_inset
}

MenuBarLabelY :: (item: Rectangle, line_height: i32) -> i32 #export {
    return MenuTextY(item, line_height)
}

MenuGroupItemBounds :: (x: i32, bar: Rectangle, width: i32,
    metrics: MenuMetrics) -> Rectangle #export {
    item: Rectangle
    item.x = (float)x
    item.y = bar.y + (float)metrics.bar_item_y_padding
    item.width = (float)width
    item.height = bar.height - (float)(metrics.bar_item_y_padding * 2)
    if item.height < 0.0 { item.height = 0.0 }
    return item
}
