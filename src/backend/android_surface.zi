// Android's native window size and Java-reported insets share one viewport.
// Surface synchronization runs on the render thread; inset updates may arrive
// on Java's UI thread and are copied under the Android mutex.
#import "c_string"
ANDROID_SURFACE :: #defined(ANDROID_BUILD) || #defined(PLATFORM_ANDROID) || #defined(__ANDROID__)
#if ANDROID_SURFACE {
    #import, file "android_native.zi";
    SurfaceTouch :: #import "android_touch";
}

AndroidWindowInsets :: struct {
    system_left: s32
    system_top: s32
    system_right: s32
    system_bottom: s32
    ime_bottom: s32
    cutout_left: s32
    cutout_top: s32
    cutout_right: s32
    cutout_bottom: s32
}
AndroidSafeArea :: struct {
    left: s32
    top: s32
    right: s32
    bottom: s32
}
AndroidViewport :: struct {
    x: s32
    y: s32
    width: s32
    height: s32
    insets: AndroidSafeArea
    ready: s32
}
AndroidViewportPolicy :: struct {
    insets: s32
    min_width: s32
    min_height: s32
}
AndroidSurfaceTransform :: struct {
    screen_width: s32
    screen_height: s32
    render_width: s32
    render_height: s32
    offset_x: s32
    offset_y: s32
    scale_x: float32
    scale_y: float32
    projection_x: float32
    projection_y: float32
}

surface_width: s32;
surface_height: s32;
window_insets: AndroidWindowInsets;
insets_ready: s32;
// The window frame's size, reported by the activity; 0 until it reports.
window_width: s32;
window_height: s32;
viewport_policy: AndroidViewportPolicy;
viewport_policy_set: bool;

#if ANDROID_SURFACE {
    c :: #system_library "c";
    SurfaceMutexLock :: (mutex: *void) -> s32 #foreign c "pthread_mutex_lock";
    SurfaceMutexUnlock :: (mutex: *void) -> s32 #foreign c "pthread_mutex_unlock";
    // PTHREAD_MUTEX_INITIALIZER is zero on bionic. Storage also fits glibc
    // for the display-free native behavior test.
    insets_mutex: [8]u64;
}

NonnegativeInset :: (value: s32) -> s32 {
    if value > 0 {
        return value
    }
    return 0
}
MaxInset :: (left: s32, right: s32) -> s32 {
    left = NonnegativeInset(left)
    right = NonnegativeInset(right)
    if left > right {
        return left
    }
    return right
}
ContentSize :: (size: s32, leading: s32, trailing: s32,
    minimum: s32) -> s32 {
    content := cast(s64)size - cast(s64)leading - cast(s64)trailing
    if content <= 0 || (minimum > 0 && content < cast(s64)minimum) {
        return size
    }
    return cast(s32)content
}

// Every Android frame stays clear of the status bar, navigation bar and camera
// cutout. An app's Frame lays out inside its viewport, and only art meant to
// run behind those bars asks for AndroidWindowBounds.
#program_export
AndroidViewportPolicySafeArea :: () -> AndroidViewportPolicy {
    policy: AndroidViewportPolicy
    policy.insets = 3
    return policy
}
#program_export
AndroidViewportPolicyResizeForIme :: () -> AndroidViewportPolicy {
    policy: AndroidViewportPolicy
    policy.insets = 7
    return policy
}

SafeAreaForPolicy :: (insets: AndroidWindowInsets,
    policy: AndroidViewportPolicy) -> AndroidSafeArea {
    area: AndroidSafeArea
    if (policy.insets & 1) != 0 {
        area.left = MaxInset(area.left, insets.system_left)
        area.top = MaxInset(area.top, insets.system_top)
        area.right = MaxInset(area.right, insets.system_right)
        area.bottom = MaxInset(area.bottom, insets.system_bottom)
    }
    if (policy.insets & 2) != 0 {
        area.left = MaxInset(area.left, insets.cutout_left)
        area.top = MaxInset(area.top, insets.cutout_top)
        area.right = MaxInset(area.right, insets.cutout_right)
        area.bottom = MaxInset(area.bottom, insets.cutout_bottom)
    }
    if (policy.insets & 4) != 0 {
        area.bottom = MaxInset(area.bottom, insets.ime_bottom)
    }
    return area
}

// Where the window frame sits in its surface. Android grows a raised
// window's surface past its frame by the shadow, the same on every side:
// a window coming back from the floating picture-in-picture window keeps an
// 18-pixel shadow on a 1.75x phone. Only an equal, even surplus on both axes
// is such a margin; any other mismatch is a resize in flight.
SurfaceMargin :: (width: s32, height: s32, frame_width: s32,
    frame_height: s32) -> AndroidSafeArea {
    margin: AndroidSafeArea
    if frame_width <= 0 || frame_height <= 0 {
        return margin
    }
    surplus := width - frame_width
    if surplus <= 0 || surplus != height - frame_height || surplus % 2 != 0 {
        return margin
    }
    margin.left = surplus / 2
    margin.top = margin.left
    margin.right = margin.left
    margin.bottom = margin.left
    return margin
}

// The insets are relative to the window frame, which lies margin inside
// the surface; the viewport is in surface pixels.
ResolveViewport :: (width: s32, height: s32,
    insets: AndroidWindowInsets, policy: AndroidViewportPolicy,
    ready: s32, margin: AndroidSafeArea = AndroidSafeArea.{}) -> AndroidViewport {
    frame_width := width - margin.left - margin.right
    frame_height := height - margin.top - margin.bottom
    area := SafeAreaForPolicy(insets, policy)
    viewport: AndroidViewport
    viewport.x = area.left
    viewport.y = area.top
    viewport.width = ContentSize(frame_width, area.left, area.right, policy.min_width)
    viewport.height = ContentSize(frame_height, area.top, area.bottom, policy.min_height)
    viewport.insets = area
    viewport.ready = ready
    if viewport.width == frame_width || viewport.width <= 0 {
        viewport.x = 0
        viewport.width = frame_width
    }
    if viewport.height == frame_height || viewport.height <= 0 {
        viewport.y = 0
        viewport.height = frame_height
    }
    viewport.x += margin.left
    viewport.y += margin.top
    return viewport
}

#program_export
SetAndroidWindowInsets :: (system_left: s32, system_top: s32,
    system_right: s32, system_bottom: s32, ime_bottom: s32,
    cutout_left: s32, cutout_top: s32, cutout_right: s32,
    cutout_bottom: s32) {
    #if ANDROID_SURFACE {
        SurfaceMutexLock(cast(*void)*insets_mutex[0])
    }
    window_insets.system_left = NonnegativeInset(system_left)
    window_insets.system_top = NonnegativeInset(system_top)
    window_insets.system_right = NonnegativeInset(system_right)
    window_insets.system_bottom = NonnegativeInset(system_bottom)
    window_insets.ime_bottom = NonnegativeInset(ime_bottom)
    window_insets.cutout_left = NonnegativeInset(cutout_left)
    window_insets.cutout_top = NonnegativeInset(cutout_top)
    window_insets.cutout_right = NonnegativeInset(cutout_right)
    window_insets.cutout_bottom = NonnegativeInset(cutout_bottom)
    insets_ready = 1
    #if ANDROID_SURFACE {
        SurfaceMutexUnlock(cast(*void)*insets_mutex[0])
    }
}

// The activity reports its window frame's size whenever it lays out; 0
// lets the app fill the whole surface, as in a floating window, which shows
// the shadow margin too.
#program_export
SetAndroidWindowSize :: (width: s32, height: s32) {
    #if ANDROID_SURFACE {
        SurfaceMutexLock(cast(*void)*insets_mutex[0])
    }
    window_width = NonnegativeInset(width)
    window_height = NonnegativeInset(height)
    #if ANDROID_SURFACE {
        SurfaceMutexUnlock(cast(*void)*insets_mutex[0])
    }
}

// The window frame's distance from each edge of a surface this size.
#program_export
GetAndroidSurfaceMargin :: (width: s32, height: s32) -> AndroidSafeArea {
    #if ANDROID_SURFACE {
        SurfaceMutexLock(cast(*void)*insets_mutex[0])
    }
    frame_width := window_width
    frame_height := window_height
    #if ANDROID_SURFACE {
        SurfaceMutexUnlock(cast(*void)*insets_mutex[0])
    }
    return SurfaceMargin(width, height, frame_width, frame_height)
}

#program_export
GetAndroidWindowInsets :: (output: *AndroidWindowInsets) -> s32 {
    #if ANDROID_SURFACE {
        SurfaceMutexLock(cast(*void)*insets_mutex[0])
    }
    if output != null {
        output[0] = window_insets
    }
    ready := insets_ready
    #if ANDROID_SURFACE {
        SurfaceMutexUnlock(cast(*void)*insets_mutex[0])
    }
    return ready
}
#program_export
SetAndroidViewportPolicy :: (policy: AndroidViewportPolicy) {
    viewport_policy = policy
    viewport_policy_set = true
}

#program_export
GetAndroidViewportPolicy :: () -> AndroidViewportPolicy {
    if !viewport_policy_set {
        return AndroidViewportPolicySafeArea()
    }
    return viewport_policy
}

#program_export
ResolveAndroidViewport :: (width: s32, height: s32,
    policy: AndroidViewportPolicy, output: *AndroidViewport) -> s32 {
    insets: AndroidWindowInsets
    ready := GetAndroidWindowInsets(*insets)
    if output != null {
        output[0] = ResolveViewport(width, height, insets, policy, ready,
            GetAndroidSurfaceMargin(width, height))
    }
    return ready
}

// The announced surface can be sized before its initialization is consumed.
// The host retains lifecycle acknowledgement and graphics ownership.
#program_export
GetAndroidPendingSurfaceSize :: (width: *s32, height: *s32) -> bool {
    #if ANDROID_SURFACE {
        return AndroidNativePendingSurfaceSize(width, height)
    } else {
        return false
    }
}

#program_export
GetAndroidSurfaceSize :: (width: *s32, height: *s32) -> s32 {
    w := surface_width
    h := surface_height
    if w <= 0 {
        w = 0
    }
    if h <= 0 {
        h = 0
    }
    #if ANDROID_SURFACE {
        if w <= 0 || h <= 0 {
            if AndroidNativeSurfaceSize(*w, *h) {
                surface_width = w
                surface_height = h
            }
        }
    }
    if width != null {
        width[0] = w
    }
    if height != null {
        height[0] = h
    }
    if surface_width > 0 && surface_height > 0 {
        return 1
    }
    return 0
}

#program_export
SyncAndroidSurfaceSize :: (width: *s32, height: *s32) -> s32 {
    if AndroidSurfaceOnWorker() { return GetAndroidSurfaceSize(width, height) }
    w := surface_width
    h := surface_height
    synced: s32 = 0
    #if ANDROID_SURFACE {
        AndroidNativeSyncSurface()
        if AndroidNativeSurfaceSize(*w, *h) {
            surface_width = w
            surface_height = h
            margin := GetAndroidSurfaceMargin(w, h)
            SurfaceTouch.AndroidTouchSetSurfaceOffset(cast(float32)margin.left,
                cast(float32)margin.top)
            synced = 1
        }
    }
    if width != null {
        width[0] = w
    }
    if height != null {
        height[0] = h
    }
    return synced
}

#program_export
SyncAndroidViewport :: (output: *AndroidViewport) -> s32 {
    width: s32
    height: s32
    SyncAndroidSurfaceSize(*width, *height)
    return ResolveAndroidViewport(width, height, GetAndroidViewportPolicy(), output)
}

// Read on the render thread after synchronization. Hosts can report the
// actual native-pixel transform without capturing private application pixels.
#program_export
ReadAndroidSurfaceTransform :: (output: *AndroidSurfaceTransform) -> bool {
    if android_surface_read_transform != null && android_surface_read_transform(output) { return true }
    #if ANDROID_SURFACE {
        width: s32
        height: s32
        if output == null || !AndroidNativeSurfaceSize(*width, *height) {
            return false
        }
        output.screen_width = width
        output.screen_height = height
        output.render_width = width
        output.render_height = height
        output.offset_x = 0
        output.offset_y = 0
        output.scale_x = 1.0
        output.scale_y = 1.0
        output.projection_x = 1.0
        output.projection_y = 1.0
        return true
    } else {
        unused output
        return false
    }
}

// Android draws the status and navigation bars light over whatever the app
// leaves behind them, so the strips outside the viewport are black. Insets are
// logical units and the backing store is physical pixels; zoom converts between
// them. The viewport takes the app's canvas color, given as 0xAARRGGBB.
#program_export
ClearAndroidFrame :: (viewport: AndroidViewport, canvas: u32, zoom: float32 = 1.0) {
    if android_surface_clear != null && android_surface_clear(viewport, canvas, zoom) { return }

    #if ANDROID_SURFACE {
        width: s32
        height: s32
        GetAndroidSurfaceSize(*width, *height)
        pixels := AndroidNativePixels()
        if width <= 0 || height <= 0 || pixels.count < cast(s64)width * cast(s64)height {
            return
        }
        pixel_count := cast(s64)width * cast(s64)height
        for index: 0..pixel_count - 1 {
            pixels[index] = cast(u32)0xff000000
        }
        if zoom < 0.1 || zoom > 8.0 { zoom = 1.0 }
        left := cast(s32)(cast(float32)viewport.x * zoom)
        top := cast(s32)(cast(float32)viewport.y * zoom)
        right := cast(s32)(cast(float32)(viewport.x + viewport.width) * zoom)
        bottom := cast(s32)(cast(float32)(viewport.y + viewport.height) * zoom)
        if left < 0 { left = 0 }
        if top < 0 { top = 0 }
        if right > width { right = width }
        if bottom > height { bottom = height }
        for row: top..bottom - 1 {
            for column: left..right - 1 {
                pixels[cast(s64)row * width + column] = canvas
            }
        }
    }
}

// Optional host recording hooks keep surface policy usable without a UI
// renderer or a threading dependency (including headless surface tests).
AndroidSurfaceWorker :: #type () -> bool;
AndroidSurfaceClear :: #type (viewport: AndroidViewport, canvas: u32, zoom: float32) -> bool;
AndroidSurfaceReadTransform :: #type (output: *AndroidSurfaceTransform) -> bool;
android_surface_worker: AndroidSurfaceWorker;
android_surface_clear: AndroidSurfaceClear;
android_surface_read_transform: AndroidSurfaceReadTransform;

AndroidSurfaceOnWorker :: () -> bool {
    return android_surface_worker != null && android_surface_worker()
}
