#import "c_string"
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "tree_input"

raylib :: #system_library "raylib";
sdl_library :: #system_library "SDL2";
libm :: #system_library "m";
HostRaylibSqrt :: (value: float32) -> float32 #foreign libm "sqrtf";

HostRaylibInitWindow :: (width: s32, height: s32, title: *u8) #foreign raylib "InitWindow";
HostRaylibCloseWindow :: () #foreign raylib "CloseWindow";
HostRaylibIsWindowReady :: () -> bool #foreign raylib "IsWindowReady";
HostRaylibWindowShouldClose :: () -> bool #foreign raylib "WindowShouldClose";
HostRaylibSetConfigFlags :: (flags: u32) #foreign raylib "SetConfigFlags";
HostRaylibSetTargetFPS :: (fps: s32) #foreign raylib "SetTargetFPS";
HostRaylibGetScreenWidth :: () -> s32 #foreign raylib "GetScreenWidth";
HostRaylibGetScreenHeight :: () -> s32 #foreign raylib "GetScreenHeight";
HostRaylibBeginDrawing :: () #foreign raylib "BeginDrawing";
HostRaylibEndDrawing :: () #foreign raylib "EndDrawing";
HostRaylibClearBackground :: (color: Color) #foreign raylib "ClearBackground";
HostRaylibDrawRounded :: (bounds: Rectangle, roundness: float32,
    segments: s32, color: Color) #foreign raylib "DrawRectangleRounded";
HostRaylibDrawRoundedOutline :: (bounds: Rectangle, roundness: float32, segments: s32, width: float32, color: Color) #foreign raylib "DrawRectangleRoundedLinesEx";
HostRaylibDrawLine :: (start: Vector2, end: Vector2, width: float32,
    color: Color) #foreign raylib "DrawLineEx";
HostRaylibDrawText :: (value: *u8, x: s32, y: s32, font: s32,
    color: Color) #foreign raylib "DrawText";
HostRaylibMeasureText :: (value: *u8, font: s32) -> s32 #foreign raylib "MeasureText";
RaylibFont :: struct {
    base_size: s32
    glyph_count: s32
    glyph_padding: s32
    texture: Texture2D
    recs: *Rectangle
    glyphs: *void
}
HostRaylibLoadFont :: (path: *u8, size: s32, codepoints: *s32,
    count: s32) -> RaylibFont #foreign raylib "LoadFontEx";
HostRaylibUnloadFont :: (font: RaylibFont) #foreign raylib "UnloadFont";
HostRaylibDrawFontText :: (font: RaylibFont, value: *u8, position: Vector2,
    size: float32, spacing: float32, tint: Color) #foreign raylib "DrawTextEx";
HostRaylibMeasureFontText :: (font: RaylibFont, value: *u8, size: float32,
    spacing: float32) -> Vector2 #foreign raylib "MeasureTextEx";
HostRaylibBeginScissor :: (x: s32, y: s32, width: s32, height: s32) #foreign raylib "BeginScissorMode";
HostRaylibEndScissor :: () #foreign raylib "EndScissorMode";
HostRaylibMouseX :: () -> s32 #foreign raylib "GetMouseX";
HostRaylibMouseY :: () -> s32 #foreign raylib "GetMouseY";
HostRaylibMousePressed :: (button: s32) -> bool #foreign raylib "IsMouseButtonPressed";
HostRaylibMouseDown :: (button: s32) -> bool #foreign raylib "IsMouseButtonDown";
HostRaylibMouseReleased :: (button: s32) -> bool #foreign raylib "IsMouseButtonReleased";
HostRaylibKeyPressed :: (key: s32) -> bool #foreign raylib "IsKeyPressed";
HostRaylibLoadTexture :: (path: *u8) -> Texture2D #foreign raylib "LoadTexture";
HostRaylibUnloadTexture :: (texture: Texture2D) #foreign raylib "UnloadTexture";
HostRaylibDrawTexture :: (texture: Texture2D, source: Rectangle, destination: Rectangle, origin: Vector2, rotation: float32, tint: Color) #foreign raylib "DrawTexturePro";
HostRaylibTakeScreenshot :: (path: *u8) #foreign raylib "TakeScreenshot";
HostRaylibFileExists :: (path: *u8) -> bool #foreign raylib "FileExists";
HostRaylibGetEnvironment :: (name: *u8) -> *u8 #foreign sdl_library "SDL_getenv";

RaylibAsset :: struct {
    path: [1024]u8
    length: s32
    texture: Texture2D
}

raylib_assets: [32]RaylibAsset;
raylib_assets_count: s32;
raylib_assets_next: s32;
raylib_pointer: PointerFrame;
raylib_image_error: bool;
raylib_font: RaylibFont;
raylib_font_loaded: bool;

RaylibTryFont :: (path: *u8) -> bool {
    if path == null || !HostRaylibFileExists(path) { return false }
    raylib_font = HostRaylibLoadFont(path, 32, null, 0)
    raylib_font_loaded = raylib_font.texture.id != cast(u32)0
    return raylib_font_loaded
}

RaylibRoundness :: (bounds: Rectangle, radius: float32) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 || radius <= 0.0 { return 0.0 }
    roundness: float32 = radius * 2.0 / edge
    if roundness > 1.0 { return 1.0 }
    return roundness
}

RaylibDrawImageStrip :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, origin: Vector2, rotation: float32,
    tint: Color, x: s32, y: s32, width: s32, height: s32) {
    if width <= 0 || height <= 0 { return }
    HostRaylibBeginScissor(x, y, width, height)
    HostRaylibDrawTexture(texture, source, destination, origin, rotation, tint)
    HostRaylibEndScissor()
}

// Scissor strips preserve DrawTexturePro's rotation and source mapping while
// following the same rounded clip boundary used by the Cairo host.
RaylibDrawImageClipped :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {
    x: s32 = cast(s32)clip.x
    y: s32 = cast(s32)clip.y
    width: s32 = cast(s32)clip.width
    height: s32 = cast(s32)clip.height
    if width <= 0 || height <= 0 { return }
    if radius <= 0.0 {
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x, y, width, height)
        return
    }
    if radius > cast(float32)width * 0.5 {
        radius = cast(float32)width * 0.5
    }
    if radius > cast(float32)height * 0.5 {
        radius = cast(float32)height * 0.5
    }
    rounded_rows: s32 = cast(s32)(radius + 0.5)
    if rounded_rows < 1 { rounded_rows = 1 }
    if rounded_rows * 2 > height { rounded_rows = height / 2 }
    row: s32 = 0
    while row < rounded_rows {
        dy: float32 = radius - (cast(float32)row + 0.5)
        inset: s32 = 0
        if dy > 0.0 {
            inset = cast(s32)(radius - HostRaylibSqrt(radius * radius -
                dy * dy) + 0.5)
        }
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + row,
            width - inset * 2, 1)
        RaylibDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + height - 1 - row,
            width - inset * 2, 1)
        row += 1
    }
    RaylibDrawImageStrip(texture, source, destination, origin,
        rotation, tint, x, y + rounded_rows,
        width, height - rounded_rows * 2)
}

RaylibAssetIndex :: (path: string) -> s32 {
    if path.count == 0 || path.count >= 1024 { return -1 }
    index: s32 = 0
    while index < raylib_assets_count {
        if raylib_assets[index].length == cast(s32)path.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)path.count {
                if raylib_assets[index].path[at] != path[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same { return index }
        }
        index += 1
    }
    if raylib_assets_count < 32 {
        index = raylib_assets_count
        raylib_assets_count += 1
    } else {
        index = raylib_assets_next
        HostRaylibUnloadTexture(raylib_assets[index].texture)
        raylib_assets_next = (raylib_assets_next + 1) % 32
    }
    if !CopyCString(path, raylib_assets[index].path[:]) {
        raylib_assets[index].length = 0
        return -1
    }
    raylib_assets[index].length = cast(s32)path.count
    raylib_assets[index].texture =
        HostRaylibLoadTexture(*raylib_assets[index].path[0])
    if raylib_assets[index].texture.id == cast(u32)0 {
        raylib_assets[index].length = 0
        return -1
    }
    return index
}

#program_export
OpenRaylib :: () -> bool {
    title: [32]u8
    if !CopyCString("Kryon Ziran", title[:]) { return false }
    HostRaylibSetConfigFlags(cast(u32)4)
    HostRaylibInitWindow(960, 600, *title[0])
    if !HostRaylibIsWindowReady() { return false }
    HostRaylibSetTargetFPS(60)
    name: [32]u8
    if CopyCString("KRYON_FONT_PATH", name[:]) {
        RaylibTryFont(HostRaylibGetEnvironment(*name[0]))
    }
    if !raylib_font_loaded {
        path: [96]u8
        if CopyCString("../kryon/assets/fonts/LiberationSans-Regular.ttf",
            path[:]) { RaylibTryFont(*path[0]) }
    }
    if !raylib_font_loaded {
        path: [96]u8
        if CopyCString("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
            path[:]) { RaylibTryFont(*path[0]) }
    }
    return true
}

#program_export
CloseRaylib :: () {
    index: s32 = 0
    while index < raylib_assets_count {
        if raylib_assets[index].texture.id != cast(u32)0 {
            HostRaylibUnloadTexture(raylib_assets[index].texture)
        }
        index += 1
    }
    raylib_assets_count = 0
    if raylib_font_loaded { HostRaylibUnloadFont(raylib_font) }
    raylib_font_loaded = false
    if HostRaylibIsWindowReady() { HostRaylibCloseWindow() }
}

#program_export
PollRaylib :: () -> bool {
    if HostRaylibWindowShouldClose() { return false }
    raylib_pointer.x = cast(float32)HostRaylibMouseX()
    raylib_pointer.y = cast(float32)HostRaylibMouseY()
    raylib_pointer.down = HostRaylibMouseDown(0)
    raylib_pointer.pressed = HostRaylibMousePressed(0)
    raylib_pointer.released = HostRaylibMouseReleased(0)
    return true
}

#program_export
RaylibViewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0,
        cast(float32)HostRaylibGetScreenWidth(),
        cast(float32)HostRaylibGetScreenHeight()}
}

#program_export
RaylibPressedKey :: () -> s32 {
    if HostRaylibKeyPressed(49) { return 49 }
    if HostRaylibKeyPressed(50) { return 50 }
    if HostRaylibKeyPressed(82) { return 82 }
    return 0
}

#program_export
BeginRaylibFrame :: () {
    raylib_image_error = false
    HostRaylibBeginDrawing()
    HostRaylibClearBackground(Color.{248, 250, 252, 255})
}

#program_export
EndRaylibFrame :: () -> bool {
    HostRaylibEndDrawing()
    return !raylib_image_error
}

#program_export
CaptureRequested :: () -> bool {
    name: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", name[:]) { return false }
    return HostRaylibGetEnvironment(*name[0]) != null
}

#program_export
CaptureConfigured :: () -> bool {
    name: [32]u8
    if !CopyCString("KRYON_CAPTURE_PATH", name[:]) { return false }
    path: *u8 = HostRaylibGetEnvironment(*name[0])
    if path == null { return false }
    HostRaylibTakeScreenshot(path)
    return HostRaylibFileExists(path)
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return 0 }
    if raylib_font_loaded {
        extent: Vector2 = HostRaylibMeasureFontText(raylib_font, *bytes[0],
            cast(float32)font, 0.0)
        return cast(s32)(extent.x + 0.5)
    }
    return HostRaylibMeasureText(*bytes[0], font)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return font
}

#program_export
PollPointer :: () -> PointerFrame { return raylib_pointer }

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    if segments < 4 { segments = 4 }
    HostRaylibDrawRounded(bounds, RaylibRoundness(bounds, radius),
        segments, color)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 || width <= 0.0 { return }
    if segments < 4 { segments = 4 }
    HostRaylibDrawRoundedOutline(bounds, RaylibRoundness(bounds, radius),
        segments, width, color)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    HostRaylibDrawLine(Vector2.{line.x, line.y},
        Vector2.{line.x + line.width, line.y + line.height}, 1.0, color)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return }
    if raylib_font_loaded {
        HostRaylibDrawFontText(raylib_font, *bytes[0],
            Vector2.{cast(float32)x, cast(float32)y},
            cast(float32)font, 0.0, color)
    } else {
        HostRaylibDrawText(*bytes[0], x, y, font, color)
    }
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    HostRaylibBeginScissor(cast(s32)clip.x, cast(s32)clip.y,
        cast(s32)clip.width, cast(s32)clip.height)
    RasterText(value, x, y, font, color)
    HostRaylibEndScissor()
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    index: s32 = RaylibAssetIndex(asset_path)
    if index < 0 { return 0 }
    return raylib_assets[index].texture.width
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    index: s32 = RaylibAssetIndex(asset_path)
    if index < 0 { return 0 }
    return raylib_assets[index].texture.height
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    if source.width <= 0.0 || source.height <= 0.0 ||
        destination.width <= 0.0 || destination.height <= 0.0 ||
        clip.width <= 0.0 || clip.height <= 0.0 {
        return
    }
    texture: Texture2D
    if asset_path.count > 0 {
        index: s32 = RaylibAssetIndex(asset_path)
        if index < 0 {
            raylib_image_error = true
            return
        }
        texture = raylib_assets[index].texture
    } else if texture_id != cast(u32)0 {
        texture = CurrentPaintTexture()
        if texture.id != texture_id {
            // Keep direct calls to the low-level raster effect usable.
            texture.id = texture_id
            texture.width = cast(s32)(source.x + source.width)
            texture.height = cast(s32)(source.y + source.height)
        }
    } else {
        raylib_image_error = true
        return
    }
    RaylibDrawImageClipped(texture, source, destination, clip, origin,
        rotation, radius, tint)
}
