CopyMemory :: (a: *void, b: *void, bytes: usize) ->*void {return RawCopyMemory(a,b,bytes)}

SavedContext :: struct {
 display: *void; context: *void; draw: *void; read: *void; api: u32
 glx_display: *void; glx_context: *void; glx_draw: u64; glx_read: u64
}
SaveContext :: ()->SavedContext {
 return .{EGetCurrentDisplay(),EGetCurrentContext(),EGetCurrentSurface(0x3059),EGetCurrentSurface(0x305a),EQueryAPI(),
  GLXCurrentDisplay(),GLXCurrentContext(),GLXCurrentDrawable(),GLXCurrentReadDrawable()}
}
MakeSceneCurrent :: (display: *void,context: *void)->bool {
 glx_context:=GLXCurrentContext()
 if glx_context!=null&&GLXMakeCurrent(GLXCurrentDisplay(),0,0,null)==0 {return false}
 unused EBindAPI(0x30a0)
 return EMakeCurrent(display,null,null,context)!=0
}
RestoreContext :: (saved: SavedContext, own: *void) {
 if saved.display!=null { unused EBindAPI(saved.api); unused EMakeCurrent(saved.display,saved.draw,saved.read,saved.context) }
 else {
  if own!=null {unused EMakeCurrent(own,null,null,null)}
  unused EBindAPI(saved.api)
  if saved.glx_context!=null {unused GLXMakeCurrent(saved.glx_display,saved.glx_draw,saved.glx_read,saved.glx_context)}
 }
}
Location :: (id: u32, name: string)->s32 {
 bytes: [128]u8
 if name.count>=128 { return -1 }
 for at: 0..name.count-1 { bytes[at]=name[at] }
 return UniformLocation(id,*bytes[0])
}
Compile :: (stage: u32, source: string, log: []u8)->u32 {
 bytes: Vec(u8)
 if !BuilderAppend(bytes,source)||bytes.count==0 {return 0}
 id:=CreateShader(stage); p:=*bytes[0]; n:=cast(s32)source.count
 ShaderSource(id,1,*p,*n); CompileShader(id)
 ok: s32; GetShader(id,0x8b81,*ok)
 if ok==0 { ShaderLog(id,cast(s32)log.count,null,*log[0]); DeleteShader(id); return 0 }
 return id
}
Program :: (vertex: string, fragment: string, log: []u8)->u32 {
 vs:=Compile(0x8b31,vertex,log); if vs==0 { return 0 }; defer DeleteShader(vs)
 fs:=Compile(0x8b30,fragment,log); if fs==0 { return 0 }; defer DeleteShader(fs)
 id:=CreateProgram(); AttachShader(id,vs); AttachShader(id,fs); LinkProgram(id)
 ok: s32; GetProgram(id,0x8b82,*ok)
 if ok==0 { ProgramLog(id,cast(s32)log.count,null,*log[0]); DeleteProgram(id); return 0 }
 return id
}
Texture :: (width: s32,height: s32,internal: s32,format: u32,kind: u32,data: *void,linear: bool=false)->u32 {
 id: u32; GenTextures(1,*id); BindTexture(0x0de1,id)
 TexParameter(0x0de1,0x2801,ifx linear then 0x2601 else 0x2600); TexParameter(0x0de1,0x2800,ifx linear then 0x2601 else 0x2600)
 TexParameter(0x0de1,0x2802,0x812f); TexParameter(0x0de1,0x2803,0x812f)
 TexImage(0x0de1,0,internal,width,height,0,format,kind,data)
 return id
}
