#module "cell"

# A terminal cell is a character and resolved colors. A platform host may
# compare successive buffers and emit ANSI, but it never decides layout.
Cell :: struct {
    glyph: u32
    foreground: u32
    background: u32
    attributes: u32
}

CellPut :: (cells: []Cell, columns: i32, rows: i32,
    x: i32, y: i32, cell: Cell) -> bool #export {
    if columns <= 0 || rows <= 0 || x < 0 || y < 0 ||
       x >= columns || y >= rows { return false }
    at: i64 = (i64)y * (i64)columns + (i64)x
    if at < (i64)0 || at >= (i64)cells.length { return false }
    cells[(i32)at] = cell
    return true
}

CellFill :: (cells: []Cell, columns: i32, rows: i32,
    x: i32, y: i32, width: i32, height: i32,
    cell: Cell) #export {
    if width <= 0 || height <= 0 { return }
    row: i32 = 0
    while row < height {
        col: i32 = 0
        while col < width {
            CellPut(cells, columns, rows, x + col, y + row, cell)
            col += 1
        }
        row += 1
    }
}

CellCodepointResult :: struct {
    value: u32
    after: i32
}

# Returns one Unicode scalar and the byte offset after it. Invalid UTF-8
# consumes one byte and yields U+FFFD so the terminal renderer stays aligned.
CellCodepoint :: (text: string, at: i32) -> CellCodepointResult #export {
    result: CellCodepointResult
    result.after = at
    if at < 0 || at >= text.length { return result }
    first: u8 = text[at]
    result.after = at + 1
    if first < (u8)128 {
        result.value = (u32)first
        return result
    }
    result.value = (u32)65533
    count: i32 = 0
    codepoint: u32 = (u32)0
    minimum: u32 = (u32)0
    if first >= (u8)194 && first <= (u8)223 {
        count = 1
        codepoint = (u32)(first & (u8)31)
        minimum = (u32)128
    } else if first >= (u8)224 && first <= (u8)239 {
        count = 2
        codepoint = (u32)(first & (u8)15)
        minimum = (u32)2048
    } else if first >= (u8)240 && first <= (u8)244 {
        count = 3
        codepoint = (u32)(first & (u8)7)
        minimum = (u32)65536
    }
    if count == 0 { return result }
    if at + count >= text.length { return result }
    index: i32 = 1
    while index <= count {
        part: u8 = text[at + index]
        if part < (u8)128 || part > (u8)191 { return result }
        codepoint = (codepoint << (u32)6) | (u32)(part & (u8)63)
        index += 1
    }
    if codepoint < minimum || codepoint > (u32)1114111 ||
       (codepoint >= (u32)55296 && codepoint <= (u32)57343) {
        return result
    }
    result.value = codepoint
    result.after = at + count + 1
    return result
}

# Write one scalar per cell. This primitive covers single-width text; a
# complete terminal layout layer must resolve wide and combining clusters in
# Ziran before submitting cells. The host only encodes and presents them.
CellWrite :: (cells: []Cell, columns: i32, rows: i32,
    x: i32, y: i32, text: string, foreground: u32,
    background: u32, attributes: u32) -> i32 #export {
    at: i32 = 0
    col: i32 = x
    written: i32 = 0
    while at < text.length {
        point: CellCodepointResult = CellCodepoint(text, at)
        if point.after <= at { break }
        cell: Cell
        cell.glyph = point.value
        cell.foreground = foreground
        cell.background = background
        cell.attributes = attributes
        if CellPut(cells, columns, rows, col, y, cell) { written += 1 }
        col += 1
        at = point.after
    }
    return written
}
