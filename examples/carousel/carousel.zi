App :: #import "kryon/app";
Carousel :: #import "kryon/carousel";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"

state: Carousel.CarouselState;
opened: s32 = -1;
Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Carousel", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    items := Carousel.CarouselItem.[.{.label = "Alpine lake", .portrait = "assets/alpine-lake.webp", .landscape = "assets/alpine-lake.webp", .caption = "A quiet morning in the mountains", .action = "Open"}, .{.label = "Coastal cliffs", .portrait = "assets/coastal-cliffs.webp", .landscape = "assets/coastal-cliffs.webp", .caption = "Follow the trail along the ocean", .action = "Create"}]
    for index: 0..cast(s32)items.count - 1 { items[index].disabled = example_disabled }
    if example_reduced_motion { state.position = cast(float32)state.selected }
    result := Carousel.Draw(session, Carousel.Props.{.disabled = example_disabled, .bounds = .{height = 320}, .now = now, .label = "Places to explore", .previous_label = "Previous", .next_label = "Next", .scale = 1.0}, items[:], *state)
    if result >= 0 { opened = result }
    if opened >= 0 { Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 36}, .text = items[opened].label}) }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "carousel"}, Frame) }
