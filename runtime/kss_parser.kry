# Selector: Kind[attr=value].class:state chains filling a StyleRule selector.

KssRuleResult :: struct {
    parser: KssParser
    rule: StyleRule
}

KssApplyAttr :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    attribute: KssNameResult = KssReadName(c)
    if !attribute.ok {
        p.cursor = attribute.parser
        result.parser = KssFail(p, "expected selector attribute")
        return result
    }
    equals: KssExpectResult = KssExpect(attribute.parser, 61)
    if !equals.ok {
        p.cursor = equals.parser
        result.parser = KssFail(p, "expected '=' in selector attribute")
        return result
    }
    value: KssNameResult = KssReadName(equals.parser)
    if !value.ok {
        p.cursor = value.parser
        result.parser = KssFail(p, "expected selector attribute value")
        return result
    }
    close: KssExpectResult = KssExpect(value.parser, 93)
    if !close.ok {
        p.cursor = close.parser
        result.parser = KssFail(p, "expected ']'")
        return result
    }
    if KssNameEquals(attribute.name, "tone") {
        mapped: i32 = KssToneValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown tone '", value.name)
            return result
        }
        rule.selector.tone = mapped
    } else if KssNameEquals(attribute.name, "emphasis") {
        mapped: i32 = KssEmphasisValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown emphasis '", value.name)
            return result
        }
        rule.selector.emphasis = mapped
    } else if KssNameEquals(attribute.name, "size") {
        mapped: i32 = KssSizeValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown size '", value.name)
            return result
        }
        rule.selector.size = mapped
    } else if KssNameEquals(attribute.name, "state") {
        mapped: i32 = KssStateValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown state '", value.name)
            return result
        }
        rule.selector.state = mapped
    } else if KssNameEquals(attribute.name, "role") {
        mapped: i32 = KssRoleValue(value.name)
        if mapped == -999999 {
            p.cursor = close.parser
            result.parser = KssFailName(p, "unknown role '", value.name)
            return result
        }
        rule.selector.role = mapped
    } else if KssNameEquals(attribute.name, "class") {
        rule.selector.class_name = KssClassId(value.name)
    } else {
        p.cursor = close.parser
        result.parser = KssFailName(p, "unknown selector attribute '",
            attribute.name)
        return result
    }
    p.cursor = close.parser
    result.parser = p
    result.rule = rule
    return result
}

KssParseSelector :: (p: KssParser) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.state = StyleStateAny()
    kind: KssNameResult = KssReadSelectorName(c)
    if !kind.ok {
        p.cursor = kind.parser
        result.parser = KssFail(p, "expected style selector")
        return result
    }
    mapped: i32 = KssKindValue(kind.name)
    if mapped == -999999 {
        p.cursor = kind.parser
        result.parser = KssFailName(p, "unknown style selector '",
            kind.name)
        return result
    }
    rule.selector.kind = mapped
    c = kind.parser
    p.cursor = c
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            result.parser = KssFail(p, "unterminated style rule")
            return result
        }
        if p.cursor.source[p.cursor.pos] == 91 {
            c = KssAdvance(c, 1)
            p.cursor = c
            attribute: KssRuleResult = KssApplyAttr(p, rule)
            if attribute.parser.status == (i32)KssStatusError {
                return attribute
            }
            p = attribute.parser
            c = p.cursor
            rule = attribute.rule
            continue
        }
        if p.cursor.source[p.cursor.pos] == 46 {
            c = KssAdvance(c, 1)
            p.cursor = c
            class_name: KssNameResult = KssReadSelectorName(c)
            if !class_name.ok {
                p.cursor = class_name.parser
                result.parser = KssFail(p,
                    "expected class name after '.'")
                return result
            }
            rule.selector.class_name = KssClassId(class_name.name)
            c = class_name.parser
            p.cursor = c
            continue
        }
        if p.cursor.source[p.cursor.pos] == 58 {
            c = KssAdvance(c, 1)
            p.cursor = c
            state: KssNameResult = KssReadName(c)
            if !state.ok {
                p.cursor = state.parser
                result.parser = KssFail(p, "expected state after ':'")
                return result
            }
            state_mapped: i32 = KssStateValue(state.name)
            if state_mapped == -999999 {
                p.cursor = state.parser
                result.parser = KssFailName(p, "unknown state '",
                    state.name)
                return result
            }
            rule.state = state_mapped
            c = state.parser
            p.cursor = c
            continue
        }
        running = false
    }
    result.parser = p
    result.rule = rule
    return result
}

# Property declarations. Token references resolve immediately against the
# current token table, so overlays applied earlier win as intended. Declarative
# hosts capture source spans and resolve them with KssResolveCSSValue when the
# rule is yielded, before subsequent overlays change the table.

KssCaptureDeclaration :: (p: KssParser, rule: StyleRule, name: KssName,
    name_start: i32, name_end: i32) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    if p.declaration_count >= 1024 {
        result.parser = KssFail(p, "declaration capacity exceeded")
        return result
    }
    entry: KssDeclaration
    entry.rule = p.rule_total
    entry.name_start = name_start
    entry.name_length = name_end - name_start
    c = KssSkipSpace(c)
    p.cursor = c
    entry.value_start = p.cursor.pos
    quote: u8 = 0
    depth: i32 = 0
    running: bool = true
    while running {
        if KssAtEnd(c) {
            result.parser = KssFail(p, "expected ';'")
            return result
        }
        byte: u8 = c.source[c.pos]
        if quote != 0 {
            if byte == 92 && KssPeek(c, 1) != 0 {
                c = KssAdvance(c, 2)
                p.cursor = c
                continue
            }
            if byte == quote {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && (KssPeek(c, 1) == 42 || (depth == 0 && KssPeek(c, 1) == 47)) {
            c = KssSkipSpace(c)
            p.cursor = c
            continue
        } else if byte == 40 || byte == 91 {
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            if depth <= 0 {
                result.parser = KssFail(p, "unmatched declaration delimiter")
                return result
            }
            depth = depth - 1
        } else if depth == 0 && (byte == 59 || byte == 125) {
            running = false
            continue
        }
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    entry.value_length = p.cursor.pos - entry.value_start
    while entry.value_length > 0 {
        byte: u8 = p.cursor.source[entry.value_start + entry.value_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.value_length = entry.value_length - 1
    }
    if entry.value_length <= 0 {
        result.parser = KssFailName(p, "expected declaration value after '", name)
        return result
    }
    if p.cursor.source[p.cursor.pos] == 59 {
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    p.declarations[p.declaration_count] = entry
    p.declaration_count = p.declaration_count + 1
    result.parser = p
    result.rule = rule
    return result
}

# Unknown foreign blocks are structure-lexed here. Recognized conditional
# groups and keyframes use the shared rule/declaration stream instead.

KssCaptureForeign :: (p: KssParser, name: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if p.foreign_count >= 16 {
        return KssFail(p, "foreign block capacity exceeded")
    }
    c = KssSkipSpace(c)
    p.cursor = c
    query_start: i32 = p.cursor.pos
    while !KssAtEnd(c) && p.cursor.source[p.cursor.pos] != 123 {
        if p.cursor.source[p.cursor.pos] == 59 || p.cursor.source[p.cursor.pos] == 125 {
            return KssFailName(p, "unknown directive '@", name)
        }
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    if KssAtEnd(c) {
        return KssFail(p, "expected '{' after block name")
    }
    entry: KssForeignBlock
    entry.name = name
    entry.query_start = query_start
    entry.query_length = p.cursor.pos - query_start
    while entry.query_length > 0 {
        byte: u8 = p.cursor.source[entry.query_start + entry.query_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.query_length = entry.query_length - 1
    }
    entry.body_start = 0
    entry.body_length = 0
    entry.file = p.cursor.file
    c = KssAdvance(c, 1)
    p.cursor = c
    entry.body_start = p.cursor.pos
    p.foreign[p.foreign_count] = entry
    p.foreign_count = p.foreign_count + 1
    p = KssSkipBlockRemainder(p)
    if p.status == (i32)KssStatusError {
        return p
    }
    p.foreign[p.foreign_count - 1].body_length = p.cursor.pos - 1 - p.foreign[p.foreign_count - 1].body_start
    return p
}

# Conditional groups ('@media (query) { rules }' and friends) contain rules;
# declarative hosts get them lexed here with per-rule group tags. The query
# text stays opaque to the grammar.

KssIsGroupName :: (name: KssName) -> bool {
    return KssNameEquals(name, "media") || KssNameEquals(name, "supports") ||
        KssNameEquals(name, "container") || KssNameEquals(name, "keyframes")
}

KssParseGroupBlock :: (p: KssParser, name: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if p.foreign_count >= 16 {
        return KssFail(p, "foreign block capacity exceeded")
    }
    c = KssSkipSpace(c)
    p.cursor = c
    query_start: i32 = p.cursor.pos
    while !KssAtEnd(c) && p.cursor.source[p.cursor.pos] != 123 {
        c = KssAdvance(c, 1)
        p.cursor = c
    }
    if KssAtEnd(c) {
        return KssFail(p, "expected '{' after group query")
    }
    entry: KssForeignBlock
    entry.name = name
    entry.query_start = query_start
    entry.query_length = p.cursor.pos - query_start
    while entry.query_length > 0 {
        byte: u8 = p.cursor.source[entry.query_start + entry.query_length - 1]
        if !KssIsSpace(byte) {
            break
        }
        entry.query_length = entry.query_length - 1
    }
    entry.body_start = 0
    entry.body_length = 0
    entry.file = p.cursor.file
    group: i32 = p.foreign_count
    p.foreign[p.foreign_count] = entry
    p.foreign_count = p.foreign_count + 1
    c = KssAdvance(c, 1)
    p.cursor = c
    p.foreign[group].body_start = p.cursor.pos
    p.resume_group = group
    return KssContinueGroupBlock(p)
}

KssContinueGroupBlock :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated group block")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            p.foreign[p.resume_group].body_length = p.cursor.pos - p.foreign[p.resume_group].body_start
            c = KssAdvance(c, 1)
            p.cursor = c
            p.resume_group = -1
            running = false
            continue
        }
        p = KssParseRule(p)
        if p.status == (i32)KssStatusError {
            return p
        }
        p.rule_span.group = p.resume_group
        return p
    }
    return p
}

KssReadColorValue :: (p: KssParser) -> KssColorResult {
    c: KssCursor = p.cursor
    hex: KssColorResult = KssReadHexColor(c)
    if hex.ok {
        return hex
    }
    reference: KssNameResult = KssReadName(hex.parser)
    if reference.ok {
        p.cursor = reference.parser
        index: i32 = KssFindColorToken(p, reference.name)
        if index >= 0 {
            hex.value = p.tokens[index].color
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        # Closed set of named colors from the value-set proposal. Tokens win
        # over builtins so packs keep full control of their palette.
        if KssNameEquals(reference.name, "transparent") {
            hex.value = 0x00000000
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        if KssNameEquals(reference.name, "black") {
            hex.value = 0x000000ff
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
        if KssNameEquals(reference.name, "white") {
            hex.value = 0xffffffff
            hex.ok = true
            hex.parser = reference.parser
            return hex
        }
    }
    hex.ok = false
    hex.parser = hex.parser
    return hex
}

KssReadNumberValue :: (p: KssParser) -> KssNumberResult {
    c: KssCursor = p.cursor
    literal: KssNumberResult = KssReadNumber(c)
    if literal.ok {
        return literal
    }
    reference: KssNameResult = KssReadName(literal.parser)
    if reference.ok {
        p.cursor = reference.parser
        index: i32 = KssFindNumberToken(p, reference.name)
        if index >= 0 {
            literal.value = p.tokens[index].number
            literal.ok = true
            literal.parser = reference.parser
            return literal
        }
    }
    literal.ok = false
    return literal
}

KssIntResult :: struct {
    parser: KssParser
    value: i32
    ok: bool
}

KssReadMaterialValue :: (p: KssParser) -> KssIntResult {
    c: KssCursor = p.cursor
    result: KssIntResult
    reference: KssNameResult = KssReadName(c)
    if !reference.ok {
        p.cursor = reference.parser
        result.parser = KssFail(p, "expected material")
        return result
    }
    mapped: i32 = KssMaterialValue(reference.name)
    if mapped == -999999 {
        p.cursor = reference.parser
        index: i32 = KssFindMaterialToken(p, reference.name)
        if index >= 0 {
            mapped = p.tokens[index].material
        }
    }
    if mapped == -999999 {
        result.parser = KssFailName(p, "unknown material '",
            reference.name)
        return result
    }
    p.cursor = reference.parser
    result.parser = p
    result.value = mapped
    result.ok = true
    return result
}

# One declaration into the rule's StyleData. Field flags come from
# control_props; every property stores presence explicitly.

KssParseProperty :: (p: KssParser, rule: StyleRule) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    c = KssSkipSpace(c)
    p.cursor = c
    name_start: i32 = p.cursor.pos
    name: KssNameResult = KssReadName(c)
    if !name.ok {
        p.cursor = name.parser
        result.parser = KssFail(p, "expected property name")
        return result
    }
    colon: KssExpectResult = KssExpect(name.parser, 58)
    if !colon.ok {
        p.cursor = colon.parser
        result.parser = KssFail(p, "expected ':' after property")
        return result
    }
    c = colon.parser
    p.cursor = c

    if p.declarative {
        return KssCaptureDeclaration(p, rule, name.name, name_start,
            name_start + name.name.length)
    }

    if KssNameEquals(name.name, "background") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBackground
        rule.style.background = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "foreground") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleForeground
        rule.style.foreground = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "border") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBorder
        rule.style.border = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "focus") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleFocus
        rule.style.focus = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name.name, "background-end") {
        value: KssColorResult = KssReadColorValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected hex color")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBackgroundEnd
        rule.style.background_end = value.value
        c = value.parser
        p.cursor = c
    } else {
        return KssParseNumberProperty(p, rule, name.name)
    }

    semicolon: KssExpectResult = KssExpect(c, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        result.parser = KssFail(p, "expected ';'")
        return result
    }
    p.cursor = semicolon.parser
    result.parser = p
    result.rule = rule
    return result
}

KssParseNumberProperty :: (p: KssParser, rule: StyleRule, name: KssName) -> KssRuleResult {
    c: KssCursor = p.cursor
    result: KssRuleResult
    if KssNameEquals(name, "radius") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleRadius
        rule.style.radius = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "border-width") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleBorderWidth
        rule.style.border_width = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "opacity") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleOpacity
        rule.style.opacity = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "padding-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StylePaddingX
        rule.style.padding_x = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "padding-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StylePaddingY
        rule.style.padding_y = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "gap") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleGap
        rule.style.gap = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "font-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleFontSize
        rule.style.font_size = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "letter-spacing") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleLetterSpacing
        rule.style.letter_spacing = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "icon-size") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleIconSize
        rule.style.icon_size = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "offset-x") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleContentOffset
        rule.style.offset_x = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "offset-y") {
        value: KssNumberResult = KssReadNumberValue(p)
        if !value.ok {
            p.cursor = value.parser
            result.parser = KssFail(p, "expected number")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleContentOffset
        rule.style.offset_y = value.value
        c = value.parser
        p.cursor = c
    } else if KssNameEquals(name, "material") {
        value: KssIntResult = KssReadMaterialValue(p)
        if !value.ok {
            result.parser = value.parser
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleMaterial
        rule.style.material = (MaterialKind)value.value
        p.cursor = value.parser.cursor
        c = value.parser.cursor
    } else if KssNameEquals(name, "typeface") {
        start: i32 = -1
        length: i32 = 0
        scan: KssCursor = KssSkipSpace(c)
        if !KssAtEnd(scan) && KssIdentStart(scan.source[scan.pos]) {
            start = scan.pos
            while !KssAtEnd(scan) && KssIdentChar(scan.source[scan.pos]) {
                length = length + 1
                scan = KssAdvance(scan, 1)
            }
        }
        if start < 0 {
            p.cursor = scan
            result.parser = KssFail(p, "expected typeface name")
            return result
        }
        rule.style.fields = rule.style.fields | (u32)StyleTypeface
        rule.style.typeface = StringSlice(scan.source, start, length)
        c = scan
    } else {
        result.parser = KssFailName(p, "unknown property '", name)
        return result
    }

    semicolon: KssExpectResult = KssExpect(c, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        result.parser = KssFail(p, "expected ';'")
        return result
    }
    p.cursor = semicolon.parser
    result.parser = p
    result.rule = rule
    return result
}

# Rules: selector, declaration block, layer and order bookkeeping. Strict
# mode parses the typed selector grammar; declarative mode records the
# selector as a raw span consumed by the shared declarative selector lexer.

KssParseRule :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    origin: KssOrigin
    origin.file = p.cursor.file
    origin.line = p.cursor.line
    origin.column = p.cursor.column
    span: KssRuleSpan
    span.file = p.cursor.file
    span.group = -1
    selector: KssRuleResult
    c = KssSkipSpace(c)
    p.cursor = c
    selector_start: i32 = p.cursor.pos
    if p.declarative {
        bracket: i32 = 0
        paren: i32 = 0
        quote: u8 = 0
        running: bool = true
        while running {
            if KssAtEnd(c) {
                return KssFail(p, "expected '{'")
            }
            byte: u8 = p.cursor.source[p.cursor.pos]
            if quote != 0 {
                if byte == 92 {
                    c = KssAdvance(c, 2)
                    p.cursor = c
                    continue
                }
                if byte == quote {
                    quote = 0
                }
            } else if byte == 47 && (KssPeek(c, 1) == 42 ||
                (bracket == 0 && paren == 0 && KssPeek(c, 1) == 47)) {
                comment: KssExpectResult = KssSelectorComment(c)
                if !comment.ok {
                    return KssFail(p, "unterminated selector comment")
                }
                c = comment.parser
                p.cursor = c
                continue
            } else if byte == 34 || byte == 39 {
                quote = byte
            } else if byte == 91 {
                bracket = bracket + 1
            } else if byte == 93 && bracket > 0 {
                bracket = bracket - 1
            } else if byte == 40 {
                paren = paren + 1
            } else if byte == 41 && paren > 0 {
                paren = paren - 1
            } else if byte == 123 && bracket == 0 && paren == 0 {
                running = false
                continue
            }
            c = KssAdvance(c, 1)
            p.cursor = c
        }
    } else {
        selector = KssParseSelector(p)
        if selector.parser.status == (i32)KssStatusError {
            return selector.parser
        }
        p = selector.parser
        c = p.cursor
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) || p.cursor.source[p.cursor.pos] != 123 {
            return KssFail(p, "expected '{'")
        }
    }
    span.selector_start = selector_start
    span.selector_length = p.cursor.pos - selector_start
    c = KssAdvance(c, 1)
    p.cursor = c
    span.body_start = p.cursor.pos
    rule: StyleRule = selector.rule
    rule.layer = p.layer
    rule.order = p.rule_total
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated style rule")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            span.body_length = p.cursor.pos - span.body_start
            c = KssAdvance(c, 1)
            p.cursor = c
            span.end = c.pos
            running = false
            continue
        }
        property: KssRuleResult = KssParseProperty(p, rule)
        if property.parser.status == (i32)KssStatusError {
            return property.parser
        }
        p = property.parser
        c = p.cursor
        rule = property.rule
    }
    p.rule = rule
    p.origin = origin
    p.rule_span = span
    p.rule_total = p.rule_total + 1
    p.status = (i32)KssStatusRule
    return p
}

# Environment axes are closed and typed. Blocks match the active environment
# only; values are validated regardless of the match.

KssEnvAxisValid :: (axis: KssName) -> bool {
    return KssNameEquals(axis, "theme") || KssNameEquals(axis, "contrast") ||
        KssNameEquals(axis, "density") || KssNameEquals(axis, "pointer") ||
        KssNameEquals(axis, "platform")
}

KssEnvValueValid :: (axis: KssName, value: KssName) -> bool {
    if KssNameEquals(axis, "theme") {
        return KssNameEquals(value, "light") || KssNameEquals(value, "dark")
    }
    if KssNameEquals(axis, "contrast") {
        return KssNameEquals(value, "normal") || KssNameEquals(value, "high")
    }
    if KssNameEquals(axis, "density") {
        return KssNameEquals(value, "compact") ||
            KssNameEquals(value, "comfortable") || KssNameEquals(value, "touch")
    }
    if KssNameEquals(axis, "pointer") {
        return KssNameEquals(value, "mouse") || KssNameEquals(value, "touch") ||
            KssNameEquals(value, "mixed")
    }
    return KssNameEquals(value, "desktop") || KssNameEquals(value, "android") ||
        KssNameEquals(value, "web") || KssNameEquals(value, "plan9") ||
        KssNameEquals(value, "terminal")
}

KssEnvMatches :: (p: KssParser, axis: KssName, value: KssName) -> bool {
    if KssNameEquals(axis, "theme") {
        if KssNameEquals(value, "light") {
            return p.env.theme == (i32)KssThemeLight
        }
        return p.env.theme == (i32)KssThemeDark
    }
    if KssNameEquals(axis, "contrast") {
        if KssNameEquals(value, "high") {
            return p.env.contrast == (i32)KssContrastHigh
        }
        return p.env.contrast == (i32)KssContrastNormal
    }
    if KssNameEquals(axis, "density") {
        if KssNameEquals(value, "compact") {
            return p.env.density == (i32)KssDensityCompact
        }
        if KssNameEquals(value, "touch") {
            return p.env.density == (i32)KssDensityTouch
        }
        return p.env.density == (i32)KssDensityComfortable
    }
    if KssNameEquals(axis, "pointer") {
        if KssNameEquals(value, "touch") {
            return p.env.pointer == (i32)KssPointerTouch
        }
        if KssNameEquals(value, "mixed") {
            return p.env.pointer == (i32)KssPointerMixed
        }
        return p.env.pointer == (i32)KssPointerMouse
    }
    if KssNameEquals(value, "android") {
        return p.env.platform == (i32)KssPlatformAndroid
    }
    if KssNameEquals(value, "web") {
        return p.env.platform == (i32)KssPlatformWeb
    }
    if KssNameEquals(value, "plan9") {
        return p.env.platform == (i32)KssPlatformPlan9
    }
    if KssNameEquals(value, "terminal") {
        return p.env.platform == (i32)KssPlatformTerminal
    }
    return p.env.platform == (i32)KssPlatformDesktop
}

KssThemeActive :: (p: KssParser, name: KssName) -> bool {
    if KssNameEquals(name, "light") {
        return p.env.theme == (i32)KssThemeLight
    }
    if KssNameEquals(name, "dark") {
        return p.env.theme == (i32)KssThemeDark
    }
    return false
}

# Skip the remainder of a block whose '{' is already consumed. Used for
# non-matching environment overlays.

KssSkipBlockRemainder :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    depth: i32 = 1
    while !KssAtEnd(c) && depth > 0 {
        if c.source[c.pos] == 123 {
            depth = depth + 1
        } else if c.source[c.pos] == 125 {
            depth = depth - 1
        }
        c = KssAdvance(c, 1)
    }
    p.cursor = c
    if depth != 0 {
        return KssFail(p, "unterminated block")
    }
    return p
}

# One 'name: value;' overlay entry. The existing token fixes the value type;
# unknown names and value/type mismatches are errors.

KssOverlayOutcome :: struct {
    parser: KssParser
    matched: bool
}

KssTryOverlayEntry :: (p: KssParser, origin_kind: i32) -> KssOverlayOutcome {
    c: KssCursor = p.cursor
    outcome: KssOverlayOutcome
    name: KssNameResult = KssReadName(c)
    if !name.ok {
        p.cursor = name.parser
        outcome.parser = p
        return outcome
    }
    colon: KssExpectResult = KssExpect(name.parser, 58)
    if !colon.ok {
        p.cursor = colon.parser
        outcome.parser = p
        return outcome
    }
    p.cursor = name.parser
    token_index: i32 = -1
    scan: i32 = p.token_count - 1
    while scan >= 0 {
        if KssNameEqualsName(p.tokens[scan].name, name.name) {
            token_index = scan
        }
        scan = scan - 1
    }
    if token_index < 0 {
        p.cursor = colon.parser
        outcome.parser = p
        return outcome
    }
    kind: i32 = p.tokens[token_index].kind
    if kind == (i32)KssTokenColor {
        value: KssColorResult = KssReadHexColor(colon.parser)
        if !value.ok {
            p.cursor = colon.parser
            outcome.parser = p
            return outcome
        }
        semicolon: KssExpectResult = KssExpect(value.parser, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            outcome.parser = p
            return outcome
        }
        p.cursor = semicolon.parser
        p = KssOverlayToken(p, name.name, kind, value.value,
            0.0, 0, origin_kind)
        if p.status == (i32)KssStatusError {
            outcome.parser = p
            return outcome
        }
        outcome.parser = p
        outcome.matched = true
        return outcome
    }
    if kind == (i32)KssTokenMaterial {
        p.cursor = colon.parser
        value: KssIntResult = KssReadMaterialValue(p)
        if !value.ok {
            outcome.parser = value.parser
            return outcome
        }
        semicolon: KssExpectResult = KssExpect(value.parser.cursor, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            outcome.parser = p
            return outcome
        }
        p.cursor = semicolon.parser
        p = KssOverlayToken(p, name.name, kind, 0, 0.0,
            value.value, origin_kind)
        if p.status == (i32)KssStatusError {
            outcome.parser = p
            return outcome
        }
        outcome.parser = p
        outcome.matched = true
        return outcome
    }
    value: KssNumberResult = KssReadDuration(colon.parser)
    if !value.ok {
        value = KssReadNumber(colon.parser)
    }
    if !value.ok {
        p.cursor = colon.parser
        outcome.parser = p
        return outcome
    }
    semicolon: KssExpectResult = KssExpect(value.parser, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        outcome.parser = p
        return outcome
    }
    p.cursor = semicolon.parser
    p = KssOverlayToken(p, name.name, kind, 0, value.value,
        0, origin_kind)
    if p.status == (i32)KssStatusError {
        outcome.parser = p
        return outcome
    }
    outcome.parser = p
    outcome.matched = true
    return outcome
}

# '@theme name { entry... }': always validated, applied only when active.

KssParseThemeBlock :: (p: KssParser, name: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if p.theme_count >= 16 {
        return KssFail(p, "style theme capacity exceeded")
    }
    p.themes[p.theme_count] = name
    p.theme_count = p.theme_count + 1
    open: KssExpectResult = KssExpect(c, 123)
    if !open.ok {
        p.cursor = open.parser
        return KssFail(p, "expected '{' after @theme name")
    }
    c = open.parser
    p.cursor = c
    active: bool = KssThemeActive(p, name)
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated theme block")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            c = KssAdvance(c, 1)
            p.cursor = c
            running = false
            continue
        }
        if !active {
            return KssSkipBlockRemainder(p)
        }
        entry: KssOverlayOutcome = KssTryOverlayEntry(p, (i32)KssOriginTheme)
        if entry.parser.status == (i32)KssStatusError {
            return entry.parser
        }
        if !entry.matched {
            return KssFail(entry.parser, "expected theme overlay entry")
        }
        p = entry.parser
        c = p.cursor
    }
    return p
}

# '@env axis(value) { rules and token overlays }'. Matching blocks yield each
# rule to the host and resume inside the block on the next step; non-matching
# blocks are validated by shape and skipped.

KssParseEnvBlock :: (p: KssParser, axis: KssName, value: KssName) -> KssParser {
    c: KssCursor = p.cursor
    if !KssEnvValueValid(axis, value) {
        return KssFailName(p, "unknown environment value '", value)
    }
    open: KssExpectResult = KssExpect(c, 123)
    if !open.ok {
        p.cursor = open.parser
        return KssFail(p, "expected '{' after @env query")
    }
    c = open.parser
    p.cursor = c
    if !KssEnvMatches(p, axis, value) {
        return KssSkipBlockRemainder(p)
    }
    p.in_env = true
    return KssContinueEnvBlock(p)
}

KssContinueEnvBlock :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated environment block")
        }
        if c.source[c.pos] == 125 {
            c = KssAdvance(c, 1)
            p.cursor = c
            p.in_env = false
            running = false
            continue
        }
        saved: KssParser = p
        entry: KssOverlayOutcome = KssTryOverlayEntry(p,
            (i32)KssOriginEnvironment)
        if entry.parser.status == (i32)KssStatusError {
            return entry.parser
        }
        if entry.matched {
            p = entry.parser
            c = p.cursor
            continue
        }
        p = KssParseRule(saved)
        if p.status == (i32)KssStatusError {
            return p
        }
        return p
    }
    return p
}


# '@variant name "Label" { token overlays and rules }'. Variants are pack
# options declared in the sheet itself: every declaration is recorded (name
# and label) for host enumeration, and only the variant named by the parse
# environment contributes rules and token overlays. Overlay entries apply
# with the variant origin, above theme and environment.

KssReadVariantLabel :: (c: KssCursor) -> KssNameResult {
    result: KssNameResult
    c = KssSkipSpace(c)
    if KssAtEnd(c) || c.source[c.pos] != 34 {
        result.parser = c
        return result
    }
    c = KssAdvance(c, 1)
    while !KssAtEnd(c) && c.source[c.pos] != 34 {
        result.name = KssNameAppend(result.name, c.source[c.pos])
        c = KssAdvance(c, 1)
    }
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    c = KssAdvance(c, 1)
    result.parser = c
    result.ok = true
    return result
}

KssRecordBlock :: (p: KssParser, kind: i32, start: i32, end_pos: i32) -> KssParser {
    if p.block_count >= 32 {
        return KssFail(p, "style block capacity exceeded")
    }
    p.blocks[p.block_count].kind = kind
    p.blocks[p.block_count].start = start
    p.blocks[p.block_count].length = end_pos - start
    p.block_count = p.block_count + 1
    return p
}

KssSetVariant :: (p: KssParser, name: KssName) -> KssParser #export {
    p.env.variant = name
    return p
}

KssSetTheme :: (p: KssParser, theme: i32) -> KssParser #export {
    p.env.theme = theme
    return p
}

KssVariantActive :: (p: KssParser, name: KssName) -> bool {
    if p.env.variant.length <= 0 {
        return false
    }
    return KssNameEqualsName(p.env.variant, name)
}

KssParseVariantBlock :: (p: KssParser, name: KssName) -> KssParser {
    if p.variant_count >= 8 {
        return KssFail(p, "style variant capacity exceeded")
    }
    p.variants[p.variant_count].name = name
    p.variants[p.variant_count].label = p.variant_label
    p.variant_count = p.variant_count + 1
    open: KssExpectResult = KssExpect(p.cursor, 123)
    if !open.ok {
        p.cursor = open.parser
        return KssFail(p, "expected '{' after @variant name")
    }
    p.cursor = open.parser
    if !KssVariantActive(p, name) {
        return KssSkipBlockRemainder(p)
    }
    p.in_variant = true
    return KssContinueVariantBlock(p)
}

KssContinueVariantBlock :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated variant block")
        }
        if c.source[c.pos] == 125 {
            c = KssAdvance(c, 1)
            p.cursor = c
            p.in_variant = false
            running = false
            continue
        }
        saved: KssParser = p
        entry: KssOverlayOutcome = KssTryOverlayEntry(p,
            (i32)KssOriginVariant)
        if entry.parser.status == (i32)KssStatusError {
            return entry.parser
        }
        if entry.matched {
            p = entry.parser
            c = p.cursor
            continue
        }
        p = KssParseRule(saved)
        if p.status == (i32)KssStatusError {
            return p
        }
        return p
    }
    return p
}

# 'tokens { group { name: value; ... } ... }'

KssParseTokenGroup :: (p: KssParser, origin_kind: i32) -> KssParser {
    c: KssCursor = p.cursor
    group: KssNameResult = KssReadName(c)
    if !group.ok {
        p.cursor = group.parser
        return KssFail(p, "expected token group")
    }
    kind: i32 = -1
    if KssNameEquals(group.name, "color") {
        kind = (i32)KssTokenColor
    } else if KssNameEquals(group.name, "length") ||
        KssNameEquals(group.name, "number") {
        kind = (i32)KssTokenLength
    } else if KssNameEquals(group.name, "duration") {
        kind = (i32)KssTokenDuration
    } else if KssNameEquals(group.name, "material") {
        kind = (i32)KssTokenMaterial
    } else {
        p.cursor = group.parser
        return KssFailName(p, "unknown token group '", group.name)
    }
    open: KssExpectResult = KssExpect(group.parser, 123)
    if !open.ok {
        p.cursor = open.parser
        return KssFail(p, "expected '{' after token group")
    }
    c = open.parser
    p.cursor = c
    running: bool = true
    while running {
        token: KssToken
        token.kind = kind
        token.origin = origin_kind
        token.file = c.file
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated token group")
        }
        if p.cursor.source[p.cursor.pos] == 125 {
            c = KssAdvance(c, 1)
            p.cursor = c
            running = false
            continue
        }
        token.line = p.cursor.line
        token.column = p.cursor.column
        name: KssNameResult = KssReadName(c)
        if !name.ok {
            p.cursor = name.parser
            return KssFail(p, "expected token name")
        }
        token.name = name.name
        colon: KssExpectResult = KssExpect(name.parser, 58)
        if !colon.ok {
            p.cursor = colon.parser
            return KssFail(p, "expected ':' after token name")
        }
        if kind == (i32)KssTokenColor {
            value: KssColorResult = KssReadHexColor(colon.parser)
            if !value.ok {
                p.cursor = value.parser
                return KssFail(p, "expected token color")
            }
            token.color = value.value
            c = value.parser
            p.cursor = c
        } else if kind == (i32)KssTokenMaterial {
            p.cursor = colon.parser
            value: KssIntResult = KssReadMaterialValue(p)
            if !value.ok {
                return value.parser
            }
            token.material = value.value
            c = value.parser.cursor
        } else if kind == (i32)KssTokenDuration {
            value: KssNumberResult = KssReadDuration(colon.parser)
            if !value.ok {
                p.cursor = value.parser
                return KssFail(p, "expected token duration")
            }
            token.number = value.value
            c = value.parser
            p.cursor = c
        } else {
            value: KssNumberResult = KssReadNumber(colon.parser)
            if !value.ok {
                p.cursor = value.parser
                return KssFail(p, "expected token number")
            }
            token.number = value.value
            c = value.parser
            p.cursor = c
        }
        semicolon: KssExpectResult = KssExpect(c, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            return KssFail(p, "expected ';'")
        }
        c = semicolon.parser
        p.cursor = c
        p = KssAddToken(p, token)
        if p.status == (i32)KssStatusError {
            return p
        }
    }
    return p
}

KssParseTokensBlock :: (p: KssParser, origin_kind: i32) -> KssParser {
    c: KssCursor = p.cursor
    open: KssExpectResult = KssExpect(c, 123)
    if !open.ok {
        p.cursor = open.parser
        return KssFail(p, "expected '{' after tokens")
    }
    c = open.parser
    p.cursor = c
    running: bool = true
    while running {
        c = KssSkipSpace(c)
        p.cursor = c
        if KssAtEnd(c) {
            return KssFail(p, "unterminated tokens block")
        }
        if c.source[c.pos] == 125 {
            c = KssAdvance(c, 1)
            p.cursor = c
            running = false
            continue
        }
        p = KssParseTokenGroup(p, origin_kind)
        if p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    }
    return p
}

# Directives: @pack, @version, @layer, @import, @theme, @env.

KssParseLayerName :: (p: KssParser, name: KssName) -> KssParser {
    index: i32 = 0
    while index < p.layer_count {
        if KssNameEqualsName(p.layer_names[index], name) {
            p.layer = index
            return p
        }
        index = index + 1
    }
    if !p.layer_declared {
        if KssNameEquals(name, "reset") || KssNameEquals(name, "base") ||
            KssNameEquals(name, "defaults") {
            p.layer = 0
            return p
        }
        if KssNameEquals(name, "components") || KssNameEquals(name, "widgets") {
            p.layer = 1
            return p
        }
        if KssNameEquals(name, "app") {
            p.layer = 2
            return p
        }
        if KssNameEquals(name, "overrides") {
            p.layer = 3
            return p
        }
    }
    return KssFailName(p, "unknown layer '", name)
}

KssParseLayerDeclaration :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    if p.layer_declared {
        return KssFail(p, "layer order declared twice")
    }
    p.layer_count = 0
    p.layer = 0
    running: bool = true
    while running {
        name: KssNameResult = KssReadName(c)
        if !name.ok {
            p.cursor = name.parser
            return KssFail(p, "expected layer name")
        }
        if p.layer_count >= 12 {
            return KssFail(p, "layer capacity exceeded")
        }
        p.layer_names[p.layer_count] = name.name
        p.layer_count = p.layer_count + 1
        c = name.parser
        p.cursor = c
        c = KssSkipSpace(c)
        p.cursor = c
        if !KssAtEnd(c) && p.cursor.source[p.cursor.pos] == 44 {
            c = KssAdvance(c, 1)
            p.cursor = c
            continue
        }
        running = false
    }
    p.layer_declared = true
    return p
}

KssReadImportTarget :: (p: KssParser) -> KssNameResult {
    result: KssNameResult
    c: KssCursor = KssSkipSpace(p.cursor)
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    if c.source[c.pos] == 60 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && c.source[c.pos] != 62 {
            result.name = KssNameAppend(result.name, c.source[c.pos])
            c = KssAdvance(c, 1)
        }
        if KssAtEnd(c) {
            result.parser = c
            return result
        }
        c = KssAdvance(c, 1)
        result.parser = c
        result.ok = result.name.length > 0
        return result
    }
    if c.source[c.pos] == 34 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && c.source[c.pos] != 34 {
            result.name = KssNameAppend(result.name, c.source[c.pos])
            c = KssAdvance(c, 1)
        }
        if KssAtEnd(c) {
            result.parser = c
            return result
        }
        c = KssAdvance(c, 1)
        result.parser = c
        result.ok = result.name.length > 0
        return result
    }
    result.parser = c
    return result
}

KssParseLayerList :: (p: KssParser, block_start: i32) -> KssParser {
    layer_start: i32 = block_start
    c: KssCursor = KssSkipSpace(p.cursor)
    p.cursor = c
    if KssAtEnd(c) {
        return KssFail(p, "expected layer name")
    }
    first: KssNameResult = KssReadName(c)
    if !first.ok {
        p.cursor = first.parser
        return KssFail(p, "expected layer name")
    }
    c = first.parser
    p.cursor = c
    c = KssSkipSpace(c)
    p.cursor = c
    if !KssAtEnd(c) && p.cursor.source[p.cursor.pos] == 44 {
        c = KssAdvance(c, 1)
        p.cursor = c
        p = KssParseLayerDeclaration(p)
        if p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    } else {
        p = KssParseLayerName(p, first.name)
        if p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    }
    semicolon: KssExpectResult = KssExpect(c, 59)
    if !semicolon.ok {
        p.cursor = semicolon.parser
        return KssFail(p, "expected ';'")
    }
    p.cursor = semicolon.parser
    return KssRecordBlock(p, 5, layer_start, p.cursor.pos)
}

KssParseDirective :: (p: KssParser) -> KssParser {
    c: KssCursor = p.cursor
    directive_start: i32 = p.cursor.pos
    c = KssAdvance(c, 1)
    p.cursor = c
    keyword: KssNameResult = KssReadName(c)
    if !keyword.ok {
        p.cursor = keyword.parser
        return KssFail(p, "expected directive name")
    }

    if KssNameEquals(keyword.name, "pack") {
        value: KssNameResult = KssReadName(keyword.parser)
        if !value.ok {
            p.cursor = value.parser
            return KssFail(p, "expected pack id")
        }
        c = value.parser
        p.cursor = c
        if p.import_depth > 0 {
            c = KssSkipSpace(c)
            p.cursor = c
            if !KssAtEnd(c) && p.cursor.source[p.cursor.pos] == 59 {
                c = KssAdvance(c, 1)
                p.cursor = c
            }
            return p
        }
        p.pack = value.name
        semicolon: KssExpectResult = KssExpect(c, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            return KssFail(p, "expected ';'")
        }
        p.cursor = semicolon.parser
        return KssRecordBlock(p, 5, directive_start, p.cursor.pos)
    }
    if KssNameEquals(keyword.name, "version") {
        value: KssNumberResult = KssReadNumber(keyword.parser)
        if !value.ok {
            p.cursor = value.parser
            return KssFail(p, "expected version number")
        }
        if (i32)value.value != 1 {
            p.cursor = value.parser
            return KssFail(p, "unsupported style sheet version")
        }
        if p.version_seen {
            p.cursor = value.parser
            return KssFail(p, "version declared twice")
        }
        p.version_seen = true
        semicolon: KssExpectResult = KssExpect(value.parser, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            return KssFail(p, "expected ';'")
        }
        p.cursor = semicolon.parser
        return KssRecordBlock(p, 5, directive_start, p.cursor.pos)
    }
    if KssNameEquals(keyword.name, "layer") {
        p.cursor = keyword.parser
        return KssParseLayerList(p, directive_start)
    }
    if KssNameEquals(keyword.name, "import") {
        p.cursor = keyword.parser
        target: KssNameResult = KssReadImportTarget(p)
        if !target.ok {
            p.cursor = target.parser
            return KssFail(p, "expected import target")
        }
        c = target.parser
        p.cursor = c
        semicolon: KssExpectResult = KssExpect(c, 59)
        if !semicolon.ok {
            p.cursor = semicolon.parser
            return KssFail(p, "expected ';'")
        }
        c = semicolon.parser
        p.cursor = c
        p.pending_import = target.name
        p.status = (i32)KssStatusNeedImport
        return p
    }
    if KssNameEquals(keyword.name, "variant") {
        name: KssNameResult = KssReadName(keyword.parser)
        if !name.ok {
            p.cursor = name.parser
            return KssFail(p, "expected variant name")
        }
        label: KssNameResult = KssReadVariantLabel(name.parser)
        if !label.ok {
            p.cursor = label.parser
            return KssFail(p, "expected variant label string")
        }
        p.variant_label = label.name
        p.cursor = label.parser
        p = KssParseVariantBlock(p, name.name)
        if p.status == (i32)KssStatusError {
            return p
        }
        return KssRecordBlock(p, 4, directive_start, p.cursor.pos)
    }
    if KssNameEquals(keyword.name, "theme") {
        value: KssNameResult = KssReadName(keyword.parser)
        if !value.ok {
            p.cursor = value.parser
            return KssFail(p, "expected theme name")
        }
        p.cursor = value.parser
        p = KssParseThemeBlock(p, value.name)
        if p.status == (i32)KssStatusError {
            return p
        }
        return KssRecordBlock(p, 2, directive_start, p.cursor.pos)
    }
    if KssNameEquals(keyword.name, "env") {
        axis: KssNameResult = KssReadName(keyword.parser)
        if !axis.ok {
            p.cursor = axis.parser
            return KssFail(p, "expected environment axis")
        }
        if !KssEnvAxisValid(axis.name) {
            p.cursor = axis.parser
            return KssFailName(p, "unknown environment axis '",
                axis.name)
        }
        open: KssExpectResult = KssExpect(axis.parser, 40)
        if !open.ok {
            p.cursor = open.parser
            return KssFail(p, "expected '(' after @env axis")
        }
        value: KssNameResult = KssReadName(open.parser)
        if !value.ok {
            p.cursor = value.parser
            return KssFail(p, "expected environment value")
        }
        close: KssExpectResult = KssExpect(value.parser, 41)
        if !close.ok {
            p.cursor = close.parser
            return KssFail(p, "expected ')'")
        }
        p.cursor = close.parser
        p = KssParseEnvBlock(p, axis.name, value.name)
        if p.status == (i32)KssStatusError {
            return p
        }
        return KssRecordBlock(p, 3, directive_start, p.cursor.pos)
    }
    if p.declarative {
        if KssIsGroupName(keyword.name) {
            p.cursor = keyword.parser
            return KssParseGroupBlock(p, keyword.name)
        }
        p.cursor = keyword.parser
        return KssCaptureForeign(p, keyword.name)
    }
    p.cursor = keyword.parser
    return KssFailName(p, "unknown directive '@", keyword.name)
}

# Import resolution. The host supplies sources; the parser tracks ordering,
# cycles, and per-file provenance.

KssImportNameOnStack :: (p: KssParser, name: KssName) -> bool {
    index: i32 = 0
    while index < p.import_depth {
        if KssNameEqualsName(p.imports[index].name, name) {
            return true
        }
        index = index + 1
    }
    return false
}

KssProvideImport :: (p: KssParser, source: string, name: string) -> KssParser #export {
    import_name: KssName = KssMakeName(name)
    if KssImportNameOnStack(p, import_name) {
        return KssFailName(p, "@import cycle: ", import_name)
    }
    if p.import_depth >= 8 || p.file_count >= 8 {
        return KssFail(p, "style import depth exceeded")
    }
    p.imports[p.import_depth].name = import_name
    p.imports[p.import_depth].outer_source = p.cursor.source
    p.imports[p.import_depth].outer_pos = p.cursor.pos
    p.imports[p.import_depth].outer_line = p.cursor.line
    p.imports[p.import_depth].outer_column = p.cursor.column
    p.imports[p.import_depth].outer_file = p.cursor.file
    p.import_depth = p.import_depth + 1
    p.files[p.file_count] = KssCopyFileName(name)
    p.cursor.file = p.file_count
    p.file_count = p.file_count + 1
    p.cursor.source = source
    p.cursor.pos = 0
    p.cursor.line = 1
    p.cursor.column = 1
    p.status = (i32)KssStatusContinue
    return p
}

KssFailImport :: (p: KssParser) -> KssParser #export {
    return KssFailName(p, "missing import: ", p.pending_import)
}

KssPopImport :: (p: KssParser) -> KssParser {
    if p.import_depth <= 0 {
        return p
    }
    p.import_depth = p.import_depth - 1
    p.cursor.source = p.imports[p.import_depth].outer_source
    p.cursor.pos = p.imports[p.import_depth].outer_pos
    p.cursor.line = p.imports[p.import_depth].outer_line
    p.cursor.column = p.imports[p.import_depth].outer_column
    p.cursor.file = p.imports[p.import_depth].outer_file
    return p
}

# One parse step. Statuses: Rule (collect p.rule), NeedImport (feed via
# KssProvideImport/KssFailImport), Done, Error (read p.diagnostic).

KssStep :: (p: KssParser) -> KssParser #export {
    c: KssCursor = p.cursor
    if p.status == (i32)KssStatusError || p.status == (i32)KssStatusDone {
        return p
    }
    if p.resume_group >= 0 {
        p.status = (i32)KssStatusContinue
        p = KssContinueGroupBlock(p)
        if p.status == (i32)KssStatusRule ||
           p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    }
    if p.in_env {
        p.status = (i32)KssStatusContinue
        p = KssContinueEnvBlock(p)
        if p.status == (i32)KssStatusRule ||
           p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    }
    if p.in_variant {
        p.status = (i32)KssStatusContinue
        p = KssContinueVariantBlock(p)
        if p.status == (i32)KssStatusRule ||
           p.status == (i32)KssStatusError {
            return p
        }
        c = p.cursor
    }
    c = KssSkipSpace(c)
    p.cursor = c
    if KssAtEnd(c) {
        if p.import_depth > 0 {
            p = KssPopImport(p)
            p.status = (i32)KssStatusContinue
            return p
        }
        p.status = (i32)KssStatusDone
        return p
    }
    if p.cursor.source[p.cursor.pos] == 64 {
        p = KssParseDirective(p)
        if p.status == (i32)KssStatusNeedImport ||
           p.status == (i32)KssStatusError ||
           p.status == (i32)KssStatusRule {
            return p
        }
        p.status = (i32)KssStatusContinue
        return p
    }
    tokens_start: i32 = c.pos
    probe: KssNameResult = KssReadName(c)
    if probe.ok && KssNameEquals(probe.name, "tokens") {
        p.cursor = probe.parser
        p = KssParseTokensBlock(p, (i32)KssOriginPack)
        if p.status == (i32)KssStatusError {
            return p
        }
        return KssRecordBlock(p, 1, tokens_start, p.cursor.pos)
    }
    return KssParseRule(p)
}

# CSS export values use the shared KSS vocabulary and numeric/token grammar.
# Native-only StyleData consumers retain their closed set of fields; CSS-only
# properties stay opaque after classification instead of becoming native fields.

KssCSSValueKind :: enum {
    KssCSSLiteral = 0
    KssCSSNumber = 1
    KssCSSColor = 2
    KssCSSMaterial = 3
}

KssCSSValue :: struct {
    valid: bool
    kind: i32
    number: f64
    color: u32
    material: i32
    text: string
    has_token: bool
    token_name: KssName
    token_origin: i32
}

KssCSSPropertyKind :: (name: KssName) -> i32 #export {
    if name.length > 2 && name.bytes[0] == 45 && name.bytes[1] == 45 {
        return -2
    }
    if KssNameEquals(name, "background") ||
        KssNameEquals(name, "foreground") ||
        KssNameEquals(name, "border") ||
        KssNameEquals(name, "focus") ||
        KssNameEquals(name, "background-end") ||
        KssNameEquals(name, "color") ||
        KssNameEquals(name, "background-color") ||
        KssNameEquals(name, "accent-color") {
        return 0
    }
    if KssNameEquals(name, "caret-color") ||
        KssNameEquals(name, "border-color") ||
        KssNameEquals(name, "border-top-color") ||
        KssNameEquals(name, "border-right-color") ||
        KssNameEquals(name, "border-bottom-color") ||
        KssNameEquals(name, "border-left-color") ||
        KssNameEquals(name, "border-inline-color") ||
        KssNameEquals(name, "border-block-color") {
        return 0
    }
    if KssNameEquals(name, "border-inline-start-color") ||
        KssNameEquals(name, "border-inline-end-color") ||
        KssNameEquals(name, "border-block-start-color") ||
        KssNameEquals(name, "border-block-end-color") ||
        KssNameEquals(name, "outline-color") ||
        KssNameEquals(name, "text-decoration-color") ||
        KssNameEquals(name, "text-emphasis-color") ||
        KssNameEquals(name, "column-rule-color") {
        return 0
    }
    if KssNameEquals(name, "radius") ||
        KssNameEquals(name, "border-radius") ||
        KssNameEquals(name, "border-width") ||
        KssNameEquals(name, "opacity") ||
        KssNameEquals(name, "border-top-width") ||
        KssNameEquals(name, "border-right-width") ||
        KssNameEquals(name, "border-bottom-width") ||
        KssNameEquals(name, "border-left-width") {
        return 1
    }
    if KssNameEquals(name, "border-inline-width") ||
        KssNameEquals(name, "border-block-width") ||
        KssNameEquals(name, "border-inline-start-width") ||
        KssNameEquals(name, "border-inline-end-width") ||
        KssNameEquals(name, "border-block-start-width") ||
        KssNameEquals(name, "border-block-end-width") ||
        KssNameEquals(name, "border-top-left-radius") ||
        KssNameEquals(name, "border-top-right-radius") {
