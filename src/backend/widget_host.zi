using HostValueKind;

// Decides which asset paths a bundle may draw. Runtime texture handles
// belong to the renderer and are always refused.
WidgetAssetAllowed :: #type (path: string) -> bool;
// Resolves an allowed packed path into the current app's renderer namespace.
// Returned text must remain valid until the host has painted the frame.
// An empty result is an allowed image the host does not have yet, such as
// art still downloading: it draws as loading and resolves again next frame.
WidgetAssetResolve :: #type (path: string) -> string;

WIDGET_HOST_TAB_LIMIT :: 32
WIDGET_HOST_OPTION_LIMIT :: 32
// Scrolls and dialog panels a bundle may hold open at once.
WIDGET_HOST_SCOPE_DEPTH :: 16

