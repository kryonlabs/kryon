#import "kryon/daylight"
#import "kryon/shader"
#import "kryon/scene"
#import "kryon/scene_render"
#import "std/image"
#import "std/vec"
#import "std/math"

Check :: (ok: bool, text: string) -> s32 { if ok { return 0 }; print("daylight: %\n", text); return 1 }
Channel :: (image: *Image, x: s32, y: s32, channel: s32) -> s32 { return cast(s32)image.pixels[(cast(s64)y * image.width + x) * 4 + channel] }
Brightness :: (image: *Image, x: s32, y: s32) -> s32 { return Channel(image, x, y, 0) + Channel(image, x, y, 1) + Channel(image, x, y, 2) }

Camera :: () -> SceneCamera {
    c := OrthographicCamera(-1.0, 1.0, 1.0, -1.0, 0.1, 10.0)
    c.position = .{0.0, 0.0, 3.0}
    c.target = .{0.0, 0.0, 0.0}
    return c
}

// The hour decides the sun, the sky and the room's grade.
Hours :: () -> s32 {
    fail: s32
    // Before anything is rendered, as on a GPU-only host: colours already convert.
    first := PrepareGrade(DaylightGrade(DaylightAt(0.0)))
    fail += Check(first.on && first.tint.z > 0.1 && first.tint.x > 0.05, "a grade prepared before any render keeps its colours")
    noon := DaylightAt(12.0)
    fail += Check(noon.tint.r == 255 && noon.tint.g == 255 && noon.tint.b == 255 && noon.saturation == 1.0, "noon grade is exactly neutral")
    fail += Check(noon.beam == 0.0 && noon.lamps == 0.0 && noon.stars == 0.0, "noon has no beam, lamps or stars")
    fail += Check(noon.height > 0.85 && noon.sun.y > 0.0, "the sun is high at noon")
    night := DaylightAt(0.0)
    fail += Check(night.lamps > 0.95 && night.stars > 0.95 && night.day < 0.05, "midnight has lamps and stars")
    fail += Check(night.tint.b > night.tint.r && night.tint.r < 128, "night tint is dark blue")
    fail += Check(DaylightAt(7.0).sun.x < 0.0 && DaylightAt(17.0).sun.x > 0.0, "the sun rises on -x and sets on +x")
    fail += Check(DaylightAt(18.0).golden > 0.3 && DaylightAt(6.0).golden > 0.3, "sunrise and sunset are golden")
    fail += Check(DaylightAt(8.0).beam > 0.3 && DaylightAt(16.0).beam > 0.3, "the low sun shines in through windows")
    fail += Check(DaylightAt(36.0).hour == 12.0 && DaylightAt(-6.0).hour == 18.0, "hours wrap")
    fail += Check(night.moon.y > 0.0 && night.moonlight > 0.5 && noon.moonlight == 0.0, "the moon is up at night")
    window: Vector3 = .{0.0, 1.5, -2.0}
    morning := DaylightBeam(DaylightAt(8.0), window, .{0.5, 0.0, 0.0}, .{0.0, 0.5, 0.0})
    fail += Check(morning.strength > 0.2 && morning.direction.y > 0.0 && morning.color.r > morning.color.b, "a warm morning sunbeam")
    moonbeam := DaylightBeam(night, window, .{0.5, 0.0, 0.0}, .{0.0, 0.5, 0.0})
    fail += Check(moonbeam.strength > 0.2 && moonbeam.color.b > moonbeam.color.r, "cool moonlight at night")
    fail += Check(DaylightBeam(noon, window, .{0.5, 0.0, 0.0}, .{0.0, 0.5, 0.0}).strength == 0.0, "no beam at noon")
    fail += Check(DaylightLamp(noon, window, 1.0, .{255, 200, 140, 255}).strength == 0.0 && DaylightLamp(night, window, 1.0, .{255, 200, 140, 255}).strength > 1.0, "lamps glow at night only")
    g := DaylightGrade(night)
    fail += Check(g.enabled && g.tint.b == night.tint.b && g.saturation == night.saturation, "grade follows the hour")
    return fail
}

RenderSky :: (sky: *DaylightSky, hour: float64, seconds: float64, image: *Image) -> bool {
    scene: Scene
    SceneInit(*scene)
    defer SceneFree(*scene)
    DaylightSkyUpdate(sky, DaylightAt(hour), seconds, 1.0, 0.1)
    unused Plane(*scene, 2.0, 2.0, DaylightSkyMaterial(*sky.program, sky.uniforms[:], sky.samplers[:]))
    return RenderScene(*scene, Camera(), image)
}

Differs :: (a: *Image, b: *Image) -> bool {
    for at: 0..a.pixels.count - 1 { if a.pixels[at] != b.pixels[at] { return true } }
    return false
}

Sky :: () -> s32 {
    fail: s32
    sky: DaylightSky
    fail += Check(DaylightSkyInit(*sky), "sky program compiles")
    if fail > 0 { return fail }
    defer DaylightSkyFree(*sky)
    fail += Check(sky.program.count <= SHADER_INSTRUCTIONS && sky.program.sampler_count == 1, "sky fits one program")
    day := NewImage(48, 32); defer VecFree(day.pixels)
    later := NewImage(48, 32); defer VecFree(later.pixels)
    night := NewImage(48, 32); defer VecFree(night.pixels)
    fail += Check(RenderSky(*sky, 12.0, 0.0, *day), "render the noon sky")
    fail += Check(RenderSky(*sky, 12.0, 90.0, *later), "render the noon sky later")
    fail += Check(RenderSky(*sky, 0.5, 0.0, *night), "render the night sky")
    fail += Check(Channel(*day, 24, 31, 2) > Channel(*day, 24, 31, 0), "the noon sky is blue at the horizon")
    fail += Check(Channel(*day, 2, 1, 2) > Channel(*day, 2, 1, 0) + 40, "the noon sky is deep blue overhead")
    fail += Check(Channel(*day, 2, 1, 3) == 255, "the sky is opaque")
    fail += Check(Brightness(*night, 2, 1) * 4 < Brightness(*day, 2, 1), "the night sky is dark")
    fail += Check(Differs(*day, *later), "clouds drift with the seconds")
    sunset := NewImage(48, 32); defer VecFree(sunset.pixels)
    fail += Check(RenderSky(*sky, 18.0, 0.0, *sunset), "render the sunset sky")
    fail += Check(Channel(*sunset, 24, 30, 0) > Channel(*sunset, 24, 30, 2), "the sunset horizon is warm")
    return fail
}

// A grey wall facing the camera with the given grade, sampled at three points.
GradeScene :: (grade: SceneGrade, ungraded: bool, image: *Image) -> bool {
    scene: Scene
    SceneInit(*scene)
    defer SceneFree(*scene)
    m := UnlitMaterial(.{150, 150, 150, 255})
    m.exact_color = true
    m.ungraded = ungraded
    unused Plane(*scene, 2.0, 2.0, m)
    scene.grade = grade
    return RenderScene(*scene, Camera(), image)
}

Grade :: () -> s32 {
    fail: s32
    plain := NewImage(32, 32); defer VecFree(plain.pixels)
    image := NewImage(32, 32); defer VecFree(image.pixels)
    fail += Check(GradeScene(.{}, false, *plain), "render without a grade")
    fail += Check(GradeScene(SceneGradeNeutral(), false, *image) && !Differs(*plain, *image), "a neutral grade changes nothing")
    dusk := SceneGradeNeutral()
    dusk.tint = .{120, 120, 160, 255}
    fail += Check(GradeScene(dusk, false, *image), "render a tinted grade")
    fail += Check(Channel(*image, 16, 16, 0) < Channel(*plain, 16, 16, 0) && Channel(*image, 16, 16, 2) > Channel(*image, 16, 16, 0), "the tint darkens and cools")
    fail += Check(GradeScene(dusk, true, *image) && !Differs(*plain, *image), "an ungraded material keeps its colour")
    grey := SceneGradeNeutral()
    grey.saturation = 0.0
    fail += Check(GradeScene(grey, false, *image) && !Differs(*plain, *image), "a grey wall is unchanged by saturation")
    lamp := dusk
    lamp.lamps[0] = .{position = .{0.6, 0.6, 0.2}, radius = 0.3, color = .{255, 200, 140, 255}, strength = 1.5}
    fail += Check(GradeScene(lamp, false, *image), "render a lamp")
    near := Brightness(*image, 25, 6)
    far := Brightness(*image, 6, 25)
    fail += Check(near > far + 60, "the lamp lights the wall around it")
    fail += Check(Channel(*image, 25, 6, 0) > Channel(*image, 25, 6, 2), "lamp light is warm")
    beam := dusk
    beam.beam = .{centre = .{-0.4, 0.0, 1.0}, axis_u = .{0.3, 0.0, 0.0}, axis_v = .{0.0, 0.3, 0.0},
        direction = .{0.0, 0.0, 1.0}, color = .{255, 230, 190, 255}, strength = 1.0, softness = 0.2}
    fail += Check(GradeScene(beam, false, *image), "render a beam")
    inside := Brightness(*image, 9, 16)
    outside := Brightness(*image, 24, 16)
    fail += Check(inside > outside + 60, "the beam lights only what it passes through the opening")
    behind := beam
    behind.beam.centre = .{-0.4, 0.0, -1.0}
    fail += Check(GradeScene(behind, false, *image) && Brightness(*image, 9, 16) == outside, "an opening behind the wall casts nothing on it")
    return fail
}

main :: () -> s32 {
    fail := Hours() + Sky() + Grade()
    RenderSceneRelease()
    if fail == 0 { print("Daylight hours, sky and scene grade passed\n") }
    return fail
}
