#module "page_props"
#import "drawing_props"
#import "geometry"

PageProps :: struct {
    bounds: Rectangle
    title: string
    description: string
    canonical_url: string
    class_name: i32
    key: u64
}

SectionProps :: struct {
    bounds: Rectangle
    label: string
    class_name: i32
    key: u64
}

PageSpacing :: struct {
    gap: i32
    padding: i32
}

# Page metadata is an effect request. The platform may apply it to a browser
# document, desktop window, exported document, or ignore it entirely.
PageResult :: struct {
    node: i32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: i32
    padding: i32
    title: string
    description: string
    canonical_url: string
    theme_color: Color
    has_theme_color: bool
}

SectionResult :: struct {
    node: i32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: i32
    padding: i32
}
