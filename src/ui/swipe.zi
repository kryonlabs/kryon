#module "swipe"
#import "swipe_props"
#import "geometry"

SwipeDragState :: struct {
    dragging: bool
    cancelled: bool
    direction: SwipeDirection
    progress: float
}

SwipeReleaseState :: struct {
    direction: SwipeDirection
    progress: float
    committed: bool
}

SwipeDragLifecycle :: struct {
    cancel_active: bool
    claim_pointer_owner: bool
    capture_input: bool
    dragging: bool
}

SwipeReleaseLifecycle :: struct {
    consume_release: bool
    capture_input: bool
}

SwipeAbs :: (value: float) -> float #export {
    if value < 0.0 { return -value }
    return value
}

SwipeDirectionsFor :: (directions: u32) -> u32 #export {
    if directions != (u32)0 { return directions }
    return (u32)SwipeAll
}

SwipeMinDistanceFor :: (scale: float, min_distance: float) -> float #export {
    if min_distance > 0.0 { return min_distance }
    return 48.0 * scale
}

SwipeAxisBiasFor :: (axis_bias: float) -> float #export {
    if axis_bias >= 1.0 { return axis_bias }
    return 1.25
}

SwipeDecisionDistanceFor :: (scale: float) -> float #export {
    return 8.0 * scale
}

SwipeCanBegin :: (bounds: Rectangle, pointer_inside: bool, input_clear: bool) -> bool #export {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return false }
    if !pointer_inside { return false }
    return input_clear
}

SwipeDirectionFor :: (delta: Vector2, directions: u32,
    axis_bias: float) -> SwipeDirection #export {
    dx: float = SwipeAbs(delta.x)
    dy: float = SwipeAbs(delta.y)
    direction: SwipeDirection = (SwipeDirection)SwipeNone

    if dx >= dy * axis_bias {
        if delta.x < 0.0 {
            direction = (SwipeDirection)SwipeLeft
        } else {
            direction = (SwipeDirection)SwipeRight
        }
    } else if dy >= dx * axis_bias {
        if delta.y < 0.0 {
            direction = (SwipeDirection)SwipeUp
        } else {
            direction = (SwipeDirection)SwipeDown
        }
    } else {
        return (SwipeDirection)SwipeNone
    }

    if (directions & (u32)direction) != (u32)0 {
        return direction
    }
    return (SwipeDirection)SwipeNone
}

SwipePrimaryDistanceFor :: (delta: Vector2, direction: SwipeDirection) -> float #export {
    if direction == (SwipeDirection)SwipeLeft ||
       direction == (SwipeDirection)SwipeRight {
        return SwipeAbs(delta.x)
    }
    return SwipeAbs(delta.y)
}

SwipeMaxDistanceFor :: (delta: Vector2) -> float #export {
    dx: float = SwipeAbs(delta.x)
    dy: float = SwipeAbs(delta.y)
    if dx > dy { return dx }
    return dy
}

SwipeProgressFor :: (primary: float, min_distance: float) -> float #export {
    if min_distance <= 0.0 { return 0.0 }
    progress: float = primary / min_distance
    if progress > 1.0 { return 1.0 }
    if progress < 0.0 { return 0.0 }
    return progress
}

SwipeShouldCancelForAxis :: (delta: Vector2, directions: u32,
    axis_bias: float) -> bool #export {
    dx: float = SwipeAbs(delta.x)
    dy: float = SwipeAbs(delta.y)
    horizontal_allowed: bool = (directions & (u32)SwipeHorizontal) != (u32)0
    vertical_allowed: bool = (directions & (u32)SwipeVertical) != (u32)0

    if horizontal_allowed && !vertical_allowed && dy >= dx * axis_bias {
        return true
    }
    if vertical_allowed && !horizontal_allowed && dx >= dy * axis_bias {
        return true
    }
    return false
}

SwipeDragStateFor :: (delta: Vector2, directions: u32, axis_bias: float,
    decision_distance: float, min_distance: float,
    was_dragging: bool) -> SwipeDragState #export {
    state: SwipeDragState
    state.dragging = was_dragging
    direction: SwipeDirection = SwipeDirectionFor(delta, directions, axis_bias)
    primary: float = SwipePrimaryDistanceFor(delta, direction)
    distance: float = SwipeMaxDistanceFor(delta)

    if !state.dragging && distance >= decision_distance {
        if direction == (SwipeDirection)SwipeNone {
            state.cancelled = SwipeShouldCancelForAxis(delta, directions,
                axis_bias)
            return state
        }
        state.dragging = true
    }

    state.direction = direction
    if state.dragging {
        state.progress = SwipeProgressFor(primary, min_distance)
    }
    return state
}

SwipeDragLifecycleFor :: (pointer_owner_clear: bool, drag_cancelled: bool,
    was_dragging: bool, next_dragging: bool) -> SwipeDragLifecycle #export {
    lifecycle: SwipeDragLifecycle
    if !pointer_owner_clear || drag_cancelled {
        lifecycle.cancel_active = true
        return lifecycle
    }
    lifecycle.dragging = next_dragging
    lifecycle.claim_pointer_owner = !was_dragging && next_dragging
    lifecycle.capture_input = next_dragging
    return lifecycle
}

SwipeReleaseStateFor :: (delta: Vector2, directions: u32, axis_bias: float,
    min_distance: float, elapsed: f64, max_duration: float,
    was_dragging: bool) -> SwipeReleaseState #export {
    state: SwipeReleaseState
    state.direction = SwipeDirectionFor(delta, directions, axis_bias)
    primary: float = SwipePrimaryDistanceFor(delta, state.direction)
    within_time: bool = max_duration <= 0.0 ||
        elapsed <= (f64)max_duration

    state.progress = SwipeProgressFor(primary, min_distance)
    state.committed = was_dragging && within_time && primary >= min_distance
    if !state.committed {
        state.direction = (SwipeDirection)SwipeNone
    }
    return state
}

SwipeReleaseLifecycleFor :: (was_dragging: bool) -> SwipeReleaseLifecycle #export {
    lifecycle: SwipeReleaseLifecycle
    lifecycle.consume_release = was_dragging
    lifecycle.capture_input = was_dragging
    return lifecycle
}

SwipeInside :: (bounds: Rectangle, point: Vector2) -> bool {
    return point.x >= bounds.x && point.y >= bounds.y &&
        point.x <= bounds.x + bounds.width &&
        point.y <= bounds.y + bounds.height
}

# The host supplies pointer observations and applies the returned ownership
# effects. The caller stores result.gesture for the next frame.
Swipe :: (spec: SwipeSpec, gesture: SwipeGesture,
    frame: SwipeFrame) -> SwipeResult #export {
    result: SwipeResult
    result.gesture = gesture
    if spec.bounds.width <= 0.0 || spec.bounds.height <= 0.0 {
        result.release_pointer = frame.owner_is_swipe
        result.gesture = (SwipeGesture){}
        return result
    }
    scale: float = frame.scale
    if scale <= 0.0 { scale = 1.0 }
    directions: u32 = SwipeDirectionsFor(spec.directions)
    min_distance: float = SwipeMinDistanceFor(scale, spec.min_distance)
    axis_bias: float = SwipeAxisBiasFor(spec.axis_bias)
    decision_distance: float = SwipeDecisionDistanceFor(scale)

    if frame.pressed {
        result.release_pointer = frame.owner_is_swipe
        gesture = (SwipeGesture){}
        if SwipeCanBegin(spec.bounds,
            SwipeInside(spec.bounds, frame.pointer),
            frame.input_clear &&
                (frame.owner_clear || frame.owner_is_swipe)) {
            gesture.active = 1
            gesture.start = frame.pointer
            gesture.started_at = frame.now_seconds
        }
    }
    if gesture.active == 0 {
        result.cancelled = gesture.cancelled
        result.gesture = gesture
        return result
    }

    delta: Vector2
    delta.x = frame.pointer.x - gesture.start.x
    delta.y = frame.pointer.y - gesture.start.y
    result.delta = delta
    result.active = 1
    if frame.down {
        drag: SwipeDragState = SwipeDragStateFor(delta, directions,
            axis_bias, decision_distance, min_distance,
            gesture.dragging != 0)
        lifecycle: SwipeDragLifecycle = SwipeDragLifecycleFor(
            frame.owner_clear || frame.owner_is_swipe,
            drag.cancelled, gesture.dragging != 0, drag.dragging)
        if lifecycle.cancel_active {
            gesture.active = 0
            gesture.dragging = 0
            gesture.cancelled = 1
            result.active = 0
            result.cancelled = 1
            result.release_pointer = frame.owner_is_swipe
            result.gesture = gesture
            return result
        }
        if lifecycle.claim_pointer_owner { gesture.dragging = 1 }
        result.claim_pointer = lifecycle.claim_pointer_owner ||
            (lifecycle.dragging && frame.owner_clear &&
                !frame.owner_is_swipe)
        result.capture_input = lifecycle.capture_input
        result.dragging = 0
        if lifecycle.dragging { result.dragging = 1 }
        result.progress = drag.progress
        result.gesture = gesture
        return result
    }
    if frame.released {
        if gesture.dragging != 0 && !frame.owner_clear &&
            !frame.owner_is_swipe {
            result.active = 0
            result.cancelled = 1
            result.gesture = (SwipeGesture){}
            return result
        }
        release: SwipeReleaseState = SwipeReleaseStateFor(delta,
            directions, axis_bias, min_distance,
            frame.now_seconds - gesture.started_at,
            spec.max_duration, gesture.dragging != 0)
        lifecycle: SwipeReleaseLifecycle =
            SwipeReleaseLifecycleFor(gesture.dragging != 0)
        result.direction = release.direction
        result.progress = release.progress
        result.active = 0
        result.consume_release = lifecycle.consume_release
        result.capture_input = lifecycle.capture_input
        result.release_pointer = frame.owner_is_swipe
        result.gesture = (SwipeGesture){}
        return result
    }
    result.active = 0
    result.release_pointer = frame.owner_is_swipe
    result.gesture = (SwipeGesture){}
    return result
}
