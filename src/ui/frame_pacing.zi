host_api :: #system_library "host_api";

FramePacing :: struct {
    enabled: bool
    active: bool
    idle_fps: s32
    active_fps: s32
    target_fps: s32
}

FramePacingDecision :: struct {
    state: FramePacing
    apply_target: bool
}

# The platform host owns the timer; Kryon decides when its target changes.
ApplyTargetFPS :: (fps: s32) #foreign host_api;

#program_export
CommitFramePacing :: (decision: FramePacingDecision) -> FramePacing {
    if decision.apply_target {
        ApplyTargetFPS(decision.state.target_fps)
    }
    return decision.state
}

FramePacingSanitizeFPS :: (fps: s32) -> s32 {
    if fps > 0 { return fps }
    return 0
}

# The host applies target_fps only when apply_target is true.
#program_export
UpdateFramePacing :: (state: FramePacing) -> FramePacingDecision {
    decision: FramePacingDecision
    decision.state = state
    if !state.enabled { return decision }
    target: s32 = state.idle_fps
    if state.active { target = state.active_fps }
    if target <= 0 {
        target = state.active_fps
        if state.active { target = state.idle_fps }
    }
    if target != state.target_fps {
        decision.state.target_fps = target
        decision.apply_target = true
    }
    return decision
}

#program_export
ConfigureFramePacing :: (state: FramePacing, idle_fps: s32,
    active_fps: s32) -> FramePacingDecision {
    state.idle_fps = FramePacingSanitizeFPS(idle_fps)
    state.active_fps = FramePacingSanitizeFPS(active_fps)
    state.enabled = state.idle_fps > 0 || state.active_fps > 0
    state.target_fps = 0
    return UpdateFramePacing(state)
}

#program_export
DisableFramePacing :: (state: FramePacing) -> FramePacingDecision {
    decision: FramePacingDecision
    decision.apply_target = state.target_fps != 0
    return decision
}

#program_export
SetFramePacingActive :: (state: FramePacing,
    active: bool) -> FramePacing {
    state.active = active
    return state
}
