#import "kryon.h"

app "Widget Catalog Coverage" {
    size 800 600
    fps 60
    font examples
}

state {
    pick: int = 0
    pick_color: [4] float = {0.2f,0.4f,0.6f,1.0f}
    open: bool = true
    slider_value: int = 42
    slider_values: [1] int = {42}
    toggle_value: int = 0
    checkbox_value: int = 1
    text_cursor: int = 5
    area_cursor: int = 4
    area_scroll: int = 0
    list_scroll: int = 0
    tree_selected: int = 1
    table_selected_row: int = 0
    table_selected_column: int = 0
    table_activated_row: int = -1
    table_activated_column: int = -1
    table_right_row: int = -1
    table_right_column: int = -1
    canvas_scroll_x: int = 0
    canvas_scroll_y: int = 0
    canvas_zoom: float = 1.0f
    text_value: [64] char = "Hello"
    area_value: [128] char = "Notes"
    choices: [3] const char * = {"Alpha","Beta","Gamma"}
    columns: [2] const char * = {"Name","Value"}
    cells_a: [2] const char * = {"Alpha","1"}
    cells_b: [2] const char * = {"Beta","2"}
    rows: [2] TableRow = {{cells_a,2},{cells_b,2}}
    widths: [2] int = {120,80}
    tree_items: [2] TreeItem = {{"Root",0,1,1,1},{"Child",1,2,0,1}}
    tabs: [2] const Tab = {{"One"},{"Two"}}
}

WidgetCatalog :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())

        TitleBar((TitleBarProps){.title = "Widget Catalog", .height = Scale(32)})
        Toolbar((ToolbarProps){.id = 10, .x = 0, .y = Scale(34), .width = Scale(360), .height = Scale(36), .draw_menu = 1, .options = choices[:], .option_count = 3, .selected_index = &pick})
        Toolbar((ToolbarProps){.id = 11, .x = Scale(370), .y = Scale(34), .width = Scale(240), .height = Scale(36), .draw_menu = 1, .options = choices[:], .option_count = 3, .selected_index = &pick})
        NavigationBar((NavigationBarProps){.view_width = Scale(640), .view_height = Scale(480), .count = 0, .height = Scale(56), .icon_color = GetThemeText()})

        Column main_column: {
            bounds = {Scale(24), Scale(86), Scale(300), Scale(220)}
            gap = Scale(6)
            padding = Scale(8)
            Text((TextProps){.bounds={0, 0, 0, 0}, .text="Column text", .color=GetThemeText(), .wrap=TextWrapNone})
            Row action_row: {
                bounds = {0, 0, Scale(280), Scale(40)}
                gap = Scale(6)
                Button((ButtonProps){.bounds = {Scale(32), Scale(128), Scale(96), Scale(32)}, .label = "Button",  .font = Text16, .id = 20})
                Button((ButtonProps){.bounds = {Scale(136), Scale(128), Scale(32), Scale(32)}, .icon_type = 1, .icon_only = true, .id = 21})
                Link((LinkProps){.bounds = {Scale(176), Scale(130), Scale(80), Scale(28)}, .text = "Docs", .link = "https://kryonlabs.com", .font = Text16, .focus_id = 22, .color = GetThemeLink(), .hover_color = GetThemeLink()})
            }
            Stack surface_stack: {
                bounds = {Scale(32), Scale(170), Scale(230), Scale(60)}
                key = Key("catalog-stack")
                Rect(Scale(32), Scale(170), Scale(230), Scale(60), GetThemeSurface(), GetThemeButton())
                Line(Scale(32), Scale(170), Scale(262), Scale(230), GetThemeIcon())
                Bevel(Scale(44), Scale(184), Scale(60), Scale(24), GetThemeSurface(), GetThemeButton())
            }
        }

        y: int = Scale(320)
        Text((TextProps){.bounds=(Rectangle){Scale(24), y, Scale(120), Scale(24)}, .text="Text", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone, .align=TextAlignCenter, .vertical_align=TextAlignCenter})
        Text((TextProps){.bounds={Scale(24), y, 0, 0}, .text="one", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(24), y + Scale(18), 0, 0}, .text="two", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(24), y + Scale(36), 0, 0}, .text="three", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        y += Scale(54)
        Paragraph((ParagraphSpec){.text = "Paragraph", .icon_type = 1, .icon_size = Scale(16), .width = Scale(180), .font = Text16, .line_gap = Scale(4), .color = GetThemeText(), .align = TextAlignCenter}, Scale(24), &y)
        SelectableText("Selectable", Scale(24), y + Scale(18), Text16, GetThemeText())
        ShowToast("Catalog toast")

        TextField((TextFieldProps){.bounds = {Scale(350), Scale(92), Scale(160), Scale(28)}, .text = text_value, .text_size = sizeof(text_value), .cursor_position = &text_cursor, .focused = NULL, .max_codepoints = 63, .font = Text16, .focus_id = 30})
        TextArea((TextAreaProps){.bounds = {Scale(350), Scale(128), Scale(180), Scale(58)}, .text = area_value, .text_size = sizeof(area_value), .cursor_position = &area_cursor, .focused = NULL, .scroll_y = &area_scroll, .max_codepoints = 127, .font = Text16, .line_gap = Scale(4), .focus_id = 31, .placeholder = "Notes", .syntax = SyntaxNone})
        Dropdown((DropdownProps){.bounds = {Scale(350), Scale(198), Scale(160), Scale(28)}, .id = 32,
            .options = choices[:], .option_count = 3, .selected_index = &pick})
        Slider((SliderProps){.bounds = {Scale(350), Scale(238), Scale(160), Scale(56)}, .id = 33, .label = "Slider", .kind = 1, .int_values = slider_values, .value_count = 1, .min = 0.0, .max = 100.0, .format = "%"})
        slider_value = slider_values[0]
        Toggle((ToggleProps){.bounds = {Scale(350), Scale(274), Scale(120), Scale(34)}, .id = 34, .value = &toggle_value, .off_label = "Off", .on_label = "On"})
        Checkbox((CheckboxProps){.bounds = {Scale(350), Scale(314), Scale(110), Scale(34)}, .id = 35, .label = "Check", .value = &checkbox_value})
        Radio((RadioProps){.bounds = {Scale(350), Scale(350), Scale(120), Scale(24)}, .label = "Radio", .id = 1, .checked = pick == 1})
        Spinbox((SpinboxProps){{Scale(350), Scale(382), Scale(120), Scale(28)}, 36, 0, 100, 1, &slider_value, 0, ""})
        Dropdown((DropdownProps){.bounds = {Scale(350), Scale(418), Scale(160), Scale(28)}, .id = 37,
            .options = choices[:], .option_count = 3, .selected_index = &pick})
        Progress((ProgressProps){{Scale(350), Scale(458), Scale(160), Scale(18)}, 0, 100, slider_value, "Progress"})

        ColorPicker((ColorPickerProps){.bounds = {Scale(540), Scale(92), Scale(96), Scale(120)}, .id = 38, .values = pick_color, .value_count = 4, .picker = true})
        Fieldset((FieldsetProps){.bounds = {Scale(540), Scale(148), Scale(140), Scale(48)}, .title = "Frame"})
        Image((ImageProps){.asset_path = "tiles/tile.png", .bounds = (Rectangle){Scale(690), Scale(148), Scale(48), Scale(48)}, .source = (Rectangle){0, 0, 0, 0}, .origin = (Vector2){0, 0}, .rotation = 0.0f, .tint = WHITE, .fit = IMAGE_FIT_CONTAIN})
        Icon(39, Scale(540), Scale(210), Scale(24), 1, WHITE)
        if Button((ButtonProps){.bounds = {Scale(580), Scale(206), Scale(32), Scale(32)}, .id = 40,
            .icon_type = 1, .icon_only = 1, .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisSoft}) {
            OpenURL("https://kryonlabs.com")
        }
        Image((ImageProps){.asset_path = "tiles/tile.png", .bounds = (Rectangle){Scale(620), Scale(206), Scale(72), Scale(48)}, .source = (Rectangle){0, 0, 0, 0}, .origin = (Vector2){0, 0}, .rotation = 0.0f, .tint = WHITE, .fit = IMAGE_FIT_CONTAIN})

        TabBar((TabBarProps){.bounds = {Scale(540), Scale(270), Scale(160), Scale(36)}, .tabs = tabs[:], .count = 2, .selected_index = pick, .id = 108})
        ListBox((ListBoxProps){.bounds = {Scale(540), Scale(336), Scale(160), Scale(70)}, .id = 41, .items = choices[:], .selected_index = &pick, .scroll_offset = &list_scroll, .row_height = Scale(22)})
        TreeView((TreeViewProps){.bounds = {Scale(540), Scale(418), Scale(160), Scale(70)}, .id = 42, .items = tree_items[:], .item_count = 2, .selected_id = &tree_selected, .scroll_offset = &list_scroll, .row_height = Scale(22)})
        Rect(Scale(24), Scale(470), Scale(240), Scale(72), GetThemeSurface(), GetThemeBorder())
        Text((TextProps){.bounds = {Scale(36), Scale(484), 0, 0}, .text = "1  fn main()", .font = Text14, .color = GetThemeText(), .wrap = TextWrapNone})
        Text((TextProps){.bounds = {Scale(36), Scale(502), 0, 0}, .text = "2    Text()", .font = Text14, .color = GetThemeText(), .wrap = TextWrapNone})
        TableView((TableViewProps){.bounds = {Scale(276), Scale(470), Scale(240), Scale(72)}, .id = 43, .columns = columns[:], .column_count = 2, .rows = rows[:], .row_count = 2, .column_widths = widths[:], .selected_row = &table_selected_row, .selected_column = &table_selected_column, .activated_row = &table_activated_row, .activated_column = &table_activated_column, .right_clicked_row = &table_right_row, .right_clicked_column = &table_right_column})

        PanedView((PanedViewProps){.bounds = {Scale(24), Scale(552), Scale(220), Scale(36)}, .id = 44, .vertical = 1, .split = &slider_value, .min_first = 80, .min_second = 120})
        Collapsible((CollapsibleProps){.bounds = {Scale(260), Scale(552), Scale(160), Scale(36)}, .label = "Collapsible", .open = &open})
        modal_actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
        Modal((ModalProps){.title = "Catalog", .message = "Modal coverage", .actions = modal_actions, .action_count = 2, .max_width = 360})
        message_actions: [1] ModalAction = {{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
        Modal((ModalProps){.title = "Message", .message = "Dialog", .actions = message_actions, .action_count = 1, .max_width = 420})
        confirm_actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
        Modal((ModalProps){.title = "Confirm", .message = "Dialog", .actions = confirm_actions, .action_count = 2, .max_width = 460})
        prompt_actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
        Modal((ModalProps){.title = "Prompt", .actions = prompt_actions, .action_count = 2, .max_width = 460, .text = text_value, .text_size = sizeof(text_value), .cursor_position = &text_cursor, .focused = &open})
        action_modal_actions: [2] ModalAction = {{"Run",ButtonToneAccent,ButtonEmphasisFilled,0},{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0}}
        Modal((ModalProps){.title = "Action", .message = "Dialog", .actions = action_modal_actions, .action_count = 2, .max_width = 360})

        canvas_result: CanvasResult = BeginCanvas((Canvas){{Scale(520), Scale(510), Scale(92), Scale(58)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
        CanvasGrid((Rectangle){Scale(520), Scale(510), Scale(92), Scale(58)}, 8, GetThemeIcon())
        Circle((int)canvas_result.world.x, (int)canvas_result.world.y,
               Scale(4), GetThemeSurface())
        EndCanvas((Canvas){{Scale(520), Scale(510), Scale(92), Scale(58)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
    }
}
