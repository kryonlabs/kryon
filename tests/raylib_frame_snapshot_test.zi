#import "std/bundle_host"
#import "hosted_values"
#import "widget_codec"
#import "tree_input"
#import "session"
#import "input_protocol"
#import "raylib_runtime"
#import "frame_snapshot"
#import "geometry"
#import "key_input"
#import "widget_host"
#import "hosted_app"
#import "std/file"
#import "std/c_string"

// Real SDL events enter raylib's platform poller; no replacement input provider.
sdl :: #system_library "SDL2";
raylib_input :: #system_library "raylib";
Event :: struct {
    kind: u32
    timestamp: u32
    window: u32
    state: u8
    repeat: u8
    pad1: u8
    pad2: u8
    scancode: s32
    keycode: s32
    modifiers: u16
    pad3: u16
    unused_value: u32
    tail: [24]u8
}
PushEvent :: (event: *Event) -> s32 #foreign sdl "SDL_PushEvent";
PollEvents :: () #foreign raylib_input "PollInputEvents";

KeyEvent :: (down: bool, repeat: bool, scancode: s32 = 4, keycode: s32 = 97) -> bool {
    event: Event
    event.kind = ifx down then cast(u32)0x300 else cast(u32)0x301
    event.state = ifx down then cast(u8)1 else cast(u8)0
    event.repeat = ifx repeat then cast(u8)1 else cast(u8)0
    event.scancode = scancode
    event.keycode = keycode
    return PushEvent(*event) == 1
}

FocusEvent :: (focused: bool) -> bool {
    event: Event
    event.kind = cast(u32)0x200
    event.state = ifx focused then cast(u8)12 else cast(u8)13
    return PushEvent(*event) == 1
}

// Deterministic touch fixtures at raylib's FFI boundary. All window and key
// events still use real SDL on the test's private Xvfb display.
fixture_active: bool;
fixture_count: s32;
fixture_points: [8]Vector2;
fixture_queries: s32;
fixture_positions: s32;
fixture_invalid: bool;
fixture_owner: usize;
thread_c :: #system_library "c";
Self :: () -> usize #foreign thread_c "pthread_self";
RealMouseX :: () -> s32 #foreign raylib_input "__real_GetMouseX";
RealMouseY :: () -> s32 #foreign raylib_input "__real_GetMouseY";

#program_export
__wrap_GetMouseX :: () -> s32 {
    if fixture_active { return 80 }
    return RealMouseX()
}
#program_export
__wrap_GetMouseY :: () -> s32 {
    if fixture_active { return 150 }
    return RealMouseY()
}
#program_export
__wrap_GetTouchPointCount :: () -> s32 {
    fixture_queries += 1
    if Self() != fixture_owner { fixture_invalid = true }
    return fixture_count
}
#program_export
__wrap_GetTouchPosition :: (index: s32) -> Vector2 {
    fixture_positions += 1
    if Self() != fixture_owner || index < 0 || index >= 8 || index >= fixture_count {
        fixture_invalid = true
        return Vector2.{}
    }
    return fixture_points[index]
}

TouchFrame :: (argument: *void) {
    result := cast(*s32)argument
    #if #defined(KRYON_FRAME_THREADS) {
        if Self() == fixture_owner { result.* = 51; return }
    }
    // Zoom may change in the callback; the snapshot retains screen pixels.
    RaylibSetZoom(4.0)
    points: [3]Vector2
    points[2] = Vector2.{-99.0, -98.0}
    if RaylibTouches(points[:]) != 2 || points[0].x != 20.0 || points[0].y != 37.5 ||
    points[1].x != 35.0 || points[1].y != 57.5 ||
    points[2].x != -99.0 || points[2].y != -98.0 { result.* = 52; return }
    points[0].x = -1.0
    if RaylibTouches(points[:1]) != 2 || points[0].x != 20.0 { result.* = 53 }
}

TouchFixtures :: () -> s32 {
    fixture_active = true
    defer { fixture_active = false; RaylibSetZoom(1.0) }
    points: [9]Vector2
    points[0] = Vector2.{-99.0, -98.0}
    if !FocusEvent(true) { return 35 }
    PollEvents()
    fixture_count = 0
    if !PollRaylib() || RaylibTouches(points[:]) != 0 ||
    points[0].x != -99.0 || points[0].y != -98.0 || fixture_positions != 0 { return 36 }
    fixture_count = -1
    if !PollRaylib() || RaylibTouches(points[:0]) != 0 || fixture_positions != 0 { return 37 }
    for index: cast(s32)0..7 {
        fixture_points[index] = Vector2.{100.0 + cast(float32)index * 60.0,
            200.0 + cast(float32)index * 80.0}
    }
    fixture_count = 2
    RaylibSetZoom(2.0)
    if !PollRaylib() { return 38 }
    queries := fixture_queries
    positions := fixture_positions
    // Mutating the provider after the poll must not affect a callback.
    fixture_count = 0
    fixture_points[0] = Vector2.{-200.0, -400.0}
    if RaylibTouches(points[:0]) != 2 || points[0].x != -99.0 || points[0].y != -98.0 ||
    fixture_queries != queries || fixture_positions != positions { return 39 }
    points[1] = Vector2.{-97.0, -96.0}
    if RaylibTouches(points[:1]) != 2 || points[0].x != 40.0 || points[0].y != 75.0 ||
    points[1].x != -97.0 || points[1].y != -96.0 { return 40 }
    if RaylibTouches(points[:]) != 2 || points[1].x != 70.0 || points[1].y != 115.0 { return 41 }
    // The first point matches the polled pointer in the current zoom.
    pointer := PollPointer()
    if pointer.x != points[0].x || pointer.y != points[0].y { return 42 }
    result: s32
    if !RunRaylibAppFrame(TouchFrame, cast(*void)*result) || !FlushRaylibAppFrames() { return 43 }
    if result != 0 { return result }
    if fixture_queries != queries || fixture_positions != positions || fixture_invalid { return 44 }
    CloseRaylibAppFrames()
    // A hostile count cannot overrun the backend snapshot or caller slice.
    fixture_points[0] = Vector2.{100.0, 200.0}
    fixture_count = 2147483647
    RaylibSetZoom(2.0)
    points[8] = Vector2.{-97.0, -96.0}
    if !PollRaylib() || RaylibTouches(points[:]) != 8 || fixture_positions != positions + 8 ||
    points[7].x != 250.0 || points[7].y != 355.0 ||
    points[8].x != -97.0 || points[8].y != -96.0 || fixture_invalid { return 45 }
    if !FocusEvent(false) { return 46 }
    PollEvents()
    positions = fixture_positions
    if !PollRaylib() || RaylibTouches(points[:]) != 0 || fixture_positions != positions { return 47 }
    // Terminal polling must revoke the previous touch snapshot.
    if !FocusEvent(true) { return 48 }
    PollEvents()
    fixture_count = 2
    if !PollRaylib() || RaylibTouches(points[:0]) != 2 { return 49 }
    WindowQuitHost()
    if PollRaylib() || RaylibTouches(points[:]) != 0 { return 50 }
    return 0
}

AllowAsset :: (path: string) -> bool { unused path; return false }
Allows :: (context: *void, module: string, function: string) -> bool {
    unused context
    return WidgetHostSupports(module, function)
}

#program_export
main :: () -> s32 {
    fixture_owner = Self()
    initial_points: [1]Vector2
    if RaylibTouches(initial_points[:]) != 0 { return Failure(55) }
    if !OpenRaylib(320, 200, "Frame input local test") { return Failure(1) }
    defer { CloseRaylib() }
    RaylibExitKey(0)
    session := SessionOpen()
    other := SessionOpen()
    if !FocusEvent(true) { return Failure(2) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) { return Failure(2) }
    initial := CaptureFrameInput(session)
    if !initial.available || initial.delta_ms != 0 || initial.sequence != cast(u64)1 { return Failure(3) }
    FrameInputEnd(session)
    bytes, ok := ReadEntireFile("frame-snapshot.zx")
    app: HostedApp
    if !ok || !HostedAppOpen(*app, bytes) || !HostedAppStart(*app, Allows, WidgetHostCall, null) { return Failure(4) }
    defer { HostedAppClose(*app) }
    if !KeyEvent(true, false) || !KeyEvent(true, false, 80, 0x40000050) || !FocusEvent(true) { return Failure(5) }
    // SDL_TEXTINPUT text starts at offset 12 in SDL_Event.
    typed: Event
    typed.kind = cast(u32)0x303
    typed.state = cast(u8)120
    if PushEvent(*typed) != 1 { return Failure(6) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) { return Failure(7) }
    first := CaptureFrameInput(session)
    if first.keys[65] != cast(u8)3 || first.keys[KeyLeft] != cast(u8)3 || !first.focused || first.delta_ms < 0 ||
    first.sequence != cast(u64)2 || CaptureFrameInput(other).available { return Failure(8) }
    // Polling queued raylib's keys and text in order for one session; the
    // snapshot keeps its flags and the other sessions' queues stay untouched.
    delivery := SessionOpen()
    defer { TreeInputReset(delivery); unused SessionClose(delivery) }
    key, modifiers := RaylibInputTake(delivery)
    delivered: [8]u8
    if key != 65 || TypedTextTake(delivery, delivered[:]) != "x" { return Failure(9) }
    key, modifiers = RaylibInputTake(delivery)
    if key != KeyLeft { return Failure(9) }
    key, modifiers = RaylibInputTake(delivery)
    if key != 0 { return Failure(9) }
    unused KeyboardSend(session, KeyEscape)
    unused TypedCodepointSend(session, 120)
    again := CaptureFrameInput(session)
    if again.keys[65] != first.keys[65] || KeyboardTake(session) != KeyEscape { return Failure(10) }
    text: [8]u8
    if TypedTextTake(session, text[:]) != "x" { return Failure(11) }
    answer: s64
    if !WidgetHostSupports("frame_snapshot", "CaptureFrameInputHost") ||
    WidgetHostSupports("unrelated", "CaptureFrameInputHost") ||
    WidgetHostSupports("frame_snapshot", "KeyboardTake") { return Failure(32) }
    WidgetHostBegin(session, AllowAsset)
    if !HostedAppRun(*app, *answer) || answer != 42 { return Failure(12) }
    WidgetHostEnd()
    session_codec: WidgetSessionCodec
    argument: [1]HostValue
    argument[0] = WidgetEncodeSession(session, *session_codec)
    result: HostValue
    if WidgetHostCall(null, HostTextData("frame_snapshot"), HostTextData("CaptureFrameInputHost"),
    *argument[0], 1, *result) != 0 { return Failure(13) }
    // A foreign session is refused even while a different hosted frame is active.
    WidgetHostBegin(other, AllowAsset)
    if WidgetHostCall(null, HostTextData("frame_snapshot"), HostTextData("CaptureFrameInputHost"),
    *argument[0], 1, *result) != 0 { return Failure(14) }
    WidgetHostEnd()
    FrameInputEnd(session)
    WidgetHostBegin(session, AllowAsset)
    if WidgetHostCall(null, HostTextData("frame_snapshot"), HostTextData("CaptureFrameInputHost"),
    *argument[0], 1, *result) != 1 { return Failure(33) }
    zero: HostValue
    if HostFieldValue(*result, 0, "available", *zero).integer != 0 { return Failure(34) }
    WidgetHostEnd()
    if CaptureFrameInput(session).available { return Failure(15) }
    // Held without repeat is independent of consuming the press queue.
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) ||
    CaptureFrameInput(session).keys[65] != cast(u8)FrameKeyHeld { return Failure(16) }
    FrameInputEnd(session)
    if !KeyEvent(true, true) { return Failure(17) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) { return Failure(18) }
    repeated := CaptureFrameInput(session)
    if repeated.keys[65] != cast(u8)9 || first.keys[65] != cast(u8)3 ||
    repeated.elapsed_ms < first.elapsed_ms || repeated.sequence <= first.sequence { return Failure(19) }
    key, modifiers = RaylibInputTake(delivery)
    after, after_modifiers := RaylibInputTake(delivery)
    if key != 65 || after != 0 { return Failure(19) }
    WidgetHostBegin(session, AllowAsset)
    if !HostedAppRun(*app, *answer) || answer != 42 { return Failure(20) }
    WidgetHostEnd()
    FrameInputEnd(session)
    if !KeyEvent(false, false) { return Failure(21) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) ||
    CaptureFrameInput(session).keys[65] != cast(u8)FrameKeyReleased { return Failure(22) }
    FrameInputEnd(session)
    if !KeyEvent(true, false) { return Failure(23) }
    PollEvents()
    if !PollRaylib() { return Failure(24) }
    if !FocusEvent(false) { return Failure(25) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) { return Failure(26) }
    lost := CaptureFrameInput(session)
    if lost.focused || lost.keys[65] != cast(u8)FrameKeyReleased || lost.pointer.down ||
    lost.pointer.pressed || lost.secondary.down || lost.modifiers != 0 { return Failure(27) }
    FrameInputEnd(session)
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) ||
    CaptureFrameInput(session).keys[65] != cast(u8)0 { return Failure(28) }
    FrameInputEnd(session)
    if !FocusEvent(true) || !KeyEvent(true, false) { return Failure(29) }
    PollEvents()
    if !PollRaylib() || !RaylibFrameInputBegin(session) { return Failure(30) }
    regained := CaptureFrameInput(session)
    if !regained.focused || regained.keys[65] != cast(u8)FrameKeyHeld || regained.delta_ms < 0 { return Failure(31) }
    FrameInputEnd(session)
    touch_result := TouchFixtures()
    if touch_result != 0 { return Failure(touch_result) }
    return 0
}

libc :: #system_library "c";
PrintFailure :: (format: *u8, code: s32) -> s32 #foreign libc "printf";
Failure :: (code: s32) -> s32 {
    unused PrintFailure(HostTextData("frame snapshot failure %d\n"), code)
    return code
}
