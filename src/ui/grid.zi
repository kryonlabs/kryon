#import "geometry"
#import "grid_props"

#program_export
MeasureGrid :: (props: GridProps) -> GridMetrics {
    grid: GridMetrics
    gap: s32 = ifx props.gap >= 0 then props.gap else 0
    padding: s32 = ifx props.padding >= 0 then props.padding else 0
    available: s32
    columns: s32 = props.columns
    min_width: s32

    grid.bounds = props.bounds
    grid.gap = gap
    grid.padding = padding
    grid.content = Rectangle.{
        props.bounds.x + cast(float32)padding,
        props.bounds.y + cast(float32)padding,
        props.bounds.width - cast(float32)(padding * 2),
        props.bounds.height - cast(float32)(padding * 2)
    }
    if grid.content.width < 0.0 { grid.content.width = 0.0 }
    if grid.content.height < 0.0 { grid.content.height = 0.0 }

    available = cast(s32)grid.content.width
    if columns <= 0 {
        min_width = ifx props.min_item_width > 0 then props.min_item_width else available
        if min_width <= 0 { min_width = 1 }
        columns = (available + gap) / (min_width + gap)
    }
    if columns < 1 { columns = 1 }
    if props.max_columns > 0 && columns > props.max_columns {
        columns = props.max_columns
    }

    grid.columns = columns
    grid.cell_width = available
    if columns > 0 {
        grid.cell_width = (available - gap * (columns - 1)) / columns
    }
    if grid.cell_width < 0 { grid.cell_width = 0 }
    return grid
}

#program_export
BeginGridCursor :: (props: GridProps) -> GridCursor {
    cursor: GridCursor
    cursor.metrics = MeasureGrid(props)
    cursor.x = cast(s32)cursor.metrics.content.x
    cursor.y = cast(s32)cursor.metrics.content.y
    return cursor
}

#program_export
GridStep :: (cursor: GridCursor, height: s32, column_span: s32) -> GridCursor {
    columns: s32 = ifx cursor.metrics.columns > 0 then cursor.metrics.columns else 1
    span: s32
    width: s32

    if height < 0 { height = 0 }
    span = ifx column_span > 0 then column_span else 1
    if span > columns { span = columns }
    if cursor.col > 0 && cursor.col + span > columns {
        cursor.y += cursor.row_height + cursor.metrics.gap
        cursor.used_height += cursor.row_height + cursor.metrics.gap
        cursor.col = 0
        cursor.row_height = 0
    }

    width = cursor.metrics.cell_width * span + cursor.metrics.gap * (span - 1)
    cursor.item = Rectangle.{
        cast(float32)(cursor.x + cursor.col * (cursor.metrics.cell_width + cursor.metrics.gap)),
        cast(float32)cursor.y,
        cast(float32)width,
        cast(float32)height
    }
    if height > cursor.row_height { cursor.row_height = height }
    cursor.col += span
    if cursor.col >= columns {
        cursor.y += cursor.row_height + cursor.metrics.gap
        cursor.used_height += cursor.row_height + cursor.metrics.gap
        cursor.col = 0
        cursor.row_height = 0
    }
    return cursor
}


#program_export
GridCursorHeight :: (cursor: GridCursor) -> s32 {
    height: s32 = cursor.used_height
    if cursor.row_height > 0 {
        height += cursor.row_height
    } else if height > 0 {
        height -= cursor.metrics.gap
    }
    if height < 0 { height = 0 }
    return height
}

// Equal cells: a grid of tiles that share one height, laid out across the
// columns MeasureGrid chose for the width, such as an app launcher.

// Rows that count equal cells need.
#program_export
GridRowCount :: (metrics: GridMetrics, count: s32) -> s32 {
    columns: s32 = ifx metrics.columns > 0 then metrics.columns else 1
    if count <= 0 { return 0 }
    return (count + columns - 1) / columns
}

// Height of count equal cells, with gaps only between rows.
#program_export
GridCellsHeight :: (metrics: GridMetrics, count: s32, cell_height: s32) -> s32 {
    rows: s32 = GridRowCount(metrics, count)
    if rows == 0 { return 0 }
    return rows * cell_height + (rows - 1) * metrics.gap
}

// Bounds of equal cell index, in reading order.
#program_export
GridCellBounds :: (metrics: GridMetrics, index: s32, cell_height: s32) -> Rectangle {
    columns: s32 = ifx metrics.columns > 0 then metrics.columns else 1
    if index < 0 { index = 0 }
    column: s32 = index % columns
    row: s32 = index / columns
    return Rectangle.{
        metrics.content.x + cast(float32)(column * (metrics.cell_width + metrics.gap)),
        metrics.content.y + cast(float32)(row * (cell_height + metrics.gap)),
        cast(float32)metrics.cell_width,
        cast(float32)cell_height
    }
}

// The equal cell under a point, for dropping a dragged tile there: points
// beside the columns or between cells pick the nearest cell, points above the
// grid pick the first and points past the last cell give count.
#program_export
GridIndexAt :: (metrics: GridMetrics, x: float32, y: float32,
    cell_height: s32, count: s32) -> s32 {
    columns: s32 = ifx metrics.columns > 0 then metrics.columns else 1
    if count <= 0 { return 0 }
    pitch_x: s32 = metrics.cell_width + metrics.gap
    pitch_y: s32 = cell_height + metrics.gap
    if pitch_x <= 0 { pitch_x = 1 }
    if pitch_y <= 0 { pitch_y = 1 }
    column: s32 = 0
    if x > metrics.content.x {
        column = cast(s32)(x - metrics.content.x) / pitch_x
    }
    if column >= columns { column = columns - 1 }
    row: s32 = 0
    if y > metrics.content.y {
        row = cast(s32)(y - metrics.content.y) / pitch_y
    }
    index: s32 = row * columns + column
    if index > count { index = count }
    return index
}
