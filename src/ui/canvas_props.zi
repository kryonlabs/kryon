#module "canvas_props"
#import "kryon_compat.generated.h"

Canvas :: struct {
    bounds: Rectangle
    class_name: i32
    scroll_x: *i32
    scroll_y: *i32
    zoom: *f32
}

CanvasResult :: struct {
    active: bool
    dragging: bool
    selected_index: i32
    world: Vector2
}

CanvasHitTest :: (point: Vector2, items: *Rectangle, item_count: i32) -> i32 #extern #export
CanvasToScreen :: (canvas: Canvas, point: Vector2) -> Vector2 #extern #export
CanvasRectToScreen :: (canvas: Canvas, rect: Rectangle) -> Rectangle #extern #export
