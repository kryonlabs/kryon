#import "geometry"

PopupDecision :: struct {
    valid: bool
    tooltip: bool
    modal: bool
    context: bool
    captures_input: bool
    requires_open: bool
    requires_trigger: bool
}

PopupContextActivation :: struct {
    open: bool
    origin: Vector2
}

PopupOpenResult :: struct {
    open: bool
    changed: bool
}

PopupDismissDecision :: struct {
    close: bool
    consume_release: bool
}

#program_export
PopupPanelRole :: () -> s32 {
    return 2
}

#program_export
PopupDecisionFor :: (flags: u32, disabled: bool) -> PopupDecision {
    decision: PopupDecision
    tooltip_flag: u32 = cast(u32)1
    modal_flag: u32 = cast(u32)2
    context_flag: u32 = cast(u32)4
    known: u32 = tooltip_flag | modal_flag | context_flag

    if (flags & ~known) != cast(u32)0 {
        return decision
    }
    decision.tooltip = (flags & tooltip_flag) != cast(u32)0
    decision.modal = (flags & modal_flag) != cast(u32)0
    decision.context = (flags & context_flag) != cast(u32)0
    selected: s32 = 0
    if decision.tooltip { selected += 1 }
    if decision.modal { selected += 1 }
    if decision.context { selected += 1 }
    if selected > 1 {
        return decision
    }
    decision.valid = true
    decision.captures_input = !decision.tooltip
    decision.requires_open = !decision.tooltip
    decision.requires_trigger = decision.tooltip || decision.context
    if disabled && !decision.tooltip {
        decision.captures_input = false
    }
    return decision
}

#program_export
PopupCanBegin :: (decision: PopupDecision, id: s32, bounds: Rectangle,
trigger: Rectangle, has_open: bool) -> bool {
    if !decision.valid || id <= 0 || bounds.width <= 0.0 || bounds.height <= 0.0 {
        return false
    }
    if decision.requires_open && !has_open {
        return false
    }
    if decision.requires_trigger &&
    (trigger.width <= 0.0 || trigger.height <= 0.0) {
        return false
    }
    return true
}

#program_export
PopupOpenAfterDisabled :: (decision: PopupDecision, open: bool,
disabled: bool) -> bool {
    if disabled && !decision.tooltip {
        return false
    }
    return open
}

#program_export
PopupTooltipVisible :: (decision: PopupDecision, disabled: bool,
pointer_inside_trigger: bool) -> bool {
    if !decision.tooltip {
        return false
    }
    return !disabled && pointer_inside_trigger
}

#program_export
PopupOpenFor :: (open: bool, open_requested: bool, close_requested: bool,
has_open: bool) -> PopupOpenResult {
    result: PopupOpenResult
    result.open = open
    if !has_open {
        return result
    }
    if open_requested {
        result.open = true
    }
    if close_requested {
        result.open = false
    }
    result.changed = result.open != open
    return result
}

#program_export
PopupInputBounds :: (decision: PopupDecision, bounds: Rectangle,
view_width: float32, view_height: float32) -> Rectangle {
    input: Rectangle = bounds
    if decision.modal {
        input.x = 0.0
        input.y = 0.0
        input.width = view_width
        input.height = view_height
    }
    return input
}

#program_export
PopupMenuBarOrigin :: (item: Rectangle, bar: Rectangle) -> Vector2 {
    origin: Vector2
    origin.x = item.x
    origin.y = bar.y + bar.height
    return origin
}

#program_export
PopupContextOrigin :: (mouse: Vector2) -> Vector2 {
    return mouse
}

#program_export
PopupContextActivationFor :: (decision: PopupDecision, trigger: Rectangle,
mouse: Vector2, disabled: bool, click_captured: bool,
right_released: bool) -> PopupContextActivation {
    activation: PopupContextActivation
    activation.origin = PopupContextOrigin(mouse)
    if !decision.context || disabled || click_captured || !right_released {
        return activation
    }
    if mouse.x < trigger.x || mouse.y < trigger.y ||
    mouse.x >= trigger.x + trigger.width ||
    mouse.y >= trigger.y + trigger.height {
        return activation
    }
    activation.open = true
    return activation
}

#program_export
PopupDismissDecisionFor :: (decision: PopupDecision, left_released: bool,
release_consumed: bool, pointer_inside_popup: bool) -> PopupDismissDecision {
    dismiss: PopupDismissDecision
    if decision.tooltip || decision.modal {
        return dismiss
    }
    if left_released && !release_consumed && !pointer_inside_popup {
        dismiss.close = true
        dismiss.consume_release = true
    }
    return dismiss
}

#program_export
PopupBackdropAlpha :: (decision: PopupDecision) -> s32 {
    if decision.modal {
        return 180
    }
    return 0
}

# Native hosts supply sampled input and apply these transitions to their
# caller-owned open value, paint layers and input registry. Keyboard ownership
# must be sampled after entering the input scope, including on the first frame.
PopupFrameInput :: struct {
    id: s32
    bounds: Rectangle
    trigger: Rectangle
    has_open: bool
    open: bool
    disabled: bool
    trigger_blocked: bool
    mouse: Vector2
    right_released: bool
    view_width: float32
    view_height: float32
}

PopupLifecycle :: struct {
    decision: PopupDecision
    eligible: bool
    open: bool
    visible: bool
    close_input: bool
    context_opened: bool
    consume_release: bool
    input_bounds: Rectangle
    backdrop_alpha: s32
}

#program_export
PopupLifecycleBegin :: (flags: u32, input: PopupFrameInput) -> PopupLifecycle {
    state: PopupLifecycle
    state.decision = PopupDecisionFor(flags, input.disabled)
    state.open = input.open
    state.eligible = PopupCanBegin(state.decision, input.id, input.bounds,
    input.trigger, input.has_open)
    if !state.eligible {
        return state
    }
    activation: PopupContextActivation = PopupContextActivationFor(
    state.decision, input.trigger, input.mouse, input.disabled,
    input.trigger_blocked, input.right_released)
    state.context_opened = activation.open
    if state.decision.tooltip {
        inside: bool = input.mouse.x >= input.trigger.x &&
        input.mouse.y >= input.trigger.y &&
        input.mouse.x < input.trigger.x + input.trigger.width &&
        input.mouse.y < input.trigger.y + input.trigger.height
        state.open = PopupTooltipVisible(state.decision,
        input.disabled || input.trigger_blocked, inside)
    } else {
        state.open = PopupOpenAfterDisabled(state.decision,
        input.open || activation.open, input.disabled)
        state.close_input = !state.open
    }
    state.visible = state.open
    state.input_bounds = PopupInputBounds(state.decision, input.bounds,
    input.view_width, input.view_height)
    state.backdrop_alpha = PopupBackdropAlpha(state.decision)
    return state
}

#program_export
PopupLifecycleFinish :: (state: PopupLifecycle, open: bool,
close_requested: bool) -> PopupLifecycle {
    result: PopupLifecycle = state
    if !state.eligible {
        return result
    }
    result.open = open && !close_requested
    result.visible = state.visible && result.open
    result.close_input = !result.visible && !state.decision.tooltip
    return result
}

# Consume exactly the release that dismisses an open popup. Hosts with queues
# feed releases in order; an already closed popup cannot consume later taps.
#program_export
PopupLifecycleRelease :: (state: PopupLifecycle, released: bool,
consumed: bool, inside: bool) -> PopupLifecycle {
    result: PopupLifecycle = state
    result.consume_release = false
    if !state.visible {
        return result
    }
    dismiss: PopupDismissDecision = PopupDismissDecisionFor(
    state.decision, released, consumed, inside)
    if dismiss.close {
        result = PopupLifecycleFinish(result, false, true)
        result.consume_release = dismiss.consume_release
    }
    return result
}

#program_export
PopupLifecycleKeyboard :: (state: PopupLifecycle, escape: bool,
keyboard_captured: bool) -> PopupLifecycle {
    if state.visible && state.decision.captures_input && escape &&
    !keyboard_captured {
        return PopupLifecycleFinish(state, false, true)
    }
    return state
}
