#import "control_props"
#import "geometry"
#import "style"

using StyleField;

InfoRowsMetrics :: struct {
    row_height: s32
    padding_x: s32
}

InfoRowsLayout :: struct {
    background: Rectangle
}

InfoRowLayout :: struct {
    text_bounds: Rectangle
    separator_y: s32
}

LabelTextFieldMetrics :: struct {
    label_height: s32
    field_height: s32
    gap: s32
    bottom_gap: s32
}

LabelTextFieldLayout :: struct {
    label_bounds: Rectangle
    field_bounds: Rectangle
}

SectionLabelMetrics :: struct {
    height: s32
    icon_diameter: s32
    info_gap: s32
    info_y_offset: s32
}

CheckboxRowMetrics :: struct {
    height: s32
}

ButtonRowMetrics :: struct {
    height: s32
    gap: s32
    item_padding_x: s32
    min_width: s32
    max_width: s32
}

ButtonRowPlacement :: struct {
    start_x: s32
    button_width: s32
    total_width: s32
}

ButtonRowWrapDecision :: struct {
    wraps: bool
    row_width: s32
}

SpinboxRowMetrics :: struct {
    row_height: s32
    control_width: s32
    label_gap: s32
    control_height_inset: s32
}

FormRectResult :: struct {
    bounds: Rectangle
    next_cursor_y: s32
}

SpinboxRowLayout :: struct {
    label_bounds: Rectangle
    spinbox_bounds: Rectangle
    control_width: s32
    label_width: s32
}

RowsMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

RowsRequestedMetric :: (requested: s32, fields: u32, field: u32,
    value: float32, fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if requested > 0 { return requested }
    return RowsMetric(fields, field, value, fallback, scale, allow_zero)
}

#program_export
RowsMutedAlpha :: (alpha: u8) -> u8 {
    return cast(u8)(cast(float32)alpha * 0.72)
}

#program_export
InfoRowsTextRole :: () -> s32 {
    return 0
}

#program_export
LabelTextFieldLabelRole :: () -> s32 {
    return 1
}

#program_export
LabelTextFieldFieldRole :: () -> s32 {
    return 2
}

#program_export
SectionLabelRole :: () -> s32 {
    return 3
}

#program_export
CheckboxRowRole :: () -> s32 {
    return 4
}

#program_export
ButtonRowPrimaryRole :: () -> s32 {
    return 5
}

#program_export
ButtonRowSecondaryRole :: () -> s32 {
    return 6
}

#program_export
SpinboxRowLabelRole :: () -> s32 {
    return 7
}

#program_export
SpinboxRowControlRole :: () -> s32 {
    return 8
}

#program_export
InfoRowsMetricsFor :: (row_height: s32, padding_x: s32, scale: float32,
    row: StyleFrame) -> InfoRowsMetrics {
    metrics: InfoRowsMetrics
    metrics.row_height = RowsRequestedMetric(row_height, row.value.fields,
        cast(u32)StyleContentOffset, row.value.offset_y, 32.0, scale, false)
    metrics.padding_x = RowsRequestedMetric(padding_x, row.value.fields,
        cast(u32)StylePaddingX, row.value.padding_x, 10.0, scale, true)
    return metrics
}

#program_export
InfoRowsLayoutFor :: (x: s32, y: s32, width: s32, row_count: s32,
    metrics: InfoRowsMetrics) -> InfoRowsLayout {
    layout: InfoRowsLayout
    h: s32 = row_count * metrics.row_height
    if width < 0 { width = 0 }
    if h < 0 { h = 0 }
    layout.background.x = cast(float32)x
    layout.background.y = cast(float32)y
    layout.background.width = cast(float32)width
    layout.background.height = cast(float32)h
    return layout
}

#program_export
InfoRowLayoutFor :: (x: s32, y: s32, width: s32, row_index: s32,
    metrics: InfoRowsMetrics) -> InfoRowLayout {
    layout: InfoRowLayout
    if row_index < 0 { row_index = 0 }
    row_y: s32 = y + row_index * metrics.row_height
    text_width: s32 = width - metrics.padding_x * 2
    if text_width < 0 { text_width = 0 }
    layout.text_bounds.x = cast(float32)(x + metrics.padding_x)
    layout.text_bounds.y = cast(float32)row_y
    layout.text_bounds.width = cast(float32)text_width
    layout.text_bounds.height = cast(float32)metrics.row_height
    layout.separator_y = row_y
    return layout
}

#program_export
LabelTextFieldMetricsFor :: (label_height: s32, field_height: s32,
    gap: s32, bottom_gap: s32, scale: float32, label: StyleFrame,
    field: StyleFrame) -> LabelTextFieldMetrics {
    metrics: LabelTextFieldMetrics
    metrics.label_height = RowsRequestedMetric(label_height,
        label.value.fields, cast(u32)StyleContentOffset, label.value.offset_y,
        22.0, scale, false)
    metrics.field_height = RowsRequestedMetric(field_height,
        field.value.fields, cast(u32)StyleContentOffset, field.value.offset_y,
        40.0, scale, false)
    if gap > 0 {
        metrics.gap = gap
    } else {
        metrics.gap = RowsMetric(label.value.fields, cast(u32)StyleGap,
            label.value.gap, 0.0, scale, true)
    }
    metrics.bottom_gap = RowsRequestedMetric(bottom_gap, field.value.fields,
        cast(u32)StyleGap, field.value.gap, 24.0, scale, true)
    return metrics
}

#program_export
LabelTextFieldLayoutFor :: (x: s32, y: s32, width: s32,
    requested_bounds: Rectangle, metrics: LabelTextFieldMetrics) -> LabelTextFieldLayout {
    layout: LabelTextFieldLayout

    layout.label_bounds.x = cast(float32)x
    layout.label_bounds.y = cast(float32)y
    layout.label_bounds.width = cast(float32)width
    layout.label_bounds.height = cast(float32)metrics.label_height

    if requested_bounds.width > 0.0 && requested_bounds.height > 0.0 {
        layout.field_bounds = requested_bounds
        return layout
    }

    layout.field_bounds.x = cast(float32)x
    layout.field_bounds.y = cast(float32)(y + metrics.label_height + metrics.gap)
    layout.field_bounds.width = cast(float32)width
    layout.field_bounds.height = cast(float32)metrics.field_height
    return layout
}

#program_export
SectionLabelMetricsFor :: (height: s32, icon_diameter: s32, scale: float32,
    label: StyleFrame) -> SectionLabelMetrics {
    metrics: SectionLabelMetrics
    metrics.height = RowsRequestedMetric(height, label.value.fields,
        cast(u32)StyleContentOffset, label.value.offset_y, 24.0, scale, false)
    metrics.icon_diameter = RowsRequestedMetric(icon_diameter,
        label.value.fields, cast(u32)StyleIconSize, label.value.icon_size,
        18.0, scale, false)
    metrics.info_gap = RowsMetric(label.value.fields, cast(u32)StylePaddingX,
        label.value.padding_x, 16.0, scale, true)
    metrics.info_y_offset = RowsMetric(label.value.fields, cast(u32)StylePaddingY,
        label.value.padding_y, 1.0, scale, true)
    return metrics
}

#program_export
CheckboxRowMetricsFor :: (height: s32, scale: float32,
    row: StyleFrame) -> CheckboxRowMetrics {
    metrics: CheckboxRowMetrics
    metrics.height = RowsRequestedMetric(height, row.value.fields,
        cast(u32)StyleContentOffset, row.value.offset_y, 42.0, scale, false)
    return metrics
}

#program_export
ButtonRowMetricsFor :: (height: s32, gap: s32, scale: float32,
    row: StyleFrame, item: StyleFrame) -> ButtonRowMetrics {
    metrics: ButtonRowMetrics
    metrics.height = RowsRequestedMetric(height, row.value.fields,
        cast(u32)StyleContentOffset, row.value.offset_y, 30.0, scale, false)
    if gap > 0 {
        metrics.gap = gap
    } else {
        metrics.gap = RowsMetric(row.value.fields, cast(u32)StyleGap,
            row.value.gap, 6.0, scale, true)
    }
    metrics.item_padding_x = RowsMetric(item.value.fields,
        cast(u32)StylePaddingX, item.value.padding_x, 10.0, scale, true)
    metrics.min_width = RowsMetric(item.value.fields,
        cast(u32)StyleContentOffset, item.value.offset_x, 76.0, scale, false)
    metrics.max_width = RowsMetric(item.value.fields,
        cast(u32)StyleIconSize, item.value.icon_size, 144.0, scale, false)
    if metrics.max_width < metrics.min_width {
        metrics.max_width = metrics.min_width
    }
    return metrics
}

#program_export
ButtonRowItemWidth :: (label_width: s32, metrics: ButtonRowMetrics) -> s32 {
    width: s32 = label_width + metrics.item_padding_x * 2
    if width < metrics.min_width { width = metrics.min_width }
    if width > metrics.max_width { width = metrics.max_width }
    return width
}

#program_export
ButtonRowWrapFor :: (row_width: s32, item_width: s32, total_width: s32,
    gap: s32) -> ButtonRowWrapDecision {
    decision: ButtonRowWrapDecision
    if item_width < 0 { item_width = 0 }
    if gap < 0 { gap = 0 }
    next_width: s32 = item_width
    if row_width > 0 {
        next_width = row_width + gap + item_width
    }
    if row_width > 0 && total_width > 0 && next_width > total_width {
        decision.wraps = true
        decision.row_width = item_width
        return decision
    }
    decision.row_width = next_width
    return decision
}

#program_export
ButtonRowPlacementFor :: (x: s32, width: s32, row_count: s32,
    gap: s32) -> ButtonRowPlacement {
    placement: ButtonRowPlacement
    if row_count <= 0 || width <= 0 {
        placement.start_x = x
        return placement
    }
    usable: s32 = width - gap * (row_count - 1)
    placement.button_width = usable / row_count
    if placement.button_width < 0 { placement.button_width = 0 }
    placement.total_width = placement.button_width * row_count +
        gap * (row_count - 1)
    placement.start_x = x + (width - placement.total_width) / 2
    return placement
}

#program_export
ButtonRowTotalHeight :: (row_count: s32, row_height: s32, gap: s32) -> s32 {
    if row_count <= 0 { return 0 }
    if row_height < 0 { row_height = 0 }
    if gap < 0 { gap = 0 }
    return row_count * row_height + (row_count - 1) * gap
}

#program_export
ButtonRowNextY :: (y: s32, row_height: s32, gap: s32) -> s32 {
    if row_height < 0 { row_height = 0 }
    if gap < 0 { gap = 0 }
    return y + row_height + gap
}

#program_export
SpinboxRowMetricsFor :: (row_height: s32, control_width: s32,
    scale: float32, row: StyleFrame, control: StyleFrame) -> SpinboxRowMetrics {
    metrics: SpinboxRowMetrics
    metrics.row_height = RowsRequestedMetric(row_height, row.value.fields,
        cast(u32)StyleContentOffset, row.value.offset_y, 54.0, scale, false)
    metrics.control_width = RowsRequestedMetric(control_width,
        control.value.fields, cast(u32)StyleContentOffset, control.value.offset_x,
        156.0, scale, false)
    metrics.label_gap = RowsMetric(row.value.fields, cast(u32)StyleGap,
        row.value.gap, 12.0, scale, true)
    metrics.control_height_inset = RowsMetric(control.value.fields,
        cast(u32)StylePaddingY, control.value.padding_y, 14.0, scale, true)
    return metrics
}

#program_export
FormAdvanceY :: (cursor_y: s32, height: s32, gap: s32) -> s32 {
    next_y: s32 = cursor_y
    if height > 0 { next_y += height }
    if gap > 0 { next_y += gap }
    return next_y
}

#program_export
FormRectFor :: (x: s32, cursor_y: s32, width: s32, height: s32,
    gap: s32) -> FormRectResult {
    result: FormRectResult
    rect_h: s32 = height
    if rect_h < 0 { rect_h = 0 }
    result.bounds.x = cast(float32)x
    result.bounds.y = cast(float32)cursor_y
    result.bounds.width = cast(float32)width
    result.bounds.height = cast(float32)rect_h
    result.next_cursor_y = FormAdvanceY(cursor_y, height, gap)
    return result
}

#program_export
SpinboxRowLayoutFor :: (x: s32, y: s32, width: s32, label_width: s32,
    requested_bounds: Rectangle, metrics: SpinboxRowMetrics) -> SpinboxRowLayout {
    layout: SpinboxRowLayout
    height: s32 = metrics.row_height
    control_w: s32 = metrics.control_width
    if control_w > width { control_w = width }
    if control_w < 0 { control_w = 0 }

    label_w: s32 = label_width
    if label_w <= 0 {
        label_w = width - control_w - metrics.label_gap
    }
    if label_w < 0 { label_w = 0 }

    spinbox_w: s32 = cast(s32)requested_bounds.width
    spinbox_h: s32 = cast(s32)requested_bounds.height
    if spinbox_w <= 0 { spinbox_w = control_w }
    if spinbox_h <= 0 { spinbox_h = height - metrics.control_height_inset }
    if spinbox_w < 0 { spinbox_w = 0 }
    if spinbox_h < 0 { spinbox_h = 0 }

    layout.label_bounds.x = cast(float32)x
    layout.label_bounds.y = cast(float32)y
    layout.label_bounds.width = cast(float32)label_w
    layout.label_bounds.height = cast(float32)height
    layout.spinbox_bounds.x = cast(float32)(x + width - spinbox_w)
    layout.spinbox_bounds.y = cast(float32)(y + (height - spinbox_h) / 2)
    layout.spinbox_bounds.width = cast(float32)spinbox_w
    layout.spinbox_bounds.height = cast(float32)spinbox_h
    layout.control_width = control_w
    layout.label_width = label_w
    return layout
}
