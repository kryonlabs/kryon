#module "text_props"
#import "ui_control_props.generated.h"
#import "kryon_compat.generated.h"

# Standard font size points; Font itself is the host's raylib handle.
Text8 :: 8
Text12 :: 12
Text14 :: 14
Text16 :: 16
Text18 :: 18
Text20 :: 20
Text24 :: 24
Text32 :: 32
Text48 :: 48
TextBaseSize :: 16

# Implemented by the C-only text host; declared here for the public ABI.
GetTextFont :: () -> Font #extern #export
EnsureDefaultFont :: () -> i32 #extern #export
RegisterTextFont :: (name: const char*, font: Font) -> i32 #extern #export
RegisterSmallTextFont :: (name: const char*, font: Font) -> i32 #extern #export
RegisterTextFontSource :: (name: const char*, file_type: const char*,
                           font_data: const u8*, font_size: u32,
                           codepoints: const i32*,
                           codepoint_count: i32) -> i32 #extern #export
RegisterTextFontSourceForText :: (name: const char*, file_type: const char*,
                                  font_data: const u8*, font_size: u32,
                                  text: const char*) -> i32 #extern #export
RegisterFixedTextFontSource :: (name: const char*, file_type: const char*,
                                font_data: const u8*, font_size: u32,
                                codepoints: const i32*,
                                codepoint_count: i32) -> i32 #extern #export
RegisterTextFontFileSource :: (name: const char*, path: const char*,
                               codepoints: const i32*,
                               codepoint_count: i32) -> i32 #extern #export
RegisterTextFontFileSourceForText :: (name: const char*, path: const char*,
                                      text: const char*) -> i32 #extern #export
UseTextFont :: (name: const char*) -> i32 #extern #export
PushTextFont :: (name: const char*) -> i32 #extern #export
PopTextFont :: (token: i32) #extern #export
TextFontHasGlyph :: (font: Font, codepoint: i32) -> i32 #extern #export
LoadTextFontFromMemory :: (file_type: const char*, font_data: const u8*,
                           font_size: u32, base_size: i32) -> Font #extern #export
LoadTextFontAsset :: (path: const char*, base_size: i32) -> Font #extern #export
UnloadTextFont :: (font: *Font) #extern #export
ClearTextFonts :: () #extern #export
TextFontMemoryReport :: (tag: const char*) #extern #export
MeasureTextWidth :: (text: const char*, font_size: i32,
                     typeface: const char*) -> i32 #extern #export
GetTextFontForCodepoint :: (codepoint: i32, font_size: i32) -> Font #extern #export
GetTextFontForSize :: (font_size: i32) -> Font #extern #export
GetTextFontScale :: (font: Font, font_size: i32) -> float #extern #export
RenderTextGlyph :: (codepoint: u32, x: i32, y: i32, font_size: i32,
                    color: Color) -> i32 #extern #export

TextWrap :: enum {
    TextWrapAuto = 0
    TextWrapNone = 1
}

TextAlign :: enum {
    TextAlignStart = 0
    TextAlignCenter = 1
    TextAlignEnd = 2
}

TextProps :: struct {
    bounds: Rectangle
    text: const char*
    font: i32
    class_name: i32
    wrap: TextWrap
    align: TextAlign
    vertical_align: TextAlign
    disabled: bool
    selectable: bool
    strikethrough: bool
}

# Implemented by the C-only text backend; declared here for the public ABI.
TextFontReady :: (font: Font) -> i32 #extern #export
TextFontBaseSize :: (font: Font) -> i32 #extern #export
TextFontGlyphPadding :: (font: Font) -> i32 #extern #export
TextFontGlyph :: (font: Font, codepoint: i32) -> GlyphInfo #extern #export
TextFontAtlasRec :: (font: Font, codepoint: i32) -> Rectangle #extern #export
TextFontAtlasTexture :: (font: Font) -> Texture2D #extern #export
TextFontAdvance :: (font: Font, codepoint: i32) -> i32 #extern #export
TextFontHasGlyphValue :: (font: Font, codepoint: i32) -> i32 #extern #export
TextFontGlyphCount :: (font: Font) -> i32 #extern #export
TextFontHasNativeText :: (font: Font) -> i32 #extern #export
TextFontNativeTextWidth :: (font: Font, text: const char*, byte_len: i32) -> i32 #extern #export
TextFontNativeTextHeight :: (font: Font) -> i32 #extern #export
TextFontDrawNativeText :: (font: Font, text: const char*, byte_len: i32,
                           x: i32, y: i32, font_size: i32,
                           color: Color) -> i32 #extern #export
