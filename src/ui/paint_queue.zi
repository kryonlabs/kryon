#program_export
PaintImage :: (session: Session, node: s32, asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color, texture: Texture2D = Texture2D.{0, 0, 0, 0, 0},
    smooth: bool = false) {
    empty: [1]Vector2
    PaintImageWithPolygon(session,node,asset_path,texture_id,source,destination,clip,
        origin,rotation,radius,tint,texture,smooth,empty[:0])
}

PaintImageWithPolygon :: (session: Session, node: s32, asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color, texture: Texture2D, smooth: bool, clip_polygon: []Vector2) {
    if clip_polygon.count > 0 && !ImagePolygonValid(clip_polygon) { return }
    command: QueuedPaint
    command.data.kind = PaintKindImage
    command.data.smooth = smooth
    command.data.node = node
    command.data.asset_path = asset_path
    command.data.texture_id = texture_id
    command.data.texture = texture
    command.data.source = source
    command.data.bounds = destination
    command.data.clip = clip
    command.data.origin = origin
    command.data.rotation = rotation
    command.data.radius = radius
    command.data.color = tint
    command.data.image_clip_count = cast(s32)clip_polygon.count
    command.data.mesh_points = clip_polygon
    emit: PaintEmitter = EmitImage
    clip_for: PaintClipper = ClipImage
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.builtin_emitter = true
    command.clips = true
    QueuePaint(session, *command)
}

// A texture warped over a grid of points (see ImageMesh), clipped to clip.
#program_export
PaintImageMesh :: (session: Session, node: s32, asset_path: string,
    texture_id: u32, source: Rectangle, columns: s32, rows: s32,
    points: []Vector2, clip: Rectangle, tint: Color,
    texture: Texture2D = Texture2D.{0, 0, 0, 0, 0}, smooth: bool = false) {
    if PaintMeshPointCount(columns, rows) == 0 ||
    points.count < PaintMeshPointCount(columns, rows) { return }
    command: QueuedPaint
    command.data.kind = PaintKindImage
    command.data.smooth = smooth
    command.data.node = node
    command.data.asset_path = asset_path
    command.data.texture_id = texture_id
    command.data.texture = texture
    command.data.source = source
    command.data.bounds = clip
    command.data.clip = clip
    command.data.color = tint
    command.data.mesh_columns = columns
    command.data.mesh_rows = rows
    command.data.mesh_points = points
    emit: PaintEmitter = EmitImage
    command.emit = emit
    clip_for: PaintClipper = ClipImage
    command.clip_for = clip_for
    command.has_emitter = true
    command.builtin_emitter = true
    command.clips = true
    QueuePaint(session, *command)
}

#program_export
PaintClear :: (session: Session) {
    slot := SessionIndex(session)
    VecClear(pending_paint[slot].items)
    VecClear(pending_short_text[slot])
    VecClear(pending_medium_text[slot])
    VecClear(pending_text[slot])
    VecClear(pending_mesh[slot])
    pending_paint[slot].overflow = false
    pending_paint[slot].overlays = false
    pending_paint[slot].ordered = false
}

// Keep submission order within each layer, then draw overlays after the page.
// The ordinary frame path needs no sorting or extra allocation.
#program_export
PaintOrder :: (session: Session) -> bool {
    slot := SessionIndex(session)
    if pending_paint[slot].ordered || !pending_paint[slot].overlays { return true }
    VecClear(ordered_paint[slot])
    layer: s32 = 0
    while layer >= 0 {
        next: s32 = -1
        index: s64 = 0
        while index < pending_paint[slot].items.count {
            command := pending_paint[slot].items[index]
            candidate := command.data.overlay_layer
            if candidate == layer {
                if !VecPush(ordered_paint[slot], command) {
                    pending_paint[slot].overflow = true
                    return false
                }
            } else if candidate > layer && (next < 0 || candidate < next) {
                next = candidate
            }
            index += 1
        }
        layer = next
    }
    VecSwap(pending_paint[slot].items, ordered_paint[slot])
    pending_paint[slot].ordered = true
    return true
}

#program_export
PaintOverflow :: (session: Session) -> bool {
    return pending_paint[SessionIndex(session)].overflow
}

// The pending commands are inspectable after the tree commits and before
// PaintFlush clears them. A failed commit clears the queue instead.
#program_export
PendingPaintCount :: (session: Session) -> s32 {
    return cast(s32)pending_paint[SessionIndex(session)].items.count
}

#program_export
PendingPaintAt :: (session: Session, index: s32) -> PaintCommand {
    slot: s32 = SessionIndex(session)
    if index < 0 || cast(s64)index >= pending_paint[slot].items.count {
        empty: PaintCommand
        return empty
    }
    data: PaintCommand = pending_paint[slot].items[index].data
    if data.owns_text {
        data.value = PendingTextValue(slot, data.text_block, data.text_start, data.text_count)
    }
    if data.owns_asset {
        data.asset_path = PendingTextValue(slot, data.asset_block, data.asset_start, data.asset_count)
    }
    if data.owns_mesh {
        count: s32 = cast(s32)PaintPointCount(data)
        data.mesh_points = pending_mesh[slot][data.mesh_block].points[data.mesh_start:
        data.mesh_start + count]
    }
    return data
}

SnapshotTextAppend :: (slot: s32, values: bool, value: string) -> s64 {
    if value.count == 0 { return 0 }
    if value.count > cast(s64)PAINT_TEXT_CAPACITY { return -1 }
    start: s64
    if values {
        start = paint_snapshot_value_counts[slot]
        while paint_snapshot_values[slot].count * PAINT_SNAPSHOT_BLOCK_CAPACITY < start + value.count {
            block: PaintSnapshotBlock
            if !VecPush(paint_snapshot_values[slot], block) { return -1 }
        }
        copied: s64 = 0
        while copied < value.count {
            index := start + copied
            offset := index % PAINT_SNAPSHOT_BLOCK_CAPACITY
            part := cast(s64)PAINT_SNAPSHOT_BLOCK_CAPACITY - offset
            if part > value.count - copied { part = value.count - copied }
            // One run per block, written through the block's address: every
            // frame copies each paint command's text, and finding its block
            // for each byte cost a phone a tenth of the frame.
            kept := *paint_snapshot_values[slot][index / PAINT_SNAPSHOT_BLOCK_CAPACITY]
            for at: cast(s64)0..part - 1 { kept.bytes[offset + at] = value[copied + at] }
            copied += part
        }
        paint_snapshot_value_counts[slot] = start + value.count
    } else {
        start = paint_snapshot_asset_counts[slot]
        while paint_snapshot_assets[slot].count * PAINT_SNAPSHOT_BLOCK_CAPACITY < start + value.count {
            block: PaintSnapshotBlock
            if !VecPush(paint_snapshot_assets[slot], block) { return -1 }
        }
        copied: s64 = 0
        while copied < value.count {
            index := start + copied
            offset := index % PAINT_SNAPSHOT_BLOCK_CAPACITY
            part := cast(s64)PAINT_SNAPSHOT_BLOCK_CAPACITY - offset
            if part > value.count - copied { part = value.count - copied }
            kept := *paint_snapshot_assets[slot][index / PAINT_SNAPSHOT_BLOCK_CAPACITY]
            for at: cast(s64)0..part - 1 { kept.bytes[offset + at] = value[copied + at] }
            copied += part
        }
        paint_snapshot_asset_counts[slot] = start + value.count
    }
    return start
}

SnapshotSpanEqual :: (slot: s32, values: bool, value: string, start: s64, count: s64) -> bool {
    if value.count != count || slot <= 0 || slot >= 9 || start < 0 ||
    count < 0 { return false }
    length := ifx values then paint_snapshot_value_counts[slot] else paint_snapshot_asset_counts[slot]
    if start > length || count > length - start { return false }
    compared: s64
    while compared < count {
        index := start + compared
        block := index / PAINT_SNAPSHOT_BLOCK_CAPACITY
        offset := index % PAINT_SNAPSHOT_BLOCK_CAPACITY
        part := cast(s64)PAINT_SNAPSHOT_BLOCK_CAPACITY - offset
        if part > count - compared { part = count - compared }
        // Native targets compare each owned byte run at once. No Vec alias
        // or borrowed view survives a mutation of the retained storage.
        if values {
            if value[compared:compared + part] != TextView(paint_snapshot_values[slot][block].bytes[offset:offset + part]) { return false }
        } else {
            if value[compared:compared + part] != TextView(paint_snapshot_assets[slot][block].bytes[offset:offset + part]) { return false }
        }
        compared += part
    }
    return true
}

SnapshotValueEqual :: (slot: s32, value: string, start: s64, count: s64) -> bool {
    return SnapshotSpanEqual(slot, true, value, start, count)
}

SnapshotAssetEqual :: (slot: s32, value: string, start: s64, count: s64) -> bool {
    return SnapshotSpanEqual(slot, false, value, start, count)
}

TextureEqual :: (left: Texture2D, right: Texture2D) -> bool {
    return left.id == right.id && left.width == right.width &&
    left.height == right.height && left.mipmaps == right.mipmaps &&
    left.format == right.format
}

PaintCommandEqual :: (slot: s32, current: PaintCommand,
    previous: PaintSnapshot) -> bool {
    if slot <= 0 || slot >= 9 { return false }
    if current.node != previous.data.node || current.kind != previous.data.kind { return false }
    if current.overlay_layer != previous.data.overlay_layer { return false }
    if current.bounds.x != previous.data.bounds.x ||
    current.bounds.y != previous.data.bounds.y ||
    current.bounds.width != previous.data.bounds.width ||
    current.bounds.height != previous.data.bounds.height { return false }
    if current.color.r != previous.data.color.r ||
    current.color.g != previous.data.color.g ||
    current.color.b != previous.data.color.b ||
    current.color.a != previous.data.color.a { return false }
    if current.end_color.r != previous.data.end_color.r ||
    current.end_color.g != previous.data.end_color.g ||
    current.end_color.b != previous.data.end_color.b ||
    current.end_color.a != previous.data.end_color.a { return false }
    if current.radius != previous.data.radius ||
    current.segments != previous.data.segments ||
    current.line_width != previous.data.line_width { return false }
    if !SnapshotValueEqual(slot, current.value, previous.value_start,
        previous.value_count) { return false }
    if current.x != previous.data.x || current.y != previous.data.y ||
    current.font != previous.data.font || current.emphasis != previous.data.emphasis ||
    current.italic != previous.data.italic { return false }
    if !SnapshotAssetEqual(slot, current.asset_path, previous.asset_start,
        previous.asset_count) { return false }
    if current.texture_id != previous.data.texture_id ||
    !TextureEqual(current.texture, previous.data.texture) { return false }
    if current.source.x != previous.data.source.x ||
    current.source.y != previous.data.source.y ||
    current.source.width != previous.data.source.width ||
    current.source.height != previous.data.source.height { return false }
    if current.clip.x != previous.data.clip.x ||
    current.clip.y != previous.data.clip.y ||
    current.clip.width != previous.data.clip.width ||
    current.clip.height != previous.data.clip.height ||
    current.clip_set != previous.data.clip_set { return false }
    if current.origin.x != previous.data.origin.x ||
    current.origin.y != previous.data.origin.y ||
    current.rotation != previous.data.rotation { return false }
    if current.smooth != previous.data.smooth { return false }
    if current.image_clip_count != previous.data.image_clip_count || current.mesh_columns != previous.data.mesh_columns ||
    current.mesh_rows != previous.data.mesh_rows { return false }
    if !SnapshotMeshEqual(slot, current, previous) { return false }
    return true
}

// A warped image is unchanged only while every one of its points is.
SnapshotMeshEqual :: (slot: s32, current: PaintCommand,
    previous: PaintSnapshot) -> bool {
    count: s64 = PaintPointCount(current)
    if count == 0 { return true }
    block: s32 = previous.mesh_block
    start: s32 = previous.mesh_start
    if current.mesh_points.count < count || block < 0 || start < 0 ||
    cast(s64)block >= paint_snapshot_meshes[slot].count { return false }
    // Read the kept block through its address. Indexing the block itself
    // copies all of its points for every point compared, which made a still
    // page of meshes (a chart of figures) take most of a second per frame.
    kept_block := *paint_snapshot_meshes[slot][block]
    if cast(s64)start + count > cast(s64)kept_block.count { return false }
    at: s32 = 0
    while cast(s64)at < count {
        point: Vector2 = current.mesh_points[at]
        kept: Vector2 = kept_block.points[start + at]
        if point.x != kept.x || point.y != kept.y { return false }
        at += 1
    }
    return true
}

PaintSnapshotInvalidate :: (session: Session) {
    if !SessionValid(session) { return }
    slot: s32 = SessionIndex(session)
    VecClear(paint_snapshots[slot])
    VecClear(paint_snapshot_values[slot])
    VecClear(paint_snapshot_assets[slot])
    VecClear(paint_snapshot_meshes[slot])
    paint_snapshot_value_counts[slot] = 0
    paint_snapshot_asset_counts[slot] = 0
    paint_snapshots_valid[slot] = false
    frame_paint_unchanged[slot] = false
}

PaintSnapshotStore :: (session: Session) -> bool {
    slot: s32 = SessionIndex(session)
    VecClear(paint_snapshots[slot])
    VecClear(paint_snapshot_values[slot])
    VecClear(paint_snapshot_assets[slot])
    VecClear(paint_snapshot_meshes[slot])
    paint_snapshot_value_counts[slot] = 0
    paint_snapshot_asset_counts[slot] = 0
    index: s32 = 0
    while cast(s64)index < pending_paint[slot].items.count {
        current: PaintCommand = PendingPaintAt(session, index)
        previous: PaintSnapshot
        previous.data = current
        previous.emit = pending_paint[slot].items[index].emit
        previous.has_emitter = pending_paint[slot].items[index].has_emitter
        previous.builtin_emitter = pending_paint[slot].items[index].builtin_emitter
        previous.value_start = SnapshotTextAppend(slot, true, current.value)
        if previous.value_start < 0 {
            PaintSnapshotInvalidate(session)
            return false
        }
        previous.value_count = current.value.count
        previous.asset_start = SnapshotTextAppend(slot, false, current.asset_path)
        if previous.asset_start < 0 {
            PaintSnapshotInvalidate(session)
            return false
        }
        previous.asset_count = current.asset_path.count
        mesh_count: s64 = PaintPointCount(current)
        if mesh_count > 0 {
            kept := KeepMeshPoints(*paint_snapshot_meshes[slot],
                current.mesh_points, mesh_count, 0.0, 0.0)
            if !kept.valid {
                PaintSnapshotInvalidate(session)
                return false
            }
            previous.mesh_block = kept.block
            previous.mesh_start = kept.start
        }
        if !VecPush(paint_snapshots[slot], previous) {
            PaintSnapshotInvalidate(session)
            return false
        }
        index += 1
    }
    paint_snapshots_valid[slot] = true
    return true
}

// Short strings borrow the immutable snapshot block. A string spanning
// blocks is joined only when a host needs the paint emitted again.
SnapshotTextRead :: (slot: s32, values: bool, start: s64, count: s64) -> string {
    if count == 0 { return "" }
    length := ifx values then paint_snapshot_value_counts[slot] else paint_snapshot_asset_counts[slot]
    if start < 0 || count < 0 || start > length || count > length - start { return "" }
    block := start / PAINT_SNAPSHOT_BLOCK_CAPACITY
    offset := start % PAINT_SNAPSHOT_BLOCK_CAPACITY
    if count <= cast(s64)PAINT_SNAPSHOT_BLOCK_CAPACITY - offset {
        if values { return TextView(paint_snapshot_values[slot][block].bytes[offset:offset + count]) }
        return TextView(paint_snapshot_assets[slot][block].bytes[offset:offset + count])
    }
    return ""
}

SnapshotTextJoin :: (slot: s32, values: bool, start: s64, count: s64,
    joined: *Vec(u8)) -> bool {
    length := ifx values then paint_snapshot_value_counts[slot] else paint_snapshot_asset_counts[slot]
    if start < 0 || count < 0 || start > length || count > length - start { return false }
    VecClear(joined.*)
    copied: s64
    while copied < count {
        index := start + copied
        block := index / PAINT_SNAPSHOT_BLOCK_CAPACITY
        offset := index % PAINT_SNAPSHOT_BLOCK_CAPACITY
        part := cast(s64)PAINT_SNAPSHOT_BLOCK_CAPACITY - offset
        if part > count - copied { part = count - copied }
        if values {
            if !BuilderAppend(joined.*, TextView(paint_snapshot_values[slot][block].bytes[offset:offset + part])) { return false }
        } else {
            if !BuilderAppend(joined.*, TextView(paint_snapshot_assets[slot][block].bytes[offset:offset + part])) { return false }
        }
        copied += part
    }
    return true
}

PaintSnapshotEmit :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    slot := SessionIndex(session)
    if !paint_snapshots_valid[slot] { return false }
    value_text: Vec(u8)
    asset_text: Vec(u8)
    defer { VecFree(value_text); VecFree(asset_text) }
    for index: cast(s64)0..paint_snapshots[slot].count - 1 {
        previous := paint_snapshots[slot][index]
        command: QueuedPaint
        command.data = previous.data
        command.data.value = SnapshotTextRead(slot, true, previous.value_start, previous.value_count)
        if command.data.value.count != previous.value_count {
            if !SnapshotTextJoin(slot, true, previous.value_start, previous.value_count, *value_text) { return false }
            command.data.value = TextView(VecSlice(value_text, 0, value_text.count))
        }
        command.data.asset_path = SnapshotTextRead(slot, false, previous.asset_start, previous.asset_count)
        if command.data.asset_path.count != previous.asset_count {
            if !SnapshotTextJoin(slot, false, previous.asset_start, previous.asset_count, *asset_text) { return false }
            command.data.asset_path = TextView(VecSlice(asset_text, 0, asset_text.count))
        }
        mesh_count: s32 = cast(s32)PaintPointCount(previous.data)
        if mesh_count > 0 {
            command.data.mesh_points = paint_snapshot_meshes[slot][previous.mesh_block].points[previous.mesh_start:
            previous.mesh_start + mesh_count]
        }
        command.emit = previous.emit
        command.has_emitter = previous.has_emitter
        command.builtin_emitter = previous.builtin_emitter
        EmitPaint(command)
    }
    return true
}

#program_export
PaintPlanUnchanged :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    slot: s32 = SessionIndex(session)
    if !paint_snapshots_valid[slot] { return false }
    if pending_paint[slot].items.count != paint_snapshots[slot].count { return false }
    index: s32 = 0
    while cast(s64)index < pending_paint[slot].items.count {
        if !pending_paint[slot].items[index].builtin_emitter || !paint_snapshots[slot][index].builtin_emitter ||
        pending_paint[slot].items[index].has_emitter != paint_snapshots[slot][index].has_emitter { return false }
        if !PaintCommandEqual(slot, PendingPaintAt(session, index),
            paint_snapshots[slot][index]) { return false }
        index += 1
    }
    return true
}

// The area a builtin command may cover, in layout units and widened for
// anti-aliased edges, or false when only repainting everything is safe.
// Text is bounded without measuring: no glyph is wider than its font size
// per byte, nor a line taller than twice the font size.
PaintCommandArea :: (command: PaintCommand, area: *Rectangle) -> bool {
    margin: float32 = 2.0 + command.line_width
    kind := command.kind
    if kind == PaintKindClippedText || kind == PaintKindImage ||
    (kind == PaintKindText && (command.italic || command.emphasis)) {
        // These draw only inside their clip.
        area.* = Rectangle.{command.clip.x - margin, command.clip.y - margin,
            command.clip.width + margin * 2.0, command.clip.height + margin * 2.0}
        return command.clip.width > 0.0 && command.clip.height > 0.0
    }
    if kind == PaintKindText {
        lines: s32 = 1
        for byte: command.value { if byte == #char "\n" { lines += 1 } }
        font := cast(float32)command.font
        area.* = Rectangle.{cast(float32)command.x - font, cast(float32)command.y - font,
            cast(float32)command.value.count * font + font * 2.0, cast(float32)lines * font * 2.0 + font * 2.0}
        return true
    }
    if kind < PaintKindLine || kind > PaintKindShapeTriangle { return false }
    bounds := command.bounds
    if bounds.width < 0.0 { bounds.x += bounds.width; bounds.width = -bounds.width }
    if bounds.height < 0.0 { bounds.y += bounds.height; bounds.height = -bounds.height }
    area.* = Rectangle.{bounds.x - margin, bounds.y - margin,
        bounds.width + margin * 2.0, bounds.height + margin * 2.0}
    if command.clip_set {
        area.* = RectangleIntersection(area.*, Rectangle.{command.clip.x - margin, command.clip.y - margin,
                command.clip.width + margin * 2.0, command.clip.height + margin * 2.0})
    }
    return true
}

PaintAreaJoin :: (area: *Rectangle, joined: *bool, next: Rectangle) {
    if next.width <= 0.0 || next.height <= 0.0 { return }
    if !joined.* {
        area.* = next
        joined.* = true
        return
    }
    left := ifx next.x < area.x then next.x else area.x
    top := ifx next.y < area.y then next.y else area.y
    right := ifx next.x + next.width > area.x + area.width then next.x + next.width else area.x + area.width
    bottom := ifx next.y + next.height > area.y + area.height then next.y + next.height else area.y + area.height
    area.* = Rectangle.{left, top, right - left, bottom - top}
}

PaintFrameDamage :: struct {
    unchanged: bool
    // Only `area` differs from the previous frame's paint.
    partial: bool
    area: Rectangle
}

// Places that changed apart are also kept apart, so a host can repaint
// each alone: a figure bobbing above a board and a piece moving below it
// need not repaint the whole board between them. Together they lie within
// the frame's `area`, and no two of them touch.
PAINT_DAMAGE_AREA_LIMIT :: 4
PaintDamageAreas :: struct {
    count: s32
    areas: [PAINT_DAMAGE_AREA_LIMIT]Rectangle
}
paint_damage_areas: [9]PaintDamageAreas;

PaintAreasNear :: (first: Rectangle, second: Rectangle) -> bool {
    // A host widens each area to whole device pixels; keep them apart by more.
    gap: float32 = 4.0
    return first.x <= second.x + second.width + gap && second.x <= first.x + first.width + gap &&
        first.y <= second.y + second.height + gap && second.y <= first.y + first.height + gap
}

PaintAreasUnion :: (first: Rectangle, second: Rectangle) -> Rectangle {
    area := first
    joined := true
    PaintAreaJoin(*area, *joined, second)
    return area
}

PaintDamageAdd :: (damage: *PaintDamageAreas, next: Rectangle) {
    if next.width <= 0.0 || next.height <= 0.0 { return }
    merged := next
    index: s32 = 0
    while index < damage.count {
        if PaintAreasNear(damage.areas[index], merged) {
            // The grown area may now reach one already passed.
            merged = PaintAreasUnion(damage.areas[index], merged)
            damage.count -= 1
            damage.areas[index] = damage.areas[damage.count]
            index = 0
        } else {
            index += 1
        }
    }
    if damage.count < PAINT_DAMAGE_AREA_LIMIT {
        damage.areas[damage.count] = merged
        damage.count += 1
        return
    }
    // With every area in use, the new one joins the area it grows least.
    best: s32 = 0
    growth: float32 = 0.0
    for at: cast(s32)0..damage.count - 1 {
        area := damage.areas[at]
        both := PaintAreasUnion(area, merged)
        grows := both.width * both.height - area.width * area.height
        if at == 0 || grows < growth {
            best = at
            growth = grows
        }
    }
    grown := PaintAreasUnion(damage.areas[best], merged)
    damage.count -= 1
    damage.areas[best] = damage.areas[damage.count]
    PaintDamageAdd(damage, grown)
}

// The separate areas of the damage the last committed frame reported.
#program_export
PaintDamageAreaCount :: (session: Session) -> s32 {
    if !SessionValid(session) { return 0 }
    return paint_damage_areas[SessionIndex(session)].count
}

#program_export
PaintDamageAreaAt :: (session: Session, index: s32) -> Rectangle {
    empty: Rectangle
    if !SessionValid(session) { return empty }
    damage := *paint_damage_areas[SessionIndex(session)]
    if index < 0 || index >= damage.count { return empty }
    return damage.areas[index]
}

// Compares this frame's paint with the previous frame's, command by command,
// and joins the areas of the commands that differ, as they were and as they
// are now. A command painted by its own emitter makes the whole frame differ.
PaintDamage :: (session: Session) -> PaintFrameDamage {
    result: PaintFrameDamage
    if !SessionValid(session) { return result }
    slot: s32 = SessionIndex(session)
    paint_damage_areas[slot].count = 0
    if !paint_snapshots_valid[slot] { return result }
    count := pending_paint[slot].items.count
    previous := paint_snapshots[slot].count
    total := ifx count > previous then count else previous
    joined: bool
    area: Rectangle
    for index: cast(s64)0..total - 1 {
        if index < count && !pending_paint[slot].items[index].builtin_emitter { return result }
        if index < previous && !paint_snapshots[slot][index].builtin_emitter { return result }
        current: PaintCommand
        if index < count { current = PendingPaintAt(session, cast(s32)index) }
        if index < count && index < previous &&
        pending_paint[slot].items[index].has_emitter == paint_snapshots[slot][index].has_emitter &&
        PaintCommandEqual(slot, current, paint_snapshots[slot][index]) { continue }
        box: Rectangle
        if index < count {
            if !PaintCommandArea(current, *box) { return result }
            PaintAreaJoin(*area, *joined, box)
            PaintDamageAdd(*paint_damage_areas[slot], box)
        }
        if index < previous {
            kept := paint_snapshots[slot][index]
            before := kept.data
            before.value = SnapshotTextRead(slot, true, kept.value_start, kept.value_count)
            if before.value.count != kept.value_count || !PaintCommandArea(before, *box) { return result }
            PaintAreaJoin(*area, *joined, box)
            PaintDamageAdd(*paint_damage_areas[slot], box)
        }
        if !joined { return result }
    }
    result.unchanged = !joined
    result.partial = joined
    result.area = area
    return result
}

// Emits only the commands that may touch `area`, for a host that kept the
// previous frame's pixels everywhere else and clips this paint to the area.
#program_export
PaintFlushArea :: (session: Session, area: Rectangle) {
    areas: [1]Rectangle = .{area}
    PaintFlushAreas(session, areas[:])
}

// The same for several areas at once, with the paint clipped to all of them:
// each command that may touch one is emitted once.
#program_export
PaintFlushAreas :: (session: Session, areas: []Rectangle) {
    if PaintOverflow(session) || !PaintOrder(session) { PaintClear(session); return }
    index: s32 = 0
    while cast(s64)index < pending_paint[SessionIndex(session)].items.count {
        slot := SessionIndex(session)
        queued := *pending_paint[slot].items[index]
        if queued.has_emitter {
            data := PendingPaintAt(session, index)
            box: Rectangle
            touched := !queued.builtin_emitter || !PaintCommandArea(data, *box)
            for area: areas {
                if touched { break }
                overlap := RectangleIntersection(box, area)
                touched = overlap.width > 0.0 && overlap.height > 0.0
            }
            if touched {
                resolved := queued.*
                resolved.data = data
                EmitPaint(resolved)
            }
        }
        index += 1
    }
    PaintClear(session)
}

#program_export
FramePaintUnchanged :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    return frame_paint_unchanged[SessionIndex(session)]
}

#program_export
PaintFlush :: (session: Session) {
    if PaintOverflow(session) || !PaintOrder(session) { PaintClear(session); return }
    index: s32 = 0
    while cast(s64)index < pending_paint[SessionIndex(session)].items.count {
        slot := SessionIndex(session)
        // Read the callback before invoking it; it may append paint or close
        // the session. Only the command data crosses that call, by value.
        queued := *pending_paint[slot].items[index]
        if queued.has_emitter {
            resolved := queued.*
            resolved.data = PendingPaintAt(session, index)
            EmitPaint(resolved)
        }
        index += 1
    }
    PaintClear(session)
}

#program_export
PaintDispose :: (session: Session) {
    if !SessionValid(session) { return }
    VecFree(pending_paint[session.slot].items)
    VecFree(ordered_paint[session.slot])
    VecFree(paint_snapshots[session.slot])
    VecFree(paint_snapshot_values[session.slot])
    VecFree(paint_snapshot_assets[session.slot])
    VecFree(paint_snapshot_meshes[session.slot])
    VecFree(pending_short_text[session.slot])
    VecFree(pending_medium_text[session.slot])
    VecFree(pending_text[session.slot])
    VecFree(pending_mesh[session.slot])
    pending_paint[session.slot].overflow = false
    paint_snapshot_value_counts[session.slot] = 0
    paint_snapshot_asset_counts[session.slot] = 0
    paint_snapshots_valid[session.slot] = false
    frame_paint_unchanged[session.slot] = false
}
