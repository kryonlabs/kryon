// Canvas and DOM use PageImageDecode and the browser's own AVIF decoder.
// The page reports the browser's AVIF capability explicitly. Without it,
// Kryon's defined behaviour is a clean decode failure for every AVIF input
// (null pixels, zero size: the image is treated as undecodable) while other
// formats keep decoding; there is no partial or substituted image.
#import "page_texture"
#import "web"
#import "file"
#import "text_tools"
#import "std/byte_text_linux"
browser_c :: #system_library "c";
Release :: (pixels: *void) #foreign browser_c "free";
Report :: (text: string) {
    scope := WebScope()
    document := WebGetObject(WebGlobal, WebName("document"))
    result := WebAsObject(WebCall1(document, WebName("getElementById"), WebText("result")))
    WebSet(result, WebName("textContent"), WebText(text))
    WebEnd(scope)
}
Fixture :: (name: string, extension: string) -> string {
    parts: [3]string = .["/avif/", name, extension]
    data, ok := ReadEntireFile(TextJoin(parts[:], ""))
    if !ok { return "" }
    return data
}
Decode :: (data: string, width: *s32, height: *s32) -> *u8 {
    width.* = 0; height.* = 0
    descriptor := cast(*TextDescriptor)(*data)
    return PageImageDecode(descriptor.data, cast(s32)data.count, width, height)
}
// Explicit capability probe: can this browser's own decoder produce the
// smallest AVIF fixture's frame?
AvifBrowserSupported :: () -> bool {
    width: s32; height: s32
    pixels := Decode(Fixture("rgba8", ".avif"), *width, *height)
    if pixels == null { return false }
    Release(cast(*void)pixels)
    return width == 8 && height == 6
}
Golden :: (pixels: *u8, golden: string) -> bool {
    for i: 0..golden.count - 1 {
        alpha := cast(u8)golden[(i / 4) * 4 + 3]
        if alpha == 0 && i % 4 != 3 { continue }
        difference := cast(s32)pixels[i] - cast(s32)golden[i]
        if difference < -5 || difference > 5 { return false }
    }
    return true
}
Check :: () -> string {
    // A non-AVIF control image decodes regardless of AVIF support.
    width: s32; height: s32
    control := Decode(Fixture("control", ".png"), *width, *height)
    if control == null || width != 8 || height != 6 || !Golden(control, Fixture("rgba8", ".rgba")) { return "control" }
    Release(cast(*void)control)
    supported := AvifBrowserSupported()
    names: [9]string = .["rgba8", "rgba10", "rgba12", "gray8", "gray10", "gray12", "opaque", "premultiplied", "animated"]
    for name: names {
        data := Fixture(name, ".avif")
        if data.count == 0 { return "fixture" }
        pixels := Decode(data, *width, *height)
        if !supported {
            if pixels != null || width != 0 || height != 0 { return name }
            continue
        }
        golden := Fixture(name, ".rgba")
        if golden.count == 0 { return "golden" }
        if pixels == null || width != 8 || height != 6 { return name }
        good := Golden(pixels, golden)
        Release(cast(*void)pixels)
        if !good { return name }
    }
    // Decoder classes Kryon apps ship: small 4:4:4 UI art with alpha, a 4:4:4
    // photo and a real Jungle q35 asset.
    corpus: [3]string = .["ui-icon-444", "photo-444", "jungle-clownfish"]
    sizes: [3]s32 = .[48, 768, 940]
    heights: [3]s32 = .[48, 576, 940]
    for name, index: corpus {
        pixels := Decode(Fixture(name, ".avif"), *width, *height)
        if !supported {
            if pixels != null || width != 0 || height != 0 { return name }
            continue
        }
        if pixels == null || width != sizes[index] || height != heights[index] { return name }
        Release(cast(*void)pixels)
    }
    return ifx supported then "PASS supported" else "PASS unsupported"
}
#program_export
main :: () -> s32 { Report(Check()); return 0 }
