#import "kryon.h"

# Declarative port of inbe's settings screen (device tab), in the same
# spirit as the language picker: scrollable setting rows with toggles,
# a language dropdown, orientation dropdown, and a fullscreen checkbox.
# Everything the cartridge cannot own yet (persisting, system calls)
# stays host-side; the layout, widgets, and conditional rows are
# cartridge-owned.

state {
    scroll_off: int = 0
    language_index: int = 0
    orientation_index: int = 0
    fullscreen: int = 0
    keep_screen_on: int = 1
    language_options: [5] const char * = {"System", "English", "Portugues", "Espanol", "Deutsch"}
    orientation_options: [4] const char * = {"System", "Portrait", "Landscape", "Sensor"}
}

app "Inner Breeze — Settings" {
    size 480 640
    fps 60
}

App :: () #ui {
    Screen root: {
        ClearBackground(GetThemeBackground())
        Background(GetThemeSurface())
        Text("Settings", ScaleUIPx(70), ScaleUIPx(28), Text24, GetThemeText())
        Text("Device", ScaleUIPx(40), ScaleUIPx(80), Text16, GetThemeIcon())
        settings_area: UIScrollArea = {{ScaleUIPx(40), ScaleUIPx(110), ScaleUIPx(400), ScaleUIPx(480)}, ScaleUIPx(820), ScaleUIPx(40), ScaleUIPx(400), &scroll_off, 0, 0}
        settings_view: UIScrollView = BeginUIScrollContainer(settings_area)
        Text("Language", settings_view.content_x, settings_view.content_y + ScaleUIPx(10), Text16, GetThemeText())
        Dropdown(101, settings_view.content_x, settings_view.content_y + ScaleUIPx(36), ScaleUIPx(340), ScaleUIPx(36), language_options, 5, &language_index)
        Text("Orientation", settings_view.content_x, settings_view.content_y + ScaleUIPx(120), Text16, GetThemeText())
        Dropdown(103, settings_view.content_x, settings_view.content_y + ScaleUIPx(146), ScaleUIPx(340), ScaleUIPx(36), orientation_options, 4, &orientation_index)
        Checkbox(0, settings_view.content_x, settings_view.content_y + ScaleUIPx(230), "Fullscreen", &fullscreen)
        Checkbox(0, settings_view.content_x, settings_view.content_y + ScaleUIPx(270), "Keep screen on", &keep_screen_on)
        if (fullscreen == 1) {
            Text("Restarts the app to apply", settings_view.content_x, settings_view.content_y + ScaleUIPx(310), Text16, GetThemeIcon())
        } else {
            Text("Uses the display the app started on", settings_view.content_x, settings_view.content_y + ScaleUIPx(310), Text16, GetThemeIcon())
        }
        if (keep_screen_on == 1) {
            Text("The screen stays awake during sessions", settings_view.content_x, settings_view.content_y + ScaleUIPx(350), Text16, GetThemeIcon())
        }
        EndUIScrollContainer(settings_area, settings_view)
    }
}
