Services :: #import "pixmap_assets_android";
Decode :: #import "android_image_decode";
Raster :: #import "pixmap";
Jni :: #import "android_jni";
Cleanup :: #import "android_host_cleanup";
#import "android_native_test_host"
#import "image_integration_fixture"
#import "webp_fixture_checks"
#import "std/byte_text_linux"

functions: Jni.JniFunctions;
vm_functions: Jni.JniVmFunctions;
env: Jni.JniEnv;
vm: Jni.JniVm;
activity: Jni.NativeActivity;
app: Jni.NativeAndroidApp;
frames: s32;
references: s32;
bitmap_calls: s32;
bad_bitmap: bool;
bitmap: [4]u32 = .[2, 1, 0x80341256, 0xff090807];

GetEnv :: (input: *Jni.JniVm, output: **Jni.JniEnv, version: s32) -> s32 {
    unused input; unused version; output.* = *env; return 0
}
Push :: (input: *Jni.JniEnv, capacity: s32) -> s32 { unused input; unused capacity; frames += 1; return 0 }
Pop :: (input: *Jni.JniEnv, result: *void) -> *void { unused input; frames -= 1; return result }
Exception :: (input: *Jni.JniEnv) -> u8 { unused input; return 0 }
Clear :: (input: *Jni.JniEnv) { unused input }
ObjectClass :: (input: *Jni.JniEnv, object: *void) -> *void {
    unused input; unused object; references += 1; return cast(*void)cast(usize)1
}
Method :: (input: *Jni.JniEnv, klass: *void, name: *u8, signature: *u8) -> *void {
    unused input; unused klass
    if TextFromCString(name) != "decodeBundleImage" || TextFromCString(signature) != "([B)[I" { return null }
    return cast(*void)cast(usize)2
}
Delete :: (input: *Jni.JniEnv, object: *void) { unused input; unused object; references -= 1 }
NewBytes :: (input: *Jni.JniEnv, count: s32) -> *void {
    unused input; unused count; references += 1; return cast(*void)cast(usize)3
}
SetBytes :: (input: *Jni.JniEnv, array: *void, start: s32, count: s32, bytes: *u8) {
    unused input; unused array; unused start; unused count; unused bytes
}
Call :: (input: *Jni.JniEnv, object: *void, method: *void, arguments: *Jni.JniValue) -> *void {
    unused input; unused object; unused method; unused arguments
    bitmap_calls += 1; references += 1; return cast(*void)cast(usize)4
}
Length :: (input: *Jni.JniEnv, array: *void) -> s32 { unused input; unused array; return 4 }
ReadInts :: (input: *Jni.JniEnv, array: *void, start: s32, count: s32, output: *s32) {
    unused input; unused array
    for at: cast(s32)0..count - 1 { output[at] = cast(s32)bitmap[start + at] }
    if bad_bitmap && start == 0 { output[0] = 1; output[1] = 2 }
}
MockActivity :: () {
    vm_functions.GetEnv = GetEnv
    functions.PushLocalFrame = Push; functions.PopLocalFrame = Pop
    functions.ExceptionCheck = Exception; functions.ExceptionClear = Clear
    functions.ExceptionDescribe = Clear; functions.GetObjectClass = ObjectClass
    functions.GetMethodID = Method; functions.DeleteLocalRef = Delete
    functions.NewByteArray = NewBytes; functions.SetByteArrayRegion = SetBytes
    functions.CallObjectMethodA = Call; functions.GetArrayLength = Length
    functions.GetIntArrayRegion = ReadInts
    env.functions = *functions; vm.functions = *vm_functions
    activity.vm = *vm; activity.activity = cast(*void)cast(usize)5
    app.activity = *activity; Jni.jni_android_app = *app
}

CheckPreview :: (data: string, width: s32, height: s32, expected: []u8) -> bool {
    w: s32; h: s32; channels: s32; upright: bool
    pixels := Services.ImagePreviewDecode(data, ".wrong", *w, *h, *channels, *upright)
    defer Services.ImagePreviewRelease(pixels)
    if pixels == null || w != width || h != height || channels != 4 || !upright { return false }
    for at: 0..expected.count - 1 { if pixels[at] != expected[at] { return false } }
    return true
}

#program_export
main :: () -> s32 {
    png := Fixture("build/scratch/image-pixels", "rgba", ".png"); defer VecFree(png)
    png_data := TextFromBytes(png[:])
    expected: [8]u8 = .[173, 61, 219, 97, 19, 203, 41, 255]
    if !CheckPreview(png_data, 2, 1, expected[:]) { return 1 }
    webp := Fixture("tests/fixtures/webp", "lossless", ".webp"); defer VecFree(webp)
    decoded := Decode.AndroidImageDecodeEncoded(TextFromBytes(webp[:]), ".png")
    if decoded.pixels == null || WebPFixtureCheck("lossless", decoded.pixels, decoded.width, decoded.height, 0).count != 0 { return 2 }
    Services.ImagePreviewRelease(decoded.pixels)
    avif := Fixture("tests/fixtures/avif", "transform31", ".avif"); defer VecFree(avif)
    golden := Fixture("tests/fixtures/avif", "transform31", ".rgba"); defer VecFree(golden)
    if golden.count != 64 || !CheckPreview(TextFromBytes(avif[:]), 4, 4, golden[:]) { return 3 }

    // The VM is a deterministic OS boundary here. Real PNG, WebP and AVIF
    // decoding above uses native package codecs; this checks bitmap JNI
    // ownership, dimension checks and Exif transformation independently.
    MockActivity()
    jpeg := Fixture("build/scratch/android-image-services", "orientation6", ".jpg"); defer VecFree(jpeg)
    jpeg_expected: [8]u8 = .[52, 18, 86, 128, 9, 8, 7, 255]
    if !CheckPreview(TextFromBytes(jpeg[:]), 1, 2, jpeg_expected[:]) || bitmap_calls != 1 || frames != 0 || references != 0 { return 4 }
    bad_bitmap = true
    if Decode.AndroidImageDecodeEncoded(TextFromBytes(jpeg[:]), "").pixels != null || frames != 0 || references != 0 { return 5 }
    bad_bitmap = false
    huge := Fixture("build/scratch/android-image-services", "huge", ".png"); defer VecFree(huge)
    w: s32 = 99; h: s32 = 99; channels: s32 = 99; upright: bool
    if Services.ImagePreviewDecode(TextFromBytes(huge[:]), ".png", *w, *h, *channels, *upright) != null ||
        w != 0 || h != 0 || channels != 0 || bitmap_calls != 2 { return 6 }
    if Decode.AndroidImageDecodeEncoded("invalid", "").pixels != null || Decode.AndroidImageDecodeEncoded(png_data[:20], "").pixels != null { return 7 }

    if !Services.PixmapLoadImageBytes("pictures/a.png", png_data, "") || Services.android_picture_bytes != 8 { return 8 }
    slot := Raster.PixmapImageIndex("pictures/a.png")
    if slot < 0 || Raster.pixmap_image_pixels[slot].value[0] != cast(u32)0x61ad3ddb { return 9 }
    previous := *Raster.pixmap_image_pixels[slot].value[0]
    if Services.PixmapLoadImageBytes("pictures/a.png", "invalid", "") || *Raster.pixmap_image_pixels[slot].value[0] != previous { return 10 }
    if !Services.PixmapLoadImageBytes("pictures/a.png", TextFromBytes(webp[:]), "") || Services.android_picture_bytes != 24 { return 11 }
    if !Services.PixmapLoadImageBytes("pictures/b.png", png_data, "") || !Services.PixmapLoadImageBytes("pictures-extra/c.png", png_data, "") { return 12 }
    if Services.RasterInvalidateImagesIn("pictures/") != 2 || Services.android_picture_bytes != 8 || Raster.PixmapImageIndex("pictures-extra/c.png") < 0 { return 13 }
    slot = Raster.PixmapImageIndex("pictures-extra/c.png")
    // An app can replace an owned picture with borrowed pixels. Releasing
    // the previous allocation must not claim ownership of the new slice.
    borrowed: [1]u32 = .[cast(u32)0xff112233]
    if !Raster.PixmapSetImage(slot, "borrowed", 1, 1, borrowed[:]) || Services.android_picture_bytes != 0 { return 14 }
    if !Services.RasterInvalidateImage("borrowed") || borrowed[0] != cast(u32)0xff112233 || Services.RasterInvalidateImage("borrowed") { return 15 }
    if !Services.PixmapLoadImageBytes("/picture", png_data, "") || !Services.PixmapLoadImageBytes("relative", png_data, "") { return 16 }
    if Services.RasterInvalidateImagesIn("/") != 1 || Services.android_picture_bytes != 8 { return 17 }
    Cleanup.AndroidHostResourcesClose()
    if Services.android_picture_bytes != 0 || Raster.PixmapImageIndex("relative") >= 0 { return 18 }
    if Services.RasterInvalidateImages() != 0 || Services.PixmapLoadImageBytes("", png_data, "") { return 19 }
    Services.ImagePreviewRelease(null)
    print("Android image services: native RGBA/orientation, bounded bitmap JNI, owned cache replacement, folder invalidation and cleanup passed\n")
    return 0
}
