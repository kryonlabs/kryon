#import "geometry"
#import "layout"

GroupPolicy :: struct {
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
}

#program_export
GroupPolicyFor :: (bounds: Rectangle, gap: s32, padding: s32) -> GroupPolicy {
    metrics: LayoutMetrics = LayoutMetricsFor(bounds, gap, padding)
    policy: GroupPolicy
    policy.bounds = bounds
    policy.content = metrics.content
    policy.gap = metrics.gap
    policy.padding = metrics.padding
    return policy
}

#program_export
ScreenGroupPolicyFor :: (bounds: Rectangle, fallback_width: s32,
    fallback_height: s32, gap: s32, padding: s32) -> GroupPolicy {
    scoped: Rectangle = LayoutScopeBounds(bounds, fallback_width, fallback_height)
    return GroupPolicyFor(scoped, gap, padding)
}
