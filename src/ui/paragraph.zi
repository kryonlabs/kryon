#import "text_align"

ParagraphMetrics :: struct {
    font: s32
    line_gap: s32
    icon_size: s32
    width: s32
    height: s32
    next_y: s32
}

ParagraphLayoutPolicy :: struct {
    space_width: s32
    icon_spacing: s32
    line_gap: s32
}

ParagraphToken :: struct {
    start: s32
    end: s32
    next: s32
    valid: bool
    line_break: bool
    icon: bool
}

ParagraphLine :: struct {
    start: s32
    end: s32
    width: float32
    has_content: bool
}

ParagraphLineDecision :: struct {
    line: ParagraphLine
    next: ParagraphLine
    emit: bool
}

# Hosts copy these borrowed byte ranges and measure their text. Whitespace,
# explicit line breaks and inline icon recognition are shared language policy.
# Non-breaking spaces and other UTF-8 sequences remain inside their word.
ParagraphIsSpace :: (value: u8) -> bool {
    return value == cast(u8)32 || value == cast(u8)9 ||
    value == cast(u8)11 || value == cast(u8)12
}

#program_export
ParagraphTokenNext :: (text: string, offset: s32, icons: bool) -> ParagraphToken {
    token: ParagraphToken
    if offset < 0 {
        offset = 0
    }
    while offset < (cast(s32)text.count) && ParagraphIsSpace(text[offset]) {
        offset += 1
    }
    token.start = offset
    token.end = offset
    token.next = offset
    if offset >= (cast(s32)text.count) {
        return token
    }
    token.valid = true
    value: u8 = text[offset]
    if value == cast(u8)10 || value == cast(u8)13 {
        token.line_break = true
        offset += 1
        if value == cast(u8)13 && offset < (cast(s32)text.count) && text[offset] == cast(u8)10 {
            offset += 1
        }
    } else if icons && value == cast(u8)37 && offset + 1 < (cast(s32)text.count) &&
    text[offset + 1] == cast(u8)105 {
        token.icon = true
        offset += 2
    } else {
        while offset < (cast(s32)text.count) {
            value = text[offset]
            if ParagraphIsSpace(value) || value == cast(u8)10 || value == cast(u8)13 {
                break
            }
            if icons && value == cast(u8)37 && offset + 1 < (cast(s32)text.count) &&
            text[offset + 1] == cast(u8)105 {
                break
            }
            offset += 1
        }
    }
    token.end = offset
    token.next = offset
    return token
}

#program_export
ParagraphTextSeparator :: (line: ParagraphLine) -> string {
    if line.has_content {
        return " "
    }
    return ""
}

# The host supplies both the standalone element width and the measured joined
# candidate (including shaping/letter spacing). No renderer chooses wrap points.
# An oversized first element stays on its line; it never emits a phantom blank.
#program_export
ParagraphLineAdvance :: (line: ParagraphLine, index: s32,
line_break: bool, end: bool, element_width: float32, candidate_width: float32,
max_width: float32) -> ParagraphLineDecision {
    decision: ParagraphLineDecision
    decision.next = line
    if line_break || end {
        decision.emit = true
        decision.line = line
        decision.next = ParagraphLine.{.start = index + 1, .end = index + 1}
        return decision
    }
    if element_width < 0.0 {
        element_width = 0.0
    }
    if candidate_width < 0.0 {
        candidate_width = 0.0
    }
    if line.has_content && max_width > 0.0 && candidate_width > max_width {
        decision.emit = true
        decision.line = line
        decision.next = ParagraphLine.{.start = index}
    }
    decision.next.width = candidate_width
    if !decision.next.has_content {
        decision.next.width = element_width
    }
    decision.next.end = index + 1
    decision.next.has_content = true
    return decision
}

#program_export
ParagraphElementSpacing :: (has_content: bool, icon: bool,
policy: ParagraphLayoutPolicy) -> s32 {
    if !has_content {
        return 0
    }
    if icon {
        return policy.icon_spacing
    }
    return policy.space_width
}

#program_export
ParagraphResolveMetrics :: (requested_font: s32, default_font: s32,
requested_line_gap: s32, default_line_gap: s32, requested_icon_size: s32,
requested_width: s32, fallback_width: s32, measured_height: s32,
current_y: s32) -> ParagraphMetrics {
    metrics: ParagraphMetrics
    metrics.font = requested_font
    if metrics.font <= 0 { metrics.font = default_font }
    metrics.line_gap = requested_line_gap
    if metrics.line_gap <= 0 { metrics.line_gap = default_line_gap }
    metrics.icon_size = requested_icon_size
    if metrics.icon_size <= 0 { metrics.icon_size = metrics.font }
    metrics.width = requested_width
    if metrics.width <= 0 { metrics.width = fallback_width }
    if metrics.width < 0 { metrics.width = 0 }
    metrics.height = measured_height
    if metrics.height <= 0 { metrics.height = metrics.font + metrics.line_gap }
    metrics.next_y = current_y + metrics.height
    return metrics
}

#program_export
ParagraphCanLayout :: (width: s32) -> bool {
    return width > 0
}

#program_export
ParagraphDefaultLineGap :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(4.0 * scale)
}

#program_export
ParagraphLayoutPolicyFor :: (space_text_width: s32, letter_spacing: s32, requested_line_gap: s32, default_line_gap: s32, scale: float32) -> ParagraphLayoutPolicy {
    policy: ParagraphLayoutPolicy
    policy.space_width = space_text_width + 2 * letter_spacing
    if policy.space_width < 0 { policy.space_width = 0 }
    policy.icon_spacing = cast(s32)(4.0 * scale + 0.5)
    policy.line_gap = requested_line_gap
    if policy.line_gap <= 0 { policy.line_gap = default_line_gap }
    return policy
}

#program_export
ParagraphLayoutTotalHeight :: (line_count: s32, drawn_line_height: s32,
line_gap: s32) -> s32 {
    if line_count <= 0 { return 0 }
    height: s32 = line_count * drawn_line_height
    if line_count > 1 { height += (line_count - 1) * line_gap }
    if height < 0 { return 0 }
    return height
}

#program_export
ParagraphLineXFor :: (x: s32, width: s32, line_width: s32, align: s32) -> s32 {
    spare: s32 = width - line_width
    if align == TextAlignCenter { return x + spare / 2 }
    if align == TextAlignEnd { return x + spare }
    return x
}

#program_export
ParagraphNextLineY :: (current_y: s32, drawn_line_height: s32,
line_gap: s32, has_next_line: bool) -> s32 {
    next: s32 = current_y + drawn_line_height
    if has_next_line { next += line_gap }
    return next
}

#program_export
ParagraphLineStride :: (drawn_line_height: s32, line_gap: s32) -> s32 {
    stride: s32 = drawn_line_height + line_gap
    if stride < 1 { return 1 }
    return stride
}

#program_export
ParagraphLineIndexFor :: (mouse_y: float32, bounds_y: float32,
line_stride: s32, line_count: s32) -> s32 {
    if line_count <= 0 {
        return -1
    }
    if line_stride < 1 {
        line_stride = 1
    }
    index: s32 = cast(s32)(mouse_y - bounds_y) / line_stride
    if index < 0 {
        return 0
    }
    if index >= line_count {
        return line_count - 1
    }
    return index
}

#program_export
ParagraphSelectionLocalOffsetFor :: (mouse_y: float32, bounds_y: float32,
block_height: s32, line_length: s32, measured_offset: s32) -> s32 {
    if line_length < 0 {
        line_length = 0
    }
    if mouse_y < bounds_y {
        return 0
    }
    if mouse_y > bounds_y + cast(float32)block_height {
        return line_length
    }
    if measured_offset < 0 {
        return 0
    }
    if measured_offset > line_length {
        return line_length
    }
    return measured_offset
}
