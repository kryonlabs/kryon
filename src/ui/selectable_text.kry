#module "selectable_text_host"
#import "ui_internal.h"
#import "ui_text_props.generated.h"
#import "ui_text_backend.h"
#import "ui/text_rows.h"
#import "ui/cursor.h"
#import "ui/text_editor.h"
#import "ui_style_internal.h"
#import "runtime/paragraph.h"
#import "runtime/text.h"
#import "runtime/text_input.h"
#import "stdlib.h"
#import "string.h"
#import "stdio.h"

TextBlockLine :: struct {
    start: i32
    end: i32
}

BlockSelection :: struct {
    id: i32
    anchor: i32
    cursor: i32
    dragging: i32
}

block_selection :: BlockSelection #global
block_last_click_id :: i32 #global
block_last_click_line :: i32 = -1 #global
block_last_click_position :: Vector2 #global
block_last_click_time :: f64 = -1.0 #global

inline_selectable_stack :: [16]i32 #global
inline_selectable_stack_count :: i32 #global
inline_selectable :: i32 = 1 #global
inline_selection :: BlockSelection #global

SelectableTextLineByteLength :: (value: const char*) -> i32 {
    if value == nil { return 0 }
    length: i32 = 0
    while value[length] != '\0' && value[length] != '\n' {
        length += 1
    }
    return length
}

SelectableTextGlyphAdvance :: (value: const char*, offset: i32,
codepoint: i32, bytes: i32, font_size: i32) -> i32 {
    font: Font = GetTextFontForCodepoint(codepoint, font_size)
    if TextFontHasNativeText(font) {
        return TextFontNativeTextWidth(font, value + offset, bytes)
    }
    return (int)((float)TextFontAdvance(font, codepoint) *
        GetTextFontScale(font, font_size) + 0.5f)
}

SelectableTextWidthBytes :: (value: const char*,
byte_len: i32, font_size: i32) -> i32 {
    font: Font = GetTextFontForSize(font_size)
    if value == nil || byte_len <= 0 || !TextFontReady(font) {
        return 0
    }
    spacing: i32 = ui_get_text_letter_spacing()
    if TextFontHasNativeText(font) && spacing == 0 {
        return TextFontNativeTextWidth(font, value, byte_len)
    }
    width: i32 = 0
    offset: i32 = 0
    while offset < byte_len && value[offset] != '\0' {
        bytes: i32 = 0
        codepoint: i32 = GetCodepointNext(value + offset, &bytes)
        if codepoint == '\n' { break }
        if bytes <= 0 { bytes = 1 }
        if offset + bytes > byte_len { break }
        if offset > 0 { width += spacing }
        width += SelectableTextGlyphAdvance(value, offset,
            codepoint, bytes, font_size)
        offset += bytes
    }
    return width
}

ui_text_byte_offset_at_x :: (value: const char*,
font_size: i32, target_x: i32) -> i32 #export {
    if value == nil || target_x <= 0 { return 0 }
    byte_len: i32 = SelectableTextLineByteLength(value)
    cursor_x: i32 = 0
    spacing: i32 = ui_get_text_letter_spacing()
    offset: i32 = 0
    while offset < byte_len {
        bytes: i32 = 0
        codepoint: i32 = GetCodepointNext(value + offset, &bytes)
        if bytes <= 0 { bytes = 1 }
        if offset + bytes > byte_len { return offset }
        advance: i32 = SelectableTextGlyphAdvance(value, offset,
            codepoint, bytes, font_size)
        if offset + bytes < byte_len { advance += spacing }
        if target_x < cursor_x + advance / 2 { return offset }
        cursor_x += advance
        offset += bytes
    }
    return byte_len
}

ui_text_draw_selection :: (value: const char*, x: i32,
y: i32, font_size: i32, color: Color,
start: i32, end: i32) #export {
    if value == nil || end <= start { return }
    spacing: i32 = ui_get_text_letter_spacing()
    start_x: i32 = x + SelectableTextWidthBytes(value, start, font_size)
    end_x: i32 = x + SelectableTextWidthBytes(value, end, font_size)
    if start > 0 && value[start] != '\0' && value[start] != '\n' {
        start_x += spacing
    }
    if end > 0 && value[end] != '\0' && value[end] != '\n' {
        end_x += spacing
    }
    if end_x <= start_x { return }
    DrawRectangle(start_x, y, end_x - start_x,
        TextLineHeight(font_size), color)
}

ui_text_default_selection_color :: (
text_color: Color) -> Color {
    link: Style = ui_resolve_button_style_kind(
    (ButtonProps){0}, ButtonStateNormal, StyleKindLink())
    color: Color = link.foreground.a != 0
    ? link.foreground : text_color
    color.a = TextSelectionDefaultAlpha()
    return color
}

TextHashInt :: (hash: i32, value: i32) -> i32 {
    h: u32 = (uint32_t)hash
    h ^= (uint32_t)value + 0x9e3779b9u +
    (h << 6) + (h >> 2)
    return (int)(h & 0x7fffffffu)
}

ui_text_id :: (value: const char*, x: i32,
y: i32, font_size: i32) -> i32 #export {
    content: u32 = 2166136261u
    if value != nil {
        i: i32 = 0
        while value[i] != '\0' {
            content = (content ^ (uint32_t)(unsigned char)value[i]) * 16777619u
            i += 1
        }
    }
    hash: i32 = (int)content
    hash = TextHashInt(hash, x)
    hash = TextHashInt(hash, y)
    hash = TextHashInt(hash, font_size)
    if hash == 0 {
        hash = 1
    }
    return hash
}

ui_inline_text_selection_active :: (value: const char*,
x: i32, y: i32, font_size: i32) -> i32 #export {
    return inline_selectable &&
    (inline_selection.id == ui_text_id(value, x, y, font_size) ||
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT))
}

PushTextSelectable :: (selectable: i32) -> i32 #export {
    token: i32 = inline_selectable
    if inline_selectable_stack_count < 16 {
        inline_selectable_stack[inline_selectable_stack_count] = token
        inline_selectable_stack_count += 1
    }
    inline_selectable = selectable != 0
    return token
}

PopTextSelectable :: (token: i32) #export {
    if inline_selectable_stack_count > 0 {
        inline_selectable_stack_count -= 1
        inline_selectable =
        inline_selectable_stack[inline_selectable_stack_count]
    } else {
        inline_selectable = token != 0
    }
}

ui_inline_text_before_render :: (value: const char*,
x: i32, y: i32, font_size: i32, color: Color,
selectable_arg: i32, byte_len: i32,
text_w: i32, line_h: i32) #export {
    if value == nil {
        return
    }
    if value[0] != '\0' && text_w > 0 && line_h > 0 {
        inspect_id: [96]char
        bounds: Rectangle = (Rectangle){(float)x, (float)y,
            (float)text_w, (float)line_h}
        inspect_hash: i32 = ui_text_id(value, x, y, font_size)
        snprintf(inspect_id, sizeof(inspect_id),
        "tmp:Text:%d", inspect_hash)
        widget: Widget = BeginWidget("Text", inspect_id,
        bounds, WidgetFlagReadOnly)
        WidgetSetAction(&widget, value)
        EndWidget(&widget)
    }
    if !selectable_arg || !inline_selectable ||
    value[0] == '\0' { return }
    id: i32 = ui_text_id(value, x, y, font_size)
    bounds: Rectangle = (Rectangle){(float)x, (float)y,
        (float)text_w, (float)line_h}
    mouse: Vector2 = ui_mouse_world()
    inside: i32 = CheckCollisionPointRec(mouse, bounds)
    captured: i32 = InputCapturesClick(mouse)
    pointer: TextSelectionPointerDecision =
    TextSelectionPointerDecisionFor(inside != 0,
    captured != 0,
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0)
    if pointer.hover {
        MarkCursor(MOUSE_CURSOR_IBEAM)
    }
    if pointer.begin {
        offset: i32 = ui_text_byte_offset_at_x(value,
        font_size, (int)mouse.x - x)
        inline_selection.id = id
        inline_selection.anchor = offset
        inline_selection.cursor = offset
        inline_selection.dragging = 1
        g_ui_pointer_owner = POINTER_OWNER_TEXT_SELECTION
    }
    drag: TextSelectionDragDecision = TextSelectionDragDecisionFor(
    inline_selection.id == id,
    inline_selection.dragging != 0,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0)
    if drag.update {
        inline_selection.cursor = ui_text_byte_offset_at_x(
        value, font_size, (int)mouse.x - x)
    } else if drag.finish {
        inline_selection.dragging = 0
    }
    copy: TextSelectionCopyDecision = TextSelectionCopyDecisionFor(
    inline_selection.id == id,
    IsKeyboardInputEnabled() != 0,
    ui_mod_key_down() != 0,
    IsKeyPressed(KEY_C) != 0)
    if copy.copy {
        range: TextSelectionRange = TextSelectionRangeForLength(
        inline_selection.anchor, inline_selection.cursor, byte_len)
        ui_text_copy_range(value, range.start, range.end)
    }
    if TextSelectionRangeShouldShow(inline_selection.id == id) {
        range: TextSelectionRange = TextSelectionRangeForLength(
        inline_selection.anchor, inline_selection.cursor, byte_len)
        ui_text_draw_selection(value, x, y, font_size,
        ui_text_default_selection_color(color),
        range.start, range.end)
    }
}

TextSlice :: (value: const char*, start: i32,
end: i32) -> *char {
    length: i32 = end - start
    if value == nil || length < 0 {
        return nil
    }
    slice: *char = (char*)malloc((size_t)length + 1)
    if slice == nil {
        return nil
    }
    memcpy(slice, value + start, (size_t)length)
    slice[length] = '\0'
    return slice
}

TextBlockLines :: (value: const char*, width: i32,
font_size: i32, out_lines: **TextBlockLine) -> i32 {
    if out_lines == nil {
        return 0
    }
    *out_lines = nil
    if value == nil {
        return 0
    }
    capacity: i32 = 8
    lines: *TextBlockLine = (TextBlockLine*)malloc(
    (size_t)capacity * sizeof(TextBlockLine))
    if lines == nil {
        return 0
    }
    count: i32 = 0
    rows: TextRowCursor = ui_text_rows(value,
    font_size, 0, width, 0, 1)
    row: TextMeasuredRow = (TextMeasuredRow){0}
    while ui_text_row_next(&rows, &row) {
        if count == capacity {
            capacity *= 2
            grown: *TextBlockLine = (TextBlockLine*)realloc(
            lines, (size_t)capacity * sizeof(TextBlockLine))
            if grown == nil {
                free(lines)
                return 0
            }
            lines = grown
        }
        lines[count].start = row.start
        lines[count].end = row.end
        count += 1
    }
    *out_lines = lines
    return count
}

MeasureSelectableTextBlock :: (value: const char*,
width: i32, font_size: i32, line_gap: i32) -> i32 #export {
    lines: *TextBlockLine = nil
    count: i32 = TextBlockLines(value, width, font_size, &lines)
    line_h: i32 = TextLineHeight(font_size)
    height: i32 = ParagraphLayoutTotalHeight(
    count, line_h, line_gap)
    free(lines)
    return height
}

RenderSelectableTextBlock :: (
block: SelectableTextBlock) -> i32 #export {
    if block.text == nil || block.id <= 0 ||
    block.font_size <= 0 { return 0 }
    lines: *TextBlockLine = nil
    mouse: Vector2 = ui_mouse_world()
    count: i32 = TextBlockLines(block.text,
    (int)block.bounds.width, block.font_size, &lines)
    line_h: i32 = TextLineHeight(block.font_size)
    line_stride: i32 = ParagraphLineStride(line_h, block.line_gap)
    height: i32 = ParagraphLayoutTotalHeight(
    count, line_h, block.line_gap)
    captured: i32 = InputCapturesClick(mouse)
    selected_start: i32 = 0
    selected_end: i32 = 0
    i: i32 = 0
    y: i32 = (int)block.bounds.y
    while i < count {
        line: *char = TextSlice(block.text,
        lines[i].start, lines[i].end)
        line_w: i32 = line != nil ?
        TextWidth(line, block.font_size) : 0
        hit: Rectangle = (Rectangle){block.bounds.x,
            (float)y, (float)line_w, (float)line_h}
        inside: i32 = CheckCollisionPointRec(mouse, hit)
        pointer: TextSelectionPointerDecision =
        TextSelectionPointerDecisionFor(inside != 0,
        captured != 0,
        IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0)
        if pointer.hover {
            MarkCursor(MOUSE_CURSOR_IBEAM)
        }
        if pointer.begin {
            local: i32 = ui_text_byte_offset_at_x(
            line, block.font_size,
            (int)(mouse.x - block.bounds.x))
            now: f64 = GetTime()
            dx: float = mouse.x - block_last_click_position.x
            dy: float = mouse.y - block_last_click_position.y
            scale: float = (float)Scale(1000) / 1000.0
            double_click: i32 = TextDoubleClickShouldSelectLine(
            block_last_click_id == block.id,
            block_last_click_line == i,
            (float)block_last_click_time, (float)now,
            dx, dy, scale)
            if double_click {
                block_selection.id = block.id
                block_selection.anchor = lines[i].start
                block_selection.cursor = lines[i].end
                block_selection.dragging = 0
                block_last_click_id = 0
                block_last_click_line = -1
                block_last_click_time = -1.0
            } else {
                block_selection.id = block.id
                block_selection.anchor = lines[i].start + local
                block_selection.cursor = lines[i].start + local
                block_selection.dragging = 1
                block_last_click_id = block.id
                block_last_click_line = i
                block_last_click_position = mouse
                block_last_click_time = now
            }
            g_ui_pointer_owner = POINTER_OWNER_TEXT_SELECTION
        }
        free(line)
        i += 1
        y = ParagraphNextLineY(y, line_h, block.line_gap, 1)
    }
    drag: TextSelectionDragDecision = TextSelectionDragDecisionFor(
    block_selection.id == block.id,
    block_selection.dragging != 0,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0)
    if drag.update && count > 0 {
        line_index: i32 = ParagraphLineIndexFor(
        mouse.y, block.bounds.y, line_stride, count)
        line: *char = TextSlice(block.text,
        lines[line_index].start, lines[line_index].end)
        local: i32 = ParagraphSelectionLocalOffsetFor(
        mouse.y, block.bounds.y, height,
        lines[line_index].end - lines[line_index].start,
        ui_text_byte_offset_at_x(line, block.font_size,
        (int)(mouse.x - block.bounds.x)))
        free(line)
        block_selection.cursor = lines[line_index].start + local
        g_ui_pointer_owner = POINTER_OWNER_TEXT_SELECTION
    } else if drag.finish {
        block_selection.dragging = 0
    }
    if TextSelectionRangeShouldShow(
    block_selection.id == block.id) {
        range: TextSelectionRange = TextSelectionRangeForLength(
        block_selection.anchor, block_selection.cursor,
        (int)strlen(block.text))
        selected_start = range.start
        selected_end = range.end
        copy: TextSelectionCopyDecision =
        TextSelectionCopyDecisionFor(
        block_selection.id == block.id,
        IsKeyboardInputEnabled() != 0,
        ui_mod_key_down() != 0,
        IsKeyPressed(KEY_C) != 0)
        if copy.copy {
            ui_text_copy_range(block.text,
            selected_start, selected_end)
        }
    }
    i = 0
    y = (int)block.bounds.y
    while i < count {
        span: TextSelectionPaintSpan =
        TextSelectionPaintSpanForLine(selected_start,
        selected_end, lines[i].start, lines[i].end)
        line: *char = TextSlice(block.text,
        lines[i].start, lines[i].end)
        if span.end > span.start && line != nil {
            ui_text_draw_selection(line,
            (int)block.bounds.x, y, block.font_size,
            ui_text_default_selection_color(block.color),
            span.start - lines[i].start,
            span.end - lines[i].start)
        }
        if line != nil {
            RenderTextEx(line, (int)block.bounds.x,
            y, block.font_size, block.color, 0)
        }
        free(line)
        i += 1
        y = ParagraphNextLineY(y, line_h, block.line_gap, 1)
    }
    free(lines)
    return height
}
