// kryon init pins a floating [toolchain] to the Ziran Kryon's templates
// pin and keeps an exact one; every template pins that same Ziran. kryon
// upgrade rewrites only the toolchain, kryon and css tables, and the app
// template pins exactly the set it writes.
// Run from the Kryon root: make toolchain-pin-test
#import "toolchain_pin"
#import "std/file"
#import "std/text_tools"
#import "std/vec"

failures: s32;

Expect :: (ok: bool, what: string) {
    if ok { return }
    failures += 1
    print("toolchain pin: FAIL %\n", what)
}

main :: () -> s32 {
    floating := "[package]\nname = \"tool\"\n\n[toolchain]\ngit = \"https://github.com/ziranlang/ziran.git\"\nref = \"master\"\n\n[dependencies.x]\nref = \"main\"\n"
    output: [1024]u8
    pinned := PinToolchain(floating, output[:])
    Expect(ToolchainRef(pinned) == KryonZiranRef, "a floating ref becomes Kryon's Ziran")
    expected_parts: [5]string = .["[package]\nname = \"tool\"\n\n[toolchain]\ngit = \"",
        KryonZiranGit, "\"\nref = \"", KryonZiranRef,
        "\"\n\n[dependencies.x]\nref = \"main\"\n"]
    expected: Text = TextJoin(expected_parts[:], "")
    Expect(pinned == TextView(expected), "only the [toolchain] git and ref lines change")

    exact := "[toolchain]\ngit = \"https://git.waozi.xyz/ziranlang/ziran.git\"\nref = \"2684af8d22b623c52bfd19ce785523b50ad83c5e\"\n"
    other: [1024]u8
    Expect(PinToolchain(exact, other[:]) == "", "an exact user pin is kept")
    Expect(PinToolchain("[package]\nname = \"tool\"\n", other[:]) == "", "no [toolchain], nothing to pin")
    small: [8]u8
    Expect(PinToolchain(floating, small[:]) == "", "too small an output pins nothing")
    Expect(ExactCommit(KryonZiranRef) && !ExactCommit("master") && !ExactCommit("5DB3D3C3"), "exact commits")

    templates: [4]string = .["templates/app/ziran.toml", "templates/tui/ziran.toml",
        "templates/pages/ziran.toml", "templates/web/ziran.toml"]
    for path: templates {
        text, ok := ReadEntireFile(path)
        Expect(ok && ToolchainRef(text) == KryonZiranRef, path)
    }
    old_app := "[toolchain]\ngit = \"https://github.com/ziranlang/ziran.git\"\nref = \"5db3d3c39425d5dfe4bfe4a84e6f6e2e5a810ad0\"\n\n[dependencies.kryon]\ngit = \"https://github.com/kryonlabs/kryon.git\"\nref = \"cdf23986a0434cfb01513ecca4763b0477d01a7e\"\n\n[dependencies.other]\nref = \"main\"\n"
    pins: [3]TablePin
    count := KryonUpgradePins(pins[:])
    upgraded: [1024]u8
    moved := PinTables(old_app, pins[0:count], upgraded[:])
    Expect(ToolchainRef(moved) == KryonZiranRef, "upgrade pins Kryon's Ziran")
    Expect(TextContains(moved, KryonRef) && TextContains(moved, KryonGit), "upgrade pins Kryon's Kryon")
    Expect(TextContains(moved, "[dependencies.other]\nref = \"main\""), "upgrade keeps other tables")
    Expect(!TextContains(moved, "[dependencies.css]"), "upgrade adds no table the app lacks")

    app, app_ok := ReadEntireFile("templates/app/ziran.toml")
    same: [4096]u8
    Expect(app_ok && PinTables(app, pins[0:count], same[:]) == app, "the app template pins the upgrade set")
    if failures > 0 { return 1 }
    print("toolchain pin: floating, exact and missing toolchains; four templates agree; upgrade pins the app template's set\n")
    return 0
}
