#module "tree_view_props"
#import "geometry"

TreeItem :: struct {
    label: string
    depth: i32
    id: i32
    expanded: bool
    selectable: bool
}

TreeViewNavigation :: enum {
    TreeViewNavigationNone = 0
    TreeViewNavigationHome = 1
    TreeViewNavigationEnd = 2
    TreeViewNavigationUp = 3
    TreeViewNavigationDown = 4
}

# Items are a borrowed slice passed to TreeView, not a pointer in this record.
# The caller stores the returned selection and scroll value between frames.
TreeViewProps :: struct {
    key: u64
    bounds: Rectangle
    id: i32
    class_name: i32
    selected_id: i32
    scroll_offset: i32
    scroll_delta: i32
    row_height: i32
    scale: float
    focused: bool
    navigation: TreeViewNavigation
    disabled: bool
}

TreeViewResult :: struct {
    node: i32
    selected_id: i32
    scroll_offset: i32
    changed: bool
}
