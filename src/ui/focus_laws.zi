#import "focus"

// Laws for keyboard focus. Each states the expected behavior independently
// of the implementation; `ziran check` proves it over every listed input.
// An implementation edit may not change this file.

Activates :: (active: s32, keyboard: s32, disabled: s32, captured: s32,
    enter: s32, space: s32, typing: s32) -> bool {
    return FocusActivationFor(active != 0, keyboard != 0, disabled != 0,
        captured != 0, enter != 0, space != 0, typing != 0)
}

// An inactive, keyboard-disabled, disabled, or captured control never
// activates, whatever keys are down.
#law InactiveNeverActivates forall keyboard: 0..1, disabled: 0..1, captured: 0..1, enter: 0..1, space: 0..1, typing: 0..1 => !Activates(0, keyboard, disabled, captured, enter, space, typing);
#law KeyboardDisabledNeverActivates forall disabled: 0..1, captured: 0..1, enter: 0..1, space: 0..1, typing: 0..1 => !Activates(1, 0, disabled, captured, enter, space, typing);
#law DisabledNeverActivates forall captured: 0..1, enter: 0..1, space: 0..1, typing: 0..1 => !Activates(1, 1, 1, captured, enter, space, typing);
#law CapturedNeverActivates forall enter: 0..1, space: 0..1, typing: 0..1 => !Activates(1, 1, 0, 1, enter, space, typing);

// Enter activates a ready control; Space does too unless text input is
// active, where it types a space instead.
#law EnterActivates forall space: 0..1, typing: 0..1 => Activates(1, 1, 0, 0, 1, space, typing);
#law SpaceActivatesWithoutTyping custom Activates(1, 1, 0, 0, 0, 1, 0);
#law TypingBlocksSpace forall space: 0..1 => !Activates(1, 1, 0, 0, 0, space, 1);
#law NoKeyNoActivation forall typing: 0..1 => !Activates(1, 1, 0, 0, 0, 0, typing);

// Tab moves focus forward, Shift+Tab backward, and Shift alone stays.
#law NoTabStays forall shift: 0..1 => FocusTabDirectionFor(false, shift != 0) == 0;
#law TabMovesForward custom FocusTabDirectionFor(true, false) == 1;
#law ShiftTabMovesBackward custom FocusTabDirectionFor(true, true) == -1;
