#module "scroll_widget"
#import "control_props"
#import "geometry"
#import "drawing_props"
#import "paint_queue"
#import "scroll"
#import "scroll_props"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "widget_kind"

# A value based scroll viewport. The caller supplies wheel or keyboard
# movement, keeps the returned offset, and positions children in content.
# Close the child scope with End().
Scroll :: (props: ScrollProps) -> ScrollResult #export {
    result: ScrollResult
    result.node = -1
    result.viewport = props.bounds
    parent: Rectangle = TreeCurrentParentBounds()
    if result.viewport.width <= 0.0 {
        result.viewport.width = parent.width
    }
    if result.viewport.height <= 0.0 {
        result.viewport.height = parent.height
    }
    if TreeIsBuilding() {
        key: u64 = props.key
        if key == (u64)0 { key = TreeNextKey() }
        result.node = TreeSubmitCurrent(key, WidgetKindScroll,
            result.viewport)
        if result.node < 0 { return result }
        result.viewport = TreeSubmittedNodeAt(result.node).bounds
    }
    result.max_scroll = ScrollMax(props.content_height,
        (i32)result.viewport.height)
    offset: i64 = (i64)props.scroll_offset + (i64)props.scroll_delta
    if offset < (i64)0 { offset = (i64)0 }
    if offset > (i64)result.max_scroll {
        offset = (i64)result.max_scroll
    }
    result.scroll_offset = (i32)offset
    result.content = result.viewport
    result.content.y -= (float)result.scroll_offset
    if props.content_height > (i32)result.viewport.height {
        result.content.height = (float)props.content_height
    }
    if props.input.enabled {
        track: StyleFrame = ScrollFace(StyleKindScroll(),
            props.class_name, props.input.disabled, (i32)ButtonStateNormal, 10.0)
        thumb: StyleFrame = ScrollFace(StyleKindScrollThumb(),
            props.class_name, props.input.disabled, (i32)ButtonStateNormal, 10.0)
        metrics: ScrollMetrics = props.metrics
        if metrics.scrollbar_width <= 0 {
            metrics = ScrollMetricsFor(props.scale, track, thumb)
        }
        input: ScrollFrameInput
        input.bounds = result.viewport
        input.content_height = props.content_height
        input.has_offset = true
        input.offset = result.scroll_offset
        input.pointer_allowed = props.input.pointer_allowed
        input.disabled = props.input.disabled
        input.mouse = props.input.mouse
        input.pressed = props.input.pressed
        input.down = props.input.down
        input.released = props.input.released
        input.wheel = props.input.wheel
        input.owns_drag = props.input.owns_drag
        input.owner_captured = props.input.owner_captured
        input.grab = props.input.grab
        result.frame = ScrollFrameFor(input, metrics)
        result.scroll_offset = result.frame.offset
        result.content = result.frame.content
        if result.frame.scrollbar {
            thumb = ScrollFace(StyleKindScrollThumb(),
                props.class_name, props.input.disabled,
                result.frame.thumb_state, 10.0)
            PaintRoundedFill(result.node, result.frame.paint.track_bounds,
                track.value.radius, 12,
                ColorFromPacked(Opacity(track.value.background,
                    StyleOpacityValue(track.value.fields,
                        track.value.opacity))))
            PaintRoundedFill(result.node, result.frame.paint.thumb_bounds,
                thumb.value.radius, 12,
                ColorFromPacked(Opacity(thumb.value.background,
                    StyleOpacityValue(thumb.value.fields,
                        thumb.value.opacity))))
        }
    }
    if result.node >= 0 {
        clip: Rectangle = result.viewport
        if props.input.enabled { clip = result.frame.clip }
        TreeSetChildClip(result.node, clip)
        result.opened = TreePushScope(result.node)
    }
    return result
}
