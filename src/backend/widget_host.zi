#import "hosted_values"
#import "widget_codec"
#import "bundle_names"
#import "media_audio"
#import "media_audio_host"
#import "media_audio_codec"

using HostValueKind;

// Decides which asset paths a bundle may draw. Runtime texture handles
// belong to the renderer and are always refused.
WidgetAssetAllowed :: #type (path: string) -> bool;
// Resolves an allowed packed path into the current app's renderer namespace.
// Returned text must remain valid until the host has painted the frame.
// An empty result is an allowed image the host does not have yet, such as
// art still downloading: it draws as loading and resolves again next frame.
WidgetAssetResolve :: #type (path: string) -> string;

WIDGET_HOST_TAB_LIMIT :: 32
WIDGET_HOST_OPTION_LIMIT :: 32
// Scrolls and dialog panels a bundle may hold open at once.
WIDGET_HOST_SCOPE_DEPTH :: 16

widget_host_audio: *MediaAudioOwner;
widget_host_audio_read: MediaAudioRead;
widget_host_audio_context: *void;
widget_audio_command_codec: WidgetMediaAudioCommandCodec;
widget_audio_result_codec: WidgetMediaAudioResultCodec;
widget_host_session: Session;
widget_host_active: bool;
widget_host_depth: s32;
widget_host_asset_allowed: WidgetAssetAllowed;
widget_host_asset_resolve: WidgetAssetResolve;
// The palettes a bundle is drawing in this frame, nested; they end with
// the frame.
widget_host_palette_depth: s32;
widget_text_codec: WidgetTextPropsCodec;
widget_image_codec: WidgetImagePropsCodec;
// The points of the warped image being drawn: the hosted Image effect
// decodes a grid here, so image codecs elsewhere keep no room for one.
widget_image_mesh_points: [IMAGE_MESH_POINT_LIMIT]Vector2;
widget_image_mesh_point_codec: WidgetVector2Codec;
widget_button_codec: WidgetButtonPropsCodec;
widget_area_codec: WidgetTextAreaPropsCodec;
widget_area_result_codec: WidgetTextAreaResultCodec;
widget_tile_map_codec: WidgetTileMapPropsCodec;
widget_tile_map_result_codec: WidgetTileMapResultCodec;
widget_tile_map_used: [TILE_MAP_HOSTED_LIMIT]bool;
widget_scroll_codec: WidgetScrollPropsCodec;
widget_scroll_result_codec: WidgetScrollResultCodec;
widget_session_codec: WidgetSessionCodec;
widget_pointer_codec: WidgetPointerFrameCodec;
widget_frame_input_codec: WidgetFrameInputSnapshotCodec;
widget_checkbox_codec: WidgetCheckboxPropsCodec;
widget_checkbox_result_codec: WidgetCheckboxValueResultCodec;
widget_toggle_codec: WidgetTogglePropsCodec;
widget_toggle_result_codec: WidgetToggleValueResultCodec;
widget_field_codec: WidgetTextFieldPropsCodec;
widget_field_result_codec: WidgetTextFieldResultCodec;
widget_tabs: [WIDGET_HOST_TAB_LIMIT]Tab;
widget_tab_codecs: [WIDGET_HOST_TAB_LIMIT]WidgetTabCodec;
widget_tab_bar_codec: WidgetTabBarPropsCodec;
widget_tab_bar_result_codec: WidgetTabBarResultCodec;
widget_segments: [WIDGET_HOST_OPTION_LIMIT]SegmentOption;
widget_segment_codecs: [WIDGET_HOST_OPTION_LIMIT]WidgetSegmentOptionCodec;
widget_segmented_codec: WidgetSegmentedControlPropsCodec;
widget_segmented_result_codec: WidgetSegmentedControlResultCodec;
widget_box_codec: WidgetBoxPropsCodec;
widget_slider_codec: WidgetSliderPropsCodec;
widget_slider_step_codec: WidgetSliderStepCodec;
widget_discrete_slider_codec: WidgetDiscreteSliderPropsCodec;
widget_discrete_step_codec: WidgetSliderDiscreteStepCodec;
widget_progress_codec: WidgetProgressPropsCodec;
widget_dismissible_overlay_codec: WidgetDismissibleOverlayPropsCodec;
widget_dismissible_overlay_result_codec: WidgetDismissibleOverlayResultCodec;
widget_popup_codec: WidgetPopupPropsCodec;
widget_popup_result_codec: WidgetPopupResultCodec;
widget_fieldset_codec: WidgetFieldsetPropsCodec;
widget_line_codec: WidgetLinePropsCodec;
widget_circle_codec: WidgetCirclePropsCodec;
widget_ring_codec: WidgetRingPropsCodec;
widget_triangle_codec: WidgetTrianglePropsCodec;
widget_vector_codec: WidgetVector2Codec;
widget_svg_icon_codec: WidgetSvgIconPropsCodec;
widget_press_codec: WidgetPressPropsCodec;
widget_press_result_codec: WidgetPressResultCodec;
widget_spinbox_codec: WidgetSpinboxPropsCodec;
widget_spinbox_result_codec: WidgetSpinboxStepResultCodec;
widget_time_picker_codec: WidgetTimePickerPropsCodec;
widget_time_picker_result_codec: WidgetTimePickerResultCodec;
widget_dropdown_codec: WidgetDropdownPropsCodec;
widget_dropdown_result_codec: WidgetDropdownResultCodec;
widget_title_bar_codec: WidgetTitleBarPropsCodec;
widget_title_bar_result_codec: WidgetTitleBarResultCodec;
widget_options: [WIDGET_HOST_OPTION_LIMIT]DropdownOption;
widget_modal_frame_codec: WidgetModalFramePropsCodec;
widget_modal_frame_result_codec: WidgetModalFrameResultCodec;
widget_action_modal_codec: WidgetActionModalPropsCodec;
widget_action_modal_result_codec: WidgetActionModalResultCodec;
widget_modal_actions: [16]ActionModalAction;
widget_modal_action_codecs: [16]WidgetActionModalActionCodec;
widget_option_codecs: [WIDGET_HOST_OPTION_LIMIT]WidgetDropdownOptionCodec;
widget_context_menu_codec: WidgetContextMenuPropsCodec;
widget_context_menu_result_codec: WidgetContextMenuResultCodec;
widget_menu_items: [WIDGET_HOST_OPTION_LIMIT]ContextMenuItem;
widget_menu_item_codecs: [WIDGET_HOST_OPTION_LIMIT]WidgetContextMenuItemCodec;

// The widget calls WidgetHostCall answers, for checking a bundle's
// capabilities before it runs.
WidgetHostSupports :: (module: string, function: string) -> bool {
    return (ModuleName(module, "media_audio") && function == "MediaAudioHost") ||
    (ModuleName(module, "frame_snapshot") && function == "CaptureFrameInputHost") ||
    (ModuleName(module, "pointer_input") && function == "PollPointer") ||
    (ModuleName(module, "carousel") && function == "CarouselWheelHostedHost") ||
    (ModuleName(module, "text_widget") && function == "TextHostedHost") ||
    (ModuleName(module, "text_widget") && function == "TextLinkAtHostedHost") ||
    (ModuleName(module, "text_measure") && function == "TextWidthHostedHost") ||
    (ModuleName(module, "text_measure") && function == "TextHeightHostedHost") ||
    (ModuleName(module, "image_widget") && function == "ImageHostedHost") ||
    (ModuleName(module, "tile_map") && function == "TileMapHostedHost") ||
    (ModuleName(module, "button_widget") && function == "ButtonHostedHost") ||
    (ModuleName(module, "text_area_widget") && function == "TextAreaHostedHost") ||
    (ModuleName(module, "scroll_widget") && function == "ScrollHostedHost") ||
    (ModuleName(module, "tree") && function == "EndHostedHost") ||
    (ModuleName(module, "tree") && function == "TreePushScopeHostedHost") ||
    (ModuleName(module, "text_field_widget") && function == "TextFieldHostedHost") ||
    (ModuleName(module, "tab_bar_widget") && function == "TabBarHostedHost") ||
    (ModuleName(module, "segmented_control_widget") && function == "SegmentedControlHostedHost") ||
    (ModuleName(module, "checkbox_widget") && function == "CheckboxHostedHost") ||
    (ModuleName(module, "toggle_widget") && function == "ToggleHostedHost") ||
    (ModuleName(module, "box_widget") && function == "BoxHostedHost") ||
    (ModuleName(module, "fieldset_widget") && function == "FieldsetHostedHost") ||
    (ModuleName(module, "shape_widget") && (function == "LineHostedHost" ||
        function == "CircleHostedHost" || function == "RingHostedHost" ||
        function == "TriangleHostedHost")) ||
    (ModuleName(module, "toggle_measure") && function == "ToggleSizeHostedHost") ||
    (ModuleName(module, "slider_widget") && (function == "SliderHostedHost" ||
        function == "DiscreteSliderHostedHost")) ||
    (ModuleName(module, "progress_widget") && function == "ProgressHostedHost") ||
    (ModuleName(module, "overlay_widget") && (function == "DismissibleOverlayHostedHost" ||
        function == "PopupHostedHost")) ||
    (ModuleName(module, "svg_icon_widget") && function == "SvgIconHostedHost") ||
    (ModuleName(module, "press_widget") && function == "PressHostedHost") ||
    (ModuleName(module, "spinbox_widget") && function == "SpinboxHostedHost") ||
    (ModuleName(module, "time_picker_widget") && function == "TimePickerHostedHost") ||
    (ModuleName(module, "dropdown_widget") && function == "DropdownHostedHost") ||
    (ModuleName(module, "title_bar_widget") && function == "TitleBarHostedHost") ||
    (ModuleName(module, "modal_frame_widget") && function == "ModalFrameHostedHost") ||
    (ModuleName(module, "modal_widget") && function == "ActionModalHostedHost") ||
    (ModuleName(module, "context_menu_widget") && function == "ContextMenuHostedHost") ||
    (ModuleName(module, "widget_palette") && function == "WidgetPaletteHostedHost") ||
    (ModuleName(module, "widget_palette") && function == "WidgetPaletteRestoreHostedHost")
}

WidgetHostPackedPath :: (path: string) -> string { return path }

// A portable Text's props with its strong and link ranges attached.
WidgetHostTextProps :: (props: HostValue) -> TextProps {
    text: TextProps = WidgetDecodeTextProps(props, *widget_text_codec)
    text.strong = widget_text_codec.strong_decoded[:HostSliceLength(props, 15, "strong")]
    text.links = widget_text_codec.links_decoded[:HostSliceLength(props, 18, "links")]
    if text.typeface.count >= 7 && text.typeface[:7] == "assets/" {
        text.typeface = WidgetHostAssetPath(text.typeface)
    } else {
        // A guest can name a registered face, but cannot load arbitrary host
        // paths. Only its own allowed assets pass through the resolver.
        for byte: text.typeface {
            if byte == #char "/" || byte == #char "\\" || byte == #char ":" {
                text.typeface = ""
                break
            }
        }
    }
    return text
}

// Which of a portable Text's links is under a point, as TextLinkAt.
WidgetHostTextLinkAt :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    props := arguments[1]
    if !WidgetValidTextProps(props) ||
    !HostScalarValid(arguments[2], "float32", cast(s32)HostReal) ||
    !HostScalarValid(arguments[3], "float32", cast(s32)HostReal) {
        return 0
    }
    hit := TextLinkAt(session, WidgetHostTextProps(props),
        cast(float32)arguments[2].real, cast(float32)arguments[3].real)
    result.* = HostScalar("s32", cast(s64)hit)
    return 1
}

WidgetHostAudioReadNone :: (context: *void, path: string) -> string {
    unused context
    unused path
    return ""
}

WidgetHostBegin :: (session: Session, asset_allowed: WidgetAssetAllowed, resolve: WidgetAssetResolve = WidgetHostPackedPath,
    audio: *MediaAudioOwner = null, audio_read: MediaAudioRead = WidgetHostAudioReadNone, audio_context: *void = null) {
    widget_host_audio = audio
    widget_host_audio_read = audio_read
    widget_host_audio_context = audio_context
    widget_host_session = session
    widget_host_asset_allowed = asset_allowed
    widget_host_asset_resolve = resolve
    widget_host_depth = 0
    widget_host_palette_depth = 0
    widget_host_active = true
    if audio != null {
        MediaAudioOwnerBind(audio, session, WidgetHostAssetAllowed, audio_read, audio_context)
        MediaAudioOwnerTick(audio)
    }
}

// Closes any scroll the bundle left open, so the host's tree stays balanced,
// and draws in the host's own style again.
WidgetHostEnd :: () {
    while widget_host_depth > 0 {
        End(widget_host_session)
        widget_host_depth -= 1
    }
    while widget_host_palette_depth > 0 {
        unused WidgetPaletteRestore(widget_host_session)
        widget_host_palette_depth -= 1
    }
    widget_host_active = false
    widget_host_audio = null
    widget_host_audio_context = null
}

WidgetHostAssetAllowed :: (path: string) -> bool {
    return widget_host_asset_allowed != null && widget_host_asset_allowed(path)
}

WidgetHostAssetPath :: (path: string) -> string {
    if !WidgetHostAssetAllowed(path) { return "" }
    if path == "" || widget_host_asset_resolve == null { return path }
    return widget_host_asset_resolve(path)
}

WidgetHostImage :: (image: *ImageProps) -> bool {
    if image.texture.id != cast(u32)0 { return false }
    packed := image.asset_path
    if !WidgetHostAssetAllowed(packed) { return false }
    if packed == "" { return true }
    image.asset_path = WidgetHostAssetPath(packed)
    if image.asset_path == "" {
        image.texture.width = -1
        image.texture.height = -1
    }
    return true
}

// A warped image's points, validated with its props, decoded into the
// host's own buffer.
WidgetHostMeshPoints :: (mesh: HostValue) -> []Vector2 {
    points_at := HostFieldAt(mesh, 2, "points")
    if points_at >= 0 { return WidgetHostImagePoints(mesh.fields[points_at].value) }
    return widget_image_mesh_points[:0]
}

WidgetHostImagePoints :: (points: HostValue) -> []Vector2 {
    count: usize = 0
    while count < points.length && count < cast(usize)IMAGE_MESH_POINT_LIMIT {
        widget_image_mesh_points[count] = WidgetDecodeVector2(points.elements[count],
            *widget_image_mesh_point_codec)
        count += cast(usize)1
    }
    return widget_image_mesh_points[:cast(s64)count]
}

// A bundle's own colours for the widgets it draws after this call, until
// its frame ends: nine packed colours and whether buttons are raised.
WidgetHostPalette :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    colors: [9]u32
    for index: cast(s32)0..8 {
        if !HostScalarValid(arguments[index + 1], "u32", cast(s32)HostUnsigned) { return 0 }
        colors[index] = cast(u32)arguments[index + 1].bits
    }
    if !HostScalarValid(arguments[10], "bool", cast(s32)HostInteger) { return 0 }
    palette := WidgetPalette.{.background = colors[0], .base = colors[1], .text = colors[2],
        .selected = colors[3], .selected_text = colors[4], .border = colors[5],
        .danger = colors[6], .warning = colors[7], .success = colors[8],
        .material = arguments[10].integer != 0}
    used := WidgetPaletteUse(session, palette)
    if used { widget_host_palette_depth += 1 }
    result.* = HostScalar("bool", ifx used then 1 else 0)
    return 1
}

// The active widget frame supplies the asset policy; the actual instance
// supplies ownership and a packed resource reader. No owner means unsupported.
WidgetHostAudioCall :: (audio: *MediaAudioOwner, read: MediaAudioRead, context: *void,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    if !widget_host_active || count != 2 || !WidgetValidSession(arguments[0]) ||
    !WidgetValidMediaAudioCommand(arguments[1]) { return 0 }
    session := WidgetDecodeSession(arguments[0], *widget_session_codec)
    if session.slot != widget_host_session.slot || session.epoch != widget_host_session.epoch { return 0 }
    command := WidgetDecodeMediaAudioCommand(arguments[1], *widget_audio_command_codec)
    answer := MediaAudioResult.{.code = .Unsupported, .message = "Host has no owned asset audio scope"}
    if audio != null {
        MediaAudioOwnerBind(audio, session, WidgetHostAssetAllowed, read, context)
        answer = MediaAudioOwnerCall(audio, session, command)
    }
    result.* = WidgetEncodeMediaAudioResult(answer, *widget_audio_result_codec)
    return 1
}

// A HostCall for the hosted widget functions. Returns 0 for a call it does
// not answer or refuses.
WidgetHostCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    unused context
    if !widget_host_active {
        return 0
    }
    owner := TextFromCString(module)
    name := TextFromCString(function)
    if name == "MediaAudioHost" && ModuleName(owner, "media_audio") {
        return WidgetHostAudioCall(widget_host_audio, widget_host_audio_read, widget_host_audio_context,
            arguments, count, result)
    }
    if name == "PollPointer" && ModuleName(owner, "pointer_input") && count == 0 {
        result.* = WidgetEncodePointerFrame(PointerSample(widget_host_session), *widget_pointer_codec)
        return 1
    }
    if count < 1 || !WidgetValidSession(arguments[0]) {
        return 0
    }
    session := WidgetDecodeSession(arguments[0], *widget_session_codec)
    if session.slot != widget_host_session.slot || session.epoch != widget_host_session.epoch {
        return 0
    }
    if name == "CaptureFrameInputHost" && ModuleName(owner, "frame_snapshot") && count == 1 {
        result.* = WidgetEncodeFrameInputSnapshot(CaptureFrameInput(session), *widget_frame_input_codec)
        return 1
    }
    if name == "EndHostedHost" && ModuleName(owner, "tree") && count == 1 {
        if widget_host_depth == 0 {
            return 0
        }
        End(session)
        widget_host_depth -= 1
        result.* = HostScalar("bool", 1)
        return 1
    }
    if name == "TreePushScopeHostedHost" && ModuleName(owner, "tree") && count == 2 {
        if widget_host_depth >= WIDGET_HOST_SCOPE_DEPTH ||
        !HostScalarValid(arguments[1], "s32", cast(s32)HostInteger) {
            return 0
        }
        pushed := TreePushScope(session, cast(s32)arguments[1].integer)
        if pushed {
            widget_host_depth += 1
        }
        result.* = HostScalar("bool", ifx pushed then 1 else 0)
        return 1
    }
    if name == "TabBarHostedHost" && ModuleName(owner, "tab_bar_widget") && count == 3 {
        return WidgetHostTabBar(session, arguments, result)
    }
    if name == "SegmentedControlHostedHost" && ModuleName(owner, "segmented_control_widget") && count == 3 {
        return WidgetHostSegmentedControl(session, arguments, result)
    }
    if name == "DropdownHostedHost" && ModuleName(owner, "dropdown_widget") && count == 3 {
        return WidgetHostDropdown(session, arguments, result)
    }
    if name == "TitleBarHostedHost" && ModuleName(owner, "title_bar_widget") && count == 3 {
        return WidgetHostTitleBar(session, arguments, result)
    }
    if name == "ActionModalHostedHost" && ModuleName(owner, "modal_widget") && count == 3 {
        return WidgetHostActionModal(session, arguments, result)
    }
    if name == "ContextMenuHostedHost" && ModuleName(owner, "context_menu_widget") && count == 3 {
        return WidgetHostContextMenu(session, arguments, result)
    }
    if name == "TextLinkAtHostedHost" && ModuleName(owner, "text_widget") && count == 4 {
        return WidgetHostTextLinkAt(session, arguments, result)
    }
    if name == "WidgetPaletteHostedHost" && ModuleName(owner, "widget_palette") && count == 11 {
        return WidgetHostPalette(session, arguments, result)
    }
    if name == "WidgetPaletteRestoreHostedHost" && ModuleName(owner, "widget_palette") && count == 1 {
        restored := widget_host_palette_depth == 0 || WidgetPaletteRestore(session)
        if widget_host_palette_depth > 0 { widget_host_palette_depth -= 1 }
        result.* = HostScalar("bool", ifx restored then 1 else 0)
        return 1
    }
    if count != 2 {
        return 0
    }
    props := arguments[1]
    if name == "CarouselWheelHostedHost" && ModuleName(owner, "carousel") && WidgetValidRectangle(props) {
        rectangle_codec: WidgetRectangleCodec
        result.* = HostValue.{.kind = cast(s32)HostReal, .type_name = HostTextData("float32"),
            .real = cast(float64)PointerWheelTake(session, WidgetDecodeRectangle(props, *rectangle_codec))}
        return 1
    }

    if name == "ModalFrameHostedHost" && ModuleName(owner, "modal_frame_widget") && WidgetValidModalFrameProps(props) {
        return WidgetHostModalFrame(session, props, result)
    }
    if name == "BoxHostedHost" && ModuleName(owner, "box_widget") && WidgetValidBoxProps(props) {
        result.* = HostScalar("s32", cast(s64)Box(session, WidgetDecodeBoxProps(props, *widget_box_codec)))
        return 1
    }
    if name == "LineHostedHost" && ModuleName(owner, "shape_widget") && WidgetValidLineProps(props) {
        result.* = HostScalar("s32", cast(s64)Line(session, WidgetDecodeLineProps(props, *widget_line_codec)))
        return 1
    }
    if name == "CircleHostedHost" && ModuleName(owner, "shape_widget") && WidgetValidCircleProps(props) {
        result.* = HostScalar("s32", cast(s64)Circle(session, WidgetDecodeCircleProps(props,
            *widget_circle_codec)))
        return 1
    }
    if name == "RingHostedHost" && ModuleName(owner, "shape_widget") && WidgetValidRingProps(props) {
        result.* = HostScalar("s32", cast(s64)Ring(session, WidgetDecodeRingProps(props, *widget_ring_codec)))
        return 1
    }
    if name == "TriangleHostedHost" && ModuleName(owner, "shape_widget") && WidgetValidTriangleProps(props) {
        result.* = HostScalar("s32", cast(s64)Triangle(session, WidgetDecodeTriangleProps(props,
            *widget_triangle_codec)))
        return 1
    }
    if name == "SliderHostedHost" && ModuleName(owner, "slider_widget") && WidgetValidSliderProps(props) {
        step := Slider(session, WidgetDecodeSliderProps(props, *widget_slider_codec))
        result.* = WidgetEncodeSliderStep(step, *widget_slider_step_codec)
        return 1
    }
    if name == "DiscreteSliderHostedHost" && ModuleName(owner, "slider_widget") &&
    WidgetValidDiscreteSliderProps(props) {
        step := DiscreteSlider(session, WidgetDecodeDiscreteSliderProps(props,
            *widget_discrete_slider_codec))
        result.* = WidgetEncodeSliderDiscreteStep(step, *widget_discrete_step_codec)
        return 1
    }
    if name == "ProgressHostedHost" && ModuleName(owner, "progress_widget") && WidgetValidProgressProps(props) {
        Progress(session, WidgetDecodeProgressProps(props, *widget_progress_codec))
        return 1
    }
    if name == "FieldsetHostedHost" && ModuleName(owner, "fieldset_widget") && WidgetValidFieldsetProps(props) {
        Fieldset(session, WidgetDecodeFieldsetProps(props, *widget_fieldset_codec))
        result.* = HostScalar("s32", 0)
        return 1
    }
    if name == "ToggleSizeHostedHost" && ModuleName(owner, "toggle_measure") && WidgetValidToggleProps(props) {
        result.* = WidgetEncodeVector2(ToggleSize(session, WidgetDecodeToggleProps(props,
            *widget_toggle_codec)), *widget_vector_codec)
        return 1
    }
    if name == "SvgIconHostedHost" && ModuleName(owner, "svg_icon_widget") && WidgetValidSvgIconProps(props) {
        SvgIcon(session, WidgetDecodeSvgIconProps(props, *widget_svg_icon_codec))
        return 1
    }
    if name == "TextFieldHostedHost" && ModuleName(owner, "text_field_widget") && WidgetValidTextFieldProps(props) {
        edited := TextField(session, WidgetDecodeTextFieldProps(props, *widget_field_codec))
        result.* = WidgetEncodeTextFieldResult(edited, *widget_field_result_codec)
        return 1
    }
    if name == "TextWidthHostedHost" && ModuleName(owner, "text_measure") && WidgetValidTextProps(props) {
        result.* = HostScalar("s32", cast(s64)TextWidth(session, WidgetHostTextProps(props)))
        return 1
    }
    if name == "TextHeightHostedHost" && ModuleName(owner, "text_measure") && WidgetValidTextProps(props) {
        result.* = HostScalar("s32", cast(s64)TextHeight(session, WidgetHostTextProps(props)))
        return 1
    }
    if name == "TextHostedHost" && ModuleName(owner, "text_widget") && WidgetValidTextProps(props) {
        Text(session, WidgetHostTextProps(props))
        return 1
    }
    if name == "ImageHostedHost" && ModuleName(owner, "image_widget") && WidgetValidImageProps(props) {
        image := WidgetDecodeImageProps(props, *widget_image_codec)
        if !WidgetHostImage(*image) {
            return 0
        }
        // A warped image's grid; images inside buttons, title bars and
        // dropdown options are drawn without one.
        mesh_at := HostFieldAt(props, 13, "mesh")
        if mesh_at >= 0 {
            image.mesh.points = WidgetHostMeshPoints(props.fields[mesh_at].value)
        }
        polygon_at := HostFieldAt(props, 14, "clip_polygon")
        if polygon_at >= 0 { image.clip_polygon = WidgetHostImagePoints(props.fields[polygon_at].value) }
        Image(session, image)
        return 1
    }
    if name == "TileMapHostedHost" && ModuleName(owner, "tile_map") && WidgetValidTileMapProps(props) {
        map := WidgetDecodeTileMapProps(props, *widget_tile_map_codec)
        map.tiles = widget_tile_map_codec.tiles_decoded[:HostSliceLength(props, 4, "tiles")]
        map.names = widget_tile_map_codec.names_decoded[:HostSliceLength(props, 5, "names")]
        map.layers = widget_tile_map_codec.layers_decoded[:HostSliceLength(props, 6, "layers")]
        map.nearest_tiles = widget_tile_map_codec.nearest_tiles_decoded[:HostSliceLength(props, 12, "nearest_tiles")]
        // Each picture a cell shows passes the asset policy once, as each of
        // those cells' Images did; a map showing one the bundle may not draw
        // is refused as that Image was.
        for index: 0..cast(s32)map.tiles.count - 1 { widget_tile_map_used[index] = false }
        cells := map.columns * map.rows
        for at: 0..cast(s32)map.layers.count - 1 {
            tile := map.layers[at]
            if at < map.layer_count * cells && tile >= 0 && cast(s64)tile < map.tiles.count { widget_tile_map_used[tile] = true }
        }
        for index: 0..cast(s32)map.tiles.count - 1 {
            if !widget_tile_map_used[index] { continue }
            packed := map.tiles[index]
            if packed == "" {
                if !WidgetHostAssetAllowed(packed) { return 0 }
                continue
            }
            resolved := WidgetHostAssetPath(packed)
            if resolved == "" { return 0 }
            map.tiles[index] = resolved
        }
        result.* = WidgetEncodeTileMapResult(TileMap(session, map), *widget_tile_map_result_codec)
        return 1
    }
    if name == "ButtonHostedHost" && ModuleName(owner, "button_widget") && WidgetValidButtonProps(props) {
        button := WidgetDecodeButtonProps(props, *widget_button_codec)
        if button.icon.id != cast(u32)0 || !WidgetHostImage(*button.image) {
            return 0
        }
        result.* = HostScalar("s32", cast(s64)Button(session, button))
        return 1
    }
    if name == "TextAreaHostedHost" && ModuleName(owner, "text_area_widget") && WidgetValidTextAreaProps(props) {
        area := WidgetDecodeTextAreaProps(props, *widget_area_codec)
        area.colors = widget_area_codec.colors_decoded[:HostSliceLength(props, 16, "colors")]
        area.hidden = widget_area_codec.hidden_decoded[:HostSliceLength(props, 25, "hidden")]
        area.strong = widget_area_codec.strong_decoded[:HostSliceLength(props, 26, "strong")]
        area.italic = widget_area_codec.italic_decoded[:HostSliceLength(props, 27, "italic")]
        area.blocks = widget_area_codec.blocks_decoded[:HostSliceLength(props, 28, "blocks")]
        area.lines = widget_area_codec.lines_decoded[:HostSliceLength(props, 29, "lines")]
        // A box's picture passes the asset policy as an Image's does; one the
        // bundle may not draw shows its label instead.
        for index: 0..cast(s32)area.blocks.count - 1 {
            area.blocks[index].image = WidgetHostAssetPath(area.blocks[index].image)
        }
        edited := TextArea(session, area)
        result.* = WidgetEncodeTextAreaResult(edited, *widget_area_result_codec)
        return 1
    }
    if name == "ScrollHostedHost" && ModuleName(owner, "scroll_widget") && WidgetValidScrollProps(props) {
        if widget_host_depth >= WIDGET_HOST_SCOPE_DEPTH {
            return 0
        }
        frame := Scroll(session, WidgetDecodeScrollProps(props, *widget_scroll_codec))
        if frame.opened {
            widget_host_depth += 1
        }
        result.* = WidgetEncodeScrollResult(frame, *widget_scroll_result_codec)
        return 1
    }
    if name == "DismissibleOverlayHostedHost" && ModuleName(owner, "overlay_widget") &&
    WidgetValidDismissibleOverlayProps(props) {
        overlay := DismissibleOverlay(session,
            WidgetDecodeDismissibleOverlayProps(props, *widget_dismissible_overlay_codec))
        result.* = WidgetEncodeDismissibleOverlayResult(overlay,
            *widget_dismissible_overlay_result_codec)
        return 1
    }
    if name == "PopupHostedHost" && ModuleName(owner, "overlay_widget") &&
    WidgetValidPopupProps(props) {
        popup := Popup(session, WidgetDecodePopupProps(props, *widget_popup_codec))
        result.* = WidgetEncodePopupResult(popup, *widget_popup_result_codec)
        return 1
    }
    if name == "CheckboxHostedHost" && ModuleName(owner, "checkbox_widget") && WidgetValidCheckboxProps(props) {
        checked := Checkbox(session, WidgetDecodeCheckboxProps(props, *widget_checkbox_codec))
        result.* = WidgetEncodeCheckboxValueResult(checked, *widget_checkbox_result_codec)
        return 1
    }
    if name == "PressHostedHost" && ModuleName(owner, "press_widget") && WidgetValidPressProps(props) {
        pressed := Press(session, WidgetDecodePressProps(props, *widget_press_codec))
        result.* = WidgetEncodePressResult(pressed, *widget_press_result_codec)
        return 1
    }
    if name == "ToggleHostedHost" && ModuleName(owner, "toggle_widget") && WidgetValidToggleProps(props) {
        toggled := Toggle(session, WidgetDecodeToggleProps(props, *widget_toggle_codec))
        result.* = WidgetEncodeToggleValueResult(toggled, *widget_toggle_result_codec)
        return 1
    }
    if name == "SpinboxHostedHost" && ModuleName(owner, "spinbox_widget") && WidgetValidSpinboxProps(props) {
        stepped := Spinbox(session, WidgetDecodeSpinboxProps(props, *widget_spinbox_codec))
        result.* = WidgetEncodeSpinboxStepResult(stepped, *widget_spinbox_result_codec)
        return 1
    }
    if name == "TimePickerHostedHost" && ModuleName(owner, "time_picker_widget") && WidgetValidTimePickerProps(props) {
        picked := TimePicker(session, WidgetDecodeTimePickerProps(props, *widget_time_picker_codec))
        result.* = WidgetEncodeTimePickerResult(picked, *widget_time_picker_result_codec)
        return 1
    }
    return 0
}

WidgetHostTabBar :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidTabBarProps(arguments[1]) {
        return 0
    }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice || TextFromCString(values.type_name) != "[]Tab" ||
    values.length > cast(usize)WIDGET_HOST_TAB_LIMIT || (values.length > cast(usize)0 && values.elements == null) {
        return 0
    }
    index: usize = 0
    while index < values.length {
        if !WidgetValidTab(values.elements[index]) {
            return 0
        }
        widget_tabs[index] = WidgetDecodeTab(values.elements[index], *widget_tab_codecs[index])
        index += cast(usize)1
    }
    selected := TabBar(session, WidgetDecodeTabBarProps(arguments[1], *widget_tab_bar_codec),
        widget_tabs[:cast(s32)values.length])
    result.* = WidgetEncodeTabBarResult(selected, *widget_tab_bar_result_codec)
    return 1
}

// A segmented control holds at most 32 options.
WidgetHostSegmentedControl :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidSegmentedControlProps(arguments[1]) {
        return 0
    }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice || TextFromCString(values.type_name) != "[]SegmentOption" ||
    values.length > cast(usize)WIDGET_HOST_OPTION_LIMIT || (values.length > cast(usize)0 && values.elements == null) {
        return 0
    }
    index: usize = 0
    while index < values.length {
        if !WidgetValidSegmentOption(values.elements[index]) {
            return 0
        }
        widget_segments[index] = WidgetDecodeSegmentOption(values.elements[index],
            *widget_segment_codecs[index])
        index += cast(usize)1
    }
    chosen := SegmentedControl(session, WidgetDecodeSegmentedControlProps(arguments[1],
        *widget_segmented_codec), widget_segments[:cast(s32)values.length])
    result.* = WidgetEncodeSegmentedControlResult(chosen, *widget_segmented_result_codec)
    return 1
}

// A title bar's leading image and dropdown option images pass the host's
// asset policy; texture handles never cross.
WidgetHostTitleBar :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidTitleBarProps(arguments[1]) {
        return 0
    }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice || TextFromCString(values.type_name) != "[]DropdownOption" ||
    values.length > cast(usize)WIDGET_HOST_OPTION_LIMIT || (values.length > cast(usize)0 && values.elements == null) {
        return 0
    }
    props := WidgetDecodeTitleBarProps(arguments[1], *widget_title_bar_codec)
    if !WidgetHostImage(*props.leading_image) {
        return 0
    }
    index: usize = 0
    while index < values.length {
        if !WidgetValidDropdownOption(values.elements[index]) {
            return 0
        }
        option := WidgetDecodeDropdownOption(values.elements[index], *widget_option_codecs[index])
        if !WidgetHostImage(*option.image) {
            return 0
        }
        widget_options[index] = option
        index += cast(usize)1
    }
    drawn := TitleBar(session, props, widget_options[:cast(s32)values.length])
    result.* = WidgetEncodeTitleBarResult(drawn, *widget_title_bar_result_codec)
    return 1
}

WidgetHostDropdown :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidDropdownProps(arguments[1]) {
        return 0
    }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice || TextFromCString(values.type_name) != "[]DropdownOption" ||
    values.length > cast(usize)WIDGET_HOST_OPTION_LIMIT || (values.length > cast(usize)0 && values.elements == null) {
        return 0
    }
    props := WidgetDecodeDropdownProps(arguments[1], *widget_dropdown_codec)
    index: usize = 0
    while index < values.length {
        if !WidgetValidDropdownOption(values.elements[index]) {
            return 0
        }
        option := WidgetDecodeDropdownOption(values.elements[index], *widget_option_codecs[index])
        if !WidgetHostImage(*option.image) {
            return 0
        }
        widget_options[index] = option
        index += cast(usize)1
    }
    drawn := Dropdown(session, props, widget_options[:cast(s32)values.length])
    result.* = WidgetEncodeDropdownResult(drawn, *widget_dropdown_result_codec)
    return 1
}

// A dialog over the page. Its action images pass the host's asset policy,
// and its open panel is a scope the bundle Ends, like a scroll's content.
WidgetHostModalFrame :: (session: Session, props: HostValue, result: *HostValue) -> s32 {
    if widget_host_depth >= WIDGET_HOST_SCOPE_DEPTH {
        return 0
    }
    modal := WidgetDecodeModalFrameProps(props, *widget_modal_frame_codec)
    if !WidgetHostImage(*modal.left_image) || !WidgetHostImage(*modal.right_image) {
        return 0
    }
    frame := ModalFrame(session, modal)
    if frame.opened {
        widget_host_depth += 1
    }
    result.* = WidgetEncodeModalFrameResult(frame, *widget_modal_frame_result_codec)
    return 1
}

WidgetHostActionModal :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidActionModalProps(arguments[1]) {
        return 0
    }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice ||
    TextFromCString(values.type_name) != "[]ActionModalAction" ||
    values.length > cast(usize)16 ||
    (values.length > cast(usize)0 && values.elements == null) {
        return 0
    }
    index: usize = 0
    while index < values.length {
        if !WidgetValidActionModalAction(values.elements[index]) {
            return 0
        }
        widget_modal_actions[index] = WidgetDecodeActionModalAction(values.elements[index],
            *widget_modal_action_codecs[index])
        index += cast(usize)1
    }
    drawn := ActionModal(session, WidgetDecodeActionModalProps(arguments[1], *widget_action_modal_codec),
        widget_modal_actions[:cast(s32)values.length])
    result.* = WidgetEncodeActionModalResult(drawn, *widget_action_modal_result_codec)
    return 1
}

// The ordinary context menu owns its overlay, hit testing and dismissal.
// Validate the whole bounded command list before submitting any widget.
WidgetHostContextMenu :: (session: Session, arguments: *HostValue, result: *HostValue) -> s32 {
    if !WidgetValidContextMenuProps(arguments[1]) { return 0 }
    values := arguments[2]
    if values.kind != cast(s32)HostSlice || TextFromCString(values.type_name) != "[]ContextMenuItem" ||
    values.length > cast(usize)WIDGET_HOST_OPTION_LIMIT ||
    (values.length > cast(usize)0 && values.elements == null) { return 0 }
    index: usize = 0
    while index < values.length {
        if !WidgetValidContextMenuItem(values.elements[index]) { return 0 }
        widget_menu_items[index] = WidgetDecodeContextMenuItem(values.elements[index], *widget_menu_item_codecs[index])
        index += cast(usize)1
    }
    drawn := ContextMenu(session, WidgetDecodeContextMenuProps(arguments[1], *widget_context_menu_codec),
        widget_menu_items[:cast(s32)values.length])
    result.* = WidgetEncodeContextMenuResult(drawn, *widget_context_menu_result_codec)
    return 1
}
