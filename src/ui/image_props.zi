#import "drawing_props"
#import "geometry"

ImageFit :: enum {
    ImageFitStretch :: 0
    ImageFitContain :: 1
    ImageFitCover :: 2
}

ImageProps :: struct {
    asset_path: string
    alt_text: string
    bounds: Rectangle
    source: Rectangle
    origin: Vector2
    rotation: float32
    fit: ImageFit
    class_name: s32
    // Runtime texture: honored instead of asset_path when set.
    texture: Texture2D
    key: u64
}
