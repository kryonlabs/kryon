#import "layout"

// Laws for layout arithmetic. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

// A value is clamped into its range, and one inside is kept.
#law ClampStaysInRange forall value: -4..4, low: -2..2, high: -2..2 => low > high || (Clamp(value, low, high) >= low && Clamp(value, low, high) <= high);
#law InsideKept forall value: -2..2, low: -2..2, high: -2..2 => value < low || value > high || Clamp(value, low, high) == value;

// The minimum applies first and the maximum last, so an inverted range
// always ends at the maximum.
#law InvertedEndsAtMaximum forall value: -4..4, low: -2..2, high: -2..2 => low <= high || Clamp(value, low, high) == high;
