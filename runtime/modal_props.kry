#module "modal_props"
#import "ui_control_props.generated.h"

ModalAction :: struct {
    label: const char*
    tone: ButtonTone
    emphasis: ButtonEmphasis
    disabled: bool
}

ModalProps :: struct {
    title: const char*
    class_name: i32
    message: const char*
    actions: const ModalAction*
    action_count: i32
    close_icon: Texture2D
    max_width: i32
    text: char*
    text_size: i32
    cursor_position: *i32
    focused: *bool
    focus_id: i32
}

# Layout result of a custom modal frame: panel rect plus the content area the
# caller draws into, and the optional title-icon click results.
PanelFrame :: struct { int x; int y; int w; int h; int content_x; int content_y; int content_w; int content_h; int left_clicked; int right_clicked; } #type

# Custom-content modal frame: scrim, movable/resizable panel, centered title,
# optional close icons. Implemented by the modal host; declared here so apps
# can build palette-style overlays with their own content.
RenderModalFrame :: (width: i32, height: i32, title: const char*, left_icon: Texture2D, right_icon: Texture2D) -> PanelFrame #extern #export

# Action modal: title, message, and buttons; returns the activated action id
# (0 = dismissed). Implemented by the modal host.
RenderActionModal :: (modal: ModalProps) -> i32 #extern #export
