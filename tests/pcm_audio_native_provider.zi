// Hold this process's actual SDL sink while testing bounded stream pressure.
#import "media_audio_host"
#import "media_audio"
sdl :: #system_library "SDL2";
PauseDevice :: (device: u32, paused: s32) #foreign sdl "__real_SDL_PauseAudioDevice";
pcm_device: u32;
PcmBaseProvider: MediaAudioProvider;
#program_export "__wrap_SDL_PauseAudioDevice"
CaptureDevice :: (device: u32, paused: s32) {
    pcm_device = device
    PauseDevice(device, paused)
}
PcmTestProvider :: (voice: *MediaAudioVoice, command: MediaAudioCommand, bytes: string) -> MediaAudioResult {
    answer := PcmBaseProvider(voice, command, bytes)
    if voice.pcm && answer.code == .Ok && command.operation == .Play { CaptureDevice(pcm_device, 1) }
    if voice.pcm && answer.code == .Ok && command.operation == .Status && voice.state == .Playing { CaptureDevice(pcm_device, 0) }
    return answer
}
