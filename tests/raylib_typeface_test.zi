// Run real Raylib font decoding and measurements without a window. Only the
// texture upload, draw submission and texture disposal boundary is replaced.
#import "raylib_runtime";
SystemTypeface :: #import "system_typeface_linux";
Collection :: #import "typeface_collection";
Text :: #import "std/byte_text_linux";
Geometry :: #import "geometry";
Drawing :: #import "drawing_props";
Clip :: #import "raylib_clip";
raylib :: #system_library "raylib";
c :: #system_library "c";
libm :: #system_library "m";
Floor :: (value: float32) -> float32 #foreign libm "floorf";
ReadFile :: (path: *u8, size: *s32) -> *u8 #foreign raylib "LoadFileData";
FreeFile :: (bytes: *u8) #foreign raylib "UnloadFileData";
DecodeFont :: (bytes: *u8, size: s32, pixels: s32, codepoints: *s32,
    count: s32, kind: s32, actual: *s32) -> *RaylibGlyphInfo #foreign raylib "LoadFontData";
FreeGlyphs :: (glyphs: *RaylibGlyphInfo, count: s32) #foreign raylib "UnloadFontData";
NextCodepoint :: (text: *u8, length: *s32) -> s32 #foreign raylib "GetCodepointNext";
MeasureFont :: (font: RaylibFont, text: *u8, size: float32,
    spacing: float32) -> Geometry.Vector2 #foreign raylib "MeasureTextEx";
Allocate :: (bytes: usize) -> *void #foreign c "malloc";
Free :: (bytes: *void) #foreign c "free";

loaded: s32;
released: s32;
flushes: s32;
filtered: s32;
filters: [512]s32;
text_matrix: Clip.RaylibMatrix;
bad_size: bool;
Drawn :: struct { codepoint: s32; x: float32; y: float32; width: float32 }
drawn: [32]Drawn;
draw_count: s32;
bad_glyph: bool;

CollectionChecks :: () -> bool {
    bytes: [64]u8
    bytes[0] = 116; bytes[1] = 116; bytes[2] = 99; bytes[3] = 102
    bytes[5] = 1; bytes[11] = 1; bytes[15] = 16
    bytes[17] = 1; bytes[21] = 1
    bytes[28] = 104; bytes[29] = 101; bytes[30] = 97; bytes[31] = 100
    bytes[39] = 44; bytes[43] = 13; bytes[44] = 1; bytes[56] = 17
    output: [44]u8
    if Collection.FaceSize(bytes[:], 0) != 44 ||
    Collection.FaceSize(bytes[:], 1) != 0 || Collection.FaceSize(bytes[:], -1) != 0 ||
    Collection.FaceSize(bytes[0:0], 0) != 0 || Collection.FaceSize(bytes[0:56], 0) != 0 ||
    Collection.Face(bytes[:], 0, output[0:43]).count != 0 { return false }
    result := Collection.Face(bytes[:], 0, output[:])
    if result.count != 44 || result[1] != 1 || result[4] != 0 || result[5] != 1 ||
    result[23] != 28 || result[27] != 13 || result[28] != 1 || result[40] != 17 ||
    result[41] != 0 || result[42] != 0 || result[43] != 0 || bytes[52] != 0 { return false }
    // OpenType requires the whole reconstructed font to have this checksum.
    sum: u32
    for word: 0..10 {
        at := word * 4
        sum += (cast(u32)result[at] << cast(u32)24) |
        (cast(u32)result[at + 1] << cast(u32)16) |
        (cast(u32)result[at + 2] << cast(u32)8) | cast(u32)result[at + 3]
    }
    if sum != cast(u32)0xB1B0AFBA { return false }
    bytes[36] = 255
    if Collection.FaceSize(bytes[:], 0) != 0 { return false }
    return true
}

CpuFont :: (bytes: *u8, count: s32, pixels: s32, codepoints: *s32,
    glyph_count: s32) -> RaylibFont {
    result: RaylibFont
    actual: s32
    glyphs := DecodeFont(bytes, count, pixels, codepoints, glyph_count, 0, *actual)
    if glyphs == null || actual <= 0 { return result }
    recs := cast(*Geometry.Rectangle)Allocate(cast(usize)actual * size_of(Geometry.Rectangle))
    if recs == null { FreeGlyphs(glyphs, actual); return result }
    for index: 0..actual - 1 {
        recs[index] = .{0.0, 0.0, cast(float32)glyphs[index].image.width,
            cast(float32)glyphs[index].image.height}
    }
    loaded += 1
    result.base_size = pixels; result.glyph_count = actual
    result.glyphs = cast(*void)glyphs; result.recs = recs
    result.texture.id = cast(u32)loaded
    return result
}

#program_export
__wrap_LoadFontEx :: (path: *u8, pixels: s32, codepoints: *s32,
    glyph_count: s32) -> RaylibFont {
    count: s32
    bytes := ReadFile(path, *count)
    if bytes == null { return RaylibFont.{} }
    defer FreeFile(bytes)
    return CpuFont(bytes, count, pixels, codepoints, glyph_count)
}
#program_export
__wrap_LoadFontFromMemory :: (extension: *u8, bytes: *u8, count: s32,
    pixels: s32, codepoints: *s32, glyph_count: s32) -> RaylibFont {
    unused extension
    return CpuFont(bytes, count, pixels, codepoints, glyph_count)
}
#program_export
__wrap_UnloadFont :: (font: RaylibFont) {
    FreeGlyphs(cast(*RaylibGlyphInfo)font.glyphs, font.glyph_count)
    Free(cast(*void)font.recs)
    released += 1
}
#program_export
__wrap_rlDrawRenderBatchActive :: () { flushes += 1 }
#program_export
__wrap_SetTextureFilter :: (texture: Drawing.Texture2D, filter: s32) {
    if texture.id == 0 || (filter != 0 && filter != 1) { bad_size = true }
    if texture.id < 512 {
        filters[texture.id] = filter
    }
    filtered += 1
}
#program_export
__wrap_rlGetMatrixModelview :: () -> Clip.RaylibMatrix {
    return text_matrix
}
#program_export
__wrap_DrawTextEx :: (font: RaylibFont, text: *u8,
    position: Geometry.Vector2, size: float32, spacing: float32, color: Drawing.Color) {
    unused spacing; unused color
    scale := RaylibTextScale(text_matrix)
    error := size * scale - cast(float32)font.base_size
    if error > 0.0001 || error < -0.0001 {
        bad_size = true
    }
    expected_filter := ifx RaylibTextAligned(text_matrix) then 0 else 1
    if font.texture.id >= 512 || filters[font.texture.id] != expected_filter {
        bad_size = true
    }
    at: s32 = 0
    while text[at] != 0 {
        length: s32
        codepoint := NextCodepoint(*text[at], *length)
        if !RaylibFontHasCodepoint(font, codepoint) { bad_glyph = true }
        glyph: [5]u8
        for index: 0..length - 1 { glyph[index] = text[at + index] }
        glyph[length] = 0
        extent := MeasureFont(font, *glyph[0], size, 0.0)
        if draw_count < 32 { drawn[draw_count] = .{codepoint, position.x, position.y, extent.x} }
        draw_count += 1
        position.x += extent.x
        at += length
    }
}

// Compare measured logical prefixes with the actual submitted screen origins.
// Pixel alignment may move an origin by half a pixel, without accumulating
// rounding error across the run.
CheckOrigins :: (value: string, x: s32, y: s32, size: s32) -> bool {
    at: s32 = 0
    index: s32 = 0
    while at < value.count {
        length: s32
        prefix := RaylibTextWithFallback(value[:at], 0, 0,
            size, Drawing.Color.{}, false).x
        expected := RaylibTextPosition(
            .{cast(float32)x + prefix, cast(float32)y}, text_matrix)
        if drawn[index].x - expected.x > 0.0001 ||
        drawn[index].x - expected.x < -0.0001 ||
        drawn[index].y - expected.y > 0.0001 ||
        drawn[index].y - expected.y < -0.0001 {
            return false
        }
        codepoint_bytes: [5]u8
        remaining := value[at:]
        for byte: 0..3 {
            if byte < remaining.count {
                codepoint_bytes[byte] = remaining[byte]
            }
        }
        unused NextCodepoint(*codepoint_bytes[0], *length)
        at += length
        index += 1
    }
    return index == draw_count
}

#program_export
main :: () -> s32 {
    text_matrix.m0 = 1.0
    text_matrix.m5 = 1.0
    if !CollectionChecks() { return 14 }
    // Requested supplementary characters must be added and deduplicated.
    staged: RaylibTypeface
    if !RaylibAddGlyph(*staged, 0x1F642) ||
    !RaylibAddGlyph(*staged, 0x1F642) || staged.codepoint_count != 1 ||
    !RaylibHasGlyph(*staged, 0x1F642) ||
    RaylibAddGlyph(*staged, 0xD800) || RaylibAddGlyph(*staged, 0x110000) { return 1 }
    RaylibFreeTypefaceSource(*staged)

    path: [1024]u8
    if SystemTypeface.FileFor("sans-serif", 0x4E2D, path[:], null) == "" { return 2 }
    tiny: [1]u8
    if SystemTypeface.FileFor("sans-serif", 0x4E2D, tiny[:], null) != "" ||
    SystemTypeface.FileFor("sans-serif", 0x10FFFF, path[:], null) != "" ||
    SystemTypeface.FileFor("sans-serif", 0xD800, path[:], null) != "" { return 3 }
    if !LoadTypefaceFile("Latin", "assets/fonts/LiberationSans-Regular.ttf", null, 0) ||
    !SelectTypeface("Latin") { return 4 }
    defer ReleaseTypefaces()
    RaylibEnsureGlyphs("中")
    if RaylibFontHasCodepoint(raylib_font, 0x4E2D) { return 5 }

    width := MeasureGlyphWidth("A中B", 20, "Latin")
    RasterText("A中B", 7, 11, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 3 || drawn[0].codepoint != 65 ||
    drawn[1].codepoint != 0x4E2D || drawn[2].codepoint != 66 { return 6 }
    if width <= 0 || !CheckOrigins("A中B", 7, 11, 20) { return 7 }
    before := loaded
    draw_count = 0
    RasterText("A中B", 7, 11, 20, Drawing.Color.{255, 255, 255, 255})
    if loaded != before || raylib_fallback_face_count != 1 { return 8 }
    draw_count = 0
    RasterText("中\n文", 7, 11, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 2 || drawn[1].codepoint != 0x6587 ||
    drawn[1].x != 7.0 || drawn[1].y <= drawn[0].y || flushes == 0 { return 9 }
    if !LoadSystemTypeface("monospace") || !SelectTypeface("monospace") { return 10 }
    draw_count = 0
    RasterText("中", 0, 0, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 1 || drawn[0].codepoint != 0x4E2D { return 11 }
    // Replacing a registered face clears misses and keeps glyphs measurable.
    if !LoadTypefaceFile("monospace", "assets/fonts/DejaVuSans.ttf", null, 0) ||
    raylib_fallback_entry_count != 0 { return 12 }
    draw_count = 0
    RasterText("😀", 0, 0, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 1 || drawn[0].codepoint != 0x1F600 { return 15 }
    // Explicit collection data is retained after the caller frees its bytes.
    cjk_path := Text.TextFromCString(*path[0])
    if cjk_path.count >= 4 && cjk_path[cjk_path.count - 4:cjk_path.count] == ".ttc" {
        count: s32
        bytes := ReadFile(*path[0], *count)
        if bytes == null { return 16 }
        seed: [2]s32 = .[63, 0x4E2D]
        ok := LoadTypefaceData("Collection", ".ttc",
            Text.TextFromBytes(Text.BytesFromPointer(bytes, cast(u64)count)), *seed[0], 2)
        FreeFile(bytes)
        if !ok || !SelectTypeface("Collection") { return 17 }
        draw_count = 0
        RasterText("中", 0, 0, 20, Drawing.Color.{255, 255, 255, 255})
        if bad_glyph || draw_count != 1 || drawn[0].codepoint != 0x4E2D { return 18 }
    }
    // Use registered fallback faces without opening any system fallback, as
    // required on Android. Tiny seeds also exercise adding glyphs lazily.
    ReleaseTypefaces()
    seed: [2]s32 = .[63, 65]
    if !LoadTypefaceFile("Offline Latin", "assets/fonts/LiberationSans-Regular.ttf", *seed[0], 2) ||
    !LoadTypefaceFile("Bundled Chinese", "fonts/noto/NotoSansSC-Regular.otf", *seed[0], 2) ||
    !SelectTypeface("Offline Latin") {
        return 19
    }
    draw_count = 0
    width = MeasureGlyphWidth("A中文B", 20, "Offline Latin")
    RasterText("A中文B", 7, 11, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 4 || drawn[1].codepoint != 0x4E2D ||
    drawn[2].codepoint != 0x6587 || raylib_fallback_face_count != 0 {
        return 20
    }
    if width <= 0 || !CheckOrigins("A中文B", 7, 11, 20) {
        return 21
    }
    before = loaded
    draw_count = 0
    RasterText("A中文B", 7, 11, 20, Drawing.Color.{255, 255, 255, 255})
    if bad_glyph || draw_count != 4 || loaded != before {
        return 22
    }
    // A fractional desktop zoom must draw the rounded atlas at exactly its
    // baked pixel height, with matching measurement and pixel-aligned origins.
    RaylibSetZoom(1.3)
    text_matrix.m0 = 1.3
    text_matrix.m5 = 1.3
    text_matrix.m12 = 114.0
    text_matrix.m13 = 0.4
    draw_count = 0
    width = MeasureGlyphWidth("A中文B", 12, "Offline Latin")
    RasterText("A中文B", 7, 11, 12, Drawing.Color.{255, 255, 255, 255})
    latin_face := *raylib_typefaces[0]
    chinese_face := *raylib_typefaces[1]
    if bad_size || bad_glyph || draw_count != 4 ||
    RaylibTypefaceFontForPixels(latin_face, 16, false).base_size != 16 ||
    filtered < loaded { return 23 }
    if !CheckOrigins("A中文B", 7, 11, 12) { return 24 }
    for index: 0..3 {
        screen := Clip.ClipPoint(text_matrix, drawn[index].x, drawn[index].y)
        if screen.x - Floor(screen.x + 0.5) > 0.0001 ||
        screen.x - Floor(screen.x + 0.5) < -0.0001 ||
        screen.y - Floor(screen.y + 0.5) > 0.0001 ||
        screen.y - Floor(screen.y + 0.5) < -0.0001 { return 25 }
    }
    rotated := text_matrix
    rotated.m1 = 0.5
    original := Geometry.Vector2.{7.0, 11.0}
    preserved := RaylibTextPosition(original, rotated)
    if preserved.x != original.x || preserved.y != original.y { return 26 }

    // The camera/density can differ from the frame's layout/input zoom.
    // Every scale keeps the same logical metrics and native-size glyphs.
    scales: [8]float32 = .[0.5, 0.7, 1.0, 1.3, 1.75, 2.5, 2.6, 4.0]
    baseline := MeasureGlyphWidth("A中文B", 12, "Offline Latin")
    for index: 0..7 {
        RaylibSetZoom(scales[index])
        text_matrix.m0 = scales[index] * 1.25
        text_matrix.m5 = text_matrix.m0
        draw_count = 0
        if MeasureGlyphWidth("A中文B", 12, "Offline Latin") != baseline {
            return 27
        }
        RasterText("A中文B", 7, 11, 12, Drawing.Color.{255, 255, 255, 255})
        if bad_size || bad_glyph || !CheckOrigins("A中文B", 7, 11, 12) {
            return 28
        }
    }

    // More sizes than the cache holds, including glyphs larger than the old
    // 96-pixel ceiling, must stay crisp and release queued atlases safely.
    RaylibSetZoom(1.0)
    text_matrix.m0 = 1.75
    text_matrix.m5 = 1.75
    for size: 97..120 {
        draw_count = 0
        RasterText("A中B", 7, 11, cast(s32)size, Drawing.Color.{255, 255, 255, 255})
        if bad_size || bad_glyph || !CheckOrigins("A中B", 7, 11, cast(s32)size) {
            return 29
        }
    }
    if latin_face.sized_count != RAYLIB_SIZED_FONT_MAX ||
    chinese_face.sized_count != RAYLIB_SIZED_FONT_MAX {
        return 30
    }
    // Returning to a size already cached reuses its atlas, even if zoom changed.
    before = loaded
    RaylibSetZoom(2.5)
    draw_count = 0
    RasterText("A中B", 7, 11, 120, Drawing.Color.{255, 255, 255, 255})
    if loaded != before || bad_size { return 31 }
    // Rotation and shear keep their geometry and interpolated masks while
    // still choosing enough atlas pixels for the transform's largest stretch.
    text_matrix.m0 = 0.78
    text_matrix.m1 = 1.04
    text_matrix.m4 = -1.04
    text_matrix.m5 = 0.78
    draw_count = 0
    RasterText("A中B", 7, 11, 12, Drawing.Color.{255, 255, 255, 255})
    if bad_size || !CheckOrigins("A中B", 7, 11, 12) { return 32 }
    text_matrix.m0 = 1.0
    text_matrix.m1 = 0.0
    text_matrix.m4 = 0.5
    text_matrix.m5 = 1.0
    draw_count = 0
    RasterText("A中B", 7, 11, 12, Drawing.Color.{255, 255, 255, 255})
    if bad_size || !CheckOrigins("A中B", 7, 11, 12) { return 33 }
    ReleaseTypefaces()
    if loaded != released || raylib_fallback_face_count != 0 { return 13 }
    return 0
}
