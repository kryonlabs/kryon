
DPIPlatform :: enum {
    DPIPlatformDesktop :: 0
    DPIPlatformAndroid :: 1
    DPIPlatformWeb :: 2
}
using DPIPlatform;


DPIState :: struct {
    physical_width: s32
    physical_height: s32
    view_width: s32
    view_height: s32
    layout_width: s32
    layout_height: s32
    ui_scale: float32
    ui_scale_clamped: float32
    render_scale: float32
    camera_zoom: float32
    base_width: s32
    base_height: s32
    needs_update: bool
    zoom: float32
}

#program_export
InitialDPI :: () -> DPIState {
    state: DPIState
    state.physical_width = 320
    state.physical_height = 560
    state.view_width = 320
    state.view_height = 560
    state.layout_width = 320
    state.layout_height = 560
    state.ui_scale = 1.0
    state.ui_scale_clamped = 1.0
    state.render_scale = 1.0
    state.camera_zoom = 1.0
    state.base_width = 320
    state.base_height = 560
    state.zoom = 1.0
    return state
}

#scope_file
// The zoom a state carries; a state that never set one is at 100%.
DPIZoomOf :: (state: DPIState) -> float32 {
    if state.zoom > 0.0 { return state.zoom }
    return 1.0
}

// Derive the render scale and layout from the resolved display density and
// the zoom. Everything is drawn at density times zoom, and the layout is the
// view divided by that scale, so a zoom below 100% lays out a larger area
// and a zoom above it a smaller one, as a browser does.
DPIScaled :: (state: DPIState) -> DPIState {
    scale: float32 = state.ui_scale_clamped * DPIZoomOf(state)
    if scale < 0.1 { scale = 0.1 }
    state.render_scale = scale
    layout_width: s32 = cast(s32)(cast(float32)state.physical_width / scale + 0.5)
    layout_height: s32 = cast(s32)(cast(float32)state.physical_height / scale + 0.5)
    if layout_width < 1 { layout_width = 1 }
    if layout_height < 1 { layout_height = 1 }
    state.layout_width = layout_width
    state.layout_height = layout_height
    state.view_width = layout_width
    state.view_height = layout_height
    state.camera_zoom = scale
    state.needs_update = true
    return state
}

#scope_export

#program_export
InvalidateDPI :: (state: DPIState) -> DPIState {
    state.physical_width = -1
    state.physical_height = -1
    state.view_width = -1
    state.view_height = -1
    state.layout_width = -1
    state.layout_height = -1
    state.needs_update = true
    return state
}

// The host passes platform and density observations. Ziran owns the scale and
// layout decision; every backend receives the same resulting state.
#program_export
ResolveDPI :: (state: DPIState, view_width: s32, view_height: s32,
    platform: DPIPlatform, device_density: float32,
    window_scale_x: float32, window_scale_y: float32) -> DPIState {
    if state.base_height <= 0 {
        zoom: float32 = state.zoom
        state = InitialDPI()
        if zoom > 0.0 { state.zoom = zoom }
    }
    if state.physical_width == view_width &&
        state.physical_height == view_height {
        state.needs_update = false
        return state
    }
    state.physical_width = view_width
    state.physical_height = view_height

    viewport_scale: float32 = 1.0
    if view_height > 0 {
        viewport_scale = cast(float32)view_height / cast(float32)state.base_height
    }
    real_dpi: float32 = 1.0
    if platform == cast(DPIPlatform)DPIPlatformAndroid {
        real_dpi = viewport_scale
        if device_density > 0.0 { real_dpi = device_density }
    } else if platform == cast(DPIPlatform)DPIPlatformWeb {
        real_dpi = viewport_scale
    } else {
        if device_density > real_dpi { real_dpi = device_density }
        window_dpi: float32 = window_scale_y
        if window_scale_x > 1.0 { window_dpi = window_scale_x }
        if window_dpi > real_dpi { real_dpi = window_dpi }
    }
    if !(real_dpi > 0.0) || real_dpi > 8.0 { real_dpi = 1.0 }
    state.ui_scale = real_dpi
    state.ui_scale_clamped = real_dpi
    if state.ui_scale_clamped < 1.0 { state.ui_scale_clamped = 1.0 }
    return DPIScaled(state)
}

// Apply the user's zoom on top of the resolved display density: 1.0 is 100%,
// and the factor may go below 1.0 to zoom out. The next ResolveDPI keeps it.
// A state that has not been resolved yet takes the zoom when it is.
#program_export
ZoomDPI :: (state: DPIState, zoom: float32) -> DPIState {
    if !(zoom > 0.0) { zoom = 1.0 }
    if DPIZoomOf(state) == zoom && state.zoom > 0.0 { return state }
    state.zoom = zoom
    if state.physical_width <= 0 || state.physical_height <= 0 { return state }
    return DPIScaled(state)
}

#program_export
OffscreenDPI :: (state: DPIState, view_width: s32, view_height: s32,
    forced_scale: float32, platform: DPIPlatform, device_density: float32,
    window_scale_x: float32, window_scale_y: float32) -> DPIState {
    state = ResolveDPI(state, view_width, view_height, platform,
        device_density, window_scale_x, window_scale_y)
    if !(forced_scale > 0.0) { return state }
    state.ui_scale = forced_scale
    state.ui_scale_clamped = forced_scale
    if state.ui_scale_clamped < 1.0 { state.ui_scale_clamped = 1.0 }
    state.render_scale = state.ui_scale_clamped
    state.layout_width = cast(s32)(cast(float32)view_width / state.render_scale + 0.5)
    state.layout_height = cast(s32)(cast(float32)view_height / state.render_scale + 0.5)
    if state.layout_width < 1 { state.layout_width = 1 }
    if state.layout_height < 1 { state.layout_height = 1 }
    state.view_width = state.layout_width
    state.view_height = state.layout_height
    state.camera_zoom = state.render_scale
    state.needs_update = true
    return state
}

#program_export
ScalePixels :: (px: s32, scale: float32) -> s32 {
    if !(scale > 0.0) { scale = 1.0 }
    return cast(s32)(cast(float32)px * scale + 0.5)
}

#program_export
ClampPixels :: (px: s32, minimum: s32, maximum: s32,
    scale: float32) -> s32 {
    value: s32 = ScalePixels(px, scale)
    low: s32 = ScalePixels(minimum, scale)
    high: s32 = ScalePixels(maximum, scale)
    if value < low { value = low }
    if value > high { value = high }
    return value
}
