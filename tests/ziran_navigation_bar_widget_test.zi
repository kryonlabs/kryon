#import "session"
test_session: Session;
TestSession :: () -> Session {
    if !SessionValid(test_session) { test_session = SessionOpen() }
    return test_session
}

#import "control_props"
#import "geometry"
#import "image_props"
#import "navigation_bar_props"
#import "navigation_bar_widget"
#import "paint_queue"
#import "semantic"
#import "style"
#import "style_sheet"
#import "tree"
#import "tree_input"
#import "widget_kind"

using SemanticKind;
using WidgetKind;
using StyleField;

phase: s32;

#program_export
Frame :: () -> s32 {
    if phase == 0 {
        rules: StyleRules
        rules.count = 1
        rule: StyleRule
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = StyleKindNavigationBar()
        rule.selector.class_name = 9
        rule.style.fields = cast(u32)StyleBackground
        rule.style.background = cast(u32)0x123456ff
        rules.items[0] = rule
        InstallStyleRules(rules)
    }
    items: [3]NavigationBarItem
    items[0].key = cast(u64)41
    items[0].route = 11
    items[0].label = "Home"
    items[0].image.asset_path = "icon.png"
    items[0].image.tint = cast(u32)0x506070ff
    items[0].active = true
    items[1].key = cast(u64)42
    items[1].route = 22
    items[1].label = "Search"
    items[1].image.asset_path = "icon.png"
    items[2].key = cast(u64)43
    items[2].route = 33
    items[2].label = "Blocked"
    items[2].disabled = true
    if phase == 1 {
        first: NavigationBarItem = items[0]
        items[0] = items[1]
        items[1] = first
    }
    if phase == 2 { items[1].disabled = true }
    props: NavigationBarProps
    props.key = cast(u64)10
    props.id = 10
    props.class_name = 9
    props.view_width = 300
    props.view_height = 180
    props.height = 80
    if NavigationBarHeight(props) != 80 { return -30 }
    themed: NavigationBarProps = props
    themed.height = 0
    // Without an explicit height the bar takes the theme's.
    if NavigationBarHeight(themed) != 32 { return -31 }
    TreeStart(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 180.0})
    result: NavigationBarResult = NavigationBar(TestSession(), props,
        items[0:3])
    if !TreeFinish(TestSession()) || result.node != 1 ||
        result.y != 100 || result.height != 80 ||
        TreeCount(TestSession()) != 5 ||
        TreeNodeAt(TestSession(), 1).kind != WidgetKindNavigationBar ||
        TreeNodeAt(TestSession(), 2).kind != WidgetKindButton ||
        TreeNodeAt(TestSession(), 3).kind != WidgetKindButton ||
        TreeNodeAt(TestSession(), 4).kind != WidgetKindButton ||
        TreeNodeAt(TestSession(), 2).semantic_kind !=
            cast(SemanticKind)SemanticButton { return -20 }
    if phase == 0 {
        if result.clicked_index != -1 ||
            TreeHitAt(TestSession(), 150.0, 120.0) != 3 ||
            TreeHitAt(TestSession(), 250.0, 120.0) != -1 { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{150.0, 120.0,
            true, true, false})
        TreePointerUpdate(TestSession(), PointerFrame.{150.0, 120.0,
            false, false, true})
    } else if phase == 1 {
        if result.clicked_index != 0 ||
            result.clicked_route != 22 ||
            TreeNodeAt(TestSession(), 2).semantic_label != "Search" ||
            TreeHitAt(TestSession(), 250.0, 120.0) != -1 { return -2 }
    } else if phase == 2 {
        if result.clicked_index != -1 ||
            TreeHitAt(TestSession(), 150.0, 120.0) != -1 { return -3 }
    }
    PaintFlush(TestSession())
    old: s32 = phase
    phase += 1
    return old
}

#import "ziran_navigation_bar_widget_host"

#program_export
main :: () -> s32 {
    index: s32 = 0
    while index < 3 {
        if Frame() != index || NavigationHostFailed() { return 1 }
        index += 1
    }
    if NavigationFills() < 6 || NavigationOutlines() != 3 ||
        NavigationLabels() != 9 || NavigationImages() != 6 ||
        NavigationBarFills() != 3 || NavigationTintedImages() != 3 { return 2 }
    return 0
}
