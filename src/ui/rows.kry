#module "rows_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_rows_internal.h"
#import "runtime/style.h"
#import "runtime/rows.h"

RowsRuntimeScale :: () -> float {
    return (float)Scale(1000) / 1000.0
}

RowsStyleFrame :: (style_kind: i32, role: i32) -> StyleFrame {
    props: ButtonProps = (ButtonProps){0}
    props.tone = ButtonToneNeutral
    props.emphasis = ButtonEmphasisSoft
    props.size = ControlSizeMedium
    return ui_control_style_frame_role_kind(props,
    ButtonStateNormal, 0, 0.0, 0.0, 0.0, style_kind, role)
}

InfoRowsMetricsForProps :: (rows: InfoRowsProps) -> InfoRowsMetrics {
    return InfoRowsMetricsFor(rows.row_height, rows.padding_x,
    RowsRuntimeScale(), RowsStyleFrame(StyleKindText(),
    InfoRowsTextRole()))
}

LabelTextFieldMetricsForProps :: (row: LabelTextFieldProps) -> LabelTextFieldMetrics {
    return LabelTextFieldMetricsFor(row.label_h, row.field_h,
    row.gap, row.bottom_gap, RowsRuntimeScale(),
    RowsStyleFrame(StyleKindText(), LabelTextFieldLabelRole()),
    RowsStyleFrame(StyleKindTextField(), LabelTextFieldFieldRole()))
}

SectionLabelMetricsForProps :: (label: SectionLabelProps) -> SectionLabelMetrics {
    return SectionLabelMetricsFor(label.height,
    label.icon_diameter, RowsRuntimeScale(),
    RowsStyleFrame(StyleKindText(), SectionLabelRole()))
}

CheckboxRowMetricsForProps :: (row: CheckboxRowProps) -> CheckboxRowMetrics {
    return CheckboxRowMetricsFor(row.height, RowsRuntimeScale(),
    RowsStyleFrame(StyleKindCheckbox(), CheckboxRowRole()))
}

ButtonRowMetricsForProps :: (row: ButtonRowProps) -> ButtonRowMetrics {
    return ButtonRowMetricsFor(row.height, row.gap,
    RowsRuntimeScale(),
    RowsStyleFrame(StyleKindButton(), ButtonRowPrimaryRole()),
    RowsStyleFrame(StyleKindButton(), ButtonRowSecondaryRole()))
}

SpinboxRowMetricsForProps :: (row: SpinboxRowProps) -> SpinboxRowMetrics {
    return SpinboxRowMetricsFor(row.row_height, row.control_width,
    RowsRuntimeScale(),
    RowsStyleFrame(StyleKindSpinbox(), SpinboxRowLabelRole()),
    RowsStyleFrame(StyleKindSpinbox(), SpinboxRowControlRole()))
}

RowsText :: (value: const char*) -> const char* {
    if value == nil { return "" }
    return value
}

RenderInfoRows :: (rows: InfoRowsProps) #export {
    metrics: InfoRowsMetrics = InfoRowsMetricsForProps(rows)
    if rows.rows == nil || rows.row_count <= 0 ||
    rows.width <= 0 || metrics.row_height <= 0 { return }
    surface_style: Style = ui_surface_style()
    empty_props: ButtonProps = (ButtonProps){0}
    separator_style: Style = ui_resolve_button_style_kind(
    empty_props, ButtonStateNormal, StyleKindSeparator())
    text_style: Style = ui_resolve_button_style_kind(
    empty_props, ButtonStateNormal, StyleKindText())
    background: Color = surface_style.background
    if rows.background.a != 0 { background = rows.background }
    separator: Color = separator_style.background
    if rows.separator.a != 0 { separator = rows.separator }
    default_text: Color = text_style.foreground
    if rows.default_text.a != 0 { default_text = rows.default_text }
    layout: InfoRowsLayout = InfoRowsLayoutFor(rows.x, rows.y,
    rows.width, rows.row_count, metrics)
    default_font: i32 = ResolveFont(0,
    StyleFontValue(text_style.fields, text_style.font_size),
    GetFontSize())
    font_token: i32 = PushTextFont(text_style.typeface)
    DrawRectangle((int)layout.background.x,
    (int)layout.background.y, (int)layout.background.width,
    (int)layout.background.height, background)
    index: i32 = 0
    while index < rows.row_count {
        row: InfoRow = rows.rows[index]
        row_layout: InfoRowLayout = InfoRowLayoutFor(rows.x,
        rows.y, rows.width, index, metrics)
        font: i32 = ResolveFont(row.font, 0, default_font)
        text_color: Color = default_text
        if row.color.a != 0 { text_color = row.color }
        if index > 0 {
            DrawLine(rows.x, row_layout.separator_y,
            rows.x + rows.width, row_layout.separator_y, separator)
        }
        RenderControlTextInRect(RowsText(row.text),
        row_layout.text_bounds, font, text_color)
        index += 1
    }
    PopTextFont(font_token)
}

ui_label_text_field_height :: (row: LabelTextFieldProps) -> i32 #export {
    metrics: LabelTextFieldMetrics = LabelTextFieldMetricsForProps(row)
    return metrics.label_height + metrics.gap +
    metrics.field_height + metrics.bottom_gap
}

GetLabelTextFieldHeight :: (row: LabelTextFieldProps) -> i32 #export {
    return ui_label_text_field_height(row)
}

RenderLabelTextField :: (row: LabelTextFieldProps,
x: i32, y: i32, width: i32) -> i32 #export {
    metrics: LabelTextFieldMetrics = LabelTextFieldMetricsForProps(row)
    text_style: Style = ui_resolve_button_style_kind(
    (ButtonProps){0}, ButtonStateNormal, StyleKindText())
    label_font: i32 = ResolveFont(row.label_font,
    StyleFontValue(text_style.fields, text_style.font_size),
    GetSmallFontSize())
    label_color: Color = text_style.foreground
    if row.label_color.a != 0 {
        label_color = row.label_color
    } else {
        label_color.a = RowsMutedAlpha(label_color.a)
    }
    layout: LabelTextFieldLayout = LabelTextFieldLayoutFor(
    x, y, width, (Rectangle){0}, metrics)
    font_token: i32 = PushTextFont(text_style.typeface)
    RenderText(RowsText(row.label), (int)layout.label_bounds.x,
    (int)layout.label_bounds.y, label_font, label_color)
    PopTextFont(font_token)
    field: TextFieldProps = row.field
    field.bounds = layout.field_bounds
    return ui_text_field_render(field)
}

ui_section_label_height :: (label: SectionLabelProps) -> i32 #export {
    return SectionLabelMetricsForProps(label).height
}

RenderSectionLabel :: (label: SectionLabelProps,
x: i32, y: i32) -> i32 #export {
    metrics: SectionLabelMetrics = SectionLabelMetricsForProps(label)
    text_style: Style = ui_resolve_button_style_kind(
    (ButtonProps){0}, ButtonStateNormal, StyleKindText())
    font: i32 = ResolveFont(label.font,
    StyleFontValue(text_style.fields, text_style.font_size),
    GetSmallFontSize())
    color: Color = text_style.foreground
    if label.color.a != 0 {
        color = label.color
    } else {
        color.a = RowsMutedAlpha(color.a)
    }
    value: const char* = RowsText(label.label)
    font_token: i32 = PushTextFont(text_style.typeface)
    RenderText(value, x, y, font, color)
    if !label.info {
        PopTextFont(font_token)
        return 0
    }
    label_width: i32 = TextWidth(value, font)
    PopTextFont(font_token)
    info_button: ButtonProps = (ButtonProps){0}
    info_button.tone = ButtonToneNeutral
    info_button.emphasis = ButtonEmphasisGhost
    info_button.size = ControlSizeSmall
    info_button.pill = 1
    return RenderButtonInfoIndicator(info_button,
    x + label_width + metrics.info_gap,
    y + font / 2 + metrics.info_y_offset,
    metrics.icon_diameter)
}

ui_checkbox_row_height :: (row: CheckboxRowProps) -> i32 #export {
    return CheckboxRowMetricsForProps(row).height
}

RenderCheckboxRow :: (row: CheckboxRowProps,
x: i32, y: i32) -> i32 #export {
    if row.disabled {
        return DrawDisabledCheckboxToggle(x, y, row.label,
        row.value, 1)
    }
    return RenderCheckboxToggle(x, y, row.label, row.value)
}

GetButtonRowHeight :: (row: ButtonRowProps) -> i32 #export {
    metrics: ButtonRowMetrics = ButtonRowMetricsForProps(row)
    if row.items == nil || row.count <= 0 || row.width <= 0 {
        return metrics.height
    }
    row_width: i32 = 0
    rows: i32 = 1
    font: i32 = GetSmallFontSize()
    index: i32 = 0
    while index < row.count {
        label: const char* = RowsText(row.items[index].label)
        item_width: i32 = ButtonRowItemWidth(TextWidth(label, font),
        metrics)
        wrap: ButtonRowWrapDecision = ButtonRowWrapFor(row_width,
        item_width, row.width, metrics.gap)
        if wrap.wraps { rows += 1 }
        row_width = wrap.row_width
        index += 1
    }
    return ButtonRowTotalHeight(rows, metrics.height, metrics.gap)
}

GetSpinboxRowHeight :: (row: SpinboxRowProps) -> i32 #export {
    return SpinboxRowMetricsForProps(row).row_height
}

RowFormBegin :: (x: i32, y: i32, width: i32) -> RowForm #export {
    form: RowForm = (RowForm){0}
    form.x = x
    form.y = y
    form.width = width
    form.cursor_y = y
    return form
}

RowFormY :: (form: const RowForm*) -> i32 #export {
    if form == nil { return 0 }
    return form->cursor_y
}

RowFormAdvance :: (form: *RowForm, height: i32) -> i32 #export {
    if form == nil { return 0 }
    y: i32 = form->cursor_y
    form->cursor_y = FormAdvanceY(form->cursor_y,
    height, form->gap)
    return y
}

RowFormTakeRect :: (form: *RowForm,
height: i32) -> Rectangle #export {
    if form == nil {
        empty: Rectangle = (Rectangle){0}
        return empty
    }
    result: FormRectResult = FormRectFor(form->x,
    form->cursor_y, form->width, height, form->gap)
    form->last_bounds = result.bounds
    form->cursor_y = result.next_cursor_y
    return result.bounds
}

RowFormNoteFocus :: (form: *RowForm, focus_id: i32,
bounds: Rectangle) #export {
    if form == nil || focus_id <= 0 { return }
    if IsFocusActive(focus_id) {
        form->focused_rect = bounds
        form->focused_rect_valid = 1
    }
}

RowFormEnsureFocusedVisible :: (form: *RowForm,
area: ScrollArea, margin: i32) -> i32 #export {
    if form == nil || !form->focused_rect_valid { return 0 }
    EnsureScrollRectVisible(area, form->focused_rect, margin)
    form->focused_rect_valid = 0
    return 1
}

RowFormSection :: (form: *RowForm,
label: SectionLabelProps) -> i32 #export {
    if form == nil { return 0 }
    y: i32 = form->cursor_y
    RowFormTakeRect(form, ui_section_label_height(label))
    return RenderSectionLabel(label, form->x, y)
}

RowFormTextField :: (form: *RowForm,
row: LabelTextFieldProps) -> i32 #export {
    if form == nil { return 0 }
    y: i32 = form->cursor_y
    RowFormTakeRect(form, ui_label_text_field_height(row))
    result: i32 = RenderLabelTextField(row, form->x,
    y, form->width)
    metrics: LabelTextFieldMetrics = LabelTextFieldMetricsForProps(row)
    field_bounds: Rectangle = LabelTextFieldLayoutFor(form->x,
    y, form->width, row.field.bounds, metrics).field_bounds
    RowFormNoteFocus(form, row.field.focus_id, field_bounds)
    return result
}

RowFormCheckbox :: (form: *RowForm,
row: CheckboxRowProps) -> i32 #export {
    if form == nil { return 0 }
    y: i32 = form->cursor_y
    RowFormTakeRect(form, ui_checkbox_row_height(row))
    return RenderCheckboxRow(row, form->x, y)
}

RowFormSpinbox :: (form: *RowForm,
row: SpinboxRowProps) -> i32 #export {
    if form == nil { return 0 }
    y: i32 = form->cursor_y
    metrics: SpinboxRowMetrics = SpinboxRowMetricsForProps(row)
    RowFormTakeRect(form, metrics.row_height)
    label_font: i32 = ResolveFont(row.label_font, 0,
    GetFontSize())
    layout: SpinboxRowLayout = SpinboxRowLayoutFor(form->x,
    y, form->width, row.label_width, row.spinbox.bounds, metrics)
    text_style: Style = ui_resolve_button_style_kind(
    (ButtonProps){0}, ButtonStateNormal, StyleKindText())
    label_color: Color = text_style.foreground
    if row.label_color.a != 0 { label_color = row.label_color }
    RenderControlTextInRect(RowsText(row.label),
    layout.label_bounds, label_font, label_color)
    spinbox: SpinboxProps = row.spinbox
    spinbox.bounds = layout.spinbox_bounds
    return Spinbox(spinbox)
}

RowFormButtons :: (form: *RowForm,
row: ButtonRowProps) -> i32 #export {
    if form == nil { return -1 }
    row.x = form->x
    row.y = form->cursor_y
    row.width = form->width
    RowFormTakeRect(form, GetButtonRowHeight(row))
    return RenderButtonRow(row)
}

RenderButtonRow :: (row: ButtonRowProps) -> i32 #export {
    metrics: ButtonRowMetrics = ButtonRowMetricsForProps(row)
    if row.height <= 0 { row.height = metrics.height }
    if row.items == nil || row.count <= 0 || row.width <= 0 {
        return -1
    }
    clicked: i32 = -1
    row_start: i32 = 0
    row_width: i32 = 0
    row_count: i32 = 0
    y: i32 = row.y
    font: i32 = GetSmallFontSize()
    index: i32 = 0
    while index <= row.count {
        end_row: i32 = index == row.count
        wrap: ButtonRowWrapDecision = (ButtonRowWrapDecision){0}
        if !end_row {
            label: const char* = RowsText(row.items[index].label)
            item_width: i32 = ButtonRowItemWidth(
            TextWidth(label, font), metrics)
            wrap = ButtonRowWrapFor(row_width, item_width,
            row.width, metrics.gap)
        }
        if !end_row && !wrap.wraps {
            row_width = wrap.row_width
            row_count += 1
            index += 1
            continue
        }
        if row_count > 0 {
            placement: ButtonRowPlacement = ButtonRowPlacementFor(
            row.x, row.width, row_count, metrics.gap)
            if placement.button_width <= 0 { return clicked }
            x: i32 = placement.start_x
            row_index: i32 = 0
            while row_index < row_count {
                item_index: i32 = row_start + row_index
                item: ButtonRowItem = row.items[item_index]
                props: ButtonProps = (ButtonProps){0}
                props.bounds = (Rectangle){(float)x, (float)y,
                    (float)placement.button_width, (float)row.height}
                props.label = item.label
                props.tone = item.tone
                props.emphasis = item.emphasis
                props.disabled = item.disabled
                if Button(props) { clicked = item_index }
                x += placement.button_width + metrics.gap
                row_index += 1
            }
            y = ButtonRowNextY(y, row.height, metrics.gap)
        }
        row_start = index
        row_width = 0
        row_count = 0
        if !end_row {
            row_width = wrap.row_width
            row_count = 1
        }
        index += 1
    }
    return clicked
}
