// Submit the standard widget contract from a portable composition.
#if #defined(KRYON_HOSTED_UI) {
    #import "session"
    #import "toggle_props"
    host_api :: #system_library "host_api";
    ToggleHostedHost :: (session: Session, props: ToggleProps) -> ToggleValueResult #foreign host_api;
    #program_export
    Toggle :: (session: Session, props: ToggleProps) -> ToggleValueResult {
        return ToggleHostedHost(session, props)
    }
} else {
#import "session"
#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "style"
#import "style_sheet"
#import "surface"
#import "toggle"
#import "toggle_props"
#import "tree"
#import "tree_input"
#import "widget_kind"

using WidgetKind;
using ButtonTone;
using ButtonEmphasis;
using ControlSize;
using ButtonState;
using StyleField;

#program_export
ToggleDefaultFace :: (kind: s32, role: s32,
    tone: ButtonTone, disabled: bool) -> StyleData {
    face: StyleData
    face.fields = cast(u32)StyleBackground | cast(u32)StyleForeground |
        cast(u32)StyleBorder | cast(u32)StyleFocus |
        cast(u32)StyleBorderWidth | cast(u32)StyleOpacity |
        cast(u32)StyleFontSize
    face.background = cast(u32)0xd1d5dbff
    face.foreground = cast(u32)0x374151ff
    face.border = cast(u32)0x00000000
    face.focus = cast(u32)0x2563ebff
    face.border_width = 0.0
    face.opacity = 1.0
    face.font_size = 14.0
    if kind == StyleKindToggleThumb() {
        face.background = cast(u32)0xffffffff
        face.foreground = cast(u32)0xffffffff
        face.border = cast(u32)0x94a3b8ff
        face.border_width = 1.0
    } else if tone == cast(ButtonTone)ButtonToneAccent {
        face.background = cast(u32)0x2563ebff
        face.foreground = cast(u32)0xffffffff
    } else if role == ToggleLabelRole() {
        face.background = cast(u32)0x00000000
    }
    if disabled {
        face.background = Opacity(face.background, 0.45)
        face.foreground = Opacity(face.foreground, 0.45)
        face.border = Opacity(face.border, 0.45)
    }
    return face
}

#program_export
ToggleFaceFor :: (props: ToggleProps,
    kind: s32, role: s32, tone: ButtonTone,
    state: s32) -> StyleFrame {
    facts: StyleFacts = StyleControlRoleFacts(kind, props.id,
        props.class_name, role, cast(s32)tone,
        cast(s32)ButtonEmphasisSoft, cast(s32)ControlSizeMedium, state)
    frame: StyleFrame
    frame.value = ResolveInstalledStyleRules(
        ToggleDefaultFace(kind, role, tone, props.disabled),
        facts, state)
    return frame
}

// A switch track is a pill. A labeled toggle is a segmented control whose
// corners follow the theme radius, never rounder than half its height.
ToggleCornerRadius :: (bounds: Rectangle, style_radius: float32,
    has_labels: bool) -> float32 {
    pill: float32 = PillRadius(bounds)
    if !has_labels || style_radius <= 0.0 || style_radius > pill {
        return pill
    }
    return style_radius
}

#program_export
PaintToggleForNode :: (session: Session, node: s32, props: ToggleProps,
    paint: TogglePaint, font: s32) {
    track_opacity: float32 = StyleOpacityValue(paint.track.value.fields,
        paint.track.value.opacity)
    track_radius: float32 = ToggleCornerRadius(paint.track_bounds,
        paint.track.value.radius, paint.has_labels)
    PaintRoundedFill(session, node, paint.track_bounds, track_radius, 16,
        ColorFromPacked(Opacity(paint.track.value.background,
            track_opacity)))
    if paint.track.value.border_width > 0.0 {
        PaintRoundedOutline(session, node, paint.track_bounds, track_radius, 16,
            paint.track.value.border_width,
            ColorFromPacked(Opacity(paint.track.value.border,
                track_opacity)))
    }
    if paint.has_labels {
        active_opacity: float32 = StyleOpacityValue(
            paint.active.value.fields, paint.active.value.opacity)
        active_radius: float32 = ToggleCornerRadius(paint.active_bounds,
            paint.active.value.radius, true)
        PaintRoundedFill(session, node, paint.active_bounds, active_radius, 16,
            ColorFromPacked(Opacity(paint.active.value.background,
                active_opacity)))
        if paint.active.value.border_width > 0.0 {
            PaintRoundedOutline(session, node, paint.active_bounds, active_radius, 16,
                paint.active.value.border_width,
                ColorFromPacked(Opacity(paint.active.value.border,
                    active_opacity)))
        }
        // Each label shows only within its half of the track.
        off_half: Rectangle = paint.track_bounds
        off_half.width = paint.track_bounds.width * 0.5
        on_half: Rectangle = off_half
        on_half.x = paint.track_bounds.x + off_half.width
        if props.off_label != "" {
            PaintClippedLabel(session, node, props.off_label,
                cast(s32)paint.off_label_bounds.x,
                cast(s32)paint.off_label_bounds.y, font,
                ColorFromPacked(paint.off_label_color), off_half)
        }
        if props.on_label != "" {
            PaintClippedLabel(session, node, props.on_label,
                cast(s32)paint.on_label_bounds.x,
                cast(s32)paint.on_label_bounds.y, font,
                ColorFromPacked(paint.on_label_color), on_half)
        }
    } else {
        thumb: Rectangle = Rectangle.{
            paint.thumb_x - paint.thumb_radius,
            paint.thumb_y - paint.thumb_radius,
            paint.thumb_radius * 2.0, paint.thumb_radius * 2.0}
        PaintRoundedFill(session, node, thumb, paint.thumb_radius, 16,
            ColorFromPacked(paint.thumb_fill_color))
        if paint.thumb.value.border_width > 0.0 {
            PaintRoundedOutline(session, node, thumb, paint.thumb_radius, 16,
                paint.thumb.value.border_width,
                ColorFromPacked(paint.thumb_edge_color))
        }
    }
}

// The toggle's styles and label widths for a value and pointer state.
ToggleSpecFor :: (props: ToggleProps, value: bool, hovered: bool,
    pressed: bool) -> ToggleSpec {
    spec: ToggleSpec
    spec.bounds = props.bounds
    spec.checked = value
    spec.enabled = !props.disabled
    spec.hovered = hovered
    spec.pressed = pressed
    spec.has_labels = props.off_label != "" || props.on_label != ""
    spec.scale = 1.0
    state: s32 = ResolveState(cast(s32)ButtonStateAuto, props.disabled,
        false, pressed, hovered, false, value)
    tone: ButtonTone = cast(ButtonTone)ButtonToneNeutral
    if value && !spec.has_labels { tone = cast(ButtonTone)ButtonToneAccent }
    spec.track = ToggleFaceFor(props, StyleKindToggle(),
        ToggleTrackRoleFor(value, spec.has_labels), tone, state)
    spec.active = ToggleFaceFor(props, StyleKindToggle(), ToggleFillRole(),
        cast(ButtonTone)ButtonToneAccent, state)
    spec.label = ToggleFaceFor(props, StyleKindToggle(), ToggleLabelRole(),
        cast(ButtonTone)ButtonToneNeutral, state)
    spec.thumb = ToggleFaceFor(props, StyleKindToggleThumb(), StyleAny(),
        tone, state)
    spec.font = ResolveFont(0,
        StyleFontValue(spec.label.value.fields, spec.label.value.font_size), 14)
    if props.off_label != "" {
        spec.off_width = GlyphWidth(props.off_label, spec.font,
            spec.label.value.typeface)
    }
    if props.on_label != "" {
        spec.on_width = GlyphWidth(props.on_label, spec.font,
            spec.label.value.typeface)
    }
    return spec
}

// The size that shows a toggle whole: its switch, or both its labels with
// their padding. A toggle given a size of 0 takes this size; one given less
// keeps to its bounds, so a layout places it with this size.
#program_export
ToggleMinimumSize :: (props: ToggleProps) -> Vector2 {
    spec: ToggleSpec = ToggleSpecFor(props, props.value, false, false)
    return Vector2.{
        cast(float32)ToggleMinimumWidthForStyle(spec.has_labels,
            spec.off_width, spec.on_width, spec.scale, spec.track,
            spec.active, spec.label),
        cast(float32)ToggleMinimumHeightForStyle(spec.scale, spec.track,
            spec.thumb)}
}

// The caller retains the value returned here and supplies it on the next
// frame. Pointer activation is consumed from the previous committed tree.
#program_export
Toggle :: (session: Session, props: ToggleProps) -> ToggleValueResult {
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    previous: s32 = -1
    if TreeIsBuilding(session) {
        previous = TreePrevious(session, TreeCurrentParent(session), key, WidgetKindToggle)
    }
    result: ToggleValueResult = ToggleValueFor(props.value,
        TreeTakeActivationAt(session, previous), !props.disabled, true)
    spec: ToggleSpec = ToggleSpecFor(props, result.value,
        TreeHoveredAt(session, previous), TreePressedAt(session, previous))
    has_labels: bool = spec.has_labels
    label: StyleFrame = spec.label
    font: s32 = spec.font
    paint: TogglePaint = TogglePaintFor(spec)
    if has_labels {
        inactive_color: u32 = Opacity(label.value.foreground,
            StyleOpacityValue(label.value.fields, label.value.opacity))
        if result.value {
            paint.off_label_color = inactive_color
        } else {
            paint.on_label_color = inactive_color
        }
    }
    node: s32 = -1
    if TreeIsBuilding(session) {
        node = TreeSubmitCurrent(session, key, WidgetKindToggle, paint.bounds)
        if node < 0 { return result }
        TreeSetInteractive(session, node, props.disabled, false, props.id)
        TreeSetSelected(session, node, result.value)
        semantic_label: string = props.label
        if semantic_label == "" { semantic_label = props.on_label }
        if semantic_label == "" { semantic_label = props.off_label }
        TreeSetLabel(session, node, semantic_label)
    }
    PaintToggleForNode(session, node, props, paint, font)
    return result
}

}
