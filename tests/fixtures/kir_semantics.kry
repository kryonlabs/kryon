#module "kir_semantics"

KirSemAdd :: (a: i32, b: i32) -> i32 #export {
    return a + b
}

KirSemSub :: (a: i32, b: i32) -> i32 #export {
    return a - b
}

KirSemDiv :: (a: i32, b: i32) -> i32 #export {
    return a / b
}

KirSemTemp :: (a: i32, b: i32) -> i32 #export {
    t: i32 = a + b
    u: i32 = t * 3
    t = t - 1
    return t + u
}

KirSemBranch :: (flag: bool, unused: i32) -> i32 #export {
    if flag { return 1 }
    return 0
}

KirSemMax :: (a: i32, b: i32) -> i32 #export {
    if a < b { return b }
    return a
}

KirSemClamp :: (v: i32, limit: i32) -> i32 #export {
    if v < 0 { return 0 }
    if v > limit { return limit }
    return v
}

KirSemLoop :: (n: i32, unused: i32) -> i32 #export {
    total: i32 = 0
    i: i32 = 0
    while i < n {
        total = total + i
        i = i + 1
    }
    return total
}

KirSemAbs :: (v: i32) -> i32 #export {
    if v < 0 { return -v }
    return v
}

KirSemCall :: (v: i32, unused: i32) -> i32 #export {
    return KirSemAbs(v)
}

KirSemRec :: (n: i32, unused: i32) -> i32 #export {
    if n <= 0 { return 0 }
    return KirSemRec(n - 1, 0) + 1
}

KirSemFloat :: (v: i32) -> i32 #export {
    x: float = 1.5
    return v + (i32)x
}
