#import "kryon.h"

app "Native Composed Combo Parity" {
    size 320 220
    fps 60
}

state {
    combo_open: bool = true
    combo_close: bool = false
    combo_action: int = 0
    combo_checked: int = 0
    combo_text: [32] char = "edit"
    combo_cursor: int = 4
    combo_cleanup_open: bool = true
    popup_open: bool = true
    popup_close: bool = false
    popup_action: int = 0
    popup_background: int = 0
    tooltip_frames: int = 0
    tooltip_background: int = 0
    modal_open: bool = true
    modal_frames: int = 0
    modal_background: int = 0
    context_open: bool = false
    context_frames: int = 0
    context_action: int = 0
    popup_drag_open: bool = true
    popup_drag_values: [1] float = {10.0f}
    popup_shortcut_open: bool = true
    popup_shortcut_inside: int = 0
    popup_shortcut_background: int = 0
    popup_tree_inside_open: bool = false
    popup_tree_background_open: bool = false
}

composed_popup_shortcut_frame :: () #ui {
    Screen root: {
        Popup shortcut_owner: {
            bounds = {20,20,120,100}
            id = 27070
            open = &popup_shortcut_open
            if AcceleratorPressed((Accelerator){KEY_C,1,0,0,77}) == 77 {
                popup_shortcut_inside += 1
            }
            Collapsible((CollapsibleProps){.bounds={30,50,90,28},.label="Popup tree",.open=&popup_tree_inside_open,.tree=1,.id=27071})
        }
        if AcceleratorPressed((Accelerator){KEY_C,1,0,0,78}) == 78 {
            popup_shortcut_background += 1
        }
        Collapsible((CollapsibleProps){.bounds={170,50,120,28},.label="Background tree",.open=&popup_tree_background_open,.tree=1,.id=27072})
    }
}

composed_popup_drag_frame :: () #ui {
    Screen root: {
        Popup drag_owner: {
            bounds = {20,20,120,100}
            id = 27060
            open = &popup_drag_open
            DragFloat((DragFloatProps){.bounds={30,30,80,24},.id=27061,.values=popup_drag_values,.value_count=1,.speed=1.0f,.min=0.0f,.max=500.0f})
        }
        if !popup_drag_open {
            DragFloat((DragFloatProps){.bounds={30,30,80,24},.id=27061,.values=popup_drag_values,.value_count=1,.speed=1.0f,.min=0.0f,.max=500.0f})
        }
    }
}

composed_context_frame :: () #ui {
    Screen root: {
        Popup context: {
            bounds = {90,60,150,80}
            id = 27050
            open = &context_open
            trigger = {20,20,100,32}
            flags = PopupContext
            context_frames += 1
            if Button((ButtonProps){.bounds={100,70,100,26},.label="Context action",.id=27051}) {
                context_action += 1
                ClosePopup()
            }
        }
    }
}

composed_modal_frame :: () #ui {
    Screen root: {
        Popup modal: {
            bounds = {70,50,180,110}
            id = 27040
            open = &modal_open
            flags = PopupModal
            modal_frames += 1
            Column modal_content: {
                bounds = {80,60,160,80}
                gap = 4
                Text((TextProps){.text="Native modal children",.font=Text14,.color=GetThemeText(),.wrap=TextWrapNone})
                Button((ButtonProps){.bounds={0,0,100,24},.label="Confirm",.id=27041})
            }
        }
        if Button((ButtonProps){.bounds={270,160,40,30},.label="Back",.id=27042}) {
            modal_background += 1
        }
    }
}

composed_tooltip_frame :: () #ui {
    Screen root: {
        Popup help: {
            bounds = {90,60,150,70}
            id = 27030
            trigger = {20,20,80,30}
            flags = PopupTooltip
            tooltip_frames += 1
            Column tooltip_content: {
                bounds = {98,68,134,54}
                gap = 4
                Text((TextProps){.text="Native children",.font=Text14,.color=GetThemeText(),.wrap=TextWrapNone})
                if Button((ButtonProps){.bounds={0,0,100,24},.label="Details",.id=27031}) {
                    tooltip_frames += 10
                }
            }
        }
        if Button((ButtonProps){.bounds={20,20,80,30},.label="Hover",.id=27032}) {
            tooltip_background += 1
        }
    }
}

composed_combo_early_exit :: (leave: bool) #ui {
    Combo cleanup: {
        bounds = {180,20,120,28}
        popup_size = (Vector2){120,80}
        preview = "Cleanup"
        id = 27010
        open = &combo_cleanup_open
        if leave {
            return
        }
        Text((TextProps){.bounds={184, 56, 0, 0}, .text="balanced", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
    }
}

composed_combo_frame :: () #ui {
    Screen root: {
        Combo popup: {
            bounds = {20,20,120,28}
            popup_size = (Vector2){150,100}
            preview = "Tools"
            id = 27000
            open = &combo_open
            flags = ComboPopupAlignLeft | ComboHeightSmall
            Row popup_row: {
                bounds = {24,64,140,30}
                gap = 6
                key = Key("composed-popup-row")
                if Button((ButtonProps){.bounds = {0,0,50,26}, .label = "Run", .id = 27001}) {
                    combo_action += 1
                }
                Checkbox(27003, 80, 64, "", &combo_checked)
                TextField((TextFieldProps){.bounds = {0,0,50,26}, .text = combo_text, .text_size = sizeof(combo_text), .cursor_position = &combo_cursor, .focus_id = 27002})
            }
            if combo_close {
                CloseCombo()
            }
        }
    }
}

composed_popup_frame :: () #ui {
    Screen root: {
        Popup tools: {
            bounds = {170,50,130,100}
            id = 27020
            open = &popup_open
            Row popup_actions: {
                bounds = {176,60,118,30}
                gap = 6
                if Button((ButtonProps){.bounds = {0,0,54,26}, .label = "Apply", .id = 27021}) {
                    popup_action += 1
                }
                Checkbox(27022, 240, 64, "", &combo_checked)
            }
            if popup_close {
                ClosePopup()
            }
        }
        if Button((ButtonProps){.bounds = {170,160,130,28}, .label = "Background", .id = 27023}) {
            popup_background += 1
        }
    }
}
