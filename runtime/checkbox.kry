#module "checkbox"
#import "control_props"
#import "drawing_props"
#import "style"
#import "surface"

CheckboxSpec :: struct {
    bounds: Rectangle
    checked: bool
    enabled: bool
    hovered: bool
    pressed: bool
    focused: bool
    scale: float
    box: StyleFrame
    active: StyleFrame
    label: StyleFrame
}

CheckboxPaint :: struct {
    bounds: Rectangle
    slot_bounds: Rectangle
    box_bounds: Rectangle
    state_bounds: Rectangle
    focus_bounds: Rectangle
    check_start: Vector2
    check_middle: Vector2
    check_end: Vector2
    box: StyleFrame
    active: StyleFrame
    fill_color: u32
    border_color: u32
    mark_color: u32
    state_color: u32
    focus_color: u32
    label_color: u32
    radius: float
    border_width: float
    mark_width: float
    state_radius: float
    focus_radius: float
    show_fill: bool
    show_mark: bool
    show_state: bool
    show_focus: bool
}

CheckboxLayout :: struct {
    bounds: Rectangle
    slot_bounds: Rectangle
    label_x: float
    label_y: float
}

CheckboxFlagResult :: struct {
    flags: u32
    checked: bool
    changed: bool
}

CheckboxSlotSize :: (scale: float, box: StyleFrame) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    size: float = box.value.padding_x
    if size <= 0.0 { size = 22.0 }
    return (i32)(size * scale)
}

CheckboxBoxSize :: (scale: float, box: StyleFrame) -> i32 #export {
    if scale <= 0.0 { scale = 1.0 }
    size: float = box.value.icon_size
    if size <= 0.0 { size = 20.0 }
    return (i32)(size * scale)
}

CheckboxLabelXFor :: (slot_bounds: Rectangle, scale: float,
    label: StyleFrame) -> float #export {
    if scale <= 0.0 { scale = 1.0 }
    gap: float = label.value.gap
    if gap <= 0.0 { gap = 10.0 }
    return slot_bounds.x + slot_bounds.width + gap * scale
}

CheckboxLabelYFor :: (bounds: Rectangle, text_line_height: float) -> float #export {
    return bounds.y + (bounds.height - text_line_height) / 2.0
}

CheckboxLayoutForText :: (x: float, y: float, label_width: float,
    text_line_height: float, scale: float, box: StyleFrame,
    label: StyleFrame) -> CheckboxLayout #export {
    layout: CheckboxLayout
    if scale <= 0.0 { scale = 1.0 }
    slot_size: float = (float)CheckboxSlotSize(scale, box)
    gap: float = label.value.gap
    if gap <= 0.0 { gap = 10.0 }
    layout.bounds.x = x
    layout.bounds.y = y
    layout.bounds.width = slot_size + gap * scale + label_width
    layout.bounds.height = slot_size
    if layout.bounds.height < text_line_height {
        layout.bounds.height = text_line_height
    }
    layout.slot_bounds = layout.bounds
    layout.slot_bounds.width = slot_size
    layout.label_x = CheckboxLabelXFor(layout.slot_bounds, scale, label)
    layout.label_y = CheckboxLabelYFor(layout.bounds, text_line_height)
    return layout
}

CheckboxLayoutFor :: (x: float, y: float, label_width: float,
    scale: float, box: StyleFrame, label: StyleFrame) -> CheckboxLayout #export {
    return CheckboxLayoutForText(x, y, label_width,
        (float)CheckboxSlotSize(scale, box), scale, box, label)
}

CheckboxFlagApply :: (flags: u32, flag_value: u32, pressed: bool) -> CheckboxFlagResult #export {
    result: CheckboxFlagResult
    result.flags = flags
    result.checked = (flags & flag_value) == flag_value
    result.changed = false
    if pressed {
        if result.checked {
            result.flags = flags & ~flag_value
        } else {
            result.flags = flags | flag_value
        }
        result.checked = !result.checked
        result.changed = true
    }
    return result
}

CheckboxPaintFor :: (spec: CheckboxSpec) -> CheckboxPaint #export {
    paint: CheckboxPaint
    scale: float = spec.scale
    if scale <= 0.0 { scale = 1.0 }

    slot_size: float = (float)CheckboxSlotSize(scale, spec.box)
    box_size: float = (float)CheckboxBoxSize(scale, spec.box)
    state_outset: float = spec.box.value.gap
    focus_outset: float = spec.box.value.padding_y
    mark_inset: float = spec.active.value.padding_x
    mark_width: float = spec.active.value.icon_size
    if state_outset <= 0.0 { state_outset = 4.0 }
    if focus_outset <= 0.0 { focus_outset = 3.0 }
    if mark_inset <= 0.0 { mark_inset = 5.0 }
    if mark_width <= 0.0 { mark_width = 2.4 }
    state_outset *= scale
    focus_outset *= scale
    mark_inset *= scale
    mark_width *= scale
    border_width: float = spec.box.value.border_width * scale

    paint.bounds = spec.bounds
    paint.slot_bounds.x = spec.bounds.x
    paint.slot_bounds.y = spec.bounds.y + (spec.bounds.height - slot_size) * 0.5
    paint.slot_bounds.width = slot_size
    paint.slot_bounds.height = slot_size

    paint.box_bounds.x = paint.slot_bounds.x + (slot_size - box_size) * 0.5
    paint.box_bounds.y = paint.slot_bounds.y + (slot_size - box_size) * 0.5
    paint.box_bounds.width = box_size
    paint.box_bounds.height = box_size

    paint.state_bounds.x = paint.box_bounds.x - state_outset
    paint.state_bounds.y = paint.box_bounds.y - state_outset
    paint.state_bounds.width = paint.box_bounds.width + state_outset * 2.0
    paint.state_bounds.height = paint.box_bounds.height + state_outset * 2.0

    paint.focus_bounds.x = paint.box_bounds.x - focus_outset
    paint.focus_bounds.y = paint.box_bounds.y - focus_outset
    paint.focus_bounds.width = paint.box_bounds.width + focus_outset * 2.0
    paint.focus_bounds.height = paint.box_bounds.height + focus_outset * 2.0

    paint.check_start.x = paint.box_bounds.x + mark_inset
    paint.check_start.y = paint.box_bounds.y + paint.box_bounds.height * 0.53
    paint.check_middle.x = paint.box_bounds.x + paint.box_bounds.width * 0.42
    paint.check_middle.y = paint.box_bounds.y + paint.box_bounds.height - mark_inset
    paint.check_end.x = paint.box_bounds.x + paint.box_bounds.width - mark_inset
    paint.check_end.y = paint.box_bounds.y + mark_inset

    paint.box = spec.box
    paint.active = spec.active
    paint.fill_color = spec.checked ? spec.active.value.background : spec.box.value.background
    paint.border_color = spec.checked ? spec.active.value.border : spec.box.value.border
    paint.mark_color = spec.active.value.foreground
    paint.state_color = Opacity(spec.checked ? spec.active.value.background : spec.box.value.foreground,
        spec.pressed ? 0.14 : (spec.hovered ? 0.08 : 0.10))
    paint.focus_color = spec.box.value.focus
    paint.label_color = spec.box.value.foreground
    if (spec.label.value.fields & (u32)StyleForeground) != (u32)0 {
        paint.label_color = spec.label.value.foreground
    }

    paint.radius = 0.18
    paint.state_radius = 0.28
    paint.focus_radius = 0.26
    paint.border_width = border_width
    if paint.border_width < 0.0 { paint.border_width = 0.0 }
    paint.mark_width = mark_width

    paint.show_fill = spec.checked
    paint.show_mark = spec.checked
    paint.show_state = spec.enabled && (spec.hovered || spec.pressed || spec.focused)
    paint.show_focus = spec.enabled && spec.focused

    if !spec.enabled {
        paint.show_state = false
        paint.show_focus = false
    }

    return paint
}
