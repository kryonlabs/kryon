#module "router_props"
#import "geometry"

RouterRoute :: struct {
    id: i32
    parent: i32
    path: string
    title: string
    group: string
}

RouterState :: struct {
    initialized: i32
    current_route: i32
    previous_route: i32
    requested_route: i32
    changed: i32
    route_version: i32
    generation: u32
}

RouterProps :: struct {
    bounds: Rectangle
    key: u64
    state: RouterState*
    routes: const RouterRoute*
    route_count: i32
    initial_route: i32
    sync_url: bool
    replace_on_init: bool
}

RouterResult :: struct {
    route: i32
    previous_route: i32
    requested_route: i32
    changed: bool
    route_info: const RouterRoute*
}
