#module "button_props"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "image_props"

ArrowDirection :: enum {
    ArrowLeft = 0
    ArrowRight = 1
    ArrowUp = 2
    ArrowDown = 3
}

# Shared public contract. The host renders the declared values.
ButtonProps :: struct {
    key: u64
    bounds: Rectangle
    label: string
    id: i32
    class_name: i32
    style_kind: i32
    tone: ButtonTone
    emphasis: ButtonEmphasis
    size: ControlSize
    disabled: bool
    loading: bool
    selected: bool
    invisible: bool
    full_width: bool
    pill: bool
    circle: bool
    icon: Texture2D
    icon_type: i32
    icon_placement: IconPlacement
    icon_only: bool
    square: bool
    image: ImageProps
    swatch: bool
    swatch_color: Color
    menu_id: i32
    menu: bool
    split: bool
    arrow: bool
    info: bool
    direction: ArrowDirection
    state: ButtonState
}
