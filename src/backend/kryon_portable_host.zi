#module "kryon_portable_host"
#import "ziran_host.h"
#import "image_canvas_types.h"

# Host adapters implement effects requested by Kryon UI modules. The C
# callback typedefs are ABI declarations; their behavior stays in the host.
FramePacingBinding :: () -> HostBinding #extern #export
KssStringSliceBinding :: () -> HostBinding #extern #export
TextSliceBinding :: () -> HostBinding #extern #export

CursorShapeFn :: void (*)(void *context, int shape) #type
CursorPlatform :: struct CursorPlatform { CursorShapeFn set_shape; void *context; } #type
CursorBinding :: (platform: *CursorPlatform) -> HostBinding #extern #export

CompositionQueue :: struct CompositionQueue #type
CompositionInputEvent :: struct CompositionInputEvent { int available; int phase; const char *text; size_t length; int cursor; int selection_length; } #type
CompositionQueueCreate :: () -> *CompositionQueue #extern #export
CompositionQueueDestroy :: (queue: *CompositionQueue) #extern #export
CompositionQueueBeginFrame :: (queue: *CompositionQueue) #extern #export
CompositionQueueSubmit :: (queue: *CompositionQueue, phase: i32, text: const char*, cursor: i32, selection_length: i32) -> i32 #extern #export
CompositionQueueTake :: (queue: *CompositionQueue, event: *CompositionInputEvent) -> i32 #extern #export
PollCompositionBinding :: (queue: *CompositionQueue) -> HostBinding #extern #export

LineDrawFn :: void (*)(void *context, float x1, float y1, float x2, float y2, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
LineRenderer :: struct LineRenderer { LineDrawFn draw; void *context; } #type
RasterLineBinding :: (renderer: *LineRenderer) -> HostBinding #extern #export

RoundedRectangleFillFn :: void (*)(void *context, float x, float y, float width, float height, float radius, int segments, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
RoundedRectangleOutlineFn :: void (*)(void *context, float x, float y, float width, float height, float radius, int segments, float line_width, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
RoundedRectangleRenderer :: struct RoundedRectangleRenderer { RoundedRectangleFillFn fill; RoundedRectangleOutlineFn outline; void *context; } #type
RasterRoundedRectangleBinding :: (renderer: *RoundedRectangleRenderer) -> HostBinding #extern #export
RasterRoundedRectangleOutlineBinding :: (renderer: *RoundedRectangleRenderer) -> HostBinding #extern #export

TextDrawFn :: void (*)(void *context, const char *text, size_t length, int x, int y, int font, uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
TextDrawClippedFn :: void (*)(void *context, const char *text, size_t length, int x, int y, int font, const float clip[4], uint8_t r, uint8_t g, uint8_t b, uint8_t a) #type
TextRenderer :: struct TextRenderer { TextDrawFn draw; void *context; TextDrawClippedFn draw_clipped; } #type
RasterTextBinding :: (renderer: *TextRenderer) -> HostBinding #extern #export
RasterTextClippedBinding :: (renderer: *TextRenderer) -> HostBinding #extern #export

GlyphWidthFn :: int (*)(void *context, const char *text, size_t text_length, int font, const char *typeface, size_t typeface_length) #type
GlyphLineHeightFn :: int (*)(void *context, int font, const char *typeface, size_t typeface_length) #type
FontMeasurer :: struct FontMeasurer { GlyphWidthFn width; GlyphLineHeightFn line_height; void *context; } #type
MeasureGlyphWidthBinding :: (measurer: *FontMeasurer) -> HostBinding #extern #export
MeasureGlyphLineHeightBinding :: (measurer: *FontMeasurer) -> HostBinding #extern #export

ImageSizeFn :: int (*)(void *context, const char *path, size_t path_length, int *width, int *height) #type
ImageDrawFn :: void (*)(void *context, const char *path, size_t path_length, uint32_t texture_id, const float source[4], const float destination[4], const float clip[4], const float origin[2], float rotation, float radius, const uint8_t tint[4]) #type
ImageRasterizer :: struct ImageRasterizer { ImageSizeFn size; ImageDrawFn draw; void *context; } #type
ImageWidthBinding :: (renderer: *ImageRasterizer) -> HostBinding #extern #export
ImageHeightBinding :: (renderer: *ImageRasterizer) -> HostBinding #extern #export
RasterImageBinding :: (renderer: *ImageRasterizer) -> HostBinding #extern #export
ImageCanvasRasterizer :: (canvas: *ImageCanvas) -> ImageRasterizer #extern #export
