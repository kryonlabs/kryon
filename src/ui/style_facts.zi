StyleFacts :: struct {
    kind: s32
    name: s32
    class_name: s32
    id: s32
    role: s32
    tone: s32
    emphasis: s32
    size: s32
    state: s32
    validation: s32
    orientation: s32
    placement: s32
}

StyleSelector :: struct {
    kind: s32
    name: s32
    class_name: s32
    id: s32
    role: s32
    tone: s32
    emphasis: s32
    size: s32
    state: s32
    validation: s32
    orientation: s32
    placement: s32
    // Tree context (StyleContext bits): an ancestor, or with
    // StyleContextParent the parent, carrying ancestor_class and
    // ancestor_id; being its parent's first child; not carrying not_class
    // and not being in not_state.
    context: u32
    ancestor_class: s32
    ancestor_id: s32
    not_class: s32
    not_state: s32
}

StyleContext :: enum {
    StyleContextAncestor :: 1
    StyleContextParent :: 2
    StyleContextFirstChild :: 4
    StyleContextNot :: 8
}
using StyleContext;

// Ancestor, parent and first-child context of the widget being styled.
// BeginFrame installs it, so a program without a frame carries none, and
// rules without context never call it.
StyleTreeMatch :: #type (selector: StyleSelector) -> bool;
style_tree_match: StyleTreeMatch;

#program_export
StyleDefaultFacts :: (kind: s32) -> StyleFacts {
    facts: StyleFacts
    facts.kind = kind
    facts.role = StyleAny()
    facts.tone = StyleAny()
    facts.emphasis = StyleAny()
    facts.size = StyleAny()
    facts.state = StyleAny()
    facts.validation = StyleAny()
    facts.orientation = StyleAny()
    facts.placement = StyleAny()
    return facts
}

#program_export
StyleControlFacts :: (kind: s32, id: s32, class_name: s32, tone: s32,
    emphasis: s32, size: s32, state: s32) -> StyleFacts {
    facts: StyleFacts = StyleDefaultFacts(kind)
    facts.id = id
    facts.class_name = class_name
    facts.tone = tone
    facts.emphasis = emphasis
    facts.size = size
    facts.state = state
    return facts
}

#program_export
StyleControlRoleFacts :: (kind: s32, id: s32, class_name: s32, role: s32,
    tone: s32, emphasis: s32, size: s32, state: s32) -> StyleFacts {
    facts: StyleFacts = StyleControlFacts(kind, id, class_name, tone,
        emphasis, size, state)
    facts.role = role
    return facts
}

#program_export
StyleTextFacts :: (id: s32, class_name: s32, role: s32,
    state: s32) -> StyleFacts {
    facts: StyleFacts = StyleDefaultFacts(StyleKindText())
    facts.id = id
    facts.class_name = class_name
    facts.role = role
    facts.state = state
    return facts
}

#program_export
StyleDefaultSelector :: () -> StyleSelector {
    selector: StyleSelector
    selector.kind = StyleKindAny()
    selector.role = StyleAny()
    selector.tone = StyleAny()
    selector.emphasis = StyleAny()
    selector.size = StyleAny()
    selector.state = StyleAny()
    selector.validation = StyleAny()
    selector.orientation = StyleAny()
    selector.placement = StyleAny()
    return selector
}
