#import "file"

// Writes src/backend/pixmap_font.zi: the ASCII glyphs of PSF console fonts
// as bitmaps the pixmap host draws with. Reads one uncompressed .psf path per
// line on standard input and prints the module on standard output.
//
//   zcat Lat15-Terminus16.psf.gz > build/fonts/16.psf
//   ls build/fonts/*.psf | python3 build/tools/pixmap_glyphs
//
// Built for Python with zi2py, like the other image tools here.

libc :: #system_library "libc";
ReadRaw :: (fd: s32, output: *u8, count: u64) -> s64 #foreign libc "read";

FirstGlyph :: 32;
LastGlyph :: 126;

heights: [16]s32;
widths: [16]s32;
starts: [16]s32;
font_count: s32;
// One bit per glyph pixel, rows unpadded, glyph after glyph, font after font.
bits: [262144]bool;
bit_count: s32;

// A declaration's text is limited, so the bits go out as base64 strings of
// this many characters, each character six bits.
ChunkCharacters :: 3840;

Line :: (output: []u8) -> string {
    length: s32 = 0
    while length < cast(s32)output.count {
        byte: u8 = 0
        if ReadRaw(0, *byte, 1) != 1 { break }
        if byte == cast(u8)10 { break }
        output[length] = byte
        length += 1
    }
    return TextView(output[0:length])
}

Word :: (data: string, at: s32) -> s32 {
    return cast(s32)data[at] | (cast(s32)data[at + 1] << 8) |
        (cast(s32)data[at + 2] << 16) | (cast(s32)data[at + 3] << 24)
}

// Adds one font's ASCII glyphs; false when the file is not a PSF font.
AddFont :: (data: string) -> bool {
    if font_count >= 16 { return false }
    height: s32 = 0
    width: s32 = 8
    glyph_bytes: s32 = 0
    offset: s32 = 0
    if data.count > 4 && data[0] == cast(u8)54 && data[1] == cast(u8)4 {
        height = cast(s32)data[3]
        glyph_bytes = height
        offset = 4
    } else if data.count > 32 && data[0] == cast(u8)114 && data[1] == cast(u8)181 &&
        data[2] == cast(u8)74 && data[3] == cast(u8)134 {
        offset = Word(data, 8)
        glyph_bytes = Word(data, 20)
        height = Word(data, 24)
        width = Word(data, 28)
    } else {
        return false
    }
    row_bytes: s32 = (width + 7) / 8
    if height <= 0 || height > 64 || width <= 0 || width > 32 ||
        glyph_bytes != height * row_bytes { return false }
    count: s32 = (LastGlyph - FirstGlyph + 1) * height * width
    if bit_count + count > 262144 ||
        offset + (LastGlyph + 1) * glyph_bytes > cast(s32)data.count { return false }
    heights[font_count] = height
    widths[font_count] = width
    starts[font_count] = bit_count
    glyph: s32 = FirstGlyph
    while glyph <= LastGlyph {
        row: s32 = 0
        while row < height {
            column: s32 = 0
            while column < width {
                byte: u8 = data[offset + glyph * glyph_bytes + row * row_bytes + column / 8]
                bits[bit_count] = ((byte >> cast(u8)(7 - column % 8)) & cast(u8)1) != cast(u8)0
                bit_count += 1
                column += 1
            }
            row += 1
        }
        glyph += 1
    }
    font_count += 1
    return true
}

Base64 :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

// Six bits starting at bit `at`, first bit highest; missing bits are 0.
Sextet :: (at: s32) -> s32 {
    value: s32 = 0
    index: s32 = 0
    while index < 6 {
        value = value * 2
        if at + index < bit_count && bits[at + index] { value += 1 }
        index += 1
    }
    return value
}

PrintList :: (name: string, values: []s32, count: s32) {
    print("%: [%]s32 = .{", name, count)
    index: s32 = 0
    while index < count {
        if index > 0 { print(", ") }
        print("%", values[index])
        index += 1
    }
    print("};\n")
}

main :: () -> s32 {
    path_bytes: [4096]u8
    while true {
        path: string = Line(path_bytes[:])
        if path.count == 0 { break }
        data, ok := ReadEntireFile(path)
        if !ok || !AddFont(data) {
            print("pixmap_glyphs: cannot use %\n", path)
            return 1
        }
    }
    if font_count == 0 { return 1 }
    // Smallest first, so the host can pick the largest that fits.
    sorted: bool = false
    while !sorted {
        sorted = true
        index: s32 = 1
        while index < font_count {
            if heights[index] < heights[index - 1] {
                swap: s32 = heights[index]; heights[index] = heights[index - 1]; heights[index - 1] = swap
                swap = widths[index]; widths[index] = widths[index - 1]; widths[index - 1] = swap
                swap = starts[index]; starts[index] = starts[index - 1]; starts[index - 1] = swap
                sorted = false
            }
            index += 1
        }
    }
    print("// Generated by tools/pixmap_glyphs.zi; `make pixmap-font` rebuilds it.\n")
    print("// Glyphs 32-126 from Terminus Font, (c) 2010 Dimitar Toshkov Zhekov,\n")
    print("// licensed under the SIL Open Font License 1.1 (licenses/Terminus-OFL.txt).\n")
    print("// Each glyph is HEIGHT rows of WIDTH bits, one bit per pixel, packed six\n")
    print("// to a base64 character, first bit highest.\n\n")
    print("PixmapFontCount :: %;\n", font_count)
    print("PixmapFontFirst :: %;\n", FirstGlyph)
    print("PixmapFontLast :: %;\n", LastGlyph)
    PrintList("pixmap_font_heights", heights[:], font_count)
    PrintList("pixmap_font_widths", widths[:], font_count)
    PrintList("pixmap_font_starts", starts[:], font_count)
    characters: s32 = (bit_count + 5) / 6
    chunks: s32 = (characters + ChunkCharacters - 1) / ChunkCharacters
    print("PixmapFontChunk :: %;\n", ChunkCharacters)
    chunk: s32 = 0
    one: [1]u8
    while chunk < chunks {
        print("PixmapFontData% :: \"", chunk)
        at: s32 = chunk * ChunkCharacters
        while at < characters && at < (chunk + 1) * ChunkCharacters {
            one[0] = Base64[Sextet(at * 6)]
            print("%", TextView(one[:]))
            at += 1
        }
        print("\";\n")
        chunk += 1
    }
    print("\n// The glyph bit at index, counted from the start of all fonts.\n")
    print("PixmapFontBit :: (index: s32) -> bool {\n")
    print("    at: s32 = index / 6\n")
    print("    chunk: s32 = at / PixmapFontChunk\n")
    print("%", "    offset: s32 = at % PixmapFontChunk\n")
    print("    character: u8 = cast(u8)65\n")
    chunk = 0
    while chunk < chunks {
        if chunk == 0 { print("    if chunk == 0 {") } else { print(" else if chunk == % {", chunk) }
        print(" character = PixmapFontData%[offset] }", chunk)
        chunk += 1
    }
    print("\n")
    print("    value: s32 = 0\n")
    print("    code: s32 = cast(s32)character\n")
    print("    if code >= 65 && code <= 90 { value = code - 65 }\n")
    print("    else if code >= 97 && code <= 122 { value = code - 71 }\n")
    print("    else if code >= 48 && code <= 57 { value = code + 4 }\n")
    print("    else if code == 43 { value = 62 }\n")
    print("    else { value = 63 }\n")
    print("%", "    return ((value >> (5 - index % 6)) & 1) != 0\n")
    print("}\n")
    return 0
}
