#module "menu_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/menu.h"
#import "runtime/popup_policy.h"
#import "ui/paint_command.h"
#import "ui/widget_store.h"
#import "ui/widget_input.h"
#import "ui_popup_input_internal.h"

ui_menu_bar_owns_open_menu :: (id: i32,
menu_count: i32) -> i32 #export {
    state: *ToolkitStore = toolkit_store_current()
    return MenuBarOpenIndexFor(id, state->open_id, menu_count) >= 0
}

ui_draw_menu_panel :: (bounds: Rectangle,
class_name: i32) #export {
    frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuPopupRole())
    DrawWidgetFrame(bounds, (Rectangle){0}, frame, 0, 0, 0, 0)
}

ui_menu_track_panel :: (bounds: Rectangle) #export {
    state: *ToolkitStore = toolkit_store_current()
    if state->panel_valid == 0 {
        state->panel_bounds = bounds
        state->panel_valid = 1
        return
    }
    x1: float = state->panel_bounds.x
    y1: float = state->panel_bounds.y
    if bounds.x < x1 { x1 = bounds.x }
    if bounds.y < y1 { y1 = bounds.y }
    x2: float = state->panel_bounds.x + state->panel_bounds.width
    y2: float = state->panel_bounds.y + state->panel_bounds.height
    if bounds.x + bounds.width > x2 {
        x2 = bounds.x + bounds.width
    }
    if bounds.y + bounds.height > y2 {
        y2 = bounds.y + bounds.height
    }
    state->panel_bounds.x = x1
    state->panel_bounds.y = y1
    state->panel_bounds.width = x2 - x1
    state->panel_bounds.height = y2 - y1
}

menu_item_at :: (items: const MenuItem*, item_count: i32,
start: i32, direction: i32) -> i32 #export {
    if items == nil || item_count <= 0 { return -1 }
    index: i32 = start
    visited: i32 = 0
    while visited < item_count {
        index = MenuWrappedItemIndex(index, direction, item_count)
        if MenuItemSelectable((int)items[index].kind,
        items[index].disabled) {
            return index
        }
        visited += 1
    }
    return -1
}

menu_first_item :: (items: const MenuItem*,
count: i32) -> i32 #export {
    return menu_item_at(items, count, -1, 1)
}

menu_last_item :: (items: const MenuItem*,
count: i32) -> i32 #export {
    return menu_item_at(items, count, 0, -1)
}

menu_navigation_begin_frame :: () #export {
    state: *ToolkitStore = toolkit_store_current()
    if state->navigation.key_frame == g_ui_frame_serial { return }
    state->navigation.key_frame = g_ui_frame_serial
    state->navigation.key_handled = 0
}

menu_navigation_reset :: (focus_id: i32,
items: const MenuItem*, item_count: i32) #export {
    state: *ToolkitStore = toolkit_store_current()
    state->navigation.focus_id = focus_id
    state->navigation.top = 0
    state->navigation.depth = 0
    index: i32 = 0
    while index < MENU_DEPTH_MAX {
        state->navigation.path[index] = -1
        index += 1
    }
    state->navigation.path[0] = menu_first_item(items, item_count)
}

menu_items_panel_bounds :: (x: i32, y: i32,
items: const MenuItem*, item_count: i32,
class_name: i32) -> Rectangle #export {
    frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenuItem(), StyleAny())
    style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(frame).value)
    panel_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuPopupRole())
    bar_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuBarRole())
    font: i32 = ResolveFont(0, StyleFontValue(style.fields,
    style.font_size), GetFontSize())
    metrics: MenuMetrics = MenuMetricsFor(
    (float)Scale(1000) / 1000.0, panel_frame, frame, bar_frame)
    width: i32 = metrics.panel_min_width
    if items == nil || item_count <= 0 {
        return (Rectangle){(float)x, (float)y, 0.0, 0.0}
    }
    index: i32 = 0
    while index < item_count {
        text_w: i32 = items[index].label != nil ?
        TextWidth(items[index].label, font) : 0
        accel: i32 = items[index].accelerator != nil ?
        TextWidth(items[index].accelerator, font) : 0
        width = MenuPanelWidthStep(width, text_w, accel,
        items[index].accelerator != nil, metrics)
        index += 1
    }
    return MenuPanelBounds(x, y, width, item_count, metrics)
}

copy_menu_items :: (arena: *MenuItem, used: *i32,
items: const MenuItem*, item_count: i32,
copied_count: *i32) -> i32 #export {
    *copied_count = 0
    if items == nil || item_count <= 0 ||
    *used >= CONTEXT_MENU_MAX_ITEMS { return -1 }
    count: i32 = item_count
    if count > CONTEXT_MENU_MAX_ITEMS - *used {
        count = CONTEXT_MENU_MAX_ITEMS - *used
    }
    start: i32 = *used
    *used += count
    *copied_count = count
    index: i32 = 0
    while index < count {
        arena[start + index] = items[index]
        index += 1
    }
    index = 0
    while index < count {
        copy: *MenuItem = &arena[start + index]
        if !MenuItemShowsSubmenu((int)copy->kind) ||
        copy->submenu == nil || copy->submenu_count <= 0 {
            copy->submenu = nil
            copy->submenu_count = 0
        } else {
            child_count: i32 = 0
            child_start: i32 = copy_menu_items(arena, used,
            copy->submenu, copy->submenu_count, &child_count)
            copy->submenu = child_start >= 0 ?
            &arena[child_start] : nil
            copy->submenu_count = child_count
        }
        index += 1
    }
    return start
}

queue_context_menu_overlay :: (menu: MenuProps,
suppress_close: i32) #export {
    state: *ToolkitStore = toolkit_store_current()
    if menu.items == nil || menu.item_count <= 0 {
        state->context_overlay.active = 0
        return
    }
    count: i32 = 0
    used: i32 = 0
    copy_menu_items(&state->context_overlay.items[0],
    &used, menu.items, menu.item_count, &count)
    state->context_overlay.active = 1
    state->context_overlay.id = menu.id
    state->context_overlay.class_name = menu.class_name
    state->context_overlay.x = menu.x != nil ? *menu.x : 0
    state->context_overlay.y = menu.y != nil ? *menu.y : 0
    state->context_overlay.item_count = count
    state->context_overlay.suppress_close = suppress_close
}

draw_menu_items :: (x: i32, y: i32,
items: const MenuItem*, item_count: i32,
focus_id: i32, depth: i32,
class_name: i32) -> i32 #export {
    state: *ToolkitStore = toolkit_store_current()
    base_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenuItem(), StyleAny())
    base_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(base_frame).value)
    panel_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuPopupRole())
    bar_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuBarRole())
    font: i32 = ResolveFont(0, StyleFontValue(base_style.fields,
    base_style.font_size), GetFontSize())
    metrics: MenuMetrics = MenuMetricsFor(
    (float)Scale(1000) / 1000.0, panel_frame,
    base_frame, bar_frame)
    width: i32 = metrics.panel_min_width
    activated: i32 = 0
    can_draw: i32 = IsWindowReady()
    if items == nil || item_count <= 0 { return 0 }

    keyboard: i32 = !ContentDisabled() && focus_id > 0 &&
    IsFocusActive(focus_id) && IsKeyboardInputEnabled() &&
    !ui_popup_input_focus_captures(focus_id)
    if keyboard && state->navigation.focus_id != focus_id {
        menu_navigation_reset(focus_id, items, item_count)
    }
    if keyboard && depth < MENU_DEPTH_MAX {
        index: i32 = state->navigation.path[depth]
        if index < 0 || index >= item_count ||
        !MenuItemSelectable((int)items[index].kind,
        items[index].disabled) {
            state->navigation.path[depth] = menu_first_item(
            items, item_count)
        }
        selected: i32 = state->navigation.path[depth]
        if !state->navigation.key_handled &&
        state->navigation.depth == depth && selected >= 0 {
            keyboard_input: MenuKeyboardInput = MenuKeyboardInputFor(
            IsKeyPressed(KEY_UP) != 0,
            IsKeyPressed(KEY_DOWN) != 0,
            IsKeyPressed(KEY_HOME) != 0,
            IsKeyPressed(KEY_END) != 0,
            IsKeyPressed(KEY_LEFT) != 0,
            IsKeyPressed(KEY_RIGHT) != 0,
            (IsKeyPressed(KEY_ENTER) ||
            IsKeyPressed(KEY_KP_ENTER)) != 0,
            IsKeyPressed(KEY_SPACE) != 0, 0)
            decision: MenuKeyboardDecision =
            MenuKeyboardDecisionFor(keyboard_input, depth, selected)
            if decision.move_delta != 0 {
                state->navigation.path[depth] = menu_item_at(
                items, item_count, selected, decision.move_delta)
                state->navigation.key_handled = 1
            } else if decision.first {
                state->navigation.path[depth] =
                menu_first_item(items, item_count)
                state->navigation.key_handled = 1
            } else if decision.last {
                state->navigation.path[depth] =
                menu_last_item(items, item_count)
                state->navigation.key_handled = 1
            } else if decision.close_parent {
                state->navigation.depth = depth - 1
                state->navigation.path[depth] = -1
                state->navigation.key_handled = 1
            } else if decision.open_or_activate {
                selected_item: const MenuItem* =
                &items[state->navigation.path[depth]]
                opens: i32 = MenuItemCanOpenSubmenu(
                (int)selected_item->kind, selected_item->disabled,
                selected_item->submenu != nil,
                selected_item->submenu_count, depth,
                MENU_DEPTH_MAX)
                state->navigation.key_handled = 1
                if opens {
                    state->submenu_id = selected_item->id
                    state->navigation.depth = depth + 1
                    state->navigation.path[depth + 1] =
                    menu_first_item(selected_item->submenu,
                    selected_item->submenu_count)
                } else if MenuItemKeyboardActivates(
                (int)selected_item->kind, selected_item->disabled,
                opens) {
                    state->open_id = 0
                    return selected_item->id
                }
            }
        }
    }

    index: i32 = 0
    while index < item_count {
        text_w: i32 = items[index].label != nil ?
        TextWidth(items[index].label, font) : 0
        accel: i32 = items[index].accelerator != nil ?
        TextWidth(items[index].accelerator, font) : 0
        width = MenuPanelWidthStep(width, text_w, accel,
        items[index].accelerator != nil, metrics)
        index += 1
    }
    panel: Rectangle = MenuPanelBounds(x, y, width,
    item_count, metrics)
    if can_draw { ui_draw_menu_panel(panel, class_name) }
    ui_menu_track_panel(panel)
    PushInputCapture(panel, 1)
    mouse: Vector2 = ui_mouse_world()
    if ui_contains(panel, mouse) { MarkCursor(MOUSE_CURSOR_DEFAULT) }

    index = 0
    while index < item_count {
        row: Rectangle = MenuRowBounds(panel, index, metrics)
        item: const MenuItem* = &items[index]
        row_hot: i32 = !ContentDisabled() &&
        ui_contains(row, mouse) &&
        !MenuItemIsSeparator((int)item->kind)
        hot: i32 = row_hot && !item->disabled
        selected: i32 = keyboard && depth < MENU_DEPTH_MAX &&
        state->navigation.path[depth] == index
        item_state: ButtonState = item->disabled != 0 ?
        ButtonStateDisabled :
        (hot && IsMouseButtonDown(MOUSE_BUTTON_LEFT) ?
        ButtonStatePressed :
        (hot != 0 ? ButtonStateHover :
        (selected != 0 ? ButtonStateSelected : ButtonStateNormal)))
        item_frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, item_state, item->disabled, selected,
        class_name, StyleKindMenuItem(), StyleAny())
        item_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(item_frame).value)
        item_font: i32 = ResolveFont(0, StyleFontValue(
        item_style.fields, item_style.font_size), font)
        item_text: Color = Fade(item_style.foreground,
        item_style.opacity)

        if MenuItemIsSeparator((int)item->kind) {
            if can_draw {
                separator_frame: StyleFrame =
                WidgetFrameForClassRole(
                ButtonToneNeutral, ButtonStateNormal, 0, 0,
                class_name, StyleKindMenuSeparator(), StyleAny())
                separator_style: Style = ui_unpack_style(
                ui_style_apply_effects_frame(separator_frame).value)
                line: MenuLine = MenuSeparatorLineFor(row, metrics)
                Line(line.x1, line.y1, line.x2, line.y2,
                separator_style.border)
            }
        } else {
            if hot {
                if state->navigation.focus_id == focus_id &&
                depth < MENU_DEPTH_MAX {
                    state->navigation.path[depth] = index
                    state->navigation.depth = depth
                    child: i32 = depth + 1
                    while child < MENU_DEPTH_MAX {
                        state->navigation.path[child] = -1
                        child += 1
                    }
                }
                if can_draw {
                    DrawWidgetFrame(row, panel, item_frame,
                    1, IsMouseButtonDown(MOUSE_BUTTON_LEFT),
                    item->disabled, 0)
                }
                MarkClickable()
            }
            if selected && !hot && can_draw {
                DrawWidgetFrame(row, panel, item_frame,
                0, 0, item->disabled, 0)
            }
            if item->disabled && can_draw {
                DrawWidgetFrame(row, panel, item_frame,
                0, 0, 1, 0)
            }
            if item->disabled && row_hot { MarkDisabled() }
            if can_draw && item->checked {
                RenderText("*", MenuCheckedMarkX(row, metrics),
                MenuTextY(row, TextLineHeight(item_font)),
                item_font, item_text)
            }
            if can_draw {
                label: const char* = item->label
                if label == nil { label = "" }
                RenderText(label, MenuLabelX(row, metrics),
                MenuTextY(row, TextLineHeight(item_font)),
                item_font, item_text)
            }
            if can_draw && item->accelerator != nil {
                accel_width: i32 = TextWidth(item->accelerator,
                item_font)
                RenderText(item->accelerator,
                MenuAcceleratorX(row, accel_width, metrics),
                MenuTextY(row, TextLineHeight(item_font)),
                item_font, item_text)
            }
            if can_draw && MenuItemShowsSubmenu((int)item->kind) {
                RenderText(">", MenuSubmenuIndicatorX(row, metrics),
                MenuTextY(row, TextLineHeight(item_font)),
                item_font, item_text)
            }
            if hot && MenuItemShowsSubmenu((int)item->kind) {
                state->submenu_id = item->id
            }
            if MenuItemCanOpenSubmenu((int)item->kind,
            item->disabled, item->submenu != nil,
            item->submenu_count, depth, MENU_DEPTH_MAX) &&
            (keyboard != 0 ? selected &&
            state->navigation.depth > depth :
            state->submenu_id == item->id) {
                origin: Vector2 = MenuSubmenuOrigin(row)
                sub: i32 = draw_menu_items((int)origin.x,
                (int)origin.y, item->submenu, item->submenu_count,
                focus_id, depth + 1, class_name)
                if sub != 0 { activated = sub }
            }
            pointer: MenuItemPointerDecision =
            MenuItemPointerDecisionFor(hot != 0,
            IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
            state->navigation.focus_id == focus_id,
            (int)item->kind, item->disabled, item->id,
            index, depth, MENU_DEPTH_MAX)
            if pointer.consume_release { ConsumeRelease() }
            if pointer.reset_navigation {
                menu_navigation_reset(focus_id, items, item_count)
            }
            if pointer.set_navigation_path {
                state->navigation.path[pointer.navigation_depth] =
                pointer.navigation_index
                state->navigation.depth = pointer.navigation_depth
                if pointer.clear_child_navigation {
                    child: i32 = pointer.navigation_depth + 1
                    while child < MENU_DEPTH_MAX {
                        state->navigation.path[child] = -1
                        child += 1
                    }
                }
            }
            if pointer.set_focus { SetFocus(focus_id) }
            if pointer.set_submenu {
                state->submenu_id = pointer.submenu_id
            }
            if pointer.activate { activated = pointer.activated_id }
            if pointer.close_open { state->open_id = 0 }
        }
        index += 1
    }
    return activated
}

ui_draw_menu_overlays :: () #export {
    state: *ToolkitStore = toolkit_store_current()
    if state->overlay.active && state->open_id != 0 {
        state->panel_valid = 0
        activated: i32 = draw_menu_items(state->overlay.x,
        state->overlay.y, &state->overlay.items[0],
        state->overlay.item_count, state->overlay.bar_id,
        0, state->overlay.class_name)
        if activated != 0 {
            state->pending_bar_id = state->overlay.bar_id
            state->pending_activated = activated
            state->pending_closed_bar_id = state->overlay.bar_id
        }
    }
    state->overlay.active = 0

    if state->context_overlay.active &&
    state->context_open_id == state->context_overlay.id {
        mouse: Vector2 = ui_mouse_world()
        state->panel_valid = 0
        activated: i32 = draw_menu_items(
        state->context_overlay.x, state->context_overlay.y,
        &state->context_overlay.items[0],
        state->context_overlay.item_count,
        state->context_overlay.id, 0,
        state->context_overlay.class_name)
        if activated != 0 {
            state->context_pending_id = state->context_overlay.id
            state->context_pending_activated = activated
            state->context_open_id = 0
        } else {
            close: MenuContextOutsideCloseDecision =
            MenuContextOutsideCloseDecisionFor(
            state->context_open_id, state->context_overlay.id,
            state->context_overlay.suppress_close != 0,
            IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
            state->panel_valid != 0,
            ui_contains(state->panel_bounds, mouse) != 0)
            if close.consume_release { ConsumeRelease() }
            if close.close_open {
                state->context_pending_closed_id =
                state->context_overlay.id
                state->context_open_id = 0
            }
        }
    }
    state->context_overlay.active = 0
}

RenderPopupMenu :: (id: i32, class_name: i32,
x: i32, y: i32, items: const MenuItem*,
item_count: i32) -> i32 #export {
    panel: Rectangle = menu_items_panel_bounds(x, y,
    items, item_count, class_name)
    focused: i32 = !ContentDisabled() && id > 0 &&
    RegisterFocus(id, panel)
    if MenuEscapeShouldClose(focused,
    ui_popup_input_focus_captures(id),
    IsKeyPressed(KEY_ESCAPE)) {
        menu_navigation_reset(0, nil, 0)
        SetFocus(0)
        return 0
    }
    menu_navigation_begin_frame()
    return draw_menu_items(x, y, items, item_count,
    id, 0, class_name)
}

RenderContextMenu :: (menu: MenuProps) -> i32 #export {
    state: *ToolkitStore = toolkit_store_current()
    mouse: Vector2 = ui_mouse_world()
    open_local: i32 = 0
    x_local: i32 = 0
    y_local: i32 = 0
    if menu.open == nil { menu.open = &open_local }
    if menu.x == nil { menu.x = &x_local }
    if menu.y == nil { menu.y = &y_local }
    if state->context_pending_id == menu.id {
        activated: i32 = state->context_pending_activated
        result: MenuContextOpenResult = MenuContextOpenFor(
        *menu.open != 0, 0, 1, menu.open != nil)
        state->context_pending_id = 0
        state->context_pending_activated = 0
        *menu.open = result.open
        return activated
    }
    if state->context_pending_closed_id == menu.id {
        result: MenuContextOpenResult = MenuContextOpenFor(
        *menu.open != 0, 0, 1, menu.open != nil)
        state->context_pending_closed_id = 0
        *menu.open = result.open
        return 0
    }
    activation: PopupContextActivation = PopupContextActivationFor(
    PopupDecisionFor(PopupContext, 0), menu.trigger, mouse,
    ContentDisabled() != 0, InputCapturesClick(mouse) != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_RIGHT) != 0)
    if activation.open {
        result: MenuContextOpenResult = MenuContextOpenFor(
        *menu.open != 0, 1, 0, menu.open != nil)
        *menu.open = result.open
        *menu.x = (int)activation.origin.x
        *menu.y = (int)activation.origin.y
        SetFocus(menu.id)
        menu_navigation_reset(menu.id, menu.items,
        menu.item_count)
    }
    if !*menu.open {
        if state->context_open_id == menu.id {
            state->context_open_id = 0
        }
        return 0
    }
    suppress_close: i32 = MenuContextShouldSuppressClose(
    activation.open, ui_contains(menu.trigger, mouse),
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT))
    state->context_open_id = menu.id
    panel: Rectangle = menu_items_panel_bounds(
    *menu.x, *menu.y, menu.items, menu.item_count,
    menu.class_name)
    focused: i32 = !ContentDisabled() && menu.id > 0 &&
    RegisterFocus(menu.id, panel) &&
    !ui_popup_input_focus_captures(menu.id)
    if MenuEscapeShouldClose(focused,
    ui_popup_input_focus_captures(menu.id),
    IsKeyPressed(KEY_ESCAPE)) {
        result: MenuContextOpenResult = MenuContextOpenFor(
        *menu.open != 0, 0, 1, menu.open != nil)
        *menu.open = result.open
        state->context_open_id = 0
        state->submenu_id = 0
        menu_navigation_reset(0, nil, 0)
        return 0
    }
    menu_navigation_begin_frame()
    ui_menu_track_panel(panel)
    PushInputCapture(panel, 1)
    if ui_contains(panel, mouse) {
        MarkCursor(MOUSE_CURSOR_DEFAULT)
    }
    queue_context_menu_overlay(menu, suppress_close)
    return 0
}

RenderMenu :: (menu: MenuProps) -> MenuResult #export {
    result: MenuResult = (MenuResult){0, -1}
    if menu.mode == MenuModeBar {
        return RenderMenuGroups(menu.id, menu.class_name,
        menu.bounds, menu.menus, menu.menu_count,
        menu.open_index)
    }
    if menu.mode == MenuModePopup {
        result.activated_id = RenderPopupMenu(menu.id,
        menu.class_name, (int)menu.bounds.x,
        (int)menu.bounds.y, menu.items, menu.item_count)
        return result
    }
    result.activated_id = RenderContextMenu(menu)
    return result
}

RenderMenuGroups :: (id: i32, class_name: i32,
bounds: Rectangle, menus: const MenuGroup*,
menu_count: i32, open_index: *i32) -> MenuResult #export {
    state: *ToolkitStore = toolkit_store_current()
    result: MenuResult = (MenuResult){0, -1}
    base_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenuItem(), StyleAny())
    base_style: Style = ui_unpack_style(
    ui_style_apply_effects_frame(base_frame).value)
    bar_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuBarRole())
    panel_frame: StyleFrame = WidgetFrameForClassRole(
    ButtonToneNeutral, ButtonStateNormal, 0, 0, class_name,
    StyleKindMenu(), MenuPopupRole())
    font: i32 = ResolveFont(0, StyleFontValue(base_style.fields,
    base_style.font_size), GetFontSize())
    metrics: MenuMetrics = MenuMetricsFor(
    (float)Scale(1000) / 1000.0,
    panel_frame, base_frame, bar_frame)
    x: i32 = MenuBarFirstItemX(bounds, metrics)
    mouse: Vector2 = ui_mouse_world()
    skip_external_open: i32 = 0
    bar_capture_pushed: i32 = 0
    can_draw: i32 = IsWindowReady()

    if state->pending_bar_id == id {
        result.activated_id = state->pending_activated
        state->pending_bar_id = 0
        state->pending_activated = 0
    }
    if state->pending_closed_bar_id == id {
        state->pending_closed_bar_id = 0
        state->open_id = 0
        state->submenu_id = 0
        skip_external_open = 1
        if open_index != nil { *open_index = -1 }
    }
    menu_count = MenuBarCountFor(menu_count, MENU_MAX)
    focused: i32 = !ContentDisabled() && id > 0 &&
    RegisterFocus(id, bounds) &&
    !ui_popup_input_focus_captures(id)
    if state->navigation.focus_id != id {
        menu_navigation_reset(id, nil, 0)
    }
    state->navigation.top = MenuBarTopIndexFor(
    state->navigation.top, menu_count)
    menu_navigation_begin_frame()
    if !skip_external_open && open_index != nil &&
    *open_index >= 0 {
        state->open_id = MenuBarOpenIdFor(id,
        *open_index, menu_count)
    }
    if focused && menu_count > 0 {
        current: i32 = MenuBarOpenIndexFor(id,
        state->open_id, menu_count)
        keyboard_input: MenuKeyboardInput = MenuKeyboardInputFor(
        0, IsKeyPressed(KEY_DOWN) != 0,
        IsKeyPressed(KEY_HOME) != 0,
        IsKeyPressed(KEY_END) != 0,
        IsKeyPressed(KEY_LEFT) != 0,
        IsKeyPressed(KEY_RIGHT) != 0,
        (IsKeyPressed(KEY_ENTER) ||
        IsKeyPressed(KEY_KP_ENTER)) != 0,
        IsKeyPressed(KEY_SPACE) != 0,
        IsKeyPressed(KEY_ESCAPE) != 0)
        decision: MenuBarKeyboardDecision =
        MenuBarKeyboardDecisionFor(keyboard_input,
        current >= 0, state->navigation.depth)
        if current < 0 {
            if decision.move_top_delta != 0 {
                state->navigation.top = MenuBarMoveTopIndex(
                state->navigation.top, menu_count,
                decision.move_top_delta)
            } else if decision.first_top {
                state->navigation.top = 0
            } else if decision.last_top {
                state->navigation.top = menu_count - 1
            } else if decision.open_top {
                current = state->navigation.top
                state->open_id = MenuBarOpenIdFor(id,
                current, menu_count)
                menu_navigation_reset(id, menus[current].items,
                menus[current].item_count)
                state->navigation.top = current
                state->navigation.key_handled = 1
            }
        } else if decision.close_open {
            state->open_id = 0
            state->submenu_id = 0
            state->navigation.depth = 0
            state->navigation.path[0] = -1
        } else if decision.move_open_delta != 0 {
            current = MenuBarMoveTopIndex(current, menu_count,
            decision.move_open_delta)
            state->open_id = MenuBarOpenIdFor(id,
            current, menu_count)
            menu_navigation_reset(id, menus[current].items,
            menus[current].item_count)
            state->navigation.top = current
            state->navigation.key_handled = 1
        } else if decision.move_open_if_no_submenu_delta != 0 {
            selected: i32 = state->navigation.path[0]
            opens: i32 = selected >= 0 &&
            selected < menus[current].item_count &&
            MenuItemCanOpenSubmenu(
            (int)menus[current].items[selected].kind,
            menus[current].items[selected].disabled,
            menus[current].items[selected].submenu != nil,
            menus[current].items[selected].submenu_count,
            state->navigation.depth, MENU_DEPTH_MAX)
            if !opens {
                current = MenuBarMoveTopIndex(current,
                menu_count,
                decision.move_open_if_no_submenu_delta)
                state->open_id = MenuBarOpenIdFor(id,
                current, menu_count)
                menu_navigation_reset(id, menus[current].items,
                menus[current].item_count)
                state->navigation.top = current
                state->navigation.key_handled = 1
            }
        }
    }
    if ui_menu_bar_owns_open_menu(id, menu_count) {
        PushInputCapture(bounds, 1)
        bar_capture_pushed = 1
    }
    state->overlay.active = 0
    if can_draw {
        DrawWidgetFrame(bounds, (Rectangle){0},
        bar_frame, 0, 0, 0, 0)
    }

    index: i32 = 0
    while index < menu_count {
        label: const char* = menus[index].label
        if label == nil { label = "" }
        width: i32 = MenuGroupItemWidth(
        TextWidth(label, font), metrics)
        item: Rectangle = MenuGroupItemBounds(x,
        bounds, width, metrics)
        menu_id: i32 = MenuBarOpenIdFor(id,
        index, menu_count)
        open: i32 = state->open_id == menu_id
        hot: i32 = !ContentDisabled() && ui_hot(item)
        item_state: ButtonState = open != 0 ?
        ButtonStateSelected : (hot != 0 ?
        ButtonStateHover : ButtonStateNormal)
        item_frame: StyleFrame = WidgetFrameForClassRole(
        ButtonToneNeutral, item_state, 0, open,
        class_name, StyleKindMenuItem(), StyleAny())
        item_style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(item_frame).value)
        item_font: i32 = ResolveFont(0, StyleFontValue(
        item_style.fields, item_style.font_size), font)
        item_text: Color = Fade(item_style.foreground,
        item_style.opacity)
        if can_draw && (hot || open) {
            DrawWidgetFrame(item, bounds, item_frame,
            hot, 0, 0,
            focused && state->navigation.top == index)
        }
        if hot { MarkClickable() }
        if can_draw {
            RenderText(label, MenuBarLabelX(item, metrics),
            MenuBarLabelY(item, TextLineHeight(item_font)),
            item_font, item_text)
        }
        pointer: MenuGroupPointerDecision =
        MenuGroupPointerDecisionFor(menu_id, index,
        state->open_id, hot,
        IsMouseButtonReleased(MOUSE_BUTTON_LEFT))
        if pointer.consume_release { ConsumeRelease() }
        if pointer.set_focus { SetFocus(id) }
        if pointer.changed_open {
            state->open_id = pointer.next_open_id
        }
        if pointer.clear_submenu { state->submenu_id = 0 }
        if pointer.reset_navigation {
            state->navigation.top = pointer.navigation_top
            menu_navigation_reset(id, menus[index].items,
            menus[index].item_count)
            state->navigation.top = pointer.navigation_top
        }
        open = state->open_id == menu_id
        if open {
            origin: Vector2 = PopupMenuBarOrigin(item, bounds)
            result.open_index = index
            state->overlay.active = 1
            state->overlay.bar_id = id
            state->overlay.menu_id = id + index
            state->overlay.class_name = class_name
            state->overlay.x = (int)origin.x
            state->overlay.y = (int)origin.y
            used: i32 = 0
            copy_menu_items(&state->overlay.items[0], &used,
            menus[index].items, menus[index].item_count,
            &state->overlay.item_count)
        }
        x = MenuBarNextItemX(x, width, metrics)
        index += 1
    }
    close: MenuOutsideCloseDecision = MenuOutsideCloseDecisionFor(
    state->open_id, IsMouseButtonReleased(MOUSE_BUTTON_LEFT),
    ui_contains(bounds, mouse), state->panel_valid,
    ui_contains(state->panel_bounds, mouse))
    if close.close_open {
        if close.consume_release { ConsumeRelease() }
        state->open_id = 0
        if close.clear_submenu { state->submenu_id = 0 }
        result.open_index = close.open_index
    }
    if state->open_id != 0 && !bar_capture_pushed &&
    ui_menu_bar_owns_open_menu(id, menu_count) {
        PushInputCapture(bounds, 1)
    }
    if open_index != nil { *open_index = result.open_index }
    if can_draw && focused { RenderFocus(bounds) }
    return result
}
