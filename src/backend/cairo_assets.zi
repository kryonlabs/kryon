// A program's own assets for the desktop raster, such as files embedded in
// its executable. A picture whose bytes the program's reader returns is
// decoded from memory, ahead of a file of the same name on disk, by the same
// decoders as files: PNG, JPEG, WebP, AVIF and the rest. Each asset read
// becomes a file of its own that the decoders open by path: an in-memory
// file on Linux, a temporary file on Windows. It stays, and its path keeps
// naming it, until RasterAssetsClose. cairo_typefaces keeps its font files
// the same way.
Raster :: #import "cairo_raster";
#if OS == .WINDOWS {
    Files :: #import "asset_files_windows";
} else {
    Files :: #import "asset_files_linux";
}
#import "byte_text_linux"
using Vectors :: #import "vec";

// The asset's bytes, or "" when the program has no such asset. The bytes are
// borrowed only until the reader's caller returns.
RasterAssetRead :: #type (path: string) -> string;

#scope_file
Entry :: struct { path: Vec(u8); file: s32; }

reader: RasterAssetRead;
reading: bool;
// Every path asked for, with its file or -1 when the program has no such
// asset, so the reader is asked once per name.
entries: Vec(Entry);

Lookup :: (path: string, output: []u8) -> string {
    if !reading || path.count == 0 || path.count > 4096 { return "" }
    for index: 0..entries.count - 1 {
        entry := *entries[index]
        if TextFromBytes(entry.path[:]) == path {
            if entry.file < 0 { return "" }
            return RasterAssetPath(entry.file, output)
        }
    }
    file := RasterAssetFile(reader(path))
    entry: Entry
    for byte: path { VecPush(entry.path, byte) }
    entry.file = file
    VecPush(entries, entry)
    if file < 0 { return "" }
    return RasterAssetPath(file, output)
}

#scope_export
// Installs the program's reader; pictures read before it come from disk.
RasterUseAssets :: (read: RasterAssetRead) {
    reader = read
    reading = true
    lookup: Raster.RasterAssetPath = Lookup
    Raster.raster_asset_path = lookup
}

// Closes every asset's file and forgets the reader. Pictures already
// decoded stay in the raster's cache under their names.
RasterAssetsClose :: () {
    for index: 0..entries.count - 1 {
        Files.AssetFileClose(entries[index].file)
        VecFree(entries[index].path)
    }
    VecFree(entries)
    entries = .{}
    reading = false
}

// A file holding BYTES that stays until RasterAssetsClose, or the program
// ends when it is not a reader's asset; -1 for no bytes or no room.
RasterAssetFile :: (bytes: string) -> s32 { return Files.AssetFileOpen(bytes) }

// The path decoders open FILE by, in OUTPUT; "" if it does not fit.
RasterAssetPath :: (file: s32, output: []u8) -> string { return Files.AssetFilePath(file, output) }
