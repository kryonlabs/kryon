// Explicit system styling remains opt-in; automatic frame defaults read only
// the small palette capability and never import stylesheet installation.
using Host :: #import "system_palette_host"
System :: #import "system_theme";

// Applies the host's palette as style rules and theme colours the first time
// and again whenever it changes; true when it applied. Call it once per frame.
SystemPaletteFollow :: () -> bool { return System.SystemPaletteUpdate(SystemPaletteRead()) }
