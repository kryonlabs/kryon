#module "frame_host"
#import "ui_internal.h"
#import "ui_paint_layers_internal.h"
#import "ui_popup_input_internal.h"
#import "../platform/accessibility_internal.h"
#import "ui/disabled.h"
#import "ui/focus.h"
#import "ui/input_capture.h"
#import "ui/clip.h"
#import "ui/ui_scaling.h"
#import "ui/ui_layout.h"
#import "ui/cursor.h"
#import "ui/text_editor.h"
#import "ui/text_context.h"
#import "runtime/text_input.h"
#import "string.h"
#import "limits.h"

ui_view_width :: i32 = 320 #global #export
ui_view_height :: i32 = 560 #global #export
c_text :: Color #global #export
c_bg :: Color #global #export
c_surface :: Color #global #export
c_circle :: Color #global #export
c_button :: Color #global #export
g_ui_camera :: Camera2D #global #export
g_ui_frame_serial :: unsigned long #global #export
g_ui_mouse_world_override_enabled :: i32 #global #export
g_ui_mouse_world_override :: Vector2 #global #export

default_font_auto_load :: i32 = 1 #global
overlays_drawn_frame :: unsigned long #global
platform_text_input_active :: i32 #global
text_input_platform_callback :: TextInputPlatformCallback #global
transition_cues_enabled :: i32 = -1 #global

ui_update_primary_pointer_input :: () #extern
ui_pointer_world_at :: (screen: Vector2) -> Vector2 #extern
ui_motion_backend_available :: () -> i32 #extern

SetTransitionCuesEnabled :: (enabled: i32) #export {
    transition_cues_enabled = enabled ? 1 : 0
}

TransitionCuesEnabled :: () -> i32 #export {
    if !ui_motion_backend_available() {
        return 0
    }
    if transition_cues_enabled < 0 {
        return DefaultMotionEnabled()
    }
    return transition_cues_enabled
}

SetDefaultFontAutoLoad :: (enabled: i32) #export {
    default_font_auto_load = enabled != 0
}

InitInterface :: (width: i32, height: i32,
dpi: float) #export {
    ui_view_width = width
    ui_view_height = height
    SetScale(dpi)
    EnsureBuiltInStylePacks()
    ApplyCurrentTheme()
    if default_font_auto_load {
        EnsureDefaultFont()
    }
}

ApplyCurrentTheme :: () #export {
    c_text = GetThemeText()
    c_bg = GetThemeBackground()
    c_surface = GetThemeSurface()
    c_circle = GetThemeCircle()
    c_button = GetThemeButton()
}

BeginInterfaceFrame :: (width: i32, height: i32,
dpi: float) #export {
    ui_reset_disabled_scope()
    SetViewSize(width, height)
    InitInterface(width, height, dpi)
    SetFrameCamera(GetDefaultCamera())
}

SetFrameCamera :: (camera: Camera2D) #export {
    ui_accessibility_platform_pump()
    PumpWindows()
    EndFocusScope()
    BeginFocusScope()
    g_ui_frame_serial += 1
    g_ui_auto_focus_id = 0x40000000
    ui_text_begin_frame()
    g_ui_text_input_requested = 0
    g_ui_focus_text_input_active = 0
    ui_reset_cursor_intent_for_frame()
    g_ui_camera = ui_sane_camera(camera)
    ui_update_primary_pointer_input()
    ui_update_pointer_gesture()
    ui_begin_input_capture_frame(g_ui_text_context_open)
    ResetClip()
    BeginInspectFrame(nil)
    ui_frame_layers_begin()
}

RenderFrameOverlays :: () #export {
    if overlays_drawn_frame == g_ui_frame_serial {
        return
    }
    overlays_drawn_frame = g_ui_frame_serial
    ResetClip()
    ui_dropdown_overlays()
    ui_draw_menu_overlays()
    ui_tab_bar_finish_frame()
    ui_text_draw_context_overlay()
}

SyncPlatformTextInput :: () {
    active: i32 = TextPlatformInputActiveFor(
    g_ui_text_input_requested != 0,
    g_ui_text_focus_owner != nil,
    g_ui_text_focus_owner_this_frame == g_ui_text_focus_owner)
    decision: TextPlatformInputSyncDecision =
    TextPlatformInputSyncDecisionFor(
    g_ui_text_input_show_requested != 0,
    text_input_platform_callback != nil,
    platform_text_input_active != 0,
    active != 0)
    platform_text_input_active = decision.active ? 1 : 0
    if decision.call_callback && text_input_platform_callback != nil {
        text_input_platform_callback(decision.callback_active ? 1 : 0)
    }
    if decision.clear_show_request {
        g_ui_text_input_show_requested = 0
    }
}

EndInterfaceFrame :: () #export {
    RenderFrameOverlays()
    EndFocusScope()
    if ui_popup_input_keyboard_captures() ||
    ui_popup_input_keyboard_was_captured() {
        while GetCharPressed() != 0 {
            continue
        }
        g_ui_text_input_codepoint_count = 0
        g_ui_text_input_backspace_count = 0
        g_ui_text_input_enter_count = 0
        ClearTextComposition()
    }
    ui_frame_layers_end()
    SyncPlatformTextInput()
    EndInspectFrame()
}

SetTextInputPlatformCallback :: (
callback: TextInputPlatformCallback) #export {
    text_input_platform_callback = callback
}

SaveFrameState :: () -> FrameState #export {
    state: FrameState = (FrameState){0}
    state.view_width = ui_view_width
    state.view_height = ui_view_height
    state.camera = g_ui_camera
    state.input_clip_count = g_ui_input_clip_stack_count
    memcpy(state.input_clips, g_ui_input_clip_stack,
    sizeof(state.input_clips))
    state.input_capture_count = g_ui_input_capture_stack_count
    i: i32 = 0
    while i < 16 {
        state.input_captures[i].bounds =
        g_ui_input_capture_stack[i].bounds
        state.input_captures[i].allow_inside =
        g_ui_input_capture_stack[i].allow_inside
        i += 1
    }
    state.cursor_priority = g_ui_cursor_priority
    state.cursor_had_intent = g_ui_cursor_had_intent
    state.pointer_down = g_ui_pointer_down
    state.pointer_dragging = g_ui_pointer_dragging
    state.pointer_dragged_this_click = g_ui_pointer_dragged_this_click
    state.pointer_start_x = g_ui_pointer_start_x
    state.pointer_start_y = g_ui_pointer_start_y
    state.pointer_owner = g_ui_pointer_owner
    state.release_consumed = g_ui_release_consumed
    state.focus_active_id = g_ui_focus_active_id
    memcpy(state.focus_ids, g_ui_focus_ids,
    sizeof(state.focus_ids))
    state.focus_count = g_ui_focus_count
    state.focus_tab_dir = g_ui_focus_tab_dir
    state.focus_frame_open = g_ui_focus_frame_open
    state.focus_text_input_active = g_ui_focus_text_input_active
    state.text_input_requested = g_ui_text_input_requested
    state.text_input_show_requested = g_ui_text_input_show_requested
    state.mouse_world_override_enabled =
    g_ui_mouse_world_override_enabled
    state.mouse_world_override = g_ui_mouse_world_override
    state.frame_serial = g_ui_frame_serial
    state.auto_focus_id = g_ui_auto_focus_id
    state.ui_scale = GetScale()
    return state
}

RestoreFrameState :: (state: FrameState) #export {
    ui_view_width = state.view_width
    ui_view_height = state.view_height
    g_ui_camera = state.camera
    g_ui_input_clip_stack_count = state.input_clip_count
    memcpy(g_ui_input_clip_stack, state.input_clips,
    sizeof(g_ui_input_clip_stack))
    g_ui_input_capture_stack_count = state.input_capture_count
    i: i32 = 0
    while i < 16 {
        g_ui_input_capture_stack[i].bounds =
        state.input_captures[i].bounds
        g_ui_input_capture_stack[i].allow_inside =
        state.input_captures[i].allow_inside
        i += 1
    }
    g_ui_cursor_priority = state.cursor_priority
    g_ui_cursor_had_intent = state.cursor_had_intent
    g_ui_pointer_down = state.pointer_down
    g_ui_pointer_dragging = state.pointer_dragging
    g_ui_pointer_dragged_this_click = state.pointer_dragged_this_click
    g_ui_pointer_start_x = state.pointer_start_x
    g_ui_pointer_start_y = state.pointer_start_y
    g_ui_pointer_owner = state.pointer_owner
    g_ui_release_consumed = state.release_consumed
    g_ui_focus_active_id = state.focus_active_id
    memcpy(g_ui_focus_ids, state.focus_ids,
    sizeof(g_ui_focus_ids))
    g_ui_focus_count = state.focus_count
    g_ui_focus_tab_dir = state.focus_tab_dir
    g_ui_focus_frame_open = state.focus_frame_open
    g_ui_focus_text_input_active = state.focus_text_input_active
    g_ui_text_input_requested = state.text_input_requested
    g_ui_text_input_show_requested = state.text_input_show_requested
    g_ui_mouse_world_override_enabled =
    state.mouse_world_override_enabled
    g_ui_mouse_world_override = state.mouse_world_override
    if g_ui_pointer_start_x != INT_MIN ||
    g_ui_pointer_start_y != INT_MIN {
        g_ui_pointer_start_world = ui_pointer_world_at(
        (Vector2){(float)g_ui_pointer_start_x,
            (float)g_ui_pointer_start_y})
    }
    g_ui_frame_serial = state.frame_serial
    g_ui_auto_focus_id = state.auto_focus_id
    SetScale(state.ui_scale)
    ResetClip()
}
