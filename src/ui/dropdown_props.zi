#module "dropdown_props"
#import "geometry"

DropdownOption :: struct {
    label: const char*
    icon_type: i32
    disabled: bool
    separator_before: bool
}

DropdownProps :: struct {
    bounds: Rectangle
    id: i32
    class_name: i32
    options: const char**
    option_count: i32
    selected_index: i32*
    disabled: bool
    items: const DropdownOption*
}
