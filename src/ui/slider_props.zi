#module "slider_props"
#import "geometry"
#import "input_props"

SliderProps :: struct {
    bounds: Rectangle
    id: i32
    label: const char*
    kind: NumericValueKind
    float_values: float*
    int_values: i32*
    value_count: i32
    float_value: float*
    min: double
    max: double
    format: const char*
    disabled: bool
    vertical: bool
    angle: bool
    class_name: i32
    value_scale: double
    value_format: const char*
    step_buttons: bool
    show_limits: bool
    measured_height: float*
}
