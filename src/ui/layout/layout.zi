using PropsModule :: #import "layout_props";
using BehaviorModule :: #import "layout_behavior";
Theme :: #import "theme";
#import "geometry"
#import "session"

LayoutContainer :: struct {
    node: s32
    opened: bool
    kind: s32
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
    padding_y: s32
}

// Resolve a theme spacing role into the same logical units as Props.gap.
#program_export
Gap :: (token: Theme.ThemeMetricRole) -> s32 {
    return LayoutPixelMetric(Theme.CurrentThemeMetric(token))
}

LayoutPixelMetric :: (value: float32) -> s32 {
    if !(value > 0.0) { return 0 }
    if value >= 2147483520.0 { return 2147483647 }
    return cast(s32)(value + 0.5)
}
#if #defined(KRYON_HOSTED_UI) {
layout_host :: #system_library "host_api";
GroupHostedHost :: (session: Session, props: PropsModule.Props) -> LayoutContainer #foreign layout_host;

#program_export
Group :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    return GroupHostedHost(session, props)
}
}

#if !#defined(KRYON_HOSTED_UI) {
#import "control_props"
#import "grid"
#import "grid_props"
#import "math"
#import "style"
#import "style_sheet"
#import "tree"
#import "widget_kind"

using WidgetKind;
using StyleField;

// The space a column child may fill, or -1 outside a column.
#program_export
ColumnWidth :: (session: Session) -> float32 {
    parent_index := TreeCurrentParent(session)
    if TreeSubmittedNodeAt(session, parent_index).kind != WidgetKindColumn { return -1.0 }
    parent := TreeLayoutAt(session, parent_index)
    return LayoutMetricsFor(parent.bounds, parent.gap, parent.padding, parent.padding_y).content.width
}

GridResult :: struct {
    container: LayoutContainer
    cursor: GridCursor
}

TreePlaceLinear :: (session: Session, parent_index: s32, bounds: Rectangle,
    horizontal: bool) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    metrics: LayoutMetrics = LayoutMetricsFor(parent.bounds,
        parent.gap, parent.padding, parent.padding_y)
    progress: LayoutProgress = TreeLayoutProgressAt(session, parent_index)
    cursor: float32 = LayoutCursorForChild(metrics, horizontal,
        progress.count, progress.extent)
    placed: Rectangle = LayoutChildBounds(bounds, bounds, metrics,
        horizontal, cursor)
    progress.count += 1
    if horizontal {
        progress.extent += placed.width
    } else {
        progress.extent += placed.height
    }
    TreeSetLayoutProgress(session, parent_index, progress)
    return placed
}

#program_export
TreePlaceColumn :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    return TreePlaceLinear(session, parent_index, bounds, false)
}

#program_export
TreePlaceRow :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    return TreePlaceLinear(session, parent_index, bounds, true)
}

#program_export
TreePlaceStack :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    metrics: LayoutMetrics = LayoutMetricsFor(parent.bounds,
        parent.gap, parent.padding, parent.padding_y)
    return StackChildBounds(bounds, bounds, metrics)
}

#program_export
TreePlaceGrid :: (session: Session, parent_index: s32, bounds: Rectangle) -> Rectangle {
    parent: LayoutInfo = TreeLayoutAt(session, parent_index)
    grid: GridCursor = BeginGridCursor(GridProps.{.bounds = parent.bounds, .gap = parent.gap,
        .padding = parent.padding, .padding_y = parent.padding_y, .padding_y_override = true,
        .row_gap = parent.row_gap, .row_gap_override = true, .columns = parent.columns,
        .min_item_width = parent.min_item_width, .max_columns = parent.max_columns})
    progress: LayoutProgress = TreeLayoutProgressAt(session, parent_index)
    if progress.grid_initialized {
        grid.y = progress.grid_y
        grid.col = progress.grid_col
        grid.row_height = progress.grid_row_height
        grid.used_height = progress.grid_used_height
    }
    grid = GridStep(grid, cast(s32)bounds.height, 1)
    progress.grid_initialized = true
    progress.grid_y = grid.y
    progress.grid_col = grid.col
    progress.grid_row_height = grid.row_height
    progress.grid_used_height = grid.used_height
    TreeSetLayoutProgress(session, parent_index, progress)
    return grid.item
}

LayoutFace :: (props: PropsModule.Props, kind: s32) -> StyleData {
    style_kind: s32 = 0
    if kind == WidgetKindRow { style_kind = StyleKindRow() }
    if kind == WidgetKindColumn { style_kind = StyleKindColumn() }
    if kind == WidgetKindGrid { style_kind = StyleKindGrid() }
    defaults: StyleData
    if style_kind == 0 { return defaults }
    facts := StyleDefaultFacts(style_kind)
    facts.id = props.id
    facts.class_name = props.class_name
    return ResolveInstalledStyleRules(defaults, facts, StyleStateAny())
}

LayoutSpacingFor :: (axis: s32, axis_override: bool, uniform: s32,
    uniform_override: bool, styled: float32) -> s32 {
    value := LayoutPixelMetric(styled)
    if uniform != 0 || uniform_override { value = uniform }
    if axis != 0 || axis_override { value = axis }
    if value < 0 { return 0 }
    return value
}

LayoutExtentFor :: (declared: float32, inherited: float32, styled: float32,
    has_style: bool) -> float32 {
    if !(declared <= 0.0) { return declared }
    if has_style && styled > 0.0 && Finite32(styled) { return styled }
    return inherited
}

LayoutParentBounds :: (session: Session, kind: s32) -> Rectangle {
    parent_index := TreeCurrentParent(session)
    parent_kind := TreeSubmittedNodeAt(session, parent_index).kind
    parent := TreeCurrentParentBounds(session)
    if parent_kind == WidgetKindRow || parent_kind == WidgetKindColumn || parent_kind == WidgetKindStack ||
        (kind == WidgetKindGrid && (parent_kind == WidgetKindPage || parent_kind == WidgetKindSection)) {
        outer := TreeLayoutAt(session, parent_index)
        parent = LayoutMetricsFor(outer.bounds, outer.gap, outer.padding, outer.padding_y).content
    }
    return parent
}

#program_export
ContainerFor :: (session: Session, props: PropsModule.Props,
    kind: s32) -> LayoutContainer {
    result: LayoutContainer = .{.node = -1, .kind = kind, .bounds = props.bounds}
    parent := LayoutParentBounds(session, kind)
    face := LayoutFace(props, kind)
    result.bounds.width = LayoutExtentFor(props.bounds.width, parent.width,
        face.width, StyleHasField(face, cast(u32)StyleWidth))
    result.bounds.height = LayoutExtentFor(props.bounds.height, parent.height,
        face.height, StyleHasField(face, cast(u32)StyleHeight))
    gap := props.gap
    if kind == WidgetKindRow {
        gap = LayoutSpacingFor(props.column_gap, props.column_gap_override,
            props.gap, props.gap_override, face.column_gap)
    } else if kind == WidgetKindColumn {
        gap = LayoutSpacingFor(props.row_gap, props.row_gap_override,
            props.gap, props.gap_override, face.row_gap)
    }
    padding := LayoutSpacingFor(props.padding_x, props.padding_x_override,
        props.padding, props.padding_override, face.padding_x)
    padding_y := LayoutSpacingFor(props.padding_y, props.padding_y_override,
        props.padding, props.padding_override, face.padding_y)
    metrics := LayoutMetricsFor(result.bounds, gap, padding, padding_y)
    result.content = metrics.content
    result.gap = metrics.gap
    result.padding = metrics.padding
    result.padding_y = metrics.padding_y
    return OpenContainer(session, props, result)
}

OpenContainer :: (session: Session, props: PropsModule.Props,
    result: LayoutContainer) -> LayoutContainer {
    if !TreeIsBuilding(session) { return result }
    key: u64 = props.key
    if key == cast(u64)0 { key = TreeNextKey(session) }
    result.node = TreeSubmitCurrent(session, key, result.kind, result.bounds)
    if result.node < 0 { return result }
    result.bounds = TreeSubmittedBounds(session, result.node)
    result.content = LayoutMetricsFor(result.bounds, result.gap, result.padding, result.padding_y).content
    TreeSetLayout(session, result.node, result.gap, result.padding, 0, 0, 0, result.padding_y)
    if props.id != 0 { TreeSetStyleId(session, result.node, props.id) }
    if props.class_name != 0 { TreeSetStyleClass(session, result.node, props.class_name) }
    result.opened = TreePushScope(session, result.node)
    return result
}

Draw :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, WidgetKindColumn)
    TreeSetPlacement(session, result.node, TreePlaceColumn)
    return result
}

#program_export
Row :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, WidgetKindRow)
    TreeSetPlacement(session, result.node, TreePlaceRow)
    return result
}

#program_export
Stack :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    result: LayoutContainer = ContainerFor(session, props, WidgetKindStack)
    TreeSetPlacement(session, result.node, TreePlaceStack)
    return result
}

#program_export
Group :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    return ContainerFor(session, props, WidgetKindGroup)
}

#program_export
Screen :: (session: Session, props: PropsModule.Props) -> LayoutContainer {
    root: Rectangle = TreeRootBounds(session)
    if props.bounds.width <= 0.0 { props.bounds.width = root.width }
    if props.bounds.height <= 0.0 { props.bounds.height = root.height }
    return ContainerFor(session, props, WidgetKindGroup)
}

EmptyGridItems :: () -> []GridItem {
    items: []GridItem
    return items
}

#program_export
Grid :: (session: Session, props: GridProps, items: []GridItem = EmptyGridItems()) -> GridResult {
    scope: PropsModule.Props = .{.key = props.key, .id = props.id, .class_name = props.class_name}
    face := LayoutFace(scope, WidgetKindGrid)
    parent := LayoutParentBounds(session, WidgetKindGrid)
    props.bounds.width = LayoutExtentFor(props.bounds.width, parent.width,
        face.width, StyleHasField(face, cast(u32)StyleWidth))
    props.row_gap = LayoutSpacingFor(props.row_gap, props.row_gap_override,
        props.gap, props.gap_override, face.row_gap)
    props.row_gap_override = true
    props.gap = LayoutSpacingFor(0, false, props.gap, props.gap_override, face.column_gap)
    props.padding_y = LayoutSpacingFor(props.padding_y, props.padding_y_override,
        props.padding, props.padding_override, face.padding_y)
    props.padding_y_override = true
    props.padding = LayoutSpacingFor(0, false, props.padding, props.padding_override, face.padding_x)
    if props.columns <= 0 && props.min_item_width <= 0 {
        if face.grid_tracks >= 0 { props.columns = face.grid_tracks }
        else {
            props.min_item_width = -face.grid_tracks
            // Collapse empty auto-fit tracks when declared items fit in one row.
            occupied: s64 = 0
            for item: items {
                if item.column_span < 0 { occupied = 0; break }
                occupied += ifx item.column_span > 0 then item.column_span else 1
            }
            if occupied > 0 && occupied <= 2147483647 &&
                (props.max_columns <= 0 || occupied < cast(s64)props.max_columns) {
                props.max_columns = cast(s32)occupied
            }
        }
    }
    content_height := parent.height
    if items.count > 0 {
        content_height = cast(float32)(GridItemsHeight(BeginGridCursor(props), items) + 2 * props.padding_y)
    }
    props.bounds.height = LayoutExtentFor(props.bounds.height, content_height,
        face.height, StyleHasField(face, cast(u32)StyleHeight))

    metrics := MeasureGrid(props)
    container: LayoutContainer = .{.node = -1, .kind = WidgetKindGrid, .bounds = props.bounds,
        .content = metrics.content, .gap = props.gap, .padding = props.padding,
        .padding_y = props.padding_y}
    container = OpenContainer(session, scope, container)
    TreeSetLayout(session, container.node, props.gap, props.padding, metrics.columns,
        0, 0, props.padding_y, props.row_gap)
    if items.count == 0 { TreeSetPlacement(session, container.node, TreePlaceGrid) }
    props.bounds = container.bounds
    return .{.container = container, .cursor = BeginGridCursor(props)}
}

ContainerMetrics :: (container: LayoutContainer) -> LayoutMetrics {
    return .{.content = container.content, .gap = container.gap,
        .padding = container.padding, .padding_y = container.padding_y}
}

#program_export
ColumnChildBounds :: (container: LayoutContainer,
    declared: Rectangle, measured: Rectangle, child_index: s32,
    previous_height_sum: float32) -> Rectangle {
    metrics: LayoutMetrics = ContainerMetrics(container)
    cursor: float32 = LayoutCursorForChild(metrics, false,
        child_index, previous_height_sum)
    return LayoutChildBounds(declared, measured, metrics,
        false, cursor)
}

#program_export
RowChildBounds :: (container: LayoutContainer,
    declared: Rectangle, measured: Rectangle, child_index: s32,
    previous_width_sum: float32) -> Rectangle {
    metrics: LayoutMetrics = ContainerMetrics(container)
    cursor: float32 = LayoutCursorForChild(metrics, true,
        child_index, previous_width_sum)
    return LayoutChildBounds(declared, measured, metrics,
        true, cursor)
}

#program_export
StackChildBoundsFor :: (container: LayoutContainer,
    declared: Rectangle, measured: Rectangle) -> Rectangle {
    return StackChildBounds(declared, measured,
        ContainerMetrics(container))
}
}
