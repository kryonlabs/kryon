#module "style_palette_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "theme.h"
#import "runtime/theme.h"
#import "runtime/style.h"

scheme_cache :: ThemeScheme #global
scheme_cache_valid :: i32 #global
scheme_key_bg :: Color #global
scheme_key_surface :: Color #global
scheme_key_text :: Color #global
scheme_key_circle :: Color #global
scheme_key_button :: Color #global
scheme_key_dark :: i32 #global

SameColor :: (a: Color, b: Color) -> i32 {
    return a.r == b.r && a.g == b.g &&
    a.b == b.b && a.a == b.a
}

ui_default_scheme :: () -> ThemeScheme #export {
    input_surface: Color = c_surface
    dark: i32 = GetEffectiveThemeDarkMode()
    if scheme_cache_valid && dark == scheme_key_dark &&
    SameColor(scheme_key_bg, c_bg) &&
    SameColor(scheme_key_surface, input_surface) &&
    SameColor(scheme_key_text, c_text) &&
    SameColor(scheme_key_circle, c_circle) &&
    SameColor(scheme_key_button, c_button) {
        return scheme_cache
    }
    roles: Scheme = SchemeFor(ColorToInt(c_bg),
    ColorToInt(input_surface), ColorToInt(c_text),
    ColorToInt(c_circle), ColorToInt(c_button),
    dark != 0, StyleDisabledAlpha())
    scheme: ThemeScheme = (ThemeScheme){0}
    scheme.primary = GetColor(roles.primary)
    scheme.on_primary = GetColor(roles.on_primary)
    scheme.secondary = GetColor(roles.secondary)
    scheme.on_secondary = GetColor(roles.on_secondary)
    scheme.surface = GetColor(roles.surface)
    scheme.on_surface = GetColor(roles.on_surface)
    scheme.surface_container = GetColor(roles.surface_container)
    scheme.surface_variant = GetColor(roles.surface_variant)
    scheme.on_surface_variant = GetColor(roles.on_surface_variant)
    scheme.outline = GetColor(roles.outline)
    scheme.error = GetColor(roles.error)
    scheme.on_error = GetColor(roles.on_error)
    scheme.disabled_container = GetColor(roles.disabled_container)
    scheme.disabled_content = GetColor(roles.disabled_content)
    scheme_cache = scheme
    scheme_cache_valid = 1
    scheme_key_bg = c_bg
    scheme_key_surface = input_surface
    scheme_key_text = c_text
    scheme_key_circle = c_circle
    scheme_key_button = c_button
    scheme_key_dark = dark
    return scheme
}

GetThemeScheme :: () -> ThemeScheme #export {
    return ui_default_scheme()
}

ui_runtime_theme_values :: (palette_out: *Palette,
metrics_out: *Metrics) #export {
    scheme: ThemeScheme = ui_default_scheme()
    theme: const Theme* = GetThemeRef()
    defaults: Palette = DefaultPalette(GetEffectiveThemeDarkMode())
    surface: Color = theme != nil
    ? theme->colors.surface : scheme.surface
    neutral: Color = theme != nil
    ? theme->colors.surface_raised : scheme.surface_variant
    accent: Color = theme != nil
    ? theme->colors.accent : scheme.primary
    accent_hover: Color = theme != nil
    ? theme->colors.accent_hover : accent
    accent_pressed: Color = theme != nil
    ? theme->colors.accent_pressed : DarkenColor(accent, 14)
    danger: Color = theme != nil
    ? theme->colors.danger : GetColor(defaults.danger)
    success: Color = theme != nil
    ? theme->colors.success : GetColor(defaults.success)
    warning: Color = theme != nil
    ? theme->colors.warning : GetColor(defaults.warning)
    disabled_text: Color = theme != nil
    ? theme->colors.text_disabled : GetColor(defaults.text_disabled)
    palette: Palette = (Palette){0}
    palette.background = ColorToInt(theme != nil
    ? theme->colors.background : scheme.surface)
    palette.surface = ColorToInt(surface)
    palette.surface_raised = ColorToInt(neutral)
    palette.surface_sunken = ColorToInt(theme != nil
    ? theme->colors.surface_sunken : scheme.surface_container)
    palette.overlay = ColorToInt(theme != nil
    ? theme->colors.overlay : GetColor(defaults.overlay))
    palette.accent = ColorToInt(accent)
    palette.accent_hover = ColorToInt(accent_hover)
    palette.accent_pressed = ColorToInt(accent_pressed)
    palette.on_accent = ColorToInt(theme != nil
    ? theme->colors.on_accent : scheme.on_primary)
    palette.text = ColorToInt(theme != nil
    ? theme->colors.text : scheme.on_surface)
    palette.text_muted = ColorToInt(theme != nil
    ? theme->colors.text_muted : scheme.on_surface_variant)
    palette.text_disabled = ColorToInt(disabled_text)
    palette.icon = ColorToInt(theme != nil
    ? theme->colors.icon : scheme.on_surface)
    palette.icon_muted = ColorToInt(theme != nil
    ? theme->colors.icon_muted : scheme.on_surface_variant)
    palette.border = ColorToInt(theme != nil
    ? theme->colors.border : scheme.outline)
    palette.border_strong = ColorToInt(theme != nil
    ? theme->colors.border_strong : scheme.outline)
    palette.divider = ColorToInt(theme != nil
    ? theme->colors.divider : scheme.outline)
    palette.danger = ColorToInt(danger)
    palette.on_danger = ColorToInt(theme != nil
    ? theme->colors.on_danger : GetColor(defaults.on_danger))
    palette.success = ColorToInt(success)
    palette.on_success = ColorToInt(theme != nil
    ? theme->colors.on_success : GetColor(defaults.on_success))
    palette.warning = ColorToInt(warning)
    palette.on_warning = ColorToInt(theme != nil
    ? theme->colors.on_warning : GetColor(defaults.on_warning))
    palette.link = ColorToInt(theme != nil
    ? theme->colors.link : scheme.primary)
    palette.focus = ColorToInt(theme != nil
    ? theme->colors.focus : scheme.primary)
    palette.shadow = ColorToInt(theme != nil
    ? theme->colors.shadow : GetColor(defaults.shadow))
    theme_metrics: ThemeMetrics = GetThemeMetrics()
    tokens: Metrics = (Metrics){0}
    tokens.transition_normal_ms = theme_metrics.transition_normal_ms
    tokens.transition_fast_ms = theme_metrics.transition_fast_ms
    tokens.radius_medium = theme_metrics.radius_medium
    tokens.radius_large = theme_metrics.radius_large
    tokens.radius_pill = theme_metrics.radius_pill
    tokens.border_width = theme_metrics.border_width
    tokens.control_padding_small = theme_metrics.control_padding_small
    tokens.control_padding_medium = theme_metrics.control_padding_medium
    tokens.control_padding_large = theme_metrics.control_padding_large
    tokens.control_gap = theme_metrics.control_gap
    tokens.font_size_small = theme_metrics.font_size_small
    tokens.font_size_medium = theme_metrics.font_size_medium
    tokens.font_size_large = theme_metrics.font_size_large
    tokens.icon_size_small = theme_metrics.icon_size_small
    tokens.icon_size_medium = theme_metrics.icon_size_medium
    tokens.icon_size_large = theme_metrics.icon_size_large
    *palette_out = palette
    *metrics_out = tokens
}
