#module "kss_host"
#import "ui_style_pack_props.generated.h"
#import "runtime/kss_parser.h"
#import "runtime/kss_formatter.h"
#import "stdlib.h"
#import "stdio.h"
#import "string.h"

KssVariantInfo :: struct {
    name: [64]char
    label: [64]char
}

KssParseResult :: struct {
    pack_id: [64]char
    rule_count: i32
    variants: [8]KssVariantInfo
    variant_count: i32
}

KssRuleSource :: struct {
    file: [96]char
    file_index: i32
    line: i32
    column: i32
    selector_start: i32
    selector_length: i32
    body_start: i32
    body_length: i32
    group: i32
    end: i32
}

KssModule :: struct {
    id: [64]char
    source: *char
}

kss_modules :: [32]KssModule #global
kss_module_count :: i32 #global
kss_parse_invocation_count :: i32 #global

StringSlice :: (source: String, start: i32,
length: i32) -> String #export {
    if start < 0 || length < 0 ||
    (size_t)start + (size_t)length > source.length {
        return StringView(nil, 0)
    }
    return StringView(source.data + start, (size_t)length)
}

RegisterStyleModule :: (id: const char*,
source: const char*) -> bool #export {
    if id == nil || source == nil || id[0] == '\0' {
        return false
    }
    slot: *KssModule = nil
    index: i32 = 0
    while index < kss_module_count {
        if strcmp(kss_modules[index].id, id) == 0 {
            slot = &kss_modules[index]
        }
        index += 1
    }
    if slot == nil {
        if kss_module_count >= 32 { return false }
        slot = &kss_modules[kss_module_count]
        kss_module_count += 1
        written: i32 = snprintf(slot->id, sizeof(slot->id), "%s", id)
        if written < 0 || written >= (int32_t)sizeof(slot->id) {
            kss_module_count -= 1
            return false
        }
    } else {
        free(slot->source)
    }
    length: size_t = strlen(source)
    slot->source = (char*)malloc(length + 1)
    if slot->source == nil { return false }
    copied: *void = memcpy(slot->source, source, length + 1)
    return copied != nil
}

ClearStyleModules :: () #export {
    index: i32 = 0
    while index < kss_module_count {
        free(kss_modules[index].source)
        kss_modules[index] = (KssModule){0}
        index += 1
    }
    kss_module_count = 0
}

GetStyleModuleCount :: () -> i32 #export {
    return kss_module_count
}

KssModuleSource :: (name: const KssName*) -> const char* {
    if name == nil || name->length <= 0 || name->length >= 64 {
        return nil
    }
    index: i32 = 0
    while index < kss_module_count {
        if (int32_t)strlen(kss_modules[index].id) == name->length &&
        memcmp(kss_modules[index].id, name->bytes,
        (size_t)name->length) == 0 {
            return kss_modules[index].source
        }
        index += 1
    }
    return nil
}

KssCopyFileName :: (out: *char, out_size: size_t,
file: const KssSourceFile*) {
    if out == nil || out_size == 0 { return }
    out[0] = '\0'
    if file == nil { return }
    length: i32 = file->length
    if length < 0 { length = 0 }
    if (size_t)length >= out_size {
        length = (int32_t)out_size - 1
    }
    memcpy(out, file->name, (size_t)length)
    out[length] = '\0'
}

KssCopyRuleSource :: (source: *KssRuleSource,
parser: const KssParser*, origin: const KssOrigin*,
span: const KssRuleSpan*) {
    if source == nil || parser == nil ||
    origin == nil || span == nil { return }
    *source = (KssRuleSource){0}
    file_index: i32 = span->file
    source->file_index = file_index
    source->line = origin->line
    source->column = origin->column
    source->selector_start = span->selector_start
    source->selector_length = span->selector_length
    source->body_start = span->body_start
    source->body_length = span->body_length
    source->group = span->group
    source->end = span->end
    if file_index >= 0 && file_index < parser->file_count {
        KssCopyFileName(source->file, sizeof(source->file),
        &parser->files[file_index])
    }
}

KssCopyDiagnostic :: (diagnostic: *char,
diagnostic_size: size_t, parser: const KssParser*) {
    if diagnostic == nil || diagnostic_size == 0 { return }
    length: i32 = parser->diagnostic_length
    if length < 0 { length = 0 }
    if (size_t)length >= diagnostic_size {
        length = (int32_t)diagnostic_size - 1
    }
    memcpy(diagnostic,
    parser->diagnostic, (size_t)length)
    diagnostic[length] = '\0'
}

KssParseInvocationCount :: () -> i32 #export {
    return kss_parse_invocation_count
}

KssResetParseInvocationCount :: () #export {
    kss_parse_invocation_count = 0
}

KssCollect :: (source: const char*, colors: const StyleColorToken*,
color_count: i32, variant: const char*, theme: const char*,
rules: *StyleRule, sources: *KssRuleSource,
rule_capacity: i32, result: *KssParseResult,
diagnostic: *char, diagnostic_size: size_t) -> bool {
    environment: KssEnvironment = KssDefaultEnvironment()
    empty: String = StringView(nil, 0)
    environment = KssEnvironmentWithNames(environment,
    StringView(theme, theme != nil ? strlen(theme) : 0),
    empty, empty, empty, empty,
    StringView(variant, variant != nil ? strlen(variant) : 0))
    parser: KssParser = KssBegin(StringView(source, strlen(source)),
    StringView(nil, 0), environment)
    rule_count: i32 = 0
    kss_parse_invocation_count += 1
    if diagnostic != nil && diagnostic_size > 0 {
        diagnostic[0] = '\0'
    }
    index: i32 = 0
    while index < color_count {
        parser = KssAddColorOverride(parser,
        StringView(colors[index].name, strlen(colors[index].name)),
        colors[index].color)
        index += 1
    }
    while true {
        if parser.status == KssStatusRule {
            if rule_count >= rule_capacity {
                if diagnostic != nil && diagnostic_size > 0 {
                    snprintf(diagnostic,
                    diagnostic_size, "style rule capacity exceeded")
                }
                return false
            }
            rules[rule_count] = parser.rule
            if sources != nil {
                KssCopyRuleSource(&sources[rule_count], &parser,
                &parser.origin, &parser.rule_span)
            }
            rule_count += 1
            parser.status = KssStatusContinue
            continue
        }
        if parser.status != KssStatusContinue { break }
        parser = KssStep(parser)
        if parser.status == KssStatusNeedImport {
            module: const char* = KssModuleSource(&parser.pending_import)
            if module != nil {
                id: [96]char
                length: i32 = parser.pending_import.length
                if length > 95 { length = 95 }
                memcpy(id, parser.pending_import.bytes,
                (size_t)length)
                id[length] = '\0'
                parser = KssProvideImport(parser,
                StringView(module, strlen(module)),
                StringView(id, (size_t)length))
            } else {
                parser = KssFailImport(parser)
            }
        }
    }
    if parser.status != KssStatusDone {
        KssCopyDiagnostic(diagnostic, diagnostic_size, &parser)
        return false
    }
    if result != nil {
        length: i32 = parser.pack.length
        result->rule_count = rule_count
        result->variant_count = parser.variant_count
        index: i32 = 0
        while index < parser.variant_count && index < 8 {
            name_length: i32 = parser.variants[index].name.length
            label_length: i32 = parser.variants[index].label.length
            if name_length < 0 { name_length = 0 }
            if name_length >= (int32_t)sizeof(result->variants[index].name) {
                name_length = sizeof(result->variants[index].name) - 1
            }
            if label_length < 0 { label_length = 0 }
            if label_length >= (int32_t)sizeof(result->variants[index].label) {
                label_length = sizeof(result->variants[index].label) - 1
            }
            memcpy(result->variants[index].name,
            parser.variants[index].name.bytes, (size_t)name_length)
            result->variants[index].name[name_length] = '\0'
            memcpy(result->variants[index].label,
            parser.variants[index].label.bytes, (size_t)label_length)
            result->variants[index].label[label_length] = '\0'
            index += 1
        }
        if length < 0 { length = 0 }
        if length >= (int32_t)sizeof(result->pack_id) {
            length = sizeof(result->pack_id) - 1
        }
        memcpy(result->pack_id,
        parser.pack.bytes, (size_t)length)
        result->pack_id[length] = '\0'
    }
    return true
}

kss_parse_variant :: (source: const char*, colors: const StyleColorToken*,
color_count: i32, rules: *StyleRule, rule_capacity: i32,
result: *KssParseResult, diagnostic: *char,
diagnostic_size: size_t) -> bool #export {
    if source == nil || rules == nil || rule_capacity < 0 {
        return false
    }
    if color_count < 0 || (color_count > 0 && colors == nil) {
        return false
    }
    return KssCollect(source, colors, color_count,
    nil, nil, rules, nil, rule_capacity, result,
    diagnostic, diagnostic_size)
}

kss_parse_string :: (source: const char*, rules: *StyleRule,
rule_capacity: i32, result: *KssParseResult,
diagnostic: *char, diagnostic_size: size_t) -> bool #export {
    return kss_parse_variant(source, nil, 0, rules,
    rule_capacity, result, diagnostic, diagnostic_size)
}

kss_parse_trace_string :: (source: const char*,
rules: *StyleRule, sources: *KssRuleSource,
rule_capacity: i32, result: *KssParseResult,
diagnostic: *char, diagnostic_size: size_t) -> bool #export {
    if source == nil || rules == nil || sources == nil ||
    rule_capacity < 0 { return false }
    return KssCollect(source, nil, 0, nil, nil,
    rules, sources, rule_capacity, result,
    diagnostic, diagnostic_size)
}

kss_parse_with_variant :: (source: const char*,
variant: const char*, rules: *StyleRule,
rule_capacity: i32, result: *KssParseResult,
diagnostic: *char, diagnostic_size: size_t) -> bool #export {
    return kss_parse_with_environment(source, variant, nil,
    rules, rule_capacity, result, diagnostic,
    diagnostic_size)
}

kss_parse_with_environment :: (source: const char*,
variant: const char*, theme: const char*, rules: *StyleRule,
rule_capacity: i32, result: *KssParseResult,
diagnostic: *char, diagnostic_size: size_t) -> bool #export {
    if source == nil || rules == nil || rule_capacity < 0 {
        return false
    }
    return KssCollect(source, nil, 0, variant, theme,
    rules, nil, rule_capacity, result,
    diagnostic, diagnostic_size)
}

kss_format_string :: (source: const char*, out: *char,
out_size: size_t, diagnostic: *char,
diagnostic_size: size_t) -> i32 #export {
    if source == nil || out == nil || out_size == 0 {
        return -1
    }
    if diagnostic != nil && diagnostic_size > 0 {
        diagnostic[0] = '\0'
    }
    result: KssFormatResult = KssFormat(
    StringView(source, strlen(source)))
    if !result.ok {
        count: i32 = result.diagnostic_length
        if diagnostic != nil && diagnostic_size > 0 {
            if count >= (int32_t)diagnostic_size {
                count = (int32_t)diagnostic_size - 1
            }
            if count < 0 { count = 0 }
            memcpy(diagnostic,
            result.diagnostic, (size_t)count)
            diagnostic[count] = '\0'
        }
        return -1
    }
    length: size_t = 0
    index: i32 = 0
    while index < result.count {
        segment: const KssFormatSegment* = &result.segments[index]
        need: size_t = 1
        if segment->kind == 0 {
            need = (size_t)segment->length
        } else if segment->kind != 1 {
            need = 1 + (size_t)segment->length
        }
        if length + need + 1 > out_size { return -1 }
        if segment->kind == 0 {
            memcpy(out + length,
            source + segment->start, (size_t)segment->length)
            length += (size_t)segment->length
        } else if segment->kind == 1 {
            out[length] = (char)segment->atom
            length += 1
        } else {
            out[length] = '\n'
            length += 1
            space: i32 = 0
            while space < segment->length {
                out[length] = ' '
                length += 1
                space += 1
            }
        }
        index += 1
    }
    out[length] = '\0'
    return (int32_t)length
}
