#import "control_props"
#import "geometry"
#import "style"

using StyleField;
#program_export
FocusActivationFor :: (active: bool, keyboard_enabled: bool,
content_disabled: bool, captured: bool, enter_pressed: bool,
space_pressed: bool, text_input_active: bool) -> bool {
    return active && keyboard_enabled && !content_disabled && !captured &&
    (enter_pressed || (!text_input_active && space_pressed))
}

#program_export
FocusTabDirectionFor :: (tab_pressed: bool, shift_down: bool) -> s32 {
    if !tab_pressed { return 0 }
    if shift_down { return -1 }
    return 1
}

#program_export
FocusDefaultOutlineBounds :: (bounds: Rectangle, scale: float32) -> Rectangle {
    if scale <= 0.0 { scale = 1.0 }
    pad: s32 = cast(s32)(2.0 * scale)
    return Rectangle.{.x = bounds.x - cast(float32)pad, .y = bounds.y - cast(float32)pad,
        .width = bounds.width + cast(float32)(pad * 2),
        .height = bounds.height + cast(float32)(pad * 2)}
}
TreeFocusScan :: struct {
    index: s32
    origin: s32
    depth: s32
    parent: bool
    child: bool
    done: bool
}

#program_export
TreeFocusBegin :: (current: s32, count: s32, depth: s32, down: bool,
up: bool, right: bool, left: bool) -> TreeFocusScan {
    scan: TreeFocusScan = TreeFocusScan.{.index = current, .origin = current, .depth = depth, .done = true}
    if current < 0 || current >= count { return scan }
    if down || right {
        if current + 1 >= count { return scan }
        scan.index = current + 1
        scan.child = !down && right
    } else if up || left {
        if current <= 0 { return scan }
        scan.index = current - 1
        scan.parent = !up && left
    } else {
        return scan
    }
    scan.done = false
    return scan
}

#program_export
TreeFocusAdvance :: (scan: TreeFocusScan, candidate_depth: s32) -> TreeFocusScan {
    if scan.done { return scan }
    if scan.parent && candidate_depth >= scan.depth {
        if scan.index > 0 {
            scan.index -= 1
            return scan
        }
        scan.index = scan.origin
    } else if scan.child && candidate_depth <= scan.depth {
        scan.index = scan.origin
    }
    scan.done = true
    return scan
}
