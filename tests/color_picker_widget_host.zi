#import "drawing_props"
#import "geometry"

swatches: s32;
labels: s32;
failed: bool;

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface != "" { failed = true }
    return 12
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.x < 10.0 || bounds.y < 10.0 ||
        bounds.x + bounds.width > 190.0 ||
        bounds.y + bounds.height > 250.0 { failed = true }
    if bounds.y == 214.0 && bounds.height == 36.0 {
        if color.r != cast(u8)64 || color.g != cast(u8)128 ||
            color.b != cast(u8)191 { failed = true }
        swatches += 1
    }
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
}

#program_export
RasterLine :: (bounds: Rectangle, color: Color) { failed = true }

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) { failed = true }

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if value.count == 0 || font != 14 || clip.x < 10.0 ||
        clip.y < 10.0 || clip.x + clip.width > 190.0 ||
        clip.y + clip.height > 250.0 { failed = true }
    labels += 1
}

#program_export
RasterImage :: (path: string, texture_id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) { failed = true }

#program_export
HostCountsAre :: (want_swatches: s32, want_labels: s32) -> bool {
    return !failed && swatches == want_swatches && labels == want_labels
}
