// Ogg Opus for audio_mixer, decoded as it plays by audio/opus. Importing
// this module is what adds the format; native programs link libopus.
Mixer :: #import "audio_mixer";
Opus :: #import "audio/opus";
Types :: #import "audio/types";

#scope_file
libc :: #system_library "c";
Allocate :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Free :: (value: *void) #foreign libc "free";

State :: struct { decoder: Opus.Decoder; }

// The first Ogg page holds exactly the identification packet, which begins
// with OpusHead (RFC 7845).
Probe :: (bytes: []u8) -> bool {
    if bytes.count < 47 || bytes[0] != #char "O" || bytes[1] != #char "g" ||
    bytes[2] != #char "g" || bytes[3] != #char "S" { return false }
    start := 27 + cast(s64)bytes[26]
    return start + 8 <= bytes.count && TextView(bytes[start:start + 8]) == "OpusHead"
}

Read :: (argument: *void, output: []float32, frames: s64) -> s64 {
    state := cast(*State)argument
    made: s64
    channels := cast(s64)state.decoder.info.channels
    if Opus.DecoderRead(*state.decoder, output[0:frames * channels], *made) != Types.OK { return -1 }
    return made
}

Rewind :: (argument: *void) -> bool {
    return Opus.DecoderRewind(*(cast(*State)argument).decoder) == Types.OK
}

Close :: (argument: *void) {
    state := cast(*State)argument
    Opus.DecoderClose(*state.decoder)
    Free(argument)
}

Open :: (bytes: []u8, source: *Mixer.AudioSource) -> bool {
    state := cast(*State)Allocate(1, size_of(State))
    if state == null { return false }
    if Opus.DecoderOpen(*state.decoder, bytes, cast(s64)48000 * 86400) != Types.OK {
        Free(cast(*void)state)
        return false
    }
    source.* = .{.state = cast(*void)state, .read = Read, .rewind = Rewind, .close = Close,
        .rate = 48000, .channels = state.decoder.info.channels, .frames = state.decoder.info.frames}
    return true
}

registered: bool = Mixer.AudioUseDecoder(Probe, Open);
