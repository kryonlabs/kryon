# Resolve codec-owned build entry points through the ordinary package graph.
# Callers can pass KRYON_AVIF_PACKAGE_DIR / KRYON_WEBP_PACKAGE_DIR when building
# a renderer artifact from a consumer's locked dependency graph.
include_guard(GLOBAL)

# Locked checkout of any package or pinned source dependency in Kryon's graph.
function(kryon_ziran_package_path output name)
    if(DEFINED ZIRAN_BIN AND NOT ZIRAN_BIN STREQUAL "")
        set(ziran "${ZIRAN_BIN}")
    elseif(NOT "$ENV{ZIRAN_BIN}" STREQUAL "")
        set(ziran "$ENV{ZIRAN_BIN}")
    elseif(DEFINED ZIRAN_DIR AND NOT ZIRAN_DIR STREQUAL "")
        set(ziran "${ZIRAN_DIR}/build/bin/ziran")
    elseif(NOT "$ENV{ZIRAN_TOOLCHAIN_ROOT}" STREQUAL "")
        set(ziran "$ENV{ZIRAN_TOOLCHAIN_ROOT}/build/bin/ziran")
    elseif(NOT "$ENV{ZIRAN_DIR}" STREQUAL "")
        set(ziran "$ENV{ZIRAN_DIR}/build/bin/ziran")
    elseif(NOT "$ENV{ZIRAN}" STREQUAL "")
        set(ziran "$ENV{ZIRAN}")
    else()
        set(ziran ziran)
    endif()
    get_filename_component(project "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(locked --locked)
    if(EXISTS "${project}/ziran.local.toml")
        set(locked)
    endif()
    execute_process(COMMAND "${ziran}" pkg path "${name}" ${locked}
        WORKING_DIRECTORY "${project}"
        RESULT_VARIABLE status OUTPUT_VARIABLE directory
        ERROR_VARIABLE diagnostic OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot resolve ${name} package: ${diagnostic}")
    endif()
    set(${output} "${directory}" PARENT_SCOPE)
endfunction()

function(kryon_image_package output name)
    string(TOUPPER "${name}" upper)
    set(selection "KRYON_${upper}_PACKAGE_DIR")
    if(DEFINED ${selection} AND NOT "${${selection}}" STREQUAL "")
        set(directory "${${selection}}")
    elseif(NOT "$ENV{${selection}}" STREQUAL "")
        set(directory "$ENV{${selection}}")
    else()
        kryon_ziran_package_path(directory "${name}")
    endif()
    if(NOT EXISTS "${directory}/ziran.toml")
        message(FATAL_ERROR "No ${name} package at ${directory}; run ziran fetch")
    endif()
    set(${output} "${directory}" PARENT_SCOPE)
endfunction()
