            editor := PEdit(env, prefs)
            PPut(env, editor, "request", NString(env, ""))
            if !PCommit(env, editor) { return }
            unused PEndpoint(env, context, PushProviderFcm, wire, token, null, null)
        }
        PFcmEnvelope :: (env: *JniEnv, prefs: *void, scope: *void, wire: *void) -> bool {
            return PInt(env, prefs, "provider") == PushProviderFcm && PInt(env, prefs, "status") == PushReady &&
                PEqual(env, PGet(env, prefs, "scope"), scope) && PEqual(env, PGet(env, prefs, "wire"), wire)
        }
        // FCM notification payloads can auto-display inside the SDK before
        // onMessageReceived. Gate before super.handleIntent, and accept only
        // data messages carrying the active application's account+instance.
        #program_export "Java_org_kryonlabs_notifications_push_SharedFcmService_ingress"
        PFcmIngress :: (env: *JniEnv, klass: *void, context: *void, intent: *void) -> u8 {
            unused klass
            unused PLock(cast(*void)*p_mutex[0])
            defer { unused PUnlock(cast(*void)*p_mutex[0]); unused PClear(env) }
            prefs := PPrefs(env, context)
            if PInt(env, prefs, "provider") != PushProviderFcm || intent == null { return 0 }
            action := NObject(env, intent, "getAction", "()Ljava/lang/String;")
            if PEqual(env, action, NString(env, "com.google.firebase.messaging.NEW_TOKEN")) {
                status := PInt(env, prefs, "status")
                return ifx status == PushRegistering || status == PushReady || status == PushUnavailable then 1 else 0
            }
            if !PEqual(env, action, NString(env, "com.google.android.c2dm.intent.RECEIVE")) &&
                !PEqual(env, action, NString(env, "com.google.firebase.messaging.RECEIVE_DIRECT_BOOT")) { return 0 }
            flags: [2]string = .["gcm.n.e", "gcm.notification.e"]
            for key: flags {
                flag := NObject(env, intent, "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;", NRef(NString(env, key)))
                if PEqual(env, flag, NString(env, "1")) { return 0 }
            }
            scope := NObject(env, intent, "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;", NRef(NString(env, "kryon_scope")))
            wire := NObject(env, intent, "getStringExtra", "(Ljava/lang/String;)Ljava/lang/String;", NRef(NString(env, "kryon_instance")))
            return ifx PFcmEnvelope(env, prefs, scope, wire) then 1 else 0
        }
        #program_export "Java_org_kryonlabs_notifications_push_SharedFcmService_acceptsMessage"
        PFcmMessage :: (env: *JniEnv, klass: *void, context: *void, message: *void) -> u8 {
            unused klass
            unused PLock(cast(*void)*p_mutex[0])
            defer { unused PUnlock(cast(*void)*p_mutex[0]); unused PClear(env) }
            data := NObject(env, message, "getData", "()Ljava/util/Map;")
            scope := NObject(env, data, "get", "(Ljava/lang/Object;)Ljava/lang/Object;", NRef(NString(env, "kryon_scope")))
            wire := NObject(env, data, "get", "(Ljava/lang/Object;)Ljava/lang/Object;", NRef(NString(env, "kryon_instance")))
            return ifx PFcmEnvelope(env, PPrefs(env, context), scope, wire) then 1 else 0
        }
    }
    #program_export "Java_org_kryonlabs_notifications_push_PushCallbacks_snapshot"
    PSnapshotCallback :: (env: *JniEnv, klass: *void, context: *void, scope: *void) -> *void {
        unused klass
        unused PLock(cast(*void)*p_mutex[0])
        defer { unused PUnlock(cast(*void)*p_mutex[0]); unused PClear(env) }
        state: PushState
        if !PRead(env, context, scope, *state) { return NString(env, "{}") }
        json := NNew(env, "org/json/JSONObject", "()V")
        unused NObject(env, json, "put", "(Ljava/lang/String;I)Lorg/json/JSONObject;", NRef(NString(env, "status")), NNumber(state.status))
        unused NObject(env, json, "put", "(Ljava/lang/String;I)Lorg/json/JSONObject;", NRef(NString(env, "provider")), NNumber(state.provider))
        unused NObject(env, json, "put", "(Ljava/lang/String;J)Lorg/json/JSONObject;", NRef(NString(env, "revision")), NWide(state.revision))
        keys: [2]string = .["distributor", "wire"]
        for key: keys {
            unused NObject(env, json, "put", "(Ljava/lang/String;Ljava/lang/Object;)Lorg/json/JSONObject;", NRef(NString(env, key)), NRef(PGet(env, PPrefs(env, context), key)))
        }
        unused NObject(env, json, "put", "(Ljava/lang/String;Ljava/lang/Object;)Lorg/json/JSONObject;", NRef(NString(env, "endpoint")), NRef(NString(env, TextFromCString(*state.endpoint[0]))))
        unused NObject(env, json, "put", "(Ljava/lang/String;Ljava/lang/Object;)Lorg/json/JSONObject;", NRef(NString(env, "auth")), NRef(NString(env, TextFromCString(*state.auth[0]))))
        unused NObject(env, json, "put", "(Ljava/lang/String;Ljava/lang/Object;)Lorg/json/JSONObject;", NRef(NString(env, "p256dh")), NRef(NString(env, TextFromCString(*state.p256dh[0]))))
        return NObject(env, json, "toString", "()Ljava/lang/String;")
    }
}
