#module "popup_props"
#import "geometry"

PopupFlags :: enum {
    PopupFlagsNone = 0
    PopupTooltip = 1
    PopupModal = 2
    PopupContext = 4
}

PopupProps :: struct {
    bounds: Rectangle
    id: i32
    class_name: i32
    open: bool*
    disabled: bool
    trigger: Rectangle
    flags: PopupFlags
}
