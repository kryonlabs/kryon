// Strict AVIF parity alone, for cross-built targets without a renderer
// (Linux AArch64 under qemu-user): every corpus case through dav1d at each
// thread count and the libaom oracle.
#import "avif_engine_parity"
#import "std/byte_text_linux"
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 2 { print("usage: avif-parity FIXTURES\n"); return 2 }
    return ifx AvifEngineParity(TextFromCString(argv[1])) then 0 else 1
}
