// Scene registry and shared gallery state. Screen composition is authored in
// the maintained TSX examples (examples/shared/screens and each package's
// exported example screens), and the generated catalog dispatches those
// screens. This module keeps the shared theme/dismissal state, the scene
// name table used by the website generator and review captures, and the
// site editor's input helpers, so the native application, Canvas/Wasm
// build, widget review tool and website build agree on one state.
#import "kryon/key_input"
TextArea :: #import "kryon/text_area";
TextField :: #import "kryon/text_field";

dark: bool;
dismissed: bool;
scene_image: string = "assets/pfp.webp";

SceneInput :: struct { area: TextArea.Input }

SceneInputFor :: (input_key: s32, modifiers: s32, input_text: string) -> SceneInput {
    return SceneInput.{.area = TextAreaInputFor(input_key, modifiers, input_text)}
}

// In-place text splice so any editor capacity works without a large scratch
// copy: shift the tail directly inside the target buffer.
Apply :: (target: []u8, length: s32, edit: TextField.Edit) -> s32 {
    if !edit.changed { return length }
    if edit.start < 0 || edit.end < edit.start || edit.end > length { return length }
    removed := edit.end - edit.start
    added := cast(s32)edit.replacement.count
    new_length := length - removed + added
    if new_length > cast(s32)target.count { return length }
    if added > removed {
        shift := added - removed
        at := length - 1
        while at >= edit.end { target[at + shift] = target[at]; at -= 1 }
    } else {
        shift := removed - added
        at := edit.end
        while at < length { target[at - shift] = target[at]; at += 1 }
    }
    for index: 0..added - 1 { target[edit.start + index] = edit.replacement[index] }
    return new_length
}

SceneName :: (index: s32) -> string {
    if index == 0 { return "Button" }
    if index == 1 { return "TextField" }
    if index == 2 { return "TextArea" }
    if index == 3 { return "Dropdown" }
    if index == 4 { return "Slider" }
    if index == 5 { return "Toggle" }
    if index == 6 { return "Checkbox" }
    if index == 7 { return "Radio" }
    if index == 8 { return "Progress" }
    if index == 9 { return "Spinbox" }
    if index == 10 { return "ListBox" }
    if index == 11 { return "ListBoxMulti" }
    if index == 12 { return "SegmentedControl" }
    if index == 13 { return "TabBar" }
    if index == 14 { return "Selectable" }
    if index == 15 { return "Separator and Bullet" }
    if index == 16 { return "Fieldset" }
    if index == 17 { return "Collapsible" }
    if index == 18 { return "TimePicker" }
    if index == 19 { return "ColorPicker" }
    if index == 20 { return "NavigationBar" }
    if index == 21 { return "Toolbar" }
    if index == 22 { return "TitleBar" }
    if index == 23 { return "Toast" }
    if index == 24 { return "ContextMenu" }
    if index == 25 { return "Menu" }
    if index == 26 { return "Link" }
    if index == 27 { return "Text" }
    if index == 28 { return "Image" }
    if index == 29 { return "Box" }
    if index == 30 { return "Circle Ring Triangle Line" }
    if index == 31 { return "Scroll" }
    if index == 32 { return "ModalFrame" }
    if index == 33 { return "ActionModal" }
    if index == 34 { return "Popup" }
    if index == 35 { return "Press" }
    if index == 36 { return "Column" }
    if index == 37 { return "Row" }
    if index == 38 { return "Stack" }
    if index == 39 { return "Group" }
    if index == 40 { return "Grid" }
    if index == 41 { return "Page Section Heading ParagraphText" }
    if index == 42 { return "NavigationBarConfig" }
    if index == 43 { return "Reorder" }
    if index == 44 { return "PanedView" }
    if index == 45 { return "DismissibleOverlay" }
    if index == 46 { return "Button emphasis" }
    if index == 47 { return "Dropdown open" }
    if index == 48 { return "Screen" }
    if index == 49 { return "Flow" }
    if index == 50 { return "Text selection" }
    if index == 51 { return "Transition fade" }
    if index == 52 { return "DiscreteSlider" }
    if index == 53 { return "Modern style" }
    if index == 54 { return "Card" }
    return ""
}
