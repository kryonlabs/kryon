        return -2
    }
    if KssNameEquals(name, "break-before") ||
        KssNameEquals(name, "break-after") ||
        KssNameEquals(name, "break-inside") ||
        KssNameEquals(name, "float") ||
        KssNameEquals(name, "clear") ||
        KssNameEquals(name, "order") {
        return -2
    }
    return -1
}

// CSS property vocabulary reuses declaration classification. These names are
// canonical KSS spellings; DOM camel-case names are only accepted by unit policy.
#program_export
KssCSSPropertyName :: (name: string) -> string {
    if name.count >= 2 && name[0] == 45 && name[1] == 45 {
        return name
    }
    if name.count > 64 {
        return ""
    }
    index: s32 = 0
    while index < cast(s32)name.count {
        if name[index] != KssLower(name[index]) {
            return ""
        }
        index = index + 1
    }
    if name == "foreground" {
        return "color"
    }
    if name == "border" {
        return "border-color"
    }
    if name == "radius" {
        return "border-radius"
    }
    if name == "padding-x" {
        return "padding-left"
    }
    if name == "padding-y" {
        return "padding-top"
    }
    if name == "margin-x" {
        return "margin-left"
    }
    if name == "margin-y" {
        return "margin-top"
    }
    if name == "typeface" {
        return "font-family"
    }
    if name == "focus" {
        return "outline-color"
    }
    if name == "material" || name == "content-offset-x" ||
        name == "content-offset-y" || name == "icon-size" ||
        name == "background-end" || name == "offset-x" || name == "offset-y" {
        return ""
    }
    if KssCSSPropertyKind(KssMakeName(name)) == -1 {
        return ""
    }
    return name
}

// Whether a numeric host value receives px. String values keep their units.
#program_export
KssCSSNeedsPixels :: (name: string) -> bool {
    if name == "opacity" ||
        name == "font-weight" ||
        name == "fontWeight" ||
        name == "line-height" ||
        name == "lineHeight" ||
        name == "z-index" {
        return false
    }
    if name == "zIndex" ||
        name == "tab-size" ||
        name == "tabSize" ||
        name == "font-size-adjust" ||
        name == "fontSizeAdjust" ||
        name == "column-count" {
        return false
    }
    if name == "columnCount" ||
        name == "order" ||
        name == "flex-grow" ||
        name == "flexGrow" ||
        name == "flex-shrink" ||
        name == "flexShrink" {
        return false
    }
    if name == "border-image-slice" ||
        name == "borderImageSlice" ||
        name == "border-image-width" ||
        name == "borderImageWidth" ||
        name == "border-image-outset" ||
        name == "borderImageOutset" {
        return false
    }
    if name == "grid-column-start" ||
        name == "gridColumnStart" ||
        name == "grid-column-end" ||
        name == "gridColumnEnd" ||
        name == "grid-row-start" ||
        name == "gridRowStart" {
        return false
    }
    if name == "grid-row-end" ||
        name == "gridRowEnd" ||
        name == "line-clamp" ||
        name == "lineClamp" ||
        name == "webkitLineClamp" || name == "-webkit-line-clamp" ||
        name == "orphans" {
        return false
    }
    if name == "widows" ||
        name == "animation-iteration-count" ||
        name == "animationIterationCount" ||
        name == "shape-image-threshold" ||
        name == "shapeImageThreshold" ||
        name == "scale" {
        return false
    }
    return true
}

// UTF-8 whitespace accepted by the existing CSS text adapter.
KssCSSSpaceLength :: (value: string, index: s32) -> s32 {
    if KssIsSpace(value[index]) {
        return 1
    }
    if index + 1 < (cast(s32)value.count) && value[index] == 194 && value[index + 1] == 160 {
        return 2
    }
    if index + 2 >= (cast(s32)value.count) {
        return 0
    }
    first: u8 = value[index]
    second: u8 = value[index + 1]
    third: u8 = value[index + 2]
    if first == 225 && second == 154 && third == 128 {
        return 3
    }
    if first == 226 && second == 128 &&
        ((third >= 128 && third <= 138) || third == 168 || third == 169 || third == 175) {
        return 3
    }
    if first == 226 && second == 129 && third == 159 {
        return 3
    }
    if first == 227 && second == 128 && third == 128 {
        return 3
    }
    if first == 239 && second == 187 && third == 191 {
        return 3
    }
    return 0
}

// Preserve KSS border's color alias unless its trimmed value has whitespace.
#program_export
KssCSSBorderShorthand :: (value: string) -> bool {
    index: s32 = 0
    content: bool = false
    space_after_content: bool = false
    while index < (cast(s32)value.count) {
        space: s32 = KssCSSSpaceLength(value, index)
        if space > 0 {
            if content {
                space_after_content = true
            }
            index = index + space
        } else {
            if space_after_content {
                return true
            }
            content = true
            index = index + 1
        }
    }
    return false
}

// Declaration expansion returns borrowed property names. Hosts emit the value
// for each nonempty name, using the shared numeric-unit policy.
KssCSSExpansion :: struct {
    first: string
    second: string
}

#program_export
KssCSSExpandDeclaration :: (name: string, value: string, has_offsets: bool) -> KssCSSExpansion {
    result: KssCSSExpansion
    if value == "" || name == "offset-x" || name == "offset-y" {
        return result
    }
    if name == "transform" && has_offsets {
        return result
    }
    if name == "content-offset-x" {
        result.first = "--kryon-content-offset-x"
    } else if name == "content-offset-y" {
        result.first = "--kryon-content-offset-y"
    } else if name == "icon-size" {
        result.first = "--kryon-icon-size"
    } else if name == "background-end" {
        result.first = "--kryon-background-end"
    } else if name == "border" && KssCSSBorderShorthand(value) {
        result.first = "border"
    } else {
        result.first = KssCSSPropertyName(name)
    }
    if name == "padding-x" {
        result.second = "padding-right"
    } else if name == "padding-y" {
        result.second = "padding-bottom"
    } else if name == "margin-x" {
        result.second = "margin-right"
    } else if name == "margin-y" {
        result.second = "margin-bottom"
    } else if name == "line-clamp" {
        result.second = "-webkit-line-clamp"
    } else if name == "box-decoration-break" {
        result.second = "-webkit-box-decoration-break"
    }
    return result
}

// An authored nonzero border width or border paint requests a visible border.
// Emit this before authored declarations so explicit styles and sides win.
#program_export
KssCSSBorderDefault :: (border: string, width: string) -> string {
    paint: KssCSSValue = KssCSSValueFromText(border)
    size: KssCSSValue = KssCSSValueFromText(width)
    if (paint.text != "" && (paint.kind != cast(s32)KssCSSNumber || paint.number != 0)) ||
        (size.text != "" && (size.kind != cast(s32)KssCSSNumber || size.number != 0)) {
        return "solid"
    }
    return ""
}

// Values already have their CSS units. Empty text means absent, not zero.
KssCSSEffectFacts :: struct {
    background: string
    background_end: string
    background_image: string
    offset_x: string
    offset_y: string
    transform: string
}

// A borrowed-fragment output recipe avoids a fixed output buffer or allocation.
// Emit name: prefix + first + separator + second + suffix when name is nonempty.
KssCSSOutput :: struct {
    name: string
    prefix: string
    first: string
    separator: string
    second: string
    suffix: string
}

#program_export
KssCSSHasOffsets :: (facts: KssCSSEffectFacts) -> bool {
    return facts.offset_x != "" || facts.offset_y != ""
}

// Slots 0..3 follow ordinary declarations: gradient, x, y, then transform.
// An absent or out-of-range slot produces no output.
#program_export
KssCSSEffectAt :: (facts: KssCSSEffectFacts, index: s32) -> KssCSSOutput {
    result: KssCSSOutput
    if index == 0 && facts.background != "" && facts.background_end != "" && facts.background_image == "" {
        result.name = "background-image"
        result.prefix = "linear-gradient("
        result.first = facts.background
        result.separator = ", "
        result.second = facts.background_end
        result.suffix = ")"
    } else if index == 1 && facts.offset_x != "" {
        result.name = "--kryon-offset-x"
        result.first = facts.offset_x
    } else if index == 2 && facts.offset_y != "" {
        result.name = "--kryon-offset-y"
        result.first = facts.offset_y
    } else if index == 3 && KssCSSHasOffsets(facts) {
        result.name = "transform"
        result.prefix = "translate(var(--kryon-offset-x, 0px), var(--kryon-offset-y, 0px))"
        if facts.transform != "" {
            result.separator = " "
            result.second = facts.transform
        }
    }
    return result
}

#program_export
KssCSSValueFromText :: (source: string) -> KssCSSValue {
    result: KssCSSValue
    result.valid = true
    start: s32 = 0
    end: s32 = (cast(s32)source.count)
    while start < end && KssIsSpace(source[start]) {
        start = start + 1
    }
    while end > start && KssIsSpace(source[end - 1]) {
        end = end - 1
    }
    result.text = source[start:end]
    c: KssCursor
    c.source = result.text
    scalar: KssScalarResult = KssReadScalar(c)
    if scalar.ok {
        c = scalar.parser
        if KssPeek(c, 0) == 112 && KssPeek(c, 1) == 120 {
            c = KssAdvance(c, 2)
        }
        c = KssSkipSpace(c)
        if KssAtEnd(c) {
            result.kind = cast(s32)KssCSSNumber
            result.number = scalar.value
        }
    }
    return result
}

#program_export
KssResolveCSSValue :: (p: KssParser, property: string, source: string) -> KssCSSValue {
    result: KssCSSValue = KssCSSValueFromText(source)
    property_kind: s32 = KssCSSPropertyKind(KssMakeName(property))
    if property_kind == -1 {
        result.valid = false
        return result
    }
    if result.kind == cast(s32)KssCSSNumber || property_kind == -2 {
        return result
    }
    c: KssCursor
    c.source = result.text
    reference: KssNameResult = KssReadName(c)
    c = KssSkipSpace(reference.parser)
    if !reference.ok || !KssAtEnd(c) {
        return result
    }
    index: s32 = -1
    if property_kind == cast(s32)KssTokenLength {
        index = KssFindNumberToken(p, reference.name)
    } else {
        index = KssFindToken(p, reference.name, property_kind)
    }
    if index < 0 {
        return result
    }
    result.has_token = true
    result.token_name = p.tokens[index].name
    result.token_origin = p.tokens[index].origin
    if property_kind == cast(s32)KssTokenColor {
        result.kind = cast(s32)KssCSSColor
        result.color = p.tokens[index].color
    } else if property_kind == cast(s32)KssTokenMaterial {
        result.kind = cast(s32)KssCSSMaterial
        result.material = p.tokens[index].material
    } else {
        result.kind = cast(s32)KssCSSNumber
        result.number = cast(float64)p.tokens[index].number
    }
    return result
}

#program_export
KssOverrideCSSValue :: (value: KssCSSValue, replacement: string, provided: bool) -> KssCSSValue {
    if !provided || !value.has_token || value.kind != cast(s32)KssCSSColor {
        return value
    }
    parsed: KssCSSValue = KssCSSValueFromText(replacement)
    value.kind = parsed.kind
    value.number = parsed.number
    value.text = parsed.text
    return value
}
