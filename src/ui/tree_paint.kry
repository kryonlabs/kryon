#module "tree_paint"
#import "ui_internal.h"
#import "ui/tree_layout.h"
#import "ui/text.h"
#import "ui/tree_disabled.h"
#import "ui/clip.h"
#import "ui_blend_internal.h"
#import "ui_popup_input_internal.h"
#import "runtime/input.h"
#import "runtime/drag.h"
#import "runtime/text_input.h"

TreePaintPrimitive :: (node: *TreeNode) {
    if node->kind == WidgetKindBackground {
        DrawRectangleRec(node->bounds,
        node->data.primitive.color)
    } else if node->kind == WidgetKindText {
        if node->data.primitive.heading_level > 0 {
            label: const char* = node->owned_text
            if label == nil { label = "" }
            ui_page_semantic_next(SemanticHeading, label,
            nil, nil, node->data.primitive.heading_level, -1)
        }
        label: const char* = node->owned_text
        if label == nil { label = "" }
        ui_paint_text_box_decorated(label, node->bounds,
        node->data.primitive.font,
        node->data.primitive.color,
        node->data.primitive.wrap,
        node->data.primitive.align,
        node->data.primitive.vertical_align,
        node->data.primitive.font_token,
        node->data.primitive.letter_spacing,
        node->data.primitive.strikethrough)
    } else if node->kind == WidgetKindBox {
        if node->data.primitive.styled {
            ui_paint_surface(node->bounds,
            node->data.primitive.style)
        } else {
            DrawRectangleRec(node->bounds,
            node->data.primitive.color)
            if node->data.primitive.border.a != 0 {
                DrawRectangleLinesEx(node->bounds, 1.0f,
                node->data.primitive.border)
            }
        }
    } else if node->kind == WidgetKindCircle {
        DrawCircle((int)(node->bounds.x +
        node->bounds.width / 2.0f),
        (int)(node->bounds.y + node->bounds.height / 2.0f),
        node->bounds.width / 2.0f,
        node->data.primitive.color)
    } else if node->kind == WidgetKindRing {
        center: Vector2 = (Vector2){node->bounds.x +
            node->bounds.width / 2.0f,
            node->bounds.y + node->bounds.height / 2.0f}
        DrawRing(center, (float)node->data.primitive.x1,
        node->bounds.width / 2.0f,
        0.0f, 360.0f, 0, node->data.primitive.color)
    } else if node->kind == WidgetKindLine {
        DrawLine(node->data.primitive.x1,
        node->data.primitive.y1, node->data.primitive.x2,
        node->data.primitive.y2,
        node->data.primitive.color)
    } else if node->kind == WidgetKindTriangle {
        a: Vector2 = (Vector2){(float)node->data.primitive.x1,
            (float)node->data.primitive.y1}
        b: Vector2 = (Vector2){(float)node->data.primitive.x2,
            (float)node->data.primitive.y2}
        c: Vector2 = (Vector2){(float)node->data.primitive.x3,
            (float)node->data.primitive.y3}
        DrawTriangle(a, b, c, node->data.primitive.color)
    }
}

TreePaintNumeric :: (node: *TreeNode) {
    if node->kind == WidgetKindDrag {
        drag: DragProps = node->data.drag.props
        drag.bounds = node->bounds
        drag.label = node->owned_text
        drag.format = nil
        if node->owned_text != nil {
            drag.format = node->owned_text +
            node->data.drag.format_offset
        }
        if InputKindIsInt(drag.kind) {
            value: DragDiscreteProps = (DragDiscreteProps){0}
            value.bounds = drag.bounds
            value.id = drag.id
            value.class_name = drag.class_name
            value.label = drag.label
            value.values = drag.int_values
            value.value_count = drag.value_count
            value.speed = drag.speed
            value.min = (int)drag.min
            value.max = (int)drag.max
            value.format = drag.format
            value.disabled = drag.disabled
            ui_paint_drag_discrete(value)
        } else {
            value: DragContinuousProps = (DragContinuousProps){0}
            value.bounds = drag.bounds
            value.id = drag.id
            value.class_name = drag.class_name
            value.label = drag.label
            value.values = drag.float_values
            value.value_count = drag.value_count
            value.speed = drag.speed
            value.min = (float)drag.min
            value.max = (float)drag.max
            value.format = drag.format
            value.disabled = drag.disabled
            ui_paint_drag_continuous(value)
        }
    } else if node->kind == WidgetKindSlider {
        slider: SliderProps = node->data.slider.props
        slider.bounds = node->bounds
        slider.label = node->owned_text
        slider.format = nil
        if node->owned_text != nil {
            slider.format = node->owned_text +
            node->data.slider.format_offset
        }
        slider.value_format = nil
        if slider.format != nil {
            slider.value_format = slider.format +
            strlen(slider.format) + 1
            if slider.value_format[0] == '\0' {
                slider.value_format = nil
            }
        }
        ui_paint_slider(slider)
    }
}

TreePaintButton :: (node: *TreeNode, index: i32) {
    spec: ButtonSpec = node->data.button
    spec.props.bounds = node->bounds
    spec.props.label = node->owned_text
    if spec.props.label == nil || node->first_child >= 0 {
        spec.props.label = ""
    }
    hovered: i32 = (node->flags & TreeNodeFlagHovered) != 0
    pressed: i32 = (node->flags & TreeNodeFlagPressed) != 0
    foreground: Color = ui_paint_button(spec, hovered, pressed)
    ui_tree_inherit_foreground(index, foreground,
    node->data.button.props.disabled)
}

TreePaintTextArea :: (node: *TreeNode) {
    state: *TextFieldState = (TextFieldState*)node->state
    area: TextAreaProps = node->data.text_area
    cursor: i32 = 0
    anchor: i32 = 0
    if state != nil {
        cursor = state->cursor
        anchor = state->anchor
    }
    range: TextSelectionRange = TextSelectionRangeFor(anchor, cursor)
    previous_font: i32 = ui_active_font_token()
    composition: TextCompositionView = (TextCompositionView){0}
    preedit: const char* = nil
    preedit_cursor: i32 = 0
    preedit_selection_length: i32 = 0
    composing: i32 = 0
    if state != nil {
        composing = ui_text_composition_get(state, &preedit,
        &preedit_cursor, &preedit_selection_length)
    }
    area.bounds = node->bounds
    PopTextFont(node->font_token)
    if composing && ui_text_composition_view(area.text,
    range.start, range.end, preedit, preedit_cursor,
    preedit_selection_length, &composition) {
        area.text = composition.text
        area.content_version = 0
        ui_paint_text_area_composition(area,
        composition.cursor, state->focused,
        composition.selection_start, composition.selection_end,
        composition.composition_start, composition.composition_end)
        ui_text_composition_view_free(&composition)
    } else {
        focused: i32 = 0
        if state != nil { focused = state->focused }
        ui_paint_text_area(area, cursor, focused,
        range.start, range.end)
    }
    PopTextFont(previous_font)
}

TreePaintTextField :: (node: *TreeNode) {
    field: TextFieldProps = node->data.text_field
    state: *TextFieldState = (TextFieldState*)node->state
    display: const char* = field.text
    if display == nil { display = "" }
    cursor: i32 = 0
    if state != nil { cursor = state->cursor }
    anchor: i32 = cursor
    if state != nil { anchor = state->anchor }
    range: TextSelectionRange = TextSelectionRangeFor(anchor, cursor)
    selection_start: i32 = range.start
    selection_end: i32 = range.end
    composition_start: i32 = 0
    composition_end: i32 = 0
    composition: TextCompositionView = (TextCompositionView){0}
    preedit: const char* = nil
    preedit_cursor: i32 = 0
    preedit_selection_length: i32 = 0
    if state != nil && !field.secure &&
    ui_text_composition_get(state, &preedit, &preedit_cursor,
    &preedit_selection_length) &&
    ui_text_composition_view(display, selection_start,
    selection_end, preedit, preedit_cursor,
    preedit_selection_length, &composition) {
        display = composition.text
        cursor = composition.cursor
        selection_start = composition.selection_start
        selection_end = composition.selection_end
        composition_start = composition.composition_start
        composition_end = composition.composition_end
    }
    masked: *char = nil
    if field.secure {
        length: size_t = strlen(display)
        secure_mask: *char = (char*)malloc(length + 1)
        if secure_mask != nil {
            masked = secure_mask
            memset(secure_mask, '*', length)
            secure_mask[length] = '\0'
            display = secure_mask
        }
    }
    paint: TextInputPaint = (TextInputPaint){0}
    paint.cursor = cursor
    if state != nil { paint.focused = state->focused }
    paint.editable = !field.read_only
    paint.caret = state != nil && state->focused && !field.read_only
    paint.font = ui_text_input_default_font(StyleKindTextField(),
    field.class_name)
    paint.font_token = node->font_token
    paint.selection_start = selection_start
    paint.selection_end = selection_end
    paint.composition_start = composition_start
    paint.composition_end = composition_end
    ui_paint_text_input(node->bounds, display, paint)
    free(masked)
    ui_text_composition_view_free(&composition)
}

TreePaintToggle :: (node: *TreeNode) {
    value: *i32 = nil
    if node->kind == WidgetKindToggle {
        value = node->data.toggle.value
    } else {
        value = node->data.checkbox.value
    }
    changed: i32 = 0
    if node->kind == WidgetKindToggle {
        focused: i32 = IsFocusActive(node->id) &&
        !ui_popup_input_snapshot_keyboard_captures(
        ui_tree_input_snapshot(node))
        changed = ToggleSwitch((int)node->bounds.x,
        (int)node->bounds.y, (int)node->bounds.width,
        (int)node->bounds.height, value,
        node->data.toggle.class_name,
        node->data.toggle.off_label,
        node->data.toggle.on_label, focused)
    } else {
        changed = RenderCheckboxToggle((int)node->bounds.x,
        (int)node->bounds.y, node->data.checkbox.label, value)
        if IsFocusActive(node->id) &&
        !ui_popup_input_snapshot_keyboard_captures(
        ui_tree_input_snapshot(node)) && IsWindowReady() {
            RenderFocus(node->bounds)
        }
    }
    if changed && value != nil {
        event: Event = (Event){0}
        event.key = node->key
        event.kind = EVENT_VALUE_CHANGED
        event.timestamp = GetTime()
        event.data.value = *value
        ui_event_push(event)
    }
}

TreePaintContent :: (node: *TreeNode, index: i32) #export {
    if (node->flags & TreeNodeFlagTextInputPaint) != 0 {
        ui_paint_text_input(node->bounds, node->owned_text,
        ui_tree_load_text_input_paint(node))
    } else if node->kind == WidgetKindDrag ||
    node->kind == WidgetKindSlider {
        TreePaintNumeric(node)
    } else if node->kind == WidgetKindBackground ||
    node->kind == WidgetKindText ||
    node->kind == WidgetKindBox ||
    node->kind == WidgetKindCircle ||
    node->kind == WidgetKindRing ||
    node->kind == WidgetKindLine ||
    node->kind == WidgetKindTriangle {
        TreePaintPrimitive(node)
    } else if node->kind == WidgetKindButton ||
    node->kind == WidgetKindCard {
        TreePaintButton(node, index)
    } else if node->kind == WidgetKindTextArea {
        TreePaintTextArea(node)
    } else if node->kind == WidgetKindTextField {
        TreePaintTextField(node)
    } else if node->kind == WidgetKindToggle ||
    node->kind == WidgetKindCheckbox {
        TreePaintToggle(node)
    }
}

DrawTree :: () #export {
    if (ui_tree_invalid & INVALIDATE_PAINT) == 0 { return }
    window_ready: i32 = IsWindowReady()
    ui_tree_invalid &= ~INVALIDATE_PAINT
    index: i32 = 0
    while index < ui_committed_node_count {
        node: *TreeNode = &ui_committed_nodes[index]
        index += 1
        if (node->flags & TreeNodeFlagPaintedImmediate) != 0 {
            continue
        }
        if !window_ready && node->kind != WidgetKindSlider &&
        node->kind != WidgetKindDrag &&
        node->kind != WidgetKindToggle &&
        node->kind != WidgetKindCheckbox { continue }
        parent_clip: ClipState = (ClipState){0}
        parent_blend: BlendState = (BlendState){0}
        captured: bool = window_ready && node->paint_capture != 0
        if captured {
            capture: *PaintCapture = &ui_tree_paint_captures[
            node->paint_capture - 1]
            parent_clip = ui_clip_save()
            parent_blend = ui_blend_save()
            BeginTextureMode(capture->target)
            ui_blend_restore(capture->blend)
            rlSetMatrixProjection(capture->projection)
            rlSetMatrixModelview(capture->modelview)
            ResetClip()
            if capture->has_clip {
                BeginClip((int)capture->clip.x,
                (int)capture->clip.y,
                (int)capture->clip.width,
                (int)capture->clip.height)
            }
        }
        if node->has_input_clip {
            PushInputClip(node->input_clip)
            if window_ready {
                BeginClip((int)node->input_clip.x,
                (int)node->input_clip.y,
                (int)node->input_clip.width,
                (int)node->input_clip.height)
            }
        }
        TreePaintWithDisabled(node, index - 1,
        (node->flags & TreeNodeFlagScopeDisabled) != 0)
        if node->has_input_clip {
            if window_ready { EndClip() }
            PopInputClip()
        }
        if captured {
            EndTextureMode()
            ui_blend_restore(parent_blend)
            ui_clip_restore(parent_clip)
        }
    }
}
