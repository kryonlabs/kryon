#module "link_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/link.h"

RenderLink :: (link: LinkProps) -> i32 #export {
    editor_id: [96]char
    text: const char* = link.text
    if text == nil { text = "" }
    bounds: Rectangle = link.bounds
    style_props: ButtonProps = (ButtonProps){0}
    style_props.class_name = link.class_name
    style_props.emphasis = ButtonEmphasisLink
    style_props.size = ControlSizeMedium
    style_props.disabled = link.disabled
    state: ButtonState = ButtonStateNormal
    if link.disabled != 0 { state = ButtonStateDisabled }
    style_frame: StyleFrame = ui_control_style_frame_kind(
    style_props, state, 0, 0.0, 0.0, 0.0, StyleKindLink())
    font: i32 = ResolveFont(0,
    StyleFontValue(style_frame.value.fields,
    style_frame.value.font_size), GetFontSize())
    text_width: i32 = TextWidth(text, font)
    bounds = LinkBoundsFor(bounds, text_width,
    TextHeight(text, font), font)

    widget: Widget = BeginWidget("Link",
    ui_inspect_control_id(&editor_id[0], 96, "Link",
    link.focus_id, text), bounds,
    WidgetFlagMovable | WidgetFlagResizable)
    bounds = widget.bounds
    mouse_world: Vector2 = ui_mouse_world()
    interaction: LinkInteraction = LinkInteractionFor(
    link.disabled != 0, InputCapturesClick(mouse_world) != 0,
    CheckCollisionPointRec(mouse_world, bounds) != 0,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    ReleaseConsumed() != 0,
    press_started_inside(bounds) != 0)
    focused: i32 = !link.disabled && link.focus_id > 0 &&
    RegisterFocus(link.focus_id, bounds)
    style_frame = ui_control_style_frame_kind(style_props,
    interaction.state, 0, 0.0, 0.0, 0.0, StyleKindLink())
    appearance: LinkAppearance = ResolveLinkAppearance(style_frame,
    interaction.hovered, link.disabled != 0)
    color: Color = Fade(GetColor(appearance.color),
    style_frame.value.opacity)
    clicked: i32 = 0
    if interaction.active {
        MarkClickable()
        clicked = interaction.activated
    } else if interaction.disabled_marker {
        MarkDisabled()
    }

    RenderText(text, (int)bounds.x,
    ControlTextBaselineY(text, (int)bounds.y,
    (int)bounds.height, font), font, color)
    if appearance.underline && text_width > 0 {
        underline_y: i32 = LinkUnderlineYFor(bounds,
        (float)Scale(1000) / 1000.0)
        DrawLine((int)bounds.x, underline_y,
        (int)bounds.x + text_width, underline_y, color)
    }
    if focused != 0 {
        SetFocusTextInputActive(0)
        RenderFocus(bounds)
    }
    if interaction.consume_release { ConsumeRelease() }
    activated: i32 = LinkActivated(link.disabled != 0,
    clicked != 0, IsFocusActivatePressed(link.focus_id) != 0)
    if activated != 0 { ui_open_url(link.link) }
    EndWidget(&widget)
    return activated
}
