using SvgIcon :: #import "svg_icon_props";
// A vector icon on its own, such as a symbol beside a name or a coin beside
// an amount, in a color of the caller's. It takes no input; an icon that
// does something is a Button with an icon_shape. Portable compositions
// submit it to their host like the other widgets.
#if #defined(KRYON_HOSTED_UI) {
    #import "session"
    host_api :: #system_library "host_api";
    SvgIconHostedHost :: (session: Session, props: SvgIcon.Props) #foreign host_api;
        Draw :: (session: Session, props: SvgIcon.Props) { SvgIconHostedHost(session, props) }
} else {
    #import "session"
    #import "svg_icon_behavior"

        Draw :: (session: Session, props: SvgIcon.Props) {
        PaintSvgIcon(session, -1, props.shape, props.bounds, props.color)
    }
}
