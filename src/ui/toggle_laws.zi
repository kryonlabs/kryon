#import "toggle"

// Laws for toggle switches. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A toggle flips only when activated while enabled and holding a value,
// and reports exactly that change.
#law FlipRule forall value: 0..1, activated: 0..1, enabled: 0..1, has_value: 0..1 => ToggleValueFor(B(value), B(activated), B(enabled), B(has_value)).value == (B(value) != (B(activated) && B(enabled) && B(has_value))) && ToggleValueFor(B(value), B(activated), B(enabled), B(has_value)).changed == (B(activated) && B(enabled) && B(has_value));
