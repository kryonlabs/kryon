host_api :: #system_library "host_api";

// The host owns the app's window. An app that keeps working in the
// background (for example behind a tray icon) hides the window instead of
// quitting, and the host keeps calling its Frame without presenting it.
WindowSetVisibleHost :: (visible: bool) #foreign host_api;
WindowVisibleHost :: () -> bool #foreign host_api;
WindowFocusedHost :: () -> bool #foreign host_api;
WindowInterceptCloseHost :: (enabled: bool) -> bool #foreign host_api;
WindowTakeCloseRequestHost :: () -> bool #foreign host_api;
WindowQuitHost :: () #foreign host_api;
WindowBackgroundDragHost :: (active: bool) #foreign host_api;
#program_export
WindowBackgroundDrag :: (active: bool) { WindowBackgroundDragHost(active) }
WindowCompactHost :: () -> bool #foreign host_api;
WindowBackgroundHost :: (width: s32, height: s32, dx: s32, dy: s32) #foreign host_api;

// A supporting app host keeps this app's own window visible in a smaller
// background pane. Zero dimensions withdraw the request. Movement is relative
// to the default bottom-right position; the host clamps it to its viewport.
#program_export
WindowBackground :: (width: s32, height: s32, dx: s32, dy: s32) {
    WindowBackgroundHost(width, height, dx, dy)
}
#program_export
WindowCompact :: () -> bool { return WindowCompactHost() }

#program_export
WindowShow :: () {
    WindowSetVisibleHost(true)
}

#program_export
WindowHide :: () {
    WindowSetVisibleHost(false)
}

#program_export
WindowVisible :: () -> bool {
    return WindowVisibleHost()
}

// Reports keyboard focus for this application's own visible window. Hosts
// without a focus signal return false; an embedding host supplies its child's
// focus rather than treating the supervising window as the active child.
#program_export
WindowFocused :: () -> bool { return WindowFocusedHost() }

// With interception on, closing the window no longer quits: it is reported
// once through WindowTakeCloseRequest and the app decides. Returns false when
// the host cannot intercept closing, in which case closing still quits.
#program_export
WindowInterceptClose :: (enabled: bool) -> bool {
    return WindowInterceptCloseHost(enabled)
}

#program_export
WindowTakeCloseRequest :: () -> bool {
    return WindowTakeCloseRequestHost()
}

// Ends the host loop after the current frame.
#program_export
WindowQuit :: () {
    WindowQuitHost()
}
