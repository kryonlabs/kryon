#module "example_pictures"
#import "kryon.h"
#import "kryon_example_font.h"

app "Kryon Pictures" {
    size 640 420
    fps 60
    font examples
}

App :: () #ui {
    Screen root: {
        Background(GetThemeBackground())
        Text("Pictures are image nodes", ScaleUIPx(32), ScaleUIPx(30),
                   Text24, GetThemeText())
        Stack picture_card: {
            bounds = {ScaleUIPx(32), ScaleUIPx(82), ScaleUIPx(260), ScaleUIPx(210)}
            key = Key("picture-card")
            Rect(ScaleUIPx(32), ScaleUIPx(82), ScaleUIPx(260), ScaleUIPx(210),
                       GetThemeSurface(), GetThemeButton())
            Picture((PictureProps){.asset_path = "tiles/tile.png",
                     .bounds = {ScaleUIPx(52), ScaleUIPx(104), ScaleUIPx(96), ScaleUIPx(96)},
                     .source = {0, 0, 0, 0}, .origin = {0, 0}, .rotation = 0.0f,
                     .tint = WHITE, .fit = PICTURE_FIT_CONTAIN})
            Picture((PictureProps){.asset_path = "pfp/lotus.png",
                     .bounds = {ScaleUIPx(168), ScaleUIPx(104), ScaleUIPx(96), ScaleUIPx(96)},
                     .source = {0, 0, 0, 0}, .origin = {0, 0}, .rotation = 0.0f,
                     .tint = WHITE, .fit = PICTURE_FIT_CONTAIN})
            Text("Pictures keep their node bounds for editing",
                       ScaleUIPx(52), ScaleUIPx(226), Text12, GetThemeIcon())
        }
    }
}
