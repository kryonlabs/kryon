#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"

using StyleField;

ListBoxMultiNavResult :: struct {
    clicked: s32
    anchor: s32
    anchor_changed: bool
    control: bool
    shift: bool
    range_anchor: s32
}

ListBoxMultiInput :: struct {
    home: bool
    end: bool
    up: bool
    down: bool
    space: bool
    enter: bool
}

ListBoxMultiRowDecision :: struct {
    activate: bool
    consume_release: bool
}

ListBoxMultiMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if (fields & field) == cast(u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
ListBoxMultiRowHeight :: (row_height: s32, scale: float32,
    item: StyleFrame) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    if row_height > 0 { return row_height }
    fallback: float32 = 28.0
    if (item.value.fields & cast(u32)StyleIconSize) != cast(u32)0 &&
       item.value.icon_size > 0.0 {
        fallback = item.value.icon_size
    }
    return ListBoxMultiMetric(item.value.fields, cast(u32)StyleContentOffset,
        item.value.offset_y, fallback, scale, false)
}

#program_export
ListBoxMultiRowBounds :: (bounds: Rectangle, index: s32, row_height: s32) -> Rectangle {
    row: Rectangle
    row.x = bounds.x
    row.y = bounds.y + cast(float32)(index * row_height)
    row.width = bounds.width
    row.height = cast(float32)row_height
    return row
}

#program_export
ListBoxMultiItemLabelInset :: (scale: float32, item: StyleFrame) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return ListBoxMultiMetric(item.value.fields, cast(u32)StylePaddingX,
        item.value.padding_x, 8.0, scale, true)
}

#program_export
ListBoxMultiFocusedRow :: (anchor: s32, selected_first: s32, item_count: s32) -> s32 {
    if item_count <= 0 { return -1 }
    if anchor >= 0 && anchor < item_count { return anchor }
    if selected_first >= 0 && selected_first < item_count { return selected_first }
    return 0
}

#program_export
ListBoxMultiInputFor :: (home: bool, end: bool, up: bool, down: bool,
    space: bool, enter: bool) -> ListBoxMultiInput {
    input: ListBoxMultiInput
    input.home = home
    input.end = end
    input.up = up
    input.down = down
    input.space = space
    input.enter = enter
    return input
}

#program_export
ListBoxMultiRowDecisionFor :: (hot: bool, disabled: bool,
    released: bool) -> ListBoxMultiRowDecision {
    decision: ListBoxMultiRowDecision
    if hot && !disabled && released {
        decision.activate = true
        decision.consume_release = true
    }
    return decision
}

#program_export
ListBoxMultiNavigate :: (item_count: s32, cursor: s32, control: bool,
    shift: bool, input: ListBoxMultiInput) -> ListBoxMultiNavResult {
    result: ListBoxMultiNavResult
    result.clicked = -1
    result.anchor = cursor
    result.anchor_changed = false
    result.control = control
    result.shift = shift
    result.range_anchor = -1
    if item_count <= 0 { return result }
    if cursor < 0 { cursor = 0 }
    if cursor >= item_count { cursor = item_count - 1 }
    next: s32 = cursor
    navigate: bool = true
    if input.home {
        next = 0
    } else if input.end {
        next = item_count - 1
    } else if input.up {
        if next > 0 { next = next - 1 }
    } else if input.down {
        if next + 1 < item_count { next = next + 1 }
    } else if input.space {
        result.clicked = cursor
        result.control = true
        result.shift = false
        navigate = false
    } else if input.enter {
        result.clicked = cursor
        result.control = false
        result.shift = false
        navigate = false
    } else {
        navigate = false
    }
    if navigate {
        if shift {
            result.range_anchor = cursor
            result.control = true
        }
        result.anchor = next
        result.anchor_changed = true
        if !result.control || shift { result.clicked = next }
    }
    return result
}

#program_export
ListBoxMultiActionAnchor :: (current_anchor: s32, range_anchor: s32) -> s32 {
    if range_anchor >= 0 { return range_anchor }
    return current_anchor
}

#program_export
ListBoxMultiSelectionForRow :: (row: s32, was_selected: bool, clicked: s32,
    item_count: s32, current_anchor: s32, control: bool, shift: bool,
    range_anchor: s32) -> bool {
    if clicked < 0 || clicked >= item_count { return was_selected }
    anchor: s32 = ListBoxMultiActionAnchor(current_anchor, range_anchor)
    if shift && anchor >= 0 && anchor < item_count {
        first: s32 = anchor
        last: s32 = clicked
        if first > last {
            temp: s32 = first
            first = last
            last = temp
        }
        if row >= first && row <= last { return true }
        if control { return was_selected }
        return false
    }
    if control {
        if row == clicked { return !was_selected }
        return was_selected
    }
    return row == clicked
}

#program_export
ListBoxMultiAnchorAfterClick :: (current_anchor: s32, clicked: s32,
    item_count: s32, control: bool, shift: bool, range_anchor: s32) -> s32 {
    anchor: s32 = ListBoxMultiActionAnchor(current_anchor, range_anchor)
    if clicked < 0 || clicked >= item_count { return current_anchor }
    if shift && anchor >= 0 && anchor < item_count { return current_anchor }
    if control || !shift { return clicked }
    return current_anchor
}
