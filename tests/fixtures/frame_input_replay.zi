#import "frame_input"
#import "frame_capture"
#import "geometry"
#import "session"
#import "tree"
#import "tree_draw"
#import "text_field_widget"
#import "text_input"
#import "text_input_props"
#import "widget_kind"

using WidgetKind;
host_api :: #system_library "host_api";
PollFrameInput :: () -> FrameInput #foreign host_api;

session: Session;
value: [256]u8;
length: s32;
cursor: s32;
anchor: s32;
ime_active: bool;
ime_cursor: s32;
ime_selection: s32;
ime_bytes: [256]u8;
ime_length: s32;

RememberComposition :: (state: CompositionState) {
    ime_active = state.active; ime_cursor = state.cursor; ime_selection = state.selection_length
    ime_length = cast(s32)state.text.count
    for byte: 0..ime_length - 1 { ime_bytes[byte] = state.text[byte] }
}

Editor :: (input: FrameInput) -> TextFieldResult {
    props: TextFieldProps
    props.key = 20; props.focus_id = 20; props.focused = true
    props.bounds = .{20.0, 20.0, input.width - 40.0, 36.0}
    props.value = TextView(value[:length]); props.label = "Replay editor"
    props.cursor = cursor; props.anchor = anchor; props.composition.active = ime_active; props.composition.cursor = ime_cursor
    props.composition.selection_length = ime_selection; props.composition.text = TextView(ime_bytes[:ime_length])
    props.input = FrameInputField(input)
    return TextField(session, props)
}

ApplyEdit :: (edit: TextFieldEdit) -> bool {
    if !edit.changed { return true }
    next: s32 = length - (edit.end - edit.start) + cast(s32)edit.replacement.count
    if edit.start < 0 || edit.end < edit.start || edit.end > length || next > 256 { return false }
    output: [256]u8
    at: s32 = 0
    for i: 0..edit.start - 1 { output[at] = value[i]; at += 1 }
    for i: 0..cast(s32)edit.replacement.count - 1 { output[at] = edit.replacement[i]; at += 1 }
    for i: edit.end..length - 1 { output[at] = value[i]; at += 1 }
    for i: 0..next - 1 { value[i] = output[i] }
    length = next
    return true
}

#program_export
Frame :: () -> s32 {
    if !SessionValid(session) {
        session = SessionOpen(); value[0] = 65; length = 1; cursor = 1; anchor = 1
    }
    input: FrameInput = PollFrameInput()
    if !FrameInputApply(session, input) { return -1 }
    BeginFrame(session, 1, .{0.0, 0.0, input.width, input.height})
    result: TextFieldResult = Editor(input)
    cursor = result.cursor; anchor = result.anchor; RememberComposition(result.composition)
    if input.width == 13.0 {
        TreeSubmitCurrent(session, 99, WidgetKindButton, .{})
        TreeSubmitCurrent(session, 99, WidgetKindButton, .{})
    }
    if !EndFrameCapture(session) { return -1 }
    if !ApplyEdit(result.edit) { return -2 }
    return length
}
