// Read the palette supplied by a supervising parent, or the desktop palette
// for a standalone window. This reads properties and sends no window actions.
Theme :: #import "system_theme_linux";
using Palette :: #import "system_theme";
#scope_file
palette: SystemPalette;
ready: bool;
// Refresh the desktop or containing host palette at the frame boundary.
Refresh :: () {
    palette = Theme.SystemPaletteRead()
    ready = true
}
#scope_export
#program_export
SystemThemeColorHost :: (role: s32) -> u32 {
    if role==0 || !ready { Refresh() }
    return SystemPaletteHostColor(palette, role)
}
SystemPaletteRead :: () -> SystemPalette { Refresh(); return palette }
// Applies the current palette, the host's while embedded, as style rules and
// theme colours the first time and again whenever it changes; true when it
// applied. Called once per frame, it makes an embedded app follow its host.
SystemPaletteFollow :: () -> bool { return SystemPaletteUpdate(SystemPaletteRead()) }
