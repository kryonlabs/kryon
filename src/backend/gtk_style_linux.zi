ObjectSet :: (object: *void, name: *u8, args: ..any) #foreign gobject "g_object_set";
NotifyCallback :: #type (*void, *void, *void) -> void #c_call;
WeakCallback :: #type (*void, *void) -> void #c_call;
SignalConnect :: (object: *void, signal: *u8, callback: *void, data: *void, destroy: *void, flags: s32) -> usize #foreign gobject "g_signal_connect_data";
SignalDisconnect :: (object: *void, id: usize) #foreign gobject "g_signal_handler_disconnect";
WeakRef :: (object: *void, callback: *void, data: *void) #foreign gobject "g_object_weak_ref";
WeakUnref :: (object: *void, callback: *void, data: *void) #foreign gobject "g_object_weak_unref";
watched_settings: *void;
settings_signal: usize;
watched_icon_theme: *void;
icon_theme_signal: usize;
IconChangedCallback :: #type (*void, *void) -> void #c_call;
IconThemeChanged :: (object: *void, data: *void) { Changed() }
IconThemeFinalized :: (data: *void, object: *void) {
    watched_icon_theme = null; icon_theme_signal = 0
    Changed()
}
WatchIconTheme :: () {
    object := IconTheme()
    if object == watched_icon_theme { return }
    weak: WeakCallback = IconThemeFinalized
    weak_raw: **void = cast(**void)*weak
    if watched_icon_theme != null {
        Changed()
        if icon_theme_signal != 0 { SignalDisconnect(watched_icon_theme, icon_theme_signal) }
        WeakUnref(watched_icon_theme, weak_raw[0], null)
    }
    watched_icon_theme = object; icon_theme_signal = 0
    if object == null { return }
    callback: IconChangedCallback = IconThemeChanged
    raw: **void = cast(**void)*callback
    key: [8]u8
    unused CString.CopyCString("changed", key[:])
    icon_theme_signal = SignalConnect(object, *key[0], raw[0], null, null, 0)
    WeakRef(object, weak_raw[0], null)
}
SettingsNotify :: (object: *void, property: *void, data: *void) { Changed() }
SettingsFinalized :: (data: *void, object: *void) {
    watched_settings = null; settings_signal = 0
    Changed()
}
WatchSettings :: () {
    object := Settings()
    if object == watched_settings { return }
    weak: WeakCallback = SettingsFinalized
    weak_raw: **void = cast(**void)*weak
    if watched_settings != null {
        // A default-display change can select already initialized settings,
        // without delivering any property notification or GLib event.
        Changed()
        if settings_signal != 0 { SignalDisconnect(watched_settings, settings_signal) }
        WeakUnref(watched_settings, weak_raw[0], null)
    }
    watched_settings = object; settings_signal = 0
    if object == null { return }
    notify: NotifyCallback = SettingsNotify
    notify_raw: **void = cast(**void)*notify
    key: [8]u8
    unused CString.CopyCString("notify", key[:])
    settings_signal = SignalConnect(object, *key[0], notify_raw[0], null, null, 0)
    // Neither connection holds a settings ref. Finalization clears the borrow.
    WeakRef(object, weak_raw[0], null)
}
Ready :: () -> bool {
    if Init(null, null) == 0 || Screen() == null { return false }
    WatchSettings()
    WatchIconTheme()
    return true
}
ProviderSlot :: struct { id: u64; object: *void; screen: *void; priority: u32 }
PreferenceSlot :: struct { id: u64; value: bool }
providers: [64]ProviderSlot;
preferences: [64]PreferenceSlot;
next_provider: u64 = 1;
next_preference: u64 = 1;
settings_object: *void;
settings_original: bool;
style_generation: u64 = 1;
style_pending: bool;
Changed :: () { style_generation += 1; style_pending = true }
ProviderIndex :: (handle: u64) -> s32 {
    if handle == 0 { return -1 }
    for i: 0..63 { if providers[i].id == handle { return cast(s32)i } }
    return -1
}
ParseProvider :: (css: string) -> *void {
    // Allocate before touching GTK, so invalid input/allocation failure is atomic.
    descriptor := cast(*Text.TextDescriptor)(*css)
    if css.count < 0 || css.count > 1048576 || (css.count > 0 && descriptor.data == null) { return null }
    for c: css { if c == 0 { return null } }
    bytes := Allocate(cast(usize)css.count + 1, 1)
    if bytes == null { return null }
    defer Free(bytes)
    for i: 0..css.count - 1 { bytes[i] = css[i] }
    if !Ready() { return null }
    object := ProviderNew()
    if object == null { return null }
    error: *void
    loaded := ProviderLoad(object, bytes, cast(isize)css.count, *error)
    if error != null { ErrorFree(error) }
    if loaded == 0 || error != null { Unref(object); return null }
    return object
}
DarkValue :: () -> bool {
    value: s32
    key: [40]u8
    unused CString.CopyCString("gtk-application-prefer-dark-theme", key[:])
    ObjectGet(settings_object, *key[0], *value, cast(*u8)null)
    return value != 0
}
ApplyDark :: (value: bool) {
    if DarkValue() == value { return }
    key: [40]u8
    unused CString.CopyCString("gtk-application-prefer-dark-theme", key[:])
    generation := style_generation
    ObjectSet(settings_object, *key[0], cast(s32)value, cast(*u8)null)
    if style_generation == generation { Changed() }
}

ValidText :: (value: string) -> bool {
    if value.count > 255 { return false }
    for byte: value { if byte == cast(u8)0 { return false } }
    return true
}

AppendPathNode :: (path: *void, kind: usize, node: GtkStyleNode) -> s32 {
    at:=PathAppend(path,kind)
    bytes: [256]u8
    if node.element!="" { unused CString.CopyCString(node.element,bytes[:]); PathElement(path,at,*bytes[0]) }
    if node.name!="" { unused CString.CopyCString(node.name,bytes[:]); PathName(path,at,*bytes[0]) }
    for name: node.classes { unused CString.CopyCString(name,bytes[:]); PathClass(path,at,*bytes[0]) }
    PathState(path,at,node.state)
    return at
}

MakeContext :: (nodes: []GtkStyleNode, scale: s32) -> *void {
    if nodes.count < 1 || nodes.count > 32 || scale < 1 || scale > 4 { return null }
    for node: nodes {
        if node.widget_type == "" || !ValidText(node.widget_type) ||
            !ValidText(node.element) || !ValidText(node.name) || node.classes.count < 0 || node.classes.count > 32 ||
            node.providers.count < 0 || node.providers.count > 32 ||
            node.sibling_count<0 || node.sibling_count>64 || node.sibling_index<0 ||
            (node.sibling_count==0 && node.sibling_index!=0) ||
            (node.sibling_count>0 && node.sibling_index>=node.sibling_count) ||
            (node.state & cast(u32)0xFFFFE000) != 0 { return null }
        for name: node.classes { if name == "" || !ValidText(name) { return null } }
        for attachment: node.providers { if ProviderIndex(attachment.provider) < 0 { return null } }
    }
    if !Ready() { return null }
    screen := Screen()
    if screen == null { return null }
    builder := BuilderNew()
    if builder == null { return null }
    defer Unref(builder)
    path := PathNew()
    if path == null { return null }
    defer PathUnref(path)
    parent: *void = null
    for node: nodes {
        bytes: [256]u8
        unused CString.CopyCString(node.widget_type, bytes[:])
        kind := TypeFromName(builder, *bytes[0])
        if kind == 0 || TypeIsA(kind, WidgetType()) == 0 {
            if parent != null { Unref(parent) }
            return null
        }
        if node.sibling_count>0 {
            siblings:=PathNew()
            if siblings==null { if parent!=null { Unref(parent) }; return null }
            for index: cast(s32)0..node.sibling_count-1 { unused AppendPathNode(siblings,kind,node) }
            unused PathSiblings(path,siblings,cast(u32)node.sibling_index)
            PathUnref(siblings)
        } else { unused AppendPathNode(path,kind,node) }
        context := ContextNew()
        if context == null {
            if parent != null { Unref(parent) }
            return null
        }
        ContextScreen(context, screen)
        ContextScale(context, scale)
        ContextPath(context, path)
        ContextState(context, node.state)
        for attachment: node.providers {
            ContextProvider(context, providers[ProviderIndex(attachment.provider)].object, attachment.priority)
        }
        if parent != null { ContextParent(context, parent); Unref(parent) }
        parent = context
    }
    return parent
}

Channel :: (value: float64) -> u32 {
    if value <= 0.0 { return 0 }
    if value >= 1.0 { return 255 }
    return cast(u32)(value * 255.0 + 0.5)
}
Pack :: (value: RGBA) -> u32 {
    return Channel(value.red) << cast(u32)24 | Channel(value.green) << cast(u32)16 |
        Channel(value.blue) << cast(u32)8 | Channel(value.alpha)
}
Insets :: (value: Border) -> GtkStyleInsets {
    return .{cast(s32)value.left, cast(s32)value.right, cast(s32)value.top, cast(s32)value.bottom}
}
Straight :: (value: u32, alpha: u32) -> u8 {
    if alpha == 0 { return 0 }
    channel := (value * cast(u32)255 + alpha / cast(u32)2) / alpha
    if channel > 255 { channel = 255 }
    return cast(u8)channel
}

SurfaceBitmap :: (surface: *void, w: s32, h: s32) -> GtkStyleBitmap {
    SurfaceFlush(surface)
    if SurfaceStatus(surface) != 0 { return .{} }
    pixels := SurfaceData(surface)
    stride_bytes:=SurfaceStride(surface)
    if pixels==null || stride_bytes<w*4 || stride_bytes%4!=0 ||
        cast(s64)stride_bytes*cast(s64)h>67108864 { return .{} }
    stride:=stride_bytes/4
    count := cast(u64)w * cast(u64)h
    data := Allocate(cast(usize)count,4)
    if data == null { return .{} }
    for y: 0..h - 1 {
        for x: 0..w - 1 {
            pixel := pixels[y * stride + x]
            alpha := pixel >> cast(u32)24
            at := (y * w + x) * 4
            data[at]=Straight((pixel >> cast(u32)16) & cast(u32)255,alpha)
            data[at+1]=Straight((pixel >> cast(u32)8) & cast(u32)255,alpha)
            data[at+2]=Straight(pixel & cast(u32)255,alpha)
            data[at+3]=cast(u8)alpha
        }
    }
    return .{w,h,Text.BytesFromPointer(data,count * cast(u64)4)}
}

ParsedMarkup :: struct { valid: bool; attributes: *void; data: *u8 }
ParsedFree :: (parsed: ParsedMarkup) {
    if parsed.attributes != null { AttributesFree(parsed.attributes) }
    if parsed.data != null { GLibFree(parsed.data) }
}
ParseMarkup :: (text: string) -> ParsedMarkup {
    if text.count > 65536 { return .{} }
    bytes := cast(*Text.TextDescriptor)(*text)
    empty: [1]u8
    data := bytes.data
    if text.count == 0 { data=*empty[0] }
    if ValidUTF8(data,cast(isize)text.count,null) == 0 { return .{} }
    parsed: ParsedMarkup
    if Parse(data,cast(s32)text.count,0,*parsed.attributes,*parsed.data,null,null) == 0 {
        ParsedFree(parsed)
        return .{}
    }
    parsed.valid=true
    return parsed
}

NativeFontDefaults :: (context: *void) {
    // An unresolved screen default inherits the native drawing backend, not an
    // image surface's defaults. Query an empty compatible pixmap; no window
    // pixels are read. GTK's resolved widget font options retain precedence.
    window:=RootWindow()
    if window==null { return }
    surface:=SimilarSurface(window,4096,1,1)
    if surface==null { return }
    defer SurfaceFree(surface)
    if SurfaceStatus(surface)!=0 { return }
    options:=FontOptionsNew()
    if options==null { return }
    defer FontOptionsFree(options)
    SurfaceFontOptions(surface,options)
    screen_options:=PangoFontOptions(context)
    if screen_options!=null { MergeFontOptions(options,screen_options) }
    if FontOptionsStatus(options)==0 { ContextFontOptions(context,options) }
}

MakeLayout :: (context: *void, state: u32, text: string, width: s32, align: s32, override: string, markup: bool) -> *void {
    if text.count > 65536 || width < 0 || width > 4096 || align < 0 || align > 2 || !ValidText(override) { return null }
    bytes := cast(*Text.TextDescriptor)(*text)
    if text.count > 0 && ValidUTF8(bytes.data,cast(isize)text.count,null) == 0 { return null }
    widget:=LabelNew(null)
    if widget==null { return null }
    unused RefSink(widget)
    pango_context := WidgetPangoContext(widget)
    Unref(widget)
    if pango_context == null { return null }
    defer Unref(pango_context)
    NativeFontDefaults(pango_context)
    layout := LayoutNew(pango_context)
    if layout == null { return null }
    font: *void = null
    if override == "" {
        key: [8]u8
        unused CString.CopyCString("font",key[:])
        Property(context,state,*key[0],*font,cast(*u8)null)
    } else {
        key: [256]u8
        unused CString.CopyCString(override,key[:])
        if ValidUTF8(*key[0],cast(isize)override.count,null) == 0 { Unref(layout); return null }
        font=FontParse(*key[0])
    }
    if font == null { Unref(layout); return null }
    LayoutFont(layout,font)
    FontFree(font)
    if markup {
        parsed := ParseMarkup(text)
        if !parsed.valid { Unref(layout); return null }
        defer ParsedFree(parsed)
        LayoutAttributes(layout,parsed.attributes)
        LayoutText(layout,parsed.data,-1)
    } else {
        empty: [1]u8
        data:=bytes.data
        if text.count == 0 { data=*empty[0] }
        LayoutText(layout,data,cast(s32)text.count)
    }
    LayoutWidth(layout,ifx width > 0 then width * 1024 else -1)
    LayoutAlign(layout,align)
    LayoutWrap(layout,2)
    return layout
}

#scope_export
// GLib's XDG user-directory identity; borrowed until process settings reload.
GtkUserDirectory :: (directory: s32) -> string {
    if directory<0 || directory>7 { return "" }
    return Text.TextFromCString(UserDirectory(directory))
}
// Decoded UTF-8 byte count, excluding NUL. Failure leaves output untouched.
// The parser performs no file, network or application actions.
GtkMarkupPlain :: (markup: string, output: []u8) -> s32 {
    if output.count < 1 { return -1 }
    parsed := ParseMarkup(markup)
    if !parsed.valid { return -1 }
    defer ParsedFree(parsed)
    plain := Text.TextFromCString(parsed.data)
    if plain.count > 65536 || !CString.CopyCString(plain,output) { return -1 }
    return cast(s32)plain.count
}

#scope_file
// Resolved style metrics are a pure function of the node path, scale and the
// current style generation, which every theme, setting, icon-theme and
// provider change advances. Frames repeat the same paths many times, so keep
// the resolved values instead of rebuilding GTK style contexts each time.
StyleQueryEntry :: struct { key: u64; generation: u64; scale: s32; metrics: GtkStyleMetrics }
style_queries: [512]StyleQueryEntry;
StyleKeyText :: (hash: u64, text: string) -> u64 {
    hash = (hash ^ cast(u64)text.count) * cast(u64)1099511628211
    for c: text { hash = (hash ^ cast(u64)c) * cast(u64)1099511628211 }
    return hash
}
StyleKeyValue :: (hash: u64, value: u64) -> u64 { return (hash ^ value) * cast(u64)1099511628211 }
StyleQueryKey :: (nodes: []GtkStyleNode, scale: s32) -> u64 {
    hash := StyleKeyValue(cast(u64)1469598103934665603, cast(u64)nodes.count)
    hash = StyleKeyValue(hash, cast(u64)scale)
    for node: nodes {
        hash = StyleKeyText(StyleKeyText(StyleKeyText(hash, node.widget_type), node.element), node.name)
        hash = StyleKeyValue(hash, cast(u64)node.state)
        hash = StyleKeyValue(StyleKeyValue(hash, cast(u64)node.sibling_count), cast(u64)node.sibling_index)
        hash = StyleKeyValue(hash, cast(u64)node.classes.count)
        for cls: node.classes { hash = StyleKeyText(hash, cls) }
        hash = StyleKeyValue(hash, cast(u64)node.providers.count)
        for provider: node.providers { hash = StyleKeyValue(StyleKeyValue(hash, provider.provider), cast(u64)provider.priority) }
    }
    return ifx hash == 0 then cast(u64)1 else hash
}
#scope_export

// Call on the GTK owning thread. All GTK contexts are temporary; no borrowed
// GTK strings or theme snapshots escape this query.
GtkStyleQuery :: (nodes: []GtkStyleNode, scale: s32) -> GtkStyleMetrics {
    key := StyleQueryKey(nodes, scale)
    entry := *style_queries[cast(s64)(key % cast(u64)512)]
    if entry.key == key && entry.generation == style_generation && entry.scale == scale && entry.metrics.available {
        return entry.metrics
    }
    result := StyleQueryResolve(nodes, scale)
    if result.available {
        entry.key = key; entry.generation = style_generation; entry.scale = scale; entry.metrics = result
    }
    return result
}

#scope_file
StyleQueryResolve :: (nodes: []GtkStyleNode, scale: s32) -> GtkStyleMetrics {
    result: GtkStyleMetrics
    context := MakeContext(nodes, scale)
    if context == null { return result }
    defer Unref(context)
    state := nodes[nodes.count - 1].state
    color: RGBA
    Foreground(context, state, *color); result.foreground = Pack(color)
    Background(context, state, *color); result.background = Pack(color)
    border: Border
    GetBorder(context, state, *border); result.border = Insets(border)
    GetPadding(context, state, *border); result.padding = Insets(border)
    GetMargin(context, state, *border); result.margin = Insets(border)
    if nodes[nodes.count-1].widget_type=="GtkTreeView" {
        property: [32]u8; value: GValue
        unused CString.CopyCString("vertical-separator",property[:])
        unused ValueInit(*value,cast(usize)24) // G_TYPE_INT (G_TYPE_FUNDAMENTAL(6)).
        GetStyleProperty(context,*property[0],*value); result.vertical_separator=ValueInt(*value); ValueUnset(*value)
        unused CString.CopyCString("horizontal-separator",property[:])
        unused ValueInit(*value,cast(usize)24)
        GetStyleProperty(context,*property[0],*value); result.horizontal_separator=ValueInt(*value); ValueUnset(*value)
    }
    result.dpi = Resolution(Screen())
    if result.dpi <= 0.0 { result.dpi = 96.0 }
    font: *void = null
    key: [8]u8
    unused CString.CopyCString("font", key[:])
    Property(context, state, *key[0], *font, cast(*u8)null)
    if font != null {
        defer FontFree(font)
        family := Text.TextFromCString(FontFamily(font))
        if !CString.CopyCString(family, result.font_family[:]) { return .{} }
        result.font_size = cast(float64)FontSize(font) / 1024.0
        if FontAbsolute(font) == 0 { result.font_size *= result.dpi / 72.0 }
        result.font_weight = FontWeight(font)
        result.font_style = FontStyle(font)
    }
    result.available = true
    return result
}

#scope_file
ApplyWidgetNode :: (widget: *void, node: GtkStyleNode) {
    context:=WidgetContext(widget)
    bytes: [256]u8
    if node.name!="" { unused CString.CopyCString(node.name,bytes[:]); WidgetName(widget,*bytes[0]) }
    for name: node.classes { unused CString.CopyCString(name,bytes[:]); ContextClass(context,*bytes[0]) }
    WidgetState(widget,node.state,1)
    for attachment: node.providers { ContextProvider(context,providers[ProviderIndex(attachment.provider)].object,attachment.priority) }
}

#scope_export
// Backend adapters borrow their widgets; this module retains no widget pointer.
// Calls must stay on GTK's owning thread, as with the other native APIs.
GtkNativeReady :: () -> bool { return Ready() }
GtkNativeSurfaceBitmap :: (surface: *void, width: s32, height: s32) -> GtkStyleBitmap {
    if surface==null || width<1 || height<1 || width>4096 || height>4096 ||
        cast(s64)width*cast(s64)height>4194304 || SurfaceStatus(surface)!=0 ||
        SurfaceType(surface)!=0 || SurfaceFormat(surface)!=0 ||
        SurfaceWidth(surface)!=width || SurfaceHeight(surface)!=height { return .{} }
    return SurfaceBitmap(surface,width,height)
}
GtkNativeWidgetNodeApply :: (widget: *void, node: GtkStyleNode) -> bool {
    if widget==null { return false }
    nodes: [1]GtkStyleNode=.[node]
    context:=MakeContext(nodes[:],1)
    if context==null { return false }
    Unref(context)
    ApplyWidgetNode(widget,node)
    return true
}

// GTK's own preferred requisition, including CSS min-size, padding, borders,
// font and widget-specific interior spacing. These widgets remain offscreen.
// Unsupported selectors return unavailable. Optional dimensions allocate the
// actual native children without changing the widget's preferred requisition.
GtkWidgetMeasure :: (nodes: []GtkStyleNode, text: string = "", sort_arrow: bool = false,
    allocation_width: s32 = 0, allocation_height: s32 = 0, options: GtkWidgetMeasureOptions = .{}) -> GtkWidgetMetrics {
    empty: [0]string
    return MeasureWidget(nodes,text,sort_arrow,false,empty[:],-1,false,allocation_width,allocation_height,options)
}
GtkCellTextMeasure :: (nodes: []GtkStyleNode, text: string) -> GtkWidgetMetrics {
    empty: [0]string
    return MeasureWidget(nodes,text,false,true,empty[:],-1,false)
}
GtkCellTextMeasureMany :: (nodes: []GtkStyleNode, texts: []string, width_chars: s32 = -1, ellipsize: bool = false) -> GtkWidgetMetrics {
    return MeasureWidget(nodes,"",false,true,texts,width_chars,ellipsize)
}
#scope_file
MeasureWidget :: (nodes: []GtkStyleNode, text: string, sort_arrow: bool, cell_text: bool, texts: []string, width_chars: s32, ellipsize: bool,
    allocation_width: s32 = 0, allocation_height: s32 = 0, options: GtkWidgetMeasureOptions = .{}) -> GtkWidgetMetrics {
    if nodes.count<1 || text.count>65536 || allocation_width<0 || allocation_height<0 || allocation_width>8192 || allocation_height>8192 { return .{} }
    margin:=options.margin
    if options.margin_edges>15 || margin.left<0 || margin.right<0 || margin.top<0 || margin.bottom<0 ||
        margin.left>8192 || margin.right>8192 || margin.top>8192 || margin.bottom>8192 { return .{} }
    context:=MakeContext(nodes,1); if context==null { return .{} }; defer Unref(context)
    final:=nodes[nodes.count-1].widget_type
    if cell_text { if final!="GtkTreeView" { return .{} } }
    else if final!="GtkEntry" && final!="GtkButton" && final!="GtkMenuBar" &&
        final!="GtkMenuItem" && final!="GtkToolbar" && final!="GtkToolButton" && final!="GtkPaned" && final!="GtkStatusbar" { return .{} }
    bytes: [65537]u8
    if !CString.CopyCString(text,bytes[:]) { return .{} }
    root:=OffscreenNew(); if root==null { return .{} }
    unused RefSink(root)
    defer { WidgetDestroy(root); Unref(root) }
    parent: *void; widget: *void; parent_type: string; header: bool
    at: s64
    while at<nodes.count {
        node:=nodes[at]
        if at==0 && node.widget_type=="GtkWindow" { widget=root }
        else if node.widget_type=="GtkBox" {
            orientation: s32=1
            for name: node.classes { if name=="horizontal" { orientation=0 } }
            widget=BoxNew(orientation,0)
        }
        else if node.widget_type=="GtkGrid" { widget=GridNew() }
        else if node.widget_type=="GtkBin" { widget=AlignmentNew(0.0,0.0,1.0,1.0) }
        else if node.widget_type=="GtkToolItem" { widget=ToolItemNew() }
        else if node.widget_type=="GtkToolbar" {
            widget=ToolbarNew(); ToolbarStyle(widget,0); ToolbarIconSize(widget,3)
        }
        else if node.widget_type=="GtkMenuBar" { widget=MenuBarNew() }
        else if node.widget_type=="GtkPaned" { widget=PanedNew(0) }
        else if node.widget_type=="GtkStatusbar" { widget=StatusbarNew(); unused StatusbarPush(widget,0,*bytes[0]) }
        else if node.widget_type=="GtkMenuItem" { widget=MenuItemNew(*bytes[0]) }
        else if node.widget_type=="GtkToolButton" { widget=ToolButtonNew(ImageNew(*bytes[0],3),null) }
        else if node.widget_type=="GtkTreeView" { widget=TreeViewNew() }
        else if node.widget_type=="GtkEntry" { widget=EntryNew(); if text!="" { EntryIcon(widget,0,*bytes[0]) } }
        else if node.widget_type=="GtkButton" { widget=ButtonNew(*bytes[0]) }
        else { return .{} }
        if widget==null { return .{} }
        if widget!=root {
            if parent==null { ContainerAdd(root,widget) }
            else if parent_type=="GtkToolbar" {
                if node.widget_type=="GtkToolButton" || node.widget_type=="GtkToolItem" { ToolbarInsert(parent,widget,-1) }
                else { item:=ToolItemNew(); ContainerAdd(item,widget); ToolbarInsert(parent,item,-1); WidgetShow(item) }
            } else { ContainerAdd(parent,widget) }
        }
        ApplyWidgetNode(widget,node)
        // A tree header is an internal GTK CSS node, not a GtkWidget. Build
        // the actual column so GTK supplies its alignment, label and arrow.
        if node.widget_type=="GtkTreeView" && at+2==nodes.count-1 && nodes[at+1].element=="header" && final=="GtkButton" {
            count:=nodes[nodes.count-1].sibling_count
            index:=nodes[nodes.count-1].sibling_index
            if count==0 { count=1 }
            column: *void
            for position: cast(s32)0..count-1 {
                peer:=ColumnNew()
                if position==index { column=peer; ColumnTitle(peer,*bytes[0]); ColumnSort(peer,cast(s32)sort_arrow) }
                unused ColumnAppend(widget,peer)
            }
            WidgetShow(widget)
            widget=ColumnButton(column); if widget==null { return .{} }
            ApplyWidgetNode(widget,nodes[nodes.count-1])
            header=true
            break
        }
        if widget!=root { WidgetShowAll(widget) }
        parent=widget; parent_type=node.widget_type; at+=1
    }
    // Never show the offscreen root. Preferred sizes only need the visible
    // child hierarchy. Entry text areas additionally require GTK's offscreen
    // backing surface; this surface is never mapped onto the desktop.
    // A container requisition includes one representative child. For menus,
    // text is its label; for icon toolbars it is a large-toolbar icon name.
    representative: *void
    representative_image: *void
    if (options.margin_edges & GtkWidgetMarginLeft)!=0 { WidgetMarginLeft(widget,margin.left) }
    if (options.margin_edges & GtkWidgetMarginRight)!=0 { WidgetMarginRight(widget,margin.right) }
    if (options.margin_edges & GtkWidgetMarginTop)!=0 { WidgetMarginTop(widget,margin.top) }
    if (options.margin_edges & GtkWidgetMarginBottom)!=0 { WidgetMarginBottom(widget,margin.bottom) }
    if final=="GtkMenuBar" { representative=MenuItemNew(*bytes[0]); ContainerAdd(widget,representative) }
    if final=="GtkToolbar" { representative_image=ImageNew(*bytes[0],3); representative=ToolButtonNew(representative_image,null); ToolbarInsert(widget,representative,-1) }
    if final=="GtkPaned" { PanedFirst(widget,BoxNew(1,0),0,0); PanedSecond(widget,BoxNew(1,0),1,0) }
    if header { WidgetShow(widget) } else { WidgetShowAll(widget) }
    minimum: Requisition; natural: Requisition
    if cell_text {
        renderer:=CellTextNew(); if renderer==null { return .{} }
        unused RefSink(renderer); defer Unref(renderer)
        key: [8]u8; unused CString.CopyCString("text",key[:])
        ObjectSet(renderer,*key[0],*bytes[0],cast(*u8)null)
        property: [16]u8
        if width_chars>=0 {
            unused CString.CopyCString("width-chars",property[:]); ObjectSet(renderer,*property[0],width_chars,cast(*u8)null)
        }
        if ellipsize {
            unused CString.CopyCString("ellipsize",property[:]); ObjectSet(renderer,*property[0],cast(s32)3,cast(*u8)null)
        }
        CellPreferred(renderer,widget,*minimum,*natural)
        if texts.count>1048576 { return .{} }
        // Repeated cell values have identical requisitions in this widget.
        // Keep a bounded per-call set; saturation only stops caching, so every
        // distinct value is still measured and hash collisions change nothing.
        seen: [256]string
        for value: texts {
            if !CString.CopyCString(value,bytes[:]) { return .{} }
            if value=="" { continue } // already measured above
            hash: u64=14695981039346656037
            for byte: value { hash=(hash ^ cast(u64)byte)*cast(u64)1099511628211 }
            slot:=cast(s32)(hash % 256)
            duplicate:=false
            for probe: cast(s32)0..255 {
                if seen[slot]==value { duplicate=true; break }
                if seen[slot]=="" { seen[slot]=value; break }
                slot=(slot+1)%256
            }
            if duplicate { continue }
            ObjectSet(renderer,*key[0],*bytes[0],cast(*u8)null)
            low: Requisition; high: Requisition
            CellPreferred(renderer,widget,*low,*high)
            if low.width>minimum.width { minimum.width=low.width }
            if low.height>minimum.height { minimum.height=low.height }
            if high.width>natural.width { natural.width=high.width }
            if high.height>natural.height { natural.height=high.height }
        }
    } else { WidgetPreferred(widget,*minimum,*natural) }
    result:=GtkWidgetMetrics.{.available=minimum.height>0 || minimum.width>0,.minimum_width=minimum.width,.minimum_height=minimum.height,
        .natural_width=natural.width,.natural_height=natural.height}
    if (representative!=null || header || final=="GtkEntry" || final=="GtkStatusbar") && result.available {
        allocation:=Allocation.{0,0,ifx allocation_width>0 then allocation_width else natural.width,
            ifx allocation_height>0 then allocation_height else natural.height}
        if header { WidgetShow(widget) } else { WidgetShowAll(widget) }
        if final=="GtkEntry" { WidgetRealize(widget) }
        if final=="GtkToolbar" { WidgetRealize(root); WidgetRealize(widget) }
        WidgetAllocate(widget,*allocation)
        if header {
            box:=BinChild(widget)
            children:=ContainerChildren(box); defer WidgetListFree(children)
            child:=children
            while child!=null {
                if InstanceIsA(child.data,ImageType())!=0 {
                    WidgetAllocation(child.data,*allocation)
                    if sort_arrow { result.arrow_x=allocation.x; result.arrow_y=allocation.y; result.arrow_width=allocation.width; result.arrow_height=allocation.height }
                } else {
                    label:=BinChild(child.data)
                    if label!=null { WidgetAllocation(label,*allocation); result.item_x=allocation.x; result.item_y=allocation.y; result.item_width=allocation.width; result.item_height=allocation.height }
                }
                child=child.next
            }
        } else if final=="GtkEntry" {
            area: Allocation; EntryTextArea(widget,*area)
            EntryLayoutOffsets(widget,*result.item_x,*result.item_y)
            width: s32; height: s32; LayoutSize(EntryLayout(widget),*width,*height)
            result.item_width=area.x+area.width-result.item_x
            if result.item_width<0 { result.item_width=0 }
            result.item_height=height
            if text!="" {
                EntryIconArea(widget,0,*area)
                result.arrow_x=area.x; result.arrow_y=area.y; result.arrow_width=area.width; result.arrow_height=area.height
            }
        } else if final=="GtkStatusbar" {
            children:=ContainerChildren(StatusbarArea(widget)); defer WidgetListFree(children)
            child:=children
            while child!=null {
                if InstanceIsA(child.data,LabelType())!=0 {
                    WidgetAllocation(child.data,*allocation)
                    result.item_x=allocation.x; result.item_y=allocation.y; result.item_width=allocation.width; result.item_height=allocation.height
                    break
                }
                child=child.next
            }
        } else {
            WidgetAllocation(representative,*allocation)
            result.item_x=allocation.x; result.item_y=allocation.y
            result.item_width=allocation.width; result.item_height=allocation.height
            if final=="GtkToolbar" {
                control:=BinChild(representative)
                if control!=null {
                    WidgetAllocation(control,*allocation)
                    if WidgetTranslate(control,widget,0,0,*result.control_x,*result.control_y)!=0 {
                        result.control_width=allocation.width; result.control_height=allocation.height
                    }
                }
                if representative_image!=null {
                    WidgetAllocation(representative_image,*allocation)
                    if WidgetTranslate(representative_image,widget,0,0,*result.arrow_x,*result.arrow_y)!=0 {
                        result.arrow_width=allocation.width; result.arrow_height=allocation.height
                    }
                }
            }
        }
    }
    return result
}
#scope_export

// GtkIconSize categories: menu=1, small toolbar=2, large toolbar=3, button=4.
GtkIconSize :: (category: s32) -> GtkTextMetrics {
    result: GtkTextMetrics
    if category<1 || category>6 || !Ready() { return result }
    result.available=IconSizeLookup(category,*result.width,*result.height)!=0
    return result
}

#scope_file
// Own every target and image. The root window only selects a compatible
// backend; no existing window pixels are read.
NativeRasterTarget :: (w: s32, h: s32, backdrop: []u8) -> *void {
    surface: *void
    if backdrop.count!=0 {
        window:=RootWindow()
        if window!=null {
            native:=SimilarSurface(window,12288,1,1)
            if native!=null {
                if SurfaceStatus(native)==0 {
                    SurfaceDeviceScale(native,1.0,1.0)
                    surface=SurfaceSimilar(native,12288,w,h)
                }
                SurfaceFree(native)
            }
            // Public dimensions are device pixels. GDK's window scale must
            // not multiply them again; CSS scale is applied once below.
            if surface!=null { SurfaceDeviceScale(surface,1.0,1.0) }
            if surface!=null && SurfaceStatus(surface)!=0 { SurfaceFree(surface); surface=null }
        }
    }
    if surface==null { surface=SurfaceNew(0,w,h) }
    if surface == null { return null }
    retained: bool
    defer { if !retained { SurfaceFree(surface) } }
    if SurfaceStatus(surface) != 0 { return null }
    if backdrop.count==0 { retained=true; return surface }
    backdrop_image: *void
    defer { if backdrop_image!=null { SurfaceFree(backdrop_image) } }
    if backdrop.count!=0 {
        backdrop_image=SurfaceNew(0,w,h)
        if backdrop_image==null || SurfaceStatus(backdrop_image)!=0 { return null }
        SurfaceFlush(backdrop_image)
        stride_bytes:=SurfaceStride(backdrop_image)
        if stride_bytes<w*4 || stride_bytes%4!=0 || cast(s64)stride_bytes*cast(s64)h>67108864 { return null }
        pixels:=SurfaceData(backdrop_image); stride:=stride_bytes/4
        if pixels==null { return null }
        for yy: cast(s32)0..h-1 { for xx: cast(s32)0..w-1 {
            at:=(yy*w+xx)*4; a:=cast(u32)backdrop[at+3]
            r:=(cast(u32)backdrop[at]*a+127)/255
            g:=(cast(u32)backdrop[at+1]*a+127)/255
            b:=(cast(u32)backdrop[at+2]*a+127)/255
            pixels[yy*stride+xx]=(a<<24)|(r<<16)|(g<<8)|b
        } }
        SurfaceDirty(backdrop_image)
    }
    draw := DrawNew(surface)
    if draw == null { return null }
    defer DrawFree(draw)
    if DrawStatus(draw) != 0 { return null }
    if backdrop_image!=null {
        DrawOperator(draw,1)
        DrawSourceSurface(draw,backdrop_image,0.0,0.0)
        DrawPaint(draw)
        DrawOperator(draw,2)
        // Finish the image upload before CSS drawing. Native Cairo backends
        // can otherwise retain the image fallback compositor for later curves.
        SurfaceFlush(surface)
    }
    if DrawStatus(draw)!=0 || SurfaceStatus(surface)!=0 { return null }
    retained=true
    return surface
}

NativeRasterBitmap :: (surface: *void, w: s32, h: s32) -> GtkStyleBitmap {
    if SurfaceType(surface)!=0 {
        mapped:=SurfaceMap(surface,null)
        if mapped==null { return .{} }
        defer SurfaceUnmap(surface,mapped)
        if SurfaceStatus(mapped)!=0 || SurfaceType(mapped)!=0 || SurfaceFormat(mapped)!=0 ||
            SurfaceWidth(mapped)!=w || SurfaceHeight(mapped)!=h { return .{} }
        return SurfaceBitmap(mapped,w,h)
    }
    return SurfaceBitmap(surface,w,h)
}
#scope_export
// The caller owns this borrowed, allocated GTK widget. Output owns its RGBA;
// a supplied backdrop is composited once using the native window backend.
GtkNativeWidgetRaster :: (widget: *void, width: s32, height: s32, scale: s32,
    backdrop: []u8) -> GtkStyleBitmap {
    if widget==null || scale<1 || scale>4 || width<1 || height<1 ||
        width>4096/scale || height>4096/scale { return .{} }
    w:=width*scale; h:=height*scale
    if cast(s64)w*cast(s64)h>4194304 ||
        (backdrop.count!=0 && backdrop.count!=cast(s64)w*cast(s64)h*4) || !Ready() { return .{} }
    surface:=NativeRasterTarget(w,h,backdrop)
    if surface==null { return .{} }; defer SurfaceFree(surface)
    draw:=DrawNew(surface); if draw==null { return .{} }; defer DrawFree(draw)
    DrawScale(draw,cast(float64)scale,cast(float64)scale)
    NativeWidgetDraw(widget,draw)
    if DrawStatus(draw)!=0 || SurfaceStatus(surface)!=0 { return .{} }
    return NativeRasterBitmap(surface,w,h)
}

// Logical dimensions, integer device scale. The output is straight RGBA8 and
// fits BitmapImageCreate's 4096-axis / 4,194,304-pixel ownership budget.
GtkStyleRaster :: (nodes: []GtkStyleNode, width: s32, height: s32, scale: s32) -> GtkStyleBitmap {
    return GtkStyleRasterRegion(nodes,width,height,scale,0,0,width,height)
}

// Render a crop of the original CSS box, retaining its gradient, border and
// corner coordinates. Only the crop allocates a Cairo surface.
GtkStyleRasterRegion :: (nodes: []GtkStyleNode, width: s32, height: s32, scale: s32,
    x: s32, y: s32, crop_width: s32, crop_height: s32) -> GtkStyleBitmap {
    empty: []u8
    return GtkStyleRasterRegionOver(nodes,width,height,scale,x,y,crop_width,crop_height,empty)
}

// Draw each CSS layer directly over the supplied straight-alpha RGBA crop.
// This preserves Cairo's per-layer rounding at translucent borders/shadows.
// Native compatible surfaces preserve the window backend's curve coverage;
// mapping touches only our newly allocated pixmap, never any window pixels.
// An empty backdrop keeps the transparent raster behavior.
GtkStyleRasterRegionOver :: (nodes: []GtkStyleNode, width: s32, height: s32, scale: s32,
    x: s32, y: s32, crop_width: s32, crop_height: s32, backdrop: []u8) -> GtkStyleBitmap {
    if scale < 1 || scale > 4 || width < 1 || height < 1 ||
        width > 8192 || height > 8192 || x<0 || y<0 || crop_width<1 || crop_height<1 ||
        crop_width>4096/scale || crop_height>4096/scale ||
        x>width-crop_width || y>height-crop_height { return .{} }
    w := crop_width * scale; h := crop_height * scale
    count := cast(u64)w * cast(u64)h
    if count > 4194304 || (backdrop.count!=0 && backdrop.count!=cast(s64)count*4) { return .{} }
    context := MakeContext(nodes, scale)
    if context == null { return .{} }
    defer Unref(context)
    surface:=NativeRasterTarget(w,h,backdrop)
    if surface==null { return .{} }; defer SurfaceFree(surface)
    draw:=DrawNew(surface); if draw==null { return .{} }; defer DrawFree(draw)
    DrawScale(draw, cast(float64)scale, cast(float64)scale)
    RenderBackground(context, draw, 0.0-cast(float64)x, 0.0-cast(float64)y, cast(float64)width, cast(float64)height)
    RenderFrame(context, draw, 0.0-cast(float64)x, 0.0-cast(float64)y, cast(float64)width, cast(float64)height)
    if DrawStatus(draw) != 0 || SurfaceStatus(surface) != 0 { return .{} }
    return NativeRasterBitmap(surface,w,h)
}

GtkTextMeasure :: (nodes: []GtkStyleNode, text: string, width: s32, scale: s32, font: string = "", markup: bool = false) -> GtkTextMetrics {
    if text.count > 65536 || width < 0 || width > 4096 { return .{} }
    context := MakeContext(nodes,scale)
    if context == null { return .{} }
    defer Unref(context)
    layout := MakeLayout(context,nodes[nodes.count-1].state,text,width,0,font,markup)
    if layout == null { return .{} }
    defer Unref(layout)
    result: GtkTextMetrics
    LayoutSize(layout,*result.width,*result.height)
    result.baseline=(LayoutBaseline(layout)+512)/1024
    result.available=true
    return result
}

// Transparent CSS text paint only; the caller supplies the label and box.
// Horizontal alignment is Pango left/center/right (0/1/2), vertically centered.
GtkTextRaster :: (nodes: []GtkStyleNode, text: string, width: s32, height: s32, scale: s32, align: s32, font: string = "", markup: bool = false, ellipsize: bool = false, snap_y: bool = false) -> GtkStyleBitmap {
    if scale < 1 || scale > 4 || width < 1 || height < 1 ||
        width > 4096 / scale || height > 4096 / scale || text.count > 65536 ||
        align < 0 || align > 2 { return .{} }
    w:=width * scale; h:=height * scale
    if cast(u64)w * cast(u64)h > 4194304 { return .{} }
    context := MakeContext(nodes,scale)
    if context == null { return .{} }
    defer Unref(context)
    layout := MakeLayout(context,nodes[nodes.count-1].state,text,width,align,font,markup)
    if layout == null { return .{} }
    defer Unref(layout)
    if ellipsize { LayoutEllipsize(layout,3) }
    surface := SurfaceNew(0,w,h)
    if surface == null { return .{} }
    defer SurfaceFree(surface)
    if SurfaceStatus(surface) != 0 { return .{} }
    draw := DrawNew(surface)
    if draw == null { return .{} }
    defer DrawFree(draw)
    if DrawStatus(draw) != 0 { return .{} }
    DrawScale(draw,cast(float64)scale,cast(float64)scale)
    tw: s32; th: s32
    LayoutSize(layout,*tw,*th)
    y: float64=(cast(float64)height-cast(float64)th)/2.0
    if snap_y {
        whole:=cast(s32)y
        if y<0.0 && cast(float64)whole!=y { whole-=1 }
        y=cast(float64)whole
    }
    RenderLayout(context,draw,0.0,y,layout)
    if DrawStatus(draw) != 0 { return .{} }
    return SurfaceBitmap(surface,w,h)
}

GtkStyleBitmapRelease :: (bitmap: *GtkStyleBitmap) {
    if bitmap == null { return }
    if bitmap.rgba.count > 0 { Free(*bitmap.rgba[0]) }
    bitmap.* = .{}
}

// Resolve current theme inheritance and symbolic colors without serializing
// an icon to disk. Returned dimensions are physical pixels, which may differ
// for a non-square themed image. Missing or malformed icons fail empty.
GtkIconRaster :: (name: string, size: s32, scale: s32, nodes: []GtkStyleNode, force_size: bool = true, styled: bool = false) -> GtkStyleBitmap {
    if name == "" || !ValidText(name) || scale < 1 || scale > 4 ||
        size < 1 || size > 2048 / scale { return .{} }
    for byte: name { if byte == cast(u8)47 || byte == cast(u8)92 { return .{} } }
    context := MakeContext(nodes,scale)
    if context == null { return .{} }
    defer Unref(context)
    theme := IconTheme()
    if theme == null { return .{} }
    unused IconRescan(theme)
    bytes: [256]u8
    unused CString.CopyCString(name,bytes[:])
    flags: s32=ifx force_size then 16 else 0
    if styled { flags |= 4; flags |= ifx ContextDirection(context)==2 then 256 else 128 }
    info := IconLookup(theme,*bytes[0],size,scale,flags)
    if info == null { return .{} }
    defer Unref(info)
    if !styled { return RasterIconInfo(info,context) }
    image:=IconLoad(info,context,null,null)
    if image==null { return .{} }
    defer Unref(image)
    icon_surface:=PixbufSurface(image,scale,null)
    if icon_surface==null { return .{} }
    defer SurfaceFree(icon_surface)
    if SurfaceStatus(icon_surface)!=0 { return .{} }
    surface:=SurfaceNew(0,size*scale,size*scale)
    if surface==null { return .{} }
    defer SurfaceFree(surface)
    if SurfaceStatus(surface)!=0 { return .{} }
    draw:=DrawNew(surface)
    if draw==null { return .{} }
    defer DrawFree(draw)
    DrawScale(draw,cast(float64)scale,cast(float64)scale)
    xx:=(cast(float64)size-cast(float64)PixbufWidth(image)/cast(float64)scale)/2.0
    yy:=(cast(float64)size-cast(float64)PixbufHeight(image)/cast(float64)scale)/2.0
    RenderIconSurface(context,draw,icon_surface,xx,yy)
    if DrawStatus(draw)!=0 || SurfaceStatus(surface)!=0 { return .{} }
    return SurfaceBitmap(surface,size*scale,size*scale)
}

#scope_file
FileNew :: (path: *u8) -> *void #foreign gio "g_file_new_for_path";
FileQuery :: (file: *void, attributes: *u8, flags: s32, cancel: *void, error: **void) -> *void #foreign gio "g_file_query_info";
FileSystemQuery :: (file: *void, attributes: *u8, cancel: *void, error: **void) -> *void #foreign gio "g_file_query_filesystem_info";
FileAttributeU64 :: (info: *void, name: *u8) -> u64 #foreign gio "g_file_info_get_attribute_uint64";
FileIcon :: (info: *void) -> *void #foreign gio "g_file_info_get_icon";
FileContentType :: (info: *void) -> *u8 #foreign gio "g_file_info_get_content_type";
FileLinkTarget :: (info: *void) -> *u8 #foreign gio "g_file_info_get_symlink_target";
FileHasAttribute :: (info: *void, name: *u8) -> s32 #foreign gio "g_file_info_has_attribute";
ContentDescription :: (content: *u8) -> *u8 #foreign gio "g_content_type_get_description";
IconLookupGIcon :: (theme: *void, icon: *void, size: s32, scale: s32, flags: s32) -> *void #foreign gtk "gtk_icon_theme_lookup_by_gicon_for_scale";
IconFromString :: (value: *u8, error: **void) -> *void #foreign gio "g_icon_new_for_string";
UserDirectory :: (directory: s32) -> *u8 #foreign glib "g_get_user_special_dir";
HomeDirectory :: () -> *u8 #foreign glib "g_get_home_dir";
FormatSize :: (size: u64, flags: s32) -> *u8 #foreign glib "g_format_size_full";
RasterIconInfo :: (info: *void, context: *void) -> GtkStyleBitmap {
    image := IconLoad(info,context,null,null)
    if image == null { return .{} }
    defer Unref(image)
    return RasterPixbuf(image)
}
RasterPixbuf :: (image: *void) -> GtkStyleBitmap {
    w := PixbufWidth(image); h := PixbufHeight(image)
    channels := PixbufChannels(image)
    if w < 1 || h < 1 || w > 4096 || h > 4096 ||
        (channels != 3 && channels != 4) || PixbufBits(image) != 8 ||
        PixbufColorspace(image) != 0 { return .{} }
    count := cast(u64)w * cast(u64)h
    if count > 4194304 { return .{} }
    stride := PixbufStride(image)
    pixels := PixbufData(image)
    if pixels == null || stride < w * channels ||
        cast(s64)stride * cast(s64)h > 67108864 { return .{} }
    data := Allocate(cast(usize)count,4)
    if data == null { return .{} }
    for y: 0..h - 1 {
        for x: 0..w - 1 {
            from := y * stride + x * channels
            at := (y * w + x) * 4
            data[at]=pixels[from]; data[at+1]=pixels[from+1]; data[at+2]=pixels[from+2]
            data[at+3]=ifx channels == 4 then pixels[from+3] else cast(u8)255
        }
    }
    return .{w,h,Text.BytesFromPointer(data,count * cast(u64)4)}
}

#scope_export
// GIO resolves MIME icons using the shared MIME database and the current GTK
// icon theme. File paths remain raw Unix bytes; no shell or URI conversion.
GtkFileIconRaster :: (path: string, size: s32, scale: s32, nodes: []GtkStyleNode) -> GtkStyleBitmap {
    if path.count < 1 || path.count > 4095 || size < 1 || scale < 1 || scale > 4 || size > 2048/scale { return .{} }
    for c: path { if c == 0 { return .{} } }
    if path == "/" { return GtkIconRaster("drive-harddisk",size,scale,nodes) }
    home := HomeDirectory()
    if home != null && path == Text.TextFromCString(home) { return GtkIconRaster("user-home",size,scale,nodes) }
    names: [8]string = .["user-desktop","folder-documents","folder-download","folder-music","folder-pictures","folder-publicshare","folder-templates","folder-videos"]
    for i: 0..7 {
        special := UserDirectory(cast(s32)i)
        if special != null && path == Text.TextFromCString(special) { return GtkIconRaster(names[i],size,scale,nodes) }
    }
    context := MakeContext(nodes,scale)
    if context == null { return .{} }
    defer Unref(context)
    bytes: [4096]u8
    unused CString.CopyCString(path,bytes[:])
    file := FileNew(*bytes[0])
    if file == null { return .{} }
    defer Unref(file)
    attrs: [32]u8
    unused CString.CopyCString("standard::icon",attrs[:])
    metadata := FileQuery(file,*attrs[0],0,null,null)
    if metadata == null { return .{} }
    defer Unref(metadata)
    if FileHasAttribute(metadata,*attrs[0])==0 { return .{} }
    icon := FileIcon(metadata)
    theme := IconTheme()
    if icon == null || theme == null { return .{} }
    info := IconLookupGIcon(theme,icon,size,scale,16)
    if info == null { return .{} }
    defer Unref(info)
    return RasterIconInfo(info,context)
}

// GIcon serialization preserves complete native themed/file/emblemed identity.
GtkSerializedIconRaster :: (value: string, size: s32, scale: s32, nodes: []GtkStyleNode) -> GtkStyleBitmap {
    if value.count<1 || value.count>8191 || size<1 || scale<1 || scale>4 || size>2048/scale { return .{} }
    for c: value { if c==0 { return .{} } }
    bytes: [8192]u8;unused CString.CopyCString(value,bytes[:])
    icon:=IconFromString(*bytes[0],null)
    if icon==null { return .{} }
    defer Unref(icon)
    context:=MakeContext(nodes,scale)
    if context==null { return .{} }
    defer Unref(context)
    theme:=IconTheme()
    if theme==null { return .{} }
    info:=IconLookupGIcon(theme,icon,size,scale,16)
    if info==null { return .{} }
    defer Unref(info)
    return RasterIconInfo(info,context)
}
GtkContentDescription :: (content_type: string, output: []u8) -> s32 {
    if content_type.count<1 || content_type.count>1023 { return -1 }
    for c: content_type { if c==0 { return -1 } }
    bytes: [1024]u8;unused CString.CopyCString(content_type,bytes[:])
    description:=ContentDescription(*bytes[0])
    if description==null { return -1 }
    defer GLibFree(description)
    text:=Text.TextFromCString(description)
    if !CString.CopyCString(text,output) { return -1 }
    return cast(s32)text.count
}

GtkFileDescription :: (path: string, output: []u8) -> s32 {
    if path.count < 1 || path.count > 4095 { return -1 }
    for c: path { if c == 0 { return -1 } }
    bytes: [4096]u8; attrs: [32]u8
    unused CString.CopyCString(path,bytes[:])
    unused CString.CopyCString("standard::content-type",attrs[:])
    file := FileNew(*bytes[0])
    if file == null { return -1 }
    defer Unref(file)
    info := FileQuery(file,*attrs[0],0,null,null)
    if info == null { return -1 }
    defer Unref(info)
    if FileHasAttribute(info,*attrs[0])==0 { return -1 }
    content := FileContentType(info)
    if content == null { return -1 }
    description := ContentDescription(content)
    if description == null { return -1 }
    defer GLibFree(description)
    text := Text.TextFromCString(description)
    if !CString.CopyCString(text,output) { return -1 }
    return cast(s32)text.count
}

GtkFileLinkTarget :: (path: string, output: []u8) -> s32 {
    if path.count < 1 || path.count > 4095 { return -1 }
    for c: path { if c == 0 { return -1 } }
    bytes: [4096]u8; attrs: [32]u8
    unused CString.CopyCString(path,bytes[:]); unused CString.CopyCString("standard::symlink-target",attrs[:])
    file := FileNew(*bytes[0])
    if file == null { return -1 }
    defer Unref(file)
    info := FileQuery(file,*attrs[0],1,null,null)
    if info == null { return -1 }
    defer Unref(info)
    if FileHasAttribute(info,*attrs[0]) == 0 { return -1 }
    target := FileLinkTarget(info)
    if target == null { return -1 }
    text := Text.TextFromCString(target)
    if !CString.CopyCString(text,output) { return -1 }
    return cast(s32)text.count
}

GtkImageRaster :: (path: string, width: s32, height: s32) -> GtkStyleBitmap {
    if path.count < 1 || path.count > 4095 || width < 1 || width > 2048 || height < 1 || height > 2048 { return .{} }
    for c: path { if c == 0 { return .{} } }
    bytes: [4096]u8; unused CString.CopyCString(path,bytes[:])
    image := PixbufFile(*bytes[0],width,height,1,null)
    if image == null { return .{} }
    defer Unref(image)
    return RasterPixbuf(image)
}

GtkFormatFileSize :: (size: u64, output: []u8) -> s32 {
    text := FormatSize(size,2)
    if text == null { return -1 }
    defer GLibFree(text)
    value := Text.TextFromCString(text)
    if !CString.CopyCString(value,output) { return -1 }
    return cast(s32)value.count
}

GtkFormatFileDate :: (stamp: s64, output: []u8, style: GtkFileDateStyle = .LocaleDate,
    now: s64 = -1, domain: string = "") -> s32 {
    return FileDate.FormatFileDate(stamp,output,cast(FileDate.DateStyle)style,now,domain)
}

GtkFileSystemFree :: (path: string) -> s64 {
    if path.count < 1 || path.count > 4095 { return -1 }
    for c: path { if c == 0 { return -1 } }
    bytes: [4096]u8; attrs: [32]u8
    unused CString.CopyCString(path,bytes[:]); unused CString.CopyCString("filesystem::free",attrs[:])
    file := FileNew(*bytes[0])
    if file == null { return -1 }
    defer Unref(file)
    info := FileSystemQuery(file,*attrs[0],null,null)
    if info == null { return -1 }
    defer Unref(info)
    value := FileAttributeU64(info,*attrs[0])
    return ifx value <= cast(u64)9223372036854775807 then cast(s64)value else cast(s64)-1
}

// Tokens are process-local, bounded to 64 live entries and never reused.
// All operations run on the GTK owning thread, just like the raster bridge.
GtkStyleProviderCreate :: (css: string) -> u64 {
    if next_provider == 0 { return 0 }
    slot: s32 = -1
    for i: 0..63 { if providers[i].id == 0 { slot = cast(s32)i; break } }
    if slot < 0 { return 0 }
    object := ParseProvider(css)
    if object == null { return 0 }
    id := next_provider; next_provider += 1
    providers[slot] = .{.id=id, .object=object}
    return id
}
GtkStyleProviderInstall :: (handle: u64, priority: u32) -> bool {
    at := ProviderIndex(handle)
    if at < 0 { return false }
    slot := *providers[at]
    // Reinstalling at the same priority is a no-op, including display env changes.
    if slot.screen != null && slot.priority == priority { return true }
    if !Ready() { return false }
    screen := Screen()
    if screen == null { return false }
    unused Ref(screen)
    if slot.screen != null { ProviderRemove(slot.screen, slot.object); Unref(slot.screen) }
    slot.screen = screen; slot.priority = priority
    ProviderAdd(screen, slot.object, priority)
    Changed()
    return true
}
GtkStyleProviderReplace :: (handle: u64, css: string) -> bool {
    at := ProviderIndex(handle)
    if at < 0 { return false }
    object := ParseProvider(css)
    if object == null { return false }
    slot := *providers[at]
    if slot.screen != null {
        ProviderRemove(slot.screen, slot.object)
        ProviderAdd(slot.screen, object, slot.priority)
    }
    Unref(slot.object); slot.object = object
    Changed()
    return true
}
GtkStyleProviderRelease :: (handle: u64) -> bool {
    at := ProviderIndex(handle)
    if at < 0 { return false }
    slot := providers[at]
    providers[at] = .{}
    if slot.screen != null { ProviderRemove(slot.screen, slot.object); Unref(slot.screen) }
    Unref(slot.object)
    Changed()
    return true
}
GtkStyleDarkPreferencePush :: (value: bool) -> u64 {
    if next_preference == 0 { return 0 }
    at: s32 = -1
    for i: 0..63 { if preferences[i].id == 0 { at = cast(s32)i; break } }
    if at < 0 { return 0 }
    if settings_object == null {
        if !Ready() { return 0 }
        object := Settings()
        if object == null { return 0 }
        settings_object = Ref(object)
        settings_original = DarkValue()
    }
    id := next_preference; next_preference += 1
    preferences[at] = .{id, value}
    ApplyDark(value)
    return id
}
GtkStyleDarkPreferenceRestore :: (handle: u64) -> bool {
    if handle == 0 { return false }
    at: s32 = -1
    for i: 0..63 { if preferences[i].id == handle { at = cast(s32)i; break } }
    if at < 0 { return false }
    preferences[at] = .{}
    newest: u64
    value := settings_original
    for scope: preferences { if scope.id > newest { newest = scope.id; value = scope.value } }
    ApplyDark(value)
    if newest == 0 { Unref(settings_object); settings_object = null }
    return true
}
GtkStyleGeneration :: () -> u64 { return style_generation }

// Non-GTK event loops may explicitly deliver pending GTK settings changes.
// Never blocks; callbacks execute on the calling (GTK owning) thread.
GtkStylePoll :: () -> s32 {
    if !Ready() { return 0 }
    count: s32 = 0
    while count < 32 && Iterate(null, 0) != 0 { count += 1 }
    // Timers, input and unrelated GIO completions also use the default GLib
    // context. Only settings, icon-theme and provider changes invalidate
    // native raster caches; dispatching an event alone changes no pixels.
    if style_pending { style_pending = false; count += 1 }
    return count
}
