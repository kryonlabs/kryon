// Optional remote transport; local notifications never depend on this module.
// Opt in with templates/android-notifications-push.gradle and import this
// module from the Android entry so its platform callbacks are linked.
// One active account/application scope per package. Cancel before signing out.
// Endpoint registration with an application's server remains the app's job.
// PushStart is explicit enable/retry: callers preserve their existing disabled
// preference before calling it on launch. PushRead/snapshot returns credentials
// only for the matching scope; never log that snapshot. Observe revision and
// register changed endpoints/keys with the app's existing server. For FCM send
// data-only payloads with kryon_scope and kryon_instance (snapshot's wire).
// Native callers use PushState.instance as the kryon_instance value.
// The application validates payload content in its service's onPushMessage.
#if #defined(ANDROID_BUILD) {
    #import "android_notification_jni"
    #import "android_jni"
    #import "std/c_string"
    #import "std/byte_text_linux"
}

PushUnsupported :: 0
PushDisabled :: 1
PushNoDistributor :: 2
PushFirebaseUnconfigured :: 3
PushRegistering :: 4
PushReady :: 5
PushFailed :: 6
PushUnavailable :: 7
PushInvalidScope :: 8
PushProviderNone :: 0
PushProviderUnified :: 1
PushProviderFcm :: 2

PushChoice :: struct { provider: s32; status: s32; distributor: string }
PushState :: struct {
    status: s32
    provider: s32
    revision: s64
    instance: [128]u8
    distributor: [256]u8
    endpoint: [4096]u8
    auth: [256]u8
    p256dh: [256]u8
}

PushScopeValid :: (scope: string) -> bool {
    if scope.count == 0 || scope.count > 128 { return false }
    for byte: scope { if byte < 32 || byte == 127 { return false } }
    return true
}
PushInstalled :: (installed: []string, value: string) -> bool {
    if value.count == 0 { return false }
    for item: installed { if item == value { return true } }
    return false
}
PushBefore :: (a: string, b: string) -> bool {
    for byte, at: a {
        if at >= b.count { return false }
        if byte != b[at] { return byte < b[at] }
    }
    return a.count < b.count
}
// No named distributor is privileged (Sunup is an ordinary UnifiedPush
// distributor). Never replace an installed saved/default choice.
PushChoose :: (gplay: bool, firebase_configured: bool, saved: string, default_distributor: string, installed: []string) -> PushChoice {
    if gplay {
        return PushChoice.{.provider = PushProviderFcm,
            .status = ifx firebase_configured then PushRegistering else PushFirebaseUnconfigured}
    }
    choice := PushChoice.{.provider = PushProviderUnified, .status = PushRegistering}
    if PushInstalled(installed, saved) { choice.distributor = saved; return choice }
    if PushInstalled(installed, default_distributor) { choice.distributor = default_distributor; return choice }
    for item: installed {
        if item.count > 0 && (choice.distributor.count == 0 || PushBefore(item, choice.distributor)) { choice.distributor = item }
    }
    if choice.distributor.count == 0 { choice.status = PushNoDistributor }
    return choice
}
PushAccepts :: (status: s32, provider: s32, expected_provider: s32, wire: string, incoming: string) -> bool {
    return (status == PushRegistering || status == PushReady || status == PushUnavailable) &&
        provider == expected_provider && wire.count > 0 && wire == incoming
}

PushStart :: (scope: string, label: string) -> s32 {
    if !PushScopeValid(scope) || label.count > 1024 { return PushInvalidScope }
    #if #defined(ANDROID_BUILD) {
        session: AndroidJniSession
        if AndroidJniAttachCurrent(*session) == 0 { return PushUnsupported }
        result := PStart(session.env, session.activity, NString(session.env, scope), NString(session.env, label))
        AndroidJniDetachCurrent(*session)
        return result
    }
    return PushUnsupported
}
PushRead :: (scope: string, state: *PushState) -> bool {
    state.* = .{}
    #if #defined(ANDROID_BUILD) {
        session: AndroidJniSession
        if AndroidJniAttachCurrent(*session) == 0 { return false }
        unused PLock(cast(*void)*p_mutex[0])
        result := PRead(session.env, session.activity, NString(session.env, scope), state)
        unused PUnlock(cast(*void)*p_mutex[0])
        AndroidJniDetachCurrent(*session)
        return result
    }
    unused scope
    return false
}
PushCancel :: (scope: string) -> bool {
    #if #defined(ANDROID_BUILD) {
        session: AndroidJniSession
        if AndroidJniAttachCurrent(*session) == 0 { return false }
        result := PCancel(session.env, session.activity, NString(session.env, scope))
        AndroidJniDetachCurrent(*session)
        return result
    }
    unused scope
    return false
}

#if #defined(ANDROID_BUILD) {
