# Emitted as C enums ahead of the records that reference them (#type
# declarations emit before the enum pass).
EventKind :: enum { EVENT_NONE = 0, EVENT_CLICK = 1, EVENT_VALUE_CHANGED = 2, EVENT_TEXT_CHANGED = 3, EVENT_TEXT_COMMIT = 4, EVENT_SELECTION_CHANGED = 5, EVENT_COMPOSITION_CHANGED = 6, EVENT_FOCUS = 7, EVENT_BLUR = 8 } #type
Invalidation :: enum { INVALIDATE_NONE = 0, INVALIDATE_PAINT = 1, INVALIDATE_LAYOUT = 2, INVALIDATE_TREE = 4 } #type

ROUTER_NO_ROUTE :: -2147483647

# C-only tree types: the identifier alias, the opaque tree node, the
# accessibility sink callback, the flex aliases, and the event record whose
# union has no portable mirror.
NodeId :: int #type
TreeNode :: struct TreeNode #type
AccessibilitySink :: void (*)(const AccessibilityNode *nodes, int count, void *userdata) #type
RowProps :: ColumnProps #type
FlowProps :: ColumnProps #type
Event :: struct Event { KeyID key; EventKind kind; double timestamp; union { int value; struct { int start, end; } selection; struct { int bytes; } text; } data; } #type

# Tree lifecycle, node queries, and accessibility; implemented by the C-only
# tree host.
BeginTree :: (screen_key: KeyID) #extern #export
EndTree :: () #extern #export
End :: () #extern #export
Key :: (text: const char*) -> KeyID #extern #export
InvalidateTree :: (invalidation: Invalidation) #extern #export
NextEvent :: (event: *Event) -> i32 #extern #export
SetSelection :: (key: KeyID, anchor: i32, cursor: i32) -> i32 #extern #export
ReconcileTree :: () #extern #export
LayoutTree :: () #extern #export
RouteInput :: () #extern #export
UpdateTree :: () #extern #export
Overlays :: () #extern #export
GetTreeNodes :: (count: *i32) -> const TreeNode* #extern #export
GetNodeId :: (node: const TreeNode*) -> i32 #extern #export
GetNodeKind :: (node: const TreeNode*) -> i32 #extern #export
GetNodeKindName :: (kind: i32) -> const char* #extern #export
GetNodeBounds :: (node: const TreeNode*) -> Rectangle #extern #export
GetNodeParent :: (node: const TreeNode*) -> i32 #extern #export
GetNodeFirstChild :: (node: const TreeNode*) -> i32 #extern #export
GetNodeNextSibling :: (node: const TreeNode*) -> i32 #extern #export
GetNodeHeightById :: (id: i32) -> i32 #extern #export
GetNode :: (id: NodeId) -> const TreeNode* #extern #export
HitTestNode :: (point: Vector2) -> NodeId #extern #export
GetAccessibilitySnapshot :: (nodes: *AccessibilityNode, capacity: i32) -> i32 #extern #export
SetAccessibilitySink :: (sink: AccessibilitySink, userdata: *void) #extern #export
QueueAccessibilityAction :: (focus_id: i32, generation: u64, action: AccessibilityAction) -> i32 #extern #export
QueueAccessibilityValue :: (focus_id: i32, generation: u64, value: const char*) -> i32 #extern #export
QueueAccessibilitySelection :: (focus_id: i32, generation: u64, anchor: i32, cursor: i32) -> i32 #extern #export
QueueAccessibilityItem :: (focus_id: i32, generation: u64, index: i32, selected: i32) -> i32 #extern #export

