ThemePolicy :: enum {
    ThemePolicySystem :: 0
    ThemePolicyLight :: 1
    ThemePolicyDark :: 2
}
using ThemePolicy;


#program_export
ResolveDark :: (policy: ThemePolicy, system_dark: bool) -> bool {
    if policy == cast(ThemePolicy)ThemePolicyLight { return false }
    if policy == cast(ThemePolicy)ThemePolicyDark { return true }
    return system_dark
}

// Canonical light/dark palette. Hosts only unpack these RGBA values.
Palette :: struct {
    background: u32
    surface: u32
    surface_raised: u32
    surface_sunken: u32
    overlay: u32
    text: u32
    text_muted: u32
    text_disabled: u32
    icon: u32
    icon_muted: u32
    border: u32
    border_strong: u32
    divider: u32
    focus: u32
    selection: u32
    accent: u32
    on_accent: u32
    accent_hover: u32
    accent_pressed: u32
    success: u32
    on_success: u32
    warning: u32
    on_warning: u32
    danger: u32
    on_danger: u32
    info: u32
    on_info: u32
    link: u32
    link_hover: u32
    shadow: u32
}

#program_export
PackedColor :: (rgb: u32, alpha: u32) -> u32 {
    return (rgb << cast(u32)8) | alpha
}

// Derived roles for the existing native theme APIs. Hosts supply their current
// palette and unpack the result; tone, contrast and fallback decisions live here.
Scheme :: struct {
    primary: u32
    on_primary: u32
    secondary: u32
    on_secondary: u32
    surface: u32
    on_surface: u32
    surface_container: u32
    surface_variant: u32
    on_surface_variant: u32
    outline: u32
    error: u32
    on_error: u32
    disabled_container: u32
    disabled_content: u32
}

#program_export
OnColor :: (color: u32) -> u32 {
    red: u32 = (color >> cast(u32)24) & cast(u32)255
    green: u32 = (color >> cast(u32)16) & cast(u32)255
    blue: u32 = (color >> cast(u32)8) & cast(u32)255
    luminance: u32 = (red * cast(u32)299 + green * cast(u32)587 + blue * cast(u32)114) / cast(u32)1000
    if luminance < cast(u32)128 {
        return PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
    }
    return PackedColor(cast(u32)0x1D1B20, cast(u32)255)
}

ClampChannel :: (value: s32) -> u32 {
    if value < 0 { return cast(u32)0 }
    if value > 255 { return cast(u32)255 }
    return cast(u32)value
}

#program_export
ToneFor :: (base: u32, light_delta: s32, dark_delta: s32, dark: bool) -> u32 {
    delta: s32 = dark_delta
    if !dark { delta = light_delta }
    // Clamp before negating or adding, including for extreme signed inputs.
    if delta < -255 { delta = -255 }
    if delta > 255 { delta = 255 }
    if !dark { delta = -delta }
    red: u32 = ClampChannel(cast(s32)((base >> cast(u32)24) & cast(u32)255) + delta)
    green: u32 = ClampChannel(cast(s32)((base >> cast(u32)16) & cast(u32)255) + delta)
    blue: u32 = ClampChannel(cast(s32)((base >> cast(u32)8) & cast(u32)255) + delta)
    return (red << cast(u32)24) | (green << cast(u32)16) | (blue << cast(u32)8) | (base & cast(u32)255)
}

#program_export
SchemeFor :: (background: u32, surface: u32, text: u32, primary: u32,
              secondary: u32, dark: bool, disabled_alpha: u8) -> Scheme {
    scheme: Scheme
    scheme.primary = primary
    scheme.on_primary = OnColor(primary)
    scheme.secondary = secondary
    scheme.on_secondary = OnColor(secondary)
    scheme.surface = surface
    if (surface & cast(u32)255) == cast(u32)0 { scheme.surface = background }
    scheme.on_surface = text
    scheme.surface_container = ToneFor(background, 4, 10, dark)
    scheme.surface_variant = ToneFor(background, 10, 18, dark)
    scheme.on_surface_variant = ToneFor(text, 34, 28, dark)
    scheme.outline = ToneFor(background, 44, 42, dark)
    scheme.error = PackedColor(cast(u32)0xBA1A1A, cast(u32)255)
    if dark { scheme.error = PackedColor(cast(u32)0xF2B8B5, cast(u32)255) }
    scheme.on_error = OnColor(scheme.error)
    scheme.disabled_container = (ToneFor(background, 14, 14, dark) & ~cast(u32)255) | cast(u32)disabled_alpha
    scheme.disabled_content = (text & ~cast(u32)255) | cast(u32)disabled_alpha
    return scheme
}

#program_export
DefaultPalette :: (dark: bool) -> Palette {
    palette: Palette
    if dark {
        palette.background = PackedColor(cast(u32)0x001D38, cast(u32)255)
        palette.surface = PackedColor(cast(u32)0x092039, cast(u32)255)
        palette.surface_raised = PackedColor(cast(u32)0x153858, cast(u32)255)
        palette.surface_sunken = PackedColor(cast(u32)0x04172B, cast(u32)255)
        palette.overlay = PackedColor(cast(u32)0x000000, cast(u32)217)
        palette.text = PackedColor(cast(u32)0xF5F8FF, cast(u32)255)
        palette.text_muted = PackedColor(cast(u32)0xA9BBD1, cast(u32)255)
        palette.text_disabled = PackedColor(cast(u32)0x72839A, cast(u32)255)
        palette.icon = PackedColor(cast(u32)0xD8E5F5, cast(u32)255)
        palette.icon_muted = PackedColor(cast(u32)0xA9BBD1, cast(u32)255)
        palette.border = PackedColor(cast(u32)0x315C85, cast(u32)255)
        palette.border_strong = PackedColor(cast(u32)0x315C85, cast(u32)255)
        palette.divider = PackedColor(cast(u32)0x315C85, cast(u32)255)
        palette.focus = PackedColor(cast(u32)0x409CFF, cast(u32)255)
        palette.selection = PackedColor(cast(u32)0x1E6DE0, cast(u32)255)
        palette.accent = PackedColor(cast(u32)0x006CFF, cast(u32)255)
        palette.on_accent = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.accent_hover = PackedColor(cast(u32)0x1689FF, cast(u32)255)
        palette.accent_pressed = PackedColor(cast(u32)0x0055D4, cast(u32)255)
        palette.success = PackedColor(cast(u32)0x009F7A, cast(u32)255)
        palette.on_success = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.warning = PackedColor(cast(u32)0xC88B00, cast(u32)255)
        palette.on_warning = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.danger = PackedColor(cast(u32)0xF0162A, cast(u32)255)
        palette.on_danger = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.info = PackedColor(cast(u32)0x168BD2, cast(u32)255)
        palette.on_info = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.link = PackedColor(cast(u32)0x00BBFF, cast(u32)255)
        palette.link_hover = PackedColor(cast(u32)0x8AC2FF, cast(u32)255)
        palette.shadow = PackedColor(cast(u32)0x000000, cast(u32)128)
    } else {
        palette.background = PackedColor(cast(u32)0xF8FBFF, cast(u32)255)
        palette.surface = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.surface_raised = PackedColor(cast(u32)0xEDF4FC, cast(u32)255)
        palette.surface_sunken = PackedColor(cast(u32)0xEAF2FC, cast(u32)255)
        palette.overlay = PackedColor(cast(u32)0x000000, cast(u32)102)
        palette.text = PackedColor(cast(u32)0x002553, cast(u32)255)
        palette.text_muted = PackedColor(cast(u32)0x536A83, cast(u32)255)
        palette.text_disabled = PackedColor(cast(u32)0x809BBB, cast(u32)255)
        palette.icon = PackedColor(cast(u32)0x183C63, cast(u32)255)
        palette.icon_muted = PackedColor(cast(u32)0x536A83, cast(u32)255)
        palette.border = PackedColor(cast(u32)0xC5DDF6, cast(u32)255)
        palette.border_strong = PackedColor(cast(u32)0xC5DDF6, cast(u32)255)
        palette.divider = PackedColor(cast(u32)0xC5DDF6, cast(u32)255)
        // A restrained violet-blue edge on pale material. Explicit focus
        // overrides retain their own alpha in the shared surface policy.
        palette.focus = PackedColor(cast(u32)0x064CFF, cast(u32)179)
        palette.selection = PackedColor(cast(u32)0xD8E9FF, cast(u32)255)
        palette.accent = PackedColor(cast(u32)0x006CFF, cast(u32)255)
        palette.on_accent = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.accent_hover = PackedColor(cast(u32)0x2184FF, cast(u32)255)
        palette.accent_pressed = PackedColor(cast(u32)0x0A4DB8, cast(u32)255)
        palette.success = PackedColor(cast(u32)0x00856A, cast(u32)255)
        palette.on_success = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.warning = PackedColor(cast(u32)0xB57800, cast(u32)255)
        palette.on_warning = PackedColor(cast(u32)0x211400, cast(u32)255)
        palette.danger = PackedColor(cast(u32)0xDC1524, cast(u32)255)
        palette.on_danger = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        palette.info = PackedColor(cast(u32)0x087CBF, cast(u32)255)
        palette.on_info = PackedColor(cast(u32)0xFFFFFF, cast(u32)255)
        // Link ink is a deeper blue than the luminous accent material.
        palette.link = PackedColor(cast(u32)0x0033FF, cast(u32)255)
        palette.link_hover = PackedColor(cast(u32)0x034BA9, cast(u32)255)
        palette.shadow = PackedColor(cast(u32)0x17324D, cast(u32)36)
    }
    return palette
}

Metrics :: struct {
    radius_small: float32
    radius_medium: float32
    radius_large: float32
    radius_pill: float32
    border_width: float32
    focus_width: float32
    focus_gap: float32
    space_1: float32
    space_2: float32
    space_3: float32
    space_4: float32
    space_5: float32
    space_6: float32
    control_height_small: float32
    control_height_medium: float32
    control_height_large: float32
    control_padding_small: float32
    control_padding_medium: float32
    control_padding_large: float32
    control_gap: float32
    font_size_small: float32
    font_size_medium: float32
    font_size_large: float32
    icon_size_small: float32
    icon_size_medium: float32
    icon_size_large: float32
    shadow_offset_y: float32
    shadow_blur: float32
    disabled_opacity: float32
    transition_fast_ms: float32
    transition_normal_ms: float32
}

#program_export
DefaultMetrics :: () -> Metrics {
    metrics: Metrics
    metrics.radius_small = 4.0
    metrics.radius_medium = 8.0
    metrics.radius_large = 12.0
    metrics.radius_pill = 999.0
    metrics.border_width = 1.0
    metrics.focus_width = 2.0
    metrics.focus_gap = 2.0
    metrics.space_1 = 4.0
    metrics.space_2 = 8.0
    metrics.space_3 = 12.0
    metrics.space_4 = 16.0
    metrics.space_5 = 24.0
    metrics.space_6 = 32.0
    metrics.control_height_small = 32.0
    metrics.control_height_medium = 40.0
    metrics.control_height_large = 48.0
    metrics.control_padding_small = 12.0
    metrics.control_padding_medium = 16.0
    metrics.control_padding_large = 20.0
    metrics.control_gap = 8.0
    metrics.font_size_small = 16.0
    metrics.font_size_medium = 18.0
    metrics.font_size_large = 20.0
    metrics.icon_size_small = 14.0
    metrics.icon_size_medium = 18.0
    metrics.icon_size_large = 20.0
    metrics.shadow_offset_y = 2.0
    metrics.shadow_blur = 8.0
    metrics.disabled_opacity = 0.45
    metrics.transition_fast_ms = 80.0
    metrics.transition_normal_ms = 140.0
    return metrics
}
