#import "ziran_mesh_noop_host"
#import "drawing_props"
#import "geometry"

texts: s32;
fills: s32;
failed: bool;
emphasis: bool;
typing: bool;
typed_values: [4]string;
typed_x: [4]s32;
linking: bool;
link_values: [8]string;
link_x: [8]s32;
link_y: [8]s32;
link_colors: [8]Color;
link_fills: [4]Rectangle;
link_fill_colors: [4]Color;

// Linked text records each painted piece and each underline.
#program_export
TextHostLinks :: () {
    linking = true
    typing = false
    emphasis = false
    texts = 0
    fills = 0
}

#program_export
TextHostLinkValue :: (index: s32) -> string {
    if index < 0 || index >= 8 { return "" }
    return link_values[index]
}

#program_export
TextHostLinkX :: (index: s32) -> s32 {
    if index < 0 || index >= 8 { return -1 }
    return link_x[index]
}

#program_export
TextHostLinkY :: (index: s32) -> s32 {
    if index < 0 || index >= 8 { return -1 }
    return link_y[index]
}

#program_export
TextHostLinkColor :: (index: s32) -> Color {
    if index < 0 || index >= 8 { return Color.{} }
    return link_colors[index]
}

#program_export
TextHostLinkFill :: (index: s32) -> Rectangle {
    if index < 0 || index >= 4 { return Rectangle.{} }
    return link_fills[index]
}

#program_export
TextHostLinkFillColor :: (index: s32) -> Color {
    if index < 0 || index >= 4 { return Color.{} }
    return link_fill_colors[index]
}

// Typed text records what each painted line shows and where it starts.
#program_export
TextHostTyping :: () {
    typing = true
    emphasis = false
    texts = 0
    fills = 0
}

#program_export
TextHostTypedValue :: (index: s32) -> string {
    if index < 0 || index >= 4 { return "" }
    return typed_values[index]
}

#program_export
TextHostTypedX :: (index: s32) -> s32 {
    if index < 0 || index >= 4 { return -1 }
    return typed_x[index]
}

#program_export
TextHostEmphasis :: () {
    emphasis = true
    texts = 0
    fills = 0
}

InkIsExpected :: (color: Color) -> bool {
    return color.r == cast(u8)0x11 && color.g == cast(u8)0x22 &&
    color.b == cast(u8)0x33 && color.a == cast(u8)127
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return (cast(s32)value.count) * 10
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    if font != 14 || typeface.count != 0 { failed = true }
    return 12
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value
    unused x
    unused y
    unused font
    unused color
    failed = true
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if linking {
        if texts < 8 {
            link_values[texts] = value
            link_x[texts] = x
            link_y[texts] = y
            link_colors[texts] = color
        }
        texts += 1
        return
    }
    if typing {
        if texts < 4 {
            typed_values[texts] = value
            typed_x[texts] = x
        }
        texts += 1
        return
    }
    if emphasis {
        values: [5]string = .["ab cd", "b cd", "é水", "é", "水"]
        positions: [5]s32 = .[0, 11, 0, 1, 21]
        if texts >= 5 {
            failed = true
            return
        }
        expected_y := ifx texts < 2 then 0 else 16
        if value != values[texts] || x != positions[texts] || y != expected_y ||
        font != 14 || !InkIsExpected(color) || clip.x != 0.0 || clip.y != 0.0 ||
        clip.width != 50.0 || clip.height != 28.0 {
            failed = true
        }
        texts += 1
        return
    }
    expected: string
    expected_x: s32
    expected_y: s32
    // The second line starts inside the 24-high box but ends 4 below it,
    // so it is drawn whole; the third starts below the box and is not.
    expected_height: float32 = 24.0
    if texts == 1 { expected_height = 28.0 }
    if texts == 0 {
        expected = "Alpha"
        expected_x = 10
        expected_y = 20
    } else if texts == 1 {
        expected = "beta"
        expected_x = 15
        expected_y = 36
    } else if texts == 2 {
        expected = "Gamma"
        expected_x = 10
        expected_y = 52
    } else {
        failed = true
    }
    if value != expected || x != expected_x || y != expected_y ||
    font != 14 || !InkIsExpected(color) ||
    clip.x != 10.0 || clip.y != 20.0 ||
    clip.width != 50.0 || clip.height != expected_height { failed = true }
    texts += 1
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if linking {
        if fills < 4 {
            link_fills[fills] = bounds
            link_fill_colors[fills] = color
        }
        if radius != 0.0 || segments != 1 { failed = true }
        fills += 1
        return
    }
    if fills >= 2 || texts != fills + 1 { failed = true }
    expected_x: float32 = 10.0
    expected_y: float32 = 26.0
    expected_width: float32 = 50.0
    if fills == 1 {
        expected_x = 15.0
        expected_y = 42.0
        expected_width = 40.0
    }
    if bounds.x != expected_x || bounds.y != expected_y ||
    bounds.width != expected_width || bounds.height != 1.0 ||
    radius != 0.0 || segments != 1 ||
    !InkIsExpected(color) { failed = true }
    fills += 1
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused bounds
    unused radius
    unused segments
    unused width
    unused color
    failed = true
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line
    unused color
    failed = true
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path
    unused texture_id
    unused source
    unused destination
    unused clip
    unused origin
    unused rotation
    unused radius
    unused tint
    failed = true
}

#program_export
TextHostFailed :: () -> bool { return failed }

#program_export
TextHostLabels :: () -> s32 { return texts }

#program_export
TextHostFills :: () -> s32 { return fills }
