// Browser fonts for the canvas backend. UI text is measured on a hidden 2D
// canvas and rasterised into cached whole-run atlases the GPU presenter
// draws as tinted textured quads. The low-level glyph API can also rasterise
// individual glyphs for the atlases owned by canvas_text.zi.
#import "page_core"
#import "page_gpu"
#import "page_texture"
#import "drawing_props"
#import "byte_text_linux"
#import "number_text"
#import "text_buffer"
#import "web"
#import "control_props"

page_font_c :: #system_library "c";
PageFontRunAlloc :: (size: usize) -> *void #foreign page_font_c "malloc";
PageFontRunFree :: (memory: *void) #foreign page_font_c "free";

using FontStyle;

PAGE_FONT_MAX :: 256

page_faces: [PAGE_FONT_MAX]s32;
page_face_count: s32;
page_glyph_canvas: s32;
page_glyph_context: s32;
page_glyph_options: s32;
page_font_bytes: [96]u8;

PageTextSize :: struct {
    face: s32
    size: s32
    weight: s32
    slant: FontStyle
    hundredths: s32
    ascent: float64
    descent: float64
}

PAGE_TEXT_SIZE_MAX :: 256
page_text_sizes: [PAGE_TEXT_SIZE_MAX]PageTextSize;
page_text_size_count: s32;
page_text_size_next: s32;

PageFontAppend :: (index: s32, text: string) -> s32 {
    at: s32 = index
    digit: s64 = 0
    while digit < text.count {
        page_font_bytes[at] = text[digit]
        at += 1
        digit += 1
    }
    return at
}

// A font-family-and-size shorthand such as "16.25px kryon-face-0" for a size
// in hundredths of a pixel; monospace stands in when there is no face.
PageFontSpec :: (hundredths: s32, face_id: s32, glyphs: TextGlyphStyle = TextGlyphStyle.{}) -> string {
    part: [24]u8
    index: s32 = 0
    if glyphs.style == cast(FontStyle)FontStyleItalic { index = PageFontAppend(index, "italic ") }
    if glyphs.style == cast(FontStyle)FontStyleOblique { index = PageFontAppend(index, "oblique ") }
    if glyphs.weight >= 1 && glyphs.weight <= 1000 {
        index = PageFontAppend(index, FormatInteger(glyphs.weight, part[:]))
        index = PageFontAppend(index, " ")
    }
    index = PageFontAppend(index, FormatInteger((hundredths / 100), part[:]))
    fraction: s32 = hundredths % 100
    page_font_bytes[index] = cast(u8)46
    page_font_bytes[index + 1] = cast(u8)(48 + fraction / 10)
    page_font_bytes[index + 2] = cast(u8)(48 + fraction % 10)
    index += 3
    if face_id > 0 {
        index = PageFontAppend(index, "px ")
        index = PageFontAppend(index, PageFaceFamily(face_id))
    } else {
        index = PageFontAppend(index, "px monospace")
    }
    page_font_bytes[index] = cast(u8)0
    return TextUntilNul(page_font_bytes[0:index + 1])
}

page_family_bytes: [40]u8;

// The family name a face id was registered under.
PageFaceFamily :: (face_id: s32) -> string {
    part: [24]u8
    prefix: string = "kryon-face-"
    index: s32 = 0
    while index < 11 {
        page_family_bytes[index] = prefix[index]
        index += 1
    }
    number: string = FormatInteger((face_id - 1), part[:])
    digit: s64 = 0
    while digit < number.count {
        page_family_bytes[index] = number[digit]
        index += 1
        digit += 1
    }
    page_family_bytes[index] = cast(u8)0
    return TextUntilNul(page_family_bytes[0:index + 1])
}

// Registers a font file with the page. Returns a 1-based face id, or 0.
PageFontFaceLoad :: (data: *u8, length: s32) -> s32 {
    PageInitNames()
    if page_face_count >= PAGE_FONT_MAX { return 0 }
    constructor: s32 = WebGetObject(WebGlobal, WebName("FontFace"))
    if constructor == 0 { return 0 }
    scope: s32 = WebScope()
    result: s32 = 0
    bytes: s32 = WebBytes(0, cast(*void)data, length)
    face: s32 = WebNew2(constructor, WebText(PageFaceFamily(page_face_count + 1)),
        WebObject(bytes))
    if face != 0 {
        loaded: WebValue
        promise: s32 = WebAsObject(WebCall0(face, WebName("load")))
        if promise != 0 && WebAwait(promise, *loaded) {
            fonts: s32 = WebGetObject(PageDocument(), WebName("fonts"))
            if fonts != 0 { unused WebCall1(fonts, WebName("add"), WebObject(face)) }
            page_faces[page_face_count] = WebKeep(face)
            page_face_count += 1
            result = page_face_count
        }
    }
    WebEnd(scope)
    return result
}

PageFontFaceRelease :: (id: s32) {
    if id <= 0 || id > page_face_count || page_faces[id - 1] == 0 { return }
    scope: s32 = WebScope()
    fonts: s32 = WebGetObject(PageDocument(), WebName("fonts"))
    if fonts != 0 {
        unused WebCall1(fonts, WebName("delete"), WebObject(page_faces[id - 1]))
    }
    WebRelease(page_faces[id - 1])
    page_faces[id - 1] = 0
    WebEnd(scope)
}

PageGlyphSurface :: () -> bool {
    if page_glyph_canvas != 0 { return true }
    canvas: s32 = 0
    document: s32 = PageDocument()
    if document != 0 {
        canvas = WebAsObject(WebCall1(document, page_names.create_element,
            WebText("canvas")))
    } else {
        canvas = PageMakeCanvas(64, 64)
    }
    if canvas == 0 { return false }
    page_glyph_canvas = WebKeep(canvas)
    options: s32 = WebNewObject()
    WebSet(options, WebName("willReadFrequently"), WebBool(true))
    page_glyph_options = WebKeep(options)
    return true
}

PageGlyphContext :: () -> s32 {
    context: s32 = WebAsObject(WebCall2(page_glyph_canvas, page_names.get_context,
        WebText("2d"), WebObject(page_glyph_options)))
    return context
}

// A measurement the browser reports, or `fallback` when it does not.
PageMeasured :: (metrics: s32, name: s32, fallback: float64) -> float64 {
    value: WebValue = WebGet(metrics, name)
    if WebIsUndefined(value) { return fallback }
    return WebAsNumber(value)
}

PageCeil :: (value: float64) -> s32 {
    whole: s32 = cast(s32)value
    if cast(float64)whole < value { whole += 1 }
    return whole
}

PageMaxOf :: (left: s32, right: s32) -> s32 {
    if left > right { return left }
    return right
}

// The CSS font size, in hundredths of a pixel, at which the face's ascent
// plus descent spans `size` pixels. Kryon lays text out like native, whose
// fonts are scaled to that pixel height, while a CSS size is the em size;
// browsers also disagree on a face's ascent and descent, so this is measured.
PageFontHundredths :: (context: s32, face_id: s32, size: s32, glyphs: TextGlyphStyle) -> s32 {
    WebSet(context, WebName("font"), WebText(PageFontSpec(size * 100, face_id, glyphs)))
    metrics: s32 = WebAsObject(WebCall1(context, WebName("measureText"),
        WebText("H")))
    size_value: float64 = cast(float64)size
    line: float64 = PageMeasured(metrics, WebName("fontBoundingBoxAscent"), size_value * 0.8) +
    PageMeasured(metrics, WebName("fontBoundingBoxDescent"), size_value * 0.2)
    if line < 1.0 { return size * 100 }
    hundredths: s32 = cast(s32)(size_value * size_value * 100.0 / line + 0.5)
    if hundredths < 100 { hundredths = 100 }
    return hundredths
}

// Measure and draw with the same browser font at its final logical size.
// The context's camera and device-pixel transform rasterise it directly at
// the output resolution instead of resampling a glyph atlas.
PageTextSizeFor :: (context: s32, face_id: s32, size: s32,
    glyphs: TextGlyphStyle = TextGlyphStyle.{}) -> PageTextSize {
    index: s32 = 0
    while index < page_text_size_count {
        cached := page_text_sizes[index]
        if cached.face == face_id && cached.size == size && cached.weight == glyphs.weight && cached.slant == glyphs.style {
            return cached
        }
        index += 1
    }
    result: PageTextSize
    result.face = face_id
    result.size = size
    result.weight = glyphs.weight
    result.slant = glyphs.style
    result.hundredths = PageFontHundredths(context, face_id, size, glyphs)
    WebSet(context, WebName("font"), WebText(PageFontSpec(result.hundredths, face_id, glyphs)))
    metrics := WebAsObject(WebCall1(context, WebName("measureText"), WebText("H")))
    result.ascent = PageMeasured(metrics, WebName("fontBoundingBoxAscent"),
        cast(float64)size * 0.8)
    result.descent = PageMeasured(metrics, WebName("fontBoundingBoxDescent"),
        cast(float64)size * 0.2)
    if page_text_size_count < PAGE_TEXT_SIZE_MAX {
        index = page_text_size_count
        page_text_size_count += 1
    } else {
        index = page_text_size_next
        page_text_size_next = (page_text_size_next + 1) % PAGE_TEXT_SIZE_MAX
    }
    page_text_sizes[index] = result
    return result
}

// Only styled calls use native letterSpacing, and they restore the previous
// drawing state when measuring or painting into a shared context.
PageTextTracking :: (context: s32, spacing: float32) -> WebValue {
    if spacing == 0.0 { return WebUndefined() }
    attribute := WebName("letterSpacing")
    previous := WebGet(context, attribute)
    if WebIsUndefined(previous) { return previous }
    part: [32]u8
    number := FormatDecimal(cast(float64)spacing, 6, part[:])
    count := PageFontAppend(0, number)
    count = PageFontAppend(count, "px")
    WebSet(context, attribute, WebText(TextView(page_font_bytes[:count])))
    return previous
}

PageTextWidth :: (face_id: s32, text: string, size: s32, weight: s32 = 0,
    slant: s32 = 0, spacing: float32 = 0.0) -> float64 {
    context := PageMeasureContext()
    if context == 0 || size <= 0 || text.count == 0 { return 0.0 }
    scope := WebScope()
    glyphs := TextGlyphStyle.{weight, cast(FontStyle)slant, spacing}
    style := PageTextSizeFor(context, face_id, size, glyphs)
    WebSet(context, WebName("font"), WebText(PageFontSpec(style.hundredths, face_id, glyphs)))
    previous := PageTextTracking(context, spacing)
    metrics := WebAsObject(WebCall1(context, WebName("measureText"), WebText(text)))
    width := WebGetNumber(metrics, WebName("width"))
    if !WebIsUndefined(previous) { WebSet(context, WebName("letterSpacing"), previous) }
    WebEnd(scope)
    return width
}

// A cached raster of one whole text run: white-on-transparent pixels at the
// output resolution, drawn as one tinted textured quad. `scale` is the
// device pixels per logical pixel the run was rasterised for.
PageTextRun :: struct {
    face: s32
    size: s32
    weight: s32
    slant: s32
    spacing: float32
    scale_hundredths: s32
    ascent: float64
    width: float64
    height: float64
    texture: s32
    generation: u64
    order: s32
    text: string
    text_memory: *void
}

PAGE_TEXT_RUN_MAX :: 128
PAGE_TEXT_RUN_BYTES :: 33554432
page_text_runs: [PAGE_TEXT_RUN_MAX]PageTextRun;
page_text_run_count: s32;
page_text_run_order: s32;
page_run_canvas: s32;
page_run_context: s32;

// Drops every cached run: the page is closing or starting over.
PageTextRunsClear :: () {
    while page_text_run_count > 0 { PageTextRunDrop(page_text_run_count - 1) }
    if page_run_context != 0 { WebRelease(page_run_context); page_run_context = 0 }
    if page_run_canvas != 0 { WebRelease(page_run_canvas); page_run_canvas = 0 }
}

PageTextRunBytes :: () -> float64 {
    total: float64 = 0.0
    index: s32 = 0
    while index < page_text_run_count {
        texture := page_text_runs[index].texture
        total += cast(float64)PageTextureWidthOf(texture) * cast(float64)PageTextureHeightOf(texture) * 4.0
        index += 1
    }
    return total
}

PageTextRunOldest :: () -> s32 {
    oldest: s32 = 0
    index: s32 = 1
    while index < page_text_run_count {
        if page_text_runs[index].order < page_text_runs[oldest].order { oldest = index }
        index += 1
    }
    return oldest
}

PageTextRunDrop :: (index: s32) {
    if page_text_runs[index].texture != 0 { PageTextureFree(page_text_runs[index].texture) }
    if page_text_runs[index].text_memory != null {
        PageTextureRelease(page_text_runs[index].text_memory)
    }
    page_text_run_count -= 1
    page_text_runs[index] = page_text_runs[page_text_run_count]
}

// Whether RUN holds exactly TEXT.
PageTextRunSame :: (run: string, text: string) -> bool {
    if run.count != text.count { return false }
    index: s64 = 0
    while index < text.count {
        if run[index] != text[index] { return false }
        index += 1
    }
    return true
}

// The hidden canvas a run is rasterised on, sized as the caller asks.
PageTextRunSurface :: (width: s32, height: s32) -> s32 {
    if page_run_canvas == 0 {
        canvas: s32 = PageMakeCanvas(width, height)
        if canvas == 0 { return 0 }
        options: s32 = WebNewObject()
        WebSet(options, WebName("willReadFrequently"), WebBool(true))
        context: s32 = WebAsObject(WebCall2(canvas, page_names.get_context,
            WebText("2d"), WebObject(options)))
        if context == 0 { return 0 }
        page_run_canvas = WebKeep(canvas)
        page_run_context = WebKeep(context)
    }
    if cast(s32)WebGetNumber(page_run_canvas, page_names.width) != width {
        WebSet(page_run_canvas, page_names.width, WebNumber(cast(float64)width))
    }
    if cast(s32)WebGetNumber(page_run_canvas, page_names.height) != height {
        WebSet(page_run_canvas, page_names.height, WebNumber(cast(float64)height))
    }
    return page_run_context
}

// The text run's atlas: a cached texture, or a fresh white-on-transparent
// raster the presenter tints when it draws.
PageTextRunTexture :: (face_id: s32, text: string, size: s32, weight: s32,
    slant: s32, spacing: float32, scale: float64, style: PageTextSize) -> s32 {
    hundredths: s32 = cast(s32)(scale * 100.0 + 0.5)
    if hundredths < 1 { hundredths = 1 }
    index: s32 = 0
    while index < page_text_run_count {
        run := page_text_runs[index]
        if run.face == face_id && run.size == size && run.weight == weight &&
        run.slant == slant && run.spacing == spacing &&
        run.scale_hundredths == hundredths && run.generation == PageGpuTextureGeneration() &&
        PageTextRunSame(run.text, text) {
            page_text_runs[index].order = page_text_run_order
            page_text_run_order += 1
            return index
        }
        index += 1
    }
    // Rasterise the run at its output resolution: one pixel of atlas per
    // device pixel the quad covers, like the 2D host's direct fillText.
    run_width := PageTextWidth(face_id, text, size, weight, slant, spacing)
    margin: float64 = 2.0 / scale
    device_w: s32 = PageCeil(run_width * scale + margin * 2.0 * scale) + 1
    line: float64 = style.ascent + style.descent
    device_h: s32 = PageCeil(line * scale + margin * 2.0 * scale) + 1
    if device_w <= 0 || device_h <= 0 || device_w > 16384 || device_h > 16384 ||
    cast(s64)device_w * cast(s64)device_h * 4 > cast(s64)PAGE_TEXT_RUN_BYTES { return -1 }
    context := PageTextRunSurface(device_w, device_h)
    if context == 0 { return -1 }
    scope := WebScope()
    glyphs := TextGlyphStyle.{weight, cast(FontStyle)slant, spacing}
    raster_hundredths := cast(s32)(cast(float64)style.hundredths * scale + 0.5)
    WebSet(context, WebName("font"), WebText(PageFontSpec(raster_hundredths, face_id, glyphs)))
    previous := PageTextTracking(context, cast(float32)(cast(float64)spacing * scale))
    WebSet(context, WebName("textBaseline"), WebText("alphabetic"))
    WebSet(context, WebName("textAlign"), WebText("left"))
    WebSet(context, page_names.fill_style, WebText(PageColor(255, 255, 255, 255)))
    unused WebCall4(context, WebName("clearRect"), WebNumber(0.0), WebNumber(0.0),
        WebNumber(cast(float64)device_w), WebNumber(cast(float64)device_h))
    unused WebCall3(context, WebName("fillText"), WebText(text),
        WebNumber(margin * scale), WebNumber(margin * scale + style.ascent * scale))
    if !WebIsUndefined(previous) { WebSet(context, WebName("letterSpacing"), previous) }
    pixels := cast(*u8)PageFontRunAlloc(cast(usize)(device_w * device_h * 4))
    ok := false
    if pixels != null {
        image := WebAsObject(WebCall4(context, WebName("getImageData"),
            WebNumber(0.0), WebNumber(0.0), WebNumber(cast(float64)device_w),
            WebNumber(cast(float64)device_h)))
        data := WebGetObject(image, WebName("data"))
        if data != 0 {
            unused WebCopyOut(data, cast(*void)pixels, device_w * device_h * 4)
            ok = true
        }
    }
    WebEnd(scope)
    if !ok {
        if pixels != null { PageTextureRelease(cast(*void)pixels) }
        return -1
    }
    texture := PageTextureFromRgba(pixels, device_w, device_h)
    PageTextureRelease(cast(*void)pixels)
    if texture == 0 { return -1 }
    if page_text_run_count >= PAGE_TEXT_RUN_MAX { PageTextRunDrop(PageTextRunOldest()) }
    while PageTextRunBytes() + cast(float64)device_w * cast(float64)device_h * 4.0 >
    cast(float64)PAGE_TEXT_RUN_BYTES && page_text_run_count > 0 {
        PageTextRunDrop(PageTextRunOldest())
    }
    if page_text_run_count >= PAGE_TEXT_RUN_MAX { PageTextureFree(texture); return -1 }
    memory: *void = PageFontRunAlloc(cast(usize)(text.count + 1))
    if memory == null {
        PageTextureFree(texture)
        return -1
    }
    stored_bytes := cast(*u8)memory
    at: s64 = 0
    while at < text.count { stored_bytes[at] = text[at]; at += 1 }
    stored_bytes[at] = cast(u8)0
    stored := TextFromBytes(BytesFromPointer(stored_bytes, cast(u64)text.count))
    slot := page_text_run_count
    page_text_run_count += 1
    page_text_run_order += 1
    page_text_runs[slot] = PageTextRun.{face_id, size, weight, slant, spacing,
        hundredths, style.ascent, run_width, line, texture,
        PageGpuTextureGeneration(), page_text_run_order, stored, memory}
    return slot
}

PageTextDraw :: (face_id: s32, text: string, x: s32, y: s32, size: s32,
    r: s32, g: s32, b: s32, a: s32, weight: s32 = 0, slant: s32 = 0, spacing: float32 = 0.0) {
    if size <= 0 || text.count == 0 { return }
    context := PageMeasureContext()
    if context == 0 { return }
    glyphs := TextGlyphStyle.{weight, cast(FontStyle)slant, spacing}
    style := PageTextSizeFor(context, face_id, size, glyphs)
    scale := PageGpuMatrixScale()
    if scale <= 0.0 { return }
    slot := PageTextRunTexture(face_id, text, size, weight, slant, spacing, scale, style)
    if slot < 0 { return }
    run := page_text_runs[slot]
    // The quad covers the raster exactly: margins included, so ink outside
    // the measured line box still shows.
    texel := 1.0 / scale
    width := cast(float64)PageTextureWidthOf(run.texture)
    height := cast(float64)PageTextureHeightOf(run.texture)
    PageDrawTexture(run.texture, 0.0, 0.0, width, height,
        cast(float64)x - 2.0 * texel, cast(float64)y - 2.0 * texel,
        width * texel, height * texel, 0.0, 0.0, 0.0,
        r, g, b, a, 1)
}

// TEXT at SIZE in the given colour, centred on a transparent WIDTH by HEIGHT
// canvas in the same browser face as drawn text: straight RGBA into PIXELS
// (at least WIDTH * HEIGHT * 4 bytes), for text used as a texture.
PageTextPixels :: (face_id: s32, text: string, size: s32, r: s32, g: s32, b: s32, a: s32,
    width: s32, height: s32, pixels: []u8) -> bool {
    if size <= 0 || width <= 0 || height <= 0 || width > 4096 || height > 4096 ||
        pixels.count < cast(s64)width * cast(s64)height * 4 { return false }
    scope := WebScope()
    defer WebEnd(scope)
    canvas := PageMakeCanvas(width, height)
    if canvas == 0 { return false }
    context := PageContext2D(canvas)
    if context == 0 { return false }
    style := PageTextSizeFor(context, face_id, size)
    WebSet(context, WebName("font"), WebText(PageFontSpec(style.hundredths, face_id)))
    WebSet(context, WebName("textBaseline"), WebText("middle"))
    WebSet(context, WebName("textAlign"), WebText("center"))
    WebSet(context, page_names.fill_style, WebText(PageColor(r, g, b, a)))
    unused WebCall3(context, WebName("fillText"), WebText(text),
        WebNumber(cast(float64)width / 2.0), WebNumber(cast(float64)height / 2.0))
    image := WebAsObject(WebCall4(context, WebName("getImageData"), WebNumber(0.0), WebNumber(0.0),
        WebNumber(cast(float64)width), WebNumber(cast(float64)height)))
    data := WebGetObject(image, WebName("data"))
    if data == 0 { return false }
    unused WebCopyOut(data, cast(*void)*pixels[0], width * height * 4)
    return true
}

PageRound :: (value: float64) -> s32 {
    if value < 0.0 { return 0 - cast(s32)(0.5 - value) }
    return cast(s32)(value + 0.5)
}

// Rasterises one glyph as white-on-transparent RGBA into `pixels`. Returns 1
// and fills the metrics, or 0 when the glyph does not fit. As in native, the
// line box is `size` pixels tall with the baseline at the face's ascent, and
// offset_y places the bitmap's top relative to the top of that box.
PageGlyphMetrics :: (face_id: s32, codepoint: s32, size: s32, advance: *s32,
    width: *s32, height: *s32, offset_x: *s32, offset_y: *s32, pixels: *u8) -> s32 {
    PageInitNames()
    if !PageGlyphSurface() { return 0 }
    scope: s32 = WebScope()
    ok: s32 = 0
    context: s32 = PageGlyphContext()
    if context != 0 {
        font: string = PageFontSpec(PageFontHundredths(context, face_id, size, .{}), face_id)
        WebSet(context, WebName("font"), WebText(font))
        WebSet(context, WebName("textBaseline"), WebText("alphabetic"))
        character: s32 = WebAsObject(WebCall1(WebGetObject(WebGlobal, WebName("String")),
            WebName("fromCodePoint"), WebNumber(cast(float64)codepoint)))
        metrics: s32 = WebAsObject(WebCall1(context, WebName("measureText"),
            WebObject(character)))
        size_value: float64 = cast(float64)size
        measured_width: float64 = WebGetNumber(metrics, WebName("width"))
        advance_x: s32 = PageRound(measured_width)
        glyph_ascent: s32 = PageCeil(PageMeasured(metrics,
            WebName("actualBoundingBoxAscent"), size_value * 0.8))
        glyph_descent: s32 = PageCeil(PageMeasured(metrics,
            WebName("actualBoundingBoxDescent"), 2.0))
        font_ascent: s32 = PageRound(PageMeasured(metrics,
            WebName("fontBoundingBoxAscent"), size_value * 0.8))
        fallback_descent: float64 = size_value * 0.2
        if fallback_descent < 2.0 { fallback_descent = 2.0 }
        font_descent: s32 = PageCeil(PageMeasured(metrics,
            WebName("fontBoundingBoxDescent"), fallback_descent))
        baseline: s32 = PageMaxOf(font_ascent, glyph_ascent) + 1
        left: s32 = PageCeil(PageMeasured(metrics, WebName("actualBoundingBoxLeft"), 0.0))
        right: s32 = PageCeil(PageMeasured(metrics, WebName("actualBoundingBoxRight"),
            measured_width))
        glyph_width: s32 = PageMaxOf(right + left + 2, 1)
        glyph_height: s32 = PageMaxOf(baseline + PageMaxOf(font_descent, glyph_descent) + 1, 1)
        if glyph_width <= 256 && glyph_height <= 256 {
            surface_width: s32 = cast(s32)WebGetNumber(page_glyph_canvas, page_names.width)
            surface_height: s32 = cast(s32)WebGetNumber(page_glyph_canvas, page_names.height)
            if surface_width < glyph_width || surface_height < glyph_height {
                WebSet(page_glyph_canvas, page_names.width,
                    WebNumber(cast(float64)PageMaxOf(surface_width, glyph_width)))
                WebSet(page_glyph_canvas, page_names.height,
                    WebNumber(cast(float64)PageMaxOf(surface_height, glyph_height)))
                context = PageGlyphContext()
                WebSet(context, WebName("font"), WebText(font))
                WebSet(context, WebName("textBaseline"), WebText("alphabetic"))
            }
            unused WebCall4(context, WebName("clearRect"), WebNumber(0.0),
                WebNumber(0.0), WebNumber(cast(float64)glyph_width),
                WebNumber(cast(float64)glyph_height))
            WebSet(context, page_names.fill_style, WebText("#fff"))
            unused WebCall3(context, WebName("fillText"), WebObject(character),
                WebNumber(cast(float64)(left + 1)), WebNumber(cast(float64)baseline))
            image: s32 = WebAsObject(WebCall4(context, WebName("getImageData"),
                WebNumber(0.0), WebNumber(0.0), WebNumber(cast(float64)glyph_width),
                WebNumber(cast(float64)glyph_height)))
            if image != 0 && !WebFailed() {
                data: s32 = WebGetObject(image, WebName("data"))
                unused WebCopyOut(data, cast(*void)pixels, glyph_width * glyph_height * 4)
                advance.* = advance_x
                width.* = glyph_width
                height.* = glyph_height
                offset_x.* = 0 - (left + 1)
                offset_y.* = font_ascent - baseline
                ok = 1
            }
        }
    }
    WebEnd(scope)
    return ok
}
