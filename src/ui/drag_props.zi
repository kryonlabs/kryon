#import "geometry"
#import "input_props"

DragMode :: enum {
    DragValue :: 0
    DragRange :: 1
}

DragProps :: struct {
    bounds: Rectangle
    id: s32
    class_name: s32
    label: string
    kind: NumericValueKind
    mode: DragMode
    float_values: *float32
    int_values: *s32
    value_count: s32
    float_min: *float32
    float_max: *float32
    int_min: *s32
    int_max: *s32
    speed: float32
    min: float64
    max: float64
    format: string
    format_max: string
    disabled: bool
}
