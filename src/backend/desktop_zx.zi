#import "cairo_raster"
#import "desktop_runtime"
#import "frame_driver"
#import "session"
#import "tree_input"
#import "geometry"
#import "hosted_values"
#import "drawing_props"
#import "program_title"
#import "vec"
#import "file_linux"
#import "bundle_media"
#import "bundle_app"
Video :: #import "video_linux";
Bitmaps :: #import "bitmap_image";
UiTheme :: #import "theme";
#if OS == .LINUX {
    Service :: #import "service_linux";
    Theme :: #import "system_theme_host_linux";
    Background :: #import "background_window_linux";
    WebView :: #import "webview_linux";
    DesktopMedia :: #import "desktop_media_linux";
}
Watch :: #import "bundle_watch";
AppPlayer :: #import "app_player";
WindowPlayer :: #import "window_player";
WindowBundles :: #import "zx_window_bundle";
#import "timer_linux"
Native :: #import "std/guest_host";

PlayerOptions :: struct { check: bool }

#scope_module
using HostValueKind;
libc :: #system_library "libc";
ChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";
SaveDirectory :: (path: *u8, flags: s32, mode: ..any) -> s32 #foreign libc "open";
SetDirectoryFlags :: (descriptor: s32, command: s32, flags: ..any) -> s32 #foreign libc "fcntl";
RestoreDirectory :: (descriptor: s32) -> s32 #foreign libc "fchdir";
CloseDirectoryDescriptor :: (descriptor: s32) -> s32 #foreign libc "close";
SET_FD_FLAGS :: 2;
CLOSE_ON_EXEC :: 1;
TemporaryDirectory :: (path: *u8) -> *u8 #foreign libc "mkdtemp";
PlayerEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
RemoveDirectory :: (path: *u8) -> s32 #foreign libc "rmdir";
PlayerReadlink :: (path: *u8, output: *u8, count: u64) -> s64 #foreign libc "readlink";
Name :: struct { bytes: [128]u8 }
Player :: struct {
    editor_fields: [5]HostField
    fields: [14]HostField
    names: [29]Name
    // A raw bundle has no UI session; this one receives the window's ordered
    // keys and text, and the bundle reads one key and its modifiers a frame.
    input: Session
    key: s32
    modifiers: s32
    media: BundleMedia
    closed: bool
    // The bundle owns its event loop. Between its frames the player finishes
    // the previous one, paces, and takes the window's next events; the input
    // record's stop flag ends the loop.
    frames: s32
    ui: bool
    reload_due: bool
    reload_at: s64
    watch_path: string
    // The generic guest host base: per-instance state whose answer bytes
    // the host borrows between calls, with argv[0] owned by the player.
    guest: Native.State
    guest_path: [4096]u8
    guest_argv: [1]*u8
}

Names :: #import "bundle_names";
ModuleName :: (value: string, name: string) -> bool { return Names.ModuleName(value, name) }

// Binds one instance's generic guest host state: argv[0] is the bundle path
// in player-owned storage, and the answer bytes reset with the state.
BindGuestHost :: (player: *Player, bundle: *void, path: string) -> bool {
    if path.count + 1 > player.guest_path.count { return false }
    if !CopyCString(path, player.guest_path[:]) { return false }
    player.guest = Native.State.{}
    player.guest.bundle = bundle
    player.guest.argc = 1
    player.guest_argv[0] = *player.guest_path[0]
    player.guest.argv = *player.guest_argv[0]
    return true
}

#load "bundle_player_shared.zi";

Supported :: (module: string, function: string) -> bool {
    if Native.Provides(module, function) { return true }
    if ModuleName(module, "clock") { return function == "ClockMillisecondsHost" }
    if ModuleName(module, "video") {
        return function == "VideoOpenHost" || function == "VideoPauseHost" || function == "VideoStopHost" ||
            function == "VideoStateHost" || function == "VideoPositionHost" || function == "VideoDurationHost" ||
            function == "VideoSeekHost" || function == "VideoSpeedHost" || function == "VideoVolumeHost" ||
            function == "VideoLeaseHost" || function == "VideoFrameHost" || function == "VideoMessageHost"
    }
    if ModuleName(module, "frames_zx") {
        return function == "BundleWindowHost" || function == "ReadBundleInput" ||
            function == "TakeBundleCodepoint" ||
            function == "BundleTextInputHost" || function == "BundleFrameFinishedHost" ||
            function == "BundleFrameReusableHost" || function == "BundleFrameCursorHost" ||
            function == "BundleWakeAtHost" || function == "BundleCloseHost" ||
            function == "BundleTextEditorHost" || function == "BundleTextRequestHost"
    }
    if ModuleName(module, "font_metrics") {
        return function == "MeasureGlyphWidth" || function == "MeasureGlyphLineHeight"
    }
    if ModuleName(module, "raster_text") {
        return function == "RasterText" || function == "RasterTextClipped" || function == "RasterTextRotated"
    }
    if ModuleName(module, "raster_shape") {
        return function == "RasterRoundedRectangle" ||
        function == "RasterRoundedRectangleOutline"
    }
    if ModuleName(module, "raster") { return function == "RasterLine" }
    if ModuleName(module, "raster_triangles") { return function == "RasterTriangles" }
    if ModuleName(module, "paint_queue") {
        return function == "RasterImage" || function == "RasterImageMesh"
    }
    if ModuleName(module, "cursor_picture") { return function == "CursorPictureHost" }
    if ModuleName(module, "image_raster") {
        return function == "ImageWidth" || function == "ImageHeight"
    }
    if ModuleName(module, "system_clipboard") {
        return function == "SystemClipboardOpenHost" ||
        function == "SystemClipboardByteHost" ||
        function == "SystemClipboardWriteHost"
    }
    if ModuleName(module, "window") {
        #if OS == .LINUX {
            if function == "WindowCompactHost" || function == "WindowBackgroundHost" || function == "WindowBackgroundDragHost" { return true }
        }
        return function == "WindowSetVisibleHost" || function == "WindowVisibleHost" || function == "WindowFocusedHost" ||
        function == "WindowInterceptCloseHost" ||
        function == "WindowTakeCloseRequestHost" || function == "WindowQuitHost"
    }
    if ModuleName(module, "media") {
        return function == "MediaOpenHost" || function == "MediaPauseHost" ||
            function == "MediaStopHost" || function == "MediaStateHost" ||
            function == "MediaMessageHost" || function == "FetchTextHost" ||
            function == "FetchTextStateHost" || function == "FetchTextResultHost"
    }
    #if OS == .LINUX {
        if ModuleName(module, "webview") {
            return function == "WebViewOpenHost" || function == "WebViewBoundsHost" ||
                function == "WebViewSendHost" || function == "WebViewEventHost" ||
                function == "WebViewCloseHost"
        }
    }
    if ModuleName(module, "bitmap_image") {
        return function == "BitmapImageCreateHost" || function == "BitmapImageUpdateHost" || function == "BitmapImageReleaseHost"
    }
    #if OS == .LINUX {
        if ModuleName(module, "service") {
            return function == "ServiceRequestHost" || function == "ServiceStateHost" || function == "ServiceResultHost"
        }
        if ModuleName(module, "system_theme_host") { return function == "SystemThemeColorHost" }
    }
    return false
}

PlayerCall :: (context: *void, module_name: *u8, function_name: *u8,
    args: *HostValue, count: s32, result: *HostValue) -> s32 {
    player := cast(*Player)context
    module := TextFromCString(module_name)
    function := TextFromCString(function_name)
    if !Supported(module, function) { return 0 }
    result.kind = HostVoid
    if Native.Provides(module, function) {
        return Native.Call(*player.guest, module, function, args, count, result)
    }
    if ModuleName(module, "media") {
        #if OS == .LINUX {
            return DesktopMedia.DesktopMediaCall(*player.media, function, args, count, result)
        }
        return BundleMediaCall(*player.media, module, function, args, count, result)
    }
    #if OS == .LINUX {
    if ModuleName(module, "webview") {
        if function == "WebViewOpenHost" && count == 5 && args[0].kind == HostString &&
        args[1].kind == HostInteger && args[2].kind == HostInteger &&
        args[3].kind == HostInteger && args[4].kind == HostInteger {
            result.kind = HostInteger
            result.integer = cast(s64)WebView.WebViewOpenHost(TextValue(args[0]), cast(s32)args[1].integer, cast(s32)args[2].integer, cast(s32)args[3].integer, cast(s32)args[4].integer)
            return 1
        }
        if function == "WebViewBoundsHost" && count == 5 && args[0].kind == HostInteger &&
        args[1].kind == HostInteger && args[2].kind == HostInteger &&
        args[3].kind == HostInteger && args[4].kind == HostInteger {
            WebView.WebViewBoundsHost(cast(s32)args[0].integer, cast(s32)args[1].integer, cast(s32)args[2].integer, cast(s32)args[3].integer, args[4].integer != 0)
            return 1
        }
        if function == "WebViewSendHost" && count == 1 && args[0].kind == HostString {
            result.kind = HostInteger; result.integer = cast(s64)WebView.WebViewSendHost(TextValue(args[0])); return 1
        }
        if function == "WebViewEventHost" && count == 0 {
            value := WebView.WebViewEventHost()
            result.kind = HostString; result.length = cast(usize)value.count
            descriptor := cast(*TextDescriptor)(*value)
            result.data = descriptor.data; return 1
        }
        if function == "WebViewCloseHost" && count == 0 { WebView.WebViewCloseHost(); return 1 }
    }
    }
    if ModuleName(module, "clock") && function == "ClockMillisecondsHost" && count == 0 {
        result.kind = HostInteger; result.integer = MonotonicMilliseconds(); return 1
    }
    if ModuleName(module, "video") {
        if function == "VideoOpenHost" && count == 1 && args[0].kind == HostString { result.kind = HostInteger; result.integer = cast(s64)Video.VideoOpenHost(TextValue(args[0])); return 1 }
        if count == 0 {
            if function == "VideoPauseHost" { Video.VideoPauseHost(); return 1 }
            if function == "VideoStopHost" { Video.VideoStopHost(); return 1 }
            if function == "VideoFrameHost" || function == "VideoMessageHost" {
                value := ifx function == "VideoFrameHost" then Video.VideoFrameHost() else Video.VideoMessageHost()
                descriptor := cast(*TextDescriptor)(*value)
                result.kind = HostString; result.data = descriptor.data; result.length = cast(usize)value.count; return 1
            }
            result.kind = HostInteger
            if function == "VideoStateHost" { result.integer = cast(s64)Video.VideoStateHost(); return 1 }
            if function == "VideoPositionHost" { result.integer = Video.VideoPositionHost(); return 1 }
            if function == "VideoDurationHost" { result.integer = Video.VideoDurationHost(); return 1 }
        }
        if count == 1 && args[0].kind == HostInteger {
            if function == "VideoSeekHost" { result.kind = HostInteger; result.integer = cast(s64)Video.VideoSeekHost(args[0].integer); return 1 }
            if args[0].integer >= 0 && args[0].integer <= 10000 {
                if function == "VideoSpeedHost" { result.kind = HostInteger; result.integer = cast(s64)Video.VideoSpeedHost(cast(s32)args[0].integer); return 1 }
                if function == "VideoVolumeHost" { Video.VideoVolumeHost(cast(s32)args[0].integer); return 1 }
                if function == "VideoLeaseHost" { Video.VideoLeaseHost(cast(s32)args[0].integer); return 1 }
            }
        }
        return 0
    }
    #if OS == .LINUX {
    if function == "SystemThemeColorHost" && count == 1 && args[0].kind == HostInteger {
        result.kind = HostUnsigned; result.bits = cast(u64)Theme.SystemThemeColorHost(cast(s32)args[0].integer); return 1
    }
    }
    // This desktop player has no native snapshot editor. Its ordinary key
    // and Unicode path remains active; optional editor requests are empty.
    if function == "BundleTextEditorHost" && count == 5 && args[0].kind == HostUnsigned &&
    args[1].kind == HostString && args[1].length <= cast(usize)65536 &&
    args[2].kind == HostInteger && args[3].kind == HostInteger && args[4].kind == HostInteger { return 1 }
    if function == "BundleTextRequestHost" && count == 1 && args[0].kind == HostUnsigned {
        player.editor_fields[0] = HostField.{HostTextData("value"), HostValue.{.kind = HostString,
            .type_name = HostTextData("string")}}
        player.editor_fields[1] = HostField.{HostTextData("cursor"), HostScalar("s32", 0)}
        player.editor_fields[2] = HostField.{HostTextData("anchor"), HostScalar("s32", 0)}
        player.editor_fields[3] = HostField.{HostTextData("replace"), HostScalar("bool", 0)}
        player.editor_fields[4] = HostField.{HostTextData("pending"), HostScalar("bool", 0)}
        result.* = HostRecordValue("TextRequest", player.editor_fields[:])
        return 1
    }
    if function=="BundleTextInputHost" && count==1 && args[0].kind==HostInteger { return 1 }
    if function == "BundleFrameReusableHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)DesktopFrameReusable()
        return 1
    }
    if function == "BundleFrameFinishedHost" && count == 1 && args[0].kind == HostInteger {
        DesktopFrameUnchanged(args[0].integer != 0)
        return 1
    }
    if function == "BundleWakeAtHost" && count == 1 && HostScalarValid(args[0], "float64", HostReal) {
        DesktopWakeAt(args[0].real)
        return 1
    }
    if function == "BundleCloseHost" && count == 0 {
        DesktopWakeAt(-1.0)
        TreeInputReset(player.input)
        player.frames = 0
        player.key = 0
        player.modifiers = 0
        return 1
    }
    // The bundle resolved its tree's cursor; apply it on the player's window.
    if function == "BundleFrameCursorHost" && count == 7 && args[0].kind == HostInteger &&
    args[1].kind == HostString && args[1].length <= cast(usize)4096 &&
    args[2].kind == HostInteger && args[3].kind == HostInteger &&
    args[4].kind == HostInteger && args[5].kind == HostInteger &&
    args[6].kind == HostInteger {
        asset: string
        if args[1].length > 0 { asset = TextFromBytes(BytesFromPointer(args[1].data, cast(u64)args[1].length)) }
        cursor := FrameCursor.{asset, cast(s32)args[2].integer,
            cast(s32)args[3].integer, cast(s32)args[4].integer, cast(s32)args[5].integer,
            args[6].integer != 0, cast(s32)args[0].integer}
        unused DesktopCursorApply(cursor)
        return 1
    }
    // A bundle's runtime pictures, owned by the session the player runs.
    if function == "BitmapImageCreateHost" && count == 3 && args[0].kind == HostInteger && args[1].kind == HostInteger && args[2].kind == HostString {
        result.kind = HostUnsigned; result.bits = 0
        width := args[0].integer; height := args[1].integer
        if width > 0 && height > 0 && width <= 4096 && height <= 4096 && cast(s64)args[2].length == width * height * 4 {
            result.bits = cast(u64)Bitmaps.BitmapImageCreate(player.input, cast(s32)width, cast(s32)height, BytesFromPointer(args[2].data, cast(u64)args[2].length)).id
        }
        return 1
    }
    if function == "BitmapImageUpdateHost" && count == 4 && args[0].kind == HostUnsigned && args[1].kind == HostInteger && args[2].kind == HostInteger && args[3].kind == HostString {
        image := Texture2D.{.id = cast(u32)args[0].bits, .width = cast(s32)args[1].integer, .height = cast(s32)args[2].integer, .mipmaps = 1, .format = 7}
        result.kind = HostInteger; result.integer = ifx Bitmaps.BitmapImageUpdate(player.input, image, BytesFromPointer(args[3].data, cast(u64)args[3].length)) then 1 else 0
        return 1
    }
    if function == "BitmapImageReleaseHost" && count == 3 && args[0].kind == HostUnsigned && args[1].kind == HostInteger && args[2].kind == HostInteger {
        Bitmaps.BitmapImageRelease(player.input, Texture2D.{.id = cast(u32)args[0].bits, .width = cast(s32)args[1].integer, .height = cast(s32)args[2].integer, .mipmaps = 1, .format = 7})
        return 1
    }
    #if OS == .LINUX {
    if function == "ServiceRequestHost" && count == 2 && args[0].kind == HostString && args[1].kind == HostString {
        result.kind = HostInteger
        result.integer = cast(s64)Service.ServiceRequestHost(TextValue(args[0]), TextValue(args[1]))
        return 1
    }
    if function == "ServiceStateHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)Service.ServiceStateHost()
        return 1
    }
    if function == "ServiceResultHost" && count == 0 {
        value := Service.ServiceResultHost()
        result.kind = HostString
        descriptor := cast(*TextDescriptor)(*value)
        result.data = descriptor.data
        result.length = cast(usize)value.count
        return 1
    }
    if count == 0 && function == "WindowCompactHost" {
        result.kind = HostInteger
        result.integer = cast(s64)Background.WindowCompactHost()
        return 1
    }
    if function == "WindowBackgroundDragHost" && count == 1 && args[0].kind == HostInteger {
        Background.WindowBackgroundDragHost(args[0].integer != 0)
        return 1
    }
    if function == "WindowBackgroundHost" && count == 4 && args[0].kind == HostInteger &&
        args[1].kind == HostInteger && args[2].kind == HostInteger && args[3].kind == HostInteger {
        Background.WindowBackgroundHost(cast(s32)args[0].integer, cast(s32)args[1].integer, cast(s32)args[2].integer, cast(s32)args[3].integer)
        return 1
    }
    }
    if function == "BundleWindowHost" {
        if !WindowRequestValid(args, count) { return 0 }
        player.closed = false
        result.kind = HostInteger
        result.integer = cast(s64)(DesktopSetTitle(TextValue(args[0])) &&
            ResizeDesktop(cast(s32)args[1].integer, cast(s32)args[2].integer))
        return 1
    }
    if function == "ReadBundleInput" && count == 0 {
        ok := true
        // Between frames: finish the previous one, then pace and take the
        // window's next events. A capture renders two frames and stops.
        if player.frames > 0 {
            ok = EndDesktopFrame()
            if ok && !CaptureRequested() { PauseDesktop() }
        }
        if ok && !CaptureRequested() { ok = PollDesktop() }
        if ok && CaptureRequested() && player.frames >= 2 { ok = false }
        if ok && !CaptureRequested() && player.watch_path != "" {
            now := MonotonicMilliseconds()
            if now >= player.reload_at {
                player.reload_at = now + 1000
                player.reload_due = true
                ok = false
            }
        }
        if !ok {
            player.closed = true
            player.fields[13].value.integer = 1
            result.kind = HostRecord
            result.type_name = *player.names[28].bytes[0]
            result.fields = *player.fields[0]
            result.field_count = cast(usize)14
            return 1
        }
        key, modifiers := DesktopInputTake(player.input)
        player.key = key
        player.modifiers = modifiers
        BundleMediaTick(*player.media)
        #if OS == .LINUX {
            WebView.WebViewTickHost()
        }
        BeginDesktopFrame()
        SetRasterBackground(BundleThemeBackground)
        viewport := DesktopViewport()
        pointer := PollPointer()
        secondary := PollSecondaryPointer()
        player.fields[0].value.integer = cast(s64)viewport.width
        player.fields[1].value.integer = cast(s64)viewport.height
        player.fields[2].value.real = cast(float64)pointer.x
        player.fields[3].value.real = cast(float64)pointer.y
        player.fields[4].value.integer = cast(s64)pointer.down
        player.fields[5].value.integer = cast(s64)pointer.pressed
        player.fields[6].value.integer = cast(s64)pointer.released
        player.fields[7].value.integer = cast(s64)secondary.down
        player.fields[8].value.integer = cast(s64)secondary.pressed
        player.fields[9].value.integer = cast(s64)secondary.released
        player.fields[10].value.integer = cast(s64)player.modifiers
        player.fields[11].value.integer = cast(s64)player.key
        player.key = 0
        player.fields[12].value.real = cast(float64)DesktopWheelMove()
        player.fields[13].value.integer = 0
        player.frames += 1
        result.kind = HostRecord
        result.type_name = *player.names[28].bytes[0]
        result.fields = *player.fields[0]
        result.field_count = cast(usize)14
        return 1
    }
    if function == "TakeBundleCodepoint" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)TypedCodepointTake(player.input)
        return 1
    }
    raster_status := PlayerRasterCall(function, args, count, result)
    if raster_status >= 0 { return raster_status }
    if function == "SystemClipboardOpenHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)SystemClipboardOpenHost()
        return 1
    }
    if function == "SystemClipboardByteHost" && count == 1 && args[0].kind == HostInteger {
        result.kind = HostInteger
        result.integer = cast(s64)SystemClipboardByteHost(cast(s32)args[0].integer)
        return 1
    }
    if function == "SystemClipboardWriteHost" && count == 1 && args[0].kind == HostString {
        result.kind = HostInteger
        result.integer = cast(s64)SystemClipboardWriteHost(TextValue(args[0]))
        return 1
    }
    if function == "WindowVisibleHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)WindowVisibleHost()
        return 1
    }
    if function == "WindowFocusedHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)WindowFocusedHost()
        return 1
    }
    if function == "WindowTakeCloseRequestHost" && count == 0 {
        result.kind = HostInteger
        result.integer = cast(s64)WindowTakeCloseRequestHost()
        return 1
    }
    if function == "WindowQuitHost" && count == 0 {
        WindowQuitHost()
        return 1
    }
    if function == "WindowSetVisibleHost" && count == 1 && args[0].kind == HostInteger {
        WindowSetVisibleHost(args[0].integer != 0)
        return 1
    }
    if function == "WindowInterceptCloseHost" && count == 1 && args[0].kind == HostInteger {
        result.kind = HostInteger
        result.integer = cast(s64)WindowInterceptCloseHost(args[0].integer != 0)
        return 1
    }
    return 0
}


// Extract only validated bundle resources into a directory this player owns.
// Native image loaders then use their normal asset paths. Normal completion
// removes the files and directories this instance created;
// user data stays elsewhere.
TemporaryAssets :: (storage: []u8) -> bool {
    name: [8]u8
    unused CopyCString("TMPDIR", name[:])
    value := PlayerEnvironment(*name[0])
    root := ifx value == null then "/tmp" else TextFromCString(value)
    if root == "" { root = "/tmp" }
    suffix := "/zx-XXXXXX"
    length := root.count + suffix.count
    if storage.count == 0 || length >= storage.count || root[0] != cast(u8)47 ||
    !DirectoryExists(root) { return false }
    for index: 0..cast(s32)root.count - 1 { storage[index] = root[index] }
    for index: 0..cast(s32)suffix.count - 1 { storage[root.count + index] = suffix[index] }
    storage[length] = cast(u8)0
    return TemporaryDirectory(*storage[0]) != null
}

AssetPath :: (root: string, name: string, bytes: []u8) -> string {
    count := root.count + name.count + 1
    if count >= bytes.count { return "" }
    index: s64 = 0
    while index < root.count { bytes[index] = root[index]; index += 1 }
    bytes[index] = cast(u8)47
    index += 1
    at: s64 = 0
    while at < name.count { bytes[index + at] = name[at]; at += 1 }
    bytes[count] = cast(u8)0
    return TextView(bytes[0:count])
}

ExtractAssets :: (bundle: *void, root: string) -> bool {
    index: u64 = 0
    while index < BundleAssets(bundle) {
        name := TextFromCString(BundleAssetPath(bundle, index))
        path_bytes: [4096]u8
        path_text := AssetPath(root, name, path_bytes[:])
        if path_text == "" { return false }
        at := root.count + 1
        while at < path_text.count {
            if path_text[at] == cast(u8)47 {
                if !CreatePrivateDirectory(path_text[0:at]) { return false }
            }
            at += 1
        }
        file := OpenExclusivePrivate(path_text)
        if !file.valid { return false }
        length := BundleAssetLength(bundle, index)
        data := BytesFromPointer(BundleAssetBytes(bundle, index), length)
        written := WriteAt(file, data, 0)
        closed := CloseFile(file)
        if written != cast(s64)length || !closed { return false }
        index += cast(u64)1
    }
    return true
}

RemoveAssetDirectory :: (path: string) -> bool {
    cursor := OpenDirectory(path)
    if !cursor.valid { return false }
    ok := true
    entry := NextDirectoryEntry(*cursor)
    while entry.valid {
        {
            name := TextFromBytes(entry.name[0:entry.name_count])
            if name != "." && name != ".." {
                child_bytes: [4096]u8
                child := AssetPath(path, name, child_bytes[:])
                if child == "" { ok = false; break }
                if DirectoryExists(child) {
                    if !RemoveAssetDirectory(child) { ok = false }
                } else {
                    if !RemoveFile(child) { ok = false }
                }
            }
        }
        entry = NextDirectoryEntry(*cursor)
    }
    if !CloseDirectory(*cursor) { ok = false }
    bytes: [4096]u8
    return CopyCString(path, bytes[:]) && RemoveDirectory(*bytes[0]) == 0 && ok
}

BundleThemeBackground :: (refresh: bool) -> u32 {
    // The bundle owns its palette. Match its default canvas without applying
    // a desktop palette to the clear color alone.
    unused refresh
    return UiTheme.CurrentBackground()
}

// Runs the bundle's main once. A UI bundle's main is its whole event loop;
// it returns when the window closed or a frame failed.
RunUIBundle :: (instance: *void, player: *Player) -> bool {
    result: s64
    has_result: s32
    if RunBundleInstance(instance, *result, *has_result) == 0 { return false }
    if has_result != 0 && result != 0 { player.closed = true; return false }
    return true
}

CollectBindings :: (bundle: *void, player: *Player, grants: []HostBinding,
    bindings: *Vec(HostBinding)) -> bool {
    index: u64
    while index < BundleCapabilities(bundle) {
        module := BundleCapabilityModuleName(bundle, index)
        function := BundleCapabilityFunctionName(bundle, index)
        module_name := TextFromCString(module)
        function_name := TextFromCString(function)
        binding := HostBinding.{.module = module, .function = function}
        if ModuleName(module_name, "frames_zx") { player.ui = true }
        for grant: grants {
            if grant.call != null && TextFromCString(grant.module) == module_name &&
            TextFromCString(grant.function) == function_name {
                if binding.call != null {
                    print("zx: duplicate host capability %:%\n", module_name, function_name)
                    return false
                }
                binding.call = grant.call
                binding.context = grant.context
            }
        }
        if binding.call == null {
            if !Supported(module_name, function_name) {
                print("zx: unsupported host capability %:%\n", module_name, function_name)
                return false
            }
            binding.call = PlayerCall
            binding.context = cast(*void)player
        }
        if !VecPush(bindings.*, binding) { return false }
        index += 1
    }
    return true
}

OpenInstance :: (bundle: *void, player: *Player, grants: []HostBinding, check: bool) -> (opened: *void, ready: bool) {
    bindings: Vec(HostBinding)
    defer { VecFree(bindings) }
    if !CollectBindings(bundle, player, grants, *bindings) { return null, false }
    // A check resolves imports without executing module initializers.
    if check { return null, true }
    if !PrepareInput(player) { return null, false }
    first: *HostBinding
    if bindings.count > 0 { first = *bindings[0] }
    instance := InstantiateBundle(bundle, first, cast(u64)bindings.count)
    if instance != null {
        // A UI bundle's main is its whole event loop, so a per-run ceiling
        // would end every long session; console bundles run once and keep
        // their runaway guard.
        if !player.ui { LimitBundleSteps(instance, 5000000) }
    } else {
        print("zx: could not initialize app instance\n")
    }
    return instance, instance != null
}

Reload :: (pointer: string, current: *Watch.Release, bundle: **void,
    instance: **void, player: *Player, assets_active: *bool, asset_storage: []u8) {
    candidate := Watch.Read(pointer)
    if !Watch.Newer(current.*, candidate) {
        if candidate.valid && candidate.sequence > current.sequence { current.* = candidate }
        return
    }
    replacement := OpenBundle(*candidate.path[0])
    if replacement == null { return }
    temporary: [4096]u8
    replacement_assets: string
    if BundleAssets(replacement) > cast(u64)0 {
        if !TemporaryAssets(temporary[:]) {
            CloseBundle(replacement)
            return
        }
        replacement_assets = TextFromCString(*temporary[0])
        if !ExtractAssets(replacement, replacement_assets) {
            unused RemoveAssetDirectory(replacement_assets)
            CloseBundle(replacement)
            return
        }
    }
    // The candidate binds an isolated guest state: its own reply bytes and
    // its own bundle path, so the current instance keeps answering from its
    // valid state while the candidate initializes.
    candidate_guest: Native.State
    candidate_path: [4096]u8
    candidate_argv: [1]*u8
    candidate_path_text := TextFromCString(*candidate.path[0])
    if candidate_path_text.count + 1 > candidate_path.count ||
    !CopyCString(candidate_path_text, candidate_path[:]) {
        if replacement_assets != "" { unused RemoveAssetDirectory(replacement_assets) }
        CloseBundle(replacement)
        return
    }
    candidate_argv[0] = *candidate_path[0]
    candidate_guest.bundle = replacement
    candidate_guest.argc = 1
    candidate_guest.argv = *candidate_argv[0]
    // Initializers resolve resources against the candidate bundle. Keep its
    // media and guest state separate until the candidate replaces the current
    // instance.
    replacement_media: BundleMedia
    replacement_media.bundle = replacement
    previous_media := player.media
    player.media = replacement_media
    previous_guest := player.guest
    player.guest = candidate_guest
    grants: []HostBinding
    prepared, ready := OpenInstance(replacement, player, grants, false)
    replacement_media = player.media
    player.media = previous_media
    defer { BundleMediaClose(*replacement_media) }
    if !ready {
        // A failed candidate has no instance to close; only its state ends.
        VecFree(player.guest.answer)
        player.guest = previous_guest
        if replacement_assets != "" { unused RemoveAssetDirectory(replacement_assets) }
        CloseBundle(replacement)
        return
    }
    // The prepared instance keeps answering from the candidate state until
    // its destructor has run; the current state returns only after that.
    directory: [4096]u8
    if replacement_assets != "" {
        if replacement_assets.count >= asset_storage.count ||
            !CopyCString(replacement_assets, directory[:]) || ChangeDirectory(*directory[0]) != 0 {
            // The candidate destructor runs with its own media and guest
            // contexts; free its destructor-extended answer in place before
            // restoring the previous state, exactly once.
            player.media = replacement_media
            CloseBundleInstance(prepared)
            replacement_media = player.media
            VecFree(player.guest.answer)
            player.media = previous_media
            player.guest = previous_guest
            CloseBundle(replacement)
            unused RemoveAssetDirectory(replacement_assets)
            return
        }
    } else {
        name := TextFromCString(*candidate.path[0])
        separator := name.count - 1
        while separator >= 0 && name[separator] != cast(u8)47 { separator -= 1 }
        if separator < 0 || !CopyCString(name[:separator + 1], directory[:]) || ChangeDirectory(*directory[0]) != 0 {
            player.media = replacement_media
            CloseBundleInstance(prepared)
            replacement_media = player.media
            VecFree(player.guest.answer)
            player.media = previous_media
            player.guest = previous_guest
            CloseBundle(replacement)
            return
        }
    }
    // Swap only at a frame boundary. The window and host stay alive; module
    // memory is reinitialized, while application-owned durable data stays put.
    candidate_guest = player.guest
    player.guest = previous_guest
    CloseBundleInstance(instance.*)
    BundleMediaClose(*player.media)
    CloseBundle(bundle.*)
    if assets_active.* { unused RemoveAssetDirectory(TextFromCString(*asset_storage[0])) }
    assets_active.* = false
    if replacement_assets != "" {
        unused CopyCString(replacement_assets, asset_storage)
        assets_active.* = true
    }
    bundle.* = replacement
    player.media = replacement_media
    replacement_media = BundleMedia.{}
    instance.* = prepared
    VecFree(player.guest.answer)
    player.guest = candidate_guest
    unused CopyCString(candidate_path_text, player.guest_path[:])
    player.guest_argv[0] = *player.guest_path[0]
    player.guest.argv = *player.guest_argv[0]
    current.* = candidate
    print("zx: reloaded release %\n", candidate.sequence)
}

RunPath :: (bundle_path: string, bundle_name: *u8, check: bool, grants: []HostBinding,
    pointer_path: string, current: Watch.Release) -> s32 {
    watch := pointer_path != ""
    bundle := OpenBundle(bundle_name)
    if bundle == null { return 1 }
    hosted := BundleIsApp(bundle)
    window_only := WindowBundles.WindowBundle(bundle)
    if grants.count != 0 && window_only && !hosted {
        CloseBundle(bundle)
        print("zx: app host bindings require a desktop frame or hosted app bundle\n")
        return 1
    }
    if hosted {
        if check { return AppPlayer.Run(bundle, true, bundle_path, grants) }
        if watch {
            CloseBundle(bundle)
            print("zx: hosted app release watching is not available yet\n")
            return 1
        }
        resource_bytes: [4096]u8
        resource_root: string
        if BundleAssets(bundle) > cast(u64)0 {
            if !TemporaryAssets(resource_bytes[:]) {
                CloseBundle(bundle)
                return 1
            }
            resource_root = TextFromCString(*resource_bytes[0])
            if !ExtractAssets(bundle, resource_root) || ChangeDirectory(*resource_bytes[0]) != 0 {
                CloseBundle(bundle)
                unused RemoveAssetDirectory(resource_root)
                return 1
            }
        }
        status := AppPlayer.Run(bundle, false, bundle_path, grants)
        if resource_root != "" && !RemoveAssetDirectory(resource_root) { return 1 }
        return status
    }
    // A bundle that only shows a window runs its own native entry in it.
    if window_only {
        if watch {
            CloseBundle(bundle)
            print("zx: window release watching is not available yet\n")
            return 1
        }
        return WindowPlayer.Run(bundle, check, bundle_path)
    }
    return RunFrameBundle(bundle_path, bundle, check, grants, pointer_path, current)
}

#scope_export
// Binding names and contexts are borrowed from the linked caller until this
// call returns. The native desktop and resource directory require serial runs.
RunWithBindings :: (path: string, options: PlayerOptions, bindings: []HostBinding) -> s32 {
    name: [4096]u8
    if path == "" || !CopyCString(path, name[:]) { return 1 }
    if options.check { return RunPath(path, *name[0], true, bindings, "", .{}) }

    // Playback resolves resources from the app directory. Restore the linked
    // launcher's original directory before returning to its code.
    directory := SaveDirectory(HostTextData("."), 0)
    if directory < 0 { return 1 }
    defer { unused CloseDirectoryDescriptor(directory) }
    if SetDirectoryFlags(directory, SET_FD_FLAGS, cast(s32)CLOSE_ON_EXEC) != 0 { return 1 }
    unused ProgramTitleFor(path)
    status := RunPath(path, *name[0], false, bindings, "", .{})
    if RestoreDirectory(directory) != 0 {
        print("zx: could not restore launcher directory\n")
        return 1
    }
    return status
}

RunCommand :: (argc: s32, argv: **u8) -> s32 {
    check := argc == 3 && TextFromCString(argv[1]) == "--check"
    watch := argc == 3 && TextFromCString(argv[1]) == "--watch-current"
    if argc < 1 || argc > 3 || (argc == 3 && !check && !watch) {
        print("usage: zx [--check] FILE.zx | zx --watch-current CURRENT.json\n")
        return 2
    }
    executable_bytes: [4096]u8
    prefix_bytes: [4096]u8
    app_bytes: [4096]u8
    installed_bytes: [4096]u8
    bundle_path: string = ""
    bundle_name: *u8 = null
    pointer_path: string
    current: Watch.Release
    if watch {
        pointer_path = TextFromCString(argv[2])
        if pointer_path == "" || pointer_path[0] != cast(u8)47 { return 2 }
        current = Watch.Read(pointer_path)
        if !current.valid { return 1 }
        bundle_name = *current.path[0]
        bundle_path = TextFromCString(bundle_name)
        unused ProgramTitleFor(bundle_path)
    } else if argc == 2 || check {
        bundle_name = argv[ifx check then 2 else 1]
        bundle_path = TextFromCString(bundle_name)
        // A played file is named by its .title, or else its file name. An
        // installed app finds share/kryon/BIN/app.title from the player.
        unused ProgramTitleFor(bundle_path)
    } else {
        link: [32]u8
        if !CopyCString("/proc/self/exe", link[:]) { return 1 }
        size := PlayerReadlink(*link[0], *executable_bytes[0], cast(u64)4096)
        if size <= 0 || size >= 4096 { return 1 }
        location := TextFromBytes(executable_bytes[0:size])
        separator := location.count - 1
        while separator >= 0 && location[separator] != cast(u8)47 { separator -= 1 }
        if separator < 0 { return 1 }
        prefix := AssetPath(location[0:separator], "../share/kryon", prefix_bytes[:])
        app := AssetPath(prefix, location[separator + 1:location.count], app_bytes[:])
        bundle_path = AssetPath(app, "app.zx", installed_bytes[:])
        if bundle_path == "" { return 1 }
        bundle_name = *installed_bytes[0]
    }
    grants: []HostBinding
    return RunPath(bundle_path, bundle_name, check, grants, pointer_path, current)
}

#scope_file
RunFrameBundle :: (bundle_path: string, opened_bundle: *void, check: bool,
    grants: []HostBinding, pointer_path: string, release: Watch.Release) -> s32 {
    bundle := opened_bundle
    current := release
    defer { CloseBundle(bundle) }
    // A downloaded app's relative assets live beside its bundle, independent
    // of where the owner launches it. Open the bundle before changing cwd.
    slash := bundle_path.count - 1
    while slash >= 0 && bundle_path[slash] != cast(u8)47 { slash -= 1 }
    if !check && slash >= 0 {
        directory: [4096]u8
        parent := bundle_path[0:slash]
        if slash == 0 { parent = "/" }
        if !CopyCString(parent, directory[:]) || ChangeDirectory(*directory[0]) != 0 {
            return 1
        }
    }
    player: Player
    player.media.bundle = bundle
    player.watch_path = pointer_path
    if !check && !BindGuestHost(*player, bundle, bundle_path) {
        VecFree(player.guest.answer)
        return 1
    }
    instance, ok := OpenInstance(bundle, *player, grants, check)
    if check {
        VecFree(player.guest.answer)
        return ifx ok then 0 else 1
    }
    if !ok {
        BundleMediaClose(*player.media)
        VecFree(player.guest.answer)
        return 1
    }
    temporary: [4096]u8
    assets_active := false
    if BundleAssets(bundle) > cast(u64)0 {
        ok = TemporaryAssets(temporary[:])
        if ok {
            assets_active = true
            ok = ExtractAssets(bundle, TextFromCString(*temporary[0])) && ChangeDirectory(*temporary[0]) == 0
        }
    }
    // A UI bundle declares the frames_zx loop's host capabilities: its main
    // runs the whole event loop and the player pumps the window between its
    // frames. Any other entry is a program that runs once and prints its
    // result, as `ziran run` does for a console bundle.
    if !player.ui {
        result: s64
        has_result: s32
        ok = RunBundleInstance(instance, *result, *has_result) != 0
        CloseBundleInstance(instance)
        BundleMediaClose(*player.media)
        VecFree(player.guest.answer)
        if assets_active && !RemoveAssetDirectory(TextFromCString(*temporary[0])) { ok = false }
        if !ok { print("zx: app execution failed\n"); return 1 }
        if has_result != 0 { print("%\n", result) }
        return 0
    }
    if ok { ok = OpenDesktop() }
    if ok {
        player.input = SessionOpen()
        ok = SessionValid(player.input)
    }
    if ok {
        if CaptureRequested() {
            ok = RunUIBundle(instance, *player)
            if ok { ok = CaptureConfigured() }
        } else {
            running := true
            while ok && running {
                ok = RunUIBundle(instance, *player)
                if ok && player.reload_due {
                    player.reload_due = false
                    Reload(pointer_path, *current, *bundle, *instance, *player, *assets_active, temporary[:])
                } else {
                    running = false
                }
            }
        }
    }
    CloseBundleInstance(instance)
    if SessionValid(player.input) {
        TreeInputReset(player.input)
        unused SessionClose(player.input)
    }
    BundleMediaClose(*player.media)
    VecFree(player.guest.answer)
    Video.VideoStopHost()
    #if OS == .LINUX {
        DesktopMedia.DesktopMediaClose()
        WebView.WebViewCloseHost()
        Service.CloseService()
    }
    CloseDesktop()
    if assets_active && !RemoveAssetDirectory(TextFromCString(*temporary[0])) { ok = false }
    if !ok { print("zx: app execution or rendering failed\n"); return 1 }
    return 0
}
