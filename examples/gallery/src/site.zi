    return 0
}
GUIDE_WIDGETS)
    if Button(session, ButtonProps.{.key = 10620, .bounds = .{ax, y + 410.0, aw, 42.0}, .label = "Explore 101 editable examples  →", .class_name = 11012}) != 0 { SiteNavigate(2) }
    y += 496.0
    Box(session, BoxProps.{.key = 10621, .bounds = .{ax, y, aw, 1.0}, .fill = SiteBorder()})
    y += 36.0
    SiteText(session, 10622, .{ax, y, aw, 38.0}, "03 / Easy theming", 24)
    SiteMuted(session, 10623, .{ax, y + 54.0, aw, 90.0}, "One theme carries colors, typography,\nspacing and motion across your controls.\nStart with a palette, then set your accent.", 15)
    SiteGuideCode(session, 10624, .{ax, y + 158.0, aw, 206.0}, #string GUIDE_THEME
Theme :: #import "kryon/Theme";

theme := Theme.DefaultTheme(false)
theme = Theme.WithAccent(theme,
    0x4338caff, 0xffffffff,
    0x312e81ff, 0xe0e7ffff)
unused Theme.InstallTheme(theme)
GUIDE_THEME)
    SiteMuted(session, 10626, .{ax, y + 384.0, aw, 100.0}, "Use SetThemeMode for light or dark;\nreapply custom accents after a mode change.\nSetReducedMotion controls motion.", 14)
    if Button(session, ButtonProps.{.key = 10052, .bounds = .{ax, y + 508.0, aw, 42.0}, .label = "Read the theme API  ↗", .class_name = 11012}) != 0 {
        unused OpenUri("https://github.com/kryonlabs/kryon/blob/master/src/ui/theme.zi")
    }
    if scroll.opened { End(session) }
