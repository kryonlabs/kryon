#module "profile_header_host"
#import "ui_internal.h"
#import "ui_image_internal.h"
#import "ui_style_internal.h"
#import "runtime/input.h"
#import "runtime/profile_header.h"

ProfileIconEntry :: struct {
    icon: IconType
    sync_id: i32
    name: const char*
}

