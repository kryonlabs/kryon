#module "locale_policy_test"
#inspect off

#import "ui_locale_props.generated.h"
#import "ui/locale_policy.h"
#import <stdio.h>
#import <string.h>

static failures: int
static stored_language_calls: int
static stored_language_code: const char*
static stored_language_label: const char*

LocaleStoreLanguage :: (code: const char*, label: const char*) #export {
    stored_language_calls++
    stored_language_code = code
    stored_language_label = label
}

check_text :: (label: const char*, got: const char*,
expected: const char*) {
    if got != nil && strcmp(got, expected) == 0 {
        return
    }
    fprintf(stderr, "locale policy %s: got %s, expected %s\n",
            label, got != nil ? got : "(null)", expected)
    failures++
}

main :: () -> int #export {
    languages: [6]LocaleLanguage = {
        {"en", "English"},
        {"es", "Español"},
        {"pt", "Português"},
        {"zh", "中文"},
        {"fr", "Français"},
        {"de", "Deutsch"},
    }
    check_text("null request", LocaleRequestedCode(nil), "en")
    check_text("empty request", LocaleRequestedCode(""), "en")
    check_text("explicit request", LocaleRequestedCode("pt"), "pt")
    if !LocaleContainsCode(languages, 6, "pt") ||
       LocaleContainsCode(languages, 6, "xx") ||
       LocaleContainsCode(languages, 6, nil) {
        fprintf(stderr, "locale policy exact-code membership failed\n")
        failures++
    }
    check_text("regional", LocalePreferredCode(languages, 6, "pt-BR"), "pt")
    check_text("later preference", LocalePreferredCode(languages, 6,
               "xx-ZZ,pt_BR.UTF-8"), "pt")
    check_text("script fallback", LocalePreferredCode(languages, 6,
               "zh-Hans-CN"), "zh")
    check_text("skipped C and POSIX", LocalePreferredCode(languages, 6,
               "C,POSIX,es-419"), "es")
    check_text("case and codeset", LocalePreferredCode(languages, 6,
               "EN_us.UTF-8"), "en")
    check_text("locale modifier", LocalePreferredCode(languages, 6,
               "de_DE@euro"), "de")
    check_text("unknown fallback", LocalePreferredCode(languages, 6,
               "xx-ZZ"), "en")
    check_text("empty fallback", LocalePreferredCode(languages, 6, ""), "en")
    LocaleEnsureEnglish(languages, 6)
    if stored_language_calls != 0 {
        fprintf(stderr, "locale policy duplicated English\n")
        failures++
    }
    LocaleEnsureEnglish(languages + 1, 5)
    if stored_language_calls != 1 {
        fprintf(stderr, "locale policy did not add English\n")
        failures++
    }
    check_text("default code", stored_language_code, "en")
    check_text("default label", stored_language_label, "English")

    active: [1]LocaleEntry = {
        {"title", "Localized"},
    }
    base: [2]LocaleEntry = {
        {"title", "Default"},
        {"body", "Base body"},
    }
    check_text("active entry", LocaleResolveValue(active, 1, base, 2,
               "title"), "Localized")
    check_text("base entry", LocaleResolveValue(active, 1, base, 2,
               "body"), "Base body")
    check_text("unknown key", LocaleResolveValue(active, 1, base, 2,
               "missing"), "missing")
    check_text("null key", LocaleResolveValue(active, 1, base, 2,
               nil), "")

    if failures == 0 {
        puts("locale policy checks passed")
    }
    return failures == 0 ? 0 : 1
}
