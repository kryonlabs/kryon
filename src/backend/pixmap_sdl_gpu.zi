// GPU painting. Kryon's recorded raster effects draw into a retained target
// texture, which the host then copies to the window exactly as it would an
// uploaded pixel texture. Set KRYON_PIXMAP_GPU=0 to keep CPU painting, or =1
// to paint through a software GL driver as well, which tests need.
//
// This is apart from pixmap_sdl because importing it links the pixel raster,
// which Cairo hosts presenting through pixmap_sdl must not.
#import "std/c_string"
#import "vec"
Pixels :: #import "pixmap";
#import "pixmap_gpu"

sdl :: #system_library "SDL2";
CreateTexture :: (renderer: *void, format: u32, access: s32, width: s32, height: s32) -> *void #foreign sdl "SDL_CreateTexture";
DestroyTexture :: (texture: *void) #foreign sdl "SDL_DestroyTexture";
UpdateTexture :: (texture: *void, rectangle: *void, pixels: *u32, pitch: s32) -> s32 #foreign sdl "SDL_UpdateTexture";
SetTextureBlend :: (texture: *void, mode: s32) -> s32 #foreign sdl "SDL_SetTextureBlendMode";
SetTextureScale :: (texture: *void, mode: s32) -> s32 #foreign sdl "SDL_SetTextureScaleMode";
ComposeBlend :: (source_color: s32, target_color: s32, color_operation: s32,
    source_alpha: s32, target_alpha: s32, alpha_operation: s32) -> s32 #foreign sdl "SDL_ComposeCustomBlendMode";
SetRenderTarget :: (renderer: *void, texture: *void) -> s32 #foreign sdl "SDL_SetRenderTarget";
RenderGeometry :: (renderer: *void, texture: *void, vertices: *PixmapGpuVertex, count: s32,
    indices: *s32, index_count: s32) -> s32 #foreign sdl "SDL_RenderGeometry";
RenderFlush :: (renderer: *void) -> s32 #foreign sdl "SDL_RenderFlush";
GetEnv :: (name: *u8) -> *u8 #foreign sdl "SDL_getenv";
RendererDetails :: struct {
    name: *u8
    flags: u32
    format_count: u32
    formats: [16]u32
    max_width: s32
    max_height: s32
}
GetRendererInfo :: (renderer: *void, info: *RendererDetails) -> s32 #foreign sdl "SDL_GetRendererInfo";
GlGetString :: #type (name: u32) -> *u8 #c_call;
GetProcAddress :: (name: *u8) -> GlGetString #foreign sdl "SDL_GL_GetProcAddress";

GpuArgb :: 372645892; // SDL_PIXELFORMAT_ARGB8888
GpuArea :: struct { x: s32; y: s32; width: s32; height: s32 }
gpu_renderer: *void;
gpu_target: *void;
gpu_atlas: *void;
gpu_premultiplied: s32;
// Mirrors pixmap's PixmapImageLimit (1024 asset + 64 managed slots); array
// capacities need a local constant, and every slot below is range-checked.
GpuImageLimit :: 1088;
gpu_images: [GpuImageLimit]*void;
gpu_image_revisions: [GpuImageLimit]u64;
gpu_image_smooth: [GpuImageLimit]bool;
gpu_seen_revision: u64;
gpu_premultiply: Vec(u32);

PixmapGpuEnabled :: () -> bool { return pixmap_gpu_active }

Contains :: (text: *u8, part: string) -> bool {
    if text == null { return false }
    at: s64
    while text[at] != cast(u8)0 {
        offset: s64
        while offset < part.count && text[at + offset] == part[offset] { offset += 1 }
        if offset == part.count { return true }
        at += 1
    }
    return false
}

// A software GL driver paints on the CPU anyway, and less efficiently than the
// raster it would replace.
SoftwareDriver :: () -> bool {
    name: [16]u8; if !CopyCString("glGetString", name[:]) { return true }
    get := GetProcAddress(*name[0])
    if get == null { return false }
    driver := get(cast(u32)0x1F01) // GL_RENDERER
    return Contains(driver, "llvmpipe") || Contains(driver, "softpipe") || Contains(driver, "Software")
}

// SDL applies this at once, to commands already queued, and its GL driver binds
// the texture without noting it. Draw what is queued first; an atlas upload then
// makes SDL bind the next draw's texture again.
SetScale :: (texture: *void, mode: s32) {
    unused RenderFlush(gpu_renderer); unused SetTextureScale(texture, mode)
    white: u32 = cast(u32)0xffffffff; area: GpuArea = .{0, 0, 1, 1}
    unused UpdateTexture(gpu_atlas, cast(*void)*area, *white, 4)
}

OpenAtlas :: () -> bool {
    gpu_atlas = CreateTexture(gpu_renderer, cast(u32)GpuArgb, 0, PixmapGpuAtlasSide, PixmapGpuAtlasSide)
    if gpu_atlas == null { return false }
    unused SetTextureBlend(gpu_atlas, 1)
    white: [16]u32
    for index: 0..15 { white[index] = cast(u32)0xffffffff }
    area: GpuArea = .{0, 0, PixmapGpuWhiteSide, PixmapGpuWhiteSide}
    if UpdateTexture(gpu_atlas, cast(*void)*area, *white[0], PixmapGpuWhiteSide * 4) != 0 {
        DestroyTexture(gpu_atlas); gpu_atlas = null; return false
    }
    // Texels map one to one; a host's scale hint must not blur them.
    SetScale(gpu_atlas, 0)
    PixmapGpuRecordClear(); PixmapGpuAtlasClear()
    return true
}

// Starts recording when this renderer is a real GPU with target textures. On
// false, nothing changed and the host keeps uploading rasterized pixels.
PixmapGpuOpen :: (renderer: *void) -> bool {
    if renderer == null || pixmap_gpu_active { return pixmap_gpu_active }
    variable: [32]u8; if !CopyCString("KRYON_PIXMAP_GPU", variable[:]) { return false }
    choice := GetEnv(*variable[0])
    disabled := choice != null && choice[0] == cast(u8)48
    forced := choice != null && choice[0] == cast(u8)49
    info: RendererDetails
    if disabled || GetRendererInfo(renderer, *info) != 0 { return false }
    if (info.flags & cast(u32)8) == cast(u32)0 { return false } // SDL_RENDERER_TARGETTEXTURE
    if !forced && ((info.flags & cast(u32)2) == cast(u32)0 || SoftwareDriver()) { return false }
    if (info.max_width > 0 && info.max_width < PixmapGpuAtlasSide) || (info.max_height > 0 && info.max_height < PixmapGpuAtlasSide) { return false }
    gpu_renderer = renderer
    if !OpenAtlas() { return false }
    // ONE, ONE_MINUS_SRC_ALPHA, ADD for color and alpha.
    gpu_premultiplied = ComposeBlend(2, 6, 1, 2, 6, 1)
    pixmap_gpu_max_image = ifx info.max_width < info.max_height then info.max_width else info.max_height
    if pixmap_gpu_max_image <= 0 { pixmap_gpu_max_image = 4096 }
    pixmap_gpu_flush = PixmapGpuDraw; pixmap_gpu_active = true
    return true
}

// The texture the host presents, replacing any earlier target; it keeps
// ownership of both. Its contents start undefined, so its first frame needs
// complete damage, which the host's new viewport already causes.
PixmapGpuCreateTarget :: (width: s32, height: s32) -> *void {
    if !pixmap_gpu_active { return null }
    PixmapGpuDraw()
    next := CreateTexture(gpu_renderer, cast(u32)GpuArgb, 2, width, height)
    if next != null { gpu_target = next }
    return next
}

// Returns to an earlier target when the host could not switch to the new one.
PixmapGpuUseTarget :: (texture: *void) { gpu_target = texture }

ForgetImage :: (slot: s64) {
    if gpu_images[slot] != null { DestroyTexture(gpu_images[slot]); gpu_images[slot] = null }
    gpu_image_revisions[slot] = 0; gpu_image_smooth[slot] = false
}

// Drop what the host has replaced or cleared, once per image publication.
SweepImages :: () {
    revision := Pixels.PixmapImageRevision()
    if revision == gpu_seen_revision { return }
    gpu_seen_revision = revision
    for slot: 0..GpuImageLimit - 1 {
        if gpu_images[slot] != null && gpu_image_revisions[slot] != Pixels.pixmap_image_revisions[slot] { ForgetImage(slot) }
    }
}

ImageTexture :: (slot: s32) -> *void {
    if slot < 0 || slot >= GpuImageLimit { return null }
    if gpu_images[slot] != null { return gpu_images[slot] }
    width := Pixels.pixmap_image_widths[slot]; height := Pixels.pixmap_image_heights[slot]
    if width <= 0 || height <= 0 { return null }
    texture := CreateTexture(gpu_renderer, cast(u32)GpuArgb, 0, width, height)
    if texture == null { return null }
    unused SetTextureBlend(texture, gpu_premultiplied)
    if Pixels.PixmapSourceCount(slot) < cast(s64)width * height { DestroyTexture(texture); return null }
    VecClear(gpu_premultiply)
    for index: 0..cast(s64)width * height - 1 {
        pixel := Pixels.PixmapSourcePixel(slot, index); alpha := pixel >> cast(u32)24
        red := ((pixel >> cast(u32)16) & cast(u32)255) * alpha / cast(u32)255
        green := ((pixel >> cast(u32)8) & cast(u32)255) * alpha / cast(u32)255
        blue := (pixel & cast(u32)255) * alpha / cast(u32)255
        unused VecPush(gpu_premultiply, (alpha << cast(u32)24) | (red << cast(u32)16) | (green << cast(u32)8) | blue)
    }
    unused UpdateTexture(texture, null, *gpu_premultiply[0], width * 4)
    gpu_images[slot] = texture; gpu_image_revisions[slot] = Pixels.pixmap_image_revisions[slot]
    return texture
}

// Draws everything recorded into the target, on the renderer's thread, and
// restores the window as the render target. Hosts call this before copying the
// target to the window; a full atlas also calls it mid-frame.
PixmapGpuDraw :: () {
    if gpu_renderer == null || gpu_target == null { return }
    for index: 0..pixmap_gpu_uploads.count - 1 {
        upload := pixmap_gpu_uploads[index]
        area: GpuArea = .{upload.x, upload.y, upload.width, upload.height}
        unused UpdateTexture(gpu_atlas, cast(*void)*area, *pixmap_gpu_staged[upload.start], upload.width * 4)
    }
    if pixmap_gpu_batches.count > 0 {
        SweepImages()
        unused SetRenderTarget(gpu_renderer, gpu_target)
        for index: 0..pixmap_gpu_batches.count - 1 {
            batch := pixmap_gpu_batches[index]
            texture := gpu_atlas
            if batch.slot >= 0 {
                texture = ImageTexture(batch.slot)
                if texture != null && gpu_image_smooth[batch.slot] != batch.smooth {
                    SetScale(texture, ifx batch.smooth then 1 else 0); gpu_image_smooth[batch.slot] = batch.smooth
                }
            }
            if texture != null {
                unused RenderGeometry(gpu_renderer, texture, *pixmap_gpu_vertices[batch.first], batch.count, null, 0)
            }
        }
        unused SetRenderTarget(gpu_renderer, null)
    }
    PixmapGpuRecordClear()
}

// A lost device took every texture with it. Rebuild the atlas; images return on
// demand. The host then recreates its target and repaints.
PixmapGpuDeviceLost :: () {
    if !pixmap_gpu_active { return }
    gpu_target = null
    for slot: 0..GpuImageLimit - 1 { ForgetImage(slot) }
    if gpu_atlas != null { DestroyTexture(gpu_atlas); gpu_atlas = null }
    if !OpenAtlas() { pixmap_gpu_active = false }
}

// Before destroying the renderer. Returns the host to CPU painting.
PixmapGpuClose :: () {
    if !pixmap_gpu_active { return }
    PixmapGpuRecordClear()
    for slot: 0..GpuImageLimit - 1 { ForgetImage(slot) }
    if gpu_atlas != null { DestroyTexture(gpu_atlas); gpu_atlas = null }
    VecFree(gpu_premultiply)
    pixmap_gpu_active = false; gpu_target = null; gpu_renderer = null
}
