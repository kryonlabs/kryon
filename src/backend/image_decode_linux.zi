// Optional system image codecs, loaded without adding a backend link dependency.
// GdkPixbuf decodes and scales; the host converts its pixels to Cairo ARGB32.
// Preserve original pixels within the raster host's 256 MiB image budget.
ImagePixelLimit :: 67108864;
dl :: #system_library "dl";
c :: #system_library "c";
Copy :: (target: *void, source: *void, size: usize) -> *void #foreign c "memcpy";
Open :: (path: *u8, flags: s32) -> *void #foreign dl "dlopen";
Symbol :: (library: *void, name: *u8) -> *void #foreign dl "dlsym";
NewImage :: #type (path: *u8, width: s32, height: s32, preserve: s32, error: *void) -> *void #c_call;
Integer :: #type (image: *void) -> s32 #c_call;
Pixels :: #type (image: *void) -> *u8 #c_call;
Release :: #type (image: *void) -> void #c_call;
Info :: #type (path: *u8, width: *s32, height: *s32) -> *void #c_call;
Orient :: #type (image: *void) -> *void #c_call;
new_image: NewImage;
width_of: Integer;
height_of: Integer;
stride_of: Integer;
channels_of: Integer;
pixels_of: Pixels;
release: Release;
info: Info;
orient: Orient;
initialized: bool;
available: bool;
library: *void;

#import "std/c_string"
Resolve :: (slot: *void, name: string) -> bool {
    bytes: [128]u8
    if !CopyCString(name, bytes[:]) { return false }
    symbol := Symbol(library, *bytes[0])
    if symbol == null { return false }
    unused Copy(slot, cast(*void)*symbol, size_of(*void))
    return true
}

Init :: () -> bool {
    if initialized { return available }
    initialized = true
    name: [64]u8
    unused CopyCString("libgdk_pixbuf-2.0.so.0", name[:])
    library = Open(*name[0], 1)
    if library == null { return false }
    available = Resolve(cast(*void)*new_image, "gdk_pixbuf_new_from_file_at_scale") &&
        Resolve(cast(*void)*width_of, "gdk_pixbuf_get_width") &&
        Resolve(cast(*void)*height_of, "gdk_pixbuf_get_height") &&
        Resolve(cast(*void)*stride_of, "gdk_pixbuf_get_rowstride") &&
        Resolve(cast(*void)*channels_of, "gdk_pixbuf_get_n_channels") &&
        Resolve(cast(*void)*pixels_of, "gdk_pixbuf_get_pixels") &&
        Resolve(cast(*void)*release, "g_object_unref") &&
        Resolve(cast(*void)*info, "gdk_pixbuf_get_file_info") &&
        Resolve(cast(*void)*orient, "gdk_pixbuf_apply_embedded_orientation")
    return available
}

OpenImage :: (path: *u8) -> *void {
    if AVIFFile(TextFromCString(path)) || !Init() { return null }
    width: s32; height: s32
    if info(path, *width, *height) == null || width <= 0 || height <= 0 { return null }
    if width > 32768 || height > 32768 || cast(s64)width * cast(s64)height > ImagePixelLimit {
        if width > 4096 { width = 4096 }
        if height > 4096 { height = 4096 }
    }
    image := new_image(path, width, height, 1, null)
    if image == null { return null }
    oriented := orient(image)
    release(image)
    return oriented
}

Width :: (image: *void) -> s32 { return width_of(image) }
Height :: (image: *void) -> s32 { return height_of(image) }
CloseImage :: (image: *void) { release(image) }

CopyPixels :: (image: *void, destination: *u8, stride: s32) -> bool {
    width := width_of(image); height := height_of(image)
    channels := channels_of(image); source_stride := stride_of(image)
    if width <= 0 || height <= 0 || width > 32768 || height > 32768 ||
        cast(s64)width * cast(s64)height > ImagePixelLimit ||
        (channels != 3 && channels != 4) || source_stride < width * channels || stride < width * 4 { return false }
    source := pixels_of(image)
    if source == null || destination == null { return false }
    for y: 0..height - 1 {
        for x: 0..width - 1 {
            input := y * source_stride + x * channels
            output := y * stride + x * 4
            alpha: u32 = ifx channels == 4 then cast(u32)source[input + 3] else 255
            red := (cast(u32)source[input] * alpha + 127) / 255
            green := (cast(u32)source[input + 1] * alpha + 127) / 255
            blue := (cast(u32)source[input + 2] * alpha + 127) / 255
            pixel := cast(*u32)(*destination[output])
            pixel.* = (alpha << 24) | (red << 16) | (green << 8) | blue
        }
    }
    return true
}

// WebP through the system libwebp demuxer (libwebpdemux.so.2 and its
// libwebp.so.7), also loaded on first use: lossy, lossless and alpha pictures
// decode to straight RGBA, and an animation to its first complete frame.
#import "std/file_linux"
#import "std/byte_text_linux"
NativeWebp :: #import "webp/dynamic";
Codecs :: #import "image_codec/api";
WebpRiff :: #import "webp/riff";
WebpEngine :: #import "webp/engine";
#import "ziran_image_decode"
webp_engine: NativeWebp.DynamicWebpEngine;
webp_initialized: bool;
webp_available: bool;

// POD storage retained only until the host has copied/uploaded the pixels.
// Both package output paths use libc allocation; avif preserves the existing
// allocator discriminator for callers that share the still-image close path.
WebPImage :: struct { pixels: *u8; width: s32; height: s32; avif: bool; }

WebPInit :: () -> bool {
    if webp_initialized { return webp_available }
    webp_initialized = true
    webp_engine = NativeWebp.OpenDynamicWebp("libwebpdemux.so.2")
    webp_available = webp_engine.available
    return webp_available
}

OpenWebP :: (path: string) -> WebPImage {
    file := OpenRead(path)
    if !file.valid { return WebPImage.{} }
    defer { unused CloseFile(file) }
    header: [12]u8
    size := FileSize(file)
    // Cairo's encoded-file budget remains 256 MiB. The static WebP adapter
    // separately retains its existing 2 GiB input ceiling.
    if size < 12 || size > 268435456 || ReadAt(file, header[:], 0) != 12 ||
        !ImageWebpSignature(TextFromBytes(header[:])) || !WebPInit() { return WebPImage.{} }
    data := ImagePixelsAllocate(cast(usize)size)
    if data == null { return WebPImage.{} }
    defer { ImagePixelsFree(data) }
    read: s64 = 0
    while read < size {
        count := ReadAt(file, BytesFromPointer(*data[read], cast(u64)(size - read)), read)
        if count <= 0 { return WebPImage.{} }
        read += count
    }
    options := WebpEngine.WebpDefaultOptions()
    options.limits.max_input_bytes = 268435456
    options.limits.max_frames = 2147483647
    options.limits.max_metadata_bytes = options.limits.max_input_bytes
    input := ImageEncodedBytes(TextFromBytes(BytesFromPointer(data, cast(u64)size)))
    probe := WebpRiff.WebpProbe(input, options.limits)
    if !probe.is_ok { return WebPImage.{} }
    count := cast(s64)probe.metadata.width * probe.metadata.height * 4
    pixels := ImagePixelsAllocate(cast(usize)count)
    if pixels == null { return WebPImage.{} }
    output := Codecs.OutputBuffer.{BytesFromPointer(pixels, cast(u64)count), cast(s64)probe.metadata.width * 4}
    result := NativeWebp.DynamicWebpDecodeInto(*webp_engine, input, output, options)
    if !result.is_ok || result.metadata.width != probe.metadata.width || result.metadata.height != probe.metadata.height {
        ImagePixelsFree(pixels); return WebPImage.{}
    }
    return WebPImage.{pixels, result.metadata.width, result.metadata.height, false}
}

// Straight RGBA to Cairo's premultiplied ARGB32 rows of the given stride.
CopyWebP :: (image: WebPImage, destination: *u8, stride: s32) -> bool {
    if image.pixels == null || destination == null || image.width <= 0 || image.height <= 0 ||
        image.width > 32768 || image.height > 32768 ||
        cast(s64)image.width * image.height > ImagePixelLimit || stride < image.width * 4 { return false }
    for y: 0..image.height - 1 {
        for x: 0..image.width - 1 {
            input := (y * image.width + x) * 4
            alpha := cast(u32)image.pixels[input + 3]
            red := (cast(u32)image.pixels[input] * alpha + 127) / 255
            green := (cast(u32)image.pixels[input + 1] * alpha + 127) / 255
            blue := (cast(u32)image.pixels[input + 2] * alpha + 127) / 255
            pixel := cast(*u32)(*destination[cast(s64)y * stride + x * 4])
            pixel.* = (alpha << 24) | (red << 16) | (green << 8) | blue
        }
    }
    return true
}

CloseWebP :: (image: WebPImage) {
    if image.pixels != null { ImagePixelsFree(image.pixels) }
}

// Packaged CPU AVIF decoder. It is independent of GdkPixbuf's loader set.
#import "avif_decode"
avif_api: AvifAPI;
avif_library: *void;
avif_initialized: bool;
avif_available: bool;
AvifReadLink :: (path: *u8, output: *u8, capacity: usize) -> isize #foreign c "readlink";
AvifGetEnv :: (name: *u8) -> *u8 #foreign c "getenv";
AvifResolve :: (slot: *void, name: string) -> bool {
    bytes: [64]u8
    if !CopyCString(name, bytes[:]) { return false }
    symbol := Symbol(avif_library, *bytes[0])
    if symbol == null { return false }
    unused Copy(slot, cast(*void)*symbol, size_of(*void))
    return true
}
AvifOpenLibrary :: (path: string) -> *void {
    bytes: [4096]u8
    if !CopyCString(path, bytes[:]) { return null }
    return Open(*bytes[0], 1)
}
AvifInit :: () -> bool {
    if avif_initialized { return avif_available }
    avif_initialized = true
    name: [32]u8
    unused CopyCString("KRYON_AVIF_LIBRARY", name[:])
    explicit := AvifGetEnv(*name[0])
    if explicit != null { avif_library = AvifOpenLibrary(TextFromCString(explicit)) }
    if avif_library == null { avif_library = AvifOpenLibrary("libkryonavif.so") }
    // Installed binaries and AppDirs can carry the codec next to the executable
    // or in their lib directory. Never depend on the process working directory.
    if avif_library == null {
        unused CopyCString("/proc/self/exe", name[:])
        executable: [4096]u8
        count := AvifReadLink(*name[0], *executable[0], 4095)
        if count > 0 && count < 4095 {
            slash := count - 1
            while slash >= 0 && executable[slash] != 47 { slash -= 1 }
            if slash >= 0 {
                directory := TextFromBytes(executable[:slash + 1])
                suffixes: [3]string = .["libkryonavif.so", "lib/libkryonavif.so", "../lib/libkryonavif.so"]
                for suffix: suffixes {
                    full: [4096]u8
                    if directory.count + suffix.count + 1 > full.count { continue }
                    for i: 0..directory.count - 1 { full[i] = directory[i] }
                    for i: 0..suffix.count - 1 { full[directory.count + i] = suffix[i] }
                    full[directory.count + suffix.count] = 0
                    avif_library = Open(*full[0], 1)
                    if avif_library != null { break }
                }
            }
        }
    }
    if avif_library == null { return false }
    avif_available = AvifResolve(cast(*void)*avif_api.version, "avifVersion") &&
        AvifResolve(cast(*void)*avif_api.create, "avifDecoderCreate") &&
        AvifResolve(cast(*void)*avif_api.destroy, "avifDecoderDestroy") &&
        AvifResolve(cast(*void)*avif_api.memory, "avifDecoderSetIOMemory") &&
        AvifResolve(cast(*void)*avif_api.parse, "avifDecoderParse") &&
        AvifResolve(cast(*void)*avif_api.next, "avifDecoderNextImage") &&
        AvifResolve(cast(*void)*avif_api.defaults, "avifRGBImageSetDefaults") &&
        AvifResolve(cast(*void)*avif_api.convert, "avifImageYUVToRGB") &&
        AvifResolve(cast(*void)*avif_api.crop, "avifCropRectConvertCleanApertureBox")
    return avif_available
}
OpenAVIF :: (path: string) -> WebPImage {
    file := OpenRead(path)
    if !file.valid { return WebPImage.{} }
    defer { unused CloseFile(file) }
    size := FileSize(file)
    header: [4096]u8
    if size < 16 || size > AVIF_BYTE_LIMIT { return WebPImage.{} }
    wanted := ifx size < 4096 then size else 4096
    count := ReadAt(file, header[:wanted], 0)
    if count != wanted || !AvifSignature(TextFromBytes(header[:count])) || !AvifInit() { return WebPImage.{} }
    data := AvifAllocate(cast(usize)size)
    if data == null { return WebPImage.{} }
    defer { AvifFree(data) }
    read: s64 = 0
    while read < size {
        count = ReadAt(file, BytesFromPointer(*data[read], cast(u64)(size - read)), read)
        if count <= 0 { return WebPImage.{} }
        read += count
    }
    width: s32 = 0; height: s32 = 0
    pixels := AvifDecode(avif_api, TextFromBytes(BytesFromPointer(data, cast(u64)size)), *width, *height)
    return WebPImage.{pixels, width, height, true}
}
OpenStill :: (path: string) -> WebPImage {
    image := OpenAVIF(path)
    if image.pixels != null { return image }
    return OpenWebP(path)
}
CloseStill :: (image: WebPImage) {
    if image.avif {
        if image.pixels != null { AvifFree(image.pixels) }
    } else { CloseWebP(image) }
}

// A recognized AVIF failure must not fall through to an unbounded system
// loader and bypass the packaged decoder's allocation limits.
AVIFFile :: (path: string) -> bool {
    file := OpenRead(path)
    if !file.valid { return false }
    defer { unused CloseFile(file) }
    header: [4096]u8
    size := FileSize(file)
    if size < 16 { return false }
    wanted := ifx size < 4096 then size else 4096
    count := ReadAt(file, header[:wanted], 0)
    return count == wanted && AvifSignature(TextFromBytes(header[:count]))
}
