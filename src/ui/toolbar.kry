#module "toolbar_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "runtime/toolbar.h"

ToolbarFrame :: (toolbar: ToolbarProps, role: i32,
state: ButtonState, icon_only: bool) -> StyleFrame {
    props: ButtonProps
    props.tone = ButtonToneNeutral
    props.emphasis = ButtonEmphasisSoft
    props.size = ControlSizeMedium
    props.icon_only = icon_only
    props.class_name = toolbar.class_name
    return ui_control_style_frame_role_kind(props, state, 0,
    0.0, 0.0, 0.0, StyleKindToolbar(), role)
}

RenderToolbar :: (toolbar: ToolbarProps) -> ToolbarResult #export {
    result: ToolbarResult
    result.selected_menu_item = -1
    result.clicked_action = -1
    bar_frame: StyleFrame = ToolbarFrame(toolbar, ToolbarBarRole(),
    ButtonStateNormal, false)
    divider_frame: StyleFrame = ToolbarFrame(toolbar, ToolbarDividerRole(),
    ButtonStateNormal, false)
    action_frame: StyleFrame = ToolbarFrame(toolbar, ToolbarActionRole(),
    ButtonStateNormal, true)
    bar: Style = ui_unpack_style(bar_frame.value)
    divider: Style = ui_unpack_style(divider_frame.value)
    action_style: Style = ui_unpack_style(action_frame.value)

    scale: float = (float)Scale(1000) / 1000.0
    spec: ToolbarSpec
    spec.x = toolbar.x
    spec.y = toolbar.y
    spec.width = toolbar.width
    spec.height = toolbar.height
    spec.action_count = toolbar.action_count
    spec.action_icon_size = -1
    spec.action_icon_padding = -1
    spec.action_gap = -1
    spec.side_padding = -1
    spec.dropdown_min_width = toolbar.dropdown_min_width
    spec.dropdown_max_width = toolbar.dropdown_max_width
    spec.dropdown_height = toolbar.dropdown_height
    spec.scale = scale
    spec.bar = bar_frame
    spec.action = action_frame
    layout: ToolbarLayout = ToolbarLayoutFor(spec)

    bar_bounds: Rectangle = (Rectangle){(float)toolbar.x, (float)toolbar.y,
        (float)toolbar.width, (float)toolbar.height}
    ui_draw_material(bar_bounds, (Rectangle){0}, bar.background, bar.border,
    bar.border, bar.radius, bar.border_width, 0.0, 0.0, 0,
    bar.focus, 0.0, bar.opacity, ui_style_fill(bar), bar.material)
    divider_line: ToolbarDividerLine = ToolbarDividerLineFor(toolbar.x,
    toolbar.y, toolbar.width, toolbar.height)
    DrawLine(divider_line.x1, divider_line.y1, divider_line.x2,
    divider_line.y2, divider.border)

    if toolbar.actions != nil && toolbar.action_count > 0 {
        action_hover: Style = ui_unpack_style(ToolbarFrame(toolbar,
        ToolbarActionRole(), ButtonStateHover, true).value)
        index: i32 = toolbar.action_count - 1
        while index >= 0 {
            button: ButtonSpec
            button.props.bounds = ToolbarActionBoundsFor(layout, index,
            toolbar.action_count)
            button.props.id = ToolbarActionIdFor(toolbar.id, index)
            button.props.icon = toolbar.actions[index].icon
            button.props.icon_type = toolbar.actions[index].icon_type
            button.props.icon_only = true
            button.props.disabled = toolbar.actions[index].disabled
            button.props.tone = ButtonToneNeutral
            button.props.emphasis = ButtonEmphasisSoft
            button.props.class_name = toolbar.class_name
            button.style.normal = action_style
            button.style.hover = action_hover
            button.style.normal.fields |= StyleIconSize
            button.style.normal.icon_size = ToolbarActionStyleIconSize(
            layout.action_icon_size, scale)
            button.style_kind = StyleKindToolbar()
            button.style_resolved = 1
            if !toolbar.actions[index].disabled && ui_button_render(button) {
                result.clicked_action = index
            }
            index -= 1
        }
    }

    if toolbar.options != nil && toolbar.option_count > 0 &&
    toolbar.selected_index != nil {
        dropdown: DropdownProps
        dropdown.id = toolbar.id
        dropdown.bounds = layout.dropdown_bounds
        dropdown.class_name = toolbar.class_name
        dropdown.options = toolbar.options
        dropdown.option_count = toolbar.option_count
        dropdown.selected_index = toolbar.selected_index
        if Dropdown(dropdown) {
            result.selected_menu_item = *toolbar.selected_index
        }
    }
    return result
}
