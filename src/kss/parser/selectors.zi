// Part of the kss_parser module, loaded by src/kss/kss_parser.zi.
// CSS selector matching for declarative hosts.

// Selector predicates operate on borrowed UTF-8 bytes. Hosts supply attribute
// values and sibling positions; matching semantics stay shared.
KssTextAt :: (value: string, needle: string, start: s32) -> bool {
    if start < 0 || start > (cast(s32)value.count) || (cast(s32)needle.count) > (cast(s32)value.count) - start {
        return false
    }
    index: s32 = 0
    while index < (cast(s32)needle.count) {
        if value[start + index] != needle[index] {
            return false
        }
        index = index + 1
    }
    return true
}

KssIdentityFacts :: struct {
    id: string
    name: string
    key: string
}

#program_export
KssIdentityMatches :: (expected: string, facts: KssIdentityFacts) -> bool {
    if (cast(s32)expected.count) == 0 {
        return false
    }
    return expected == facts.id || expected == facts.name || expected == facts.key
}

#program_export
KssAttributeMatches :: (value: string, needle: string, operation: string, present: bool) -> bool {
    if !present {
        return false
    }
    if operation == "=" || operation == "" {
        return value == needle
    }
    if operation == "|=" {
        return value == needle || (KssTextAt(value, needle, 0) &&
            (cast(s32)value.count) > (cast(s32)needle.count) && value[(cast(s32)needle.count)] == 45)
    }
    if (cast(s32)needle.count) == 0 {
        return false
    }
    if operation == "^=" {
        return KssTextAt(value, needle, 0)
    }
    if operation == "$=" {
        return KssTextAt(value, needle, (cast(s32)value.count) - (cast(s32)needle.count))
    }
    if operation == "*=" {
        start: s32 = 0
        while start <= (cast(s32)value.count) - (cast(s32)needle.count) {
            if KssTextAt(value, needle, start) {
                return true
            }
            start = start + 1
        }
        return false
    }
    if operation == "~=" {
        start: s32 = 0
        while start < (cast(s32)value.count) {
            while start < (cast(s32)value.count) && KssIsSpace(value[start]) {
                start = start + 1
            }
            end: s32 = start
            while end < (cast(s32)value.count) && !KssIsSpace(value[end]) {
                end = end + 1
            }
            if end - start == (cast(s32)needle.count) && KssTextAt(value, needle, start) {
                return true
            }
            start = end
        }
        return false
    }
    return false
}

KssNthFormula :: struct {
    step: s64
    offset: s64
    ok: bool
}

#program_export
KssParseNth :: (source: string) -> KssNthFormula {
    result: KssNthFormula
    c: KssCursor
    c.source = source
    space: KssExpectResult = KssSelectorSpace(c)
    if !space.ok {
        return result
    }
    c = space.parser
    word: KssNameResult = KssReadName(c)
    tail: KssExpectResult = KssSelectorSpace(word.parser)
    if word.ok && tail.ok && KssAtEnd(tail.parser) {
        if KssNameEquals(word.name, "odd") {
            result.step = 2
            result.offset = 1
            result.ok = true
            return result
        }
        if KssNameEquals(word.name, "even") {
            result.step = 2
            result.ok = true
            return result
        }
    }
    sign: s64 = 1
    if KssPeek(c, 0) == 45 {
        sign = -1
        c = KssAdvance(c, 1)
    } else if KssPeek(c, 0) == 43 {
        c = KssAdvance(c, 1)
    }
    number: s64 = 0
    digits: bool = false
    while KssIsDigit(KssPeek(c, 0)) {
        number = number * 10 + cast(s64)(KssPeek(c, 0) - 48)
        if number > 2147483647 {
            return result
        }
        digits = true
        c = KssAdvance(c, 1)
    }
    if KssLower(KssPeek(c, 0)) != 110 {
        tail = KssSelectorSpace(c)
        result.ok = digits && tail.ok && KssAtEnd(tail.parser)
        if result.ok {
            result.offset = sign * number
        }
        return result
    }
    if !digits {
        number = 1
    }
    step: s64 = sign * number
    space = KssSelectorSpace(KssAdvance(c, 1))
    if !space.ok {
        return result
    }
    c = space.parser
    offset: s64 = 0
    if !KssAtEnd(c) {
        sign = 1
        if KssPeek(c, 0) == 45 {
            sign = -1
        } else if KssPeek(c, 0) != 43 {
            return result
        }
        space = KssSelectorSpace(KssAdvance(c, 1))
        if !space.ok {
            return result
        }
        c = space.parser
        digits = false
        while KssIsDigit(KssPeek(c, 0)) {
            offset = offset * 10 + cast(s64)(KssPeek(c, 0) - 48)
            if offset > 2147483647 {
                return result
            }
            digits = true
            c = KssAdvance(c, 1)
        }
        tail = KssSelectorSpace(c)
        if !digits || !tail.ok || !KssAtEnd(tail.parser) {
            return result
        }
        offset = sign * offset
    }
    result.step = step
    result.offset = offset
    result.ok = true
    return result
}

KssNthAppendInteger :: (text: KssName, value: s64) -> KssName {
    if value < 0 {
        text = KssNameAppend(text, 45)
        value = -value
    }
    divisor: s64 = 1
    while value / divisor >= 10 {
        divisor = divisor * 10
    }
    while divisor > 0 {
        text = KssNameAppend(text, cast(u8)(48 + value / divisor))
        value = value % divisor
        divisor = divisor / 10
    }
    return text
}

// A bounded canonical CSS An+B spelling; invalid formulas produce empty text.
#program_export
KssNthText :: (source: string) -> KssName {
    text: KssName
    formula: KssNthFormula = KssParseNth(source)
    if !formula.ok {
        return text
    }
    if formula.step == 0 {
        return KssNthAppendInteger(text, formula.offset)
    }
    if formula.step == -1 {
        text = KssNameAppend(text, 45)
    } else if formula.step != 1 {
        text = KssNthAppendInteger(text, formula.step)
    }
    text = KssNameAppend(text, 110)
    if formula.offset > 0 {
        text = KssNameAppend(text, 43)
    }
    if formula.offset != 0 {
        text = KssNthAppendInteger(text, formula.offset)
    }
    return text
}

#program_export
KssNthMatches :: (source: string, position: s32) -> bool {
    if position <= 0 {
        return false
    }
    formula: KssNthFormula = KssParseNth(source)
    if !formula.ok {
        return false
    }
    if formula.step == 0 {
        return cast(s64)position == formula.offset
    }
    delta: s64 = cast(s64)position - formula.offset
    return delta % formula.step == 0 && delta / formula.step >= 0
}

#program_export
KssNthSiblingMatches :: (source: string, index: s32, count: s32, from_end: bool) -> bool {
    if index < 0 || index >= count {
        return false
    }
    position: s32 = index + 1
    if from_end {
        position = count - index
    }
    return KssNthMatches(source, position)
}

KssStateFacts :: struct {
    kind: string
    tag: string
    any_active: bool
    requested: bool
    hover: bool
    pressed: bool
    focus: bool
    disabled: bool
    node_disabled: bool
    readonly: bool
    readonly_camel: bool
    node_readonly: bool
    required: bool
    node_required: bool
    valid: bool
    invalid: bool
    aria_invalid: bool
    extra_invalid: bool
    placeholder_shown: bool
    placeholder_shown_camel: bool
    placeholder_present: bool
    value_present: bool
}

#program_export
KssStateName :: (source: string) -> KssName {
    name: KssName
    if (cast(s32)source.count) > 64 {
        return name
    }
    while name.length < (cast(s32)source.count) {
        name.bytes[name.length] = KssLower(source[name.length])
        name.length = name.length + 1
    }
    return name
}

KssIsFormControl :: (kind: string, tag: string) -> bool {
    if tag == "input" || tag == "select" || tag == "textarea" {
        return true
    }
    if kind == "TextField" || kind == "Input" || kind == "TextArea" ||
        kind == "ColorPicker" || kind == "Slider" || kind == "Spinbox" {
        return true
    }
    return kind == "Dropdown" || kind == "ListBox" || kind == "Checkbox" ||
        kind == "Toggle" || kind == "Radio"
}

#program_export
KssStateMatches :: (source: string, facts: KssStateFacts) -> bool {
    if (cast(s32)source.count) > 64 {
        return false
    }
    name: KssName = KssStateName(source)
    if name.length == 0 || KssNameEquals(name, "any") {
        return true
    }
    if KssNameEquals(name, "normal") {
        return !facts.any_active && !facts.node_readonly && !facts.node_required
    }
    if KssNameEquals(name, "hover") {
        return facts.requested || facts.hover
    }
    if KssNameEquals(name, "pressed") || KssNameEquals(name, "active") {
        return facts.requested || facts.pressed
    }
    if KssNameEquals(name, "focus") || KssNameEquals(name, "focused") ||
        KssNameEquals(name, "focus-visible") {
        return facts.requested || facts.focus
    }
    if KssNameEquals(name, "enabled") {
        return !facts.disabled && !facts.node_disabled
    }
    if KssNameEquals(name, "readonly") || KssNameEquals(name, "read-only") {
        return facts.node_readonly || facts.readonly || facts.readonly_camel
    }
    if KssNameEquals(name, "required") {
        return facts.node_required || facts.required
    }
    if KssNameEquals(name, "optional") {
        return !facts.node_required && !facts.required
    }
    if KssNameEquals(name, "valid") {
        if facts.valid {
            return true
        }
        return KssIsFormControl(facts.kind, facts.tag) && !facts.invalid &&
            !facts.aria_invalid && !facts.extra_invalid
    }
    if KssNameEquals(name, "placeholder-shown") || KssNameEquals(name, "placeholder_shown") {
        if facts.placeholder_shown || facts.placeholder_shown_camel {
            return true
        }
        return KssIsFormControl(facts.kind, facts.tag) && facts.placeholder_present &&
            !facts.value_present
    }
    return facts.requested
}

KssStructuralFacts :: struct {
    has_parent: bool
    has_scope: bool
    is_scope: bool
    sibling_index: s32
    sibling_count: s32
    type_index: s32
    type_count: s32
    has_children: bool
    has_text: bool
    focus_within: bool
    target: bool
}

// -1 means the name is not a basic structural pseudo. KssPseudoMatch handles
// further dispatch; zero and one are complete decisions from these facts.
#program_export
KssStructuralMatch :: (name: string, facts: KssStructuralFacts) -> s32 {
    matched: bool = false
    if name == "root" {
        matched = !facts.has_parent
    } else if name == "scope" {
        if facts.has_scope {
            matched = facts.is_scope
        } else {
            matched = !facts.has_parent
        }
    } else if name == "first-child" {
        matched = facts.sibling_index == 0 && facts.sibling_count > 0
    } else if name == "last-child" {
        matched = facts.sibling_index >= 0 && facts.sibling_index == facts.sibling_count - 1
    } else if name == "only-child" {
        matched = facts.sibling_index == 0 && facts.sibling_count == 1
    } else if name == "first-of-type" {
        matched = facts.type_index == 0 && facts.type_count > 0
    } else if name == "last-of-type" {
        matched = facts.type_index >= 0 && facts.type_index == facts.type_count - 1
    } else if name == "only-of-type" {
        matched = facts.type_index == 0 && facts.type_count == 1
    } else if name == "empty" {
        matched = !facts.has_children && !facts.has_text
    } else if name == "focus-within" {
        matched = facts.focus_within
    } else if name == "target" {
        matched = facts.target
    } else {
        return -1
    }
    if matched {
        return 1
    }
    return 0
}

KssPseudoFunction :: struct {
    relative: bool
    positional: bool
    same_type: bool
    from_end: bool
}

#program_export
KssPseudoFunctionInfo :: (name: string) -> KssPseudoFunction {
    result: KssPseudoFunction
    result.relative = name == "has"
    result.positional = name == "nth-child" || name == "nth-last-child" ||
        name == "nth-of-type" || name == "nth-last-of-type"
    result.same_type = name == "nth-of-type" || name == "nth-last-of-type"
    result.from_end = name == "nth-last-child" || name == "nth-last-of-type"
    return result
}

// Names and arguments come from selector atoms. -1 requests relative :has
// traversal; all other supported/unknown cases resolve to zero or one here.
#program_export
KssPseudoMatch :: (name: string, argument: string, functional: bool,
    facts: KssStructuralFacts) -> s32 {
    if !functional {
        decision: s32 = KssStructuralMatch(name, facts)
        if decision < 0 {
            return 0
        }
        return decision
    }
    kind: KssPseudoFunction = KssPseudoFunctionInfo(name)
    if kind.relative {
        return -1
    }
    if !kind.positional {
        return 0
    }
    index: s32 = facts.sibling_index
    count: s32 = facts.sibling_count
    if kind.same_type {
        index = facts.type_index
        count = facts.type_count
    }
    matched: bool = KssNthSiblingMatches(argument, index, count, kind.from_end)
    if matched {
        return 1
    }
    return 0
}

// Declarative selector lexing. Results borrow spans from the input; the host
// stores the resulting selector objects but does not parse their syntax.
KssSelectorStack :: struct {
    bytes: [64]u8
}

KssSelectorSpan :: struct {
    parser: KssCursor
    start: s32
    length: s32
    combinator: s32
    ok: bool
    done: bool
}

KssSelectorComment :: (c: KssCursor) -> KssExpectResult {
    result: KssExpectResult
    line: bool = KssPeek(c, 1) == 47
    c = KssAdvance(c, 2)
    while !KssAtEnd(c) {
        if line && KssPeek(c, 0) == 10 {
            result.parser = c
            result.ok = true
            return result
        }
        if !line && KssPeek(c, 0) == 42 && KssPeek(c, 1) == 47 {
            result.parser = KssAdvance(c, 2)
            result.ok = true
            return result
        }
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = line
    return result
}

KssSelectorSpace :: (c: KssCursor) -> KssExpectResult {
    result: KssExpectResult
    while !KssAtEnd(c) {
        if KssIsSpace(KssPeek(c, 0)) {
            c = KssAdvance(c, 1)
        } else if KssPeek(c, 0) == 47 && (KssPeek(c, 1) == 42 || KssPeek(c, 1) == 47) {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                return comment
            }
        } else {
            break
        }
    }
    result.parser = c
    result.ok = true
    return result
}

KssSelectorPartMode :: (c: KssCursor, sequence: bool, relative: bool) -> KssSelectorSpan {
    result: KssSelectorSpan
    initial: s32 = c.pos
    skipped: KssExpectResult = KssSelectorSpace(c)
    c = skipped.parser
    result.parser = c
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.ok = !(initial > 0 && c.source[initial - 1] == 44)
        result.done = true
        return result
    }
    if sequence {
        if initial > 0 {
            result.combinator = 32
        }
        byte: u8 = KssPeek(c, 0)
        if byte == 62 || byte == 43 || byte == 126 {
            if initial == 0 && !relative {
                return result
            }
            result.combinator = cast(s32)byte
            skipped = KssSelectorSpace(KssAdvance(c, 1))
            c = skipped.parser
            result.parser = c
            if !skipped.ok || KssAtEnd(c) {
                return result
            }
        }
    }
    result.start = c.pos
    end: s32 = c.pos
    stack: KssSelectorStack
    depth: s32 = 0
    quote: u8 = 0
    while !KssAtEnd(c) {
        byte: u8 = KssPeek(c, 0)
        if quote != 0 {
            if byte == 92 && !KssIsLineBreak(KssPeek(c, 1)) {
                c = KssAdvance(c, 2)
                end = c.pos
                continue
            }
            if byte == quote || KssIsLineBreak(byte) {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && (KssPeek(c, 1) == 42 || (depth == 0 && KssPeek(c, 1) == 47)) {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                result.parser = c
                return result
            }
            continue
        } else if byte == 40 || byte == 91 {
            if depth >= 64 {
                result.parser = c
                return result
            }
            stack.bytes[depth] = byte
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            if depth == 0 {
                result.parser = c
                return result
            }
            opening: u8 = stack.bytes[depth - 1]
            if (byte == 41 && opening != 40) || (byte == 93 && opening != 91) {
                result.parser = c
                return result
            }
            depth = depth - 1
        } else if depth == 0 {
            if !sequence && byte == 44 {
                break
            }
            if sequence && (KssIsSpace(byte) || byte == 62 || byte == 43 || byte == 126) {
                break
            }
        }
        c = KssAdvance(c, 1)
        if !KssIsSpace(byte) || depth > 0 || quote != 0 {
            end = c.pos
        }
    }
    result.parser = c
    if depth != 0 || quote != 0 || end <= result.start {
        return result
    }
    result.length = end - result.start
    if !sequence && KssPeek(c, 0) == 44 {
        result.parser = KssAdvance(c, 1)
    }
    result.ok = true
    return result
}

#program_export
KssSelectorPart :: (c: KssCursor, sequence: bool) -> KssSelectorSpan {
    return KssSelectorPartMode(c, sequence, false)
}

#program_export
KssRelativeSelectorPart :: (c: KssCursor) -> KssSelectorSpan {
    result: KssSelectorSpan = KssSelectorPartMode(c, true, true)
    if c.pos == 0 && result.ok && !result.done && result.combinator == 0 {
        result.combinator = 32
    }
    return result
}

KssSelectorGroup :: (c: KssCursor) -> KssSelectorSpan {
    result: KssSelectorSpan
    opening: u8 = KssPeek(c, 0)
    stack: KssSelectorStack
    stack.bytes[0] = opening
    depth: s32 = 1
    quote: u8 = 0
    c = KssAdvance(c, 1)
    result.start = c.pos
    while !KssAtEnd(c) {
        byte: u8 = KssPeek(c, 0)
        if quote != 0 {
            if byte == 92 && !KssIsLineBreak(KssPeek(c, 1)) {
                c = KssAdvance(c, 2)
                continue
            }
            if byte == quote || KssIsLineBreak(byte) {
                quote = 0
            }
        } else if byte == 34 || byte == 39 {
            quote = byte
        } else if byte == 47 && KssPeek(c, 1) == 42 {
            comment: KssExpectResult = KssSelectorComment(c)
            c = comment.parser
            if !comment.ok {
                result.parser = c
                return result
            }
            continue
        } else if byte == 40 || byte == 91 {
            if depth >= 64 {
                result.parser = c
                return result
            }
            stack.bytes[depth] = byte
            depth = depth + 1
        } else if byte == 41 || byte == 93 {
            opening = stack.bytes[depth - 1]
            if (byte == 41 && opening != 40) || (byte == 93 && opening != 91) {
                result.parser = c
                return result
            }
            depth = depth - 1
            if depth == 0 {
                result.length = c.pos - result.start
                result.parser = KssAdvance(c, 1)
                result.ok = true
                return result
            }
        }
        c = KssAdvance(c, 1)
    }
    result.parser = c
    return result
}

// The host retains a stack of frames and supplies relationships for cursor.
// A popped child means that candidate failed, so the resumed frame tries the
// next ancestor/sibling only for descendant and general-sibling combinators.
KssSelectorChainAction :: enum {
    KssSelectorPop :: 0
    KssSelectorPush :: 1
    KssSelectorAccept :: 2
}

KssSelectorChainFrame :: struct {
    part: s32
    cursor: s32
    entered: bool
    anchored: bool
    anchor: s32
}

KssSelectorChainResult :: struct {
    frame: KssSelectorChainFrame
    next: KssSelectorChainFrame
    action: s32
}

#program_export
KssSelectorChainBegin :: (count: s32, node: s32) -> KssSelectorChainFrame {
    frame: KssSelectorChainFrame
    frame.part = count - 1
    frame.cursor = node
    return frame
}

#program_export
KssRelativeSelectorBegin :: (count: s32, node: s32, anchor: s32) -> KssSelectorChainFrame {
    frame: KssSelectorChainFrame = KssSelectorChainBegin(count, node)
    frame.anchored = count > 0 && anchor >= 0
    frame.anchor = anchor
    if !frame.anchored {
        frame.cursor = -1
    }
    return frame
}

#program_export
KssSelectorChainStep :: (frame: KssSelectorChainFrame, matched: bool,
    relation: s32, parent: s32, previous: s32) -> KssSelectorChainResult {
    result: KssSelectorChainResult
    result.frame = frame
    if frame.cursor < 0 {
        return result
    }
    if frame.part < 0 {
        if frame.part == -1 && frame.anchored && frame.cursor == frame.anchor {
            result.action = cast(s32)KssSelectorAccept
        }
        return result
    }
    repeated: bool = relation == 0 || relation == 32 || relation == 126
    if frame.entered {
        if !repeated {
            return result
        }
    } else {
        if !matched {
            return result
        }
        if frame.part == 0 && !frame.anchored {
            result.action = cast(s32)KssSelectorAccept
            return result
        }
    }
    candidate: s32 = -1
    if relation == 0 || relation == 32 || relation == 62 {
        candidate = parent
    } else if relation == 43 || relation == 126 {
        candidate = previous
    }
    if candidate < 0 {
        return result
    }
    result.frame.cursor = candidate
    result.frame.entered = true
    result.next.part = frame.part - 1
    result.next.cursor = candidate
    result.next.anchored = frame.anchored
    result.next.anchor = frame.anchor
    result.action = cast(s32)KssSelectorPush
    return result
}

// Hosts count matching alternatives; this policy owns selector-list negation.
#program_export
KssSelectorGroupMatches :: (name: string, count: s32, matching: s32) -> bool {
    if count <= 0 || matching < 0 || matching > count {
        return false
    }
    if name == "not" {
        return matching == 0
    }
    if name == "is" || name == "where" {
        return matching > 0
    }
    return false
}

KssSelectorAtomKind :: enum {
    KssSelectorKind :: 0
    KssSelectorId :: 1
    KssSelectorClass :: 2
    KssSelectorAttribute :: 3
    KssSelectorPseudo :: 4
    KssSelectorState :: 5
    KssSelectorNot :: 6
    KssSelectorMatches :: 7
}

KssSelectorCursor :: struct {
    cursor: KssCursor
    specificity: s32
    has_kind: bool
}

KssSelectorAtom :: struct {
    parser: KssSelectorCursor
    kind: s32
    name: string
    value: string
    operation: string
    argument: string
    canonical: KssName
    has_value: bool
    has_argument: bool
    ok: bool
    done: bool
}

#program_export
KssBeginSelector :: (source: string) -> KssSelectorCursor {
    parser: KssSelectorCursor
    parser.cursor.source = source
    return parser
}

KssPseudoName :: (source: string) -> KssName {
    name: KssName = KssStateName(source)
    index: s32 = 0
    while index < name.length {
        if name.bytes[index] == 95 {
            name.bytes[index] = 45
        }
        index = index + 1
    }
    return name
}

KssPseudoState :: (name: KssName) -> KssName {
    if KssNameEquals(name, "active") {
        return KssMakeName("pressed")
    }
    if KssNameEquals(name, "focused") || KssNameEquals(name, "focus-visible") {
        return KssMakeName("focus")
    }
    if KssNameEquals(name, "read-only") {
        return KssMakeName("readonly")
    }
    if KssNameEquals(name, "hover") || KssNameEquals(name, "pressed") ||
        KssNameEquals(name, "focus") || KssNameEquals(name, "normal") ||
        KssNameEquals(name, "disabled") || KssNameEquals(name, "loading") ||
        KssNameEquals(name, "selected") || KssNameEquals(name, "checked") {
        return name
    }
    if KssNameEquals(name, "invalid") || KssNameEquals(name, "valid") ||
        KssNameEquals(name, "indeterminate") || KssNameEquals(name, "default") ||
        KssNameEquals(name, "autofill") || KssNameEquals(name, "placeholder-shown") ||
        KssNameEquals(name, "expanded") || KssNameEquals(name, "open") {
        return name
    }
    if KssNameEquals(name, "readonly") || KssNameEquals(name, "required") ||
        KssNameEquals(name, "enabled") || KssNameEquals(name, "optional") {
        return name
    }
    empty: KssName
    return empty
}

KssSelectorAttributeAtom :: (result: KssSelectorAtom, group: KssSelectorSpan) -> KssSelectorAtom {
    c: KssCursor
    c.source = group.parser.source[group.start:group.start + group.length]
    skipped: KssExpectResult = KssSelectorSpace(c)
    c = skipped.parser
    start: s32 = c.pos
    key: KssNameResult = KssReadName(c)
    if !skipped.ok || !key.ok {
        return result
    }
    result.name = c.source[start:key.parser.pos]
    skipped = KssSelectorSpace(key.parser)
    c = skipped.parser
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.ok = true
        return result
    }
    start = c.pos
    byte: u8 = KssPeek(c, 0)
    if byte == 126 || byte == 124 || byte == 94 || byte == 36 || byte == 42 {
        c = KssAdvance(c, 1)
    }
    if KssPeek(c, 0) != 61 {
        return result
    }
    c = KssAdvance(c, 1)
    result.operation = c.source[start:c.pos]
    skipped = KssSelectorSpace(c)
    c = skipped.parser
    if !skipped.ok || KssAtEnd(c) {
        return result
    }
    start = c.pos
    end: s32 = (cast(s32)c.source.count)
    quote: u8 = KssPeek(c, 0)
    if quote == 34 || quote == 39 {
        c = KssAdvance(c, 1)
        start = c.pos
        while !KssAtEnd(c) && KssPeek(c, 0) != quote && !KssIsLineBreak(KssPeek(c, 0)) {
            if KssPeek(c, 0) == 92 && !KssIsLineBreak(KssPeek(c, 1)) {
                c = KssAdvance(c, 2)
            } else {
                c = KssAdvance(c, 1)
            }
        }
        if KssAtEnd(c) || KssPeek(c, 0) != quote {
            return result
        }
        end = c.pos
        skipped = KssSelectorSpace(KssAdvance(c, 1))
        if !skipped.ok || !KssAtEnd(skipped.parser) {
            return result
        }
    } else {
        while !KssAtEnd(c) && !KssIsSpace(KssPeek(c, 0)) {
            if KssPeek(c, 0) == 47 && KssPeek(c, 1) == 42 {
                break
            }
            c = KssAdvance(c, 1)
        }
        end = c.pos
        skipped = KssSelectorSpace(c)
        if !skipped.ok || !KssAtEnd(skipped.parser) {
            return result
        }
    }
    result.value = c.source[start:end]
    result.has_value = true
    result.ok = true
    return result
}

// Nested :has is outside the supported selector language. Inspect tokens,
// excluding quoted values, attributes, and comments, rather than searching text.
KssHasArgumentAllowed :: (source: string) -> bool {
    c: KssCursor
    c.source = source
    while !KssAtEnd(c) {
        skipped: KssExpectResult = KssSelectorSpace(c)
        c = skipped.parser
        if !skipped.ok {
            return false
        }
        byte: u8 = KssPeek(c, 0)
        if byte == 91 {
            group: KssSelectorSpan = KssSelectorGroup(c)
            if !group.ok {
                return false
            }
            c = group.parser
        } else if byte == 34 || byte == 39 {
            c = KssAdvance(c, 1)
            while !KssAtEnd(c) && KssPeek(c, 0) != byte {
                if KssPeek(c, 0) == 92 {
                    c = KssAdvance(c, 2)
                } else {
                    c = KssAdvance(c, 1)
                }
            }
            if KssAtEnd(c) {
                return false
            }
            c = KssAdvance(c, 1)
        } else if byte == 58 {
            c = KssAdvance(c, 1)
            start: s32 = c.pos
            name: KssNameResult = KssReadSelectorName(c)
            if !name.ok {
                return false
            }
            c = name.parser
            canonical: KssName = KssPseudoName(source[start:c.pos])
            if KssNameEquals(canonical, "has") && KssPeek(c, 0) == 40 {
                return false
            }
        } else {
            c = KssAdvance(c, 1)
        }
    }
    return true
}

#program_export
KssSelectorNext :: (parser: KssSelectorCursor) -> KssSelectorAtom {
    result: KssSelectorAtom
    result.parser = parser
    skipped: KssExpectResult = KssSelectorSpace(parser.cursor)
    c: KssCursor = skipped.parser
    result.parser.cursor = c
    if !skipped.ok {
        return result
    }
    if KssAtEnd(c) {
        result.done = true
        result.ok = true
        return result
    }
    byte: u8 = KssPeek(c, 0)
    start: s32 = c.pos
    if byte == 91 {
        group: KssSelectorSpan = KssSelectorGroup(c)
        result.parser.cursor = group.parser
        if !group.ok {
            return result
        }
        result.kind = cast(s32)KssSelectorAttribute
        result = KssSelectorAttributeAtom(result, group)
        if result.ok {
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 1, 0, 0)
        }
        return result
    }
    if byte == 35 || byte == 46 || byte == 58 {
        c = KssAdvance(c, 1)
        start = c.pos
        name: KssNameResult = KssReadSelectorName(c)
        if !name.ok || !KssIdentStart(KssPeek(c, 0)) {
            return result
        }
        c = name.parser
        result.name = c.source[start:c.pos]
        if byte == 35 {
            result.kind = cast(s32)KssSelectorId
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 0, 0, 1)
        } else if byte == 46 {
            result.kind = cast(s32)KssSelectorClass
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 0, 1, 0)
        } else {
            result.kind = cast(s32)KssSelectorPseudo
            result.canonical = KssPseudoName(result.name)
            if result.canonical.length == 0 {
                return result
            }
            result.parser.specificity = result.parser.specificity + StyleSpecificity(0, 1, 0, 0)
            if KssPeek(c, 0) == 40 {
                group: KssSelectorSpan = KssSelectorGroup(c)
                result.parser.cursor = group.parser
                if !group.ok {
                    return result
                }
                result.has_argument = true
                result.argument = c.source[group.start:group.start + group.length]
                c = group.parser
                if KssNameEquals(result.canonical, "not") || KssNameEquals(result.canonical, "is") ||
                    KssNameEquals(result.canonical, "where") || KssNameEquals(result.canonical, "has") {
                    argument_cursor: KssCursor
                    argument_cursor.source = result.argument
                    argument_space: KssExpectResult = KssSelectorSpace(argument_cursor)
                    if !argument_space.ok || KssAtEnd(argument_space.parser) {
                        return result
                    }
                }
                if KssNameEquals(result.canonical, "has") && !KssHasArgumentAllowed(result.argument) {
                    return result
                }
                if KssNameEquals(result.canonical, "not") {
                    result.kind = cast(s32)KssSelectorNot
                } else if KssNameEquals(result.canonical, "is") || KssNameEquals(result.canonical, "where") {
                    result.kind = cast(s32)KssSelectorMatches
                }
            } else {
                state: KssName = KssPseudoState(result.canonical)
                if state.length > 0 {
                    result.kind = cast(s32)KssSelectorState
                    result.canonical = state
                }
            }
        }
    } else {
        if parser.has_kind || (!KssIdentStart(byte) && byte != 42) {
            return result
        }
        while !KssAtEnd(c) {
            byte = KssPeek(c, 0)
            if KssIsSpace(byte) || byte == 46 || byte == 35 || byte == 91 || byte == 58 {
                break
            }
            if byte == 47 && (KssPeek(c, 1) == 42 || KssPeek(c, 1) == 47) {
                break
            }
            if byte == 44 || byte == 40 || byte == 41 || byte == 93 || byte == 62 || byte == 43 || byte == 126 {
                return result
            }
            c = KssAdvance(c, 1)
        }
        result.name = c.source[start:c.pos]
        result.kind = cast(s32)KssSelectorKind
        result.parser.has_kind = true
        if result.name != "*" {
            result.parser.specificity = result.parser.specificity + StyleSpecificity(1, 0, 0, 0)
        }
    }
    result.parser.cursor = c
    result.ok = true
    return result
}
