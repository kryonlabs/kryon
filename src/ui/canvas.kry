#module "canvas_host"
#import "ui_internal.h"
#import "runtime/canvas.h"
#import "runtime/canvas_grid.h"
#import "ui_style_internal.h"
#import "ui/paint_command.h"
#import "ui/widget_store.h"

ui_canvas_frame :: (class_name: i32) -> StyleFrame #export {
    return WidgetFrameForClassRole(ButtonToneNeutral,
    ButtonStateNormal, 0, 0, class_name, StyleKindCanvas(), StyleAny())
}

CanvasToScreen :: (canvas: Canvas, point: Vector2) -> Vector2 #export {
    scroll_x: i32 = 0
    scroll_y: i32 = 0
    zoom: float = 1.0
    if canvas.scroll_x != nil { scroll_x = *canvas.scroll_x }
    if canvas.scroll_y != nil { scroll_y = *canvas.scroll_y }
    if canvas.zoom != nil { zoom = *canvas.zoom }
    return CanvasPointToScreen(canvas.bounds, point,
    scroll_x, scroll_y, zoom)
}

CanvasRectToScreen :: (canvas: Canvas,
rect: Rectangle) -> Rectangle #export {
    scroll_x: i32 = 0
    scroll_y: i32 = 0
    zoom: float = 1.0
    if canvas.scroll_x != nil { scroll_x = *canvas.scroll_x }
    if canvas.scroll_y != nil { scroll_y = *canvas.scroll_y }
    if canvas.zoom != nil { zoom = *canvas.zoom }
    return CanvasRectToScreenBounds(canvas.bounds, rect,
    scroll_x, scroll_y, zoom)
}

RenderCanvasGrid :: (bounds: Rectangle, step: i32,
color: Color) #export {
    spacing: i32 = CanvasGridSpacing(Scale(step), 4)
    vertical_count: i32 = CanvasGridLineCount(bounds.width, spacing)
    horizontal_count: i32 = CanvasGridLineCount(bounds.height, spacing)
    packed: u32 = ColorToInt(color)

    index: i32 = 0
    while index < vertical_count {
        line: CanvasGridLine = CanvasGridVerticalLine(bounds,
        index, spacing, packed)
        DrawLine((int)line.bounds.x, (int)line.bounds.y,
        (int)line.bounds.x,
        (int)(line.bounds.y + line.bounds.height),
        GetColor(line.color))
        index += 1
    }
    index = 0
    while index < horizontal_count {
        line: CanvasGridLine = CanvasGridHorizontalLine(bounds,
        index, spacing, packed)
        DrawLine((int)line.bounds.x, (int)line.bounds.y,
        (int)(line.bounds.x + line.bounds.width),
        (int)line.bounds.y, GetColor(line.color))
        index += 1
    }
}

CanvasHitTest :: (point: Vector2, items: *Rectangle,
item_count: i32) -> i32 #export {
    if items == nil { return -1 }
    index: i32 = item_count - 1
    while index >= 0 {
        hit: i32 = CanvasHitTestStep(point, items[index], index, -1)
        if hit >= 0 { return hit }
        index -= 1
    }
    return -1
}

CanvasScope :: (canvas: Canvas) -> CanvasResult #export {
    toolkit: *ToolkitStore = toolkit_store_current()
    result: CanvasResult = (CanvasResult){0}
    mouse: Vector2 = ui_mouse_world()
    if IsWindowReady() {
        DrawWidgetFrame(canvas.bounds, canvas.bounds,
        ui_canvas_frame(canvas.class_name), 0, 0, 0, 0)
    }
    scroll_x: i32 = 0
    scroll_y: i32 = 0
    zoom: float = 1.0
    if canvas.scroll_x != nil { scroll_x = *canvas.scroll_x }
    if canvas.scroll_y != nil { scroll_y = *canvas.scroll_y }
    if canvas.zoom != nil { zoom = *canvas.zoom }
    policy: CanvasPolicyResult = CanvasBeginResultFor(canvas.bounds,
    mouse, scroll_x, scroll_y, zoom,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT))
    result.active = policy.active
    result.dragging = policy.dragging
    result.world = policy.world

    if toolkit->canvas_depth == toolkit->canvas_capacity {
        capacity: i32 = 8
        if toolkit->canvas_capacity > 0 {
            capacity = toolkit->canvas_capacity * 2
        }
        scopes: *CanvasScopeState = (CanvasScopeState*)realloc(
        toolkit->canvases, (size_t)capacity * sizeof(CanvasScopeState))
        if scopes == nil { abort() }
        toolkit->canvases = scopes
        toolkit->canvas_capacity = capacity
    }
    scope: CanvasScopeState = (CanvasScopeState){0}
    scope.paint = IsWindowReady()
    scope.transform = CanvasHasTransform(canvas.scroll_x != nil,
    canvas.scroll_y != nil, canvas.zoom != nil, zoom)
    PushInputClip(canvas.bounds)
    if scope.paint != 0 {
        BeginClip((int)canvas.bounds.x, (int)canvas.bounds.y,
        (int)canvas.bounds.width, (int)canvas.bounds.height)
        if scope.transform != 0 {
            scope.projection = rlGetMatrixProjection()
            scope.modelview = rlGetMatrixModelview()
            transform: CanvasTransform = CanvasTransformFor(
            canvas.bounds, scroll_x, scroll_y, zoom)
            camera: Camera2D = (Camera2D){0}
            camera.offset = (Vector2){transform.x, transform.y}
            camera.zoom = transform.scale
            BeginMode2D(camera)
        }
    }
    toolkit->canvases[toolkit->canvas_depth] = scope
    toolkit->canvas_depth += 1
    return result
}

CanvasEndScope :: (canvas: Canvas) #export {
    toolkit: *ToolkitStore = toolkit_store_current()
    if toolkit->canvas_depth == 0 { return }
    toolkit->canvas_depth -= 1
    scope: CanvasScopeState = toolkit->canvases[toolkit->canvas_depth]
    if scope.paint != 0 {
        if scope.transform != 0 {
            EndMode2D()
            rlSetMatrixProjection(scope.projection)
            rlSetMatrixModelview(scope.modelview)
        }
        EndClip()
    }
    PopInputClip()
    if scope.paint != 0 {
        style: Style = ui_unpack_style(
        ui_style_apply_effects_frame(
        ui_canvas_frame(canvas.class_name)).value)
        DrawRectangleLinesEx(canvas.bounds, 1.0, style.border)
    }
}
