// Independent CPU scene reference for native GLES material execution.
#import, file "shader_benchmark_workloads.zi";
#import "kryon/shader"
#import "kryon/scene"
#import "kryon/scene_render"
#import "std/image"
#import "std/vec"
#import "std/byte_text_linux"
GPU :: #import, file "../src/backend/scene_gpu.zi";

CheckShadows :: (gpu: *GPU.SceneGpuContext) -> bool {
    scene: Scene; SceneInit(*scene); defer SceneFree(*scene)
    scene.background=.{20,30,40,255}
    AddHemisphereLight(*scene,.{180,220,255,255},.{100,70,40,255},1.0)
    sun:=AddDirectionalLight(*scene,.{255,220,190,255},3.0,.{-3,7,-5})
    CastLightShadow(*scene,sun,5,5,0.1,20,128,-0.0006,0.06,1)
    box:=RoundedBox(*scene,1,1,1,0.1,LitMaterial(.{160,90,40,255}))
    unused SetShadows(*scene,box,true,true)
    floor:=Plane(*scene,5,5,LitMaterial(.{170,170,170,255}))
    unused SetRotation(*scene,floor,-1.5707963267948966,0,0)
    unused SetPosition(*scene,floor,0,-0.7,0)
    unused SetShadows(*scene,floor,false,true)
    camera:=PerspectiveCamera(45,1.6,0.1,20); camera.position=.{0,1,3}
    cpu:=NewImage(160,100); hardware:=NewImage(160,100)
    defer { VecFree(cpu.pixels); VecFree(hardware.pixels) }

    frame:=GPU.SceneGpuRender(gpu,*scene,camera,*hardware)
    if !frame.ok || !frame.accelerated {
        print("Shadow GPU frame failed: %\n",frame.diagnostic)
        return false
    }
    scene.lights[sun].shadow=false
    if !GPU.SceneGpuRender(gpu,*scene,camera,*cpu).accelerated { return false }
    changed: s64
    for at: 0..cpu.pixels.count-1 {
        if cpu.pixels[at]!=hardware.pixels[at] { changed+=1 }
    }
    scene.lights[sun].shadow=true
    if !RenderScene(*scene,camera,*cpu) { return false }
    total: s64; large: s64
    for at: 0..cpu.pixels.count-1 {
        delta:=cast(s32)cpu.pixels[at]-cast(s32)hardware.pixels[at]
        if delta<0 { delta=-delta }
        total+=delta
        if delta>16 { large+=1 }
    }
    print("Shadow accuracy hardware comparison % changed channels % mean_lsb % over_sixteen %\n",
        gpu.capabilities.pcf_available,changed,cast(float64)total/cast(float64)cpu.pixels.count,large)
    return changed>0 && total<=cpu.pixels.count && large<=cpu.pixels.count/200
}

#program_export
main :: () -> s32 {
    gpu: GPU.SceneGpuContext; defer GPU.SceneGpuRelease(*gpu)
    caps:=GPU.SceneGpuProbe(*gpu)
    if !caps.available { print("GPU unavailable: %\n",caps.diagnostic); return 1 }
    print("accuracy renderer % %\n",TextFromCString(*caps.renderer[0]),TextFromCString(*caps.version[0]))
    texture: [256*256*4]u8; ShaderBenchTexture(texture[:])
    samplers: [1]ShaderSampler=.[.{256,256,texture[:],true}]
    uniforms: [2]ShaderValue=.[.{0.25,0.25,0.25,0.25},.{0.0,64.0*3.141592653589793,0.0,0.0}]
    cpu:=NewImage(64,64); hardware:=NewImage(64,64)
    defer { VecFree(cpu.pixels); VecFree(hardware.pixels); RenderSceneRelease() }
    camera:=OrthographicCamera(-1.0,1.0,1.0,-1.0,0.1,10.0); camera.position=.{0.0,0.0,3.0}
    failures: s32
    for kind: 0..7 {
        program: ShaderProgram
        if !ShaderBenchProgram(*program,cast(s32)kind) { return 2 }
        scene: Scene; SceneInit(*scene)
        material:=UnlitMaterial(.{255,255,255,255})
        material.shader=*program; material.shader_uniforms=uniforms[:]; material.shader_samplers=samplers[:]
        unused Plane(*scene,2.0,2.0,material)
        for frame: 0..2 {
            time:=0.25+cast(float64)frame/60.0; uniforms[0]=.{time,time,time,time}
            if !RenderScene(*scene,camera,*cpu) {
                print("CPU reference failed for workload %, frame % (scene failed: %, image bytes: %)\n",kind,frame,scene.failed,cpu.pixels.count)
                return 3
            }
            hardware_frame:=GPU.SceneGpuRender(*gpu,*scene,camera,*hardware)
            if !hardware_frame.accelerated { print("GPU frame failed: %\n",hardware_frame.diagnostic); return 3 }
            total: s64; maximum: s32; differing: s64
            for at: 0..cpu.pixels.count-1 {
                delta:=cast(s32)cpu.pixels[at]-cast(s32)hardware.pixels[at]
                if delta<0 { delta=-delta }
                total+=delta; if delta>maximum { maximum=delta }
                if delta>2 { differing+=1 }
            }
            mean:=cast(float64)total/cast(float64)cpu.pixels.count
            print("accuracy % % mean_lsb % max_lsb % over_two %\n",kind,frame,mean,maximum,differing)
            // highp float32 GLSL is compared with the float64 CPU reference.
            // Report every error and reject visible/channel-wide differences.
            if mean>0.25 || maximum>8 { failures+=1 }
        }
        SceneFree(*scene); ShaderFree(*program)
    }
    if !CheckShadows(*gpu) { failures+=1 }
    return failures
}
