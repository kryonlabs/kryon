#import "drawing_props"
#import "geometry"
#import "raster"
#import "raster_shape"
#import "raster_text"
#import "tree"
host_api :: #system_library "host_api";

PaintKind :: enum {
    PaintKindLine = 1
    PaintKindRoundedFill = 2
    PaintKindRoundedOutline = 3
    PaintKindText = 4
    PaintKindImage = 5
    PaintKindClippedText = 6
}

PaintCommand :: struct {
    kind: s32
    node: s32
    bounds: Rectangle
    color: Color
    radius: float32
    segments: s32
    line_width: float32
    value: string
    x: s32
    y: s32
    font: s32
    asset_path: string
    texture_id: u32
    source: Rectangle
    clip: Rectangle
    origin: Vector2
    rotation: float32
}

PaintCommands :: struct {
    items: [4096]PaintCommand
    count: s32
    overflow: bool
}

pending_paint: PaintCommands;

# Raw rasterization; the queued source, clip, radius, and tint are chosen in
# checked widget code before this device effect is called.
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) #foreign host_api;

#program_export
EmitPaint :: (command: PaintCommand) {
    if command.kind == PaintKindLine {
        StrokeLine(command.bounds, command.color)
    } else if command.kind == PaintKindRoundedFill {
        FillRoundedRectangle(command.bounds, command.radius,
            command.segments, command.color)
    } else if command.kind == PaintKindRoundedOutline {
        StrokeRoundedRectangle(command.bounds, command.radius,
            command.segments, command.line_width, command.color)
    } else if command.kind == PaintKindText {
        PaintText(command.value, command.x, command.y,
            command.font, command.color)
    } else if command.kind == PaintKindImage {
        if command.clip.width > 0.0 && command.clip.height > 0.0 {
            RasterImage(command.asset_path, command.texture_id,
                command.source, command.bounds, command.clip,
                command.origin, command.rotation, command.radius,
                command.color)
        }
    } else if command.kind == PaintKindClippedText {
        PaintTextClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip)
    }
}

#program_export
SubmitPaint :: (command: PaintCommand) {
    if command.node < 0 && !TreeIsBuilding() {
        EmitPaint(command)
        return
    }
    if pending_paint.count >= 4096 {
        pending_paint.overflow = true
        return
    }
    if command.node >= 0 && TreeIsBuilding() {
        entry: TreeEntry = TreeSubmittedNodeAt(command.node)
        dx: float32 = entry.bounds.x - entry.measured_bounds.x
        dy: float32 = entry.bounds.y - entry.measured_bounds.y
        full_bounds: bool = command.bounds.x == entry.measured_bounds.x &&
            command.bounds.y == entry.measured_bounds.y &&
            command.bounds.width == entry.measured_bounds.width &&
            command.bounds.height == entry.measured_bounds.height
        full_clip: bool = command.clip.x == entry.measured_bounds.x &&
            command.clip.y == entry.measured_bounds.y &&
            command.clip.width == entry.measured_bounds.width &&
            command.clip.height == entry.measured_bounds.height
        command.bounds.x += dx
        command.bounds.y += dy
        command.clip.x += dx
        command.clip.y += dy
        command.x += cast(s32)dx
        command.y += cast(s32)dy
        if full_bounds {
            command.bounds.width = entry.bounds.width
            command.bounds.height = entry.bounds.height
        }
        if full_clip {
            command.clip.width = entry.bounds.width
            command.clip.height = entry.bounds.height
        }
        if entry.clipped {
            if command.kind == PaintKindText {
                command.kind = PaintKindClippedText
                command.clip = entry.clip
            } else if command.kind == PaintKindClippedText ||
                command.kind == PaintKindImage {
                command.clip = RectangleIntersection(command.clip,
                    entry.clip)
            }
        }
    }
    pending_paint.items[pending_paint.count] = command
    pending_paint.count += 1
}

#program_export
PaintLine :: (node: s32, bounds: Rectangle,
    color: Color) {
    command: PaintCommand
    command.kind = PaintKindLine
    command.node = node
    command.bounds = bounds
    command.color = color
    SubmitPaint(command)
}

#program_export
PaintRoundedFill :: (node: s32, bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    command: PaintCommand
    command.kind = PaintKindRoundedFill
    command.node = node
    command.bounds = bounds
    command.radius = radius
    command.segments = segments
    command.color = color
    SubmitPaint(command)
}

#program_export
PaintRoundedOutline :: (node: s32, bounds: Rectangle, radius: float32,
    segments: s32, line_width: float32, color: Color) {
    command: PaintCommand
    command.kind = PaintKindRoundedOutline
    command.node = node
    command.bounds = bounds
    command.radius = radius
    command.segments = segments
    command.line_width = line_width
    command.color = color
    SubmitPaint(command)
}

#program_export
PaintLabel :: (node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color) {
    command: PaintCommand
    command.kind = PaintKindText
    command.node = node
    command.value = value
    command.x = x
    command.y = y
    command.font = font
    command.color = color
    SubmitPaint(command)
}

#program_export
PaintClippedLabel :: (node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    command: PaintCommand
    command.kind = PaintKindClippedText
    command.node = node
    command.value = value
    command.x = x
    command.y = y
    command.font = font
    command.color = color
    command.clip = clip
    SubmitPaint(command)
}

#program_export
PaintImage :: (node: s32, asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    command: PaintCommand
    command.kind = PaintKindImage
    command.node = node
    command.asset_path = asset_path
    command.texture_id = texture_id
    command.source = source
    command.bounds = destination
    command.clip = clip
    command.origin = origin
    command.rotation = rotation
    command.radius = radius
    command.color = tint
    SubmitPaint(command)
}

#program_export
PaintClear :: () {
    index: s32 = 0
    while index < pending_paint.count {
        empty: PaintCommand
        pending_paint.items[index] = empty
        index += 1
    }
    pending_paint.count = 0
    pending_paint.overflow = false
}

#program_export
PaintOverflow :: () -> bool {
    return pending_paint.overflow
}

# The pending commands are inspectable after the tree commits and before
# PaintFlush clears them. A failed commit clears the queue instead.
#program_export
PendingPaintCount :: () -> s32 {
    return pending_paint.count
}

#program_export
PendingPaintAt :: (index: s32) -> PaintCommand {
    empty: PaintCommand
    if index < 0 || index >= pending_paint.count { return empty }
    return pending_paint.items[index]
}

#program_export
PaintFlush :: () {
    index: s32 = 0
    while index < pending_paint.count {
        EmitPaint(pending_paint.items[index])
        index += 1
    }
    PaintClear()
}
