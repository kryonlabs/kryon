// Actual public widgets for the before/after contact sheets. No mock drawing
// substitutes for a control. Nonvisual containers contain ordinary children.
using UI :: #import "Widgets";
using Scenes :: #import "scenes";
#if #defined(REVIEW_DESKTOP) {
    #import "cairo_raster"
    #import "desktop_runtime"
} else {
    #import "pixmap"
    #import "pixmap_frame"
}
#import "tree_draw"
#import "page_text"
#import "flow"
#import "panedview"
#import "paned_view_props"
#import "transition"
ReviewTheme :: #import "theme";
#import "system_theme"
#import "text_selection_widget"
#import "std/file"

// Linux resets this high-water mark at exec. wait4's ru_maxrss can include
// the Python launcher's pre-exec memory, even for an empty native process.
ResidentKib :: (field: string) -> s64 {
    status, ok := ReadEntireFile("/proc/self/status")
    if !ok { return -1 }
    for at: cast(s64)0..status.count - 7 {
        if (at == 0 || status[at - 1] == 10) && status[at:at + 6] == field {
            value: s64 = 0
            index := at + 6
            while index < status.count && status[index] != 10 {
                digit := status[index]
                if digit >= 48 && digit <= 57 { value = value * 10 + cast(s64)digit - 48 }
                index += 1
            }
            return value
        }
    }
    return -1
}

#import "std/byte_text_linux";
#import "std/c_string";
libc :: #system_library "c";
ReviewEnvironment :: (name: *u8) -> *u8 #foreign libc "getenv";
Clock :: #import "std/timer_linux";
ReviewStamp :: struct { seconds: s64; nanoseconds: s64 }
ReviewClock :: (kind: s32, stamp: *ReviewStamp) -> s32 #foreign libc "clock_gettime";
ReviewSleep :: (stamp: *ReviewStamp, remaining: *ReviewStamp) -> s32 #foreign libc "nanosleep";
CpuNow :: () -> s64 { stamp: ReviewStamp; unused ReviewClock(2, *stamp); return stamp.seconds * 1000000000 + stamp.nanoseconds }


pixels: [153600]u32;
image: [4096]u32;

EnvNumber :: (name: string) -> s32 {
    buffer: [128]u8
    if !CopyCString(name, buffer[:]) { return 0 }
    value := TextFromCString(ReviewEnvironment(*buffer[0]))
    number: s32 = 0
    for digit: value { if digit >= 48 && digit <= 57 { number = number * 10 + cast(s32)digit - 48 } }
    return number
}


#program_export
Run :: () -> s32 {
    started := Clock.MonotonicNanoseconds()
    scene_image = "review-image"
    scene := EnvNumber("KRYON_REVIEW_SCENE")
    state := EnvNumber("KRYON_REVIEW_STATE")
    metrics := EnvNumber("KRYON_REVIEW_METRICS") > 0
    for index: 0..4095 { image[index] = ifx (index / 512 + index % 64 / 8) % 2 == 0 then cast(u32)0xff287d91 else cast(u32)0xff83b5a0 }
    #if #defined(REVIEW_DESKTOP) {
        // Use a real file through the ordinary image decoder on this host.
        key: [64]u8
        unused CopyCString("KRYON_REVIEW_FIXTURE", key[:])
        scene_image = TextFromCString(ReviewEnvironment(*key[0]))
        if scene_image == "" { scene_image = "backup/material-widgets/fixture.png" }
        if !OpenDesktopSized(480, 320) { return 1 }
        defer CloseDesktop()
    } else {
        if !PixmapSetImage(0, "review-image", 64, 64, image[:]) { return 1 }
        defer { PixmapCloseWorkers(); PixmapClearImage(0); PixmapEndInto() }
    }
    session := SessionOpen()
    defer CloseSession(session)
    if !SessionValid(session) { return 2 }
    active := EnvNumber("KRYON_REVIEW_ACTIVE") > 0
    palette := SystemPaletteFromCss("", (scene == 55 || scene == 57))
    if scene >= 54 { if !SystemPaletteInstall(palette) { return 7 } }
    background := ifx scene >= 54 then palette.background else ReviewTheme.LightBackground()
    count := ifx metrics then 130 else 3
    if metrics { print("frame,total_ns,nodes,paint,emitted,damage_pixels,frame_text_reserve_bytes,cpu_ns\n") }
    for frame: 0..count - 1 {
        #if #defined(REVIEW_DESKTOP) {
            BeginDesktopFrame()
        } else {
            if !PixmapResumeInto(480, 320, pixels[:]) { return 3 }
        }
        if active { PaintSnapshotInvalidate(session) }
        if state == 2 { TreePointerUpdate(session, PointerFrame.{48.0, (ifx scene == 20 then 264.0 else 86.0), false, false, false}) }
        if state == 4 { TreePointerUpdate(session, PointerFrame.{48.0, (ifx scene == 20 then 264.0 else 86.0), frame >= 1, frame == 1, false}) }
        if state == 3 && frame == 1 { unused KeyboardSend(session, KeyTab) }
        cpu_start := CpuNow()
        start := Clock.MonotonicNanoseconds()
        if BeginFrame(session, 1, .{0.0, 0.0, 480.0, 320.0}) != FrameStatus.FrameOk { return 4 }
        unused Box(session, BoxProps.{.key = 2, .bounds = .{0.0, 0.0, 480.0, 320.0}, .fill = ColorFromPacked(background)})
        if scene < 54 { Compose(session, scene, state == 1) }
        else if scene >= 56 { Compose(session, 54, state == 1) }
        else {
            unused Button(session, ButtonProps.{.key = 10, .bounds = .{24.0, 64.0, 208.0, 44.0}, .label = "Continue", .tone = .ButtonToneAccent, .disabled = state == 1})
            unused Button(session, ButtonProps.{.key = 11, .bounds = .{248.0, 64.0, 208.0, 44.0}, .label = "Tonal action", .emphasis = .ButtonEmphasisSoft, .disabled = state == 1})
            unused TextField(session, TextFieldProps.{.key = 12, .bounds = .{24.0, 128.0, 432.0, 44.0}, .value = "A quiet place to think", .disabled = state == 1})
            unused Toggle(session, ToggleProps.{.key = 13, .bounds = .{24.0, 196.0, 432.0, 44.0}, .label = "Notifications", .value = true, .disabled = state == 1})
        }
        result: FrameEndResult
        emitted: s32
        #if #defined(REVIEW_DESKTOP) {
            result = CommitFrameDamaged(session)
            if !result.paint_unchanged { emitted = result.paint_count; PaintFlush(session) }
            DesktopFrameUnchanged(result.paint_unchanged)
            if !EndDesktopFrame() { return 5 }
        } else {
            pixels_result := EndPixmapFrame(session, true, background, true)
            result.status = pixels_result.status; result.paint_count = pixels_result.paint_count
            result.damage = pixels_result.damage; emitted = pixels_result.emitted_count
        }
        if metrics && frame == 0 { print("# startup_ns,%\n", Clock.MonotonicNanoseconds() - started) }
        if scene == 50 && frame == 0 && state != 1 { unused TreeFocusAt(session, 2) }
        elapsed := Clock.MonotonicNanoseconds() - start
        cpu_elapsed := CpuNow() - cpu_start
        if result.status != FrameStatus.FrameOk { return 5 }
        reserved: s64 = pending_text[session.slot].capacity * cast(s64)(PAINT_TEXT_CAPACITY + 4)
        #if #defined(REVIEW_INLINE_TEXT) {
            reserved += cast(s64)(PAINT_TEXT_CAPACITY + 4)
        }
        #if #defined(REVIEW_SIZED_TEXT) {
            reserved += pending_short_text[session.slot].capacity * cast(s64)(PAINT_SHORT_TEXT_CAPACITY + 4)
            reserved += pending_medium_text[session.slot].capacity * cast(s64)(PAINT_MEDIUM_TEXT_CAPACITY + 4)
        }
        if metrics && frame >= 10 { print("%,%,%,%,%,%,%,%\n", frame - 10, elapsed, TreeCount(session), result.paint_count, emitted, cast(s64)(result.damage.width * result.damage.height), reserved, cpu_elapsed) }
    }
    if !metrics {
        #if #defined(REVIEW_DESKTOP) {
            if !CaptureConfigured() { return 6 }
        } else {
            PixmapPresent()
        }
    } else {
        print("# runner_peak_rss_kib,%\n", ResidentKib("VmHWM:"))
        print("# steady_rss_kib,%\n", ResidentKib("VmRSS:"))
        // No animation timer is added by styling. Measure a quiet retained host.
        cpu_start := CpuNow(); wall_start := Clock.MonotonicNanoseconds()
        for idle: 0..4 {
            #if #defined(REVIEW_DESKTOP) {
                // Drain our window's queued events before the bounded quiet
                // interval; event creation at startup must not masquerade as
                // an idle spin. Hosts still own their normal activity policy.
                unused PollDesktop()
            }
            delay: ReviewStamp = .{0, 40000000}; unused ReviewSleep(*delay, null)
        }
        print("# idle_cpu_ns,%\n", CpuNow() - cpu_start)
        print("# idle_wall_ns,%\n", Clock.MonotonicNanoseconds() - wall_start)
    }
    return 0
}
