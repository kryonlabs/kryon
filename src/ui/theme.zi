ThemePolicy :: enum {
    ThemePolicySystem :: 0
    ThemePolicyLight :: 1
    ThemePolicyDark :: 2
}
using ThemePolicy;

#program_export
ResolveDark :: (policy: ThemePolicy, system_dark: bool) -> bool {
    if policy == .ThemePolicyLight { return false }
    if policy == .ThemePolicyDark { return true }
    return system_dark
}

#program_export
PackedColor :: (rgb: u32, alpha: u32) -> u32 {
    return (rgb << cast(u32)8) | alpha
}

Palette :: struct {
    background: u32; surface: u32; surface_raised: u32; surface_muted: u32; surface_sunken: u32
    foreground: u32; text_secondary: u32; text_muted: u32; text_disabled: u32
    icon: u32; icon_muted: u32; border: u32; subtle_border: u32; strong_border: u32
    focus: u32; hover_layer: u32; active_layer: u32; scrim: u32
    selection: u32; selection_text: u32; accent: u32; accent_strong: u32
    accent_subtle: u32; on_accent: u32; control_on: u32; control_glyph: u32
    control_track: u32; control_track_hover: u32; control_thumb: u32; control_thumb_on: u32
    success: u32; on_success: u32; warning: u32; on_warning: u32; danger: u32; on_danger: u32
    info: u32; on_info: u32; link: u32; shadow: u32
}

SeriesTokens :: struct { items: [6]u32 }

ShadowLayer :: struct {
    blur: float32; offset_y: float32; spread: float32; opacity: float32
}

ShadowTokens :: struct {
    rest: ShadowLayer; raised: [2]ShadowLayer; floating: [2]ShadowLayer
}

MotionTokens :: struct {
    highlight_ms: float32; hover_ms: float32; state_ms: float32
    enter_ms: float32; exit_ms: float32; theme_ms: float32
    multiplier: float32; saved_multiplier: float32; reduced_motion: bool
    oklab_theme_transition: bool
}

FontTokens :: struct {
    body: string; control: string; heading: string; code: string; icon: string
}

Metrics :: struct {
    radius_mark: float32; radius_item: float32; radius_small: float32
    radius_medium: float32; radius_large: float32; radius_surface: float32; radius_pill: float32
    border_width: float32; focus_width: float32; focus_gap: float32
    space_1: float32; space_2: float32; space_3: float32; space_4: float32
    space_5: float32; space_6: float32
    control_height_small: float32; control_height_medium: float32; control_height_large: float32
    control_padding_small: float32; control_padding_medium: float32; control_padding_large: float32
    control_gap: float32; text_xs: float32; text_sm: float32; text_body: float32; text_lg: float32
    heading_1: float32; heading_2: float32; heading_3: float32; heading_4: float32
    icon_size_small: float32; icon_size_medium: float32; icon_size_large: float32
    disabled_opacity: float32
}

ThemeTokens :: struct {
    dark: bool; colors: Palette; series: SeriesTokens; metrics: Metrics
    shadows: ShadowTokens; motion: MotionTokens; fonts: FontTokens
}

ThemeColorRole :: enum {
    ThemeColorBackground :: 0
    ThemeColorSurface :: 1
    ThemeColorSurfaceRaised :: 2
    ThemeColorSurfaceMuted :: 3
    ThemeColorSurfaceSunken :: 4
    ThemeColorForeground :: 5
    ThemeColorTextSecondary :: 6
    ThemeColorTextMuted :: 7
    ThemeColorTextDisabled :: 8
    ThemeColorIcon :: 9
    ThemeColorIconMuted :: 10
    ThemeColorBorder :: 11
    ThemeColorSubtleBorder :: 12
    ThemeColorStrongBorder :: 13
    ThemeColorFocus :: 14
    ThemeColorHoverLayer :: 15
    ThemeColorActiveLayer :: 16
    ThemeColorScrim :: 17
    ThemeColorSelection :: 18
    ThemeColorSelectionText :: 19
    ThemeColorAccent :: 20
    ThemeColorAccentStrong :: 21
    ThemeColorAccentSubtle :: 22
    ThemeColorOnAccent :: 23
    ThemeColorControlOn :: 24
    ThemeColorControlGlyph :: 25
    ThemeColorControlTrack :: 26
    ThemeColorControlTrackHover :: 27
    ThemeColorControlThumb :: 28
    ThemeColorControlThumbOn :: 29
    ThemeColorSuccess :: 30
    ThemeColorOnSuccess :: 31
    ThemeColorWarning :: 32
    ThemeColorOnWarning :: 33
    ThemeColorDanger :: 34
    ThemeColorOnDanger :: 35
    ThemeColorInfo :: 36
    ThemeColorOnInfo :: 37
    ThemeColorLink :: 38
    ThemeColorShadow :: 39
}
using ThemeColorRole;

ThemeMetricRole :: enum {
    ThemeMetricRadiusMark :: 0
    ThemeMetricRadiusItem :: 1
    ThemeMetricRadiusSmall :: 2
    ThemeMetricRadiusControl :: 3
    ThemeMetricRadiusPanel :: 4
    ThemeMetricRadiusSurface :: 5
    ThemeMetricRadiusPill :: 6
    ThemeMetricBorderWidth :: 7
    ThemeMetricFocusWidth :: 8
    ThemeMetricFocusGap :: 9
    ThemeMetricSpace1 :: 10
    ThemeMetricSpace2 :: 11
    ThemeMetricSpace3 :: 12
    ThemeMetricSpace4 :: 13
    ThemeMetricSpace5 :: 14
    ThemeMetricSpace6 :: 15
    ThemeMetricControlHeightSmall :: 16
    ThemeMetricControlHeightMedium :: 17
    ThemeMetricControlHeightLarge :: 18
    ThemeMetricControlPaddingSmall :: 19
    ThemeMetricControlPaddingMedium :: 20
    ThemeMetricControlPaddingLarge :: 21
    ThemeMetricControlGap :: 22
    ThemeMetricTextXS :: 23
    ThemeMetricTextSM :: 24
    ThemeMetricTextBody :: 25
    ThemeMetricTextLG :: 26
    ThemeMetricHeading1 :: 27
    ThemeMetricHeading2 :: 28
    ThemeMetricHeading3 :: 29
    ThemeMetricHeading4 :: 30
    ThemeMetricIconSmall :: 31
    ThemeMetricIconMedium :: 32
    ThemeMetricIconLarge :: 33
