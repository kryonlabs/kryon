#module "segmented_control"
#import "style"
#import "control_props"

SegmentedMetrics :: struct {
    gap: i32
    row_height: i32
    min_item_width: i32
    max_item_width: i32
    label_padding: i32
}

SegmentedRow :: struct {
    start: i32
    count: i32
    width: i32
    button_width: i32
    x: i32
    y: i32
}

SegmentedMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if (fields & field) == (u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

SegmentedDefaultMetrics :: (row_height: i32, min_item_width: i32,
    max_item_width: i32, scale: float, control: StyleFrame,
    segment: StyleFrame) -> SegmentedMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: SegmentedMetrics
    metrics.gap = SegmentedMetric(segment.value.fields, (u32)StyleGap,
        segment.value.gap, -1.0, scale, true)
    if metrics.gap < 0 {
        metrics.gap = SegmentedMetric(control.value.fields, (u32)StyleGap,
            control.value.gap, 6.0, scale, true)
    }
    metrics.row_height = row_height
    if metrics.row_height <= 0 {
        metrics.row_height = SegmentedMetric(control.value.fields,
            (u32)StyleIconSize, control.value.icon_size, 30.0, scale, false)
    }
    metrics.min_item_width = min_item_width
    if metrics.min_item_width <= 0 {
        metrics.min_item_width = SegmentedMetric(control.value.fields,
            (u32)StyleContentOffset, control.value.offset_x, 72.0, scale,
            false)
    }
    metrics.max_item_width = max_item_width
    if metrics.max_item_width <= 0 {
        metrics.max_item_width = SegmentedMetric(control.value.fields,
            (u32)StyleContentOffset, control.value.offset_y, 180.0, scale,
            false)
    }
    if metrics.max_item_width > 0 && metrics.max_item_width < metrics.min_item_width {
        metrics.max_item_width = metrics.min_item_width
    }
    label_padding: float = segment.value.padding_x * 2.0
    if (segment.value.fields & (u32)StylePaddingX) == (u32)0 ||
       segment.value.padding_x < 0.0 {
        label_padding = 20.0
    }
    metrics.label_padding = SegmentedMetric(segment.value.fields,
        (u32)StyleContentOffset, segment.value.offset_x, label_padding, scale, true)
    return metrics
}

SegmentedItemWidth :: (label_width: i32, metrics: SegmentedMetrics) -> i32 #export {
    width: i32 = label_width + metrics.label_padding
    if width < metrics.min_item_width {
        width = metrics.min_item_width
    }
    if metrics.max_item_width > 0 && width > metrics.max_item_width {
        width = metrics.max_item_width
    }
    return width
}

SegmentedNextRowWidth :: (row_width: i32, item_width: i32, gap: i32) -> i32 #export {
    if row_width > 0 {
        return row_width + gap + item_width
    }
    return item_width
}

SegmentedShouldWrap :: (wrap: bool, row_width: i32, next_width: i32,
    available_width: i32) -> bool #export {
    return wrap && row_width > 0 && next_width > available_width
}

SegmentedHeightForRows :: (rows: i32, row_height: i32, gap: i32) -> i32 #export {
    if rows <= 0 || row_height <= 0 {
        return 0
    }
    return rows * row_height + (rows - 1) * gap
}

SegmentedFocusIdFor :: (control_id: i32, index: i32) -> i32 #export {
    if control_id <= 0 || index < 0 {
        return 0
    }
    return control_id * 1000 + index + 1
}

SegmentedRowFor :: (bounds_x: float, bounds_width: float, y: i32,
    row_start: i32, row_count: i32, row_width: i32, wrap: bool,
    metrics: SegmentedMetrics) -> SegmentedRow #export {
    row: SegmentedRow
    row.start = row_start
    row.count = row_count
    row.width = row_width
    row.y = y
    available: i32 = (i32)bounds_width
    if row_count <= 0 || available <= 0 {
        return row
    }
    if wrap {
        row.button_width = (available - metrics.gap * (row_count - 1)) / row_count
        row.x = (i32)bounds_x + (available -
            (row.button_width * row_count + metrics.gap * (row_count - 1))) / 2
    } else {
        row.button_width = row_width / row_count
        row.x = (i32)bounds_x
    }
    if row.button_width < 0 {
        row.button_width = 0
    }
    return row
}
