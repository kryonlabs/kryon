// Part of the kss_parser module, loaded by src/kss/kss_parser.zi.
// Widget kinds, classes, states, tones, emphases, sizes, and roles by name.

// Stable class ids match StyleClassId in the C and Go pack registries.

KssClassId :: (name: KssName) -> s32 {
    hash: u32 = 2166136261
    if name.length == 0 {
        return 0
    }
    index: s32 = 0
    while index < name.length {
        hash = hash ^ cast(u32)name.bytes[index]
        hash = hash * cast(u32)16777619
        index = index + 1
    }
    hash = hash & cast(u32)2147483647
    if hash == 0 {
        return 1
    }
    return cast(s32)hash
}

KssKindValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "*") || KssNameEquals(name, "Any") {
        return StyleKindAny()
    }
    if KssNameEquals(name, "App") {
        return StyleKindApp()
    }
    if KssNameEquals(name, "Button") {
        return StyleKindButton()
    }
    if KssNameEquals(name, "Text") {
        return StyleKindText()
    }
    if KssNameEquals(name, "TextField") {
        return StyleKindTextField()
    }
    if KssNameEquals(name, "TextArea") {
        return StyleKindTextArea()
    }
    if KssNameEquals(name, "Surface") {
        return StyleKindSurface()
    }
    if KssNameEquals(name, "Dropdown") {
        return StyleKindDropdown()
    }
    if KssNameEquals(name, "Card") {
        return StyleKindCard()
    }
    if KssNameEquals(name, "Slider") {
        return StyleKindSlider()
    }
    if KssNameEquals(name, "SliderThumb") {
        return StyleKindSliderThumb()
    }
    if KssNameEquals(name, "Toggle") {
        return StyleKindToggle()
    }
    if KssNameEquals(name, "ToggleThumb") {
        return StyleKindToggleThumb()
    }
    if KssNameEquals(name, "Scroll") {
        return StyleKindScroll()
    }
    if KssNameEquals(name, "ScrollThumb") {
        return StyleKindScrollThumb()
    }
    if KssNameEquals(name, "Checkbox") {
        return StyleKindCheckbox()
    }
    if KssNameEquals(name, "Radio") {
        return StyleKindRadio()
    }
    if KssNameEquals(name, "Progress") {
        return StyleKindProgress()
    }
    if KssNameEquals(name, "Separator") {
        return StyleKindSeparator()
    }
    if KssNameEquals(name, "NavigationBar") {
        return StyleKindNavigationBar()
    }
    if KssNameEquals(name, "NavigationBarItem") {
        return StyleKindNavigationBarItem()
    }
    if KssNameEquals(name, "Selectable") {
        return StyleKindSelectable()
    }
    if KssNameEquals(name, "Fieldset") {
        return StyleKindFieldset()
    }
    if KssNameEquals(name, "Plot") {
        return StyleKindPlot()
    }
    if KssNameEquals(name, "PlotMark") {
        return StyleKindPlotMark()
    }
    if KssNameEquals(name, "Link") {
        return StyleKindLink()
    }
    if KssNameEquals(name, "TabBar") {
        return StyleKindTabBar()
    }
    if KssNameEquals(name, "Tab") {
        return StyleKindTab()
    }
    if KssNameEquals(name, "TabClose") {
        return StyleKindTabClose()
    }
    if KssNameEquals(name, "SegmentedControl") {
        return StyleKindSegmentedControl()
    }
    if KssNameEquals(name, "Segment") {
        return StyleKindSegment()
    }
    if KssNameEquals(name, "Menu") {
        return StyleKindMenu()
    }
    if KssNameEquals(name, "MenuItem") {
        return StyleKindMenuItem()
    }
    if KssNameEquals(name, "MenuSeparator") {
        return StyleKindMenuSeparator()
    }
    if KssNameEquals(name, "ListBox") {
        return StyleKindListBox()
    }
    if KssNameEquals(name, "ListBoxItem") {
        return StyleKindListBoxItem()
    }
    if KssNameEquals(name, "TreeView") {
        return StyleKindTreeView()
    }
    if KssNameEquals(name, "TreeViewItem") {
        return StyleKindTreeViewItem()
    }
    return KssKindValueMore(name)
}

KssKindValueMore :: (name: KssName) -> s32 {
    if KssNameEquals(name, "ListBoxMulti") {
        return StyleKindListBoxMulti()
    }
    if KssNameEquals(name, "ListBoxMultiItem") {
        return StyleKindListBoxMultiItem()
    }
    if KssNameEquals(name, "DragDropTarget") {
        return StyleKindDragDropTarget()
    }
    if KssNameEquals(name, "Spinbox") {
        return StyleKindSpinbox()
    }
    if KssNameEquals(name, "SpinboxValue") {
        return StyleKindSpinboxValue()
    }
    if KssNameEquals(name, "ColorPicker") {
        return StyleKindColorPicker()
    }
    if KssNameEquals(name, "ColorPickerSwatch") {
        return StyleKindColorPickerSwatch()
    }
    if KssNameEquals(name, "PanedView") {
        return StyleKindPanedView()
    }
    if KssNameEquals(name, "Toast") {
        return StyleKindToast()
    }
    if KssNameEquals(name, "Collapsible") {
        return StyleKindCollapsible()
    }
    if KssNameEquals(name, "TitleBar") {
        return StyleKindTitleBar()
    }
    if KssNameEquals(name, "Toolbar") {
        return StyleKindToolbar()
    }
    if KssNameEquals(name, "Modal") {
        return StyleKindModal()
    }
    if KssNameEquals(name, "TableView") {
        return StyleKindTableView()
    }
    if KssNameEquals(name, "Guide") {
        return StyleKindGuide()
    }
    if KssNameEquals(name, "Image") {
        return StyleKindImage()
    }
    if KssNameEquals(name, "Focus") {
        return StyleKindFocus()
    }
    if KssNameEquals(name, "Popup") {
        return StyleKindPopup()
    }
    if KssNameEquals(name, "Canvas") {
        return StyleKindCanvas()
    }
    if KssNameEquals(name, "Drag") {
        return StyleKindDrag()
    }
    if KssNameEquals(name, "DragValue") {
        return StyleKindDragValue()
    }
    if KssNameEquals(name, "Heading") {
        return StyleKindHeading()
    }
    if KssNameEquals(name, "ParagraphText") {
        return StyleKindParagraphText()
    }
    if KssNameEquals(name, "Page") {
        return StyleKindPage()
    }
    if KssNameEquals(name, "Section") {
        return StyleKindSection()
    }
    if KssNameEquals(name, "Reorder") {
        return StyleKindReorder()
    }
    return -999999
}

KssStateValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "any") {
        return StyleStateAny()
    }
    if KssNameEquals(name, "normal") {
        return cast(s32)ButtonStateNormal
    }
    if KssNameEquals(name, "hover") {
        return cast(s32)ButtonStateHover
    }
    if KssNameEquals(name, "pressed") || KssNameEquals(name, "press") {
        return cast(s32)ButtonStatePressed
    }
    if KssNameEquals(name, "focus") || KssNameEquals(name, "focused") {
        return cast(s32)ButtonStateFocus
    }
    if KssNameEquals(name, "disabled") {
        return cast(s32)ButtonStateDisabled
    }
    if KssNameEquals(name, "loading") {
        return cast(s32)ButtonStateLoading
    }
    if KssNameEquals(name, "selected") {
        return cast(s32)ButtonStateSelected
    }
    return -999999
}

KssToneValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "any") {
        return StyleAny()
    }
    if KssNameEquals(name, "Neutral") {
        return cast(s32)ButtonToneNeutral
    }
    if KssNameEquals(name, "Accent") {
        return cast(s32)ButtonToneAccent
    }
    if KssNameEquals(name, "Danger") {
        return cast(s32)ButtonToneDanger
    }
    if KssNameEquals(name, "Success") {
        return cast(s32)ButtonToneSuccess
    }
    if KssNameEquals(name, "Warning") {
        return cast(s32)ButtonToneWarning
    }
    return -999999
}

KssEmphasisValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "any") {
        return StyleAny()
    }
    if KssNameEquals(name, "Filled") {
        return cast(s32)ButtonEmphasisFilled
    }
    if KssNameEquals(name, "Soft") {
        return cast(s32)ButtonEmphasisSoft
    }
    if KssNameEquals(name, "Outline") {
        return cast(s32)ButtonEmphasisOutline
    }
    if KssNameEquals(name, "Ghost") {
        return cast(s32)ButtonEmphasisGhost
    }
    if KssNameEquals(name, "Link") {
        return cast(s32)ButtonEmphasisLink
    }
    return -999999
}

KssSizeValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "any") {
        return StyleAny()
    }
    if KssNameEquals(name, "Medium") {
        return cast(s32)ControlSizeMedium
    }
    if KssNameEquals(name, "Small") {
        return cast(s32)ControlSizeSmall
    }
    if KssNameEquals(name, "Large") {
        return cast(s32)ControlSizeLarge
    }
    return -999999
}

KssRoleValue :: (name: KssName) -> s32 {
    if KssNameEquals(name, "Any") {
        return StyleAny()
    }
    if KssNameEquals(name, "Bar") || KssNameEquals(name, "MenuBar") {
        return 1
    }
    if KssNameEquals(name, "Popup") || KssNameEquals(name, "Panel") ||
        KssNameEquals(name, "MenuPopup") {
        return 2
    }
    if KssNameEquals(name, "Context") || KssNameEquals(name, "MenuContext") {
        return 3
    }
    if KssNameEquals(name, "Track") {
        return 4
    }
    if KssNameEquals(name, "Fill") {
        return 5
    }
    if KssNameEquals(name, "Label") || KssNameEquals(name, "Text") {
        return 6
    }
    if KssNameEquals(name, "Line") {
        return 7
    }
    if KssNameEquals(name, "Bullet") {
        return 8
    }
    if KssNameEquals(name, "Box") {
        return 9
    }
    if KssNameEquals(name, "Mark") || KssNameEquals(name, "Check") {
        return 10
    }
    if KssNameEquals(name, "Ring") {
        return 11
    }
    if KssNameEquals(name, "Handle") {
        return 12
    }
    if KssNameEquals(name, "Header") {
        return 13
    }
    if KssNameEquals(name, "TreeHeader") {
        return 14
    }
    if KssNameEquals(name, "Close") {
        return 15
    }
    if KssNameEquals(name, "Title") {
        return 16
    }
    if KssNameEquals(name, "Action") {
        return 17
    }
    if KssNameEquals(name, "Divider") {
        return 18
    }
    if KssNameEquals(name, "Scrim") {
        return 19
    }
    if KssNameEquals(name, "Message") {
        return 20
    }
    if KssNameEquals(name, "Row") {
        return 21
    }
    if KssNameEquals(name, "Cell") {
        return 22
    }
    if KssNameEquals(name, "Selection") || KssNameEquals(name, "Selected") {
        return 23
    }
    if KssNameEquals(name, "Anchor") {
        return 24
    }
    if KssNameEquals(name, "Placeholder") {
        return 25
    }
    if KssNameEquals(name, "Option") {
        return 26
    }
    if KssNameEquals(name, "Scrollbar") {
        return 27
    }
    if KssNameEquals(name, "BottomBar") {
        return 28
    }
    if KssNameEquals(name, "BottomAction") {
        return 29
    }
    return -999999
}
