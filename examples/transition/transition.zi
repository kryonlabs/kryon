using UI :: #import "kryon/Widgets";
#import "kryon/frame_snapshot"
DemoTheme :: #import "kryon/Theme";

state: TransitionState;

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    input := CaptureFrameInput(session)
    Text(session, TextProps.{.disabled = example_disabled, .key = 1, .bounds = .{viewport.x + 20.0, viewport.y + 16.0, viewport.width - 40.0, 40.0}, .text = "Transition", .font = 28})
    if Button(session, ButtonProps.{.disabled = example_disabled, .key = 10, .bounds = .{viewport.x + 20.0, viewport.y + 76.0, 180.0, 44.0}, .label = "Animate fade"}) != 0 { state = TransitionStart(0.6) }
    state = TransitionAdvance(state, (ifx (example_reduced_motion || DemoTheme.CurrentTheme().motion.reduced_motion) then 1.0 else cast(float32)input.delta_ms / 1000.0)).state
    bounds := Rectangle.{viewport.x + 20.0, viewport.y + 144.0, viewport.width - 40.0, 128.0}
    Text(session, TextProps.{.disabled = example_disabled, .key = 11, .bounds = bounds, .text = "A transition over this content"})
    Box(session, BoxProps.{.key = 12, .bounds = bounds, .fill = TransitionFadeColor(state, .{16, 34, 45, 180})})
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
