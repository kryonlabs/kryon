#import "overlay"

// Laws for dismissible overlays. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A release outside an overlay that allows dismissing, and that no one else
// took, closes it and takes the release; otherwise the overlay stays and
// the release is left as it was.
#law OutsideReleaseCloses custom DismissibleOverlayPolicyFor(true, false, false, false).closed && DismissibleOverlayPolicyFor(true, false, false, false).outside_released && DismissibleOverlayPolicyFor(true, false, false, false).release_consumed;
#law OtherwiseStays forall released: 0..1, consumed: 0..1, locked: 0..1, inside: 0..1 => (B(released) && !B(consumed) && !B(locked) && !B(inside)) || (!DismissibleOverlayPolicyFor(B(released), B(consumed), B(locked), B(inside)).closed && DismissibleOverlayPolicyFor(B(released), B(consumed), B(locked), B(inside)).release_consumed == B(consumed));
