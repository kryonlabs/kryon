#import "geometry"

ToastState :: struct {
    message: string
    class_name: s32
    id: s32
    until_seconds: float64
    action_label: string
}

ToastProps :: struct {
    key: u64
    id: s32
    viewport: Rectangle
    state: ToastState
    message: string
    class_name: s32
    seconds: float64
    now_seconds: float64
    scale: float32
    clear: bool
    // Captured with a new message; an empty label leaves the toast passive.
    action_label: string
}

ToastResult :: struct {
    state: ToastState
    visible: bool
    node: s32
    bounds: Rectangle
    display: string
    ellipsis: bool
    action_clicked: bool
}
