#program_export
ControlHeightFor :: (size: s32) -> float32 {
    metrics := CurrentTheme().metrics
    if size == 1 { return metrics.control_height_small }
    if size == 2 { return metrics.control_height_large }
    return metrics.control_height_medium
}

#program_export
MotionDuration :: (purpose: s32, reduced_motion: bool, multiplier: float32) -> float32 {
    motion := CurrentTheme().motion
    duration := motion.state_ms
    if purpose == 0 { duration = motion.highlight_ms }
    else if purpose == 1 { duration = motion.hover_ms }
    else if purpose == 2 { duration = motion.state_ms }
    else if purpose == 3 { duration = motion.enter_ms }
    else if purpose == 4 { duration = motion.exit_ms }
    else if purpose == 5 { duration = motion.theme_ms }
    if reduced_motion { return 0.0 }
    if multiplier < 0.0 { multiplier = 0.0 }
    return duration * multiplier
}

#program_export
OnColor :: (color: u32) -> u32 {
    red: u32 = (color >> cast(u32)24) & cast(u32)255
    green: u32 = (color >> cast(u32)16) & cast(u32)255
    blue: u32 = (color >> cast(u32)8) & cast(u32)255
    luminance := (red * cast(u32)299 + green * cast(u32)587 + blue * cast(u32)114) / cast(u32)1000
    if luminance < cast(u32)128 { return cast(u32)0xffffffff }
    return cast(u32)0x0b0b0bff
}

ClampChannel :: (value: s32) -> u32 {
    if value < 0 { return cast(u32)0 }
    if value > 255 { return cast(u32)255 }
    return cast(u32)value
}

#program_export
ToneFor :: (base: u32, light_delta: s32, dark_delta: s32, dark: bool) -> u32 {
    delta: s32 = dark_delta
    if !dark { delta = light_delta }
    if delta < -255 { delta = -255 }
    if delta > 255 { delta = 255 }
    if !dark { delta = -delta }
    red: u32 = ClampChannel(cast(s32)((base >> cast(u32)24) & cast(u32)255) + delta)
    green: u32 = ClampChannel(cast(s32)((base >> cast(u32)16) & cast(u32)255) + delta)
    blue: u32 = ClampChannel(cast(s32)((base >> cast(u32)8) & cast(u32)255) + delta)
    return (red << cast(u32)24) | (green << cast(u32)16) | (blue << cast(u32)8) | (base & cast(u32)255)
}

Scheme :: struct {
    primary: u32; on_primary: u32; secondary: u32; on_secondary: u32
    surface: u32; on_surface: u32; surface_container: u32; surface_variant: u32
    on_surface_variant: u32; outline: u32; error: u32; on_error: u32
    disabled_container: u32; disabled_content: u32; primary_container: u32
    on_primary_container: u32; secondary_container: u32; on_secondary_container: u32
    surface_container_low: u32; surface_container_high: u32; outline_variant: u32
    inverse_surface: u32; on_inverse_surface: u32; scrim: u32
}

#program_export
SchemeFor :: (background: u32, surface: u32, text: u32, primary: u32,
              secondary: u32, dark: bool, disabled_alpha: u8) -> Scheme {
    scheme: Scheme
    colors := ifx dark then DarkPalette() else LightPalette()
    scheme.primary = primary; scheme.on_primary = OnColor(primary)
    scheme.secondary = secondary; scheme.on_secondary = OnColor(secondary)
    scheme.surface = surface
    if (surface & cast(u32)255) == cast(u32)0 { scheme.surface = background }
    scheme.on_surface = text; scheme.surface_container = colors.surface_muted
    scheme.surface_variant = colors.surface_raised; scheme.on_surface_variant = colors.text_secondary
    scheme.outline = colors.border; scheme.error = colors.danger; scheme.on_error = colors.on_danger
    scheme.disabled_container = colors.surface_muted
    scheme.disabled_content = (text & ~cast(u32)255) | cast(u32)disabled_alpha
    scheme.primary_container = colors.accent_subtle; scheme.on_primary_container = colors.accent_strong
    scheme.secondary_container = StateLayer(colors.surface, secondary, cast(u32)16)
    scheme.on_secondary_container = text; scheme.surface_container_low = colors.subtle_border
    scheme.surface_container_high = colors.surface_muted; scheme.outline_variant = colors.subtle_border
    scheme.inverse_surface = text; scheme.on_inverse_surface = scheme.surface; scheme.scrim = colors.scrim
    return scheme
}

#program_export
StateLayer :: (background: u32, content: u32, percent: u32) -> u32 {
    if percent > cast(u32)100 { percent = cast(u32)100 }
    if (background & cast(u32)255) == cast(u32)0 {
        return (content & ~cast(u32)255) | (percent * cast(u32)255 / cast(u32)100)
    }
    red := (((background >> cast(u32)24) & cast(u32)255) * (cast(u32)100 - percent) + ((content >> cast(u32)24) & cast(u32)255) * percent) / cast(u32)100
    green := (((background >> cast(u32)16) & cast(u32)255) * (cast(u32)100 - percent) + ((content >> cast(u32)16) & cast(u32)255) * percent) / cast(u32)100
    blue := (((background >> cast(u32)8) & cast(u32)255) * (cast(u32)100 - percent) + ((content >> cast(u32)8) & cast(u32)255) * percent) / cast(u32)100
    return (red << cast(u32)24) | (green << cast(u32)16) | (blue << cast(u32)8) | (background & cast(u32)255)
}
