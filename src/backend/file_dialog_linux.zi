// Desktop-themed GTK3 file selection. Run on an owned helper process so the
// application event loop keeps running; no zenity or desktop-specific shell.
#import "std/c_string"
#import "std/byte_text_linux"
gtk :: #system_library "gtk-3";
glib :: #system_library "glib-2.0";
gdk :: #system_library "gdk-3";
gobject :: #system_library "gobject-2.0";
x11 :: #system_library "X11";
FileDialogInit :: (argc: *s32, argv: ***u8) -> s32 #foreign gtk "gtk_init_check";
New :: (title: *u8, parent: *void, action: s32, first_button: *u8) -> *void #foreign gtk "gtk_file_chooser_dialog_new";
AddButton :: (dialog: *void, label: *u8, response: s32) -> *void #foreign gtk "gtk_dialog_add_button";
Default :: (dialog: *void, response: s32) #foreign gtk "gtk_dialog_set_default_response";
Local :: (dialog: *void, local: s32) #foreign gtk "gtk_file_chooser_set_local_only";
Overwrite :: (dialog: *void, confirm: s32) #foreign gtk "gtk_file_chooser_set_do_overwrite_confirmation";
Name :: (dialog: *void, name: *u8) #foreign gtk "gtk_file_chooser_set_current_name";
FilterNew :: () -> *void #foreign gtk "gtk_file_filter_new";
FilterName :: (filter: *void, name: *u8) #foreign gtk "gtk_file_filter_set_name";
Pattern :: (filter: *void, pattern: *u8) #foreign gtk "gtk_file_filter_add_pattern";
AddFilter :: (dialog: *void, filter: *void) #foreign gtk "gtk_file_chooser_add_filter";
Run :: (dialog: *void) -> s32 #foreign gtk "gtk_dialog_run";
Filename :: (dialog: *void) -> *u8 #foreign gtk "gtk_file_chooser_get_filename";
Destroy :: (dialog: *void) #foreign gtk "gtk_widget_destroy";
FileDialogFree :: (value: *u8) #foreign glib "g_free";
Realize :: (dialog: *void) #foreign gtk "gtk_widget_realize";
Window :: (dialog: *void) -> *void #foreign gtk "gtk_widget_get_window";
IsX11 :: (window: *void, type: u64) -> s32 #foreign gobject "g_type_check_instance_is_a";
X11Type :: () -> u64 #foreign gdk "gdk_x11_window_get_type";
Xid :: (window: *void) -> u64 #foreign gdk "gdk_x11_window_get_xid";
Display :: () -> *void #foreign gdk "gdk_x11_get_default_xdisplay";
Transient :: (display: *void, window: u64, parent: u64) -> s32 #foreign x11 "XSetTransientForHint";

FileDialogProps :: struct {
    title: string
    accept_label: string
    filename: string
    save: bool
    filter_name: string
    patterns: []string
    // The application's own X11 window. Only the helper's dialog is changed.
    parent_x11_window: u64
}
FileDialogResult :: struct { available: bool; accepted: bool; bytes: s32 }

#program_export
FileDialog :: (props: FileDialogProps, output: []u8) -> FileDialogResult {
    result: FileDialogResult
    title: [1024]u8; accept: [128]u8; cancel: [16]u8; name: [4096]u8
    if output.count < 2 || !CopyCString(props.title, title[:]) || FileDialogInit(null, null) == 0 { return result }
    label := props.accept_label; if label == "" { label = ifx props.save then "_Save" else "_Open" }
    if !CopyCString(label, accept[:]) || !CopyCString("_Cancel", cancel[:]) { return result }
    action: s32 = ifx props.save then 1 else 0
    dialog := New(*title[0], null, action, null); if dialog == null { return result }
    defer { Destroy(dialog) }
    Local(dialog, 1); Overwrite(dialog, ifx props.save then 1 else 0)
    unused AddButton(dialog, *cancel[0], -6); unused AddButton(dialog, *accept[0], -3)
    Default(dialog, -3)
    if props.save && props.filename != "" && CopyCString(props.filename, name[:]) { Name(dialog, *name[0]) }
    if props.patterns.count > 0 {
        filter := FilterNew()
        if filter == null { return result }
        AddFilter(dialog, filter)
        if CopyCString(props.filter_name, name[:]) { FilterName(filter, *name[0]) }
        for i: 0..cast(s32)props.patterns.count - 1 {
            if !CopyCString(props.patterns[i], name[:]) { return result }
            Pattern(filter, *name[0])
        }
    }
    if props.parent_x11_window != 0 {
        Realize(dialog); window := Window(dialog)
        if window != null && IsX11(window, X11Type()) != 0 {
            display := Display()
            if display != null { unused Transient(display, Xid(window), props.parent_x11_window) }
        }
    }
    result.available = true
    if Run(dialog) != -3 { return result }
    path := Filename(dialog); if path == null { result.available = false; return result }
    defer { FileDialogFree(path) }
    value := TextFromCString(path)
    if !CopyCString(value, output) { result.available = false; return result }
    result.accepted = true; result.bytes = cast(s32)value.count
    return result
}
