// An interactive portable Kryon app. Build and run as documented in BACKENDS.md.
Surface :: #import "kryon/host/surface";
Button :: #import "kryon/button";
Text :: #import "kryon/text";
TextField :: #import "kryon/text_field";
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/key_input"
#import "std/number_text"

clicks: s32;
value: TextField.State;
value_bytes: [128]u8;
last_width: s32;
last_height: s32;

Draw :: (frame: Surface.Frame) {
    session: Session = .{frame.slot, frame.epoch}
    viewport := TreeRootBounds(session)
    width := viewport.width - 24.0
    if cast(s32)viewport.width != last_width || cast(s32)viewport.height != last_height {
        last_width = cast(s32)viewport.width
        last_height = cast(s32)viewport.height
        print("surface % x %\n", last_width, last_height)
    }
    if Button.Draw(session, .{.key = 2, .bounds = .{12.0, 36.0, width, 38.0},
        .label = "Count click"}) != 0 {
        clicks += 1
        print("click %\n", clicks)
    }
    digits: [24]u8
    Text.Draw(session, .{.key = 1, .bounds = .{12.0, 8.0, width, 24.0},
        .text = FormatInteger(cast(s64)clicks, digits[:]), .size = 18})
    typed: [128]u8
    input := TextFieldInputFor(KeyboardTake(session), KeyboardModifiers(session), TypedTextTake(session, typed[:]))
    field := TextField.StateProps(value, .{.key = 3, .bounds = .{12.0, 82.0, width, 38.0},
        .placeholder = "Type here", .input = input})
    changed := TextField.Draw(session, field)
    if TextField.StateApplyResult(*value, changed) && changed.edit.changed {
        print("text %\n", TextView(value.bytes[:value.length]))
    }
}

#program_export
main :: () -> s32 {
    value.bytes = value_bytes[:]
    window: Surface.Window = .{.title = "Kryon hosted surface", .width = 240, .height = 144}
    #if #defined(SURFACE_SMOKE_TIMED) {
        return Surface.RunRetained(window, Draw, 250)
    } else {
        return Surface.Run(window, Draw)
    }
}
