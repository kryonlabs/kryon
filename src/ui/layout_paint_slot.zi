#import "geometry"
#import "session"
#import "style"
#import "style_sheet"

// A Row, Column or Grid with a CSS background or border paints its box
// through these. Containers install the painter on first use, so a plain
// frame carries no container painter. A nonnegative mark moves the box beneath
// commands queued since that mark; the box takes the container's transform.
LayoutBoxPaint :: #type (Session, Rectangle, StyleData, StyleBoxData, s64, s32) -> void;
layout_box_paint: LayoutBoxPaint;
