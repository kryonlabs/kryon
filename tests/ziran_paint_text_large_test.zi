#import "drawing_props";
#import "geometry";
#import "paint_queue";
#import "session";
#import "tree";
#import "tree_draw";

draws: s32;
images: s32;
bad: bool;
changed_last: bool;
callback_session: Session;
callbacks: s32;

QueueCallback :: (session: Session, value: string) {
    command: QueuedPaint
    command.data.node = -1
    command.data.value = value
    command.data.color.r = 1
    command.emit = AppendDuringFlush
    command.has_emitter = true
    SubmitPaint(session, command)
}

// An emitter can grow the inspected queue. Its input remains a value copy,
// and the newly appended command still owns its temporary label bytes.
AppendDuringFlush :: (data: PaintCommand) {
    expected := ifx callbacks == 0 then "first" else "later"
    if data.value != expected || data.color.r != 1 { bad = true }
    callbacks += 1
    data.color.r = 99
    if PendingPaintAt(callback_session, callbacks - 1).color.r != 1 { bad = true }
    if callbacks == 1 {
        bytes: [5]u8 = .[108, 97, 116, 101, 114]
        for index: 0..15 { QueueCallback(callback_session, TextView(bytes[:])) }
        for index: 0..4 { bytes[index] = 88 }
    }
}

CheckAppendOwnership :: (session: Session) -> bool {
    callback_session = session
    PaintDispose(session)
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    bytes: [5]u8 = .[102, 105, 114, 115, 116]
    QueueCallback(session, TextView(bytes[:]))
    for index: 0..4 { bytes[index] = 88 }
    PaintFlush(session)
    TreeCancel(session)
    return callbacks == 17 && !bad && PendingPaintCount(session) == 0
}

// Queue many glyph-sized buffers, reusing each immediately. The total text
// exceeds the old frame limit, including thousands of temporary buffers.
QueueLabels :: (session: Session) {
    for index: 0..4999 {
        bytes: [8]u8 = .[49, 50, 51, 52, 53, 54, 55, 56]
        if changed_last && index == 4999 { bytes[7] = 88 }
        PaintClippedLabel(session, -1, TextView(bytes[:]), 0, 0, 14,
            Color.{1, 2, 3, 255}, Rectangle.{0.0, 0.0, 100.0, 100.0})
        for at: 0..7 { bytes[at] = 88 }
    }
}

// A settings dialog may change the same buffer after Image was composed.
QueueAsset :: (session: Session) {
    path: [9]u8 = .[97, 115, 115, 101, 116, 46, 112, 110, 103]
    bounds := Rectangle.{0.0, 0.0, 100.0, 100.0}
    PaintImage(session, -1, TextView(path[:]), cast(u32)0,
        bounds, bounds, bounds, Vector2.{}, 0.0, 0.0, Color.{255, 255, 255, 255})
    for index: 0..8 { path[index] = 88 }
}

// One command can retain both fields. Appending its full-block image path
// grows the pool after its label was retained and must preserve both ranges.
SubmitMixedBuffers :: (session: Session, label: string, path: string) -> bool {
    command: QueuedPaint
    command.data.node = -1
    command.data.value = label
    command.data.asset_path = path
    command.data.bounds = Rectangle.{1.0, 2.0, 3.0, 4.0}
    command.data.color = Color.{1, 2, 3, 4}
    SubmitPaint(session, command)
    return !command.data.owns_text && !command.data.owns_asset
}

CheckMixedOwnership :: (session: Session) -> bool {
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    label: [8]u8 = .[49, 50, 51, 52, 53, 54, 55, 56]
    path: [PAINT_TEXT_CAPACITY]u8
    path[0] = 65
    path[PAINT_TEXT_CAPACITY - 1] = 90
    if !SubmitMixedBuffers(session, TextView(label[:]), TextView(path[:])) { return false }
    for index: 0..7 { label[index] = 88 }
    path[0] = 88
    path[PAINT_TEXT_CAPACITY - 1] = 88
    retained := PendingPaintAt(session, 0)
    if retained.value != "12345678" || retained.asset_path.count != PAINT_TEXT_CAPACITY ||
        retained.asset_path[0] != 65 || retained.asset_path[PAINT_TEXT_CAPACITY - 1] != 90 ||
        !retained.owns_text || !retained.owns_asset ||
        retained.text_block == retained.asset_block ||
        retained.bounds.width != 3.0 || retained.color.a != 4 { return false }
    blocks := pending_text[session.slot].count
    empty: QueuedPaint
    empty.data.node = -1
    SubmitPaint(session, empty)
    if pending_text[session.slot].count != blocks ||
        PendingPaintAt(session, 1).owns_text || PendingPaintAt(session, 1).owns_asset { return false }
    PaintFlush(session)
    TreeCancel(session)
    return !PaintOverflow(session) && PendingPaintCount(session) == 0
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    unused x; unused y; unused font; unused color
    expected := "12345678"
    if changed_last && draws % 5000 == 4999 { expected = "1234567X" }
    if value != expected { bad = true }
    draws += 1
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if clip.width != 100.0 { bad = true }
    RasterText(value, x, y, font, color)
}

#program_export
RasterLine :: (bounds: Rectangle, color: Color) { unused bounds; unused color }
#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) { unused bounds; unused radius; unused segments; unused color }
#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused bounds; unused radius; unused segments; unused width; unused color
}
#program_export
RasterImage :: (path: string, id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {
    unused id; unused source; unused destination; unused clip
    unused origin; unused rotation; unused radius; unused tint
    if path != "asset.png" { bad = true }
    images += 1
}

#program_export
main :: () -> s32 {
    session := SessionOpen()
    for frame: 0..1 {
        BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        QueueLabels(session)
        if PendingPaintCount(session) != 5000 || PaintOverflow(session) { return 1 }
        if PendingPaintAt(session, 0).value != "12345678" ||
            PendingPaintAt(session, 4999).value != "12345678" { return 2 }
        if PendingPaintAt(session, -1).value.count != 0 ||
            PendingPaintAt(session, 5000).value.count != 0 { return 11 }
        result := EndFrameRetained(session, true)
        if cast(s32)result.status != 0 || result.paint_unchanged != (frame == 1) ||
            result.paint_count != 5000 { return 3 }
    }
    if draws != 5000 || bad { return 4 }
    // A changed byte beyond the former total limit invalidates the plan;
    // the following identical frame retains that new byte too.
    changed_last = true
    for frame: 0..1 {
        BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        QueueLabels(session)
        result := EndFrameRetained(session, true)
        if cast(s32)result.status != 0 || result.paint_unchanged != (frame == 1) { return 13 }
    }
    if draws != 10000 || bad { return 14 }
    for frame: 0..1 {
        BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        QueueAsset(session)
        if PendingPaintAt(session, 0).asset_path != "asset.png" { return 9 }
        result := EndFrameRetained(session, true)
        if cast(s32)result.status != 0 || result.paint_unchanged != (frame == 1) { return 10 }
    }
    if images != 1 || bad { return 11 }
    // Image paths own a separate byte pool and may exceed the same old
    // total limit while each caller's temporary path remains short.
    for frame: 0..1 {
        BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        for index: 0..4999 { QueueAsset(session) }
        result := EndFrameRetained(session, true)
        if cast(s32)result.status != 0 || result.paint_unchanged != (frame == 1) { return 15 }
    }
    if images != 5001 || bad { return 16 }
    if !CheckMixedOwnership(session) { return 18 }
    if !CheckAppendOwnership(session) { return 19 }
    // Overflow never emits partially borrowed or stale text, including a
    // caller that flushes directly instead of committing through EndFrame.
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    oversized: [32769]u8
    PaintLabel(session, -1, TextView(oversized[:]), 0, 0, 14, Color.{})
    if !PaintOverflow(session) { return 6 }
    PaintFlush(session)
    if draws != 10000 || bad || PendingPaintCount(session) != 0 { return 7 }
    TreeCancel(session)
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    PaintLabel(session, -1, TextView(oversized[:]), 0, 0, 14, Color.{})
    if cast(s32)EndFrame(session) != 8 || draws != 10000 { return 8 }
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    bounds := Rectangle.{0.0, 0.0, 100.0, 100.0}
    PaintImage(session, -1, TextView(oversized[:]), cast(u32)0,
        bounds, bounds, bounds, Vector2.{}, 0.0, 0.0, Color.{})
    if cast(s32)EndFrame(session) != 8 || images != 5001 { return 12 }
    PaintDispose(session)
    if paint_snapshot_values[session.slot].count != 0 ||
        paint_snapshot_assets[session.slot].count != 0 { return 17 }
    if !SessionClose(session) { return 5 }
    return 0
}
