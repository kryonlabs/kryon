using UI :: #import "kryon/Widgets";
Core :: #import "scenes";
Plot :: #import "plot/PlotWidget";
Charts :: #import "plot/Plot";
Trees :: #import "data_views/TreeView";
Board :: #import "data_views/Kanban";

GallerySceneCount :: 63;

GallerySceneName :: (index: s32) -> string {
    if index < Core.CoreSceneCount { return Core.SceneName(index) }
    if index == 54 { return "Plot · lines" }
    if index == 55 { return "Plot · bars" }
    if index == 56 { return "LineChart" }
    if index == 57 { return "LineChartCompare" }
    if index == 58 { return "CandleChart" }
    if index == 59 { return "BandChart" }
    if index == 60 { return "TreeView" }
    if index == 61 { return "Kanban" }
    if index == 62 { return "TableView · API status" }
    return ""
}

tree_selection: s32 = 1;
tree_scroll: s32;
tree_items: [5]Trees.TreeItem;
tree_ready: bool;
board_cell: Board.KanbanCell;
card_lanes: [3]s32 = .{0, 1, 2};

ComposePackage :: (session: Session, scene: s32, disabled: bool) {
    bounds: Rectangle = .{24.0, 64.0, 432.0, 208.0}
    values: [8]float32 = .{3.0, 5.0, 4.0, 8.0, 6.0, 9.0, 8.0, 11.0}
    previous: [8]float32 = .{2.0, 3.0, 4.0, 5.0, 4.0, 7.0, 6.0, 8.0}
    if scene < 2 {
        unused Plot.Plot(session, Plot.PlotProps.{.key = 600, .bounds = bounds, .semantic_label = "Eight example values", .scale_min = 0.0, .scale_max = 12.0, .mode = cast(Plot.PlotMode)scene}, values[:])
    } else if scene == 2 || scene == 3 {
        props: Charts.LineChartProps = .{.key = 600, .bounds = bounds, .semantic_label = "Example line chart", .line_color = .{23, 107, 131, 255}, .grid_color = .{180, 200, 210, 150}, .compare_color = .{180, 125, 70, 255}}
        if scene == 2 { Charts.LineChart(session, props, values[:], Charts.ChartRangeFor(values[:])) }
        else { Charts.LineChartCompare(session, props, values[:], previous[:], Charts.ChartRangeForBoth(values[:], previous[:])) }
    } else if scene == 4 {
        bars: [8]Charts.PriceBar
        for index: cast(s32)0..7 {
            bars[index] = Charts.PriceBar.{.open = previous[index], .close = values[index], .high = values[index] + 1.0, .low = previous[index] - 1.0, .volume = cast(float32)(index + 1) * 20.0}
        }
        Charts.CandleChart(session, Charts.CandleChartProps.{.key = 600, .bounds = bounds, .visible_count = 8, .semantic_label = "Example candles and volume", .up_color = .{35, 115, 92, 255}, .down_color = .{185, 65, 67, 255}, .grid_color = .{180, 200, 210, 150}}, bars[:], Charts.CandleRangeFor(bars[:], 8))
    } else if scene == 5 {
        points: [8]Charts.BandChartPoint
        for index: cast(s32)0..7 { points[index] = Charts.BandChartPoint.{.slot = index, .value = values[index], .good = ifx values[index] >= 4.0 && values[index] <= 9.0 then 1 else 0, .label = "Hover or tap a point"} }
        bands: [1]Charts.BandChartBand
        bands[0] = .{.low = 4.0, .high = 9.0, .has_low = true, .has_high = true}
        unused Charts.BandChart(session, Charts.BandChartProps.{.key = 600, .bounds = bounds, .semantic_label = "Values and a target band", .slots = 8, .min_value = 0.0, .max_value = 12.0, .top_label = "12", .bottom_label = "0", .font = 14, .good_color = .{35, 115, 92, 255}, .other_color = .{180, 125, 70, 255}, .band_color = .{131, 181, 160, 80}, .grid_color = .{180, 200, 210, 150}, .text_color = StyleTokenColor("text"), .label_fill = StyleTokenColor("surface")}, points[:], bands[:])
    } else if scene == 6 {
        if !tree_ready {
            tree_items[0] = .{.label = "Project", .id = 1, .expanded = true, .selectable = true}
            tree_items[1] = .{.label = "Source", .id = 2, .depth = 1, .expanded = true, .selectable = true}
            tree_items[2] = .{.label = "app.zi", .id = 3, .depth = 2, .selectable = true}
            tree_items[3] = .{.label = "Assets", .id = 4, .depth = 1, .selectable = true}
            tree_items[4] = .{.label = "README", .id = 5, .depth = 1, .selectable = true}
            tree_ready = true
        }
        result := Trees.TreeView(session, Trees.TreeViewProps.{.key = 600, .bounds = bounds, .selected_id = tree_selection, .scroll_offset = tree_scroll, .row_height = 36, .disabled = disabled}, tree_items[:])
        tree_selection = result.selected_id; tree_scroll = result.scroll_offset
    } else if scene == 7 {
        config := Board.KanbanDefaults(600, 3)
        config.min_width = 130.0; config.gap = 10.0
        config.background = StyleTokenColor("surface")
        config.card_background = StyleTokenColor("button")
        frame := Board.BeginKanban(session, *board_cell, config, bounds, Board.KanbanInput.{.disabled = disabled})
        titles: [3]string = .{"To do", "Doing", "Done"}
        labels: [3]string = .{"Explore", "Try widgets", "Build"}
        for lane: cast(s32)0..2 {
            count: s32
            for index: cast(s32)0..2 { if card_lanes[index] == lane { count += 1 } }
            column := Board.KanbanColumn(session, *board_cell, frame, lane, titles[lane], count, count * 64)
            if column.visible {
                for index: cast(s32)0..2 {
                    if card_lanes[index] == lane {
                        card := Board.KanbanCard(session, *board_cell, frame, *column, index, cast(u64)(700 + index), 64.0)
                        Text(session, TextProps.{.bounds = .{card.x + 8.0, card.y + 8.0, card.width - 16.0, card.height - 16.0}, .text = labels[index], .font = 14})
                    }
                }
            }
            Board.EndKanbanColumn(session, column)
        }
        Board.EndKanban(session, frame)
        pointer := PointerSample(session)
        if !disabled {
            gesture := Board.PointerKanban(*board_cell, bounds, 3, .{pointer.x, pointer.y}, pointer.down, pointer.pressed, pointer.released)
            if gesture.moved && gesture.lane >= 0 && gesture.identity >= 700 && gesture.identity < 703 { card_lanes[cast(s32)gesture.identity - 700] = gesture.lane }
        }
    } else {
        Text(session, TextProps.{.bounds = bounds, .text = "TableView currently exports layout and selection APIs. This package revision has no maintained table renderer.\n\nThis entry records that gap; it does not substitute a mock table.", .font = 17})
    }
}
