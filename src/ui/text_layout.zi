#import "font_metrics"
#import "text_align"
#import "text_props"
#import "utf8"

using TextAlign;
using TextWrap;

TextLinePlan :: struct {
    start: s32
    end: s32
    next: s32
    width: s32
}

TextToken :: struct {
    start: s32
    end: s32
    next: s32
    valid: bool
    line_break: bool
    icon: bool
}

TextIsSpace :: (value: u8) -> bool {
    return value == cast(u8)32 || value == cast(u8)9 ||
    value == cast(u8)11 || value == cast(u8)12
}

// Japanese and Chinese are written without spaces, so a line may break
// between their characters. Kana, ideographs, and the fullwidth forms count;
// Hangul is spaced and breaks at its spaces.
TextIdeographic :: (point: u32) -> bool {
    code: s32 = cast(s32)point
    return (code >= 12288 && code <= 12543) ||
        (code >= 13312 && code <= 19903) ||
        (code >= 19968 && code <= 40959) ||
        (code >= 63744 && code <= 64255) ||
        (code >= 65280 && code <= 65519) ||
        (code >= 131072 && code <= 262143)
}

// Closing punctuation, the prolonged sound mark, and small kana never start
// a line.
TextNoBreakBefore :: (point: u32) -> bool {
    code: s32 = cast(s32)point
    if code == 33 || code == 37 || code == 41 || code == 44 || code == 46 ||
        code == 58 || code == 59 || code == 63 || code == 93 || code == 125 {
        return true
    }
    if code == 12289 || code == 12290 || code == 12293 || code == 12297 ||
        code == 12299 || code == 12301 || code == 12303 || code == 12305 ||
        code == 12309 || code == 12539 || code == 12540 || code == 12443 ||
        code == 12444 { return true }
    if code == 65281 || code == 65289 || code == 65292 || code == 65294 ||
        code == 65306 || code == 65307 || code == 65311 || code == 65341 ||
        code == 65373 { return true }
    if code == 12353 || code == 12355 || code == 12357 || code == 12359 ||
        code == 12361 || code == 12387 || code == 12419 || code == 12421 ||
        code == 12423 || code == 12430 || code == 12449 || code == 12451 ||
        code == 12453 || code == 12455 || code == 12457 || code == 12483 ||
        code == 12515 || code == 12517 || code == 12519 || code == 12526 ||
        code == 12533 || code == 12534 { return true }
    return false
}

// Opening brackets never end a line.
TextNoBreakAfter :: (point: u32) -> bool {
    code: s32 = cast(s32)point
    return code == 40 || code == 91 || code == 123 || code == 12296 ||
        code == 12298 || code == 12300 || code == 12302 || code == 12304 ||
        code == 12308 || code == 65288 || code == 65339 || code == 65371
}

// Whether a line may break between two adjacent characters of one word.
TextBreaksBetween :: (before: u32, after: u32) -> bool {
    if !TextIdeographic(before) && !TextIdeographic(after) { return false }
    return !TextNoBreakBefore(after) && !TextNoBreakAfter(before)
}

// Whitespace and line breaks delimit borrowed UTF-8 byte ranges, and so do
// the places between characters where spaceless text may wrap. Optional
// inline icon markers are used by richer text layouts.
#program_export
TextTokenNext :: (value: string, offset: s32, icons: bool) -> TextToken {
    token: TextToken
    if offset < 0 { offset = 0 }
    while offset < cast(s32)value.count && TextIsSpace(value[offset]) {
        offset += 1
    }
    token.start = offset
    token.end = offset
    token.next = offset
    if offset >= cast(s32)value.count { return token }
    token.valid = true
    current: u8 = value[offset]
    if current == cast(u8)10 || current == cast(u8)13 {
        token.line_break = true
        offset += 1
        if current == cast(u8)13 && offset < cast(s32)value.count &&
            value[offset] == cast(u8)10 { offset += 1 }
    } else if icons && current == cast(u8)37 &&
        offset + 1 < cast(s32)value.count && value[offset + 1] == cast(u8)105 {
        token.icon = true
        offset += 2
    } else {
        previous: u32 = cast(u32)0
        have_previous: bool = false
        while offset < cast(s32)value.count {
            current = value[offset]
            if TextIsSpace(current) || current == cast(u8)10 ||
                current == cast(u8)13 { break }
            if icons && current == cast(u8)37 &&
                offset + 1 < cast(s32)value.count &&
                value[offset + 1] == cast(u8)105 { break }
            point: Decoded = Decode(value, offset)
            if have_previous && TextBreaksBetween(previous, point.value) {
                break
            }
            previous = point.value
            have_previous = true
            offset = point.after
        }
    }
    token.end = offset
    token.next = offset
    return token
}

// A word wider than the available width stays intact on its own line; text
// written without spaces wraps between characters as TextTokenNext allows.
#program_export
NextTextLine :: (value: string, start: s32, max_width: float32,
    wrap: TextWrap, font: s32, typeface: string) -> TextLinePlan {
    line: TextLinePlan
    line.start = start
    line.end = start
    line.next = cast(s32)value.count + 1
    if start >= cast(s32)value.count { return line }
    offset: s32 = start
    while offset < cast(s32)value.count {
        token: TextToken = TextTokenNext(value, offset, false)
        if !token.valid { break }
        if token.line_break {
            line.next = token.next
            return line
        }
        candidate: string = value[line.start:token.end]
        width: s32 = GlyphWidth(candidate, font, typeface)
        if wrap == cast(TextWrap)TextWrapAuto && max_width > 0.0 &&
            line.end > line.start && cast(float32)width > max_width {
            line.next = token.start
            return line
        }
        line.end = token.end
        line.width = width
        offset = token.next
    }
    return line
}

#program_export
TextDefaultLineGap :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(4.0 * scale)
}

#program_export
TextLayoutTotalHeight :: (line_count: s32, drawn_line_height: s32,
    line_gap: s32) -> s32 {
    if line_count <= 0 { return 0 }
    height: s32 = line_count * drawn_line_height
    if line_count > 1 { height += (line_count - 1) * line_gap }
    if height < 0 { return 0 }
    return height
}

#program_export
TextLineXFor :: (x: s32, width: s32, line_width: s32, align: s32) -> s32 {
    spare: s32 = width - line_width
    if align == TextAlignCenter { return x + spare / 2 }
    if align == TextAlignEnd { return x + spare }
    return x
}
