#module "progress"
#import "control_props"
#import "geometry"
#import "style"
#import "surface"

ProgressLayout :: struct {
    ratio: float
    fill_bounds: Rectangle
    label_x: float
    label_y: float
    label_on_fill: bool
}

ProgressPaint :: struct {
    layout: ProgressLayout
    track: StyleFrame
    fill: StyleFrame
    label: StyleFrame
    track_color: u32
    fill_color: u32
    border_color: u32
    label_color: u32
    filled_label_color: u32
    radius: float
    border_width: float
}

ProgressDrawPlan :: struct {
    radius: float
    draw_fill: bool
    draw_border: bool
    draw_label: bool
    label_color: u32
}

ProgressTrackRole :: () -> i32 #export {
    return 4
}

ProgressFillRole :: () -> i32 #export {
    return 5
}

ProgressLabelRole :: () -> i32 #export {
    return 6
}

ProgressMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> float {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return value * scale
}

ProgressRatio :: (min: i32, max: i32, value: i32) -> float #export {
    if max <= min {
        max = min + 1
    }
    ratio: float = (float)(value - min) / (float)(max - min)
    if ratio < 0.0 {
        return 0.0
    }
    if ratio > 1.0 {
        return 1.0
    }
    return ratio
}

ProgressFillBounds :: (bounds: Rectangle, ratio: float) -> Rectangle #export {
    fill: Rectangle = bounds
    if ratio < 0.0 {
        ratio = 0.0
    }
    if ratio > 1.0 {
        ratio = 1.0
    }
    fill.width = bounds.width * ratio
    return fill
}

ProgressDrawRadius :: (bounds: Rectangle, radius: float) -> float #export {
    if bounds.height <= 0.0 {
        return 0.0
    }
    radius = radius / bounds.height
    if radius < 0.0 {
        return 0.0
    }
    if radius > 1.0 {
        return 1.0
    }
    return radius
}

ProgressLabelX :: (bounds: Rectangle, fill_width: float,
    label_width: float, padding: float) -> float #export {
    x: float = bounds.x + (bounds.width - label_width) * 0.5
    fill_end: float = bounds.x + fill_width
    empty_width: float = bounds.width - fill_width
    if empty_width >= label_width + padding * 2.0 {
        return fill_end + padding
    }
    if fill_width >= label_width + padding * 2.0 {
        return fill_end - label_width - padding
    }
    return x
}

ProgressLabelY :: (bounds: Rectangle, label_line_height: float) -> float #export {
    return bounds.y + (bounds.height - label_line_height) * 0.5
}

ProgressLabelOnFill :: (fill_width: float, label_width: float,
    padding: float) -> bool #export {
    return fill_width >= label_width + padding * 2.0
}

ProgressLayoutFor :: (bounds: Rectangle, min: i32, max: i32, value: i32,
    label_width: float, label_line_height: float, padding: float) -> ProgressLayout #export {
    layout: ProgressLayout
    layout.ratio = ProgressRatio(min, max, value)
    layout.fill_bounds = ProgressFillBounds(bounds, layout.ratio)
    layout.label_x = ProgressLabelX(bounds, layout.fill_bounds.width,
        label_width, padding)
    layout.label_y = ProgressLabelY(bounds, label_line_height)
    layout.label_on_fill = ProgressLabelOnFill(layout.fill_bounds.width,
        label_width, padding)
    return layout
}

ProgressLabelPaddingForStyle :: (label: StyleFrame, scale: float) -> float #export {
    if scale <= 0.0 { scale = 1.0 }
    return ProgressMetric(label.value.fields, (u32)StylePaddingX,
        label.value.padding_x, 6.0, scale)
}

ProgressPaintFor :: (bounds: Rectangle, min: i32, max: i32, value: i32,
    label_width: float, label_line_height: float, scale: float,
    track: StyleFrame, fill: StyleFrame, label: StyleFrame) -> ProgressPaint #export {
    paint: ProgressPaint
    if scale <= 0.0 { scale = 1.0 }
    padding: float = ProgressLabelPaddingForStyle(label, scale)
    paint.layout = ProgressLayoutFor(bounds, min, max, value, label_width,
        label_line_height, padding)
    paint.track = track
    paint.fill = fill
    paint.label = label
    paint.track_color = track.value.background
    paint.fill_color = fill.value.background
    paint.border_color = track.value.border
    paint.label_color = label.value.foreground
    paint.filled_label_color = fill.value.foreground
    paint.radius = track.value.radius * scale
    paint.border_width = track.value.border_width * scale
    if paint.border_width < 0.0 { paint.border_width = 0.0 }
    return paint
}

ProgressDrawPlanFor :: (bounds: Rectangle, paint: ProgressPaint,
    has_label: bool, label_opacity: float) -> ProgressDrawPlan #export {
    plan: ProgressDrawPlan
    plan.radius = ProgressDrawRadius(bounds, paint.radius)
    plan.draw_fill = paint.layout.fill_bounds.width > 0.0
    plan.draw_border = paint.border_width > 0.0
    plan.draw_label = has_label
    color: u32 = paint.label_color
    if paint.layout.label_on_fill {
        color = paint.filled_label_color
    }
    plan.label_color = Opacity(color, label_opacity)
    return plan
}
