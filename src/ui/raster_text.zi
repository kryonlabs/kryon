#import "drawing_props"
#import "geometry"
#import "text_emphasis"
host_api :: #system_library "host_api";

// Text bytes are borrowed for the call; the platform owns glyph rasterization.
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) #foreign host_api;
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) #foreign host_api;

#program_export
PaintText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    RasterText(value, x, y, font, color)
}

#program_export
PaintTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    RasterTextClipped(value, x, y, font, color, clip)
}

// Paints the extra stroke of emphasized text over its painted label. Hosts
// may ship only a regular face; the stroke keeps glyph advances unchanged.
#program_export
PaintTextEmphasisClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    if RunTextEmphasisRaster(value, x, y, font, color, clip) { return }
    stroke := font / 24
    if stroke < 1 {
        stroke = 1
    }
    RasterTextClipped(value, x + stroke, y, font, color, clip)
}
