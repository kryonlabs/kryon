#import "geometry"

// Paint callback values are shared by retained and hosted compositions.
NodeGeometry :: struct {
    bounds: Rectangle
    measured_bounds: Rectangle
    clip: Rectangle
    clipped: bool
}

// Portable compositions can submit the same public widget contract to a
// retained UI host. The host binds this effect to the ordinary implementation;
// widget behavior, styles and input ownership have one implementation.
#if #defined(KRYON_HOSTED_UI) {
    #import "session"
    host_api :: #system_library "host_api";
    EndHostedHost :: (session: Session) -> bool #foreign host_api;
    TreePushScopeHostedHost :: (session: Session, index: s32) -> bool #foreign host_api;
    TreeSubmittedBoundsHostedHost :: (session: Session, index: s32) -> Rectangle #foreign host_api;
    #program_export
    TreeSubmittedBounds :: (session: Session, index: s32) -> Rectangle {
        return TreeSubmittedBoundsHostedHost(session, index)
    }
    #program_export
    End :: (session: Session) -> bool { return EndHostedHost(session) }
    // The host gives hosted widgets their identity; composed widgets that
    // also build in hosted programs record nothing.
    TreeCallSite :: (session: Session, location: Source_Code_Location) -> bool {
        unused session; unused location; return false
    }
    TreeCallSiteEnd :: (session: Session, owned: bool) { unused session; unused owned }
    TreePlaceAhead :: (session: Session, bounds: Rectangle) -> Rectangle { unused session; return bounds }
    #program_export
    TreePushScope :: (session: Session, index: s32) -> bool {
        return TreePushScopeHostedHost(session, index)
    }
} else {
    Components :: #import "component_frame_slot";
    ComponentTypes :: #import "component_types";
    #import "call_site"
    #import "semantic"
    #import "session"
    #import "widget_kind"
    #import "cursor"
    #import "widget_key"
    #import "vec"
    #import "layout_motion_slot"

    // A retained node keeps its identity only when its key, kind, and parent key
    // match the previous committed tree.
    #program_export
    TreeIdentityHash :: (parent: u64, key: u64, kind: s32) -> u64 {
        hash: u64 = key ^ (parent * cast(u64)16777619)
        hash = hash ^ (cast(u64)cast(u32)kind * cast(u64)2166136261)
        hash = (hash ^ (hash >> cast(u64)16)) * cast(u64)2246822519
        return hash ^ (hash >> cast(u64)16)
    }

    #program_export
    TreeButtonLike :: (kind: s32) -> bool {
        return kind == WidgetKindButton || kind == WidgetKindCard
    }

    #program_export
    TreeInteractiveButtonLike :: (kind: s32, focus_id: s32,
        disabled: bool, loading: bool) -> bool {
        if !TreeButtonLike(kind) { return false }
        if kind == WidgetKindCard && focus_id <= 0 { return false }
        return !disabled && !loading
    }

    // Checked value controls use the same retained press and release routing as
    // Buttons. Cards remain opt in through a positive focus id.
    #program_export
    TreePointerActivatable :: (kind: s32, focus_id: s32,
        disabled: bool, loading: bool) -> bool {
        if disabled || loading { return false }
        if kind == WidgetKindCard { return focus_id > 0 }
        if kind == WidgetKindText { return focus_id > 0 }
        return kind == WidgetKindButton || kind == WidgetKindCheckbox ||
        kind == WidgetKindToggle || kind == WidgetKindRadio ||
        kind == WidgetKindSlider || kind == WidgetKindSelectable ||
        kind == WidgetKindLink || kind == WidgetKindCollapsible ||
        kind == WidgetKindDropdown || kind == WidgetKindTextField ||
        kind == WidgetKindTextArea
    }

    TreeCommitPlan :: struct {
        keep_committed: bool
        reconcile: bool
        route_input: bool
    }

    FrameStatus :: enum {
        FrameOk :: 0
        FrameInvalidSession :: 1
        FrameNotBuilding :: 2
        FrameInvalidParent :: 3
        FrameInvalidScope :: 4
        FrameDuplicateKey :: 5
        FrameAllocationFailed :: 6
        FrameIdentityOverflow :: 7
        FramePaintOverflow :: 8
        FrameComponentFailure :: 9
    }
    FrameFailure :: struct { status: s32; key: u64; kind: s32; message: string; }

    #program_export
    FrameStatusMessage :: (status: s32) -> string {
        if status == 0 { return "Frame accepted" }
        if status == 1 { return "Invalid UI session" }
        if status == 2 { return "No frame is being built" }
        if status == 3 { return "Invalid widget parent" }
        if status == 4 { return "Unbalanced widget scope" }
        if status == 5 { return "Duplicate widget key" }
        if status == 6 { return "Frame storage allocation failed" }
        if status == 7 { return "Widget identity overflow" }
        if status == 8 { return "Paint queue overflow" }
        if status == 9 { return "Component lifetime submission failed" }
        return "Unknown frame failure"
    }

    #program_export
    FrameFailureAt :: (session: Session) -> FrameFailure {
        result: FrameFailure
        result.status = cast(s32)TreeFrameStatus(session)
        result.message = FrameStatusMessage(result.status)
        if SessionValid(session) {
            result.key = trees[session.slot].error_key
            result.kind = trees[session.slot].error_kind
        }
        return result
    }

    using SemanticKind;
    using WidgetKind;
    using FrameStatus;


    // During activation, a partial submission must preserve the committed tree
    // and defer input until the replacement tree is complete.
    #program_export
    TreeCommitFor :: (activation: bool, committed_count: s32,
        submitted_count: s32) -> TreeCommitPlan {
        plan: TreeCommitPlan
        plan.keep_committed = activation && committed_count > 0 &&
        submitted_count >= 0 && submitted_count < committed_count
        plan.reconcile = !plan.keep_committed
        plan.route_input = !plan.keep_committed
        return plan
    }

    TreePlacement :: #type (session: Session, parent_index: s32,
        bounds: Rectangle) -> Rectangle;

    TreeChildWidth :: #type (session: Session, parent_index: s32) -> float32;
    tree_no_child_width: TreeChildWidth;

    // A content-sized container settles its height when its scope closes.
    TreeClose :: #type (session: Session, index: s32) -> void;

    // What a content-sized container keeps for its close: its min and max
    // height (a negative max is none), the block margins of its slot, and
    // where its own box goes in the paint queue (-1 when it paints none).
    TreeContentSize :: struct {
        min: float32
        max: float32
        margin_top: float32
        margin_bottom: float32
        paint_mark: s64
    }

    TreeEntry :: struct {
        style_class: s32
        key: u64
        parent_key: u64
        auto_key: bool
        auto_ordinal: s32
        next_auto_ordinal: s32
        kind: s32
        bounds: Rectangle
        clip: Rectangle
        child_clip: Rectangle
        clipped: bool
        clips_children: bool
        measured_bounds: Rectangle
        auto_placed: bool
        places_children: bool
        placement: TreePlacement
        layout_gap: s32
        layout_padding: s32
        grid_columns: s32
        grid_min_item_width: s32
        grid_max_columns: s32
        semantic_label: string
        semantic_detail: string
        semantic_kind: SemanticKind
        style_id: s32
        text_bytes: s32
        text_cursor: s32
        text_anchor: s32
        has_text: bool
        read_only: bool
        secure: bool
        heading_level: s32
        // Wrapped lines of the node's text that its box leaves out.
        hidden_lines: s32
        parent: s32
        first_child: s32
        last_child: s32
        next_sibling: s32
        sibling_ordinal: s32
        identity_generation: u64
        interactive: bool
        disabled: bool
        loading: bool
        selected: bool
        focus_id: s32
    }

    NodeCore :: struct {
        owner_namespace: u64
        key: u64
        identity_generation: u64
        bounds: Rectangle
        measured_bounds: Rectangle
        clip: Rectangle
        child_clip: Rectangle
        kind: s32
        parent: s32
        first_child: s32
        last_child: s32
        next_sibling: s32
        sibling_ordinal: s32
        auto_ordinal: s32
        next_auto_ordinal: s32
        semantic_index: s32
        interaction_index: s32
        state_index: s32
        layout_index: s32
        auto_key: bool
        clipped: bool
        clips_children: bool
        auto_placed: bool
        // Drawn and hit above the page like a modal, without blocking input
        // to the rest of it; see TreeSetPopup.
        popup: bool
        // A widget other than a scroll that scrolls its own content, such as
        // a text area, has more content than shows; see TreeSetWheelScrolls.
        wheel_scrolls: bool
        // Such a widget's content also follows a drag, as a finger drags it
        // on a touch screen; see TreeSetDragScrolls.
        drag_scrolls: bool
    }

    SemanticData :: struct {
        style_class: s32
        style_id: s32
        label_offset: s64
        label_length: s64
        detail_offset: s64
        detail_length: s64
        kind: SemanticKind
        heading_level: s32
        selected: bool
        text_offset: s64
        text_length: s64
        text_bytes: s32
        text_cursor: s32
        text_anchor: s32
        has_text: bool
        read_only: bool
        secure: bool
        hidden_lines: s32
    }

    InteractionData :: struct {
        disabled: bool
        loading: bool
        circle_hit: bool
        captures_drag: bool
        focus_id: s32
        // A CursorShape the widget chose over its kind's own; 0 for none.
        cursor: s32
        capture_tab: bool
    }

    // State a widget keeps on its own node from one frame to the next, such
    // as whether its menu is open, the highlighted row and the scroll offset.
    WidgetState :: struct {
        open: bool
        index: s32
        offset: s32
        focus_generation: u64
    }

    LayoutProgress :: struct {
        count: s32
        extent: float32
        // The tallest slot of the current row or flow line, and that line's
        // offset below the content top.
        cross: float32
        line: float32
        // The column span of the next child a grid places; 0 is one track.
        span: s32
        grid_y: s32
        grid_col: s32
        grid_row_height: s32
        grid_used_height: s32
        grid_initialized: bool
    }

    LayoutData :: struct {
        placement: TreePlacement
        child_width: TreeChildWidth
        gap: s32
        row_gap: s32
        padding: s32
        padding_y: s32
        columns: s32
        min_item_width: s32
        max_columns: s32
        progress: LayoutProgress
        places_children: bool
        close: TreeClose
        closes: bool
        content_size: TreeContentSize
    }

    NodeInput :: struct {
        key: u64
        identity_generation: u64
        kind: s32
        bounds: Rectangle
        clip: Rectangle
        clipped: bool
        interactive: bool
        disabled: bool
        loading: bool
        circle_hit: bool
        captures_drag: bool
        focus_id: s32
        cursor: s32
    }

    LayoutInfo :: struct {
        bounds: Rectangle
        child_width: TreeChildWidth
        gap: s32
        row_gap: s32
        padding: s32
        padding_y: s32
        columns: s32
        min_item_width: s32
        max_columns: s32
    }

    LabelSpan :: struct {
        offset: u32
        length: u32
        prefix: u32
    }

    TreeLabelCapacity :: 65536

    LabelBuffer :: struct {
        bytes: Vec(u8)
    }

    TreeLabelText :: (buffer: *LabelBuffer, offset: s64, length: s64) -> string {
        return TextView(buffer.bytes[offset:offset + length])
    }

    TreeStore :: struct {
        committed: Vec(NodeCore)
        submitted: Vec(NodeCore)
        committed_semantics: Vec(SemanticData)
        submitted_semantics: Vec(SemanticData)
        committed_text: Vec(u8)
        submitted_text: Vec(u8)
        // Input keeps reading the committed buffer while its replacement is
        // composed. Each buffer reserves its full capacity on first use so
        // neither appending a label nor committing moves borrowed label bytes.
        labels: [2]LabelBuffer
        committed_label_buffer: s32
        submitted_label_count: s64
        // Complete ownership directory for the submitted frame, ordered by
        // length, first four bytes, then remaining bytes. Every distinct label
        // has one span; small directories stay inline with heap overflow.
        // There are no evictions. Moving spans never moves the
        // packed bytes, so submitted and committed borrows remain stable.
        submitted_labels: [64]LabelSpan
        submitted_label_spans: s64
        submitted_label_overflow: Vec(LabelSpan)
        committed_interactions: Vec(InteractionData)
        submitted_interactions: Vec(InteractionData)
        committed_states: Vec(WidgetState)
        submitted_states: Vec(WidgetState)
        layouts: Vec(LayoutData)
        slots: Vec(s32)
        new_slots: Vec(s32)
        scope: [64]s32
        scope_depth: s32
        committed_count: s32
        submitted_count: s32
        committed_modal_layer: s32
        submitted_modal_layer: s32
        // Memo for TreeCommittedParent during one build, keyed by the
        // submitted parent's identity generation.
        committed_parent_generation: u64
        committed_parent_index: s32
        committed_parent_memo: bool
        next_identity_generation: u64
        staged_identity_generation: u64
        identity_index_valid: bool
        identity_order_unchanged: bool
        // The caller of the widget being drawn, for its unkeyed identity.
        sites: CallSites
        building: bool
        error: FrameStatus
        // The widget that made the frame fail, so hosts can report it.
        error_key: u64
        error_kind: s32
        // The first key submitted twice under one parent this frame; the
        // repeat was drawn under a derived key (see widget_key).
        repeated_key: u64
        repeated_kind: s32
    }

    trees: [9]TreeStore;

    TreeParentGeneration :: (session: Session, index: s32,
        committed: bool) -> u64 {
        if index < 0 { return cast(u64)0 }
        slot: s32 = SessionIndex(session)
        if committed {
            parent: s32 = trees[slot].committed[index].parent
            if parent < 0 { return cast(u64)0 }
            return trees[slot].committed[parent].identity_generation
        }
        parent: s32 = trees[slot].submitted[index].parent
        if parent < 0 { return cast(u64)0 }
        return trees[slot].submitted[parent].identity_generation
    }

    // A short tree is cheaper to search directly than to clear and hash an
    // index. The larger-tree index keeps its existing load factor and keys.
    TreeLinearIndexLimit :: 8

    TreeBuildOldIndex :: (session: Session) -> bool {
        slot: s32 = SessionIndex(session)
        if trees[slot].identity_index_valid { return true }
        VecClear(trees[slot].slots)
        if trees[slot].committed_count <= TreeLinearIndexLimit {
            trees[slot].identity_index_valid = true
            return true
        }
        capacity: s32 = 8
        while cast(s64)capacity <= cast(s64)trees[slot].committed_count * 2 {
            if capacity > 1073741824 { return false }
            capacity *= 2
        }
        index: s32 = 0
        while index < capacity {
            if !VecPush(trees[slot].slots, -1) { return false }
            index += 1
        }
        index = 0
        while index < trees[slot].committed_count {
            entry: NodeCore = trees[slot].committed[index]
            parent: u64 = TreeParentGeneration(session, index, true)
            hash: u64 = TreeIdentityHash(parent, entry.key, entry.kind)
            position: s32 = cast(s32)(hash & cast(u64)(capacity - 1))
            while trees[slot].slots[position] >= 0 {
                position = (position + 1) & (capacity - 1)
            }
            trees[slot].slots[position] = index
            index += 1
        }
        trees[slot].identity_index_valid = true
        return true
    }

    TreeBuildNewIndex :: (session: Session, needed: s32) -> bool {
        slot: s32 = SessionIndex(session)
        if needed <= TreeLinearIndexLimit { return true }
        if trees[slot].new_slots.count > cast(s64)needed * 2 {
            return true
        }
        capacity: s32 = 8
        while cast(s64)capacity <= cast(s64)needed * 2 {
            if capacity > 1073741824 { return false }
            capacity *= 2
        }
        VecClear(trees[slot].new_slots)
        index: s32 = 0
        while index < capacity {
            if !VecPush(trees[slot].new_slots, -1) { return false }
            index += 1
        }
        index = 0
        while index < trees[slot].submitted_count {
            entry: *NodeCore = *trees[slot].submitted[index]
            if !entry.auto_key {
                parent: u64 = TreeParentGeneration(session, index, false)
                hash: u64 = TreeIdentityHash(parent, entry.key, 0)
                position: s32 = cast(s32)(hash & cast(u64)(capacity - 1))
                while trees[slot].new_slots[position] >= 0 {
                    position = (position + 1) & (capacity - 1)
                }
                trees[slot].new_slots[position] = index
            }
            index += 1
        }
        return true
    }

    // A widget records its caller before it submits its first node, and
    // ends the record when it returns: the outermost widget's caller names
    // its first node, whatever the widget draws inside first.
    TreeCallSite :: (session: Session, location: Source_Code_Location) -> bool {
        if !SessionValid(session) { return false }
        return CallSitesRecord(*trees[SessionIndex(session)].sites, location)
    }

    TreeCallSiteEnd :: (session: Session, owned: bool) {
        if !owned { return }
        trees[SessionIndex(session)].sites.pending = 0
        trees[SessionIndex(session)].sites.placed_ahead = false
    }

    // A parent's next unkeyed child: its caller's ordinal, or the next
    // position for a node no widget call recorded (parts inside a widget).
    TreeAutoOrdinal :: (slot: s32, parent_index: s32, consume: bool) -> s32 {
        parent: *NodeCore = *trees[slot].submitted[parent_index]
        owner := Components.Current(.{slot, session_epochs[slot]})
        generation := parent.identity_generation
        if owner != cast(u64)0 { generation = CallSiteMix(generation, owner) }
        sited := CallSiteOrdinal(*trees[slot].sites, generation, consume)
        if sited != 0 { return sited }
        if owner != cast(u64)0 {
            ordinal: s32 = 1
            child := parent.first_child
            while child >= 0 {
                if trees[slot].submitted[child].owner_namespace == owner && trees[slot].submitted[child].auto_key { ordinal += 1 }
                child = trees[slot].submitted[child].next_sibling
            }
            return ordinal
        }
        return parent.next_auto_ordinal + 1
    }

    TreeFindOld :: (session: Session, parent: u64, key: u64,
        kind: s32, auto_key: bool, auto_ordinal: s32, owner: u64 = 0) -> s32 {
        slot: s32 = SessionIndex(session)
        if trees[slot].committed_count <= TreeLinearIndexLimit {
            for index: 0..trees[slot].committed_count - 1 {
                entry: *NodeCore = *trees[slot].committed[index]
                if entry.key == key && entry.kind == kind && entry.owner_namespace == owner &&
                entry.auto_key == auto_key &&
                (!auto_key || entry.auto_ordinal == auto_ordinal) &&
                TreeParentGeneration(session, index, true) == parent {
                    return index
                }
            }
            return -1
        }
        capacity: s32 = cast(s32)trees[slot].slots.count
        if capacity == 0 { return -1 }
        hash: u64 = TreeIdentityHash(parent, key, kind)
        position: s32 = cast(s32)(hash & cast(u64)(capacity - 1))
        while trees[slot].slots[position] >= 0 {
            index: s32 = trees[slot].slots[position]
            entry: *NodeCore = *trees[slot].committed[index]
            if entry.key == key && entry.kind == kind && entry.owner_namespace == owner &&
            entry.auto_key == auto_key &&
            (!auto_key || entry.auto_ordinal == auto_ordinal) &&
            TreeParentGeneration(session, index, true) == parent {
                return index
            }
            position = (position + 1) & (capacity - 1)
        }
        return -1
    }

    // Look up a child of a submitted parent in the previous committed frame.
    // Key zero names the next parent-local unkeyed position before submission.
    #program_export
    TreePrevious :: (session: Session, parent_index: s32,
        key: u64, kind: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || parent_index < 0 ||
        parent_index >= trees[slot].submitted_count { return -1 }
        parent: *NodeCore = *trees[slot].submitted[parent_index]
        auto_key: bool = key == cast(u64)0
        ordinal: s32 = 0
        if auto_key {
            ordinal = TreeAutoOrdinal(slot, parent_index, false)
            key = cast(u64)ordinal
        }
        return TreeFindOld(session, parent.identity_generation, key,
            kind, auto_key, ordinal, Components.Current(session))
    }

    // Look up an explicitly keyed child already submitted in this frame. A
    // composition can attach gestures to its ordinary widgets with this node.
    #program_export
    TreeSubmitted :: (session: Session, parent_index: s32,
        key: u64, kind: s32) -> s32 {
        if !SessionValid(session) {
            return -1
        }
        slot := SessionIndex(session)
        if !trees[slot].building || key == cast(u64)0 || parent_index < 0 ||
        parent_index >= trees[slot].submitted_count {
            return -1
        }
        index := trees[slot].submitted[parent_index].first_child
        while index >= 0 {
            node := trees[slot].submitted[index]
            if node.key == key && node.kind == kind && node.owner_namespace == Components.Current(session) && !node.auto_key {
                return index
            }
            index = node.next_sibling
        }
        return -1
    }

    // Use this when the current parent has not yet been submitted.
    #program_export
    TreePreviousCommitted :: (session: Session, parent_index: s32,
        key: u64, kind: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        if parent_index < 0 || parent_index >= trees[slot].committed_count ||
        key == cast(u64)0 { return -1 }
        return TreeFindOld(session,
            trees[slot].committed[parent_index].identity_generation,
            key, kind, false, 0, Components.Current(session))
    }

    TreeExplicitExists :: (session: Session, parent: u64, key: u64) -> bool {
        slot: s32 = SessionIndex(session)
        if trees[slot].submitted_count < TreeLinearIndexLimit {
            for index: 0..trees[slot].submitted_count - 1 {
                entry: *NodeCore = *trees[slot].submitted[index]
                if !entry.auto_key && entry.key == key && entry.owner_namespace == Components.Current(session) &&
                TreeParentGeneration(session, index, false) == parent { return true }
            }
            return false
        }
        capacity: s32 = cast(s32)trees[slot].new_slots.count
        hash: u64 = TreeIdentityHash(parent, key, 0)
        position: s32 = cast(s32)(hash & cast(u64)(capacity - 1))
        while trees[slot].new_slots[position] >= 0 {
            index: s32 = trees[slot].new_slots[position]
            if trees[slot].submitted[index].key == key &&
            trees[slot].submitted[index].owner_namespace == Components.Current(session) &&
            TreeParentGeneration(session, index, false) == parent {
                return true
            }
            position = (position + 1) & (capacity - 1)
        }
        return false
    }

    TreeRead :: (session: Session, index: s32,
        committed: bool) -> TreeEntry {
        entry: TreeEntry
        slot: s32 = SessionIndex(session)
        node: NodeCore
        if committed {
            if index < 0 || index >= trees[slot].committed_count { return entry }
            node = trees[slot].committed[index]
        } else {
            if !trees[slot].building || index < 0 ||
            index >= trees[slot].submitted_count { return entry }
            node = trees[slot].submitted[index]
        }
        entry.key = node.key
        if node.parent >= 0 {
            if committed {
                entry.parent_key = trees[slot].committed[node.parent].key
            } else {
                entry.parent_key = trees[slot].submitted[node.parent].key
            }
        }
        entry.auto_key = node.auto_key
        entry.auto_ordinal = node.auto_ordinal
        entry.next_auto_ordinal = node.next_auto_ordinal
        entry.kind = node.kind
        entry.bounds = node.bounds
        entry.clip = node.clip
        entry.child_clip = node.child_clip
        entry.clipped = node.clipped
        entry.clips_children = node.clips_children
        entry.measured_bounds = node.measured_bounds
        entry.auto_placed = node.auto_placed
        entry.parent = node.parent
        entry.first_child = node.first_child
        entry.last_child = node.last_child
        entry.next_sibling = node.next_sibling
        entry.sibling_ordinal = node.sibling_ordinal
        entry.identity_generation = node.identity_generation
        if node.semantic_index >= 0 {
            semantic: SemanticData
            if committed {
                semantic = trees[slot].committed_semantics[node.semantic_index]
            } else {
                semantic = trees[slot].submitted_semantics[node.semantic_index]
            }
            committed_buffer := trees[slot].committed_label_buffer
            labels := *trees[slot].labels[ifx committed then committed_buffer else 1 - committed_buffer]
            if semantic.label_length > 0 {
                entry.semantic_label = TreeLabelText(labels, semantic.label_offset, semantic.label_length)
            }
            if semantic.detail_length > 0 {
                entry.semantic_detail = TreeLabelText(labels, semantic.detail_offset, semantic.detail_length)
            }
            entry.style_class = semantic.style_class
            entry.style_id = semantic.style_id
            entry.text_bytes = semantic.text_bytes
            entry.text_cursor = semantic.text_cursor
            entry.text_anchor = semantic.text_anchor
            entry.has_text = semantic.has_text
            entry.read_only = semantic.read_only
            entry.secure = semantic.secure
            entry.semantic_kind = semantic.kind
            entry.heading_level = semantic.heading_level
            entry.selected = semantic.selected
            entry.hidden_lines = semantic.hidden_lines
        }
        if node.interaction_index >= 0 {
            interaction: InteractionData
            if committed {
                interaction = trees[slot].committed_interactions[node.interaction_index]
            } else {
                interaction = trees[slot].submitted_interactions[node.interaction_index]
            }
            entry.interactive = true
            entry.disabled = interaction.disabled
            entry.loading = interaction.loading
            entry.focus_id = interaction.focus_id
        }
        if !committed && node.layout_index >= 0 {
            layout: LayoutData = trees[slot].layouts[node.layout_index]
            entry.placement = layout.placement
            entry.places_children = layout.places_children
            entry.layout_gap = layout.gap
            entry.layout_padding = layout.padding
            entry.grid_columns = layout.columns
            entry.grid_min_item_width = layout.min_item_width
            entry.grid_max_columns = layout.max_columns
        }
        return entry
    }

    #program_export
    TreeSubmittedGeometryAt :: (session: Session,
        index: s32) -> NodeGeometry {
        geometry: NodeGeometry
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return geometry }
        node: *NodeCore = *trees[slot].submitted[index]
        geometry.bounds = node.bounds
        geometry.measured_bounds = node.measured_bounds
        geometry.clip = node.clip
        geometry.clipped = node.clipped
        return geometry
    }

    TreeSubmittedIdentity :: (session: Session, index: s32) -> u64 {
        slot := SessionIndex(session)
        if !trees[slot].building || index < 0 || index >= trees[slot].submitted_count { return 0 }
        return trees[slot].submitted[index].identity_generation
    }

    #program_export
    TreeSubmittedBounds :: (session: Session, index: s32) -> Rectangle {
        empty: Rectangle
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return empty }
        return trees[slot].submitted[index].bounds
    }

    // Where a widget paints its own node: the rect it was measured in, at the
    // size its parent placed it. The paint queue moves the node's paint from
    // there to the placed spot, so a widget whose width or height its parent
    // fills draws at that size.
    TreeNodePaintBounds :: (session: Session, index: s32, measured: Rectangle) -> Rectangle {
        placed := TreeSubmittedBounds(session, index)
        if placed.width <= 0.0 || placed.height <= 0.0 { return measured }
        return Rectangle.{measured.x, measured.y, placed.width, placed.height}
    }

    // Whether the parent will place a widget submitted with these bounds: a
    // placing container (column, row, stack, grid) places a child that sets
    // no origin and fills its unset size. A widget leaves its size unset for
    // such a parent and picks its own otherwise.
    TreeWillPlace :: (session: Session, bounds: Rectangle) -> bool {
        if !SessionValid(session) || bounds.x != 0.0 || bounds.y != 0.0 { return false }
        slot: s32 = SessionIndex(session)
        parent := TreeCurrentParent(session)
        if !trees[slot].building || parent < 0 || parent >= trees[slot].submitted_count { return false }
        layout := trees[slot].submitted[parent].layout_index
        return layout >= 0 && trees[slot].layouts[layout].places_children
    }

    // Places a widget before it draws: the rect its parent gives a node with
    // these bounds, now, so the widget lays out, paints and submits its node
    // there and nothing moves afterwards. Bounds the parent does not place
    // come back as they are.
    TreePlaceAhead :: (session: Session, bounds: Rectangle) -> Rectangle {
        if !TreeWillPlace(session, bounds) { return bounds }
        slot: s32 = SessionIndex(session)
        parent := TreeCurrentParent(session)
        // A column advances by its child's height and a row by its width: a
        // widget that sizes itself along that axis is placed when it submits.
        kind := trees[slot].submitted[parent].kind
        if kind == cast(s32)WidgetKindColumn && bounds.height <= 0.0 { return bounds }
        if kind == cast(s32)WidgetKindRow && bounds.width <= 0.0 { return bounds }
        layout: LayoutData = trees[slot].layouts[trees[slot].submitted[parent].layout_index]
        placement: TreePlacement = layout.placement
        trees[slot].sites.placed_ahead = true
        return placement(session, parent, bounds)
    }

    // A widget that lays itself out after its parent placed it adopts the
    // placement: it then gives its own paint in placed coordinates, and the
    // paint queue does not move that paint a second time.
    TreeAdoptPlacement :: (session: Session, index: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 || index >= trees[slot].submitted_count { return }
        trees[slot].submitted[index].measured_bounds = trees[slot].submitted[index].bounds
    }

    #program_export
    TreeInputAt :: (session: Session, index: s32) -> NodeInput {
        input: NodeInput
        slot: s32 = SessionIndex(session)
        if index < 0 || index >= trees[slot].committed_count { return input }
        node: *NodeCore = *trees[slot].committed[index]
        input.key = node.key
        input.identity_generation = node.identity_generation
        input.kind = node.kind
        input.bounds = node.bounds
        input.clip = node.clip
        input.clipped = node.clipped
        if node.interaction_index >= 0 {
            interaction: *InteractionData =
            *trees[slot].committed_interactions[node.interaction_index]
            input.interactive = true
            input.disabled = interaction.disabled
            input.loading = interaction.loading
            input.circle_hit = interaction.circle_hit
            input.captures_drag = interaction.captures_drag
            input.focus_id = interaction.focus_id
            input.cursor = interaction.cursor
        }
        return input
    }

    #program_export
    TreeLayoutAt :: (session: Session, index: s32) -> LayoutInfo {
        info: LayoutInfo
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return info }
        node: NodeCore = trees[slot].submitted[index]
        info.bounds = node.bounds
        if node.layout_index >= 0 {
            layout: LayoutData = trees[slot].layouts[node.layout_index]
            info.child_width = layout.child_width
            info.gap = layout.gap
            info.row_gap = layout.row_gap
            info.padding = layout.padding
            info.padding_y = layout.padding_y
            info.columns = layout.columns
            info.min_item_width = layout.min_item_width
            info.max_columns = layout.max_columns
        }
        return info
    }

    TreeEnsureSemantic :: (session: Session, index: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        existing: s32 = trees[slot].submitted[index].semantic_index
        if existing >= 0 { return existing }
        next: s32 = cast(s32)trees[slot].submitted_semantics.count
        data: SemanticData
        if !VecPush(trees[slot].submitted_semantics, data) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        trees[slot].submitted[index].semantic_index = next
        return next
    }

    TreeEnsureInteraction :: (session: Session, index: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        existing: s32 = trees[slot].submitted[index].interaction_index
        if existing >= 0 { return existing }
        next: s32 = cast(s32)trees[slot].submitted_interactions.count
        data: InteractionData
        if !VecPush(trees[slot].submitted_interactions, data) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        trees[slot].submitted[index].interaction_index = next
        return next
    }

    TreeEnsureLayout :: (session: Session, index: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        existing: s32 = trees[slot].submitted[index].layout_index
        if existing >= 0 { return existing }
        next: s32 = cast(s32)trees[slot].layouts.count
        data: LayoutData
        if !VecPush(trees[slot].layouts, data) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        trees[slot].submitted[index].layout_index = next
        return next
    }

    #program_export
    TreeLayoutProgressAt :: (session: Session, index: s32) -> LayoutProgress {
        empty: LayoutProgress
        slot: s32 = SessionIndex(session)
        if index < 0 || index >= trees[slot].submitted_count {
            return empty
        }
        layout: s32 = trees[slot].submitted[index].layout_index
        if layout < 0 { return empty }
        return trees[slot].layouts[layout].progress
    }

    #program_export
    TreeSetLayoutProgress :: (session: Session, index: s32,
        progress: LayoutProgress) {
        slot: s32 = SessionIndex(session)
        if index < 0 || index >= trees[slot].submitted_count { return }
        layout: s32 = trees[slot].submitted[index].layout_index
        if layout < 0 { return }
        trees[slot].layouts[layout].progress = progress
    }

    #program_export
    TreeStart :: (session: Session, screen_key: u64, bounds: Rectangle) {
        if !SessionValid(session) { return }
        slot: s32 = session.slot
        if !Components.FrameStart(session) { return }
        TreeClearDeferred(slot)
        CallSitesStart(*trees[slot].sites)
        VecClear(trees[slot].submitted)
        VecClear(trees[slot].submitted_semantics)
        VecClear(trees[slot].submitted_text)
        trees[slot].submitted_label_count = 0
        trees[slot].submitted_label_spans = 0
        VecClear(trees[slot].submitted_label_overflow)
        VecClear(trees[slot].submitted_interactions)
        VecClear(trees[slot].submitted_states)
        VecClear(trees[slot].layouts)
        trees[slot].submitted_count = 0
        trees[slot].submitted_modal_layer = 0
        trees[slot].scope_depth = 0
        trees[slot].committed_parent_generation = 0
        trees[slot].committed_parent_index = -1
        trees[slot].committed_parent_memo = false
        trees[slot].building = true
        CursorHoverFrameStart(session)
        trees[slot].error = cast(FrameStatus)FrameOk
        trees[slot].error_key = cast(u64)0
        trees[slot].error_kind = 0
        trees[slot].repeated_key = cast(u64)0
        trees[slot].repeated_kind = 0
        trees[slot].staged_identity_generation =
        trees[slot].next_identity_generation
        trees[slot].identity_order_unchanged = true
        VecClear(trees[slot].new_slots)
        if !TreeBuildOldIndex(session) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return
        }
        key: u64 = screen_key
        if key == 0 { key = 1 }
        if TreeSubmit(session, key, -1, WidgetKindScreen, bounds) == 0 {
            trees[slot].scope[0] = 0
            trees[slot].scope_depth = 1
        }
    }

    // The root is the default scope. A container submits itself, pushes its node,
    // composes children, then pops it. Explicit TreeSubmit still accepts a parent
    // index for controls such as Spinbox that create their own child nodes.
    #program_export
    TreeCurrentParent :: (session: Session) -> s32 {
        if TreeFrameBlocked(session) { return -1 }
        slot := SessionIndex(session)
        if !trees[slot].building || trees[slot].scope_depth <= 0 {
            return -1
        }
        return trees[slot].scope[trees[slot].scope_depth - 1]
    }

    #program_export
    TreeCurrentPaintGeometry :: (session: Session) -> NodeGeometry {
        geometry: NodeGeometry
        parent: s32 = TreeCurrentParent(session)
        if parent < 0 { return geometry }
        node: NodeCore = trees[SessionIndex(session)].submitted[parent]
        geometry.bounds = node.bounds
        geometry.measured_bounds = node.measured_bounds
        if node.clips_children {
            geometry.clip = node.child_clip
            geometry.clipped = true
        } else if node.clipped {
            geometry.clip = node.clip
            geometry.clipped = true
        }
        return geometry
    }

    #program_export
    TreeCurrentParentKey :: (session: Session) -> u64 {
        parent: s32 = TreeCurrentParent(session)
        if parent < 0 { return cast(u64)0 }
        return trees[SessionIndex(session)].submitted[parent].key
    }

    #program_export
    TreeCurrentParentBounds :: (session: Session) -> Rectangle {
        parent: s32 = TreeCurrentParent(session)
        if parent < 0 {
            empty: Rectangle
            return empty
        }
        return trees[SessionIndex(session)].submitted[parent].bounds
    }

    #program_export
    TreeSubmitCurrent :: (session: Session, key: u64, kind: s32,
        bounds: Rectangle) -> s32 {
        parent: s32 = TreeCurrentParent(session)
        if parent < 0 { return -1 }
        return TreeSubmit(session, key, parent, kind, bounds)
    }

    #program_export
    TreePushScope :: (session: Session, index: s32) -> bool {
        if TreeFrameBlocked(session) { return false }
        if !trees[SessionIndex(session)].building || index < 0 ||
        index >= trees[SessionIndex(session)].submitted_count ||
        trees[SessionIndex(session)].scope_depth <= 0 ||
        trees[SessionIndex(session)].scope_depth >= 64 {
            if SessionValid(session) && trees[session.slot].building {
                trees[session.slot].error = cast(FrameStatus)FrameInvalidScope
            }
            return false
        }
        trees[SessionIndex(session)].scope[trees[SessionIndex(session)].scope_depth] = index
        trees[SessionIndex(session)].scope_depth += 1
        return true
    }

    #program_export
    TreePopScope :: (session: Session) -> bool {
        if TreeFrameBlocked(session) { return false }
        if !trees[SessionIndex(session)].building || trees[SessionIndex(session)].scope_depth <= 1 {
            if SessionValid(session) && trees[session.slot].building {
                trees[session.slot].error = cast(FrameStatus)FrameInvalidScope
            }
            return false
        }
        slot: s32 = SessionIndex(session)
        index: s32 = trees[slot].scope[trees[slot].scope_depth - 1]
        layout: s32 = trees[slot].submitted[index].layout_index
        if layout >= 0 && trees[slot].layouts[layout].closes {
            close: TreeClose = trees[slot].layouts[layout].close
            close(session, index)
        }
        trees[slot].scope_depth -= 1
        return true
    }

    // Close the innermost container opened by Page, Section, or another layout
    // widget. The root scope closes only through TreeFinish.
    #program_export
    End :: (session: Session) -> bool {
        return TreePopScope(session)
    }

    #program_export
    TreeSubmit :: (session: Session, key: u64, parent_index: s32, kind: s32,
        bounds: Rectangle) -> s32 {
        if !SessionValid(session) { return -1 }
        if TreeFrameBlocked(session) { return -1 }
        slot: s32 = session.slot
        if !trees[slot].building ||
        trees[slot].error != cast(FrameStatus)FrameOk { return -1 }
        if trees[slot].submitted_count == 2147483647 {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        if parent_index >= trees[slot].submitted_count || parent_index < -1 ||
        (parent_index < 0 && trees[slot].submitted_count > 0) {
            trees[slot].error = cast(FrameStatus)FrameInvalidParent
            return -1
        }
        index: s32 = trees[slot].submitted_count
        if !TreeBuildNewIndex(session, index + 1) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        node: NodeCore = .{.key = key, .auto_key = key == cast(u64)0, .semantic_index = -1,
            .interaction_index = -1, .state_index = -1, .layout_index = -1}
        // A widget's explicit key uses up its recorded caller.
        if !node.auto_key { trees[slot].sites.pending = 0 }
        parent_generation: u64 = cast(u64)0
        if parent_index >= 0 {
            parent_generation = trees[slot].submitted[parent_index].identity_generation
            if node.auto_key {
                node.auto_ordinal = TreeAutoOrdinal(slot, parent_index, true)
                node.key = cast(u64)node.auto_ordinal
            }
            parent_clip: NodeCore = trees[slot].submitted[parent_index]
            if parent_clip.clips_children {
                node.clip = parent_clip.child_clip
                node.clipped = true
            } else if parent_clip.clipped {
                node.clip = parent_clip.clip
                node.clipped = true
            }
        }
        if !node.auto_key && TreeExplicitExists(session, parent_generation, key) {
            // A repeated key keeps the frame: the widget is drawn under a
            // derived key and the repeat is reported, never a blank screen.
            attempt: s32 = 0
            derived: u64 = WidgetRepeatedKey(key, attempt)
            while attempt < WIDGET_KEY_ATTEMPTS && TreeExplicitExists(session, parent_generation, derived) {
                attempt += 1
                derived = WidgetRepeatedKey(key, attempt)
            }
            if attempt >= WIDGET_KEY_ATTEMPTS {
                trees[slot].error = cast(FrameStatus)FrameDuplicateKey
                trees[slot].error_key = key
                trees[slot].error_kind = kind
                return -1
            }
            if trees[slot].repeated_key == cast(u64)0 {
                trees[slot].repeated_key = key
                trees[slot].repeated_kind = kind
            }
            node.key = derived
        }
        node.owner_namespace = Components.Current(session)
        node.kind = kind
        node.measured_bounds = bounds
        // A widget placed ahead submits at the rect its parent gave it.
        if trees[slot].sites.placed_ahead {
            trees[slot].sites.placed_ahead = false
            node.bounds = bounds
            node.auto_placed = true
        } else if parent_index >= 0 && bounds.x == 0.0 && bounds.y == 0.0 &&
        trees[slot].submitted[parent_index].layout_index >= 0 {
            layout: LayoutData = trees[slot].layouts[
            trees[slot].submitted[parent_index].layout_index]
            if layout.places_children {
                placement: TreePlacement = layout.placement
                node.bounds = placement(session, parent_index, bounds)
                node.auto_placed = true
            }
        }
        if !node.auto_placed { node.bounds = bounds }
        node.parent = parent_index
        if parent_index >= 0 {
            last_sibling: s32 = trees[slot].submitted[parent_index].last_child
            node.sibling_ordinal = 1
            if last_sibling >= 0 {
                node.sibling_ordinal =
                trees[slot].submitted[last_sibling].sibling_ordinal + 1
            }
        }
        node.first_child = -1
        node.last_child = -1
        node.next_sibling = -1
        old_index: s32 = TreeFindOld(session, parent_generation,
            node.key, kind, node.auto_key, node.auto_ordinal, node.owner_namespace)
        // The existing lookup tells us whether every identity keeps its
        // committed position. Geometry, semantics and state may still change.
        if old_index != index { trees[slot].identity_order_unchanged = false }
        if old_index >= 0 {
            node.identity_generation = trees[slot].committed[old_index].identity_generation
        } else {
            if trees[slot].staged_identity_generation ==
            cast(u64)18446744073709551615 {
                trees[slot].error = cast(FrameStatus)FrameIdentityOverflow
                return -1
            }
            trees[slot].staged_identity_generation += cast(u64)1
            node.identity_generation = trees[slot].staged_identity_generation
        }
        if layout_motion_sample != null && parent_index >= 0 && !node.auto_key {
            parent_bounds := trees[slot].submitted[parent_index].bounds
            target := node.bounds
            target.x -= parent_bounds.x
            target.y -= parent_bounds.y
            previous := target
            if old_index >= 0 {
                old_parent := trees[slot].committed[old_index].parent
                old_parent_bounds := trees[slot].committed[old_parent].bounds
                previous = trees[slot].committed[old_index].bounds
                previous.x -= old_parent_bounds.x
                previous.y -= old_parent_bounds.y
            }
            placed := layout_motion_sample(session, parent_index, node.identity_generation,
                target, previous, old_index >= 0)
            node.bounds.x += placed.x - target.x
            node.bounds.y += placed.y - target.y
            node.bounds.width = placed.width
            node.bounds.height = placed.height
            // Full paints use the sampled bounds. Clip content and descendants
            // that still draw from the measured size during the transition.
            if placed.width != target.width || placed.height != target.height {
                node.clip = ifx node.clipped then RectangleIntersection(node.clip, node.bounds) else node.bounds
                node.clipped = true
            }
        }
        if !VecPush(trees[slot].submitted, node) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        if parent_index >= 0 {
            if node.auto_key && node.auto_ordinal < CallSiteOrdinalBase {
                trees[slot].submitted[parent_index].next_auto_ordinal =
                node.auto_ordinal
            }
            last: s32 = trees[slot].submitted[parent_index].last_child
            if last < 0 {
                trees[slot].submitted[parent_index].first_child = index
            } else {
                trees[slot].submitted[last].next_sibling = index
            }
            trees[slot].submitted[parent_index].last_child = index
        }
        if !node.auto_key && index >= TreeLinearIndexLimit {
            capacity: s32 = cast(s32)trees[slot].new_slots.count
            hash: u64 = TreeIdentityHash(parent_generation, node.key, 0)
            position: s32 = cast(s32)(hash & cast(u64)(capacity - 1))
            while trees[slot].new_slots[position] >= 0 {
                position = (position + 1) & (capacity - 1)
            }
            trees[slot].new_slots[position] = index
        }
        trees[slot].submitted_count += 1
        if kind == WidgetKindModal && index > 0 {
            trees[slot].submitted_modal_layer = index + 1
        }
        return index
    }

    #program_export
    TreeSetLayout :: (session: Session, index: s32, gap: s32, padding: s32,
        columns: s32, min_item_width: s32,
        max_columns: s32, padding_y: s32 = -1, row_gap: s32 = -1,
        child_width: TreeChildWidth = tree_no_child_width) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        layout: s32 = TreeEnsureLayout(session, index)
        if layout < 0 { return }
        trees[slot].layouts[layout].gap = gap
        trees[slot].layouts[layout].row_gap = ifx row_gap >= 0 then row_gap else gap
        trees[slot].layouts[layout].padding = padding
        trees[slot].layouts[layout].padding_y = ifx padding_y >= 0 then padding_y else padding
        trees[slot].layouts[layout].columns = columns
        trees[slot].layouts[layout].min_item_width = min_item_width
        trees[slot].layouts[layout].max_columns = max_columns
        trees[slot].layouts[layout].child_width = child_width
    }

    #program_export
    TreeSetPlacement :: (session: Session, index: s32, placement: TreePlacement) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        layout: s32 = TreeEnsureLayout(session, index)
        if layout < 0 { return }
        trees[slot].layouts[layout].placement = placement
        trees[slot].layouts[layout].places_children = true
    }

    // A content-sized container: `close` runs when its scope ends.
    #program_export
    TreeSetClose :: (session: Session, index: s32, close: TreeClose, size: TreeContentSize) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        layout: s32 = TreeEnsureLayout(session, index)
        if layout < 0 { return }
        trees[slot].layouts[layout].close = close
        trees[slot].layouts[layout].closes = true
        trees[slot].layouts[layout].content_size = size
    }

    #program_export
    TreeContentSizeAt :: (session: Session, index: s32) -> TreeContentSize {
        empty: TreeContentSize
        slot: s32 = SessionIndex(session)
        if index < 0 || index >= trees[slot].submitted_count { return empty }
        layout: s32 = trees[slot].submitted[index].layout_index
        if layout < 0 { return empty }
        return trees[slot].layouts[layout].content_size
    }

    // A container moves its own box inside the slot its parent placed, for
    // margins and min/max sizes, before it submits any child.
    #program_export
    TreeSetSubmittedBounds :: (session: Session, index: s32, bounds: Rectangle) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        trees[slot].submitted[index].bounds = bounds
    }

    // A container sets this before submitting children. Its own input is not
    // clipped by the child viewport; descendants inherit the intersection.
    #program_export
    TreeSetChildClip :: (session: Session, index: s32, bounds: Rectangle) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        if trees[slot].submitted[index].clipped {
            trees[slot].submitted[index].child_clip =
            RectangleIntersection(bounds, trees[slot].submitted[index].clip)
        } else {
            trees[slot].submitted[index].child_clip = bounds
        }
        trees[slot].submitted[index].clips_children = true
    }

    #program_export
    TreeSubmittedNodeAt :: (session: Session, index: s32) -> TreeEntry {
        return TreeRead(session, index, false)
    }

    // The committed node behind this frame's submitted parent. Late sibling
    // facts (:last-child and family) read it: while building, the parent's
    // remaining children are not known yet, so those facts match the
    // previous frame's child list and converge one frame after a structure
    // change. Memoized per frame, keyed by the parent's identity generation.
    #program_export
    TreeCommittedParent :: (session: Session, parent_index: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        if parent_index < 0 || parent_index >= trees[slot].submitted_count {
            return -1
        }
        parent := trees[slot].submitted[parent_index]
        if trees[slot].committed_parent_memo && parent.identity_generation ==
        trees[slot].committed_parent_generation {
            return trees[slot].committed_parent_index
        }
        index: s32 = -1
        if parent.parent >= 0 {
            index = TreeFindOld(session,
                trees[slot].submitted[parent.parent].identity_generation,
                parent.key, parent.kind, parent.auto_key, parent.auto_ordinal, parent.owner_namespace)
        } else {
            // A root parent has no parent generation to hash under; roots
            // are few, so the scan runs once per frame through the memo.
            for search: 0..trees[slot].committed_count - 1 {
                if trees[slot].committed[search].identity_generation ==
                parent.identity_generation { index = search; break }
            }
        }
        trees[slot].committed_parent_generation = parent.identity_generation
        trees[slot].committed_parent_index = index
        trees[slot].committed_parent_memo = true
        return index
    }

    #program_export
    TreeCommittedNodeAt :: (session: Session, index: s32) -> TreeEntry {
        return TreeRead(session, index, true)
    }

    // Native skins inspect this frame's submitted geometry without reading the
    // previous frame used for input routing.
    #program_export
    TreeSubmittedCount :: (session: Session) -> s32 {
        if !SessionValid(session) || !trees[session.slot].building { return 0 }
        return trees[session.slot].submitted_count
    }

    // The active editor in a retained subtree, including editors which the
    // viewport clips. Focus can reveal one without copying every node.
    #program_export
    TreeTextInputNode :: (session: Session, parent: s32 = -1) -> s32 {
        if !SessionValid(session) { return -1 }
        slot := session.slot
        for index: 0..trees[slot].committed_count - 1 {
            node := trees[slot].committed[index]
            if node.kind != WidgetKindTextField && node.kind != WidgetKindTextArea { continue }
            semantic := node.semantic_index
            if semantic < 0 || !trees[slot].committed_semantics[semantic].selected { continue }
            interaction := node.interaction_index
            if interaction >= 0 && trees[slot].committed_interactions[interaction].disabled { continue }
            if parent >= 0 {
                ancestor := node.parent
                while ancestor >= 0 && ancestor != parent {
                    ancestor = trees[slot].committed[ancestor].parent
                }
                if ancestor != parent { continue }
            }
            return cast(s32)index
        }
        return -1
    }

    #program_export
    TreeTextInputActive :: (session: Session) -> bool {
        return TreeTextInputNode(session) >= 0
    }

    // A widget that must sit above everything else the frame draws, such as a
    // context menu, registers a late callback while it runs. TreeFinish calls each
    // one after the page has been submitted, at the root, so its nodes and paint
    // come last and are on top in hit order.
    TreeLate :: #type (session: Session) -> ();

    TreeLateSlot :: struct {
        run: TreeLate
        used: bool
        owner: u64
    }

    tree_late: [9][4]TreeLateSlot;

    TreeClearDeferred :: (slot: s32) {
        for index: 0..3 { tree_late[slot][index] = .{} }
    }

    // Runs run at the end of this frame. Returns false when four are pending.
    #program_export
    TreeDefer :: (session: Session, run: TreeLate) -> bool {
        if !SessionValid(session) || TreeFrameBlocked(session) || !trees[session.slot].building || run == null { return false }
        index: s32 = 0
        while index < 4 {
            if !tree_late[session.slot][index].used {
                tree_late[session.slot][index].run = run
                tree_late[session.slot][index].used = true
                tree_late[session.slot][index].owner = Components.Current(session)
                return true
            }
            index += 1
        }
        return false
    }

    #program_export
    TreeFinish :: (session: Session) -> bool {
        if !SessionValid(session) || TreeFrameBlocked(session) { return false }
        slot: s32 = session.slot
        if !trees[slot].building {
            trees[slot].error = cast(FrameStatus)FrameNotBuilding
            return false
        }
        late: s32 = 0
        while late < 4 {
            if tree_late[slot][late].used {
                tree_late[slot][late].used = false
                if trees[slot].error == cast(FrameStatus)FrameOk &&
                trees[slot].scope_depth == 1 {
                    run: TreeLate = tree_late[slot][late].run
                    owner := tree_late[slot][late].owner
                    if owner == cast(u64)0 { run(session) }
                    else {
                        instance := ComponentTypes.Instance.{session, owner}
                        if Components.Resume(instance) {
                            run(session)
                            unused Components.Leave(instance)
                        }
                    }
                }
            }
            late += 1
        }
        trees[slot].building = false
        if Components.FrameStatus(session) != 0 && trees[slot].error == cast(FrameStatus)FrameOk {
            trees[slot].error = cast(FrameStatus)FrameComponentFailure
            trees[slot].error_key = Components.FrameErrorKey(session)
            trees[slot].error_kind = cast(s32)Components.FrameStatus(session)
        }
        if trees[slot].scope_depth != 1 &&
        trees[slot].error == cast(FrameStatus)FrameOk {
            pending: s32 = 1
            while pending < trees[slot].scope_depth {
                pending_node: s32 = trees[slot].scope[pending]
                if pending_node >= 0 && pending_node < trees[slot].submitted_count {
                    trees[slot].error_key = trees[slot].submitted[pending_node].key
                    trees[slot].error_kind = trees[slot].submitted[pending_node].kind
                }
                pending += 1
            }
            trees[slot].error = cast(FrameStatus)FrameInvalidScope
        }
        if trees[slot].error != cast(FrameStatus)FrameOk ||
        trees[slot].scope_depth != 1 {
            trees[slot].scope_depth = 0
            Components.FrameCancel(session)
            return false
        }
        trees[slot].scope_depth = 0
        // Reuse the lookup only for an accepted frame with identical identity
        // ordering. Failed and cancelled submissions leave its owner intact.
        trees[slot].identity_index_valid = trees[slot].identity_index_valid &&
        trees[slot].identity_order_unchanged &&
        trees[slot].submitted_count == trees[slot].committed_count
        VecSwap(trees[slot].committed, trees[slot].submitted)
        VecSwap(trees[slot].committed_semantics, trees[slot].submitted_semantics)
        VecSwap(trees[slot].committed_text, trees[slot].submitted_text)
        trees[slot].committed_label_buffer = 1 - trees[slot].committed_label_buffer
        VecSwap(trees[slot].committed_interactions, trees[slot].submitted_interactions)
        VecSwap(trees[slot].committed_states, trees[slot].submitted_states)
        trees[slot].committed_count = trees[slot].submitted_count
        trees[slot].committed_modal_layer = trees[slot].submitted_modal_layer
        trees[slot].next_identity_generation = trees[slot].staged_identity_generation
        Components.FrameCommit(session)
        CursorHoverFrameCommit(session)
        return true
    }

    #program_export
    TreeCount :: (session: Session) -> s32 {
        return trees[SessionIndex(session)].committed_count
    }

    // Input sees only the last accepted frame, including while its replacement is
    // being composed. Submission order makes the last modal the uppermost layer.
    #program_export
    TreeModalLayer :: (session: Session) -> s32 {
        return trees[SessionIndex(session)].committed_modal_layer
    }

    #program_export
    TreeFrameStatus :: (session: Session) -> FrameStatus {
        if !SessionValid(session) { return cast(FrameStatus)FrameInvalidSession }
        if TreeFrameBlocked(session) { return cast(FrameStatus)FrameComponentFailure }
        return trees[session.slot].error
    }

    // Reentrant lifecycle work observes a rejected transaction without changing
    // the error or submitted storage of the outer frame that owns disposal.
    TreeFrameBlocked :: (session: Session) -> bool { return Components.FrameBlocked(session) }

    #program_export
    TreeFramePendingScopes :: (session: Session) -> s32 {
        if !SessionValid(session) { return 0 }
        slot := SessionIndex(session)
        if trees[slot].scope_depth > 1 { return trees[slot].scope_depth }
        return 0
    }

    // The key and kind of the widget that failed the frame, such as the second
    // widget submitted with an explicit key already used under the same parent.
    #program_export
    TreeFrameErrorKey :: (session: Session) -> u64 {
        if !SessionValid(session) { return cast(u64)0 }
        return trees[session.slot].error_key
    }

    #program_export
    TreeFrameErrorKind :: (session: Session) -> s32 {
        if !SessionValid(session) { return 0 }
        return trees[session.slot].error_kind
    }

    // The first key the frame received twice under one parent, or 0, and its
    // kind. The frame still drew; the app should give the widgets own keys.
    #program_export
    TreeFrameRepeatedKey :: (session: Session) -> u64 {
        if !SessionValid(session) { return cast(u64)0 }
        return trees[session.slot].repeated_key
    }

    #program_export
    TreeFrameRepeatedKind :: (session: Session) -> s32 {
        if !SessionValid(session) { return 0 }
        return trees[session.slot].repeated_kind
    }

    #program_export
    TreeIsBuilding :: (session: Session) -> bool {
        if TreeFrameBlocked(session) { return false }
        return trees[SessionIndex(session)].building
    }

    #program_export
    TreeNextKey :: (session: Session) -> u64 {
        parent: s32 = TreeCurrentParent(session)
        if parent < 0 { return cast(u64)0 }
        slot: s32 = SessionIndex(session)
        generation := trees[slot].submitted[parent].identity_generation
        owner := Components.Current(session)
        if owner != cast(u64)0 { generation = CallSiteMix(generation, owner) }
        // A widget's caller names the key it keeps its state under.
        ordinal := CallSiteOrdinal(*trees[slot].sites, generation, true)
        if ordinal == 0 {
            ordinal = 1
            if owner != cast(u64)0 {
                child := trees[slot].submitted[parent].first_child
                while child >= 0 {
                    if trees[slot].submitted[child].owner_namespace == owner { ordinal += 1 }
                    child = trees[slot].submitted[child].next_sibling
                }
            } else {
                last: s32 = trees[slot].submitted[parent].last_child
                if last >= 0 { ordinal = trees[slot].submitted[last].sibling_ordinal + 1 }
            }
        }
        return TreeIdentityHash(generation, cast(u64)ordinal, 2147483647)
    }
    #program_export
    TreeRootBounds :: (session: Session) -> Rectangle {
        empty: Rectangle
        if !trees[SessionIndex(session)].building || trees[SessionIndex(session)].submitted_count == 0 {
            return empty
        }
        return trees[SessionIndex(session)].submitted[0].bounds
    }

    #program_export
    TreeCancel :: (session: Session) {
        if TreeFrameBlocked(session) { return }
        Components.FrameCancel(session)
        slot: s32 = SessionIndex(session)
        TreeClearDeferred(slot)
        trees[slot].building = false
        VecClear(trees[slot].submitted)
        VecClear(trees[slot].submitted_semantics)
        VecClear(trees[slot].submitted_text)
        trees[slot].submitted_label_count = 0
        trees[slot].submitted_label_spans = 0
        VecClear(trees[slot].submitted_label_overflow)
        VecClear(trees[slot].submitted_interactions)
        VecClear(trees[slot].submitted_states)
        VecClear(trees[slot].layouts)
        trees[slot].submitted_count = 0
        trees[slot].scope_depth = 0
        trees[slot].error = cast(FrameStatus)FrameOk
    }

    #program_export
    TreeNodeAt :: (session: Session, index: s32) -> TreeEntry {
        return TreeRead(session, index, true)
    }

    // An overlay and its children share a layer above ordinary page content.
    // Later overlays, including nested ones, sit above earlier overlays.
    #program_export
    TreeOverlayLayerAt :: (session: Session, index: s32, committed: bool) -> s32 {
        return TreeLayerAt(session, index, committed, true)
    }

    // The modal layer that owns this node's input, ignoring popups: a popup
    // floats above the page but takes no input away from it.
    #program_export
    TreeModalLayerAt :: (session: Session, index: s32) -> s32 {
        return TreeLayerAt(session, index, true, false)
    }

    TreeLayerAt :: (session: Session, index: s32, committed: bool, popups: bool) -> s32 {
        if !SessionValid(session) { return 0 }
        slot := session.slot
        count := trees[slot].submitted_count
        if committed { count = trees[slot].committed_count }
        while index > 0 && index < count {
            node: *NodeCore
            if committed {
                node = *trees[slot].committed[index]
            } else {
                node = *trees[slot].submitted[index]
            }
            if node.kind == WidgetKindModal || (popups && node.popup) { return index + 1 }
            index = node.parent
        }
        return 0
    }

    // A popup, such as a dropdown's open menu, is painted and hit above the
    // rest of the page, but the page keeps its input: pressing outside the
    // popup reaches the control there. It escapes the clip of the scroll area
    // or dialog it opens from, so it shows whole over their edges.
    #program_export
    TreeSetPopup :: (session: Session, index: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        trees[slot].submitted[index].popup = true
        trees[slot].submitted[index].clipped = false
    }

    // A widget that scrolls its own content, as a text area does, says when
    // more of it is out of view. The wheel over it then scrolls it rather
    // than a scroll around it; see TreeScrollAt.
    #program_export
    TreeSetWheelScrolls :: (session: Session, index: s32, scrolls: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        trees[slot].submitted[index].wheel_scrolls = scrolls
    }

    // A widget that scrolls its own content says when a drag of it moves
    // that content, as a finger's does on a text area with more text than
    // shows. A drag on it then scrolls it rather than a scroll around it.
    #program_export
    TreeSetDragScrolls :: (session: Session, index: s32, scrolls: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        trees[slot].submitted[index].drag_scrolls = scrolls
    }

    // Read a bounded UTF-8 byte range without exposing the tree's owned buffer.
    // Long documents remain available in chunks; passwords yield no bytes.
    #program_export
    TreeTextRange :: (session: Session, index: s32, first: s32, last: s32,
        output: []u8) -> string {
        if !SessionValid(session) || index < 0 || index >= TreeCount(session) {
            return ""
        }
        slot: s32 = session.slot
        semantic: s32 = trees[slot].committed[index].semantic_index
        if semantic < 0 { return "" }
        data: SemanticData = trees[slot].committed_semantics[semantic]
        if data.secure || first < 0 || last < first || last > data.text_length ||
        last - first > output.count { return "" }
        byte: s32 = 0
        while byte < last - first {
            output[byte] = trees[slot].committed_text[data.text_offset + first + byte]
            byte += 1
        }
        return TextView(output[:byte])
    }

    // Own the immutable frame value; caller storage may change after submission.
    // Password bytes never enter the semantic tree. Selection offsets are UTF-8
    // byte offsets; platform adapters translate their own character conventions.
    #program_export
    TreeSetTextValue :: (session: Session, index: s32, value: string,
        cursor: s32, anchor: s32, read_only: bool, secure: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        start: s64 = trees[slot].submitted_text.count
        if !secure {
            byte: s64 = 0
            while byte < value.count {
                if !VecPush(trees[slot].submitted_text, value[byte]) {
                    trees[slot].error = cast(FrameStatus)FrameAllocationFailed
                    return
                }
                byte += 1
            }
        }
        trees[slot].submitted_semantics[semantic].has_text = true
        trees[slot].submitted_semantics[semantic].text_offset = start
        trees[slot].submitted_semantics[semantic].text_length =
        trees[slot].submitted_text.count - start
        trees[slot].submitted_semantics[semantic].text_bytes = cast(s32)value.count
        trees[slot].submitted_semantics[semantic].text_cursor = cursor
        trees[slot].submitted_semantics[semantic].text_anchor = anchor
        trees[slot].submitted_semantics[semantic].read_only = read_only
        trees[slot].submitted_semantics[semantic].secure = secure
    }

    TreeLabelSpanAt :: (slot: s32, index: s64) -> LabelSpan {
        if index < 64 { return trees[slot].submitted_labels[index] }
        return trees[slot].submitted_label_overflow[index - 64]
    }

    TreeSetLabelSpan :: (slot: s32, index: s64, span: LabelSpan) {
        if index < 64 { trees[slot].submitted_labels[index] = span }
        else { trees[slot].submitted_label_overflow[index - 64] = span }
    }

    TreeStoreLabel :: (slot: s32, value: string) -> s64 {
        if value.count == 0 { return 0 }
        if value.count > TreeLabelCapacity {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        buffer: s32 = 1 - trees[slot].committed_label_buffer
        labels := *trees[slot].labels[buffer]
        if labels.bytes.count == 0 && !VecResizeBounded(labels.bytes, TreeLabelCapacity, TreeLabelCapacity) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        prefix: u32
        byte: s64 = 0
        while byte < 4 {
            prefix <<= cast(u32)8
            if byte < value.count { prefix |= cast(u32)value[byte] }
            byte += 1
        }
        low: s64 = 0
        high: s64 = trees[slot].submitted_label_spans
        while low < high {
            middle := low + (high - low) / 2
            span := TreeLabelSpanAt(slot, middle)
            before: bool = span.length < cast(u32)value.count
            if span.length == cast(u32)value.count {
                before = span.prefix < prefix
                if span.prefix == prefix {
                    stored := TreeLabelText(labels, cast(s64)span.offset, cast(s64)span.length)
                    if stored == value { return cast(s64)span.offset }
                    byte = 4
                    while byte < value.count && stored[byte] == value[byte] { byte += 1 }
                    before = byte < value.count && stored[byte] < value[byte]
                }
            }
            if before { low = middle + 1 } else { high = middle }
        }
        start: s64 = trees[slot].submitted_label_count
        if value.count > TreeLabelCapacity - start {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        span := LabelSpan.{cast(u32)start, cast(u32)value.count, prefix}
        // Reserve the directory entry before writing any owned bytes. Failure
        // leaves both the directory and byte count unchanged.
        if trees[slot].submitted_label_spans >= 64 &&
        !VecPush(trees[slot].submitted_label_overflow, span) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return -1
        }
        at := trees[slot].submitted_label_spans
        while at > low {
            TreeSetLabelSpan(slot, at, TreeLabelSpanAt(slot, at - 1))
            at -= 1
        }
        TreeSetLabelSpan(slot, low, span)
        trees[slot].submitted_label_spans += 1
        byte = 0
        while byte < value.count {
            labels.bytes[start + byte] = value[byte]
            byte += 1
        }
        trees[slot].submitted_label_count = start + byte
        return start
    }

    #program_export
    TreeSetLabel :: (session: Session, index: s32, label: string) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        start := TreeStoreLabel(slot, label)
        if start < 0 { return }
        trees[slot].submitted_semantics[semantic].label_offset = start
        trees[slot].submitted_semantics[semantic].label_length =
        label.count
    }

    #program_export
    TreeSetSemanticDetail :: (session: Session, index: s32, detail: string) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        start := TreeStoreLabel(slot, detail)
        if start < 0 { return }
        trees[slot].submitted_semantics[semantic].detail_offset = start
        trees[slot].submitted_semantics[semantic].detail_length =
        detail.count
    }

    #program_export
    TreeSetSemantic :: (session: Session, index: s32, kind: SemanticKind,
        heading_level: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        if kind != cast(SemanticKind)SemanticHeading {
            heading_level = 0
        } else {
            if heading_level < 1 { heading_level = 1 }
            if heading_level > 6 { heading_level = 6 }
        }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        trees[slot].submitted_semantics[semantic].kind = kind
        trees[slot].submitted_semantics[semantic].heading_level = heading_level
    }

    #program_export
    TreeSetInteractive :: (session: Session, index: s32, disabled: bool, loading: bool,
        focus_id: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        interaction: s32 = TreeEnsureInteraction(session, index)
        if interaction < 0 { return }
        trees[slot].submitted_interactions[interaction].disabled = disabled
        trees[slot].submitted_interactions[interaction].loading = loading
        trees[slot].submitted_interactions[interaction].focus_id = focus_id
    }

    // A widget saves its state on the node it submitted in this frame.
    // Committed editor intent; scoped to the retained node and session epoch.
    #program_export
    TreeSetCaptureTab :: (session: Session, index: s32, capture: bool) {
        if !SessionValid(session) { return }
        slot := SessionIndex(session)
        if !trees[slot].building || index < 0 || index >= trees[slot].submitted_count { return }
        interaction := TreeEnsureInteraction(session, index)
        if interaction >= 0 { trees[slot].submitted_interactions[interaction].capture_tab = capture }
    }

    #program_export
    TreeSetWidgetState :: (session: Session, index: s32, state: WidgetState) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        existing: s32 = trees[slot].submitted[index].state_index
        if existing >= 0 {
            trees[slot].submitted_states[existing] = state
            return
        }
        next: s32 = cast(s32)trees[slot].submitted_states.count
        if !VecPush(trees[slot].submitted_states, state) {
            trees[slot].error = cast(FrameStatus)FrameAllocationFailed
            return
        }
        trees[slot].submitted[index].state_index = next
    }

    // The state a widget saved on its node in the last committed frame. The
    // index comes from TreePrevious; a widget without one starts empty.
    #program_export
    TreePreviousWidgetState :: (session: Session, index: s32) -> WidgetState {
        state: WidgetState
        slot: s32 = SessionIndex(session)
        if index < 0 || index >= trees[slot].committed_count { return state }
        stored: s32 = trees[slot].committed[index].state_index
        if stored < 0 || stored >= cast(s32)trees[slot].committed_states.count { return state }
        return trees[slot].committed_states[stored]
    }

    #program_export
    TreeSetDragCapture :: (session: Session, index: s32, captures_drag: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        interaction: s32 = trees[slot].submitted[index].interaction_index
        if interaction < 0 { return }
        trees[slot].submitted_interactions[interaction].captures_drag = captures_drag
    }

    // The cursor shape over an interactive node instead of its kind's own;
    // 0 or an invalid shape restores the kind's shape.
    #program_export
    TreeSetCursor :: (session: Session, index: s32, shape: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        interaction: s32 = trees[slot].submitted[index].interaction_index
        if interaction < 0 { return }
        if shape < 0 || shape > 10 { shape = 0 }
        trees[slot].submitted_interactions[interaction].cursor = shape
    }

    #program_export
    TreeSetCircleHit :: (session: Session, index: s32, circle_hit: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        interaction: s32 = trees[slot].submitted[index].interaction_index
        if interaction < 0 { return }
        trees[slot].submitted_interactions[interaction].circle_hit = circle_hit
    }

    #program_export
    TreeSetSelected :: (session: Session, index: s32, selected: bool) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        trees[slot].submitted_semantics[semantic].selected = selected
    }

    // Text that wraps to more lines than its box shows reports how many are
    // left out, such as a label cut off below a fixed height.
    #program_export
    TreeSetHiddenLines :: (session: Session, index: s32, hidden_lines: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 ||
        index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic < 0 { return }
        trees[slot].submitted_semantics[semantic].hidden_lines = hidden_lines
    }

    #program_export
    TreeChild :: (session: Session, parent_index: s32,
        key: u64, kind: s32) -> s32 {
        slot: s32 = SessionIndex(session)
        if parent_index < 0 || parent_index >= trees[slot].committed_count {
            return -1
        }
        child: s32 = trees[slot].committed[parent_index].first_child
        while child >= 0 {
            node: NodeCore = trees[slot].committed[child]
            if !node.auto_key && node.key == key && node.kind == kind && node.owner_namespace == Components.Current(session) {
                return child
            }
            child = node.next_sibling
        }
        return -1
    }

    #program_export
    TreeDispose :: (session: Session) {
        if !SessionValid(session) { return }
        if !Components.DisposeOwner(session.slot, session.epoch) { return }
        CursorSessionEnd(session)
        slot: s32 = session.slot
        TreeClearDeferred(slot)
        VecFree(trees[slot].committed)
        VecFree(trees[slot].submitted)
        VecFree(trees[slot].committed_semantics)
        VecFree(trees[slot].submitted_semantics)
        VecFree(trees[slot].committed_text)
        VecFree(trees[slot].submitted_text)
        VecFree(trees[slot].labels[0].bytes)
        VecFree(trees[slot].labels[1].bytes)
        VecFree(trees[slot].submitted_label_overflow)
        trees[slot].submitted_label_spans = 0
        VecFree(trees[slot].committed_interactions)
        VecFree(trees[slot].submitted_interactions)
        VecFree(trees[slot].committed_states)
        VecFree(trees[slot].submitted_states)
        VecFree(trees[slot].layouts)
        VecFree(trees[slot].slots)
        VecFree(trees[slot].new_slots)
        trees[slot].scope_depth = 0
        trees[slot].committed_count = 0
        trees[slot].submitted_count = 0
        trees[slot].committed_modal_layer = 0
        trees[slot].submitted_modal_layer = 0
        trees[slot].next_identity_generation = 0
        trees[slot].staged_identity_generation = 0
        trees[slot].identity_index_valid = false
        trees[slot].identity_order_unchanged = false
        trees[slot].building = false
    }

    #program_export
    TreeSetStyleClass :: (session: Session, index: s32, style_class: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 || index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic >= 0 { trees[slot].submitted_semantics[semantic].style_class = style_class }
    }

    #program_export
    TreeSetStyleId :: (session: Session, index: s32, style_id: s32) {
        slot: s32 = SessionIndex(session)
        if !trees[slot].building || index < 0 || index >= trees[slot].submitted_count { return }
        semantic: s32 = TreeEnsureSemantic(session, index)
        if semantic >= 0 { trees[slot].submitted_semantics[semantic].style_id = style_id }
    }

}
