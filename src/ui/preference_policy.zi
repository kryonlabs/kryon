#import "theme"

ThemeSource :: enum {
    ThemeSourceApp = 0
    ThemeSourceSystem = 1
}

ThemePreference :: struct {
    theme_id: s32
    source: ThemeSource
    mode: ThemePolicy
    system_dark: bool
}

ThemeDecision :: struct {
    theme_id: s32
    source: ThemeSource
    mode: ThemePolicy
    dark: bool
}

# The host reports the system preference. Kryon chooses the effective palette
# and returns a value for native, browser, or portable presentation.
#program_export
ThemeDecisionFor :: (preference: ThemePreference) -> ThemeDecision {
    decision: ThemeDecision
    decision.theme_id = preference.theme_id
    decision.source = preference.source
    if decision.source != cast(ThemeSource)ThemeSourceApp &&
        decision.source != cast(ThemeSource)ThemeSourceSystem {
        decision.source = cast(ThemeSource)ThemeSourceSystem
    }
    decision.mode = preference.mode
    if decision.mode != cast(ThemePolicy)ThemePolicyLight &&
        decision.mode != cast(ThemePolicy)ThemePolicyDark {
        decision.mode = cast(ThemePolicy)ThemePolicySystem
    }
    decision.dark = ResolveDark(decision.mode, preference.system_dark)
    return decision
}

OrientationPreference :: struct {
    mode: s32
    portrait_mode: s32
    landscape_mode: s32
}

OrientationAction :: enum {
    OrientationActionNone = 0
    OrientationActionResize = 1
    OrientationActionSetMode = 2
}

OrientationDecision :: struct {
    action: OrientationAction
    width: s32
    height: s32
    mode: s32
}

# Capabilities are observations supplied by the host. The policy decides
# whether to request a resize or a platform orientation change.
#program_export
OrientationDecisionFor :: (preference: OrientationPreference,
    width: s32, height: s32, can_resize: bool,
    can_set_mode: bool) -> OrientationDecision {
    decision: OrientationDecision
    decision.mode = preference.mode
    if width > 0 && height > 0 && can_resize &&
        ((preference.mode == preference.portrait_mode && width > height) ||
         (preference.mode == preference.landscape_mode && height > width)) {
        decision.action = cast(OrientationAction)OrientationActionResize
        decision.width = height
        decision.height = width
        return decision
    }
    if can_set_mode {
        decision.action = cast(OrientationAction)OrientationActionSetMode
    }
    return decision
}
