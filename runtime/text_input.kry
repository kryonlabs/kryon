#module "text_input"
#import "control_props"
#import "drawing_props"

TextInputMetrics :: struct {
    font: i32
    padding_x: i32
    padding_y: i32
    line_gap: i32
    line_height: i32
}

TextFieldScroll :: struct {
    scroll: i32
    max_scroll: i32
    clip_width: i32
    text_origin_x: i32
}

TextFieldPaint :: struct {
    clip_bounds: Rectangle
    text_x: i32
    cursor_y: i32
    cursor_height: i32
}

TextAreaPaint :: struct {
    clip_bounds: Rectangle
    wrap_width: i32
    viewport_height: i32
    max_scroll: i32
    scroll_y: i32
    placeholder_x: i32
    placeholder_y: i32
}

TextAreaGutterMetrics :: struct {
    top_inset: i32
    active_y_inset: i32
    label_x_inset: i32
    label_font: i32
    extra_rows: i32
}

TextNavigationDecision :: struct {
    consumed: bool
    collapse_selection_start: bool
    collapse_selection_end: bool
    char_direction: i32
    word_direction: i32
    document_edge: i32
    line_edge: i32
    vertical_direction: i32
    page_direction: i32
    extend_selection: bool
}

TextDeleteDecision :: struct {
    consumed: bool
    char_direction: i32
    word_direction: i32
    document_edge: i32
}

TextInsertDecision :: struct {
    accept: bool
    skip: bool
    stop: bool
}

TextInputDoubleClickDecision :: struct {
    double_click: bool
}

TextCompositionInputDecision :: struct {
    accept_events: bool
    cancel: bool
    drain_events: bool
}

TextCompositionSessionDecision :: struct {
    visible: bool
    cancel: bool
}

TextCompositionPhaseDecision :: struct {
    store_preedit: bool
    commit: bool
    cancel: bool
}

TextCompositionApplyDecision :: struct {
    text_changed: bool
    presentation_changed: bool
    selection_changed: bool
}

TextCompositionViewRange :: struct {
    replace_start: i32
    replace_end: i32
    cursor: i32
    selection_start: i32
    selection_end: i32
    composition_start: i32
    composition_end: i32
}

TextCompositionPaintSpan :: struct {
    visible: bool
    start: i32
    end: i32
}

TextSelectionPaintSpan :: struct {
    visible: bool
    start: i32
    end: i32
    continues_past_line: bool
}

TextFieldPanDecision :: struct {
    pan: bool
}

TextCompositionInputDecisionFor :: (focused: bool, read_only: bool) -> TextCompositionInputDecision #export {
    decision: TextCompositionInputDecision
    decision.accept_events = focused && !read_only
    decision.cancel = !decision.accept_events
    decision.drain_events = focused && read_only
    return decision
}

TextCompositionCancelDecisionFor :: (has_owner: bool, scoped: bool,
    same_owner: bool) -> TextCompositionSessionDecision #export {
    decision: TextCompositionSessionDecision
    decision.cancel = has_owner && (!scoped || same_owner)
    return decision
}

TextCompositionGetDecisionFor :: (has_owner: bool, same_owner: bool,
    has_text: bool) -> TextCompositionSessionDecision #export {
    decision: TextCompositionSessionDecision
    decision.visible = has_owner && same_owner && has_text
    return decision
}

TextCompositionPhaseDecisionFor :: (phase: i32) -> TextCompositionPhaseDecision #export {
    decision: TextCompositionPhaseDecision
    decision.store_preedit = phase == 1 || phase == 2
    decision.commit = phase == 3
    decision.cancel = phase == 4
    return decision
}

TextCompositionApplyDecisionFor :: (phase: i32,
    text_changed: bool) -> TextCompositionApplyDecision #export {
    event: TextCompositionPhaseDecision = TextCompositionPhaseDecisionFor(phase)
    decision: TextCompositionApplyDecision
    if event.store_preedit || event.cancel {
        decision.presentation_changed = true
        return decision
    }
    if event.commit {
        decision.text_changed = text_changed
        decision.presentation_changed = true
        decision.selection_changed = true
    }
    return decision
}

TextCompositionSelectionLength :: (preedit_len: i32, cursor: i32,
    selection_length: i32) -> i32 #export {
    if preedit_len < 0 { preedit_len = 0 }
    if cursor < 0 { cursor = 0 }
    if cursor > preedit_len { cursor = preedit_len }
    if selection_length < 0 { selection_length = 0 }
    max_length: i32 = preedit_len - cursor
    if selection_length > max_length { return max_length }
    return selection_length
}

TextCompositionViewRangeFor :: (selection_start: i32, selection_end: i32,
    preedit_len: i32, preedit_cursor: i32,
    preedit_selection_end: i32) -> TextCompositionViewRange #export {
    range: TextCompositionViewRange
    if selection_start < 0 { selection_start = 0 }
    if selection_end < 0 { selection_end = 0 }
    if selection_start <= selection_end {
        range.replace_start = selection_start
        range.replace_end = selection_end
    } else {
        range.replace_start = selection_end
        range.replace_end = selection_start
    }
    if preedit_len < 0 { preedit_len = 0 }
    if preedit_cursor < 0 { preedit_cursor = 0 }
    if preedit_cursor > preedit_len { preedit_cursor = preedit_len }
    if preedit_selection_end < preedit_cursor {
        preedit_selection_end = preedit_cursor
    }
    if preedit_selection_end > preedit_len {
        preedit_selection_end = preedit_len
    }
    range.cursor = range.replace_start + preedit_cursor
    range.selection_start = range.cursor
    range.selection_end = range.replace_start + preedit_selection_end
    range.composition_start = range.replace_start
    range.composition_end = range.replace_start + preedit_len
    return range
}

TextCompositionPaintSpanForText :: (composition_start: i32,
    composition_end: i32, text_len: i32) -> TextCompositionPaintSpan #export {
    span: TextCompositionPaintSpan
    if text_len < 0 { text_len = 0 }
    if composition_start < 0 { composition_start = 0 }
    if composition_end < 0 { composition_end = 0 }
    if composition_start > text_len { composition_start = text_len }
    if composition_end > text_len { composition_end = text_len }
    if composition_end <= composition_start { return span }
    span.visible = true
    span.start = composition_start
    span.end = composition_end
    return span
}

TextCompositionPaintSpanForLine :: (composition_start: i32,
    composition_end: i32, line_start: i32,
    line_end: i32) -> TextCompositionPaintSpan #export {
    span: TextCompositionPaintSpan
    if composition_end <= composition_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = composition_start
    if span.start < line_start { span.start = line_start }
    span.end = composition_end
    if span.end > line_end { span.end = line_end }
    if span.end <= span.start { return span }
    span.visible = true
    return span
}

TextCompositionUnderlineEndX :: (start_x: i32, end_x: i32,
    stroke_width: i32) -> i32 #export {
    if stroke_width < 1 { stroke_width = 1 }
    if end_x <= start_x { return start_x + stroke_width }
    return end_x
}

TextCompositionUnderlineY :: (text_y: i32, line_height: i32,
    stroke_width: i32) -> i32 #export {
    if stroke_width < 1 { stroke_width = 1 }
    return text_y + line_height - stroke_width
}

TextSelectionPaintSpanForLine :: (selection_start: i32,
    selection_end: i32, line_start: i32,
    line_end: i32) -> TextSelectionPaintSpan #export {
    span: TextSelectionPaintSpan
    if selection_end <= selection_start { return span }
    if line_end < line_start { line_end = line_start }
    span.start = selection_start
    if span.start < line_start { span.start = line_start }
    span.end = selection_end
    if span.end > line_end { span.end = line_end }
    span.continues_past_line = selection_start <= line_start &&
        selection_end > line_end
    if span.end < span.start { return span }
    if span.end == span.start && !span.continues_past_line {
        return span
    }
    span.visible = true
    return span
}

TextSelectionRange :: struct {
    start: i32
    end: i32
    has_selection: bool
}

TextSelectionState :: struct {
    anchor: i32
    cursor: i32
    has_selection: bool
}

TextSelectionOwnerMatches :: (has_owner: bool, same_owner: bool,
    selection_id: i32, requested_id: i32) -> bool #export {
    if has_owner && same_owner {
        return true
    }
    return requested_id > 0 && selection_id == requested_id
}

TextNavNone :: () -> i32 #export {
    return 0
}

TextNavLeft :: () -> i32 #export {
    return 1
}

TextNavRight :: () -> i32 #export {
    return 2
}

TextNavHome :: () -> i32 #export {
    return 3
}

TextNavEnd :: () -> i32 #export {
    return 4
}

TextNavUp :: () -> i32 #export {
    return 5
}

TextNavDown :: () -> i32 #export {
    return 6
}

TextNavPageUp :: () -> i32 #export {
    return 7
}

TextNavPageDown :: () -> i32 #export {
    return 8
}

TextDeleteNone :: () -> i32 #export {
    return 0
}

TextDeleteBackspace :: () -> i32 #export {
    return 1
}

TextDeleteForward :: () -> i32 #export {
    return 2
}

TextInputMetric :: (fields: u32, field: u32, value: i32,
    fallback: i32) -> i32 {
    if (fields & field) == (u32)0 || value < 0 {
        return fallback
    }
    return value
}

TextInputScaledMetric :: (value: float, scale: float) -> i32 {
    if scale <= 0.0 { scale = 1.0 }
    metric: i32 = (i32)(value * scale)
    if metric < 0 { return 0 }
    return metric
}

TextInputDefaultPaddingX :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(10.0, scale)
}

TextInputDefaultPaddingY :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(8.0, scale)
}

TextAreaMinWrapWidth :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(24.0, scale)
}

TextAreaScrollbarWidthFor :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(12.0, scale)
}

TextAreaGutterMetricsFor :: (scale: float) -> TextAreaGutterMetrics #export {
    metrics: TextAreaGutterMetrics
    metrics.top_inset = TextInputScaledMetric(10.0, scale)
    metrics.active_y_inset = TextInputScaledMetric(2.0, scale)
    metrics.label_x_inset = TextInputScaledMetric(6.0, scale)
    metrics.label_font = TextInputScaledMetric(10.0, scale)
    metrics.extra_rows = 3
    return metrics
}

TextAreaGutterRowsFor :: (bounds_height: float, line_height: i32,
    metrics: TextAreaGutterMetrics) -> i32 #export {
    if line_height <= 0 { return 0 }
    rows: i32 = ((i32)bounds_height / line_height) + metrics.extra_rows
    if rows < 0 { return 0 }
    return rows
}

TextAreaGutterFirstY :: (gutter_y: float, scroll_y: i32, line_height: i32,
    metrics: TextAreaGutterMetrics) -> i32 #export {
    if line_height <= 0 { return (i32)gutter_y + metrics.top_inset }
    return (i32)gutter_y + metrics.top_inset - (scroll_y % line_height)
}

TextFieldRevealMargin :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(8.0, scale)
}

TextInputDoubleClickSlopFor :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(6.0, scale)
}

TextInputDoubleClickMaxSeconds :: () -> float #export {
    return 0.45
}

TextInputDoubleClickDecisionFor :: (same_owner: bool, same_id: bool,
    elapsed_seconds: float, dx: i32, dy: i32,
    slop: i32) -> TextInputDoubleClickDecision #export {
    decision: TextInputDoubleClickDecision
    if slop < 0 { slop = 0 }
    if dx < 0 { dx = -dx }
    if dy < 0 { dy = -dy }
    decision.double_click = same_owner && same_id &&
        elapsed_seconds <= TextInputDoubleClickMaxSeconds() &&
        dx <= slop && dy <= slop
    return decision
}

TextFieldPanDragThresholdFor :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(5.0, scale)
}

TextFieldPanDecisionFor :: (already_panning: bool, dx: i32, dy: i32,
    threshold: i32) -> TextFieldPanDecision #export {
    decision: TextFieldPanDecision
    if threshold < 0 { threshold = 0 }
    abs_dx: i32 = dx
    abs_dy: i32 = dy
    if abs_dx < 0 { abs_dx = -abs_dx }
    if abs_dy < 0 { abs_dy = -abs_dy }
    decision.pan = already_panning ||
        (abs_dx > threshold && abs_dx >= abs_dy)
    return decision
}

TextFieldMinCursorHeight :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(8.0, scale)
}

TextFieldCursorVerticalPadding :: (scale: float) -> i32 #export {
    return TextInputScaledMetric(8.0, scale)
}

TextFieldClipGuard :: (scale: float) -> i32 #export {
    clip_guard: i32 = TextInputScaledMetric(1.0, scale)
    if clip_guard < 1 { return 1 }
    return clip_guard
}

TextInputStrokeWidth :: (scale: float) -> i32 #export {
    width: i32 = TextInputScaledMetric(2.0, scale)
    if width < 1 { return 1 }
    return width
}

TextInputMetricsFor :: (fields: u32, font: i32, padding_x: i32, padding_y: i32,
    line_gap: i32, default_font: i32, default_padding_x: i32,
    default_padding_y: i32, default_line_gap: i32) -> TextInputMetrics #export {
    metrics: TextInputMetrics
    metrics.font = font
    if metrics.font <= 0 {
        metrics.font = default_font
    }
    metrics.padding_x = TextInputMetric(fields, (u32)StylePaddingX,
        padding_x, default_padding_x)
    metrics.padding_y = TextInputMetric(fields, (u32)StylePaddingY,
        padding_y, default_padding_y)
    metrics.line_gap = TextInputMetric(fields, (u32)StyleGap,
        line_gap, default_line_gap)
    metrics.line_height = metrics.font + metrics.line_gap
    if metrics.line_height <= 0 {
        metrics.line_height = 1
    }
    return metrics
}

TextInputContentWidth :: (bounds_width: float, padding_x: i32) -> i32 #export {
    width: i32 = (i32)bounds_width - padding_x * 2
    if width < 0 {
        return 0
    }
    return width
}

TextAreaPageRows :: (bounds_height: float, font: i32, line_gap: i32,
    padding_y: i32) -> i32 #export {
    line_height: i32 = font + line_gap
    visible_height: i32 = (i32)bounds_height - padding_y * 2
    if line_height <= 0 || visible_height < line_height {
        return 1
    }
    rows: i32 = visible_height / line_height
    if rows < 1 {
        return 1
    }
    if rows < 2 {
        return 2
    }
    return rows
}

TextAreaWrapWidthFor :: (bounds_width: float, padding_x: i32,
    wrap: bool, min_wrap_width: i32) -> i32 #export {
    if !wrap { return 0 }
    width: i32 = (i32)bounds_width - padding_x * 2
    if width < min_wrap_width { return 0 }
    return width
}

TextAreaPaintFor :: (bounds: Rectangle, font: i32, line_gap: i32,
    padding_x: i32, padding_y: i32, wrap: bool, content_height: i32,
    scroll_y: i32, text_line_height: i32, min_wrap_width: i32) -> TextAreaPaint #export {
    paint: TextAreaPaint
    line_height: i32 = font + line_gap
    paint.viewport_height = (i32)bounds.height - padding_y * 2
    if paint.viewport_height < 0 { paint.viewport_height = 0 }
    paint.max_scroll = content_height - paint.viewport_height
    if paint.max_scroll < 0 { paint.max_scroll = 0 }
    paint.scroll_y = scroll_y
    if paint.scroll_y < 0 { paint.scroll_y = 0 }
    if paint.scroll_y > paint.max_scroll { paint.scroll_y = paint.max_scroll }
    paint.wrap_width = TextAreaWrapWidthFor(bounds.width, padding_x, wrap,
                                            min_wrap_width)
    paint.clip_bounds.x = bounds.x + (float)padding_x
    paint.clip_bounds.y = bounds.y + (float)padding_y
    paint.clip_bounds.width = bounds.width - (float)(padding_x * 2)
    paint.clip_bounds.height = bounds.height - (float)(padding_y * 2)
    if paint.clip_bounds.width < 0.0 { paint.clip_bounds.width = 0.0 }
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.placeholder_x = (i32)bounds.x + padding_x
    paint.placeholder_y = (i32)bounds.y + padding_y +
        (line_height - text_line_height) / 2
    return paint
}

TextInputBufferLimit :: (text_size: i32, max_codepoints: i32) -> i32 #export {
    limit: i32 = text_size - 1
    if max_codepoints > 0 && max_codepoints < limit {
        limit = max_codepoints
    }
    if limit < 0 {
        return 0
    }
    return limit
}

TextFieldScrollFor :: (bounds_x: float, bounds_width: float, padding_x: i32,
    text_width: i32, scroll: i32) -> TextFieldScroll #export {
    result: TextFieldScroll
    result.clip_width = TextInputContentWidth(bounds_width, padding_x)
    result.max_scroll = text_width - result.clip_width
    if result.max_scroll < 0 {
        result.max_scroll = 0
    }
    if scroll < 0 {
        result.scroll = 0
    } else if scroll > result.max_scroll {
        result.scroll = result.max_scroll
    } else {
        result.scroll = scroll
    }
    result.text_origin_x = (i32)bounds_x + padding_x - result.scroll
    return result
}

TextFieldRevealScroll :: (scroll: i32, max_scroll: i32, clip_width: i32,
    cursor_text_x: i32, margin: i32) -> i32 #export {
    if margin < 0 {
        margin = 0
    }
    if cursor_text_x < scroll + margin {
        scroll = cursor_text_x - margin
    }
    if cursor_text_x > scroll + clip_width - margin {
        scroll = cursor_text_x - clip_width + margin
    }
    if scroll < 0 {
        return 0
    }
    if scroll > max_scroll {
        return max_scroll
    }
    return scroll
}

TextFieldCursorHeightFor :: (font: i32, bounds_height: float,
    text_line_height: i32, min_height: i32, vertical_padding: i32) -> i32 #export {
    height: i32 = text_line_height
    max_height: i32 = (i32)bounds_height - vertical_padding
    if height < font { height = font }
    if max_height < min_height { max_height = (i32)bounds_height }
    if height > max_height { height = max_height }
    if height < min_height { height = min_height }
    return height
}

TextFieldPaintFor :: (bounds: Rectangle, padding_x: i32, scroll_x: i32,
    font: i32, text_line_height: i32, min_cursor_height: i32,
    cursor_vertical_padding: i32, clip_guard: i32) -> TextFieldPaint #export {
    paint: TextFieldPaint
    clip_width: i32 = TextInputContentWidth(bounds.width, padding_x)

    paint.clip_bounds.x = bounds.x + (float)padding_x
    paint.clip_bounds.y = bounds.y - (float)clip_guard
    paint.clip_bounds.width = (float)clip_width
    paint.clip_bounds.height = bounds.height + (float)(clip_guard * 2)
    if paint.clip_bounds.height < 0.0 { paint.clip_bounds.height = 0.0 }
    paint.text_x = (i32)bounds.x + padding_x - scroll_x
    paint.cursor_height = TextFieldCursorHeightFor(
        font, bounds.height, text_line_height, min_cursor_height,
        cursor_vertical_padding)
    paint.cursor_y = (i32)bounds.y +
        ((i32)bounds.height - paint.cursor_height) / 2
    return paint
}

TextSelectionRangeFor :: (anchor: i32, cursor: i32) -> TextSelectionRange #export {
    out: TextSelectionRange
    if anchor < cursor {
        out.start = anchor
        out.end = cursor
    } else {
        out.start = cursor
        out.end = anchor
    }
    out.has_selection = out.start != out.end
    return out
}

TextSelectionAfterMove :: (anchor: i32, cursor: i32, target: i32,
    extend: bool) -> TextSelectionState #export {
    out: TextSelectionState
    if extend {
        if anchor == cursor {
            out.anchor = cursor
        } else {
            out.anchor = anchor
        }
        out.cursor = target
    } else {
        out.anchor = target
        out.cursor = target
    }
    out.has_selection = out.anchor != out.cursor
    return out
}

TextSelectionCollapsed :: (cursor: i32) -> TextSelectionState #export {
    out: TextSelectionState
    out.anchor = cursor
    out.cursor = cursor
    out.has_selection = false
    return out
}

TextSelectionAll :: (length: i32) -> TextSelectionState #export {
    out: TextSelectionState
    if length < 0 {
        length = 0
    }
    out.anchor = 0
    out.cursor = length
    out.has_selection = length > 0
    return out
}

TextNavigationDecisionFor :: (key: i32, multiline: bool, shift: bool,
    modifier: bool, secure: bool, has_selection: bool) -> TextNavigationDecision #export {
    decision: TextNavigationDecision
    decision.extend_selection = shift

    if key == TextNavLeft() {
        decision.consumed = true
        if !shift && has_selection {
            decision.collapse_selection_start = true
        } else if modifier && secure {
            decision.document_edge = -1
        } else if modifier {
            decision.word_direction = -1
        } else {
            decision.char_direction = -1
        }
        return decision
    }

    if key == TextNavRight() {
        decision.consumed = true
        if !shift && has_selection {
            decision.collapse_selection_end = true
        } else if modifier && secure {
            decision.document_edge = 1
        } else if modifier {
            decision.word_direction = 1
        } else {
            decision.char_direction = 1
        }
        return decision
    }

    if key == TextNavHome() {
        decision.consumed = true
        if multiline && !modifier {
            decision.line_edge = -1
        } else {
            decision.document_edge = -1
        }
        return decision
    }

    if key == TextNavEnd() {
        decision.consumed = true
        if multiline && !modifier {
            decision.line_edge = 1
        } else {
            decision.document_edge = 1
        }
        return decision
    }

    if key == TextNavUp() && multiline {
        decision.consumed = true
        decision.vertical_direction = -1
        return decision
    }

    if key == TextNavDown() && multiline {
        decision.consumed = true
        decision.vertical_direction = 1
        return decision
    }

    if key == TextNavPageUp() && multiline {
        decision.consumed = true
        decision.page_direction = -1
        return decision
    }

    if key == TextNavPageDown() && multiline {
        decision.consumed = true
        decision.page_direction = 1
        return decision
    }

    return decision
}

TextDeleteDecisionFor :: (action: i32, modifier: bool, secure: bool,
    has_selection: bool) -> TextDeleteDecision #export {
    decision: TextDeleteDecision

    if action == TextDeleteBackspace() {
        decision.consumed = true
        if has_selection {
            return decision
        }
        if modifier && secure {
            decision.document_edge = -1
        } else if modifier {
            decision.word_direction = -1
        } else {
            decision.char_direction = -1
        }
        return decision
    }

    if action == TextDeleteForward() {
        decision.consumed = true
        if has_selection {
            return decision
        }
        if modifier && secure {
            decision.document_edge = 1
        } else if modifier {
            decision.word_direction = 1
        } else {
            decision.char_direction = 1
        }
        return decision
    }

    return decision
}

TextInsertDecisionFor :: (codepoint: i32, encoded_len: i32,
    text_len: i32, text_size: i32, current_codepoints: i32,
    inserted_codepoints: i32, max_codepoints: i32,
    allow_newlines: bool) -> TextInsertDecision #export {
    decision: TextInsertDecision

    if codepoint == 13 {
        decision.skip = true
        return decision
    }

    if codepoint == 10 && !allow_newlines {
        decision.skip = true
        return decision
    }

    if codepoint < 32 && codepoint != 10 {
        decision.skip = true
        return decision
    }

    if encoded_len <= 0 {
        decision.skip = true
        return decision
    }

    if text_size <= 0 || text_len + encoded_len + 1 > text_size {
        decision.stop = true
        return decision
    }

    if max_codepoints > 0 &&
       current_codepoints + inserted_codepoints >= max_codepoints {
        decision.stop = true
        return decision
    }

    decision.accept = true
    return decision
}
