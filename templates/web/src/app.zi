Button :: #import "kryon/button";
Link :: #import "kryon/link";
Text :: #import "kryon/text";
using Layout :: #import "layout";
#import "kryon/control_props"
#import "kryon/geometry"
#import "kryon/semantic"
#import "kryon/session"
#import "std/number_text"
// {{name}}: a web page written with Kryon, drawn on a Canvas2D element:
// headings, paragraphs, links, and buttons declared from your state.
//
//   kryon build          build/{{name}}-web.html (needs Emscripten)
//   kryon run desktop    the same page in a window

likes: s32;
likes_text: [48]u8;

Heading :: (session: Session, text: string, level: s32, bounds: Rectangle, size: s32) {
    Text.Draw(session, Text.Props.{.bounds = bounds, .text = text, .size = size,
        .semantic_kind = SemanticKind.SemanticHeading, .heading_level = level})
}

Paragraph :: (session: Session, text: string, bounds: Rectangle, size: s32) {
    Text.Draw(session, Text.Props.{.bounds = bounds, .text = text, .size = size,
        .semantic_kind = SemanticKind.SemanticParagraph, .wrap = Text.Wrap.TextWrapAuto})
}

WebLink :: (session: Session, text: string, url: string, bounds: Rectangle) {
    unused Link.Draw(session, Link.Props.{.bounds = bounds, .text = text,
        .link = url})
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    page: PageLayout = PageFor(viewport, 640.0)
    Heading(session, "{{name}}", 1, NextRow(*page, 44.0), FontSize(*page, 34))
    Paragraph(session, "This page is a Kryon application. The same Ziran source runs as semantic HTML, on a canvas, and in a desktop window.",
        NextRow(*page, 48.0), FontSize(*page, 17))
    Heading(session, "Why Kryon", 2, NextRow(*page, 30.0), FontSize(*page, 22))
    Paragraph(session, "One interface, declared every frame from your state. No HTML templates and no JavaScript.",
        NextRow(*page, 48.0), FontSize(*page, 17))
    WebLink(session, "Kryon on GitHub", "https://github.com/kryonlabs/kryon",
        NextRow(*page, 24.0))
    WebLink(session, "The Ziran language", "https://github.com/ziranlang/ziran",
        NextRow(*page, 24.0))

    like: Button.Props
    like.id = 7
    like.bounds = RowPart(*page, NextRow(*page, 40.0), 0, 3)
    like.label = "Like"
    like.tone = ButtonTone.ButtonToneAccent
    like.emphasis = ButtonEmphasis.ButtonEmphasisFilled
    if Button.Draw(session, like) == 1 { likes += 1 }
    digits: [16]u8
    Paragraph(session, Joined(FormatInteger(cast(s64)likes, digits[:]), " likes so far",
        likes_text[:]), NextRow(*page, 24.0), FontSize(*page, 16))
    return 0
}
