#module "link"
#import "style"

LinkVisualState :: enum {
    LinkStateNormal = 0
    LinkStateHover = 1
    LinkStateDisabled = 2
}

LinkAppearance :: struct {
    color: u32
    underline: bool
}

ResolveLinkAppearance :: (frame: StyleFrame, hovered: bool,
    disabled: bool) -> LinkAppearance #export {
    state: i32 = LinkStateNormal
    if hovered {
        state = LinkStateHover
    }
    if disabled {
        state = LinkStateDisabled
    }
    appearance: LinkAppearance
    appearance.color = frame.value.foreground
    appearance.underline = state == LinkStateHover
    return appearance
}
