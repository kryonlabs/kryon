#module "text_edit_host"
#import "ui_internal.h"
#import "runtime/text_input.h"
#import "stdlib.h"
#import "string.h"

TextBufferLineAtCursor :: (text: const char*,
cursor: i32) -> i32 #export {
    if text == nil { return 1 }
    line: i32 = 1
    index: i32 = 0
    while text[index] != '\0' && index < cursor {
        if text[index] == '\n' { line += 1 }
        index += 1
    }
    return line
}

TextBufferColumnAtCursor :: (text: const char*,
cursor: i32) -> i32 #export {
    if text == nil { return 1 }
    column: i32 = 1
    index: i32 = 0
    while text[index] != '\0' && index < cursor {
        if text[index] == '\n' {
            column = 1
        } else {
            column += 1
        }
        index += 1
    }
    return column
}

TextBufferLineCount :: (text: const char*) -> i32 #export {
    if text == nil { return 1 }
    lines: i32 = 1
    index: i32 = 0
    while text[index] != '\0' {
        if text[index] == '\n' { lines += 1 }
        index += 1
    }
    return lines
}

TextEditLineStart :: (text: const char*,
cursor: i32) -> i32 {
    if text == nil { return 0 }
    start: i32 = TextBufferLineStartCursor(cursor)
    while start > 0 && text[start - 1] != '\n' {
        start -= 1
    }
    return start
}

TextEditBufferInsert :: (text: *char, text_size: i32,
at: i32, bytes: const char*, length: i32) -> i32 {
    if text == nil || bytes == nil || text_size <= 0 ||
    length <= 0 { return 0 }
    used: i32 = (int)strlen(text)
    decision: TextBufferInsertDecision =
    TextBufferInsertDecisionFor(text_size, used, at, length)
    if !decision.can_insert { return 0 }
    memmove(text + at + length, text + at,
    (size_t)decision.tail_count)
    memcpy(text + at, bytes, (size_t)length)
    return 1
}

TextEditBufferDelete :: (text: *char, at: i32,
length: i32) -> i32 {
    if text == nil || length <= 0 { return 0 }
    used: i32 = (int)strlen(text)
    decision: TextBufferDeleteDecision =
    TextBufferDeleteDecisionFor(used, at, length)
    if !decision.can_delete { return 0 }
    memmove(text + at, text + at + length,
    (size_t)decision.tail_count)
    return 1
}

TextBufferToggleLineComment :: (text: *char,
text_size: i32, cursor: *i32) -> i32 #export {
    if text == nil || cursor == nil { return 0 }
    start: i32 = TextEditLineStart(text, *cursor)
    position: i32 = start
    while text[position] == ' ' || text[position] == '\t' {
        position += 1
    }
    if text[position] == '/' && text[position + 1] == '/' {
        if !TextEditBufferDelete(text, position, 2) { return 0 }
        *cursor = TextBufferCursorAfterDelete(*cursor,
        position, 2)
        return 1
    }
    if !TextEditBufferInsert(text, text_size, position,
    "//", 2) { return 0 }
    *cursor = TextBufferCursorAfterInsert(*cursor, position, 2)
    return 1
}

TextBufferIndentLine :: (text: *char, text_size: i32,
cursor: *i32, outdent: i32) -> i32 #export {
    if text == nil || cursor == nil { return 0 }
    start: i32 = TextEditLineStart(text, *cursor)
    if outdent {
        remove: i32 = 0
        while remove < 4 && text[start + remove] == ' ' {
            remove += 1
        }
        if remove == 0 && text[start] == '\t' { remove = 1 }
        if remove == 0 { return 0 }
        if !TextEditBufferDelete(text, start, remove) { return 0 }
        *cursor = TextBufferCursorAfterDelete(*cursor,
        start, remove)
        return 1
    }
    if !TextEditBufferInsert(text, text_size, start,
    "    ", 4) { return 0 }
    *cursor = TextBufferCursorAfterInsert(*cursor, start, 4)
    return 1
}

TextBufferBracketMatch :: (text: const char*,
cursor: i32) -> i32 #export {
    if text == nil { return -1 }
    length: i32 = (int)strlen(text)
    if length <= 0 { return -1 }
    opens: const char* = "([{"
    closes: const char* = ")]}"
    position: i32 = TextBufferBracketCursorFor(cursor, length)
    position = TextBufferBracketCandidatePos(position,
    strchr(opens, text[position]) != nil ||
    strchr(closes, text[position]) != nil)
    decision: TextBufferBracketDecision =
    TextBufferBracketDecisionFor(position,
    (unsigned char)text[position])
    if !decision.valid { return -1 }
    open: char = (char)decision.open
    close: char = (char)decision.close
    direction: i32 = decision.direction
    depth: i32 = 0
    index: i32 = position
    while index >= 0 && index < length {
        if text[index] == open {
            depth += direction > 0 ? 1 : -1
        } else if text[index] == close {
            depth += direction > 0 ? -1 : 1
        }
        if depth == 0 && index != position { return index }
        index += direction
    }
    return -1
}

ui_utf8_next_offset :: (text: const char*, offset: i32) -> i32 #export {
    if text == nil { return 0 }
    length: i32 = (int)strlen(text)
    if offset < 0 { offset = 0 }
    if offset >= length { return length }
    codepoint_size: i32 = 0
    GetCodepointNext(text + offset, &codepoint_size)
    if codepoint_size <= 0 { codepoint_size = 1 }
    if offset + codepoint_size > length { return length }
    return offset + codepoint_size
}

ui_utf8_prev_offset :: (text: const char*, offset: i32) -> i32 #export {
    if text == nil { return 0 }
    length: i32 = (int)strlen(text)
    if offset > length { offset = length }
    if offset <= 0 { return 0 }
    offset -= 1
    while offset > 0 &&
    ((unsigned char)text[offset] & 0xc0) == 0x80 {
        offset -= 1
    }
    return offset
}

TextEditUTF8Clamp :: (text: const char*, offset: i32) -> i32 {
    if text == nil { return 0 }
    length: i32 = (int)strlen(text)
    offset = TextCursorForLength(offset, length)
    while offset > 0 && offset < length &&
    ((unsigned char)text[offset] & 0xc0) == 0x80 {
        offset -= 1
    }
    return offset
}

ui_text_composition_view :: (text: const char*,
selection_start: i32, selection_end: i32,
preedit: const char*, preedit_cursor: i32,
preedit_selection_length: i32,
view: *TextCompositionView) -> i32 #export {
    if view == nil { return 0 }
    memset(view, 0, sizeof(*view))
    if text == nil { text = "" }
    if preedit == nil || preedit[0] == '\0' { return 0 }
    text_length: i32 = (int)strlen(text)
    preedit_length: i32 = (int)strlen(preedit)
    start: i32 = ui_grapheme_floor_offset(text, selection_start)
    end: i32 = ui_grapheme_floor_offset(text, selection_end)
    if start > end {
        swap: i32 = start
        start = end
        end = swap
    }
    cursor: i32 = TextEditUTF8Clamp(preedit, preedit_cursor)
    preedit_selection_length = TextCompositionSelectionLength(
    preedit_length, cursor, preedit_selection_length)
    selected_end: i32 = TextEditUTF8Clamp(
    preedit, cursor + preedit_selection_length)
    range: TextCompositionViewRange = TextCompositionViewRangeFor(
    start, end, preedit_length, cursor, selected_end)
    view_length: size_t = (size_t)text_length -
    (size_t)(end - start) + (size_t)preedit_length
    view->text = (char*)malloc(view_length + 1)
    if view->text == nil { return 0 }
    memcpy(view->text, text, (size_t)range.replace_start)
    memcpy(view->text + range.replace_start,
    preedit, (size_t)preedit_length)
    memcpy(view->text + range.replace_start + preedit_length,
    text + range.replace_end,
    (size_t)(text_length - range.replace_end + 1))
    view->cursor = range.cursor
    view->selection_start = range.selection_start
    view->selection_end = range.selection_end
    view->composition_start = range.composition_start
    view->composition_end = range.composition_end
    return 1
}

ui_text_composition_view_free :: (view: *TextCompositionView) #export {
    if view == nil { return }
    free(view->text)
    memset(view, 0, sizeof(*view))
}

TextEditCodepointAt :: (text: const char*, offset: i32) -> i32 {
    if text == nil || offset < 0 || text[offset] == '\0' { return 0 }
    codepoint_size: i32 = 0
    return GetCodepointNext(text + offset, &codepoint_size)
}

TextEditWordBoundary :: (text: const char*, offset: i32) -> i32 {
    if text == nil || offset <= 0 { return 0 }
    previous_offset: i32 = ui_utf8_prev_offset(text, offset)
    previous: i32 = TextEditCodepointAt(text, previous_offset)
    current: i32 = TextEditCodepointAt(text, offset)
    return TextWordBoundaryFor(previous, current)
}

ui_text_word_left :: (text: const char*, cursor: i32) -> i32 #export {
    if text == nil { return 0 }
    cursor = TextCursorForLength(cursor, (int)strlen(text))
    cursor = ui_grapheme_prev_offset(text, cursor)
    while cursor > 0 && !TextEditWordBoundary(text, cursor) {
        cursor = ui_grapheme_prev_offset(text, cursor)
    }
    return cursor
}

ui_text_word_right :: (text: const char*, cursor: i32) -> i32 #export {
    if text == nil { return 0 }
    length: i32 = (int)strlen(text)
    cursor = TextCursorForLength(cursor, length)
    cursor = ui_grapheme_next_offset(text, cursor)
    while cursor < length && !TextEditWordBoundary(text, cursor) {
        cursor = ui_grapheme_next_offset(text, cursor)
    }
    return cursor
}

ui_utf8_codepoint_count :: (text: const char*) -> i32 #export {
    if text == nil { return 0 }
    count: i32 = 0
    offset: i32 = 0
    while text[offset] != '\0' {
        next: i32 = ui_utf8_next_offset(text, offset)
        if next <= offset { break }
        count += 1
        offset = next
    }
    return count
}

ui_utf8_encode :: (codepoint: i32, out: *char) -> i32 #export {
    if out == nil { return 0 }
    if codepoint < 0x80 {
        out[0] = (char)codepoint
        out[1] = '\0'
        return 1
    }
    if codepoint < 0x800 {
        out[0] = (char)(0xc0 | (codepoint >> 6))
        out[1] = (char)(0x80 | (codepoint & 0x3f))
        out[2] = '\0'
        return 2
    }
    if codepoint < 0x10000 {
        out[0] = (char)(0xe0 | (codepoint >> 12))
        out[1] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        out[2] = (char)(0x80 | (codepoint & 0x3f))
        out[3] = '\0'
        return 3
    }
    if codepoint <= 0x10ffff {
        out[0] = (char)(0xf0 | (codepoint >> 18))
        out[1] = (char)(0x80 | ((codepoint >> 12) & 0x3f))
        out[2] = (char)(0x80 | ((codepoint >> 6) & 0x3f))
        out[3] = (char)(0x80 | (codepoint & 0x3f))
        out[4] = '\0'
        return 4
    }
    return 0
}

ui_text_delete_range :: (text: *char, text_size: size_t,
cursor: *i32, start: i32, end: i32) -> i32 #export {
    if text == nil || text_size == 0 || cursor == nil { return 0 }
    length: i32 = (int)strlen(text)
    decision: TextBufferDeleteRangeDecision =
    TextBufferDeleteRangeDecisionFor(length, start, end)
    if !decision.can_delete { return 0 }
    memmove(text + decision.start, text + decision.end,
    (size_t)decision.tail_count)
    *cursor = decision.cursor
    return 1
}

ui_text_delete_key :: (text: *char, text_size: size_t,
anchor: *i32, cursor: *i32, action: i32, modifier: i32,
secure: i32) -> i32 #export {
    if text == nil || anchor == nil || cursor == nil { return 0 }
    *anchor = ui_grapheme_floor_offset(text, *anchor)
    *cursor = ui_grapheme_floor_offset(text, *cursor)
    range: TextSelectionRange = TextSelectionRangeFor(*anchor, *cursor)
    start: i32 = range.start
    end: i32 = range.end
    decision: TextDeleteDecision = TextDeleteDecisionFor(
    action, modifier != 0, secure != 0, start != end)
    if !decision.consumed { return 0 }
    if start == end {
        if decision.document_edge < 0 {
            start = 0
        } else if decision.document_edge > 0 {
            end = (int)strlen(text)
        } else if decision.word_direction < 0 {
            start = ui_text_word_left(text, *cursor)
        } else if decision.word_direction > 0 {
            end = ui_text_word_right(text, *cursor)
        } else if decision.char_direction < 0 {
            start = ui_grapheme_prev_offset(text, *cursor)
        } else if decision.char_direction > 0 {
            end = ui_grapheme_next_offset(text, *cursor)
        }
    }
    if !ui_text_delete_range(text, text_size, cursor, start, end) {
        return 0
    }
    collapsed: TextSelectionState = TextSelectionCollapsed(*cursor)
    *anchor = collapsed.anchor
    *cursor = collapsed.cursor
    return 1
}

TextEditInsertByte :: (text: *char, text_size: size_t,
cursor: *i32, value: char, max_codepoints: i32,
allow_newlines: i32) -> i32 {
    if text == nil || text_size == 0 || cursor == nil ||
    value == '\0' {
        return 0
    }
    length: i32 = (int)strlen(text)
    codepoint_count: i32 = ui_utf8_codepoint_count(text)
    *cursor = TextCursorForLength(*cursor, length)
    decision: TextInsertDecision = TextInsertDecisionFor(
    (unsigned char)value, 1, length, (int)text_size,
    codepoint_count, 0, max_codepoints, allow_newlines)
    if !decision.accept { return 0 }
    buffer_decision: TextBufferInsertDecision =
    TextBufferInsertDecisionFor((int)text_size,
    length, *cursor, 1)
    if !buffer_decision.can_insert { return 0 }
    memmove(text + *cursor + 1, text + *cursor,
    (size_t)buffer_decision.tail_count)
    text[*cursor] = value
    *cursor += 1
    return 1
}

ui_text_insert_ascii :: (text: *char, text_size: size_t,
cursor: *i32, value: char, max_codepoints: i32) -> i32 #export {
    return TextEditInsertByte(text, text_size, cursor,
    value, max_codepoints, 0)
}

ui_text_insert_newline :: (text: *char, text_size: size_t,
cursor: *i32, max_codepoints: i32) -> i32 #export {
    return TextEditInsertByte(text, text_size, cursor,
    '\n', max_codepoints, 1)
}

ui_text_insert_codepoint :: (text: *char, text_size: size_t,
cursor: *i32, codepoint: i32, max_codepoints: i32) -> i32 #export {
    if text == nil || text_size == 0 || cursor == nil { return 0 }
    encoded: [5]char
    encoded_length: i32 = ui_utf8_encode(codepoint, encoded)
    length: i32 = (int)strlen(text)
    codepoint_count: i32 = ui_utf8_codepoint_count(text)
    *cursor = TextCursorForLength(*cursor, length)
    decision: TextInsertDecision = TextInsertDecisionFor(
    codepoint, encoded_length, length, (int)text_size,
    codepoint_count, 0, max_codepoints, 0)
    if !decision.accept { return 0 }
    buffer_decision: TextBufferInsertDecision =
    TextBufferInsertDecisionFor((int)text_size,
    length, *cursor, encoded_length)
    if !buffer_decision.can_insert { return 0 }
    memmove(text + *cursor + encoded_length, text + *cursor,
    (size_t)buffer_decision.tail_count)
    memcpy(text + *cursor, encoded, (size_t)encoded_length)
    *cursor += encoded_length
    return 1
}

ui_text_insert_text :: (text: *char, text_size: size_t,
cursor: *i32, input: const char*, allow_newlines: i32,
filter: TextInputFilter, filter_user_data: *void,
max_codepoints: i32) -> i32 #export {
    if text == nil || text_size == 0 || cursor == nil ||
    input == nil || input[0] == '\0' {
        return 0
    }
    length: i32 = (int)strlen(text)
    if (size_t)length >= text_size { return 0 }
    *cursor = TextCursorForLength(*cursor, length)
    current_codepoints: i32 = ui_utf8_codepoint_count(text)
    initial: TextInsertDecision = TextInsertDecisionFor(
    ' ', 1, length, (int)text_size, current_codepoints,
    0, max_codepoints, allow_newlines != 0)
    if initial.stop { return 0 }
    remaining_bytes: size_t = text_size - (size_t)length - 1
    insert: *char = (char*)malloc(remaining_bytes + 1)
    if insert == nil { return 0 }
    out_length: i32 = 0
    inserted_codepoints: i32 = 0
    index: i32 = 0
    while input[index] != '\0' && remaining_bytes > 0 {
        if input[index] == '\n' {
            decision: TextInsertDecision = TextInsertDecisionFor(
            '\n', 1, length + out_length, (int)text_size,
            current_codepoints, inserted_codepoints,
            max_codepoints, allow_newlines != 0)
            index += 1
            if decision.stop { break }
            if decision.accept {
                insert[out_length] = '\n'
                out_length += 1
                remaining_bytes -= 1
                inserted_codepoints += 1
            }
            continue
        }
        bytes: i32 = 0
        codepoint: i32 = GetCodepointNext(
        input + index, &bytes)
        if bytes <= 0 { break }
        index += bytes
        if filter != nil &&
        !filter(codepoint, filter_user_data) {
            continue
        }
        encoded: [5]char
        encoded_length: i32 = ui_utf8_encode(codepoint, encoded)
        decision: TextInsertDecision = TextInsertDecisionFor(
        codepoint, encoded_length, length + out_length,
        (int)text_size, current_codepoints,
        inserted_codepoints, max_codepoints,
        allow_newlines != 0)
        if decision.stop { break }
        if decision.skip { continue }
        if (size_t)encoded_length > remaining_bytes { break }
        memcpy(insert + out_length, encoded, (size_t)encoded_length)
        out_length += encoded_length
        remaining_bytes -= (size_t)encoded_length
        inserted_codepoints += 1
    }
    if out_length <= 0 {
        free(insert)
        return 0
    }
    buffer_decision: TextBufferInsertDecision =
    TextBufferInsertDecisionFor((int)text_size,
    length, *cursor, out_length)
    if !buffer_decision.can_insert {
        free(insert)
        return 0
    }
    memmove(text + *cursor + out_length, text + *cursor,
    (size_t)buffer_decision.tail_count)
    memcpy(text + *cursor, insert, (size_t)out_length)
    *cursor += out_length
    free(insert)
    return 1
}
