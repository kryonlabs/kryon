#import "component_protocol"
#import "kryon/button_widget"
#import "kryon/button_props"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/geometry"
#import "std/vec"

ComponentLabel :: struct { text: string }
ComponentOwned :: struct { label: ComponentLabel; samples: [2]s64 }
component_owned: ComponentOwned = ComponentOwned.{
    .label = ComponentLabel.{.text = "A"}
};

component_schema_version: s64 = 1;
component_count: s64 = 7;
component_label_kind: s64 = 0;

Label :: () -> string {
    value: Vec(u8)
    label := component_owned.label.text
    BuilderPrint(*value, "% %", label, component_count)
    return BuilderFinish(value)
}

#program_export
Frame :: () -> s64 {
    if component_schema_version < 1 { return 1 }
    session := ComponentSession()
    bounds := ComponentBounds()
    action := Button(session, ButtonProps.{
        .key = 101, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 16.0, 96.0, 36.0
        }, .label = "Increment"
    })
    if action != 0 { component_count += 1; component_owned.samples[0] += 1; component_owned.samples[1] = component_count }
    Text(session, TextProps.{
        .key = 102, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 64.0, 180.0, 28.0
        }, .text = Label(), .font = Text18
    })
    if component_count != 7 && component_owned.samples[1] != component_count { return 1 }
    return 0
}
