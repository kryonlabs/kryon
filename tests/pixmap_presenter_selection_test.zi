Presenter :: #import "pixmap_sdl";
#import "std/c_string"

preferred: [32]u8;
calls: [8]u32;
creates: s32;
destroys: s32;
alive: s32;
software_fails: bool;
accelerated_fails: bool;
explicit: bool;
forced: bool;

#program_export "SDL_GetHint"
Hint :: (name: *u8) -> *u8 {
    return ifx explicit then *preferred[0] else null
}
#program_export "SDL_getenv"
Env :: (name: *u8) -> *u8 {
    return ifx forced then *preferred[0] else null
}
#program_export "SDL_SetHintWithPriority"
SetHint :: (name: *u8, value: *u8, priority: s32) -> s32 { return 1 }
#program_export "SDL_CreateRenderer"
Create :: (window: *void, index: s32, flags: u32) -> *void {
    if creates >= 8 || index != -1 || window != cast(*void)16 { return null }
    calls[creates] = flags
    creates += 1
    if (flags == 1 && software_fails) ||
        (flags == 2 && accelerated_fails) { return null }
    if alive != 0 { return null }
    alive += 1
    return cast(*void)cast(s64)(32 + creates)
}
#program_export "SDL_DestroyRenderer"
Destroy :: (renderer: *void) {
    destroys += 1
    alive -= 1
}

Reset :: () {
    creates = 0
    destroys = 0
    alive = 0
    software_fails = false
    accelerated_fails = false
    explicit = false
    forced = false
    unused CopyCString("opengl", preferred[:])
}

#program_export "main"
main :: () -> s32 {
    Reset()
    if Presenter.CreatePixmapRenderer(null) != null || creates != 0 { return 1 }

    result := Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 1 || alive != 1 { return 2 }

    Reset()
    explicit = true
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 0 { return 3 }

    Reset()
    explicit = true
    unused CopyCString("software", preferred[:])
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 0 { return 4 }

    Reset()
    forced = true
    unused CopyCString("1", preferred[:])
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 2 { return 5 }

    Reset()
    explicit = true
    unused CopyCString("", preferred[:])
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 1 { return 6 }

    Reset()
    software_fails = true
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 2 || calls[0] != 1 ||
        calls[1] != 2 || alive != 1 { return 7 }

    Reset()
    accelerated_fails = true
    result = Presenter.CreatePixmapRenderer(cast(*void)16)
    if result == null || creates != 1 || calls[0] != 1 || alive != 1 { return 8 }

    Reset()
    software_fails = true
    accelerated_fails = true
    if Presenter.CreatePixmapRenderer(cast(*void)16) != null ||
        creates != 2 || calls[0] != 1 || calls[1] != 2 || alive != 0 {
        return 9
    }

    print("Presenter selection: explicit authority, software default, GPU opt-in and fallback passed\n")
    return 0
}
