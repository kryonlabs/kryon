#module "toast_props"
#import "geometry"

ToastState :: struct {
    message: string
    class_name: i32
    until_seconds: double
}

ToastProps :: struct {
    key: u64
    viewport: Rectangle
    state: ToastState
    message: string
    class_name: i32
    seconds: double
    now_seconds: double
    scale: float
    clear: bool
}

ToastResult :: struct {
    state: ToastState
    visible: bool
    node: i32
    bounds: Rectangle
    display: string
    ellipsis: bool
}
