#module "collapsible"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "focus"
#import "collapsible_props"
#import "style"

CollapsibleMarkerKind :: enum {
    CollapsibleMarkerClosed = 0
    CollapsibleMarkerOpen = 1
    CollapsibleMarkerLeaf = 2
}

CollapsibleMetrics :: struct {
    header_height: i32
    depth_indent: i32
    close_width: i32
    icon_offset: i32
    text_offset: i32
}

CollapsibleLayout :: struct {
    header: Rectangle
    body: Rectangle
    close_bounds: Rectangle
    has_close: bool
}

CollapsiblePointerDecision :: struct {
    mark_clickable: bool
    focus: bool
    toggle_open: bool
    consume_release: bool
    changed: bool
}

CollapsibleCloseDecision :: struct {
    hide: bool
    changed: bool
}

CollapsibleKeyboardDecision :: struct {
    move_focus: bool
    focus_key: i32
    set_open: bool
    open: bool
    toggle_open: bool
    handled: bool
}

CollapsibleOpenResult :: struct {
    open: bool
    changed: bool
}

CollapsibleKeyNone :: () -> i32 #export {
    return 0
}

CollapsibleKeyLeft :: () -> i32 #export {
    return 1
}

CollapsibleKeyRight :: () -> i32 #export {
    return 2
}

CollapsibleKeyUp :: () -> i32 #export {
    return 3
}

CollapsibleKeyDown :: () -> i32 #export {
    return 4
}

CollapsibleHeaderRole :: () -> i32 #export {
    return 13
}

CollapsibleTreeHeaderRole :: () -> i32 #export {
    return 14
}

CollapsibleCloseRole :: () -> i32 #export {
    return 15
}

CollapsibleHeaderRoleFor :: (tree: bool) -> i32 #export {
    if tree { return CollapsibleTreeHeaderRole() }
    return CollapsibleHeaderRole()
}

CollapsibleMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float) -> float {
    if (fields & field) == (u32)0 || value < 0.0 { value = fallback }
    return value * scale
}

CollapsibleMetricsFor :: (scale: float, header: StyleFrame,
    tree_header: StyleFrame, close: StyleFrame) -> CollapsibleMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: CollapsibleMetrics
    font_size: float = CollapsibleMetric(header.value.fields,
        (u32)StyleFontSize, header.value.font_size, 16.0, scale)
    header_padding_y: float = CollapsibleMetric(header.value.fields,
        (u32)StylePaddingY, header.value.padding_y, 8.0, scale)
    metrics.header_height = (i32)(font_size + header_padding_y * 2.0)
    metrics.depth_indent = (i32)CollapsibleMetric(tree_header.value.fields,
        (u32)StylePaddingX, tree_header.value.padding_x, 20.0, scale)
    metrics.close_width = (i32)CollapsibleMetric(close.value.fields,
        (u32)StyleIconSize, close.value.icon_size, 28.0, scale)
    icon_offset: float = CollapsibleMetric(header.value.fields,
        (u32)StylePaddingX, header.value.padding_x, 8.0, scale)
    metrics.icon_offset = (i32)icon_offset
    icon_size: float = CollapsibleMetric(header.value.fields,
        (u32)StyleIconSize, header.value.icon_size, 20.0, scale)
    metrics.text_offset = (i32)(icon_offset + icon_size)
    return metrics
}

CollapsibleMarkerFor :: (open: bool, leaf: bool) -> i32 #export {
    if leaf { return CollapsibleMarkerLeaf }
    if open { return CollapsibleMarkerOpen }
    return CollapsibleMarkerClosed
}

CollapsibleMarkerText :: (marker: i32) -> string #export {
    if marker == CollapsibleMarkerLeaf { return "•" }
    if marker == CollapsibleMarkerOpen { return "v" }
    return ">"
}

CollapsibleLayoutFor :: (bounds: Rectangle, tree: bool, depth: i32,
    has_close: bool, metrics: CollapsibleMetrics) -> CollapsibleLayout #export {
    layout: CollapsibleLayout
    header: Rectangle = bounds
    header.height = (float)metrics.header_height
    if tree && depth > 0 {
        indent: float = (float)(depth * metrics.depth_indent)
        if indent > header.width { indent = header.width }
        header.x += indent
        header.width -= indent
    }
    layout.header = header
    layout.body = header
    layout.has_close = has_close
    if has_close {
        close_width: float = (float)metrics.close_width
        if close_width > header.width { close_width = header.width }
        layout.close_bounds.x = header.x + header.width - close_width
        layout.close_bounds.y = header.y
        layout.close_bounds.width = close_width
        layout.close_bounds.height = header.height
        layout.body.width = header.width - close_width
        if layout.body.width < 0.0 { layout.body.width = 0.0 }
    }
    return layout
}

CollapsiblePointerDecisionFor :: (enabled: bool, closed: bool, hot_body: bool,
    released: bool, leaf: bool, has_open: bool) -> CollapsiblePointerDecision #export {
    decision: CollapsiblePointerDecision
    if !enabled || closed || !hot_body {
        return decision
    }
    decision.mark_clickable = true
    if !released {
        return decision
    }
    decision.focus = true
    decision.consume_release = true
    decision.toggle_open = !leaf && has_open
    decision.changed = decision.toggle_open
    return decision
}

CollapsibleCloseDecisionFor :: (enabled: bool, has_visible: bool,
    clicked: bool) -> CollapsibleCloseDecision #export {
    decision: CollapsibleCloseDecision
    decision.hide = enabled && has_visible && clicked
    decision.changed = decision.hide
    return decision
}

CollapsibleKeyFor :: (down: bool, up: bool, right: bool,
    left: bool) -> i32 #export {
    if down {
        return CollapsibleKeyDown()
    }
    if up {
        return CollapsibleKeyUp()
    }
    if right {
        return CollapsibleKeyRight()
    }
    if left {
        return CollapsibleKeyLeft()
    }
    return CollapsibleKeyNone()
}

CollapsibleKeyboardDecisionFor :: (focused: bool, focus_captured: bool,
    key_already_handled: bool, tree: bool, key: i32, open: bool, leaf: bool,
    has_open: bool, activate: bool) -> CollapsibleKeyboardDecision #export {
    decision: CollapsibleKeyboardDecision
    if !focused || focus_captured || key_already_handled {
        return decision
    }
    if tree && (key == CollapsibleKeyDown() || key == CollapsibleKeyUp() ||
       (key == CollapsibleKeyRight() && open && !leaf) ||
       (key == CollapsibleKeyLeft() && (!open || leaf))) {
        decision.move_focus = true
        decision.focus_key = key
        decision.handled = true
        return decision
    }
    if !leaf && has_open {
        if key == CollapsibleKeyRight() {
            decision.set_open = true
            decision.open = true
        }
        if key == CollapsibleKeyLeft() {
            decision.set_open = true
            decision.open = false
        }
        if activate {
            decision.toggle_open = true
        }
        decision.handled = key != CollapsibleKeyNone() || activate
    }
    return decision
}

CollapsibleOpenApply :: (open: bool, toggle_open: bool, set_open: bool,
    next_open: bool, has_open: bool) -> CollapsibleOpenResult #export {
    result: CollapsibleOpenResult
    result.open = open
    result.changed = false
    if !has_open {
        return result
    }
    if set_open {
        result.open = next_open
    }
    if toggle_open {
        result.open = !result.open
    }
    result.changed = result.open != open
    return result
}

CollapsibleFocusTarget :: (headers: []CollapsibleHeader,
    current_id: i32, key: i32) -> i32 #export {
    current: i32 = -1
    index: i32 = 0
    while index < headers.length {
        if headers[index].id == current_id {
            current = index
            break
        }
        index += 1
    }
    if current < 0 { return current_id }
    depth: i32 = headers[current].depth
    if depth < 0 { depth = 0 }
    scan: TreeFocusScan = TreeFocusBegin(current, headers.length,
        depth, key == CollapsibleKeyDown(),
        key == CollapsibleKeyUp(), key == CollapsibleKeyRight(),
        key == CollapsibleKeyLeft())
    while !scan.done {
        candidate_depth: i32 = headers[scan.index].depth
        if candidate_depth < 0 { candidate_depth = 0 }
        scan = TreeFocusAdvance(scan, candidate_depth)
    }
    return headers[scan.index].id
}
