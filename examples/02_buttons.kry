#import "kryon.h"

app "Magnetic Lightfield" {
    size 1536 1024
    fps 60
    font examples
}

state {
    menu_open: [4] int
    split_open: [4] int
}

ButtonsExample :: (viewport: Rectangle) #ui {
    chrome := ThemeDefaultDark()
    ClearBackground(chrome.colors.background)
    if viewport.width >= 1536 {
        previous_mode := GetThemeMode()
        left: Rectangle = {0, 0, 768, 1024}
        right: Rectangle = {768, 0, 768, 1024}
        SetThemeMode(THEME_MODE_DARK)
        ButtonsPanel(left, 0, 0, 0, false)
        SetThemeMode(THEME_MODE_LIGHT)
        ButtonsPanel(right, 768, 10000, 2, false)
        SetThemeMode(previous_mode)
        LightfieldHeader()
        Text((TextProps){.bounds={29, 11, 250, 30}, .text="KRYON",
            .font=26, .letter_spacing=25, .color=chrome.colors.text, .wrap=TextWrapNone})
        Text((TextProps){.bounds={28, 38, 300, 20}, .text="DESIGN SYSTEM 2040",
            .font=13, .letter_spacing=6, .color=chrome.colors.icon, .wrap=TextWrapNone})
        Text((TextProps){.bounds={321, 5, 900, 38}, .text="PROPOSAL 4 — MAGNETIC LIGHTFIELD",
            .font=37, .typeface="semibold", .letter_spacing=2, .align=TextAlignCenter,
            .color=chrome.colors.text, .wrap=TextWrapNone})
        Text((TextProps){.bounds={415, 43, 700, 22}, .text="LIVING INTERFACES. QUIETER POWER.",
            .font=15, .letter_spacing=6, .align=TextAlignCenter,
            .color=chrome.colors.icon, .wrap=TextWrapNone})
        Text((TextProps){.bounds={1335, 17, 200, 20}, .text="A MORE",
            .font=13, .letter_spacing=5, .color=chrome.colors.icon, .wrap=TextWrapNone})
        Text((TextProps){.bounds={1335, 33, 200, 20}, .text="HUMAN TOMORROW —",
            .font=13, .letter_spacing=5, .color=chrome.colors.icon, .wrap=TextWrapNone})
    } else {
        ButtonsPanel(viewport, 0, 0, 0, true)
    }
}

HeaderLight :: (x: i32) -> float {
    amount: float = ((float)x - 384.0) / 1151.0
    if amount < 0.0 { amount = 0.0 }
    return amount * amount * (3.0 - 2.0 * amount)
}

HeaderChannel :: (base: float, gain: float, amount: float) -> u8 {
    return (u8)(base + gain * amount)
}

LightfieldHeader :: () #private {
    # The light gathers toward the right side of the shared header. Each
    # column uses the same portable Surface gradient as the widget faces.
    for int x = 0; x < 1536; x++ {
        amount := HeaderLight(x)
        top: Color = {HeaderChannel(0, 18, amount), HeaderChannel(25, 33, amount), HeaderChannel(54, 47, amount), 255}
        bottom: Color = {HeaderChannel(0, 12, amount), HeaderChannel(24, 25, amount), HeaderChannel(52, 37, amount), 255}
        Surface((Rectangle){x, 0, 1, 74},
            (Style){.fields=StyleBackground | StyleBackgroundEnd | StyleRadius,
                .background=top, .background_end=bottom, .radius=0})
    }
}

ButtonsPanel :: (viewport: Rectangle, origin: int, id_base: int, state_base: int, theme_switch: bool) #private {
