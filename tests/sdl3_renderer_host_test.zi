// Real SDL3 integration; run only through the private-display shell harness.
Presenter :: #import "pixmap_sdl3";
Sink :: #import "pixmap_sdl3_gpu";
Pixels :: #import "pixmap";
#import, file "backend_comparison_scene.zi";
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/environment_linux"

sdl3 :: #system_library "SDL3";
Init :: (flags: u32) -> bool #foreign sdl3 "SDL_Init";
Quit :: () #foreign sdl3 "SDL_Quit";
Error :: () -> *u8 #foreign sdl3 "SDL_GetError";
CreateWindow :: (title: *u8, width: s32, height: s32, flags: u64) -> *void #foreign sdl3 "SDL_CreateWindow";
DestroyWindow :: (window: *void) #foreign sdl3 "SDL_DestroyWindow";
DestroyRenderer :: (renderer: *void) #foreign sdl3 "SDL_DestroyRenderer";
CreateRenderer :: (window: *void, name: *u8) -> *void #foreign sdl3 "SDL_CreateRenderer";
DestroyTexture :: (texture: *void) #foreign sdl3 "SDL_DestroyTexture";
SetTarget :: (renderer: *void, texture: *void) -> bool #foreign sdl3 "SDL_SetRenderTarget";
SetColor :: (renderer: *void, red: u8, green: u8, blue: u8, alpha: u8) -> bool #foreign sdl3 "SDL_SetRenderDrawColor";
Clear :: (renderer: *void) -> bool #foreign sdl3 "SDL_RenderClear";
Present :: (renderer: *void) -> bool #foreign sdl3 "SDL_RenderPresent";
RenderTexture :: (renderer: *void, texture: *void, source: *void, destination: *void) -> bool #foreign sdl3 "SDL_RenderTexture";
Read :: (renderer: *void, rectangle: *void) -> *Surface #foreign sdl3 "SDL_RenderReadPixels";
Convert :: (surface: *Surface, format: u32) -> *Surface #foreign sdl3 "SDL_ConvertSurface";
DestroySurface :: (surface: *Surface) #foreign sdl3 "SDL_DestroySurface";
Resize :: (window: *void, width: s32, height: s32) -> bool #foreign sdl3 "SDL_SetWindowSize";
OutputSize :: (renderer: *void, width: *s32, height: *s32) -> bool #foreign sdl3 "SDL_GetRenderOutputSize";
Pump :: () #foreign sdl3 "SDL_PumpEvents";
Delay :: (milliseconds: u32) #foreign sdl3 "SDL_Delay";

// Public SDL_Surface layout (SDL 3.4). Convert supplies packed ARGB8888 and
// pitch is honored, so renderer-selected BGRA/RGBA readback cannot fool parity.
Surface :: struct {
    flags: u32; format: u32; width: s32; height: s32; pitch: s32
    pixels: *void; references: s32; reserved: *void
}
Count :: BackendComparisonWidth * BackendComparisonHeight;
Argb :: 372645892;
Background :: 0xff20252b;
cpu: [Count]u32;
gpu: [Count]u32;
fixture: [256]u32;

Check :: (condition: bool, stage: string) -> bool {
    if !condition { print("FAIL SDL3 %: %\n", stage, TextFromCString(Error())) }
    return condition
}

ReadInto :: (renderer: *void, output: []u32, width: s32, height: s32) -> bool {
    surface := Read(renderer, null)
    if surface == null { return false }
    defer DestroySurface(surface)
    argb := Convert(surface, cast(u32)Argb)
    if argb == null { return false }
    defer DestroySurface(argb)
    if argb.width != width || argb.height != height || argb.pixels == null ||
        argb.pitch < width * 4 || cast(s64)width * height > output.count { return false }
    bytes := cast(*u8)argb.pixels
    for y: cast(s32)0..height - 1 {
        row := cast(*u32)(*bytes[y * argb.pitch])
        for x: cast(s32)0..width - 1 { output[y * width + x] = row[x] }
    }
    return true
}

Difference :: (first: u32, second: u32) -> s32 {
    maximum: s32
    for channel: cast(s32)0..3 {
        shift := cast(u32)(channel * 8)
        difference := cast(s32)((first >> shift) & cast(u32)255) -
            cast(s32)((second >> shift) & cast(u32)255)
        if difference < 0 { difference = -difference }
        if difference > maximum { maximum = difference }
    }
    return maximum
}

// At a fractional zoom, an exact source checker boundary can coincide with a
// destination pixel centre. CPU division and GPU UV interpolation can approach
// that nearest-sampling discontinuity from opposite sides. Only that exact
// location may match an adjacent reference pixel, along the tied axis only.
// This is a sampling-boundary allowance, not an AA/channel tolerance increase.
SamplingBoundaryMatch :: (scene: s32, frame: s32, x: s32, y: s32) -> bool {
    if scene != BackendComparisonZoom || x < 8 || x >= 472 || y < 40 || y >= 312 { return false }
    info := BackendComparisonDescribe(scene, frame)
    if info.zoom <= 1.0 { return false }
    px := cast(float32)x + 0.5; py := cast(float32)y + 0.5
    for row: cast(s32)0..9 { for column: cast(s32)0..5 {
        left := 8.0 + cast(float32)(column * 78) * info.zoom
        top := 40.0 + cast(float32)(row * 46 - info.scroll_y) * info.zoom
        width := 32.0 * info.zoom; height := 24.0 * info.zoom
        if px < left || px >= left + width || py < top || py >= top + height { continue }
        tie_x := false; tie_y := false
        for edge: cast(s32)1..3 {
            dx := px - (left + width * cast(float32)edge / 4.0)
            dy := py - (top + height * cast(float32)edge / 4.0)
            if dx >= -0.0001 && dx <= 0.0001 { tie_x = true }
            if dy >= -0.0001 && dy <= 0.0001 { tie_y = true }
        }
        if !tie_x && !tie_y { return false }
        for dy: cast(s32)-1..1 { for dx: cast(s32)-1..1 {
            if (dx != 0 && !tie_x) || (dy != 0 && !tie_y) || (dx == 0 && dy == 0) { continue }
            nx := x + dx; ny := y + dy
            npx := cast(float32)nx + 0.5; npy := cast(float32)ny + 0.5
            if nx < 8 || nx >= 472 || ny < 40 || ny >= 312 ||
                npx < left || npx >= left + width || npy < top || npy >= top + height { continue }
            if Difference(gpu[y * BackendComparisonWidth + x], cpu[ny * BackendComparisonWidth + nx]) <= 3 { return true }
        } }
        return false
    } }
    return false
}

Compare :: (scene: s32, frame: s32) -> bool {
    failures: s32; maximum: s32; exact: s32; sampling_ties: s32
    // Shared raster AA coverage is preserved. SDL blending/UNORM conversion
    // may round channels differently; permit at most 3/255 at every pixel,
    // including antialiased edges. No mismatching-pixel percentage exemption.
    for at: cast(s32)0..Count - 1 {
        difference := Difference(cpu[at], gpu[at])
        if difference == 0 { exact += 1 }
        if difference > maximum { maximum = difference }
        if difference > 3 {
            if SamplingBoundaryMatch(scene, frame, at % BackendComparisonWidth, at / BackendComparisonWidth) {
                sampling_ties += 1
            } else {
                if failures < 4 { print("parity scene=% frame=% x=% y=% cpu=% gpu=% delta=%\n",
                    scene, frame, at % BackendComparisonWidth, at / BackendComparisonWidth, cpu[at], gpu[at], difference) }
                failures += 1
            }
        }
    }
    print("parity scene=% frame=% pixels=% exact=% max_channel_delta=% channel_tolerance=3 nearest_tie_pixels=% failures=%\n",
        scene, frame, Count, exact, maximum, sampling_ties, failures)
    return failures == 0
}

Pixel :: (x: s32, y: s32) -> u32 { return gpu[y * BackendComparisonWidth + x] }

Probes :: (scene: s32, frame: s32) -> bool {
    if Pixel(0, 0) != Background || Pixel(479, 319) != Background { return false }
    if scene == BackendComparisonShapes {
        if Pixel(16, 16) != cast(u32)0xffc83c28 ||
            Difference(Pixel(40, 16), cast(u32)0xff6e5082) > 1 ||
            Pixel(96, 8) != Background || Pixel(116, 20) != cast(u32)0xff50c864 { return false }
        ink: s32
        for y: cast(s32)8..27 { for x: cast(s32)350..459 {
            if x < 380 || x >= 404 { if Pixel(x, y) != Background { return false } }
            else if Pixel(x, y) != Background { ink += 1 }
        } }
        if ink == 0 { return false }
    }
    if scene == BackendComparisonImages {
        opaque_x: s32 = ifx frame % 2 == 0 then 8 else 20
        alpha_x: s32 = ifx frame % 2 == 0 then 20 else 8
        if Pixel(opaque_x, 8) != cast(u32)0xffe02050 ||
            Difference(Pixel(alpha_x, 8), cast(u32)0xff207b66) > 1 ||
            Pixel(414, 8) != Background || Pixel(430, 20) == Background { return false }
    }
    if scene == BackendComparisonScroll || scene == BackendComparisonZoom {
        for y: cast(s32)32..319 { for x: cast(s32)0..479 {
            if y < 40 || y >= 312 || x < 8 || x >= 472 {
                if Pixel(x, y) != Background { return false }
            }
        } }
    }
    return true
}

SceneTest :: (renderer: *void, scene: s32, frame: s32) -> bool {
    // The CPU and GPU execute the same shared scene, fixture and bindings.
    if !Pixels.PixmapBeginInto(cast(u32)0x112233, BackendComparisonWidth, BackendComparisonHeight, cpu[:], true) { return false }
    BackendComparisonPaint(scene, frame); Pixels.PixmapEndInto()
    if !Sink.PixmapSdl3Open(renderer) { return false }
    defer Sink.PixmapSdl3Close()
    target := Sink.PixmapSdl3CreateTarget(BackendComparisonWidth, BackendComparisonHeight)
    if target == null { return false }
    // Close first: the sink borrows the target and may still refer to it.
    defer { Sink.PixmapSdl3Close(); DestroyTexture(target) }
    if Sink.PixmapSdl3CreateTarget(0, BackendComparisonHeight) != null { return false }
    if !Sink.PixmapSdl3UseTarget(target) { return false }
    if !Pixels.PixmapBeginInto(cast(u32)0x654321, BackendComparisonWidth, BackendComparisonHeight, gpu[:], true) { return false }
    BackendComparisonPaint(scene, frame); Pixels.PixmapEndInto()
    if !Sink.PixmapSdl3Draw() || !SetTarget(renderer, target) { return false }
    if !ReadInto(renderer, gpu[:], BackendComparisonWidth, BackendComparisonHeight) { return false }
    if !Compare(scene, frame) || !Probes(scene, frame) { return false }
    if !SetTarget(renderer, null) || !RenderTexture(renderer, target, null, null) || !Present(renderer) { return false }
    BackendComparisonPrintMetadata(scene, frame)
    return true
}

Lifecycle :: (window: *void, renderer: *void) -> bool {
    for pass: cast(s32)0..1 {
        width := 48 + pass * 16; height := 32 + pass * 16
        if !Resize(window, width, height) { return false }
        // Bounded event settling on this test's private server only.
        actual_width: s32; actual_height: s32
        for attempt: cast(s32)0..19 {
            Pump()
            if OutputSize(renderer, *actual_width, *actual_height) &&
                actual_width == width && actual_height == height { break }
            Delay(cast(u32)10)
        }
        if actual_width != width || actual_height != height { return false }
        if !SetColor(renderer, cast(u8)21, cast(u8)43, cast(u8)65, cast(u8)255) || !Clear(renderer) ||
            !ReadInto(renderer, gpu[:], width, height) { return false }
        for at: cast(s32)0..width * height - 1 { if gpu[at] != cast(u32)0xff152b41 { return false } }
        if !Present(renderer) || !Sink.PixmapSdl3Open(renderer) { return false }
        target := Sink.PixmapSdl3CreateTarget(width, height)
        if target == null { Sink.PixmapSdl3Close(); return false }
        if !SetTarget(renderer, target) || !Clear(renderer) || !ReadInto(renderer, gpu[:], width, height) {
            Sink.PixmapSdl3Close(); DestroyTexture(target); return false
        }
        if !SetTarget(renderer, null) { Sink.PixmapSdl3Close(); DestroyTexture(target); return false }
        Sink.PixmapSdl3Close(); DestroyTexture(target)
        Sink.PixmapSdl3Close() // idempotent; drawing while closed reports failure.
        if Sink.PixmapSdl3Draw() { return false }
        print("lifecycle resize=%x% clear/readback/present/target/destroy passed\n", width, height)
    }
    return true
}

main :: () -> s32 {
    if Presenter.CreatePixmapSdl3Renderer(null) != null || Presenter.PixmapSdl3DescribeRenderer(null).valid ||
        Sink.PixmapSdl3Open(null) { return 1 }
    if !Check(Init(cast(u32)32), "video initialization") { return 2 }
    defer Quit()
    title: [48]u8; unused CopyCString("Owned SDL3 renderer integration test", title[:])
    window := CreateWindow(*title[0], BackendComparisonWidth, BackendComparisonHeight, cast(u64)8) // SDL_WINDOW_HIDDEN
    if !Check(window != null, "private window") { return 3 }
    defer DestroyWindow(window)
    renderer := Presenter.CreatePixmapSdl3Renderer(window)
    if EnvironmentText("KRYON_SDL3_EXPECT_FAILURE") == "1" {
        if renderer != null { DestroyRenderer(renderer); print("FAIL: unexpected renderer fallback\n"); return 4 }
        print("SDL3 expected gpu creation failure, no fallback: %\n", TextFromCString(Error())); return 0
    }
    if !Check(renderer != null, "gpu renderer creation (no fallback)") { return 5 }
    defer DestroyRenderer(renderer)
    info := Presenter.PixmapSdl3DescribeRenderer(renderer)
    if !Check(info.valid && info.device != null && TextFromCString(info.renderer_name) == "gpu" &&
        TextFromCString(info.api).count > 0, "actual gpu renderer/device metadata") { return 6 }
    print("SDL3 renderer=% api=% device=% system_driver=% driver_info=% acceleration=unclassified\n",
        TextFromCString(info.renderer_name), TextFromCString(info.api), TextFromCString(info.device_name),
        TextFromCString(info.driver_name), TextFromCString(info.driver_info))
    // Reject metadata for a real non-gpu renderer, rather than relabeling it.
    other_title: [16]u8; unused CopyCString("software", other_title[:])
    other_window := CreateWindow(*title[0], 16, 16, cast(u64)8)
    if other_window == null { return 7 }
    other := CreateRenderer(other_window, *other_title[0])
    if other == null { DestroyWindow(other_window); return 8 }
    rejected := !Presenter.PixmapSdl3DescribeRenderer(other).valid
    DestroyRenderer(other); DestroyWindow(other_window)
    if !Check(rejected, "software renderer metadata rejection") { return 9 }
    if !BackendComparisonImagePixels(fixture[:]) ||
        !Pixels.PixmapSetImage(0, BackendComparisonImagePath, 16, 16, fixture[:]) { return 10 }
    defer Pixels.PixmapClearImage(0)
    defer Pixels.PixmapCloseWorkers()
    frames: [3]s32 = .{0, 1, 119}
    for scene: cast(s32)0..BackendComparisonSceneCount - 1 {
        for frame: frames {
            if !Check(SceneTest(renderer, scene, frame), "shared scene parity/clip/order") { return 11 }
        }
    }
    if !Check(Lifecycle(window, renderer), "resize/lifecycle") { return 12 }
    print("SDL3 renderer host integration local tests passed\n")
    return 0
}
