#import "control_props"
#import "geometry"
#import "style"
#import "surface"

using StyleField;

ProgressLayout :: struct {
    ratio: float32
    fill_bounds: Rectangle
    label_x: float32
    label_y: float32
    label_on_fill: bool
}

ProgressPaint :: struct {
    layout: ProgressLayout
    track: StyleFrame
    fill: StyleFrame
    label: StyleFrame
    track_color: u32
    fill_color: u32
    border_color: u32
    label_color: u32
    filled_label_color: u32
    radius: float32
    border_width: float32
}

ProgressDrawPlan :: struct {
    radius: float32
    draw_fill: bool
    draw_border: bool
    draw_label: bool
    label_color: u32
}

#program_export
ProgressTrackRole :: () -> s32 {
    return 4
}

#program_export
ProgressFillRole :: () -> s32 {
    return 5
}

#program_export
ProgressLabelRole :: () -> s32 {
    return 6
}

ProgressMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32) -> float32 {
    if (fields & field) == cast(u32)0 || value < 0.0 { value = fallback }
    return value * scale
}

#program_export
ProgressRatio :: (min: s32, max: s32, value: s32) -> float32 {
    if max <= min {
        max = min + 1
    }
    ratio: float32 = cast(float32)(value - min) / cast(float32)(max - min)
    if ratio < 0.0 {
        return 0.0
    }
    if ratio > 1.0 {
        return 1.0
    }
    return ratio
}

#program_export
ProgressFillBounds :: (bounds: Rectangle, ratio: float32) -> Rectangle {
    fill: Rectangle = bounds
    if ratio < 0.0 {
        ratio = 0.0
    }
    if ratio > 1.0 {
        ratio = 1.0
    }
    fill.width = bounds.width * ratio
    return fill
}

#program_export
ProgressDrawRadius :: (bounds: Rectangle, radius: float32) -> float32 {
    if bounds.height <= 0.0 {
        return 0.0
    }
    radius = radius / bounds.height
    if radius < 0.0 {
        return 0.0
    }
    if radius > 1.0 {
        return 1.0
    }
    return radius
}

#program_export
ProgressLabelX :: (bounds: Rectangle, fill_width: float32,
    label_width: float32, padding: float32) -> float32 {
    x: float32 = bounds.x + (bounds.width - label_width) * 0.5
    fill_end: float32 = bounds.x + fill_width
    empty_width: float32 = bounds.width - fill_width
    if empty_width >= label_width + padding * 2.0 {
        return fill_end + padding
    }
    if fill_width >= label_width + padding * 2.0 {
        return fill_end - label_width - padding
    }
    return x
}

#program_export
ProgressLabelY :: (bounds: Rectangle, label_line_height: float32) -> float32 {
    return bounds.y + (bounds.height - label_line_height) * 0.5
}

#program_export
ProgressLabelOnFill :: (fill_width: float32, label_width: float32,
    padding: float32) -> bool {
    return fill_width >= label_width + padding * 2.0
}

#program_export
ProgressLayoutFor :: (bounds: Rectangle, min: s32, max: s32, value: s32,
    label_width: float32, label_line_height: float32, padding: float32) -> ProgressLayout {
    layout: ProgressLayout
    layout.ratio = ProgressRatio(min, max, value)
    layout.fill_bounds = ProgressFillBounds(bounds, layout.ratio)
    layout.label_x = ProgressLabelX(bounds, layout.fill_bounds.width,
        label_width, padding)
    layout.label_y = ProgressLabelY(bounds, label_line_height)
    layout.label_on_fill = ProgressLabelOnFill(layout.fill_bounds.width,
        label_width, padding)
    return layout
}

#program_export
ProgressLabelPaddingForStyle :: (label: StyleFrame, scale: float32) -> float32 {
    if scale <= 0.0 { scale = 1.0 }
    return ProgressMetric(label.value.fields, cast(u32)StylePaddingX,
        label.value.padding_x, 6.0, scale)
}

#program_export
ProgressPaintFor :: (bounds: Rectangle, min: s32, max: s32, value: s32,
    label_width: float32, label_line_height: float32, scale: float32,
    track: StyleFrame, fill: StyleFrame, label: StyleFrame) -> ProgressPaint {
    paint: ProgressPaint
    if scale <= 0.0 { scale = 1.0 }
    padding: float32 = ProgressLabelPaddingForStyle(label, scale)
    paint.layout = ProgressLayoutFor(bounds, min, max, value, label_width,
        label_line_height, padding)
    paint.track = track
    paint.fill = fill
    paint.label = label
    paint.track_color = track.value.background
    paint.fill_color = fill.value.background
    paint.border_color = track.value.border
    paint.label_color = label.value.foreground
    paint.filled_label_color = fill.value.foreground
    paint.radius = track.value.radius * scale
    paint.border_width = track.value.border_width * scale
    if paint.border_width < 0.0 { paint.border_width = 0.0 }
    return paint
}

#program_export
ProgressDrawPlanFor :: (bounds: Rectangle, paint: ProgressPaint,
    has_label: bool, label_opacity: float32) -> ProgressDrawPlan {
    plan: ProgressDrawPlan
    plan.radius = ProgressDrawRadius(bounds, paint.radius)
    plan.draw_fill = paint.layout.fill_bounds.width > 0.0
    plan.draw_border = paint.border_width > 0.0
    plan.draw_label = has_label
    color: u32 = paint.label_color
    if paint.layout.label_on_fill {
        color = paint.filled_label_color
    }
    plan.label_color = Opacity(color, label_opacity)
    return plan
}
