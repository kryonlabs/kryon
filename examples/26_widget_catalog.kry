#import "kryon.h"

app "Kryon Widget Catalog" {
    size 1200 800
    fps 60
    font examples
}

state {
    image_path: const char * = "icons/tiles.png"
    menu_items: [2] MenuItem = {{MenuCommand,"Open",NULL,1,0,0,NULL,0},{MenuCommand,"Save",NULL,2,0,0,NULL,0}}
    menus: [1] Menu = {{{0},"File",menu_items,2}}
    action_count: int = 0
    category: int = 0
    category_names: [10] const char * = {"Display & media","Actions & input","Layout & containers","Collections & editors","Navigation","Feedback & dialogs","Canvas","Numbers & plots","Colors","Pages & settings"}
    category_heights: [10] int = {760,760,400,1020,680,660,400,1060,540,740}
    numbers: [3] float = {0.25f,0.5f,0.75f}
    integers: [3] int = {2,5,8}
    doubles: [2] double = {0.25,0.75}
    plot: [8] float = {0.2f,0.5f,0.3f,0.8f,0.6f,0.9f,0.4f,0.7f}
    rgba: [4] float = {0.3f,0.6f,0.8f,1.0f}
    range_min: float = 2.0f
    range_max: float = 8.0f
    int_min: int = 2
    int_max: int = 8
    angle: float = 0.0f
    selected: int = 0
    flags: int = 1
    multi_selected: [3] int = {0}
    multi_count: int = 0
    multi_anchor: int = -1
    accepted_size: int = 0
    open_tabs: [8] Tab = {{.label = "One", .closeable = 1},{.label = "Two", .closeable = 1}}
    tab_labels: [8] const char * = {"One","Two","Three","Four","Five","Six","Seven","Eight"}
    tab_count: int = 2
    tab_selected: int = 0
    subtab_selected: int = 0
    pane_selected: int = 0
    subtabs: [3] Tab = {{.label = "Overview"},{.label = "Details"},{.label = "History"}}
    page_preview: int = 0
    page_route: int = 0
    nav_items: [3] NavigationBarItem = {{.route = 0,.label = "Home"},{.route = 1,.label = "Explore"},{.route = 2,.label = "Settings"}}
    theme_source: int = 0
    theme_mode: int = 2
    theme_style: int = 1
    theme_initialized: int = 0
    menu_command: int = 0
    picker_choice: int = -1
    dialog_result: int = 0
    canvas_dragging: int = 0
    canvas_last: Vector2 = {0}
    closed_tab: int = -1
    scroll_off: int = 0
    open_menu: int = -1
    context_open: int = 0
    context_x: int = 0
    context_y: int = 0
    theme_id: int = 0
    dark_mode: int = 0
    picked: int = 0
    slider_value: int = 42
    toggle_value: int = 0
    checkbox_value: int = 1
    text_cursor: int = 5
    text_focused: int = 0
    area_cursor: int = 12
    area_focused: int = 0
    area_scroll: int = 0
    list_scroll: int = 0
    tree_selected: int = 1
    table_selected_row: int = 0
    table_selected_column: int = 0
    table_activated_row: int = -1
    table_activated_column: int = -1
    table_right_row: int = -1
    table_right_column: int = -1
    canvas_scroll_x: int = 0
    canvas_scroll_y: int = 0
    canvas_zoom: float = 1.0f
    split: int = 90
    open: bool = true
    dialog: int = 0
    color_value: Color = {88,201,235,255}
    text_value: [64] char = "Hello"
    area_value: [128] char = "Editable text area"
    choices: [3] const char * = {"Alpha","Beta","Gamma"}
    display_lines: [2] const char * = {"Text lines: first","Text lines: second"}
    columns: [2] const char * = {"Name","Value"}
    cells_a: [2] const char * = {"Alpha","1"}
    cells_b: [2] const char * = {"Beta","2"}
    rows: [2] TableRow = {{.cells = cells_a, .cell_count = 2},{.cells = cells_b, .cell_count = 2}}
    widths: [2] int = {150,90}
    tree_items: [2] UITreeItem = {{"Root",0,1,1,1},{"Child",1,2,0,1}}
    tabs: [2] const Tab = {{.label = "One"},{.label = "Two"}}
}

WidgetCatalogExample :: (viewport: Rectangle) #ui {
    # Keep both columns and every sidebar category reachable in smaller windows.
    density: float = GetWindowScaleDPI().x
    if density > viewport.width / 1120.0f { density = viewport.width / 1120.0f }
    if density > viewport.height / 640.0f { density = viewport.height / 640.0f }
    SetUIScale(density)
    SetExitKey(KEY_NULL)
    if !FileExists(image_path) {
        image_path = "../icons/tiles.png"
    }
    if theme_initialized == 0 {
        dark_mode = GetEffectiveThemeDarkMode()
        theme_mode = GetThemeMode()
        theme_style = GetThemeStyle()
        theme_source = GetThemeSource()
        theme_initialized = 1
    }
    if page_preview {
        Screen preview: {
            bounds = viewport
            Background(GetThemeBackground())
            TitleBar((TitleBarProps){.title = "TitleBar / NavigationBar preview", .height = Scale(54)})
            if Button((ButtonProps){.bounds = {Scale(20),Scale(72),Scale(180),Scale(36)}, .label = "Back to catalog", .id = 950}) {
                page_preview = 0
            }
            Text((TextProps){.bounds={Scale(230), Scale(80), 0, 0}, .text=TextFormat("Selected route: %d", page_route), .font=Text20, .color=GetThemeText(), .wrap=TextWrapNone})
            nav_index: int = 0
            for nav_index = 0; nav_index < 3; nav_index++ {
                nav_items[nav_index].active = page_route == nav_index
            }
            nav_result: NavigationBarResult = NavigationBar((NavigationBarProps){.view_width = (int)viewport.width,.view_height = (int)viewport.height,.count = 3,.items = nav_items,.height = Scale(64)})
            if nav_result.clicked_index >= 0 {
                page_route = nav_result.clicked_route
            }
        }
        return
    }
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
        Text((TextProps){.bounds={Scale(20), Scale(22), 0, 0}, .text="Widget catalog", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(246), Scale(28), 0, 0}, .text="Standard Kryon controls. Select a category and try them.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Line(Scale(220), Scale(76), Scale(220), (int)viewport.height - Scale(24), GetThemeButton())
        i: int = 0
        for i = 0; i < 10; i++ {
            if Button((ButtonProps){.bounds = {Scale(16),Scale(86 + i * 46),Scale(190),Scale(38)}, .label = category_names[i], .font = Text14, .id = 900 + i, .tone = category == i ? ButtonToneAccent : ButtonToneNeutral, .emphasis = ButtonEmphasisSoft, .selected = category == i}) {
                category = i
                scroll_off = 0
                open_menu = -1
                context_open = 0
            }
        }
        Text((TextProps){.bounds={Scale(20), (int)viewport.height - Scale(52), 0, 0}, .text="Wheel to scroll", .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={Scale(20), (int)viewport.height - Scale(30), 0, 0}, .text=TextFormat("Clicks: %d", action_count), .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})

        area: ScrollArea = {{Scale(236), Scale(82), (int)viewport.width - Scale(252), (int)viewport.height - Scale(100)}, Scale(category_heights[category]), Scale(252), (int)viewport.width - Scale(292), &scroll_off, Scale(42), 0}
        view: ScrollView = BeginScrollContainer(area)
        x: int = view.content_x
        right: int = x + Scale(410)
        y: int = view.content_y

        if category == 0 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="DISPLAY AND MEDIA", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + Scale(38), 0, 0}, .text="Text", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds=(Rectangle){x, y + Scale(70), Scale(300), Scale(52)}, .text="Text is bounded, wrapped, and clipped by default.", .font=Text16, .color=GetThemeText(), .align=TextAlignCenter, .vertical_align=TextAlignCenter})
        Text((TextProps){.bounds={x, y + Scale(132), 0, 0}, .text=display_lines[0], .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + Scale(150), 0, 0}, .text=display_lines[1], .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        paragraph_y: int = y + Scale(176)
        Paragraph((ParagraphSpec){.text = "A short paragraph with an icon.", .icon_type = 1, .icon_size = Scale(16), .width = Scale(300), .font = Text16, .line_gap = Scale(4), .color = GetThemeText()}, x, &paragraph_y)
        Rect(right, y + Scale(38), Scale(120), Scale(54), GetThemeSurface(), GetThemeButton())
        Line(right, y + Scale(110), right + Scale(120), y + Scale(110), GetThemeLink())
        Bevel(right, y + Scale(132), Scale(120), Scale(34), GetThemeSurface(), GetThemeButton())
        Icon(100, right + Scale(150), y + Scale(46), Scale(28), 1, GetThemeIcon())
        Fieldset((FieldsetProps){.bounds = {right + Scale(200), y + Scale(36), Scale(150), Scale(58)}, .title = "Fieldset"})
        Image((ImageProps){.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right + Scale(200), y + Scale(112), Scale(58), Scale(58)}, .tint = WHITE, .fit = IMAGE_FIT_CONTAIN})
        Image((ImageProps){.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right + Scale(278), y + Scale(112), Scale(72), Scale(58)}, .tint = WHITE, .fit = IMAGE_FIT_CONTAIN})

        Text((TextProps){.bounds={x, y + Scale(260), 0, 0}, .text="Custom color", .font=Text16, .color=GetThemeLink(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + Scale(300), 0, 0}, .text="Disabled text", .font=Text16, .wrap=TextWrapNone, .disabled=1})
        Text((TextProps){.bounds=(Rectangle){x,y + Scale(340),Scale(320),Scale(60)}, .text="Bounded text wraps and clips inside its standard bounds.", .font=Text16, .color=GetThemeText()})
        Text((TextProps){.bounds={x,y + Scale(418),0,0}, .text="Label", .font=Text16, .color=Fade(GetThemeText(), 0.72f), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x + Scale(56),y + Scale(418),0,0}, .text="Value", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Bullet((Rectangle){x,y + Scale(460),Scale(16),Scale(20)})
        Text((TextProps){.bounds={x + Scale(20),y + Scale(460),0,0}, .text="Bullet text", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        selectable_token: int = PushTextSelectable(1)
        Text((TextProps){.bounds={x, y + Scale(510), 0, 0}, .text="Select and copy this text.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        PopTextSelectable(selectable_token)
        Text((TextProps){.bounds={right,y + Scale(260),0,0}, .text="Bool: true", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={right,y + Scale(300),0,0}, .text=TextFormat("Int: %d", 42), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={right,y + Scale(340),0,0}, .text=TextFormat("UInt: %u", 42), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={right,y + Scale(380),0,0}, .text=TextFormat("Float: %.2f", 0.5f), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Image((ImageProps){.asset_path = image_path, .source = {0,0,64,64}, .bounds = {right,y + Scale(500),Scale(80),Scale(80)}, .tint = WHITE, .fit = IMAGE_FIT_CONTAIN, .style = {.enabled = true, .background = GetThemeSurface()}})
        if Button((ButtonProps){.bounds = {right + Scale(110),y + Scale(500),Scale(80),Scale(80)}, .image_asset_path = image_path, .image_source = {0,0,64,64}, .image_bounds = {right + Scale(110),y + Scale(500),Scale(80),Scale(80)}, .image_tint = WHITE, .image_fit = IMAGE_FIT_CONTAIN, .image_background = GetThemeSurface(), .id = 210}) {
            action_count += 1
            ShowToast("Image button clicked")
        }
        Text((TextProps){.bounds={right, y + Scale(606), 0, 0}, .text="Image / Button image", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        Separator((SeparatorProps){.bounds = {x,y + Scale(570),Scale(350),Scale(30)}, .label = "Separator"})
        Bullet((Rectangle){right,y + Scale(460),Scale(24),Scale(24)})
        }

        if category == 1 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="ACTIONS AND INPUT", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        if Button((ButtonProps){.bounds = {x, y + Scale(38), Scale(140), Scale(34)}, .label = "Button", .font = Text16, .id = 101}) {
            action_count += 1
        }
        if Button((ButtonProps){.bounds = {x + Scale(154), y + Scale(38), Scale(34), Scale(34)}, .icon_type = 1, .icon_only = true, .id = 102}) {
            action_count += 1
        }
        Link((LinkProps){.bounds = {x + Scale(204), y + Scale(40), Scale(100), Scale(30)}, .text = "Kryon Labs", .link = "https://kryonlabs.com", .font = Text16, .focus_id = 103, .color = GetThemeLink(), .hover_color = GetThemeLink()})
        TextField((TextFieldProps){.bounds = {right, y + Scale(38), Scale(260), Scale(34)}, .text = text_value, .text_size = sizeof(text_value), .cursor_position = &text_cursor, .focused = &text_focused, .max_codepoints = 63, .font = Text16, .focus_id = 104})
        TextArea((TextAreaProps){.bounds = {right, y + Scale(86), Scale(300), Scale(76)}, .text = area_value, .text_size = sizeof(area_value), .cursor_position = &area_cursor, .focused = &area_focused, .scroll_y = &area_scroll, .max_codepoints = 127, .font = Text16, .line_gap = Scale(4), .focus_id = 105, .placeholder = "Notes", .syntax = SyntaxNone})

        y += Scale(190)
        Dropdown((DropdownProps){.bounds = {x, y, Scale(180), Scale(32)}, .id = 106,
            .options = choices, .option_count = 3, .selected_index = &picked})
        Slider((SliderProps){.bounds = {x, y + Scale(46), Scale(250), Scale(40)}, .id = 107, .label = "Slider", .kind = NumericInt, .int_values = &slider_value, .value_count = 1, .min = 0, .max = 100, .format = "%"})
        Toggle((ToggleProps){.bounds = {x, y + Scale(92), Scale(130), Scale(34)}, .id = 108, .value = &toggle_value, .off_label = "Off", .on_label = "On"})
        Checkbox((CheckboxProps){.bounds = {x, y + Scale(140), Scale(160), Scale(34)}, .id = 109, .label = "Checkbox", .value = &checkbox_value})
        if Radio((RadioProps){.bounds = {right, y, Scale(130), Scale(28)}, .label = "Radio", .id = 129, .checked = picked == 1}) {
            picked = 1
        }
        Spinbox((SpinboxProps){.bounds = {right, y + Scale(44), Scale(140), Scale(32)}, .id = 110, .min = 0, .max = 100, .step = 1, .value = &slider_value, .value_text = nil, .wrap = 0})
        Dropdown((DropdownProps){.bounds = {right, y + Scale(92), Scale(180), Scale(32)}, .id = 111,
            .options = choices, .option_count = 3, .selected_index = &picked})
        Progress((ProgressProps){{right, y + Scale(140), Scale(220), Scale(24)}, 0, 100, slider_value, "Progress"})
        ColorPicker((ColorPickerProps){.bounds = {right + Scale(240), y, Scale(120), Scale(120)}, .id = 112, .values = rgba, .value_count = 4, .picker = true})

        if Button((ButtonProps){.bounds = {x,y + Scale(204),Scale(120),Scale(28)}, .label = "Small", .size = ControlSizeSmall, .id = 200}) {
            action_count += 1
        }
        if Button((ButtonProps){.bounds = {x + Scale(140),y + Scale(204),Scale(32),Scale(28)}, .id = 201, .arrow = true, .direction = ARROW_RIGHT}) {
            action_count += 1
        }
        Selectable((SelectableProps){.bounds = {x,y + Scale(250),Scale(300),Scale(32)}, .id = 202, .label = "Selectable", .selected = &selected})
        Checkbox((CheckboxProps){.bounds = {right,y + Scale(204),Scale(300),Scale(32)}, .id = 203, .label = "Checkbox flags", .flags = &flags, .flags_value = 1})
        Text((TextProps){.bounds={right, y + Scale(258), 0, 0}, .text="InvisibleButton (click this area)", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        if InvisibleButton((InvisibleButtonProps){.bounds = {right,y + Scale(250),Scale(300),Scale(32)}, .id = 204}) {
            action_count += 1
            ShowToast("InvisibleButton clicked")
        }
        Disabled disabled_action: {
            if Button((ButtonProps){.bounds = {x,y + Scale(310),Scale(180),Scale(34)}, .label = "Disabled button", .id = 205}) {
                action_count += 1
            }
        }
        Popup disabled_help: {
            bounds = {x + Scale(188),y + Scale(304),Scale(256),Scale(48)}
            id = 206
            trigger = {x,y + Scale(310),Scale(180),Scale(34)}
            flags = PopupTooltip
            Text((TextProps){.bounds={x + Scale(196),y + Scale(316),Scale(240),Scale(22)},.text="A standard tooltip",.font=Text14,.color=GetThemeText(),.wrap=TextWrapNone})
        }
        }

        if category == 2 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="LAYOUT AND CONTAINERS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        Column demo_column: {
            bounds = {x, y + Scale(38), Scale(190), Scale(92)}
            gap = Scale(6)
            padding = Scale(8)
            Text((TextProps){.bounds={0, 0, 0, 0}, .text="Column", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Row demo_row: {
                bounds = {0, 0, Scale(170), Scale(34)}
                gap = Scale(6)
                if Button((ButtonProps){.bounds = {0,0,Scale(72),Scale(30)}, .label = "Row A", .id = 112}) {
                    action_count += 1
                }
                if Button((ButtonProps){.bounds = {0,0,Scale(72),Scale(30)}, .label = "Row B", .id = 113}) {
                    action_count += 1
                }
            }
        }
        Stack demo_stack: {
            bounds = {x + Scale(214), y + Scale(38), Scale(160), Scale(92)}
            key = Key("catalog-stack")
            Rect(x + Scale(214), y + Scale(38), Scale(160), Scale(92), GetThemeSurface(), GetThemeButton())
            Text((TextProps){.bounds={x + Scale(258), y + Scale(70), 0, 0}, .text="Stack", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        }
        Grid((GridProps){.bounds = {x, y + Scale(148), Scale(374), Scale(48)}, .columns = 2, .gap = Scale(6)})
        if Button((ButtonProps){.bounds = {0,0,Scale(150),Scale(32)}, .label = "Grid A", .id = 124}) {
            action_count += 1
        }
        if Button((ButtonProps){.bounds = {0,0,Scale(150),Scale(32)}, .label = "Grid B", .id = 125}) {
            action_count += 1
        }
        End()
        layout_tab_result: int = TabBar((TabBarProps){.bounds = {right, y + Scale(38), Scale(180), Scale(36)}, .tabs = tabs, .count = 2, .selected_index = picked, .id = 1140})
        if layout_tab_result >= 0 { picked = layout_tab_result }
        PanedView((PanedViewProps){.bounds = {right + Scale(198), y + Scale(38), Scale(180), Scale(54)}, .id = 114, .vertical = 1, .split = &split, .min_first = 60, .min_second = 80})
        Text((TextProps){.bounds={right + Scale(198), y + Scale(8), 0, 0}, .text="Drag the divider", .font=Text14, .color=GetThemeIcon(), .wrap=TextWrapNone})
        Collapsible((CollapsibleProps){.bounds = {right, y + Scale(108), Scale(260), Scale(54)}, .label = "Collapsible", .open = &open})
        if open {
            Text((TextProps){.bounds={right, y + Scale(174), 0, 0}, .text="This content collapses with its header.", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        }

        }

        if category == 3 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="COLLECTIONS AND EDITORS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        ListBox((ListBoxProps){.bounds = {x, y + Scale(38), Scale(180), Scale(90)}, .id = 115, .items = choices, .item_count = 3, .selected_index = &picked, .scroll_offset = &list_scroll, .row_height = Scale(26)})
        TreeView((TreeViewProps){.bounds = {x + Scale(198), y + Scale(38), Scale(180), Scale(90)}, .id = 116, .items = tree_items, .item_count = 2, .selected_id = &tree_selected, .scroll_offset = &list_scroll, .row_height = Scale(26)})
        Rect(right, y + Scale(38), Scale(360), Scale(90), GetThemeSurface(), GetThemeBorder())
        Text((TextProps){.bounds={right + Scale(12), y + Scale(52), 0, 0}, .text="1  Text(\"Hello\")", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        TableView((TableViewProps){.bounds = {x, y + Scale(148), Scale(378), Scale(100)}, .id = 117, .columns = columns, .column_count = 2, .rows = rows, .row_count = 2, .column_widths = widths, .selected_row = &table_selected_row, .selected_column = &table_selected_column, .activated_row = &table_activated_row, .activated_column = &table_activated_column, .right_clicked_row = &table_right_row, .right_clicked_column = &table_right_column})

        Text((TextProps){.bounds={x, y + Scale(290), 0, 0}, .text="MultiSelectList (Ctrl / Shift to select)", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        MultiSelectList((MultiSelectListProps){.bounds = {x,y + Scale(330),Scale(350),Scale(110)}, .id = 206, .items = choices, .item_count = 3, .selected = multi_selected, .selected_count = &multi_count, .anchor = &multi_anchor, .row_height = Scale(30)})
        Text((TextProps){.bounds={x, y + Scale(480), 0, 0}, .text="Drag text from the left into the right box", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Rect(x,y + Scale(522),Scale(300),Scale(48),GetThemeSurface(),GetThemeButton())
        Text((TextProps){.bounds={x + Scale(12), y + Scale(538), 0, 0}, .text="DragDropSource", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        DragDropSource((DragDropSourceProps){.bounds = {x,y + Scale(522),Scale(300),Scale(48)}, .id = 207, .type = "TEXT", .data = text_value, .data_size = sizeof(text_value)})
        Rect(right,y + Scale(522),Scale(300),Scale(48),GetThemeSurface(),GetThemeButton())
        Text((TextProps){.bounds={right + Scale(12), y + Scale(538), 0, 0}, .text="DragDropTarget", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        DragDropTarget((DragDropTargetProps){.bounds = {right,y + Scale(522),Scale(300),Scale(48)}, .id = 208, .type = "TEXT", .output = area_value, .output_size = sizeof(area_value), .accepted_size = &accepted_size})
        Text((TextProps){.bounds={right, y + Scale(590), 0, 0}, .text=area_value, .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        }

        if category == 4 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="NAVIGATION", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + Scale(22), 0, 0}, .text="Menus, tabs and navigation", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        Toolbar((ToolbarProps){.id = 118, .x = x, .y = y + Scale(44), .width = Scale(300), .height = Scale(36), .draw_menu = 1, .options = choices, .option_count = 3, .selected_index = &picked})
        Toolbar((ToolbarProps){.id = 119, .x = right, .y = y + Scale(44), .width = Scale(300), .height = Scale(36), .draw_menu = 1, .options = choices, .option_count = 3, .selected_index = &picked})
        tab_result: int = TabBar((TabBarProps){.bounds = {x, y + Scale(100), Scale(360), Scale(34)}, .tabs = tabs, .count = 2, .selected_index = picked, .focus_selected = 1, .id = 2603})
        if tab_result >= 0 {
            picked = tab_result
        }
        menu_result: MenuBarResult = MenuBar(126, (Rectangle){x, y + Scale(148), Scale(360), Scale(34)}, menus, 1, &open_menu)
        context_result: int = ContextMenu((ContextMenuProps){127, {right, y + Scale(132), Scale(280), Scale(50)}, menu_items, 2, &context_open, &context_x, &context_y})
        if menu_result.activated_id > 0 {
            menu_command = menu_result.activated_id
        }
        if context_result > 0 {
            menu_command = context_result
        }
        Text((TextProps){.bounds={right + Scale(12), y + Scale(148), 0, 0}, .text="Right-click here for a context menu", .font=Text14, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={x, y + Scale(216), 0, 0}, .text="TabBar close props", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        close_tab_result: int = TabBar((TabBarProps){.bounds = {x,y + Scale(252),Scale(760),Scale(36)}, .tabs = open_tabs, .count = tab_count, .selected_index = tab_selected, .font = Text16, .closed_index = &closed_tab, .id = 2604})
        if closed_tab >= 0 {
            if closed_tab < tab_count {
                tab_index: int = closed_tab
                for tab_index = closed_tab; tab_index < tab_count - 1; tab_index++ {
                    open_tabs[tab_index] = open_tabs[tab_index + 1]
                }
                tab_count -= 1
                if tab_selected > closed_tab {
                    tab_selected -= 1
                }
                if tab_selected >= tab_count {
                    tab_selected = tab_count - 1
                }
            }
            closed_tab = -1
        }
        if close_tab_result >= 0 {
            tab_selected = close_tab_result
        }
        if Button((ButtonProps){.bounds = {right,y + Scale(308),Scale(130),Scale(36)}, .id = 209, .label = "New tab", .font = Text16, .tone = ButtonToneNeutral, .emphasis = ButtonEmphasisGhost, .disabled = tab_count >= 8}) {
            open_tabs[tab_count] = (Tab){.label = tab_labels[tab_count], .closeable = 1}
            tab_selected = tab_count
            tab_count += 1
        }

        }

        if category == 4 {
            Text((TextProps){.bounds={x, y + Scale(308), 0, 0}, .text=TextFormat("Open tabs: %d / Menu command: %d", tab_count, menu_command), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Text((TextProps){.bounds={x, y + Scale(350), 0, 0}, .text="Level 2 tabs", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            subtab_result: int = TabBar((TabBarProps){.bounds = {x,y + Scale(384),Scale(350),Scale(36)},.tabs = subtabs,.count = 3,.selected_index = subtab_selected,.font = Text16,.min_tab_width = Scale(110),.max_tab_width = Scale(120)})
            if subtab_result >= 0 {
                subtab_selected = subtab_result
            }
            Text((TextProps){.bounds={right, y + Scale(350), 0, 0}, .text="Pane tabs", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            pane_result: int = TabBar((TabBarProps){.bounds = {right,y + Scale(384),Scale(350),Scale(36)},.tabs = tabs,.count = 2,.selected_index = pane_selected,.font = Text16,.min_tab_width = Scale(92),.max_tab_width = Scale(120)})
            if pane_result >= 0 {
                pane_selected = pane_result
            }
        }
        if category == 5 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="FEEDBACK AND DIALOGS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        if Button((ButtonProps){.bounds = {x, y + Scale(40), Scale(150), Scale(34)}, .label = "Show toast", .id = 120}) {
            ShowToast("Hello from Kryon")
        }
        if Button((ButtonProps){.bounds = {x + Scale(166), y + Scale(40), Scale(150), Scale(34)}, .label = "Message dialog", .id = 121}) {
            dialog = 1
        }
        if Button((ButtonProps){.bounds = {right, y + Scale(40), Scale(150), Scale(34)}, .label = "Confirm dialog", .id = 122}) {
            dialog = 2
        }
        if Button((ButtonProps){.bounds = {right + Scale(166), y + Scale(40), Scale(150), Scale(34)}, .label = "Prompt dialog", .id = 123}) {
            dialog = 3
        }
        if Button((ButtonProps){.bounds = {right + Scale(276), y + Scale(94), Scale(120), Scale(34)}, .label = "Action modal", .id = 128}) {
            dialog = 4
        }

        }

        if category == 5 {
            if Button((ButtonProps){.bounds = {x,y + Scale(430),Scale(180),Scale(36)},.label = "Choice modal",.id = 960}) { dialog = 5 }
            Text((TextProps){.bounds={x, y + Scale(486), 0, 0}, .text=TextFormat("Picker: %d / Dialog result: %d", picker_choice, dialog_result), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        }
        if category == 6 {
        Text((TextProps){.bounds={x, y, 0, 0}, .text="CANVAS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
        canvas_bounds: Rectangle = {x,y + Scale(38),Scale(360),Scale(120)}
        mouse: Vector2 = GetMousePosition()
        if CheckCollisionPointRec(mouse, canvas_bounds) && !UIInputCapturesClick(mouse) {
            wheel: float = GetMouseWheelMove()
            if wheel != 0 {
                canvas_zoom = Clamp(canvas_zoom + wheel * 0.1f, 0.25f, 4.0f)
            }
            if IsMouseButtonPressed(MOUSE_BUTTON_LEFT) {
                canvas_dragging = 1
                canvas_last = mouse
            }
        }
        if canvas_dragging {
            canvas_scroll_x -= (int)((mouse.x - canvas_last.x) / canvas_zoom)
            canvas_scroll_y -= (int)((mouse.y - canvas_last.y) / canvas_zoom)
            canvas_last = mouse
            if IsMouseButtonReleased(MOUSE_BUTTON_LEFT) { canvas_dragging = 0 }
        }
        canvas_result: CanvasResult = BeginCanvas((Canvas){{x, y + Scale(38), Scale(360), Scale(120)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
        CanvasGrid((Rectangle){x, y + Scale(38), Scale(360), Scale(120)}, 12, GetThemeIcon())
        Circle(x + Scale(180), y + Scale(98), Scale(16), GetThemeLink())
        unused canvas_result
        EndCanvas((Canvas){{x, y + Scale(38), Scale(360), Scale(120)}, &canvas_scroll_x, &canvas_scroll_y, &canvas_zoom})
        Text((TextProps){.bounds={right, y + Scale(56), 0, 0}, .text="Wheel to zoom; drag the canvas to pan.", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})

        }

        if category == 6 {
            Text((TextProps){.bounds={x, y + Scale(190), 0, 0}, .text=TextFormat("Pan: %d, %d / Zoom: %.2f", canvas_scroll_x,canvas_scroll_y,canvas_zoom), .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds = {right,y + Scale(100),Scale(140),Scale(34)},.label = "Reset canvas",.id = 963}) {
                canvas_scroll_x = 0
                canvas_scroll_y = 0
                canvas_zoom = 1.0f
            }
        }
        if category == 7 {
            Text((TextProps){.bounds={x, y, 0, 0}, .text="NUMBERS AND PLOTS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
            Text((TextProps){.bounds={x, y + Scale(54), 0, 0}, .text="Drag float", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Drag((DragProps){.bounds = {x,y + Scale(86),Scale(350),Scale(36)}, .id = 300, .kind = NumericFloat, .float_values = numbers, .value_count = 3, .speed = 0.01f, .min = 0.0f, .max = 1.0f})
            Text((TextProps){.bounds={right, y + Scale(54), 0, 0}, .text="Drag int", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Drag((DragProps){.bounds = {right,y + Scale(86),Scale(350),Scale(36)}, .id = 301, .kind = NumericInt, .int_values = integers, .value_count = 3, .speed = 1.0f, .min = 0, .max = 10})
            Text((TextProps){.bounds={x, y + Scale(166), 0, 0}, .text="Drag float range", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Drag((DragProps){.bounds = {x,y + Scale(198),Scale(350),Scale(36)}, .id = 302, .kind = NumericFloat, .mode = DragRange, .float_min = &range_min, .float_max = &range_max, .speed = 0.1f, .min = 0.0f, .max = 10.0f})
            Text((TextProps){.bounds={right, y + Scale(166), 0, 0}, .text="Drag int range", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Drag((DragProps){.bounds = {right,y + Scale(198),Scale(350),Scale(36)}, .id = 303, .kind = NumericInt, .mode = DragRange, .int_min = &int_min, .int_max = &int_max, .speed = 1.0f, .min = 0, .max = 10})
            Text((TextProps){.bounds={x, y + Scale(278), 0, 0}, .text="Slider float", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Slider((SliderProps){.bounds = {x,y + Scale(310),Scale(350),Scale(36)}, .id = 304, .kind = NumericFloat, .float_values = numbers, .value_count = 3, .min = 0.0f, .max = 1.0f})
            Text((TextProps){.bounds={right, y + Scale(278), 0, 0}, .text="Slider int", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Slider((SliderProps){.bounds = {right,y + Scale(310),Scale(350),Scale(36)}, .id = 305, .kind = NumericInt, .int_values = integers, .value_count = 3, .min = 0, .max = 10})
            Text((TextProps){.bounds={x, y + Scale(390), 0, 0}, .text="Slider angle", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Slider((SliderProps){.bounds = {x,y + Scale(422),Scale(350),Scale(36)}, .id = 306, .kind = NumericFloat, .float_value = &angle, .min = -180.0f, .max = 180.0f, .angle = 1})
            Text((TextProps){.bounds={right, y + Scale(390), 0, 0}, .text="Input float", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Input((InputProps){.bounds = {right,y + Scale(422),Scale(350),Scale(36)}, .id = 307, .kind = NumericFloat, .float_values = numbers, .value_count = 3, .step = 0.1f, .step_fast = 1.0f})
            Text((TextProps){.bounds={x, y + Scale(502), 0, 0}, .text="Input int", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Input((InputProps){.bounds = {x,y + Scale(534),Scale(350),Scale(36)}, .id = 308, .kind = NumericInt, .int_values = integers, .value_count = 3, .step = 1, .step_fast = 10})
            Text((TextProps){.bounds={right, y + Scale(502), 0, 0}, .text="Input double", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Input((InputProps){.bounds = {right,y + Scale(534),Scale(350),Scale(36)}, .id = 309, .kind = NumericDouble, .double_values = doubles, .value_count = 2, .step = 0.01, .step_fast = 1.0})
            Text((TextProps){.bounds={x, y + Scale(628), 0, 0}, .text="Vertical sliders", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Slider((SliderProps){.bounds = {x,y + Scale(666),Scale(48),Scale(150)}, .id = 310, .kind = NumericFloat, .float_values = numbers, .value_count = 1, .min = 0.0f, .max = 1.0f, .vertical = 1})
            Slider((SliderProps){.bounds = {x + Scale(72),y + Scale(666),Scale(48),Scale(150)}, .id = 311, .kind = NumericInt, .int_values = integers, .value_count = 1, .min = 0, .max = 10, .vertical = 1})
            Text((TextProps){.bounds={right, y + Scale(628), 0, 0}, .text="Plot lines", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Plot((PlotProps){.bounds = {right,y + Scale(666),Scale(350),Scale(150)}, .values = plot, .value_count = 8, .scale_min = 0.0f, .scale_max = 1.0f})
            Text((TextProps){.bounds={x, y + Scale(870), 0, 0}, .text="Plot histogram", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            Plot((PlotProps){.bounds = {x,y + Scale(908),Scale(350),Scale(110)}, .values = plot, .value_count = 8, .scale_min = 0.0f, .scale_max = 1.0f, .mode = 1})
        }
        if category == 8 {
            Text((TextProps){.bounds={x, y, 0, 0}, .text="COLORS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
            Text((TextProps){.bounds={x, y + Scale(54), 0, 0}, .text="ColorPicker RGB edit", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            ColorPicker((ColorPickerProps){.bounds = {x,y + Scale(90),Scale(350),Scale(36)}, .id = 320, .values = rgba, .value_count = 3})
            Text((TextProps){.bounds={right, y + Scale(54), 0, 0}, .text="ColorPicker RGBA edit", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            ColorPicker((ColorPickerProps){.bounds = {right,y + Scale(90),Scale(350),Scale(36)}, .id = 321, .values = rgba, .value_count = 4})
            Text((TextProps){.bounds={x, y + Scale(170), 0, 0}, .text="ColorPicker RGB", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            ColorPicker((ColorPickerProps){.bounds = {x,y + Scale(208),Scale(300),Scale(160)}, .id = 322, .values = rgba, .value_count = 3, .picker = true})
            Text((TextProps){.bounds={right, y + Scale(170), 0, 0}, .text="ColorPicker RGBA", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            ColorPicker((ColorPickerProps){.bounds = {right,y + Scale(208),Scale(300),Scale(210)}, .id = 323, .values = rgba, .value_count = 4, .picker = true})
            if Button((ButtonProps){.bounds = {x,y + Scale(450),Scale(160),Scale(36)}, .id = 324, .label = "Color swatch", .swatch = true, .swatch_color = color_value}) {
                action_count += 1
            }
        }

        if category == 9 {
            Text((TextProps){.bounds={x, y, 0, 0}, .text="PAGES AND SETTINGS", .font=Text20, .color=GetThemeLink(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds = {x,y + Scale(42),Scale(350),Scale(36)},.label = "Preview TitleBar and NavigationBar",.id = 965}) { page_preview = 1 }
            Page((PageProps){.bounds = {x,y + Scale(110),Scale(360),Scale(210)},.title = "Page",.gap = Scale(12),.padding = Scale(12),.key = 966})
            Section((SectionProps){.bounds = {0,0,Scale(336),Scale(180)},.label = "Section",.gap = Scale(12),.key = 967})
            Heading((HeadingProps){.bounds = {x + Scale(12),y + Scale(122),Scale(312),Scale(40)},.text = "Page / Section",.level = 2,.font = Text20,.color = GetThemeText(),.key = 968})
            ParagraphText((ParagraphTextProps){.bounds = {x + Scale(12),y + Scale(174),Scale(312),Scale(72)},.text = "Semantic page content using standard headings and paragraphs.",.font = Text16,.color = GetThemeText(),.key = 969})
            End()
            End()
            theme_changed: int = 0
            Text((TextProps){.bounds={right, y + Scale(80), 0, 0}, .text="Theme controls", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            if Button((ButtonProps){.bounds={right,y + Scale(110),Scale(340),Scale(36)},.label=TextFormat("Mode %d", theme_mode),.id=980,.tone=ButtonToneNeutral,.emphasis=ButtonEmphasisSoft}) {
                theme_mode += 1
                if theme_mode > THEME_MODE_DARK { theme_mode = THEME_MODE_SYSTEM }
                theme_changed = 1
            }
            if Button((ButtonProps){.bounds={right,y + Scale(158),Scale(340),Scale(36)},.label=TextFormat("Palette %d", theme_id),.id=981,.tone=ButtonToneNeutral,.emphasis=ButtonEmphasisSoft}) {
                theme_source = THEME_SOURCE_APP
                theme_id += 1
                if theme_id >= THEME_COUNT { theme_id = 0 }
                theme_changed = 1
            }
            if Button((ButtonProps){.bounds={right,y + Scale(206),Scale(340),Scale(36)},.label=TextFormat("Style %d", theme_style),.id=982,.tone=ButtonToneNeutral,.emphasis=ButtonEmphasisSoft}) {
                theme_style += 1
                if theme_style > THEME_STYLE_DEFAULT { theme_style = THEME_STYLE_SYSTEM }
                theme_changed = 1
            }
            if theme_changed {
                SetThemeSource((ThemeSource)theme_source)
                SetThemeMode((ThemeMode)theme_mode)
                SetThemeStyle((ThemeStyle)theme_style)
                dark_mode = GetEffectiveThemeDarkMode()
                SetCurrentTheme(theme_id, dark_mode)
            }
        }
        EndScrollContainer(area, view)

        if dialog == 1 {
            message_actions: [1] ModalAction = {{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
            if Modal((ModalProps){.title = "Message", .message = "A simple message dialog.", .actions = message_actions, .action_count = 1, .max_width = 420}) > 0 {
                dialog = 0
            }
        }
        if dialog == 2 {
            confirm_actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"OK",ButtonToneAccent,ButtonEmphasisFilled,0}}
            result: int = Modal((ModalProps){.title = "Confirm", .message = "Continue?", .actions = confirm_actions, .action_count = 2, .max_width = 460})
            if result != 0 { dialog_result = result; dialog = 0 }
        }
        if dialog == 3 {
            prompt_actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"Save",ButtonToneAccent,ButtonEmphasisFilled,0}}
            result: int = Modal((ModalProps){.title = "Prompt",.actions = prompt_actions,.action_count = 2,.max_width = 460,.text = text_value,.text_size = sizeof(text_value),.cursor_position = &text_cursor,.focused = &text_focused})
            if result != 0 { dialog_result = result; dialog = 0 }
        }
        if dialog == 5 {
            picker_actions: [4] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"One",ButtonToneNeutral,ButtonEmphasisSoft,0},{"Two",ButtonToneNeutral,ButtonEmphasisSoft,0},{"Three",ButtonToneAccent,ButtonEmphasisFilled,0}}
            picker_result: int = Modal((ModalProps){.title = "Choose an item",.message = "Pick an item.",.actions = picker_actions,.action_count = 4,.max_width = 360})
            if picker_result != 0 {
                if picker_result > 1 { picker_choice = picker_result - 2 }
                dialog = 0
            }
        }
        if dialog == 4 {
            actions: [2] ModalAction = {{"Cancel",ButtonToneNeutral,ButtonEmphasisSoft,0},{"Continue",ButtonToneAccent,ButtonEmphasisFilled,0}}
            if Modal((ModalProps){.title = "Action modal", .message = "Choose a simple action.", .actions = actions, .action_count = 2, .max_width = 420}) != 0 {
                dialog = 0
            }
        }
    }
}
