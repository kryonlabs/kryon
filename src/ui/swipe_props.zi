#import "geometry"

SwipeDirection :: enum {
    SwipeNone = 0
    SwipeLeft = 1
    SwipeRight = 2
    SwipeUp = 4
    SwipeDown = 8
    SwipeHorizontal = 3
    SwipeVertical = 12
    SwipeAll = 15
}

SwipeSpec :: struct {
    bounds: Rectangle
    directions: u32
    min_distance: float32
    axis_bias: float32
    max_duration: float32
}

SwipeGesture :: struct {
    active: s32
    dragging: s32
    cancelled: s32
    start: Vector2
    started_at: float64
}

SwipeFrame :: struct {
    pointer: Vector2
    pressed: bool
    down: bool
    released: bool
    input_clear: bool
    owner_clear: bool
    owner_is_swipe: bool
    now_seconds: float64
    scale: float32
}

SwipeResult :: struct {
    direction: SwipeDirection
    delta: Vector2
    progress: float32
    active: s32
    dragging: s32
    cancelled: s32
    gesture: SwipeGesture
    claim_pointer: bool
    release_pointer: bool
    capture_input: bool
    consume_release: bool
}
