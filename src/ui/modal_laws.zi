#import "modal"

// Laws for dismissing a modal. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// Only a release outside the panel that no one else took dismisses the
// modal, and dismissing takes the release; otherwise the release is left
// as it was.
#law OutsideReleaseDismisses custom ModalOutsideDismissalFor(true, false, false).dismissed && ModalOutsideDismissalFor(true, false, false).release_consumed;
#law OtherwiseStays forall released: 0..1, consumed: 0..1, inside: 0..1 => (B(released) && !B(consumed) && !B(inside)) || (!ModalOutsideDismissalFor(B(released), B(consumed), B(inside)).dismissed && ModalOutsideDismissalFor(B(released), B(consumed), B(inside)).release_consumed == B(consumed));
