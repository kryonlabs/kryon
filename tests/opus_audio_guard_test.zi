// Production decoder selection on the Linux null sink: Ogg Opus content goes
// to audio/opus whatever the asset is called; other content uses std decoders.
#import "media_audio_desktop"
native_provider: MediaAudioProvider;
#import "media_audio_host"
#import "media_audio"
#import "std/file"
#import "std/timer_linux"
Sink :: #import "std/audio_sink";
#import "std/byte_text_linux"
Load :: (voice: *MediaAudioVoice, asset: string, bytes: string) -> MediaAudioResult {
    return native_provider(voice, .{.operation = .Load, .voice = 1, .asset = asset, .gain = 0.5, .music = true}, bytes)
}
// Arguments: a valid Ogg Opus file, then an Ogg file whose first packet is not OpusHead.
#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    if argc != 3 { return 1 }
    opus, opus_ok := ReadEntireFile(TextFromCString(argv[1]))
    other, other_ok := ReadEntireFile(TextFromCString(argv[2]))
    if !opus_ok || !other_ok { return 2 }
    MediaAudioUseDesktop()
    unused Sink.AudioSinkOpen()
    deadline := MonotonicMilliseconds() + 3000
    while Sink.AudioSinkPending() && MonotonicMilliseconds() < deadline { unused SleepMilliseconds(1) }
    native_provider = media_audio_provider
    voice: MediaAudioVoice
    // Content selects Opus even when the asset name ends in .wav.
    loaded := Load(*voice, "assets/test/voice.wav", opus)
    if loaded.code != .Ok || loaded.state != .Ready { return 6 }
    if native_provider(*voice, .{.operation = .Play, .voice = 1}, "").state != .Playing { return 8 }
    if native_provider(*voice, .{.operation = .Status, .voice = 1}, "").code != .Ok { return 9 }
    if native_provider(*voice, .{.operation = .SubmitStream, .voice = 1}, "").code != .Invalid { return 10 }
    if native_provider(*voice, .{.operation = .Unload, .voice = 1}, "").code != .Ok || voice.resource != null { return 11 }
    // Invalid Ogg and non-Ogg content fail without retaining resources.
    if Load(*voice, "assets/test/other.ogg", other).code != .Failed || voice.resource != null { return 12 }
    if Load(*voice, "assets/test/fake.opus", "not decoded as Opus").code != .Failed || voice.resource != null { return 13 }
    // Invalid Ogg Opus content fails in the Opus decoder and leaks nothing.
    broken := opus[0:opus.count - 9]
    if Load(*voice, "assets/test/broken.opus", broken).code == .Ok || voice.resource != null { return 14 }
    print("Ogg Opus content routing, production load/play/unload and invalid-input cleanup passed\n")
    return 0
}
