#import "control_props"
#import "drawing_props"
#import "font_metrics"
#import "geometry"
#import "paint_queue"
#import "plot"
#import "plot_props"
#import "style"
#import "style_sheet"
#import "surface"
#import "tree"
#import "widget_kind"

PlotFaces :: struct {
    plot: StyleFrame
    mark: StyleFrame
}

#program_export
DefaultPlotFaces :: () -> PlotFaces {
    faces: PlotFaces
    faces.plot.value.fields = cast(u32)StyleBackground |
        cast(u32)StyleForeground | cast(u32)StyleBorder |
        cast(u32)StyleBorderWidth | cast(u32)StyleRadius |
        cast(u32)StyleFontSize | cast(u32)StylePaddingX |
        cast(u32)StylePaddingY | cast(u32)StyleOpacity
    faces.plot.value.background = cast(u32)0xf5f5f5ff
    faces.plot.value.foreground = cast(u32)0x171717ff
    faces.plot.value.border = cast(u32)0x737373ff
    faces.plot.value.border_width = 1.0
    faces.plot.value.radius = 4.0
    faces.plot.value.font_size = 14.0
    faces.plot.value.padding_x = 6.0
    faces.plot.value.padding_y = 4.0
    faces.plot.value.opacity = 1.0
    faces.mark.value.fields = cast(u32)StyleBackground |
        cast(u32)StyleOpacity
    faces.mark.value.background = cast(u32)0x3b609bff
    faces.mark.value.opacity = 1.0
    return faces
}

#program_export
PlotFacesFor :: (rules: StyleRules, props: PlotProps,
    defaults: PlotFaces) -> PlotFaces {
    faces: PlotFaces = defaults
    plot_facts: StyleFacts = StyleControlRoleFacts(StyleKindPlot(),
        props.id, props.class_name, StyleAny(),
        cast(s32)ButtonToneNeutral, cast(s32)ButtonEmphasisFilled,
        cast(s32)ControlSizeMedium, cast(s32)ButtonStateNormal)
    mark_facts: StyleFacts = StyleControlRoleFacts(StyleKindPlotMark(),
        props.id, props.class_name, StyleAny(),
        cast(s32)ButtonToneAccent, cast(s32)ButtonEmphasisFilled,
        cast(s32)ControlSizeMedium, cast(s32)ButtonStateNormal)
    faces.plot.value = ResolveStyleRules(rules, defaults.plot.value,
        plot_facts, cast(s32)ButtonStateNormal)
    faces.mark.value = ResolveStyleRules(rules, defaults.mark.value,
        mark_facts, cast(s32)ButtonStateNormal)
    return faces
}

#program_export
PlotObservedRange :: (values: []float32,
    offset: s32, props: PlotProps) -> PlotRange {
    offset = PlotOffset((cast(s32)values.count), offset)
    observed_min: float32 = 0.0
    observed_max: float32 = 0.0
    if (cast(s32)values.count) > 0 {
        observed_min = values[offset]
        observed_max = observed_min
        index: s32 = 1
        while index < (cast(s32)values.count) {
            value: float32 = values[(offset + index) % (cast(s32)values.count)]
            if value < observed_min { observed_min = value }
            if value > observed_max { observed_max = value }
            index += 1
        }
    }
    return PlotRangeFor(props.scale_min, props.scale_max,
        observed_min, observed_max)
}

# Values are borrowed for this frame. The retained node keeps only its key,
# bounds, and semantic label; the caller supplies the next frame's values.
#program_export
Plot :: (props: PlotProps, values: []float32) -> s32 {
    bounds: Rectangle = props.bounds
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return -1 }
    key: u64 = props.key
    if key == cast(u64)0 && props.id > 0 { key = cast(u64)cast(u32)props.id }
    if key == cast(u64)0 { key = TreeNextKey() }
    node: s32 = -1
    if TreeIsBuilding() {
        node = TreeSubmitCurrent(key, WidgetKindPlot, bounds)
        if node < 0 { return -1 }
        TreeSetLabel(node, props.label)
        bounds = TreeSubmittedNodeAt(node).bounds
    }
    faces: PlotFaces = PlotFacesFor(ActiveStyleRules(), props,
        DefaultPlotFaces())
    opacity: float32 = StyleOpacityValue(faces.plot.value.fields,
        faces.plot.value.opacity)
    PaintRoundedFill(node, bounds, faces.plot.value.radius, 12,
        ColorFromPacked(Opacity(faces.plot.value.background, opacity)))
    if faces.plot.value.border_width > 0.0 {
        PaintRoundedOutline(node, bounds, faces.plot.value.radius, 12,
            faces.plot.value.border_width,
            ColorFromPacked(Opacity(faces.plot.value.border, opacity)))
    }
    if (cast(s32)values.count) > 0 {
        offset: s32 = PlotOffset((cast(s32)values.count), props.offset)
        value_range: PlotRange = PlotObservedRange(values, offset, props)
        mark_color: Color = ColorFromPacked(Opacity(
            faces.mark.value.background,
            StyleOpacityValue(faces.mark.value.fields,
                faces.mark.value.opacity)))
        index: s32 = 0
        if props.mode == cast(PlotMode)PlotBars {
            while index < (cast(s32)values.count) {
                mark: PlotMark = PlotHistogramBar(bounds, index,
                    (cast(s32)values.count), values[(offset + index) % (cast(s32)values.count)],
                    value_range, faces.mark)
                if mark.bounds.width > 0.0 && mark.bounds.height > 0.0 {
                    PaintRoundedFill(node, mark.bounds, 0.0, 0, mark_color)
                }
                index += 1
            }
        } else if (cast(s32)values.count) == 1 {
            mark: PlotMark = PlotSingleLine(bounds, values[offset],
                value_range, faces.mark)
            PaintLine(node, mark.bounds, mark_color)
        } else {
            index = 1
            while index < (cast(s32)values.count) {
                a: float32 = values[(offset + index - 1) % (cast(s32)values.count)]
                b: float32 = values[(offset + index) % (cast(s32)values.count)]
                mark: PlotMark = PlotLineSegment(bounds, index,
                    (cast(s32)values.count), a, b, value_range, faces.mark)
                PaintLine(node, mark.bounds, mark_color)
                index += 1
            }
        }
    }
    if props.label != "" || props.overlay != "" {
        font: s32 = ResolveFont(0,
            StyleFontValue(faces.plot.value.fields,
                faces.plot.value.font_size), 14)
        label_width: float32 = 0.0
        overlay_width: float32 = 0.0
        if props.label != "" {
            label_width = cast(float32)GlyphWidth(props.label, font,
                faces.plot.value.typeface)
        }
        if props.overlay != "" {
            overlay_width = cast(float32)GlyphWidth(props.overlay, font,
                faces.plot.value.typeface)
        }
        paint: PlotTextPaint = PlotTextPaintFor(bounds, label_width,
            overlay_width, props.scale, faces.plot,
            props.label != "", props.overlay != "")
        text_color: Color = ColorFromPacked(Opacity(paint.text_color,
            opacity))
        if paint.show_label {
            PaintClippedLabel(node, props.label,
                cast(s32)paint.label_bounds.x,
                cast(s32)paint.label_bounds.y, font, text_color, bounds)
        }
        if paint.show_overlay {
            PaintClippedLabel(node, props.overlay,
                cast(s32)paint.overlay_bounds.x,
                cast(s32)paint.overlay_bounds.y, font, text_color, bounds)
        }
    }
    return node
}
