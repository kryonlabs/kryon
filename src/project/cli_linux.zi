#import "options"

// Linux command-line host for Kryon projects. Configuration and command
// selection are Ziran; libc supplies only file, stdout, and process effects.
libc :: #system_library "libc";
RawOpen :: (path: *u8, flags: s32) -> s32 #foreign libc "open";
RawRead :: (fd: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
RawWrite :: (fd: s32, input: *u8, count: u64) -> s64 #foreign libc "write";
RawClose :: (fd: s32) -> s32 #foreign libc "close";
RawIsTty :: (fd: s32) -> s32 #foreign libc "isatty";
RawExec :: (name: *u8, arguments: *PointerSlot) -> s32 #foreign libc "execvp";
RawSetenv :: (name: *u8, value: *u8, overwrite: s32) -> s32 #foreign libc "setenv";
RawGetenv :: (name: *u8) -> *u8 #foreign libc "getenv";
CopyDescriptor :: (source: *TextDescriptor, destination: *string,
    count: u64) -> void #foreign libc "bcopy";

TextDescriptor :: struct {
    data: *u8
    length: u64
}

PointerSlot :: struct {
    value: *u8
}

ArgumentBytes :: struct {
    data: [4096]u8
}

FileContents :: struct {
    text: string
    ok: bool
}

TextFromBuffer :: (bytes: []u8, length: s32) -> string {
    if length < 0 || length > cast(s32)bytes.count { return "" }
    descriptor: TextDescriptor
    descriptor.data = *bytes[0]
    descriptor.length = cast(u64)length
    result: string = ""
    CopyDescriptor(*descriptor, *result, size_of(TextDescriptor))
    return result
}

Environment :: (name: string, output: []u8) -> string {
    name_bytes: [128]u8
    if !CString(name, name_bytes[:]) { return "" }
    value: *u8 = RawGetenv(*name_bytes[0])
    if value == null { return "" }
    length: s32 = 0
    while value[length] != cast(u8)0 {
        if length >= cast(s32)output.count { return "" }
        output[length] = value[length]
        length += 1
    }
    return TextFromBuffer(output, length)
}

CString :: (value: string, output: []u8) -> bool {
    if value.count >= output.count { return false }
    at: s32 = 0
    while at < cast(s32)value.count {
        output[at] = value[at]
        at += 1
    }
    output[at] = cast(u8)0
    return true
}

Join :: (first: string, second: string, output: []u8) -> string {
    count: s32 = cast(s32)first.count + cast(s32)second.count
    if count >= cast(s32)output.count { return "" }
    at: s32 = 0
    while at < cast(s32)first.count {
        output[at] = first[at]
        at += 1
    }
    index: s32 = 0
    while index < cast(s32)second.count {
        output[at] = second[index]
        at += 1
        index += 1
    }
    return TextFromBuffer(output, count)
}

PrintFd :: (fd: s32, value: string) -> bool {
    bytes: [4096]u8
    at: s32 = 0
    while at < cast(s32)value.count {
        count: s32 = cast(s32)value.count - at
        if count > 4096 { count = 4096 }
        index: s32 = 0
        while index < count {
            bytes[index] = value[at + index]
            index += 1
        }
        written: s64 = RawWrite(fd, *bytes[0], cast(u64)count)
        if written <= 0 { return false }
        at += cast(s32)written
    }
    return true
}

Error :: (message: string) -> s32 {
    PrintFd(2, "kryon: ")
    PrintFd(2, message)
    PrintFd(2, "\n")
    return 2
}

ReadFile :: (path: string, output: []u8) -> FileContents {
    result: FileContents
    name: [4096]u8
    if !CString(path, name[:]) { return result }
    fd: s32 = RawOpen(*name[0], 0)
    if fd < 0 { return result }
    length: s32 = 0
    while length < cast(s32)output.count {
        count: s64 = RawRead(fd, *output[length],
            cast(u64)(cast(s32)output.count - length))
        if count < 0 {
            RawClose(fd)
            return result
        }
        if count == 0 {
            result.ok = true
            break
        }
        length += cast(s32)count
    }
    if length == cast(s32)output.count {
        extra: u8 = cast(u8)0
        result.ok = RawRead(fd, *extra, 1) == 0
    }
    RawClose(fd)
    if result.ok { result.text = TextFromBuffer(output, length) }
    return result
}

SetEnvironment :: (name: string, value: string) -> bool {
    name_bytes: [128]u8
    value_bytes: [4096]u8
    if !CString(name, name_bytes[:]) || !CString(value, value_bytes[:]) { return false }
    return RawSetenv(*name_bytes[0], *value_bytes[0], 1) == 0
}

Exists :: (path: string) -> bool {
    name: [4096]u8
    if !CString(path, name[:]) { return false }
    fd: s32 = RawOpen(*name[0], 0)
    if fd < 0 { return false }
    RawClose(fd)
    return true
}

Execute :: (arguments: []string) -> s32 {
    if arguments.count == 0 || arguments.count > 16 { return 127 }
    storage: [17]ArgumentBytes
    pointers: [18]PointerSlot
    at: s32 = 0
    while at < cast(s32)arguments.count {
        if !CString(arguments[at], storage[at].data[:]) { return 127 }
        pointers[at].value = *storage[at].data[0]
        at += 1
    }
    pointers[at].value = null
    RawExec(*storage[0].data[0], *pointers[0])
    return 127
}

// Argument index of a NUL-separated command line, as a view of it.
ArgumentAt :: (command_line: string, wanted: s32) -> string {
    current: s32 = 0
    start: s32 = 0
    at: s32 = 0
    while at < cast(s32)command_line.count {
        if command_line[at] == cast(u8)0 {
            if current == wanted { return command_line[start:at] }
            current += 1
            start = at + 1
        }
        at += 1
    }
    return ""
}

ArgumentCount :: (command_line: string) -> s32 {
    count: s32 = 0
    at: s32 = 0
    while at < cast(s32)command_line.count {
        if command_line[at] == cast(u8)0 { count += 1 }
        at += 1
    }
    return count
}

BackendDescription :: (backend: string) -> string {
    if backend == "desktop" { return "SDL2/Cairo window" }
    if backend == "raylib" { return "raylib window" }
    if backend == "libdraw" { return "libdraw window" }
    if backend == "canvas" { return "Canvas2D browser page" }
    if backend == "dom" { return "semantic DOM browser page" }
    if backend == "terminal" { return "terminal" }
    return backend
}

ChooseProfile :: (config: ProjectConfig) -> s32 {
    PrintFd(1, "Choose a profile:\n")
    index: s32 = 0
    while index < config.profile_count {
        digit: [1]u8
        digit[0] = cast(u8)(49 + index)
        PrintFd(1, "  ")
        PrintFd(1, TextFromBuffer(digit[:], 1))
        PrintFd(1, ") ")
        PrintFd(1, config.profiles[index].name)
        PrintFd(1, " (")
        PrintFd(1, BackendDescription(config.profiles[index].backend))
        PrintFd(1, ")\n")
        index += 1
    }
    PrintFd(1, "Selection: ")
    chosen: u8 = cast(u8)0
    extra: bool = false
    while true {
        byte: u8 = cast(u8)0
        if RawRead(0, *byte, 1) != 1 { break }
        if byte == cast(u8)10 || byte == cast(u8)13 { break }
        if chosen == cast(u8)0 {
            chosen = byte
        } else {
            extra = true
        }
    }
    if RawIsTty(0) == 0 { PrintFd(1, "\n") }
    if extra { return -1 }
    index = cast(s32)chosen - 49
    if index < 0 || index >= config.profile_count { return -1 }
    return index
}

ListProfiles :: (config: ProjectConfig) -> s32 {
    index: s32 = 0
    while index < config.profile_count {
        profile: ProjectProfile = config.profiles[index]
        if profile.name == config.default_profile { PrintFd(1, "* ") }
        else { PrintFd(1, "  ") }
        PrintFd(1, profile.name)
        PrintFd(1, "  ")
        PrintFd(1, BackendDescription(profile.backend))
        PrintFd(1, "\n")
        index += 1
    }
    return 0
}

Usage :: () -> s32 {
    PrintFd(1, "usage: kryon new DIR [--template NAME|SOURCE[:NAME]] [--name NAME]\n")
    PrintFd(1, "       kryon init [--template NAME|SOURCE[:NAME]]\n")
    PrintFd(1, "       kryon run|build|check [PROFILE | --profile NAME]\n")
    PrintFd(1, "       kryon install [--prefix DIR]\n")
    PrintFd(1, "       kryon profiles\n")
    PrintFd(1, "Kryon templates: app (window), tui (terminal), pages (navigation), web (browser page)\n")
    return 0
}

KryonTemplates :: "https://github.com/kryonlabs/kryon.git";

// A bare template name is one of Kryon's; anything else names its own
// package, as ziran new does.
TemplateSpec :: (value: string, base: string, output: []u8) -> string {
    at: s32 = 0
    plain: bool = value.count > 0 && value[0] != cast(u8)46
    while at < cast(s32)value.count {
        if value[at] == cast(u8)47 || value[at] == cast(u8)58 { plain = false }
        at += 1
    }
    if !plain { return value }
    joined_bytes: [4096]u8
    joined: string = Join(base, ":", joined_bytes[:])
    if joined == "" { return "" }
    return Join(joined, value, output)
}

// Outside `ziran tool Kryon`, kryon is a front door: project commands go
// through ziran, which runs the Kryon the project's ziran.lock pins, and
// new and init start projects from Kryon's templates.
FrontDoor :: (command_line: string, verb: string) -> s32 {
    guard_bytes: [8]u8
    if Environment("KRYON_FRONT_DOOR", guard_bytes[:]) == "1" {
        return Error("ziran tool Kryon started kryon without project settings")
    }
    if !SetEnvironment("KRYON_FRONT_DOOR", "1") { return Error("cannot set the environment") }
    count: s32 = ArgumentCount(command_line)
    if count > 14 { return Error("too many arguments") }
    args: [16]string
    used: s32 = 0
    args[used] = "ziran"
    used += 1
    base_bytes: [4096]u8
    base: string = Environment("KRYON_TEMPLATES", base_bytes[:])
    if base == "" { base = KryonTemplates }
    spec_bytes: [4096]u8
    if verb == "new" || verb == "init" {
        args[used] = verb
        used += 1
        templated: bool = false
        index: s32 = 2
        while index < count {
            part: string = ArgumentAt(command_line, index)
            args[used] = part
            used += 1
            if part == "--template" && index + 1 < count {
                templated = true
                args[used] = TemplateSpec(ArgumentAt(command_line, index + 1),
                    base, spec_bytes[:])
                if args[used] == "" { return Error("template name is too long") }
                used += 1
                index += 1
            }
            index += 1
        }
        if !templated {
            args[used] = "--template"
            used += 1
            args[used] = TemplateSpec("app", base, spec_bytes[:])
            used += 1
        }
    } else {
        if verb == "install" {
            args[used] = "install"
            used += 1
        } else {
            args[used] = "tool"
            args[used + 1] = "Kryon"
            args[used + 2] = verb
            used += 3
        }
        index: s32 = 2
        while index < count {
            args[used] = ArgumentAt(command_line, index)
            used += 1
            index += 1
        }
    }
    Execute(args[0:used])
    return Error("cannot run ziran; install it with make install-user in the Ziran repository")
}

#program_export
main :: () -> s32 {
    command_bytes: [8192]u8
    command_line: FileContents = ReadFile("/proc/self/cmdline", command_bytes[:])
    if !command_line.ok { return Error("cannot read command arguments") }
    verb: string = ArgumentAt(command_line.text, 1)
    if verb == "help" || verb == "--help" || verb == "-h" || verb == "" {
        return Usage()
    }
    if verb != "run" && verb != "build" && verb != "check" && verb != "install" &&
        verb != "profiles" && verb != "new" && verb != "init" {
        return Error("unknown command; use new, init, run, build, check, install, or profiles")
    }
    options_path_bytes: [4096]u8
    options_path: string = Environment("ZIRAN_TOOL_OPTIONS", options_path_bytes[:])
    if options_path == "" { return FrontDoor(command_line.text, verb) }
    if verb == "new" || verb == "init" {
        return Error("kryon new and init start projects; run them outside ziran tool")
    }
    profile_name: string = ""
    option: string = ArgumentAt(command_line.text, 2)
    if option == "--profile" {
        profile_name = ArgumentAt(command_line.text, 3)
        if profile_name == "" || ArgumentAt(command_line.text, 4) != "" {
            return Error("expected exactly one profile name")
        }
    } else if ProjectStarts(option, "--profile=") {
        profile_name = option[10:cast(s32)option.count]
        if profile_name == "" || ArgumentAt(command_line.text, 3) != "" {
            return Error("expected exactly one profile name")
        }
    } else if option != "" && option[0] != cast(u8)45 && verb != "profiles" {
        // kryon run desktop
        profile_name = option
        if ArgumentAt(command_line.text, 3) != "" {
            return Error("expected exactly one profile name")
        }
    } else if option != "" {
        return Error("unknown option")
    }

    name_env_bytes: [128]u8
    entry_env_bytes: [4096]u8
    options_bytes: [32768]u8
    file: FileContents = ReadFile(options_path, options_bytes[:])
    if !file.ok { return Error("cannot read the options ziran resolved") }
    config: ProjectConfig = ParseProject(file.text,
        Environment("ZIRAN_PROJECT_NAME", name_env_bytes[:]),
        Environment("ZIRAN_PROJECT_ENTRY", entry_env_bytes[:]))
    if !config.ok { return Error(config.error) }
    if verb == "profiles" { return ListProfiles(config) }
    installed_kryon_bytes: [4096]u8
    installed_ziran_bytes: [4096]u8
    package_id_bytes: [128]u8
    installed_kryon: string = Environment("ZIRAN_PACKAGE_ROOT", installed_kryon_bytes[:])
    installed_ziran: string = Environment("ZIRAN_TOOLCHAIN_ROOT", installed_ziran_bytes[:])
    package_id: string = Environment("ZIRAN_PACKAGE_ID", package_id_bytes[:])
    if installed_kryon == "" || installed_ziran == "" || package_id == "" {
        return Error("run this command through ziran tool Kryon")
    }
    if profile_name == "" && verb == "install" {
        profile_name = config.install.profile
    }
    if profile_name == "" {
        if verb == "run" && config.profile_count > 1 && RawIsTty(0) != 0 {
            chosen_profile: s32 = ChooseProfile(config)
            if chosen_profile < 0 { return Error("invalid profile selection") }
            profile_name = config.profiles[chosen_profile].name
        } else {
            profile_name = config.default_profile
        }
    }
    if verb == "install" {
        prefix_bytes: [4096]u8
        bin_bytes: [128]u8
        if Environment("ZIRAN_INSTALL_PREFIX", prefix_bytes[:]) == "" {
            return Error("run this command through ziran install")
        }
        if !ProjectNameValid(Environment("ZIRAN_INSTALL_BIN", bin_bytes[:])) {
            return Error("invalid install bin name")
        }
        // The install rule reads these as shell variables, never as make
        // syntax, so desktop text cannot change the recipe.
        autostart: string = "false"
        if config.install.autostart { autostart = "true" }
        if !SetEnvironment("KRYON_INSTALL_NAME", config.install.name) ||
        !SetEnvironment("KRYON_INSTALL_COMMENT", config.install.comment) ||
        !SetEnvironment("KRYON_INSTALL_ICON", config.install.icon) ||
        !SetEnvironment("KRYON_INSTALL_CATEGORIES", config.install.categories) ||
        !SetEnvironment("KRYON_INSTALL_DIRECTORY",
            config.install.working_directory) ||
        !SetEnvironment("KRYON_INSTALL_AUTOSTART", autostart) ||
        !SetEnvironment("KRYON_INSTALL_AUTOSTART_ENV",
            config.install.autostart_env) {
            return Error("cannot pass install options")
        }
    }
    profile: ProjectProfile = ProjectProfileNamed(config, profile_name)
    if profile.name == "" { return Error("unknown profile") }
    if (profile.backend != "terminal" && profile.backend != "desktop" &&
        profile.backend != "libdraw" && profile.backend != "raylib" &&
        profile.backend != "canvas" && profile.backend != "dom") ||
    profile.codegen != "c99" {
        return Error("this backend/codegen pair is not available yet")
    }
    makefile_bytes: [4096]u8
    makefile: string = Join(installed_kryon,
        "/mk/ziran-project.mk", makefile_bytes[:])
    if makefile == "" || !Exists(makefile) { return Error("Kryon build rules not found") }
    ziran_tool_bytes: [4096]u8
    ziran_tool: string = Join(installed_ziran,
        "/Makefile", ziran_tool_bytes[:])
    if ziran_tool == "" || !Exists(ziran_tool) {
        return Error("Ziran checkout not found")
    }
    if !Exists(config.entry) { return Error("project entry not found") }

    name_bytes: [4096]u8
    entry_bytes: [4096]u8
    backend_bytes: [4096]u8
    codegen_bytes: [4096]u8
    selected_bytes: [4096]u8
    kryon_bytes: [4096]u8
    ziran_bytes: [4096]u8
    library_bytes: [4096]u8
    static_archive_bytes: [4096]u8
    args: [15]string
    args[0] = "make"
    args[1] = "--silent"
    args[2] = "--no-print-directory"
    args[3] = "-f"
    args[4] = makefile
    args[5] = verb
    args[6] = Join("PROJECT_NAME=", config.name, name_bytes[:])
    args[7] = Join("PROJECT_ENTRY=", config.entry, entry_bytes[:])
    args[8] = Join("PROJECT_BACKEND=", profile.backend, backend_bytes[:])
    args[9] = Join("PROJECT_CODEGEN=", profile.codegen, codegen_bytes[:])
    args[10] = Join("PROJECT_PROFILE=", profile.name, selected_bytes[:])
    args[11] = Join("KRYON_DIR=", installed_kryon, kryon_bytes[:])
    args[12] = Join("ZIRAN_DIR=", installed_ziran, ziran_bytes[:])
    args[13] = Join("PROJECT_LIBRARY=", profile.library, library_bytes[:])
    args[14] = Join("PROJECT_STATIC_ARCHIVE=", profile.static_archive,
        static_archive_bytes[:])
    at: s32 = 6
    while at < 15 {
        if args[at] == "" { return Error("project path or value is too long") }
        at += 1
    }
    return Execute(args[:])
}
