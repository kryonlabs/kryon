#module "progress_raster"
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "progress"

# The host rasterizes these primitives; draw order and color choices are Ziran.
PaintProgressForNode :: (node: i32, bounds: Rectangle,
    paint: ProgressPaint, label: string, font: i32,
    label_opacity: float) #export {
    plan: ProgressDrawPlan = ProgressDrawPlanFor(bounds, paint,
        label != "", label_opacity)
    PaintRoundedFill(node, bounds, plan.radius, 12,
        ColorFromPacked(paint.track_color))
    if plan.draw_fill {
        PaintRoundedFill(node, paint.layout.fill_bounds, plan.radius, 12,
            ColorFromPacked(paint.fill_color))
    }
    if plan.draw_border {
        PaintRoundedOutline(node, bounds, plan.radius, 12,
            paint.border_width,
            ColorFromPacked(paint.border_color))
    }
    if plan.draw_label {
        PaintLabel(node, label, (i32)paint.layout.label_x,
            (i32)paint.layout.label_y, font,
            ColorFromPacked(plan.label_color))
    }
}

PaintProgress :: (bounds: Rectangle, paint: ProgressPaint,
    label: string, font: i32, label_opacity: float) #export {
    PaintProgressForNode(-1, bounds, paint, label,
        font, label_opacity)
}
