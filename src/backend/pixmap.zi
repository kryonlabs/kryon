#import "drawing_props"
#import "geometry"
#import "utf8"
#import "pixmap_text"
ImageCanvas :: #import "image_canvas";
Metrics :: #import "font_metrics";
#import "math"

#if #defined(POSIX_THREADS) {
    Workers :: #import "std/parallel_linux";
    pixmap_workers: Workers.ParallelPool;
    PixmapRowProcedure :: #type (start: s64, end: s64, argument: *void) #c_call;
    PixmapRowWork :: struct { procedure: PixmapRowProcedure; argument: *void }
    PixmapRunRows :: (start: s64, end: s64, argument: *void) {
        work := cast(*PixmapRowWork)argument; work.procedure(start, end, work.argument)
    }
    // The frame owner fixes the surface, clip and assets for each operation.
    // Workers write disjoint rows and join before the next ordered paint.
    PixmapRows :: (start: s32, end: s32, width: s32,
        procedure: PixmapRowProcedure, argument: *void, independent: bool = true) {
        if end <= start || width <= 0 { return }
        // Small retained damage costs less than waking the pool.
        if independent && cast(s64)(end - start) * width >= 65536 {
            work: PixmapRowWork = .{procedure, argument}
            callback: Workers.RangeProcedure = PixmapRunRows
            Workers.ParallelRun(*pixmap_workers, cast(s64)start, cast(s64)end, callback, cast(*void)*work); return
        }
        procedure(cast(s64)start, cast(s64)end, argument)
    }
    PixmapClearRows :: (start: s64, end: s64, argument: *void) {
        data := cast(*PixmapClearRowsData)argument
        PixmapClearRange(cast(s32)start, cast(s32)end, data.*)
    }
    PixmapFillRows :: (start: s64, end: s64, argument: *void) {
        data := cast(*PixmapFillRowsData)argument
        PixmapFillRange(cast(s32)start, cast(s32)end, data.*)
    }
    PixmapImageRows :: (start: s64, end: s64, argument: *void) {
        data := cast(*PixmapImageRowsData)argument
        PixmapImageRange(cast(s32)start, cast(s32)end, data.*)
    }
}

// Call before unloading a native raster host. EndInto only drops the surface;
// keeping the idle pool alive between frames avoids creating threads again.
#program_export
PixmapCloseWorkers :: () {
    #if #defined(POSIX_THREADS) {
        Workers.ParallelClose(*pixmap_workers)
    }
}
#program_export
PixmapWorkerCount :: () -> s32 {
    #if #defined(POSIX_THREADS) {
        return pixmap_workers.workers + 1
    }
    return 1
}

// A headless host: Kryon paints a frame into this pixel buffer, and
// PixmapPresent prints it as a PPM image on standard output. The raster is
// integer arithmetic over the paint queue's values and text is drawn from
// Kryon's font outlines (pixmap_text), so every Ziran target -- C, C++, Go,
// Rust, Python, and the
// portable VM -- prints the same bytes for the same frame. That makes it both
// a screenshot profile (`kryon run shot > frame.ppm`) and a cross-target
// conformance check.

PixmapWidth :: 960;
PixmapHeight :: 600;
// The desktop host's background, so screenshots of both line up.
PixmapBackground :: 16317180;

pixmap_pixels: [576000]u32;
pixmap_surface: []u32 = pixmap_pixels[:];
pixmap_width: s32 = PixmapWidth;
pixmap_height: s32 = PixmapHeight;
// Opaque ARGB hosts can write their alpha byte with the color itself, rather
// than traversing every changed pixel again after painting. RGB surfaces use
// zero here; transparency still blends over the surface's RGB background.
pixmap_alpha: u32;
// Widget geometry stays in logical units; raster endpoints use device pixels.
// Measures deliberately remain logical, so density never changes wrapping.
pixmap_scale_x: float32 = 1.0;
pixmap_scale_y: float32 = 1.0;
#program_export
PixmapScale :: (x: float32, y: float32) -> bool {
    if !Finite32(x) || !Finite32(y) || x < 0.1 || y < 0.1 || x > 8.0 || y > 8.0 { return false }
    pixmap_scale_x = x; pixmap_scale_y = y; return true
}
PixmapDeviceBounds :: (bounds: Rectangle) -> Rectangle {
    return .{bounds.x * pixmap_scale_x, bounds.y * pixmap_scale_y,
        bounds.width * pixmap_scale_x, bounds.height * pixmap_scale_y}
}
PixmapDeviceFont :: (font: s32) -> s32 { return PixmapRound(cast(float32)font * pixmap_scale_y) }
// The host owns these decoded 0xAARRGGBB pixels and keeps them alive until
// clearing/replacing the slot. Image widgets still resolve an ordinary asset.
PixmapImageLimit :: 1024;
pixmap_image_paths: [PixmapImageLimit][256]u8;
pixmap_image_lengths: [PixmapImageLimit]s32;
pixmap_image_widths: [PixmapImageLimit]s32;
pixmap_image_heights: [PixmapImageLimit]s32;
// Hosts that retain rendered pixels can observe decoded asset replacements.
// Registration publishes borrowed storage even when its path and size match;
// a caller may have edited those pixels since its last registration.
pixmap_image_revision: u64;
#program_export
PixmapImageRevision :: () -> u64 { return pixmap_image_revision }
PixmapImagePixels :: struct { value: []u32 }
pixmap_image_pixels: [PixmapImageLimit]PixmapImagePixels;

#program_export
PixmapClearImage :: (slot: s32) {
    if slot < 0 || slot >= PixmapImageLimit { return }
    if pixmap_image_lengths[slot] > 0 { pixmap_image_revision += 1 }
    pixmap_image_lengths[slot] = 0; pixmap_image_widths[slot] = 0
    pixmap_image_heights[slot] = 0; pixmap_image_pixels[slot].value = pixmap_pixels[0:0]
}

PixmapImageIndex :: (path: string) -> s32 {
    if path.count == 0 || path.count >= 256 { return -1 }
    for slot: 0..PixmapImageLimit - 1 {
        if pixmap_image_lengths[slot] != path.count { continue }
        same := true
        for i: 0..cast(s32)path.count - 1 { if pixmap_image_paths[slot][i] != path[i] { same = false; break } }
        if same { return cast(s32)slot }
    }
    return -1
}

#program_export
PixmapSetImage :: (slot: s32, path: string, width: s32, height: s32, pixels: []u32) -> bool {
    if slot < 0 || slot >= PixmapImageLimit || path.count == 0 || path.count >= 256 ||
        width <= 0 || height <= 0 || width > 16384 || height > 16384 ||
        cast(s64)width * cast(s64)height > pixels.count { return false }
    for i: 0..cast(s32)path.count - 1 { if path[i] == cast(u8)0 { return false } }
    existing := PixmapImageIndex(path)
    if existing >= 0 && existing != slot { return false }
    for i: 0..cast(s32)path.count - 1 { pixmap_image_paths[slot][i] = path[i] }
    pixmap_image_lengths[slot] = cast(s32)path.count
    pixmap_image_widths[slot] = width; pixmap_image_heights[slot] = height
    pixmap_image_pixels[slot].value = pixels; pixmap_image_revision += 1; return true
}
// Pixels outside [clip_left, clip_right) x [clip_top, clip_bottom) are kept.
pixmap_clip_left: s32;
pixmap_clip_top: s32;
pixmap_clip_right: s32 = PixmapWidth;
pixmap_clip_bottom: s32 = PixmapHeight;
// A retained frame can restrict every raster effect to its damaged pixels.
// Per-command clips and ClipAll must never widen this outer clip.
pixmap_damage_active: bool;
pixmap_damage_left: s32;
pixmap_damage_top: s32;
pixmap_damage_right: s32;
pixmap_damage_bottom: s32;

#program_export
PixmapBegin :: (background: u32) {
    unused PixmapBeginInto(background, PixmapWidth, PixmapHeight, pixmap_pixels[:])
}

// Rasterize into caller-owned storage. Keep it alive until painting finishes;
// PixmapEndInto drops the borrowed surface before its owner can release it.
// Invalid dimensions/storage leave the current surface completely untouched.
#program_export
PixmapBeginInto :: (background: u32, width: s32, height: s32, pixels: []u32,
    opaque: bool = false) -> bool {
    if !PixmapResumeInto(width, height, pixels, opaque) { return false }
    background = background | pixmap_alpha
    clear: PixmapClearRowsData = .{background, 0, width}
    #if #defined(POSIX_THREADS) {
        procedure: PixmapRowProcedure = PixmapClearRows
        PixmapRows(0, height, width, procedure, cast(*void)*clear)
    } else {
        PixmapClearRange(0, height, clear)
    }
    PixmapClipAll()
    return true
}

// Rasterize into caller-owned storage that still holds the host's previous
// frame, without clearing it. A frame that paints its own background can
// then leave those pixels as they are when EndFrameRetained finds its paint
// unchanged. Invalid dimensions/storage leave the current surface untouched.
#program_export
PixmapResumeInto :: (width: s32, height: s32, pixels: []u32,
    opaque: bool = false) -> bool {
    if width <= 0 || height <= 0 || width > 16384 || height > 16384 { return false }
    count := cast(s64)width * cast(s64)height
    if count > pixels.count { return false }
    // The bundled outlines and logical advances are immutable. Declare their
    // lifetime once so widgets can retain layout across unchanged frames.
    if Metrics.GlyphMetricsRevision() == cast(u64)0 { Metrics.GlyphMetricsChanged() }
    pixmap_surface = pixels; pixmap_width = width; pixmap_height = height
    pixmap_alpha = ifx opaque then cast(u32)0xff000000 else cast(u32)0
    pixmap_damage_active = false
    PixmapClipAll()
    return true
}

#program_export
PixmapEndInto :: () {
    pixmap_surface = pixmap_pixels[:]; pixmap_width = PixmapWidth; pixmap_height = PixmapHeight
    pixmap_scale_x = 1.0; pixmap_scale_y = 1.0
    pixmap_alpha = cast(u32)0
    pixmap_damage_active = false
    PixmapClipAll()
}

PixmapClipAll :: () {
    pixmap_clip_left = 0
    pixmap_clip_top = 0
    pixmap_clip_right = pixmap_width
    pixmap_clip_bottom = pixmap_height
    if pixmap_damage_active {
        pixmap_clip_left = pixmap_damage_left; pixmap_clip_top = pixmap_damage_top
        pixmap_clip_right = pixmap_damage_right; pixmap_clip_bottom = pixmap_damage_bottom
    }
}

// Bounds are logical; the outer clip covers whole device pixels. Clear the
// damaged area before replay so removed and translucent paint cannot leave
// pixels from an earlier frame behind.
PixmapDamageBegin :: (bounds: Rectangle, background: u32, clear: bool = true) {
    bounds = PixmapDeviceBounds(bounds)
    pixmap_damage_left = FloorInteger(bounds.x); pixmap_damage_top = FloorInteger(bounds.y)
    pixmap_damage_right = CeilInteger(bounds.x + bounds.width)
    pixmap_damage_bottom = CeilInteger(bounds.y + bounds.height)
    if pixmap_damage_left < 0 { pixmap_damage_left = 0 }
    if pixmap_damage_top < 0 { pixmap_damage_top = 0 }
    if pixmap_damage_right > pixmap_width { pixmap_damage_right = pixmap_width }
    if pixmap_damage_bottom > pixmap_height { pixmap_damage_bottom = pixmap_height }
    pixmap_damage_active = true; PixmapClipAll()
    if !clear { return }
    background = background | pixmap_alpha
    clear_rows: PixmapClearRowsData = .{background, pixmap_clip_left, pixmap_clip_right}
    #if #defined(POSIX_THREADS) {
        procedure: PixmapRowProcedure = PixmapClearRows
        PixmapRows(pixmap_clip_top, pixmap_clip_bottom, pixmap_clip_right - pixmap_clip_left, procedure, cast(*void)*clear_rows)
    } else {
        PixmapClearRange(pixmap_clip_top, pixmap_clip_bottom, clear_rows)
    }
}

PixmapClearRowsData :: struct { background: u32; left: s32; right: s32 }
PixmapClearRange :: (start: s32, end: s32, data: PixmapClearRowsData) {
    surface := pixmap_surface; stride := pixmap_width
    for y: cast(s32)start..cast(s32)end - 1 {
        for at: y * stride + data.left..y * stride + data.right - 1 { surface[at] = data.background }
    }
}

PixmapDamageBounds :: () -> Rectangle {
    return .{cast(float32)pixmap_damage_left, cast(float32)pixmap_damage_top,
        cast(float32)(pixmap_damage_right - pixmap_damage_left),
        cast(float32)(pixmap_damage_bottom - pixmap_damage_top)}
}
PixmapDamageEnd :: () { pixmap_damage_active = false; PixmapClipAll() }

PixmapClipTo :: (clip: Rectangle) {
    PixmapClipPixels(PixmapDeviceBounds(clip))
}
PixmapClipPixels :: (clip: Rectangle) {
    pixmap_clip_left = PixmapRound(clip.x)
    pixmap_clip_top = PixmapRound(clip.y)
    pixmap_clip_right = PixmapRound(clip.x + clip.width)
    pixmap_clip_bottom = PixmapRound(clip.y + clip.height)
    if pixmap_clip_left < 0 { pixmap_clip_left = 0 }
    if pixmap_clip_top < 0 { pixmap_clip_top = 0 }
    if pixmap_clip_right > pixmap_width { pixmap_clip_right = pixmap_width }
    if pixmap_clip_bottom > pixmap_height { pixmap_clip_bottom = pixmap_height }
    if pixmap_damage_active {
        if pixmap_clip_left < pixmap_damage_left { pixmap_clip_left = pixmap_damage_left }
        if pixmap_clip_top < pixmap_damage_top { pixmap_clip_top = pixmap_damage_top }
        if pixmap_clip_right > pixmap_damage_right { pixmap_clip_right = pixmap_damage_right }
        if pixmap_clip_bottom > pixmap_damage_bottom { pixmap_clip_bottom = pixmap_damage_bottom }
    }
}

// Nearest integer, halves away from zero.
PixmapRound :: (value: float32) -> s32 {
    if value >= 0.0 { return cast(s32)(value + 0.5) }
    return -cast(s32)(0.5 - value)
}

PixmapMix :: (source: s32, destination: s32, alpha: s32) -> s32 {
    return (source * alpha + destination * (255 - alpha) + 127) / 255
}

// Blends color over one pixel; coverage is 0 to 255.
PixmapBlend :: (x: s32, y: s32, color: Color, coverage: s32) {
    if x < pixmap_clip_left || y < pixmap_clip_top ||
        x >= pixmap_clip_right || y >= pixmap_clip_bottom { return }
    alpha: s32 = cast(s32)color.a * coverage / 255
    if alpha <= 0 { return }
    index: s32 = y * pixmap_width + x
    // Full alpha mixes to the color itself.
    if alpha >= 255 {
        pixmap_surface[index] = (cast(u32)color.r << cast(u32)16) |
            (cast(u32)color.g << cast(u32)8) | cast(u32)color.b | pixmap_alpha
        return
    }
    old: u32 = pixmap_surface[index]
    red: s32 = PixmapMix(cast(s32)color.r, cast(s32)((old >> cast(u32)16) & cast(u32)255), alpha)
    green: s32 = PixmapMix(cast(s32)color.g, cast(s32)((old >> cast(u32)8) & cast(u32)255), alpha)
    blue: s32 = PixmapMix(cast(s32)color.b, cast(s32)(old & cast(u32)255), alpha)
    pixmap_surface[index] = (cast(u32)red << cast(u32)16) | (cast(u32)green << cast(u32)8) |
        cast(u32)blue | pixmap_alpha
}

// Whether a point in eighths of a pixel lies in the rounded rectangle
// [x0, x1) x [y0, y1) with corner radius r, all in whole pixels.
PixmapInside :: (px: s32, py: s32, x0: s32, y0: s32, x1: s32, y1: s32, r: s32) -> bool {
    left: s32 = x0 * 8
    top: s32 = y0 * 8
    right: s32 = x1 * 8
    bottom: s32 = y1 * 8
    if px < left || py < top || px >= right || py >= bottom { return false }
    reach: s32 = r * 8
    dx: s32 = 0
    if px < left + reach { dx = left + reach - px }
    else if px > right - reach { dx = px - (right - reach) }
    dy: s32 = 0
    if py < top + reach { dy = top + reach - py }
    else if py > bottom - reach { dy = py - (bottom - reach) }
    // A supported 16384-pixel surface can have an 8192-pixel radius;
    // its squared distance in eighths exceeds signed 32-bit storage.
    return cast(s64)dx * dx + cast(s64)dy * dy <= cast(s64)reach * reach
}

// How many of a pixel's 16 sample points lie in the rounded rectangle.
PixmapSamples :: (x: s32, y: s32, x0: s32, y0: s32, x1: s32, y1: s32, r: s32) -> s32 {
    // Bounds are whole pixels, so all sixteen samples are either inside
    // the rectangular bounds or outside them. Flat strips need no sampling.
    if x < x0 || x >= x1 || y < y0 || y >= y1 { return 0 }
    dx: s64
    if x < x0 + r { dx = (cast(s64)x0 + r - x) * 8 - 7 }
    else if x >= x1 - r { dx = (cast(s64)x - (x1 - r)) * 8 + 1 }
    else { return 16 }
    dy: s64
    if y < y0 + r { dy = (cast(s64)y0 + r - y) * 8 - 7 }
    else if y >= y1 - r { dy = (cast(s64)y - (y1 - r)) * 8 + 1 }
    else { return 16 }
    // Reflect a corner's grid into increasing distances from its centre.
    // Most corner pixels are wholly covered or empty. Only the narrow
    // antialiased edge needs to count the original 4x4 grid individually.
    reach := cast(s64)r * 8; square := reach * reach
    near_x := dx * dx; far_x := (dx + 6) * (dx + 6)
    if near_x + dy * dy > square { return 0 }
    if far_x + (dy + 6) * (dy + 6) <= square { return 16 }
    second_x := (dx + 2) * (dx + 2); third_x := (dx + 4) * (dx + 4)
    count: s32
    for row: cast(s32)0..3 {
        room := square - dy * dy
        if room < near_x { break }
        if far_x <= room { count += 4 }
        else {
            count += 1
            if second_x <= room { count += 1 }
            if third_x <= room { count += 1 }
        }
        dy += 2
    }
    return count
}

PixmapRadius :: (x0: s32, y0: s32, x1: s32, y1: s32, radius: s32) -> s32 {
    r: s32 = radius
    if r < 0 { r = 0 }
    if r * 2 > x1 - x0 { r = (x1 - x0) / 2 }
    if r * 2 > y1 - y0 { r = (y1 - y0) / 2 }
    return r
}

// The caller clips and checks a contiguous row once. Constant source alpha
// and channels apply to every pixel, so only destination channels vary.
// Pointer iteration remains bounded by the borrowed slice on every target.
PixmapFillSpan :: (span: []u32, color: Color) {
    alpha := cast(u32)color.a
    if alpha == cast(u32)0 { return }
    if alpha == cast(u32)255 {
        rgb := (cast(u32)color.r << cast(u32)16) |
            (cast(u32)color.g << cast(u32)8) | cast(u32)color.b | pixmap_alpha
        for *pixel: span { <<pixel = rgb }
        return
    }
    inverse := cast(u32)255 - alpha
    red_source := cast(u32)color.r * alpha + cast(u32)127
    green_source := cast(u32)color.g * alpha + cast(u32)127
    blue_source := cast(u32)color.b * alpha + cast(u32)127
    output_alpha := pixmap_alpha
    for *pixel: span {
        old := <<pixel
        red := (red_source + ((old >> cast(u32)16) & cast(u32)255) * inverse) / cast(u32)255
        green := (green_source + ((old >> cast(u32)8) & cast(u32)255) * inverse) / cast(u32)255
        blue := (blue_source + (old & cast(u32)255) * inverse) / cast(u32)255
        <<pixel = (red << cast(u32)16) | (green << cast(u32)8) | blue | output_alpha
    }
}

// Fills a rounded rectangle; corner pixels are anti-aliased from samples.
PixmapFillRounded :: (x0: s32, y0: s32, x1: s32, y1: s32, radius: s32, color: Color) {
    if x1 <= x0 || y1 <= y0 || color.a == cast(u8)0 { return }
    r: s32 = PixmapRadius(x0, y0, x1, y1, radius)
    top: s32 = y0
    if top < pixmap_clip_top { top = pixmap_clip_top }
    bottom: s32 = y1
    if bottom > pixmap_clip_bottom { bottom = pixmap_clip_bottom }
    left: s32 = x0
    if left < pixmap_clip_left { left = pixmap_clip_left }
    right: s32 = x1
    if right > pixmap_clip_right { right = pixmap_clip_right }
    if left >= right || top >= bottom { return }
    rows: PixmapFillRowsData = .{x0, y0, x1, y1, r, left, right, color}
    #if #defined(POSIX_THREADS) {
        procedure: PixmapRowProcedure = PixmapFillRows
        PixmapRows(top, bottom, right - left, procedure, cast(*void)*rows)
    } else {
        PixmapFillRange(top, bottom, rows)
    }
}
PixmapFillRowsData :: struct { x0: s32; y0: s32; x1: s32; y1: s32; radius: s32; left: s32; right: s32; color: Color }
PixmapFillRange :: (start: s32, end: s32, data: PixmapFillRowsData) {
    x0 := data.x0; y0 := data.y0; x1 := data.x1; y1 := data.y1; r := data.radius
    left := data.left; right := data.right; color := data.color
    surface := pixmap_surface; stride := pixmap_width
    y: s32 = cast(s32)start
    while y < cast(s32)end {
        corner_row: bool = y < y0 + r || y >= y1 - r
        row: s32 = y * stride
        x: s32 = left
        while x < right {
            // Only rounded corners need per-pixel coverage. Blend flat
            // interiors as spans even when their color is translucent.
            if !corner_row || (x >= x0 + r && x < x1 - r) {
                end: s32 = right
                if corner_row && end > x1 - r { end = x1 - r }
                // Check one contiguous row span instead of recalculating and
                // checking a global surface index for every opaque pixel.
                PixmapFillSpan(surface[row + x:row + end], color)
                x = end
                continue
            }
            if corner_row && (x < x0 + r || x >= x1 - r) {
                samples: s32 = PixmapSamples(x, y, x0, y0, x1, y1, r)
                if samples > 0 { PixmapBlend(x, y, color, samples * 255 / 16) }
            }
            x += 1
        }
        y += 1
    }
}

// Strokes a rounded rectangle's inside edge `width` pixels thick.
PixmapStrokeRounded :: (x0: s32, y0: s32, x1: s32, y1: s32, radius: s32,
    width: s32, color: Color) {
    if x1 <= x0 || y1 <= y0 { return }
    r: s32 = PixmapRadius(x0, y0, x1, y1, radius)
    w: s32 = width
    if w < 1 { w = 1 }
    ix0: s32 = x0 + w
    iy0: s32 = y0 + w
    ix1: s32 = x1 - w
    iy1: s32 = y1 - w
    inner: bool = ix1 > ix0 && iy1 > iy0
    ir: s32 = r - w
    if ir < 0 { ir = 0 }
    // Only pixels this close to an edge can be on the stroke.
    band: s32 = r
    if w > band { band = w }
    band += 1
    top: s32 = y0
    if top < pixmap_clip_top { top = pixmap_clip_top }
    bottom: s32 = y1
    if bottom > pixmap_clip_bottom { bottom = pixmap_clip_bottom }
    y: s32 = top
    while y < bottom {
        edge_row: bool = y < y0 + band || y >= y1 - band
        x: s32 = x0
        while x < x1 {
            if !edge_row && x >= x0 + band && x < x1 - band {
                x = x1 - band
                continue
            }
            if x >= pixmap_clip_left && x < pixmap_clip_right {
                samples: s32 = PixmapSamples(x, y, x0, y0, x1, y1, r)
                if inner && samples > 0 {
                    samples -= PixmapSamples(x, y, ix0, iy0, ix1, iy1, ir)
                }
                if samples > 0 { PixmapBlend(x, y, color, samples * 255 / 16) }
            }
            x += 1
        }
        y += 1
    }
}

// Wrapping repeatedly measures growing prefixes. The pixmap font is fixed,
// so keep owned bytes and font-independent advances, rather than decoding
// each prefix from its beginning. Revisit the final four units: a newly
// completed UTF-8 point or variation selector can change its preceding unit.
// Large values use the ordinary path and never retain borrowed storage.
PixmapMeasureBytes :: 32768;
pixmap_measure_bytes: [32768]u8;
pixmap_measure_count: s32 = -1;
pixmap_measure_units: s64;
pixmap_measure_restart: s32;
pixmap_measure_before: s64;
// Short labels recur across frames and are interleaved with other widgets.
// Own their bytes in a bounded direct cache; collisions always compare the
// complete content, and stored advances are independent of font size.
pixmap_label_bytes: [64][256]u8;
pixmap_label_lengths: [64]s32;
pixmap_label_units: [64]s64;
PixmapLabelSlot :: (value: string) -> s32 {
    key: u64 = 5381
    for i: 0..cast(s32)value.count - 1 { key = key * cast(u64)33 + cast(u64)value[i] }
    return cast(s32)(key & cast(u64)63)
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    bounded: bool = value.count <= PixmapMeasureBytes
    units: s64 = 0
    at: s32 = 0
    extending: bool = false
    if bounded && pixmap_measure_count >= 0 {
        if value.count == pixmap_measure_count &&
            value == TextView(pixmap_measure_bytes[:pixmap_measure_count]) {
            return PixmapTextWidth(pixmap_measure_units, font)
        }
        if value.count > pixmap_measure_count &&
            value[:pixmap_measure_count] == TextView(pixmap_measure_bytes[:pixmap_measure_count]) {
            at = pixmap_measure_restart
            units = pixmap_measure_before
            extending = true
        }
    }
    // Wrapping measures successively longer prefixes. Hashing and storing
    // each prefix costs quadratic byte work and evicts the ordinary labels.
    // The owned incremental prefix already proves which advances are reusable.
    label_slot: s32 = -1
    if !extending && value.count <= 256 {
        label_slot = PixmapLabelSlot(value)
        if pixmap_label_lengths[label_slot] == value.count &&
            TextView(pixmap_label_bytes[label_slot][:pixmap_label_lengths[label_slot]]) == value {
            return PixmapTextWidth(pixmap_label_units[label_slot], font)
        }
    }
    copied: s32 = at
    starts: [4]s32
    advances: [4]s64
    count: s32 = 0
    while at < cast(s32)value.count {
        starts[count % 4] = at
        advances[count % 4] = units
        count += 1
        unit: PixmapTextUnit = PixmapNextUnit(value, at)
        if unit.after <= at { break }
        at = unit.after
        units += unit.advance
    }
    if bounded {
        for i: copied..cast(s32)value.count - 1 { pixmap_measure_bytes[i] = value[i] }
        pixmap_measure_count = cast(s32)value.count
        pixmap_measure_units = units
        index: s32 = 0
        if count >= 4 { index = count % 4 }
        // A final ASCII byte is a complete unit: an appended selector can
        // affect that unit, but cannot complete an earlier UTF-8 sequence.
        if count > 0 && value.count > 0 && value[value.count - 1] < cast(u8)128 {
            index = (count - 1) % 4
        }
        pixmap_measure_restart = starts[index]
        pixmap_measure_before = advances[index]
    } else { pixmap_measure_count = -1 }
    if label_slot >= 0 {
        for i: 0..cast(s32)value.count - 1 { pixmap_label_bytes[label_slot][i] = value[i] }
        pixmap_label_lengths[label_slot] = cast(s32)value.count
        pixmap_label_units[label_slot] = units
    }
    return PixmapTextWidth(units, font)
}

// The line box is the font size, as on the other hosts.
#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    return font
}

// Draws a color emoji filling the size x size square at (x, y).
PixmapDrawEmoji :: (emoji: s32, x: s32, y: s32, size: s32) {
    offset: s32 = PixmapEmojiPixelsFor(emoji, size)
    if offset < 0 { return }
    color: Color
    color.a = cast(u8)255
    for row: 0..size - 1 {
        for column: 0..size - 1 {
            pixel: u32 = pixmap_emoji_pool[offset + cast(s32)row * size + cast(s32)column]
            alpha: s32 = cast(s32)(pixel >> cast(u32)24)
            if alpha > 0 {
                color.r = cast(u8)((pixel >> cast(u32)16) & cast(u32)255)
                color.g = cast(u8)((pixel >> cast(u32)8) & cast(u32)255)
                color.b = cast(u8)(pixel & cast(u32)255)
                PixmapBlend(x + cast(s32)column, y + cast(s32)row, color, alpha)
            }
        }
    }
}

// Clip a glyph once, then blend its contiguous mask and destination rows.
// Source channels and host alpha are constant; only coverage and the old
// RGB channels vary per pixel. No glyph-sized color cache is needed.
PixmapBlendMask :: (mask: PixmapGlyphMask, coverage: []u8, color: Color) {
    source_alpha := cast(u32)color.a
    if source_alpha == cast(u32)0 { return }
    top: s32 = mask.top
    if top < pixmap_clip_top { top = pixmap_clip_top }
    bottom: s32 = mask.top + mask.height
    if bottom > pixmap_clip_bottom { bottom = pixmap_clip_bottom }
    left: s32 = mask.left
    if left < pixmap_clip_left { left = pixmap_clip_left }
    right: s32 = mask.left + mask.width
    if right > pixmap_clip_right { right = pixmap_clip_right }
    if right <= left || bottom <= top { return }
    red_source := cast(u32)color.r
    green_source := cast(u32)color.g
    blue_source := cast(u32)color.b
    output_alpha := pixmap_alpha
    rgb := (red_source << cast(u32)16) | (green_source << cast(u32)8) | blue_source | output_alpha
    surface := pixmap_surface; stride := pixmap_width
    for y: top..bottom - 1 {
        row := (y - mask.top) * mask.width + left - mask.left
        at: s32 = 0
        for *pixel: surface[y * stride + left:y * stride + right] {
            alpha := cast(u32)coverage[row + at]; at += 1
            if source_alpha != cast(u32)255 { alpha = source_alpha * alpha / cast(u32)255 }
            if alpha == cast(u32)0 { continue }
            if alpha == cast(u32)255 { <<pixel = rgb; continue }
            inverse := cast(u32)255 - alpha
            old := <<pixel
            red := (red_source * alpha + ((old >> cast(u32)16) & cast(u32)255) * inverse + cast(u32)127) / cast(u32)255
            green := (green_source * alpha + ((old >> cast(u32)8) & cast(u32)255) * inverse + cast(u32)127) / cast(u32)255
            blue := (blue_source * alpha + (old & cast(u32)255) * inverse + cast(u32)127) / cast(u32)255
            <<pixel = (red << cast(u32)16) | (green << cast(u32)8) | blue | output_alpha
        }
    }
}

PixmapDrawText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    if font <= 0 { return }
    // A glyph stays well within two font sizes of its line box and advance,
    // so text past the clip draws nothing and is not rasterized.
    reach: s32 = font * 2
    if y + font + reach <= pixmap_clip_top || y - reach >= pixmap_clip_bottom { return }
    baseline: s64 = cast(s64)y * 256 + PixmapTextBaseline(font)
    pen: s64 = 0
    mask: PixmapGlyphMask
    at: s32 = 0
    while at < cast(s32)value.count {
        unit: PixmapTextUnit = PixmapNextUnit(value, at)
        if unit.after <= at { break }
        at = unit.after
        origin: s64 = cast(s64)x * 256 + PixmapUnits(pen, font)
        whole: s32 = cast(s32)PixmapFloorDiv(origin, 256)
        // Advances never move left, so no later glyph reaches the clip.
        if whole - reach >= pixmap_clip_right { break }
        if whole + PixmapTextWidth(unit.advance, font) + reach > pixmap_clip_left {
            if unit.emoji >= 0 {
                PixmapDrawEmoji(unit.emoji, whole, y, font)
            } else if unit.glyph >= 0 {
                coverage: []u8 = PixmapCachedGlyph(unit.glyph, origin, baseline, font, *mask)
                if coverage.count > 0 { PixmapBlendMask(mask, coverage, color) }
            }
        }
        pen += unit.advance
    }
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {
    PixmapDrawText(value, PixmapRound(cast(float32)x * pixmap_scale_x),
        PixmapRound(cast(float32)y * pixmap_scale_y), PixmapDeviceFont(font), color)
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32, color: Color,
    clip: Rectangle) {
    PixmapClipTo(clip)
    RasterText(value, x, y, font, color)
    PixmapClipAll()
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32,
    color: Color) {
    unused segments
    bounds = PixmapDeviceBounds(bounds); radius *= pixmap_scale_y
    PixmapFillRounded(PixmapRound(bounds.x), PixmapRound(bounds.y),
        PixmapRound(bounds.x + bounds.width), PixmapRound(bounds.y + bounds.height),
        PixmapRound(radius), color)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused segments
    bounds = PixmapDeviceBounds(bounds); radius *= pixmap_scale_y; width *= pixmap_scale_y
    PixmapStrokeRounded(PixmapRound(bounds.x), PixmapRound(bounds.y),
        PixmapRound(bounds.x + bounds.width), PixmapRound(bounds.y + bounds.height),
        PixmapRound(radius), PixmapRound(width), color)
}

// A one-pixel line from (x, y) to (x + width, y + height).
#program_export
RasterLine :: (line: Rectangle, color: Color) {
    line = PixmapDeviceBounds(line)
    x0: s32 = PixmapRound(line.x)
    y0: s32 = PixmapRound(line.y)
    x1: s32 = PixmapRound(line.x + line.width)
    y1: s32 = PixmapRound(line.y + line.height)
    dx: s32 = x1 - x0
    if dx < 0 { dx = -dx }
    dy: s32 = y1 - y0
    if dy < 0 { dy = -dy }
    step_x: s32 = 1
    if x1 < x0 { step_x = -1 }
    step_y: s32 = 1
    if y1 < y0 { step_y = -1 }
    error: s32 = dx - dy
    x: s32 = x0
    y: s32 = y0
    while true {
        PixmapBlend(x, y, color, 255)
        if x == x1 && y == y1 { break }
        twice: s32 = error * 2
        if twice > -dy {
            error -= dy
            x += step_x
        }
        if twice < dx {
            error += dx
            y += step_y
        }
    }
}

// Hosts supply decoded assets; absent assets retain the screenshot placeholder.
#program_export
RasterImage :: (asset_path: string, texture_id: u32, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2, rotation: float32,
    radius: float32, tint: Color) {
    unused texture_id
    destination = PixmapDeviceBounds(destination); clip = PixmapDeviceBounds(clip)
    origin.x *= pixmap_scale_x; origin.y *= pixmap_scale_y; radius *= pixmap_scale_y
    slot := PixmapImageIndex(asset_path)
    if slot >= 0 {
        if !Finite32(source.x) || !Finite32(source.y) || !Finite32(source.width) || !Finite32(source.height) ||
            !Finite32(destination.x) || !Finite32(destination.y) || !Finite32(destination.width) || !Finite32(destination.height) ||
            !Finite32(clip.x) || !Finite32(clip.y) || !Finite32(clip.width) || !Finite32(clip.height) ||
            !Finite32(origin.x) || !Finite32(origin.y) || !Finite32(rotation) || !Finite32(radius) ||
            destination.width <= 0.0 || destination.height <= 0.0 || clip.width <= 0.0 || clip.height <= 0.0 { return }
        // Clamp floats before converting them to pixel indexes.
        left := clip.x; top := clip.y; right := clip.x + clip.width; bottom := clip.y + clip.height
        if !Finite32(right) || !Finite32(bottom) { return }
        if rotation == 0.0 {
            if left < destination.x - origin.x { left = destination.x - origin.x }
            if top < destination.y - origin.y { top = destination.y - origin.y }
            if right > destination.x - origin.x + destination.width { right = destination.x - origin.x + destination.width }
            if bottom > destination.y - origin.y + destination.height { bottom = destination.y - origin.y + destination.height }
        }
        if left < 0.0 { left = 0.0 }; if top < 0.0 { top = 0.0 }
        if right > cast(float32)pixmap_width { right = cast(float32)pixmap_width }
        if bottom > cast(float32)pixmap_height { bottom = cast(float32)pixmap_height }
        if right <= left || bottom <= top { return }
        cosine := CosineDegrees(rotation); sine := SineDegrees(rotation)
        PixmapClipAll()
        if left < cast(float32)pixmap_clip_left { left = cast(float32)pixmap_clip_left }
        if top < cast(float32)pixmap_clip_top { top = cast(float32)pixmap_clip_top }
        if right > cast(float32)pixmap_clip_right { right = cast(float32)pixmap_clip_right }
        if bottom > cast(float32)pixmap_clip_bottom { bottom = cast(float32)pixmap_clip_bottom }
        rows: PixmapImageRowsData = .{slot, FloorInteger(left), CeilInteger(right), source, destination, clip, origin, cosine, sine, radius, tint}
        #if #defined(POSIX_THREADS) {
            procedure: PixmapRowProcedure = PixmapImageRows
            independent := true
            // An image may borrow the destination surface. Preserve ordered
            // serial behavior for every overlapping view of that storage.
            image := pixmap_image_pixels[slot].value
            if image.count > 0 {
                source_start := cast(usize)*image[0]; source_end := source_start + cast(usize)image.count * 4
                target_start := cast(usize)*pixmap_surface[0]; target_end := target_start + cast(usize)(pixmap_width * pixmap_height) * 4
                independent = source_end <= target_start || target_end <= source_start
            }
            PixmapRows(FloorInteger(top), CeilInteger(bottom), CeilInteger(right) - FloorInteger(left), procedure, cast(*void)*rows, independent)
        } else {
            PixmapImageRange(FloorInteger(top), CeilInteger(bottom), rows)
        }
        return
    }
    PixmapClipPixels(clip)
    x0: s32 = PixmapRound(destination.x)
    y0: s32 = PixmapRound(destination.y)
    x1: s32 = PixmapRound(destination.x + destination.width)
    y1: s32 = PixmapRound(destination.y + destination.height)
    light: Color = Color.{229, 231, 235, 255}
    PixmapFillRounded(x0, y0, x1, y1, PixmapRound(radius), light)
    square: Color = tint
    square.a = cast(u8)(cast(s32)tint.a / 4)
    y: s32 = y0
    while y < y1 {
        x: s32 = x0
        while x < x1 {
            if ((x - x0) / 8 + (y - y0) / 8) % 2 == 0 {
                PixmapFillRounded(x, y, x + 8, y + 8, 0, square)
            }
            x += 8
        }
        y += 8
    }
    PixmapClipAll()
}

PixmapImageRowsData :: struct {
    slot: s32; left: s32; right: s32
    source: Rectangle; destination: Rectangle; clip: Rectangle; origin: Vector2
    cosine: float32; sine: float32; radius: float32; tint: Color
}
PixmapImageRange :: (start: s32, end: s32, data: PixmapImageRowsData) {
    slot := data.slot; source := data.source; destination := data.destination
    clip := data.clip; origin := data.origin; cosine := data.cosine; sine := data.sine; radius := data.radius; tint := data.tint
    for y: cast(s32)start..cast(s32)end - 1 {
        for x: data.left..data.right - 1 {
            px := cast(float32)x + 0.5; py := cast(float32)y + 0.5
            if !ImageCanvas.InsideRoundedClip(px, py, clip, radius) { continue }
            dx := px - destination.x; dy := py - destination.y
            local_x := dx * cosine + dy * sine + origin.x
            local_y := -dx * sine + dy * cosine + origin.y
            if local_x < 0.0 || local_y < 0.0 || local_x >= destination.width || local_y >= destination.height { continue }
            sx := source.x + local_x * source.width / destination.width
            sy := source.y + local_y * source.height / destination.height
            if !Finite32(sx) || !Finite32(sy) || sx < 0.0 || sy < 0.0 ||
                sx >= cast(float32)pixmap_image_widths[slot] || sy >= cast(float32)pixmap_image_heights[slot] { continue }
            packed := pixmap_image_pixels[slot].value[FloorInteger(sy) * pixmap_image_widths[slot] + FloorInteger(sx)]
            color: Color
            color.r = cast(u8)(((packed >> cast(u32)16) & cast(u32)255) * cast(u32)tint.r / cast(u32)255)
            color.g = cast(u8)(((packed >> cast(u32)8) & cast(u32)255) * cast(u32)tint.g / cast(u32)255)
            color.b = cast(u8)((packed & cast(u32)255) * cast(u32)tint.b / cast(u32)255)
            color.a = cast(u8)((packed >> cast(u32)24) * cast(u32)tint.a / cast(u32)255)
            PixmapBlend(x, y, color, 255)
        }
    }
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    slot := PixmapImageIndex(asset_path); if slot >= 0 { return pixmap_image_widths[slot] }
    return 0
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    slot := PixmapImageIndex(asset_path); if slot >= 0 { return pixmap_image_heights[slot] }
    return 0
}

PixmapDigits :: (value: s32, output: []u8, at: s32) -> s32 {
    if value >= 100 {
        output[at] = cast(u8)(48 + value / 100)
        at += 1
    }
    if value >= 10 {
        output[at] = cast(u8)(48 + (value / 10) % 10)
        at += 1
    }
    output[at] = cast(u8)(48 + value % 10)
    return at + 1
}

// Prints the frame as a plain (P3) PPM image, one pixel row per line.
#program_export
PixmapPresent :: () {
    print("P3\n% %\n255\n", pixmap_width, pixmap_height)
    row: [11520]u8
    y: s32 = 0
    while y < pixmap_height {
        length: s32 = 0
        x: s32 = 0
        while x < pixmap_width {
            pixel: u32 = pixmap_surface[y * pixmap_width + x]
            if length > 11508 { print("%\n", TextView(row[0:length])); length = 0 }
            if length > 0 {
                row[length] = cast(u8)32
                length += 1
            }
            length = PixmapDigits(cast(s32)((pixel >> cast(u32)16) & cast(u32)255), row[:], length)
            row[length] = cast(u8)32
            length = PixmapDigits(cast(s32)((pixel >> cast(u32)8) & cast(u32)255), row[:], length + 1)
            row[length] = cast(u8)32
            length = PixmapDigits(cast(s32)(pixel & cast(u32)255), row[:], length + 1)
            x += 1
        }
        print("%\n", TextView(row[0:length]))
        y += 1
    }
}

// The frame is the whole display: always shown, nothing to close, no
// clipboard.
#program_export
WindowVisibleHost :: () -> bool {
    return true
}

// A caller-owned pixel surface has no OS focus; an embedding player's
// platform callback must supply the focus of its own application child.
#program_export
WindowFocusedHost :: () -> bool { return false }

#program_export
WindowSetVisibleHost :: (visible: bool) {
    unused visible
}

#program_export
WindowInterceptCloseHost :: (enabled: bool) -> bool {
    unused enabled
    return false
}

#program_export
WindowTakeCloseRequestHost :: () -> bool {
    return false
}

#program_export
WindowQuitHost :: () {}

#program_export
SystemClipboardOpenHost :: () -> s32 {
    return -1
}

#program_export
SystemClipboardByteHost :: (index: s32) -> s32 {
    unused index
    return -1
}

#program_export
SystemClipboardWriteHost :: (text: string) -> bool {
    unused text
    return false
}
