Media :: #import "media_linux";
#import "c_string"
#import "byte_text_linux"
#import "timer_linux"
c :: #system_library "libc";
Get :: (name: *u8) -> *u8 #foreign c "getenv";

Env :: (name: string) -> string {
    bytes: [128]u8; unused CopyCString(name, bytes[:]); return TextFromCString(Get(*bytes[0]))
}
#program_export
main :: () -> s32 {
    defer { Media.CloseMedia() }
    if Media.MediaOpenHost("-shell-option") { return 1 }
    if Media.MediaOpenHost("ftp://example.org/audio") { return 2 }
    if Media.MediaOpenHost("/tmp/line\nfeed.wav") { return 3 }
    if !Media.MediaOpenHost(Env("MEDIA_TEST_FILE")) { return 4 }
    for i: 0..49 { if Media.MediaStateHost() == 2 { break }; unused SleepMilliseconds(100) }
    if Media.MediaStateHost() != 2 { return 5 }
    SleepMilliseconds(500);
    if Media.MediaStateHost() != 2 { return 6 }
    Media.MediaPauseHost();
    if Media.MediaStateHost() != 3 { return 7 }
    Media.MediaPauseHost();
    if Media.MediaStateHost() != 2 { return 8 }
    Media.MediaStopHost();
    for i: 0..100 { Media.MediaTick(); SleepMilliseconds(20) }
    if Media.MediaStateHost() != 0 { return 9 }
    if !Media.MediaOpenHost("/missing/audio.wav") { return 10 }
    for i: 0..100 { Media.MediaTick(); SleepMilliseconds(20) }
    if Media.MediaStateHost() != -1 { return 11 }
    print("11 media checks passed\n");
    return 0
}
