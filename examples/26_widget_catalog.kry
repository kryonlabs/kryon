            Text((TextProps){.bounds={right, y + ScaleUIPx(54), 0, 0}, .text="DragInt", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            DragInt((DragIntProps){.bounds = {right,y + ScaleUIPx(86),ScaleUIPx(350),ScaleUIPx(36)}, .id = 301, .values = integers, .value_count = 3, .speed = 1.0f, .min = 0, .max = 10})
            Text((TextProps){.bounds={x, y + ScaleUIPx(166), 0, 0}, .text="DragFloatRange2", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            DragFloatRange2((DragFloatRange2Props){.bounds = {x,y + ScaleUIPx(198),ScaleUIPx(350),ScaleUIPx(36)}, .id = 302, .current_min = &range_min, .current_max = &range_max, .speed = 0.1f, .min = 0.0f, .max = 10.0f})
            Text((TextProps){.bounds={right, y + ScaleUIPx(166), 0, 0}, .text="DragIntRange2", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            DragIntRange2((DragIntRange2Props){.bounds = {right,y + ScaleUIPx(198),ScaleUIPx(350),ScaleUIPx(36)}, .id = 303, .current_min = &int_min, .current_max = &int_max, .speed = 1.0f, .min = 0, .max = 10})
            Text((TextProps){.bounds={x, y + ScaleUIPx(278), 0, 0}, .text="SliderFloat", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            SliderFloat((SliderFloatProps){.bounds = {x,y + ScaleUIPx(310),ScaleUIPx(350),ScaleUIPx(36)}, .id = 304, .values = numbers, .value_count = 3, .min = 0.0f, .max = 1.0f})
            Text((TextProps){.bounds={right, y + ScaleUIPx(278), 0, 0}, .text="SliderInt", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            SliderInt((SliderIntProps){.bounds = {right,y + ScaleUIPx(310),ScaleUIPx(350),ScaleUIPx(36)}, .id = 305, .values = integers, .value_count = 3, .min = 0, .max = 10})
