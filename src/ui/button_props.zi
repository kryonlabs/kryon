#module "button_props"
#import "ui_control_props.generated.h"
#import "ui_menu_props.generated.h"
#import "ui_image_props.generated.h"

ArrowDirection :: enum {
    ArrowLeft = 0
    ArrowRight = 1
    ArrowUp = 2
    ArrowDown = 3
}

# Shared public contract. Hosts provide the geometry, texture, and style types.
ButtonProps :: struct {
    bounds: Rectangle
    label: const char*
    id: i32
    class_name: i32
    tone: ButtonTone
    emphasis: ButtonEmphasis
    size: ControlSize
    disabled: bool
    loading: bool
    selected: bool
    invisible: bool
    full_width: bool
    pill: bool
    circle: bool
    icon: Texture2D
    icon_type: i32
    icon_placement: IconPlacement
    icon_only: bool
    square: bool
    image: ImageProps
    swatch: bool
    swatch_color: Color
    menu_id: i32
    items: const MenuItem*
    item_count: i32
    open: *i32
    activated_id: *i32
    menu: bool
    split: bool
    arrow: bool
    info: bool
    direction: ArrowDirection
    state: ButtonState
}
