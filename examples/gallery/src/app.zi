Box :: #import "kryon/box";
Checkbox :: #import "kryon/checkbox";
ListBox :: #import "kryon/list_box";
Text :: #import "kryon/text";
Toggle :: #import "kryon/toggle";
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/input_protocol"
#import "kryon/key_input"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
using Scenes :: #import "scenes";
using Shot :: #import "catalog_shot";
#import "catalog"
#import "palette"
#import "kryon/widget_kind"
#import "kryon/frame_snapshot"
GalleryTheme :: #import "kryon/Theme";

embedded: bool;
scene: s32;
disabled_controls: bool;
picker_key: s32;
picker_focused: bool;
catalog_scroll: s32;
navigation_focus_pending: bool;

// Reserve sidebar input before generic activation and scene editors consume it.
PrepareGalleryInput :: (session: Session) {
    picker_key = 0
    picker_focused = false
    if embedded { return }
    for index: 0..TreeCount(session) - 1 {
        entry := TreeNodeAt(session, index)
        if TreeFocusedAt(session, index) && entry.parent >= 0 && TreeNodeAt(session, entry.parent).key == cast(u64)9003 {
            picker_focused = TreeFocusedAt(session, index)
            if picker_focused {
                picker_key = KeyboardTake(session)
                if picker_key == KeyTab {
                    unused KeyboardSend(session, picker_key)
                    picker_key = 0
                    picker_focused = false
                }
                typed: [128]u8
                unused TypedTextTake(session, typed[:])
            }
            return
        }
    }
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if Shot.CatalogShotActive() { return Shot.CatalogShotFrame(session, viewport) }
    snapshot := CaptureFrameInput(session)
    SetGalleryPreview(Rectangle.{0.0, 0.0, 480.0, viewport.height - 88.0}, true,
        cast(float32)snapshot.elapsed_ms / 1000.0, GalleryTheme.CurrentTheme().motion.reduced_motion)
    InstallGalleryPalette(dark)
    Box.Draw(session, Box.Props.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    if embedded {
        Text.Draw(session, Text.Props.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = GallerySceneName(scene), .font = 23})
        DrawScene(session)
        return 0
    }
    restore_focus := navigation_focus_pending
    navigation_focus_pending = false
    DrawScene(session)
    // Modal examples own the content's input layer. Keep the gallery controls
    // in that same layer so an example cannot trap the sidebar.
    modal: s32 = -1
    for index: 0..TreeSubmittedCount(session) - 1 {
        if TreeSubmittedNodeAt(session, index).kind == cast(s32)WidgetKind.WidgetKindModal { modal = index }
    }
    controls_scope := modal >= 0 && TreePushScope(session, modal)
    controls_y := viewport.height - 64.0
    items: [GallerySceneCount]ListBox.ListBoxItem
    for index: cast(s32)0..GallerySceneCount - 1 {
        items[index].key = cast(u64)(index + 1)
        items[index].label = GallerySceneName(index)
    }
    navigation: s32
    if picker_key == KeyHome { navigation = ListBox.ListBoxKeyHome() }
    else if picker_key == KeyEnd { navigation = ListBox.ListBoxKeyEnd() }
    else if picker_key == KeyUp { navigation = ListBox.ListBoxKeyUp() }
    else if picker_key == KeyDown { navigation = ListBox.ListBoxKeyDown() }
    picked := ListBox.Draw(session, ListBox.Props.{.key = 9003, .id = 9003,
        .bounds = .{500.0, 24.0, viewport.width - 524.0, viewport.height - 48.0},
        .selected_index = scene, .scroll_offset = catalog_scroll,
        .row_height = 30, .focused = picker_focused, .navigation = navigation}, items[:])
    catalog_scroll = picked.scroll_offset
    if picked.changed { scene = picked.selected_index; dismissed = false; navigation_focus_pending = true }
    if navigation != 0 || restore_focus {
        for index: 0..TreeSubmittedCount(session) - 1 {
            entry := TreeSubmittedNodeAt(session, index)
            if entry.parent == picked.node && entry.key == cast(u64)(scene + 1) {
                unused TreeFocusSubmittedAt(session, index)
            }
        }
    }
    disabled_controls = Checkbox.Draw(session, Checkbox.Props.{.key = 9004, .bounds = .{24.0, controls_y, 208.0, 40.0}, .label = "Disabled", .checked = disabled_controls}).checked
    dark = Toggle.Draw(session, Toggle.Props.{.key = 9005, .bounds = .{344.0, controls_y, 96.0, 40.0}, .label = "Dark", .value = dark}).value
    if controls_scope { End(session) }
    return 0
}

DrawScene :: (session: Session) {
    ComposeGallery(session, scene, disabled_controls)
}
