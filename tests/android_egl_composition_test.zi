G :: #import, file "../src/backend/scene_gpu_gl.zi";
Paint :: #import, file "../src/backend/pixmap_gles.zi";
Pixmap :: #import "kryon/pixmap";
Gpu :: #import, file "../src/backend/pixmap_gpu.zi";
#import "kryon/drawing_props"
#import "kryon/geometry"

egl :: #system_library "EGL";
Pbuffer :: (display: *void, config: *void, attributes: *s32) -> *void #foreign egl "eglCreatePbufferSurface";
DestroySurface :: (display: *void, surface: *void) -> u32 #foreign egl "eglDestroySurface";
Swap :: (display: *void, surface: *void) -> u32 #foreign egl "eglSwapBuffers";

Pixel :: (rgba: []u8, expected_r: s32, expected_g: s32, expected_b: s32) -> bool {
    r := cast(s32)rgba[0] - expected_r
    g := cast(s32)rgba[1] - expected_g
    b := cast(s32)rgba[2] - expected_b
    return r >= -1 && r <= 1 && g >= -1 && g <= 1 && b >= -1 && b <= 1 && rgba[3] == 255
}

main :: () -> s32 {
    display := G.ESceneDisplay()
    if display == null || G.EInitialize(display, null, null) == 0 { return 1 }
    defer { unused G.ETerminate(display) }
    attributes: [13]s32 = .[0x3033, 1, 0x3040, 0x40, 0x3024, 8, 0x3023, 8, 0x3022, 8, 0x3021, 8, 0x3038]
    config: *void; count: s32
    if G.EBindAPI(0x30a0) == 0 || G.EChooseConfig(display, *attributes[0], *config, 1, *count) == 0 || count == 0 { return 2 }
    context_attributes: [3]s32 = .[0x3098, 3, 0x3038]
    context := G.ECreateContext(display, config, null, *context_attributes[0])
    if context == null { return 3 }
    defer { unused G.EDestroyContext(display, context) }
    surface_attributes: [5]s32 = .[0x3057, 4, 0x3056, 4, 0x3038]
    surface := Pbuffer(display, config, *surface_attributes[0])
    if surface == null { return 4 }
    defer { unused DestroySurface(display, surface) }
    if G.EMakeCurrent(display, surface, surface, context) == 0 { return 5 }
    defer { unused G.EMakeCurrent(display, null, null, null) }

    diagnostic: [512]u8
    if !Paint.Open(diagnostic[:]) { return 6 }
    if !Paint.Resize(4, 4) { return 7 }
    pixels: []u32
    if !Pixmap.PixmapResumeInto(4, 4, pixels, true) { return 8 }
    Gpu.PixmapGpuRect(0, 0, 4, 4, Color.{32, 64, 128, 255})
    Gpu.PixmapGpuRect(0, 0, 2, 2, Color.{224, 32, 0, 128})
    Pixmap.PixmapEndInto()
    if !Paint.PresentToWindow(4, 4) { return 9 }
    rgba: [4]u8
    G.BindFramebuffer(0x8ca8, 0)
    G.ReadPixels(0, 3, 1, 1, 0x1908, 0x1401, cast(*void)*rgba[0])
    if !Pixel(rgba[:], 128, 48, 64) || Swap(display, surface) == 0 { return 10 }
    if !Paint.Read(0, 3, 1, 1, rgba[:]) || !Pixel(rgba[:], 32, 64, 128) { return 11 }

    Gpu.PixmapGpuRect(3, 0, 4, 1, Color.{24, 200, 40, 255})
    if !Paint.PresentToWindow(4, 4) || Swap(display, surface) == 0 { return 12 }
    if !Paint.Read(0, 0, 1, 1, rgba[:]) || !Pixel(rgba[:], 128, 48, 64) { return 13 }
    if !Paint.Read(3, 0, 1, 1, rgba[:]) || !Pixel(rgba[:], 24, 200, 40) { return 14 }

    image: [1]u32 = .[cast(u32)0x80ff8000]
    if !Pixmap.PixmapSetImage(0, "fixture", 1, 1, image[:]) { return 15 }
    if !Pixmap.PixmapResumeInto(4, 4, pixels, true) { return 16 }
    if !Pixmap.PixmapGpuImageQuad(0, Rectangle.{0.0, 0.0, 1.0, 1.0}, Rectangle.{0.0, 3.0, 1.0, 1.0},
        Rectangle.{0.0, 0.0, 4.0, 4.0}, Vector2.{0.0, 0.0}, 0.0, 0.0, Color.{255, 255, 255, 255}) { return 17 }
    Pixmap.PixmapEndInto()
    if !Paint.PresentToWindow(4, 4) || !Paint.Read(0, 3, 1, 1, rgba[:]) || !Pixel(rgba[:], 144, 96, 64) { return 18 }

    // A smaller image uploads into staging that a larger one grew. The frame
    // stays on GLES.
    whole := Rectangle.{0.0, 0.0, 4.0, 4.0}
    white := Color.{255, 255, 255, 255}
    larger: [4]u32 = .[cast(u32)0xff0000ff, cast(u32)0xff0000ff, cast(u32)0xff0000ff, cast(u32)0xff0000ff]
    smaller: [1]u32 = .[cast(u32)0xff00ff00]
    if !Pixmap.PixmapSetImage(1, "larger", 2, 2, larger[:]) || !Pixmap.PixmapSetImage(2, "smaller", 1, 1, smaller[:]) { return 22 }
    if !Pixmap.PixmapResumeInto(4, 4, pixels, true) { return 23 }
    if !Pixmap.PixmapGpuImageQuad(1, Rectangle.{0.0, 0.0, 2.0, 2.0}, Rectangle.{0.0, 0.0, 2.0, 2.0},
        whole, Vector2.{0.0, 0.0}, 0.0, 0.0, white) { return 24 }
    Pixmap.PixmapEndInto()
    if !Paint.PresentToWindow(4, 4) || !Paint.Read(0, 0, 1, 1, rgba[:]) || !Pixel(rgba[:], 0, 0, 255) { return 25 }
    if !Pixmap.PixmapResumeInto(4, 4, pixels, true) { return 26 }
    if !Pixmap.PixmapGpuImageQuad(2, Rectangle.{0.0, 0.0, 1.0, 1.0}, Rectangle.{3.0, 3.0, 1.0, 1.0},
        whole, Vector2.{0.0, 0.0}, 0.0, 0.0, white) { return 27 }
    Pixmap.PixmapEndInto()
    if !Paint.PresentToWindow(4, 4) || !Paint.Read(3, 3, 1, 1, rgba[:]) || !Pixel(rgba[:], 0, 255, 0) { return 28 }
    // A scaled crop that passes the image edge by float rounding alone is
    // still one textured quad.
    if !Pixmap.PixmapResumeInto(4, 4, pixels, true) { return 29 }
    if !Pixmap.PixmapGpuImageQuad(1, Rectangle.{0.0, 0.0, 1.0, 2.000001}, Rectangle.{3.0, 0.0, 1.0, 1.0},
        whole, Vector2.{0.0, 0.0}, 0.0, 0.0, white) { return 30 }
    Pixmap.PixmapEndInto()
    if !Paint.PresentToWindow(4, 4) || !Paint.Read(3, 0, 1, 1, rgba[:]) || !Pixel(rgba[:], 0, 0, 255) { return 31 }
    if !Paint.Resize(2, 2) || !Paint.Read(0, 0, 1, 1, rgba[:]) || !Pixel(rgba[:], 0, 0, 0) { return 19 }
    Paint.Close(true)
    if Pixmap.PixmapResumeInto(2, 2, pixels, true) { return 20 }
    if !Paint.Open(diagnostic[:]) || !Paint.Resize(4, 4) { return 21 }
    Paint.Close(true)
    return 0
}
