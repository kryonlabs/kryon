# Host-owned RGBA8 storage. Ziran declares the ABI so generated targets and
# the C raster host agree on one type definition.
ImageAsset :: struct {
    path: *u8
    texture_id: u32
    pixels: *u8
    width: s32
    height: s32
    stride: s32
}

ImageCanvas :: struct {
    pixels: *u8
    width: s32
    height: s32
    stride: s32
    assets: *ImageAsset
    asset_count: u64
}
