#import "session"
Modal :: #import "kryon/modal";
Overlay :: #import "kryon/overlay";
Shape :: #import "kryon/shape";
Button :: #import "kryon/button";
Checkbox :: #import "kryon/checkbox";
Dropdown :: #import "kryon/dropdown";
Fieldset :: #import "kryon/fieldset";
Image :: #import "kryon/image";
Progress :: #import "kryon/progress";
Scroll :: #import "kryon/scroll";
SegmentedControl :: #import "kryon/segmented_control";
Slider :: #import "kryon/slider";
TabBar :: #import "kryon/tab_bar";
TextArea :: #import "kryon/text_area";
TextField :: #import "kryon/text_field";
Text :: #import "kryon/text";
Toggle :: #import "kryon/toggle";
#import "geometry"
#import "input_protocol"

#program_export "PollPointer"
Pointer :: () -> PointerFrame {
    return PointerFrame.{.x = 13.0, .y = 21.0, .pressed = true}
}

count: s32;
#program_export "TextHostedHost"
TextHost :: (session: Session, props: Text.Props) {
    if session.slot == 4 && session.epoch == cast(u64)12 && props.text == "Portable composition" { count += 1 }
}
#program_export "ImageHostedHost"
ImageHost :: (session: Session, image: Image.Props) {
    if session.slot == 4 && image.asset_path == "assets/photo.png" { count += 1 }
}
#program_export "ButtonHostedHost"
ButtonHost :: (session: Session, props: Button.Props) -> s32 {
    if session.slot == 4 && props.label == "Save" && count == 2 { return props.id }
    return 0
}
#program_export "TextAreaHostedHost"
TextAreaHost :: (session: Session, props: TextArea.Props) -> TextArea.Result {
    if session.slot != 4 || props.value != "Saved text" { return TextArea.Result.{} }
    return TextArea.Result.{.cursor = props.cursor + 1,
        .edit = TextArea.Edit.{.changed = true, .replacement = "🌿"}}
}
#program_export "ScrollHostedHost"
ScrollHost :: (session: Session, props: Scroll.Props) -> Scroll.ScrollResult {
    if session.slot != 4 { return Scroll.ScrollResult.{} }
    return Scroll.ScrollResult.{.opened = true, .scroll_offset = props.scroll_offset + 5,
        .content = Rectangle.{.width = 200.0}}
}
#program_export "EndHostedHost"
End :: (session: Session) -> bool { return session.slot == 4 && count == 2 }

#program_export "CheckboxHostedHost"
CheckboxHost :: (session: Session, props: Checkbox.Props) -> Checkbox.CheckboxValueResult {
    return Checkbox.CheckboxValueResult.{.changed = session.slot == 4 && props.id == 52, .checked = !props.checked}
}
#program_export "ToggleHostedHost"
ToggleHost :: (session: Session, props: Toggle.Props) -> Toggle.ToggleValueResult {
    return Toggle.ToggleValueResult.{.changed = session.slot == 4 && props.id == 53, .value = !props.value}
}

#program_export "TextFieldHostedHost"
TextFieldHost :: (session: Session, props: TextField.Props) -> TextField.Result {
    if session.slot != 4 || props.value != "List title" {
        return TextField.Result.{}
    }
    return TextField.Result.{.cursor = props.cursor + 1,
        .edit = TextField.Edit.{.changed = true, .replacement = "✓"}}
}

#program_export "TabBarHostedHost"
TabBarHost :: (session: Session, props: TabBar.Props, tabs: []TabBar.Tab) -> TabBar.Result {
    if session.slot != 4 || tabs.count != 2 || tabs[1].label != "Two" {
        return TabBar.Result.{}
    }
    return TabBar.Result.{.selected_index = props.selected_index + 1}
}

#import "geometry"

#program_export "FieldsetHostedHost"
FieldsetHost :: (session: Session, props: Fieldset.Props) -> s32 {
    unused session
    unused props
    return 0
}

#program_export "LineHostedHost"
Line :: (session: Session, props: Shape.Props) -> s32 {
    return ifx session.slot == 4 && props.end.x == 4.0 then 81 else 0
}

#program_export "CircleHostedHost"
Circle :: (session: Session, props: Shape.CircleProps) -> s32 {
    return ifx session.slot == 4 && props.radius == 5.0 then 82 else 0
}

#program_export "RingHostedHost"
Ring :: (session: Session, props: Shape.RingProps) -> s32 {
    return ifx session.slot == 4 && props.outer_radius == 5.0 then 83 else 0
}

#program_export "TriangleHostedHost"
Triangle :: (session: Session, props: Shape.TriangleProps) -> s32 {
    unused props
    return ifx session.slot == 4 then 84 else 0
}

#program_export "SliderHostedHost"
SliderHost :: (session: Session, props: Slider.Props) -> Slider.SliderStep {
    if session.slot != 4 || props.max != 10.0 {
        return Slider.SliderStep.{}
    }
    return Slider.SliderStep.{.value = props.value + 0.5, .changed = true}
}

#program_export "DiscreteSliderHostedHost"
DiscreteSlider :: (session: Session, props: Slider.DiscreteSliderProps) -> Slider.SliderDiscreteStep {
    if session.slot != 4 || props.max != 10 {
        return Slider.SliderDiscreteStep.{}
    }
    return Slider.SliderDiscreteStep.{.value = props.value + 1, .changed = true}
}

hosted_progress_value: s32;

#program_export "ProgressHostedHost"
ProgressHost :: (session: Session, props: Progress.Props) {
    if session.slot == 4 {
        hosted_progress_value = props.value
    }
}

#program_export "DismissibleOverlayHostedHost"
DismissibleOverlay :: (session: Session,
    props: Overlay.Props) -> Overlay.DismissibleOverlayResult {
    unused props
    return Overlay.DismissibleOverlayResult.{.closed = session.slot == 4,
        .panel_node = ifx session.slot == 4 then 85 else -1}
}

#program_export "PopupHostedHost"
Popup :: (session: Session, props: Overlay.PopupProps) -> Overlay.PopupResult {
    unused props
    return Overlay.PopupResult.{.node = ifx session.slot == 4 then 86 else -1}
}

#program_export
HostedProgressValue :: () -> s32 {
    return hosted_progress_value
}

#program_export "ToggleSizeHostedHost"
ToggleSize :: (session: Session, props: Toggle.Props) -> Vector2 {
    if session.slot != 4 || props.on_label != "On" {
        return Vector2.{}
    }
    return Vector2.{72.0, 30.0}
}

#program_export "SegmentedControlHostedHost"
SegmentedControlHost :: (session: Session, props: SegmentedControl.Props,
    options: []SegmentedControl.SegmentOption) -> SegmentedControl.SegmentedControlResult {
    if session.slot != 4 || options.count != 2 || options[1].label != "Calendar" ||
    !props.has_selection {
        return SegmentedControl.SegmentedControlResult.{}
    }
    return SegmentedControl.SegmentedControlResult.{.selected_index = props.selected_index + 1,
        .clicked_index = props.selected_index + 1, .changed = true}
}

#program_export "DropdownHostedHost"
DropdownHost :: (session: Session, props: Dropdown.Props, options: []Dropdown.Option) -> Dropdown.Result {
    if session.slot != 4 || options.count != 1 || options[0].label != "Practice" {
        return Dropdown.Result.{}
    }
    return Dropdown.Result.{.changed = true, .selected_index = props.selected_index + 1}
}

#program_export "ActionModalHostedHost"
ActionModal :: (session: Session, props: Modal.ActionModalProps,
    actions: []Modal.ActionModalAction) -> Modal.ActionModalResult {
    unused session
    unused props
    return Modal.ActionModalResult.{.action = ifx actions.count == 1 then 1 else 0}
}
