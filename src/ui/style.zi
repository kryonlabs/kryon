#import "control_props"
#import "geometry"
#import "surface"

StateFlags :: struct {
    disabled: bool
    loading: bool
    selected: bool
}

#program_export
ResolveFlags :: (state: s32, disabled: bool, loading: bool,
    selected: bool) -> StateFlags {
    flags: StateFlags
    flags.disabled = disabled || state == ButtonStateDisabled
    flags.loading = loading || state == ButtonStateLoading
    flags.selected = selected || state == ButtonStateSelected
    return flags
}

InteractionState :: struct {
    state: s32
    hovered: bool
    pressed: bool
    focused: bool
}

#program_export
ResolveInteraction :: (explicit_state: s32, disabled: bool, loading: bool,
    pressed: bool, hovered: bool, focused: bool,
    selected: bool) -> InteractionState {
    state: s32 = ResolveState(explicit_state, disabled, loading,
        pressed, hovered, focused, selected)
    interaction: InteractionState
    interaction.state = state
    interaction.hovered = hovered
    interaction.pressed = pressed
    interaction.focused = focused
    if explicit_state != ButtonStateAuto {
        interaction.hovered = state == ButtonStateHover
        interaction.pressed = state == ButtonStatePressed
        interaction.focused = state == ButtonStateFocus
    }
    return interaction
}

StyleData :: struct {
    fields: u32
    background: u32
    foreground: u32
    border: u32
    focus: u32
    radius: float32
    border_width: float32
    opacity: float32
    padding_x: float32
    padding_y: float32
    gap: float32
    font_size: float32
    icon_size: float32
    offset_x: float32
    offset_y: float32
    background_end: u32
    material: MaterialKind
    typeface: string
    letter_spacing: float32
}

StyleFrame :: struct {
    value: StyleData
    fill: FillStates
}

StyleStates :: struct {
    normal: StyleData
    hover: StyleData
    pressed: StyleData
    focused: StyleData
    disabled: StyleData
    loading: StyleData
    selected: StyleData
}

#program_export
DefaultFields :: () -> u32 {
    return cast(u32)StyleBackground | cast(u32)StyleForeground | cast(u32)StyleBorder |
        cast(u32)StyleFocus | cast(u32)StyleRadius | cast(u32)StyleBorderWidth |
        cast(u32)StyleOpacity | cast(u32)StylePaddingX | cast(u32)StylePaddingY |
        cast(u32)StyleGap | cast(u32)StyleFontSize | cast(u32)StyleIconSize |
        cast(u32)StyleContentOffset | cast(u32)StyleMaterial
}

#program_export
ResolveState :: (explicit_state: s32, disabled: bool, loading: bool,
    pressed: bool, hovered: bool, focused: bool, selected: bool) -> s32 {
    if disabled { return ButtonStateDisabled }
    if loading { return ButtonStateLoading }
    if explicit_state != ButtonStateAuto { return explicit_state }
    if pressed { return ButtonStatePressed }
    if hovered { return ButtonStateHover }
    if focused { return ButtonStateFocus }
    if selected { return ButtonStateSelected }
    return ButtonStateNormal
}

#program_export
ResolveFont :: (requested: s32, inherited: s32,
    fallback: s32) -> s32 {
    if requested > 0 { return requested }
    if inherited > 0 { return inherited }
    if fallback > 0 { return fallback }
    return 16
}

#program_export
StyleFontValue :: (fields: u32, font_size: float32) -> s32 {
    if (fields & cast(u32)StyleFontSize) == cast(u32)0 { return 0 }
    if font_size <= 0.0 { return 0 }
    return cast(s32)(font_size + 0.5)
}

#program_export
StyleOpacityValue :: (fields: u32, opacity: float32) -> float32 {
    if (fields & cast(u32)StyleOpacity) == cast(u32)0 { return 1.0 }
    if opacity < 0.0 { return 0.0 }
    if opacity > 1.0 { return 1.0 }
    return opacity
}

#program_export
FitHeight :: (requested: float32, minimum: float32, content: float32,
    padding: float32) -> float32 {
    if requested > 0.0 { return requested }
    if padding < 0.0 { padding = 0.0 }
    if content < 0.0 { content = 0.0 }
    height: float32 = content + 2.0 * padding
    if height < minimum { height = minimum }
    return height
}

#program_export
ContentBounds :: (width: float32, height: float32, padding_x: float32,
    padding_y: float32) -> Rectangle {
    box: Rectangle
    if padding_x < 0.0 { padding_x = 0.0 }
    if padding_y < 0.0 { padding_y = 0.0 }
    box.x = padding_x
    box.y = padding_y
    box.width = width - 2.0 * padding_x
    box.height = height - 2.0 * padding_y
    if box.width < 0.0 { box.width = 0.0 }
    if box.height < 0.0 { box.height = 0.0 }
    return box
}

#program_export
InsetBounds :: (bounds: Rectangle, padding_x: float32, padding_y: float32,
    scale: float32) -> Rectangle {
    if scale <= 0.0 { scale = 1.0 }
    content: Rectangle = ContentBounds(bounds.width / scale,
        bounds.height / scale, padding_x, padding_y)
    result: Rectangle
    result.x = bounds.x + content.x * scale
    result.y = bounds.y + content.y * scale
    result.width = content.width * scale
    result.height = content.height * scale
    return result
}

#program_export
MergeValues :: (base: StyleData, override: StyleData) -> StyleData {
    if (override.fields & cast(u32)StyleBackground) != cast(u32)0 { base.background = override.background }
    if (override.fields & cast(u32)StyleForeground) != cast(u32)0 { base.foreground = override.foreground }
    if (override.fields & cast(u32)StyleBorder) != cast(u32)0 { base.border = override.border }
    if (override.fields & cast(u32)StyleFocus) != cast(u32)0 { base.focus = override.focus }
    if (override.fields & cast(u32)StyleRadius) != cast(u32)0 { base.radius = override.radius }
    if (override.fields & cast(u32)StyleBorderWidth) != cast(u32)0 { base.border_width = override.border_width }
    if (override.fields & cast(u32)StyleOpacity) != cast(u32)0 { base.opacity = override.opacity }
    if (override.fields & cast(u32)StylePaddingX) != cast(u32)0 { base.padding_x = override.padding_x }
    if (override.fields & cast(u32)StylePaddingY) != cast(u32)0 { base.padding_y = override.padding_y }
    if (override.fields & cast(u32)StyleGap) != cast(u32)0 { base.gap = override.gap }
    if (override.fields & cast(u32)StyleFontSize) != cast(u32)0 { base.font_size = override.font_size }
    if (override.fields & cast(u32)StyleIconSize) != cast(u32)0 { base.icon_size = override.icon_size }
    if (override.fields & cast(u32)StyleContentOffset) != cast(u32)0 { base.offset_x = override.offset_x }
    if (override.fields & cast(u32)StyleContentOffset) != cast(u32)0 { base.offset_y = override.offset_y }
    if (override.fields & cast(u32)StyleBackgroundEnd) != cast(u32)0 { base.background_end = override.background_end }
    if (override.fields & cast(u32)StyleMaterial) != cast(u32)0 { base.material = override.material }
    if (override.fields & cast(u32)StyleTypeface) != cast(u32)0 { base.typeface = override.typeface }
    if (override.fields & cast(u32)StyleLetterSpacing) != cast(u32)0 { base.letter_spacing = override.letter_spacing }
    base.fields = base.fields | override.fields
    return base
}

#program_export
ResolveValues :: (base: StyleData, states: StyleStates,
    state: s32) -> StyleData {
    base = MergeValues(base, states.normal)
    if state == ButtonStateHover { return MergeValues(base, states.hover) }
    if state == ButtonStatePressed { return MergeValues(base, states.pressed) }
    if state == ButtonStateFocus { return MergeValues(base, states.focused) }
    if state == ButtonStateDisabled { return MergeValues(base, states.disabled) }
    if state == ButtonStateLoading { return MergeValues(base, states.loading) }
    if state == ButtonStateSelected { return MergeValues(base, states.selected) }
    return base
}
