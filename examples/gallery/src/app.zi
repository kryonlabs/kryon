using UI :: #import "kryon/Widgets";
using Scenes :: #import "scenes";
#import "packages"
#import "kryon/SystemTheme"
Theme :: #import "kryon/Theme";
#import "std/number_text"

embedded: bool;
scene: s32;
catalog_scroll: s32;
disabled_controls: bool;
installed: s32 = -1;

// Show Kryon's standard palette in both hosts. Accent fills and soft
// selections have separate roles; the desktop fallback conflates them.
InstallCatalogPalette :: () {
    palette := Theme.DefaultPalette(dark)
    system := SystemPalette.{.dark = dark, .background = palette.background,
        .base = palette.surface, .text = palette.text, .border = palette.border,
        .selected = palette.accent, .selected_text = palette.on_accent,
        .danger = palette.danger, .warning = palette.warning, .success = palette.success}
    unused SystemPaletteInstall(system)
    rules := ActiveStyleRules()
    selection_text := ifx dark then Theme.OnColor(palette.selection) else Theme.LightSelectionText()
    // Dropdowns and time pickers share these semantic style facts.
    dropdown: StyleRule
    dropdown.selector = StyleDefaultSelector()
    dropdown.selector.kind = StyleKindDropdown()
    dropdown.selector.state = cast(s32)ButtonState.ButtonStateHover
    dropdown.style.fields = cast(u32)StyleField.StyleBackground | cast(u32)StyleField.StyleForeground
    dropdown.style.background = palette.surface_raised
    dropdown.style.foreground = palette.text
    dropdown.order = rules.count; rules.items[rules.count] = dropdown; rules.count += 1
    dropdown.selector.state = StyleAny()
    dropdown.selector.tone = cast(s32)ButtonTone.ButtonToneAccent
    dropdown.style.background = palette.selection
    dropdown.style.foreground = selection_text
    dropdown.order = rules.count; rules.items[rules.count] = dropdown; rules.count += 1
    kinds: [6]s32 = .{StyleKindListBox(), StyleKindListBoxMulti(), StyleKindTreeView(), StyleKindListBoxItem(), StyleKindListBoxMultiItem(), StyleKindTreeViewItem()}
    for index: 0..5 {
        rule: StyleRule
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = kinds[index]
        rule.style.fields = cast(u32)StyleField.StyleForeground
        rule.style.foreground = palette.text
        if index < 3 {
            rule.style.fields |= cast(u32)StyleField.StyleBackground | cast(u32)StyleField.StyleBorder
            rule.style.background = palette.surface
            rule.style.border = palette.border
        }
        rule.order = rules.count
        rules.items[rules.count] = rule; rules.count += 1
        if index >= 3 {
            rule.style.fields |= cast(u32)StyleField.StyleBackground
            rule.style.background = palette.selection
            rule.style.foreground = selection_text
            rule.state = cast(s32)ButtonState.ButtonStateHover
            rule.order = rules.count
            rules.items[rules.count] = rule; rules.count += 1
            rule.state = cast(s32)ButtonState.ButtonStateSelected
            rule.order = rules.count
            rules.items[rules.count] = rule; rules.count += 1
        }
    }
    chart: StyleRule
    chart.selector = StyleDefaultSelector(); chart.selector.kind = StyleKindPlot()
    chart.style.fields = cast(u32)StyleField.StyleBackground | cast(u32)StyleField.StyleForeground | cast(u32)StyleField.StyleBorder
    chart.style.background = palette.surface; chart.style.foreground = palette.accent; chart.style.border = palette.border
    chart.order = rules.count; rules.items[rules.count] = chart; rules.count += 1
    unused InstallStyleRules(rules)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    wanted: s32 = ifx dark then 1 else 0
    if wanted != installed {
        InstallCatalogPalette()
        installed = wanted
    }
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    if embedded {
        Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = GallerySceneName(scene), .font = 23})
        DrawScene(session)
        return 0
    }
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 16.0, 440.0, 36.0}, .text = "Kryon widget catalog", .font = 26})
    Text(session, TextProps.{.key = 9002, .bounds = .{500.0, 20.0, 450.0, 28.0}, .text = "Choose a widget to try", .font = 20})
    items: [GallerySceneCount]ListBoxItem
    for index: cast(s32)0..GallerySceneCount - 1 {
        items[index].key = cast(u64)(index + 1)
        items[index].label = GallerySceneName(index)
    }
    picked := ListBox(session, ListBoxProps.{.key = 9003, .bounds = .{500.0, 64.0, viewport.width - 524.0, viewport.height - 88.0}, .selected_index = scene, .scroll_offset = catalog_scroll, .row_height = 30}, items[:])
    catalog_scroll = picked.scroll_offset
    if picked.changed { scene = picked.selected_index; dismissed = false }
    DrawScene(session)
    Text(session, TextProps.{.key = 9004, .bounds = .{24.0, 330.0, 432.0, 40.0}, .text = items[scene].label, .font = 21})
    disabled_controls = Checkbox(session, CheckboxProps.{.key = 9005, .bounds = .{24.0, 382.0, 208.0, 36.0}, .label = "Disabled state", .checked = disabled_controls}).checked
    dark = Toggle(session, ToggleProps.{.key = 9006, .bounds = .{248.0, 382.0, 60.0, 36.0}, .label = "Dark palette", .value = dark}).value
    Text(session, TextProps.{.key = 9011, .bounds = .{320.0, 382.0, 136.0, 36.0}, .text = "Dark palette", .font = 14, .vertical_align = TextAlign.TextAlignCenter})
    Text(session, TextProps.{.key = 9007, .bounds = .{24.0, 442.0, 432.0, 72.0}, .text = "Click and type in the controls. Scroll the list for more. Tab moves keyboard focus.", .font = 16})
    digits: [16]u8
    Text(session, TextProps.{.key = 9008, .bounds = .{24.0, 534.0, 200.0, 24.0}, .text = "Button clicks / decisions", .font = 14})
    Text(session, TextProps.{.key = 9009, .bounds = .{248.0, 534.0, 208.0, 24.0}, .text = FormatInteger(cast(s64)clicks, digits[:]), .font = 18})
    Text(session, TextProps.{.key = 9010, .bounds = .{24.0, 594.0, 432.0, 52.0}, .text = "Core widgets, Plot charts and DataViews. The same Ziran source runs on desktop and web.", .font = 14, .disabled = true})
    return 0
}

DrawScene :: (session: Session) {
    if scene < CoreSceneCount { Compose(session, scene, disabled_controls) }
    else { ComposePackage(session, scene - CoreSceneCount, disabled_controls) }
}
