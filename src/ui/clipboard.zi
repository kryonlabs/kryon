
// Clipboard bytes are owned by the caller. The host supplies observations and
// applies writes; this module selects which value is visible to a widget.
ClipboardSource :: enum {
    ClipboardSystem :: 0
    ClipboardPrimary :: 1
    ClipboardPrimaryOrSystem :: 2
}

ClipboardState :: struct {
    system: string
    primary: string
    pending_write: bool
}

ClipboardWrite :: struct {
    available: bool
    text: string
}

#program_export
ClipboardSetPrimary :: (state: ClipboardState,
    text: string) -> ClipboardState {
    state.primary = text
    return state
}

#program_export
ClipboardRequestWrite :: (state: ClipboardState,
    text: string) -> ClipboardState {
    state.system = text
    state.pending_write = true
    return state
}

#program_export
ClipboardCopySelection :: (state: ClipboardState,
    text: string) -> ClipboardState {
    state.primary = text
    if (cast(s32)text.count) > 0 {
        state = ClipboardRequestWrite(state, text)
    }
    return state
}

#program_export
ClipboardObserve :: (state: ClipboardState,
    text: string) -> ClipboardState {
    if !state.pending_write { state.system = text }
    return state
}

#program_export
ClipboardPendingWrite :: (state: ClipboardState) -> ClipboardWrite {
    write: ClipboardWrite
    write.available = state.pending_write
    if write.available { write.text = state.system }
    return write
}

#program_export
ClipboardWriteCompleted :: (state: ClipboardState) -> ClipboardState {
    state.pending_write = false
    return state
}

#program_export
ClipboardRead :: (state: ClipboardState,
    source: ClipboardSource) -> string {
    if source == cast(ClipboardSource)ClipboardPrimary {
        return state.primary
    }
    if source == cast(ClipboardSource)ClipboardPrimaryOrSystem &&
        (cast(s32)state.primary.count) > 0 {
        return state.primary
    }
    return state.system
}

#program_export
ClipboardHasText :: (state: ClipboardState,
    source: ClipboardSource) -> bool {
    return ClipboardRead(state, source).count > 0
}
