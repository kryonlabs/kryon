#module "image"
#import "drawing_props"

# Matches ImageFit in include/ui_image.h without exporting a second public enum.
ImageFitBounds :: (bounds: Rectangle, source: Rectangle,
    texture_width: i32, texture_height: i32, fit: i32) -> Rectangle #export {
    dst: Rectangle = bounds
    src_w: float = source.width
    src_h: float = source.height

    if src_w < 0.0 { src_w = -src_w }
    if src_h < 0.0 { src_h = -src_h }
    if src_w == 0.0 { src_w = (float)texture_width }
    if src_h == 0.0 { src_h = (float)texture_height }

    if fit == 1 || fit == 2 {
        if src_w == 0.0 || src_h == 0.0 {
            return dst
        }
        sx: float = bounds.width / src_w
        sy: float = bounds.height / src_h
        scale: float = sx
        if fit == 2 {
            if sy > scale { scale = sy }
        } else {
            if sy < scale { scale = sy }
        }
        dst.width = src_w * scale
        dst.height = src_h * scale
        dst.x = bounds.x + (bounds.width - dst.width) * 0.5
        dst.y = bounds.y + (bounds.height - dst.height) * 0.5
    }
    return dst
}
