#program_export
WidgetKindName :: (kind: s32) -> string {
    if kind == 0 { return "Screen" }
    if kind == 1 { return "Background" }
    if kind == 2 { return "Text" }
    if kind == 3 { return "Box" }
    if kind == 4 { return "Circle" }
