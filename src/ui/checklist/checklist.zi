#import "box_props"
#import "box"
#import "button_props"
#import "button"
#import "control_props"
#import "drawing_props"
#import "geometry"
#import "onboarding_checklist_task"
#import "paint_queue"
#import "session"
#import "semantic"
#import "shape_props"
#import "shape"
#import "style"
#import "style_sheet"
#import "svg_icon_props"
#import "svgicon"
#import "text_align"
#import "text_props"
#import "kryon/text_widget"
#import "theme"
#import "tree"
#import "widget_kind"
NumberText :: #import "std/number_text"

using WidgetKind;
using SemanticKind;

OnboardingChecklistProps :: struct {
    key: u64
    bounds: Rectangle
    title: string
    description: string
    tasks: []OnboardingChecklistTask
    disabled: bool
    id: s32
    class_name: s32
    style_kind: s32
    style_role: s32
}

OnboardingChecklistLayout :: struct {
    bounds: Rectangle
    header: Rectangle
    title: Rectangle
    description: Rectangle
    ring: Rectangle
    rows: [16]Rectangle
    circles: [16]Rectangle
    titles: [16]Rectangle
    bodies: [16]Rectangle
    actions: [16]Rectangle
    row_count: s32
    current: s32
}

OnboardingChecklistResult :: struct {
    node: s32
    layout: OnboardingChecklistLayout
    completed: s32
    total: s32
    progress: float32
    current: s32
    toggled: bool
    toggled_index: s32
    toggled_id: u64
    action: bool
    action_index: s32
    action_id: u64
}

#program_export
OnboardingChecklistProgress :: (tasks: []OnboardingChecklistTask) -> float32 {
    if tasks.count <= 0 { return 0.0 }
    done: s32 = 0
    for task: tasks { if task.done { done += 1 } }
    return cast(float32)done / cast(float32)tasks.count
}

#program_export
OnboardingChecklistCurrent :: (tasks: []OnboardingChecklistTask) -> s32 {
    for task, index: tasks {
        if !task.done { return cast(s32)index }
    }
    return -1
}

#program_export
OnboardingChecklistLayoutFor :: (props: OnboardingChecklistProps) -> OnboardingChecklistLayout {
    layout: OnboardingChecklistLayout
    layout.bounds = props.bounds
    if props.bounds.width <= 0.0 || props.bounds.height <= 0.0 { return layout }
    layout.row_count = cast(s32)props.tasks.count
    if layout.row_count > 16 { layout.row_count = 16 }
    layout.current = OnboardingChecklistCurrent(props.tasks)
    layout.header = Rectangle.{props.bounds.x, props.bounds.y, props.bounds.width, 70.0}
    layout.title = Rectangle.{props.bounds.x + 22.0, props.bounds.y + 12.0,
        props.bounds.width - 92.0, 20.0}
    layout.description = Rectangle.{props.bounds.x + 22.0, props.bounds.y + 37.0,
        props.bounds.width - 92.0, 18.0}
    layout.ring = Rectangle.{props.bounds.x + props.bounds.width - 62.0,
        props.bounds.y + 12.0, 46.0, 46.0}
    y := props.bounds.y + 70.0
    index: s32 = 0
    while index < layout.row_count {
        expanded := index == layout.current
        row_height: float32 = ifx expanded then 78.0 else 46.0
        layout.rows[index] = Rectangle.{props.bounds.x + 8.0, y,
            props.bounds.width - 16.0, row_height}
        layout.circles[index] = Rectangle.{layout.rows[index].x + 12.0,
            y + 12.0, 22.0, 22.0}
        layout.titles[index] = Rectangle.{layout.rows[index].x + 46.0,
            y + 14.0, layout.rows[index].width - 58.0, 18.0}
        if expanded {
            layout.bodies[index] = Rectangle.{layout.rows[index].x + 46.0,
                y + 36.0, layout.rows[index].width - 58.0, 18.0}
            layout.actions[index] = Rectangle.{layout.rows[index].x + 46.0,
                y + 44.0, 96.0, 26.0}
        }
        y += row_height
        index += 1
    }
    return layout
}

#program_export
OnboardingChecklistDescription :: (done: s32, total: s32, output: []u8) -> string {
    done_digits: [24]u8
    total_digits: [24]u8
    done_text := NumberText.FormatInteger(cast(s64)done, done_digits[:])
    total_text := NumberText.FormatInteger(cast(s64)total, total_digits[:])
    at: s32 = 0
    for byte: done_text { if at < cast(s32)output.count { output[at] = byte; at += 1 } }
    for byte: " of " { if at < cast(s32)output.count { output[at] = byte; at += 1 } }
    for byte: total_text { if at < cast(s32)output.count { output[at] = byte; at += 1 } }
    for byte: " complete" { if at < cast(s32)output.count { output[at] = byte; at += 1 } }
    return TextView(output[0:cast(s64)at])
}

#program_export
OnboardingChecklist :: (session: Session, props: OnboardingChecklistProps) -> OnboardingChecklistResult {
    result: OnboardingChecklistResult
    result.total = cast(s32)props.tasks.count
    result.current = OnboardingChecklistCurrent(props.tasks)
    result.toggled_index = -1
    result.action_index = -1
    result.layout = OnboardingChecklistLayoutFor(props)
    for task: props.tasks {
        if task.done { result.completed += 1 }
    }
    if result.total > 0 { result.progress = cast(float32)result.completed / cast(float32)result.total }
    if !SessionValid(session) || !TreeIsBuilding(session) ||
    props.bounds.width <= 0.0 || props.bounds.height <= 0.0 { return result }
    result.node = Box(session, BoxProps.{.key = props.key, .bounds = props.bounds,
        .id = props.id, .class_name = props.class_name,
        .fill = ColorFromPacked(CurrentSurface()), .border = ColorFromPacked(CurrentBorder()),
        .radius = CurrentThemeMetric(.ThemeMetricRadiusPanel)})
    if result.node < 0 || !TreePushScope(session, result.node) { return result }
    title := ifx props.title != "" then props.title else "Get started"
    description_digits: [72]u8
    description: string = props.description
    if description == "" {
        description = OnboardingChecklistDescription(result.completed, result.total,
            description_digits[:])
    }
    unused Text(session, TextProps.{.key = WidgetPartKey(props.key, 1),
        .bounds = result.layout.title, .text = title, .font = Text14,
        .id = props.id, .class_name = props.class_name,
            .semantic_kind = .SemanticHeading, .heading_level = 3,
        .align = TextAlign.TextAlignStart, .wrap = TextWrap.TextWrapEllipsis})
    unused Text(session, TextProps.{.key = WidgetPartKey(props.key, 2),
        .bounds = result.layout.description, .text = description, .font = Text12,
        .id = props.id, .class_name = props.class_name,
        .align = TextAlign.TextAlignStart, .wrap = TextWrap.TextWrapEllipsis})
    ring_center := Vector2.{result.layout.ring.x + result.layout.ring.width * 0.5,
        result.layout.ring.y + result.layout.ring.height * 0.5}
    ring_outer: float32 = 20.0
    ring_inner: float32 = 15.0
    unused Ring(session, RingProps.{.key = WidgetPartKey(props.key, 3),
        .center = ring_center, .inner_radius = ring_inner, .outer_radius = ring_outer,
        .start_angle = -90.0, .end_angle = -90.0 + 360.0 * result.progress,
        .color = ColorFromPacked(CurrentSuccess()), .id = props.id,
        .class_name = props.class_name})
    unused Ring(session, RingProps.{.key = WidgetPartKey(props.key, 4),
        .center = ring_center, .inner_radius = ring_inner, .outer_radius = ring_outer,
        .start_angle = -90.0 + 360.0 * result.progress, .end_angle = 270.0,
        .color = ColorFromPacked(CurrentPalette().control_track), .id = props.id,
        .class_name = props.class_name})
    index: s32 = 0
    while index < result.layout.row_count {
        task := props.tasks[index]
        row := result.layout.rows[index]
        expanded := index == result.current
        unused Box(session, BoxProps.{.key = WidgetPartKey(props.key, 20 + index),
            .bounds = row, .id = props.id, .class_name = props.class_name,
            .fill = ColorFromPacked(ifx expanded then CurrentPalette().surface_muted else 0),
            .radius = CurrentThemeMetric(.ThemeMetricRadiusItem)})
        if Button(session, ButtonProps.{.key = props.key ^ task.id,
            .bounds = result.layout.circles[index],
            .label = task.title, .icon_only = true, .circle = true,
            .icon_shape = "S2rr:M5 12l4 4L19 7", .disabled = props.disabled || task.disabled,
            .selected = task.done, .id = props.id, .class_name = props.class_name,
            .style_kind = StyleKindButton(), .emphasis = .ButtonEmphasisGhost,
            .size = .ControlSizeSmall}) == 1 && !props.disabled && !task.disabled {
            props.tasks[index].done = !task.done
            result.toggled = true
            result.toggled_index = index
            result.toggled_id = task.id
            if props.tasks[index].done { result.completed += 1 } else { result.completed -= 1 }
            result.progress = cast(float32)result.completed / cast(float32)result.total
        }
        unused Text(session, TextProps.{.key = WidgetPartKey(props.key, 60 + index),
            .bounds = result.layout.titles[index], .text = task.title, .font = Text14,
            .id = props.id, .class_name = props.class_name,
            .align = TextAlign.TextAlignStart, .wrap = TextWrap.TextWrapEllipsis})
        if expanded && (task.description != "" || task.action != "") {
            if task.description != "" {
                unused Text(session, TextProps.{.key = WidgetPartKey(props.key, 100 + index),
                    .bounds = result.layout.bodies[index], .text = task.description,
                    .font = Text12, .id = props.id, .class_name = props.class_name,
                    .align = TextAlign.TextAlignStart, .wrap = TextWrap.TextWrapAnywhere})
            }
            if task.action != "" && Button(session, ButtonProps.{
                .key = (props.key ^ task.id) ^ 0xB0, .bounds = result.layout.actions[index],
                .label = task.action, .disabled = props.disabled || task.disabled,
                .id = props.id, .class_name = props.class_name,
                .style_kind = StyleKindButton(), .emphasis = .ButtonEmphasisFilled,
                .size = .ControlSizeSmall}) == 1 && !props.disabled && !task.disabled {
                result.action = true
                result.action_index = index
                result.action_id = task.id
            }
        }
        index += 1
    }
    unused TreePopScope(session)
    return result
}
