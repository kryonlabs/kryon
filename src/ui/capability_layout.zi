#import "geometry"

Capability :: enum {
    FilePicker :: 1
    FileSave :: 2
    Share :: 4
    SecureStore :: 8
    BiometricUnlock :: 16
    Notifications :: 32
    Wakelock :: 64
    Clipboard :: 128
}

SafeArea :: struct {
    left: s32
    top: s32
    right: s32
    bottom: s32
}

ViewportSpec :: struct {
    width: s32
    height: s32
    safe_area: SafeArea
    padding: s32
    reserved_top: s32
    reserved_bottom: s32
    min_content_width: s32
}

#program_export
CapabilitiesHas :: (capabilities: u32, capability: Capability) -> bool {
    return (capabilities & cast(u32)capability) != cast(u32)0
}

#program_export
CapabilityName :: (capability: Capability) -> string {
    if capability == cast(Capability)FilePicker { return "file-picker" }
    if capability == cast(Capability)FileSave { return "file-save" }
    if capability == cast(Capability)Share { return "share" }
    if capability == cast(Capability)SecureStore { return "secure-store" }
    if capability == cast(Capability)BiometricUnlock { return "biometric-unlock" }
    if capability == cast(Capability)Notifications { return "notifications" }
    if capability == cast(Capability)Wakelock { return "wakelock" }
    if capability == cast(Capability)Clipboard { return "clipboard" }
    return "unknown"
}

#program_export
SafeContentRect :: (spec: ViewportSpec) -> Rectangle {
    x: s32 = spec.safe_area.left + spec.padding
    y: s32 = spec.safe_area.top + spec.reserved_top + spec.padding
    width: s32 = spec.width - spec.safe_area.left - spec.safe_area.right -
                 spec.padding * 2
    height: s32 = spec.height - spec.safe_area.top - spec.safe_area.bottom -
                  spec.reserved_top - spec.reserved_bottom - spec.padding * 2
    if spec.min_content_width > 0 && width < spec.min_content_width {
        width = spec.min_content_width
    }
    if height < 0 { height = 0 }
    bounds: Rectangle
    bounds.x = cast(float32)x
    bounds.y = cast(float32)y
    bounds.width = cast(float32)width
    bounds.height = cast(float32)height
    return bounds
}
