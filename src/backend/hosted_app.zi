// Runs a portable bundle inside a host application. The host decides each
// capability the bundle asks for and answers every call through one
// HostCall; a restart keeps the working instance until the new one passes
// the host's handshake. Bundles and their host may be built against
// different record layouts, so fields match by name.
#import "std/bundle_host"
#import "std/byte_text_linux"
#import "bundle_preload"
#import "frame_replay"

HOSTED_APP_CAPABILITY_LIMIT :: 64
// Instructions a single run may execute before it traps.
HOSTED_APP_STEP_LIMIT :: 10000000

HostedApp :: struct {
    bundle: *void
    instance: *void
    // The last run trapped or returned no answer.
    failed: bool
    // The host's call, and a quiet frame to show again; see HostedAppRunFrame.
    replay: *FrameReplay
}

// Whether the bundle may call module.function. context is the one given to
// every call of the bundle.
HostedAppAllows :: #type (context: *void, module: string, function: string) -> bool;
// The host's handshake for a started instance, such as a first run whose
// answer identifies the app.
HostedAppAccepts :: #type (context: *void) -> bool;

HostedAsset :: struct {
    found: bool
    data: string
}

HostedAppOpen :: (app: *HostedApp, bytes: string) -> bool {
    HostedAppClose(app)
    descriptor := cast(*TextDescriptor)(*bytes)
    app.bundle = OpenBundleBytes(descriptor.data, cast(u64)bytes.count)
    return app.bundle != null
}

// Takes the bundle BundlePreloadStart opened from bytes, waiting for it if
// it is still opening. Without a preload, or when it failed, opens bytes.
HostedAppOpenPreloaded :: (app: *HostedApp, bytes: string, preload: s32) -> bool {
    if preload < 0 {
        return HostedAppOpen(app, bytes)
    }
    HostedAppClose(app)
    app.bundle = BundlePreloadTake(preload, bytes)
    if app.bundle == null {
        return HostedAppOpen(app, bytes)
    }
    return true
}

// Checks every capability with allows, binds them all to call and creates an
// instance; it does not run it.
HostedAppStart :: (app: *HostedApp, allows: HostedAppAllows, call: HostCall, context: *void) -> bool {
    app.failed = false
    if app.bundle == null {
        return false
    }
    count := BundleCapabilities(app.bundle)
    if count > cast(u64)HOSTED_APP_CAPABILITY_LIMIT {
        return false
    }
    if app.replay == null {
        app.replay = cast(*FrameReplay)HostedAllocateZeroed(cast(usize)1, size_of(FrameReplay))
        if app.replay == null { return false }
    }
    FrameReplayClear(app.replay)
    app.replay.call = call
    app.replay.context = context
    bindings: [HOSTED_APP_CAPABILITY_LIMIT]HostBinding
    index: u64 = 0
    while index < count {
        module := BundleCapabilityModuleName(app.bundle, index)
        function := BundleCapabilityFunctionName(app.bundle, index)
        if module == null || function == null ||
        !allows(context, TextFromCString(module), TextFromCString(function)) {
            return false
        }
        bindings[index].module = module
        bindings[index].function = function
        bindings[index].call = HostedAppCall
        // The replay state stays where it was made, wherever the host keeps app.
        bindings[index].context = cast(*void)app.replay
        index += 1
    }
    app.instance = InstantiateBundle(app.bundle, *bindings[0], count)
    if app.instance == null {
        return false
    }
    MatchBundleFieldsByName(app.instance, true)
    LimitBundleSteps(app.instance, HOSTED_APP_STEP_LIMIT)
    return true
}

// Runs the instance's entry once. False, and failed, when it traps or
// returns no answer.
HostedAppRun :: (app: *HostedApp, answer: *s64) -> bool {
    if app.instance == null {
        return false
    }
    has_answer: s32
    if RunBundleInstance(app.instance, answer, *has_answer) == 0 || has_answer == 0 {
        app.failed = true
        return false
    }
    return true
}

// Every call of the bundle passes here on its way to the host's call, and
// is recorded while a quiet frame runs.
HostedAppCall :: (context: *void, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    replay := cast(*FrameReplay)context
    returned := replay.call(replay.context, module, function, arguments, count, result)
    if replay.recording {
        FrameReplayRecord(replay, module, function, arguments, count, result.*, returned)
    }
    return returned
}

// Runs a frame of the app, or, when quiet says nothing reached it since its
// last quiet frame and it does not animate, shows that frame again if its
// reads still answer the same. A quiet frame that runs is recorded.
HostedAppRunFrame :: (app: *HostedApp, answer: *s64, quiet: bool) -> bool {
    if app.replay == null {
        return HostedAppRun(app, answer)
    }
    if !quiet {
        app.replay.ready = false
    } else if FrameReplayRun(app.replay, answer) {
        return true
    }
    FrameReplayClear(app.replay)
    record := quiet && app.replay.settle <= 0
    if app.replay.settle > 0 { app.replay.settle -= 1 }
    app.replay.recording = record
    ran := HostedAppRun(app, answer)
    app.replay.recording = false
    app.replay.ready = record && ran
    app.replay.answer = answer.*
    return ran
}

// Starts a new instance of the open bundle. The current instance is closed
// only once the new one passes accepts; otherwise the app keeps running it.
HostedAppRestart :: (app: *HostedApp, allows: HostedAppAllows, call: HostCall,
    context: *void, accepts: HostedAppAccepts) -> bool {
    previous := app.instance
    previous_failed := app.failed
    app.instance = null
    ready := HostedAppStart(app, allows, call, context) && accepts(context)
    if ready {
        CloseBundleInstance(previous)
    } else {
        CloseBundleInstance(app.instance)
        app.instance = previous
        app.failed = previous_failed
    }
    return ready
}

HostedAppClose :: (app: *HostedApp) {
    if app.replay != null {
        FrameReplayClose(app.replay)
        HostedRelease(cast(*void)app.replay)
    }
    HostedAssetIndexDrop(app.bundle)
    CloseBundleInstance(app.instance)
    CloseBundle(app.bundle)
    app.* = HostedApp.{}
}

hosted_c :: #system_library "c";
HostedAllocateZeroed :: (count: usize, size: usize) -> *void #foreign hosted_c "calloc";
HostedRelease :: (memory: *void) #foreign hosted_c "free";

// A game draws each tile of its board as an image, and each image named its
// asset by scanning every asset of the bundle: tens of thousands of name
// comparisons a frame. Each open bundle gets a table that finds an asset by
// a hash of its name; a bundle's assets never change while it is open.
HostedAssetIndex :: struct {
    bundle: *void
    // Asset number plus one, or zero for an empty slot.
    slots: *u32
    mask: u64
}

HOSTED_ASSET_INDEXES :: 32

hosted_asset_indexes: [32]HostedAssetIndex;
hosted_asset_next: s32;

HostedAssetHash :: (name: *u8, count: s64) -> u64 {
    hash: u64 = cast(u64)14695981039346656037
    for index: cast(s64)0..count - 1 { hash = (hash ^ cast(u64)name[index]) * cast(u64)1099511628211 }
    return hash
}

HostedAssetIndexDrop :: (bundle: *void) {
    if bundle == null { return }
    for index: cast(s32)0..HOSTED_ASSET_INDEXES - 1 {
        if hosted_asset_indexes[index].bundle == bundle {
            HostedRelease(cast(*void)hosted_asset_indexes[index].slots)
            hosted_asset_indexes[index] = .{}
        }
    }
}

HostedAssetIndexFor :: (bundle: *void) -> *HostedAssetIndex {
    for index: cast(s32)0..HOSTED_ASSET_INDEXES - 1 {
        if hosted_asset_indexes[index].bundle == bundle { return *hosted_asset_indexes[index] }
    }
    count := BundleAssets(bundle)
    size: u64 = 64
    while size < count * 2 { size *= 2 }
    slots := cast(*u32)HostedAllocateZeroed(cast(usize)size, 4)
    if slots == null { return null }
    asset: u64 = 0
    while asset < count {
        name := BundleAssetPath(bundle, asset)
        if name != null {
            length: s64 = 0
            while name[length] != cast(u8)0 { length += 1 }
            slot := HostedAssetHash(name, length) & (size - 1)
            while slots[slot] != cast(u32)0 { slot = (slot + 1) & (size - 1) }
            slots[slot] = cast(u32)(asset + 1)
        }
        asset += 1
    }
    entry := *hosted_asset_indexes[hosted_asset_next]
    HostedRelease(cast(*void)entry.slots)
    entry.* = .{.bundle = bundle, .slots = slots, .mask = size - 1}
    hosted_asset_next = (hosted_asset_next + 1) % HOSTED_ASSET_INDEXES
    return entry
}

// The bytes of an asset packed in the bundle, borrowed while it is open.
HostedAppAsset :: (app: *HostedApp, path: string) -> HostedAsset {
    if app.bundle == null {
        return HostedAsset.{}
    }
    table := HostedAssetIndexFor(app.bundle)
    if table != null {
        descriptor := cast(*TextDescriptor)(*path)
        slot := HostedAssetHash(descriptor.data, path.count) & table.mask
        while table.slots[slot] != cast(u32)0 {
            index := cast(u64)(table.slots[slot] - 1)
            if HostedAssetNamed(BundleAssetPath(app.bundle, index), path) {
                return HostedAsset.{.found = true, .data = TextFromBytes(BytesFromPointer(
                            BundleAssetBytes(app.bundle, index), BundleAssetLength(app.bundle, index)))}
            }
            slot = (slot + 1) & table.mask
        }
        return HostedAsset.{}
    }
    count := BundleAssets(app.bundle)
    index: u64 = 0
    while index < count {
        if HostedAssetNamed(BundleAssetPath(app.bundle, index), path) {
            return HostedAsset.{.found = true, .data = TextFromBytes(BytesFromPointer(
                        BundleAssetBytes(app.bundle, index), BundleAssetLength(app.bundle, index)))}
        }
        index += 1
    }
    return HostedAsset.{}
}

HostedAssetNamed :: (name: *u8, path: string) -> bool {
    if name == null {
        return false
    }
    for index: cast(s64)0..path.count - 1 {
        if name[index] != path[index] {
            return false
        }
    }
    return name[path.count] == cast(u8)0
}
