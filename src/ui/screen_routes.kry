#module "screen_routes"

#import "app_runtime.h"
#import "ui_page_props.generated.h"
#import <stdio.h>
#import <stdlib.h>
#import <string.h>

IsInspectActive :: () -> int #export {
    value := getenv("KRYON_INSPECT")
    if value == nil || value[0] == '\0' || value[0] == '0' {
        return 0
    }
    return 1
}

app_screen_count :: (userdata: void*) -> int #private {
    app := (App*)userdata
    if app == nil || app->routes == nil || app->route_count < 0 {
        return 0
    }
    return app->route_count
}

app_screen :: (userdata: void*, index: int) -> AppScreenInfo #private {
    app := (App*)userdata
    if app == nil || app->routes == nil ||
       index < 0 || index >= app->route_count {
        return (AppScreenInfo){0}
    }
    return app->routes[index]
}

app_select_screen :: (userdata: void*, index: int) #private {
    app := (App*)userdata
    if app == nil || app->routes == nil ||
       index < 0 || index >= app->route_count {
        return
    }
    if app->selected_route == index {
        return
    }
    app->selected_route = index
    if app->routes[index].enter != nil {
        app->routes[index].enter(app->app, index)
    }
}

app_select_source_path :: (userdata: void*,
                            source_path: const char*) -> int #private {
    app := (App*)userdata
    if app == nil || app->routes == nil || source_path == nil {
        return 0
    }
    for int index = 0; index < app->route_count; index++ {
        route_path := app->routes[index].source_path
        if route_path != nil && strcmp(route_path, source_path) == 0 {
            app_select_screen(userdata, index)
            return 1
        }
    }
    return 0
}

app_draw :: (userdata: void*, viewport: Rectangle) #private {
    app := (App*)userdata
    if app == nil || app->routes == nil || app->route_count <= 0 {
        return
    }
    index := app->selected_route
    if index < 0 || index >= app->route_count {
        index = 0
    }
    if app->routes[index].draw != nil {
        app->routes[index].draw(app->app, viewport)
    }
}

BindAppHost :: (app: App*, host: AppHost*) #export {
    if app == nil || host == nil {
        return
    }
    host->userdata = app
    host->screen_count = app_screen_count
    host->screen = app_screen
    host->select_screen = app_select_screen
    host->select_source_path = app_select_source_path
    host->draw = app_draw
}

GetAppScreenCount :: (host: AppHost*) -> int #export {
    if host == nil || host->screen_count == nil {
        return 0
    }
    return host->screen_count(host->userdata)
}

GetAppScreen :: (host: AppHost*, index: int) -> AppScreenInfo #export {
    if host == nil || host->screen == nil {
        return (AppScreenInfo){0}
    }
    return host->screen(host->userdata, index)
}

SetAppScreen :: (host: AppHost*, index: int) #export {
    if host == nil || host->select_screen == nil {
        return
    }
    host->select_screen(host->userdata, index)
}

SetAppScreenById :: (host: AppHost*, id: const char*) -> int #export {
    if host == nil || id == nil || id[0] == '\0' {
        return 0
    }
    count := GetAppScreenCount(host)
    for int index = 0; index < count; index++ {
        screen := GetAppScreen(host, index)
        if screen.id != nil && strcmp(screen.id, id) == 0 {
            SetAppScreen(host, index)
            return 1
        }
    }
    return 0
}

SetAppScreenBySourcePath :: (host: AppHost*,
                              source_path: const char*) -> int #export {
    if host == nil || host->select_source_path == nil {
        return 0
    }
    return host->select_source_path(host->userdata, source_path)
}

app_route_copy_id :: (dst: char*, dst_size: size_t,
                       source: const char*) #private {
    if dst == nil || dst_size == 0 {
        return
    }
    dst[0] = '\0'
    if source == nil {
        return
    }
    start: size_t = 0
    while source[start] == ' ' || source[start] == '\t' ||
          source[start] == '#' {
        start++
    }
    if source[start] == '/' {
        start++
    }
    length: size_t = 0
    while source[start + length] != '\0' && source[start + length] != '/' &&
          source[start + length] != '?' && source[start + length] != '&' &&
          length + 1 < dst_size {
        dst[length] = source[start + length]
        length++
    }
    dst[length] = '\0'
}

app_route_current_id :: (dst: char*, dst_size: size_t) -> int #private {
    if dst == nil || dst_size == 0 {
        return 0
    }
    dst[0] = '\0'
    hash := GetRouteHash()
    if hash == nil || hash[0] == '\0' {
        return 0
    }
    app_route_copy_id(dst, dst_size, hash)
    return dst[0] != '\0' ? 1 : 0
}

SetAppScreenFromRoute :: (host: AppHost*) -> int #export {
    if host == nil {
        return 0
    }
    if GetAppScreenCount(host) <= 0 {
        return 0
    }
    id: [256]char = {0}
    if app_route_current_id(id, sizeof(id)) && SetAppScreenById(host, id) {
        return 1
    }
    SetAppScreen(host, 0)
    return 0
}

app_set_screen_route :: (host: AppHost*, index: int,
                          replace: int) #private {
    if host == nil || index < 0 || index >= GetAppScreenCount(host) {
        return
    }
    screen := GetAppScreen(host, index)
    if screen.id == nil || screen.id[0] == '\0' {
        return
    }
    path := GetRoutePath()
    if path == nil || path[0] == '\0' {
        path = "/"
    }
    route: [320]char = {0}
    snprintf(route, sizeof(route), "%s#/%s", path, screen.id)
    if replace != 0 {
        ReplaceRoute(route)
    } else {
        PushRoute(route)
    }
    SetAppScreen(host, index)
}

PushAppScreenRoute :: (host: AppHost*, index: int) #export {
    app_set_screen_route(host, index, 0)
}

ReplaceAppScreenRoute :: (host: AppHost*, index: int) #export {
    app_set_screen_route(host, index, 1)
}

DrawAppScreen :: (host: AppHost*, viewport: Rectangle) #export {
    if host == nil || host->draw == nil {
        return
    }
    host->draw(host->userdata, viewport)
}

ResizeAppHost :: (host: AppHost*, width: int, height: int) #export {
    if host == nil || host->resize == nil {
        return
    }
    host->resize(host->userdata, width, height)
}

SetAppHostFocused :: (host: AppHost*, focused: int) #export {
    if host == nil || host->set_focused == nil {
        return
    }
    host->set_focused(host->userdata, focused)
}
