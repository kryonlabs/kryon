#import "kryon.h"

ANSWER :: #run 6 * 7
#assert ANSWER == 42, "spec #run assertion failed"
#assert 1 + 1 == 2, "spec arithmetic assertion failed"

state {
    count: int = 0
}

app "Spec Contract" {
    size 320 240
    fps 60
}

App :: () #ui {
    Screen root: {
        ClearBackground(GetThemeBackground())
        Background(GetThemeSurface())
        Text((TextProps){.bounds={ScaleUIPx(8), ScaleUIPx(8), 0, 0}, .text="Spec Contract", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        if count < 42 {
            count = count + 1
        }
        Text((TextProps){.bounds={ScaleUIPx(8), ScaleUIPx(32), 0, 0}, .text="ready", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
    }
}
