#import "session"
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "semantic"
#import "tree"
#import "tree_draw"
#import "tree_input"

using FrameStatus;
host_api :: #system_library "host_api";

// These records deliberately expose values useful for comparing frames, not
// the tree's internal links or queue storage. They also cross the portable
// host boundary without importing internal record types into the host ABI.
FrameNode :: struct {
    key: u64
    parent_key: u64
    kind: s32
    x: float32
    y: float32
    width: float32
    height: float32
    label: string
    semantic_kind: s32
    heading_level: s32
    identity_generation: u64
    interactive: bool
    disabled: bool
    loading: bool
    selected: bool
    focus_id: s32
    focused: bool
    has_text: bool
    read_only: bool
    secure: bool
    text_bytes: s32
    text_cursor: s32
    text_anchor: s32
    text_value: string
}

FramePaint :: struct {
    kind: s32
    node: s32
    x: float32
    y: float32
    width: float32
    height: float32
    clip_x: float32
    clip_y: float32
    clip_width: float32
    clip_height: float32
    red: u8
    green: u8
    blue: u8
    alpha: u8
    radius: float32
    segments: s32
    line_width: float32
    value: string
    text_x: s32
    text_y: s32
    font: s32
    asset_path: string
    texture_id: u32
    source_x: float32
    source_y: float32
    source_width: float32
    source_height: float32
    origin_x: float32
    origin_y: float32
    rotation: float32
}

FrameNodeFrom :: (entry: TreeEntry) -> FrameNode {
    node: FrameNode = .{.key = entry.key, .parent_key = entry.parent_key, .kind = entry.kind,
        .x = entry.bounds.x, .y = entry.bounds.y, .width = entry.bounds.width,
        .height = entry.bounds.height, .label = entry.semantic_label,
        .semantic_kind = cast(s32)entry.semantic_kind, .heading_level = entry.heading_level,
        .identity_generation = entry.identity_generation, .interactive = entry.interactive,
        .disabled = entry.disabled, .loading = entry.loading, .selected = entry.selected,
        .focus_id = entry.focus_id, .has_text = entry.has_text, .read_only = entry.read_only,
        .secure = entry.secure}
    if !entry.secure {
        node.text_bytes = entry.text_bytes
        node.text_cursor = entry.text_cursor
        node.text_anchor = entry.text_anchor
    }
    return node
}

FramePaintFrom :: (command: PaintCommand) -> FramePaint {
    return FramePaint.{.kind = command.kind, .node = command.node, .x = command.bounds.x,
        .y = command.bounds.y, .width = command.bounds.width, .height = command.bounds.height,
        .clip_x = command.clip.x, .clip_y = command.clip.y, .clip_width = command.clip.width,
        .clip_height = command.clip.height, .red = command.color.r, .green = command.color.g,
        .blue = command.color.b, .alpha = command.color.a, .radius = command.radius,
        .segments = command.segments, .line_width = command.line_width, .value = command.value,
        .text_x = command.x, .text_y = command.y, .font = command.font,
        .asset_path = command.asset_path, .texture_id = command.texture_id,
        .source_x = command.source.x, .source_y = command.source.y,
        .source_width = command.source.width, .source_height = command.source.height,
        .origin_x = command.origin.x, .origin_y = command.origin.y, .rotation = command.rotation}
}

// These effects belong to an opt-in inspection host. Ordinary EndFrame does
// not require them. A host may record the values without opening a display.
RecordFrameStart :: (node_count: s32, paint_count: s32) #foreign host_api;
RecordNode :: (index: s32, node: FrameNode) #foreign host_api;
RecordPaint :: (index: s32, command: FramePaint) #foreign host_api;
RecordFrameEnd :: () #foreign host_api;
RecordFrameFailure :: (failure: FrameFailure) #foreign host_api;

// Capture only a complete, committed frame. All values are sent before paint
// is flushed, while the queue still contains the commands chosen by widgets.
#program_export
EndFrameCapture :: (session: Session) -> bool {
    status: FrameStatus = CommitFrame(session)
    if status != cast(FrameStatus)FrameOk {
        failure: FrameFailure = FrameFailureAt(session)
        failure.status = cast(s32)status
        failure.message = FrameStatusMessage(failure.status)
        RecordFrameFailure(failure)
        return false
    }
    node_count: s32 = TreeCount(session)
    paint_count: s32 = PendingPaintCount(session)
    RecordFrameStart(node_count, paint_count)
    index: s32 = 0
    while index < node_count {
        entry: TreeEntry = TreeNodeAt(session, index)
        node: FrameNode = FrameNodeFrom(entry)
        node.focused = TreeFocusedAt(session, index) || (entry.has_text && entry.selected)
        bytes: [65536]u8
        if entry.has_text && !entry.secure && entry.text_bytes <= 65536 {
            node.text_value = TreeTextRange(session, index, 0, entry.text_bytes, bytes[:])
        }
        RecordNode(index, node)
        index += 1
    }
    index = 0
    while index < paint_count {
        RecordPaint(index, FramePaintFrom(PendingPaintAt(session, index)))
        index += 1
    }
    RecordFrameEnd()
    PaintFlush(session)
    return true
}
