#module "dropdown"
#import "style"
#import "button"
#import "surface"
#import "control_props"

# Roles adapt a resolved Button style; they do not define another palette.
# 0: trigger, 1: floating panel, 2: option row.
SelectionEmphasis :: (surface: u32) -> i32 #export {
    if LightSurface(surface) { return ButtonEmphasisSoft }
    return ButtonEmphasisFilled
}

Appearance :: (base: StyleData, accent: StyleData, surface: u32,
    role: i32, state: i32, selected: bool) -> StyleData #export {
    # The trigger is exactly a neutral soft Button, including all states,
    # typography, geometry, material, and motion. Content is supplied by Dropdown.
    if role == 0 { return base }
    light: bool = LightSurface(surface)
    if role == 2 {
        if selected && state != ButtonStateDisabled { base = accent }
        # Light menu rows are flush with the popup instead of separate raised
        # buttons. All their colors, typography, and dimensions remain shared.
        if light {
            base.material = (i32)MaterialFlat
            base.border = (u32)0
            base.border_width = 0.0
        }
        return base
    }
    # Floating glass is the sole dropdown-specific surface adaptation. Keep
    # Button typography, padding, opacity, border width, and disabled policy.
    base.material = (i32)MaterialGlass
    base.fields = base.fields | (u32)StyleBackgroundEnd | (u32)StyleMaterial
    base.radius = base.radius + 2.0
    if light {
        base.background = GradientColor(surface, (~(u32)0), 0.85)
        base.background_end = GradientColor(surface, (~(u32)0), 0.40)
        base.border = GradientColor(surface, accent.background, 0.18)
    } else {
        base.background = GradientColor(surface, base.background, 0.80)
        base.background_end = GradientColor(surface, base.border, 0.38)
        base.border = GradientColor(base.border, (~(u32)0), 0.18)
    }
    base.background = Opacity(base.background, 0.97)
    base.background_end = Opacity(base.background_end, 0.92)
    return base
}

ContentMetrics :: struct {
    padding: float
    gap: float
    icon: float
    font: float
}

# Both native hosts consume Button's resolved content metrics. Geometry does
# not silently select another size: the standard dropdown uses medium tokens.
Content :: (paint: StyleData, scale: float) -> ContentMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    return (ContentMetrics){.padding = paint.padding_x * scale,
        .gap = paint.gap * scale, .icon = paint.icon_size * scale,
        .font = paint.font_size * scale}
}
