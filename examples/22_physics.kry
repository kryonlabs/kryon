#module "example_physics"
#import "kryon.h"
#import "kryon_example_font.h"
#style <material> as material

app "Kryon Physics" {
    size 640 420
    fps 60
    font examples
    scene main
}

#enum {
    GROUND_X = 320
    GROUND_Y = 380
    BOX_X = 320
    BOX_Y = 60
}

scene main {
    ScenePhysicsCreate(scene, 0.0, 980.0)

    ground := NodeCreate(scene, 0, NodeKindBody2D, "ground")
    NodeSetProps(scene, ground, Body2DPropsAlloc(Body2DStatic))
    NodeSetPosition(scene, ground, GROUND_X, GROUND_Y)
    ground_shape := NodeCreate(scene, ground, NodeKindCollisionShape2D, "ground_shape")
    NodeSetProps(scene, ground_shape, CollisionShape2DPropsAlloc(Shape2DBox, 400.0, 32.0))

    box := NodeCreate(scene, 0, NodeKindBody2D, "box")
    NodeSetProps(scene, box, Body2DPropsAlloc(Body2DDynamic))
    NodeSetPosition(scene, box, BOX_X, BOX_Y)
    box_shape := NodeCreate(scene, box, NodeKindCollisionShape2D, "box_shape")
    NodeSetProps(scene, box_shape, CollisionShape2DPropsAlloc(Shape2DBox, 48.0, 48.0))
}
