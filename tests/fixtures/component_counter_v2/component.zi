#import "component_protocol"
#import "button"
#import "button_props"
#import "text"
#import "text_props"
#import "geometry"
#import "std/vec"

ComponentLabel :: struct { text: string }
ComponentOwned :: struct { label: ComponentLabel; samples: [2]s64 }
component_owned: ComponentOwned = ComponentOwned.{
    .label = ComponentLabel.{.text = "replacement"}
};

component_schema_version: s64 = 2;
component_count: s64 = 99;
component_label_kind: s64 = 2;
component_suffix_kind: s64 = 1;

Label :: () -> string {
    value: Vec(u8)
    label := component_owned.label.text
    suffix := ifx component_suffix_kind == 0 then "" else "v2"
    BuilderPrint(*value, "% % %", label, component_count, suffix)
    return BuilderFinish(value)
}

#program_export
Frame :: () -> s64 {
    if component_schema_version < 2 { return 1 }
    session := ComponentSession()
    bounds := ComponentBounds()
    action := Button(session, ButtonProps.{
        .key = 101, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 16.0, 112.0, 36.0
        }, .label = "Increment"
    })
    if action != 0 { component_count += 2; component_owned.samples[0] += 1; component_owned.samples[1] = component_count }
    Text(session, TextProps.{
        .key = 102, .bounds = Rectangle.{
            bounds.x + 16.0, bounds.y + 64.0, 220.0, 28.0
        }, .text = Label(), .font = Text18
    })
    if component_count != 7 && component_owned.samples[1] != component_count { return 1 }
    return 0
}
