#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
#import "kryon/style_sheet"
Box :: #import "kryon/box";
Text :: #import "kryon/text";
TextArea :: #import "kryon/text_area";
TextField :: #import "kryon/text_field";
#import "kryon/drawing_props"
#import "kryon/input_protocol"
#import "kryon/key_input"
#import "kryon/system_clipboard"
#import "kryon/tree_input"
#import "kryon/system_theme"
#import "std/number_text"

WidgetContext :: struct { theme: s32; now: float32; disabled: bool; reduced_motion: bool }

WidgetInput :: (session: Session) -> WidgetContext {
    snapshot := CaptureFrameInput(session)
    result: WidgetContext
    result.now = cast(float32)snapshot.elapsed_ms / 1000.0
    result.theme = ifx StyleTokenColor("canvas").r < 128 then 2 else 1
    result.disabled = example_disabled
    result.reduced_motion = example_reduced_motion
    return result
}

gallery_view: Rectangle = Rectangle.{.x = 0.0, .y = 0.0, .width = 480.0, .height = 320.0};

gallery_live: bool;

gallery_now: float32;

gallery_reduced_motion: bool;

SetGalleryViewport :: (view: Rectangle, live: bool, now: float32, reduced_motion: bool) {
    gallery_view = view; gallery_live = live; gallery_now = now
    gallery_reduced_motion = reduced_motion
}

GalleryBounds :: (bounds: Rectangle) -> Rectangle {
    if !gallery_live { return bounds }
    bounds.x = gallery_view.x + bounds.x * gallery_view.width / 480.0
    bounds.y += gallery_view.y
    bounds.width *= gallery_view.width / 480.0
    return bounds
}

quiet: bool;

multi: [5]bool;

field_bytes: [1024]u8;

field_next: [1024]u8;

field_length: s32;

empty_bytes: [1024]u8;

empty_next: [1024]u8;

empty_length: s32;

area_bytes: [4096]u8;

area_next: [4096]u8;

area_length: s32;

initialized: bool;

demo_area_cursor: s32;

demo_area_anchor: s32;

demo_area_scroll: s32;

Copy :: (target: []u8, value: string) -> s32 {
    count := cast(s32)value.count
    if count > cast(s32)target.count { count = cast(s32)target.count }
    for index: 0..count - 1 { target[index] = value[index] }
    return count
}

Apply :: (target: []u8, length: s32, edit: TextField.Edit) -> s32 {
    if !edit.changed { return length }
    if edit.start < 0 || edit.end < edit.start || edit.end > length { return length }
    new_length := length - (edit.end - edit.start) + cast(s32)edit.replacement.count
    if new_length > cast(s32)target.count { return length }
    scratch: [4096]u8
    at := 0
    for index: 0..edit.start - 1 { scratch[at] = target[index]; at += 1 }
    for byte: edit.replacement { scratch[at] = byte; at += 1 }
    for index: edit.end..length - 1 { scratch[at] = target[index]; at += 1 }
    for index: 0..new_length - 1 { target[index] = scratch[index] }
    return new_length
}

EditArea :: (session: Session, bounds: Rectangle, disabled: bool, input: TextArea.Input) {
    result := TextArea.Draw(session, TextArea.Props.{.bounds = bounds, .value = TextView(area_bytes[0:area_length]), .max_bytes = 4096, .wrap = true, .disabled = disabled, .cursor = demo_area_cursor, .anchor = demo_area_anchor, .scroll_y = demo_area_scroll, .input = input})
    if result.clipboard_write { unused SystemClipboardSet(result.clipboard_text) }
    demo_area_cursor = result.cursor; demo_area_anchor = result.anchor; demo_area_scroll = result.scroll_y
    edit: TextField.Edit = .{.start = result.edit.start, .end = result.edit.end, .replacement = result.edit.replacement, .changed = result.edit.changed}
    area_length = Apply(area_next[:], area_length, edit)
}

SceneInput :: struct { field: TextField.Input; area: TextArea.Input }

b: Rectangle;

typed: [128]u8;

Prepare :: (session: Session, scene: s32) -> SceneInput {
    if !initialized {
        field_length = Copy(field_bytes[:], "A quiet place to think")
        area_length = Copy(area_bytes[:], "A small note\n\nClear typography and careful spacing make everyday work feel calm. Café, Ω and é.")
        multi[0] = true; multi[2] = true
        unused Copy(field_next[:], TextView(field_bytes[0:field_length]))
        unused Copy(area_next[:], TextView(area_bytes[0:area_length]))
        initialized = true
    }
    for index: 0..field_length - 1 { field_bytes[index] = field_next[index] }
    for index: 0..empty_length - 1 { empty_bytes[index] = empty_next[index] }
    for index: 0..area_length - 1 { area_bytes[index] = area_next[index] }
    input_key: s32 = 0
    if scene == 1 || scene == 2 { input_key = KeyboardTake(session) }
    input_text := TypedTextTake(session, typed[:])
    field_input := TextFieldInputFor(input_key, KeyboardModifiers(session), input_text)
    area_input: TextArea.Input
    area_input.text = field_input.text
    area_input.left = field_input.left; area_input.right = field_input.right
    area_input.home = field_input.home; area_input.end = field_input.end
    area_input.shift = field_input.shift
    area_input.backspace = field_input.backspace
    area_input.delete_forward = field_input.delete_forward
    area_input.select_all = field_input.select_all
    area_input.copy = field_input.copy; area_input.cut = field_input.cut
    area_input.paste = field_input.paste
    area_input.escape = field_input.escape
    area_input.enter = input_key == KeyEnter
    area_input.up = input_key == KeyUp; area_input.down = input_key == KeyDown
    area_input.page_up = input_key == KeyPageUp; area_input.page_down = input_key == KeyPageDown
    b = GalleryBounds(Rectangle.{24.0, 64.0, 432.0, 44.0})
    return SceneInput.{field_input, area_input}
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := WidgetInput(session)
    SetGalleryViewport(viewport, true, example_input.now, example_input.reduced_motion)
    Box.Draw(session, Box.Props.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text.Draw(session, Text.Props.{.key = 9001, .bounds = .{viewport.x + 24.0, viewport.y + 12.0, viewport.width - 48.0, 36.0}, .text = "TextArea", .size = 23})
    disabled := example_input.disabled
    scene: s32 = 2
    input := Prepare(session, scene)
    area_input := input.area
    b.height = 188.0
    EditArea(session, b, disabled, area_input)
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
