// Part of the kss_parser module, loaded by src/kss/kss_parser.zi.
// Source bytes, names, white space and comments, literals, and diagnostics.

// Byte helpers over the borrowed source view. Every advance keeps the
// line/column provenance current so diagnostics and rule origins stay exact.

KssAtEnd :: (c: KssCursor) -> bool {
    return c.pos >= (cast(s32)c.source.count)
}

KssPeek :: (c: KssCursor, ahead: s32) -> u8 {
    index: s32 = c.pos + ahead
    if index < 0 || index >= (cast(s32)c.source.count) {
        return 0
    }
    return c.source[index]
}

KssAdvance :: (c: KssCursor, count: s32) -> KssCursor {
    step: s32 = 0
    while step < count {
        if c.pos < (cast(s32)c.source.count) {
            if c.source[c.pos] == 10 {
                c.line = c.line + 1
                c.column = 1
            } else {
                c.column = c.column + 1
            }
            c.pos = c.pos + 1
        }
        step = step + 1
    }
    return c
}

KssIsSpace :: (byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 13 || byte == 10 || byte == 11 || byte == 12
}

// Quoted text ends on its line, as CSS strings do, and an escape does not
// carry it over; re-indenting a later line must not change what it says.
KssIsLineBreak :: (byte: u8) -> bool {
    return byte == 10 || byte == 13
}

// An import target names a pack or a path: no spaces, control bytes, quotes,
// angle brackets, or the braces and semicolons that give a sheet structure.
KssImportTargetByte :: (byte: u8) -> bool {
    return byte > 32 && byte != 127 && byte != 34 && byte != 39 &&
        byte != 59 && byte != 60 && byte != 62 && byte != 123 && byte != 125
}

KssIsDigit :: (byte: u8) -> bool {
    return byte >= 48 && byte <= 57
}

KssIsHexDigit :: (byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102) ||
        (byte >= 65 && byte <= 70)
}

KssIsAlpha :: (byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

KssIdentStart :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || byte == 95 || byte == 45
}

KssIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45 ||
        byte == 46
}

KssSelectorIdentChar :: (byte: u8) -> bool {
    return KssIsAlpha(byte) || KssIsDigit(byte) || byte == 95 || byte == 45
}

KssLower :: (byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 {
        return byte + 32
    }
    return byte
}

KssNameEquals :: (name: KssName, text: string) -> bool {
    if name.length != (cast(s32)text.count) {
        return false
    }
    index: s32 = 0
    while index < name.length {
        if KssLower(name.bytes[index]) != KssLower(text[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssNameEqualsName :: (a: KssName, b: KssName) -> bool {
    if a.length != b.length {
        return false
    }
    index: s32 = 0
    while index < a.length {
        if KssLower(a.bytes[index]) != KssLower(b.bytes[index]) {
            return false
        }
        index = index + 1
    }
    return true
}

KssMakeName :: (text: string) -> KssName {
    name: KssName
    index: s32 = 0
    while index < (cast(s32)text.count) && index < 64 {
        name.bytes[index] = text[index]
        index = index + 1
    }
    name.length = index
    return name
}

KssCopyFileName :: (text: string) -> KssSourceFile {
    file: KssSourceFile
    index: s32 = 0
    while index < (cast(s32)text.count) && index < 96 {
        file.name[index] = text[index]
        index = index + 1
    }
    file.length = index
    return file
}

KssNameAppend :: (destination: KssName, byte: u8) -> KssName {
    if destination.length < 64 {
        destination.bytes[destination.length] = byte
        destination.length = destination.length + 1
    }
    return destination
}

// Skip whitespace and // plus /* */ comments, keeping provenance current.

KssSkipSpace :: (c: KssCursor) -> KssCursor {
    while !KssAtEnd(c) {
        byte: u8 = c.source[c.pos]
        if KssIsSpace(byte) {
            c = KssAdvance(c, 1)
            continue
        }
        if byte == 47 && KssPeek(c, 1) == 47 {
            while !KssAtEnd(c) && c.source[c.pos] != 10 {
                c = KssAdvance(c, 1)
            }
            continue
        }
        if byte == 47 && KssPeek(c, 1) == 42 {
            c = KssAdvance(c, 2)
            while !KssAtEnd(c) {
                if c.source[c.pos] == 42 && KssPeek(c, 1) == 47 {
                    c = KssAdvance(c, 2)
                    break
                }
                c = KssAdvance(c, 1)
            }
            continue
        }
        break
    }
    return c
}

KssNameResult :: struct {
    parser: KssCursor
    name: KssName
    ok: bool
}

KssExpectResult :: struct {
    parser: KssCursor
    ok: bool
}

KssNumberResult :: struct {
    parser: KssCursor
    value: float32
    ok: bool
}

KssScalarResult :: struct {
    parser: KssCursor
    value: float64
    ok: bool
}

KssColorResult :: struct {
    parser: KssCursor
    value: u32
    ok: bool
}

KssReadName :: (c: KssCursor) -> KssNameResult {
    result: KssNameResult
    c = KssSkipSpace(c)
    if KssAtEnd(c) || !KssIdentStart(c.source[c.pos]) {
        result.parser = c
        result.ok = false
        return result
    }
    while !KssAtEnd(c) && KssIdentChar(c.source[c.pos]) {
        result.name = KssNameAppend(result.name, c.source[c.pos])
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = result.name.length > 0
    return result
}

KssReadSelectorName :: (c: KssCursor) -> KssNameResult {
    result: KssNameResult
    c = KssSkipSpace(c)
    if !KssAtEnd(c) && c.source[c.pos] == 42 {
        result.name = KssNameAppend(result.name, 42)
        c = KssAdvance(c, 1)
        result.parser = c
        result.ok = true
        return result
    }
    if KssAtEnd(c) || !KssIdentStart(c.source[c.pos]) {
        result.parser = c
        result.ok = false
        return result
    }
    while !KssAtEnd(c) && KssSelectorIdentChar(c.source[c.pos]) {
        result.name = KssNameAppend(result.name, c.source[c.pos])
        c = KssAdvance(c, 1)
    }
    result.parser = c
    result.ok = result.name.length > 0
    return result
}

KssExpect :: (c: KssCursor, byte: u8) -> KssExpectResult {
    result: KssExpectResult
    c = KssSkipSpace(c)
    if KssAtEnd(c) || c.source[c.pos] != byte {
        result.parser = c
        result.ok = false
        return result
    }
    c = KssAdvance(c, 1)
    result.parser = c
    result.ok = true
    return result
}

// Diagnostics carry the message plus the exact file, line, and column.

KssDiagnosticAppend :: (p: KssParser, text: string) -> KssParser {
    index: s32 = 0
    while index < (cast(s32)text.count) && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = text[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendName :: (p: KssParser, name: KssName) -> KssParser {
    index: s32 = 0
    while index < name.length && p.diagnostic_length < 255 {
        p.diagnostic[p.diagnostic_length] = name.bytes[index]
        p.diagnostic_length = p.diagnostic_length + 1
        index = index + 1
    }
    return p
}

KssDiagnosticAppendInt :: (p: KssParser, value: s32) -> KssParser {
    remaining: s32 = value
    digits: s32 = 1
    if remaining < 0 {
        p = KssDiagnosticAppend(p, "-")
        remaining = -remaining
    }
    probe: s32 = 10
    while probe <= remaining && digits < 10 {
        probe = probe * 10
        digits = digits + 1
    }
    while digits > 0 {
        power: s32 = 1
        step: s32 = 1
        while step < digits {
            power = power * 10
            step = step + 1
        }
        digit: s32 = 0
        while remaining >= power {
            remaining = remaining - power
            digit = digit + 1
        }
        if p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = cast(u8)(48 + digit)
            p.diagnostic_length = p.diagnostic_length + 1
        }
        digits = digits - 1
    }
    return p
}

KssDiagnosticAt :: (p: KssParser) -> KssParser {
    p = KssDiagnosticAppend(p, " at ")
    if p.cursor.file >= 0 && p.cursor.file < p.file_count && p.files[p.cursor.file].length > 0 {
        index: s32 = 0
        while index < p.files[p.cursor.file].length && p.diagnostic_length < 255 {
            p.diagnostic[p.diagnostic_length] = p.files[p.cursor.file].name[index]
            p.diagnostic_length = p.diagnostic_length + 1
            index = index + 1
        }
        p = KssDiagnosticAppend(p, ":")
    }
    p = KssDiagnosticAppendInt(p, p.cursor.line)
    p = KssDiagnosticAppend(p, ":")
    p = KssDiagnosticAppendInt(p, p.cursor.column)
    return p
}

KssFail :: (p: KssParser, message: string) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAt(p)
    p.status = cast(s32)KssStatusError
    return p
}

KssFailName :: (p: KssParser, message: string, name: KssName) -> KssParser {
    p.diagnostic_length = 0
    p = KssDiagnosticAppend(p, message)
    p = KssDiagnosticAppendName(p, name)
    p = KssDiagnosticAt(p)
    p.status = cast(s32)KssStatusError
    return p
}

KssReadHexColor :: (c: KssCursor) -> KssColorResult {
    result: KssColorResult
    value: u32 = 0
    digits: s32 = 0
    c = KssSkipSpace(c)
    if KssAtEnd(c) || c.source[c.pos] != 35 {
        result.parser = c
        return result
    }
    c = KssAdvance(c, 1)
    while !KssAtEnd(c) && KssIsHexDigit(c.source[c.pos]) {
        byte: u8 = c.source[c.pos]
        digit: u32 = 0
        if byte >= 48 && byte <= 57 {
            digit = cast(u32)(byte - 48)
        } else if byte >= 97 && byte <= 102 {
            digit = cast(u32)(byte - 87)
        } else {
            digit = cast(u32)(byte - 55)
        }
        value = (value << cast(u32)4) | digit
        digits = digits + 1
        c = KssAdvance(c, 1)
    }
    if digits == 6 {
        value = (value << cast(u32)8) | cast(u32)255
    } else if digits != 8 {
        result.parser = c
        return result
    }
    result.parser = c
    result.value = value
    result.ok = true
    return result
}

KssReadNumber :: (c: KssCursor) -> KssNumberResult {
    scalar: KssScalarResult = KssReadScalar(c)
    result: KssNumberResult
    result.parser = scalar.parser
    result.value = cast(float32)scalar.value
    result.ok = scalar.ok
    return result
}

KssReadScalar :: (c: KssCursor) -> KssScalarResult {
    result: KssScalarResult
    negative: bool = false
    whole: float64 = 0.0
    fraction: float64 = 0.0
    fraction_digits: s32 = 0
    exponent: s32 = 0
    exponent_negative: bool = false
    seen_digits: bool = false
    power: float64 = 1.0
    value64: float64 = 0.0
    c = KssSkipSpace(c)
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    if c.source[c.pos] == 45 {
        negative = true
        c = KssAdvance(c, 1)
    } else if c.source[c.pos] == 43 {
        c = KssAdvance(c, 1)
    }
    while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
        whole = whole * 10.0 + cast(float64)(c.source[c.pos] - 48)
        seen_digits = true
        c = KssAdvance(c, 1)
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 && !seen_digits {
        result.parser = c
        return result
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            if fraction_digits < 17 {
                fraction = fraction * 10.0 + cast(float64)(c.source[c.pos] - 48)
                fraction_digits = fraction_digits + 1
            }
            seen_digits = true
            c = KssAdvance(c, 1)
        }
    }
    if !seen_digits {
        result.parser = c
        return result
    }
    if !KssAtEnd(c) && (c.source[c.pos] == 101 || c.source[c.pos] == 69) {
        c = KssAdvance(c, 1)
        if !KssAtEnd(c) && c.source[c.pos] == 45 {
            exponent_negative = true
            c = KssAdvance(c, 1)
        } else if !KssAtEnd(c) && c.source[c.pos] == 43 {
            c = KssAdvance(c, 1)
        }
        exponent_start: s32 = c.pos
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            if exponent <= 400 {
                exponent = exponent * 10 + cast(s32)(c.source[c.pos] - 48)
            }
            c = KssAdvance(c, 1)
        }
        if c.pos == exponent_start || exponent > 400 {
            result.parser = c
            return result
        }
    }
    step: s32 = 0
    while step < fraction_digits {
        power = power * 10.0
        step = step + 1
    }
    value64 = cast(float64)whole + cast(float64)fraction / power
    step = 0
    while step < exponent {
        if exponent_negative {
            value64 = value64 / 10.0
        } else {
            value64 = value64 * 10.0
        }
        step = step + 1
    }
    if negative {
        value64 = -value64
    }
    result.parser = c
    if value64 > 1.7976931348623157e308 || value64 < -1.7976931348623157e308 {
        result.ok = false
        return result
    }
    result.value = value64
    result.ok = true
    return result
}

// Durations convert to milliseconds with exact decimal shifting so '0.14s'
// yields exactly 140 instead of a float rounding artifact.

KssReadDuration :: (c: KssCursor) -> KssNumberResult {
    result: KssNumberResult
    negative: bool = false
    whole: u32 = 0
    fraction: u32 = 0
    fraction_digits: s32 = 0
    seen_digits: bool = false
    seconds: bool = false
    c = KssSkipSpace(c)
    if KssAtEnd(c) {
        result.parser = c
        return result
    }
    if c.source[c.pos] == 45 {
        negative = true
        c = KssAdvance(c, 1)
    } else if c.source[c.pos] == 43 {
        c = KssAdvance(c, 1)
    }
    while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
        whole = whole * 10 + cast(u32)(c.source[c.pos] - 48)
        seen_digits = true
        c = KssAdvance(c, 1)
    }
    if !KssAtEnd(c) && c.source[c.pos] == 46 {
        c = KssAdvance(c, 1)
        while !KssAtEnd(c) && KssIsDigit(c.source[c.pos]) {
            if fraction_digits < 9 {
                fraction = fraction * 10 + cast(u32)(c.source[c.pos] - 48)
                fraction_digits = fraction_digits + 1
            }
            seen_digits = true
            c = KssAdvance(c, 1)
        }
    }
    if !seen_digits {
        result.parser = c
        return result
    }
    unit: KssNameResult = KssReadName(c)
    if unit.ok && KssNameEquals(unit.name, "ms") {
        seconds = false
    } else if unit.ok && KssNameEquals(unit.name, "s") {
        seconds = true
    } else if unit.ok {
        result.parser = unit.parser
        return result
    } else {
        result.parser = c
        return result
    }

    value: float64 = 0.0
    scaled: u32 = whole
    shift: s32 = fraction_digits
    while shift > 0 {
        scaled = scaled * 10
        shift = shift - 1
    }
    scaled = scaled + fraction
    if seconds {
        value = cast(float64)scaled
        step: s32 = 0
        while step < 3 - fraction_digits {
            value = value * 10.0
            step = step + 1
        }
        step = 0
        while step < fraction_digits - 3 {
            value = value / 10.0
            step = step + 1
        }
    } else {
        value = cast(float64)scaled
        step: s32 = 0
        while step < fraction_digits {
            value = value / 10.0
            step = step + 1
        }
    }
    if negative {
        value = -value
    }
    result.parser = unit.parser
    result.value = cast(float32)value
    result.ok = true
    return result
}
