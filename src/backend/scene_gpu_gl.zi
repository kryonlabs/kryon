// System EGL/GLES bindings. No window creation or host renderer state.
#import "std/vec"
egl :: #system_library "EGL";
gl :: #system_library "GLESv2";
glx :: #system_library "GLX";
c :: #system_library "c";
#scope_export
RawEGetPlatformDisplay :: (platform: u32, native: *void, attributes: *s64)->*void #foreign egl "eglGetPlatformDisplay";
RawEInitialize :: (display: *void, major: *s32, minor: *s32)->u32 #foreign egl "eglInitialize";
RawEBindAPI :: (api: u32)->u32 #foreign egl "eglBindAPI";
RawEChooseConfig :: (display: *void, attrs: *s32, configs: **void, count: s32, found: *s32)->u32 #foreign egl "eglChooseConfig";
RawECreateContext :: (display: *void, config: *void, share: *void, attrs: *s32)->*void #foreign egl "eglCreateContext";
RawEDestroyContext :: (display: *void, context: *void)->u32 #foreign egl "eglDestroyContext";
RawETerminate :: (display: *void)->u32 #foreign egl "eglTerminate";
RawEMakeCurrent :: (display: *void, draw: *void, read: *void, context: *void)->u32 #foreign egl "eglMakeCurrent";
RawEGetCurrentDisplay :: ()->*void #foreign egl "eglGetCurrentDisplay";
RawEGetCurrentContext :: ()->*void #foreign egl "eglGetCurrentContext";
RawEGetCurrentSurface :: (which: s32)->*void #foreign egl "eglGetCurrentSurface";
RawEQueryAPI :: ()->u32 #foreign egl "eglQueryAPI";
RawGLXCurrentDisplay :: ()->*void #foreign glx "glXGetCurrentDisplay";
RawGLXCurrentContext :: ()->*void #foreign glx "glXGetCurrentContext";
RawGLXCurrentDrawable :: ()->u64 #foreign glx "glXGetCurrentDrawable";
RawGLXCurrentReadDrawable :: ()->u64 #foreign glx "glXGetCurrentReadDrawable";
RawGLXMakeCurrent :: (display: *void,draw: u64,read: u64,context: *void)->s32 #foreign glx "glXMakeContextCurrent";
RawGetString :: (name: u32)->*u8 #foreign gl "glGetString";
RawGetInteger :: (name: u32, value: *s32) #foreign gl "glGetIntegerv";
RawGetError :: ()->u32 #foreign gl "glGetError";
RawGetPrecision :: (stage: u32, kind: u32, range: *s32, precision: *s32) #foreign gl "glGetShaderPrecisionFormat";
RawGenFramebuffers :: (count: s32, ids: *u32) #foreign gl "glGenFramebuffers";
RawDeleteFramebuffers :: (count: s32, ids: *u32) #foreign gl "glDeleteFramebuffers";
RawBindFramebuffer :: (target: u32, id: u32) #foreign gl "glBindFramebuffer";
RawCheckFramebuffer :: (target: u32)->u32 #foreign gl "glCheckFramebufferStatus";
RawFramebufferTexture :: (target: u32, attachment: u32, texture_target: u32, id: u32, level: s32) #foreign gl "glFramebufferTexture2D";
RawFramebufferRenderbuffer :: (target: u32, attachment: u32, renderbuffer_target: u32, id: u32) #foreign gl "glFramebufferRenderbuffer";
RawGenRenderbuffers :: (count: s32, ids: *u32) #foreign gl "glGenRenderbuffers";
RawDeleteRenderbuffers :: (count: s32, ids: *u32) #foreign gl "glDeleteRenderbuffers";
RawBindRenderbuffer :: (target: u32, id: u32) #foreign gl "glBindRenderbuffer";
RawRenderbufferStorage :: (target: u32, format: u32, width: s32, height: s32) #foreign gl "glRenderbufferStorage";
RawRenderbufferMS :: (target: u32, samples: s32, format: u32, width: s32, height: s32) #foreign gl "glRenderbufferStorageMultisample";
RawGetRenderbuffer :: (target: u32, name: u32, value: *s32) #foreign gl "glGetRenderbufferParameteriv";
RawBlitFramebuffer :: (sx: s32, sy: s32, ex: s32, ey: s32, dx: s32, dy: s32, fx: s32, fy: s32, mask: u32, filter: u32) #foreign gl "glBlitFramebuffer";
RawGenTextures :: (count: s32, ids: *u32) #foreign gl "glGenTextures";
RawDeleteTextures :: (count: s32, ids: *u32) #foreign gl "glDeleteTextures";
RawBindTexture :: (target: u32, id: u32) #foreign gl "glBindTexture";
RawActiveTexture :: (unit: u32) #foreign gl "glActiveTexture";
