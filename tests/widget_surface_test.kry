#import "kryon.h"
#import "theme.h"
#import "theme_meta.h"
#import "runtime/button.h"
#import "runtime/color_picker.h"
#import "ui/text.h"
#import "ui/selectable_text.h"
#import "ui_text_props.generated.h"
#import "ui_internal.h"
#import "stdio.h"
#import "stdlib.h"
#import "string.h"

app "Kryon Widget Surface Test" {
    size 320 180
    fps 0
    before_window SurfaceBeforeWindow
    init SurfaceChecks
    should_continue SurfaceContinue
}

state {
    surface_done: bool = false
}

SurfaceBeforeWindow :: () -> bool {
    private_display: const char* = getenv("KRYON_PRIVATE_DISPLAY")
    display: const char* = getenv("DISPLAY")
    if private_display == nil || display == nil ||
    strcmp(private_display, "1") != 0 ||
    strncmp(display, ":0", 2) == 0 {
        puts("Widget surface test requires a private X display")
        return false
    }
    SetConfigFlags(FLAG_WINDOW_HIDDEN)
    return true
}

SurfaceContinue :: () -> bool {
    return !surface_done
}

SurfaceRequire :: (condition: bool, message: const char*) {
    if !condition {
        fprintf(stderr, "Widget surface failed: %s\n", message)
        exit(1)
    }
}

SurfaceNear :: (actual: float, expected: float) -> bool {
    difference: float = actual - expected
    if difference < 0.0 { difference = -difference }
    return difference <= 0.001
}

SurfaceSameColor :: (actual: Color, expected: Color) -> bool {
    return actual.r == expected.r && actual.g == expected.g &&
    actual.b == expected.b && actual.a == expected.a
}

SurfaceStyleFrame :: (background: u32, foreground: u32,
border: u32) -> StyleFrame {
    frame: StyleFrame = {0}
    frame.value.fields = StyleBackground | StyleForeground | StyleBorder
    frame.value.background = background
    frame.value.foreground = foreground
    frame.value.border = border
    frame.value.focus = border
    frame.value.border_width = 1.0
    frame.value.opacity = 1.0
    return frame
}

SurfaceThemeChecks :: () {
    mixed: Color = MixThemeColor((Color){0, 0, 0, 255},
    (Color){100, 50, 200, 127}, 0.5)
    SurfaceRequire(SurfaceSameColor(mixed, (Color){50, 25, 100, 191}),
    "theme mix")
    SurfaceRequire(SurfaceSameColor(MixThemeColor(BLACK, WHITE, -1.0),
    BLACK), "theme mix low clamp")
    SurfaceRequire(SurfaceSameColor(MixThemeColor(BLACK, WHITE, 2.0),
    WHITE), "theme mix high clamp")
    SurfaceRequire(GetThemeColorLuminance(BLACK) == 0,
    "black luminance")
    SurfaceRequire(GetThemeColorLuminance(WHITE) == 255,
    "white luminance")
    SurfaceRequire(IsThemeColorDark((Color){12, 12, 12, 255}),
    "dark color")
    SurfaceRequire(!IsThemeColorDark((Color){240, 240, 240, 255}),
    "light color")
    SurfaceRequire(SurfaceSameColor(GetThemeReadableText(
    (Color){20, 20, 20, 255}), RAYWHITE), "readable dark text")
    SurfaceRequire(SurfaceSameColor(GetThemeReadableText(
    (Color){240, 240, 240, 255}), BLACK), "readable light text")

    SetThemeSource(THEME_SOURCE_APP)
    SetCurrentTheme(THEME_MONO, 0)
    SurfaceRequire(GetThemeSurfaceAlt().a == 255, "surface alpha")
    SurfaceRequire(GetThemeBorder().a == 255, "border alpha")
    SurfaceRequire(GetThemeMutedText().a == 255, "muted text alpha")
    SurfaceRequire(GetThemeSelection().a == 255, "selection alpha")
    SurfaceRequire(SurfaceSameColor(GetThemeButtonText(),
    GetThemeReadableText(GetThemeButton())), "button text contrast")
}

SurfaceSwatchChecks :: () {
    face: StyleFrame = SurfaceStyleFrame(0x00000000, 0x111111FF,
    0x222222FF)
    face.value.focus = 0x333333FF
    face.value.radius = 6.0
    swatch: SwatchSpec = {0}
    swatch.bounds = (Rectangle){10, 20, 80, 30}
    swatch.color = (Color){20, 40, 60, 128}
    swatch.hovered = true
    swatch.focused = true
    swatch.scale = 1.0
    swatch.face = face
    paint: SwatchPaint = SwatchPaintFor(swatch)

    swatch.color.a = 255
    swatch.disabled = true
    disabled: SwatchPaint = SwatchPaintFor(swatch)
    SurfaceRequire(paint.checker_a.width == 35, "swatch checker width")
    SurfaceRequire(paint.checker_b.x == 50, "swatch checker position")
    SurfaceRequire(paint.label_x == 16, "swatch label position")
    SurfaceRequire(paint.swatch_color.a == 128, "swatch alpha")
    SurfaceRequire(paint.show_focus == 1, "swatch focus")
    SurfaceRequire(disabled.swatch_color.a == 128, "disabled swatch alpha")
    SurfaceRequire(disabled.show_focus == 0, "disabled swatch focus")

    face.value.border_width = 0.0
    swatch.color.a = 128
    swatch.disabled = false
    swatch.hovered = false
    swatch.face = face
    paint = SwatchPaintFor(swatch)
    SurfaceRequire(SurfaceNear(paint.border_width, 0.0),
    "swatch zero border")
    SurfaceRequire(SurfaceNear(paint.focus_width, 0.0),
    "swatch zero focus border")

    face.value.fields |= StylePaddingX
    face.value.padding_x = 10.0
    swatch.focused = false
    swatch.face = face
    paint = SwatchPaintFor(swatch)
    SurfaceRequire(paint.label_x == 20, "swatch styled label inset")
    face.value.padding_x = 0.0
    swatch.face = face
    paint = SwatchPaintFor(swatch)
    SurfaceRequire(paint.label_x == 10, "swatch explicit zero inset")
}

SurfaceColorPickerChecks :: () {
    bounds: Rectangle = {10, 20, 120, 160}
    metrics: StyleFrame = {0}
    metrics.value.gap = 4.0
    metrics.value.icon_size = 36.0
    metrics.value.padding_y = 2.0
    metrics.value.offset_x = 20.0
    metrics.value.offset_y = 28.0
    layout: ColorPickerLayout = ColorPickerLayoutFor(bounds, 4, 1.0, metrics)
    row: Rectangle = ColorPickerChannelBounds(bounds, 2, 4, 1.0, metrics)
    swatch: ColorPickerSwatchPaint = ColorPickerSwatchPaintFor(
    layout.swatch_bounds, 8.0, 14.0)
    rgba: Color = ColorPickerColorFor(-0.5, 0.5, 2.0, 0.25, 4)
    rgb: Color = ColorPickerColorFor(1.0, 0.0, 0.5, 0.0, 3)

    SurfaceRequire(SurfaceNear(layout.row_height, 30.0), "picker row height")
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.y, 144.0),
    "picker swatch position")
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.height, 36.0),
    "picker swatch height")
    SurfaceRequire(SurfaceNear(row.y, 80.0), "picker channel position")
    SurfaceRequire(SurfaceNear(row.height, 28.0), "picker channel height")
    SurfaceRequire(SurfaceNear(swatch.label_x, 18.0), "picker label x")
    SurfaceRequire(SurfaceNear(swatch.label_y, 155.0), "picker label y")
    SurfaceRequire(SurfaceNear(ColorPickerSwatchLabelInset(
    1.0, (StyleFrame){0}), 6.0), "picker default label inset")
    SurfaceRequire(ColorPickerChannelByte(-1.0) == 0, "picker clamp low")
    SurfaceRequire(ColorPickerChannelByte(2.0) == 255, "picker clamp high")
    SurfaceRequire(ColorPickerChannelIdFor(0, 1) == 0, "picker disabled id")
    SurfaceRequire(ColorPickerChannelIdFor(7, -1) == 0,
    "picker negative index")
    SurfaceRequire(ColorPickerChannelIdFor(7, 2) == 59, "picker channel id")
    SurfaceRequire(SurfaceSameColor(rgba, (Color){0, 128, 255, 64}),
    "picker rgba")
    SurfaceRequire(SurfaceSameColor(rgb, (Color){255, 0, 128, 255}),
    "picker rgb")

    metrics.value.gap = 6.0
    metrics.value.icon_size = 40.0
    metrics.value.padding_y = 5.0
    metrics.value.offset_x = 18.0
    metrics.value.offset_y = 24.0
    metrics.value.fields = StyleGap | StyleIconSize | StylePaddingY |
    StyleContentOffset
    layout = ColorPickerLayoutFor(bounds, 4, 1.0, metrics)
    row = ColorPickerChannelBounds(bounds, 1, 4, 1.0, metrics)
    SurfaceRequire(SurfaceNear(layout.row_height, 28.5),
    "picker styled row height")
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.y, 140.0),
    "picker styled swatch position")
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.height, 40.0),
    "picker styled swatch height")
    SurfaceRequire(SurfaceNear(row.height, 23.5),
    "picker styled channel height")

    metrics.value.gap = 0.0
    metrics.value.icon_size = 0.0
    metrics.value.padding_y = 0.0
    metrics.value.fields |= StylePaddingX
    metrics.value.padding_x = 0.0
    layout = ColorPickerLayoutFor(bounds, 4, 1.0, metrics)
    row = ColorPickerChannelBounds(bounds, 1, 4, 1.0, metrics)
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.y, 180.0),
    "picker zero gap")
    SurfaceRequire(SurfaceNear(layout.swatch_bounds.height, 0.0),
    "picker zero swatch height")
    SurfaceRequire(SurfaceNear(row.height, 40.0),
    "picker zero row inset")
    SurfaceRequire(SurfaceNear(ColorPickerSwatchLabelInset(1.0, metrics), 0.0),
    "picker zero label inset")
}

SurfaceTextClipChecks :: () {
    saved_camera: Camera2D = g_ui_camera
    glyph: GlyphInfo = {0}
    glyph.value = 'a'
    glyph.offsetX = -2
    glyph.offsetY = 3
    glyph.advanceX = 10
    glyph_rec: Rectangle = (Rectangle){0, 0, 12, 12}
    font: Font = {0}
    font.baseSize = 16
    font.glyphCount = 1
    font.texture.id = 1
    font.recs = &glyph_rec
    font.glyphs = &glyph

    fallback_glyph: GlyphInfo = {0}
    fallback_glyph.value = 0x4e2d
    fallback_glyph.advanceX = 24
    fallback_rec: Rectangle = (Rectangle){0, 0, 24, 18}
    fallback: Font = {0}
    fallback.baseSize = 16
    fallback.glyphCount = 1
    fallback.texture.id = 2
    fallback.recs = &fallback_rec
    fallback.glyphs = &fallback_glyph

    selection: i32 = PushTextSelectable(0)
    ClearTextFonts()
    RegisterTextFont("clip-latin", font)
    RegisterTextFont("clip-fallback", fallback)
    g_ui_camera = (Camera2D){0}
    g_ui_camera.zoom = 1.0
    SurfaceRequire(ui_text_fits_bounds("a", 10, 10, 16,
    (Rectangle){0, 0, 40, 40}) == 1, "fitting glyph")
    SurfaceRequire(ui_text_fits_bounds("a", 10, 10, 16,
    (Rectangle){10, 0, 40, 40}) == 0, "glyph left overhang")
    SurfaceRequire(ui_text_fits_bounds("a", 10, 10, 16,
    (Rectangle){0, 0, 40, 20}) == 0, "glyph descender")
    SurfaceRequire(ui_text_fits_bounds("a中", 10, 10, 16,
    (Rectangle){0, 0, 60, 40}) == 1, "fallback fits")
    SurfaceRequire(ui_text_fits_bounds("a中", 10, 10, 16,
    (Rectangle){0, 0, 35, 40}) == 0, "fallback overhang")
    g_ui_camera.offset = (Vector2){9, 31}
    g_ui_camera.zoom = 1.75
    SurfaceRequire(ui_text_fits_bounds("aa", 10, 10, 16,
    (Rectangle){0, 0, 40, 40}) == 1, "scaled viewport")
    SurfaceRequire(ui_text_fits_bounds("aa", 10, 10, 16,
    (Rectangle){0.4, 0, 30, 40}) == 0, "fractional pixel clip")
    ClearTextFonts()
    PopTextSelectable(selection)
    g_ui_camera = saved_camera
}

SurfaceChecks :: () {
    SurfaceThemeChecks()
    SurfaceSwatchChecks()
    SurfaceColorPickerChecks()
    SurfaceTextClipChecks()
    puts("Widget surface Kry checks passed: theme, swatch, color picker, text clip")
    surface_done = true
}

WidgetSurfaceScreen :: (viewport: Rectangle) #ui {
    Screen root: {
        bounds = viewport
        Background(GetThemeBackground())
    }
}
