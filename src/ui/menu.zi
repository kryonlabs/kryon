#import "drawing_props"
#import "geometry"
#import "style"
#import "control_props"

MenuMetrics :: struct {
    row_height: s32
    panel_min_width: s32
    panel_padding: s32
    panel_margin: s32
    accelerator_gap: s32
    separator_inset: s32
    checked_mark_inset: s32
    label_inset: s32
    submenu_indicator_inset: s32
    bar_item_min_width: s32
    bar_item_padding: s32
    bar_item_gap: s32
    bar_item_y_padding: s32
    bar_label_inset: s32
}

MenuLine :: struct {
    x1: s32
    y1: s32
    x2: s32
    y2: s32
}

MenuGroupPointerDecision :: struct {
    changed_open: bool
    next_open_id: s32
    clear_submenu: bool
    consume_release: bool
    set_focus: bool
    reset_navigation: bool
    navigation_top: s32
}

MenuItemPointerDecision :: struct {
    consume_release: bool
    set_focus: bool
    reset_navigation: bool
    set_navigation_path: bool
    navigation_depth: s32
    navigation_index: s32
    clear_child_navigation: bool
    set_submenu: bool
    submenu_id: s32
    activate: bool
    activated_id: s32
    close_open: bool
}

MenuKeyboardInput :: struct {
    up: bool
    down: bool
    home: bool
    end: bool
    left: bool
    right: bool
    enter: bool
    space: bool
    escape: bool
}

MenuKeyboardDecision :: struct {
    key_handled: bool
    move_delta: s32
    first: bool
    last: bool
    close_parent: bool
    open_or_activate: bool
}

MenuBarKeyboardDecision :: struct {
    move_top_delta: s32
    first_top: bool
    last_top: bool
    open_top: bool
    close_open: bool
    move_open_delta: s32
    move_open_if_no_submenu_delta: s32
}

MenuOutsideCloseDecision :: struct {
    close_open: bool
    clear_submenu: bool
    consume_release: bool
    open_index: s32
}

MenuContextOutsideCloseDecision :: struct {
    close_open: bool
    consume_release: bool
}

MenuContextOpenResult :: struct {
    open: bool
    changed: bool
}

#program_export
MenuBarRole :: () -> s32 {
    return 1
}

#program_export
MenuPopupRole :: () -> s32 {
    return 2
}

#program_export
MenuContextRole :: () -> s32 {
    return 3
}

MenuHas :: (fields: u32, field: u32) -> bool {
    return (fields & field) != cast(u32)0
}

MenuKindSeparator :: () -> s32 {
    return 3
}

MenuKindSubmenu :: () -> s32 {
    return 4
}

MenuMetric :: (fields: u32, field: u32, value: float32,
    fallback: float32, scale: float32, allow_zero: bool) -> s32 {
    if !MenuHas(fields, field) || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return cast(s32)(value * scale)
}

#program_export
MenuWrappedItemIndex :: (start: s32, direction: s32, item_count: s32) -> s32 {
    if item_count <= 0 { return -1 }
    if direction == 0 { direction = 1 }
    return (start + direction + item_count) % item_count
}

#program_export
MenuItemSelectable :: (kind: s32, disabled: bool) -> bool {
    return kind != MenuKindSeparator() && !disabled
}

#program_export
MenuItemIsSeparator :: (kind: s32) -> bool {
    return kind == MenuKindSeparator()
}

#program_export
MenuItemShowsSubmenu :: (kind: s32) -> bool {
    return kind == MenuKindSubmenu()
}

#program_export
MenuItemCanOpenSubmenu :: (kind: s32, disabled: bool, has_submenu: bool,
    submenu_count: s32, depth: s32, max_depth: s32) -> bool {
    if kind != MenuKindSubmenu() || disabled { return false }
    if !has_submenu || submenu_count <= 0 { return false }
    return depth + 1 < max_depth
}

#program_export
MenuItemKeyboardActivates :: (kind: s32, disabled: bool,
    opens_submenu: bool) -> bool {
    return kind != MenuKindSeparator() && !disabled && !opens_submenu
}

#program_export
MenuKeyboardInputFor :: (up: bool, down: bool, home: bool, end: bool,
    left: bool, right: bool, enter: bool, space: bool,
    escape: bool) -> MenuKeyboardInput {
    input: MenuKeyboardInput
    input.up = up
    input.down = down
    input.home = home
    input.end = end
    input.left = left
    input.right = right
    input.enter = enter
    input.space = space
    input.escape = escape
    return input
}

#program_export
MenuKeyboardDecisionFor :: (input: MenuKeyboardInput, depth: s32,
    selected: s32) -> MenuKeyboardDecision {
    decision: MenuKeyboardDecision
    if selected < 0 { return decision }
    if input.up {
        decision.key_handled = true
        decision.move_delta = -1
        return decision
    }
    if input.down {
        decision.key_handled = true
        decision.move_delta = 1
        return decision
    }
    if input.home {
        decision.key_handled = true
        decision.first = true
        return decision
    }
    if input.end {
        decision.key_handled = true
        decision.last = true
        return decision
    }
    if input.left && depth > 0 {
        decision.key_handled = true
        decision.close_parent = true
        return decision
    }
    if input.right || input.enter || input.space {
        decision.key_handled = true
        decision.open_or_activate = true
    }
    return decision
}

#program_export
MenuBarKeyboardDecisionFor :: (input: MenuKeyboardInput, open: bool,
    depth: s32) -> MenuBarKeyboardDecision {
    decision: MenuBarKeyboardDecision
    if !open {
        if input.left {
            decision.move_top_delta = -1
            return decision
        }
        if input.right {
            decision.move_top_delta = 1
            return decision
        }
        if input.home {
            decision.first_top = true
            return decision
        }
        if input.end {
            decision.last_top = true
            return decision
        }
        if input.enter || input.space || input.down {
            decision.open_top = true
        }
        return decision
    }
    if input.escape {
        decision.close_open = true
        return decision
    }
    if depth == 0 && input.left {
        decision.move_open_delta = -1
        return decision
    }
    if depth == 0 && input.right {
        decision.move_open_if_no_submenu_delta = 1
    }
    return decision
}

#program_export
MenuItemPointerActivates :: (kind: s32, disabled: bool) -> bool {
    return kind != MenuKindSeparator() && kind != MenuKindSubmenu() &&
        !disabled
}

#program_export
MenuBarCountFor :: (count: s32, limit: s32) -> s32 {
    if count < 0 { return 0 }
    if limit >= 0 && count > limit { return limit }
    return count
}

#program_export
MenuBarOpenIndexFor :: (bar_id: s32, open_id: s32, menu_count: s32) -> s32 {
    if bar_id <= 0 || menu_count <= 0 { return -1 }
    index: s32 = open_id - bar_id - 1
    if index < 0 || index >= menu_count { return -1 }
    return index
}

#program_export
MenuBarOpenIdFor :: (bar_id: s32, index: s32, menu_count: s32) -> s32 {
    if bar_id <= 0 || index < 0 || index >= menu_count { return 0 }
    return bar_id + 1 + index
}

#program_export
MenuBarTopIndexFor :: (top: s32, menu_count: s32) -> s32 {
    if menu_count <= 0 { return -1 }
    if top < 0 || top >= menu_count { return 0 }
    return top
}

#program_export
MenuBarMoveTopIndex :: (top: s32, menu_count: s32,
    direction: s32) -> s32 {
    if menu_count <= 0 { return -1 }
    top = MenuBarTopIndexFor(top, menu_count)
    if direction == 0 { return top }
    return (top + direction + menu_count) % menu_count
}

#program_export
MenuGroupPointerDecisionFor :: (menu_id: s32, index: s32,
    open_id: s32, hot: bool, mouse_released: bool) -> MenuGroupPointerDecision {
    decision: MenuGroupPointerDecision
    decision.next_open_id = open_id
    decision.navigation_top = index
    open: bool = open_id == menu_id
    if hot && mouse_released {
        decision.consume_release = true
        decision.set_focus = true
        decision.changed_open = true
        if open {
            decision.next_open_id = 0
            decision.clear_submenu = true
        } else {
            decision.next_open_id = menu_id
            decision.reset_navigation = true
        }
        return decision
    }
    if hot && open_id != 0 && !open {
        decision.changed_open = true
        decision.next_open_id = menu_id
        decision.clear_submenu = true
    }
    return decision
}

#program_export
MenuItemPointerDecisionFor :: (hot: bool, mouse_released: bool,
    same_focus: bool, kind: s32, disabled: bool, item_id: s32,
    index: s32, depth: s32, max_depth: s32) -> MenuItemPointerDecision {
    decision: MenuItemPointerDecision
    decision.navigation_depth = depth
    decision.navigation_index = index
    if !hot || !mouse_released {
        return decision
    }
    decision.consume_release = true
    decision.set_focus = true
    decision.reset_navigation = !same_focus
    if depth < max_depth {
        decision.set_navigation_path = true
        decision.clear_child_navigation = true
    }
    if MenuItemShowsSubmenu(kind) {
        decision.set_submenu = true
        decision.submenu_id = item_id
    } else if MenuItemPointerActivates(kind, disabled) {
        decision.activate = true
        decision.activated_id = item_id
        decision.close_open = true
    }
    return decision
}

#program_export
MenuOutsideCloseDecisionFor :: (open_id: s32, mouse_released: bool,
    contains_bar: bool, panel_valid: bool,
    contains_panel: bool) -> MenuOutsideCloseDecision {
    decision: MenuOutsideCloseDecision
    decision.open_index = -1
    if open_id != 0 && mouse_released && !contains_bar &&
       (!panel_valid || !contains_panel) {
        decision.close_open = true
        decision.clear_submenu = true
        decision.consume_release = true
    }
    return decision
}

#program_export
MenuContextOutsideCloseDecisionFor :: (open_id: s32, menu_id: s32,
    suppress_close: bool, mouse_released: bool, panel_valid: bool,
    contains_panel: bool) -> MenuContextOutsideCloseDecision {
    decision: MenuContextOutsideCloseDecision
    if open_id == menu_id && !suppress_close && mouse_released &&
       (!panel_valid || !contains_panel) {
        decision.close_open = true
        decision.consume_release = true
    }
    return decision
}

#program_export
MenuContextOpenFor :: (open: bool, open_requested: bool,
    close_requested: bool, has_open: bool) -> MenuContextOpenResult {
    result: MenuContextOpenResult
    result.open = open
    if !has_open {
        return result
    }
    if open_requested {
        result.open = true
    }
    if close_requested {
        result.open = false
    }
    result.changed = result.open != open
    return result
}

#program_export
MenuEscapeShouldClose :: (focused: bool, focus_captured: bool,
    escape_pressed: bool) -> bool {
    return focused && !focus_captured && escape_pressed
}

#program_export
MenuContextShouldSuppressClose :: (opened: bool, contains_trigger: bool,
    mouse_released: bool) -> bool {
    return opened || (contains_trigger && mouse_released)
}

#program_export
MenuMetricsFor :: (scale: float32, panel: StyleFrame, item: StyleFrame,
    bar: StyleFrame) -> MenuMetrics {
    if scale <= 0.0 { scale = 1.0 }
    metrics: MenuMetrics
    row_height: float32 = 30.0
    if MenuHas(item.value.fields, cast(u32)StyleFontSize) &&
       MenuHas(item.value.fields, cast(u32)StylePaddingY) {
        row_height = item.value.font_size + item.value.padding_y * 2.0
    }
    metrics.row_height = MenuMetric(item.value.fields,
        cast(u32)StyleContentOffset, item.value.offset_y, row_height, scale, false)
    metrics.panel_min_width = MenuMetric(panel.value.fields,
        cast(u32)StyleContentOffset, panel.value.offset_x, 180.0, scale, false)
    metrics.panel_padding = MenuMetric(panel.value.fields,
        cast(u32)StylePaddingX, panel.value.padding_x, 12.0, scale, true)
    metrics.panel_margin = MenuMetric(panel.value.fields,
        cast(u32)StyleGap, panel.value.gap, 4.0, scale, true)
    metrics.accelerator_gap = MenuMetric(item.value.fields,
        cast(u32)StyleContentOffset, item.value.offset_x, 88.0, scale, true)
    metrics.separator_inset = MenuMetric(item.value.fields,
        cast(u32)StylePaddingX, item.value.padding_x, 8.0, scale, true)
    metrics.checked_mark_inset = metrics.separator_inset
    metrics.label_inset = MenuMetric(item.value.fields,
        cast(u32)StyleIconSize, item.value.icon_size, 28.0, scale, true)
    metrics.submenu_indicator_inset = MenuMetric(item.value.fields,
        cast(u32)StylePaddingY, item.value.padding_y, 18.0, scale, true)
    metrics.bar_item_min_width = 0
    metrics.bar_item_padding = MenuMetric(bar.value.fields,
        cast(u32)StylePaddingX, bar.value.padding_x * 2.0, 24.0, scale, true)
    metrics.bar_item_gap = MenuMetric(bar.value.fields,
        cast(u32)StyleGap, bar.value.gap, 2.0, scale, true)
    metrics.bar_item_y_padding = MenuMetric(bar.value.fields,
        cast(u32)StylePaddingY, bar.value.padding_y, 3.0, scale, true)
    metrics.bar_label_inset = MenuMetric(bar.value.fields,
        cast(u32)StyleIconSize, bar.value.icon_size, 12.0, scale, true)
    return metrics
}

#program_export
MenuGroupItemWidth :: (label_width: s32, metrics: MenuMetrics) -> s32 {
    width: s32 = label_width + metrics.bar_item_padding
    if width < metrics.bar_item_min_width {
        width = metrics.bar_item_min_width
    }
    return width
}

#program_export
MenuPanelWidthStep :: (current_width: s32, label_width: s32,
    accelerator_width: s32, has_accelerator: bool,
    metrics: MenuMetrics) -> s32 {
    width: s32 = current_width
    if width <= 0 { width = metrics.panel_min_width }
    accel: s32 = 0
    if has_accelerator {
        accel = accelerator_width + metrics.accelerator_gap
    }
    candidate: s32 = label_width + accel + metrics.panel_padding * 2
    if candidate > width { width = candidate }
    return width
}

#program_export
MenuPanelBounds :: (x: s32, y: s32, width: s32, item_count: s32,
    metrics: MenuMetrics) -> Rectangle {
    bounds: Rectangle
    if item_count < 0 { item_count = 0 }
    if width < 0 { width = 0 }
    bounds.x = cast(float32)x
    bounds.y = cast(float32)y
    bounds.width = cast(float32)width
    bounds.height = cast(float32)(metrics.row_height * item_count +
        metrics.panel_margin * 2)
    return bounds
}

#program_export
MenuRowBounds :: (panel: Rectangle, index: s32,
    metrics: MenuMetrics) -> Rectangle {
    row: Rectangle
    if index < 0 { index = 0 }
    row.x = panel.x + cast(float32)metrics.panel_margin
    row.y = panel.y + cast(float32)(metrics.panel_margin +
        index * metrics.row_height)
    row.width = panel.width - cast(float32)(metrics.panel_margin * 2)
    row.height = cast(float32)metrics.row_height
    if row.width < 0.0 { row.width = 0.0 }
    return row
}

#program_export
MenuSubmenuX :: (row: Rectangle) -> s32 {
    return cast(s32)(row.x + row.width)
}

#program_export
MenuSubmenuOrigin :: (row: Rectangle) -> Vector2 {
    origin: Vector2
    origin.x = row.x + row.width
    origin.y = row.y
    return origin
}

#program_export
MenuSeparatorLineFor :: (row: Rectangle, metrics: MenuMetrics) -> MenuLine {
    line: MenuLine
    line.x1 = cast(s32)row.x + metrics.separator_inset
    line.y1 = cast(s32)(row.y + row.height / 2.0)
    line.x2 = cast(s32)(row.x + row.width) - metrics.separator_inset
    line.y2 = line.y1
    if line.x2 < line.x1 {
        line.x2 = line.x1
    }
    return line
}

#program_export
MenuTextY :: (row: Rectangle, line_height: s32) -> s32 {
    return cast(s32)row.y + (cast(s32)row.height - line_height) / 2
}

#program_export
MenuCheckedMarkX :: (row: Rectangle, metrics: MenuMetrics) -> s32 {
    return cast(s32)row.x + metrics.checked_mark_inset
}

#program_export
MenuLabelX :: (row: Rectangle, metrics: MenuMetrics) -> s32 {
    return cast(s32)row.x + metrics.label_inset
}

#program_export
MenuAcceleratorX :: (row: Rectangle, text_width: s32,
    metrics: MenuMetrics) -> s32 {
    return cast(s32)(row.x + row.width) - text_width - metrics.panel_padding
}

#program_export
MenuAcceleratorShouldFire :: (keyboard_enabled: bool, ctrl_required: bool,
    ctrl_down: bool, shift_required: bool, shift_down: bool,
    alt_required: bool, alt_down: bool,
    key_pressed: bool) -> bool {
    if !keyboard_enabled { return false }
    if ctrl_required && !ctrl_down { return false }
    if shift_required && !shift_down { return false }
    if alt_required && !alt_down { return false }
    return key_pressed
}

#program_export
MenuSubmenuIndicatorX :: (row: Rectangle,
    metrics: MenuMetrics) -> s32 {
    return cast(s32)(row.x + row.width) - metrics.submenu_indicator_inset
}

#program_export
MenuBarFirstItemX :: (bar: Rectangle, metrics: MenuMetrics) -> s32 {
    return cast(s32)bar.x + metrics.panel_margin
}

#program_export
MenuBarNextItemX :: (x: s32, width: s32,
    metrics: MenuMetrics) -> s32 {
    return x + width + metrics.bar_item_gap
}

#program_export
MenuBarLabelX :: (item: Rectangle, metrics: MenuMetrics) -> s32 {
    return cast(s32)item.x + metrics.bar_label_inset
}

#program_export
MenuBarLabelY :: (item: Rectangle, line_height: s32) -> s32 {
    return MenuTextY(item, line_height)
}

#program_export
MenuGroupItemBounds :: (x: s32, bar: Rectangle, width: s32,
    metrics: MenuMetrics) -> Rectangle {
    item: Rectangle
    item.x = cast(float32)x
    item.y = bar.y + cast(float32)metrics.bar_item_y_padding
    item.width = cast(float32)width
    item.height = bar.height - cast(float32)(metrics.bar_item_y_padding * 2)
    if item.height < 0.0 { item.height = 0.0 }
    return item
}
