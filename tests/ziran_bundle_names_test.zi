    if ModuleName("kryon_ad43e92a58270_text", "text") { return 16 }
    if ModuleName("2kryon_ad43e92a5827_text", "text") { return 17 }
    if ModuleName("other-kryon_ad43e92a5827_text", "text") { return 18 }
    return 0
}
