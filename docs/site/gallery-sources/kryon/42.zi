using UI :: #import "kryon/Widgets";
#import "kryon/system_theme"
#import "std/number_text"
using Example :: #import "scenes";
#import "palette"
#import "preview_protocol"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = "NavigationBarConfig", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 42
    scene_image = "catalog-image.png"
    input := Prepare(session, scene)
    field_input := input.field
    area_input := input.area
    labels: [4]string = .{"First", "Second", "Third", "Fourth"}; options: [2]NavigationBarOption
    options[0].route = 1; options[0].label = "Home"; options[1].route = 2; options[1].label = "Library"
    if dismissed {
        if Button(session, ButtonProps.{.bounds = b, .label = "Configure navigation"}) == 1 { dismissed = false }
    } else {
        config := NavigationBarConfig(session, NavigationBarConfigProps.{.bounds = .{24.0, 48.0, 432.0, 256.0}, .title = "Navigation", .route_count = config_count, .max_route_count = 4, .scroll_offset = config_scroll, .dropdown_open = config_open, .dropdown_row = config_row, .close_label = "Close", .remove_label = "Remove", .add_label = "Add", .save_label = "Save", .cancel_label = "Cancel"}, config_routes[:], labels[:], options[:])
        config_count = config.route_count
        config_scroll = config.scroll_offset
        config_open = config.dropdown_open
        config_row = config.dropdown_row
        if config.action != 0 { dismissed = true; clicks += 1 }
    }

    return 0
}
