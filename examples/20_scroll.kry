#import "kryon.h"

app "Kryon Scroll" {
    size 480 360
    fps 60
}

state {
    scroll_off: int = 0
}

ScrollExample :: () #ui {
    Screen root: {
        ClearBackground(GetThemeBackground())
        Background(GetThemeSurface())
        Text((TextProps){.bounds={ScaleUIPx(40), ScaleUIPx(28), 0, 0}, .text="Scroll", .font=Text24, .color=GetThemeText(), .wrap=TextWrapNone})
        area: UIScrollArea = {{ScaleUIPx(40), ScaleUIPx(76), ScaleUIPx(360), ScaleUIPx(220)}, ScaleUIPx(520), ScaleUIPx(40), ScaleUIPx(360), &scroll_off, 0, 0}
        view: UIScrollView = BeginUIScrollContainer(area)
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(12), 0, 0}, .text="First row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(82), 0, 0}, .text="Second row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(152), 0, 0}, .text="Third row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(222), 0, 0}, .text="Fourth row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(292), 0, 0}, .text="Fifth row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        Text((TextProps){.bounds={view.content_x, view.content_y + ScaleUIPx(362), 0, 0}, .text="Sixth row", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
        EndUIScrollContainer(area, view)
    }
}
