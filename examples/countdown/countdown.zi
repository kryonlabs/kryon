App :: #import "kryon/app";
Button :: #import "kryon/button";
Countdown :: #import "kryon/countdown";
Text :: #import "kryon/text";
Layout :: #import "kryon/layout";
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
DemoTheme :: #import "kryon/Theme";

state: Countdown.CountdownState;
ends_at: float64;
Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    viewport := frame.viewport
    page := Layout.Draw(session, Layout.Props.{.bounds = viewport, .padding = Layout.Gap(.ThemeMetricSpace5),
        .gap = Layout.Gap(.ThemeMetricSpace4), .gap_override = true})
    if !page.opened { return }
    Text.Draw(session, Text.Props.{.disabled = example_disabled, .bounds = .{height = 40}, .text = "Countdown", .size = 28})
    input := CaptureFrameInput(session)
    now := cast(float64)input.elapsed_ms / 1000.0
    if ends_at == 0.0 { ends_at = now + 90.0 }
    remaining := ends_at - now
    if remaining < 0.0 { remaining = 0.0 }
    Countdown.CountdownAdvance(*state, Countdown.CountdownPartsFor(remaining, true), cast(float32)input.delta_ms / 1000.0, (example_reduced_motion || DemoTheme.CurrentTheme().motion.reduced_motion))
    props: Countdown.Props = .{.bounds = .{height = 180}, .seconds_left = remaining, .hide_days = true}
    Countdown.Draw(session, props, *state)
    if Button.Draw(session, Button.Props.{.disabled = example_disabled, .bounds = .{width = 160, height = 40}, .label = "Restart"}) != 0 { ends_at = now + 90.0 }
    unused End(session)
    return
}

example_disabled: bool;
example_reduced_motion: bool;

// The gallery host calls this before drawing the example's frames.
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}

main :: () -> s32 { return App.Run(App.Window.{.title = "countdown"}, Frame) }
