#module "grapheme_host"
#import "utf8proc.h"
#import "string.h"

ui_utf8_valid :: (text: const char*, length: i32) -> i32 #export {
    if text == nil || length < 0 { return 0 }
    offset: i32 = 0
    while offset < length {
        codepoint: i32 = 0
        size: i32 = (int)utf8proc_iterate(
        (const unsigned char*)text + offset,
        length - offset, &codepoint)
        if size < 1 { return 0 }
        offset += size
    }
    return 1
}

ui_grapheme_next_boundary :: (text: const char*,
length: i32, offset: i32) -> i32 #export {
    if offset >= length { return length }
    previous: i32 = 0
    state: i32 = 0
    size: i32 = (int)utf8proc_iterate(
    (const unsigned char*)text + offset,
    length - offset, &previous)
    if size < 1 { return offset + 1 }
    offset += size
    while offset < length {
        current: i32 = 0
        size = (int)utf8proc_iterate(
        (const unsigned char*)text + offset,
        length - offset, &current)
        if size < 1 || utf8proc_grapheme_break_stateful(
        previous, current, &state) { break }
        previous = current
        offset += size
    }
    return offset
}

ui_grapheme_floor_offset :: (text: const char*,
offset: i32) -> i32 #export {
    if text == nil || offset <= 0 { return 0 }
    length: i32 = (int)strlen(text)
    if offset >= length { return length }
    if (unsigned char)text[offset - 1] < 128 &&
    (unsigned char)text[offset] < 128 &&
    !(text[offset - 1] == '\r' && text[offset] == '\n') {
        return offset
    }
    start: i32 = offset
    while start > 0 && text[start - 1] != '\n' { start -= 1 }
    while start < offset {
        next: i32 = ui_grapheme_next_boundary(text, length, start)
        if next > offset { break }
        start = next
    }
    return start
}

ui_grapheme_next_offset :: (text: const char*,
offset: i32) -> i32 #export {
    if text == nil { return 0 }
    offset = ui_grapheme_floor_offset(text, offset)
    return ui_grapheme_next_boundary(text, (int)strlen(text), offset)
}

ui_grapheme_prev_offset :: (text: const char*,
offset: i32) -> i32 #export {
    if text == nil || offset <= 0 { return 0 }
    length: i32 = (int)strlen(text)
    if offset > length { offset = length }
    return ui_grapheme_floor_offset(text, offset - 1)
}
