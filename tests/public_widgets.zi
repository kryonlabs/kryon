using UI :: #import "Widgets";

PublicLoadingScreen :: (session: Session, props: LoadingScreenProps) {
    LoadingScreen(session, props)
}

PublicWidgets :: (session: Session, button: ButtonProps,
    image: ImageProps, checkbox: CheckboxProps, slider: SliderProps,
    dropdown: DropdownProps) -> s32 {
    Image(session, image)
    return Button(session, button)
}

// A text field's props and result carry composition state, so an application
// gets that type from the same import as the field.
PublicTextField :: (session: Session, props: TextFieldProps) -> CompositionState {
    result: TextFieldResult = TextField(session, props)
    return result.composition
}

// TextProps.align and wrap take values an application names from the same
// import as Text.
PublicTextAlignment :: (session: Session, props: TextProps) {
    props.align = TextAlign.TextAlignCenter
    props.vertical_align = TextAlign.TextAlignEnd
    props.wrap = TextWrap.TextWrapNone
    Text(session, props)
}

// A time picker takes and returns minutes after midnight, -1 for no time,
// from the same import as the other widgets.
PublicTimePicker :: (session: Session, props: TimePickerProps) -> s32 {
    result: TimePickerResult = TimePicker(session, props)
    return result.value
}
