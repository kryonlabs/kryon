// One retained frame of a portable application. The reusable native player
// owns the window; widgets, layout and state execute in the bundle instance.
#import "frame_entry"
#import "geometry"
#import "session"
#import "tree"
#import "tree_draw"
#import "tree_input"
#import "widget_kind"
#import "text_host"
#import "text_request"
#import "text_input_platform"
Clock :: #import "frame_clock";

host_api :: #system_library "host_api";
BundleInput :: struct {
    width: s32
    height: s32
    x: float32
    y: float32
    down: bool
    pressed: bool
    released: bool
    secondary_down: bool
    secondary_pressed: bool
    secondary_released: bool
    modifiers: s32
    key: s32
    wheel: float32
}
ReadBundleInput :: () -> BundleInput #foreign host_api;
TakeBundleCodepoint :: () -> s32 #foreign host_api;
BundleTextInputHost :: (focused: bool) #foreign host_api;
BundleFrameFinishedHost :: (unchanged: bool) #foreign host_api;
BundleFrameReusableHost :: () -> bool #foreign host_api;
BundleTextEditorHost :: (identity: u64, value: string, cursor: s32,
    anchor: s32, flags: s32) #foreign host_api;
BundleTextRequestHost :: (identity: u64) -> TextRequest #foreign host_api;

using FrameStatus;
using WidgetKind;
bundle_session: Session;
bundle_started: bool;
bundle_activity: Clock.FrameActivity;
bundle_last_x: float32; bundle_last_y: float32;
bundle_last_width: s32; bundle_last_height: s32; bundle_last_modifiers: s32;

bundle_editor_identity: u64;
bundle_editor_bytes: [65536]u8;
bundle_editor_count: s32;
bundle_editor_cursor: s32;
bundle_editor_anchor: s32;
bundle_editor_flags: s32;

BundleEditorPresent :: (session: Session, index: s32, value: string,
    cursor: s32, anchor: s32, secure: bool, numeric: bool, read_only: bool,
    edited: bool) {
    if !TextInputOwnerMatches(bundle_session, session) { return }
    node := TreeSubmittedNodeAt(session, index)
    if read_only || !node.selected || node.disabled || !node.has_text ||
    value.count > bundle_editor_bytes.count { return }
    for at: 0..value.count - 1 { bundle_editor_bytes[at] = value[at] }
    bundle_editor_count = cast(s32)value.count
    bundle_editor_identity = node.identity_generation
    // On an edit frame the caller still owns the preceding value. Native
    // editors defer acknowledgement until the next value is submitted.
    bundle_editor_cursor = ifx edited then 0 else cursor
    bundle_editor_anchor = ifx edited then 0 else anchor
    bundle_editor_flags = (ifx secure then 1 else 0) | (ifx numeric then 2 else 0) |
        (ifx node.kind == WidgetKindTextArea then 4 else 0) | (ifx edited then 8 else 0)
}

BundleEditorRequest :: () {
    request := BundleTextRequestHost(bundle_editor_identity)
    if !request.pending || bundle_editor_identity == 0 { return }
    for index: cast(s32)1..TreeCount(bundle_session) - 1 {
        node := TreeNodeAt(bundle_session, index)
        if node.identity_generation == bundle_editor_identity && node.selected &&
        TreeInputAllowedAt(bundle_session, index) &&
        (!TreeHasFocus(bundle_session) || TreeFocusedAt(bundle_session, index)) {
            unused TextRequestSend(bundle_session, index, request.value,
                request.replace, request.cursor, request.anchor)
            return
        }
    }
}

#program_export
main :: () -> s32 {
    if !bundle_started {
        bundle_session = SessionOpen()
        if !SessionValid(bundle_session) { return 1 }
        bundle_started = true
        TextHostInstall(BundleEditorPresent)
    }
    BundleEditorRequest()
    bundle_editor_identity = 0
    bundle_editor_count = 0
    bundle_editor_cursor = 0; bundle_editor_anchor = 0; bundle_editor_flags = 0
    input := ReadBundleInput()
    active := input.down || input.pressed || input.released ||
        input.secondary_down || input.secondary_pressed || input.secondary_released ||
        input.key != 0 || input.wheel != 0.0 ||
        input.x != bundle_last_x || input.y != bundle_last_y ||
        input.width != bundle_last_width || input.height != bundle_last_height ||
        input.modifiers != bundle_last_modifiers
    bundle_last_x = input.x; bundle_last_y = input.y
    bundle_last_width = input.width; bundle_last_height = input.height
    bundle_last_modifiers = input.modifiers
    viewport := Rectangle.{0.0, 0.0,
        cast(float32)input.width, cast(float32)input.height}
    pointer := PointerFrame.{input.x, input.y, input.down,
        input.pressed, input.released}
    secondary := SecondaryPointerFrame.{input.secondary_down,
        input.secondary_pressed, input.secondary_released}
    TreePointerUpdate(bundle_session, pointer)
    TreeSecondaryPointerUpdate(bundle_session, secondary)
    PointerWheelSend(bundle_session, input.x, input.y, input.wheel)
    KeyboardModifiersSend(bundle_session, input.modifiers)
    if input.key != 0 { KeyboardSend(bundle_session, input.key) }
    codepoint := TakeBundleCodepoint()
    while codepoint != 0 {
        active = true
        TypedCodepointSend(bundle_session, codepoint)
        codepoint = TakeBundleCodepoint()
    }
    if BeginFrame(bundle_session, cast(u64)1, viewport) != cast(FrameStatus)FrameOk {
        return 1
    }
    result := Frame(bundle_session, viewport)
    if result != 0 {
        TreeCancel(bundle_session)
        return result
    }
    finished := EndFrameRetained(bundle_session, BundleFrameReusableHost(), Clock.Observe(*bundle_activity, active))
    if finished.status != cast(FrameStatus)FrameOk { return 1 }
    // A platform sees only committed, still-focused field identities.
    if bundle_editor_identity != 0 {
        found := false
        for index: cast(s32)1..TreeCount(bundle_session) - 1 {
            node := TreeNodeAt(bundle_session, index)
            if node.identity_generation == bundle_editor_identity && node.selected &&
            TreeInputAllowedAt(bundle_session, index) &&
            (!TreeHasFocus(bundle_session) || TreeFocusedAt(bundle_session, index)) {
                found = true
                // Reopening an OS keyboard needs a fresh hit on the actual
                // committed guest field, including clipping/overlay routing.
                if input.pressed && TreeHitAt(bundle_session, input.x, input.y) == index {
                    bundle_editor_flags = bundle_editor_flags | 16
                }
                break
            }
        }
        if !found { bundle_editor_identity = 0; bundle_editor_count = 0; bundle_editor_cursor = 0; bundle_editor_anchor = 0 }
    }
    BundleTextEditorHost(bundle_editor_identity, TextView(bundle_editor_bytes[:bundle_editor_count]),
        bundle_editor_cursor, bundle_editor_anchor, bundle_editor_flags)
    BundleFrameFinishedHost(finished.paint_unchanged)
    BundleTextInputHost(TreeTextInputActive(bundle_session))
    return 0
}
