#module "style_sheet"
#import "style"
#import "control_props"

# KSS is the text format. The runtime API uses plain Style* names.
# Compilers and parsers lower .kss files into these typed rule tables.

StyleAny :: () -> i32 #export {
    return -1
}

StyleStateAny :: () -> i32 #export {
    return 0
}

StyleKindAny :: () -> i32 #export {
    return 0
}

StyleKindApp :: () -> i32 #export {
    return 1
}

