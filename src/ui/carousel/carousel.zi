Joystick :: #import "joystick";
Shape :: #import "shape";
Box :: #import "box";
Button :: #import "button";
Image :: #import "image";
Text :: #import "text";
// A cover browser shared by game launchers and title screens. The caller
// owns the selected page; assets and actions remain application data.
#import "session"
#import "geometry"
#import "drawing_props"
#import "control_props"
#import "text_align"
#if #defined(KRYON_HOSTED_UI) {
    host_api :: #system_library "host_api";
    CarouselWheelHostedHost :: (session: Session, bounds: Rectangle) -> float32 #foreign host_api;
    CarouselWheel :: (session: Session, bounds: Rectangle) -> float32 { return CarouselWheelHostedHost(session, bounds) }
} else {
    #import "tree_input"
    CarouselWheel :: (session: Session, bounds: Rectangle) -> float32 { return PointerWheelTake(session, bounds) }
}
TextMeasure :: #import "text_measure";
#import "theme"

CarouselItem :: struct {
    label: string
    portrait: string
    landscape: string
    source: Rectangle
    logo: string
    caption: string
    action: string
    action_ribbon: string // Optional promotion attached to the action, never the title.
    disabled: bool
}

CarouselState :: struct {
    selected: s32
    position: float32
    time: float64
    wheel_time: float64
}

Props :: struct {
    key: u64
    bounds: Rectangle
    now: float64
    key_pressed: s32
    label: string
    previous_label: string
    next_label: string
    scale: float32
    dark: bool
    disabled: bool
    // Optional logical-pixel limits for a host's surrounding title controls.
    // Zero preserves the standard cover branding size and top position.
    logo_max_width: float32
    logo_top: float32
}

CarouselLogoBounds :: (bounds: Rectangle, max_width: float32 = 0.0, top: float32 = 0.0) -> Rectangle {
    width := ifx bounds.height > bounds.width then bounds.width * 0.88 else bounds.height * 0.95
    if width > 760.0 { width = 760.0 }
    if max_width > 0.0 && width > max_width { width = max_width }
    return Rectangle.{bounds.x + (bounds.width - width) / 2.0,
        bounds.y + ifx top > 0.0 then top else bounds.height * 0.05, width, width * 0.36}
}

// A whole cover, also usable while a native game is loading.
CarouselArtwork :: (session: Session, bounds: Rectangle, key: u64,
    art: string, logo: string, label: string,
    source: Rectangle = Rectangle.{}, logo_max_width: float32 = 0.0, logo_top: float32 = 0.0) -> Rectangle {
    Image.Draw(session, Image.Props.{.key = key, .asset_path = art, .alt_text = label,
            .bounds = bounds, .source = source, .fit = Image.ImageFit.ImageFitCover,
            .smooth = true})
    area := CarouselLogoBounds(bounds, logo_max_width, logo_top)
    if logo != "" {
        Image.Draw(session, Image.Props.{.key = key + 1, .asset_path = logo, .alt_text = label,
                .bounds = area, .fit = Image.ImageFit.ImageFitContain, .smooth = true})
    }
    return area
}

CarouselSelect :: (state: *CarouselState, count: s32, delta: s32, now: float64) {
    state.selected += delta
    if state.selected >= count { state.selected = count - 1 }
    if state.selected < 0 { state.selected = 0 }
    elapsed := cast(float32)(now - state.time)
    state.time = now
    if elapsed < 0.0 || elapsed > 0.2 { elapsed = 0.016 }
    rate := elapsed * 10.0
    if rate > 1.0 { rate = 1.0 }
    state.position += (cast(float32)state.selected - state.position) * rate
    distance := state.position - cast(float32)state.selected
    if distance < 0.002 && distance > -0.002 { state.position = cast(float32)state.selected }
}

// The logo and caption of the page nearest the slide stay in place and fade
// as the next one comes in; a logo both pages share stays solid.
CarouselTitle :: (session: Session, props: Props, items: []CarouselItem,
    state: *CarouselState, scale: float32) {
    bounds := props.bounds
    count := cast(s32)items.count
    nearest := cast(s32)(state.position + 0.5)
    if nearest < 0 { nearest = 0 }
    if nearest >= count { nearest = count - 1 }
    distance := state.position - cast(float32)nearest
    if distance < 0.0 { distance = -distance }
    other := ifx state.position > cast(float32)nearest then nearest + 1 else nearest - 1
    item := items[nearest]
    shared := other >= 0 && other < count && items[other].logo == item.logo
    fade := 1.0 - distance * 2.0
    if fade < 0.0 { fade = 0.0 }
    key := WidgetPartKey(props.key, 6)
    logo := CarouselLogoBounds(bounds, props.logo_max_width, props.logo_top)
    logo_alpha := ifx shared then 1.0 else cast(float64)fade
    if item.logo != "" && logo_alpha > 0.02 {
        Image.Draw(session, Image.Props.{.key = key, .asset_path = item.logo, .alt_text = item.label,
                .bounds = logo, .fit = Image.ImageFit.ImageFitContain, .smooth = true,
                .tint = cast(u32)0xFFFFFF00 | cast(u32)(logo_alpha * 255.0)})
    }
    // Text cannot fade, so the caption shows once its page has settled.
    if item.caption == "" || distance > 0.12 { return }
    tag_width := ifx item.logo != "" then 200.0 * scale else bounds.width - 120.0 * scale
    tag := Rectangle.{bounds.x + (bounds.width - tag_width) / 2.0,
        ifx item.logo != "" then logo.y + logo.height + 4.0 * scale else bounds.y + 40.0 * scale,
        tag_width, 44.0 * scale}
    unused Box.Draw(session, Box.Props.{.key = key + 2, .bounds = tag,
            .fill = StyleTokenColorOr("surface", ColorFromPacked(CurrentSurface())), .radius = 22.0 * scale})
    Text.Draw(session, Text.Props.{.key = key + 3, .bounds = tag, .text = item.caption,
            .size = cast(s32)(22.0 * scale),
            .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
}

// A folded strip overlaps the action's top edge, leaving its label and hit
// target intact. Decorative nodes never intercept pointer or keyboard input.
CarouselActionRibbon :: (session: Session, key: u64, button: Rectangle, label: string, scale: float32 = 1.0) {
    if label == "" { return }
    width := cast(float32)TextMeasure.TextWidth(session, Text.Props.{.text = label, .size = cast(s32)(14.0 * scale)}) + 28.0 * scale
    if width > button.width - 16.0 * scale { width = button.width - 16.0 * scale }
    x := button.x + (button.width - width) / 2.0
    y := button.y - 17.0 * scale
    height := 26.0 * scale
    fold := 7.0 * scale
    unused Shape.Triangle(session, Shape.TriangleProps.{.key = key + 2,
        .first = Vector2.{x - fold, y + height}, .second = Vector2.{x, y + height - fold},
        .third = Vector2.{x, y + height + fold}, .color = Color.{135, 39, 28, 255}})
    unused Shape.Triangle(session, Shape.TriangleProps.{.key = key + 3,
        .first = Vector2.{x + width + fold, y + height}, .second = Vector2.{x + width, y + height - fold},
        .third = Vector2.{x + width, y + height + fold}, .color = Color.{135, 39, 28, 255}})
    unused Box.Draw(session, Box.Props.{.key = key, .bounds = Rectangle.{x - fold, y, width + fold * 2.0, height},
        .fill = Color.{214, 58, 38, 255}, .radius = 2.0 * scale})
    unused Text.Draw(session, Text.Props.{.key = key + 1, .bounds = Rectangle.{x, y, width, height},
        .text = label, .size = cast(s32)(14.0 * scale),
        .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
}

// Returns the activated item, or -1. Pointer, swipe, wheel and keyboard
// select the same page; only the selected page exposes an action.
Draw :: (session: Session, props: Props, items: []CarouselItem,
    state: *CarouselState) -> s32 {
    if items.count == 0 || props.bounds.width <= 0.0 || props.bounds.height <= 0.0 { return -1 }
    bounds := props.bounds
    scale := ifx props.scale > 0.0 then props.scale else 1.0
    count := cast(s32)items.count
    delta: s32
    gesture := Joystick.SwipeArea(session, Joystick.SwipeAreaProps.{.key = props.key, .bounds = bounds,
            .label = props.label, .now = props.now, .min_distance = 48.0 * scale, .disabled = props.disabled})
    if !props.disabled {
        if gesture.swiped == 0 || props.key_pressed == 262 { delta = 1 }
        if gesture.swiped == 2 || props.key_pressed == 263 { delta = -1 }
    }
    wheel := ifx props.disabled then 0.0 else CarouselWheel(session, bounds)
    if wheel != 0.0 && props.now - state.wheel_time > 0.18 {
        delta = ifx wheel < 0.0 then 1 else -1
        state.wheel_time = props.now
    }
    CarouselSelect(state, count, delta, props.now)
    activated: s32 = -1
    if !props.disabled && (props.key_pressed == 257 || props.key_pressed == 32) && !items[state.selected].disabled {
        activated = state.selected
    }
    // A narrow gap separates the covers, so two pictures never meet in a seam.
    stride := bounds.width + 16.0 * scale
    for page: cast(s32)0..count - 1 {
        offset := (cast(float32)page - state.position) * stride
        if offset <= -stride || offset >= stride { continue }
        item := items[page]
        key := WidgetPartKey(WidgetPartKey(props.key, 5), page)
        art := ifx bounds.height > bounds.width || item.landscape == "" then item.portrait else item.landscape
        Image.Draw(session, Image.Props.{.key = key, .asset_path = art, .alt_text = item.label,
                .bounds = Rectangle.{bounds.x + offset, bounds.y, bounds.width, bounds.height},
                .source = item.source, .fit = Image.ImageFit.ImageFitCover, .smooth = true})
    }
    CarouselTitle(session, props, items, state, scale)
    // Keep the one action still while covers slide underneath it.
    item := items[state.selected]
    action_width := 260.0 * scale
    if action_width > bounds.width - 64.0 * scale { action_width = bounds.width - 64.0 * scale }
    action_y := bounds.y + bounds.height - 196.0 * scale
    if action_y < bounds.y + bounds.height * 0.5 { action_y = bounds.y + bounds.height * 0.5 }
    if Button.Draw(session, Button.Props.{.key = WidgetPartKey(props.key, 1),
            .bounds = Rectangle.{bounds.x + (bounds.width - action_width) / 2.0, action_y, action_width, 64.0 * scale},
            .label = item.action, .disabled = props.disabled || item.disabled, .pill = true, .size = ControlSize.ControlSizeLarge,
            .tone = ButtonTone.ButtonToneSuccess, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        activated = state.selected
    }
    CarouselActionRibbon(session, WidgetPartKey(props.key, 8),
        Rectangle.{bounds.x + (bounds.width - action_width) / 2.0, action_y, action_width, 64.0 * scale}, item.action_ribbon, scale)
    // Round, solid arrows stay readable over any cover.
    middle := bounds.y + bounds.height * 0.5 - 24.0 * scale
    if state.selected > 0 && Button.Draw(session, Button.Props.{.key = WidgetPartKey(props.key, 2),
            .bounds = Rectangle.{bounds.x + 12.0 * scale, middle, 48.0 * scale, 48.0 * scale},
            .label = props.previous_label, .disabled = props.disabled, .icon_shape = "S2rr:M15 5L8 12L15 19", .icon_only = true, .circle = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        state.selected -= 1
    }
    if state.selected < count - 1 && Button.Draw(session, Button.Props.{.key = WidgetPartKey(props.key, 3),
            .bounds = Rectangle.{bounds.x + bounds.width - 60.0 * scale, middle, 48.0 * scale, 48.0 * scale},
            .label = props.next_label, .disabled = props.disabled, .icon_shape = "S2rr:M9 5L16 12L9 19", .icon_only = true, .circle = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
        state.selected += 1
    }
    if count > 1 {
        // Small dots on a dark pill, the current page drawn wider.
        dot := 8.0 * scale
        current := 22.0 * scale
        spacing := 8.0 * scale
        row_width := cast(float32)(count - 1) * (dot + spacing) + current
        row_y := action_y + 64.0 * scale + 22.0 * scale
        unused Box.Draw(session, Box.Props.{.key = WidgetPartKey(props.key, 7),
                .bounds = Rectangle.{bounds.x + (bounds.width - row_width) / 2.0 - 10.0 * scale, row_y - 8.0 * scale,
                    row_width + 20.0 * scale, dot + 16.0 * scale},
                .fill = Color.{0, 0, 0, 90}, .radius = (dot + 16.0 * scale) * 0.5})
        x := bounds.x + (bounds.width - row_width) / 2.0
        for page: cast(s32)0..count - 1 {
            width := ifx page == state.selected then current else dot
            unused Box.Draw(session, Box.Props.{.key = WidgetPartKey(WidgetPartKey(props.key, 4), page),
                    .bounds = Rectangle.{x, row_y, width, dot},
                    .fill = ifx page == state.selected then Color.{255, 255, 255, 255} else Color.{255, 255, 255, 140},
                    .radius = dot * 0.5})
            x += width + spacing
        }
    }
    return activated
}
