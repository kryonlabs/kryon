            Text((TextProps){.bounds={x, y + ScaleUIPx(628), 0, 0}, .text="VSliderFloat / VSliderInt", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
            VSliderFloat((SliderFloatProps){.bounds = {x,y + ScaleUIPx(666),ScaleUIPx(48),ScaleUIPx(150)}, .id = 310, .values = numbers, .value_count = 1, .min = 0.0f, .max = 1.0f})
            VSliderInt((SliderIntProps){.bounds = {x + ScaleUIPx(72),y + ScaleUIPx(666),ScaleUIPx(48),ScaleUIPx(150)}, .id = 311, .values = integers, .value_count = 1, .min = 0, .max = 10})
            Text((TextProps){.bounds={right, y + ScaleUIPx(628), 0, 0}, .text="PlotLines", .font=Text16, .color=GetThemeText(), .wrap=TextWrapNone})
