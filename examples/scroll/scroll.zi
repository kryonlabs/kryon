#import "kryon/geometry"
#import "kryon/session"
#import "kryon/frame_snapshot"
#import "kryon/style_sheet"
Box :: #import "kryon/box";
Scroll :: #import "kryon/scroll";
Text :: #import "kryon/text";
#import "kryon/drawing_props"
#import "kryon/tree"
#import "kryon/system_theme"
#import "std/number_text"

WidgetContext :: struct { theme: s32; now: float32; disabled: bool; reduced_motion: bool }

WidgetInput :: (session: Session) -> WidgetContext {
    snapshot := CaptureFrameInput(session)
    result: WidgetContext
    result.now = cast(float32)snapshot.elapsed_ms / 1000.0
    result.theme = ifx StyleTokenColor("canvas").r < 128 then 2 else 1
    result.disabled = example_disabled
    result.reduced_motion = example_reduced_motion
    return result
}

gallery_view: Rectangle = Rectangle.{.x = 0.0, .y = 0.0, .width = 480.0, .height = 320.0};

gallery_live: bool;

gallery_now: float32;

gallery_reduced_motion: bool;

SetGalleryViewport :: (view: Rectangle, live: bool, now: float32, reduced_motion: bool) {
    gallery_view = view; gallery_live = live; gallery_now = now
    gallery_reduced_motion = reduced_motion
}

scroll: s32;

b: Rectangle;

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := WidgetInput(session)
    SetGalleryViewport(viewport, true, example_input.now, example_input.reduced_motion)
    Box.Draw(session, Box.Props.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text.Draw(session, Text.Props.{.key = 9001, .bounds = .{viewport.x + 24.0, viewport.y + 12.0, viewport.width - 48.0, 36.0}, .text = "Scroll", .size = 23})
    b = Rectangle.{viewport.x + 24.0, viewport.y + 64.0, viewport.width - 48.0, 44.0}
    disabled := example_input.disabled

    b.height = 188.0
    result := Scroll.Draw(session, Scroll.Props.{.bounds = b, .content_height = 420, .scroll_offset = scroll})
    scroll = result.scroll_offset
    if result.opened {
        for row: 0..9 {
            Text.Draw(session, Text.Props.{.bounds = .{result.content.x + 12.0, result.content.y + cast(float32)row * 40.0, 390.0, 32.0}, .text = "Scroll to see the next row"})
        }
        unused End(session)
    }
    return 0
}

example_disabled: bool;
example_reduced_motion: bool;

// Hosts publish these options before the unchanged application entry point.
#program_export
SetExampleOptions :: (disabled: bool, reduced_motion: bool) {
    example_disabled = disabled
    example_reduced_motion = reduced_motion
}
