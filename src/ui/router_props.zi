#module "router_props"
#import "geometry"

RouterRoute :: struct {
    id: i32
    parent: i32
    path: string
    title: string
    group: string
}

RouterState :: struct {
    initialized: bool
    current_route: i32
    previous_route: i32
    requested_route: i32
    has_request: bool
    changed: bool
    route_version: i32
    generation: u32
}

RouterProps :: struct {
    bounds: Rectangle
    key: u64
    initial_route: i32
    sync_url: bool
    replace_on_init: bool
}

RouterResult :: struct {
    state: RouterState
    route: i32
    previous_route: i32
    requested_route: i32
    changed: bool
    route_index: i32
    node: i32
    write_url: bool
    push_url: bool
    url_base: string
    url_path: string
    url_path_start: i32
}
