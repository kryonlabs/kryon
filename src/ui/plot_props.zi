#import "geometry"

PlotMode :: enum {
    PlotLines = 0
    PlotBars = 1
}

PlotProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    label: string
    overlay: string
    offset: s32
    scale_min: float32
    scale_max: float32
    scale: float32
    mode: PlotMode
}
