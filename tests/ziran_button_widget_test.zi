using Image.ImageFit;
using ButtonTone;
using IconPlacement;
using ContentAlignment;
using StyleField;
using LineHeightUnit;
using FrameStatus;
using WidgetKind;

phase: s32;

CheckButtonLineHeight :: () -> bool {
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.selector.kind = StyleKindButton()
    rule.style = .{.fields = cast(u32)StyleMinHeight | cast(u32)StyleFontSize |
        cast(u32)StylePaddingY | cast(u32)StyleLineHeight, .min_height = 1.0, .font_size = 14.0,
        .padding_y = 2.0, .line_height = 2.0, .line_height_unit = cast(LineHeightUnit)LineHeightFactor}
    rules: StyleRules
    rules.count = 1; rules.items[0] = rule
    props := Button.Props.{.label = "Run"}
    if !InstallStyleRules(rules) || Button.ButtonMeasure(props).height != 32.0 { return false }
    rules.items[0].style.line_height_unit = cast(LineHeightUnit)LineHeightLength
    rules.items[0].style.line_height = 19.0
    if !InstallStyleRules(rules) || Button.ButtonMeasure(props).height != 23.0 ||
        MeasureBounds(props, rules.items[0].style, 2.0, 28, 40.0, 0.0, 2.0, false).height != 46.0 { return false }
    rules.items[0].style.line_height = 0.0
    if !InstallStyleRules(rules) || Button.ButtonMeasure(props).height != 4.0 { return false }
    rules.items[0].style.line_height_unit = cast(LineHeightUnit)LineHeightNormal
    if !InstallStyleRules(rules) || Button.ButtonMeasure(props).height != 16.0 { return false }
    rules.items[0].style.line_height = 19.0
    return InstallStyleRules(rules) && Button.ButtonMeasure(props).height == 23.0
}

#program_export
Frame :: () -> s32 {
    if ButtonPictureSize(64.0, 64.0, 18.0, true, true) != 52.0 { return 90 }
    if ButtonPictureSize(80.0, 40.0, 18.0, true, true) != 28.0 { return 91 }
    if ButtonPictureSize(64.0, 64.0, 18.0, true, false) != 18.0 { return 92 }
    if ButtonPictureSize(64.0, 64.0, 18.0, false, true) != 18.0 { return 93 }
    // Tiles show their artwork large; ordinary controls keep glyph size.
    if ButtonLabeledPictureSize(190.0, 88.0, 18.0, 20.0, 8.0, true) != 36.0 { return 80 }
    if ButtonLabeledPictureSize(190.0, 160.0, 18.0, 20.0, 8.0, true) != 64.0 { return 81 }
    if ButtonLabeledPictureSize(60.0, 160.0, 18.0, 20.0, 8.0, true) != 36.0 { return 82 }
    if ButtonLabeledPictureSize(300.0, 64.0, 18.0, 20.0, 8.0, false) != 40.0 { return 83 }
    if ButtonLabeledPictureSize(300.0, 40.0, 18.0, 20.0, 8.0, false) != 18.0 { return 84 }
    // Capsules stay capsules on controls; tall tiles take card corners.
    if ButtonCornerRadius(999.0, 40.0) != 999.0 || ButtonCornerRadius(999.0, 88.0) != 20.0 ||
        ButtonCornerRadius(8.0, 88.0) != 8.0 { return 85 }
    muted := Button.ButtonDefaultFace(Button.Props.{.tone = .ButtonToneAccent}, cast(s32)ButtonState.ButtonStateDisabled)
    disabled_alpha := cast(u32)(255.0 * Theme.CurrentTheme().metrics.disabled_opacity)
    if (muted.background & cast(u32)255) != disabled_alpha ||
        (muted.foreground & cast(u32)255) != disabled_alpha ||
        muted.foreground == muted.background { return 94 }
    clear := Button.ButtonDefaultFace(Button.Props.{.emphasis = .ButtonEmphasisGhost}, cast(s32)ButtonState.ButtonStateDisabled)
    if (clear.background & cast(u32)255) != cast(u32)0 ||
        (clear.foreground & cast(u32)255) == cast(u32)255 { return 95 }
    props: Button.Props
    props.key = cast(u64)7
    props.id = 7
    props.class_name = 9
    props.label = "Run"
    props.bounds = Rectangle.{10.0, 20.0, 80.0, 30.0}
    props.tone = cast(ButtonTone)ButtonToneAccent
    if phase == 0 {
        rules: StyleRules
        rules.count = 1
        rule: StyleRule
        rule.selector = StyleDefaultSelector()
        rule.selector.kind = StyleKindButton()
        rule.selector.class_name = 9
        rule.style.fields = cast(u32)StyleBackground |
        cast(u32)StyleForeground | cast(u32)StyleRadius |
        cast(u32)StyleOpacity | cast(u32)StyleFontSize
        rule.style.background = cast(u32)0x123456ff
        rule.style.foreground = cast(u32)0xaabbccff
        rule.style.radius = 4.0
        rule.style.opacity = 0.5
        rule.style.font_size = 14.0
        rules.items[0] = rule
        InstallStyleRules(rules)
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button.Draw(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk || TreeCount(TestSession()) != 2 ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -1 }
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
        phase = 1
        return 0
    }
    if phase == 1 {
        TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, false, false, true})
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        clicked: s32 = Button.Draw(TestSession(), props)
        if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || clicked != 1 { return -2 }
        phase = 2
        return 42
    }
    if phase == 3 {
        props.image.asset_path = "badge.png"
        props.image.fit = cast(Image.ImageFit)ImageFitContain
        props.icon_placement = cast(IconPlacement)IconPlacementTrailing
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button.Draw(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -4 }
        phase = 4
        return 44
    }
    if phase == 4 {
        // icon_type without an image draws the built-in icon atlas tile.
        props.icon_type = 7
        props.icon_only = true
        ExpectIcon()
        BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
        if Button.Draw(TestSession(), props) != 0 || EndFrame(TestSession()) != cast(FrameStatus)FrameOk ||
        TreeNodeAt(TestSession(), 1).semantic_label != "Run" { return -5 }
        phase = 5
        return 45
    }
    props.disabled = true
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    clicked: s32 = Button.Draw(TestSession(), props)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || clicked != 0 { return -3 }
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
    TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, false, false, true})
    phase = 3
    return 43
}

#program_export
// Buttons a grid places fill their cells and center their labels there,
// and the grid keeps inside the padding of the column that holds it.
GridButtons :: () -> s32 {
    session := TestSession()
    BeginFrame(session, cast(u64)5, Rectangle.{0.0, 0.0, 480.0, 320.0})
    page := Layout.Draw(session, Layout.Props.{.key = 301, .bounds = .{0.0, 0.0, 480.0, 320.0}, .padding = 20,
        .gap = 12, .gap_override = true})
    grid := Layout.Grid(session, GridProps.{.key = 302, .columns = 2, .gap = 12})
    for index: cast(s32)0..1 {
        unused Button.Draw(session, Button.Props.{.key = cast(u64)(303 + index), .label = "Run",
            .bounds = .{height = 44.0}})
        node := TreeSubmittedCount(session) - 1
        cell := TreeSubmittedBounds(session, node)
        left := 20.0 + cast(float32)index * 226.0
        if cell.x != left || cell.width != 214.0 || cell.height != 44.0 { return 1 + index }
        labels: s32 = 0
        for n: 0..PendingPaintCount(session) - 1 {
            command := PendingPaintAt(session, n)
            if command.node != node || (command.kind != cast(s32)PaintKind.PaintKindText &&
                command.kind != cast(s32)PaintKind.PaintKindClippedText) { continue }
            center := cast(float32)command.x + 10.5
            if center < left + 106.0 || center > left + 108.0 { return 3 + index }
            labels += 1
        }
        if labels == 0 { return 5 + index }
    }
    if !grid.container.opened || !End(session) { return 7 }
    // A grid with its own height and padding keeps explicit-width buttons
    // inside its tracks.
    framed := Layout.Grid(session, GridProps.{.key = 310, .bounds = .{height = 208.0}, .columns = 2, .gap = 12,
        .padding = 8})
    for index: cast(s32)0..1 {
        unused Button.Draw(session, Button.Props.{.key = cast(u64)(311 + index), .label = "Run",
            .bounds = .{0.0, 0.0, 164.0, 44.0}})
        cell := TreeSubmittedBounds(session, TreeSubmittedCount(session) - 1)
        left := 28.0 + cast(float32)index * 218.0
        if cell.x != left || cell.width != 164.0 { return 1000 * (10 + index) + cast(s32)(cell.x + cell.width) }
    }
    if !framed.container.opened || !End(session) || !page.opened || !End(session) { return 9 }
    if EndFrame(session) != cast(FrameStatus)FrameOk { return 8 }
    return 0
}

// A button whose rule sets a transform keeps its layout box. When the
// frame commits, its shapes take the map about the center of that box and
// its label is rewritten in place: moved, and at twice the font size.
TransformedButton :: () -> s32 {
    session := TestSession()
    PaintTransformInstall()
    rules: StyleRules
    rules.count = 1
    rule: StyleRule
    rule.selector = StyleDefaultSelector()
    rule.selector.kind = StyleKindButton()
    rule.selector.class_name = 9
    rule.box.fields = cast(u32)StyleBoxField.StyleBoxTransform
    rule.box.transform = float32.[4.0, 0.0, 0.0, 2.0, 2.0]
    rules.items[0] = rule
    InstallStyleRules(rules)
    BeginFrame(session, cast(u64)6, Rectangle.{0.0, 0.0, 300.0, 100.0})
    unused Button.Draw(session, Button.Props.{.key = 320, .class_name = 9, .label = "Run",
        .bounds = .{10.0, 20.0, 80.0, 30.0}})
    node := TreeSubmittedCount(session) - 1
    if TreeSubmittedBounds(session, node).x != 10.0 || TreeSubmittedBounds(session, node).width != 80.0 { return 1 }
    font: s32 = 0
    for n: 0..PendingPaintCount(session) - 1 {
        command := PendingPaintAt(session, n)
        if command.node == node && (command.kind == cast(s32)PaintKind.PaintKindText ||
            command.kind == cast(s32)PaintKind.PaintKindClippedText) { font = command.font }
    }
    paint_matrix_frame(session, true)
    shapes: s32 = 0
    labels: s32 = 0
    for n: 0..PendingPaintCount(session) - 1 {
        command := PendingPaintAt(session, n)
        if command.node != node { continue }
        if command.kind == cast(s32)PaintKind.PaintKindText || command.kind == cast(s32)PaintKind.PaintKindClippedText {
            if font <= 0 || command.font != font * 2 { return 2 }
            labels += 1
        } else {
            if command.kind < cast(s32)PaintKind.PaintKindTransformed || command.matrix.a != 2.0 ||
                command.matrix.d != 2.0 || command.matrix.b != 0.0 || command.matrix.tx != -46.0 ||
                command.matrix.ty != -35.0 { return 3 }
            shapes += 1
        }
    }
    if shapes == 0 || labels == 0 { return 4 }
    if EndFrame(session) != cast(FrameStatus)FrameOk { return 5 }
    empty: StyleRules
    InstallStyleRules(empty)
    return 0
}

main :: () -> s32 {
    if !CheckButtonLineHeight() || ButtonHostFailed() { return 96 }
    // Neutral soft/outline/ghost/link actions retain readable ink; their
    // pale filled surface is not their text color.
    for emphasis: cast(s32)1..4 {
        neutral: Button.Props
        neutral.emphasis = cast(ButtonEmphasis)emphasis
        face := Button.ButtonDefaultFace(neutral, cast(s32)ButtonState.ButtonStateNormal)
        if face.foreground != cast(u32)0x0b0b0bff { return 61 }
    }
    expected: [4]s32 = .[0, 42, 43, 44]
    index: s32 = 0
    while index < 4 {
        frame := Frame()
        if frame != expected[index] || ButtonHostFailed() ||
        ButtonFills() != index + 1 ||
        ButtonLabels() != index + 1 { return 1 }
        index += 1
    }
    if ButtonImages() != 1 { return 2 }
    if Frame() != 45 { return 30 }
    if ButtonHostFailed() { return 31 }
    if ButtonIcons() != 1 { return 32 }
    if ButtonLabels() != 4 { return 33 }

    // A button with no width measures its label plus the style's padding;
    // one with a width keeps it.
    measured: Button.Props
    measured.class_name = 9
    measured.label = "Run"
    fit: Rectangle = Button.ButtonMeasure(measured)
    if fit.width != 41.0 || fit.height <= 0.0 || ButtonHostFailed() {
        return 34
    }
    measured.bounds = Rectangle.{0.0, 0.0, 200.0, 40.0}
    fit = Button.ButtonMeasure(measured)
    if fit.width != 200.0 || fit.height != 40.0 { return 35 }
    // icon_only keeps an explicit width instead of collapsing to a square,
    // while still measuring square when width is omitted.
    icon_row := measured
    icon_row.icon_only = true
    fit = Button.ButtonMeasure(icon_row)
    if fit.width != 200.0 || fit.height != 40.0 { return 97 }
    icon_row.bounds = Rectangle.{0.0, 0.0, 0.0, 40.0}
    fit = Button.ButtonMeasure(icon_row)
    if fit.width != 40.0 || fit.height != 40.0 { return 98 }
    icon_row.bounds = Rectangle.{0.0, 0.0, 200.0, 40.0}
    icon_row.square = true
    fit = Button.ButtonMeasure(icon_row)
    if fit.width != 40.0 || fit.height != 40.0 { return 99 }
    stacked := ContentLayout(100.0, 80.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, true, 14.0)
    if stacked.icon_x != 38.0 || stacked.icon_y != 17.0 ||
    stacked.text_x != 30.0 || stacked.text_y != 49.0 ||
    stacked.text_height != 14.0 { return 36 }
    compact := ContentLayout(100.0, 40.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, true, 14.0)
    if compact.icon_size != 6.0 || compact.text_y != 20.0 { return 37 }
    measured.bounds = Rectangle.{}
    measured.image.asset_path = "badge.png"
    measured.icon_placement = cast(IconPlacement)IconPlacementAbove
    fit = Button.ButtonMeasure(measured)
    if fit.width != 41.0 || fit.height != 36.0 { return 38 }
    start := ContentLayout(200.0, 56.0, 40.0, 24.0, 8.0,
        true, false, false, 0.0, 0.0, false, 14.0,
        cast(ContentAlignment)ContentAlignmentStart, 16.0)
    if start.icon_x != 16.0 || start.text_x != 48.0 { return 39 }
    end := ContentLayout(200.0, 56.0, 40.0, 24.0, 8.0,
        true, false, true, 0.0, 0.0, false, 14.0,
        cast(ContentAlignment)ContentAlignmentEnd, 16.0)
    if end.text_x != 112.0 || end.icon_x != 160.0 { return 40 }
    // A draggable button keeps its press outside the button, and an enclosing
    // scroll cannot claim the same gesture.
    measured.key = cast(u64)88
    measured.id = 88
    measured.image = Image.Props.{}
    measured.bounds = Rectangle.{10.0, 20.0, 80.0, 30.0}
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    unused Button.Draw(TestSession(), measured)
    submitted := TreeSubmitted(TestSession(), TreeCurrentParent(TestSession()),
        measured.key, WidgetKindButton)
    if submitted != 1 || TreeSubmitted(TestSession(), 0, cast(u64)999, WidgetKindButton) != -1 {
        return 46
    }
    TreeSetDragCapture(TestSession(), submitted, true)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk { return 41 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{20.0, 30.0, true, true, false})
    if !TreePointerCapturesDrag(TestSession()) { return 42 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{140.0, 90.0, true, false, false})
    drag := TreeTakeDragAt(TestSession(), 1)
    if !drag.active || drag.x != 140.0 || drag.y != 90.0 ||
    drag.grab_x != 10.0 || drag.grab_y != 10.0 { return 43 }
    unused TreePointerUpdate(TestSession(), PointerFrame.{140.0, 90.0, false, false, true})
    drag = TreeTakeDragAt(TestSession(), 1)
    if !drag.ended || drag.active { return 44 }
    if TreeTakeActivationAt(TestSession(), 1) { return 45 }
    // A swatch paints its own colour under any theme, and only the chosen
    // one carries rings.
    ExpectSwatch()
    swatch: Button.Props
    swatch.key = cast(u64)90
    swatch.id = 90
    swatch.class_name = 9
    swatch.circle = true
    swatch.swatch = true
    swatch.swatch_color = Color.{216, 116, 164, 255}
    swatch.bounds = Rectangle.{10.0, 20.0, 40.0, 40.0}
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    unused Button.Draw(TestSession(), swatch)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || ButtonHostFailed() ||
    SwatchFills() != 1 || SwatchRings() != 0 { return 47 }
    swatch.selected = true
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 100.0, 100.0})
    unused Button.Draw(TestSession(), swatch)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || ButtonHostFailed() ||
    SwatchFills() != 2 || SwatchRings() != 2 { return 48 }
    // A detail line sits under the label in a smaller, muted font. The
    // button measures the wider line, and both lines are centred together.
    ExpectDetail()
    detail: Button.Props
    detail.class_name = 9
    detail.label = "Run"
    detail.detail = "Uses Sunup"
    sized := Button.ButtonMeasure(detail)
    if sized.width != 70.0 || sized.height != 36.0 || ButtonHostFailed() { return 49 }
    detail.key = cast(u64)91
    detail.id = 91
    detail.bounds = Rectangle.{10.0, 20.0, 200.0, 50.0}
    BeginFrame(TestSession(), cast(u64)1, Rectangle.{0.0, 0.0, 300.0, 100.0})
    unused Button.Draw(TestSession(), detail)
    if EndFrame(TestSession()) != cast(FrameStatus)FrameOk || ButtonHostFailed() { return 50 }
    if DetailProblem() != 0 { return 50 + DetailProblem() }
    placed := GridButtons()
    if placed != 0 { return 100 + placed }
    turned := TransformedButton()
    if turned != 0 { return 200 + turned }
    return 0
}
