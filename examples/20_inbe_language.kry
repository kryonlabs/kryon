#import "kryon.h"

# Inner Breeze language screen — values traced from the native app
# (INBE_TEXT_TRACE, UI scale 1.125): title "Choose Language" fs24 at
# phys (159,32); label "Language" fs16 at (45,273); dropdown; "Next"
# fs12 at (230,377). Authored in logical units (phys/1.125).

state {
    language_index: int = 0
}

app "Inner Breeze — Language" {
    size 480 640
    fps 60
    frame main
}

frame main {
    BeginDrawing()
    ClearBackground(GetThemeBackground())
    BeginUIFrame(GetScreenWidth(), GetScreenHeight(), GetUIScale())
    Background(GetThemeBackground())
    Text("Choose Language", ScaleUIPx(141), ScaleUIPx(28), UI_TEXT_24, GetThemeText())
    Text("Language", ScaleUIPx(40), ScaleUIPx(243), UI_TEXT_16, GetThemeText())
    Dropdown(260, ScaleUIPx(39), ScaleUIPx(266), ScaleUIPx(348), ScaleUIPx(43), "English;Portugues;Espanol;Deutsch;Francais", &language_index)
    Text("Next", ScaleUIPx(204), ScaleUIPx(335), UI_TEXT_12, GetThemeText())
    EndUIFocus()
    EndDrawing()
}
