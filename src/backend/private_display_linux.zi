// A private X display for window tests: its own Xvfb, apps started on it
// with the desktop session scrubbed from their environment, the windows they
// own found by process ID, and their pixels captured. Nothing here reads or
// opens the inherited DISPLAY, so a test can never touch the live desktop.
//
//     display := OpenPrivateDisplay(1000, 720, "build/my-test/xvfb.log")
//     if !display.valid { print("%\n", display.error); return 1 }
//     defer ClosePrivateDisplay(*display)
//     extra: [1]string = .["MY_APP_MODE=test"]
//     app := StartOnDisplay(*display, arguments[:], extra[:], "", "build/my-test/app.log")
//     window := FindOwnedWindow(*display, app.pid, 10000)
//     image: DisplayImage
//     if CaptureWindow(*display, window, *image) { unused SavePNG(*image, "build/my-test/title.png") }
//     unused StopOwnedProcess(*app, 5000)
//
// Link programs that use it with -lX11 -lcairo.
#import "c_string"
#import "byte_text_linux"
#import "format"
#import "environment_linux"
#import "file"
#import "timer_linux"
using Run :: #import "process_run_linux"

#scope_file
x11 :: #system_library "X11";
cairo :: #system_library "cairo";
libc :: #system_library "libc";

XErrorHandler :: #type (display: *void, event: *void) -> s32 #c_call;
XOpen :: (name: *u8) -> *void #foreign x11 "XOpenDisplay";
XClose :: (display: *void) -> s32 #foreign x11 "XCloseDisplay";
XSetErrors :: (handler: XErrorHandler) -> XErrorHandler #foreign x11 "XSetErrorHandler";
XSync :: (display: *void, discard: s32) -> s32 #foreign x11 "XSync";
XFlush :: (display: *void) -> s32 #foreign x11 "XFlush";
XRoot :: (display: *void, screen: s32) -> u64 #foreign x11 "XRootWindow";
XAtom :: (display: *void, name: *u8, existing: s32) -> u64 #foreign x11 "XInternAtom";
XProperty :: (display: *void, window: u64, property: u64, offset: s64, length: s64, remove: s32, wanted: u64,
    actual: *u64, format: *s32, count: *u64, after: *u64, data: **u8) -> s32 #foreign x11 "XGetWindowProperty";
XFree :: (data: *void) -> s32 #foreign x11 "XFree";
XTree :: (display: *void, window: u64, root: *u64, parent: *u64, children: **u64, count: *u32) -> s32 #foreign x11 "XQueryTree";
XAttributes :: (display: *void, window: u64, attributes: *XWindowAttributes) -> s32 #foreign x11 "XGetWindowAttributes";
XResize :: (display: *void, window: u64, width: u32, height: u32) -> s32 #foreign x11 "XResizeWindow";
XImageOf :: (display: *void, drawable: u64, x: s32, y: s32, width: u32, height: u32, planes: u64, format: s32) -> *XImageHead #foreign x11 "XGetImage";

CairoImage :: (format: s32, width: s32, height: s32) -> *void #foreign cairo "cairo_image_surface_create";
CairoFromPNG :: (path: *u8) -> *void #foreign cairo "cairo_image_surface_create_from_png";
CairoStatus :: (surface: *void) -> s32 #foreign cairo "cairo_surface_status";
CairoFlush :: (surface: *void) #foreign cairo "cairo_surface_flush";
CairoDirty :: (surface: *void) #foreign cairo "cairo_surface_mark_dirty";
CairoData :: (surface: *void) -> *u8 #foreign cairo "cairo_image_surface_get_data";
CairoStride :: (surface: *void) -> s32 #foreign cairo "cairo_image_surface_get_stride";
CairoWidth :: (surface: *void) -> s32 #foreign cairo "cairo_image_surface_get_width";
CairoHeight :: (surface: *void) -> s32 #foreign cairo "cairo_image_surface_get_height";
CairoFormat :: (surface: *void) -> s32 #foreign cairo "cairo_image_surface_get_format";
CairoWritePNG :: (surface: *void, path: *u8) -> s32 #foreign cairo "cairo_surface_write_to_png";
CairoDestroy :: (surface: *void) #foreign cairo "cairo_surface_destroy";

PipeRaw :: (fds: *s32, flags: s32) -> s32 #foreign libc "pipe2";
FlagsRaw :: (fd: s32, command: s32, value: s32) -> s32 #foreign libc "fcntl";
CloseRaw :: (fd: s32) -> s32 #foreign libc "close";
ReadRaw :: (fd: s32, output: *u8, count: u64) -> s64 #foreign libc "read";
PollRaw :: (fds: *PollEntry, count: u64, timeout_ms: s32) -> s32 #foreign libc "poll";
LinkRaw :: (path: *u8, output: *u8, size: u64) -> s64 #foreign libc "readlink";
RealPathRaw :: (path: *u8, output: *u8) -> *u8 #foreign libc "realpath";
AccessRaw :: (path: *u8, mode: s32) -> s32 #foreign libc "access";

PollEntry :: struct { fd: s32; events: s16; returned: s16 }

// Xlib's XWindowAttributes on 64-bit Linux, with room to spare.
XWindowAttributes :: struct {
    x: s32; y: s32; width: s32; height: s32; border_width: s32; depth: s32
    visual: *void; root: u64
    class: s32; bit_gravity: s32; win_gravity: s32; backing_store: s32
    backing_planes: u64; backing_pixel: u64
    save_under: s32; padding: s32
    colormap: u64
    map_installed: s32; map_state: s32
    all_event_masks: s64; your_event_mask: s64; do_not_propagate_mask: s64
    override_redirect: s32; padding_2: s32
    screen: *void
    spare: [8]u64
}

// The leading fields of Xlib's XImage, which XGetImage fills in.
XImageHead :: struct {
    width: s32; height: s32; xoffset: s32; format: s32
    data: *u8
    byte_order: s32; bitmap_unit: s32; bitmap_bit_order: s32; bitmap_pad: s32
    depth: s32; bytes_per_line: s32; bits_per_pixel: s32; padding: s32
    red_mask: u64; green_mask: u64; blue_mask: u64
}

// A window can vanish between listing and reading it; that is not fatal.
IgnoreXError :: (display: *void, event: *void) -> s32 { return 0 }

// The scrubbed desktop session: a test app never sees the owner's display,
// Wayland compositor, X authority, session bus or session manager.
SCRUBBED :: string.["WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "SESSION_MANAGER", "DESKTOP_AUTOSTART_ID"]

CText :: (value: string, output: []u8) -> *u8 {
    if !CopyCString(value, output) { output[0] = 0 }
    return *output[0]
}

ReadLink :: (path: string) -> string {
    name: [4096]u8
    target: [4096]u8
    count := LinkRaw(CText(path, name[:]), *target[0], 4095)
    if count <= 0 { return "" }
    copy: Vec(u8)
    for i: 0..count - 1 { VecPush(copy, target[i]) }
    return BuilderFinish(copy)
}

RealPath :: (path: string) -> string {
    name: [4096]u8
    resolved: [4096]u8
    if RealPathRaw(CText(path, name[:]), *resolved[0]) == null { return "" }
    copy: Vec(u8)
    Append(*copy, TextFromCString(*resolved[0]))
    return BuilderFinish(copy)
}

// The executable `name` names on PATH, fully resolved, or "".
FindOnPath :: (name: string) -> string {
    path := EnvironmentText("PATH")
    start: s64
    for i: 0..path.count {
        if i < path.count && path[i] != #char ":" { continue }
        if i > start {
            candidate: Vec(u8)
            BuilderPrint(*candidate, "%/%", path[start:i], name)
            full := BuilderFinish(candidate)
            bytes: [4096]u8
            if AccessRaw(CText(full, bytes[:]), 1) == 0 { return RealPath(full) }
        }
        start = i + 1
    }
    return ""
}

PidPath :: (pid: s32, name: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "/proc/%/%", pid, name)
    return BuilderFinish(path)
}

ReadProperty :: (display: *PrivateDisplay, window: u64, atom: u64, wanted: u64, output: *Vec(u8)) -> s32 {
    actual: u64; format: s32; count: u64; after: u64; data: *u8
    status := XProperty(display.connection, window, atom, 0, 4096, 0, wanted, *actual, *format, *count, *after, *data)
    defer { if data != null { unused XFree(cast(*void)data) } }
    if status != 0 || data == null || count == 0 { return 0 }
    // Format 32 properties arrive as C longs.
    size: u64 = ifx format == 32 then 8 else cast(u64)(format / 8)
    index: u64
    while index < count * size { VecPush(output.*, data[index]); index += 1 }
    return format
}

AtomNamed :: (display: *PrivateDisplay, name: string) -> u64 {
    bytes: [128]u8
    return XAtom(display.connection, CText(name, bytes[:]), 0)
}

WindowPid :: (display: *PrivateDisplay, window: u64) -> s64 {
    value: Vec(u8)
    if ReadProperty(display, window, AtomNamed(display, "_NET_WM_PID"), 6, *value) != 32 || value.count < 8 { return -1 }
    pid: s64
    for i: 0..3 { pid |= cast(s64)value[i] << cast(s64)(i * 8) }
    return pid
}

Viewable :: (display: *PrivateDisplay, window: u64) -> bool {
    attributes: XWindowAttributes
    return XAttributes(display.connection, window, *attributes) != 0 && attributes.map_state == 2
}

// The first viewable window under `parent` that `pid` owns, depth first.
SearchTree :: (display: *PrivateDisplay, parent: u64, pid: s32, depth: s32) -> u64 {
    root: u64; up: u64; children: *u64; count: u32
    if depth > 8 || XTree(display.connection, parent, *root, *up, *children, *count) == 0 { return 0 }
    defer { if children != null { unused XFree(cast(*void)children) } }
    index: u32
    while index < count {
        window := children[index]
        index += 1
        if WindowPid(display, window) == cast(s64)pid && Viewable(display, window) { return window }
        found := SearchTree(display, window, pid, depth + 1)
        if found != 0 { return found }
    }
    return 0
}

#scope_export
PrivateDisplay :: struct {
    server: ProcessRun
    number: s32
    name: string        // ":N"
    executable: string  // the resolved Xvfb this display runs
    connection: *void
    valid: bool
    error: string
}

// 0xRRGGBB pixels, row by row.
DisplayImage :: struct {
    width: s32
    height: s32
    pixels: Vec(u32)
}

// Starts a private Xvfb with a `width` x `height` screen and connects to it.
// Xvfb picks a free display itself and reports it through -displayfd; the
// server's /proc identity is checked before anything uses it.
OpenPrivateDisplay :: (width: s32, height: s32, log_path: string) -> PrivateDisplay {
    display: PrivateDisplay
    display.executable = FindOnPath("Xvfb")
    if display.executable.count == 0 { display.error = "Xvfb is not on PATH"; return display }
    fds: [2]s32
    // Close-on-exec for both ends, then only the write end is inherited.
    if PipeRaw(*fds[0], 524288) != 0 || FlagsRaw(fds[1], 2, 0) != 0 { display.error = "no pipe for -displayfd"; return display }
    descriptor: Vec(u8)
    BuilderPrint(*descriptor, "%", fds[1])
    screen: Vec(u8)
    BuilderPrint(*screen, "%x%x24", width, height)
    arguments: [9]string = .[display.executable, "-displayfd", BuilderFinish(descriptor), "-screen", "0",
        BuilderFinish(screen), "-nolisten", "tcp", "-noreset"]
    removed: [6]string = .["DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "SESSION_MANAGER", "DESKTOP_AUTOSTART_ID"]
    options: ProcessOptions = .{arguments = arguments[:], environment = removed[:], output_path = log_path,
        merge_error = true, new_session = true}
    started := StartProcess(options, *display.server)
    unused CloseRaw(fds[1])
    if !started { unused CloseRaw(fds[0]); display.error = "Xvfb did not start"; return display }
    reply: [64]u8
    used: s64
    deadline := MonotonicMilliseconds() + 30000
    while used < 63 && (used == 0 || reply[used - 1] != #char "\n") {
        remaining := deadline - MonotonicMilliseconds()
        if remaining <= 0 { break }
        entry: PollEntry = .{fd = fds[0], events = 1}
        if PollRaw(*entry, 1, cast(s32)remaining) <= 0 { continue }
        count := ReadRaw(fds[0], *reply[used], cast(u64)(63 - used))
        if count <= 0 { break }
        used += count
    }
    unused CloseRaw(fds[0])
    number: s32 = -1
    if used > 1 && reply[used - 1] == #char "\n" {
        number = 0
        for i: 0..used - 2 {
            if reply[i] < #char "0" || reply[i] > #char "9" || number > 100000 { number = -1; break }
            number = number * 10 + cast(s32)(reply[i] - #char "0")
        }
    }
    if number < 0 || PollProcess(*display.server) {
        unused StopOwnedProcess(*display.server, 2000)
        display.error = "Private Xvfb did not report its own display"
        return display
    }
    display.number = number
    name: Vec(u8)
    BuilderPrint(*name, ":%", number)
    display.name = BuilderFinish(name)
    if !PrivateDisplayOwned(*display) {
        unused StopOwnedProcess(*display.server, 2000)
        display.error = "Private X server identity mismatch"
        return display
    }
    unused XSetErrors(IgnoreXError)
    bytes: [32]u8
    display.connection = XOpen(CText(display.name, bytes[:]))
    if display.connection == null {
        unused StopOwnedProcess(*display.server, 2000)
        display.error = "Cannot connect to the private display"
        return display
    }
    display.valid = true
    return display
}

// Whether the display's server is still the Xvfb this test started: running,
// the same executable, and started with -displayfd. Check before capturing.
PrivateDisplayOwned :: (display: *PrivateDisplay) -> bool {
    if !display.server.started || PollProcess(*display.server) { return false }
    if ReadLink(PidPath(display.server.pid, "exe")) != display.executable { return false }
    command, found := ReadEntireFile(PidPath(display.server.pid, "cmdline"))
    if !found { return false }
    start: s64
    for i: 0..command.count - 1 {
        if command[i] != 0 { continue }
        if command[start:i] == "-displayfd" { return true }
        start = i + 1
    }
    return false
}

// Disconnects and stops this display's own server.
ClosePrivateDisplay :: (display: *PrivateDisplay) {
    if display.connection != null { unused XClose(display.connection); display.connection = null }
    unused StopOwnedProcess(*display.server, 5000)
    display.valid = false
}

// Environment changes for an app on this display: the desktop session
// removed, DISPLAY set to the private server, desktop recovery off, then
// `extra` ("NAME=value" sets, a bare "NAME" removes).
DisplayEnvironment :: (display: *PrivateDisplay, extra: []string, output: *Vec(string)) {
    for SCRUBBED { VecPush(output.*, it) }
    entry: Vec(u8)
    BuilderPrint(*entry, "DISPLAY=%", display.name)
    VecPush(output.*, BuilderFinish(entry))
    VecPush(output.*, "YUE_DESKTOP_RECOVERY=0")
    for extra { VecPush(output.*, it) }
}

// Starts `arguments` on the private display in its own session and process
// group, with stdout and stderr in `log_path`. `directory` empty keeps this
// process's working directory.
StartOnDisplay :: (display: *PrivateDisplay, arguments: []string, extra: []string, directory: string,
    log_path: string) -> ProcessRun {
    run: ProcessRun
    environment: Vec(string)
    DisplayEnvironment(display, extra, *environment)
    changes: []string = VecSlice(environment, 0, environment.count)
    options: ProcessOptions = .{arguments = arguments, directory = directory, environment = changes,
        output_path = log_path, merge_error = true, new_session = true}
    unused StartProcess(options, *run)
    return run
}

// Asks a process this test started, and its group, to stop; kills them
// after `grace_ms`. Only that group is signalled.
StopOwnedProcess :: (run: *ProcessRun, grace_ms: s64) -> bool {
    if !run.started || PollProcess(run) { return true }
    unused SignalProcess(run, 15, true)
    deadline := MonotonicMilliseconds() + grace_ms
    while MonotonicMilliseconds() < deadline {
        if PollProcess(run) { return true }
        unused SleepMilliseconds(10)
    }
    unused SignalProcess(run, 9, true)
    return WaitProcess(run)
}

// The first viewable window `pid` owns on this display, waiting up to
// `timeout_ms` for it to appear; 0 when none does.
FindOwnedWindow :: (display: *PrivateDisplay, pid: s32, timeout_ms: s64) -> u64 {
    if !display.valid || pid <= 0 { return 0 }
    deadline := MonotonicMilliseconds() + timeout_ms
    while true {
        unused XSync(display.connection, 0)
        window := SearchTree(display, XRoot(display.connection, 0), pid, 0)
        if window != 0 || MonotonicMilliseconds() >= deadline { return window }
        unused SleepMilliseconds(50)
    }
    return 0
}

// The window's title (_NET_WM_NAME, else WM_NAME).
WindowTitle :: (display: *PrivateDisplay, window: u64) -> string {
    title: Vec(u8)
    if ReadProperty(display, window, AtomNamed(display, "_NET_WM_NAME"), AtomNamed(display, "UTF8_STRING"), *title) != 8 {
        VecClear(title)
        unused ReadProperty(display, window, 39, 31, *title)
    }
    return BuilderFinish(title)
}

WindowSize :: (display: *PrivateDisplay, window: u64) -> (width: s32, height: s32) {
    attributes: XWindowAttributes
    if !display.valid || XAttributes(display.connection, window, *attributes) == 0 { return 0, 0 }
    return attributes.width, attributes.height
}

// Resizes a window this test owns; with no window manager it applies at once.
ResizeWindow :: (display: *PrivateDisplay, window: u64, width: s32, height: s32) -> bool {
    if !display.valid || width <= 0 || height <= 0 { return false }
    unused XResize(display.connection, window, cast(u32)width, cast(u32)height)
    return XSync(display.connection, 0) != 0
}

// Copies the window's current pixels into `image`, after checking the
// display is still this test's own server.
CaptureWindow :: (display: *PrivateDisplay, window: u64, image: *DisplayImage) -> bool {
    if !display.valid || window == 0 || !PrivateDisplayOwned(display) { return false }
    width, height := WindowSize(display, window)
    if width <= 0 || height <= 0 { return false }
    pixels := XImageOf(display.connection, window, 0, 0, cast(u32)width, cast(u32)height, 0xffffffffffffffff, 2)
    if pixels == null { return false }
    defer { unused XFree(cast(*void)pixels.data); unused XFree(cast(*void)pixels) }
    if pixels.bits_per_pixel != 32 || pixels.red_mask != 0xff0000 || pixels.green_mask != 0xff00 ||
        pixels.blue_mask != 0xff || pixels.byte_order != 0 { return false }
    image.width = width
    image.height = height
    VecClear(image.pixels)
    y: s32
    while y < height {
        row := cast(*u32)*pixels.data[cast(s64)y * cast(s64)pixels.bytes_per_line]
        x: s32
        while x < width { VecPush(image.pixels, row[x] & 0xffffff); x += 1 }
        y += 1
    }
    return true
}

// The pixel at (x, y) as 0xRRGGBB, or 0 outside the image.
ImagePixel :: (image: *DisplayImage, x: s32, y: s32) -> u32 {
    if x < 0 || y < 0 || x >= image.width || y >= image.height { return 0 }
    return image.pixels[cast(s64)y * cast(s64)image.width + cast(s64)x]
}

PixelRed :: (pixel: u32) -> s32 { return cast(s32)((pixel >> 16) & 255) }
PixelGreen :: (pixel: u32) -> s32 { return cast(s32)((pixel >> 8) & 255) }
PixelBlue :: (pixel: u32) -> s32 { return cast(s32)(pixel & 255) }

// Copies the part of `image` from (x, y), `width` x `height`, that lies
// inside it into `output`.
ImageRegion :: (image: *DisplayImage, x: s32, y: s32, width: s32, height: s32, output: *DisplayImage) {
    left := ifx x < 0 then 0 else x
    top := ifx y < 0 then 0 else y
    right := ifx x + width > image.width then image.width else x + width
    bottom := ifx y + height > image.height then image.height else y + height
    VecClear(output.pixels)
    output.width = ifx right > left then right - left else 0
    output.height = ifx bottom > top then bottom - top else 0
    if output.width == 0 || output.height == 0 { output.width = 0; output.height = 0; return }
    for row: top..bottom - 1 {
        for column: left..right - 1 { VecPush(output.pixels, ImagePixel(image, column, row)) }
    }
}

// How many different colours the image holds.
ImageColorCount :: (image: *DisplayImage) -> s64 {
    seen: Vec(u8)
    for i: 0..2097151 { VecPush(seen, cast(u8)0) }
    count: s64
    for i: 0..image.pixels.count - 1 {
        pixel := image.pixels[i] & 0xffffff
        bit := cast(u8)(1 << cast(u8)(pixel & 7))
        if (seen[pixel >> 3] & bit) == 0 { seen[pixel >> 3] |= bit; count += 1 }
    }
    return count
}

SavePNG :: (image: *DisplayImage, path: string) -> bool {
    if image.width <= 0 || image.height <= 0 { return false }
    surface := CairoImage(1, image.width, image.height)
    if surface == null { return false }
    defer CairoDestroy(surface)
    if CairoStatus(surface) != 0 { return false }
    CairoFlush(surface)
    data := CairoData(surface)
    stride := cast(s64)CairoStride(surface)
    y: s32
    while y < image.height {
        row := cast(*u32)*data[cast(s64)y * stride]
        x: s32
        while x < image.width { row[x] = ImagePixel(image, x, y); x += 1 }
        y += 1
    }
    CairoDirty(surface)
    bytes: [4096]u8
    return CairoWritePNG(surface, CText(path, bytes[:])) == 0
}

// Reads an opaque PNG into `image`.
LoadPNG :: (path: string, image: *DisplayImage) -> bool {
    bytes: [4096]u8
    surface := CairoFromPNG(CText(path, bytes[:]))
    if surface == null { return false }
    defer CairoDestroy(surface)
    if CairoStatus(surface) != 0 { return false }
    format := CairoFormat(surface)
    if format != 0 && format != 1 { return false }
    CairoFlush(surface)
    image.width = CairoWidth(surface)
    image.height = CairoHeight(surface)
    data := CairoData(surface)
    stride := cast(s64)CairoStride(surface)
    VecClear(image.pixels)
    y: s32
    while y < image.height {
        row := cast(*u32)*data[cast(s64)y * stride]
        x: s32
        while x < image.width { VecPush(image.pixels, row[x] & 0xffffff); x += 1 }
        y += 1
    }
    return true
}
