#import "geometry"
#import "scroll"

# Device observations and drag ownership are supplied by the platform.
# The caller retains grab and ownership from the returned frame.
ScrollInput :: struct {
    enabled: bool
    pointer_allowed: bool
    disabled: bool
    mouse: Vector2
    pressed: bool
    down: bool
    released: bool
    wheel: float32
    owns_drag: bool
    owner_captured: bool
    grab: float32
}

ScrollProps :: struct {
    key: u64
    class_name: s32
    scale: float32
    bounds: Rectangle
    content_height: s32
    scroll_offset: s32
    scroll_delta: s32
    input: ScrollInput
    metrics: ScrollMetrics
}

ScrollResult :: struct {
    node: s32
    opened: bool
    viewport: Rectangle
    content: Rectangle
    scroll_offset: s32
    max_scroll: s32
    frame: ScrollFrame
}
