#module "navigation_bar_props"
#import "kryon_compat.generated.h"

NavigationBarItem :: struct {
    route: i32
    label: const char*
    icon: Texture2D
    icon_type: i32
    active: bool
    disabled: bool
}

NavigationBarProps :: struct {
    view_width: i32
    view_height: i32
    class_name: i32
    count: i32
    items: const NavigationBarItem*
    height: i32
    icon_size: i32
    icon_padding: i32
    side_margin: i32
    bottom_margin: i32
    max_button_width: i32
    icon_color: Color
}

NavigationBarResult :: struct {
    clicked_index: i32
    clicked_route: i32
    y: i32
    height: i32
}
