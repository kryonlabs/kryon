#module "input_props"
#import "kryon_compat.generated.h"

NumericValueKind :: enum {
    NumericFloat = 0
    NumericInt = 1
    NumericDouble = 2
}

# A host reports one control's pointer/focus sample; widgets decide its meaning.
Activation :: struct {
    activated: bool
    pressed: bool
    hovered: bool
    focused: bool
}

InputProps :: struct {
    bounds: Rectangle
    id: i32
    label: const char*
    kind: NumericValueKind
    float_values: *float
    int_values: *i32
    double_values: *double
    value_count: i32
    step: double
    step_fast: double
    format: const char*
    disabled: bool
}
