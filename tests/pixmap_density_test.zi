using Pixels :: #import "pixmap";
Cells :: #import "pixmap_cell_text";
#import "geometry"
#import "drawing_props"
first: [262144]u32;
second: [262144]u32;
image: [4]u32 = .{0xffff0000, 0xff00ff00, 0xff0000ff, 0xffffffff};
white :: Color.{255, 255, 255, 255};
Draw :: (scale: float32, physical: bool) {
    factor := ifx physical then scale else 1.0
    unused PixmapScale(ifx physical then 1.0 else scale, ifx physical then 1.0 else scale)
    font := ifx physical then PixmapRound(16.0 * scale) else 16
    RasterText("Device pixels café", PixmapRound(8.0 * factor), PixmapRound(8.0 * factor), font, white)
    RasterTextClipped("Clipped outline", PixmapRound(8.0 * factor), PixmapRound(40.0 * factor), font, white,
        .{8.0 * factor, 40.0 * factor, 56.0 * factor, 16.0 * factor})
    RasterRoundedRectangle(.{8.0 * factor, 62.0 * factor, 36.0 * factor, 20.0 * factor}, 4.0 * factor, 8, white)
    RasterRoundedRectangleOutline(.{54.0 * factor, 62.0 * factor, 36.0 * factor, 20.0 * factor}, 4.0 * factor, 8, 2.0 * factor, white)
    RasterLine(.{8.0 * factor, 90.0 * factor, 40.0 * factor, 4.0 * factor}, white)
    RasterImage("density-fixture", cast(u32)0, .{0.0, 0.0, 2.0, 2.0},
        .{100.0 * factor, 40.0 * factor, 20.0 * factor, 20.0 * factor},
        .{100.0 * factor, 40.0 * factor, 20.0 * factor, 20.0 * factor}, .{}, 0.0, 2.0 * factor, white)
    RasterImage("missing", cast(u32)0, .{}, .{100.0 * factor, 70.0 * factor, 20.0 * factor, 20.0 * factor},
        .{104.0 * factor, 70.0 * factor, 10.0 * factor, 20.0 * factor}, .{}, 0.0, 0.0, white)
    Cells.RasterTextCell("M", .{130.0 * factor, 40.0 * factor, 12.0 * factor, 20.0 * factor}, font, white,
        .{130.0 * factor, 40.0 * factor, 12.0 * factor, 20.0 * factor})
}
main :: () -> s32 {
    unused PixmapSetImage(0, "density-fixture", 2, 2, image[:])
    logical_width := MeasureGlyphWidth("Device pixels café", 16, "")
    for index: 0..cast(s32)3 {
        scale := 1.0 + cast(float32)index * 0.75
        width := PixmapRound(160.0 * scale); height := PixmapRound(120.0 * scale)
        unused PixmapBeginInto(cast(u32)0, width, height, first[:]); Draw(scale, false); PixmapEndInto()
        unused PixmapBeginInto(cast(u32)0, width, height, second[:]); Draw(scale, true); PixmapEndInto()
        // Missing-image checkerboard tiles remain native pixels. Compare the
        // text, cell, shape and real-image area, with clipping tested separately.
        for y: 0..height - 1 { for x: 0..width - 1 {
            if x >= PixmapRound(100.0 * scale) && x < PixmapRound(120.0 * scale) && y >= PixmapRound(70.0 * scale) { continue }
            if first[y * width + x] != second[y * width + x] { print("Density mismatch % at %, %\n", index, x, y); return 1 }
        } }
        if MeasureGlyphWidth("Device pixels café", 16, "") != logical_width { return 2 }
        if pixmap_scale_x != 1.0 || pixmap_scale_y != 1.0 { return 3 }
    }
    if PixmapScale(0.0, 2.0) || PixmapScale(9.0, 1.0) { return 4 }
    print("Device-density rasterization passed\n"); return 0
}
