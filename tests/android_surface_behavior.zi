#import, file "../src/backend/android_surface.zi";
#import, file "android_viewport_policy.zi";
#import "android_jni"
Native :: #import, file "../src/backend/android_native.zi";

native_width: s32 = 1080;
native_height: s32 = 1920;
pixels: [48]u32;
worker: bool;

#program_export
ANativeWindow_getWidth :: (window: *void) -> s32 { unused window; return native_width }
#program_export
ANativeWindow_getHeight :: (window: *void) -> s32 { unused window; return native_height }
OnWorker :: () -> bool { return worker }

#program_export
main :: () -> s32 {
    if PolicyCheck() != 42 { return 20 }
    width: s32; height: s32
    if GetAndroidSurfaceSize(*width, *height) != 0 || width != 0 || height != 0 { return 21 }
    app: NativeAndroidApp
    app.window = cast(*void)*app
    Native.android_native_app = *app
    insets: AndroidWindowInsets
    if GetAndroidWindowInsets(*insets) != 0 { return 22 }
    SetAndroidWindowInsets(-1, 53, 84, 24, 120, 4, 60, 80, 8)
    if GetAndroidWindowInsets(*insets) != 1 || insets.system_left != 0 { return 23 }
    viewport: AndroidViewport
    if SyncAndroidViewport(*viewport) != 1 || viewport.x != 4 || viewport.y != 60 ||
        viewport.width != 992 || viewport.height != 1836 { return 24 }
    if GetAndroidSurfaceSize(*width, *height) != 1 || width != 1080 || height != 1920 { return 25 }
    transform: AndroidSurfaceTransform
    if !ReadAndroidSurfaceTransform(*transform) || transform.screen_width != 1080 ||
        transform.screen_height != 1920 || transform.render_width != 1080 ||
        transform.render_height != 1920 || transform.offset_x != 0 || transform.offset_y != 0 ||
        transform.scale_x != 1.0 || transform.scale_y != 1.0 ||
        transform.projection_x != 1.0 || transform.projection_y != 1.0 { return 26 }
    if ReadAndroidSurfaceTransform(null) { return 27 }
    native_width = 1920; native_height = 1080
    if SyncAndroidViewport(*viewport) != 1 || viewport.width != 1832 || viewport.height != 996 { return 28 }
    SetAndroidViewportPolicy(AndroidViewportPolicy.{})
    if SyncAndroidViewport(*viewport) != 1 || viewport.width != 1920 ||
        viewport.height != 1080 || viewport.x != 0 { return 29 }
    native_width = 700; native_height = 0
    if SyncAndroidSurfaceSize(*width, *height) != 0 || width != 1920 || height != 1080 { return 30 }
    native_width = 1116; native_height = 1956
    SetAndroidViewportPolicy(AndroidViewportPolicySafeArea())
    SetAndroidWindowSize(1080, 1920)
    if SyncAndroidViewport(*viewport) != 1 || viewport.x != 22 || viewport.y != 78 ||
        viewport.width != 992 || viewport.height != 1836 { return 31 }
    margin := GetAndroidSurfaceMargin(1116, 1956)
    if margin.left != 18 || margin.top != 18 { return 32 }
    SetAndroidWindowSize(1116, 1956)
    if SyncAndroidViewport(*viewport) != 1 || viewport.x != 4 || viewport.y != 60 { return 33 }
    // Worker-side reads retain the synchronized surface without touching a new native size.
    android_surface_worker = OnWorker
    worker = true; native_width = 8; native_height = 6
    if SyncAndroidSurfaceSize(*width, *height) != 1 || width != 1116 || height != 1956 { return 34 }
    worker = false
    if SyncAndroidSurfaceSize(*width, *height) != 1 || width != 8 || height != 6 { return 35 }
    // Actual native pixel storage: logical viewport bounds scale, clamp, and leave black bars.
    Native.android_pixels = pixels[:]
    viewport = AndroidViewport.{.x = 1, .y = 1, .width = 2, .height = 1}
    ClearAndroidFrame(viewport, cast(u32)0xffe2eefc, 2.0)
    for y: 0..5 {
        for x: 0..7 {
            expected: u32 = cast(u32)0xff000000
            if x >= 2 && x < 6 && y >= 2 && y < 4 { expected = cast(u32)0xffe2eefc }
            if pixels[y * 8 + x] != expected { return 36 }
        }
    }
    viewport = AndroidViewport.{.x = -2, .y = -1, .width = 20, .height = 20}
    ClearAndroidFrame(viewport, cast(u32)0xff182838)
    for index: 0..47 { if pixels[index] != cast(u32)0xff182838 { return 37 } }
    Native.android_pixels = pixels[0:1]
    pixels[0] = 42
    ClearAndroidFrame(viewport, cast(u32)0xffffffff)
    if pixels[0] != 42 { return 38 }
    Native.android_native_app = null
    if ReadAndroidSurfaceTransform(*transform) { return 39 }
    return 0
}
