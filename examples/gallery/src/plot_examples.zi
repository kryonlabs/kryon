Styles :: #import "kryon/examples/optional_scene_styles";

InstallStyles :: (dark: bool) {
    Styles.InstallPlotStyles(dark)
}

SceneName :: (index: s32) -> string {
    if index == 0 { return "Plot · lines" }
    if index == 1 { return "Plot · bars" }
    if index == 2 { return "LineChart" }
    if index == 3 { return "LineChartCompare" }
    if index == 4 { return "CandleChart" }
    if index == 5 { return "BandChart" }
    return ""
}
