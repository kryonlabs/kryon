#import "drawing_props"
#import "geometry"

PageProps :: struct {
    bounds: Rectangle
    title: string
    description: string
    canonical_url: string
    class_name: s32
    key: u64
}

SectionProps :: struct {
    bounds: Rectangle
    label: string
    class_name: s32
    key: u64
}

HeadingProps :: struct {
    bounds: Rectangle
    text: string
    level: s32
    class_name: s32
    key: u64
}

ParagraphTextProps :: struct {
    bounds: Rectangle
    text: string
    class_name: s32
    key: u64
}

PageSpacing :: struct {
    gap: s32
    padding: s32
}

// Page metadata is an effect request. The platform may apply it to a browser
// document, desktop window, exported document, or ignore it entirely.
PageResult :: struct {
    node: s32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
    title: string
    description: string
    canonical_url: string
    theme_color: Color
    has_theme_color: bool
}

SectionResult :: struct {
    node: s32
    opened: bool
    bounds: Rectangle
    content: Rectangle
    gap: s32
    padding: s32
}
