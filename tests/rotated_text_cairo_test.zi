#import "cairo_raster"
#import "geometry"
#import "drawing_props"

Coverage :: (angle: float32) -> Rectangle {
    BeginRasterFrame()
    RasterTextRotated("Diagonal",60,100,32,Color.{0,0,0,255},Rectangle.{60.0,100.0,140.0,32.0},
        Vector2.{130.0,116.0},angle,Rectangle.{},false,false,false)
    if !FinishRasterFrame() { return Rectangle.{} }
    pixels := RasterSurfaceData(); stride := RasterSurfaceStride()
    left: s32=256;right: s32;top: s32=256;bottom: s32;count: s32
    for y: 0..255 { for x: 0..255 {
        if pixels[y*stride+x*4] < cast(u8)128 {
            count+=1
            if x<left { left=cast(s32)x };if x>right { right=cast(s32)x }
            if y<top { top=cast(s32)y };if y>bottom { bottom=cast(s32)y }
        }
    } }
    if count<100 { return Rectangle.{} }
    return .{cast(float32)left,cast(float32)top,cast(float32)(right-left+1),cast(float32)(bottom-top+1)}
}
#program_export
main :: () -> s32 {
    if !OpenRaster(256,256) { return 1 }
    defer CloseRaster()
    horizontal:=Coverage(0.0);vertical:=Coverage(90.0);angled:=Coverage(-27.0)
    if horizontal.width<80.0 || horizontal.height>32.0 || vertical.height<80.0 || vertical.width>32.0 || angled.height<45.0 { return 2 }
    return 0
}
