#import "ziran_mesh_noop_host"
#import "drawing_props"
#import "geometry"

ThemeRasterSample :: struct {
    fill_count: s32
    outline_count: s32
    text_count: s32
    fill_color: Color
    outline_color: Color
    text_color: Color
    fill_bounds: Rectangle
    outline_bounds: Rectangle
    radius: float32
    font: s32
    failed: bool
}

sample: ThemeRasterSample;

#program_export
MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 {
    unused typeface
    if value != "Run" || font <= 0 { sample.failed = true }
    return 30
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    unused typeface
    if font <= 0 { sample.failed = true }
    return font
}

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32,
    color: Color) {
    unused value; unused x; unused y; unused font; unused color
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32,
    color: Color, clip: Rectangle) {
    unused x; unused y; unused clip
    if value != "Run" { sample.failed = true }
    sample.text_count += 1; sample.text_color = color; sample.font = font
}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    unused segments
    sample.fill_count += 1; sample.fill_bounds = bounds
    sample.radius = radius; sample.fill_color = color
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    unused radius; unused segments; unused width
    sample.outline_count += 1; sample.outline_bounds = bounds
    sample.outline_color = color
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    unused asset_path
    return 0
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    unused asset_path
    return 0
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    unused line; unused color
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) {
    unused asset_path; unused texture_id; unused source; unused destination
    unused clip; unused origin; unused rotation; unused radius; unused tint
}

#program_export
ButtonThemeRasterReset :: () -> ThemeRasterSample {
    sample = ThemeRasterSample.{}
    return sample
}

#program_export
ButtonThemeRasterSample :: () -> ThemeRasterSample { return sample }

#program_export
ButtonThemeRasterFailed :: () -> bool { return sample.failed }
