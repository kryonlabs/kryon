#import "drawing_props"
#import "geometry"
#import "paint_texture"
#import "raster"
#import "raster_shape"
#import "raster_text"
#import "session"
#import "tree"
#import "vec"
host_api :: #system_library "host_api";

PaintKind :: enum {
    PaintKindLine :: 1
    PaintKindRoundedFill :: 2
    PaintKindRoundedOutline :: 3
    PaintKindText :: 4
    PaintKindImage :: 5
    PaintKindClippedText :: 6
    PaintKindVerticalGradient :: 7
}
using PaintKind;


PaintCommand :: struct {
    node: s32
    kind: s32
    bounds: Rectangle
    color: Color
    end_color: Color
    radius: float32
    segments: s32
    line_width: float32
    value: string
    x: s32
    y: s32
    font: s32
    asset_path: string
    texture_id: u32
    texture: Texture2D
    source: Rectangle
    clip: Rectangle
    origin: Vector2
    rotation: float32
    // Queued text is copied into the session's frame text so a caller may
    // pass a label formatted into its own short-lived buffer.
    text_start: s64
    text_count: s64
    owns_text: bool
}

PaintEmitter :: #type (command: PaintCommand) -> ();
PaintClipper :: #type (command: PaintCommand,
    geometry: NodeGeometry) -> PaintCommand;

QueuedPaint :: struct {
    data: PaintCommand
    emit: PaintEmitter
    clip_for: PaintClipper
    has_emitter: bool
    clips: bool
}

PaintCommands :: struct {
    items: Vec(QueuedPaint)
    overflow: bool
}

pending_paint: [9]PaintCommands;
PAINT_TEXT_CAPACITY :: 32768
pending_text: [9][PAINT_TEXT_CAPACITY]u8;
pending_text_count: [9]s64;

// The previous committed paint plan is retained by value. Strings and asset
// paths are copied byte-for-byte so equality does not depend on borrowed
// pointers or addresses.
PaintSnapshot :: struct {
    data: PaintCommand
    value_start: s64
    value_count: s64
    asset_start: s64
    asset_count: s64
}

paint_snapshots: [9]Vec(PaintSnapshot);
paint_snapshot_values: [9][PAINT_TEXT_CAPACITY]u8;
paint_snapshot_assets: [9][PAINT_TEXT_CAPACITY]u8;
paint_snapshot_value_counts: [9]s64;
paint_snapshot_asset_counts: [9]s64;
paint_snapshots_valid: [9]bool;
frame_paint_unchanged: [9]bool;

// Copies a queued command's text into the session's frame text. Text that
// does not fit keeps the caller's view, which must then outlive the flush.
KeepPaintText :: (slot: s32, data: PaintCommand) -> PaintCommand {
    if data.value.count == 0 { return data }
    start: s64 = pending_text_count[slot]
    if start + cast(s64)data.value.count > cast(s64)PAINT_TEXT_CAPACITY {
        return data
    }
    at: s64 = 0
    while at < cast(s64)data.value.count {
        pending_text[slot][start + at] = data.value[at]
        at += 1
    }
    pending_text_count[slot] = start + at
    data.text_start = start
    data.text_count = cast(s64)data.value.count
    data.owns_text = true
    return data
}

// Raw rasterization; the queued source, clip, radius, and tint are chosen in
// checked widget code before this device effect is called.
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color) #foreign host_api;

#program_export
EmitPaint :: (command: QueuedPaint) {
    if command.has_emitter {
        emit: PaintEmitter = command.emit
        emit(command.data)
    }
}

EmitLine :: (command: PaintCommand) {
    StrokeLine(command.bounds, command.color)
}

EmitRoundedFill :: (command: PaintCommand) {
    FillRoundedRectangle(command.bounds, command.radius,
        command.segments, command.color)
}

GradientChannel :: (first: u8, second: u8, amount: float32) -> u8 {
    value: float32 = cast(float32)first +
        (cast(float32)second - cast(float32)first) * amount + 0.5
    if value <= 0.0 { return cast(u8)0 }
    if value >= 255.0 { return cast(u8)255 }
    return cast(u8)value
}

#program_export
GradientColorAt :: (first: Color, second: Color, amount: float32) -> Color {
    if amount < 0.0 { amount = 0.0 }
    if amount > 1.0 { amount = 1.0 }
    return Color.{GradientChannel(first.r, second.r, amount),
        GradientChannel(first.g, second.g, amount),
        GradientChannel(first.b, second.b, amount),
        GradientChannel(first.a, second.a, amount)}
}

// Backends rasterize only flat rectangles, so a gradient is drawn as one-pixel
// rows sampled at their centers.
EmitVerticalGradient :: (command: PaintCommand) {
    bounds: Rectangle = command.bounds
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    bottom: float32 = bounds.y + bounds.height
    top: float32 = bounds.y
    while top < bottom {
        height: float32 = 1.0
        if top + height > bottom { height = bottom - top }
        amount: float32 = (top + height * 0.5 - bounds.y) / bounds.height
        FillRoundedRectangle(Rectangle.{bounds.x, top, bounds.width, height},
            0.0, 0, GradientColorAt(command.color, command.end_color, amount))
        top += height
    }
}

EmitRoundedOutline :: (command: PaintCommand) {
    StrokeRoundedRectangle(command.bounds, command.radius,
        command.segments, command.line_width, command.color)
}

EmitLabel :: (command: PaintCommand) {
    if command.kind == PaintKindClippedText {
        PaintTextClipped(command.value, command.x, command.y,
            command.font, command.color, command.clip)
    } else {
        PaintText(command.value, command.x, command.y,
            command.font, command.color)
    }
}

EmitImage :: (command: PaintCommand) {
    if command.clip.width > 0.0 && command.clip.height > 0.0 {
        emitting_texture = command.texture
        RasterImage(command.asset_path, command.texture_id,
            command.source, command.bounds, command.clip,
            command.origin, command.rotation, command.radius,
            command.color)
        emitting_texture.id = cast(u32)0
    }
}

ClipLabel :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    if command.kind == PaintKindText {
        command.kind = PaintKindClippedText
        command.clip = geometry.clip
    } else {
        command.clip = RectangleIntersection(command.clip, geometry.clip)
    }
    return command
}

ClipImage :: (command: PaintCommand, geometry: NodeGeometry) -> PaintCommand {
    command.clip = RectangleIntersection(command.clip, geometry.clip)
    return command
}

#program_export
SubmitPaint :: (session: Session, command: QueuedPaint) {
    if command.data.node < 0 && !TreeIsBuilding(session) {
        EmitPaint(command)
        return
    }
    if command.data.node < 0 && TreeIsBuilding(session) &&
        command.clips {
        scope: NodeGeometry = TreeCurrentPaintGeometry(session)
        if scope.clipped {
            clip_for: PaintClipper = command.clip_for
            command.data = clip_for(command.data, scope)
        }
    }
    if command.data.node >= 0 && TreeIsBuilding(session) {
        geometry: NodeGeometry = TreeSubmittedGeometryAt(session,
            command.data.node)
        dx: float32 = geometry.bounds.x - geometry.measured_bounds.x
        dy: float32 = geometry.bounds.y - geometry.measured_bounds.y
        full_bounds: bool = command.data.bounds.x == geometry.measured_bounds.x &&
            command.data.bounds.y == geometry.measured_bounds.y &&
            command.data.bounds.width == geometry.measured_bounds.width &&
            command.data.bounds.height == geometry.measured_bounds.height
        full_clip: bool = command.data.clip.x == geometry.measured_bounds.x &&
            command.data.clip.y == geometry.measured_bounds.y &&
            command.data.clip.width == geometry.measured_bounds.width &&
            command.data.clip.height == geometry.measured_bounds.height
        command.data.bounds.x += dx
        command.data.bounds.y += dy
        command.data.clip.x += dx
        command.data.clip.y += dy
        command.data.x += cast(s32)dx
        command.data.y += cast(s32)dy
        if full_bounds {
            command.data.bounds.width = geometry.bounds.width
            command.data.bounds.height = geometry.bounds.height
        }
        if full_clip {
            command.data.clip.width = geometry.bounds.width
            command.data.clip.height = geometry.bounds.height
        }
        if geometry.clipped && command.clips {
            clip_for: PaintClipper = command.clip_for
            command.data = clip_for(command.data, geometry)
        }
    }
    command.data = KeepPaintText(SessionIndex(session), command.data)
    if !VecPush(pending_paint[SessionIndex(session)].items, command) {
        pending_paint[SessionIndex(session)].overflow = true
    }
}

#program_export
PaintLine :: (session: Session, node: s32, bounds: Rectangle,
    color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindLine
    command.data.node = node
    command.data.bounds = bounds
    command.data.color = color
    emit: PaintEmitter = EmitLine
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

// Corner radius that turns bounds into a pill, or a circle when square.
// Rounded paints take the radius in pixels.
#program_export
PillRadius :: (bounds: Rectangle) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 { return 0.0 }
    return edge * 0.5
}

#program_export
PaintRoundedFill :: (session: Session, node: s32, bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindRoundedFill
    command.data.node = node
    command.data.bounds = bounds
    command.data.radius = radius
    command.data.segments = segments
    command.data.color = color
    emit: PaintEmitter = EmitRoundedFill
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

// Queued with the other paint so it lands above images submitted earlier in
// the same frame.
#program_export
PaintVerticalGradient :: (session: Session, node: s32, bounds: Rectangle,
    top: Color, bottom: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindVerticalGradient
    command.data.node = node
    command.data.bounds = bounds
    command.data.color = top
    command.data.end_color = bottom
    emit: PaintEmitter = EmitVerticalGradient
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

#program_export
PaintRoundedOutline :: (session: Session, node: s32, bounds: Rectangle, radius: float32,
    segments: s32, line_width: float32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindRoundedOutline
    command.data.node = node
    command.data.bounds = bounds
    command.data.radius = radius
    command.data.segments = segments
    command.data.line_width = line_width
    command.data.color = color
    emit: PaintEmitter = EmitRoundedOutline
    command.emit = emit
    command.has_emitter = true
    SubmitPaint(session, command)
}

#program_export
PaintLabel :: (session: Session, node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color) {
    command: QueuedPaint
    command.data.kind = PaintKindText
    command.data.node = node
    command.data.value = value
    command.data.x = x
    command.data.y = y
    command.data.font = font
    command.data.color = color
    emit: PaintEmitter = EmitLabel
    clip_for: PaintClipper = ClipLabel
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintClippedLabel :: (session: Session, node: s32, value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    command: QueuedPaint
    command.data.kind = PaintKindClippedText
    command.data.node = node
    command.data.value = value
    command.data.x = x
    command.data.y = y
    command.data.font = font
    command.data.color = color
    command.data.clip = clip
    emit: PaintEmitter = EmitLabel
    clip_for: PaintClipper = ClipLabel
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintImage :: (session: Session, node: s32, asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32,
    tint: Color, texture: Texture2D = Texture2D.{0, 0, 0, 0, 0}) {
    command: QueuedPaint
    command.data.kind = PaintKindImage
    command.data.node = node
    command.data.asset_path = asset_path
    command.data.texture_id = texture_id
    command.data.texture = texture
    command.data.source = source
    command.data.bounds = destination
    command.data.clip = clip
    command.data.origin = origin
    command.data.rotation = rotation
    command.data.radius = radius
    command.data.color = tint
    emit: PaintEmitter = EmitImage
    clip_for: PaintClipper = ClipImage
    command.emit = emit
    command.clip_for = clip_for
    command.has_emitter = true
    command.clips = true
    SubmitPaint(session, command)
}

#program_export
PaintClear :: (session: Session) {
    VecClear(pending_paint[SessionIndex(session)].items)
    pending_text_count[SessionIndex(session)] = 0
    pending_paint[SessionIndex(session)].overflow = false
}

#program_export
PaintOverflow :: (session: Session) -> bool {
    return pending_paint[SessionIndex(session)].overflow
}

// The pending commands are inspectable after the tree commits and before
// PaintFlush clears them. A failed commit clears the queue instead.
#program_export
PendingPaintCount :: (session: Session) -> s32 {
    return cast(s32)pending_paint[SessionIndex(session)].items.count
}

#program_export
PendingPaintAt :: (session: Session, index: s32) -> PaintCommand {
    empty: PaintCommand
    if index < 0 || cast(s64)index >= pending_paint[SessionIndex(session)].items.count { return empty }
    data: PaintCommand = pending_paint[SessionIndex(session)].items[index].data
    if data.owns_text {
        slot: s32 = SessionIndex(session)
        data.value = TextView(pending_text[slot][data.text_start:
            data.text_start + data.text_count])
    }
    return data
}

SnapshotTextAppend :: (slot: s32, values: bool, value: string) -> s64 {
    if value.count == 0 { return 0 }
    if cast(s64)value.count > cast(s64)PAINT_TEXT_CAPACITY { return -1 }
    start: s64
    if values {
        start = paint_snapshot_value_counts[slot]
        if start + cast(s64)value.count > cast(s64)PAINT_TEXT_CAPACITY { return -1 }
        at: s64 = 0
        while at < cast(s64)value.count {
            paint_snapshot_values[slot][start + at] = value[at]
            at += 1
        }
        paint_snapshot_value_counts[slot] = start + at
        return start
    }
    start = paint_snapshot_asset_counts[slot]
    if start + cast(s64)value.count > cast(s64)PAINT_TEXT_CAPACITY { return -1 }
    at: s64 = 0
    while at < cast(s64)value.count {
        paint_snapshot_assets[slot][start + at] = value[at]
        at += 1
    }
    paint_snapshot_asset_counts[slot] = start + at
    return start
}

SnapshotValueEqual :: (slot: s32, value: string, start: s64, count: s64) -> bool {
    if cast(s64)value.count != count { return false }
    at: s64 = 0
    while at < count {
        if value[at] != paint_snapshot_values[slot][start + at] { return false }
        at += 1
    }
    return true
}

SnapshotAssetEqual :: (slot: s32, value: string, start: s64, count: s64) -> bool {
    if cast(s64)value.count != count { return false }
    at: s64 = 0
    while at < count {
        if value[at] != paint_snapshot_assets[slot][start + at] { return false }
        at += 1
    }
    return true
}

TextureEqual :: (left: Texture2D, right: Texture2D) -> bool {
    return left.id == right.id && left.width == right.width &&
    left.height == right.height && left.mipmaps == right.mipmaps &&
    left.format == right.format
}

PaintCommandEqual :: (slot: s32, current: PaintCommand,
    previous: PaintSnapshot) -> bool {
    if slot <= 0 || slot >= 9 { return false }
    if current.node != previous.data.node || current.kind != previous.data.kind { return false }
    if current.bounds.x != previous.data.bounds.x ||
    current.bounds.y != previous.data.bounds.y ||
    current.bounds.width != previous.data.bounds.width ||
    current.bounds.height != previous.data.bounds.height { return false }
    if current.color.r != previous.data.color.r ||
    current.color.g != previous.data.color.g ||
    current.color.b != previous.data.color.b ||
    current.color.a != previous.data.color.a { return false }
    if current.end_color.r != previous.data.end_color.r ||
    current.end_color.g != previous.data.end_color.g ||
    current.end_color.b != previous.data.end_color.b ||
    current.end_color.a != previous.data.end_color.a { return false }
    if current.radius != previous.data.radius ||
    current.segments != previous.data.segments ||
    current.line_width != previous.data.line_width { return false }
    if !SnapshotValueEqual(slot, current.value, previous.value_start,
        previous.value_count) { return false }
    if current.x != previous.data.x || current.y != previous.data.y ||
    current.font != previous.data.font { return false }
    if !SnapshotAssetEqual(slot, current.asset_path, previous.asset_start,
        previous.asset_count) { return false }
    if current.texture_id != previous.data.texture_id ||
    !TextureEqual(current.texture, previous.data.texture) { return false }
    if current.source.x != previous.data.source.x ||
    current.source.y != previous.data.source.y ||
    current.source.width != previous.data.source.width ||
    current.source.height != previous.data.source.height { return false }
    if current.clip.x != previous.data.clip.x ||
    current.clip.y != previous.data.clip.y ||
    current.clip.width != previous.data.clip.width ||
    current.clip.height != previous.data.clip.height { return false }
    if current.origin.x != previous.data.origin.x ||
    current.origin.y != previous.data.origin.y ||
    current.rotation != previous.data.rotation { return false }
    return true
}

PaintSnapshotInvalidate :: (session: Session) {
    if !SessionValid(session) { return }
    slot: s32 = SessionIndex(session)
    VecClear(paint_snapshots[slot])
    paint_snapshot_value_counts[slot] = 0
    paint_snapshot_asset_counts[slot] = 0
    paint_snapshots_valid[slot] = false
    frame_paint_unchanged[slot] = false
}

PaintSnapshotStore :: (session: Session) -> bool {
    slot: s32 = SessionIndex(session)
    VecClear(paint_snapshots[slot])
    paint_snapshot_value_counts[slot] = 0
    paint_snapshot_asset_counts[slot] = 0
    index: s32 = 0
    while cast(s64)index < pending_paint[slot].items.count {
        current: PaintCommand = PendingPaintAt(session, index)
        previous: PaintSnapshot
        previous.data = current
        previous.value_start = SnapshotTextAppend(slot, true, current.value)
        if previous.value_start < 0 {
            PaintSnapshotInvalidate(session)
            return false
        }
        previous.value_count = cast(s64)current.value.count
        previous.asset_start = SnapshotTextAppend(slot, false, current.asset_path)
        if previous.asset_start < 0 {
            PaintSnapshotInvalidate(session)
            return false
        }
        previous.asset_count = cast(s64)current.asset_path.count
        if !VecPush(paint_snapshots[slot], previous) {
            PaintSnapshotInvalidate(session)
            return false
        }
        index += 1
    }
    paint_snapshots_valid[slot] = true
    return true
}

#program_export
PaintPlanUnchanged :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    slot: s32 = SessionIndex(session)
    if !paint_snapshots_valid[slot] { return false }
    if pending_paint[slot].items.count != paint_snapshots[slot].count { return false }
    index: s32 = 0
    while cast(s64)index < pending_paint[slot].items.count {
        if !PaintCommandEqual(slot, PendingPaintAt(session, index),
            paint_snapshots[slot][index]) { return false }
        index += 1
    }
    return true
}

#program_export
FramePaintUnchanged :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    return frame_paint_unchanged[SessionIndex(session)]
}

#program_export
PaintFlush :: (session: Session) {
    index: s32 = 0
    while cast(s64)index < pending_paint[SessionIndex(session)].items.count {
        command: QueuedPaint = pending_paint[SessionIndex(session)].items[index]
        if command.data.owns_text {
            slot: s32 = SessionIndex(session)
            command.data.value = TextView(pending_text[slot][
                command.data.text_start:
                command.data.text_start + command.data.text_count])
        }
        EmitPaint(command)
        index += 1
    }
    PaintClear(session)
}

#program_export
PaintDispose :: (session: Session) {
    if !SessionValid(session) { return }
    VecFree(pending_paint[session.slot].items)
    VecFree(paint_snapshots[session.slot])
    pending_text_count[session.slot] = 0
    pending_paint[session.slot].overflow = false
    paint_snapshot_value_counts[session.slot] = 0
    paint_snapshot_asset_counts[session.slot] = 0
    paint_snapshots_valid[session.slot] = false
    frame_paint_unchanged[session.slot] = false
}
