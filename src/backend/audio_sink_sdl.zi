// The desktop's audio device for audio_mixer: SDL2 opens the default output
// for 48 kHz float32 stereo, converting to what the device takes, and its
// audio thread pulls each block from the mixer. It needs no window. With
// SDL_AUDIODRIVER=disk SDL writes the blocks to SDL_DISKAUDIOFILE instead,
// so a test hears exactly what was mixed without a device.
Mixer :: #import "audio_mixer";
#import "std/byte_text_linux"

#scope_file
sdl :: #system_library "SDL2";
InitSubSystem :: (flags: u32) -> s32 #foreign sdl "SDL_InitSubSystem";
QuitSubSystem :: (flags: u32) #foreign sdl "SDL_QuitSubSystem";
OpenDevice :: (name: *u8, capture: s32, wanted: *Spec, obtained: *Spec,
    changes: s32) -> u32 #foreign sdl "SDL_OpenAudioDevice";
CloseDevice :: (device: u32) #foreign sdl "SDL_CloseAudioDevice";
PauseDevice :: (device: u32, paused: s32) #foreign sdl "SDL_PauseAudioDevice";
LockDevice :: (device: u32) #foreign sdl "SDL_LockAudioDevice";
UnlockDevice :: (device: u32) #foreign sdl "SDL_UnlockAudioDevice";

Pull :: #type (argument: *void, stream: *u8, length: s32) -> void #c_call;
// SDL_AudioSpec.
Spec :: struct {
    frequency: s32
    format: u16
    channels: u8
    silence: u8
    samples: u16
    padding: u16
    size: u32
    callback: Pull
    argument: *void
}

// SDL_INIT_AUDIO and AUDIO_F32SYS on a little-endian host.
INIT_AUDIO :: 0x10
FLOAT32 :: 0x8120

device: u32;

Mix :: (argument: *void, stream: *u8, length: s32) {
    unused argument
    samples: []float32
    view := cast(*ByteDescriptor)(*samples)
    view.data = stream
    view.length = cast(s64)length / 4
    Mixer.AudioRender(samples, cast(s64)length / 8)
}

Enter :: () { if device != 0 { LockDevice(device) } }
Leave :: () { if device != 0 { UnlockDevice(device) } }

#scope_export
// Opens the device and starts pulling; true when it already plays.
AudioSinkOpen :: () -> bool {
    if device != 0 { return true }
    if InitSubSystem(cast(u32)INIT_AUDIO) != 0 { return false }
    pull: Pull = Mix
    wanted: Spec
    wanted.frequency = Mixer.AUDIO_RATE
    wanted.format = cast(u16)FLOAT32
    wanted.channels = 2
    wanted.samples = 1024
    wanted.callback = pull
    obtained: Spec
    opened := OpenDevice(null, 0, *wanted, *obtained, 0)
    if opened == 0 { QuitSubSystem(cast(u32)INIT_AUDIO); return false }
    device = opened
    enter: Mixer.AudioLockCall = Enter
    leave: Mixer.AudioLockCall = Leave
    Mixer.AudioUseLock(enter, leave)
    PauseDevice(device, 0)
    return true
}

AudioSinkReady :: () -> bool { return device != 0 }

// Stops pulling; the mixer's voices stay loaded and its lock does nothing.
AudioSinkClose :: () {
    if device == 0 { return }
    CloseDevice(device)
    device = 0
    QuitSubSystem(cast(u32)INIT_AUDIO)
}
