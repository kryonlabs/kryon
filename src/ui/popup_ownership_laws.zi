#import "popup_ownership"

// Laws for popups owned by other popups. Each states the expected behavior
// independently of the implementation; `ziran check` proves it over every
// listed input. An implementation edit may not change this file.

B :: (value: s32) -> bool { return value != 0 }

// A popup's owner is alive unless it has a parent that is gone.
#law OwnerAliveRule forall parent: 0..1, alive: 0..1 => PopupOwnerAlive(B(parent), B(alive)) == (!B(parent) || B(alive));

// A popup whose owner died holds the input so nothing behind it reacts; a
// live popup holds it only while some other popup is on top.
#law DeadOwnerCaptures forall top: 0..1, same: 0..1 => PopupInputCaptured(true, false, B(top), B(same));
#law NothingOnTopReleases forall owner: 0..1, same: 0..1 => !PopupInputCaptured(B(owner), true, false, B(same));
#law OwnTopReleases custom !PopupInputCaptured(true, true, true, true);
#law OtherTopCaptures custom PopupInputCaptured(true, true, true, false);
#law OwnerlessTopCaptures forall same: 0..1 => PopupInputCaptured(false, true, true, B(same));
