    if !ModuleName("p0123456789abcdef_image_raster", "image_raster") { return 3 }
    if ModuleName("p0123456789abcdef_image_raster", "raster") { return 4 }
    if !ModuleName("kryon_image_raster", "image_raster") { return 5 }
    if ModuleName("some_image_raster", "image_raster") { return 6 }
    if ModuleName("p0123456789abcdeg_image_raster", "image_raster") { return 7 }
    if ModuleName("", "raster") { return 8 }
    if !ModuleName("kryon__image_raster", "image_raster") { return 9 }
    if ModuleName("kryon__image_raster", "raster") { return 10 }
    if !ModuleName("waozi_xyz_kryonlabs_kryon_ad43e92a5827_image_raster", "image_raster") { return 11 }
    if ModuleName("waozi_xyz_kryonlabs_kryon_ad43e92a5827_image_raster", "raster") { return 12 }
    if !ModuleName("kryon_ad43e92a5827_text_measure", "text_measure") { return 13 }
