#import "c_string"
#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "tree_input"
#import "canvas_types"
#import "canvas_window"
#import "canvas_draw"
#import "canvas_input"
#import "canvas_texture"
#import "canvas_text"
#import "canvas_os"

c :: #system_library "c";
libm :: #system_library "m";
HostTypefaceAllocate :: (size: usize) -> *u8 #foreign c "malloc";
HostTypefaceFree :: (bytes: *u8) #foreign c "free";
CanvasSqrt :: (value: float32) -> float32 #foreign libm "sqrtf";

CanvasAsset :: struct {
    path: [1024]u8
    length: s32
    texture: Texture2D
}

canvas_assets: [32]CanvasAsset;
canvas_assets_count: s32;
canvas_assets_next: s32;
canvas_pointer: PointerFrame;
canvas_wheel_move: float32;
canvas_image_error: bool;
canvas_font: CanvasFont;
canvas_font_loaded: bool;
canvas_font_registered: bool;
canvas_active_typeface_index: s32 = -1;

CanvasTypeface :: struct {
    name: [64]u8
    name_length: s32
    font: CanvasFont
}

canvas_typefaces: [16]CanvasTypeface;
canvas_typeface_count: s32;

CanvasTypefaceIndex :: (name: string) -> s32 {
    if name.count == 0 || name.count >= 64 {
        return -1
    }
    index: s32 = 0
    while index < canvas_typeface_count {
        if canvas_typefaces[index].name_length == cast(s32)name.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)name.count {
                if canvas_typefaces[index].name[at] != name[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same {
                return index
            }
        }
        index += 1
    }
    return -1
}

CanvasStoreTypeface :: (name: string, font: CanvasFont) -> bool {
    if font.texture.id == cast(u32)0 || name.count == 0 ||
    name.count >= 64 {
        return false
    }
    name_bytes: [64]u8
    if !CopyCString(name, name_bytes[:]) {
        return false
    }
    index: s32 = CanvasTypefaceIndex(name)
    if index < 0 {
        if canvas_typeface_count == 16 {
            return false
        }
        index = canvas_typeface_count
        canvas_typeface_count += 1
    } else {
        UnloadFont(canvas_typefaces[index].font)
    }
    if !CopyCString(name, canvas_typefaces[index].name[:]) {
        return false
    }
    canvas_typefaces[index].name_length = cast(s32)name.count
    canvas_typefaces[index].font = font
    if canvas_active_typeface_index == index {
        canvas_font = font
        canvas_font_loaded = true
        canvas_font_registered = true
    }
    return true
}

#program_export
LoadTypefaceData :: (name: string, extension: string, data: string,
    seed: *s32, seed_count: s32) -> bool {
    if name.count == 0 || extension.count == 0 || data.count == 0 ||
    data.count > 2147483647 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    extension_bytes: [16]u8
    if !CopyCString(extension, extension_bytes[:]) {
        return false
    }
    bytes: *u8 = HostTypefaceAllocate(cast(usize)data.count)
    if bytes == null {
        return false
    }
    index: s32 = 0
    while index < cast(s32)data.count {
        bytes[index] = data[index]
        index += 1
    }
    font := LoadFontFromMemory(*extension_bytes[0], bytes,
        cast(s32)data.count, 64, seed, seed_count)
    HostTypefaceFree(bytes)
    if font.texture.id == cast(u32)0 {
        return false
    }
    if !CanvasStoreTypeface(name, font) {
        UnloadFont(font)
        return false
    }
    return true
}

#program_export
LoadTypefaceFile :: (name: string, path: string,
    seed: *s32, seed_count: s32) -> bool {
    if name.count == 0 || path.count == 0 || seed_count < 0 ||
    (seed_count > 0 && seed == null) {
        return false
    }
    path_bytes: [4096]u8
    if !CopyCString(path, path_bytes[:]) {
        return false
    }
    font := LoadFontEx(*path_bytes[0], 64, seed, seed_count)
    if font.texture.id == cast(u32)0 {
        return false
    }
    if !CanvasStoreTypeface(name, font) {
        UnloadFont(font)
        return false
    }
    return true
}

#program_export
LoadSystemTypeface :: (name: string) -> bool {
    return false
}

#program_export
SelectTypeface :: (name: string) -> bool {
    index: s32 = CanvasTypefaceIndex(name)
    if index < 0 {
        return false
    }
    if canvas_font_loaded && !canvas_font_registered {
        UnloadFont(canvas_font)
    }
    canvas_font = canvas_typefaces[index].font
    canvas_font_loaded = true
    canvas_font_registered = true
    canvas_active_typeface_index = index
    return true
}

#program_export
ReleaseTypefaces :: () {
    if canvas_font_loaded && !canvas_font_registered {
        UnloadFont(canvas_font)
    }
    index: s32 = 0
    while index < canvas_typeface_count {
        UnloadFont(canvas_typefaces[index].font)
        canvas_typefaces[index] = CanvasTypeface.{}
        index += 1
    }
    canvas_typeface_count = 0
    canvas_active_typeface_index = -1
    canvas_font = CanvasFont.{}
    canvas_font_loaded = false
    canvas_font_registered = false
}

#program_export
ReleaseTypefaceCpu :: () {
    // canvas owns glyph data until UnloadFont releases the atlas.
}

CanvasTryFont :: (path: *u8) -> bool {
    if path == null || !FileExists(path) { return false }
    canvas_font = LoadFontEx(path, 32, null, 0)
    canvas_font_loaded = canvas_font.texture.id != cast(u32)0
    canvas_font_registered = false
    return canvas_font_loaded
}

CanvasRoundness :: (bounds: Rectangle, radius: float32) -> float32 {
    edge: float32 = bounds.width
    if bounds.height < edge { edge = bounds.height }
    if edge <= 0.0 || radius <= 0.0 { return 0.0 }
    roundness: float32 = radius * 2.0 / edge
    if roundness > 1.0 { return 1.0 }
    return roundness
}

CanvasDrawImageStrip :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, origin: Vector2, rotation: float32,
    tint: Color, x: s32, y: s32, width: s32, height: s32) {
    if width <= 0 || height <= 0 { return }
    BeginScissorMode(x, y, width, height)
    DrawTexturePro(texture, source, destination, origin, rotation, tint)
    EndScissorMode()
}

// Scissor strips preserve DrawTexturePro's rotation and source mapping while
// following the same rounded clip boundary used by the Cairo host.
CanvasDrawImageClipped :: (texture: Texture2D, source: Rectangle,
    destination: Rectangle, clip: Rectangle, origin: Vector2,
    rotation: float32, radius: float32, tint: Color) {
    x: s32 = cast(s32)clip.x
    y: s32 = cast(s32)clip.y
    width: s32 = cast(s32)clip.width
    height: s32 = cast(s32)clip.height
    if width <= 0 || height <= 0 { return }
    if radius <= 0.0 {
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x, y, width, height)
        return
    }
    if radius > cast(float32)width * 0.5 {
        radius = cast(float32)width * 0.5
    }
    if radius > cast(float32)height * 0.5 {
        radius = cast(float32)height * 0.5
    }
    rounded_rows: s32 = cast(s32)(radius + 0.5)
    if rounded_rows < 1 { rounded_rows = 1 }
    if rounded_rows * 2 > height { rounded_rows = height / 2 }
    row: s32 = 0
    while row < rounded_rows {
        dy: float32 = radius - (cast(float32)row + 0.5)
        inset: s32 = 0
        if dy > 0.0 {
            inset = cast(s32)(radius - CanvasSqrt(radius * radius -
                dy * dy) + 0.5)
        }
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + row,
            width - inset * 2, 1)
        CanvasDrawImageStrip(texture, source, destination, origin,
            rotation, tint, x + inset, y + height - 1 - row,
            width - inset * 2, 1)
        row += 1
    }
    CanvasDrawImageStrip(texture, source, destination, origin,
        rotation, tint, x, y + rounded_rows,
        width, height - rounded_rows * 2)
}

CanvasAssetIndex :: (path: string) -> s32 {
    if path.count == 0 || path.count >= 1024 { return -1 }
    index: s32 = 0
    while index < canvas_assets_count {
        if canvas_assets[index].length == cast(s32)path.count {
            same: bool = true
            at: s32 = 0
            while at < cast(s32)path.count {
                if canvas_assets[index].path[at] != path[at] {
                    same = false
                    break
                }
                at += 1
            }
            if same { return index }
        }
        index += 1
    }
    if canvas_assets_count < 32 {
        index = canvas_assets_count
        canvas_assets_count += 1
    } else {
        index = canvas_assets_next
        UnloadTexture(canvas_assets[index].texture)
        canvas_assets_next = (canvas_assets_next + 1) % 32
    }
    if !CopyCString(path, canvas_assets[index].path[:]) {
        canvas_assets[index].length = 0
        return -1
    }
    canvas_assets[index].length = cast(s32)path.count
    canvas_assets[index].texture =
    LoadTexture(*canvas_assets[index].path[0])
    if canvas_assets[index].texture.id == cast(u32)0 {
        canvas_assets[index].length = 0
        return -1
    }
    return index
}

#program_export
OpenCanvas :: () -> bool {
    title: [32]u8
    if !CopyCString("Kryon Ziran", title[:]) { return false }
    SetConfigFlags(cast(u32)4)
    InitWindow(960, 600, *title[0])
    if !IsWindowReady() { return false }
    SetTargetFPS(60)
    if !canvas_font_loaded {
        path: [96]u8
        if CopyCString("/kryon-font.ttf", path[:]) {
            CanvasTryFont(*path[0])
        }
    }
    return true
}

#program_export
CloseCanvas :: () {
    index: s32 = 0
    while index < canvas_assets_count {
        if canvas_assets[index].texture.id != cast(u32)0 {
            UnloadTexture(canvas_assets[index].texture)
        }
        index += 1
    }
    canvas_assets_count = 0
    ReleaseTypefaces()
    if IsWindowReady() { CloseWindow() }
}

#program_export
PollCanvas :: () -> bool {
    if WindowShouldClose() { return false }
    canvas_pointer.x = cast(float32)GetMouseX()
    canvas_pointer.y = cast(float32)GetMouseY()
    canvas_pointer.down = IsMouseButtonDown(0)
    canvas_pointer.pressed = IsMouseButtonPressed(0)
    canvas_pointer.released = IsMouseButtonReleased(0)
    canvas_wheel_move = GetMouseWheelMove()
    return true
}

#program_export
CanvasViewport :: () -> Rectangle {
    return Rectangle.{0.0, 0.0,
        cast(float32)GetScreenWidth(),
        cast(float32)GetScreenHeight()}
}

#program_export
CanvasPressedKey :: () -> s32 {
    return GetKeyPressed()
}

#program_export
CanvasTypedCodepoint :: () -> s32 {
    return GetCharPressed()
}

#program_export
CanvasWheelMove :: () -> float32 {
    return canvas_wheel_move
}

#program_export
BeginCanvasFrame :: () {
    canvas_image_error = false
    BeginDrawing()
    ClearBackground(Color.{248, 250, 252, 255})
}

#program_export
EndCanvasFrame :: () -> bool {
    EndDrawing()
    return !canvas_image_error
}

#program_export
CaptureRequested :: () -> bool {
    return false
}

#program_export
CaptureConfigured :: () -> bool {
    return false
}

#program_export
MeasureGlyphWidth :: (value: string, font: s32,
    typeface: string) -> s32 {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return 0 }
    if canvas_font_loaded {
        extent: Vector2 = MeasureTextEx(canvas_font, *bytes[0],
            cast(float32)font, 0.0)
        return cast(s32)(extent.x + 0.5)
    }
    return MeasureText(*bytes[0], font)
}

#program_export
MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 {
    return font
}

#program_export
PollPointer :: () -> PointerFrame { return canvas_pointer }

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32,
    segments: s32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { return }
    if segments < 4 { segments = 4 }
    DrawRectangleRounded(bounds, CanvasRoundness(bounds, radius),
        segments, color)
}

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32,
    segments: s32, width: float32, color: Color) {
    if bounds.width <= 0.0 || bounds.height <= 0.0 || width <= 0.0 { return }
    if segments < 4 { segments = 4 }
    DrawRectangleRoundedLinesEx(bounds, CanvasRoundness(bounds, radius),
        segments, width, color)
}

#program_export
RasterLine :: (line: Rectangle, color: Color) {
    DrawLineEx(Vector2.{line.x, line.y},
        Vector2.{line.x + line.width, line.y + line.height}, 1.0, color)
}

#program_export
RasterText :: (value: string, x: s32, y: s32,
    font: s32, color: Color) {
    bytes: [4096]u8
    if !CopyCString(value, bytes[:]) { return }
    if canvas_font_loaded {
        DrawTextEx(canvas_font, *bytes[0],
            Vector2.{cast(float32)x, cast(float32)y},
            cast(float32)font, 0.0, color)
    } else {
        DrawText(*bytes[0], x, y, font, color)
    }
}

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32,
    font: s32, color: Color, clip: Rectangle) {
    if clip.width <= 0.0 || clip.height <= 0.0 { return }
    BeginScissorMode(cast(s32)clip.x, cast(s32)clip.y,
        cast(s32)clip.width, cast(s32)clip.height)
    RasterText(value, x, y, font, color)
    EndScissorMode()
}

#program_export
ImageWidth :: (asset_path: string) -> s32 {
    index: s32 = CanvasAssetIndex(asset_path)
    if index < 0 { return 0 }
    return canvas_assets[index].texture.width
}

#program_export
ImageHeight :: (asset_path: string) -> s32 {
    index: s32 = CanvasAssetIndex(asset_path)
    if index < 0 { return 0 }
    return canvas_assets[index].texture.height
}

#program_export
RasterImage :: (asset_path: string, texture_id: u32,
    source: Rectangle, destination: Rectangle, clip: Rectangle,
    origin: Vector2, rotation: float32, radius: float32, tint: Color) {
    if source.width <= 0.0 || source.height <= 0.0 ||
    destination.width <= 0.0 || destination.height <= 0.0 ||
    clip.width <= 0.0 || clip.height <= 0.0 {
        return
    }
    texture: Texture2D
    if texture_id != cast(u32)0 {
        texture = CurrentPaintTexture()
        if texture.id != texture_id {
            // Keep direct calls to the low-level raster effect usable.
            texture.id = texture_id
            texture.width = cast(s32)(source.x + source.width)
            texture.height = cast(s32)(source.y + source.height)
        }
    } else if asset_path.count > 0 {
        index: s32 = CanvasAssetIndex(asset_path)
        if index < 0 {
            canvas_image_error = true
            return
        }
        texture = canvas_assets[index].texture
    } else {
        canvas_image_error = true
        return
    }
    CanvasDrawImageClipped(texture, source, destination, clip, origin,
        rotation, radius, tint)
}
