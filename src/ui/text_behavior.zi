#import "geometry"
#import "style"
TextAppearance :: struct {
    font: s32
    color: u32
    letter_spacing: s32
}

#program_export
ResolveTextStyle :: (font: s32, inherited_font: s32, default_font: s32,
    color: u32, inherited_color: u32, fallback_color: u32, inherited_color_set: bool,
    color_set: bool,
    disabled: bool, inherited_disabled: bool, letter_spacing: s32) -> TextAppearance {
    style: TextAppearance
    style.font = ResolveFont(font, inherited_font, default_font)
    style.color = color
    // Both explicit and inherited foregrounds may intentionally be transparent.
    // Presence is independent of alpha; only absent colors use the minimal
    // fallback supplied by the host.
    if !color_set {
        style.color = fallback_color
        if inherited_color_set {
            style.color = inherited_color
        }
    }
    // A parent's resolved foreground already includes its disabled style.
    // An explicit child color still needs disabled presentation of its own.
    if (disabled || inherited_disabled) &&
       (color_set || !inherited_color_set || !inherited_disabled) {
        alpha: u32 = cast(u32)(cast(float32)(style.color & cast(u32)255) * 0.45)
        style.color = ((style.color >> cast(u32)8) << cast(u32)8) | alpha
    }
    style.letter_spacing = letter_spacing
    if style.letter_spacing < 0 {
        style.letter_spacing = 0
    }
    return style
}

#program_export
TextExtent :: (requested: float32, measured: float32) -> float32 {
    if requested > 0.0 {
        return requested
    }
    return measured
}

#program_export
TextWrapPolicy :: (width: float32, requested: s32) -> s32 {
    if width <= 0.0 {
        return 1
    }
    return requested
}

#program_export
TextDoubleClickSlopFor :: (scale: float32) -> s32 {
    if scale <= 0.0 { scale = 1.0 }
    return cast(s32)(6.0 * scale)
}

#program_export
TextDoubleClickShouldSelectLine :: (same_target: bool, same_line: bool,
    last_time: float32, now: float32, dx: float32, dy: float32,
    scale: float32) -> bool {
    slop: s32 = TextDoubleClickSlopFor(scale)
    if !same_target || !same_line || last_time < 0.0 {
        return false
    }
    if now - last_time > 0.40 {
        return false
    }
    if dx < cast(float32)-slop || dx > cast(float32)slop {
        return false
    }
    if dy < cast(float32)-slop || dy > cast(float32)slop {
        return false
    }
    return true
}
#program_export
TextAlignmentOffset :: (available: float32, measured: float32, alignment: s32) -> float32 {
    if alignment == 1 {
        return (available - measured) * 0.5
    }
    if alignment == 2 {
        return available - measured
    }
    return 0.0
}

// Decorations use the same measured line geometry as the glyphs.
#program_export
TextStrikethroughBounds :: (x: float32, y: float32, width: float32,
    line_height: float32, scale: float32) -> Rectangle {
    result: Rectangle
    if scale < 1.0 { scale = 1.0 }
    result.x = x
    result.y = y + line_height * 0.5
    result.width = width
    result.height = scale
    return result
}
