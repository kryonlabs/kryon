// A value handle is portable across native code and Ziran bundles.
// Slot zero is invalid; an epoch rejects handles after their slot closes.
Session :: struct {
    slot: s32
    epoch: u64
}

session_active: [9]bool;
session_epochs: [9]u64;

#program_export
SessionValid :: (session: Session) -> bool {
    return SessionIndex(session) != 0
}

#program_export
SessionIndex :: (session: Session) -> s32 {
    if session.slot > 0 && session.slot < 9 &&
        session_active[session.slot] &&
        session_epochs[session.slot] == session.epoch {
        return session.slot
    }
    return 0
}

#program_export
SessionOpen :: () -> Session {
    result: Session
    slot: s32 = 1
    while slot < 9 {
        if !session_active[slot] &&
            session_epochs[slot] != cast(u64)18446744073709551615 {
            session_epochs[slot] += cast(u64)1
            session_active[slot] = true
            result.slot = slot
            result.epoch = session_epochs[slot]
            return result
        }
        slot += 1
    }
    return result
}

#program_export
SessionClose :: (session: Session) -> bool {
    if !SessionValid(session) { return false }
    session_active[session.slot] = false
    return true
}

// The key of one part of a widget made of several nodes. Parts live in their
// own key space, the top bit set, so no key an application passes can match
// one, and a widget never takes the keys next to its own.
WidgetPartKey :: (key: u64, part: s32) -> u64 {
    mixed := (key + cast(u64)1) * cast(u64)0x9e3779b97f4a7c15 + cast(u64)(part + 1) * cast(u64)0xbf58476d1ce4e5b9
    mixed = (mixed ^ (mixed >> 31)) * cast(u64)0x94d049bb133111eb
    return (mixed ^ (mixed >> 29)) | (cast(u64)1 << 63)
}
