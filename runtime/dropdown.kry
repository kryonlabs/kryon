#module "dropdown"
#import "style"
#import "button"
#import "surface"
#import "control_props"

# Roles select semantic facts for host-side style resolution. They do not
# manufacture color, material, gradient, radius, or border recipes.
# 0: trigger, 2: floating panel, 26: option row, 27: scrollbar.
DropdownPanelRole :: () -> i32 #export {
    return 2
}

DropdownOptionRole :: () -> i32 #export {
    return 26
}

DropdownScrollbarRole :: () -> i32 #export {
    return 27
}

Appearance :: (base: StyleData, accent: StyleData, role: i32,
    state: i32, selected: bool) -> StyleData #export {
    if role == DropdownOptionRole() && selected && state != ButtonStateDisabled {
        return accent
    }
    return base
}

ContentMetrics :: struct {
    padding: float
    gap: float
    icon: float
    font: float
}

DropdownTriggerMetrics :: struct {
    min_width: i32
    min_height: i32
    indicator_padding: i32
    indicator_size: i32
    text_indicator_gap: i32
}

DropdownTriggerContent :: struct {
    icon_bounds: Rectangle
    text_bounds: Rectangle
    clip_bounds: Rectangle
    indicator_center_x: i32
    indicator_center_y: i32
}

DropdownTriggerInput :: struct {
    enter: bool
    space: bool
    down: bool
}

DropdownMenuInput :: struct {
    navigating: bool
    up: bool
    down: bool
    home: bool
    end: bool
    commit: bool
    escape: bool
}

# Both native hosts consume Button's resolved content metrics. Geometry does
# not silently select another size: the standard dropdown uses medium tokens.
Content :: (paint: StyleData, scale: float) -> ContentMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    return (ContentMetrics){.padding = paint.padding_x * scale,
        .gap = paint.gap * scale, .icon = paint.icon_size * scale,
        .font = paint.font_size * scale}
}

DropdownMetric :: (fields: u32, field: u32, value: float,
    fallback: float, scale: float, allow_zero: bool) -> i32 {
    if scale <= 0.0 { scale = 1.0 }
    if (fields & field) == (u32)0 || value < 0.0 ||
       (!allow_zero && value <= 0.0) {
        value = fallback
    }
    return (i32)(value * scale)
}

DropdownTriggerMetricsFor :: (scale: float, trigger: StyleFrame) -> DropdownTriggerMetrics #export {
    if scale <= 0.0 { scale = 1.0 }
    metrics: DropdownTriggerMetrics
    metrics.min_width = (i32)(32.0 * scale)
    metrics.min_height = (i32)(24.0 * scale)
    metrics.indicator_padding = DropdownMetric(trigger.value.fields,
        (u32)StyleContentOffset, trigger.value.offset_x, 24.0, scale, true)
    metrics.indicator_size = DropdownMetric(trigger.value.fields,
        (u32)StyleIconSize, trigger.value.icon_size, 10.0, scale, true)
    metrics.text_indicator_gap = DropdownMetric(trigger.value.fields,
        (u32)StyleGap, trigger.value.gap, 8.0, scale, true)
    return metrics
}

DropdownIndicator :: struct {
    x1: i32
    y1: i32
    x2: i32
    y2: i32
    x3: i32
    y3: i32
    x4: i32
    y4: i32
}

DropdownIndicatorFor :: (center_x: i32, center_y: i32, size: i32,
    open: bool) -> DropdownIndicator #export {
    if size < 0 { size = 0 }
    half: i32 = size / 2
    left: i32 = center_x - half
    right: i32 = center_x + half
    upper: i32 = center_y - half / 2
    lower: i32 = center_y + half / 2

    if open {
        return (DropdownIndicator){.x1 = left, .y1 = lower,
            .x2 = center_x, .y2 = upper, .x3 = center_x, .y3 = upper,
            .x4 = right, .y4 = lower}
    }
    return (DropdownIndicator){.x1 = left, .y1 = upper,
        .x2 = center_x, .y2 = lower, .x3 = center_x, .y3 = lower,
        .x4 = right, .y4 = upper}
}

DropdownTriggerContentFor :: (bounds: Rectangle, content: ContentMetrics,
    metrics: DropdownTriggerMetrics, has_icon: bool) -> DropdownTriggerContent #export {
    layout: DropdownTriggerContent
    text_x: float = bounds.x + content.padding
    text_right: float

    layout.indicator_center_x = (i32)(bounds.x + bounds.width) -
        metrics.indicator_padding
    layout.indicator_center_y = (i32)bounds.y + (i32)bounds.height / 2
    if has_icon {
        layout.icon_bounds.x = text_x
        layout.icon_bounds.y = bounds.y + (bounds.height - content.icon) / 2.0
        layout.icon_bounds.width = content.icon
        layout.icon_bounds.height = content.icon
        text_x += content.icon + content.gap
    }
    text_right = (float)(layout.indicator_center_x -
        metrics.indicator_size - metrics.text_indicator_gap)
    layout.clip_bounds.x = text_x
    layout.clip_bounds.y = bounds.y
    layout.clip_bounds.width = text_right - text_x
    layout.clip_bounds.height = bounds.height
    if layout.clip_bounds.width < 0.0 {
        layout.clip_bounds.width = 0.0
    }
    layout.text_bounds = layout.clip_bounds
    layout.text_bounds.y = bounds.y + (bounds.height - content.font) / 2.0
    return layout
}

# Portable input and popup policy. Hosts supply input samples and option
# availability; no host reimplements navigation, dismissal, or geometry.
ClampIndex :: (value: i32, count: i32) -> i32 #export {
    if count <= 0 {
        return -1
    }
    if value < 0 {
        return 0
    }
    if value >= count {
        return count - 1
    }
    return value
}

DropdownOptionCountFor :: (count: i32) -> i32 #export {
    if count < 0 { return 0 }
    return count
}

DropdownCurrentIndexFor :: (selected: i32, count: i32) -> i32 #export {
    index: i32 = ClampIndex(selected, count)
    if index < 0 { return 0 }
    return index
}

Trigger :: (open: bool, disabled: bool, count: i32, focused: bool,
    keyboard: bool, activated: bool, enter: bool, space: bool, down: bool) -> bool #export {
    if disabled || count <= 0 {
        return false
    }
    if activated {
        return !open
    }
    if !open && focused && keyboard && (enter || space || down) {
        return true
    }
    return open
}

DropdownTriggerInputFor :: (enter_pressed: bool, keypad_enter_pressed: bool,
    space_pressed: bool, down_pressed: bool) -> DropdownTriggerInput #export {
    input: DropdownTriggerInput
    input.enter = enter_pressed || keypad_enter_pressed
    input.space = space_pressed
    input.down = down_pressed
    return input
}

DropdownMenuInputFor :: (keyboard_available: bool, opening: bool,
    up_pressed: bool, down_pressed: bool, home_pressed: bool,
    end_pressed: bool, enter_pressed: bool, keypad_enter_pressed: bool,
    escape_pressed: bool) -> DropdownMenuInput #export {
    input: DropdownMenuInput
    if !keyboard_available {
        return input
    }
    input.escape = escape_pressed
    if !opening {
        input.up = up_pressed
        input.down = down_pressed
        input.home = home_pressed
        input.end = end_pressed
        input.navigating = input.up || input.down || input.home || input.end
        input.commit = enter_pressed || keypad_enter_pressed
    }
    return input
}

Dismiss :: (open: bool, opening: bool, count: i32, height: float,
    escape: bool, lost_focus: bool, outside: bool) -> bool #export {
    return open && (count <= 0 || height <= 0.0 || escape || lost_focus || (!opening && outside))
}

Navigation :: struct {
    index: i32
    previous: i32
    count: i32
    direction: i32
    phase: i32
    searching: bool
    result: i32
}

StartNavigation :: (current: i32, count: i32, up: bool, down: bool,
    home: bool, end: bool) -> Navigation #export {
    current = ClampIndex(current, count)
    nav: Navigation = (Navigation){.index = current, .previous = current,
        .count = count, .direction = 1, .searching = count > 0, .result = -1}
    if up {
        nav.index = ClampIndex(current - 1, count)
        nav.direction = -1
    } else if down {
        nav.index = ClampIndex(current + 1, count)
    } else if home {
        nav.index = 0
    } else if end {
        nav.index = count - 1
        nav.direction = -1
    }
    return nav
}

# The host only looks up the availability of nav.index. This bounded scan
# includes boundary fallback and handles all-disabled lists without activation.
ScanNavigation :: (nav: Navigation, enabled: bool) -> Navigation #export {
    if !nav.searching {
        return nav
    }
    if enabled {
        nav.result = nav.index
        nav.searching = false
        return nav
    }
    if nav.phase == 1 {
        nav.phase = 2
        nav.direction = -nav.direction
    }
    nav.index += nav.direction
    if nav.index < 0 || nav.index >= nav.count {
        if nav.phase == 0 {
            nav.index = nav.previous
            nav.phase = 1
        } else {
            nav.searching = false
            nav.result = -1
        }
    }
    return nav
}

CanCommit :: (enabled: bool, opening: bool, keyboard: bool, enter: bool,
    pointer: bool, scrollbar: bool, dragging: bool, returned: bool) -> bool #export {
    return enabled && !opening && ((keyboard && enter) ||
        (pointer && !scrollbar && (!dragging || returned)))
}

ContentHeight :: (count: i32, row: float, padding: float) -> i32 #export {
    height: f64 = (f64)count * (f64)row + (f64)padding
    if height <= 0.0 {
        return 0
    }
    if height >= 2147483647.0 {
        return 2147483647
    }
    return (i32)height
}

MenuLayout :: struct {
    content_bounds: Rectangle
    scrollbar_bounds: Rectangle
    option_width: i32
    content_height: i32
    max_scroll: i32
}

OptionPaint :: struct {
    option_y: i32
    visible_bounds: Rectangle
    highlight_bounds: Rectangle
}

DropdownOptionContent :: struct {
    icon_bounds: Rectangle
    text_bounds: Rectangle
    clip_bounds: Rectangle
    check_bounds: Rectangle
    separator_bounds: Rectangle
}

DropdownMenuMetrics :: struct {
    padding_top: i32
    padding_bottom: i32
    scrollbar_width: i32
    scrollbar_gap: i32
    scrollbar_track_inset: i32
    highlight_inset_x: i32
    highlight_inset_y: i32
    separator_inset: i32
    drag_threshold: i32
}

DropdownMenuMetricsFor :: (scale: float, panel: StyleFrame,
    option: StyleFrame, scrollbar: StyleFrame) -> DropdownMenuMetrics #export {
    metrics: DropdownMenuMetrics
    metrics.padding_top = DropdownMetric(panel.value.fields,
        (u32)StylePaddingY, panel.value.padding_y, 4.0, scale, true)
    metrics.padding_bottom = metrics.padding_top
    metrics.scrollbar_width = DropdownMetric(scrollbar.value.fields,
        (u32)StyleIconSize, scrollbar.value.icon_size, 8.0, scale, true)
    metrics.scrollbar_gap = DropdownMetric(scrollbar.value.fields,
        (u32)StyleGap, scrollbar.value.gap, 2.0, scale, true)
    metrics.scrollbar_track_inset = DropdownMetric(scrollbar.value.fields,
        (u32)StylePaddingY, scrollbar.value.padding_y, 2.0, scale, true)
    metrics.highlight_inset_x = DropdownMetric(option.value.fields,
        (u32)StylePaddingX, option.value.padding_x, 4.0, scale, true)
    metrics.highlight_inset_y = DropdownMetric(option.value.fields,
        (u32)StylePaddingY, option.value.padding_y, 2.0, scale, true)
    metrics.separator_inset = DropdownMetric(option.value.fields,
        (u32)StyleContentOffset, option.value.offset_x, 16.0, scale, true)
    metrics.drag_threshold = DropdownMetric(scrollbar.value.fields,
        (u32)StyleContentOffset, scrollbar.value.offset_x, 8.0, scale, false)
    return metrics
}

MenuLayoutFor :: (bounds: Rectangle, count: i32, row_height: i32,
    padding_top: i32, padding_bottom: i32, scrollbar_width: i32,
    scrollbar_gap: i32) -> MenuLayout #export {
    layout: MenuLayout
    layout.content_height = ContentHeight(count, (float)row_height,
        (float)(padding_top + padding_bottom))
    layout.max_scroll = layout.content_height - (i32)bounds.height
    if layout.max_scroll < 0 { layout.max_scroll = 0 }
    layout.option_width = (i32)bounds.width
    if layout.max_scroll > 0 {
        layout.option_width -= scrollbar_width + scrollbar_gap
        if layout.option_width < 0 { layout.option_width = 0 }
    }
    layout.content_bounds.x = bounds.x
    layout.content_bounds.y = bounds.y + (float)padding_top
    layout.content_bounds.width = (float)layout.option_width
    layout.content_bounds.height = bounds.height - (float)(padding_top + padding_bottom)
    if layout.content_bounds.height < 0.0 { layout.content_bounds.height = 0.0 }
    layout.scrollbar_bounds.x = bounds.x + bounds.width - (float)scrollbar_width
    layout.scrollbar_bounds.y = bounds.y
    layout.scrollbar_bounds.width = (float)scrollbar_width
    layout.scrollbar_bounds.height = bounds.height
    if layout.scrollbar_bounds.width < 0.0 { layout.scrollbar_bounds.width = 0.0 }
    if layout.scrollbar_bounds.height < 0.0 { layout.scrollbar_bounds.height = 0.0 }
    return layout
}

ScrollbarTrackBounds :: (scrollbar: Rectangle, inset: i32) -> Rectangle #export {
    track: Rectangle = scrollbar
    track.y += (float)inset
    track.height -= (float)(inset * 2)
    if track.height < 0.0 { track.height = 0.0 }
    return track
}

OptionPaintFor :: (menu: Rectangle, option_width: i32, index: i32,
    row_height: i32, scroll_offset: i32, padding_top: i32,
    padding_bottom: i32, highlight_inset_x: i32,
    highlight_inset_y: i32) -> OptionPaint #export {
    paint: OptionPaint
    option_bottom: i32
    visible_bottom: i32
    content_top: i32 = (i32)menu.y + padding_top
    content_bottom: i32 = (i32)(menu.y + menu.height) - padding_bottom

    paint.option_y = (i32)((i64)((i32)menu.y) + (i64)padding_top +
        (i64)index * (i64)row_height - (i64)scroll_offset)
    option_bottom = paint.option_y + row_height
    paint.visible_bounds.x = menu.x
    paint.visible_bounds.y = (float)paint.option_y
    if (i32)paint.visible_bounds.y < content_top {
        paint.visible_bounds.y = (float)content_top
    }
    visible_bottom = option_bottom
    if visible_bottom > content_bottom { visible_bottom = content_bottom }
    paint.visible_bounds.width = (float)option_width
    paint.visible_bounds.height = (float)visible_bottom - paint.visible_bounds.y
    if paint.visible_bounds.height < 0.0 { paint.visible_bounds.height = 0.0 }
    paint.highlight_bounds.x = menu.x + (float)highlight_inset_x
    paint.highlight_bounds.y = (float)(paint.option_y + highlight_inset_y)
    paint.highlight_bounds.width = (float)(option_width - highlight_inset_x * 2)
    paint.highlight_bounds.height = (float)(row_height - highlight_inset_y * 2)
    if paint.highlight_bounds.width < 0.0 { paint.highlight_bounds.width = 0.0 }
    if paint.highlight_bounds.height < 0.0 { paint.highlight_bounds.height = 0.0 }
    return paint
}

DropdownOptionContentFor :: (row: Rectangle, visible: Rectangle,
    content: ContentMetrics, metrics: DropdownMenuMetrics,
    has_icon: bool) -> DropdownOptionContent #export {
    layout: DropdownOptionContent
    text_x: float = row.x + content.padding
    text_right: float = row.x + row.width - content.padding -
        content.icon - content.gap

    layout.separator_bounds.x = row.x + (float)metrics.separator_inset
    layout.separator_bounds.y = row.y
    layout.separator_bounds.width = row.width -
        (float)(metrics.separator_inset * 2)
    if layout.separator_bounds.width < 0.0 {
        layout.separator_bounds.width = 0.0
    }

    if has_icon {
        layout.icon_bounds.x = text_x
        layout.icon_bounds.y = row.y + (row.height - content.icon) / 2.0
        layout.icon_bounds.width = content.icon
        layout.icon_bounds.height = content.icon
        text_x += content.icon + content.gap
    }

    layout.clip_bounds.x = text_x
    layout.clip_bounds.y = visible.y
    layout.clip_bounds.width = text_right - text_x
    layout.clip_bounds.height = visible.height
    if layout.clip_bounds.width < 0.0 {
        layout.clip_bounds.width = 0.0
    }
    if layout.clip_bounds.height < 0.0 {
        layout.clip_bounds.height = 0.0
    }

    layout.text_bounds = layout.clip_bounds
    layout.text_bounds.y = row.y + (row.height - content.font) / 2.0
    layout.text_bounds.height = row.height

    layout.check_bounds.x = row.x + row.width - content.padding - content.icon
    layout.check_bounds.y = row.y + (row.height - content.icon) / 2.0
    layout.check_bounds.width = content.icon
    layout.check_bounds.height = content.icon
    return layout
}

PopupBounds :: (button: Rectangle, view: Rectangle, count: i32,
    scale: float, panel: StyleFrame) -> Rectangle #export {
    if scale <= 0.0 {
        scale = 1.0
    }
    gap: float = (float)DropdownMetric(panel.value.fields, (u32)StyleGap,
        panel.value.gap, 4.0, scale, true)
    padding: float = (float)DropdownMetric(panel.value.fields,
        (u32)StylePaddingY, panel.value.padding_y, 8.0, scale, true)
    margin: float = (float)DropdownMetric(panel.value.fields,
        (u32)StyleContentOffset, panel.value.offset_y, 16.0, scale, true)
    bottom: float = view.y + view.height
    below_y: float = button.y + button.height + gap
    if below_y < view.y {
        below_y = view.y
    }
    below: float = bottom - below_y - margin
    above: float = button.y - view.y - margin
    if below < 0.0 {
        below = 0.0
    }
    if above < 0.0 {
        above = 0.0
    }
    available: float = below
    if above > available {
        available = above
    }
    height: float = (float)ContentHeight(count, button.height, padding)
    if height > available && button.height > 0.0 {
        rows: i32 = (i32)((available - padding) / button.height)
        if rows < 1 {
            rows = 1
        }
        height = (float)ContentHeight(rows, button.height, padding)
    }
    y: float = below_y
    if height > below && above > below {
        y = button.y - gap - height
    }
    if height > view.height {
        height = view.height
    }
    if height < 0.0 {
        height = 0.0
    }
    if y > bottom - height {
        y = bottom - height
    }
    if y < view.y {
        y = view.y
    }
    width: float = button.width
    if width > view.width {
        width = view.width
    }
    if width < 0.0 {
        width = 0.0
    }
    x: float = button.x
    if x > view.x + view.width - width {
        x = view.x + view.width - width
    }
    if x < view.x {
        x = view.x
    }
    return (Rectangle){.x = x, .y = y, .width = width, .height = height}
}

ScrollOffset :: (offset: f64, maximum: i32) -> i32 #export {
    if maximum < 0 {
        maximum = 0
    }
    if offset <= 0.0 {
        return 0
    }
    if offset >= (f64)maximum {
        return maximum
    }
    return (i32)offset
}

RevealRow :: (offset: i32, index: i32, row: float, viewport: float, maximum: i32) -> i32 #export {
    if index < 0 {
        return ScrollOffset((f64)offset, maximum)
    }
    top: f64 = (f64)index * (f64)row
    next: f64 = (f64)offset
    if top < next {
        next = top
    }
    if top + (f64)row > next + (f64)viewport {
        next = top + (f64)row - (f64)viewport
    }
    return ScrollOffset(next, maximum)
}

WheelOffset :: (offset: i32, wheel: float, row: float, maximum: i32) -> i32 #export {
    return ScrollOffset((f64)offset - (f64)wheel * (f64)row, maximum)
}

VisibleRows :: struct {
    first: i32
    end: i32
}

Rows :: (count: i32, offset: i32, viewport: float, row: float) -> VisibleRows #export {
    result: VisibleRows
    if count <= 0 || row <= 0.0 || viewport <= 0.0 {
        return result
    }
    result.first = (i32)((float)offset / row)
    if result.first < 0 {
        result.first = 0
    }
    if result.first > count {
        result.first = count
    }
    bottom: f64 = ((f64)offset + (f64)viewport) / (f64)row
    if bottom >= (f64)count {
        result.end = count
    } else {
        result.end = (i32)bottom
        if (f64)result.end < bottom {
            result.end += 1
        }
    }
    return result
}

PopupGesture :: struct {
    pressed: bool
    dragging: bool
    origin_y: float
    origin_offset: i32
    offset: i32
}

PopupDragGesture :: (gesture: PopupGesture, offset: i32, down: bool, inside: bool,
    scrollbar: bool, y: float, maximum: i32, threshold: float) -> PopupGesture #export {
    gesture.offset = ScrollOffset((f64)offset, maximum)
    if down && !scrollbar {
        if !gesture.pressed && inside {
            gesture.pressed = true
            gesture.origin_y = y
            gesture.origin_offset = gesture.offset
            gesture.dragging = false
        } else if gesture.pressed && !gesture.dragging {
            delta: float = y - gesture.origin_y
            if maximum > 0 && (delta > threshold || delta < -threshold) {
                gesture.dragging = true
            }
        }
        if gesture.dragging && maximum > 0 {
            gesture.offset = ScrollOffset((f64)gesture.offset - (f64)(y - gesture.origin_y), maximum)
            gesture.origin_y = y
        }
    } else {
        gesture.pressed = false
    }
    return gesture
}

DropdownJustOpenedNext :: (just_opened: bool, pointer_pressed: bool) -> bool #export {
    return just_opened && pointer_pressed
}

DropdownScrollbarPressedNext :: (pressed: bool, pointer_down: bool,
    pointer_pressed: bool, max_scroll: i32, pointer_over_scrollbar: bool) -> bool #export {
    if !pointer_down {
        return false
    }
    return pressed || (max_scroll > 0 && pointer_pressed && pointer_over_scrollbar)
}
