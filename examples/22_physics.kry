#module "example_physics"
#import "kryon.h"
#import "kryon_example_font.h"

app "Kryon Physics" {
    size 640 420
    fps 60
    font examples
    theme THEME_SKY 0
    scene main
}

#enum {
    GROUND_X = 320
    GROUND_Y = 380
    BOX_X = 320
    BOX_Y = 60
}

scene main {
    KryScenePhysicsCreate(scene, 0.0, 980.0)

    ground := KryNodeCreate(scene, 0, KRY_NODE_BODY2D, "ground")
    KryNodeSetProps(scene, ground, KryBody2DPropsAlloc(KRY_BODY2D_STATIC))
    KryNodeSetPosition(scene, ground, GROUND_X, GROUND_Y)
    ground_shape := KryNodeCreate(scene, ground, KRY_NODE_COLLISION_SHAPE2D, "ground_shape")
    KryNodeSetProps(scene, ground_shape, KryCollisionShape2DPropsAlloc(KRY_SHAPE2D_BOX, 400.0, 32.0))

    box := KryNodeCreate(scene, 0, KRY_NODE_BODY2D, "box")
    KryNodeSetProps(scene, box, KryBody2DPropsAlloc(KRY_BODY2D_DYNAMIC))
    KryNodeSetPosition(scene, box, BOX_X, BOX_Y)
    box_shape := KryNodeCreate(scene, box, KRY_NODE_COLLISION_SHAPE2D, "box_shape")
    KryNodeSetProps(scene, box_shape, KryCollisionShape2DPropsAlloc(KRY_SHAPE2D_BOX, 48.0, 48.0))
}
