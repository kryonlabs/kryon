// GLSL composed with shader_glsl's validated material function.
GpuVertexSource :: #string GLSL
#version 300 es
precision highp float;
layout(location=0) in vec3 position;
layout(location=1) in vec3 normal;
layout(location=2) in vec3 color;
layout(location=3) in vec2 uv;
layout(location=4) in vec3 face;
uniform mat4 vp;
out vec3 world;
out vec3 worldNormal;
out vec3 vertexColor;
out vec2 texcoord;
flat out vec3 faceNormal;
void main(){
 world=position;worldNormal=normal;vertexColor=color;texcoord=uv;faceNormal=face;
 gl_Position=vp*vec4(position,1.0);
}
GLSL
GpuShadowFragment :: #string GLSL
#version 300 es
precision highp float;
void main(){}
GLSL
GpuProbeVertex :: #string GLSL
#version 300 es
precision highp float;
void main(){
 vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));
 gl_Position=vec4(p*2.0-1.0,0.0,1.0);
}
GLSL
GpuProbeFragment :: #string GLSL
#version 300 es
precision highp float;
precision highp sampler2DShadow;
uniform sampler2DShadow depthMap;
out vec4 result;
void main(){
 int x=int(gl_FragCoord.x),y=int(gl_FragCoord.y);
 vec2 p=x==0?vec2(0.5):x==1?vec2(0.375,0.25):x==2?vec2(0.625,0.25):vec2(-0.5,0.25);
 float z=y==1?0.8:y==2?0.2:0.5;
 result=vec4(texture(depthMap,vec3(p,z)),0.0,0.0,1.0);
}
GLSL
GpuFragmentPrefix :: #string GLSL
#version 300 es
precision highp float;
precision highp int;
precision highp sampler2D;
precision highp sampler2DShadow;
#define texture2D texture
in vec3 world;
in vec3 worldNormal;
in vec3 vertexColor;
in vec2 texcoord;
flat in vec3 faceNormal;
layout(location=0) out vec4 outColor;
uniform mat4 view;
uniform vec4 base;
uniform vec3 glow;
uniform vec4 material; // roughness, metalness, alpha_test, kind
uniform vec4 flags; // vertex colors, flat, double sided, receive
uniform vec4 settings; // tone mapping, exact color, exposure, perspective
uniform vec2 albedoSize;
uniform sampler2D albedo;
uniform sampler2D dfg;
uniform sampler2DShadow shadow0;
uniform sampler2DShadow shadow1;
uniform sampler2DShadow shadow2;
uniform sampler2DShadow shadow3;
uniform mat4 shadowMatrix[4];
uniform vec4 shadowSettings[4]; // enabled, bias, normal bias, radius/size
uniform vec3 lightColor[4];
uniform vec3 lightDirection[4];
uniform vec3 sky;
uniform vec3 ground;
uniform vec3 up;
uniform int lightCount;
uniform int transparent;
float sat(float a){return clamp(a,0.0,1.0);}
vec3 unit(vec3 a){float n=length(a);return n>0.0?a/n: vec3(0.0);}
vec3 linearColor(vec3 c){return mix(c/12.92,pow((c+0.055)/1.055,vec3(2.4)),step(vec3(0.04045),c));}
vec3 encode(vec3 c){c=clamp(c,0.0,1.0);return mix(c*12.92,1.055*pow(c,vec3(0.41666))-0.055,step(vec3(0.0031308),c));}
vec3 neutral(vec3 c){
 c*=settings.z;float x=min(c.r,min(c.g,c.b));
 float offset=x<0.08?x-6.25*x*x: 0.04;c-=offset;
 float peak=max(c.r,max(c.g,c.b));if(peak<0.76)return c;
 float d=0.24;float np=1.0-d*d/(peak+d-0.76);c*=np/peak;
 float g=1.0-1.0/(0.15*(peak-np)+1.0);return mix(c,vec3(np),g);
}
vec2 dfgAt(float rough,float nv){
 vec2 p=clamp(vec2(rough,nv)*16.0-0.5,0.0,15.0);
 ivec2 a=ivec2(floor(p)),b=min(a+1,ivec2(15));vec2 f=fract(p);
 return mix(mix(texelFetch(dfg,a,0).rg,texelFetch(dfg,ivec2(b.x,a.y),0).rg,f.x),
 mix(texelFetch(dfg,ivec2(a.x,b.y),0).rg,texelFetch(dfg,b,0).rg,f.x),f.y);
}
float compareDepth(sampler2DShadow map,vec2 uv,float z){
 return texture(map,vec3(uv,z));
}
float shadowAt(sampler2DShadow map,int i){
 if(shadowSettings[i].x<0.5||flags.w<0.5)return 1.0;
 vec3 p=(shadowMatrix[i]*vec4(world+worldNormal*shadowSettings[i].z,1.0)).xyz;
 float z=p.z+shadowSettings[i].y;
 if(p.x<0.0||p.x>1.0||p.y<0.0||p.y>1.0||z>1.0)return 1.0;
 vec2 pixel=floor(gl_FragCoord.xy)+0.5;
 float noise=fract(52.9829189*fract(dot(pixel,vec2(0.06711056,0.00583715))));
 float phi=noise*6.283185307179586,total=0.0;
 for(int s=0;s<5;s++){
  float theta=float(s)*2.399963229728653+phi;
  vec2 off=vec2(cos(theta),sin(theta))*sqrt((float(s)+0.5)/5.0);
  total+=compareDepth(map,p.xy+off*shadowSettings[i].w,z);
 }
 return total*0.2;
}
float lightShadow(int i){
 if(i==0)return shadowAt(shadow0,0);
 if(i==1)return shadowAt(shadow1,1);
 if(i==2)return shadowAt(shadow2,2);
 return shadowAt(shadow3,3);
}
GLSL
GpuFragmentMain :: #string GLSL
void main(){
 vec3 nview=mat3(view)*worldNormal;
 vec3 dx=dFdx(nview),dy=dFdy(nview);
 float turn=max(max(max(abs(dx.x),abs(dy.x)),max(abs(dx.y),abs(dy.y))),max(abs(dx.z),abs(dy.z)));
 vec3 eye=KRYON_PERSPECTIVE>0.5?unit(-(view*vec4(world,1.0)).xyz): vec3(0,0,1);
 vec3 n=unit(nview);
 if(KRYON_FLAT>0.5){n=unit(mat3(view)*faceNormal);if(dot(n,eye)<0.0)n=-n;turn=0.0;}
 else if(KRYON_DOUBLE>0.5&&!gl_FrontFacing)n=-n;
 vec4 color=base;
 if(KRYON_VERTEX>0.5)color.rgb*=vertexColor;
 if(albedoSize.x>0.0){
  vec2 p=clamp(floor(texcoord*albedoSize),vec2(0),albedoSize-1.0);
  vec4 t=texture(albedo,vec2(p.x+0.5,albedoSize.y-p.y-0.5)/albedoSize);
  color*=vec4(linearColor(t.rgb),t.a);
 }
 if(KRYON_KIND<1.5)color=kryonMaterial(color,vec4(world,1.0),vec4(unit(worldNormal),0.0),vec4(texcoord,0.0,0.0));
 if(KRYON_KIND>1.5){
  float mask=1.0;for(int i=0;i<4;i++){if(i<lightCount)mask*=lightShadow(i);}
  color=vec4(base.rgb,base.a*(1.0-mask));
 }
 // ShadowMaterial bypasses Surface in the CPU reference. A zero mask still
 // writes depth, and opaque ShadowMaterial ignores alpha when storing color.
 if(KRYON_KIND<1.5&&(color.a<=0.0||color.a<material.z))discard;
 if(KRYON_KIND<0.5){
  float rough=min(max(material.x,0.0525)+turn,1.0),metal=KRYON_METALNESS;
  vec3 diffuse=color.rgb*(1.0-metal),spec=mix(vec3(0.04),color.rgb,metal);
  float nv=sat(dot(n,eye));vec2 terms=dfgAt(rough,nv);float energy=terms.x+terms.y;
  vec3 compensation=vec3(1.0)+spec*(1.0/energy-1.0),dd=vec3(0),ds=vec3(0);
  float a2=rough*rough*rough*rough;
  // Only omit a zero-irradiance term when every BRDF factor is finite:
  // bounded normalized vectors, positive bounded roughness and finite color/
  // compensation keep half-vector, Fresnel, visibility and GGX finite.
  // Comparisons reject NaNs/infinities; uncertain public inputs keep the
  // original calculation, including its shadow evaluation.
  bool bounded=rough>=0.0525&&rough<=1.0&&metal>=0.0&&metal<=1.0&&all(lessThanEqual(abs(color.rgb),vec3(65536.0)))&&all(lessThanEqual(abs(compensation),vec3(1e20)))&&all(lessThanEqual(abs(n),vec3(1.001)))&&all(lessThanEqual(abs(eye),vec3(1.001)));
  for(int i=0;i<4;i++){
   if(i>=lightCount)break;
   vec3 direction=lightDirection[i].xyz;
   float nl=sat(dot(n,direction));
   if(nl==0.0&&bounded&&all(lessThanEqual(abs(direction),vec3(1.001)))&&all(lessThanEqual(abs(lightColor[i]),vec3(1e20))))continue;
   vec3 irradiance=lightColor[i].rgb*nl*lightShadow(i);
   vec3 halfVector=unit(direction+eye);float nh=sat(dot(n,halfVector)),vh=sat(dot(eye,halfVector));
   float fresnel=exp2((-5.55473*vh-6.98316)*vh);
   vec3 f=mix(spec,vec3(1.0),fresnel);
   float gv=nl*sqrt(a2+(1.0-a2)*nv*nv),gl=nv*sqrt(a2+(1.0-a2)*nl*nl);
   float visibility=0.5/max(gv+gl,1e-6),denom=nh*nh*(a2-1.0)+1.0;
   float distribution=a2/(3.141592653589793*denom*denom);
   ds+=irradiance*f*visibility*distribution*compensation;
   float f0=mix(0.04,1.0,fresnel);dd+=irradiance*diffuse*(1.0-f0)/3.141592653589793;
  }
  float weight=0.5*dot(n,up)+0.5;vec3 irradiance=mix(ground,sky,weight);
  float single=0.04*terms.x+terms.y,average=0.04+0.96*0.047619;
  float multiple=single*average/(1.0-(1.0-energy)*average)*(1.0-energy);
  color.rgb=dd+irradiance*diffuse*(1.0-single-multiple)/3.141592653589793+ds+glow;
 }
 if(settings.x>0.5&&settings.y<0.5)color.rgb=neutral(color.rgb);
 color.rgb=encode(color.rgb);
 color.rgb=clamp(color.rgb,0.0,1.0);
 outColor=vec4(color.rgb,transparent==0?1.0: clamp(color.a,0.0,1.0));
}
GLSL
