GenBuffers :: (count: s32, ids: *u32)  {RawGenBuffers(count,ids)}
DeleteBuffers :: (count: s32, ids: *u32)  {RawDeleteBuffers(count,ids)}
BindBuffer :: (target: u32, id: u32)  {RawBindBuffer(target,id)}
