using UI :: #import "kryon/Widgets";
#import "kryon/system_theme"
#import "std/number_text"
using Example :: #import "scenes";
#import "palette"
#import "preview_protocol"

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    example_input := PreviewInputRead()
    InstallCatalogPalette(example_input.theme == 2)
    Box(session, BoxProps.{.key = 9000, .bounds = viewport, .fill = StyleTokenColor("canvas")})
    Text(session, TextProps.{.key = 9001, .bounds = .{24.0, 12.0, 432.0, 36.0}, .text = "NavigationBar", .font = 23})
    disabled := example_input.disabled
    scene: s32 = 20
    scene_image = "catalog-image.png"
    input := Prepare(session, scene)
    field_input := input.field
    area_input := input.area
    items: [3]NavigationBarItem
    items[0].label = "Home"; items[0].active = nav == 0; items[1].label = "Library"; items[1].active = nav == 1; items[2].label = "Settings"; items[2].active = nav == 2; items[2].disabled = disabled
    moved := NavigationBar(session, NavigationBarProps.{.bounds = b, .view_width = 480, .view_height = 320, .height = 64}, items[:])
    if moved.clicked_index >= 0 { nav = moved.clicked_index }

    return 0
}
