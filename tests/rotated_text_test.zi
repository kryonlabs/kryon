#import "geometry"
#import "drawing_props"
#import "pixmap"
#import "raster_text"
#import "text"
#import "text_props"
#import "text_measure"
#import "session"
#import "tree"
#import "widget_kind"
using WidgetKind;
#import "tree_draw"
#import "paint_queue"

pixels: [65536]u32;
Clear :: () { unused PixmapBeginInto(cast(u32)0xffffff,256,256,pixels[:]) }

FrameText :: (session: Session, angle: float32) -> bool {
    BeginFrame(session,cast(u64)1,Rectangle.{0.0,0.0,256.0,256.0})
    props: TextProps = .{.key=cast(u64)2,.bounds=.{60.0,100.0,140.0,32.0},
        .text="Diagonal",.font=32,.rotation=angle,.origin=.{70.0,16.0},.wrap=.TextWrapNone}
    if TextWidth(session,props) <= 80 { return false }
    Text(session,props)
    command := PendingPaintAt(session,0)
    if command.font != 32 || command.rotation != angle || command.origin.x != 130.0 || command.origin.y != 116.0 { return false }
    area: Rectangle
    if !PaintCommandArea(command,*area) || area.width <= 0.0 || area.height <= 0.0 { return false }
    return EndFrame(session) == .FrameOk
}

#program_export
main :: () -> s32 {
    session := SessionOpen()
    if !SessionValid(session) { return 1 }
    Clear()
    if !FrameText(session,0.0) { return 2 }
    horizontal: s32
    for pixel: pixmap_surface { if pixel != cast(u32)0xffffff { horizontal += 1 } }
    Clear()
    if !FrameText(session,90.0) { return 3 }
    vertical: s32; left: s32=256; right: s32; top: s32=256; bottom: s32
    for y: 0..255 { for x: 0..255 {
        if pixmap_surface[y*256+x] != cast(u32)0xffffff {
            vertical += 1
            if x<left { left=cast(s32)x }; if x>right { right=cast(s32)x }
            if y<top { top=cast(s32)y }; if y>bottom { bottom=cast(s32)y }
        }
    } }
    if horizontal < 200 || vertical < horizontal*8/10 || bottom-top < (right-left)*2 { return 4 }
    angles: [3]float32 = .[-37.0,23.5,180.0]
    for angle: angles {
        Clear()
        if !FrameText(session,angle) { return 5 }
        count: s32
        for pixel: pixmap_surface { if pixel != cast(u32)0xffffff { count += 1 } }
        if count < 100 { return 7 }
    }
    // Ancestor clipping stays in world coordinates while the label clip rotates.
    Clear()
    BeginFrame(session,cast(u64)1,Rectangle.{0.0,0.0,256.0,256.0})
    parent := TreeSubmitCurrent(session,cast(u64)3,WidgetKindGroup,Rectangle.{0.0,0.0,256.0,256.0})
    TreeSetChildClip(session,parent,Rectangle.{0.0,0.0,256.0,116.0})
    if !TreePushScope(session,parent) { return 8 }
    Text(session,TextProps.{.key=cast(u64)4,.bounds=.{60.0,100.0,140.0,32.0},
        .text="Diagonal",.font=32,.rotation=90.0,.origin=.{70.0,16.0},.wrap=.TextWrapNone})
    TreePopScope(session)
    if EndFrame(session) != .FrameOk { return 9 }
    clipped: s32
    for y: 0..255 { for x: 0..255 {
        if pixmap_surface[y*256+x] != cast(u32)0xffffff {
            if y >= 116 { return 10 }
            clipped += 1
        }
    } }
    if clipped < 100 || clipped >= vertical { return 11 }
    // Link hit testing follows the inverse transform around the same pivot.
    links: [1]TextRange = .[.{0,4}]
    props: TextProps = .{.bounds=.{40.0,40.0,120.0,32.0},.text="Link",.font=32,
        .rotation=90.0,.origin=.{60.0,16.0},.links=links[:],.wrap=.TextWrapNone}
    origin: Vector2 = .{100.0,56.0}
    point := WorldToScreen(Vector2.{44.0,45.0},Camera.{.offset=origin,.target=origin,.rotation=90.0,.zoom=1.0})
    if TextLinkAt(session,props,point.x,point.y) != 0 { return 6 }
    SessionClose(session)
    return 0
}
