Text :: #import "text";
#import "session"
#import "geometry"
#import "page_props"
#import "semantic"
#import "style_sheet"
#import "tree"

using SemanticKind;

#program_export
Heading :: (session: Session, props: HeadingProps) {
    text: Text.Props
    text.bounds = props.bounds
    text.text = props.text
    text.key = props.key
    text.class_name = props.class_name
    text.fallback_font = 24
    text.style_kind = StyleKindHeading()
    text.semantic_kind = cast(SemanticKind)SemanticHeading
    text.heading_level = props.level
    Text.Draw(session, text)
}

#program_export
ParagraphText :: (session: Session, props: ParagraphTextProps) {
    text: Text.Props
    text.bounds = props.bounds
    text.text = props.text
    text.key = props.key
    text.class_name = props.class_name
    text.fallback_font = 16
    text.style_kind = StyleKindParagraphText()
    text.semantic_kind = cast(SemanticKind)SemanticParagraph
    if text.bounds.width <= 0.0 {
        parent: Rectangle = TreeCurrentParentBounds(session)
        offset: float32 = text.bounds.x - parent.x
        if offset < 0.0 { offset = 0.0 }
        text.bounds.width = parent.width - offset
        if text.bounds.width < 0.0 { text.bounds.width = 0.0 }
    }
    Text.Draw(session, text)
}
