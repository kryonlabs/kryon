#module "dropdown_host"
#import "ui_internal.h"
#import "ui_style_internal.h"
#import "ui_popup_input_internal.h"
#import "ui_paint_internal.h"
#import "ui_style_pack_props.generated.h"
#import "theme.h"
#import "ui/dropdown_store.h"
#import "ui/text.h"
#import "ui/disabled.h"
#import "runtime/dropdown.h"
#import "runtime/input.h"
#import "runtime/style.h"
#import "stdio.h"
#import "stdlib.h"

DropdownStyleFrame :: (role: i32, selected: i32,
state: ButtonState, class_name: i32) -> StyleFrame #export {
    props: ButtonProps = (ButtonProps){0}
    props.tone = ButtonToneNeutral
    props.emphasis = ButtonEmphasisSoft
    props.class_name = class_name
    if role == DropdownPanelRole() {
        props.emphasis = ButtonEmphasisFilled
    }
    if role == DropdownOptionRole() && selected != 0 &&
    state != ButtonStateDisabled {
        props.tone = ButtonToneAccent
        props.emphasis = ButtonEmphasisFilled
        props.selected = 1
        state = ButtonStateSelected
    }
    base: StyleFrame = ui_control_style_frame_role_kind(props,
    state, 0, 0.0, 0.0, 0.0, StyleKindDropdown(), role)
    if role != DropdownOptionRole() { return base }
    props.tone = ButtonToneAccent
    props.emphasis = ButtonEmphasisFilled
    props.selected = selected
    accent_state: ButtonState = state
    if selected != 0 && state != ButtonStateDisabled {
        accent_state = ButtonStateSelected
    }
    accent: StyleFrame = ui_control_style_frame_role_kind(props,
    accent_state, 0, 0.0, 0.0, 0.0, StyleKindDropdown(), role)
    base.value = Appearance(base.value, accent.value, role,
    state, selected)
    if selected != 0 && state != ButtonStateDisabled {
        base.fill = accent.fill
    }
    return base
}

DropdownStyle :: (role: i32, selected: i32,
state: ButtonState, class_name: i32) -> Style #export {
    return ui_unpack_style(DropdownStyleFrame(role, selected,
    state, class_name).value)
}

DropdownTriggerStyle :: (class_name: i32) -> ControlStyle #export {
    style: ControlStyle = (ControlStyle){0}
    style.normal = DropdownStyle(0, 0, ButtonStateNormal, class_name)
    style.hover = DropdownStyle(0, 0, ButtonStateHover, class_name)
    style.pressed = DropdownStyle(0, 0, ButtonStatePressed, class_name)
    style.focused = DropdownStyle(0, 0, ButtonStateFocus, class_name)
    style.disabled = DropdownStyle(0, 0, ButtonStateDisabled, class_name)
    return style
}

DropdownPaintTrigger :: (id: i32, bounds: Rectangle,
hovered: i32, pressed: i32, focused: i32,
class_name: i32) -> Color #export {
    props: ButtonProps = (ButtonProps){0}
    props.id = id
    props.bounds = bounds
    props.tone = ButtonToneNeutral
    props.emphasis = ButtonEmphasisSoft
    props.disabled = ContentDisabled()
    props.class_name = class_name
    spec: ButtonSpec = (ButtonSpec){0}
    spec.props = props
    spec.style = DropdownTriggerStyle(class_name)
    spec.style_kind = StyleKindDropdown()
    spec.style_resolved = 1
    sample: Activation = (Activation){0}
    sample.hovered = hovered
    sample.pressed = pressed
    sample.focused = focused
    if focused != 0 && IsFocusActivatePressed(id) {
        sample.pressed = true
    }
    input: ButtonInput = ResolveButtonInput((int)props.state,
    props.disabled, props.loading, props.selected, sample)
    metrics: ThemeMetrics = GetThemeMetrics()
    key: u32 = (2166136261u ^ (unsigned int)id) * 16777619u
    if id == 0 {
        key = (key ^ (unsigned int)(int)bounds.x) * 16777619u
        key = (key ^ (unsigned int)(int)bounds.y) * 16777619u
    }
    motion: InteractionMotion = AdvanceButtonMotion(key,
    (int)props.state, input, TransitionCuesEnabled(),
    GetFrameTime() * 1000.0, metrics.transition_normal_ms,
    metrics.transition_fast_ms)
    appearance: StyleFrame = ui_resolve_button_spec_frame(spec,
    input.interaction.state, 1, motion.hover.value,
    motion.press.value, motion.focus.value, StyleKindDropdown())
    frame: ButtonFrame = BuildFrame(props, input, appearance,
    motion, (Rectangle){0}, ColorToInt(ui_app_style().background),
    (float)Scale(1000) / 1000.0,
    ResolveFont(0, StyleFontValue(appearance.value.fields,
    appearance.value.font_size), GetFontSize()), GetFontSize())
    if frame.repaint { InvalidateTree(INVALIDATE_PAINT) }
    frame.appearance = ui_style_apply_effects_frame(frame.appearance)
    frame.material.value = frame.appearance.value
    frame.material.fill =
    ui_style_apply_effects_fill(frame.material.fill)
    layer: i32 = 0
    while layer < MaterialLayerCount(frame.material.value.material) {
        ui_draw_surface(PaintMaterialLayer(frame.material, layer))
        layer += 1
    }
    return GetColor(frame.foreground)
}

DropdownDrawSurface :: (bounds: Rectangle, paint: Style,
highlighted: i32) #export {
    ui_draw_material(bounds, (Rectangle){0}, paint.background,
    paint.border, paint.border, paint.radius, paint.border_width,
    highlighted, 0, 0, paint.focus, 0, paint.opacity,
    ui_style_fill(paint), paint.material)
}

DropdownDrawIndicator :: (center_x: i32, center_y: i32,
size: i32, open: i32, color: Color) #export {
    if size <= 0 { return }
    indicator: DropdownIndicator = DropdownIndicatorFor(center_x,
    center_y, size, open)
    DrawLine(indicator.x1, indicator.y1,
    indicator.x2, indicator.y2, color)
    DrawLine(indicator.x3, indicator.y3,
    indicator.x4, indicator.y4, color)
}

DropdownMenuBounds :: (state: const DropdownState*) -> Rectangle #export {
    bottom: i32 = ui_view_height
    if state->clip_bottom > 0 { bottom = state->clip_bottom }
    view: Rectangle = (Rectangle){0, (float)state->clip_top,
        (float)ui_view_width, (float)(bottom - state->clip_top)}
    panel_frame: StyleFrame = DropdownStyleFrame(DropdownPanelRole(),
    0, ButtonStateNormal, state->class_name)
    return PopupBounds((Rectangle){(float)state->x, (float)state->y,
        (float)state->w, (float)state->h}, view,
    state->option_count, (float)Scale(1000) / 1000.0, panel_frame)
}

dropdown_captures :: (point: Vector2) -> i32 #export {
    store: *DropdownStore = dropdown_store_current()
    state: *DropdownState = store->states
    while state != nil {
        if state->open && state->option_count > 0 {
            bounds: Rectangle = DropdownMenuBounds(state)
            if CheckCollisionPointRec(point, bounds) { return 1 }
        }
        state = state->next
    }
    return 0
}

DropdownCloseState :: (state: *DropdownState) #export {
    if state == nil { return }
    ui_scrollbar_cancel(&state->scroll_offset)
    state->open = 0
    state->just_opened = 0
    state->gesture = (PopupGesture){0}
    state->scrollbar_pressed = 0
}

dropdown_close :: (id: i32) #export {
    store: *DropdownStore = dropdown_store_current()
    state: *DropdownState = store->states
    while state != nil {
        if state->id == id {
            DropdownCloseState(state)
            return
        }
        state = state->next
    }
}

DropdownCloseOthers :: (id: i32) #export {
    store: *DropdownStore = dropdown_store_current()
    state: *DropdownState = store->states
    while state != nil {
        if state->id != id { DropdownCloseState(state) }
        state = state->next
    }
}

DropdownStateFor :: (id: i32) -> *DropdownState #export {
    store: *DropdownStore = dropdown_store_current()
    state: *DropdownState = store->states
    while state != nil {
        if state->id == id { return state }
        state = state->next
    }
    state = (DropdownState*)calloc(1, sizeof(DropdownState))
    if state == nil { abort() }
    state->id = id
    state->next = store->states
    store->states = state
    return state
}

DropdownTriggerInteraction :: (state: *DropdownState,
mouse: Vector2, bounds: Rectangle) -> InputPointerInteraction {
    captured: i32 = 0
    if state->open != 0 {
        captured = ui_base_input_captures_click(mouse, 1)
    } else {
        captured = InputCapturesClick(mouse)
    }
    return InputPointerInteractionFor(
    CheckCollisionPointRec(mouse, bounds) != 0,
    captured != 0, ContentDisabled() != 0,
    HoverEffectsEnabled() != 0,
    IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
    false, true)
}

ui_dropdown :: (props: DropdownProps) -> i32 #export {
    id: i32 = props.id
    x: i32 = (int)props.bounds.x
    y: i32 = (int)props.bounds.y
    w: i32 = (int)props.bounds.width
    h: i32 = (int)props.bounds.height
    options: const DropdownOption* = props.items
    option_count: i32 = props.option_count
    selected_index: *i32 = props.selected_index
    ui_disabled_enter(props.disabled)
    if props.disabled { MarkDisabled() }
    editor_id: [96]char
    state: *DropdownState = DropdownStateFor(id)
    runtime_scale: float = (float)Scale(1000) / 1000.0
    trigger_frame: StyleFrame = DropdownStyleFrame(0, 0,
    ButtonStateNormal, props.class_name)
    content_style: Style = ui_unpack_style(trigger_frame.value)
    style_states: ControlStyle = (ControlStyle){0}
    style_states.normal = content_style
    packed_style: StyleStates = ui_pack_style_states(style_states)
    content: ContentMetrics = Content(packed_style.normal,
    runtime_scale)
    trigger_metrics: DropdownTriggerMetrics =
    DropdownTriggerMetricsFor(runtime_scale, trigger_frame)
    font: i32 = (int)content.font
    arrow_size: i32 = trigger_metrics.indicator_size
    changed: i32 = 0
    btn_bounds: Rectangle = (Rectangle){(float)x, (float)y,
        (float)w, (float)h}
    mouse: Vector2 = ui_mouse_world()
    trigger_interaction: InputPointerInteraction =
    DropdownTriggerInteraction(state, mouse, btn_bounds)
    active: i32 = trigger_interaction.active
    hover: i32 = trigger_interaction.hovered
    can_draw: i32 = IsWindowReady()
    state->frame_seen = g_ui_frame_serial
    state->input_snapshot = ui_popup_input_snapshot()
    if ContentDisabled() {
        DropdownCloseState(state)
        state->pending_changed = 0
    }
    snprintf(editor_id, sizeof(editor_id), "Dropdown:%d", id)
    widget: Widget = BeginWidget("Dropdown", editor_id,
    btn_bounds, WidgetFlagMovable | WidgetFlagResizable)
    btn_bounds = widget.bounds
    x = (int)btn_bounds.x
    y = (int)btn_bounds.y
    w = (int)btn_bounds.width
    h = (int)btn_bounds.height
    if w < trigger_metrics.min_width { w = trigger_metrics.min_width }
    if h < trigger_metrics.min_height { h = trigger_metrics.min_height }
    btn_bounds = (Rectangle){(float)x, (float)y, (float)w, (float)h}
    WidgetSetBounds(&widget, btn_bounds)
    trigger_interaction = DropdownTriggerInteraction(state,
    mouse, btn_bounds)
    active = trigger_interaction.active
    hover = trigger_interaction.hovered
    focused: i32 = !ContentDisabled() && id > 0 &&
    RegisterFocus(id, btn_bounds)
    if focused != 0 { SetFocusTextInputActive(0) }
    if state->pending_changed {
        if selected_index != nil { *selected_index = state->pending_index }
        state->selected_index = state->pending_index
        state->pending_changed = 0
        changed = 1
    }
    store: *DropdownStore = dropdown_store_current()
    state->x = x
    state->y = y
    state->w = w
    state->h = h
    state->clip_top = store->clip_top
    state->clip_bottom = store->clip_bottom
    if selected_index != nil {
        state->selected_index = *selected_index
    }
    state->class_name = props.class_name
    option_count = DropdownOptionCountFor(option_count)
    DropdownResizeOptions(state, option_count)
    index: i32 = 0
    while index < option_count {
        label: const char* = nil
        if options != nil {
            state->options[index].icon_type = options[index].icon_type
            state->options[index].disabled = options[index].disabled
            state->options[index].separator_before =
            options[index].separator_before
            label = options[index].label
        } else {
            state->options[index].icon_type = ICON_NONE
            state->options[index].disabled = false
            state->options[index].separator_before = false
            if props.options != nil { label = props.options[index] }
        }
        DropdownCopyText(&state->options[index].label, label)
        index += 1
    }
    if active != 0 { MarkClickable() }
    pointer_activate: i32 = trigger_interaction.activated
    trigger_input: DropdownTriggerInput = DropdownTriggerInputFor(
    IsKeyPressed(KEY_ENTER) != 0,
    IsKeyPressed(KEY_KP_ENTER) != 0,
    IsKeyPressed(KEY_SPACE) != 0,
    IsKeyPressed(KEY_DOWN) != 0)
    open_decision: DropdownOpenDecision = DropdownOpenDecisionFor(
    state->open, ContentDisabled(), option_count, focused,
    !ui_popup_input_keyboard_captures(), pointer_activate,
    trigger_input, h, false, false, false)
    if open_decision.changed {
        ClearTextInputFocus()
        if trigger_interaction.consume_release { ConsumeRelease() }
        state->open = open_decision.open
        if open_decision.opened {
            DropdownCloseOthers(id)
            state->just_opened = 1
            state->opened_frame = g_ui_frame_serial
            state->scroll_offset = 0
            state->highlight_index = ClampIndex(
            state->selected_index, option_count)
            state->gesture = (PopupGesture){0}
        }
    }
    button_text: Color = content_style.foreground
    if can_draw != 0 {
        button_text = DropdownPaintTrigger(id, btn_bounds,
        hover || state->open,
        active && IsMouseButtonDown(MOUSE_BUTTON_LEFT),
        focused, props.class_name)
    }
    current_index: i32 = DropdownCurrentIndexFor(
    state->selected_index, option_count)
    current_name: const char* = ""
    has_icon: i32 = 0
    if option_count > 0 {
        current_name = state->options[current_index].label
        has_icon = state->options[current_index].icon_type != ICON_NONE
    }
    trigger_content: DropdownTriggerContent =
    DropdownTriggerContentFor(btn_bounds, content,
    trigger_metrics, has_icon != 0)
    if has_icon != 0 && can_draw != 0 {
        DrawIcon(state->options[current_index].icon_type,
        trigger_content.icon_bounds, button_text)
    }
    text_w: i32 = (int)trigger_content.clip_bounds.width
    if can_draw != 0 && text_w > 0 {
        needs_clip: i32 = !ui_text_fits_bounds(current_name,
        (int)trigger_content.text_bounds.x,
        (int)trigger_content.text_bounds.y,
        font, trigger_content.clip_bounds)
        if needs_clip != 0 {
            ui_begin_world_clip(trigger_content.clip_bounds)
        }
        ui_paint_text_box(current_name, trigger_content.text_bounds,
        font, button_text, TextWrapNone, TextAlignStart,
        TextAlignCenter, 0, 0)
        if needs_clip != 0 { EndClip() }
    }
    if can_draw != 0 {
        DropdownDrawIndicator(trigger_content.indicator_center_x,
        trigger_content.indicator_center_y, arrow_size,
        state->open, button_text)
    }
    EndWidget(&widget)
    ui_disabled_leave()
    return changed
}

DropdownPaintMenu :: (id: i32) -> i32 {
    state: *DropdownState = DropdownStateFor(id)
    if !state->open { return 0 }
    if state->option_count <= 0 {
        DropdownCloseState(state)
        return 0
    }
    keyboard_available: i32 =
    !ui_popup_input_snapshot_keyboard_captures(state->input_snapshot)
    content_style: Style = DropdownStyle(0, 0,
    ButtonStateNormal, state->class_name)
    style_states: ControlStyle = (ControlStyle){0}
    style_states.normal = content_style
    packed_style: StyleStates = ui_pack_style_states(style_states)
    content: ContentMetrics = Content(packed_style.normal,
    (float)Scale(1000) / 1000.0)
    font: i32 = (int)content.font
    x: i32 = state->x
    y: i32 = state->y
    w: i32 = state->w
    h: i32 = state->h
    option_h: i32 = h
    option_count: i32 = state->option_count
    options: const DropdownOption* = state->options
    can_draw: i32 = IsWindowReady()
    clip_started: i32 = 0
    btn_bounds: Rectangle = (Rectangle){(float)x, (float)y,
        (float)w, (float)h}
    menu_bounds: Rectangle = DropdownMenuBounds(state)
    panel_frame: StyleFrame = DropdownStyleFrame(
    DropdownPanelRole(), 0, ButtonStateNormal, state->class_name)
    option_frame: StyleFrame = DropdownStyleFrame(
    DropdownOptionRole(), 0, ButtonStateNormal, state->class_name)
    scrollbar_frame: StyleFrame = DropdownStyleFrame(
    DropdownScrollbarRole(), 0, ButtonStateNormal,
    state->class_name)
    metrics: DropdownMenuMetrics = DropdownMenuMetricsFor(
    (float)Scale(1000) / 1000.0, panel_frame,
    option_frame, scrollbar_frame)
    x = (int)menu_bounds.x
    w = (int)menu_bounds.width
    menu_layout: MenuLayout = MenuLayoutFor(menu_bounds,
    option_count, option_h, metrics.padding_top,
    metrics.padding_bottom, metrics.scrollbar_width,
    metrics.scrollbar_gap)
    content_h: i32 = menu_layout.content_height
    max_scroll: i32 = menu_layout.max_scroll
    option_w: i32 = menu_layout.option_width
    state->scroll_offset = ScrollOffset(state->scroll_offset,
    max_scroll)
    mouse: Vector2 = ui_mouse_world()
    my: i32 = (int)mouse.y
    pointer_in_dropdown: i32 =
    CheckCollisionPointRec(mouse, btn_bounds) ||
    CheckCollisionPointRec(mouse, menu_bounds)
    scrollbar_bounds: Rectangle = menu_layout.scrollbar_bounds
    next_scrollbar_pressed: i32 = DropdownScrollbarPressedNext(
    state->scrollbar_pressed != 0,
    IsMouseButtonDown(MOUSE_BUTTON_LEFT) != 0,
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0,
    max_scroll,
    CheckCollisionPointRec(mouse, scrollbar_bounds) != 0)
    state->scrollbar_pressed = state->scrollbar_pressed ||
    next_scrollbar_pressed
    state->gesture = PopupDragGesture(state->gesture,
    state->scroll_offset, IsMouseButtonDown(MOUSE_BUTTON_LEFT),
    pointer_in_dropdown, state->scrollbar_pressed, my,
    max_scroll, metrics.drag_threshold)
    state->scroll_offset = state->gesture.offset
    trigger_input: DropdownTriggerInput = (DropdownTriggerInput){0}
    open_decision: DropdownOpenDecision = DropdownOpenDecisionFor(
    state->open, false, option_count, false, false, false,
    trigger_input, h, false, false,
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) &&
    !pointer_in_dropdown)
    state->open = open_decision.open
    if !state->open { DropdownCloseState(state) }
    if !state->open { return 0 }
    opening: i32 = state->opened_frame == g_ui_frame_serial
    menu_input: DropdownMenuInput = DropdownMenuInputFor(
    keyboard_available != 0, opening != 0,
    IsKeyPressed(KEY_UP) != 0,
    IsKeyPressed(KEY_DOWN) != 0,
    IsKeyPressed(KEY_HOME) != 0,
    IsKeyPressed(KEY_END) != 0,
    IsKeyPressed(KEY_ENTER) != 0,
    IsKeyPressed(KEY_KP_ENTER) != 0,
    IsKeyPressed(KEY_ESCAPE) != 0)
    if menu_input.navigating || state->just_opened {
        nav: Navigation = StartNavigation(state->highlight_index,
        option_count, menu_input.up, menu_input.down,
        menu_input.home, menu_input.end)
        while nav.searching {
            nav = ScanNavigation(nav, !options[nav.index].disabled)
        }
        state->highlight_index = nav.result
        state->scroll_offset = RevealRow(state->scroll_offset,
        nav.result, option_h,
        menu_layout.content_bounds.height, max_scroll)
    }
    highlighted_enabled: i32 = state->highlight_index >= 0 &&
    state->highlight_index < option_count &&
    !options[state->highlight_index].disabled
    if CanCommit(highlighted_enabled, opening,
    keyboard_available, menu_input.commit,
    false, false, false, false) {
        open_decision = DropdownOpenAfterCommit(state->open, true)
        state->pending_index = state->highlight_index
        state->pending_changed =
        state->selected_index != state->highlight_index
        state->selected_index = state->highlight_index
        state->open = open_decision.open
        if open_decision.closed { DropdownCloseState(state) }
        return state->pending_changed
    }
    state->just_opened = DropdownJustOpenedNext(
    state->just_opened != 0,
    IsMouseButtonPressed(MOUSE_BUTTON_LEFT) != 0)
    if CheckCollisionPointRec(mouse, menu_bounds) {
        wheel: float = GetMouseWheelMove()
        if wheel != 0.0 && max_scroll > 0 {
            state->scroll_offset = WheelOffset(state->scroll_offset,
            wheel, option_h, max_scroll)
        }
    }
    if can_draw != 0 {
        paint: Style = ui_unpack_style(panel_frame.value)
        DropdownDrawSurface(menu_bounds, paint, 0)
    }
    if max_scroll > 0 {
        track: Rectangle = ScrollbarTrackBounds(scrollbar_bounds,
        metrics.scrollbar_track_inset)
        ui_scrollbar((int)track.x, (int)track.y,
        (int)track.height, content_h,
        &state->scroll_offset, max_scroll, 1)
    }
    if can_draw != 0 {
        BeginClip((int)(g_ui_camera.offset.x +
        menu_layout.content_bounds.x * g_ui_camera.zoom),
        (int)(g_ui_camera.offset.y +
        menu_layout.content_bounds.y * g_ui_camera.zoom),
        (int)(menu_layout.content_bounds.width * g_ui_camera.zoom),
        (int)(menu_layout.content_bounds.height * g_ui_camera.zoom))
        clip_started = 1
    }
    rows: VisibleRows = Rows(option_count, state->scroll_offset,
    menu_layout.content_bounds.height, option_h)
    index: i32 = rows.first
    while index < rows.end {
        option_paint: OptionPaint = OptionPaintFor(menu_bounds,
        option_w, index, option_h, state->scroll_offset,
        metrics.padding_top, metrics.padding_bottom,
        metrics.highlight_inset_x, metrics.highlight_inset_y)
        option_y: i32 = option_paint.option_y
        visible_h: i32 = (int)option_paint.visible_bounds.height
        visible_bounds: Rectangle = option_paint.visible_bounds
        if visible_h > 0 {
            option_interaction: InputPointerInteraction =
            InputPointerInteractionFor(
            CheckCollisionPointRec(mouse, visible_bounds) != 0,
            false, options[index].disabled != 0,
            HoverEffectsEnabled() != 0,
            IsMouseButtonReleased(MOUSE_BUTTON_LEFT) != 0,
            false, true)
            option_active: i32 = option_interaction.active
            option_hover: i32 = !options[index].disabled &&
            (state->highlight_index == index ||
            option_interaction.hovered)
            row_text: Color = content_style.foreground
            if can_draw != 0 {
                selected: i32 = state->selected_index == index
                option_state: ButtonState = ButtonStateNormal
                if options[index].disabled {
                    option_state = ButtonStateDisabled
                } else if option_hover != 0 {
                    option_state = ButtonStateHover
                }
                paint: Style = DropdownStyle(DropdownOptionRole(),
                selected, option_state, state->class_name)
                row_text = GetColor(Opacity(
                ColorToInt(paint.foreground), paint.opacity))
                if selected != 0 || option_hover != 0 {
                    row: Rectangle = option_paint.highlight_bounds
                    if row.width > 0 && row.height > 0 {
                        DropdownDrawSurface(row, paint,
                        option_hover && !selected)
                    }
                }
            }
            if option_active != 0 { MarkClickable() }
            if CanCommit(!options[index].disabled,
            state->just_opened, false, false,
            option_interaction.activated,
            state->scrollbar_pressed, state->gesture.dragging,
            state->scroll_offset == state->gesture.origin_offset) {
                open_decision = DropdownOpenAfterCommit(state->open, true)
                ClearTextInputFocus()
                if option_interaction.consume_release { ConsumeRelease() }
                state->pending_changed =
                state->selected_index != index
                state->selected_index = index
                state->pending_index = index
                state->open = open_decision.open
                if open_decision.closed { DropdownCloseState(state) }
                state->scroll_offset = 0
                if clip_started != 0 { EndClip() }
                return state->pending_changed
            }
            if can_draw != 0 {
                has_icon: i32 = options[index].icon_type != ICON_NONE
                row_bounds: Rectangle = (Rectangle){(float)x,
                    (float)option_y, (float)option_w, (float)option_h}
                option_content: DropdownOptionContent =
                DropdownOptionContentFor(row_bounds,
                visible_bounds, content, metrics, has_icon != 0)
                if options[index].separator_before {
                    separator: Rectangle = option_content.separator_bounds
                    DrawLine((int)separator.x, (int)separator.y,
                    (int)(separator.x + separator.width),
                    (int)separator.y, Fade(row_text, 0.18))
                }
                if has_icon != 0 {
                    DrawIcon(options[index].icon_type,
                    option_content.icon_bounds, row_text)
                }
                clip: Rectangle = option_content.clip_bounds
                BeginClip((int)(g_ui_camera.offset.x +
                clip.x * g_ui_camera.zoom),
                (int)(g_ui_camera.offset.y +
                clip.y * g_ui_camera.zoom),
                (int)(clip.width * g_ui_camera.zoom),
                (int)(clip.height * g_ui_camera.zoom))
                ui_paint_text_box(options[index].label,
                option_content.text_bounds, font, row_text,
                TextWrapNone, TextAlignStart, TextAlignCenter, 0, 0)
                EndClip()
                if state->selected_index == index {
                    DrawIcon(ICON_CHECK, option_content.check_bounds,
                    row_text)
                }
            }
        }
        index += 1
    }
    if clip_started != 0 { EndClip() }
    state->scrollbar_pressed = next_scrollbar_pressed
    return 0
}

ui_dropdown_overlays :: () #export {
    store: *DropdownStore = dropdown_store_current()
    focused: i32 = IsWindowFocused()
    lost_focus: i32 = store->previous_focused && !focused
    input: DropdownMenuInput = DropdownMenuInputFor(
    true, false, false, false, false, false, false, false,
    IsKeyPressed(KEY_ESCAPE) != 0)
    escape_pressed: i32 = input.escape
    store->previous_focused = focused
    if lost_focus != 0 || escape_pressed != 0 {
        state: *DropdownState = store->states
        while state != nil {
            captured: i32 = 0
            if escape_pressed != 0 && !lost_focus {
                captured = ui_popup_input_snapshot_keyboard_captures(
                state->input_snapshot)
            }
            if captured == 0 {
                trigger_input: DropdownTriggerInput =
                (DropdownTriggerInput){0}
                open_decision: DropdownOpenDecision =
                DropdownOpenDecisionFor(state->open, false,
                state->option_count, false, false, false,
                trigger_input, state->h, escape_pressed,
                lost_focus, false)
                state->open = open_decision.open
                if open_decision.closed { DropdownCloseState(state) }
            }
            state = state->next
        }
    }
    link: **DropdownState = &store->states
    while *link != nil {
        state: *DropdownState = *link
        if state->frame_seen != g_ui_frame_serial {
            *link = state->next
            DropdownCloseState(state)
            DropdownResizeOptions(state, 0)
            free(state)
        } else {
            if state->open { DropdownPaintMenu(state->id) }
            link = &state->next
        }
    }
}
