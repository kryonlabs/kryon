#import "control_props"
#import "geometry"

CardProps :: struct {
    bounds: Rectangle
    id: s32
    class_name: s32
    clickable: bool
    disabled: bool
    selected: bool
    state: ButtonState
    key: u64
    label: string
    variant: CardVariant
}

CardVariant :: enum {
    CardFilled :: 0
    CardElevated :: 1
    CardOutlined :: 2
}

CardResult :: struct {
    activated: bool
    content: Rectangle
}
