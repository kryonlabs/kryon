// The DOM page's frame loop App.Run runs: the browser document host,
// sessions and the widget tree.
App :: #import "app_types";
Dom :: #import "dom";
Web :: #import "std/web";
#import "dom_tree"
#import "dom_metrics"
#import "dom_raster"
using SessionModule :: #import "session";
using Geometry :: #import "geometry";
#import "paint_queue"
#import "tree"
#import "tree_draw"

active_draw: App.Draw;

DomError :: (reason: string) -> s32 {
    scope := Web.WebScope()
    defer Web.WebEnd(scope)
    console := Web.WebGetObject(Web.WebGlobal, Web.WebName("console"))
    unused Web.WebCall1(console, Web.WebName("error"), Web.WebText(reason))
    return 1
}

// Runs the program's frames in the page until it closes.
Run :: (window: App.Window, draw: App.Draw) -> s32 {
    unused window
    if !DomTreeOpen() { return DomError("Kryon DOM could not open the document") }
    defer DomTreeClose()
    if !DomMetricsOpen() { return DomError("Kryon DOM could not open browser font metrics") }
    defer DomMetricsClose()
    session := SessionOpen()
    if !SessionValid(session) { return DomError("Kryon DOM could not open a UI session") }
    defer { unused CloseSession(session) }
    active_draw = draw
    while !Dom.dom_close_requested {
        DomTreeInput(session)
        viewport := DomViewport()
        if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk {
            return DomError(FrameFailureAt(session).message)
        }
        App.CallDraw(active_draw, session.slot, session.epoch, viewport)
        if CommitFrame(session) != FrameStatus.FrameOk {
            return DomError(FrameFailureAt(session).message)
        }
        PaintClear(session)
        if !DomTreePublish(session) { return DomError("Kryon DOM could not update the document") }
        if !Dom.dom_close_requested { Web.WebNextFrame(0.0) }
    }
    return 0
}
