#import "geometry"
#import "control_props"
#import "session"
#import "style_sheet"
#import "text_props"
#import "text_widget"
#import "tree"
#import "tree_draw"

using TextWrap;
using FrameStatus;

session: Session;

#program_export
Frame :: () -> s32 {
    if !SessionValid(session) { session = SessionOpen() }
    if !SessionValid(session) { return -1 }
    BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, 320.0, 160.0})
    Text(session, TextProps.{.key = cast(u64)2, .bounds = Rectangle.{24.0, 48.0, 272.0, 64.0},
        .text = "Hello, world!", .font = 32, .wrap = cast(TextWrap)TextWrapNone})
    if EndFrame(session) != cast(FrameStatus)FrameOk { return -1 }
    return TreeCount(session)
}
