#module "image_props"
#import "drawing_props"
#import "geometry"

ImageFit :: enum {
    ImageFitStretch = 0
    ImageFitContain = 1
    ImageFitCover = 2
}

ImageProps :: struct {
    asset_path: const char*
    alt_text: const char*
    bounds: Rectangle
    source: Rectangle
    origin: Vector2
    rotation: float
    fit: ImageFit
    class_name: i32
    # Runtime texture: honored instead of asset_path when set. Trailing so
    # positional literals in existing sources keep their mapping.
    texture: Texture2D
}

# Host entry for the canonical Image(ImageProps) surface.
RenderImage :: (image: ImageProps) #extern #export
