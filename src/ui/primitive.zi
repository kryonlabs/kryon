#module "primitive"
#import "drawing_props"
#import "geometry"

LinePrimitive :: struct {
    bounds: Rectangle
    x1: i32
    y1: i32
    x2: i32
    y2: i32
}

TrianglePrimitive :: struct {
    bounds: Rectangle
    x1: i32
    y1: i32
    x2: i32
    y2: i32
    x3: i32
    y3: i32
}

PrimitiveBackgroundBounds :: (width: i32, height: i32) -> Rectangle #export {
    bounds: Rectangle
    bounds.x = 0.0
    bounds.y = 0.0
    bounds.width = (float)width
    bounds.height = (float)height
    return bounds
}

PrimitiveAppBackgroundColor :: (styled: Color, fallback: Color) -> Color #export {
    if styled.a != (u8)0 {
        return styled
    }
    return fallback
}

PrimitiveRectBounds :: (x: i32, y: i32, width: i32, height: i32) -> Rectangle #export {
    bounds: Rectangle
    bounds.x = (float)x
    bounds.y = (float)y
    bounds.width = (float)width
    bounds.height = (float)height
    return bounds
}

PrimitiveLineFor :: (x1: i32, y1: i32, x2: i32, y2: i32) -> LinePrimitive #export {
    line: LinePrimitive
    line.x1 = x1
    line.y1 = y1
    line.x2 = x2
    line.y2 = y2
    min_x: i32 = x1
    max_x: i32 = x2
    if x2 < min_x {
        min_x = x2
        max_x = x1
    }
    min_y: i32 = y1
    max_y: i32 = y2
    if y2 < min_y {
        min_y = y2
        max_y = y1
    }
    line.bounds.x = (float)min_x
    line.bounds.y = (float)min_y
    line.bounds.width = (float)(max_x - min_x)
    line.bounds.height = (float)(max_y - min_y)
    return line
}

PrimitiveCircleBounds :: (center_x: i32, center_y: i32, radius: i32) -> Rectangle #export {
    diameter: i32 = radius * 2
    return PrimitiveRectBounds(center_x - radius, center_y - radius,
                               diameter, diameter)
}

PrimitiveRingBounds :: (center_x: i32, center_y: i32, outer_radius: i32) -> Rectangle #export {
    return PrimitiveCircleBounds(center_x, center_y, outer_radius)
}

PrimitiveTriangleFor :: (x1: i32, y1: i32, x2: i32, y2: i32,
    x3: i32, y3: i32) -> TrianglePrimitive #export {
    triangle: TrianglePrimitive
    triangle.x1 = x1
    triangle.y1 = y1
    triangle.x2 = x2
    triangle.y2 = y2
    triangle.x3 = x3
    triangle.y3 = y3

    min_x: i32 = x1
    min_y: i32 = y1
    max_x: i32 = x1
    max_y: i32 = y1
    if x2 < min_x { min_x = x2 }
    if x3 < min_x { min_x = x3 }
    if y2 < min_y { min_y = y2 }
    if y3 < min_y { min_y = y3 }
    if x2 > max_x { max_x = x2 }
    if x3 > max_x { max_x = x3 }
    if y2 > max_y { max_y = y2 }
    if y3 > max_y { max_y = y3 }

    triangle.bounds = PrimitiveRectBounds(min_x, min_y,
                                          max_x - min_x,
                                          max_y - min_y)
    return triangle
}
