# KSS is the text format. The runtime API uses plain Style* names.
# Compilers and parsers lower .kss files into these typed rule tables.

#program_export
StyleAny :: () -> s32 {
    return -1
}

#program_export
StyleStateAny :: () -> s32 {
    return 0
}

