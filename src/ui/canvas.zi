#import "geometry"
#program_export
CanvasZoom :: (zoom: float32) -> float32 {
    if zoom <= 0.01 { return 1.0 }
    return zoom
}

#program_export
CanvasContains :: (bounds: Rectangle, point: Vector2) -> bool {
    return point.x >= bounds.x && point.y >= bounds.y &&
    point.x <= bounds.x + bounds.width &&
    point.y <= bounds.y + bounds.height
}

#program_export
CanvasPointToScreen :: (bounds: Rectangle, point: Vector2, scroll_x: s32,
scroll_y: s32, zoom: float32) -> Vector2 {
    out: Vector2 = point
    z: float32 = CanvasZoom(zoom)
    out.x = out.x - cast(float32)scroll_x
    out.y = out.y - cast(float32)scroll_y
    out.x = bounds.x + (out.x - bounds.x) * z
    out.y = bounds.y + (out.y - bounds.y) * z
    return out
}

#program_export
CanvasPointFromScreen :: (bounds: Rectangle, point: Vector2, scroll_x: s32,
scroll_y: s32, zoom: float32) -> Vector2 {
    out: Vector2 = point
    z: float32 = CanvasZoom(zoom)
    out.x = bounds.x + (out.x - bounds.x) / z + cast(float32)scroll_x
    out.y = bounds.y + (out.y - bounds.y) / z + cast(float32)scroll_y
    return out
}

#program_export
CanvasRectToScreenBounds :: (bounds: Rectangle, rect: Rectangle,
scroll_x: s32, scroll_y: s32, zoom: float32) -> Rectangle {
    out: Rectangle = rect
    z: float32 = CanvasZoom(zoom)
    point: Vector2 = CanvasPointToScreen(bounds, Vector2.{rect.x, rect.y},
    scroll_x, scroll_y, z)
    out.x = point.x
    out.y = point.y
    out.width = rect.width * z
    out.height = rect.height * z
    return out
}
