#import "geometry"

SegmentOption :: struct {
    key: u64
    label: string
    disabled: bool
}

SegmentedControlProps :: struct {
    key: u64
    bounds: Rectangle
    id: s32
    class_name: s32
    selected_index: s32
    has_selection: bool
    height: s32
    min_item_width: s32
    max_item_width: s32
    wrap: bool
    scale: float32
    disabled: bool
}

SegmentedControlResult :: struct {
    node: s32
    selected_index: s32
    clicked_index: s32
    changed: bool
    height: s32
}
